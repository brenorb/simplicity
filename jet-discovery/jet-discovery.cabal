cabal-version:       2.2
name:                jet-discovery
version:             0.1.0
synopsis:            Corpus-driven discovery of missing Bitcoin Simplicity jets
license:             MIT
build-type:          Simple

common shared
  default-language:    Haskell2010
  ghc-options:         -O1 -Wall -Wno-name-shadowing -Wno-unused-matches -Wno-missing-signatures -Wno-orphans -Wno-type-defaults -Wno-unused-do-bind
  build-depends:       Simplicity,
                       base >=4.9 && <4.20,
                       bytestring >=0.10 && <0.13,
                       cereal >=0.5 && <0.6,
                       containers >=0.5.10 && <0.7,
                       lens-family >=2.0 && <2.2,
                       mtl >=2.2 && <2.4,
                       transformers >=0.5 && <0.7,
                       vector >=0.12 && <0.14

library
  import:              shared
  hs-source-dirs:      src
  exposed-modules:     JetDiscovery.Cost

executable jet-discovery
  import:              shared
  hs-source-dirs:      app
  main-is:             Main.hs
  build-depends:       jet-discovery
