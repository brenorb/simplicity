                       JetDiscovery.Lib.TxSer
                       JetDiscovery.Lib.Bytes
                       JetDiscovery.Lib.Kernels
                       JetDiscovery.Lib.Ripemd160

executable jet-discovery
  import:              shared
  hs-source-dirs:      app
  main-is:             Main.hs
  ghc-options:         -threaded -rtsopts "-with-rtsopts=-N1 -A16m -M64G"
  build-depends:       jet-discovery

test-suite tests
  import:              shared
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Tests.hs
  ghc-options:         -threaded -rtsopts
  build-depends:       jet-discovery, tasty, tasty-hunit
