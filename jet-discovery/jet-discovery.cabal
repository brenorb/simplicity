cabal-version:       2.2
name:                jet-discovery
version:             0.1.0
synopsis:            Corpus-driven discovery of missing Bitcoin Simplicity jets
license:             MIT
build-type:          Simple

common shared
  default-language:    Haskell2010
  ghc-options:         -O1 -Wall -Wno-name-shadowing -Wno-unused-matches -Wno-missing-signatures -Wno-orphans -Wno-type-defaults -Wno-unused-do-bind -Wno-unused-imports -Wno-x-partial -Wno-unused-top-binds -Wno-incomplete-uni-patterns
  build-depends:       Simplicity,
                       base >=4.9 && <4.20,
                       bytestring >=0.10 && <0.13,
                       cereal >=0.5 && <0.6,
                       containers >=0.5.10 && <0.7,
                       lens-family >=2.0 && <2.2,
                       mtl >=2.2 && <2.4,
                       transformers >=0.5 && <0.7,
                       vector >=0.12 && <0.14,
                       directory,
                       MemoTrie

library
  import:              shared
  hs-source-dirs:      src
  exposed-modules:     JetDiscovery.Cost
                       JetDiscovery.Reprice
                       JetDiscovery.Lib.HashSigWitness
                       JetDiscovery.Corpus.BitcoinGrowth
                       JetDiscovery.Ref.BitcoinGrowth
                       JetDiscovery.Ref.BitcoinSpv
                       JetDiscovery.Lib.SpvReceipt
                       JetDiscovery.Lib.BitcoinFunding
                       JetDiscovery.Lib.ShrincsHash
                       JetDiscovery.Ref.ShrincsHash
                       JetDiscovery.Ref.StarkContext
                       JetDiscovery.Regression.WitnessState
                       JetDiscovery.Snapshot
                       JetDiscovery.Types
                       JetDiscovery.JetSets
                       JetDiscovery.WhatIf
                       JetDiscovery.Candidates.Registry
                       JetDiscovery.Candidates.Impact
                       JetDiscovery.Candidates.Variants
                       JetDiscovery.Profile
                       JetDiscovery.Run
                       JetDiscovery.Report
                       JetDiscovery.Mine
                       JetDiscovery.Tx
                       JetDiscovery.Ref.Bip340
                       JetDiscovery.Corpus
                       JetDiscovery.Corpus.Baseline
                       JetDiscovery.Corpus.Bip348Csfs
                       JetDiscovery.Corpus.Bip119Ctv
                       JetDiscovery.Corpus.Bip446TemplateHash
                       JetDiscovery.Corpus.CovenantMisc
                       JetDiscovery.Corpus.Apps
                       JetDiscovery.Corpus.Shrincs
                       JetDiscovery.Corpus.Hashes
                       JetDiscovery.Corpus.Stark
                       JetDiscovery.Corpus.StarkFri
                       JetDiscovery.Corpus.P256
                       JetDiscovery.Corpus.Ed25519
                       JetDiscovery.Corpus.Eprint
                       JetDiscovery.Corpus.EthSol
                       JetDiscovery.Corpus.EprintExpansion
                       JetDiscovery.Corpus.BN254
                       JetDiscovery.Ref.Xmss
                       JetDiscovery.Corpus.Xmss
                       JetDiscovery.Corpus.StateMachines
                       JetDiscovery.Corpus.ProposalApps
                       JetDiscovery.Lib.State
                       JetDiscovery.Corpus.StatefulApps
                       JetDiscovery.Ref.Lms
                       JetDiscovery.Corpus.Lms
                       JetDiscovery.Corpus.FinancialApps
                       JetDiscovery.Corpus.ContractMath
                       JetDiscovery.Corpus.Bip360P2mr
                       JetDiscovery.Corpus.BitcoinExpansion
                       JetDiscovery.Corpus.ScriptProposals
                       JetDiscovery.Corpus.FibonacciStark
                       JetDiscovery.Ref.FibonacciStark
                       JetDiscovery.Ref.Keccak
                       JetDiscovery.Corpus.ContractExpansion
                       JetDiscovery.Ref.CircleFri
                       JetDiscovery.Corpus.DeFi
                       JetDiscovery.Corpus.MoreBips
                       JetDiscovery.Corpus.Ripemd
                       JetDiscovery.Corpus.Aggregate
                       JetDiscovery.Corpus.Bip346Txhash
                       JetDiscovery.Ref.Shrincs
                       JetDiscovery.Ref.SlhDsa
                       JetDiscovery.Ref.SlhDsaStandard
                       JetDiscovery.Corpus.SlhDsaStandard
                       JetDiscovery.Corpus.ShrincsStateless
                       JetDiscovery.Lib.TxSer
                       JetDiscovery.Lib.Bytes
                       JetDiscovery.Lib.Kernels
                       JetDiscovery.Lib.Ripemd160

executable jet-discovery
  import:              shared
  hs-source-dirs:      app
  main-is:             Main.hs
  ghc-options:         -threaded -rtsopts "-with-rtsopts=-N1 -A16m -M64G"
  build-depends:       jet-discovery

test-suite tests
  import:              shared
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Tests.hs
  ghc-options:         -threaded -rtsopts
  build-depends:       jet-discovery, tasty, tasty-hunit
