       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m jet_secp_tweak_bytes_entry.tweak_bytes_guard
         Events.E0 (tweak_bytes_guard_temps le false result) mf ClightBigstep.Out_normal
### C.jet_secp_tweak_bytes_calls.exec_tweak_bytes_return
exec_tweak_bytes_return
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (overflow result : bool),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e (tweak_bytes_guard_temps le overflow result) m
         jet_secp_tweak_bytes_entry.tweak_bytes_return Events.E0 (tweak_bytes_guard_temps le overflow result) m
         (ClightBigstep.Out_return
            (@Some (prod Values.val Ctypes.type)
               (@pair Values.val Ctypes.type
                  (Values.Vint
                     (jet_readBit_layout.bit_int match overflow return bool with
                                                 | true => false
                                                 | false => result
                                                 end)) Ctypesdefs.tint)))
