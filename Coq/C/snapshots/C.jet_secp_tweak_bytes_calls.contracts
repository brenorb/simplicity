### C.jet_secp_tweak_bytes_calls.exec_tweak_bytes_guard_accept
exec_tweak_bytes_guard_accept
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bt bk bf : Values.block) (result : bool)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._term e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._overflow e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bf Ctypesdefs.tint)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_eckey_pubkey_tweak_add e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p le)
                (@Some Values.val (Values.Vptr bk Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint32 m bf BinNums.Z0)
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_eckey_pubkey_tweak_add)
                (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
