### C.jet_elements_version_canonical.elements_transaction_version_canonical_spec
elements_transaction_version_canonical_spec
     : forall (environment : jet_elements_prim.Elements.env) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z)
         (be : Values.block) (ebase : BinNums.Z) (bt : Values.block) (txbase : BinNums.Z)
         (version : Integers.Int64.int) (bytes : list Memdata.memval) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
         (_ : BinInt.Z.le BinNums.Z0 txbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add txbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bt
                   (BinInt.Z.add txbase
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong version)))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned version)
                (Integers.Int.unsigned (jet_elements_prim.sigTxVersion (jet_elements_prim.Elements.envTx environment))))
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cursor
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
            (fun value : Ty.tySem (Word.Word (S (S (S (S (S O)))))) =>
             and
               (@eq
                  (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                     (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                  (@elements_transaction_version_spec
                     (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)
                     tt environment) (@Some (Ty.tySem (Word.Word (S (S (S (S (S O))))))) value))
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                     (@Ctypes.Internal Clight.function jets_elements.f_simplicity_version)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                        (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                           (@cons Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase)) (@nil Values.val))))
                     Events.E0 mf (Values.Vint Integers.Int.one))
                  (and
                     (jet_encoding.frame_output_cells_at mf bw edge cursor
                        (@Translate.encode (Word.Word (S (S (S (S (S O)))))) value))
                     (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                        (and
                           (jet_frame_layout.frame_fields_at mf bd dbase bw edge
                              (BinInt.Z.sub cursor
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                              (_ : Memory.Mem.valid_block m b)
                              (_ : or (not (@eq Values.block b bd))
                                     (or
                                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                           (BinInt.Z.add dbase
                                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                        (BinInt.Z.le
                                           (BinInt.Z.add dbase
                                              (BinNums.Zpos
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                              (_ : or (not (@eq Values.block b bw))
                                     (or
                                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                           (jet_output_slice.slice_write_low
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                              edge cursor))
                                        (BinInt.Z.le
                                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                            @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))))
### C.jet_elements_version_canonical.elements_transaction_version_spec
elements_transaction_version_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
  jet_elements_prim.Elements.Version
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))

Arguments elements_transaction_version_spec {alg}
