### C.jet_secp_scalar_add_reduced.scalar_add_limb
scalar_add_limb =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) (i : nat) =>
jet_sx_expr.il
  (jet_sx_expr.den rho layout
     (@List.nth jet_sx_expr.sx i jet_secp_scalar_add_exec.scalar_add_limbs (jet_sx_expr.XLc Integers.Int64.zero)))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : nat),
       Integers.Int64.int

Arguments scalar_add_limb (rho layout)%function_scope i%nat_scope
### C.jet_secp_scalar_add_reduced.scalar_add_output_value
scalar_add_output_value =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) =>
jet_secp_scalar_overflow_numeric.scalar_limb_value (scalar_add_limb rho layout)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z), BinNums.Z

