### C.jet_secp_field_predicates.field_odd_run_eq
field_odd_run_eq
     : @eq (option jet_sx_exec.res) field_odd_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone field_odd_state jet_sx_exec.ONormal))
### C.jet_secp_field_predicates.field_odd_return
field_odd_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps field_odd_state))
         (@Some jet_sx_expr.sx field_odd_ret)
### C.jet_secp_field_predicates.field_odd_regions
field_odd_regions
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs field_odd_state)
         jet_secp_local_regions.local_write_initial_regs
### C.jet_secp_field_predicates.field_odd_value
field_odd_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (jet_sx_expr.den rho layout field_odd_ret)
         (Values.Vint (Integers.Int.repr (Integers.Int64.unsigned (Integers.Int64.and (rho (S O)) Integers.Int64.one))))
### C.jet_secp_field_predicates.eval_field_odd_from_owned_region
eval_field_odd_from_owned_region
     : forall (m : Memory.Mem.mem) (layout : jet_sx_state.layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : jet_sx_state.rep rho layout jet_secp_local_regions.local_write_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  (Integers.Int.repr (Integers.Int64.unsigned (Integers.Int64.and (rho (S O)) Integers.Int64.one)))))
            (and (jet_sx_state.rep rho layout jet_secp_local_regions.local_write_initial_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape jet_secp_local_regions.local_write_initial_regs) b pos)) m mf)))
### C.jet_secp_field_predicates.eval_field_odd_canonical
eval_field_odd_canonical
     : forall (m : Memory.Mem.mem) (ba : Values.block) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem value)))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  (jet_readBit_layout.bit_int
                     (Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem value)))))
            (and
               (Memory.Mem.range_perm mf ba BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b ba)) m mf)))
