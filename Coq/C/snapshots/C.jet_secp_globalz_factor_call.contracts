### C.jet_secp_globalz_factor_call.globalz_factor_source
globalz_factor_source
     : @eq Clight.statement globalz_factor_branch
         (Clight.Sifthenelse globalz_factor_guard globalz_factor_statement Clight.Sskip)
### C.jet_secp_globalz_factor_call.exec_globalz_factor_call
exec_globalz_factor_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (zs ratio : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bf bz : Values.block)
         (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) i)
                (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : not (@eq Values.block bf bz))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._zs e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bf jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._zr le)
                (@Some Values.val (Values.Vptr bz Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le)
                (@Some Values.val
                   (Values.Vlong (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : jet_secp_square_columns.square_input_bounds zs) (_ : jet_secp_square_columns.square_input_bounds ratio)
         (_ : jet_secp_fe_nv.fe_at m bf BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 zs))
         (_ : jet_secp_fe_nv.fe_at m bz
                (BinInt.Z.mul
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) i)
                (jet_secp_multiply_normalize_bridge.words5 ratio))
         (_ : Memory.Mem.range_perm m bf BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m globalz_factor_branch Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bf BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (globalz_factor_words i zs ratio)))
               (and
                  (jet_secp_fe_nv.fe_at mf bz
                     (BinInt.Z.mul
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) i)
                     (jet_secp_multiply_normalize_bridge.words5 ratio))
                  (and (jet_secp_square_columns.square_input_bounds (globalz_factor_words i zs ratio))
                     (and
                        (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (jet_secp_rescale_literal.rescale_field_output (globalz_factor_words i zs ratio))
                           match
                             BinInt.Z.eqb i (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))
                             return (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           with
                           | true => jet_secp_rescale_literal.rescale_field_output zs
                           | false =>
                               @jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
                                 (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (jet_secp_rescale_literal.rescale_field_output zs)
                                    (jet_secp_rescale_literal.rescale_field_output ratio))
                           end)
                        (and
                           (Memory.Mem.range_perm mf bf BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bz BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_clight_internal_permissions.keeps_permissions m mf)
                                 (and (jet_sx_mem.lframe (globalz_factor_frame bf bz i) m mf)
                                    (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
### C.jet_secp_globalz_factor_call.globalz_factor_branch
globalz_factor_branch =
match jet_secp_globalz_indexed_call.globalz_indexed_loop_body return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence branch _ => branch
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_globalz_factor_call.globalz_ratio_address
globalz_ratio_address =
Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._zr (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
  (Clight.Etempvar jets_secp._i Ctypesdefs.tulong) (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type)
     : Clight.expr
### C.jet_secp_globalz_factor_call.globalz_factor_statement
globalz_factor_statement =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._zs)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._zs)
        (@cons Clight.expr globalz_ratio_address (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_globalz_factor_call.globalz_factor_guard
globalz_factor_guard =
Clight.Ebinop Cop.One (Clight.Etempvar jets_secp._i Ctypesdefs.tulong)
  (Clight.Ebinop Cop.Osub (Clight.Etempvar jets_secp._len Ctypesdefs.tulong)
     (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tulong) Ctypesdefs.tint
     : Clight.expr
### C.jet_secp_globalz_factor_call.globalz_factor_words
globalz_factor_words =
fun (i : BinNums.Z) (zs ratio : forall _ : nat, Integers.Int64.int) =>
match
  BinInt.Z.eqb i (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))) return (forall _ : nat, Integers.Int64.int)
with
| true => zs
| false => jet_secp_point_mul_storage.point_mul_words zs ratio
end
     : forall (_ : BinNums.Z) (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : nat), Integers.Int64.int

Arguments globalz_factor_words i%Z_scope (zs ratio)%function_scope _%nat_scope
### C.jet_secp_globalz_factor_call.globalz_factor_frame
globalz_factor_frame =
fun (bf bz : Values.block) (i : BinNums.Z) (bx : Values.block) (pos : BinNums.Z) =>
and
  (or (not (@eq Values.block bx bf))
     (or (BinInt.Z.lt pos BinNums.Z0)
        (BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) pos)))
  (or (not (@eq Values.block bx bz))
     (or
        (BinInt.Z.lt pos
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) i))
        (BinInt.Z.le
           (BinInt.Z.add
              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                 i) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
     : forall (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments globalz_factor_frame bf bz i%Z_scope bx pos%Z_scope
