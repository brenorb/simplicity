      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Values.block
              (fun bout : Values.block =>
               @ex BinNums.Z
                 (fun outbase : BinNums.Z =>
                  and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                    (and (BinInt.Z.le BinNums.Z0 ebase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                             Integers.Ptrofs.max_unsigned)
                          (and (BinInt.Z.le BinNums.Z0 txbase)
                             (and
                                (BinInt.Z.le
                                   (BinInt.Z.add txbase
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO ...))))))))
                                   Integers.Ptrofs.max_unsigned)
                                (and
                                   (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                      (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                                   (and
                                      (@eq (option Values.val)
                                         (Memory.Mem.load AST.Mint64 m bt
                                            (BinInt.Z.add txbase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                         (@Some Values.val
                                            (Values.Vlong
                                               (Integers.Int64.repr
                                                  (BinInt.Z.of_nat
                                                     (@length jet_elements_prim.txOutput
                                                        (jet_elements_prim.sigTxOut ...)))))))
                                      (and
                                         (@List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                                            (@pair (prod Values.block BinNums.Z) BinNums.Z
                                               (@pair Values.block BinNums.Z be ebase)
                                               (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO ...))))) fp)
                                         (and
                                            (@List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                                               (@pair (prod Values.block BinNums.Z) BinNums.Z
                                                  (@pair Values.block BinNums.Z bt
                                                     (BinInt.Z.add txbase (BinNums.Zpos ...)))
                                                  (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO ...)))) fp)
                                            (forall (k : nat) (txo : jet_elements_prim.txOutput)
                                               (_ : @eq (option jet_elements_prim.txOutput)
                                                      (@List.nth_error jet_elements_prim.txOutput
                                                         (jet_elements_prim.sigTxOut (...)) k)
                                                      (@Some jet_elements_prim.txOutput txo)),
                                             elements_null_data_output_environment m bt txbase bout outbase k txo fp)))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments elements_null_data_environment_rep m env environment fp%list_scope
