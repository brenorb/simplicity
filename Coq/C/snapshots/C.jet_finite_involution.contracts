### C.jet_finite_involution.fixed_point_free_involution_even
@fixed_point_free_involution_even
     : forall (A : Type) (f : forall _ : A, A) (L : list A) (_ : @List.NoDup A L)
         (_ : forall (x : A) (_ : @List.In A x L), @List.In A (f x) L)
         (_ : forall (x : A) (_ : @List.In A x L), @eq A (f (f x)) x)
         (_ : forall (x : A) (_ : @List.In A x L), not (@eq A (f x) x)), PeanoNat.Nat.Even (@length A L)
