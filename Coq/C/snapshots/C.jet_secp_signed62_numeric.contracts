               (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))))
      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
