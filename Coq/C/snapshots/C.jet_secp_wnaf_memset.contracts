### C.jet_secp_wnaf_memset.memset_linked
memset_linked
     : @ex Values.block
         (fun bf : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                  jets_secp._memset) (@Some Values.block bf))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                  bf)
               (@Some (Ctypes.fundef Clight.function)
                  (@Ctypes.External Clight.function
                     (AST.EF_external
                        (String.String (Ascii.Ascii true false true true false true true false)
                           (String.String (Ascii.Ascii true false true false false true true false)
                              (String.String (Ascii.Ascii true false true true false true true false)
                                 (String.String (Ascii.Ascii true true false false true true true false)
                                    (String.String (Ascii.Ascii true false true false false true true false)
                                       (String.String (Ascii.Ascii false false true false true true true false)
                                          String.EmptyString)))))) jet_memset_model.memset_sig)
                     (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tvoid)
                        (Ctypes.Tcons Ctypesdefs.tint (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
                     (Ctypesdefs.tptr Ctypesdefs.tvoid) AST.cc_default))))
### C.jet_secp_wnaf_memset.wnaf_memset_args_eval
wnaf_memset_args_eval
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (b : Values.block)
         (base len : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._wnaf le)
                (@Some Values.val (Values.Vptr b (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le)
                (@Some Values.val (Values.Vint (Integers.Int.repr len))))
         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.le len
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       Clight.eval_exprlist jet_secp_linkage.secp_ge e le m
         (@cons Clight.expr (Clight.Etempvar jets_secp._wnaf (Ctypesdefs.tptr Ctypesdefs.tint))
            (@cons Clight.expr (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
               (@cons Clight.expr
                  (Clight.Ebinop Cop.Omul (Clight.Etempvar jets_secp._len Ctypesdefs.tint)
                     (Clight.Esizeof Ctypesdefs.tint Ctypesdefs.tulong) Ctypesdefs.tulong)
                  (@nil Clight.expr))))
         (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tvoid)
            (Ctypes.Tcons Ctypesdefs.tint (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
         (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr base))
            (@cons Values.val (Values.Vint Integers.Int.zero)
               (@cons Values.val
                  (Values.Vlong
                     (Integers.Int64.repr (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) len)))
                  (@nil Values.val))))
### C.jet_secp_wnaf_memset.exec_wnaf_memset
exec_wnaf_memset
     : forall (_ : jet_memset_model.memset_model) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (b : Values.block) (base len : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._memset e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._wnaf le)
                (@Some Values.val (Values.Vptr b (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le)
                (@Some Values.val (Values.Vint (Integers.Int.repr len))))
         (_ : and (BinInt.Z.lt BinNums.Z0 len)
                (BinInt.Z.le len
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) len))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b base
                (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) len)) Memtype.Cur
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mz : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m jet_secp_wnaf_entry15.wnaf_memset_call
               Events.E0 le mz ClightBigstep.Out_normal)
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.storebytes m b base
                  (jet_memset_model.memset_bytes Integers.Int.zero
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) len)))
               (@Some Memory.Mem.mem mz)))
### C.jet_secp_wnaf_memset.memset_bytes_app
memset_bytes_app
     : forall (c : Integers.Int.int) (a d : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 a) (_ : BinInt.Z.le BinNums.Z0 d),
       @eq (list Memdata.memval) (jet_memset_model.memset_bytes c (BinInt.Z.add a d))
         (@app Memdata.memval (jet_memset_model.memset_bytes c a) (jet_memset_model.memset_bytes c d))
### C.jet_secp_wnaf_memset.app_length_inv
@app_length_inv
     : forall (A : Type) (a b c d : list A) (_ : @eq nat (@length A a) (@length A c))
         (_ : @eq (list A) (@app A a b) (@app A c d)), and (@eq (list A) a c) (@eq (list A) b d)
### C.jet_secp_wnaf_memset.memset_zero_load
memset_zero_load
     : forall (m : Memory.Mem.mem) (b : Values.block) (base len : BinNums.Z) (mz : Memory.Mem.mem)
         (i : BinNums.Z)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.storebytes m b base
                   (jet_memset_model.memset_bytes Integers.Int.zero
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) len)))
                (@Some Memory.Mem.mem mz))
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) base)
         (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint32 mz b
            (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
         (@Some Values.val (Values.Vint Integers.Int.zero))
### C.jet_secp_wnaf_memset.memset_memory_effect
memset_memory_effect
     : forall (m : Memory.Mem.mem) (b : Values.block) (base len : BinNums.Z) (mz : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.storebytes m b base
                   (jet_memset_model.memset_bytes Integers.Int.zero
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) len)))
                (@Some Memory.Mem.mem mz)), jet_secp_wnaf_loop.wnaf_memory_effect b m mz
### C.jet_secp_wnaf_memset.generate_memset_steps
generate_memset_steps
     : forall (_ : jet_memset_model.memset_model) (ma : Memory.Mem.mem) (mi : Memory.Mem.mem')
         (local ba b : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mi local))
         (_ : Memory.Mem.range_perm ma b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xI
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mz : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_wnaf_digit.wnaf_env local)
               (jet_secp_wnaf_entry15.wnaf_before_temps
                  (jet_secp_wnaf_entry15.wnaf_entry15_temps b BinNums.Z0 (Values.Vptr ba Integers.Ptrofs.zero))) mi
               jet_secp_wnaf_entry15.wnaf_memset_call Events.E0
               (jet_secp_wnaf_entry15.wnaf_before_temps
                  (jet_secp_wnaf_entry15.wnaf_entry15_temps b BinNums.Z0 (Values.Vptr ba Integers.Ptrofs.zero))) mz
               ClightBigstep.Out_normal)
            (and
               (forall (i : BinNums.Z)
                  (_ : and (BinInt.Z.le BinNums.Z0 i)
                         (BinInt.Z.lt i
                            (BinNums.Zpos
                               (BinNums.xI
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 mz b (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
                  (@Some Values.val (Values.Vint Integers.Int.zero))) (jet_secp_wnaf_loop.wnaf_memory_effect b mi mz)))
