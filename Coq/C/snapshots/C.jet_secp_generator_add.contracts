### C.jet_secp_generator_add.generator_add_source
generator_add_source
     : @eq Clight.statement generator_add_stmt
         (Clight.Scall (@None AST.ident)
            (Clight.Evar jets_secp._secp256k1_gej_add_ge_var
               (Clight.type_of_function jets_secp.f_secp256k1_gej_add_ge_var))
            (@cons Clight.expr
               (Clight.Eaddrof (Clight.Evar jets_secp._accum (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
               (@cons Clight.expr
                  (Clight.Eaddrof (Clight.Evar jets_secp._accum (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
                     (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
                  (@cons Clight.expr
                     (Clight.Eaddrof (Clight.Evar jets_secp._add jet_secp_curve_statements.curve_ge_type)
                        (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type))
                     (@cons Clight.expr
                        (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
                           (Ctypesdefs.tptr Ctypesdefs.tvoid)) (@nil Clight.expr))))))
### C.jet_secp_generator_add.generator_add_symbol
generator_add_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            jets_secp._secp256k1_gej_add_ge_var)
         (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_gej_add_ge_var))
### C.jet_secp_generator_add.generator_add_funct
generator_add_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_gej_add_ge_var) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_add_ge_var))
### C.jet_secp_generator_add.exec_generator_add
exec_generator_add
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bx bp : Values.block) (x y z u v : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._accum e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._add e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp jet_secp_curve_statements.curve_ge_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_add_ge_var e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bx bp))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : jet_secp_square_columns.square_input_bounds u)
         (_ : jet_secp_square_columns.square_input_bounds v)
         (_ : jet_secp_fe_nv.fe_at m bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bx
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bx
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bx
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 v))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : jet_secp_swu_startup.swu_startup m)
         (_ : forall prefix : bool, jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_add_stmt Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5
                     (jet_secp_mixed_body_loose.mixed_mode_body_x_words true Integers.Int.zero x y z u v)))
               (and
                  (jet_secp_fe_nv.fe_at mf bx
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5
                        (jet_secp_mixed_body_loose.mixed_mode_body_y_words true Integers.Int.zero x y z u v)))
                  (and
                     (jet_secp_fe_nv.fe_at mf bx
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_mixed_body_loose.mixed_mode_body_z_words true Integers.Int.zero x y z u v)))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf bx
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                           (@Some Values.val
                              (Values.Vint
                                 (jet_secp_mixed_body_loose.mixed_mode_body_flag true Integers.Int.zero x y z u v))))
                        (and
                           (jet_secp_square_columns.square_input_bounds
                              (jet_secp_mixed_body_loose.mixed_mode_body_x_words true Integers.Int.zero x y z u v))
                           (and
                              (jet_secp_square_columns.square_input_bounds
                                 (jet_secp_mixed_body_loose.mixed_mode_body_y_words true Integers.Int.zero x y z u v))
                              (and
                                 (jet_secp_square_columns.square_input_bounds
                                    (jet_secp_mixed_body_loose.mixed_mode_body_z_words true Integers.Int.zero x y z u v))
                                 (and
                                    (Memory.Mem.range_perm mf bx BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (Memory.Mem.range_perm mf bp BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) =>
                                              and (not (@eq Values.block b bx)) (not (@eq Values.block b bp))) m mf)
                                          (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                             (and (jet_secp_sha_startup.secp_sha_startup mf)
                                                (and (jet_secp_swu_startup.swu_startup mf)
                                                   (forall prefix : bool,
                                                    jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix mf)))))))))))))))
### C.jet_secp_generator_add.generator_add_stmt
generator_add_stmt =
@List.nth Clight.statement (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal)))
  Clight.Sskip
     : Clight.statement
