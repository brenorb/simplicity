### C.jet_secp_scalar_set_canonical.scalar_parser_limbs_canonical
scalar_parser_limbs_canonical
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (words : forall _ : nat, Integers.Int64.int)
         (_ : @eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value words)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value)
                   jet_secp_canonical_scalar.canonical_group_order)),
       @eq (list Integers.Int64.int)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))))
         (@cons Integers.Int64.int (words O)
            (@cons Integers.Int64.int (words (S O))
               (@cons Integers.Int64.int (words (S (S O)))
                  (@cons Integers.Int64.int (words (S (S (S O)))) (@nil Integers.Int64.int)))))
### C.jet_secp_scalar_set_canonical.scalar_parser_storage_canonical
scalar_parser_storage_canonical
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (words : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : @eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value words)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value)
                   jet_secp_canonical_scalar.canonical_group_order))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S O))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vlong (words i)))),
       jet_secp_scalar_get_b32_storage.scalar_at m b BinNums.Z0
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))))
### C.jet_secp_scalar_set_canonical.eval_scalar_set_b32_canonical_flag
eval_scalar_set_b32_canonical_flag
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (b bb : Values.block)
         (ofs : BinNums.Z) (bf : Values.block) (m : Memory.Mem.mem) (_ : not (@eq Values.block b bb))
         (_ : not (@eq Values.block bf b)) (_ : not (@eq Values.block bf bb)) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Readable)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bb ofs
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes value))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_set_b32)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bb (Integers.Ptrofs.repr ofs))
                     (@cons Values.val (Values.Vptr bf Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf b BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value)))))
               (and
                  (@eq (option Values.val) (Memory.Mem.load AST.Mint32 mf bf BinNums.Z0)
                     (@Some Values.val
                        (Values.Vint
                           (jet_sx_expr.b2i
                              (BinInt.Z.leb jet_secp_canonical_scalar.canonical_group_order
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value))))))
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and
                        (jet_sx_mem.lframe
                           (fun (block : Values.block) (pos : BinNums.Z) =>
                            and
                              (not
                                 (jet_sx_state.foot
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                                       (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb ofs)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bf BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z)))))
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape jet_secp_scalar_set_flag.scalar_flag_regs) block pos))
                              (not (@eq Values.block block bf))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
