literal_wnaf_signed_value =
fun (b : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (w : Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))) =>
BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) w)
  (BinInt.Z.mul
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     (@Word.ToZ.Theory.toZ Word.BitToZ b))
     : forall (_ : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))),
       BinNums.Z

