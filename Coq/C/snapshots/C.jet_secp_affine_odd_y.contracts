         (@Some jet_sx_exec.res (jet_sx_exec.RDone affine_odd_y_state jet_sx_exec.ONormal))
### C.jet_secp_affine_odd_y.affine_odd_y_return
affine_odd_y_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps affine_odd_y_state))
         (@Some jet_sx_expr.sx affine_odd_y_ret)
### C.jet_secp_affine_odd_y.affine_odd_y_regions
affine_odd_y_regions
