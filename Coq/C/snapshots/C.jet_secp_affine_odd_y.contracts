         jet_secp_affine_normalize_y.affine_nv_y_regs
### C.jet_secp_affine_odd_y.eval_affine_odd_y_words
eval_affine_odd_y_words
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd)
               (@cons Values.val
                  (Values.Vptr b
                     (Integers.Ptrofs.repr
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@nil Values.val)) Events.E0 mf
               (Values.Vint (Integers.Int.repr (Integers.Int64.unsigned (Integers.Int64.and (w O) Integers.Int64.one)))))
            (and
               (jet_secp_fe_nv.fe_at mf b
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (jet_secp_multiply_normalize_bridge.words5 w))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (bx : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block bx b))
                        (or
                           (BinInt.Z.lt pos
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (BinInt.Z.le
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                     m mf))))
### C.jet_secp_affine_odd_y.eval_affine_odd_y_value
eval_affine_odd_y_value
     : forall (m : Memory.Mem.mem) (b : Values.block) (value : BinNums.Z)
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd)
               (@cons Values.val
                  (Values.Vptr b
                     (Integers.Ptrofs.repr
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@nil Values.val)) Events.E0 mf
               (Values.Vint (Integers.Int.repr (BinInt.Z.b2z (BinInt.Z.testbit value BinNums.Z0)))))
            (and
               (jet_secp_fe_nv.fe_at mf b
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (bx : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block bx b))
                        (or
                           (BinInt.Z.lt pos
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (BinInt.Z.le
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                     m mf))))
### C.jet_secp_affine_odd_y.affine_odd_y_run
affine_odd_y_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_is_odd
  (@cons jet_sx_expr.sx
     (jet_sx_expr.XP O (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
     (@nil jet_sx_expr.sx)) jet_secp_affine_normalize_y.affine_nv_y_regs (@nil jet_sx_eval.event)
  (S (S (S (S (S O)))))
     : option jet_sx_exec.res
### C.jet_secp_affine_odd_y.affine_odd_y_tree
affine_odd_y_tree =
@Some jet_sx_exec.res
  (jet_sx_exec.RDone
     (jet_sx_eval.mkst
        (@Maps.PTree.Nodes jet_sx_expr.sx
           (@Maps.PTree.Node010 jet_sx_expr.sx
              (jet_sx_expr.XL2I
                 (jet_sx_expr.XLb jet_sx_expr.Band (jet_sx_expr.XLv O)
                    (jet_sx_expr.XI2L Ctypes.Signed
                       (jet_sx_expr.XIc
                          (Integers.Int.mkint (BinNums.Zpos BinNums.xH)
                             (Integers.Int.Z_mod_modulus_range' (BinNums.Zpos BinNums.xH)))))))))
        (@cons jet_sx_state.region
           (jet_sx_state.mkreg
              (@cons jet_sx_state.cell
                 (jet_sx_state.mkcell
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                    AST.Mint64 (@Some jet_sx_expr.sx (jet_sx_expr.XLv O)))
                 (@cons jet_sx_state.cell
                    (jet_sx_state.mkcell
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
                       AST.Mint64 (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S O))))
                    (@cons jet_sx_state.cell
                       (jet_sx_state.mkcell
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))
                          AST.Mint64 (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))))
                       (@cons jet_sx_state.cell
                          (jet_sx_state.mkcell
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                             AST.Mint64 (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O))))))
                          (@cons jet_sx_state.cell
                             (jet_sx_state.mkcell
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                AST.Mint64 (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O)))))))
                             (@nil jet_sx_state.cell)))))) true
              (@Some BinNums.Z
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
           (@nil jet_sx_state.region)) (@nil jet_sx_eval.event) (S (S (S (S (S O)))))) jet_sx_exec.ONormal)
     : option jet_sx_exec.res
### C.jet_secp_affine_odd_y.affine_odd_y_state
affine_odd_y_state =
match affine_odd_y_tree return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_affine_odd_y.affine_odd_y_ret
affine_odd_y_ret =
jet_sx_expr.XL2I
  (jet_sx_expr.XLb jet_sx_expr.Band (jet_sx_expr.XLv O)
     (jet_sx_expr.XI2L Ctypes.Signed (jet_sx_expr.XIc Integers.Int.one)))
     : jet_sx_expr.sx
