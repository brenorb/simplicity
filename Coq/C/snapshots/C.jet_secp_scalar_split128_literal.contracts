### C.jet_secp_scalar_split128_literal.scalar_split128_two_word_limbs
scalar_split128_two_word_limbs
     : forall w0 w1 : Integers.Int64.int,
       @eq (list Integers.Int64.int)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
               (BinInt.Z.add (Integers.Int64.unsigned w0)
                  (BinInt.Z.mul
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (Integers.Int64.unsigned w1)))))
         (@cons Integers.Int64.int w0
            (@cons Integers.Int64.int w1
               (@cons Integers.Int64.int Integers.Int64.zero
                  (@cons Integers.Int64.int Integers.Int64.zero (@nil Integers.Int64.int)))))
### C.jet_secp_scalar_split128_literal.scalar_split128_output_storage
scalar_split128_output_storage
     : forall (owned : bool) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (mf : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta (jet_secp_scalar_split128.scalar_split128_output_regs owned) mf)
         (_ : Memory.Mem.range_perm mf (jet_sx_state.blk beta O) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm mf (jet_sx_state.blk beta (S O)) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       and
         (jet_secp_scalar_get_b32_storage.scalar_at mf (jet_sx_state.blk beta O) (jet_sx_state.bas beta O)
            (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
               (jet_secp_scalar_get_b32_numeric.scalar_limbs_of (jet_secp_scalar_split128.scalar_split128_low rho))))
         (jet_secp_scalar_get_b32_storage.scalar_at mf (jet_sx_state.blk beta (S O)) (jet_sx_state.bas beta (S O))
            (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
