### C.jet_secp_scalar_split128_literal.eval_scalar_split128_normalized_literal
eval_scalar_split128_normalized_literal
     : forall (owned : bool) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_sx_state.rep rho beta (jet_secp_scalar_split128.scalar_split128_regs owned) m)
         (_ : @eq BinNums.Z (jet_secp_scalar_split128.scalar_split128_input_value rho)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_split_128)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                           (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O))))) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and (jet_sx_state.rep rho beta (jet_secp_scalar_split128.scalar_split128_output_regs owned) mf)
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf (jet_sx_state.blk beta O) (jet_sx_state.bas beta O)
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                              (literal_split128_low value)))))
                  (and
                     (jet_secp_scalar_get_b32_storage.scalar_at mf (jet_sx_state.blk beta (S O))
                        (jet_sx_state.bas beta (S O))
                        (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                           (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                                 (literal_split128_high value)))))
                     (and
                        (Memory.Mem.range_perm mf (jet_sx_state.blk beta O) BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf (jet_sx_state.blk beta (S O)) BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (forall _ : @eq bool owned true,
                               Memory.Mem.range_perm mf (jet_sx_state.blk beta (S (S O))) BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (pos : BinNums.Z) =>
                                  not
                                    (jet_sx_state.foot beta
                                       (@List.map jet_sx_state.region
                                          (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                          jet_sx_state.rshape (jet_secp_scalar_split128.scalar_split128_regs owned)) b
                                       pos)) m mf))))))))
