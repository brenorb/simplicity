### C.jet_secp_taptweak_body.slot_size_unique
slot_size_unique
     : forall (slots : list (prod Values.block BinNums.Z)) (b : Values.block) (hi lo : BinNums.Z)
         (_ : @List.NoDup Values.block
                (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) slots))
         (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi) slots)
         (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b lo) slots),
       @eq BinNums.Z hi lo
### C.jet_secp_taptweak_body.owned_slots_after
owned_slots_after
     : forall (slots changed : list (prod Values.block BinNums.Z))
         (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (m mf : Memory.Mem.mem)
         (_ : @List.NoDup Values.block
                (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) slots))
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi) slots),
              and (BinInt.Z.lt BinNums.Z0 hi) (Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable))
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi) changed),
              @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi) slots)
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi) changed),
              Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi) slots)
                (_ : not
                       (@List.In Values.block b
                          (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) changed)))
                (pos : BinNums.Z), P b pos) (b : Values.block) (hi : BinNums.Z)
         (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi) slots),
       Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable
### C.jet_secp_taptweak_body.taptweak_body_slots_map
taptweak_body_slots_map
     : forall bb bi bo bp bt bh bs bc bc1 br br1 bf : Values.block,
       @eq (list Values.block)
         (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z)
            (taptweak_body_storage bb bi bo bp bt bh bs bc bc1 br br1 bf))
         (taptweak_body_locals bb bi bo bp bt bh bs bc bc1 br br1 bf)
### C.jet_secp_taptweak_body.taptweak_body_slots_positive
taptweak_body_slots_positive
     : forall (bb bi bo bp bt bh bs bc bc1 br br1 bf b : Values.block) (hi : BinNums.Z)
         (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                (taptweak_body_storage bb bi bo bp bt bh bs bc bc1 br br1 bf)), BinInt.Z.lt BinNums.Z0 hi
### C.jet_secp_taptweak_body.taptweak_body_member
taptweak_body_member
     : forall (bb bi bo bp bt bh bs bc bc1 br br1 bf b : Values.block) (hi : BinNums.Z)
         (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                (taptweak_body_storage bb bi bo bp bt bh bs bc bc1 br br1 bf)),
       @List.In Values.block b (taptweak_body_locals bb bi bo bp bt bh bs bc bc1 br br1 bf)
### C.jet_secp_taptweak_body.taptweak_key_failure_value
taptweak_key_failure_value
     : forall (ng : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (pk : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
         (_ : @eq Integers.Int.int (jet_secp_xonly_parse_field.xonly_parse_result pk) Integers.Int.zero),
       and
         (@eq (option (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (jet_secp_taptweak_finish.taptweak_output ng pk)
            (@None (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@eq bool (jet_secp_taptweak_parsed_native.taptweak_result ng pk) false)
### C.jet_secp_taptweak_body.exec_taptweak_body
exec_taptweak_body
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_memset_model.memset_model) (_ : jet_ctz_model.ctz_model)
         (pk h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bb bi bo bp bt bh bs bc bc1 br br1 bf bin : Values.block) (edge rc : BinNums.Z)
         (bd : Values.block) (base : BinNums.Z) (bw : Values.block) (outedge cursor : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._tagName__3 le)
                (@Some Values.val (Values.Vptr jet_secp_taptweak_tag.taptweak_tag_block Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._tagLen le)
                (@Some Values.val
                   (Values.Vlong (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bf Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : @List.NoDup Values.block
                (@app Values.block (jet_secp_taptweak_entry.taptweak_locals bb bi bo bp bt bh bs bc bc1 br br1)
                   (@cons Values.block bf (@cons Values.block bin (@nil Values.block)))))
         (_ : not (@List.In Values.block bd (taptweak_body_locals bb bi bo bp bt bh bs bc bc1 br br1 bf)))
         (_ : not (@List.In Values.block bw (taptweak_body_locals bb bi bo bp bt bh bs bc bc1 br br1 bf)))
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (taptweak_body_storage bb bi bo bp bt bh bs bc bc1 br br1 bf)),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_taptweak_writer_state.taptweak_ready m) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bf BinNums.Z0 bin edge rc)
         (_ : jet_encoding.frame_input_cells_at m bin edge rc
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk h)))
         (_ : jet_output_layout.write_frame_at m bd base bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
                  (jet_secp_taptweak_entry.taptweak_env bb bi bo bp bt bh bs bc bc1 br br1) le m
                  (Clight.fn_body jets_secp.f_simplicity_generic_taptweak) Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type
                           (Values.Vint
                              (jet_readBit_layout.bit_int
                                 (jet_secp_taptweak_parsed_native.taptweak_result
                                    (jet_secp_taptweak_hash.taptweak_hash_word pk h) pk))) Ctypesdefs.tint))))
               (and
                  match
                    jet_secp_taptweak_finish.taptweak_output (jet_secp_taptweak_hash.taptweak_hash_word pk h) pk
                    return Prop
                  with
                  | Some value =>
                      and
                        (jet_encoding.frame_output_cells_at mf bw outedge cursor
                           (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) value))
                        (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                           (jet_frame_layout.frame_fields_at mf bd base bw outedge
                              (BinInt.Z.sub cursor
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                  | None => True
                  end
                  (and
                     (forall (b : Values.block) (hi : BinNums.Z)
                        (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                               (taptweak_body_storage bb bi bo bp bt bh bs bc bc1 br br1 bf)),
                      Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and
                              (not
                                 (@List.In Values.block b (taptweak_body_locals bb bi bo bp bt bh bs bc bc1 br br1 bf)))
                              (and (not (@eq Values.block b bd)) (not (@eq Values.block b bw)))) m mf)
                        (and
                           (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                              (_ : Memory.Mem.valid_block m b)
                              (_ : not
                                     (@List.In Values.block b
                                        (taptweak_body_locals bb bi bo bp bt bh bs bc bc1 br br1 bf)))
                              (_ : or (not (@eq Values.block b bd))
                                     (or
                                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                           (BinInt.Z.add base
                                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                        (BinInt.Z.le
                                           (BinInt.Z.add base
                                              (BinNums.Zpos
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                              (_ : or (not (@eq Values.block b bw))
                                     (or
                                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                           (BinInt.Z.add outedge
                                              (BinInt.Z.mul
                                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                                 (BinInt.Z.div
                                                    (BinInt.Z.sub cursor
                                                       (BinNums.Zpos
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))
                                                    (BinNums.Zpos
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                        (BinInt.Z.le
                                           (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                            @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                           (and (jet_clight_forward.mem_forward m mf)
                              (jet_secp_taptweak_writer_state.taptweak_ready mf))))))))
