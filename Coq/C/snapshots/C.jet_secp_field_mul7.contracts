         (@None jet_sx_expr.sx)
### C.jet_secp_field_mul7.mul7_output_shape
mul7_output_shape
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs mul7_state)
         (@cons jet_sx_state.region
