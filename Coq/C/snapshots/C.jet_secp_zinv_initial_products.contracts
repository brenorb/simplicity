### C.jet_secp_zinv_initial_products.zinv_az_source
zinv_az_source
     : @eq Clight.statement zinv_finite_suffix (Clight.Ssequence zinv_az_statement zinv_after_az)
### C.jet_secp_zinv_initial_products.zinv_z12_source
zinv_z12_source
     : @eq Clight.statement zinv_after_az (Clight.Ssequence zinv_z12_statement zinv_after_z12)
### C.jet_secp_zinv_initial_products.exec_zinv_z12_from_owned
exec_zinv_z12_from_owned
     : forall (w : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (bo bi : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._z12 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bo jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._az e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bi jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bi BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bi BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bo bi)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m zinv_z12_statement Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bo BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words w)))
               (and
                  (Memory.Mem.range_perm mf bo BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_secp_fe_nv.fe_at mf bi BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                     (and
                        (Memory.Mem.range_perm mf bi BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe (jet_secp_square_point_x.square_two_ranges bo bi) m mf))))))
### C.jet_secp_zinv_initial_products.exec_zinv_az_from_owned
exec_zinv_az_from_owned
     : forall (a b : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bo ba bb : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._bzinv le)
                (@Some Values.val (Values.Vptr bb Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._az e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bo jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds a)
         (_ : jet_secp_square_columns.square_input_bounds b) (_ : not (@eq Values.block bo ba))
         (_ : not (@eq Values.block bo bb)) (_ : not (@eq Values.block ba bb))
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m zinv_az_statement Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bo BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_mul_storage.point_mul_words a b)))
               (and
                  (jet_secp_fe_nv.fe_at mf ba
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     (jet_secp_multiply_normalize_bridge.words5 a))
                  (and (jet_secp_fe_nv.fe_at mf bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
                     (and
                        (Memory.Mem.range_perm mf bo BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf ba BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bb BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (@eq BinNums.Z
                                    (BinInt.Z.modulo
                                       (jet_secp_multiply_finish_product.radix_value
                                          (jet_secp_point_mul_storage.point_mul_words a b)) jet_secp_fe_math.feP)
                                    (BinInt.Z.modulo
                                       (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                                          (jet_secp_multiply_finish_product.radix_value b)) jet_secp_fe_math.feP))
                                 (and
                                    (jet_secp_field_mul_small.mul_small_input_bounds
                                       (jet_secp_point_mul_storage.point_mul_words a b))
                                    (jet_sx_mem.lframe
                                       (fun (bx : Values.block) (pos : BinNums.Z) =>
                                        and (not (@eq Values.block bx bo))
                                          (and
                                             (or (not (@eq Values.block bx ba))
                                                (or
                                                   (BinInt.Z.lt pos
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...))))))))
                                                   (BinInt.Z.le
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))
                                                      pos))) (not (@eq Values.block bx bb)))) m mf))))))))))
### C.jet_secp_zinv_initial_products.zinv_az_statement
zinv_az_statement =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._az)
     (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._a jets_secp._z)
        (@cons Clight.expr (Clight.Etempvar jets_secp._bzinv (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
           (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_zinv_initial_products.zinv_finite_suffix
zinv_finite_suffix =
match Clight.fn_body jets_secp.f_secp256k1_gej_add_zinv_var return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ rest => rest
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_zinv_initial_products.zinv_after_az
zinv_after_az =
match zinv_finite_suffix return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ rest => rest
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_zinv_initial_products.zinv_z12_statement
zinv_z12_statement =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_sqr jets_secp.f_secp256k1_fe_sqr
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._z12)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._az) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_zinv_initial_products.zinv_after_z12
zinv_after_z12 =
match zinv_after_az return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ rest => rest
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
