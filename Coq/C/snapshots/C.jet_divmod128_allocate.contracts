### C.jet_divmod128_allocate.allocate_divmod128_locals
allocate_divmod128_locals
     : forall m : Memory.Mem.mem,
       @ex Memory.Mem.mem'
         (fun ma : Memory.Mem.mem' =>
          @ex Memory.Mem.mem'
            (fun mb : Memory.Mem.mem' =>
             @ex Memory.Mem.mem'
               (fun mc : Memory.Mem.mem' =>
                @ex Memory.Mem.mem'
                  (fun md : Memory.Mem.mem' =>
                   @ex Values.block
                     (fun bl : Values.block =>
                      @ex Values.block
                        (fun bqh : Values.block =>
                         @ex Values.block
                           (fun bql : Values.block =>
                            @ex Values.block
                              (fun br : Values.block =>
                               and
                                 (@eq (prod Memory.Mem.mem' Values.block)
                                    (Memory.Mem.alloc m BinNums.Z0
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    (@pair Memory.Mem.mem' Values.block ma bl))
                                 (and
                                    (@eq (prod Memory.Mem.mem' Values.block)
                                       (Memory.Mem.alloc ma BinNums.Z0
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                       (@pair Memory.Mem.mem' Values.block mb bqh))
                                    (and
                                       (@eq (prod Memory.Mem.mem' Values.block)
                                          (Memory.Mem.alloc mb BinNums.Z0
                                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                          (@pair Memory.Mem.mem' Values.block mc bql))
                                       (and
                                          (@eq (prod Memory.Mem.mem' Values.block)
                                             (Memory.Mem.alloc mc BinNums.Z0
                                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                             (@pair Memory.Mem.mem' Values.block md br))
                                          (and (divmod128_local_distinct bl bqh bql br)
                                             (and (divmod128_local_permissions md bl bqh bql br)
                                                (and
                                                   (forall (bb : Values.block) (_ : Memory.Mem.valid_block m bb),
                                                    and (not (@eq Values.block bb bl))
                                                      (and (not (@eq Values.block bb bqh)) (and (not ...) (not ...))))
                                                   (and
                                                      (forall (chunk : AST.memory_chunk) (bb : Values.block)
                                                         (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m bb),
                                                       @eq (option Values.val) (Memory.Mem.load chunk md bb ofs)
                                                         (Memory.Mem.load chunk m bb ofs))
                                                      (forall (bb : Values.block) (ofs : BinNums.Z)
                                                         (kind : Memtype.perm_kind) (p : Memtype.permission)
                                                         (_ : Memory.Mem.perm m bb ofs kind p),
                                                       Memory.Mem.perm md bb ofs kind p))))))))))))))))
### C.jet_divmod128_allocate.divmod128_local_slots_writable
divmod128_local_slots_writable
     : forall (m : Memory.Mem.mem) (bl bqh bql br : Values.block) (_ : divmod128_local_permissions m bl bqh bql br),
       and
         (Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
            Memtype.Writable)
         (and (Memory.Mem.valid_access m AST.Mint64 bqh BinNums.Z0 Memtype.Writable)
            (and (Memory.Mem.valid_access m AST.Mint64 bql BinNums.Z0 Memtype.Writable)
               (Memory.Mem.valid_access m AST.Mint64 br BinNums.Z0 Memtype.Writable)))
### C.jet_divmod128_allocate.divmod128_local_distinct
divmod128_local_distinct =
fun bl bqh bql br : Values.block =>
and (not (@eq Values.block bl bqh))
  (and (not (@eq Values.block bl bql))
     (and (not (@eq Values.block bl br))
        (and (not (@eq Values.block bqh bql)) (and (not (@eq Values.block bqh br)) (not (@eq Values.block bql br))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Prop

Arguments divmod128_local_distinct bl bqh bql br
### C.jet_divmod128_allocate.divmod128_local_permissions
divmod128_local_permissions =
fun (m : Memory.Mem.mem) (bl bqh bql br : Values.block) =>
and
  (Memory.Mem.range_perm m bl BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     Memtype.Cur Memtype.Freeable)
  (and
     (Memory.Mem.range_perm m bqh BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
        Memtype.Cur Memtype.Freeable)
     (and
        (Memory.Mem.range_perm m bql BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
           Memtype.Cur Memtype.Freeable)
        (Memory.Mem.range_perm m br BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
           Memtype.Cur Memtype.Freeable)))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Prop

Arguments divmod128_local_permissions m bl bqh bql br
