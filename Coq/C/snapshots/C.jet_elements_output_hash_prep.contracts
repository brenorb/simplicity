### C.jet_elements_output_hash_prep.eoh_output_ptr
eoh_output_ptr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (xp ip : BinNums.positive)
         (bin : Values.block) (inbase : BinNums.Z) (r : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val xp le)
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val ip le) (@Some Values.val (Values.Vlong r)))
         (_ : BinInt.Z.le BinNums.Z0 inbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add inbase
                   (BinInt.Z.mul
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                      (Integers.Int64.unsigned r))) Integers.Ptrofs.max_unsigned),
       Clight.eval_expr jet_elements_support_sha_linkage.sha_ge e le m
         (Clight.Ebinop Cop.Oadd
            (Clight.Etempvar xp (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))
            (Clight.Etempvar ip Ctypesdefs.tulong)
            (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))
         (Values.Vptr bin
            (Integers.Ptrofs.repr
               (BinInt.Z.add inbase
                  (BinInt.Z.mul
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                     (Integers.Int64.unsigned r)))))
### C.jet_elements_output_hash_prep.eoh_temps
eoh_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_elements._env env
  (@Maps.PTree.set Values.val jets_elements._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_elements._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_simplicity_output_hash))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments eoh_temps env bd dbase%Z_scope bs sbase%Z_scope
