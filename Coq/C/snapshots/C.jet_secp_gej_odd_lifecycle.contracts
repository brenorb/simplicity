### C.jet_secp_gej_odd_lifecycle.eval_gej_y_is_odd_initialized
eval_gej_y_is_odd_initialized
     : forall (envv : Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block) (edge cursor N : BinNums.Z)
         (bi : Values.block) (inedge rc : BinNums.Z) (x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : forall (mc : Memory.Mem.mem) (w : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned w) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong w) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned w)))))
         (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m0)
         (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le (BinNums.Zpos BinNums.xH) N) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m0 bs sbase bi inedge rc)
         (_ : jet_encoding.frame_input_cells_at m0 bi inedge rc
                (@List.map bool (option bool) (@Some bool)
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) x)))
         (_ : jet_encoding.frame_input_cells_at m0 bi inedge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                (@List.map bool (option bool) (@Some bool)
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) y)))
         (_ : jet_encoding.frame_input_cells_at m0 bi inedge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                (@List.map bool (option bool) (@Some bool)
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) z)))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                Integers.Int64.max_unsigned),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m0
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_gej_y_is_odd)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val envv (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                  (@Translate.encode (Ty.Sum Ty.Unit Ty.Unit)
                     (@jet_secp_gej_odd_literal.literal_gej_y_is_odd Alg.CoreFunSem
                        (@pair
                           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))))
               (and
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) => not (jet_secp_frame.extA m0 bd bw bi b)) m0 mf)
                  (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                     (jet_clight_internal_preserve.readonly_preserved m0 mf)))))
