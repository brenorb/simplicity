### C.jet_read_buffer8_call.buffer8_read_body_prefix
buffer8_read_body_prefix
     : @eq Clight.statement (Clight.fn_body jets.f_simplicity_read_buffer8)
         (Clight.Ssequence buffer8_read_assert
            (Clight.Ssequence
               (Clight.Sassign
                  (Clight.Ederef (Clight.Etempvar jets._len (Ctypesdefs.tptr Ctypesdefs.tulong)) Ctypesdefs.tulong)
                  (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))
               (Clight.Ssequence
                  (Clight.Sset jets._i
                     (Clight.Ebinop Cop.Oshl
                        (Clight.Ecast (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tulong)
                        (Clight.Etempvar jets._n Ctypesdefs.tint) Ctypesdefs.tulong))
                  jet_read_buffer8_exec.buffer8_read_loop)))
### C.jet_read_buffer8_call.eval_read_buffer8_from_loop
eval_read_buffer8_from_loop
     : forall (m mz mf : Memory.Mem.mem) (lef : Clight.temp_env) (bf : Values.block) (base : BinNums.Z)
         (bo : Values.block) (output : BinNums.Z) (bl : Values.block) (slot : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 slot) (BinInt.Z.le slot Integers.Ptrofs.max_unsigned))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.store AST.Mint64 m bl slot (Values.Vlong Integers.Int64.zero))
                (@Some Memory.Mem.mem mz))
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env
                (@Maps.PTree.set Values.val jets._i
                   (Values.Vlong
                      (Integers.Int64.repr
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                   (buffer8_read_temps bf base bo output bl slot)) mz jet_read_buffer8_exec.buffer8_read_loop Events.E0
                lef mf ClightBigstep.Out_normal),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_read_buffer8)
         (@cons Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))
            (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr slot))
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val
                     (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                     (@nil Values.val))))) Events.E0 mf Values.Vundef
### C.jet_read_buffer8_call.buffer8_read_assert
buffer8_read_assert =
match Clight.fn_body jets.f_simplicity_read_buffer8 return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence s _ => s
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_read_buffer8_call.buffer8_read_temps
buffer8_read_temps =
fun (bf : Values.block) (base : BinNums.Z) (bo : Values.block) (output : BinNums.Z) (bl : Values.block)
  (slot : BinNums.Z) =>
@Maps.PTree.set Values.val jets._n
  (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
  (@Maps.PTree.set Values.val jets._src (Values.Vptr bf (Integers.Ptrofs.repr base))
     (@Maps.PTree.set Values.val jets._len (Values.Vptr bl (Integers.Ptrofs.repr slot))
        (@Maps.PTree.set Values.val jets._buf (Values.Vptr bo (Integers.Ptrofs.repr output))
           (Clight.create_undef_temps (Clight.fn_temps jets.f_simplicity_read_buffer8)))))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z),
       Maps.PTree.tree Values.val

Arguments buffer8_read_temps bf base%Z_scope bo output%Z_scope bl slot%Z_scope
