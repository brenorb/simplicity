### C.jet_secp_u128_layout.secp_u128_composite_fields
secp_u128_composite_fields
     : @ex Ctypes.composite
         (fun co : Ctypes.composite =>
          and
            (@eq (option Ctypes.composite)
               (@Maps.PTree.get Ctypes.composite jets_secp._secp256k1_uint128
                  (Clight.genv_cenv jet_secp_linkage.secp_ge)) (@Some Ctypes.composite co))
            (and (@eq Ctypes.struct_or_union (Ctypes.co_su co) Ctypes.Struct)
               (@eq Ctypes.members (Ctypes.co_members co)
                  (@cons Ctypes.member (Ctypes.Member_plain jets_secp._lo Ctypesdefs.tulong)
                     (@cons Ctypes.member (Ctypes.Member_plain jets_secp._hi Ctypesdefs.tulong) (@nil Ctypes.member))))))
