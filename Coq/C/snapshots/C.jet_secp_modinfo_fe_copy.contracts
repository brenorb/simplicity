### C.jet_secp_modinfo_fe_copy.modinfo_fe_first_five
modinfo_fe_first_five
     : @eq (list Integers.Int64.int) (jet_secp_multiply_normalize_bridge.words5 modinfo_fe_limb)
         (@cons Integers.Int64.int
            (Integers.Int64.repr
               (BinNums.Zneg
                  (BinNums.xI
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xI
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO
                                                                     (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))))
            (@cons Integers.Int64.int Integers.Int64.zero
               (@cons Integers.Int64.int Integers.Int64.zero
                  (@cons Integers.Int64.int Integers.Int64.zero
                     (@cons Integers.Int64.int
                        (Integers.Int64.repr
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                        (@nil Integers.Int64.int))))))
### C.jet_secp_modinfo_fe_copy.eval_signed62_assign_modinfo
eval_signed62_assign_modinfo
     : forall (m : Memory.Mem.mem) (bd : Values.block) (_ : jet_secp_modinfo_fe_global.modinfo_fe_global_rep m)
         (_ : not (@eq Values.block bd jet_secp_modinfo_fe_global.modinfo_fe_block))
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_signed62_assign)
               (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr jet_secp_modinfo_fe_global.modinfo_fe_block Integers.Ptrofs.zero)
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf bd BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 modinfo_fe_limb))
               (and
                  (Memory.Mem.range_perm mf bd BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_secp_modinfo_fe_global.modinfo_fe_global_rep mf)
                     (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m mf)))))
### C.jet_secp_modinfo_fe_copy.modinfo_fe_limb
modinfo_fe_limb =
fun i : nat => @List.nth Integers.Int64.int i jet_secp_modinfo_fe_global.modinfo_fe_words Integers.Int64.zero
     : forall _ : nat, Integers.Int64.int

Arguments modinfo_fe_limb i%nat_scope
