### C.jet_secp_table_affine_seed.table_modulo_residue
table_modulo_residue
     : forall a : BinNums.Z, Zdiv.eqm jet_secp_fe_math.feP (BinInt.Z.modulo a jet_secp_fe_math.feP) a
### C.jet_secp_table_affine_seed.table_half_inverse
table_half_inverse
     : Zdiv.eqm jet_secp_fe_math.feP (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) table_half)
         (BinNums.Zpos BinNums.xH)
### C.jet_secp_table_affine_seed.table_prime_residue
table_prime_residue
     : Zdiv.eqm jet_secp_fe_math.feP jet_secp_fe_math.feP BinNums.Z0
### C.jet_secp_table_affine_seed.literal_table_halve_residue
literal_table_halve_residue
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       Zdiv.eqm jet_secp_fe_math.feP
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_double_literal.literal_fe_halve Alg.CoreFunSem a))
         (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a) table_half)
### C.jet_secp_table_affine_seed.literal_table_add_residue
literal_table_add_residue
     : forall (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (u v : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a) u)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b) v),
       Zdiv.eqm jet_secp_fe_math.feP
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))) (BinInt.Z.add u v)
### C.jet_secp_table_affine_seed.literal_table_mul_residue
literal_table_mul_residue
     : forall (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (u v : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a) u)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b) v),
       Zdiv.eqm jet_secp_fe_math.feP
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))) (BinInt.Z.mul u v)
### C.jet_secp_table_affine_seed.literal_table_square_residue
literal_table_square_residue
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (u : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a) u),
       Zdiv.eqm jet_secp_fe_math.feP
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem a)) (BinInt.Z.mul u u)
### C.jet_secp_table_affine_seed.literal_table_scale_residue
literal_table_scale_residue
     : forall (n : BinNums.Z) (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (u : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a) u),
       Zdiv.eqm jet_secp_fe_math.feP
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_double_literal.literal_fe_multiply_int n Alg.CoreFunSem a)) (BinInt.Z.mul n u)
### C.jet_secp_table_affine_seed.literal_table_negate_residue
literal_table_negate_residue
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (u : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a) u),
       Zdiv.eqm jet_secp_fe_math.feP
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem a)) (BinInt.Z.opp u)
### C.jet_secp_table_affine_seed.literal_table_affine_curve
literal_table_affine_curve
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))) true),
       Zdiv.eqm jet_secp_fe_math.feP
         (table_curve_s (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
         (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))
### C.jet_secp_table_affine_seed.literal_table_affine_coordinates_nonzero
literal_table_affine_coordinates_nonzero
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))) true),
       and (@eq bool (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem x)) false)
         (@eq bool (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem y)) false)
