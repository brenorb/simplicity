### C.jet_secp_table_affine_seed.table_half
table_half =
BinInt.Z.div (BinInt.Z.add jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH)) (BinNums.Zpos (BinNums.xO BinNums.xH))
     : BinNums.Z
### C.jet_secp_table_affine_seed.table_curve_s
table_curve_s =
fun x : BinNums.Z =>
BinInt.Z.add (BinInt.Z.mul (BinInt.Z.mul x x) x) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))
     : forall _ : BinNums.Z, BinNums.Z

Arguments table_curve_s x%Z_scope
### C.jet_secp_table_affine_seed.table_double_slope
table_double_slope =
fun x : BinNums.Z => BinInt.Z.mul (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) x) x) table_half
     : forall _ : BinNums.Z, BinNums.Z

Arguments table_double_slope x%Z_scope
### C.jet_secp_table_affine_seed.table_double_x
table_double_x =
fun x : BinNums.Z =>
BinInt.Z.sub (BinInt.Z.mul (table_double_slope x) (table_double_slope x))
  (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) x) (table_curve_s x))
     : forall _ : BinNums.Z, BinNums.Z

Arguments table_double_x x%Z_scope
### C.jet_secp_table_affine_seed.table_double_y
table_double_y =
fun x : BinNums.Z =>
BinInt.Z.sub
  (BinInt.Z.mul (table_double_slope x)
     (BinInt.Z.sub (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) x) (table_curve_s x))
        (BinInt.Z.mul (table_double_slope x) (table_double_slope x))))
  (BinInt.Z.mul (table_curve_s x) (table_curve_s x))
     : forall _ : BinNums.Z, BinNums.Z

Arguments table_double_y x%Z_scope
