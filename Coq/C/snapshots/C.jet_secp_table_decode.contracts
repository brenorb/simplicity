### C.jet_secp_table_decode.storage_unpack_machine_limbs
storage_unpack_machine_limbs
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int)
         (jet_secp_multiply_normalize_bridge.words5 (jet_secp_storage_unpack.storage_unpack_words w))
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_fe_math.fe_limbs_of (jet_secp_storage_numeric.field_storage_value w)))
### C.jet_secp_table_decode.field_storage_value_bounds
field_storage_value_bounds
     : forall w : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (jet_secp_storage_numeric.field_storage_value w))
         (BinInt.Z.lt (jet_secp_storage_numeric.field_storage_value w)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_table_decode.affine_storage_readable_lframe
affine_storage_readable_lframe
     : forall (w : forall _ : nat, Integers.Int64.int) (m mf : Memory.Mem.mem) (bin : Values.block)
         (sbase : BinNums.Z) (P : forall (_ : Values.block) (_ : BinNums.Z), Prop)
         (_ : jet_secp_affine_storage.affine_storage_readable m bin sbase w) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall pos : BinNums.Z, P bin pos), jet_secp_affine_storage.affine_storage_readable mf bin sbase w
### C.jet_secp_table_decode.eval_table_decode_signed
eval_table_decode_signed
     : forall (neg : bool) (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (sbase lo hi : BinNums.Z) (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_affine_storage.affine_storage_readable m bin sbase w)
         (_ : jet_clight_readonly_frame.readonly_region_bounds m bin lo hi),
       @ex Memory.Mem.mem
         (fun md : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_from_storage)
                  (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr sbase)) (@nil Values.val))) Events.E0 md
                  Values.Vundef)
               (and
                  match neg return Prop with
                  | true =>
                      ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge md
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
                        (@cons Values.val
                           (Values.Vptr bout
                              (Integers.Ptrofs.repr
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@cons Values.val
                              (Values.Vptr bout
                                 (Integers.Ptrofs.repr
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                              (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf
                        Values.Vundef
                  | false => @eq Memory.Mem.mem mf md
                  end
                  (and
                     (Memory.Mem.range_perm mf bout BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (forall k : bool,
                         jet_secp_fe_nv.fe_at mf bout
                           match k return BinNums.Z with
                           | true =>
                               BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                           | false => BinNums.Z0
                           end (table_signed_coordinate w neg k))
                        (and
                           (@eq (option Values.val)
                              (Memory.Mem.load AST.Mint32 mf bout
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                              (@Some Values.val (Values.Vint Integers.Int.zero)))
                           (and (jet_secp_affine_storage.affine_storage_readable mf bin sbase w)
                              (and (jet_clight_readonly_frame.readonly_region_bounds mf bin lo hi)
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (pos : BinNums.Z) =>
                                     or (not (@eq Values.block b bout))
                                       (or (BinInt.Z.lt pos BinNums.Z0)
                                          (BinInt.Z.le
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                             pos))) m mf)))))))))
### C.jet_secp_table_decode.table_negative_y
table_negative_y =
fun w : forall _ : nat, Integers.Int64.int =>
jet_secp_field_negate_storage.negate_values
  (jet_secp_write_fe_numeric.write_fe_rho
     (jet_secp_storage_numeric.field_storage_value (fun i : nat => w (Nat.add (S (S (S (S O)))) i))) BinNums.Z0)
     : forall _ : forall _ : nat, Integers.Int64.int, list Integers.Int64.int

Arguments table_negative_y w%function_scope
### C.jet_secp_table_decode.table_signed_coordinate
table_signed_coordinate =
fun (w : forall _ : nat, Integers.Int64.int) (neg k : bool) =>
match k return (list Integers.Int64.int) with
| true =>
    match neg return (list Integers.Int64.int) with
    | true => table_negative_y w
    | false => jet_secp_multiply_normalize_bridge.words5 (jet_secp_affine_storage.affine_storage_coord w true)
    end
| false => jet_secp_multiply_normalize_bridge.words5 (jet_secp_affine_storage.affine_storage_coord w false)
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool) (_ : bool), list Integers.Int64.int

Arguments table_signed_coordinate w%function_scope (neg k)%bool_scope
