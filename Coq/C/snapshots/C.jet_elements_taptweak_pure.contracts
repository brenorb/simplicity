### C.jet_elements_taptweak_pure.elements_taptweak_sha_pure_lookup
elements_taptweak_sha_pure_lookup
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef)
            (jet_secp_linkage.secp_helper_lookup elements_taptweak_ge)
            jet_secp_sha_pure_transport.secp_sha_pure_helpers)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun p : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p)))
            jet_secp_sha_pure_transport.secp_sha_pure_helpers)
### C.jet_elements_taptweak_pure.elements_taptweak_sha_pure_checked
elements_taptweak_sha_pure_checked
     : @eq bool
         (@List.forallb (prod AST.ident Clight.function)
            (fun p : prod AST.ident Clight.function =>
             jet_transport.fundef_okb jet_secp_linkage.secp_ge elements_taptweak_ge
               (@List.map (prod AST.ident Clight.function) AST.ident (@fst AST.ident Clight.function)
                  jet_secp_sha_pure_transport.secp_sha_pure_helpers)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p)))
            jet_secp_sha_pure_transport.secp_sha_pure_helpers) true
### C.jet_elements_taptweak_pure.elements_taptweak_sha_pure_entries
elements_taptweak_sha_pure_entries
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f)
                jet_secp_sha_pure_transport.secp_sha_pure_helpers),
       @ex Values.block
         (fun b1 : Values.block =>
          @ex Values.block
            (fun b2 : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                     id) (@Some Values.block b1))
               (and
                  (@eq (option Clight.fundef)
                     (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type
                        (Clight.genv_genv jet_secp_linkage.secp_ge) b1)
                     (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))
                  (and
                     (@eq (option Values.block)
                        (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv elements_taptweak_ge)
                           id) (@Some Values.block b2))
                     (@eq (option Clight.fundef)
                        (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type
                           (Clight.genv_genv elements_taptweak_ge) b2)
                        (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))))))
### C.jet_elements_taptweak_pure.elements_taptweak_sha_pure_ok
elements_taptweak_sha_pure_ok
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f)
                jet_secp_sha_pure_transport.secp_sha_pure_helpers),
       @eq bool
         (jet_transport.fundef_okb jet_secp_linkage.secp_ge elements_taptweak_ge
            (@List.map (prod AST.ident Clight.function) AST.ident (@fst AST.ident Clight.function)
               jet_secp_sha_pure_transport.secp_sha_pure_helpers) (@Ctypes.Internal Clight.function f)) true
### C.jet_elements_taptweak_pure.elements_taptweak_sha_transport
elements_taptweak_sha_transport
     : forall (id : AST.ident) (f : Clight.function) (m : Memory.Mem.mem) (args : list Values.val)
         (trace : Events.trace) (mf : Memory.Mem.mem) (result : Values.val)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f)
                jet_secp_sha_pure_transport.secp_sha_pure_helpers)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m (@Ctypes.Internal Clight.function f) args
                trace mf result),
       ClightBigstep.Clight2.eval_funcall elements_taptweak_ge m (@Ctypes.Internal Clight.function f) args trace mf
         result
### C.jet_elements_taptweak_pure.eval_elements_taptweak_sha_init_owned
eval_elements_taptweak_sha_init_owned
     : forall (m : Memory.Mem.mem) (bc bs : Values.block) (_ : not (@eq Values.block bc bs))
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_sha256_init)
               (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                  (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val (Values.Vlong Integers.Int64.zero)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint8unsigned mf bc
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0 jet_sha256_iv_init.sha256_iv_words)
                        (and
                           (Memory.Mem.range_perm mf bc BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bs BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bc)) (not (@eq Values.block b bs))) m mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
### C.jet_elements_taptweak_pure.eval_elements_taptweak_sha_digest_owned
eval_elements_taptweak_sha_digest_owned
     : forall (regs : list Integers.Int.int) (m : Memory.Mem.mem) (bb bs : Values.block)
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : not (@eq Values.block bb bs)) (_ : jet_uint32_array_init.uint32_array_at m bs BinNums.Z0 regs)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_sha256_fromMidstate)
               (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))),
                @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned mf bb (BinInt.Z.of_nat i))
                  (@Some Values.val
                     (Values.Vint
                        (Integers.Int.repr
                           (@List.nth BinNums.Z i (jet_secp_sha_owned.secp_sha_digest_bytes regs) BinNums.Z0)))))
               (and (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0 regs)
                  (and
                     (Memory.Mem.range_perm mf bb BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bs BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bb)) m
                              mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))
