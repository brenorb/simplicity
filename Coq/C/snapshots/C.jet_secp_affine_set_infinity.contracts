         Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_affine_set_infinity.eval_affine_set_infinity_owned
eval_affine_set_infinity_owned
     : forall (m : Memory.Mem.mem) (b : Values.block)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_infinity)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b BinNums.Z0
                  (@List.repeat Integers.Int64.int Integers.Int64.zero (S (S (S (S (S O)))))))
               (and
                  (jet_secp_fe_nv.fe_at mf b
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (@List.repeat Integers.Int64.int Integers.Int64.zero (S (S (S (S (S O)))))))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf b
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.one)))
                     (and
                        (Memory.Mem.range_perm mf b BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b))
                              m mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))
### C.jet_secp_affine_set_infinity.affine_infinity_store
affine_infinity_store =
match Clight.fn_body jets_secp.f_secp256k1_ge_set_infinity return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence flag _ => flag
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_affine_set_infinity.affine_infinity_clear
affine_infinity_clear =
fun second : bool =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_clear jets_secp.f_secp256k1_fe_clear
  (@None AST.ident)
  (@cons Clight.expr
     (Clight.Eaddrof
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_secp._r (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6121 Ctypes.noattr)))
              (Ctypes.Tstruct jets_secp.__6121 Ctypes.noattr))
           match second return AST.ident with
           | true => jets_secp._y
           | false => jets_secp._x
           end (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))) (@nil Clight.expr))
     : forall _ : bool, Clight.statement

Arguments affine_infinity_clear second%bool_scope
