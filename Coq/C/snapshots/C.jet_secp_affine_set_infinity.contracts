### C.jet_secp_affine_set_infinity.exec_affine_infinity_clear
exec_affine_infinity_clear
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (b : Values.block)
         (second : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
