### C.jet_elements_issuance_computed_exec.computed_issuance_present
computed_issuance_present =
fun v : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
match v return bool with
| inl _ => false
| inr _ => true
end
     : forall _ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))), bool

