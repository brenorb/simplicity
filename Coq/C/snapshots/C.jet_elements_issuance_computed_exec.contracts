### C.jet_elements_issuance_computed_exec.computed_issuance_hash_rep
computed_issuance_hash_rep =
fun (delta : BinNums.Z)
  (value : forall _ : jet_elements_prim.sigTxInput,
           Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (m : Memory.Mem.mem)
  (b : Values.block) (ofs : BinNums.Z) (txi : jet_elements_prim.sigTxInput) =>
and (jet_elements_issuance_status_exec.issuance_status_enum_rep m b ofs txi)
  (forall
     (h : prod
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end)
               ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                   match n return Ty.Ty with
                   | O => X
                   | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                   end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end)
               ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                   match n return Ty.Ty with
                   | O => X
                   | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                   end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
     (_ : @eq (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (value txi)
            (@inr unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                         match n return Ty.Ty with
                         | O => X
                         | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                         end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                         match n return Ty.Ty with
                         | O => X
                         | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                         end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) h)),
   jet_uint32_array_init.uint32_array_at m b
     (BinInt.Z.add
        (BinInt.Z.add ofs
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
        delta) (Digest.hash256_reg (Word.to_hash256 h)))
     : forall (_ : BinNums.Z)
         (_ : forall _ : jet_elements_prim.sigTxInput,
              Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (_ : Memory.Mem.mem)
         (_ : Values.block) (_ : BinNums.Z) (_ : jet_elements_prim.sigTxInput), Prop

Arguments computed_issuance_hash_rep delta%Z_scope value%function_scope m b ofs%Z_scope txi
