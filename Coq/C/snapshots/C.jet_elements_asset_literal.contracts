### C.jet_elements_asset_literal.packed_fe_to_word_literal_matches
packed_fe_to_word_literal_matches
     : forall packed : Digest.hash256,
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
            (packed_fe_integer_literal packed)) (Word.from_hash256 packed)
### C.jet_elements_asset_literal.encode_confidential_literal_matches
@encode_confidential_literal_matches
     : forall (A : Set) (B : Ty.Ty) (old literal : forall _ : A, Ty.tySem B)
         (c : jet_elements_prim.confidential unit A) (_ : forall x : A, @eq (Ty.tySem B) (old x) (literal x)),
       @eq (Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B))
         match
           c
           return
             (Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B))
         with
         | jet_elements_prim.Explicit x =>
             @inr
               (prod (sum unit unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.tySem B) (old x)
         | jet_elements_prim.Confidential pt _ =>
             match
               pt
               return
                 (Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B))
             with
             | jet_elements_prim.Point odd packed =>
                 @inl (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) B)
                   (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      match odd return (sum unit unit) with
                      | true => @inr unit unit tt
                      | false => @inl unit unit tt
                      end (Word.from_hash256 packed))
             end
         end (@encode_confidential_literal A B literal c)
### C.jet_elements_asset_literal.encode_asset_literal_matches
encode_asset_literal_matches
     : forall a : jet_elements_prim.assetWith unit,
       @eq
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (jet_elements_asset_jets.encode_asset a)
         (encode_asset_literal a)
