### C.jet_elements_asset_literal.packed_fe_integer_literal
packed_fe_integer_literal =
fun packed : Digest.hash256 =>
jet_haskell_hash_word.haskell_word256_integer
  (jet_haskell_hash_word.haskell_be256_run (Digest.hash256_to_bytelist packed)
     (jet_haskell_hash_word.haskell_word256_from_integer BinNums.Z0))
     : forall _ : Digest.hash256, BinNums.Z

Arguments packed_fe_integer_literal packed
### C.jet_elements_asset_literal.encode_confidential_literal
encode_confidential_literal =
fun (A : Set) (B : Ty.Ty) (enc : forall _ : A, Ty.tySem B) (c : jet_elements_prim.confidential unit A) =>
match
  c return (Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B))
with
| jet_elements_prim.Explicit x =>
    @inr
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
             end) (Ty.Sum Ty.Unit Ty.Unit))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.tySem B) (enc x)
| jet_elements_prim.Confidential pt _ =>
    match
      pt return (Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B))
    with
    | jet_elements_prim.Point odd packed =>
        @inl (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
          ((fix tySem (X : Ty.Ty) : Set :=
              match X return Set with
              | Ty.Unit => unit
              | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
              | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
              end) B)
          (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             match odd return (sum unit unit) with
             | true => @inr unit unit tt
             | false => @inl unit unit tt
             end
             (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
                (packed_fe_integer_literal packed)))
    end
end
     : forall (A : Set) (B : Ty.Ty) (_ : forall _ : A, Ty.tySem B) (_ : jet_elements_prim.confidential unit A),
       Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B)

Arguments encode_confidential_literal {A}%type_scope {B}%ty_scope enc%function_scope c
### C.jet_elements_asset_literal.encode_asset_literal
encode_asset_literal =
fun a : jet_elements_prim.assetWith unit =>
@encode_confidential_literal Digest.hash256 (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (fun h : Digest.hash256 =>
   jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
     (jet_haskell_hash_word.haskell_integer_hash256 (Digest.hash256_to_bytelist h))) a
     : forall _ : jet_elements_prim.assetWith unit,
       Ty.tySem
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments encode_asset_literal a
### C.jet_elements_asset_literal.elements_input_asset_literal_spec
elements_input_asset_literal_spec =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
@jet_elements_output_nonce_literal.word_indexed_value_literal jet_elements_prim.sigTxInput
  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (S (S (S (S (S O)))))
  (fun txi : jet_elements_prim.sigTxInput =>
   encode_asset_literal (jet_elements_prim.utxoAsset (jet_elements_prim.sigTxiTxo txi)))
  (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment)) a
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       option
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))))

Arguments elements_input_asset_literal_spec a environment
### C.jet_elements_asset_literal.elements_output_asset_literal_spec
elements_output_asset_literal_spec =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
@jet_elements_output_nonce_literal.word_indexed_value_literal jet_elements_prim.txOutput
  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (S (S (S (S (S O)))))
  (fun txo : jet_elements_prim.txOutput =>
   encode_asset_literal
     (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256 (jet_elements_prim.txoAsset txo)))
  (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment)) a
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       option
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))))

Arguments elements_output_asset_literal_spec a environment
### C.jet_elements_asset_literal.elements_current_asset_literal_spec
elements_current_asset_literal_spec =
@jet_elements_current_sequence_literal.elements_current_literal_result
  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O)))))))))) elements_input_asset_literal_spec
     : forall (_ : Ty.tySem Ty.Unit) (_ : jet_elements_prim.Elements.env),
       option
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments elements_current_asset_literal_spec _ environment
