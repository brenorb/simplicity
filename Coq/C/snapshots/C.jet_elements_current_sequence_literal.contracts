### C.jet_elements_current_sequence_literal.elements_current_literal_sem
@elements_current_literal_sem
     : forall (B : Ty.Ty)
         (p
          q : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
              option (Ty.tySem (Ty.Sum Ty.Unit B)))
         (_ : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : jet_elements_prim.Elements.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit B))) (p a e) (q a e)) (a : Ty.tySem Ty.Unit)
         (environment : jet_elements_prim.Elements.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B))
         (@jet_elements_current_spec.elements_current_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) B p a
            environment) (@elements_current_literal_result B q a environment)
### C.jet_elements_current_sequence_literal.elements_current_sequence_literal_matches
elements_current_sequence_literal_matches
     : forall (a : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (@jet_elements_current_jets.elements_current_sequence_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment) (elements_current_sequence_literal_spec a environment)
### C.jet_elements_current_sequence_literal.elements_current_sequence_literal_local_spec
elements_current_sequence_literal_local_spec
     : jet_application_contract.application_jet_local_spec jets_elements.f_simplicity_current_sequence
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
         (@jet_elements_current_jets.current_scalar_rep jet_elements_prim.sigTxInput
            (fun e : jet_elements_prim.Elements.env => jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
            (fun txi : jet_elements_prim.sigTxInput => Integers.Int.unsigned (jet_elements_prim.sigTxiSequence txi))
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
            (BinNums.Zpos
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
            BinNums.Z0
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
         elements_current_sequence_literal_spec
### C.jet_elements_current_sequence_literal.elements_current_literal_result
elements_current_literal_result =
fun (B : Ty.Ty)
  (p : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem (Ty.Sum Ty.Unit B))) (_ : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env) =>
match
  p
    (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S O)))))
       (BinInt.Z.of_nat (jet_elements_prim.Elements.envIx environment))) environment return (option (Ty.tySem B))
with
| Some t =>
    match t return (option (Ty.tySem B)) with
    | inl _ => @None (Ty.tySem B)
    | inr value =>
        @Some
          ((fix tySem (X : Ty.Ty) : Set :=
              match X return Set with
              | Ty.Unit => unit
              | Ty.Sum A B0 => sum (tySem A) (tySem B0)
              | Ty.Prod A B0 => prod (tySem A) (tySem B0)
              end) B) value
    end
| None => @None (Ty.tySem B)
end
     : forall (B : Ty.Ty)
         (_ : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
              option (Ty.tySem (Ty.Sum Ty.Unit B))) (_ : Ty.tySem Ty.Unit) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem B)

Arguments elements_current_literal_result {B}%ty_scope p%function_scope _ environment
### C.jet_elements_current_sequence_literal.elements_current_sequence_literal_spec
elements_current_sequence_literal_spec =
@elements_current_literal_result (Word.Word (S (S (S (S (S O))))))
  jet_elements_sequence_literal.elements_input_sequence_literal_spec
     : forall (_ : Ty.tySem Ty.Unit) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem (Word.Word (S (S (S (S (S O)))))))

Arguments elements_current_sequence_literal_spec _ environment
