### C.jet_elements_single_issuance_jet.elements_single_issuance_hash_program_local_spec
elements_single_issuance_hash_program_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_issuance_hash
         jet_elements_support_sha_linkage.sha_ge jet_elements_prim.Elements.env (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) elements_single_issuance_hash_rep
         (fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : jet_elements_prim.Elements.env) =>
