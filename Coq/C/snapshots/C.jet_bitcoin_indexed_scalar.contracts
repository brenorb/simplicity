### C.jet_bitcoin_indexed_scalar.indexed_scalar_result
indexed_scalar_result =
fun (A : Type) (s : jet_wide.wide_size) (elems : list A)
  (specv : forall _ : A, Ty.tySem (Word.Word (jet_wide.wide_log s))) (a : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
=>
match
  @List.nth_error A elems (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s))))
with
| Some x => @inr unit (Ty.tySem (Word.Word (jet_wide.wide_log s))) (specv x)
| None =>
    @inl unit
      ((fix tySem (X : Ty.Ty) : Set :=
          match X return Set with
          | Ty.Unit => unit
          | Ty.Sum A0 B => sum (tySem A0) (tySem B)
          | Ty.Prod A0 B => prod (tySem A0) (tySem B)
          end) (Word.Word (jet_wide.wide_log s))) tt
end
     : forall (A : Type) (s : jet_wide.wide_size) (_ : list A)
         (_ : forall _ : A, Ty.tySem (Word.Word (jet_wide.wide_log s)))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))), Ty.tySem (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s)))

Arguments indexed_scalar_result {A}%type_scope s elems%list_scope specv%function_scope a
### C.jet_bitcoin_indexed_scalar.toZ32
toZ32 =
fun a : Ty.tySem (Word.Word (S (S (S (S (S O)))))) => @Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a
     : forall _ : Ty.tySem (Word.Word (S (S (S (S (S O)))))), BinNums.Z

Arguments toZ32 a
### C.jet_bitcoin_indexed_scalar.indexed_scalar_rep
indexed_scalar_rep =
fun (A : Type) (elems_of : forall _ : Bitcoin.Bitcoin.env, list A) (valz : forall _ : A, BinNums.Z)
  (sz voff adelta cdelta : BinNums.Z) (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Values.block
              (fun bin : Values.block =>
               @ex BinNums.Z
                 (fun inbase : BinNums.Z =>
                  @ex Integers.Int64.int
                    (fun nI : Integers.Int64.int =>
                     and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                       (and (BinInt.Z.le BinNums.Z0 ebase)
                          (and
                             (BinInt.Z.le
                                (BinInt.Z.add ebase
                                   (BinNums.Zpos
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                Integers.Ptrofs.max_unsigned)
                             (and (BinInt.Z.le BinNums.Z0 txbase)
                                (and
                                   (BinInt.Z.le
                                      (BinInt.Z.add txbase
                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))
                                      Integers.Ptrofs.max_unsigned)
                                   (and (BinInt.Z.le BinNums.Z0 inbase)
                                      (and
                                         (BinInt.Z.le
                                            (BinInt.Z.add inbase (BinInt.Z.mul sz (BinInt.Z.of_nat (@length A (...)))))
                                            Integers.Ptrofs.max_unsigned)
                                         (and
                                            (@eq (option Values.val)
                                               (Memory.Mem.load AST.Mptr m be (BinInt.Z.add ebase BinNums.Z0))
                                               (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                                            (and
                                               (@eq (option Values.val)
                                                  (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add txbase adelta))
                                                  (@Some Values.val (Values.Vptr bin (...))))
                                               (and
                                                  (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (...))
                                                     (@Some Values.val (...)))
                                                  (and (@eq BinNums.Z (...) (...)) (and (...) (...)))))))))))))))))))
     : forall (A : Type) (_ : forall _ : Bitcoin.Bitcoin.env, list A) (_ : forall _ : A, BinNums.Z)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Memory.Mem.mem)
         (_ : Values.val) (_ : Bitcoin.Bitcoin.env) (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments indexed_scalar_rep {A}%type_scope (elems_of valz)%function_scope (sz voff adelta cdelta)%Z_scope
  m env environment fp%list_scope
