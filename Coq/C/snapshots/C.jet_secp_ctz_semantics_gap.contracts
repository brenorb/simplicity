### C.jet_secp_ctz_semantics_gap.secp_statement_callees
secp_statement_callees =
fix secp_statement_callees (s : Clight.statement) : list AST.ident :=
  match s return (list AST.ident) with
  | Clight.Sskip => @nil AST.ident
  | Clight.Sassign _ _ => @nil AST.ident
  | Clight.Sset _ _ => @nil AST.ident
  | Clight.Scall _ e _ =>
      match e return (list AST.ident) with
      | Clight.Econst_int _ _ => @nil AST.ident
      | Clight.Econst_float _ _ => @nil AST.ident
      | Clight.Econst_single _ _ => @nil AST.ident
      | Clight.Econst_long _ _ => @nil AST.ident
      | Clight.Evar id _ => @cons AST.ident id (@nil AST.ident)
      | Clight.Etempvar _ _ => @nil AST.ident
      | Clight.Ederef _ _ => @nil AST.ident
      | Clight.Eaddrof _ _ => @nil AST.ident
      | Clight.Eunop _ _ _ => @nil AST.ident
      | Clight.Ebinop _ _ _ _ => @nil AST.ident
      | Clight.Ecast _ _ => @nil AST.ident
      | Clight.Efield _ _ _ => @nil AST.ident
      | Clight.Esizeof _ _ => @nil AST.ident
      | Clight.Ealignof _ _ => @nil AST.ident
      end
  | Clight.Sbuiltin _ _ _ _ => @nil AST.ident
  | Clight.Ssequence a b => @app AST.ident (secp_statement_callees a) (secp_statement_callees b)
  | Clight.Sifthenelse _ a b => @app AST.ident (secp_statement_callees a) (secp_statement_callees b)
  | Clight.Sloop a b => @app AST.ident (secp_statement_callees a) (secp_statement_callees b)
  | Clight.Sbreak => @nil AST.ident
  | Clight.Scontinue => @nil AST.ident
  | Clight.Sreturn _ => @nil AST.ident
  | Clight.Sswitch _ _ => @nil AST.ident
  | Clight.Slabel _ _ => @nil AST.ident
  | Clight.Sgoto _ => @nil AST.ident
  end
     : forall _ : Clight.statement, list AST.ident

Arguments secp_statement_callees s
