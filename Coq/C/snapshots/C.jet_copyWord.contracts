### C.jet_copyWord.copy_word_storebytes_effect
copy_word_storebytes_effect
     : forall (m m' : Memory.Mem.mem) (bi : Values.block) (src : BinNums.Z) (bw : Values.block)
         (dst : BinNums.Z) (v : Integers.Int64.int) (bytes : list Memdata.memval)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bi src) (@Some Values.val (Values.Vlong v)))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bi src (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bw dst bytes) (@Some Memory.Mem.mem m'))
         (_ : BinInt.Z.divide (Memdata.align_chunk AST.Mint64) dst),
       and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m' bw dst) (@Some Values.val (Values.Vlong v)))
         (and
            (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
               (_ : or (not (@eq Values.block b bw))
                      (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) dst)
                         (BinInt.Z.le
                            (BinInt.Z.add dst (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
             @eq (option Values.val) (Memory.Mem.load chunk m' b ofs) (Memory.Mem.load chunk m b ofs))
            (and
               (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                  (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm m' b ofs kind p)
               (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))
