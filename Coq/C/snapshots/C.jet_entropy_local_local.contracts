Arguments entropy_word_spec h ix con
### C.jet_entropy_local_local.entropy_jet_local_spec
entropy_jet_local_spec =
forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
  (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor rc : BinNums.Z)
  (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (ix : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
  (con : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (_ : @eq (option Values.val)
         (Memory.Mem.load AST.Mptr m
            (jet_elements_linkage.elements_symbol_block jets_elements._simplicity_sha256_compression) BinNums.Z0)
         (@Some Values.val
            (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._sha256_compression_portable)
               Integers.Ptrofs.zero)))
  (_ : @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (jet_elements_linkage.elements_symbol_block jets_elements._sha256_max_counter)
            BinNums.Z0) (@Some Values.val (Values.Vlong jet_elements_support_sha_uchars_exec.sha_max_counter)))
  (_ : jet_frame_layout.frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc) (_ : BinInt.Z.le BinNums.Z0 rc)
  (_ : BinInt.Z.le
         (BinInt.Z.add rc
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         Integers.Int64.max_unsigned)
  (_ : jet_encoding.frame_input_cells_at m bi edge rc
         (@Translate.encode jet_entropy_frame_read.entropy_input_type
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S O))))))) h ix) con)))
  (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
         (BinNums.Zpos
            (BinNums.xO
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
        (@Ctypes.Internal Clight.function jets_elements.f_simplicity_calculate_issuance_entropy)
        (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
           (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
        Events.E0 mf (Values.Vint Integers.Int.one))
     (and
        (jet_encoding.frame_output_cells_at mf bw outedge cursor
           (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (entropy_word_spec h ix con)))
        (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
           (and
              (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                 (BinInt.Z.sub cursor
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
              (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                 (_ : or (not (@eq Values.block b bd))
                        (or
                           (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                              (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (BinInt.Z.le
                              (BinInt.Z.add dbase
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                 (_ : or (not (@eq Values.block b bw))
                        (or
                           (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                              (BinInt.Z.add outedge
                                 (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                    (BinInt.Z.div
                                       (BinInt.Z.sub cursor
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                           (BinInt.Z.le
                              (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
               @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))))))
     : Prop
