                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
  (BinNums.xI BinNums.xH)
  (@cons (prod BinNums.positive BinNums.positive)
     (@pair BinNums.positive BinNums.positive (BinNums.xO BinNums.xH) BinNums.xH)
     (@cons (prod BinNums.positive BinNums.positive)
        (@pair BinNums.positive BinNums.positive (BinNums.xI BinNums.xH) BinNums.xH)
        (@cons (prod BinNums.positive BinNums.positive)
           (@pair BinNums.positive BinNums.positive (BinNums.xI (BinNums.xI BinNums.xH)) BinNums.xH)
           (@cons (prod BinNums.positive BinNums.positive)
              (@pair BinNums.positive BinNums.positive
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))))))
                 BinNums.xH)
              (@cons (prod BinNums.positive BinNums.positive)
                 (@pair BinNums.positive BinNums.positive
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xO
