                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (...)))))))))))))))))
                    BinNums.xH) (@nil (prod BinNums.positive BinNums.positive))))))) BinNums.xH
     : PocklingtonCertificat.singleCertif
