                   (Values.Vint
                      (jet_readBit_layout.bit_int
                         (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem az))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 v))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun ox : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun oy : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun oz : forall _ : nat, Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_add_ge_var)
                        (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val))))) Events.E0
                        mf Values.Vundef)
                     (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 ox))
                        (and
                           (jet_secp_fe_nv.fe_at mf bp
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 oy))
                           (and
                              (jet_secp_fe_nv.fe_at mf bp
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (jet_secp_multiply_normalize_bridge.words5 oz))
                              (and
                                 (Memory.Mem.range_perm mf bp BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf ba BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and (jet_secp_square_columns.square_input_bounds ox)
                                       (and (jet_secp_square_columns.square_input_bounds oy)
                                          (and (jet_secp_square_columns.square_input_bounds oz)
                                             (and
                                                (@eq
                                                   (prod
                                                      (prod (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...)))))))
                                                   (@pair
                                                      (prod (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (@pair (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...)))))
                                                         (jet_secp_rescale_literal.rescale_field_output ox)
                                                         (jet_secp_rescale_literal.rescale_field_output oy))
                                                      (jet_secp_rescale_literal.rescale_field_output oz))
                                                   (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
                                                      (@pair
                                                         (prod
                                                            (prod (Ty.tySem (Word.Word (...)))
                                                               (Ty.tySem (Word.Word (...))))
                                                            (Ty.tySem (Word.Word (S (...)))))
                                                         (prod (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))))
                                                         (@pair
                                                            (prod (Ty.tySem (Word.Word (...)))
                                                               (Ty.tySem (Word.Word (...))))
                                                            (Ty.tySem (Word.Word (S (...))))
                                                            (@pair (Ty.tySem (Word.Word (...)))
                                                               (Ty.tySem (Word.Word (...))) ax ay) az)
                                                         (@pair (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))) bx byword))))
                                                (jet_sx_mem.lframe
                                                   (fun (b : Values.block) (_ : BinNums.Z) =>
                                                    and (not (@eq Values.block b bp)) (not (@eq Values.block b ba))) m
                                                   mf))))))))))))))
### C.jet_secp_mixed_xy_literal.mixed_xy_output_residue
mixed_xy_output_residue
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_rescale_literal.rescale_field_output w)) jet_secp_fe_math.feP)
### C.jet_secp_mixed_xy_literal.mixed_xy_affine_outputs_literal
mixed_xy_affine_outputs_literal
     : forall (x y u v : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds y) (_ : jet_secp_square_columns.square_input_bounds u)
         (_ : jet_secp_square_columns.square_input_bounds v),
       let z : forall _ : nat, Integers.Int64.int := jet_secp_point_set_bit.point_set_bit_words true in
       @eq
         (prod
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@pair
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (jet_secp_rescale_literal.rescale_field_output
                  (jet_secp_mixed_body_loose.mixed_mode_body_x_words true Integers.Int.zero x y z u v))
               (jet_secp_rescale_literal.rescale_field_output
                  (jet_secp_mixed_body_loose.mixed_mode_body_y_words true Integers.Int.zero x y z u v)))
            (jet_secp_rescale_literal.rescale_field_output
               (jet_secp_mixed_body_loose.mixed_mode_body_z_words true Integers.Int.zero x y z u v)))
         (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
            (@pair
               (prod
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (jet_secp_rescale_literal.rescale_field_output x)
                     (jet_secp_rescale_literal.rescale_field_output y))
                  (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (jet_secp_rescale_literal.rescale_field_output u) (jet_secp_rescale_literal.rescale_field_output v))))
