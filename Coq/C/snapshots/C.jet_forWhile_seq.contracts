### C.jet_forWhile_seq.wz
wz =
fun (n : nat) (w : Ty.tySem (Word.Word n)) => @Word.ToZ.Theory.toZ (Word.WordToZ n) w
     : forall (n : nat) (_ : Ty.tySem (Word.Word n)), BinNums.Z

Arguments wz n%nat_scope w
### C.jet_forWhile_seq.wsize
wsize =
fun n : nat => BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) n))
     : forall _ : nat, BinNums.Z

Arguments wsize n%nat_scope
