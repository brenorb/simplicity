### C.jet_secp_gej_equiv_statements.gej_equiv_body_source
gej_equiv_body_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_gej_eq_var) gej_equiv_body
### C.jet_secp_gej_equiv_statements.exec_gej_equiv_body_from_calls
exec_gej_equiv_body_from_calls
     : forall (le : Maps.PTree.tree Values.val) (m mn ma : Memory.Mem.mem) (bt bp ba : Values.block)
         (flag : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_neg)
                (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mn
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mn
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_add_var)
                (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                         (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val))))) Events.E0 ma
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ma
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_is_infinity)
                (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 ma
                (Values.Vint flag)),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (gej_equiv_env bt) le m
         (Clight.fn_body jets_secp.f_secp256k1_gej_eq_var) Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint flag) le) ma
         (ClightBigstep.Out_return
            (@Some (prod Values.val Ctypes.type) (@pair Values.val Ctypes.type (Values.Vint flag) Ctypesdefs.tint)))
### C.jet_secp_gej_equiv_statements.gej_equiv_env
gej_equiv_env =
fun bt : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._tmp
  (@pair Values.block Ctypes.type bt (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)) Clight.empty_env
     : forall _ : Values.block, Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments gej_equiv_env bt
### C.jet_secp_gej_equiv_statements.gej_equiv_tmp_address
gej_equiv_tmp_address =
Clight.Eaddrof (Clight.Evar jets_secp._tmp (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
     : Clight.expr
### C.jet_secp_gej_equiv_statements.gej_equiv_negate_stmt
gej_equiv_negate_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_gej_neg jets_secp.f_secp256k1_gej_neg
  (@None AST.ident)
  (@cons Clight.expr gej_equiv_tmp_address
     (@cons Clight.expr
        (Clight.Etempvar jets_secp._a (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_gej_equiv_statements.gej_equiv_add_stmt
gej_equiv_add_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_gej_add_var jets_secp.f_secp256k1_gej_add_var
  (@None AST.ident)
  (@cons Clight.expr gej_equiv_tmp_address
     (@cons Clight.expr gej_equiv_tmp_address
        (@cons Clight.expr
           (Clight.Etempvar jets_secp._b (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
           (@cons Clight.expr
              (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tvoid))
              (@nil Clight.expr)))))
     : Clight.statement
### C.jet_secp_gej_equiv_statements.gej_equiv_flag_stmt
gej_equiv_flag_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_gej_is_infinity jets_secp.f_secp256k1_gej_is_infinity
  (@Some AST.ident jets_secp._t'1) (@cons Clight.expr gej_equiv_tmp_address (@nil Clight.expr))
     : Clight.statement
### C.jet_secp_gej_equiv_statements.gej_equiv_body
gej_equiv_body =
Clight.Ssequence gej_equiv_negate_stmt
  (Clight.Ssequence gej_equiv_add_stmt
     (Clight.Ssequence gej_equiv_flag_stmt
        (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tint)))))
     : Clight.statement
