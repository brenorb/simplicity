### C.jet_secp_field_weak_tight.weak_shift_values
weak_shift_values
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int) (jet_secp_field_add_initial.field_values (weak_shift_words w) (S O))
         (jet_secp_multiply_normalize_bridge.words5 w)
### C.jet_secp_field_weak_tight.eval_field_weak_tight
eval_field_weak_tight
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_math.fe_limbs_ok (Integers.Int64.unsigned (w O)) (Integers.Int64.unsigned (w (S O)))
                (Integers.Int64.unsigned (w (S (S O)))) (Integers.Int64.unsigned (w (S (S (S O)))))
                (Integers.Int64.unsigned (w (S (S (S (S O)))))))
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_weak)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe (fun (b' : Values.block) (_ : BinNums.Z) => not (@eq Values.block b' b)) m mf))))
### C.jet_secp_field_weak_tight.square_reader_positioned
square_reader_positioned
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       jet_secp_fe_math.fe_limbs_ok (Integers.Int64.unsigned (jet_secp_square_spec_bridge.square_reader_rho x O))
         (Integers.Int64.unsigned (jet_secp_square_spec_bridge.square_reader_rho x (S O)))
         (Integers.Int64.unsigned (jet_secp_square_spec_bridge.square_reader_rho x (S (S O))))
         (Integers.Int64.unsigned (jet_secp_square_spec_bridge.square_reader_rho x (S (S (S O)))))
         (Integers.Int64.unsigned (jet_secp_square_spec_bridge.square_reader_rho x (S (S (S (S O))))))
### C.jet_secp_field_weak_tight.weak_shift_words
weak_shift_words =
fun (w : forall _ : nat, Integers.Int64.int) (n : nat) =>
match n return Integers.Int64.int with
| O => Integers.Int64.zero
| S i => w i
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments weak_shift_words w%function_scope n%nat_scope
