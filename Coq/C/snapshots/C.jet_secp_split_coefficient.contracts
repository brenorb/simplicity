### C.jet_secp_split_coefficient.split_multiplier_limbs
split_multiplier_limbs
     : forall first : bool,
       @eq (list Integers.Int64.int)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of (jet_secp_split_multipliers.split_multiplier_value first)))
         (jet_secp_split_multipliers.split_multiplier_words first)
### C.jet_secp_split_coefficient.eval_split_coefficient
eval_split_coefficient
     : forall (first : bool) (k : BinNums.Z) (m : Memory.Mem.mem) (bk bc : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.lt k
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : jet_secp_split_multipliers.split_multipliers_ready m)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of k)))
         (_ : Memory.Mem.range_perm m bk BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bc bk)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_shift_var)
               (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vptr (jet_secp_split_multipliers.split_multiplier_block first) Integers.Ptrofs.zero)
                        (@cons Values.val
                           (Values.Vint
                              (Integers.Int.repr
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                           (@nil Values.val))))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf bc BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (jet_secp_split_multipliers.split_coefficient first k))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf bk BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of k)))
                  (and
                     (Memory.Mem.range_perm mf bc BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bk BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and (jet_secp_split_multipliers.split_multipliers_ready mf)
                           (and (jet_clight_internal_permissions.keeps_permissions m mf)
                              (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bc))
                                       (and (not (@eq Values.block b bk))
                                          (not
                                             (@eq Values.block b
                                                (jet_secp_split_multipliers.split_multiplier_block first))))) m mf)))))))))
### C.jet_secp_split_coefficient.eval_split_coefficient_literal
eval_split_coefficient_literal
     : forall (first : bool) (k : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bk bc : Values.block) (_ : jet_secp_split_multipliers.split_multipliers_ready m)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))))
         (_ : Memory.Mem.range_perm m bk BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bc bk)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_shift_var)
               (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vptr (jet_secp_split_multipliers.split_multiplier_block first) Integers.Ptrofs.zero)
                        (@cons Values.val
                           (Values.Vint
                              (Integers.Int.repr
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                           (@nil Values.val))))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf bc BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                           (@jet_secp_split_round_literal.literal_split_coefficient first Alg.CoreFunSem k)))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf bk BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))))
                  (and
                     (Memory.Mem.range_perm mf bc BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bk BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and (jet_secp_split_multipliers.split_multipliers_ready mf)
                           (and (jet_clight_internal_permissions.keeps_permissions m mf)
                              (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bc))
                                       (and (not (@eq Values.block b bk))
                                          (not
                                             (@eq Values.block b
                                                (jet_secp_split_multipliers.split_multiplier_block first))))) m mf)))))))))
