### C.jet_secp_linear_startup.linear_startup_initializes
linear_startup_initializes
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       linear_startup m
### C.jet_secp_linear_startup.linear_startup_exists
linear_startup_exists
     : @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                  (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m))
            (linear_startup m))
### C.jet_secp_linear_startup.linear_startup_readonly
linear_startup_readonly
     : forall (m mf : Memory.Mem.mem) (_ : linear_startup m) (_ : jet_clight_internal_preserve.readonly_preserved m mf),
       linear_startup mf
### C.jet_secp_linear_startup.linear_startup_not_writable
linear_startup_not_writable
     : forall (m : Memory.Mem.mem) (_ : linear_startup m) (b : Values.block)
         (_ : @List.In Values.block b linear_startup_blocks) (pos : BinNums.Z),
       not (Memory.Mem.perm m b pos Memtype.Max Memtype.Writable)
### C.jet_secp_linear_startup.linear_startup_lframe
linear_startup_lframe
     : forall (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (m mf : Memory.Mem.mem)
         (_ : linear_startup m) (_ : jet_clight_forward.mem_forward m mf) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall (b : Values.block) (_ : @List.In Values.block b linear_startup_blocks) (pos : BinNums.Z), P b pos),
       linear_startup mf
### C.jet_secp_linear_startup.linear_startup_owned_separate
linear_startup_owned_separate
     : forall (m : Memory.Mem.mem) (b : Values.block) (_ : linear_startup m)
         (_ : Memory.Mem.perm m b BinNums.Z0 Memtype.Cur Memtype.Freeable) (bg : Values.block)
         (_ : @List.In Values.block bg linear_startup_blocks), not (@eq Values.block b bg)
### C.jet_secp_linear_startup.linear_startup_ecmult_call
linear_startup_ecmult_call
     : forall (m mf : Memory.Mem.mem) (f : Clight.fundef) (args : list Values.val) (trace : Events.trace)
         (result : Values.val) (br bk ba bg : Values.block) (_ : linear_startup m)
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (@cons (prod Values.block BinNums.Z)
                          (@pair Values.block BinNums.Z br
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                          (@cons (prod Values.block BinNums.Z)
                             (@pair Values.block BinNums.Z bk
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                             (@cons (prod Values.block BinNums.Z)
                                (@pair Values.block BinNums.Z ba
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                (@cons (prod Values.block BinNums.Z)
                                   (@pair Values.block BinNums.Z bg
                                      (BinNums.Zpos
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                   (@nil (prod Values.block BinNums.Z))))))),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m f args trace mf result)
         (_ : jet_sx_mem.lframe
                (fun (b : Values.block) (_ : BinNums.Z) =>
                 not
                   (@List.In Values.block b
                      (@cons Values.block br
                         (@cons Values.block bk (@cons Values.block ba (@cons Values.block bg (@nil Values.block)))))))
                m mf), linear_startup mf
### C.jet_secp_linear_startup.linear_startup
linear_startup =
fun m : Memory.Mem.mem =>
and (jet_secp_split_constants.split_constants_ready m)
  (and (jet_secp_beta_global.beta_initialized m)
     (forall h : bool, jet_secp_generator_globals.generator_table_state h m))
     : forall _ : Memory.Mem.mem, Prop

Arguments linear_startup m
### C.jet_secp_linear_startup.linear_startup_blocks
linear_startup_blocks =
@app Values.block jet_secp_strauss_scale_function.strauss_readonly_blocks
  (@cons Values.block (jet_secp_generator_globals.generator_table_block false)
     (@cons Values.block (jet_secp_generator_globals.generator_table_block true) (@nil Values.block)))
     : list Values.block
