inv_batch_next_rho =
fun (len : nat) (st : divstep.State) (rho : forall _ : nat, Integers.Int64.int) =>
jet_secp_modinv_var_tail.inv_iteration_rho len (jet_secp_modinv_var_batch_exit.inv_batch_result_rho st rho)
     : forall (_ : nat) (_ : divstep.State) (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments inv_batch_next_rho len%nat_scope st rho%function_scope n%nat_scope
