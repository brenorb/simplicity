### C.jet_secp_point_field_transport.point_field_load_transport
point_field_load_transport
     : forall (k : jet_secp_point_write_run.point_coordinate) (m mf : Memory.Mem.mem) (b : Values.block)
         (xs : list Integers.Int64.int) (_ : le (@length Integers.Int64.int xs) (S (S (S (S (S O))))))
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset k) xs)
         (_ : Memory.Mem.range_perm mf b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mf b
                   (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.of_nat i))))
                (Memory.Mem.load AST.Mint64 m b
                   (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.of_nat i))))),
       jet_secp_fe_nv.fe_at mf b (jet_secp_point_write_run.point_coordinate_offset k) xs
### C.jet_secp_point_field_transport.point_pure_frame_preserves_field
point_pure_frame_preserves_field
     : forall (k j : jet_secp_point_write_run.point_coordinate) (m mf : Memory.Mem.mem) (b : Values.block)
         (xs : list Integers.Int64.int) (_ : not (@eq jet_secp_point_write_run.point_coordinate k j))
         (_ : le (@length Integers.Int64.int xs) (S (S (S (S (S O))))))
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset j) xs)
         (_ : Memory.Mem.range_perm mf b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_mem.lframe
                (fun (bx : Values.block) (pos : BinNums.Z) =>
                 not
                   (jet_sx_state.foot
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z)))
                      (@List.map jet_sx_state.region
                         (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                         jet_sx_state.rshape (jet_secp_point_write_run.point_write_initial_regs k)) bx pos)) m mf),
       jet_secp_fe_nv.fe_at mf b (jet_secp_point_write_run.point_coordinate_offset j) xs
