### C.jet_present_buffer_segment.eval_present_buffer_segment
eval_present_buffer_segment
     : forall (m : Memory.Mem.mem) (bi : Values.block) (input : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S O)))))) (tail : BinNums.Z)
         (_ : lt O (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)) (_ : BinInt.Z.le BinNums.Z0 tail)
         (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le (BinInt.Z.add input (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bi bf)) (_ : not (@eq Values.block bi bw))
         (_ : jet_read8s_layout.uint8_array_at m bi input
                (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value xs))
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinInt.Z.add
                   (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))) tail)),
       @ex Memory.Mem.mem
         (fun mb : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_writeBit)
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val))) Events.E0 mb
                  (Values.Vint Integers.Int.one))
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb (@Ctypes.Internal Clight.function jets.f_write8s)
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                        (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
                           (@cons Values.val
                              (Values.Vlong
                                 (Integers.Int64.repr
                                    (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))
                              (@nil Values.val)))) Events.E0 mf Values.Vundef)
                  (and
                     (jet_encoding.frame_output_cells_at mf bw edge cursor
                        (@cons (option bool) (@Some bool true)
                           (@List.concat BitMachine.Cell
                              (@List.map (Ty.tySem (Word.Word (S (S (S O))))) (list BitMachine.Cell)
                                 (@Translate.encode (Word.Word (S (S (S O))))) xs))))
                     (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                        (and
                           (jet_output_layout.write_frame_at mf bf base bw edge
                              (BinInt.Z.sub cursor
                                 (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))) tail)
                           (and
                              (jet_output_layout.loads_outside_ranges m mf bf
                                 (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 (BinInt.Z.add base
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                                 (BinInt.Z.add edge
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       (BinInt.Z.div
                                          (BinInt.Z.sub cursor
                                             (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                                (BinInt.Z.mul
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                                   (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))))
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                 (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              (and
                                 (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                  Memory.Mem.perm mf b ofs kind p)
                                 (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                  Memory.Mem.valid_block mf b)))))))))
