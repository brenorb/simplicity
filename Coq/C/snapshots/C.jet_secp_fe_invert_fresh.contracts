### C.jet_secp_fe_invert_fresh.modinfo_fe_state_old_blocks
modinfo_fe_state_old_blocks
     : forall (m mf : Memory.Mem.mem) (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m)
         (_ : forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
              and (Memory.Mem.valid_block mf b)
                (and
                   (forall (chunk : AST.memory_chunk) (ofs : BinNums.Z),
                    @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                   (forall (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                      (_ : Memory.Mem.perm mf b ofs k p), Memory.Mem.perm m b ofs k p))),
       jet_secp_modinfo_fe_caller.modinfo_fe_state mf
### C.jet_secp_fe_invert_fresh.field_invert_runs_from_initialized
field_invert_runs_from_initialized
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (env : Values.val)
         (m0 : Memory.Mem.mem)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m0),
       @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          @ex Values.block
            (fun bd : Values.block =>
             @ex Values.block
               (fun bs : Values.block =>
                @ex Values.block
                  (fun bi : Values.block =>
                   @ex Values.block
                     (fun bw : Values.block =>
                      @ex BinNums.Z
                        (fun edge : BinNums.Z =>
                         @ex Memory.Mem.mem
                           (fun mf : Memory.Mem.mem =>
                            and (jet_secp_modinfo_fe_caller.modinfo_fe_state m)
                              (and (jet_frame_layout.frame_fields_at m bs BinNums.Z0 bi edge BinNums.Z0)
                                 (and
                                    (jet_encoding.frame_input_cells_at m bi edge BinNums.Z0
                                       (@Translate.encode (Word.Word (S (S (S (S (S (S (S ...)))))))) value))
                                    (and
                                       (jet_output_layout.write_frame_at m bd BinNums.Z0 bw BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))
                                       (and
                                          (forall (b : Values.block) (chunk : AST.memory_chunk)
                                             (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m0 b),
                                           @eq (option Values.val) (Memory.Mem.load chunk m b ofs)
                                             (Memory.Mem.load chunk m0 b ofs))
                                          (and
                                             (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                                (@Ctypes.Internal Clight.function jets_secp.f_simplicity_fe_invert)
                                                (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                                                   (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                                                      (@cons Values.val env (@nil Values.val)))) Events.E0 mf
                                                (Values.Vint Integers.Int.one))
                                             (and
                                                (jet_frame_inv.finv m bd BinNums.Z0 bw BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))) bi mf
                                                   true
                                                   (@Translate.encode (Word.Word (S (S (S ...))))
                                                      (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem value)))
                                                (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                                                   (forall (b : Values.block) (chunk : AST.memory_chunk)
                                                      (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m0 b),
                                                    @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                                      (Memory.Mem.load chunk m0 b ofs))))))))))))))))
### C.jet_secp_fe_invert_fresh.field_invert_runs_from_actual_init
field_invert_runs_from_actual_init
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (env : Values.val)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x))))),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m : Memory.Mem.mem =>
             @ex Values.block
               (fun bd : Values.block =>
                @ex Values.block
                  (fun bs : Values.block =>
                   @ex Values.block
                     (fun bi : Values.block =>
                      @ex Values.block
                        (fun bw : Values.block =>
                         @ex BinNums.Z
                           (fun edge : BinNums.Z =>
                            @ex Memory.Mem.mem
                              (fun mf : Memory.Mem.mem =>
                               and
                                 (@eq (option Memory.Mem.mem)
                                    (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                                       (@Ctypes.program_of_program Clight.function jets_secp.prog))
                                    (@Some Memory.Mem.mem mi))
                                 (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mi)
                                    (and (jet_frame_layout.frame_fields_at m bs BinNums.Z0 bi edge BinNums.Z0)
                                       (and
                                          (jet_encoding.frame_input_cells_at m bi edge BinNums.Z0
                                             (@Translate.encode (Word.Word (S (S (S (S (...)))))) value))
                                          (and
                                             (jet_output_layout.write_frame_at m bd BinNums.Z0 bw BinNums.Z0
                                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))
                                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))
                                             (and
                                                (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                                   (@Ctypes.Internal Clight.function jets_secp.f_simplicity_fe_invert)
                                                   (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                                                      (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                                                         (@cons Values.val env (@nil Values.val)))) Events.E0 mf
                                                   (Values.Vint Integers.Int.one))
                                                (and
                                                   (jet_frame_inv.finv m bd BinNums.Z0 bw BinNums.Z0
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO (...))))
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO (...)))) bi mf true
                                                      (@Translate.encode (Word.Word (S (...)))
                                                         (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem
                                                            value)))
                                                   (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                                                      (forall (b : Values.block) (chunk : AST.memory_chunk)
                                                         (ofs : BinNums.Z) (_ : Memory.Mem.valid_block mi b),
                                                       @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                                         (Memory.Mem.load chunk mi b ofs)))))))))))))))))
