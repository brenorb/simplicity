### C.jet_secp_fe_set_owned.eval_fe_set_owned
eval_fe_set_owned
     : forall (bit : bool) (m : Memory.Mem.mem) (b : Values.block)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_set_int)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr BinNums.Z0))
                  (@cons Values.val
                     (Values.Vint
                        match bit return Integers.Int.int with
                        | true => Integers.Int.one
