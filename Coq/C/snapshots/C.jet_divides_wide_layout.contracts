### C.jet_divides_wide_layout.wide_divides_context_guarantees
wide_divides_context_guarantees =
fun s : jet_wide.wide_size =>
@jet_guarantees.jet_context_guarantees
  (Ty.Prod
     ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
         match n return Ty.Ty with
         | O => X
         | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
         end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))
     ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
         match n return Ty.Ty with
         | O => X
         | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
         end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))) (Ty.Sum Ty.Unit Ty.Unit)
  (jet_divides_wide_exec.wide_divides s) (@jet_division_core_spec.divides_word_spec (jet_wide.wide_log s))
  (jet_division_core_spec.divides_word_spec_parametric (jet_wide.wide_log s)) (wide_divides_local_spec s)
  match s return (le (S O) (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))) with
  | jet_wide.W16 =>
      ZifyClasses.rew_iff_rev (le (S O) (S O)) (BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH))
        (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
           (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)) (S O) (BinNums.Zpos BinNums.xH)
           (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)))
        (let __arith : BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH) :=
           let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
           let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
           let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
             @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
               (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
                  RingMicromega.OpLe (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))) tt in
           ZMicromega.ZTautoChecker_sound __ff __wit
             (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
             (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
         __arith)
      <:
      le (S O) (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))
  | jet_wide.W32 =>
      ZifyClasses.rew_iff_rev (le (S O) (S O)) (BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH))
        (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
           (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)) (S O) (BinNums.Zpos BinNums.xH)
           (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)))
        (let __arith : BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH) :=
           let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
           let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
           let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
             @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
               (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
                  RingMicromega.OpLe (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))) tt in
           ZMicromega.ZTautoChecker_sound __ff __wit
             (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
             (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
         __arith)
      <:
      le (S O) (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))
  | jet_wide.W64 =>
      ZifyClasses.rew_iff_rev (le (S O) (S O)) (BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH))
        (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
           (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)) (S O) (BinNums.Zpos BinNums.xH)
           (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)))
        (let __arith : BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH) :=
           let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
           let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
           let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
             @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
               (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
                  RingMicromega.OpLe (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))) tt in
           ZMicromega.ZTautoChecker_sound __ff __wit
             (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
             (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
         __arith)
      <:
      le (S O) (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))
  end
     : forall (s : jet_wide.wide_size) (env : Values.val) (m : Memory.Mem.mem) (L : jet_bitmachine_rep.bm_layout)
         (ctx : BitMachine.Context)
         (a : Ty.tySem
                (Ty.Prod
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s)))),
       let s0 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState
              (@Translate.encode
                 (Ty.Prod
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))) a)
              (BitMachine.newWriteFrame (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit)))) in
       let s1 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState
              (@Translate.encode
                 (Ty.Prod
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))) a)
              (BitMachine.fullWriteFrame
                 (@Translate.encode (Ty.Sum Ty.Unit Ty.Unit)
                    (@jet_division_core_spec.divides_word_spec (jet_wide.wide_log s) Alg.CoreFunSem a)))) in
       forall (_ : jet_bitmachine_rep.bm_rep m L s0) (_ : jet_bitmachine_rep.bm_separated L s0)
         (_ : jet_bitmachine_rep.active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function (jet_divides_wide_exec.wide_divides s))
               (jet_bitmachine_rep.jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (jet_bitmachine_rep.bm_rep mf L s1)
               (BitMachine.runProgram
                  (@jet_division_core_spec.divides_word_spec (jet_wide.wide_log s) Translate.Naive.translate)
                  (BitMachine.Running s0) (BitMachine.Running s1))))

Arguments wide_divides_context_guarantees s env m L ctx a _ _ _
### C.jet_divides_wide_layout.wide_divides_guarantees
wide_divides_guarantees =
fun s : jet_wide.wide_size =>
jet_guarantees.jet_local_spec_guarantees (jet_divides_wide_exec.wide_divides s)
  (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s))) (Ty.Sum Ty.Unit Ty.Unit)
  (fun xy : Ty.tySem (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s))) =>
   @jet_division_core_spec.divides_word_spec (jet_wide.wide_log s) Alg.CoreFunSem xy) (wide_divides_local_spec s)
     : forall (s : jet_wide.wide_size) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s))))
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add read_cursor
                   (BinInt.Z.of_nat
                      (Translate.bitSize (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s))))))
                Integers.Int64.max_unsigned)
         (_ : jet_encoding.frame_input_cells_at m bi edge read_cursor
                (@Translate.encode (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s))) a))
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.of_nat (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function (jet_divides_wide_exec.wide_divides s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Ty.Sum Ty.Unit Ty.Unit)
                     ((fun xy : Ty.tySem (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s)))
                       => @jet_division_core_spec.divides_word_spec (jet_wide.wide_log s) Alg.CoreFunSem xy) a)))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit)))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))

Arguments wide_divides_guarantees s env m bd dbase%Z_scope bs sbase%Z_scope bi bw
  (edge outedge cursor read_cursor)%Z_scope a _ _ _ _ _ _ _
### C.jet_divides_wide_layout.wide_divides_context_guarantees
wide_divides_context_guarantees =
fun s : jet_wide.wide_size =>
@jet_guarantees.jet_context_guarantees
  (Ty.Prod
     ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
         match n return Ty.Ty with
         | O => X
         | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
         end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))
     ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
         match n return Ty.Ty with
         | O => X
         | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
         end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))) (Ty.Sum Ty.Unit Ty.Unit)
  (jet_divides_wide_exec.wide_divides s) (@jet_division_core_spec.divides_word_spec (jet_wide.wide_log s))
  (jet_division_core_spec.divides_word_spec_parametric (jet_wide.wide_log s)) (wide_divides_local_spec s)
  match s return (le (S O) (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))) with
  | jet_wide.W16 =>
      ZifyClasses.rew_iff_rev (le (S O) (S O)) (BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH))
        (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
           (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)) (S O) (BinNums.Zpos BinNums.xH)
           (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)))
        (let __arith : BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH) :=
           let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
           let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
           let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
             @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
               (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
                  RingMicromega.OpLe (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))) tt in
           ZMicromega.ZTautoChecker_sound __ff __wit
             (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
             (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
         __arith)
      <:
      le (S O) (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))
  | jet_wide.W32 =>
      ZifyClasses.rew_iff_rev (le (S O) (S O)) (BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH))
        (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
           (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)) (S O) (BinNums.Zpos BinNums.xH)
           (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)))
        (let __arith : BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH) :=
           let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
           let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
           let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
             @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
               (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
                  RingMicromega.OpLe (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))) tt in
           ZMicromega.ZTautoChecker_sound __ff __wit
             (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
             (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
         __arith)
      <:
      le (S O) (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))
  | jet_wide.W64 =>
      ZifyClasses.rew_iff_rev (le (S O) (S O)) (BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH))
        (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
           (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)) (S O) (BinNums.Zpos BinNums.xH)
           (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)))
        (let __arith : BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH) :=
           let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
           let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
           let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
             @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
               (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
                  RingMicromega.OpLe (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))) tt in
           ZMicromega.ZTautoChecker_sound __ff __wit
             (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
             (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
         __arith)
      <:
      le (S O) (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))
  end
     : forall (s : jet_wide.wide_size) (env : Values.val) (m : Memory.Mem.mem) (L : jet_bitmachine_rep.bm_layout)
         (ctx : BitMachine.Context)
         (a : Ty.tySem
                (Ty.Prod
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s)))),
       let s0 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState
              (@Translate.encode
                 (Ty.Prod
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))) a)
              (BitMachine.newWriteFrame (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit)))) in
       let s1 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState
              (@Translate.encode
                 (Ty.Prod
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log s))) a)
              (BitMachine.fullWriteFrame
                 (@Translate.encode (Ty.Sum Ty.Unit Ty.Unit)
                    (@jet_division_core_spec.divides_word_spec (jet_wide.wide_log s) Alg.CoreFunSem a)))) in
       forall (_ : jet_bitmachine_rep.bm_rep m L s0) (_ : jet_bitmachine_rep.bm_separated L s0)
         (_ : jet_bitmachine_rep.active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function (jet_divides_wide_exec.wide_divides s))
               (jet_bitmachine_rep.jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (jet_bitmachine_rep.bm_rep mf L s1)
               (BitMachine.runProgram
                  (@jet_division_core_spec.divides_word_spec (jet_wide.wide_log s) Translate.Naive.translate)
                  (BitMachine.Running s0) (BitMachine.Running s1))))

Arguments wide_divides_context_guarantees s env m L ctx a _ _ _
