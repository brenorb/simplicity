match v return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl t =>
    match t return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
    | pair b h =>
        @cons (Ty.tySem (Word.Word (S (S (S O)))))
          match b return (Ty.tySem (Word.Word (S (S (S O))))) with
          | inl _ => asset_byte_even
          | inr _ => asset_byte_odd
          end (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
    end
| inr h =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_one
      (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
