### C.jet_elements_asset_amount_hash_spec.conf_tag_byte_value
conf_tag_byte_value
     : forall (prefix_even prefix_odd : Ty.tySem (Word.Word (S (S (S O))))) (b : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)),
       @eq (Ty.tySem (Word.Word (S (S (S O))))) (@conf_tag_byte_spec prefix_even prefix_odd Alg.CoreFunSem b)
         match b return (Ty.tySem (Word.Word (S (S (S O))))) with
         | inl _ => prefix_even
         | inr _ => prefix_odd
         end
### C.jet_elements_asset_amount_hash_spec.conf_tag_byte_option
conf_tag_byte_option
     : forall (prefix_even prefix_odd : Ty.tySem (Word.Word (S (S (S O))))) (b : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Word.Word (S (S (S O))))))
         (@conf_tag_byte_spec prefix_even prefix_odd (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero))
            b)
         (@Some (Ty.tySem (Word.Word (S (S (S O)))))
            match b return (Ty.tySem (Word.Word (S (S (S O))))) with
            | inl _ => prefix_even
            | inr _ => prefix_odd
            end)
