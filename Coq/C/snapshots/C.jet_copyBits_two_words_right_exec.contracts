### C.jet_copyBits_two_words_right_exec.copy_two_right_env
copy_two_right_env =
fun (le : Maps.PTree.tree Values.val) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int) (ss ds n : BinNums.Z)
  (old source : Integers.Int64.int) =>
jet_copyBits_right_advance.copy_right_advance_env
  (jet_copyBits_helper_right.copy_right_env (jet_copyBits_helper_exec.copy_clear_env le ds old) ss ds old source) bw
  dst_ofs ss ds n
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments copy_two_right_env le bw dst_ofs (ss ds n)%Z_scope old source
