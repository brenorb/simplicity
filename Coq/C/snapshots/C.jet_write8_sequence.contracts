### C.jet_write8_sequence.byte_sequence_cells_length
byte_sequence_cells_length
     : forall xs : list Integers.Int.int,
       @eq nat (@length BitMachine.Cell (byte_sequence_cells xs))
         (Nat.mul (S (S (S (S (S (S (S (S O)))))))) (@length Integers.Int.int xs))
### C.jet_write8_sequence.write8_sequence_run_layout
write8_sequence_run_layout
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (xs : list Integers.Int.int)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                   (BinInt.Z.of_nat (@length Integers.Int.int xs)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and (write8_sequence_run bf base xs m mf)
            (and (jet_encoding.frame_output_cells_at mf bw edge cursor (byte_sequence_cells xs))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bf base bw edge
                        (BinInt.Z.sub cursor
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat (@length Integers.Int.int xs)))))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bf
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor
                                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                          (BinInt.Z.of_nat (@length Integers.Int.int xs))))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
### C.jet_write8_sequence.write8_sequence_run
write8_sequence_run =
fix write8_sequence_run
  (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int) (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons x xs0 =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         and
           (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
              (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
              (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                 (@cons Values.val (Values.Vint x) (@nil Values.val))) Events.E0 mi Values.Vundef)
           (write8_sequence_run bf base xs0 mi mf))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int.int) (_ : Memory.Mem.mem) (_ : Memory.Mem.mem),
       Prop

Arguments write8_sequence_run bf base%Z_scope xs%list_scope m mf
### C.jet_write8_sequence.byte_sequence_cells
byte_sequence_cells =
fun xs : list Integers.Int.int =>
@List.concat BitMachine.Cell
  (@List.map Integers.Int.int (list BitMachine.Cell)
     (fun x : Integers.Int.int =>
      @Translate.encode (Word.Word (S (S (S O))))
        (jet_spec.decode_word8 (Integers.Int64.repr (Integers.Int.unsigned x)))) xs)
     : forall _ : list Integers.Int.int, list BitMachine.Cell

Arguments byte_sequence_cells xs%list_scope
