### C.jet_secp_owned_read_final.owned_read_leaf_source
owned_read_leaf_source
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int),
       jet_secp_local_regions.all_leaf_property
         (fun state : jet_sx_eval.sstate =>
          @eq (list jet_sx_state.cell)
            (jet_sx_state.rcells
               (@List.nth jet_sx_state.region (S O) (jet_sx_eval.sregs state)
                  (jet_sx_state.mkreg (@nil jet_sx_state.cell) true (@None BinNums.Z))))
            (jet_secp_frame.mk_frame_cells (jet_sx_expr.XA bi edge)
               (Integers.Int64.repr
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (jet_secp_owned_read_run.owned_read_result size k bi edge)
### C.jet_secp_owned_read_final.owned_read_selected_source
owned_read_selected_source
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate)
         (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (bi : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list jet_sx_state.cell)
         (jet_sx_state.rcells
            (@List.nth jet_sx_state.region (S O)
               (jet_sx_eval.sregs
                  (@fst jet_sx_eval.sstate jet_sx_exec.xout
                     (jet_sx_exec.rsel rho layout (jet_secp_owned_read_run.owned_read_result size k bi edge))))
               (jet_sx_state.mkreg (@nil jet_sx_state.cell) true (@None BinNums.Z))))
         (jet_secp_frame.mk_frame_cells (jet_sx_expr.XA bi edge)
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_owned_read_final.owned_read_final_source_fields
owned_read_final_source_fields
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (m : Memory.Mem.mem)
         (ba bl bi : Values.block) (edge rc : BinNums.Z) (rho : forall _ : nat, Integers.Int64.int)
         (_ : @eq Integers.Int64.int (rho O) (Integers.Int64.repr rc))
         (_ : jet_sx_state.rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (jet_sx_eval.sregs
                   (@fst jet_sx_eval.sstate jet_sx_exec.xout
                      (jet_sx_exec.rsel rho
                         (jet_sx_state.lay
                            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                  (@nil (prod Values.block BinNums.Z)))))
                         (jet_secp_owned_read_run.owned_read_result size k bi (Integers.Ptrofs.repr edge))))) m),
       jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge
         (BinInt.Z.add rc
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_owned_read_final.owned_read_final_field
owned_read_final_field
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (m : Memory.Mem.mem)
         (ba bl bi : Values.block) (edge rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : jet_sx_state.rep
                (jet_secp_wrapper_run.read_fe_rho
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (jet_sx_eval.sregs
                   (@fst jet_sx_eval.sstate jet_sx_exec.xout
                      (jet_sx_exec.rsel
                         (jet_secp_wrapper_run.read_fe_rho
                            (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                         (jet_sx_state.lay
                            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                  (@nil (prod Values.block BinNums.Z)))))
                         (jet_secp_owned_read_run.owned_read_result size k bi (Integers.Ptrofs.repr edge))))) m),
       and
         (jet_secp_fe_nv.fe_at m ba (jet_secp_point_write_run.point_coordinate_offset k)
            (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
               (jet_secp_fe_math.fe_limbs_of
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                     (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem value)))))
         (and (Memory.Mem.range_perm m ba BinNums.Z0 size Memtype.Cur Memtype.Freeable)
            (Memory.Mem.range_perm m bl BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
               Memtype.Freeable))
