### C.jet_secp_point_verify_route.point_verify_check_route
point_verify_check_route
     : forall (na ng : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (a b : Ty.tySem jet_secp_point_verify_literal.literal_compressed_point)
         (ap
          bp : Ty.tySem
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (goodA goodB : bool)
         (_ : @eq
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem a)
                match
                  goodA
                  return
                    (Ty.tySem
                       (Ty.Sum Ty.Unit
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                             (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                with
                | true =>
                    @inr unit
                      (Ty.tySem
                         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                            (Word.Word (S (S (S (S (S (S (S (S O))))))))))) ap
                | false =>
                    @inl unit
                      (prod
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
                end)
         (_ : @eq
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem b)
                match
                  goodB
                  return
                    (Ty.tySem
                       (Ty.Sum Ty.Unit
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                             (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                with
                | true =>
                    @inr unit
                      (Ty.tySem
                         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                            (Word.Word (S (S (S (S (S (S (S (S O))))))))))) bp
                | false =>
                    @inl unit
                      (prod
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
                end)
         (_ : forall _ : @eq bool goodA true,
              @eq bool (Bit.toBool (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem ap)) true)
         (_ : forall _ : @eq bool goodB true,
              @eq bool (Bit.toBool (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem bp)) true),
       @eq bool
         (Bit.toBool
            (@jet_secp_point_verify_literal.literal_point_check Alg.CoreFunSem
               (@pair
                  (prod
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem jet_secp_point_verify_literal.literal_compressed_point))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem jet_secp_point_verify_literal.literal_compressed_point)
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem jet_secp_point_verify_literal.literal_compressed_point))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem jet_secp_point_verify_literal.literal_compressed_point) na a) ng) b)))
         (andb goodA
            (andb goodB
               (Bit.toBool
                  (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem
                     (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
                        (@pair (Ty.tySem jet_secp_scalar_table_literal.literal_table_gej)
                           (Ty.tySem
                              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                 (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                           (@jet_secp_strauss_complete_program.literal_off_curve_linear_combination_1 Alg.CoreFunSem
                              (@pair
                                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (prod
                                       (Ty.tySem
                                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                             (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (prod
                                       (Ty.tySem
                                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                             (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) na
                                    (@pair
                                       (Ty.tySem
                                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                             (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ap
                                       (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))) ng))
                           (@jet_secp_gej_negate_literal.literal_ge_negate Alg.CoreFunSem bp)))))))
