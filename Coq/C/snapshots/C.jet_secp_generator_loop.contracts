### C.jet_secp_generator_loop.generator_loop_result
generator_loop_result =
fix generator_loop_result
  (count : nat) (digits1 digits128 : forall _ : BinNums.Z, Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)
  (point : Ty.tySem jet_secp_generate_literal.literal_generator_jacobian) {struct count} :
    Ty.tySem jet_secp_generate_literal.literal_generator_jacobian :=
  match count return (Ty.tySem jet_secp_generate_literal.literal_generator_jacobian) with
  | O => point
  | S count0 =>
      generator_loop_result count0 digits1 digits128
        (jet_secp_generator_iteration.generator_digit_action true (digits128 (BinInt.Z.of_nat count0))
           (jet_secp_generator_iteration.generator_digit_action false (digits1 (BinInt.Z.of_nat count0))
              (@jet_secp_double_literal.literal_gej_double Alg.CoreFunSem point)))
  end
     : forall (_ : nat) (_ : forall _ : BinNums.Z, Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)
         (_ : forall _ : BinNums.Z, Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)
         (_ : Ty.tySem jet_secp_generate_literal.literal_generator_jacobian),
       Ty.tySem jet_secp_generate_literal.literal_generator_jacobian

Arguments generator_loop_result count%nat_scope (digits1 digits128)%function_scope point
