### C.jet_secp_globalz_word_walk.globalz_decoded_residue
globalz_decoded_residue
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w)
