### C.jet_secp_globalz_word_walk.globalz_factor_decoded
globalz_factor_decoded
     : forall (n : nat) (zs ratio : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_square_columns.square_input_bounds zs) (_ : jet_secp_square_columns.square_input_bounds ratio),
       and
         (jet_secp_square_columns.square_input_bounds
            (jet_secp_globalz_factor_call.globalz_factor_words (BinInt.Z.of_nat n) zs ratio))
         (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (jet_secp_rescale_literal.rescale_field_output
               (jet_secp_globalz_factor_call.globalz_factor_words (BinInt.Z.of_nat n) zs ratio))
            match
              PeanoNat.Nat.eqb n (S (S (S (S (S (S (S O)))))))
              return (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            with
            | true => jet_secp_rescale_literal.rescale_field_output zs
            | false =>
                @jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (jet_secp_rescale_literal.rescale_field_output ratio)
                     (jet_secp_rescale_literal.rescale_field_output zs))
            end)
### C.jet_secp_globalz_word_walk.globalz_scaled_bounds
globalz_scaled_bounds
     : forall (x y z : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds y) (_ : jet_secp_square_columns.square_input_bounds z),
       and (jet_secp_square_columns.square_input_bounds (jet_secp_ge_zinv_arithmetic.ge_zinv_x_words x z))
         (jet_secp_square_columns.square_input_bounds (jet_secp_ge_zinv_arithmetic.ge_zinv_y_words y z))
### C.jet_secp_globalz_word_walk.globalz_walk_decoded
globalz_walk_decoded
     : forall (n : nat) (_ : le n (S (S (S (S (S (S (S O))))))))
         (xs ys ratios : forall (_ : nat) (_ : nat), Integers.Int64.int) (zs : forall _ : nat, Integers.Int64.int)
         (ps : forall _ : nat, Ty.tySem jet_secp_scalar_table_literal.literal_table_ge)
         (rs : forall _ : nat, Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_globalz_loop.globalz_table_bounds xs ys)
         (_ : jet_secp_globalz_loop.globalz_ratios_bounds ratios) (_ : jet_secp_square_columns.square_input_bounds zs)
         (_ : forall (k : nat) (_ : lt k (S (S (S (S (S (S (S (S O))))))))),
              @eq (Ty.tySem jet_secp_scalar_table_literal.literal_table_ge) (globalz_decoded_points xs ys k) (ps k))
         (_ : forall (k : nat) (_ : lt k (S (S (S (S (S (S (S (S O))))))))),
              @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (jet_secp_rescale_literal.rescale_field_output (ratios k)) (rs k))
         (_ : @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (jet_secp_rescale_literal.rescale_field_output zs) s),
       match jet_secp_globalz_loop.globalz_walk n xs ys ratios zs return Prop with
       | pair p zf =>
           match p return Prop with
           | pair xf yf =>
               match globalz_word_walk n ps rs s return Prop with
               | pair pf sf =>
                   and
                     (forall (k : nat) (_ : lt k (S (S (S (S (S (S (S (S O))))))))),
                      @eq (Ty.tySem jet_secp_scalar_table_literal.literal_table_ge) (globalz_decoded_points xf yf k)
                        (pf k))
                     (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (jet_secp_rescale_literal.rescale_field_output zf) sf)
               end
           end
       end
### C.jet_secp_globalz_word_walk.globalz_word_replace
globalz_word_replace =
fun (ps : forall _ : nat, Ty.tySem jet_secp_scalar_table_literal.literal_table_ge) (j : nat)
  (p : Ty.tySem jet_secp_scalar_table_literal.literal_table_ge) (k : nat) =>
match PeanoNat.Nat.eq_dec k j return (Ty.tySem jet_secp_scalar_table_literal.literal_table_ge) with
| left _ => p
| right _ => ps k
end
     : forall (_ : forall _ : nat, Ty.tySem jet_secp_scalar_table_literal.literal_table_ge)
         (_ : nat) (_ : Ty.tySem jet_secp_scalar_table_literal.literal_table_ge) (_ : nat),
       Ty.tySem jet_secp_scalar_table_literal.literal_table_ge

Arguments globalz_word_replace ps%function_scope j%nat_scope p k%nat_scope
### C.jet_secp_globalz_word_walk.globalz_word_walk
globalz_word_walk =
fix globalz_word_walk
  (n : nat) (ps : forall _ : nat, Ty.tySem jet_secp_scalar_table_literal.literal_table_ge)
  (rs : forall _ : nat, Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) {struct n} :
    prod (forall _ : nat, Ty.tySem jet_secp_scalar_table_literal.literal_table_ge)
      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) :=
  match
    n
    return
      (prod (forall _ : nat, Ty.tySem jet_secp_scalar_table_literal.literal_table_ge)
         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  with
  | O =>
      @pair (forall _ : nat, Ty.tySem jet_secp_scalar_table_literal.literal_table_ge)
        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ps s
  | S j =>
      let f : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
        match
          PeanoNat.Nat.eqb (S j) (S (S (S (S (S (S (S O)))))))
          return (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        with
        | true => s
        | false =>
            @jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rs (S j)) s)
        end in
      globalz_word_walk j
        (globalz_word_replace ps j
           (@jet_secp_rescale_literal.literal_gej_zinv Alg.CoreFunSem
              (@pair (Ty.tySem jet_secp_scalar_table_literal.literal_table_ge)
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (ps j) f))) rs f
  end
     : forall (_ : nat) (_ : forall _ : nat, Ty.tySem jet_secp_scalar_table_literal.literal_table_ge)
         (_ : forall _ : nat, Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       prod (forall _ : nat, Ty.tySem jet_secp_scalar_table_literal.literal_table_ge)
         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments globalz_word_walk n%nat_scope (ps rs)%function_scope s
### C.jet_secp_globalz_word_walk.globalz_decoded_points
globalz_decoded_points =
fun (xs ys : forall (_ : nat) (_ : nat), Integers.Int64.int) (j : nat) =>
@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (jet_secp_rescale_literal.rescale_field_output (xs j)) (jet_secp_rescale_literal.rescale_field_output (ys j))
     : forall (_ : forall (_ : nat) (_ : nat), Integers.Int64.int) (_ : forall (_ : nat) (_ : nat), Integers.Int64.int)
         (_ : nat), Ty.tySem jet_secp_scalar_table_literal.literal_table_ge

Arguments globalz_decoded_points (xs ys)%function_scope j%nat_scope
