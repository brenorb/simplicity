### C.jet_secp_beta_global.beta_symbol
beta_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            jets_secp._secp256k1_const_beta) (@Some Values.block beta_block)
### C.jet_secp_beta_global.beta_var_info
beta_var_info
     : @eq (option (AST.globvar Ctypes.type))
         (@Globalenvs.Genv.find_var_info Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            beta_block) (@Some (AST.globvar Ctypes.type) jets_secp.v_secp256k1_const_beta)
### C.jet_secp_beta_global.beta_genv_projection
beta_genv_projection
     : @eq (Globalenvs.Genv.t Clight.fundef Ctypes.type) (Clight.genv_genv jet_secp_linkage.secp_ge)
         (@Globalenvs.Genv.globalenv (Ctypes.fundef Clight.function) Ctypes.type
            (@Ctypes.program_of_program Clight.function jets_secp.prog))
### C.jet_secp_beta_global.beta_words_count
beta_words_count
     : @eq nat (@length Integers.Int64.int beta_words) (S (S (S (S (S O)))))
### C.jet_secp_beta_global.beta_radix_value
beta_radix_value
     : @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value beta_digits) beta_value
### C.jet_secp_beta_global.beta_limb_bounds
beta_limb_bounds
     : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
       and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned (beta_digits i)))
         (BinInt.Z.le (Integers.Int64.unsigned (beta_digits i))
            match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
            | true =>
                BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI
                                                                  (BinNums.xI
                                                                     (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))
            | false =>
                BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI
                                                                  (BinNums.xI
                                                                     (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))
            end)
### C.jet_secp_beta_global.beta_global_initializes
beta_global_initializes
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       beta_global_rep m
### C.jet_secp_beta_global.beta_initial_bounds
beta_initial_bounds
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       beta_readonly_bounds m
### C.jet_secp_beta_global.beta_initialized_from_init
beta_initialized_from_init
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       beta_initialized m
### C.jet_secp_beta_global.beta_program_initialization_ok_true
beta_program_initialization_ok_true
     : @eq bool beta_program_initialization_ok true
### C.jet_secp_beta_global.beta_initialized_memory_exists
beta_initialized_memory_exists
     : @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                  (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m))
            (beta_initialized m))
### C.jet_secp_beta_global.beta_words
beta_words =
@cons Integers.Int64.int
  (Integers.Int64.repr
     (BinNums.Zpos
        (BinNums.xO
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (...)))))))))))))))))))))))
  (@cons Integers.Int64.int
     (Integers.Int64.repr
        (BinNums.Zpos
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (...))))))))))))))))))))))
     (@cons Integers.Int64.int
        (Integers.Int64.repr
           (BinNums.Zpos
              (BinNums.xI
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (...)))))))))))))))))))))
        (@cons Integers.Int64.int
           (Integers.Int64.repr
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (...))))))))))))))))))))
           (@cons Integers.Int64.int
              (Integers.Int64.repr
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (...)))))))))))))))))))
              (@nil Integers.Int64.int)))))
     : list Integers.Int64.int
### C.jet_secp_beta_global.beta_value
beta_value =
BinNums.Zpos
  (BinNums.xO
     (BinNums.xI
        (BinNums.xI
           (BinNums.xI
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (...)))))))))))))))))))))))
     : BinNums.Z
### C.jet_secp_beta_global.beta_digits
beta_digits =
fun i : nat => @List.nth Integers.Int64.int i beta_words Integers.Int64.zero
     : forall _ : nat, Integers.Int64.int

Arguments beta_digits i%nat_scope
### C.jet_secp_beta_global.beta_block
beta_block = jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_const_beta
     : Values.block
### C.jet_secp_beta_global.beta_global_rep
beta_global_rep =
fun m : Memory.Mem.mem =>
and (Memory.Mem.valid_block m beta_block)
  (and
     (Memory.Mem.range_perm m beta_block BinNums.Z0
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
        Memtype.Readable)
     (forall (i : nat) (w : Integers.Int64.int)
        (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int beta_words i)
               (@Some Integers.Int64.int w)),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m beta_block
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong w))))
     : forall _ : Memory.Mem.mem, Prop

Arguments beta_global_rep m
### C.jet_secp_beta_global.beta_readonly_bounds
beta_readonly_bounds =
fun m : Memory.Mem.mem =>
forall (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
iff (Memory.Mem.perm m beta_block ofs k p)
  (and
     (and (BinInt.Z.le BinNums.Z0 ofs)
        (BinInt.Z.lt ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     (Memtype.perm_order Memtype.Readable p))
     : forall _ : Memory.Mem.mem, Prop

Arguments beta_readonly_bounds m
### C.jet_secp_beta_global.beta_initialized
beta_initialized =
fun m : Memory.Mem.mem => and (beta_global_rep m) (beta_readonly_bounds m)
     : forall _ : Memory.Mem.mem, Prop

Arguments beta_initialized m
### C.jet_secp_beta_global.beta_program_initialization_ok
beta_program_initialization_ok =
@jet_program_initialization.program_initialization_okb (Ctypes.fundef Clight.function) Ctypes.type
  (@Ctypes.program_of_program Clight.function jets_secp.prog)
     : bool
