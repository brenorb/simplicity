### C.jet_vector_shift_word.vector_bits
vector_bits =
fix vector_bits (T : Word.ToZ.type) (n : nat) {struct n} : nat :=
  match n return nat with
  | O => Word.ToZ.Theory.bitSize T
  | S n0 => Nat.add (vector_bits T n0) (vector_bits T n0)
  end
     : forall (_ : Word.ToZ.type) (_ : nat), nat

Arguments vector_bits T n%nat_scope
### C.jet_vector_shift_word.vector_value
vector_value =
fix vector_value (T : Word.ToZ.type) (n : nat) {struct n} :
    forall _ : Ty.tySem (Word.Vector (Word.ToZ.obj T) n), BinNums.Z :=
  match n as n0 return (forall _ : Ty.tySem (Word.Vector (Word.ToZ.obj T) n0), BinNums.Z) with
  | O => fun x : Ty.tySem (Word.Vector (Word.ToZ.obj T) O) => @Word.ToZ.Theory.toZ T x
  | S n0 =>
      fun x : Ty.tySem (Word.Vector (Word.ToZ.obj T) (S n0)) =>
      BinInt.Z.add
        (BinInt.Z.mul
           (vector_value T n0
              (@fst
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                        match n1 return Ty.Ty with
                        | O => X
                        | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                        end) (Word.ToZ.obj T) n0))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                        match n1 return Ty.Ty with
                        | O => X
                        | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                        end) (Word.ToZ.obj T) n0)) x)) (Zpower.two_power_nat (vector_bits T n0)))
        (vector_value T n0
           (@snd
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                     match n1 return Ty.Ty with
                     | O => X
                     | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                     end) (Word.ToZ.obj T) n0))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                     match n1 return Ty.Ty with
                     | O => X
                     | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                     end) (Word.ToZ.obj T) n0)) x))
  end
     : forall (T : Word.ToZ.type) (n : nat) (_ : Ty.tySem (Word.Vector (Word.ToZ.obj T) n)), BinNums.Z

Arguments vector_value T n%nat_scope _
