### C.jet_secp_frame.outsA
outsA =
fun (ρ : forall _ : nat, Integers.Int64.int) (log : list jet_sx_eval.event) =>
@List.concat BitMachine.Cell
  (@List.map jet_sx_eval.event (list BitMachine.Cell)
     (fun ev : jet_sx_eval.event =>
      match is_wr ev return (list BitMachine.Cell) with
      | true => jet_write8_sequence.byte_sequence_cells (wr_bytes ρ ev)
      | false => @nil BitMachine.Cell
      end) log)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list jet_sx_eval.event), list BitMachine.Cell

