### C.jet_secp_frame.invA
invA =
fun (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
  (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list BitMachine.Cell) (capA : BinNums.Z)
  (ρ : forall _ : nat, Integers.Int64.int) (log : list jet_sx_eval.event) (m : Memory.Mem.mem) =>
and (@eq Integers.Int64.int (ρ O) (Integers.Int64.repr rc))
  (and
     (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi m (orb w0 (has_wr log))
