                                                  (@pair
                                                     (prod
                                                        (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx))
                                                           nat) nat) (list jet_sx_expr.sx)
                                                     (@pair
                                                        (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx))
                                                           nat) nat
                                                        (@pair
                                                           (prod (list jet_sx_state.region) (option jet_sx_expr.sx))
                                                           nat
                                                           (@pair (list jet_sx_state.region)
                                                              (option jet_sx_expr.sx)
                                                              (@jet_sx_state.upd jet_sx_state.region
                                                                 (@jet_sx_state.upd jet_sx_state.region regs rb
                                                                    (jet_sx_state.mkreg
                                                                       (byte_cells BinNums.Z0 (BinInt.Z.to_nat n) base)
                                                                       (jet_sx_state.rw regb)
                                                                       (jet_sx_state.rfree regb))) rs
                                                                 (jet_sx_state.mkreg
                                                                    (mk_frame_cells xp
                                                                       (Integers.Int64.repr
                                                                          (BinInt.Z.add (Integers.Int64.unsigned kc)
                                                                             (BinInt.Z.mul ... n))))
                                                                    (jet_sx_state.rw regS)
                                                                    (jet_sx_state.rfree regS)))
                                                              (@None jet_sx_expr.sx)) tRD8)
                                                        (BinInt.Z.to_nat n))
                                                     (@cons jet_sx_expr.sx xp
                                                        (@cons jet_sx_expr.sx (jet_sx_expr.XLc kc)
                                                           (@cons jet_sx_expr.sx
                                                              (jet_sx_expr.XLc (Integers.Int64.repr n))
                                                              (@nil jet_sx_expr.sx)))))
                                            | false =>
