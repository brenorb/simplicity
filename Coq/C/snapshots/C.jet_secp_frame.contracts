### C.jet_secp_frame.orc_wr8
orc_wr8 =
fun (capA : BinNums.Z) (_ : nat) (log : list jet_sx_eval.event) (xs : list jet_sx_expr.sx)
  (regs : list jet_sx_state.region) =>
match
  xs
  return
