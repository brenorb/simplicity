                                                 (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat)
                                                 nat) (list jet_sx_expr.sx)))
                                    with
                                    | Some p =>
                                        match
                                          p
                                          return
                                            (option
                                               (prod
                                                  (prod
                                                     (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx))
                                                        nat) nat) (list jet_sx_expr.sx)))
                                        with
                                        | pair xp kc =>
                                            match
                                              andb
                                                (andb
                                                   (andb
                                                      (andb
                                                         (andb
                                                            (andb
                                                               (andb (andb (negb w0) (negb (has_wr log)))
                                                                  (BinInt.Z.ltb BinNums.Z0 n))
                                                               (BinInt.Z.leb
                                                                  (BinInt.Z.add (Integers.Int64.unsigned kc)
                                                                     (BinInt.Z.mul (BinNums.Zpos ...) n)) nin))
                                                            (negb (PeanoNat.Nat.eqb rb rs)))
                                                         (jet_sx_state.rw regb)) (jet_sx_state.rw regS))
                                                   (shape_eqb
                                                      (@List.map jet_sx_state.cell (prod BinNums.Z AST.memory_chunk)
                                                         jet_sx_state.cshape (jet_sx_state.rcells regb))
                                                      (@List.map jet_sx_state.cell (prod BinNums.Z AST.memory_chunk)
                                                         jet_sx_state.cshape
                                                         (byte_undef BinNums.Z0 (BinInt.Z.to_nat n)))))
                                                match jet_sx_state.rfree regb return bool with
