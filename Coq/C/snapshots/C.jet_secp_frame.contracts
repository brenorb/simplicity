### C.jet_secp_frame.frame_cells
frame_cells =
fun regS : jet_sx_state.region =>
match jet_sx_state.rcells regS return (option (prod jet_sx_expr.sx Integers.Int64.int)) with
| nil => @None (prod jet_sx_expr.sx Integers.Int64.int)
| cons c1 l =>
    match l return (option (prod jet_sx_expr.sx Integers.Int64.int)) with
    | nil => @None (prod jet_sx_expr.sx Integers.Int64.int)
    | cons c2 l0 =>
        match l0 return (option (prod jet_sx_expr.sx Integers.Int64.int)) with
        | nil =>
            match jet_sx_state.cval c1 return (option (prod jet_sx_expr.sx Integers.Int64.int)) with
            | Some xp =>
                match jet_sx_state.cval c2 return (option (prod jet_sx_expr.sx Integers.Int64.int)) with
                | Some xc =>
                    match cur_k xc return (option (prod jet_sx_expr.sx Integers.Int64.int)) with
                    | Some kc =>
                        match
                          andb
                            (andb
                               (andb
                                  (andb (BinInt.Z.eqb (jet_sx_state.cofs c1) BinNums.Z0)
                                     (jet_sx_state.chunk_eqb (jet_sx_state.cchunk c1) AST.Mint64))
                                  (BinInt.Z.eqb (jet_sx_state.cofs c2)
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (jet_sx_state.chunk_eqb (jet_sx_state.cchunk c2) AST.Mint64))
                            (jet_sx_expr.isk jet_sx_expr.KA xp)
                          return (option (prod jet_sx_expr.sx Integers.Int64.int))
                        with
                        | true =>
                            @Some (prod jet_sx_expr.sx Integers.Int64.int)
                              (@pair jet_sx_expr.sx Integers.Int64.int xp kc)
                        | false => @None (prod jet_sx_expr.sx Integers.Int64.int)
                        end
                    | None => @None (prod jet_sx_expr.sx Integers.Int64.int)
                    end
                | None => @None (prod jet_sx_expr.sx Integers.Int64.int)
                end
            | None => @None (prod jet_sx_expr.sx Integers.Int64.int)
            end
        | cons _ _ => @None (prod jet_sx_expr.sx Integers.Int64.int)
        end
    end
end
     : forall _ : jet_sx_state.region, option (prod jet_sx_expr.sx Integers.Int64.int)

