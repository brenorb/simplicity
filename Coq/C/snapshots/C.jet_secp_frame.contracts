                                          (prod
                                             (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat)
                                                nat) (list jet_sx_expr.sx))
                                    end
                                | None =>
                                    @None
                                      (prod
                                         (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                                         (list jet_sx_expr.sx))
                                end
                            | None =>
                                @None
                                  (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                                     (list jet_sx_expr.sx))
                            end
                        | None =>
                            @None
                              (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                                 (list jet_sx_expr.sx))
                        end
                    | None =>
