### C.jet_secp_frame.written
written =
fix written (log : list jet_sx_eval.event) : BinNums.Z :=
  match log return BinNums.Z with
  | nil => BinNums.Z0
  | cons ev t =>
      BinInt.Z.add
        match is_wr ev return BinNums.Z with
        | true =>
            BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
              (BinInt.Z.of_nat (@length jet_sx_expr.sx (@List.tl jet_sx_expr.sx (jet_sx_eval.eargs ev))))
        | false => BinNums.Z0
        end (written t)
  end
     : forall _ : list jet_sx_eval.event, BinNums.Z

Arguments written log%list_scope
### C.jet_secp_frame.evokA
evokA =
fun (bd : Values.block) (dbase : BinNums.Z) (bi : Values.block) (edge : BinNums.Z) (ibits : list bool)
  (ρ : forall _ : nat, Integers.Int64.int) (ev : jet_sx_eval.event) =>
match PeanoNat.Nat.eqb (jet_sx_eval.etag ev) tRD8 return Prop with
| true =>
    match jet_sx_eval.eargs ev return Prop with
    | nil => False
    | cons xp l =>
        match l return Prop with
        | nil => False
        | cons s l0 =>
            match s return Prop with
            | jet_sx_expr.XI _ => False
            | jet_sx_expr.XIc _ => False
            | jet_sx_expr.XL _ => False
            | jet_sx_expr.XLc k =>
                match l0 return Prop with
                | nil => False
                | cons s0 l1 =>
                    match s0 return Prop with
                    | jet_sx_expr.XI _ => False
                    | jet_sx_expr.XIc _ => False
                    | jet_sx_expr.XL _ => False
                    | jet_sx_expr.XLc _ =>
                        match l1 return Prop with
                        | nil =>
                            and (@eq Values.val (jet_sx_expr.den ρ β0 xp) (Values.Vptr bi (Integers.Ptrofs.repr edge)))
                              (forall (j : nat) (_ : lt j (jet_sx_eval.ecnt ev)),
                               @eq Integers.Int64.int (ρ (Nat.add (jet_sx_eval.ebase ev) j))
                                 (Integers.Int64.repr
                                    (jet_frame_bits.ifield ibits
                                       (Nat.add (BinInt.Z.to_nat (Integers.Int64.unsigned k))
                                          (Nat.mul (S (S (S (S (S (S (S (S O)))))))) j))
                                       (S (S (S (S (S (S (S (S O)))))))))))
                        | cons _ _ => False
                        end
                    | jet_sx_expr.XLv _ => False
                    | jet_sx_expr.XV _ => False
                    | jet_sx_expr.XA _ _ => False
                    | jet_sx_expr.XP _ _ => False
                    | jet_sx_expr.XIb _ _ _ => False
                    | jet_sx_expr.XLb _ _ _ => False
                    | jet_sx_expr.XIsh _ _ _ => False
                    | jet_sx_expr.XLsh _ _ _ => False
                    | jet_sx_expr.XIcmp _ _ _ _ => False
                    | jet_sx_expr.XLcmp _ _ _ _ => False
                    | jet_sx_expr.XI2L _ _ => False
                    | jet_sx_expr.XL2I _ => False
                    | jet_sx_expr.XIcast _ _ _ => False
                    | jet_sx_expr.XInz _ => False
                    | jet_sx_expr.XLnz _ => False
                    | jet_sx_expr.XIz _ => False
                    | jet_sx_expr.XLz _ => False
                    | jet_sx_expr.XIneg _ => False
                    | jet_sx_expr.XLneg _ => False
                    | jet_sx_expr.XInot _ => False
                    | jet_sx_expr.XLnot _ => False
                    end
                end
            | jet_sx_expr.XLv _ => False
            | jet_sx_expr.XV _ => False
            | jet_sx_expr.XA _ _ => False
            | jet_sx_expr.XP _ _ => False
            | jet_sx_expr.XIb _ _ _ => False
            | jet_sx_expr.XLb _ _ _ => False
            | jet_sx_expr.XIsh _ _ _ => False
            | jet_sx_expr.XLsh _ _ _ => False
            | jet_sx_expr.XIcmp _ _ _ _ => False
            | jet_sx_expr.XLcmp _ _ _ _ => False
            | jet_sx_expr.XI2L _ _ => False
            | jet_sx_expr.XL2I _ => False
            | jet_sx_expr.XIcast _ _ _ => False
            | jet_sx_expr.XInz _ => False
            | jet_sx_expr.XLnz _ => False
            | jet_sx_expr.XIz _ => False
            | jet_sx_expr.XLz _ => False
            | jet_sx_expr.XIneg _ => False
            | jet_sx_expr.XLneg _ => False
            | jet_sx_expr.XInot _ => False
            | jet_sx_expr.XLnot _ => False
            end
        end
    end
| false =>
    match PeanoNat.Nat.eqb (jet_sx_eval.etag ev) tWR8 return Prop with
    | true =>
        match jet_sx_eval.eargs ev return Prop with
        | nil => False
        | cons xd _ => @eq Values.val (jet_sx_expr.den ρ β0 xd) (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        end
    | false => True
    end
end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : list bool)
         (_ : forall _ : nat, Integers.Int64.int) (_ : jet_sx_eval.event), Prop

