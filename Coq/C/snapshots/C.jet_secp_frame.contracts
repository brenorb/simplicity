         (_ : BinNums.Z) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : bool) (_ : list BitMachine.Cell)
         (_ : BinNums.Z) (_ : forall _ : nat, Integers.Int64.int) (_ : list jet_sx_eval.event)
         (_ : Memory.Mem.mem), Prop

