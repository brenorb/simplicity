### C.jet_secp_frame.orc_rd8
orc_rd8 =
fun (w0 : bool) (nin : BinNums.Z) (base : nat) (log : list jet_sx_eval.event) (xs : list jet_sx_expr.sx)
  (regs : list jet_sx_state.region) =>
match
  xs
  return
    (option
       (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat) (list jet_sx_expr.sx)))
with
| nil =>
    @None (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat) (list jet_sx_expr.sx))
| cons x1 l =>
    match
      l
      return
        (option
           (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat) (list jet_sx_expr.sx)))
    with
    | nil =>
        @None
          (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat) (list jet_sx_expr.sx))
    | cons xn l0 =>
        match
          l0
          return
            (option
               (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                  (list jet_sx_expr.sx)))
        with
        | nil =>
            @None
              (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                 (list jet_sx_expr.sx))
        | cons x3 l1 =>
            match
              l1
              return
                (option
                   (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                      (list jet_sx_expr.sx)))
            with
            | nil =>
                match
                  as_xp0 x1
                  return
                    (option
                       (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                          (list jet_sx_expr.sx)))
                with
                | Some rb =>
                    match
                      jet_sx_orc.xconst xn
                      return
                        (option
                           (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                              (list jet_sx_expr.sx)))
                    with
                    | Some n =>
                        match
                          as_xp0 x3
                          return
                            (option
                               (prod (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                                  (list jet_sx_expr.sx)))
                        with
                        | Some rs =>
                            match
                              @List.nth_error jet_sx_state.region regs rb
                              return
                                (option
                                   (prod
                                      (prod (prod (prod (list jet_sx_state.region) (option jet_sx_expr.sx)) nat) nat)
                                      (list jet_sx_expr.sx)))
                            with
                            | Some regb =>
                                match
                                  @List.nth_error jet_sx_state.region regs rs
