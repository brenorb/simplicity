     : forall _ : list jet_sx_eval.event, bool

Arguments has_wr log%list_scope
### C.jet_secp_frame.wr_bytes
wr_bytes =
fun (ρ : forall _ : nat, Integers.Int64.int) (ev : jet_sx_eval.event) =>
@List.map jet_sx_expr.sx Integers.Int.int (fun x : jet_sx_expr.sx => jet_sx_expr.ii (jet_sx_expr.den ρ β0 x))
  (@List.tl jet_sx_expr.sx (jet_sx_eval.eargs ev))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : jet_sx_eval.event), list Integers.Int.int

