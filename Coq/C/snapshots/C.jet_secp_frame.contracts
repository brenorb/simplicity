fun (xp : jet_sx_expr.sx) (kc : Integers.Int64.int) =>
@cons jet_sx_state.cell (jet_sx_state.mkcell BinNums.Z0 AST.Mint64 (@Some jet_sx_expr.sx xp))
  (@cons jet_sx_state.cell
     (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
        (@Some jet_sx_expr.sx (jet_sx_expr.XLb jet_sx_expr.Badd (jet_sx_expr.XLv O) (jet_sx_expr.XLc kc))))
     (@nil jet_sx_state.cell))
