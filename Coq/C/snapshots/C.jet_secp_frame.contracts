### C.jet_secp_frame.is_wr
is_wr =
fun ev : jet_sx_eval.event => PeanoNat.Nat.eqb (jet_sx_eval.etag ev) tWR8
     : forall _ : jet_sx_eval.event, bool

Arguments is_wr ev
### C.jet_secp_frame.has_wr
has_wr =
