### C.jet_secp_frame.byte_cells_shape
byte_cells_shape
     : forall (n : nat) (ofs : BinNums.Z) (v : nat),
       @eq (list (prod BinNums.Z AST.memory_chunk))
         (@List.map jet_sx_state.cell (prod BinNums.Z AST.memory_chunk) jet_sx_state.cshape (byte_cells ofs n v))
         (@List.map jet_sx_state.cell (prod BinNums.Z AST.memory_chunk) jet_sx_state.cshape (byte_undef ofs n))
### C.jet_secp_frame.byte_cells_In
byte_cells_In
     : forall (n : nat) (ofs : BinNums.Z) (v : nat) (c : jet_sx_state.cell)
         (_ : @List.In jet_sx_state.cell c (byte_cells ofs n v)),
       @ex nat
         (fun j : nat =>
          and (lt j n)
            (@eq jet_sx_state.cell c
               (jet_sx_state.mkcell (BinInt.Z.add ofs (BinInt.Z.of_nat j)) AST.Mint8unsigned
                  (@Some jet_sx_expr.sx (jet_sx_expr.XL2I (jet_sx_expr.XLv (Nat.add v j)))))))
### C.jet_secp_frame.byte_undef_nth
byte_undef_nth
     : forall (n : nat) (ofs : BinNums.Z) (j : nat) (_ : lt j n),
       @List.In (prod BinNums.Z AST.memory_chunk)
         (@pair BinNums.Z AST.memory_chunk (BinInt.Z.add ofs (BinInt.Z.of_nat j)) AST.Mint8unsigned)
         (@List.map jet_sx_state.cell (prod BinNums.Z AST.memory_chunk) jet_sx_state.cshape (byte_undef ofs n))
### C.jet_secp_frame.shape_eqb_eq
shape_eqb_eq
     : forall (a b : list (prod BinNums.Z AST.memory_chunk)) (_ : @eq bool (shape_eqb a b) true),
       @eq (list (prod BinNums.Z AST.memory_chunk)) a b
### C.jet_secp_frame.as_xp0_eq
as_xp0_eq
     : forall (x : jet_sx_expr.sx) (r : nat) (_ : @eq (option nat) (as_xp0 x) (@Some nat r)),
       @eq jet_sx_expr.sx x (jet_sx_expr.XP r BinNums.Z0)
### C.jet_secp_frame.cur_k_eq
cur_k_eq
     : forall (x : jet_sx_expr.sx) (kc : Integers.Int64.int)
         (_ : @eq (option Integers.Int64.int) (cur_k x) (@Some Integers.Int64.int kc)),
       @eq jet_sx_expr.sx x (jet_sx_expr.XLb jet_sx_expr.Badd (jet_sx_expr.XLv O) (jet_sx_expr.XLc kc))
### C.jet_secp_frame.frame_cells_eq
frame_cells_eq
     : forall (regS : jet_sx_state.region) (xp : jet_sx_expr.sx) (kc : Integers.Int64.int)
         (_ : @eq (option (prod jet_sx_expr.sx Integers.Int64.int)) (frame_cells regS)
                (@Some (prod jet_sx_expr.sx Integers.Int64.int) (@pair jet_sx_expr.sx Integers.Int64.int xp kc))),
       and (@eq (list jet_sx_state.cell) (jet_sx_state.rcells regS) (mk_frame_cells xp kc))
         (@eq bool (jet_sx_expr.isk jet_sx_expr.KA xp) true)
### C.jet_secp_frame.outsA_length
outsA_length
     : forall (ρ : forall _ : nat, Integers.Int64.int) (log : list jet_sx_eval.event),
       @eq BinNums.Z (BinInt.Z.of_nat (@length BitMachine.Cell (outsA ρ log))) (written log)
### C.jet_secp_frame.outsA_app
outsA_app
     : forall (ρ : forall _ : nat, Integers.Int64.int) (l1 l2 : list jet_sx_eval.event),
       @eq (list BitMachine.Cell) (outsA ρ (@app jet_sx_eval.event l1 l2))
         (@app BitMachine.Cell (outsA ρ l1) (outsA ρ l2))
### C.jet_secp_frame.has_wr_app
has_wr_app
     : forall l1 l2 : list jet_sx_eval.event,
       @eq bool (has_wr (@app jet_sx_eval.event l1 l2)) (orb (has_wr l1) (has_wr l2))
### C.jet_secp_frame.written_app
written_app
     : forall l1 l2 : list jet_sx_eval.event,
       @eq BinNums.Z (written (@app jet_sx_eval.event l1 l2)) (BinInt.Z.add (written l1) (written l2))
### C.jet_secp_frame.i64_add_repr
i64_add_repr
     : forall a b : BinNums.Z,
       @eq Integers.Int64.int (Integers.Int64.add (Integers.Int64.repr a) (Integers.Int64.repr b))
         (Integers.Int64.repr (BinInt.Z.add a b))
### C.jet_secp_frame.secp_read8s_layout
secp_read8s_layout
     : forall (m : Memory.Mem.mem) (bo : Values.block) (output : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S O)))))) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bo output
                (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) Memtype.Cur
                Memtype.Writable) (_ : not (@eq Values.block bf bo)) (_ : not (@eq Values.block bf bi))
         (_ : not (@eq Values.block bo bi)) (_ : jet_frame_layout.frame_base_valid base)
         (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))) Integers.Int64.max_unsigned)
         (_ : jet_frame_layout.frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : forall (i : nat) (x : Ty.tySem (Word.Word (S (S (S O)))))
                (_ : @eq (option (Ty.tySem (Word.Word (S (S (S O))))))
                       (@List.nth_error (Ty.tySem (Word.Word (S (S (S O))))) xs i)
                       (@Some (Ty.tySem (Word.Word (S (S (S O))))) x)),
              @jet_input_layout.frame_input_word_at (S (S (S O))) m bi edge
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                x),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets.f_read8s)
               (@cons Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))
                  (@cons Values.val
                     (Values.Vlong
                        (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_read8s_layout.uint8_array_at mf bo output
                  (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
                     xs))
               (and
                  (jet_frame_layout.frame_fields_at mf bf base bi edge
                     (BinInt.Z.add cursor
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bo))
                               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) output)
                                  (BinInt.Z.le
                                     (BinInt.Z.add output
                                        (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
### C.jet_secp_frame.invA_stable
invA_stable
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list BitMachine.Cell)
         (capA : BinNums.Z) (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (ρ : forall _ : nat, Integers.Int64.int) (log : list jet_sx_eval.event) (m m' : Memory.Mem.mem)
         (_ : invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA ρ log m)
         (_ : jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => extA m0 bd bw bi b) m m'),
       invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA ρ log m'
### C.jet_secp_frame.invA_valid
invA_valid
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list BitMachine.Cell)
         (capA : BinNums.Z) (ρ : forall _ : nat, Integers.Int64.int) (log : list jet_sx_eval.event)
         (m : Memory.Mem.mem) (b : Values.block) (_ : invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA ρ log m)
         (_ : extA m0 bd bw bi b), Memory.Mem.valid_block m b
### C.jet_secp_frame.loword_byte
loword_byte
     : forall (_ : list bool) (z : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 z)
                (BinInt.Z.lt z
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @eq Integers.Int.int (Integers.Int64.loword (Integers.Int64.repr z))
         (jet_read8s_layout.word8_array_value (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O)))) z))
### C.jet_secp_frame.orc_rd8_ok
orc_rd8_ok
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (w0 : bool) (outs0 : list BitMachine.Cell) (capA : BinNums.Z)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (nin : BinNums.Z) (_ : @eq BinNums.Z nin (BinInt.Z.of_nat (@length bool ibits))),
       jet_sx_exec.oracle_ok jet_secp_linkage.secp_ge (evokA bd dbase bi edge ibits)
         (invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA) (extA m0 bd bw bi) jets.f_read8s
         (orc_rd8 w0 nin)
### C.jet_secp_frame.secp_write8s_layout
secp_write8s_layout
     : forall (m : Memory.Mem.mem) (bb : Values.block) (input : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bw' : Values.block) (edge' cursor' : BinNums.Z) (xs : list Integers.Int.int)
         (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le (BinInt.Z.add input (BinInt.Z.of_nat (@length Integers.Int.int xs)))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bb bf)) (_ : not (@eq Values.block bb bw'))
         (_ : jet_read8s_layout.uint8_array_at m bb input xs)
         (_ : jet_output_layout.write_frame_at m bf base bw' edge' cursor'
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                   (BinInt.Z.of_nat (@length Integers.Int.int xs)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets.f_write8s)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bb (Integers.Ptrofs.repr input))
                     (@cons Values.val
                        (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int xs))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (jet_bitcoin_effects.write_effect m mf bf base bw' edge' cursor'
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                  (BinInt.Z.of_nat (@length Integers.Int.int xs))) (jet_write8_sequence.byte_sequence_cells xs)))
### C.jet_secp_frame.byte_undef_length
byte_undef_length
     : forall (n : nat) (ofs : BinNums.Z), @eq nat (@length jet_sx_state.cell (byte_undef ofs n)) n
### C.jet_secp_frame.byte_shape_nth
byte_shape_nth
     : forall (_ : list bool) (n : nat) (ofs : BinNums.Z) (cs : list jet_sx_state.cell)
         (_ : @eq (list (prod BinNums.Z AST.memory_chunk))
                (@List.map jet_sx_state.cell (prod BinNums.Z AST.memory_chunk) jet_sx_state.cshape cs)
                (@List.map jet_sx_state.cell (prod BinNums.Z AST.memory_chunk) jet_sx_state.cshape (byte_undef ofs n)))
         (j : nat) (c : jet_sx_state.cell)
         (_ : @eq (option jet_sx_state.cell) (@List.nth_error jet_sx_state.cell cs j) (@Some jet_sx_state.cell c)),
       and (@eq BinNums.Z (jet_sx_state.cofs c) (BinInt.Z.add ofs (BinInt.Z.of_nat j)))
         (@eq AST.memory_chunk (jet_sx_state.cchunk c) AST.Mint8unsigned)
### C.jet_secp_frame.orc_wr8_ok
orc_wr8_ok
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (w0 : bool) (outs0 : list BitMachine.Cell) (capA : BinNums.Z)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N),
       jet_sx_exec.oracle_ok jet_secp_linkage.secp_ge (evokA bd dbase bi edge ibits)
         (invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA) (extA m0 bd bw bi) jets.f_write8s
         (orc_wr8 capA)
### C.jet_secp_frame.tRD8
tRD8 = S O
     : nat
### C.jet_secp_frame.tWR8
tWR8 = S (S O)
     : nat
### C.jet_secp_frame.β0
β0 =
fun _ : nat => @pair BinNums.positive BinNums.Z BinNums.xH BinNums.Z0
     : forall _ : nat, prod Values.block BinNums.Z

Arguments β0 _%nat_scope
### C.jet_secp_frame.byte_cells
byte_cells =
fix byte_cells (ofs : BinNums.Z) (n v : nat) {struct n} : list jet_sx_state.cell :=
  match n return (list jet_sx_state.cell) with
  | O => @nil jet_sx_state.cell
  | S n0 =>
      @cons jet_sx_state.cell
        (jet_sx_state.mkcell ofs AST.Mint8unsigned (@Some jet_sx_expr.sx (jet_sx_expr.XL2I (jet_sx_expr.XLv v))))
        (byte_cells (BinInt.Z.add ofs (BinNums.Zpos BinNums.xH)) n0 (S v))
  end
     : forall (_ : BinNums.Z) (_ : nat) (_ : nat), list jet_sx_state.cell

Arguments byte_cells ofs%Z_scope (n v)%nat_scope
### C.jet_secp_frame.byte_undef
byte_undef =
fix byte_undef (ofs : BinNums.Z) (n : nat) {struct n} : list jet_sx_state.cell :=
  match n return (list jet_sx_state.cell) with
  | O => @nil jet_sx_state.cell
  | S n0 =>
      @cons jet_sx_state.cell (jet_sx_state.mkcell ofs AST.Mint8unsigned (@None jet_sx_expr.sx))
        (byte_undef (BinInt.Z.add ofs (BinNums.Zpos BinNums.xH)) n0)
  end
     : forall (_ : BinNums.Z) (_ : nat), list jet_sx_state.cell

Arguments byte_undef ofs%Z_scope n%nat_scope
### C.jet_secp_frame.shape_eqb
shape_eqb =
fix shape_eqb (a b : list (prod BinNums.Z AST.memory_chunk)) {struct a} : bool :=
  match a return bool with
  | nil => match b return bool with
           | nil => true
           | cons _ _ => false
           end
  | cons p t1 =>
      match p return bool with
      | pair o1 c1 =>
          match b return bool with
          | nil => false
          | cons p0 t2 =>
              match p0 return bool with
              | pair o2 c2 => andb (andb (BinInt.Z.eqb o1 o2) (jet_sx_state.chunk_eqb c1 c2)) (shape_eqb t1 t2)
              end
          end
      end
  end
     : forall (_ : list (prod BinNums.Z AST.memory_chunk)) (_ : list (prod BinNums.Z AST.memory_chunk)), bool

Arguments shape_eqb (a b)%list_scope
### C.jet_secp_frame.as_xp0
as_xp0 =
fun x : jet_sx_expr.sx =>
match x return (option nat) with
| jet_sx_expr.XI _ => @None nat
| jet_sx_expr.XIc _ => @None nat
| jet_sx_expr.XL _ => @None nat
| jet_sx_expr.XLc _ => @None nat
| jet_sx_expr.XLv _ => @None nat
| jet_sx_expr.XV _ => @None nat
| jet_sx_expr.XA _ _ => @None nat
| jet_sx_expr.XP r d =>
    match BinInt.Z.eqb d BinNums.Z0 return (option nat) with
    | true => @Some nat r
    | false => @None nat
    end
| jet_sx_expr.XIb _ _ _ => @None nat
| jet_sx_expr.XLb _ _ _ => @None nat
| jet_sx_expr.XIsh _ _ _ => @None nat
| jet_sx_expr.XLsh _ _ _ => @None nat
| jet_sx_expr.XIcmp _ _ _ _ => @None nat
| jet_sx_expr.XLcmp _ _ _ _ => @None nat
| jet_sx_expr.XI2L _ _ => @None nat
| jet_sx_expr.XL2I _ => @None nat
| jet_sx_expr.XIcast _ _ _ => @None nat
| jet_sx_expr.XInz _ => @None nat
| jet_sx_expr.XLnz _ => @None nat
| jet_sx_expr.XIz _ => @None nat
| jet_sx_expr.XLz _ => @None nat
| jet_sx_expr.XIneg _ => @None nat
| jet_sx_expr.XLneg _ => @None nat
| jet_sx_expr.XInot _ => @None nat
| jet_sx_expr.XLnot _ => @None nat
end
     : forall _ : jet_sx_expr.sx, option nat

Arguments as_xp0 x
### C.jet_secp_frame.cur_k
cur_k =
fun x : jet_sx_expr.sx =>
match x return (option Integers.Int64.int) with
| jet_sx_expr.XI _ => @None Integers.Int64.int
| jet_sx_expr.XIc _ => @None Integers.Int64.int
| jet_sx_expr.XL _ => @None Integers.Int64.int
| jet_sx_expr.XLc _ => @None Integers.Int64.int
| jet_sx_expr.XLv _ => @None Integers.Int64.int
| jet_sx_expr.XV _ => @None Integers.Int64.int
| jet_sx_expr.XA _ _ => @None Integers.Int64.int
| jet_sx_expr.XP _ _ => @None Integers.Int64.int
| jet_sx_expr.XIb _ _ _ => @None Integers.Int64.int
| jet_sx_expr.XLb o a b =>
    match o return (option Integers.Int64.int) with
    | jet_sx_expr.Badd =>
        match a return (option Integers.Int64.int) with
        | jet_sx_expr.XI _ => @None Integers.Int64.int
        | jet_sx_expr.XIc _ => @None Integers.Int64.int
        | jet_sx_expr.XL _ => @None Integers.Int64.int
        | jet_sx_expr.XLc _ => @None Integers.Int64.int
        | jet_sx_expr.XLv n =>
            match n return (option Integers.Int64.int) with
            | O =>
                match b return (option Integers.Int64.int) with
                | jet_sx_expr.XI _ => @None Integers.Int64.int
                | jet_sx_expr.XIc _ => @None Integers.Int64.int
                | jet_sx_expr.XL _ => @None Integers.Int64.int
                | jet_sx_expr.XLc kc => @Some Integers.Int64.int kc
                | jet_sx_expr.XLv _ => @None Integers.Int64.int
                | jet_sx_expr.XV _ => @None Integers.Int64.int
                | jet_sx_expr.XA _ _ => @None Integers.Int64.int
                | jet_sx_expr.XP _ _ => @None Integers.Int64.int
                | jet_sx_expr.XIb _ _ _ => @None Integers.Int64.int
                | jet_sx_expr.XLb _ _ _ => @None Integers.Int64.int
                | jet_sx_expr.XIsh _ _ _ => @None Integers.Int64.int
                | jet_sx_expr.XLsh _ _ _ => @None Integers.Int64.int
                | jet_sx_expr.XIcmp _ _ _ _ => @None Integers.Int64.int
                | jet_sx_expr.XLcmp _ _ _ _ => @None Integers.Int64.int
                | jet_sx_expr.XI2L _ _ => @None Integers.Int64.int
                | jet_sx_expr.XL2I _ => @None Integers.Int64.int
                | jet_sx_expr.XIcast _ _ _ => @None Integers.Int64.int
                | jet_sx_expr.XInz _ => @None Integers.Int64.int
                | jet_sx_expr.XLnz _ => @None Integers.Int64.int
                | jet_sx_expr.XIz _ => @None Integers.Int64.int
                | jet_sx_expr.XLz _ => @None Integers.Int64.int
                | jet_sx_expr.XIneg _ => @None Integers.Int64.int
                | jet_sx_expr.XLneg _ => @None Integers.Int64.int
                | jet_sx_expr.XInot _ => @None Integers.Int64.int
                | jet_sx_expr.XLnot _ => @None Integers.Int64.int
                end
            | S _ => @None Integers.Int64.int
            end
        | jet_sx_expr.XV _ => @None Integers.Int64.int
        | jet_sx_expr.XA _ _ => @None Integers.Int64.int
        | jet_sx_expr.XP _ _ => @None Integers.Int64.int
        | jet_sx_expr.XIb _ _ _ => @None Integers.Int64.int
