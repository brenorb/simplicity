### C.jet_elements_indexed_then.elements_indexed_then
elements_indexed_then =
fun (t3 t4 t5 arrfield sid : AST.ident) (ve : Clight.expr) (wid : AST.ident) =>
Clight.Ssequence
  (Clight.Sset t3
     (Clight.Efield
        (Clight.Ederef
           (Clight.Etempvar jets_elements._env (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)))
           (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)) jets_elements._tx
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr))))
  (Clight.Ssequence
     (Clight.Sset t4
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar t3 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr)))
              (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr)) arrfield
           (Ctypesdefs.tptr (Ctypes.Tstruct sid Ctypes.noattr))))
     (Clight.Ssequence (Clight.Sset t5 ve)
        (Clight.Scall (@None AST.ident)
           (Clight.Evar wid
              (Ctypes.Tfunction
                 (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                    (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
           (@cons Clight.expr
              (Clight.Etempvar jets_elements._dst
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
              (@cons Clight.expr (Clight.Etempvar t5 Ctypesdefs.tulong) (@nil Clight.expr))))))
     : forall (_ : AST.ident) (_ : AST.ident) (_ : AST.ident) (_ : AST.ident) (_ : AST.ident)
         (_ : Clight.expr) (_ : AST.ident), Clight.statement

