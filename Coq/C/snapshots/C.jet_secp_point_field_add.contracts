### C.jet_secp_point_field_add.eval_point_add_symbolic
eval_point_add_symbolic
     : forall (d : bool) (k : jet_secp_point_write_run.point_coordinate) (rho : forall _ : nat, Integers.Int64.int)
         (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta (jet_secp_point_mul_run.point_mul_regs k) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add)
               match d return (list Values.val) with
               | true =>
                   @cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O)
                        (Integers.Ptrofs.repr
                           (BinInt.Z.add (jet_sx_state.bas beta O) (jet_secp_point_write_run.point_coordinate_offset k))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@nil Values.val))
               | false =>
                   @cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta O)
                           (Integers.Ptrofs.repr
                              (BinInt.Z.add (jet_sx_state.bas beta O)
                                 (jet_secp_point_write_run.point_coordinate_offset k)))) (@nil Values.val))
               end Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho beta (point_add_out_regs d k) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot beta
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape (jet_secp_point_mul_run.point_mul_regs k)) b pos)) m mf)))
### C.jet_secp_point_field_add.point_add_fields
point_add_fields
     : forall (d : bool) (k : jet_secp_point_write_run.point_coordinate) (a b : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bp bs : Values.block)
         (_ : jet_sx_state.rep (jet_secp_point_mul_storage.point_mul_valuation a b)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))) (point_add_out_regs d k) m),
       and
         (jet_secp_fe_nv.fe_at m bp (jet_secp_point_write_run.point_coordinate_offset k)
            (jet_secp_multiply_normalize_bridge.words5 (point_add_point_words d a b)))
         (and
            (jet_secp_fe_nv.fe_at m bs BinNums.Z0
               (jet_secp_multiply_normalize_bridge.words5 (point_add_field_words d a b)))
            (and
               (Memory.Mem.range_perm m bp BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  Memtype.Cur Memtype.Freeable)
               (Memory.Mem.range_perm m bs BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)))
### C.jet_secp_point_field_add.eval_point_field_add
eval_point_field_add
     : forall (d : bool) (k : jet_secp_point_write_run.point_coordinate) (a b : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bp bs : Values.block) (_ : not (@eq Values.block bp bs))
         (_ : jet_secp_fe_nv.fe_at m bp (jet_secp_point_write_run.point_coordinate_offset k)
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add)
               match d return (list Values.val) with
               | true =>
                   @cons Values.val
                     (Values.Vptr bp (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                     (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val))
               | false =>
                   @cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vptr bp (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                        (@nil Values.val))
               end Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bp (jet_secp_point_write_run.point_coordinate_offset k)
                  (jet_secp_multiply_normalize_bridge.words5 (point_add_point_words d a b)))
               (and
                  (jet_secp_fe_nv.fe_at mf bs BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (point_add_field_words d a b)))
                  (and
                     (Memory.Mem.range_perm mf bp BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bs BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable) (jet_sx_mem.lframe (point_add_frame k bp bs) m mf))))))
### C.jet_secp_point_field_add.point_add_args
point_add_args =
fun (point_dest : bool) (k : jet_secp_point_write_run.point_coordinate) =>
match point_dest return (list jet_sx_expr.sx) with
| true =>
    @cons jet_sx_expr.sx (jet_sx_expr.XP O (jet_secp_point_write_run.point_coordinate_offset k))
      (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx))
| false =>
    @cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0)
      (@cons jet_sx_expr.sx (jet_sx_expr.XP O (jet_secp_point_write_run.point_coordinate_offset k))
         (@nil jet_sx_expr.sx))
end
     : forall (_ : bool) (_ : jet_secp_point_write_run.point_coordinate), list jet_sx_expr.sx

Arguments point_add_args point_dest%bool_scope k
### C.jet_secp_point_field_add.point_add_run
point_add_run =
fun (d : bool) (k : jet_secp_point_write_run.point_coordinate) =>
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_add (point_add_args d k) (jet_secp_point_mul_run.point_mul_regs k)
  (@nil jet_sx_eval.event) (S (S (S (S (S (S (S (S (S (S O))))))))))
     : forall (_ : bool) (_ : jet_secp_point_write_run.point_coordinate), option jet_sx_exec.res

Arguments point_add_run d%bool_scope k
### C.jet_secp_point_field_add.point_add_sums
point_add_sums =
fun reverse : bool =>
@List.map nat jet_sx_expr.sx
  (fun i : nat =>
   match reverse return jet_sx_expr.sx with
   | true => jet_sx_expr.XLb jet_sx_expr.Badd (jet_sx_expr.XLv (Nat.add (S (S (S (S (S O))))) i)) (jet_sx_expr.XLv i)
   | false => jet_sx_expr.XLb jet_sx_expr.Badd (jet_sx_expr.XLv i) (jet_sx_expr.XLv (Nat.add (S (S (S (S (S O))))) i))
   end)
  (@cons nat O
     (@cons nat (S O) (@cons nat (S (S O)) (@cons nat (S (S (S O))) (@cons nat (S (S (S (S O)))) (@nil nat))))))
     : forall _ : bool, list jet_sx_expr.sx

Arguments point_add_sums reverse%bool_scope
### C.jet_secp_point_field_add.point_add_point_exprs
point_add_point_exprs =
fun d : bool =>
match d return (list jet_sx_expr.sx) with
| true => point_add_sums false
| false => jet_secp_fe_nv.vars5 O
end
     : forall _ : bool, list jet_sx_expr.sx

Arguments point_add_point_exprs d%bool_scope
### C.jet_secp_point_field_add.point_add_field_exprs
point_add_field_exprs =
fun d : bool =>
match d return (list jet_sx_expr.sx) with
| true => jet_secp_fe_nv.vars5 (S (S (S (S (S O)))))
| false => point_add_sums true
end
     : forall _ : bool, list jet_sx_expr.sx

Arguments point_add_field_exprs d%bool_scope
### C.jet_secp_point_field_add.point_add_out_regs
point_add_out_regs =
fun (d : bool) (k : jet_secp_point_write_run.point_coordinate) =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells (jet_secp_point_write_run.point_coordinate_offset k) (point_add_point_exprs d)) true
     (@Some BinNums.Z
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (point_add_field_exprs d)) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     (@nil jet_sx_state.region))
     : forall (_ : bool) (_ : jet_secp_point_write_run.point_coordinate), list jet_sx_state.region

Arguments point_add_out_regs d%bool_scope k
### C.jet_secp_point_field_add.point_add_point_words
point_add_point_words =
fun (d : bool) (a b : forall _ : nat, Integers.Int64.int) =>
match d return (forall _ : nat, Integers.Int64.int) with
| true => jet_secp_field_add_scaled.field_sum_words a b
| false => a
end
     : forall (_ : bool) (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments point_add_point_words d%bool_scope (a b)%function_scope i%nat_scope
### C.jet_secp_point_field_add.point_add_field_words
point_add_field_words =
fun (d : bool) (a b : forall _ : nat, Integers.Int64.int) =>
match d return (forall _ : nat, Integers.Int64.int) with
| true => b
| false => jet_secp_field_add_scaled.field_sum_words b a
end
     : forall (_ : bool) (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments point_add_field_words d%bool_scope (a b)%function_scope _%nat_scope
### C.jet_secp_point_field_add.point_add_frame
point_add_frame =
fun (k : jet_secp_point_write_run.point_coordinate) (bp bs bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bs))
  (or (not (@eq Values.block bx bp))
     (or (BinInt.Z.lt pos (jet_secp_point_write_run.point_coordinate_offset k))
        (BinInt.Z.le
           (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
     : forall (_ : jet_secp_point_write_run.point_coordinate) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments point_add_frame k bp bs bx pos%Z_scope
