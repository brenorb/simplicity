### C.jet_secp_point_field_add.point_add_point_den
point_add_point_den
     : forall (d : bool) (a b : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val
