### C.jet_secp_multiply_public_lifecycle.locals_outside
locals_outside =
fun (bl ba bb b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b bl)) (and (not (@eq Values.block b ba)) (not (@eq Values.block b bb)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

