### C.jet_secp_decompress_root_test.decompress_root_temps
decompress_root_temps =
fun (le : Maps.PTree.tree Values.val) (w : forall _ : nat, Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_secp._t'1
  (Values.Vint
     match
       jet_secp_root_check.root_check_flag (jet_secp_decompress_numeric.decompress_root_words w)
       return Integers.Int.int
     with
     | true => Integers.Int.one
     | false => Integers.Int.zero
     end) le
     : forall (_ : Maps.PTree.tree Values.val) (_ : forall _ : nat, Integers.Int64.int), Maps.PTree.tree Values.val

Arguments decompress_root_temps le w%function_scope
### C.jet_secp_decompress_root_test.decompress_root_outcome
decompress_root_outcome =
fun w : forall _ : nat, Integers.Int64.int =>
match
  jet_secp_root_check.root_check_flag (jet_secp_decompress_numeric.decompress_root_words w)
  return ClightBigstep.outcome
with
| true => ClightBigstep.Out_normal
| false =>
    ClightBigstep.Out_return
      (@Some (prod Values.val Ctypes.type)
         (@pair Values.val Ctypes.type (Values.Vint Integers.Int.zero) Ctypesdefs.tint))
end
     : forall _ : forall _ : nat, Integers.Int64.int, ClightBigstep.outcome

Arguments decompress_root_outcome w%function_scope
