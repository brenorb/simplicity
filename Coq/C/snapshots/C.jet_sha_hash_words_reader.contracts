### C.jet_sha_hash_words_reader.hr_comp
hr_comp
     : forall (E : Type) (A B C : Ty.Ty) (s : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) A B)
         (t : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) B C) (a : Ty.tySem A)
         (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@jet_sha256_ctx8_init_spec.AC.comp A B C (Alg.Assertion.toCore (hash_reader_alg E)) s t a e)
         match
           s a e return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         with
         | Some b => t b e
         | None => @None (Ty.tySem C)
         end
### C.jet_sha_hash_words_reader.hr_pair
hr_pair
     : forall (E : Type) (A B C : Ty.Ty) (s : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) A B)
         (t : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) A C) (a : Ty.tySem A)
         (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod B C)))
         (@jet_sha256_ctx8_init_spec.AC.pair A B C (Alg.Assertion.toCore (hash_reader_alg E)) s t a e)
         match
           s a e
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod B C)))
         with
         | Some b =>
             match
               t a e
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod B C)))
             with
             | Some c => @Some (prod (Ty.tySem B) (Ty.tySem C)) (@pair (Ty.tySem B) (Ty.tySem C) b c)
             | None => @None (Ty.tySem (Ty.Prod B C))
             end
         | None => @None (Ty.tySem (Ty.Prod B C))
         end
### C.jet_sha_hash_words_reader.hr_take
hr_take
     : forall (E : Type) (A B C : Ty.Ty) (t : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) A C)
         (p : Ty.tySem (Ty.Prod A B)) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@jet_sha256_ctx8_init_spec.AC.take A B C (Alg.Assertion.toCore (hash_reader_alg E)) t p e)
         (t
            (@fst
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) A)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) B) p) e)
### C.jet_sha_hash_words_reader.hr_drop
hr_drop
     : forall (E : Type) (A B C : Ty.Ty) (t : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) B C)
         (p : Ty.tySem (Ty.Prod A B)) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@jet_sha256_ctx8_init_spec.AC.drop A B C (Alg.Assertion.toCore (hash_reader_alg E)) t p e)
         (t
            (@snd
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) A)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) B) p) e)
### C.jet_sha_hash_words_reader.hr_iden
hr_iden
     : forall (E : Type) (A : Ty.Ty) (a : Ty.tySem A) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem A))
         (@jet_sha256_ctx8_init_spec.AC.iden A (Alg.Assertion.toCore (hash_reader_alg E)) a e)
         (@Some (Ty.tySem A) a)
### C.jet_sha_hash_words_reader.hr_unit
hr_unit
     : forall (E : Type) (A : Ty.Ty) (a : Ty.tySem A) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem Ty.Unit))
         (@jet_sha256_ctx8_init_spec.AC.unit A (Alg.Assertion.toCore (hash_reader_alg E)) a e)
         (@Some unit tt)
### C.jet_sha_hash_words_reader.hr_case
hr_case
     : forall (E : Type) (A B C D : Ty.Ty)
         (s : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) (Ty.Prod A C) D)
         (t : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) (Ty.Prod B C) D)
         (p : Ty.tySem (Ty.Prod (Ty.Sum A B) C)) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem D))
         (@jet_sha256_ctx8_init_spec.AC.case A B C D (Alg.Assertion.toCore (hash_reader_alg E)) s t p e)
         match
           @fst
             (sum
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) A)
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) B))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                 | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                 end) C) p
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem D))
         with
         | inl a =>
             s
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) A)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C) a
                  (@snd
                     (sum
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) A)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) B))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                         | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                         end) C) p)) e
         | inr b =>
             t
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C) b
                  (@snd
                     (sum
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) A)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) B))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                         | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                         end) C) p)) e
         end
### C.jet_sha_hash_words_reader.hr_injl
hr_injl
     : forall (E : Type) (A B C : Ty.Ty) (t : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) A B)
         (a : Ty.tySem A) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum B C)))
         (@jet_sha256_ctx8_init_spec.AC.injl A B C (Alg.Assertion.toCore (hash_reader_alg E)) t a e)
         match
           t a e
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum B C)))
         with
         | Some b =>
             @Some
               (sum (Ty.tySem B)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C))
               (@inl (Ty.tySem B)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C) b)
         | None => @None (Ty.tySem (Ty.Sum B C))
         end
### C.jet_sha_hash_words_reader.hr_injr
hr_injr
     : forall (E : Type) (A B C : Ty.Ty) (t : Alg.Core.domain (Alg.Assertion.toCore (hash_reader_alg E)) A C)
         (a : Ty.tySem A) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum B C)))
         (@jet_sha256_ctx8_init_spec.AC.injr A B C (Alg.Assertion.toCore (hash_reader_alg E)) t a e)
         match
           t a e
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum B C)))
         with
         | Some b =>
             @Some
               (sum
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B) (Ty.tySem C))
               (@inr
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B) (Ty.tySem C) b)
         | None => @None (Ty.tySem (Ty.Sum B C))
         end
### C.jet_sha_hash_words_reader.hr_copair_iden
hr_copair_iden
     : forall (E : Type) (A : Ty.Ty) (p : Ty.tySem (Ty.Sum A A)) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem A))
         (@jet_sha256_ctx8_init_spec.AC.copair A A A (Alg.Assertion.toCore (hash_reader_alg E))
            (@jet_sha256_ctx8_init_spec.AC.iden A (Alg.Assertion.toCore (hash_reader_alg E)))
            (@jet_sha256_ctx8_init_spec.AC.iden A (Alg.Assertion.toCore (hash_reader_alg E))) p e)
         (@Some
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                end) A)
            match
              p
              return
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                    | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                    end) A)
            with
            | inl a => a
            | inr a => a
            end)
### C.jet_sha_hash_words_reader.hr_assert
hr_assert
     : forall (E : Type) (A B : Ty.Ty) (t : forall alg : Alg.Assertion.Algebra, Alg.Assertion.domain alg A B)
         (_ : @Alg.Assertion.Parametric A B t) (a : Ty.tySem A) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B))
         (t (hash_reader_alg E) a e) (t (Alg.AssertionSem Option.option_Monad_Zero) a)
### C.jet_sha_hash_words_reader.hr_core
hr_core
     : forall (E : Type) (A B : Ty.Ty) (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg A B)
         (_ : @Alg.Core.Parametric A B t) (a : Ty.tySem A) (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B))
         (t (Alg.Assertion.toCore (hash_reader_alg E)) a e) (@Some (Ty.tySem B) (t Alg.CoreFunSem a))
### C.jet_sha_hash_words_reader.hash_loop_body_reader_sem
hash_loop_body_reader_sem
     : forall (E : Type) (k : nat) (C W : Ty.Ty)
         (array : Alg.Assertion.domain (hash_reader_alg E) (Ty.Prod C W)
                    (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) (cw : Ty.tySem (Ty.Prod C W))
         (ctx : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (e : E),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
         (@jet_sha_hash_loop.hash_loop_body k (hash_reader_alg E) C W array
            (@pair (Ty.tySem (Ty.Prod C W)) (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cw ctx) e)
         match
           array cw e
           return
             (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                (Ty.tySem
                   (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
         with
         | Some t =>
             match
               t
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                    (Ty.tySem
                       (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
             with
             | inl _ =>
                 @Some
                   (sum (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
                      (prod
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                   (@inl (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
                      (prod
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) ctx)
             | inr x =>
                 match
                   jet_sha_ctx8_spec.ctx8_add_list ctx (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) k x)
                   return
                     (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                        (Ty.tySem
                           (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type
                              jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
                 with
                 | Some c' =>
                     @Some
                       (sum
                          (prod
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A B => sum (tySem A) (tySem B)
                                 | Ty.Prod A B => prod (tySem A) (tySem B)
                                 end)
                                (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                             (prod
                                ((fix tySem (X : Ty.Ty) : Set :=
                                    match X return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S O))))))))
                                ((fix tySem (X : Ty.Ty) : Set :=
                                    match X return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                          (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                       (@inr
                          (prod
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A B => sum (tySem A) (tySem B)
                                 | Ty.Prod A B => prod (tySem A) (tySem B)
                                 end)
                                (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                             (prod
                                ((fix tySem (X : Ty.Ty) : Set :=
                                    match X return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S O))))))))
                                ((fix tySem (X : Ty.Ty) : Set :=
                                    match X return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                          (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) c')
                 | None =>
                     @None
                       (Ty.tySem
                          (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                 end
             end
         | None =>
             @None
               (Ty.tySem (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         end
### C.jet_sha_hash_words_reader.hash_loop_reader_sem
hash_loop_reader_sem
     : forall (E : Type) (k w : nat) (C : Ty.Ty)
         (array : Alg.Assertion.domain (hash_reader_alg E) (Ty.Prod C (Word.Word w))
                    (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) (c : Ty.tySem C)
         (ctx0 : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (e : E)
         (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
         (_ : forall
                i : (fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word w),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                   (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (array
                   (@pair (Ty.tySem C)
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word w)) c i) e)
                (@Some (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) xs
                       (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x => @inr unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None => @inl unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end)) (cf : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (jet_sha_ctx8_spec.ctx8_add_list ctx0
                   (jet_sha_hash_loop.loop_bytes k
                      (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                         (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)))
                (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cf)),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (@jet_sha_hash_loop.hash_loop_spec k w (hash_reader_alg E) C array
            (@pair (Ty.tySem C) (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) c ctx0) e)
         (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cf)
### C.jet_sha_hash_words_reader.hash_words_reader_sem
hash_words_reader_sem
     : forall (E : Type) (k w : nat) (C : Ty.Ty)
         (array : Alg.Assertion.domain (hash_reader_alg E) (Ty.Prod C (Word.Word w))
                    (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) (c : Ty.tySem C)
         (e : E) (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
         (_ : forall
                i : (fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word w),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                   (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (array
                   (@pair (Ty.tySem C)
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word w)) c i) e)
                (@Some (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) xs
                       (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x => @inr unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None => @inl unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end))
         (_ : BinInt.Z.lt
                (BinInt.Z.div
                   (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)) (jet_forWhile_seq.wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                jet_sha_ctx8_spec.ctx8_limit),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@jet_sha_hash_words.hash_words_spec k w (hash_reader_alg E) C array c e)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.from_hash256
               (jet_sha_hash_words.hash_words_of k
                  (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                     (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs))))
### C.jet_sha_hash_words_reader.hash_reader_alg
hash_reader_alg =
fun E : Type => Alg.AssertionSem (Reader.ReaderT_CIMonadZero E Option.option_Monad_Zero)
     : forall _ : Type, Alg.Assertion.Algebra

Arguments hash_reader_alg E%type_scope
