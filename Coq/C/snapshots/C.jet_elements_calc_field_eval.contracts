         (ofs : Integers.Ptrofs.int) (_ : @eq Ctypes.type (Clight.typeof a) (Ctypes.Tstruct sid Ctypes.noattr))
         (_ : envu_field_at sid field delta)
         (_ : Clight.eval_expr jet_elements_support_sha_linkage.sha_ge e le m a (Values.Vptr b ofs)),
       Clight.eval_lvalue jet_elements_support_sha_linkage.sha_ge e le m (Clight.Efield a field ty) b
