### C.jet_elements_calc_field_eval.eval_envu_deref_struct
eval_envu_deref_struct
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (x : BinNums.positive)
         (sid : AST.ident) (b : Values.block) (ofs : Integers.Ptrofs.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val x le) (@Some Values.val (Values.Vptr b ofs))),
       Clight.eval_expr jet_elements_support_sha_linkage.sha_ge e le m
         (Clight.Ederef (Clight.Etempvar x (Ctypesdefs.tptr (Ctypes.Tstruct sid Ctypes.noattr)))
            (Ctypes.Tstruct sid Ctypes.noattr)) (Values.Vptr b ofs)
