envu_loadv_repr
     : forall (chunk : AST.memory_chunk) (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z)
         (v : Values.val) (_ : and (BinInt.Z.le BinNums.Z0 base) (BinInt.Z.le base Integers.Ptrofs.max_unsigned))
         (_ : @eq (option Values.val) (Memory.Mem.load chunk m b base) (@Some Values.val v)),
       @eq (option Values.val) (Memory.Mem.loadv chunk m (Values.Vptr b (Integers.Ptrofs.repr base)))
         (@Some Values.val v)
### C.jet_elements_calc_field_eval.envu_field_offset_at
envu_field_offset_at
     : forall (sid field : AST.ident) (delta : BinNums.Z)
         (_ : @eq (option BinNums.Z) (envu_field_offset sid field) (@Some BinNums.Z delta)),
       envu_field_at sid field delta
### C.jet_elements_calc_field_eval.envu_sha256_midstate_s
envu_sha256_midstate_s
     : envu_field_at jets_elements._sha256_midstate jets_elements._s BinNums.Z0
### C.jet_elements_calc_field_eval.calc_eval_local_mid_s
calc_eval_local_mid_s
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (id : BinNums.positive) (b : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))),
       Clight.eval_expr jet_elements_support_sha_linkage.sha_ge e le m
         (Clight.Efield (Clight.Evar id (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) jets_elements._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr b Integers.Ptrofs.zero)
### C.jet_elements_calc_field_eval.envu_field_at
envu_field_at =
fun (sid field : AST.ident) (delta : BinNums.Z) =>
match @Maps.PTree.get Ctypes.composite sid (Clight.genv_cenv jet_elements_support_sha_linkage.sha_ge) return Prop with
| Some co =>
    @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
      (Ctypes.field_offset (Clight.genv_cenv jet_elements_support_sha_linkage.sha_ge) field (Ctypes.co_members co))
      (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield delta Ctypes.Full))
| None => False
end
     : forall (_ : AST.ident) (_ : AST.ident) (_ : BinNums.Z), Prop

Arguments envu_field_at sid field delta%Z_scope
### C.jet_elements_calc_field_eval.envu_struct
envu_struct =
fun (t : Ctypes.type) (sid : AST.ident) => @eq Ctypes.type t (Ctypes.Tstruct sid Ctypes.noattr)
     : forall (_ : Ctypes.type) (_ : AST.ident), Prop

Arguments envu_struct t sid
### C.jet_elements_calc_field_eval.envu_field_offset
envu_field_offset =
fun sid field : AST.ident =>
match
  @Maps.PTree.get Ctypes.composite sid (Clight.genv_cenv jet_elements_support_sha_linkage.sha_ge)
  return (option BinNums.Z)
with
| Some co =>
    match
      Ctypes.field_offset (Clight.genv_cenv jet_elements_support_sha_linkage.sha_ge) field (Ctypes.co_members co)
      return (option BinNums.Z)
    with
    | Errors.OK p =>
        match p return (option BinNums.Z) with
        | pair d b =>
            match b return (option BinNums.Z) with
            | Ctypes.Full => @Some BinNums.Z d
            | Ctypes.Bits _ _ _ _ => @None BinNums.Z
            end
        end
    | Errors.Error _ => @None BinNums.Z
    end
| None => @None BinNums.Z
end
     : forall (_ : AST.ident) (_ : AST.ident), option BinNums.Z

Arguments envu_field_offset sid field
