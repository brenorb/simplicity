### C.jet_secp_write_ge_negated_literal.literal_ge_negate_step
literal_ge_negate_step
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@jet_secp_gej_negate_literal.literal_ge_negate Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
            (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem y))
### C.jet_secp_write_ge_negated_literal.literal_ge_negate_writer_encoding
literal_ge_negate_writer_encoding
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list BitMachine.Cell)
         (@app BitMachine.Cell
            (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_point_write_field.point_field_output
                  (jet_secp_point_field_bridge.point_canonical_field
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)))))
            (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_point_write_field.point_field_output
                  (jet_secp_point_field_bridge.point_negative_field
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem y))))))
         (@Translate.encode
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@jet_secp_gej_negate_literal.literal_ge_negate Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y)))
### C.jet_secp_write_ge_negated_literal.eval_write_ge_negated_literal
eval_write_ge_negated_literal
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (m : Memory.Mem.mem)
         (b : Values.block) (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N) (_ : jet_frame_inv.finv m0 bd dbase bw edge cursor N bi m false (@nil BitMachine.Cell))
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)))))
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_field_negate_storage.negate_values
                   (jet_secp_write_fe_numeric.write_fe_rho
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem y)) BinNums.Z0)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_write_ge)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_frame_inv.finv m0 bd dbase bw edge cursor N bi mf true
                  (@Translate.encode
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@jet_secp_gej_negate_literal.literal_ge_negate Alg.CoreFunSem
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (bx : Values.block) (_ : BinNums.Z) =>
                      and (not (@eq Values.block bx b)) (not (jet_secp_frame.extA m0 bd bw bi bx))) m mf))))
