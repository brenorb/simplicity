### C.jet_secp_strauss_window_values.secp_combine_maps
@secp_combine_maps
     : forall (A B : Type) (xs : list A) (ys : list B) (_ : @eq nat (@length A xs) (@length B ys)),
       and (@eq (list A) (@List.map (prod A B) A (@fst A B) (@List.combine A B xs ys)) xs)
         (@eq (list B) (@List.map (prod A B) B (@snd A B) (@List.combine A B xs ys)) ys)
### C.jet_secp_strauss_window_values.secp_fold_left_map
@secp_fold_left_map
     : forall (A B C : Type) (step : forall (_ : C) (_ : B), C) (f : forall _ : A, B) (xs : list A) (c : C),
       @eq C (@List.fold_left C A (fun (acc : C) (x : A) => step acc (f x)) xs c)
         (@List.fold_left C B step (@List.map A B f xs) c)
