### C.jet_sx_eval.ptr_add_repr
ptr_add_repr
     : forall B d sz k : BinNums.Z,
       @eq Integers.Ptrofs.int
         (Integers.Ptrofs.add (Integers.Ptrofs.repr (BinInt.Z.add B d))
            (Integers.Ptrofs.mul (Integers.Ptrofs.repr sz) (Integers.Ptrofs.repr k)))
         (Integers.Ptrofs.repr (BinInt.Z.add B (BinInt.Z.add d (BinInt.Z.mul sz k))))
### C.jet_sx_eval.ptr_add_repr1
ptr_add_repr1
     : forall B d k : BinNums.Z,
       @eq Integers.Ptrofs.int (Integers.Ptrofs.add (Integers.Ptrofs.repr (BinInt.Z.add B d)) (Integers.Ptrofs.repr k))
         (Integers.Ptrofs.repr (BinInt.Z.add B (BinInt.Z.add d k)))
### C.jet_sx_eval.xptradd_sound
xptradd_sound
     : forall (ge : Clight.genv) (ρ : forall _ : nat, Integers.Int64.int) (β : jet_sx_state.layout)
         (m : Memory.Mem.mem) (xa : jet_sx_expr.sx) (ta : Ctypes.type) (xb : jet_sx_expr.sx)
         (tb : Ctypes.type) (x : jet_sx_expr.sx)
         (_ : @eq (option jet_sx_expr.sx) (xptradd (Clight.genv_cenv ge) xa ta xb tb) (@Some jet_sx_expr.sx x)),
       @eq (option Values.val)
         (Cop.sem_binary_operation (Clight.genv_cenv ge) Cop.Oadd (jet_sx_expr.den ρ (jet_sx_state.lay β) xa) ta
            (jet_sx_expr.den ρ (jet_sx_state.lay β) xb) tb m)
         (@Some Values.val (jet_sx_expr.den ρ (jet_sx_state.lay β) x))
