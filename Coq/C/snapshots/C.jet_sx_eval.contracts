### C.jet_sx_eval.load_lv_sound
load_lv_sound
     : forall (ge : Clight.genv) (ρ : forall _ : nat, Integers.Int64.int) (β : jet_sx_state.layout)
         (Σ : sstate) (m : Memory.Mem.mem) (e : Clight.env) (le : Clight.temp_env)
         (_ : jet_sx_state.rep ρ β (sregs Σ) m) (a : Clight.expr) (r : nat) (d : BinNums.Z)
         (x : jet_sx_expr.sx)
         (_ : Clight.eval_lvalue ge e le m a (jet_sx_state.blk β r)
