lv_var_sound
     : forall (ge : Clight.genv) (ve gv : venv) (β : jet_sx_state.layout) (m : Memory.Mem.mem)
         (e : Clight.env) (le : Clight.temp_env) (_ : ematch β ve e) (_ : gmatch ge β gv) (id : AST.ident)
         (ty : Ctypes.type) (r : nat) (d : BinNums.Z)
         (_ : @eq (option (prod nat BinNums.Z)) (lv_var ve gv id ty)
                (@Some (prod nat BinNums.Z) (@pair nat BinNums.Z r d))),
       Clight.eval_lvalue ge e le m (Clight.Evar id ty) (jet_sx_state.blk β r)
         (Integers.Ptrofs.repr (BinInt.Z.add (jet_sx_state.bas β r) d)) Ctypes.Full
### C.jet_sx_eval.xexpr_sound_both
xexpr_sound_both
     : forall (ge : Clight.genv) (ve gv : venv) (ρ : forall _ : nat, Integers.Int64.int) (β : jet_sx_state.layout)
         (Σ : sstate) (m : Memory.Mem.mem) (e : Clight.env) (le : Clight.temp_env)
         (_ : jet_sx_state.rep ρ β (sregs Σ) m) (_ : tmatch ρ β (stemps Σ) le) (_ : ematch β ve e)
         (_ : gmatch ge β gv) (a : Clight.expr),
       and
         (forall (x : jet_sx_expr.sx)
            (_ : @eq (option jet_sx_expr.sx) (xexpr (Clight.genv_cenv ge) ve gv Σ a) (@Some jet_sx_expr.sx x)),
          Clight.eval_expr ge e le m a (jet_sx_expr.den ρ (jet_sx_state.lay β) x))
         (forall (r : nat) (d : BinNums.Z)
            (_ : @eq (option (prod nat BinNums.Z)) (xlval (Clight.genv_cenv ge) ve gv Σ a)
                   (@Some (prod nat BinNums.Z) (@pair nat BinNums.Z r d))),
          Clight.eval_lvalue ge e le m a (jet_sx_state.blk β r)
            (Integers.Ptrofs.repr (BinInt.Z.add (jet_sx_state.bas β r) d)) Ctypes.Full)
