xbinop_sound
     : forall (ge : Clight.genv) (ρ : forall _ : nat, Integers.Int64.int) (β : jet_sx_state.layout)
         (m : Memory.Mem.mem) (op : Cop.binary_operation) (xa : jet_sx_expr.sx) (ta : Ctypes.type)
         (xb : jet_sx_expr.sx) (tb : Ctypes.type) (x : jet_sx_expr.sx)
