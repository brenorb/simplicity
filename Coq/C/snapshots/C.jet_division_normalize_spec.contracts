### C.jet_division_normalize_spec.division_pre_branch_parametric
division_pre_branch_parametric
     : forall n m : nat,
       @Alg.Core.Parametric (division_pre_state (Nat.add m n)) (division_pre_state (Nat.add m n))
         (@division_pre_branch n m)
### C.jet_division_normalize_spec.division_post_branch_parametric
division_post_branch_parametric
     : forall n m : nat,
       @Alg.Core.Parametric (division_post_state (Nat.add m n)) (division_post_state (Nat.add m n))
         (@division_post_branch n m)
### C.jet_division_normalize_spec.cast_state_endo_parametric
cast_state_endo_parametric
     : forall (F : forall _ : nat, Ty.Ty) (p q : nat) (e : @eq nat p q)
         (f : forall term : Alg.Core.Algebra, Alg.Core.domain term (F p) (F p))
         (_ : @Alg.Core.Parametric (F p) (F p) f),
       @Alg.Core.Parametric (F q) (F q) (fun term : Alg.Core.Algebra => @cast_state_endo F p q e term (f term))
### C.jet_division_normalize_spec.division_pre_shift_spec_parametric
division_pre_shift_spec_parametric
     : forall n m : nat,
       @Alg.Core.Parametric (division_pre_state (Nat.add m n)) (division_pre_state (Nat.add m n))
         (@division_pre_shift_spec n m)
### C.jet_division_normalize_spec.division_post_shift_spec_parametric
division_post_shift_spec_parametric
     : forall n m : nat,
       @Alg.Core.Parametric (division_post_state (Nat.add m n)) (division_post_state (Nat.add m n))
         (@division_post_shift_spec n m)
### C.jet_division_normalize_spec.cast_state_value_inverse
cast_state_value_inverse
     : forall (F : forall _ : nat, Ty.Ty) (p q : nat) (e : @eq nat p q) (v : Ty.tySem (F q)),
       @eq (Ty.tySem (F q))
         (@eq_rect nat p (fun w : nat => Ty.tySem (F w))
            (@eq_rect nat q (fun w : nat => Ty.tySem (F w)) v p (@eq_sym nat p q e)) q e) v
### C.jet_division_normalize_spec.cast_state_endo_core
cast_state_endo_core
     : forall (F : forall _ : nat, Ty.Ty) (p q : nat) (e : @eq nat p q) (f : Ty.Arrow (F p) (F p)) (v : Ty.tySem (F p)),
       @eq (Ty.tySem (F q))
         (@cast_state_endo F p q e Alg.CoreFunSem f (@eq_rect nat p (fun w : nat => Ty.tySem (F w)) v q e))
         (@eq_rect nat p (fun w : nat => Ty.tySem (F w)) (f v) q e)
