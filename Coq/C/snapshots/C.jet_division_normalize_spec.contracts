                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end) (Word.Word (Nat.add m n)))
            (@division_post_branch n m Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (Nat.add m n))) (Ty.tySem (Word.Word (Nat.add m n))) r b)))
