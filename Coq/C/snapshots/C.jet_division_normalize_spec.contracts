### C.jet_division_normalize_spec.division_post_branch_core
division_post_branch_core
     : forall (n m : nat) (v : Ty.tySem (division_post_state (Nat.add m n))),
       @eq (Ty.tySem (division_post_state (Nat.add m n))) (@division_post_branch n m Alg.CoreFunSem v)
         match
           @jet_test_value_spec.is_zero_word_spec n Alg.CoreFunSem
             (@jet_division_shift_step.division_leftmost_block n m Alg.CoreFunSem
                (@snd
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (Nat.add m n)))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (Nat.add m n))) v)) return (Ty.tySem (division_post_state (Nat.add m n)))
         with
         | inl _ => v
         | inr _ => @jet_division_shift_step.division_post_shift_step n m Alg.CoreFunSem v
         end
### C.jet_division_normalize_spec.division_post_branch_scale
division_post_branch_scale
     : forall (n m : nat) (a b : Ty.tySem (Word.Word (Nat.add (S m) n)))
         (_ : BinInt.Z.le (jet_predicate_spec.word_modulus (Nat.add (S m) n))
                (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add (S m) n)) b)
                   (jet_predicate_spec.word_modulus (S n)))),
       let result : Ty.tySem (division_post_state (Nat.add (S m) n)) :=
         @division_post_branch n (S m) Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word (Nat.add (S m) n))) (Ty.tySem (Word.Word (Nat.add (S m) n))) a b) in
       @ex BinNums.Z
         (fun k : BinNums.Z =>
          and (BinInt.Z.lt BinNums.Z0 k)
            (and
               (@eq BinNums.Z
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add (S m) n))
                     (@fst
                        (prod
                           ((fix tySem (X : Ty.Ty) : Set :=
                               match X return Set with
                               | Ty.Unit => unit
                               | Ty.Sum A B => sum (tySem A) (tySem B)
                               | Ty.Prod A B => prod (tySem A) (tySem B)
                               end)
                              ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                  match n0 return Ty.Ty with
                                  | O => X
                                  | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                  end) (Ty.Sum Ty.Unit Ty.Unit)
                                 ((fix add (n0 m0 : nat) {struct n0} : nat :=
                                     match n0 return nat with
                                     | O => m0
                                     | S p => S (add p m0)
                                     end) m n)))
                           ((fix tySem (X : Ty.Ty) : Set :=
                               match X return Set with
                               | Ty.Unit => unit
                               | Ty.Sum A B => sum (tySem A) (tySem B)
                               | Ty.Prod A B => prod (tySem A) (tySem B)
                               end)
                              ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                  match n0 return Ty.Ty with
                                  | O => X
                                  | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                  end) (Ty.Sum Ty.Unit Ty.Unit)
                                 ((fix add (n0 m0 : nat) {struct n0} : nat :=
                                     match n0 return nat with
