### C.jet_division_normalize_spec.numeric_lt_product_transport
numeric_lt_product_transport
     : forall (x x' y y' c c' : BinNums.Z) (_ : @eq BinNums.Z x x') (_ : @eq BinNums.Z y y')
         (_ : @eq BinNums.Z c c') (_ : BinInt.Z.lt x' (BinInt.Z.mul y' c')), BinInt.Z.lt x (BinInt.Z.mul y c)
