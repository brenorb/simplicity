### C.jet_division_normalize_spec.division_post_shift_normalizes
division_post_shift_normalizes
     : forall (n m : nat) (v : Ty.tySem (division_post_state (Nat.add m n)))
         (_ : BinInt.Z.le (jet_predicate_spec.word_modulus (Nat.add m n))
                (BinInt.Z.mul
                   (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
                      (@snd
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (Nat.add m n)))
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (Nat.add m n))) v)) (jet_predicate_spec.word_modulus n))),
       let result : Ty.tySem (division_post_state (Nat.add m n)) := @division_post_shift_spec n m Alg.CoreFunSem v in
       @ex BinNums.Z
         (fun k : BinNums.Z =>
          and (BinInt.Z.lt BinNums.Z0 k)
            (and
               (@eq BinNums.Z
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
                     (@fst
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) (Word.Word (Nat.add m n)))
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) (Word.Word (Nat.add m n))) result))
                  (BinInt.Z.div
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
                        (@fst
                           ((fix tySem (X : Ty.Ty) : Set :=
                               match X return Set with
                               | Ty.Unit => unit
                               | Ty.Sum A B => sum (tySem A) (tySem B)
                               | Ty.Prod A B => prod (tySem A) (tySem B)
                               end) (Word.Word (Nat.add m n)))
                           ((fix tySem (X : Ty.Ty) : Set :=
                               match X return Set with
                               | Ty.Unit => unit
                               | Ty.Sum A B => sum (tySem A) (tySem B)
                               | Ty.Prod A B => prod (tySem A) (tySem B)
                               end) (Word.Word (Nat.add m n))) v)) k))
               (and
                  (@eq BinNums.Z
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
                        (@snd
                           ((fix tySem (X : Ty.Ty) : Set :=
                               match X return Set with
                               | Ty.Unit => unit
                               | Ty.Sum A B => sum (tySem A) (tySem B)
                               | Ty.Prod A B => prod (tySem A) (tySem B)
                               end) (Word.Word (Nat.add m n)))
                           ((fix tySem (X : Ty.Ty) : Set :=
                               match X return Set with
                               | Ty.Unit => unit
                               | Ty.Sum A B => sum (tySem A) (tySem B)
                               | Ty.Prod A B => prod (tySem A) (tySem B)
                               end) (Word.Word (Nat.add m n))) result))
                     (BinInt.Z.mul
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
                           (@snd
                              ((fix tySem (X : Ty.Ty) : Set :=
                                  match X return Set with
                                  | Ty.Unit => unit
                                  | Ty.Sum A B => sum (tySem A) (tySem B)
                                  | Ty.Prod A B => prod (tySem A) (tySem B)
                                  end) (Word.Word (Nat.add m n)))
                              ((fix tySem (X : Ty.Ty) : Set :=
                                  match X return Set with
                                  | Ty.Unit => unit
                                  | Ty.Sum A B => sum (tySem A) (tySem B)
                                  | Ty.Prod A B => prod (tySem A) (tySem B)
                                  end) (Word.Word (Nat.add m n))) v)) k))
                  (BinInt.Z.le (jet_predicate_spec.word_modulus (Nat.add m n))
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
                           (@snd
                              ((fix tySem (X : Ty.Ty) : Set :=
                                  match X return Set with
                                  | Ty.Unit => unit
                                  | Ty.Sum A B => sum (tySem A) (tySem B)
                                  | Ty.Prod A B => prod (tySem A) (tySem B)
                                  end) (Word.Word (Nat.add m n)))
                              ((fix tySem (X : Ty.Ty) : Set :=
                                  match X return Set with
                                  | Ty.Unit => unit
                                  | Ty.Sum A B => sum (tySem A) (tySem B)
                                  | Ty.Prod A B => prod (tySem A) (tySem B)
                                  end) (Word.Word (Nat.add m n))) result)))))))
### C.jet_division_normalize_spec.division_branch_same_denominator
division_branch_same_denominator
     : forall (n m : nat) (a : Ty.tySem (Word.Word (S (Nat.add m n)))) (r b : Ty.tySem (Word.Word (Nat.add m n))),
       @eq
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
