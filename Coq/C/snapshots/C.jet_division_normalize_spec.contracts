                                  | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                  end) (Ty.Sum Ty.Unit Ty.Unit)
                                 ((fix add (n0 m0 : nat) {struct n0} : nat :=
                                     match n0 return nat with
                                     | O => m0
                                     | S p => S (add p m0)
                                     end) m n)))) result))
                  (BinInt.Z.div (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add (S m) n)) a) k))
               (and
                  (@eq BinNums.Z
