     : forall (n m : nat) (v : Ty.tySem (division_pre_state (Nat.add m (S n)))),
       let e : @eq nat (S (PeanoNat.Nat.add m n)) (PeanoNat.Nat.add m (S n)) :=
         @eq_sym nat (PeanoNat.Nat.add m (S n)) (S (PeanoNat.Nat.add m n)) (PeanoNat.Nat.add_succ_r m n) in
       let u : Ty.tySem (division_pre_state (Nat.add (S m) n)) :=
         @eq_rect nat (Nat.add m (S n)) (fun w : nat => Ty.tySem (division_pre_state w)) v
           (Nat.add (S m) n) (@eq_sym nat (S (PeanoNat.Nat.add m n)) (PeanoNat.Nat.add m (S n)) e) in
       let rec : Ty.tySem (division_pre_state (Nat.add (S m) n)) :=
         @division_pre_shift_spec n (S m) Alg.CoreFunSem (@division_pre_branch n (S m) Alg.CoreFunSem u) in
