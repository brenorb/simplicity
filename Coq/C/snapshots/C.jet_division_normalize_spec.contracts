### C.jet_division_normalize_spec.division_pre_state
division_pre_state = fun w : nat => Ty.Prod (Word.Word (S w)) (Word.Word w)
     : forall _ : nat, Ty.Ty

Arguments division_pre_state w%nat_scope
### C.jet_division_normalize_spec.division_post_state
division_post_state = fun w : nat => Ty.Prod (Word.Word w) (Word.Word w)
     : forall _ : nat, Ty.Ty

Arguments division_post_state w%nat_scope
### C.jet_division_normalize_spec.cast_state_endo
cast_state_endo =
fun (F : forall _ : nat, Ty.Ty) (p q : nat) (e : @eq nat p q) (term : Alg.Core.Algebra)
  (f : Alg.Core.domain term (F p) (F p)) => @eq_rect nat p (fun w : nat => Alg.Core.domain term (F w) (F w)) f q e
     : forall (F : forall _ : nat, Ty.Ty) (p q : nat) (_ : @eq nat p q) (term : Alg.Core.Algebra)
         (_ : Alg.Core.domain term (F p) (F p)), Alg.Core.domain term (F q) (F q)

Arguments cast_state_endo F%function_scope (p q)%nat_scope e {term} f
### C.jet_division_normalize_spec.division_pre_branch
division_pre_branch =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))))
  (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term
  (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)))
     (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term
     (@Alg.Core.Combinators.drop (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)) (Ty.Sum Ty.Unit Ty.Unit) term
        (@Alg.Core.Combinators.comp (Word.Word (Nat.add m n)) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term
           (@jet_division_shift_step.division_leftmost_block n m term) (@jet_test_value_spec.is_zero_word_spec n term)))
     (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term))
  (@Bit.cond (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)))
     (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term
     (@jet_division_shift_step.division_pre_shift_step n m term)
     (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term))
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (division_pre_state (Nat.add m n)) (division_pre_state (Nat.add m n))

Arguments division_pre_branch (n m)%nat_scope {term}
### C.jet_division_normalize_spec.division_post_branch
division_post_branch =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))))
  (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term
  (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
     (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term
     (@Alg.Core.Combinators.drop (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)) (Ty.Sum Ty.Unit Ty.Unit) term
        (@Alg.Core.Combinators.comp (Word.Word (Nat.add m n)) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term
           (@jet_division_shift_step.division_leftmost_block n m term) (@jet_test_value_spec.is_zero_word_spec n term)))
     (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term))
  (@Bit.cond (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
     (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term
     (@jet_division_shift_step.division_post_shift_step n m term)
     (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term))
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (division_post_state (Nat.add m n)) (division_post_state (Nat.add m n))

Arguments division_post_branch (n m)%nat_scope {term}
### C.jet_division_normalize_spec.division_pre_shift_spec
division_pre_shift_spec =
fix division_pre_shift_spec (n m : nat) (term : Alg.Core.Algebra) {struct n} :
    Alg.Core.domain term (division_pre_state (Nat.add m n)) (division_pre_state (Nat.add m n)) :=
  match
    n as n0 return (Alg.Core.domain term (division_pre_state (Nat.add m n0)) (division_pre_state (Nat.add m n0)))
  with
  | O => @Alg.Core.Combinators.iden (division_pre_state (Nat.add m O)) term
  | S n0 =>
      @cast_state_endo division_pre_state (Nat.add (S m) n0) (Nat.add m (S n0))
        (@eq_sym nat (PeanoNat.Nat.add m (S n0)) (S (PeanoNat.Nat.add m n0)) (PeanoNat.Nat.add_succ_r m n0)) term
        (@Alg.Core.Combinators.comp (division_pre_state (Nat.add (S m) n0)) (division_pre_state (Nat.add (S m) n0))
           (division_pre_state (Nat.add (S m) n0)) term (@division_pre_branch n0 (S m) term)
           (division_pre_shift_spec n0 (S m) term))
  end
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (division_pre_state (Nat.add m n)) (division_pre_state (Nat.add m n))

Arguments division_pre_shift_spec (n m)%nat_scope {term}
### C.jet_division_normalize_spec.division_post_shift_spec
division_post_shift_spec =
fix division_post_shift_spec (n m : nat) (term : Alg.Core.Algebra) {struct n} :
    Alg.Core.domain term (division_post_state (Nat.add m n)) (division_post_state (Nat.add m n)) :=
  match
    n as n0 return (Alg.Core.domain term (division_post_state (Nat.add m n0)) (division_post_state (Nat.add m n0)))
  with
  | O => @Alg.Core.Combinators.iden (division_post_state (Nat.add m O)) term
  | S n0 =>
      @cast_state_endo division_post_state (Nat.add (S m) n0) (Nat.add m (S n0))
        (@eq_sym nat (PeanoNat.Nat.add m (S n0)) (S (PeanoNat.Nat.add m n0)) (PeanoNat.Nat.add_succ_r m n0)) term
        (@Alg.Core.Combinators.comp (division_post_state (Nat.add (S m) n0)) (division_post_state (Nat.add (S m) n0))
           (division_post_state (Nat.add (S m) n0)) term (@division_post_branch n0 (S m) term)
           (division_post_shift_spec n0 (S m) term))
  end
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (division_post_state (Nat.add m n)) (division_post_state (Nat.add m n))

Arguments division_post_shift_spec (n m)%nat_scope {term}
