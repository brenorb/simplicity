### C.jet_secp_modinv_var_finish.exec_inv_finish
exec_inv_finish
     : forall (len : nat) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (e : Clight.env) (le0 : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : and (lt O len) (le len (S (S (S (S (S O)))))))
         (_ : jet_sx_state.rep rho beta jet_secp_modinv_var_de.inv_loop_regs m)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_var_entry.inv_start_alloc) e)
         (_ : @eq Values.block (jet_sx_state.blk beta (S O)) jet_secp_modinfo_fe_global.modinfo_fe_block)
         (_ : @eq BinNums.Z (jet_sx_state.bas beta (S O)) BinNums.Z0)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le0)
                (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat len)))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._modinfo le0)
                (@Some Values.val
                   (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._x le0)
                (@Some Values.val (Values.Vptr (jet_sx_state.blk beta O) Integers.Ptrofs.zero)))
         (_ : jet_secp_modinv_de_numeric.de62_state_bounds (jet_secp_modinv_var_de.inv_de_rho rho)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 m inv_finish Events.E0
               (inv_finish_temps len rho le0) mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf (jet_sx_state.blk beta O) BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (inv_finish_words len rho)))
               (and
                  (jet_secp_fe_nv.fe_at mf (jet_sx_state.blk beta (S (S O))) BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (inv_finish_words len rho)))
                  (and (jet_secp_signed62_numeric.signed62_normalized (inv_finish_words len rho))
                     (and
                        (@eq BinNums.Z (jet_secp_signed62_numeric.signed62_unsigned_value (inv_finish_words len rho))
                           (BinInt.Z.modulo
                              (BinInt.Z.mul
                                 match
                                   Integers.Int64.lt (inv_finish_sign len rho) Integers.Int64.zero return BinNums.Z
                                 with
                                 | true => BinNums.Zneg BinNums.xH
                                 | false => BinNums.Zpos BinNums.xH
                                 end
                                 (jet_secp_modinv_de_numeric.de62_input_value (jet_secp_modinv_var_de.inv_de_rho rho)
                                    false)) jet_secp_fe_math.feP))
                        (and
                           (Memory.Mem.range_perm mf (jet_sx_state.blk beta O) BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf (jet_sx_state.blk beta (S (S O))) BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_secp_modinfo_fe_global.modinfo_fe_global_rep mf)
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (ofs : BinNums.Z) =>
                                     and
                                       (jet_secp_modinv_normalize62_exec.norm62_outside
                                          (jet_sx_state.blk beta (S (S O))) jet_secp_modinfo_fe_global.modinfo_fe_block
                                          b ofs) (not (@eq Values.block b (jet_sx_state.blk beta O)))) m mf)))))))))
### C.jet_secp_modinv_var_finish.inv_finish
inv_finish =
match jet_secp_modinv_var_copies.inv_after_ready return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ rest => rest
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_modinv_var_finish.inv_finish_sign_load
inv_finish_sign_load =
Clight.Sset jets_secp._t'2
  (jet_secp_modinv_var_shorten.inv_local_index jets_secp._f (jet_secp_modinv_var_shorten.inv_len_sub (S O)))
     : Clight.statement
### C.jet_secp_modinv_var_finish.inv_finish_normalize
inv_finish_normalize =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_modinv64_normalize_62
  jets_secp.f_secp256k1_modinv64_normalize_62 (@None AST.ident)
  (@cons Clight.expr (jet_secp_modinv_var_de.inv_s62_address jets_secp._d)
     (@cons Clight.expr (Clight.Etempvar jets_secp._t'2 Ctypesdefs.tlong)
        (@cons Clight.expr jet_secp_modinv_var_de.inv_metadata_arg (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_modinv_var_finish.inv_finish_copy
inv_finish_copy =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_modinv64_signed62_assign
  jets_secp.f_secp256k1_modinv64_signed62_assign (@None AST.ident)
  (@cons Clight.expr (Clight.Etempvar jets_secp._x (Ctypesdefs.tptr jet_secp_modinv_fg_index.fg_s62_type))
     (@cons Clight.expr (jet_secp_modinv_var_de.inv_s62_address jets_secp._d) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_modinv_var_finish.inv_finish_sign
inv_finish_sign =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) =>
rho (Nat.add (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))) (Nat.sub len (S O)))
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int), Integers.Int64.int

Arguments inv_finish_sign len%nat_scope rho%function_scope
### C.jet_secp_modinv_var_finish.inv_finish_d
inv_finish_d =
fun (rho : forall _ : nat, Integers.Int64.int) (i : nat) => rho (Nat.add (S (S (S (S (S O))))) i)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments inv_finish_d rho%function_scope i%nat_scope
### C.jet_secp_modinv_var_finish.inv_finish_words
inv_finish_words =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) =>
jet_secp_modinv_normalize62_exec.norm62_machine (inv_finish_d rho) jet_secp_modinfo_fe_copy.modinfo_fe_limb
  (inv_finish_sign len rho)
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments inv_finish_words len%nat_scope rho%function_scope i%nat_scope
### C.jet_secp_modinv_var_finish.inv_finish_temps
inv_finish_temps =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) (le : Maps.PTree.tree Values.val) =>
@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vlong (inv_finish_sign len rho)) le
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : Maps.PTree.tree Values.val),
       Maps.PTree.tree Values.val

Arguments inv_finish_temps len%nat_scope rho%function_scope le
