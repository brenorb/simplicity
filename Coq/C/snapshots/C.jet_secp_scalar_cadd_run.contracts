                                                                 (jet_sx_expr.XLb jet_sx_expr.Badd ... ...)
                                                                 (jet_sx_expr.XLc ...)))) (jet_sx_expr.XLv (S (S O))))
                                                     (jet_sx_expr.XLc
                                                        match
                                                          match flag return bool with
                                                          | true => false
                                                          | false => false
                                                          end return Integers.Int64.int
                                                        with
                                                        | true =>
                                                            Integers.Int64.mkint (BinNums.Zpos BinNums.xH)
                                                              (Integers.Int64.Z_mod_modulus_range'
                                                                 (BinNums.Zpos BinNums.xH))
                                                        | false =>
                                                            Integers.Int64.mkint BinNums.Z0
                                                              (Integers.Int64.Z_mod_modulus_range' BinNums.Z0)
                                                        end))
                                                  (jet_sx_expr.XLc
                                                     match
                                                       match flag return bool with
                                                       | true => false
                                                       | false => false
                                                       end return Integers.Int64.int
                                                     with
                                                     | true =>
                                                         Integers.Int64.mkint (BinNums.Zpos BinNums.xH)
                                                           (Integers.Int64.Z_mod_modulus_range'
                                                              (BinNums.Zpos BinNums.xH))
                                                     | false =>
                                                         Integers.Int64.mkint BinNums.Z0
                                                           (Integers.Int64.Z_mod_modulus_range' BinNums.Z0)
                                                     end)))) (jet_sx_expr.XLv (S (S (S O)))))
                                      (jet_sx_expr.XLc
                                         match
                                           match flag return bool with
                                           | true => false
                                           | false => false
                                           end return Integers.Int64.int
                                         with
                                         | true =>
                                             Integers.Int64.mkint (BinNums.Zpos BinNums.xH)
                                               (Integers.Int64.Z_mod_modulus_range' (BinNums.Zpos BinNums.xH))
                                         | false =>
                                             Integers.Int64.mkint BinNums.Z0
                                               (Integers.Int64.Z_mod_modulus_range' BinNums.Z0)
                                         end))
                                   (jet_sx_expr.XLc
                                      match
                                        match flag return bool with
                                        | true => false
                                        | false => false
                                        end return Integers.Int64.int
                                      with
                                      | true =>
                                          Integers.Int64.mkint (BinNums.Zpos BinNums.xH)
                                            (Integers.Int64.Z_mod_modulus_range' (BinNums.Zpos BinNums.xH))
                                      | false =>
                                          Integers.Int64.mkint BinNums.Z0
                                            (Integers.Int64.Z_mod_modulus_range' BinNums.Z0)
                                      end)))))) (@nil jet_sx_state.cell))) true
              (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
           (@nil jet_sx_state.region)))
     (@cons jet_sx_eval.event (jet_sx_eval.mkev O (S (S (S (S O)))) O (@nil jet_sx_expr.sx))
        (@cons jet_sx_eval.event (jet_sx_eval.mkev O (S (S (S (S O)))) O (@nil jet_sx_expr.sx))
           (@cons jet_sx_eval.event (jet_sx_eval.mkev O (S (S (S (S O)))) O (@nil jet_sx_expr.sx))
              (@nil jet_sx_eval.event)))) (S (S (S (S O)))))
     : forall _ : bool, option jet_sx_eval.sstate

Arguments cadd_walk_tree flag%bool_scope
### C.jet_secp_scalar_cadd_run.cadd_final_state
cadd_final_state =
fun flag : bool =>
match cadd_walk_tree flag return jet_sx_eval.sstate with
| Some st => st
| None => cadd_initial_state flag
end
     : forall _ : bool, jet_sx_eval.sstate

Arguments cadd_final_state flag%bool_scope
### C.jet_secp_scalar_cadd_run.cadd_checkpoint
cadd_checkpoint =
fun (flag : bool) (j : nat) =>
match cadd_walk flag j return jet_sx_eval.sstate with
| Some st => st
| None => cadd_initial_state flag
end
     : forall (_ : bool) (_ : nat), jet_sx_eval.sstate

Arguments cadd_checkpoint flag%bool_scope j%nat_scope
### C.jet_secp_scalar_cadd_run.cadd_called_state
cadd_called_state =
fun (flag : bool) (j : nat) =>
match cadd_selector_run flag j (cadd_checkpoint flag j) return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ => cadd_initial_state flag
    end
| None => cadd_initial_state flag
end
     : forall (_ : bool) (_ : nat), jet_sx_eval.sstate

Arguments cadd_called_state flag%bool_scope j%nat_scope
### C.jet_secp_scalar_cadd_run.cadd_selected_state
cadd_selected_state =
fun (flag : bool) (j : nat) => cadd_selector_next (cadd_checkpoint flag j) (cadd_called_state flag j)
     : forall (_ : bool) (_ : nat), jet_sx_eval.sstate

Arguments cadd_selected_state flag%bool_scope j%nat_scope
### C.jet_secp_scalar_cadd_run.cadd_bit_expression
cadd_bit_expression =
fun flag : bool =>
match
  @Maps.PTree.get jet_sx_expr.sx jets_secp._bit (jet_sx_eval.stemps (cadd_prefix_state flag)) return jet_sx_expr.sx
with
| Some x => x
| None => jet_sx_expr.XIc Integers.Int.zero
end
     : forall _ : bool, jet_sx_expr.sx

Arguments cadd_bit_expression flag%bool_scope
