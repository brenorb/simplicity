### C.jet_secp_strauss_final_literal.strauss_mul_writer
strauss_mul_writer
     : forall (z inv : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_square_columns.square_input_bounds inv),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_rescale_literal.rescale_field_output (jet_secp_point_mul_storage.point_mul_words z inv))
         (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (jet_secp_rescale_literal.rescale_field_output z) (jet_secp_rescale_literal.rescale_field_output inv)))
### C.jet_secp_strauss_final_literal.exec_strauss_final_any
exec_strauss_final_any
     : forall (x y z inv : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bp bb : Values.block) (flag : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._Z e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bp bb))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : jet_secp_square_columns.square_input_bounds inv)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag)))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun oz : forall _ : nat, Integers.Int64.int =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  jet_secp_generator_final.generator_final_statement Events.E0
                  (@Maps.PTree.set Values.val jets_secp._t'16 (Values.Vint flag) le) mf ClightBigstep.Out_normal)
               (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                  (and
                     (jet_secp_fe_nv.fe_at mf bp
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        (jet_secp_multiply_normalize_bridge.words5 y))
                     (and
                        (jet_secp_fe_nv.fe_at mf bp
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (jet_secp_multiply_normalize_bridge.words5 oz))
                        (and
                           (@eq (option Values.val)
                              (Memory.Mem.load AST.Mint32 mf bp
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                              (@Some Values.val (Values.Vint flag)))
                           (and (jet_secp_fe_nv.fe_at mf bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                              (and
                                 (Memory.Mem.range_perm mf bp BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bb BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and (jet_secp_square_columns.square_input_bounds oz)
                                       (and
                                          (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (...))))))))))
                                             (jet_secp_rescale_literal.rescale_field_output oz)
                                             match
                                               Integers.Int.eq flag Integers.Int.zero
                                               return (Ty.tySem (Word.Word (S (S (S (S (S (...))))))))
                                             with
                                             | true =>
                                                 @jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
                                                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S ...)))))))
                                                      (Ty.tySem (Word.Word (S (S (S (S (S ...)))))))
                                                      (jet_secp_rescale_literal.rescale_field_output z)
                                                      (jet_secp_rescale_literal.rescale_field_output inv))
                                             | false => jet_secp_rescale_literal.rescale_field_output z
                                             end)
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) =>
                                              and (not (@eq Values.block b bp)) (not (@eq Values.block b bb))) m mf))))))))))))
