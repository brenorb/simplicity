### C.jet_secp_affine_negate_words.affine_words_rho_shift
affine_words_rho_shift
     : forall (w : forall _ : nat, Integers.Int64.int) (i : nat) (_ : lt i (S (S (S (S (S O)))))),
       @eq Integers.Int64.int (affine_words_rho w (S i)) (w i)
### C.jet_secp_affine_negate_words.affine_y_words_initial
affine_y_words_initial
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       jet_sx_state.rep (affine_words_rho w)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@nil (prod Values.block BinNums.Z)))
         (jet_secp_affine_weak_exec.affine_initial_regs jet_secp_affine_weak_exec.AffineY) m
### C.jet_secp_affine_negate_words.affine_y_foot_range
affine_y_foot_range
     : forall (b bx : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z)))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   (jet_secp_affine_weak_exec.affine_initial_regs jet_secp_affine_weak_exec.AffineY)) bx pos),
       and (@eq Values.block bx b)
         (and
            (BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) pos)
            (BinInt.Z.lt pos
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_affine_negate_words.eval_affine_y_negate_words
eval_affine_y_negate_words
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val
                  (Values.Vptr b
                     (Integers.Ptrofs.repr
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@cons Values.val
                     (Values.Vptr b
                        (Integers.Ptrofs.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_field_negate_separate.negate_sep_words w)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (bx : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block bx b))
                        (or
                           (BinInt.Z.lt pos
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (BinInt.Z.le
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                     m mf))))
### C.jet_secp_affine_negate_words.affine_words_rho
affine_words_rho =
fun w : forall _ : nat, Integers.Int64.int =>
jet_secp_write_fe_wide_values.wide_fe_rho (w O) (w (S O)) (w (S (S O))) (w (S (S (S O)))) (w (S (S (S (S O)))))
  BinNums.Z0
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments affine_words_rho w%function_scope n%nat_scope
