### C.jet_secp_generator_split_call.generator_scalar_branch_source
generator_scalar_branch_source
     : @eq Clight.statement generator_scalar_branch
         (Clight.Sifthenelse
            (Clight.Etempvar jets_secp._ng (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
            (Clight.Ssequence generator_scalar_split_call generator_wnaf_setup) Clight.Sskip)
### C.jet_secp_generator_split_call.generator_scalar_split_call_source
generator_scalar_split_call_source
     : @eq Clight.statement generator_scalar_split_call
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_scalar_split_128
            jets_secp.f_secp256k1_scalar_split_128 (@None AST.ident)
            (@cons Clight.expr
               (Clight.Eaddrof (Clight.Evar jets_secp._ng_1 (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
               (@cons Clight.expr
                  (Clight.Eaddrof (Clight.Evar jets_secp._ng_128 (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
                     (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
                  (@cons Clight.expr
                     (Clight.Etempvar jets_secp._ng (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
                     (@nil Clight.expr)))))
### C.jet_secp_generator_split_call.scalar_split128_foot_blocks
scalar_split128_foot_blocks
     : forall (b0 b128 bs : Values.block) (base : BinNums.Z) (b : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b0 BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b128 BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs base)
                         (@nil (prod Values.block BinNums.Z)))))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   (jet_secp_scalar_split128.scalar_split128_regs false)) b pos),
       or (@eq Values.block b b0) (or (@eq Values.block b b128) (@eq Values.block b bs))
### C.jet_secp_generator_split_call.exec_generator_scalar_split
exec_generator_scalar_split
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (b0 b128 bs : Values.block) (base : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ng_1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b0 (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ng_128 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b128 (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_scalar_split_128 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ng le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr base)))) (_ : not (@eq Values.block b0 b128))
         (_ : not (@eq Values.block b0 bs)) (_ : not (@eq Values.block b128 bs))
         (_ : Memory.Mem.range_perm m b0 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b128 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bs base
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_scalar_split_call Events.E0 le
               mf ClightBigstep.Out_normal)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf b0 BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                           (jet_secp_scalar_split128_literal.literal_split128_low value)))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf b128 BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                              (jet_secp_scalar_split128_literal.literal_split128_high value)))))
                  (and
                     (Memory.Mem.range_perm mf b0 BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf b128 BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m))
                           (and
                              (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind)
                                 (p : Memtype.permission),
                               iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p))
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block b b0))
                                    (and (not (@eq Values.block b b128)) (not (@eq Values.block b bs)))) m mf))))))))
### C.jet_secp_generator_split_call.generator_scalar_branch
generator_scalar_branch =
@List.nth Clight.statement (S (S (S (S (S (S (S (S O))))))))
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_ecmult_strauss_wnaf)))
  Clight.Sskip
     : Clight.statement
### C.jet_secp_generator_split_call.generator_scalar_split_call
generator_scalar_split_call =
match generator_scalar_branch return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ s _ =>
    match s return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence call _ => call
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_generator_split_call.generator_wnaf_setup
generator_wnaf_setup =
match generator_scalar_branch return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ s _ =>
    match s return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ rest => rest
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
