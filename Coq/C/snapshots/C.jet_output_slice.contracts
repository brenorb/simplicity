### C.jet_output_slice.write_frame_at_slice_crossing_separate
write_frame_at_slice_crossing_separate
     : forall (n : BinNums.Z) (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (_ : BinInt.Z.lt (jet_write_layout.write_word_shift cursor) n)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor n),
       or (not (@eq Values.block bf bw))
         (or
            (BinInt.Z.le
               (BinInt.Z.add
                  (BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) base)
            (BinInt.Z.le
               (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
### C.jet_output_slice.slice_output_at
slice_output_at =
fun (n : BinNums.Z) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x : Integers.Int64.int) =>
match ZArith_dec.Z_le_dec n (jet_write_layout.write_word_shift cursor) return Prop with
| left _ =>
    @ex Integers.Int64.int
      (fun w : Integers.Int64.int =>
       and
         (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
            (@Some Values.val (Values.Vlong w)))
         (@eq Integers.Int64.int
            (Integers.Int64.zero_ext n
               (Integers.Int64.shru w (Integers.Int64.repr (BinInt.Z.sub (jet_write_layout.write_word_shift cursor) n))))
            x))
| right _ =>
    @ex Integers.Int64.int
      (fun high : Integers.Int64.int =>
       @ex Integers.Int64.int
         (fun low : Integers.Int64.int =>
          and
            (@eq (option Values.val)
               (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
               (@Some Values.val (Values.Vlong high)))
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 m bw
                     (BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (@Some Values.val (Values.Vlong low)))
               (@eq Integers.Int64.int
                  (jet_word_slice.crossing_slice n (jet_write_layout.write_word_shift cursor) high low) x))))
end
     : forall (_ : BinNums.Z) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Integers.Int64.int), Prop

Arguments slice_output_at n%Z_scope m bw (edge cursor)%Z_scope x
### C.jet_output_slice.slice_write_low
slice_write_low =
fun n edge cursor : BinNums.Z =>
match ZArith_dec.Z_le_dec n (jet_write_layout.write_word_shift cursor) return BinNums.Z with
| left _ => jet_write_layout.write_word_address edge cursor
| right _ =>
    BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments slice_write_low (n edge cursor)%Z_scope
