### C.jet_sha256_iv_init.sha256_iv_words
sha256_iv_words =
@List.map BinNums.Z Integers.Int.int jet_uint32_array_init.uint32_init_value sha256_iv_constants
     : list Integers.Int.int
### C.jet_sha256_iv_init.sha256_iv_spec
sha256_iv_spec =
fun term : Alg.Core.Algebra =>
@Alg.scribe Ty.Unit (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))))
  (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
     (BinNums.Zpos
        (BinNums.xI
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))))
  term
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments sha256_iv_spec {term}
### C.jet_sha256_iv_init.sha256_iv_init_env
sha256_iv_init_env =
fun (b : Values.block) (base : BinNums.Z) =>
@Maps.PTree.set Values.val jets._iv (Values.Vptr b (Integers.Ptrofs.repr base))
  (Clight.create_undef_temps (Clight.fn_temps jets.f_sha256_iv))
     : forall (_ : Values.block) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments sha256_iv_init_env b base%Z_scope
