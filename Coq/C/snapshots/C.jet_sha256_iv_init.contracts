           (@cons BinNums.Z
              (BinNums.Zpos
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xO
