                                                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
        (@cons BinNums.Z
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xI
