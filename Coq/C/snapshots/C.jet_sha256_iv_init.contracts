                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (...)))))))))))))))))))
              (@cons BinNums.Z
                 (BinNums.Zpos
