                                                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (...)))))))))))))))))))))))
  (@cons BinNums.Z
     (BinNums.Zpos
        (BinNums.xI
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
