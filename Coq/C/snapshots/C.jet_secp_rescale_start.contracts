### C.jet_secp_rescale_start.rescale_start_from_storage
rescale_start_from_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bp bs : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bp bs)),
       @ex Values.block
         (fun bz : Values.block =>
          @ex Clight.env
            (fun e : Clight.env =>
             @ex Clight.temp_env
               (fun le0 : Clight.temp_env =>
                @ex Clight.temp_env
                  (fun le1 : Clight.temp_env =>
                   @ex Memory.Mem.mem
                     (fun mi : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun mf : Memory.Mem.mem =>
                         and
                           (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_gej_rescale
                              (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val))) m e le0 mi)
                           (and
                              (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 mi
                                 jet_secp_rescale_prefix.rescale_prefix Events.E0 le1 mf ClightBigstep.Out_normal)
                              (and
                                 (jet_sx_eval.ematch
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z bs BinNums.Z0)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bz BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z)))))
                                    (@snd (list jet_sx_state.region) jet_sx_eval.venv
                                       jet_secp_rescale_prefix.rescale_allocated) e)
                                 (and
                                    (jet_sx_eval.tmatch rho
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z bp BinNums.Z0)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bs BinNums.Z0)
                                             (@cons (prod Values.block BinNums.Z)
                                                (@pair Values.block BinNums.Z bz BinNums.Z0)
                                                (@nil (prod Values.block BinNums.Z)))))
                                       (jet_sx_eval.stemps jet_secp_rescale_prefix.rescale_prefix_state) le1)
                                    (and
                                       (jet_secp_fe_nv.fe_at mf bz BinNums.Z0
                                          (jet_secp_multiply_normalize_bridge.words5
                                             (jet_secp_square_numeric.square_words rho)))
                                       (and
                                          (Memory.Mem.range_perm mf bz BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (jet_secp_fe_nv.fe_at mf bs BinNums.Z0
                                                (jet_secp_multiply_normalize_bridge.words5 rho))
                                             (and
                                                (Memory.Mem.range_perm mf bs BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (and
                                                   (Memory.Mem.range_perm mf bp BinNums.Z0
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...)))))
                                                      Memtype.Cur Memtype.Freeable)
                                                   (and
                                                      (@eq BinNums.Z
                                                         (BinInt.Z.modulo
                                                            (jet_secp_multiply_finish_product.radix_value
                                                               (jet_secp_square_numeric.square_words rho))
                                                            jet_secp_multiply_checkpoint_columns.field_prime)
                                                         (BinInt.Z.modulo
                                                            (BinInt.Z.mul
                                                               (jet_secp_multiply_finish_product.radix_value rho)
                                                               (jet_secp_multiply_finish_product.radix_value rho))
                                                            jet_secp_multiply_checkpoint_columns.field_prime))
                                                      (and
                                                         (jet_secp_square_columns.square_input_bounds
                                                            (jet_secp_square_numeric.square_words rho))
                                                         (and (not (Memory.Mem.valid_block m bz))
                                                            (and (jet_sx_mem.lframe (...) m mf)
                                                               (jet_sx_mem.lframe (...) m mf)))))))))))))))))))
