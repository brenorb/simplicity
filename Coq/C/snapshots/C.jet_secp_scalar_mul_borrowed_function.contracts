### C.jet_secp_scalar_mul_borrowed_function.borrowed_stack_foot_cases
borrowed_stack_foot_cases
     : forall (beta : jet_sx_state.layout) (bl b : Values.block) (ofs : BinNums.Z)
         (_ : jet_sx_state.foot (jet_secp_scalar_mul_caller_alloc.scalar_mul_stack_layout beta bl)
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_regs) b ofs),
       or (@eq Values.block b bl)
         (jet_sx_state.foot beta
            (@List.map jet_sx_state.region
               (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
               jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs) b ofs)
### C.jet_secp_scalar_mul_borrowed_function.borrowed_rhs_unstack
borrowed_rhs_unstack
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (bl : Values.block)
         (m : Memory.Mem.mem)
         (_ : jet_sx_state.region_ok rho (jet_secp_scalar_mul_caller_alloc.scalar_mul_stack_layout beta bl) m
                (S (S O)) scalar_mul_borrowed_rhs), jet_sx_state.region_ok rho beta m (S O) scalar_mul_borrowed_rhs
### C.jet_secp_scalar_mul_borrowed_function.eval_scalar_mul_borrowed_inplace
eval_scalar_mul_borrowed_inplace
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_sx_state.rep (jet_secp_product_reduce_bridge.product_reduce_rho rho)
                  (@cons (prod Values.block BinNums.Z) (jet_sx_state.lay beta O) (@nil (prod Values.block BinNums.Z)))
                  (jet_secp_scalar_mul_caller_function.scalar_mul_caller_output rho) mf)
               (and
                  (@eq BinNums.Z
                     (jet_secp_reduce512_final_atomic.final_output_value
                        (jet_secp_reduce512_body_numeric.reduce512_body_digits
                           (jet_secp_product_reduce_bridge.product_reduce_rho rho))
                        (jet_secp_reduce512_body_numeric.reduce512_body_carry
                           (jet_secp_product_reduce_bridge.product_reduce_rho rho))
                        (jet_secp_product_reduce_bridge.product_reduce_rho rho)
                        (jet_sx_state.lay
                           (@cons (prod Values.block BinNums.Z) (jet_sx_state.lay beta O)
                              (@nil (prod Values.block BinNums.Z)))))
                     (BinInt.Z.modulo
                        (BinInt.Z.mul (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)
                           (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho (S (S (S (S O))))))
                        jet_secp_canonical_scalar.canonical_group_order))
                  (and (jet_sx_state.region_ok rho beta mf (S O) scalar_mul_borrowed_rhs)
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot beta
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs) b
                              ofs)) m mf)))))
### C.jet_secp_scalar_mul_borrowed_function.scalar_mul_borrowed_rhs
scalar_mul_borrowed_rhs =
jet_sx_state.mkreg
  (jet_sx_rep.u64_cells BinNums.Z0
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O)))))
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S O))))))
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S O)))))))) (@nil jet_sx_expr.sx)))))) false
  (@None BinNums.Z)
     : jet_sx_state.region
