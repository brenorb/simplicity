### C.jet_secp_decompress_sign.decompress_root_candidate_range
decompress_root_candidate_range
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (BinInt.Z.le BinNums.Z0
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_root_chain_numeric.literal_root_candidate x)))
         (BinInt.Z.lt
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_root_chain_numeric.literal_root_candidate x)) jet_secp_fe_math.feP)
### C.jet_secp_decompress_sign.decompress_y_from_x_range
decompress_y_from_x_range
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                (@jet_secp_decompress_literal.literal_y_from_x Alg.CoreFunSem x)
                (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) y)),
       and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))
         (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y) jet_secp_fe_math.feP)
### C.jet_secp_decompress_sign.literal_fe_negate_involutive_normalized
literal_fe_negate_involutive_normalized
     : forall (y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                   jet_secp_fe_math.feP)),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem
            (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem y)) y
### C.jet_secp_decompress_sign.literal_decompress_opposite_parity
literal_decompress_opposite_parity
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
            (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@inr unit unit tt) x))
         match
           @jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
             (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@inl unit unit tt) x)
           return
             (Ty.tySem
                (Ty.Sum Ty.Unit
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | inl _ =>
             @inl unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
         | inr p =>
             @inr unit
               (Ty.tySem
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@jet_secp_gej_negate_literal.literal_ge_negate Alg.CoreFunSem p)
         end
