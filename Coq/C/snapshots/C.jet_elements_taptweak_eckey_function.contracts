### C.jet_elements_taptweak_eckey_function.eckey_tweak_infinite
eckey_tweak_infinite =
fun ng ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
Bit.toBool
  (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem
     (jet_secp_eckey_tweak_prepare.eckey_tweak_point ng ax ay))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), bool

Arguments eckey_tweak_infinite ng ax ay
### C.jet_elements_taptweak_eckey_function.eckey_tweak_value
eckey_tweak_value =
fun ng ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
match
  eckey_tweak_infinite ng ax ay
  return
    (option
       (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
with
| true =>
    @None
      (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
| false =>
    @Some
      (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (@jet_secp_gej_norm_literal.literal_gej_norm Alg.CoreFunSem
         (jet_secp_eckey_tweak_prepare.eckey_tweak_point ng ax ay))
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       option
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments eckey_tweak_value ng ax ay
### C.jet_elements_taptweak_eckey_function.eckey_tweak_key_result
eckey_tweak_key_result =
fun
  (value : option
             (Ty.tySem
                (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
  (m : Memory.Mem.mem) (bk : Values.block) =>
match value return Prop with
| Some point =>
    @ex (forall _ : nat, Integers.Int64.int)
      (fun x : forall _ : nat, Integers.Int64.int =>
       @ex (forall _ : nat, Integers.Int64.int)
         (fun y : forall _ : nat, Integers.Int64.int =>
          and (jet_secp_fe_nv.fe_at m bk BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
            (and
               (jet_secp_fe_nv.fe_at m bk
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (jet_secp_multiply_normalize_bridge.words5 y))
               (and (jet_secp_square_columns.square_input_bounds x)
                  (and (jet_secp_square_columns.square_input_bounds y)
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 m bk
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@Some Values.val (Values.Vint Integers.Int.zero)))
                        (@eq
                           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (jet_secp_rescale_literal.rescale_field_output x)
                              (jet_secp_rescale_literal.rescale_field_output y)) point)))))))
| None => True
end
     : forall
         (_ : option
                (Ty.tySem
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (_ : Memory.Mem.mem) (_ : Values.block), Prop

Arguments eckey_tweak_key_result value m bk
