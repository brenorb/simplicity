                 (and (not (@eq Values.block bx p12))
                    (and (not (@eq Values.block bx p22))
                       (and (not (@eq Values.block bx bh)) (not (@eq Values.block bx bi))))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
