### C.jet_elements_array_hash_literal.literal_elements_array_hash
literal_elements_array_hash =
fun (k w : nat)
  (p : jet_elements_prim.Elements.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
  (alg : EFP.Algebra) =>
let term : Alg.Assertion.Algebra := EFP.CanonicalStructures.toAssertion alg in
@jet_sha_hash_words_literal.literal_sha_hash_words k w term Ty.Unit
  (@AC.drop Ty.Unit (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))
     (Alg.Assertion.toCore term)
     (@EFP.Combinators.prim (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) alg p))
     : forall (k w : nat)
         (_ : jet_elements_prim.Elements.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (alg : EFP.Algebra), EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments literal_elements_array_hash (k w)%nat_scope p {alg}
