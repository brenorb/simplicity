### C.jet_division_wide_layout_machine.wide_division_decode
wide_division_decode
     : forall (remainder : bool) (s : jet_wide.wide_size) (x y : Ty.tySem (Word.Word (jet_wide.wide_log s)))
         (r t : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) y)),
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log s)))
         (jet_wide_spec.decode_wide s
            (Integers.Int64.zero_ext (jet_wide.wide_bits s) (jet_division_value.division_wide_raw remainder r t)))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (jet_wide.wide_log s))
            (jet_division_value.division_numeric remainder
               (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) x)
               (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) y)))
### C.jet_division_wide_layout_machine.eval_wide_division_layout_machine
eval_wide_division_layout_machine
     : forall (env : Values.val) (remainder : bool) (s : jet_wide.wide_size) (m : Memory.Mem.mem)
         (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (x y : Ty.tySem (Word.Word (jet_wide.wide_log s))) (cursor rc : BinNums.Z)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (jet_wide.wide_bits s)))))
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge rc x)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge
                (BinInt.Z.add rc (jet_wide.wide_bits s)) y)
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor (jet_wide.wide_bits s)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function (jet_division_wide_exec.wide_division remainder s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Word.ToZ.obj (Word.WordToZ (jet_wide.wide_log s)))
                     (@Word.ToZ.Theory.fromZ (Word.WordToZ (jet_wide.wide_log s))
                        (jet_division_value.division_numeric remainder
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) x)
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) y)))))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (jet_wide.wide_bits s)))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (jet_wide.wide_bits s))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
