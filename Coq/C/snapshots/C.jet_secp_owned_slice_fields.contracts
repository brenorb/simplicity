### C.jet_secp_owned_slice_fields.owned_region_append
owned_region_append
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat) (cs1 cs2 : list jet_sx_state.cell) (size : BinNums.Z)
         (_ : jet_sx_state.region_ok rho beta m r (jet_sx_state.mkreg cs1 true (@Some BinNums.Z size)))
         (_ : jet_sx_state.region_ok rho beta m r (jet_sx_state.mkreg cs2 true (@Some BinNums.Z size)))
         (_ : @eq bool (jet_sx_state.cells_sorted BinNums.Z0 (@app jet_sx_state.cell cs1 cs2)) true),
       jet_sx_state.region_ok rho beta m r
         (jet_sx_state.mkreg (@app jet_sx_state.cell cs1 cs2) true (@Some BinNums.Z size))
### C.jet_secp_owned_slice_fields.owned_region_field_slice
owned_region_field_slice
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat) (cs : list jet_sx_state.cell) (size ofs : BinNums.Z) (exprs : list jet_sx_expr.sx)
         (words : list Integers.Int64.int)
         (_ : jet_sx_state.region_ok rho beta m r (jet_sx_state.mkreg cs true (@Some BinNums.Z size)))
         (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : BinInt.Z.le size Integers.Ptrofs.max_unsigned)
         (_ : @eq nat (@length jet_sx_expr.sx exprs) (S (S (S (S (S O))))))
         (_ : @eq nat (@length Integers.Int64.int words) (S (S (S (S (S O))))))
         (_ : forall (c : jet_sx_state.cell) (_ : @List.In jet_sx_state.cell c (jet_sx_rep.u64_cells ofs exprs)),
              @List.In jet_sx_state.cell c cs)
         (_ : @eq (list Values.val)
                (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta)) exprs)
                (@List.map Integers.Int64.int Values.val Values.Vlong words)),
       jet_secp_fe_nv.fe_at m (jet_sx_state.blk beta r) ofs words
