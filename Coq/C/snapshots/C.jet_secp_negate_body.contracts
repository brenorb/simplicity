### C.jet_secp_negate_body.secp_fe_negate_body
secp_fe_negate_body
     : @eq Clight.statement (Clight.fn_body jets_secp.f_simplicity_fe_negate)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_secp._src jet_secp_public_body.secp_frame_type)
               (Clight.Etempvar jets_secp._src jet_secp_public_body.secp_frame_type)) secp_fe_negate_rest)
### C.jet_secp_negate_body.secp_negate_helper_symbols
secp_negate_helper_symbols
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
               jets_secp._secp256k1_fe_negate)
            (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_fe_negate)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
               (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_fe_negate) Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)))
### C.jet_secp_negate_body.exec_secp_public_negate
exec_secp_public_negate
     : forall (le : Clight.temp_env) (m mf : Memory.Mem.mem) (bl ba : Values.block)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_public_copy.secp_public_env bl ba) le m
         secp_public_negate_stmt Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_negate_body.secp_public_negate_stmt
secp_public_negate_stmt =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_secp._secp256k1_fe_negate
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr jet_secp_public_body.secp_field_type)
           (Ctypes.Tcons (Ctypesdefs.tptr jet_secp_public_body.secp_field_type)
              (Ctypes.Tcons Ctypesdefs.tint Ctypes.Tnil))) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_secp._a jet_secp_public_body.secp_field_type)
        (Ctypesdefs.tptr jet_secp_public_body.secp_field_type))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_secp._a jet_secp_public_body.secp_field_type)
           (Ctypesdefs.tptr jet_secp_public_body.secp_field_type))
        (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
           (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_negate_body.secp_fe_negate_rest
secp_fe_negate_rest =
Clight.Ssequence jet_secp_public_body.secp_public_read_stmt
  (Clight.Ssequence secp_public_negate_stmt
     (Clight.Ssequence jet_secp_public_body.secp_public_write_stmt
        (Clight.Sreturn
           (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)))))
     : Clight.statement
