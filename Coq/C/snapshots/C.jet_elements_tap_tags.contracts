### C.jet_elements_tap_tags.el_tapleaf_tag_hash_eval
el_tapleaf_tag_hash_eval
     : @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@SHA256.hashBlock Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))) jet_sha_tapdata_spec.iv_word
