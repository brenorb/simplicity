### C.jet_elements_tap_tags.el_tapleaf_prefix_eval
el_tapleaf_prefix_eval
     : @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@SHA256.hashBlock Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) jet_sha_tapdata_spec.iv_word
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) el_tapleaf_tag_word el_tapleaf_tag_word)))
         el_tapleaf_prefix
### C.jet_elements_tap_tags.el_tapleaf_tag_block_bytes
el_tapleaf_tag_block_bytes
     : @eq (list BinNums.Z)
         (@List.map Integers.Int.int BinNums.Z Integers.Int.unsigned
            (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
               (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O)))))) el_tapleaf_tag_block)))
         (@List.map Integers.Int.int BinNums.Z Integers.Int.unsigned
            (@app Integers.Int.int el_tapleaf_tag_bytes
               (jet_elements_support_sha_finalize_exec.sha_pad
                  (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
