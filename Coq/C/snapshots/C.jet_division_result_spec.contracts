### C.jet_division_result_spec.division_euclidean_observation
division_euclidean_observation
     : forall (N D Q R : BinNums.Z) (_ : @eq BinNums.Z (BinInt.Z.add (BinInt.Z.mul Q D) R) N)
         (_ : and (BinInt.Z.le BinNums.Z0 R) (BinInt.Z.lt R D)),
       and (@eq BinNums.Z Q (BinInt.Z.div N D)) (@eq BinNums.Z R (BinInt.Z.modulo N D))
### C.jet_division_result_spec.div2n1n_normalized_observation
div2n1n_normalized_observation
     : forall (n : nat) (a : Ty.tySem (Word.Word (S n))) (b : Ty.tySem (Word.Word n))
         (_ : BinInt.Z.le (jet_predicate_spec.word_modulus n)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) a)
                (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ n) b) (jet_predicate_spec.word_modulus n))),
       let qr : Ty.tySem (Word.Word (S n)) :=
         @jet_division_core_spec.div2n1n_word_spec n Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word (S n))) (Ty.tySem (Word.Word n)) a b) in
       and
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@fst
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr))
            (BinInt.Z.div (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) a) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@snd
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr))
            (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) a) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
### C.jet_division_result_spec.div2n1n_invalid_result
div2n1n_invalid_result
     : forall (n : nat) (a : Ty.tySem (Word.Word (S n))) (b : Ty.tySem (Word.Word n))
         (_ : @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                (@jet_division_core_spec.div2n1n_conditions n Alg.CoreFunSem
                   (@pair (Ty.tySem (Word.Word (S n))) (Ty.tySem (Word.Word n)) a b)) (@inl unit unit tt)),
       @eq (Ty.tySem (Word.Word (S n)))
         (@jet_division_core_spec.div2n1n_word_spec n Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S n))) (Ty.tySem (Word.Word n)) a b))
         (@jet_division_core_spec.division_high_word (S n) Alg.CoreFunSem tt)
### C.jet_division_result_spec.division_descaling_euclidean
division_descaling_euclidean
     : forall (a b k q r : BinNums.Z) (_ : BinInt.Z.lt BinNums.Z0 k) (_ : BinInt.Z.lt BinNums.Z0 b)
         (_ : @eq BinNums.Z (BinInt.Z.add (BinInt.Z.mul q (BinInt.Z.mul b k)) r) (BinInt.Z.mul a k))
         (_ : and (BinInt.Z.le BinNums.Z0 r) (BinInt.Z.lt r (BinInt.Z.mul b k))),
       and (@eq BinNums.Z q (BinInt.Z.div a b)) (@eq BinNums.Z (BinInt.Z.div r k) (BinInt.Z.modulo a b))
### C.jet_division_result_spec.div_mod_nonzero_unfold
div_mod_nonzero_unfold
     : forall (n : nat) (a b : Ty.tySem (Word.Word n))
         (_ : @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (@jet_test_value_spec.is_zero_word_spec n Alg.CoreFunSem b)
                (@inl unit unit tt)),
       @eq (Ty.tySem (Word.Word (S n)))
         (@jet_division_core_spec.div_mod_word_spec n Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b))
         (let p : Ty.tySem (jet_division_normalize_spec.division_pre_state (Nat.add O n)) :=
            @jet_division_normalize_spec.division_pre_shift_spec n O Alg.CoreFunSem
              (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                 (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) (@Word.zero n Alg.CoreFunSem tt) a) b) in
          let qr : Ty.tySem (Word.Word (S n)) := @jet_division_core_spec.div2n1n_word_spec n Alg.CoreFunSem p in
          @pair
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end)
               ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                   match n0 return Ty.Ty with
                   | O => X
                   | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                   end) (Ty.Sum Ty.Unit Ty.Unit) n))
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end) (Word.Word (Nat.add O n)))
            (@fst
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                      match n0 return Ty.Ty with
                      | O => X
                      | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                      end) (Ty.Sum Ty.Unit Ty.Unit) n))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                      match n0 return Ty.Ty with
                      | O => X
                      | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                      end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr)
            (@fst
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word (Nat.add O n)))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word (Nat.add O n)))
               (@jet_division_normalize_spec.division_post_shift_spec n O Alg.CoreFunSem
                  (@pair
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Ty.tySem (Word.Word n))
                     (@snd
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                               match n0 return Ty.Ty with
                               | O => X
                               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                               end) (Ty.Sum Ty.Unit Ty.Unit) n))
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                               match n0 return Ty.Ty with
                               | O => X
                               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                               end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr) b))))
