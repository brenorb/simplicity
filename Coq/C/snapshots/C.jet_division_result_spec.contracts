                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                               match n0 return Ty.Ty with
                               | O => X
                               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                               end) (Ty.Sum Ty.Unit Ty.Unit) n)))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n)) p))))
### C.jet_division_result_spec.division_is_zero_positive
division_is_zero_positive
     : forall (n : nat) (b : Ty.tySem (Word.Word n))
         (_ : BinInt.Z.lt BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)),
       @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (@jet_test_value_spec.is_zero_word_spec n Alg.CoreFunSem b)
         (@inl unit unit tt)
### C.jet_division_result_spec.div_mod_word_nonzero
div_mod_word_nonzero
     : forall (n : nat) (a b : Ty.tySem (Word.Word n))
         (_ : BinInt.Z.lt BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)),
       let qr : Ty.tySem (Word.Word (S n)) :=
         @jet_division_core_spec.div_mod_word_spec n Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b) in
       and
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@fst
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr))
            (BinInt.Z.div (@Word.ToZ.Theory.toZ (Word.WordToZ n) a) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@snd
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr))
            (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ n) a) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
### C.jet_division_result_spec.div_mod_word_numeric
div_mod_word_numeric
     : forall (n : nat) (a b : Ty.tySem (Word.Word n)),
       let qr : Ty.tySem (Word.Word (S n)) :=
         @jet_division_core_spec.div_mod_word_spec n Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b) in
       and
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@fst
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr))
            (jet_division_value.division_numeric false (@Word.ToZ.Theory.toZ (Word.WordToZ n) a)
               (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@snd
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr))
            (jet_division_value.division_numeric true (@Word.ToZ.Theory.toZ (Word.WordToZ n) a)
               (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
### C.jet_division_result_spec.division_word_spec_parametric
division_word_spec_parametric
     : forall (n : nat) (remainder : bool),
       @Alg.Core.Parametric (Word.Word (S n))
         ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
             match n0 return Ty.Ty with
             | O => X
             | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
             end) (Ty.Sum Ty.Unit Ty.Unit) n) (@division_word_spec n remainder)
### C.jet_division_result_spec.division_word_spec_numeric
division_word_spec_numeric
     : forall (n : nat) (remainder : bool) (a b : Ty.tySem (Word.Word n)),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ n)
            (@division_word_spec n remainder Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b)))
         (jet_division_value.division_numeric remainder (@Word.ToZ.Theory.toZ (Word.WordToZ n) a)
            (@Word.ToZ.Theory.toZ (Word.WordToZ n) b))
### C.jet_division_result_spec.division_word_representation
division_word_representation
     : forall (n : nat) (remainder : bool) (a b : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ n)
            (jet_division_value.division_numeric remainder (@Word.ToZ.Theory.toZ (Word.WordToZ n) a)
               (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
         (@division_word_spec n remainder Alg.CoreFunSem (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b))
### C.jet_division_result_spec.division_word_spec
division_word_spec =
fun (n : nat) (remainder : bool) (term : Alg.Core.Algebra) =>
match
  remainder
  return
    (Alg.Core.domain term (Word.Word (S n))
       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
           match n0 return Ty.Ty with
           | O => X
           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
           end) (Ty.Sum Ty.Unit Ty.Unit) n))
with
| true => @jet_division_core_spec.modulo_word_spec n term
| false => @jet_division_core_spec.divide_word_spec n term
end
     : forall (n : nat) (_ : bool) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Word.Word (S n))
         ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
             match n0 return Ty.Ty with
             | O => X
             | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
             end) (Ty.Sum Ty.Unit Ty.Unit) n)

Arguments division_word_spec n%nat_scope remainder%bool_scope {term}
