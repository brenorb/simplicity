### C.jet_secp_reduce512_final_exec.final_output_region
final_output_region
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int),
       @eq (option jet_sx_state.region)
         (@List.nth_error jet_sx_state.region
            (jet_sx_eval.sregs (jet_secp_reduce512_final_stage.reduce512_final_state digits carry)) O)
         (@Some jet_sx_state.region
            (jet_sx_state.mkreg
               (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_reduce512_final_stage.reduce512_final_limbs digits carry))
               true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_reduce512_final_exec.exec_typed_final_suffix
exec_typed_final_suffix
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta
                (jet_sx_eval.sregs (jet_secp_reduce512_final_stage.reduce512_final_initial digits carry)) m)
         (_ : jet_sx_eval.tmatch rho beta (jet_secp_reduce512_final_stage.reduce512_final_temps carry) le)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_reduce512_typed_stage.reduce512_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  jet_secp_reduce512_final_stage.reduce512_final_suffix Events.E0 le' mf ClightBigstep.Out_normal)
               (and
                  (jet_sx_state.rep rho beta
                     (jet_sx_eval.sregs (jet_secp_reduce512_final_stage.reduce512_final_state digits carry)) mf)
                  (and
                     (forall (i : nat) (sy : jet_sx_expr.sx)
                        (_ : @eq (option jet_sx_expr.sx)
                               (@List.nth_error jet_sx_expr.sx
                                  (jet_secp_reduce512_final_stage.reduce512_final_limbs digits carry) i)
                               (@Some jet_sx_expr.sx sy)),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk beta O)
                           (BinInt.Z.add (jet_sx_state.bas beta O)
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.of_nat i))))
                        (@Some Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta) sy)))
                     (and
                        (jet_sx_eval.tmatch rho beta
                           (jet_sx_eval.stemps (jet_secp_reduce512_final_stage.reduce512_final_state digits carry)) le')
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot beta
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape
                                    (jet_sx_eval.sregs
                                       (jet_secp_reduce512_final_stage.reduce512_final_initial digits carry))) b ofs))
                           m mf))))))
