### C.jet_secp_scalar_add_prepare.scalar_add_alloc_facts
scalar_add_alloc_facts
     : forall (m0 : Memory.Mem.mem) (ml ma mb : Memory.Mem.mem') (bl ba bb : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m0 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ml bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ml BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block ma ba))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb bb)),
       and (not (Memory.Mem.valid_block m0 bl))
         (and (not (Memory.Mem.valid_block m0 ba))
            (and (not (Memory.Mem.valid_block m0 bb))
               (and (not (@eq Values.block ba bl))
                  (and (not (@eq Values.block bb bl))
                     (and (not (@eq Values.block ba bb))
                        (and
                           (Memory.Mem.range_perm mb bl BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                              Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mb ba BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (Memory.Mem.range_perm mb bb BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable))))))))
### C.jet_secp_scalar_add_prepare.exec_scalar_add_copy
exec_scalar_add_copy
     : forall (m mc : Memory.Mem.mem) (bl ba bb bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
         (jet_secp_scalar_add_body.scalar_add_public_env bl ba bb) le m
         (Clight.Sassign (Clight.Evar jets_secp._src jet_secp_public_body.secp_frame_type)
            (Clight.Etempvar jets_secp._src jet_secp_public_body.secp_frame_type)) Events.E0 le mc
         ClightBigstep.Out_normal
### C.jet_secp_scalar_add_prepare.scalar_add_prepare_locals
scalar_add_prepare_locals
     : forall (le : Maps.PTree.tree Values.val) (m0 : Memory.Mem.mem) (ml ma mb : Memory.Mem.mem')
         (bl ba bb bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bw : Values.block) (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m0 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ml bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ml BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block ma ba))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb bb))
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m0 bs sbase bi edge rc)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)))),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
               (jet_secp_scalar_add_body.scalar_add_public_env bl ba bb) le mb
               (Clight.Sassign (Clight.Evar jets_secp._src jet_secp_public_body.secp_frame_type)
                  (Clight.Etempvar jets_secp._src jet_secp_public_body.secp_frame_type)) Events.E0 le mc
               ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mc ba BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mc bb BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mc bl BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                        Memtype.Freeable)
                     (and (jet_frame_layout.frame_fields_at mc bl BinNums.Z0 bi edge rc)
                        (and (not (@eq Values.block ba bb))
                           (and (not (@eq Values.block ba bl))
                              (and (not (@eq Values.block bb bl))
                                 (and
                                    (jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z ba BinNums.Z0)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bl BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z)))))
                                    (and
                                       (jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bb BinNums.Z0)
                                             (@cons (prod Values.block BinNums.Z)
                                                (@pair Values.block BinNums.Z bl BinNums.Z0)
                                                (@nil (prod Values.block BinNums.Z)))))
                                       (and
                                          (jet_secp_frame.invA m0 bd dbase bw outedge cursor N bi rc false
                                             (@nil BitMachine.Cell)
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                             (jet_secp_wrapper_run.read_fe_rho
                                                (@jet_input_layout.frame_input_word_bits
                                                   (S (S (S (S (S (S (S (S O)))))))) a) rc)
                                             (@nil jet_sx_eval.event) mc)
                                          (and
                                             (jet_sx_mem.lframe
                                                (fun (bx : Values.block) (_ : BinNums.Z) =>
                                                 and (not (@eq Values.block bx ba))
                                                   (and (not (@eq Values.block bx bb)) (not (@eq Values.block bx bl))))
                                                m0 mc)
                                             (and (not (Memory.Mem.valid_block m0 ba))
                                                (and (not (Memory.Mem.valid_block m0 bb))
                                                   (not (Memory.Mem.valid_block m0 bl))))))))))))))))
