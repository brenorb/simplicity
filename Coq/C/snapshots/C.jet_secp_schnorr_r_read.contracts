### C.jet_secp_schnorr_r_read.schnorr_r_read_source
schnorr_r_read_source
     : @eq Clight.statement
         (jet_secp_root_chain_owned.root_drop_statements (S (S (S O)))
            (Clight.fn_body jets_secp.f_secp256k1_schnorrsig_verify))
         (Clight.Ssequence schnorr_r_read_guard
            (jet_secp_root_chain_owned.root_drop_statements (S (S (S (S O))))
               (Clight.fn_body jets_secp.f_secp256k1_schnorrsig_verify)))
### C.jet_secp_schnorr_r_read.schnorr_r_raw_bounds
