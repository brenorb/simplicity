### C.jet_secp_schnorr_r_read.schnorr_word_bytes_from_be_loads
schnorr_word_bytes_from_be_loads
     : forall (r : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (b : Values.block)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m b (BinInt.Z.of_nat i))
                (@Some Values.val
                   (Values.Vint
                      (Integers.Int.repr
                         (@List.nth BinNums.Z i (jet_secp_xonly_parse_field.xonly_input_bytes r) BinNums.Z0))))),
       jet_secp_schnorr_challenge_absorb.schnorr_bytes_at m b Integers.Ptrofs.zero
         (jet_secp_schnorr_challenge_hash.schnorr_word_bytes r)
### C.jet_secp_schnorr_r_read.exec_schnorr_r_read
exec_schnorr_r_read
     : forall (r : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (sbytes : list Integers.Int.int)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le0 : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bx bsig : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._rx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._sig64 le0)
                (@Some Values.val (Values.Vptr bsig Integers.Ptrofs.zero))) (_ : not (@eq Values.block bx bsig))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bsig BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bsig BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes r)))
         (_ : le (@length Integers.Int.int sbytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : jet_read8s_layout.uint8_array_at m bsig
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) sbytes),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 m schnorr_r_read_guard Events.E0
               (schnorr_r_read_temps le0 r) mf (schnorr_r_read_outcome r))
            (and
               (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_fe_math.fe_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r))))
               (and
                  (jet_secp_schnorr_challenge_absorb.schnorr_bytes_at mf bsig Integers.Ptrofs.zero
                     (jet_secp_schnorr_challenge_hash.schnorr_word_bytes r))
                  (and
                     (jet_read8s_layout.uint8_array_at mf bsig
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        sbytes)
                     (and (jet_clight_internal_permissions.keeps_permissions m mf)
                        (and
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (pos : BinNums.Z) =>
                               not
                                 (jet_sx_state.foot
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bx BinNums.Z0)
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z bsig BinNums.Z0)
                                          (@nil (prod Values.block BinNums.Z))))
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape jet_secp_set_b32_owned.owned_b32_regs) b pos)) m mf)
                           (jet_clight_internal_preserve.readonly_preserved m mf)))))))
### C.jet_secp_schnorr_r_read.exec_schnorr_r_reject
exec_schnorr_r_reject
     : forall (pk msg r s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bx bsig : Values.block)
         (_ : BinInt.Z.le jet_secp_fe_math.feP
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._rx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._sig64 le)
                (@Some Values.val (Values.Vptr bsig Integers.Ptrofs.zero))) (_ : not (@eq Values.block bx bsig))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bsig BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bsig BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes r))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (jet_secp_root_chain_owned.root_drop_statements (S (S (S O)))
                     (Clight.fn_body jets_secp.f_secp256k1_schnorrsig_verify)) Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type (Values.Vint Integers.Int.zero) Ctypesdefs.tint))))
               (and
                  (@eq bool
                     (Bit.toBool
                        (@jet_secp_schnorr_verify_literal.literal_bip0340_check Alg.CoreFunSem
                           (@pair
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk msg)
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) r s)))) false)
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (pos : BinNums.Z) =>
                            not
                              (jet_sx_state.foot
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bx BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bsig BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))))
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape jet_secp_set_b32_owned.owned_b32_regs) b pos)) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
