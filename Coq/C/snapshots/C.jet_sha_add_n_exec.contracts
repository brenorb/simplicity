### C.jet_sha_add_n_exec.absorb_regs_length
absorb_regs_length
     : forall (bs l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (_ : lt (@length (Ty.tySem (Word.Word (S (S (S O))))) l)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O))))))))),
       @eq nat
         (@length Integers.Int.int
            (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
               (jet_sha_ctx8_model.absorb l regs bs))) (S (S (S (S (S (S (S (S O))))))))
### C.jet_sha_add_n_exec.sg_in_read8s
sg_in_read8s
     : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function jets._read8s jets.f_read8s)
         jet_sha_transport.sha_core_helpers
### C.jet_sha_add_n_exec.sg_in_write_context
sg_in_write_context
     : @List.In (prod AST.ident Clight.function)
         (@pair AST.ident Clight.function jets._simplicity_write_sha256_context jets.f_simplicity_write_sha256_context)
         jet_sha_transport.sha_core_helpers
### C.jet_sha_add_n_exec.vector_values_pos
vector_values_pos
     : forall (X : Ty.Ty) (k : nat) (v : Ty.tySem (Word.Vector X k)),
       not (@eq (list (Ty.tySem X)) (jet_buffer_input.vector_values X k v) (@nil (Ty.tySem X)))
### C.jet_sha_add_n_exec.pow2_le_512
pow2_le_512
     : forall (k : nat) (_ : le k (S (S (S (S (S (S (S (S (S O)))))))))),
       and (le (S O) (PeanoNat.Nat.pow (S (S O)) k))
         (le (PeanoNat.Nat.pow (S (S O)) k)
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
### C.jet_sha_add_n_exec.eval_sha_add_n
eval_sha_add_n
     : forall (_ : jet_memcpy_model.memcpy_model) (k : nat) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bsf : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor rc : BinNums.Z) (c : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (v : Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (_ : le k (S (S (S (S (S (S (S (S (S O))))))))))
         (_ : sha_globals_ok m) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : jet_frame_layout.frame_fields_at m bsf sbase bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bsf
                (BinInt.Z.add sbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add
                   (BinInt.Z.add rc
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)))) Integers.Int64.max_unsigned)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@app BitMachine.Cell (@Translate.encode jet_sha256_ctx8_init_spec.sha256_ctx8_type c)
                   (@Translate.encode (Word.Vector (Word.Word (S (S (S O)))) k) v)))
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
         (_ : not (@eq Values.block bsf bi)) (_ : not (@eq Values.block bsf bd)) (_ : not (@eq Values.block bsf bw))
         (_ : not (@eq Values.block bsf (jet_sha_linkage.sha_symbol_block jets_sha._sha256_max_counter)))
         (_ : not (@eq Values.block bsf (jet_sha_linkage.sha_symbol_block jets_sha._simplicity_sha256_compression))),
       let vs : list (Ty.tySem (Word.Word (S (S (S O))))) :=
         jet_buffer_input.vector_values (Word.Word (S (S (S O)))) k v in
       let spec : option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) := jet_sha_ctx8_spec.ctx8_add_list c vs
         in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_sha.f_sha_256_ctx_8_add_n)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bsf (Integers.Ptrofs.repr sbase))
                     (@cons Values.val
                        (Values.Vlong
                           (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) vs))))
                        (@nil Values.val)))) Events.E0 mf
               (@jet_partial.jet_partial_return (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) spec))
            (and
               match spec return Prop with
               | Some b =>
                   and
                     (jet_encoding.frame_output_cells_at mf bw outedge cursor
                        (@Translate.encode jet_sha256_ctx8_init_spec.sha256_ctx8_type b))
                     (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                        (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                           (BinInt.Z.sub cursor
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))))
               | None => True
               end
               (and
                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : Memory.Mem.valid_block m b)
                     (_ : or (not (@eq Values.block b bd))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add dbase
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                     (_ : or (not (@eq Values.block b bw))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add outedge
                                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                        (BinInt.Z.div
                                           (BinInt.Z.sub cursor
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (...)))))))))))
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs)))
                     (_ : or (not (@eq Values.block b bsf))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add sbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add sbase
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs))),
                   @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                  (forall (b : Values.block) (ofs : BinNums.Z) (kd : Memtype.perm_kind) (p : Memtype.permission)
                     (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs kd p), Memory.Mem.perm mf b ofs kd p))))
### C.jet_sha_add_n_exec.sha_globals_ok
sha_globals_ok =
fun m : Memory.Mem.mem =>
and (jet_sha_block_local.sha_dispatch_ok m)
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint64 m (jet_sha_linkage.sha_symbol_block jets_sha._sha256_max_counter) BinNums.Z0)
     (@Some Values.val (Values.Vlong jet_sha_uchars_exec.sha_max_counter)))
     : forall _ : Memory.Mem.mem, Prop

Arguments sha_globals_ok m
