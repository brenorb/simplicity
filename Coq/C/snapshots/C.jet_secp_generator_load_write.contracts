### C.jet_secp_generator_load_write.generator_loaded_bounds
generator_loaded_bounds
     : forall (bytes : list BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes), jet_secp_square_columns.square_input_bounds (generator_loaded_words bytes)
### C.jet_secp_generator_load_write.generator_loaded_output_value
generator_loaded_output_value
     : forall (bytes : list BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (jet_secp_rescale_literal.rescale_field_output (generator_loaded_words bytes)))
         (BinInt.Z.modulo (jet_secp_fe_math.be_val bytes) jet_secp_multiply_checkpoint_columns.field_prime)
### C.jet_secp_generator_load_write.eval_generator_load_write
eval_generator_load_write
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (xs ys : list BinNums.Z)
         (m : Memory.Mem.mem) (bp bg : Values.block) (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N) (_ : jet_frame_inv.finv m0 bd base bw edge cursor N bi m false (@nil BitMachine.Cell))
         (_ : @eq nat (@length BinNums.Z xs)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length BinNums.Z ys)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                xs)
         (_ : @List.Forall BinNums.Z
                (fun y : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 y)
                   (BinInt.Z.le y
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                ys) (_ : not (@eq Values.block bp bg))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bg BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bg BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bg (BinInt.Z.of_nat i))
                (@Some Values.val
                   (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i (@app BinNums.Z xs ys) BinNums.Z0))))),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_load)
                  (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bg Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mr
                     (@Ctypes.Internal Clight.function jets_secp.f_write_ge)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                        (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                     Values.Vundef)
                  (and
                     (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                        (@Translate.encode
                           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                              (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (generator_loaded_output xs ys)))
                     (and
                        (Memory.Mem.range_perm mf bp BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bg BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block b bp))
                                    (and (not (@eq Values.block b bg)) (not (jet_secp_frame.extA m0 bd bw bi b)))) m mf)
                              (jet_clight_internal_preserve.readonly_preserved m mf))))))))
### C.jet_secp_generator_load_write.generator_loaded_words
generator_loaded_words =
fun bytes : list BinNums.Z => jet_secp_b32_exec.limb_rho (jet_secp_fe_math.be_val bytes)
     : forall (_ : list BinNums.Z) (_ : nat), Integers.Int64.int

Arguments generator_loaded_words bytes%list_scope n%nat_scope
### C.jet_secp_generator_load_write.generator_loaded_output
generator_loaded_output =
fun xs ys : list BinNums.Z =>
@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (jet_secp_rescale_literal.rescale_field_output (generator_loaded_words xs))
  (jet_secp_rescale_literal.rescale_field_output (generator_loaded_words ys))
     : forall (_ : list BinNums.Z) (_ : list BinNums.Z),
       prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments generator_loaded_output (xs ys)%list_scope
