| true => @fst jet_sx_expr.sx jet_sx_expr.sx (de62_shift_sx (de62_acc_sx high (S (S (S (S O))))))
| false =>
    jet_sx_expr.XLb jet_sx_expr.Band (@fst jet_sx_expr.sx jet_sx_expr.sx (de62_acc_sx high (S i)))
      jet_secp_modinv_normalize62_exec.norm62_mask
end
     : forall (_ : bool) (_ : nat), jet_sx_expr.sx

