### C.jet_secp_schnorr_verify_literal.literal_bip0340_verify_parametric
literal_bip0340_verify_parametric
     : @Alg.Assertion.Parametric jet_secp_schnorr_challenge_literal.literal_bip0340_args Ty.Unit
         (@literal_bip0340_verify)
### C.jet_secp_schnorr_verify_literal.literal_bip0340_verify_option
literal_bip0340_verify_option
     : forall input : Ty.tySem jet_secp_schnorr_challenge_literal.literal_bip0340_args,
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem Ty.Unit))
         (@literal_bip0340_verify (Alg.AssertionSem Option.option_Monad_Zero) input)
         match
           Bit.toBool (@literal_bip0340_check Alg.CoreFunSem input)
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem Ty.Unit))
         with
         | true => @Some unit tt
         | false => @None (Ty.tySem Ty.Unit)
         end
### C.jet_secp_schnorr_verify_literal.literal_schnorr_pubkey_unpack_neg_value
literal_schnorr_pubkey_unpack_neg_value
     : forall pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Ty.Sum Ty.Unit jet_secp_point_verify_literal.literal_compressed_point))
         (@literal_schnorr_pubkey_unpack_neg Alg.CoreFunSem pk)
         match
           BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) pk)
             jet_secp_canonical_normalize.canonical_field_order
           return (Ty.tySem (Ty.Sum Ty.Unit jet_secp_point_verify_literal.literal_compressed_point))
         with
         | true =>
             @inr unit (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@inr unit unit tt) pk)
         | false =>
             @inl unit
               (prod (sum unit unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
         end
### C.jet_secp_schnorr_verify_literal.literal_schnorr_signature_unpack_value
literal_schnorr_signature_unpack_value
     : forall r s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Ty.Sum Ty.Unit literal_schnorr_signature))
         (@literal_schnorr_signature_unpack Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) r s))
         match
           andb
             (BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r)
                jet_secp_canonical_normalize.canonical_field_order)
             (BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) s)
                jet_secp_canonical_scalar.canonical_group_order)
           return (Ty.tySem (Ty.Sum Ty.Unit literal_schnorr_signature))
         with
         | true =>
             @inr unit
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) r s)
         | false =>
             @inl unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
         end
### C.jet_secp_schnorr_verify_literal.literal_bip0340_check_guarded_value
literal_bip0340_check_guarded_value
     : forall pk msg r s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (@literal_bip0340_check Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk msg)
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) r s)))
         match
           BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) pk)
             jet_secp_canonical_normalize.canonical_field_order return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         with
         | true =>
             match
               andb
                 (BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r)
                    jet_secp_canonical_normalize.canonical_field_order)
                 (BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) s)
                    jet_secp_canonical_scalar.canonical_group_order) return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
             with
             | true =>
                 @jet_secp_point_verify_literal.literal_point_check Alg.CoreFunSem
                   (@pair
                      (prod
                         (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
