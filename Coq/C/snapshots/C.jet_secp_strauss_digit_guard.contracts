strauss_digit_loaded_other
     : forall (high : bool) (le : Maps.PTree.tree Values.val) (bp : Values.block) (bits : BinNums.Z)
         (id : AST.ident)
         (_ : not
                (@eq AST.ident id
                   match high return AST.ident with
                   | true => jets_secp._t'22
                   | false => jets_secp._t'27
