            (Word.from_hash256
               (mk_hash256
                  (sha_stream l (jet_sha_ctx8_model.state_regs h)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count) bs))))
### C.jet_sha_hash_closed.sha_stream
sha_stream =
fun (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int) (c : BinNums.Z)
  (bs : list (Ty.tySem (Word.Word (S (S (S O)))))) =>
let l' : list (Ty.tySem (Word.Word (S (S (S O))))) :=
  @fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (jet_sha_ctx8_model.absorb l regs bs) in
let total : BinNums.Z :=
  BinInt.Z.add c
    (BinInt.Z.div
       (BinInt.Z.add (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) l))
          (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) bs)))
       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) in
@snd (list Integers.Int.int) (list Integers.Int.int)
  (jet_sha_uchars_prep.absorb_i
     (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value l')
     (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (jet_sha_ctx8_model.absorb l regs bs))
     (jet_sha_finalize_exec.sha_pad
        (Integers.Int64.repr
           (BinInt.Z.add
              (BinInt.Z.mul
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                 total) (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) l'))))))
     : forall (_ : list (Ty.tySem (Word.Word (S (S (S O)))))) (_ : list Integers.Int.int) (_ : BinNums.Z)
         (_ : list (Ty.tySem (Word.Word (S (S (S O)))))), list Integers.Int.int

Arguments sha_stream (l regs)%list_scope c%Z_scope bs%list_scope
