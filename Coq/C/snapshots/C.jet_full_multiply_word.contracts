### C.jet_full_multiply_word.full_multiply_int64_denotes
full_multiply_int64_denotes
     : forall (n : nat) (x y z w : Ty.tySem (Word.Word n)) (r t u v : Integers.Int64.int)
         (_ : BinInt.Z.le (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) (S n)))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned u) (@Word.ToZ.Theory.toZ (Word.WordToZ n) z))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned v) (@Word.ToZ.Theory.toZ (Word.WordToZ n) w)),
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S n))))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S n))
            (Integers.Int64.unsigned (Integers.Int64.add (Integers.Int64.add (Integers.Int64.mul r t) u) v)))
         (@Word.fullMultiplier n Alg.CoreFunSem
            (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
               (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) z w)))
### C.jet_full_multiply_word.frame_input_word_quad_encode
frame_input_word_quad_encode
     : forall (n : nat) (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z)
         (x y z w : Ty.tySem (Word.Word n)),
       iff
         (jet_encoding.frame_input_cells_at m bi edge rc
            (@Translate.encode (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
               (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                  (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) z w))))
         (and (@jet_input_layout.frame_input_word_at n m bi edge rc x)
            (and
               (@jet_input_layout.frame_input_word_at n m bi edge
                  (BinInt.Z.add rc (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) n))) y)
               (and
                  (@jet_input_layout.frame_input_word_at n m bi edge
                     (BinInt.Z.add rc
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) n)))) z)
                  (@jet_input_layout.frame_input_word_at n m bi edge
                     (BinInt.Z.add rc
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH))
                           (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) n)))) w))))
