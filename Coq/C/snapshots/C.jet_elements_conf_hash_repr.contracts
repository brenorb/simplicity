### C.jet_elements_conf_hash_repr.eval_sha256_asset_repr
eval_sha256_asset_repr
     : forall (_ : jet_memcpy_model.memcpy_model) (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (m : Memory.Mem.mem) (l regs : list Integers.Int.int) (c : Integers.Int64.int)
         (ovf : bool) (bc : Values.block) (oc : BinNums.Z) (a : jet_elements_prim.assetWith unit)
         (_ : jet_elements_support_sha_ctxi.ctxi m bx bm l regs c ovf)
         (_ : and (BinInt.Z.le BinNums.Z0 oc)
                (BinInt.Z.le
                   (BinInt.Z.add oc
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   Integers.Ptrofs.max_unsigned)) (_ : not (@eq Values.block bc bx)) (_ : not (@eq Values.block bc bm))
         (_ : jet_elements_asset_jets.asset_rep m bc oc a),
       let B : list Integers.Int.int :=
         @List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
           (jet_elements_asset_amount_hash_spec.elements_asset_bytes (jet_elements_asset_jets.encode_asset a)) in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_simplicity_sha256_confAsset)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr BinNums.Z0))
                  (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr oc)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_elements_support_sha_ctxi.ctxi mf bx bm
                  (@fst (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs B))
                  (@snd (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs B))
                  (Integers.Int64.add c (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int B))))
                  (jet_elements_confidential_exec.conf_overflow c ovf
                     (@jet_elements_asset_jets.conf_prefix Digest.hash256 a)))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
                   @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm mf b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
### C.jet_elements_conf_hash_repr.eval_sha256_amount_repr
eval_sha256_amount_repr
     : forall (_ : jet_memcpy_model.memcpy_model) (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (m : Memory.Mem.mem) (l regs : list Integers.Int.int) (c : Integers.Int64.int)
         (ovf : bool) (ba : Values.block) (oa : BinNums.Z) (a : jet_elements_prim.amountWith unit)
         (_ : jet_elements_support_sha_ctxi.ctxi m bx bm l regs c ovf)
         (_ : and (BinInt.Z.le BinNums.Z0 oa)
                (BinInt.Z.le
                   (BinInt.Z.add oa
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                   Integers.Ptrofs.max_unsigned)) (_ : not (@eq Values.block ba bx)) (_ : not (@eq Values.block ba bm))
         (_ : jet_elements_amount_jets.amount_rep m ba oa a),
       let B : list Integers.Int.int :=
         @List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
           (jet_elements_asset_amount_hash_spec.elements_amount_bytes (jet_elements_amount_jets.encode_amount a)) in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_simplicity_sha256_confAmt)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr BinNums.Z0))
                  (@cons Values.val (Values.Vptr ba (Integers.Ptrofs.repr oa)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_elements_support_sha_ctxi.ctxi mf bx bm
                  (@fst (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs B))
                  (@snd (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs B))
                  (Integers.Int64.add c (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int B))))
                  (jet_elements_conf_amount_exec.amt_overflow c ovf
                     (@jet_elements_asset_jets.conf_prefix Integers.Int64.int a)))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
                   @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm mf b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
