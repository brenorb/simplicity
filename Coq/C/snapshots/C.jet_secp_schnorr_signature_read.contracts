### C.jet_secp_schnorr_signature_read.schnorr_signature_read_source
schnorr_signature_read_source
     : @eq Clight.statement
         (jet_secp_root_chain_owned.root_drop_statements (S (S (S O)))
            (Clight.fn_body jets_secp.f_secp256k1_schnorrsig_verify))
         (jet_secp_statement_prefix.statement_sequence schnorr_signature_read_statements
            jet_secp_schnorr_keyload_return.schnorr_keyload_return)
### C.jet_secp_schnorr_signature_read.exec_schnorr_signature_read
exec_schnorr_signature_read
     : forall (r s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bx bs bf bsig : Values.block)
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r)
                jet_secp_fe_math.feP)
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) s)
                jet_secp_canonical_scalar.canonical_group_order)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._rx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._s e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._overflow e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bf Ctypesdefs.tint)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_scalar_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._sig64 le)
                (@Some Values.val (Values.Vptr bsig Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bx
                   (@cons Values.block bs (@cons Values.block bf (@cons Values.block bsig (@nil Values.block))))))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bsig BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bsig BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes r)))
         (_ : jet_read8s_layout.uint8_array_at m bsig
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes s))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence schnorr_signature_read_statements Clight.Sskip) Events.E0
               (jet_secp_schnorr_scalar_read.schnorr_scalar_read_temps
                  (jet_secp_schnorr_r_read.schnorr_r_read_temps le r) false) mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5
                     (jet_secp_b32_exec.limb_rho
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf bs BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                              (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem s)))))
                  (and
                     (jet_secp_schnorr_challenge_absorb.schnorr_bytes_at mf bsig Integers.Ptrofs.zero
                        (jet_secp_schnorr_challenge_hash.schnorr_word_bytes r))
                     (and
                        (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                         BinInt.Z.lt
                           (Integers.Int64.unsigned
                              (jet_secp_b32_exec.limb_rho
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r) i))
                           match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                           | true =>
                               BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))
                           | false =>
                               BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))
                           end)
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_b32_exec.limb_rho
                                       (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r)))
                                 jet_secp_fe_math.feP)
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r))
                           (and (jet_clight_internal_permissions.keeps_permissions m mf)
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bx))
                                       (and (not (@eq Values.block b bs))
                                          (and (not (@eq Values.block b bf)) (not (@eq Values.block b bsig))))) m mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
