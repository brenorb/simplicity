### C.jet_secp_modinv_de_correction.de62_correction_complete
de62_correction_complete
     : @eq bool de62_correction_ok true
### C.jet_secp_modinv_de_correction.de62_correction_run_eq
de62_correction_run_eq
     : @eq (option jet_sx_exec.res) de62_correction_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone de62_correction_state jet_sx_exec.ONormal))
### C.jet_secp_modinv_de_correction.de62_correction_source
de62_correction_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_modinv64_update_de_62)
         (jet_secp_statement_prefix.statement_sequence
            (@List.firstn Clight.statement
               (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
               (@fst (list Clight.statement) Clight.statement de62_source_parts)) de62_after_correction)
### C.jet_secp_modinv_de_correction.de62_correction_temps
de62_correction_temps
     : forall high : bool,
       @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx
            match high return BinNums.positive with
            | true => jets_secp._me
            | false => jets_secp._md
            end (jet_sx_eval.stemps de62_correction_state)) (@Some jet_sx_expr.sx (de62_correction_sx high))
### C.jet_secp_modinv_de_correction.de62_correction_den
de62_correction_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (high : bool),
       @eq Values.val (jet_sx_expr.den rho beta (de62_correction_sx high))
         (Values.Vlong (de62_correction_word rho high))
### C.jet_secp_modinv_de_correction.exec_de62_correction_prefix
exec_de62_correction_prefix
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem) (_ : jet_sx_state.rep rho beta (jet_sx_eval.sregs de62_initial) m)
         (_ : jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps de62_initial) le)
         (_ : jet_sx_eval.ematch beta (@snd (list jet_sx_state.region) jet_sx_eval.venv de62_alloc) e),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m de62_correction_prefix Events.E0 lef mf
                  ClightBigstep.Out_normal)
               (and
                  (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._md lef)
                     (@Some Values.val (Values.Vlong (de62_correction_word rho false))))
                  (and
                     (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._me lef)
                        (@Some Values.val (Values.Vlong (de62_correction_word rho true))))
                     (and (jet_sx_state.rep rho beta (jet_sx_eval.sregs de62_correction_state) mf)
                        (and (jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps de62_correction_state) lef)
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (jet_sx_state.foot beta
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape (jet_sx_eval.sregs de62_initial)) b ofs)) m mf)))))))
### C.jet_secp_modinv_de_correction.de62_alloc
de62_alloc =
@pair (list jet_sx_state.region) jet_sx_eval.venv
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (@cons jet_sx_state.cell (jet_sx_state.mkcell BinNums.Z0 AST.Mint64 (@None jet_sx_expr.sx))
           (@cons jet_sx_state.cell
              (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
                 (@None jet_sx_expr.sx)) (@nil jet_sx_state.cell))) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     (@cons jet_sx_state.region
        (jet_sx_state.mkreg
           (@cons jet_sx_state.cell (jet_sx_state.mkcell BinNums.Z0 AST.Mint64 (@None jet_sx_expr.sx))
              (@cons jet_sx_state.cell
                 (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
                    (@None jet_sx_expr.sx)) (@nil jet_sx_state.cell))) true
           (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
        (@nil jet_sx_state.region)))
  (@cons (prod AST.ident (prod nat Ctypes.type))
     (@pair AST.ident (prod nat Ctypes.type)
        (BinNums.xO
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
        (@pair nat Ctypes.type (S (S (S (S O))))
           (Ctypes.Tstruct
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (...)))))))))))))))))))
              (Ctypes.mk_attr false (@None BinNums.N)))))
     (@cons (prod AST.ident (prod nat Ctypes.type))
        (@pair AST.ident (prod nat Ctypes.type)
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
           (@pair nat Ctypes.type (S (S (S (S (S O)))))
              (Ctypes.Tstruct
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (...))))))))))))))))))
                 (Ctypes.mk_attr false (@None BinNums.N))))) (@nil (prod AST.ident (prod nat Ctypes.type)))))
     : prod (list jet_sx_state.region) jet_sx_eval.venv
### C.jet_secp_modinv_de_correction.de62_temps
de62_temps =
@Maps.PTree.set jet_sx_expr.sx jets_secp._modinfo (jet_sx_expr.XP (S (S (S O))) BinNums.Z0)
  (@Maps.PTree.set jet_sx_expr.sx jets_secp._t (jet_sx_expr.XP (S (S O)) BinNums.Z0)
     (@Maps.PTree.set jet_sx_expr.sx jets_secp._e (jet_sx_expr.XP (S O) BinNums.Z0)
        (@Maps.PTree.set jet_sx_expr.sx jets_secp._d (jet_sx_expr.XP O BinNums.Z0) (Maps.PTree.empty jet_sx_expr.sx))))
     : Maps.PTree.tree jet_sx_expr.sx
### C.jet_secp_modinv_de_correction.de62_initial
de62_initial =
jet_sx_eval.mkst de62_temps
  (@app jet_sx_state.region jet_secp_modinv_de_exec.de62_regs
     (@fst (list jet_sx_state.region) jet_sx_eval.venv de62_alloc)) (@nil jet_sx_eval.event)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))
     : jet_sx_eval.sstate
### C.jet_secp_modinv_de_correction.de62_source_parts
de62_source_parts =
jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_modinv64_update_de_62)
     : prod (list Clight.statement) Clight.statement
### C.jet_secp_modinv_de_correction.de62_correction_prefix
de62_correction_prefix =
jet_secp_statement_prefix.statement_sequence
  (@List.firstn Clight.statement
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))
     (@fst (list Clight.statement) Clight.statement de62_source_parts)) Clight.Sskip
     : Clight.statement
### C.jet_secp_modinv_de_correction.de62_after_correction
de62_after_correction =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))
     (@fst (list Clight.statement) Clight.statement de62_source_parts))
  (@snd (list Clight.statement) Clight.statement de62_source_parts)
     : Clight.statement
### C.jet_secp_modinv_de_correction.de62_correction_run
de62_correction_run =
jet_sx_known.known_stmt (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_modinv_fg_iteration_prefix.fg_fast_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  (@snd (list jet_sx_state.region) jet_sx_eval.venv de62_alloc) de62_initial de62_correction_prefix
     : option jet_sx_exec.res
### C.jet_secp_modinv_de_correction.de62_correction_state
de62_correction_state =
match de62_correction_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ => de62_initial
    end
| None => de62_initial
end
     : jet_sx_eval.sstate
### C.jet_secp_modinv_de_correction.de62_correction_ok
de62_correction_ok =
match de62_correction_run return bool with
| Some r =>
    match r return bool with
    | jet_sx_exec.RDone _ o =>
        match o return bool with
        | jet_sx_exec.ONormal => true
        | jet_sx_exec.OBreak => false
        | jet_sx_exec.OContinue => false
        | jet_sx_exec.OReturn _ => false
        end
    | jet_sx_exec.RIf _ _ _ => false
    end
| None => false
end
     : bool
### C.jet_secp_modinv_de_correction.de62_multiple_sx
de62_multiple_sx =
fun high : bool =>
jet_sx_expr.XLb jet_sx_expr.Badd
  (jet_sx_expr.XLb jet_sx_expr.Band
     (jet_sx_expr.XLv
        match high return nat with
        | true => S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))
        | false => S (S (S (S (S (S (S (S (S (S O)))))))))
        end)
     (jet_sx_expr.XLsh jet_sx_expr.Hshr (jet_sx_expr.XLv (S (S (S (S O)))))
        (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
  (jet_sx_expr.XLb jet_sx_expr.Band
     (jet_sx_expr.XLv
        match high return nat with
        | true => S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
        | false => S (S (S (S (S (S (S (S (S (S (S O))))))))))
        end)
     (jet_sx_expr.XLsh jet_sx_expr.Hshr (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S O))))))))))
        (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
     : forall _ : bool, jet_sx_expr.sx

Arguments de62_multiple_sx high%bool_scope
### C.jet_secp_modinv_de_correction.de62_correction_sx
de62_correction_sx =
fun high : bool =>
jet_sx_expr.XLb jet_sx_expr.Bsub (de62_multiple_sx high)
  (jet_sx_expr.XLb jet_sx_expr.Band
     (jet_sx_expr.XLb jet_sx_expr.Badd
        (jet_sx_expr.XLb jet_sx_expr.Bmul
           (jet_sx_expr.XLc
              (Integers.Int64.repr
                 (BinNums.Zpos
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xI
                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI ...)))))))))))))))))))
           (jet_secp_modinv_fg_prefix.fg_row_lo
              (jet_sx_expr.XLv
                 match high return nat with
                 | true => S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))
                 | false => S (S (S (S (S (S (S (S (S (S O)))))))))
                 end)
              (jet_sx_expr.XLv
                 match high return nat with
                 | true => S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
                 | false => S (S (S (S (S (S (S (S (S (S (S O))))))))))
                 end))) (de62_multiple_sx high)) jet_secp_modinv_normalize62_exec.norm62_mask)
     : forall _ : bool, jet_sx_expr.sx

Arguments de62_correction_sx high%bool_scope
### C.jet_secp_modinv_de_correction.de62_multiple_word
de62_multiple_word =
fun (rho : forall _ : nat, Integers.Int64.int) (high : bool) =>
Integers.Int64.add
  (Integers.Int64.and
     (rho
        match high return nat with
        | true => S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))
        | false => S (S (S (S (S (S (S (S (S (S O)))))))))
        end)
     (Integers.Int64.shr (rho (S (S (S (S O)))))
        (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
  (Integers.Int64.and
     (rho
        match high return nat with
        | true => S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
        | false => S (S (S (S (S (S (S (S (S (S (S O))))))))))
        end)
     (Integers.Int64.shr (rho (S (S (S (S (S (S (S (S (S O))))))))))
        (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool), Integers.Int64.int

Arguments de62_multiple_word rho%function_scope high%bool_scope
### C.jet_secp_modinv_de_correction.de62_correction_word
de62_correction_word =
fun (rho : forall _ : nat, Integers.Int64.int) (high : bool) =>
Integers.Int64.sub (de62_multiple_word rho high)
  (Integers.Int64.and
     (Integers.Int64.add
        (Integers.Int64.mul
           (Integers.Int64.repr
              (BinNums.Zpos
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO ...)))))))))))))))))))
           (jet_secp_modinv_fg_prefix_numeric.fg_row_low rho
              match high return nat with
              | true => S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))
              | false => S (S (S (S (S (S (S (S (S (S O)))))))))
              end
              match high return nat with
              | true => S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
              | false => S (S (S (S (S (S (S (S (S (S (S O))))))))))
              end)) (de62_multiple_word rho high))
     (Integers.Int64.repr
        (BinInt.Z.sub
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
           (BinNums.Zpos BinNums.xH))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool), Integers.Int64.int

Arguments de62_correction_word rho%function_scope high%bool_scope
