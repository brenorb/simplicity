### C.jet_secp_x_equiv_prefix.x_equiv_square_multiply_calls
x_equiv_square_multiply_calls
     : forall (q x z : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bp bq br : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds q) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : not (@eq Values.block bp bq)) (_ : not (@eq Values.block br bp)) (_ : not (@eq Values.block br bq))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : jet_secp_fe_nv.fe_at m bq BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 q))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bq BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun ms : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                  (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vptr bp
                           (Integers.Ptrofs.repr
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                        (@nil Values.val))) Events.E0 ms Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ms
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                     (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr bq Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                     Values.Vundef)
                  (and
                     (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_field_pair_multiply.field_pair_product (jet_secp_square_numeric.square_words z) q)))
                     (and (jet_secp_fe_nv.fe_at mf bq BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 q))
                        (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                           (and
                              (Memory.Mem.range_perm mf br BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bq BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bp BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (@eq BinNums.Z
                                          (BinInt.Z.modulo
                                             (jet_secp_multiply_finish_product.radix_value
                                                (jet_secp_field_pair_multiply.field_pair_product
                                                   (jet_secp_square_numeric.square_words z) q))
                                             jet_secp_multiply_checkpoint_columns.field_prime)
                                          (BinInt.Z.modulo
                                             (BinInt.Z.mul
                                                (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value z)
                                                   (jet_secp_multiply_finish_product.radix_value z))
                                                (jet_secp_multiply_finish_product.radix_value q))
                                             jet_secp_multiply_checkpoint_columns.field_prime))
                                       (and
                                          (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                                           and
                                             (BinInt.Z.le BinNums.Z0
                                                (Integers.Int64.unsigned
                                                   (jet_secp_field_pair_multiply.field_pair_product
                                                      (jet_secp_square_numeric.square_words z) q i)))
                                             (BinInt.Z.lt
                                                (Integers.Int64.unsigned
                                                   (jet_secp_field_pair_multiply.field_pair_product
                                                      (jet_secp_square_numeric.square_words z) q i))
                                                match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                                                | true =>
                                                    BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))
                                                | false =>
                                                    BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))
                                                end))
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) =>
                                              and (not (@eq Values.block b bp))
                                                (and (not (@eq Values.block b bq)) (not (@eq Values.block b br)))) m mf))))))))))))
