  (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements.___compound__3
     (@pair Values.block Ctypes.type bb
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements.___compound__2
        (@pair Values.block Ctypes.type bz (Ctypes.Tstruct jets_elements._confAmount Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements.___compound__1
           (@pair Values.block Ctypes.type bt (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr))
           (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements.___compound
              (@pair Values.block Ctypes.type ba (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr))
              (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._ctx
                 (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
                 (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._midstate
                    (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
                    (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._src
                       (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                       Clight.empty_env)))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

