### C.jet_elements_single_issuance_prep.eis_copy
eis_copy
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mc : Memory.Mem.mem) (bl bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._src e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))))
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m
         (Clight.Sassign (Clight.Evar jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) Events.E0 le
         mc ClightBigstep.Out_normal
