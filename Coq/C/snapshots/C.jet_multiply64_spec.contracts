### C.jet_multiply64_spec.multiply64_product_representation
multiply64_product_representation
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (a b : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned a)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned b)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) y)),
       @eq
         (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))))
         (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
               (Integers.Int64.unsigned (jet_umul128_layout.umul128_result_hi a b)))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
               (Integers.Int64.unsigned (jet_umul128_layout.umul128_result_lo a b))))
         (@jet_multiply_spec.multiply_word_spec (S (S (S (S (S (S O)))))) Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) x
               y))
