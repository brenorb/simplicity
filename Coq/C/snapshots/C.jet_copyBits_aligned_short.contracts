### C.jet_copyBits_aligned_short.copy_loop_value_bits
copy_loop_value_bits
     : forall (ss : BinNums.Z) (source : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq bool (Integers.Int64.testbit (jet_copyBits_loop_exec.copy_loop_value ss source) i)
         match
           Coqlib.zlt i
             (BinInt.Z.sub
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                ss) return bool
         with
         | left _ => false
         | right _ =>
             Integers.Int64.testbit source
               (BinInt.Z.sub i
                  (BinInt.Z.sub
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) ss))
         end
### C.jet_copyBits_aligned_short.copy_loop_copied_bit
copy_loop_copied_bit
     : forall (ss n : BinNums.Z) (source : Integers.Int64.int) (j : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : and (BinInt.Z.lt BinNums.Z0 n) (BinInt.Z.le n ss)) (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j n)),
       @eq bool
         (Integers.Int64.testbit (jet_copyBits_loop_exec.copy_loop_value ss source)
            (BinInt.Z.sub (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))) j))
         (Integers.Int64.testbit source (BinInt.Z.sub (BinInt.Z.sub ss (BinNums.Zpos BinNums.xH)) j))
### C.jet_copyBits_aligned_short.copy_aligned_write_position
copy_aligned_write_position
     : forall (cursor j : BinNums.Z)
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                BinNums.Z0)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       and
         (@eq BinNums.Z
            (BinInt.Z.div (BinInt.Z.sub (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) j)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (BinInt.Z.div (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (@eq BinNums.Z
            (BinInt.Z.modulo (BinInt.Z.sub (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) j)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (BinInt.Z.sub (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))) j))
### C.jet_copyBits_aligned_short.copy_aligned_write_shift
copy_aligned_write_shift
     : forall (cursor : BinNums.Z)
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                BinNums.Z0),
       @eq BinNums.Z (jet_write_layout.write_word_shift cursor)
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
### C.jet_copyBits_aligned_short.copy_aligned_short_output_bit
copy_aligned_short_output_bit
     : forall (m mf : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (source : Integers.Int64.int) (j : BinNums.Z) (bit : bool)
         (_ : BinInt.Z.lt BinNums.Z0
                (BinInt.Z.modulo rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                BinNums.Z0)
         (_ : and (BinInt.Z.lt BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinInt.Z.sub
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (BinInt.Z.modulo rc
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : BinInt.Z.le n cursor) (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j n))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                            (BinInt.Z.div rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mf bw (jet_write_layout.write_word_address outedge cursor))
                (@Some Values.val
                   (Values.Vlong
                      (jet_copyBits_loop_exec.copy_loop_value
                         (BinInt.Z.sub
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                            (BinInt.Z.modulo rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                         source)))) (_ : jet_input_layout.frame_input_bit_at m bi edge (BinInt.Z.add rc j) bit),
       jet_encoding.frame_output_bit_at mf bw outedge (BinInt.Z.sub (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) j)
         bit
### C.jet_copyBits_aligned_short.copy_aligned_short_output_cells
copy_aligned_short_output_cells
     : forall (m mf : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (source : Integers.Int64.int) (cells : list BitMachine.Cell)
         (_ : BinInt.Z.lt BinNums.Z0
                (BinInt.Z.modulo rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                BinNums.Z0)
         (_ : and (BinInt.Z.lt BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinInt.Z.sub
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (BinInt.Z.modulo rc
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : BinInt.Z.le n cursor) (_ : @eq BinNums.Z n (BinInt.Z.of_nat (@length BitMachine.Cell cells)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                            (BinInt.Z.div rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mf bw (jet_write_layout.write_word_address outedge cursor))
                (@Some Values.val
                   (Values.Vlong
                      (jet_copyBits_loop_exec.copy_loop_value
                         (BinInt.Z.sub
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                            (BinInt.Z.modulo rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                         source)))) (_ : jet_encoding.frame_input_cells_at m bi edge rc cells),
       jet_encoding.frame_output_cells_at mf bw outedge cursor cells
### C.jet_copyBits_aligned_short.copy_aligned_written_prefix
copy_aligned_written_prefix
     : forall (m mf : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (value : Integers.Int64.int)
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                BinNums.Z0)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mf bw (jet_write_layout.write_word_address edge cursor))
                (@Some Values.val (Values.Vlong value))), jet_output_layout.write_prefix_at m mf bw edge cursor
### C.jet_copyBits_aligned_short.eval_copyBits_aligned_short_layout
eval_copyBits_aligned_short_layout
     : forall (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (cells : list BitMachine.Cell) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : jet_output_layout.write_frame_at m bd base bw outedge cursor n)
         (_ : @eq BinNums.Z n (BinInt.Z.of_nat (@length BitMachine.Cell cells)))
         (_ : BinInt.Z.lt BinNums.Z0
                (BinInt.Z.modulo rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                BinNums.Z0)
         (_ : and (BinInt.Z.lt BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinInt.Z.sub
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (BinInt.Z.modulo rc
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : jet_encoding.frame_input_cells_at m bi edge rc cells),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function jets.f_simplicity_copyBits)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and (jet_encoding.frame_output_cells_at mf bw outedge cursor cells)
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and (jet_frame_layout.frame_fields_at mf bd base bw outedge (BinInt.Z.sub cursor n))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bd
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (jet_write_layout.write_word_address outedge cursor)
                           (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
