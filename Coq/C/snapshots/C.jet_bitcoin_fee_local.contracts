### C.jet_bitcoin_fee_local.exec_bitcoin_env_tx_set
exec_bitcoin_env_tx_set
     : forall (tmp : AST.ident) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (be : Values.block) (ebase : BinNums.Z) (bt : Values.block) (tbase : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase)))) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase)))),
       ClightBigstep.Clight2.exec_stmt jet_bitcoin_linkage.bitcoin_ge e le m (bitcoin_env_tx_set tmp) Events.E0
         (@Maps.PTree.set Values.val tmp (Values.Vptr bt (Integers.Ptrofs.repr tbase)) le) m ClightBigstep.Out_normal
### C.jet_bitcoin_fee_local.exec_bitcoin_tx_field_set
exec_bitcoin_tx_field_set
     : forall (ptr : BinNums.positive) (tmp field : AST.ident) (delta : BinNums.Z) (e : Clight.env)
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bt : Values.block) (tbase : BinNums.Z)
         (x : Integers.Int64.int)
         (_ : jet_bitcoin_field_eval.bitcoin_field_at jets_bitcoin._bitcoinTransaction field delta)
         (_ : and (BinInt.Z.le BinNums.Z0 delta)
                (BinInt.Z.le delta
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val ptr le)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase)))) (_ : BinInt.Z.le BinNums.Z0 tbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add tbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (BinInt.Z.add tbase delta))
                (@Some Values.val (Values.Vlong x))),
       ClightBigstep.Clight2.exec_stmt jet_bitcoin_linkage.bitcoin_ge e le m (bitcoin_tx_field_set ptr tmp field)
         Events.E0 (@Maps.PTree.set Values.val tmp (Values.Vlong x) le) m ClightBigstep.Out_normal
### C.jet_bitcoin_fee_local.exec_bitcoin_fee_mid
exec_bitcoin_fee_mid
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (mc me : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (be : Values.block)
         (ebase : BinNums.Z) (bt : Values.block) (tbase : BinNums.Z) (vi vo : Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_bitcoin._simplicity_write64 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase)))) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 tbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add tbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr mc be ebase)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mc bt
                   (BinInt.Z.add tbase
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                (@Some Values.val (Values.Vlong vi)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mc bt
                   (BinInt.Z.add tbase
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                (@Some Values.val (Values.Vlong vo)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_write64)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (Integers.Int64.sub vi vo)) (@nil Values.val))) Events.E0 me
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_bitcoin_linkage.bitcoin_ge e le mc bitcoin_fee_mid Events.E0
         (bitcoin_fee_temps le bt tbase vi vo) me ClightBigstep.Out_normal
### C.jet_bitcoin_fee_local.fw6_sub
fw6_sub
     : forall vi vo : Integers.Int64.int,
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (jet_bitcoin_totals_spec.fw6 (Integers.Int64.unsigned (Integers.Int64.sub vi vo)))
         (jet_bitcoin_totals_spec.fw6 (BinInt.Z.sub (Integers.Int64.unsigned vi) (Integers.Int64.unsigned vo)))
### C.jet_bitcoin_fee_local.bitcoin_fee_getter_body
bitcoin_fee_getter_body
     : jet_bitcoin_wrapper.bitcoin_wrapper_shape jets_bitcoin.f_simplicity_bitcoin_fee
         (jet_bitcoin_wrapper.bitcoin_simple_rest bitcoin_fee_mid)
### C.jet_bitcoin_fee_local.bitcoin_fee_local_spec
bitcoin_fee_local_spec
     : jet_application_sep.application_jet_local_spec_sep jets_bitcoin.f_simplicity_bitcoin_fee
         jet_bitcoin_linkage.bitcoin_ge Bitcoin.Bitcoin.env Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))
         bitcoin_fee_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : Bitcoin.Bitcoin.env) =>
          @jet_bitcoin_fee_spec.bitcoin_fee_spec
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a environment)
### C.jet_bitcoin_fee_local.bitcoin_tx_field_set
bitcoin_tx_field_set =
fun ptr tmp field : AST.ident =>
Clight.Sset tmp
  (Clight.Efield
     (Clight.Ederef
        (Clight.Etempvar ptr (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
        (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) field Ctypesdefs.tulong)
     : forall (_ : AST.ident) (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments bitcoin_tx_field_set ptr tmp field
### C.jet_bitcoin_fee_local.bitcoin_env_tx_set
bitcoin_env_tx_set =
fun tmp : AST.ident =>
Clight.Sset tmp
  (Clight.Efield
     (Clight.Ederef
        (Clight.Etempvar jets_bitcoin._env (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._txEnv Ctypes.noattr)))
        (Ctypes.Tstruct jets_bitcoin._txEnv Ctypes.noattr)) jets_bitcoin._tx
     (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
     : forall _ : AST.ident, Clight.statement

Arguments bitcoin_env_tx_set tmp
### C.jet_bitcoin_fee_local.bitcoin_fee_mid
bitcoin_fee_mid =
Clight.Ssequence (bitcoin_env_tx_set jets_bitcoin._t'1)
  (Clight.Ssequence (bitcoin_tx_field_set jets_bitcoin._t'1 jets_bitcoin._t'2 jets_bitcoin._totalInputValue)
     (Clight.Ssequence (bitcoin_env_tx_set jets_bitcoin._t'3)
        (Clight.Ssequence (bitcoin_tx_field_set jets_bitcoin._t'3 jets_bitcoin._t'4 jets_bitcoin._totalOutputValue)
           (Clight.Scall (@None AST.ident)
              (Clight.Evar jets_bitcoin._simplicity_write64
                 (Ctypes.Tfunction
                    (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
                       (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
              (@cons Clight.expr
                 (Clight.Etempvar jets_bitcoin._dst
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
                 (@cons Clight.expr
                    (Clight.Ebinop Cop.Osub (Clight.Etempvar jets_bitcoin._t'2 Ctypesdefs.tulong)
                       (Clight.Etempvar jets_bitcoin._t'4 Ctypesdefs.tulong) Ctypesdefs.tulong)
                    (@nil Clight.expr)))))))
     : Clight.statement
### C.jet_bitcoin_fee_local.bitcoin_fee_temps
bitcoin_fee_temps =
fun (le : Maps.PTree.tree Values.val) (bt : Values.block) (tbase : BinNums.Z) (vi vo : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_bitcoin._t'4 (Values.Vlong vo)
  (@Maps.PTree.set Values.val jets_bitcoin._t'3 (Values.Vptr bt (Integers.Ptrofs.repr tbase))
     (@Maps.PTree.set Values.val jets_bitcoin._t'2 (Values.Vlong vi)
        (@Maps.PTree.set Values.val jets_bitcoin._t'1 (Values.Vptr bt (Integers.Ptrofs.repr tbase)) le)))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int), Clight.temp_env

Arguments bitcoin_fee_temps le bt tbase%Z_scope vi vo
### C.jet_bitcoin_fee_local.bitcoin_fee_env_rep
bitcoin_fee_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun vi : Integers.Int64.int =>
               @ex Integers.Int64.int
                 (fun vo : Integers.Int64.int =>
                  and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                    (and (BinInt.Z.le BinNums.Z0 ebase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add ebase
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                             Integers.Ptrofs.max_unsigned)
                          (and (BinInt.Z.le BinNums.Z0 tbase)
                             (and
                                (BinInt.Z.le
                                   (BinInt.Z.add tbase
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI ...))))))))
                                   Integers.Ptrofs.max_unsigned)
                                (and
                                   (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                      (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                                   (and
                                      (@eq (option Values.val)
                                         (Memory.Mem.load AST.Mint64 m bt
                                            (BinInt.Z.add tbase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                         (@Some Values.val (Values.Vlong vi)))
                                      (and
                                         (@eq (option Values.val)
                                            (Memory.Mem.load AST.Mint64 m bt
                                               (BinInt.Z.add tbase (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))))
                                            (@Some Values.val (Values.Vlong vo)))
                                         (and
                                            (@eq BinNums.Z (Integers.Int64.unsigned vi)
                                               (Bitcoin.sigTxTotalInValue (Bitcoin.Bitcoin.envTx environment)))
                                            (and
                                               (@eq BinNums.Z (Integers.Int64.unsigned vo)
                                                  (Bitcoin.sigTxTotalOutValue (Bitcoin.Bitcoin.envTx environment)))
                                               (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                                     (@pair (prod Values.block BinNums.Z) BinNums.Z
                                                        (@pair Values.block BinNums.Z be ebase)
                                                        (BinInt.Z.add ebase ...))
                                                     (@cons (prod ... BinNums.Z) (@pair ... BinNums.Z ... ...)
                                                        (@nil ...)))))))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments bitcoin_fee_env_rep m env environment fp%list_scope
