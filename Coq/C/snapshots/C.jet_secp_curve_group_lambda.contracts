                          (GZnZ.mul jet_secp_fe_math.feP (GZnZ.zero jet_secp_fe_math.feP) x))
                       jet_secp_curve_group.secp_group_seven))
         (_ : not
                (@eq BinNums.Z
                   (GZnZ.val jet_secp_fe_math.feP
                      (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                         (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                         (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven point)) BinNums.Z0))
         (_ : @eq BinNums.Z
                (GZnZ.val jet_secp_fe_math.feP
                   (@SMain.x (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven point))
                (GZnZ.val jet_secp_fe_math.feP
                   (GZnZ.mul jet_secp_fe_math.feP x
                      (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                         (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                         (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven point))))
         (_ : @eq BinNums.Z
                (GZnZ.val jet_secp_fe_math.feP
                   (@SMain.y (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven point))
                (GZnZ.val jet_secp_fe_math.feP
                   (GZnZ.mul jet_secp_fe_math.feP y
                      (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                         (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                         (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven point)))),
       @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (@SMain.pe2e (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.sub jet_secp_fe_math.feP)
