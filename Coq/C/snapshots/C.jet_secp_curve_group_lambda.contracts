### C.jet_secp_curve_group_lambda.secp_group_projective_affine
secp_group_projective_affine
     : forall (point : jet_secp_curve_group_certificate.secp_group_projective)
         (x y : jet_secp_curve_group.secp_group_field)
         (Curve : @eq (GZnZ.znz jet_secp_fe_math.feP)
                    (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
