                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))
                                                      Memtype.Cur Memtype.Freeable)
                                                   (and
                                                      (Memory.Mem.range_perm mf ba BinNums.Z0
                                                         (BinNums.Zpos
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI ...))))))
                                                         Memtype.Cur Memtype.Freeable)
                                                      (and
                                                         (Memory.Mem.range_perm mf bu BinNums.Z0
                                                            (BinNums.Zpos
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))
                                                            Memtype.Cur Memtype.Freeable)
                                                         (and
                                                            (Memory.Mem.range_perm mf bv BinNums.Z0
                                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))
                                                               Memtype.Cur Memtype.Freeable)
                                                            (and
                                                               (Memory.Mem.range_perm mf bs BinNums.Z0
                                                                  (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))
                                                                  Memtype.Cur Memtype.Freeable)
                                                               (and
                                                                  (Memory.Mem.range_perm mf bt BinNums.Z0
                                                                     (BinNums.Zpos (BinNums.xO ...)) Memtype.Cur
                                                                     Memtype.Freeable)
                                                                  (and
                                                                     (Memory.Mem.range_perm mf bz BinNums.Z0
                                                                        (BinNums.Zpos ...) Memtype.Cur Memtype.Freeable)
                                                                     (and
                                                                        (jet_secp_square_columns.square_input_bounds
                                                                           ...) (and ... ...))))))))))))))))))))))
### C.jet_secp_mixed_preparation.mixed_preparation_statements
mixed_preparation_statements =
@cons Clight.statement (jet_secp_mixed_copy_weak.mixed_copy_coordinate false)
  (@cons Clight.statement (jet_secp_mixed_copy_weak.mixed_weak_coordinate false)
     (@cons Clight.statement (jet_secp_mixed_affine_product.mixed_affine_call false)
        (@cons Clight.statement (jet_secp_mixed_copy_weak.mixed_copy_coordinate true)
           (@cons Clight.statement (jet_secp_mixed_copy_weak.mixed_weak_coordinate true)
              (@cons Clight.statement (jet_secp_mixed_affine_product.mixed_affine_call true)
                 (@cons Clight.statement jet_secp_mixed_s2_calls.mixed_s2_z_call (@nil Clight.statement)))))))
     : list Clight.statement
### C.jet_secp_mixed_preparation.mixed_prepare_frame
mixed_prepare_frame =
fun (bp ba bu bv bs bt bz bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bu))
  (and (not (@eq Values.block bx bv))
     (and (not (@eq Values.block bx bs))
        (and (not (@eq Values.block bx bt))
           (and (not (@eq Values.block bx bz))
              (and
                 (or (not (@eq Values.block bx bp))
                    (or
                       (BinInt.Z.lt pos
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                       (BinInt.Z.le
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                          pos)))
                 (or (not (@eq Values.block bx ba))
                    (or (BinInt.Z.lt pos BinNums.Z0)
                       (BinInt.Z.le
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                          pos))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments mixed_prepare_frame bp ba bu bv bs bt bz bx pos%Z_scope
### C.jet_secp_mixed_preparation.mixed_finite_preparation_statements
mixed_finite_preparation_statements =
@app Clight.statement
  (@cons Clight.statement jet_secp_mixed_head.mixed_head
     (@cons Clight.statement jet_secp_mixed_finite_start.mixed_b_head
        (@cons Clight.statement jet_secp_mixed_finite_start.mixed_square_stmt (@nil Clight.statement))))
  mixed_preparation_statements
     : list Clight.statement
### C.jet_secp_mixed_preparation.mixed_preparation_temps
mixed_preparation_temps =
fun le : Maps.PTree.tree Values.val =>
@Maps.PTree.set Values.val jets_secp._t'3 (Values.Vint Integers.Int.zero)
  (@Maps.PTree.set Values.val jets_secp._t'4 (Values.Vint Integers.Int.zero) le)
     : forall _ : Maps.PTree.tree Values.val, Maps.PTree.tree Values.val

Arguments mixed_preparation_temps le
