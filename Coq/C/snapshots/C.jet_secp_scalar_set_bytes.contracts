### C.jet_secp_scalar_set_bytes.scalar_set_raw_integer
scalar_set_raw_integer =
fun rho : forall _ : nat, BinNums.Z =>
BinInt.Z.add
  (BinInt.Z.add
     (BinInt.Z.add (jet_sx_zval.zval rho (jet_secp_scalar_set_shape.scalar_set_raw_sigma O))
        (BinInt.Z.mul
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
           (jet_sx_zval.zval rho (jet_secp_scalar_set_shape.scalar_set_raw_sigma (S O)))))
     (BinInt.Z.mul
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        (jet_sx_zval.zval rho (jet_secp_scalar_set_shape.scalar_set_raw_sigma (S (S O))))))
  (BinInt.Z.mul
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))
     (jet_sx_zval.zval rho (jet_secp_scalar_set_shape.scalar_set_raw_sigma (S (S (S O))))))
     : forall _ : forall _ : nat, BinNums.Z, BinNums.Z

