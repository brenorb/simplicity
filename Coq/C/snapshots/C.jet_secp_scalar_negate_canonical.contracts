### C.jet_secp_scalar_negate_canonical.scalar_limb_rho_value
scalar_limb_rho_value
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq BinNums.Z
         (jet_secp_scalar_overflow_numeric.scalar_limb_value (jet_secp_scalar_get_b32_numeric.scalar_limb_rho value))
         value
### C.jet_secp_scalar_negate_canonical.scalar_negate_normalize_range
scalar_negate_normalize_range
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (BinInt.Z.le BinNums.Z0
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value)))
         (BinInt.Z.lt
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))
            jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_scalar_negate_canonical.scalar_negate_output_canonical
scalar_negate_output_canonical
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))),
       @eq BinNums.Z (jet_secp_scalar_negate_numeric.scalar_negate_output_value rho layout)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_canonical_scalar_negate.canonical_scalar_negate Alg.CoreFunSem value))
### C.jet_secp_scalar_negate_canonical.eval_scalar_negate_canonical_owned
eval_scalar_negate_canonical_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_sx_state.rep rho layout jet_secp_scalar_writer_run.scalar_writer_initial_regs m)
         (_ : @eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf (jet_sx_state.blk layout O) (jet_sx_state.bas layout O)
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@jet_secp_canonical_scalar_negate.canonical_scalar_negate Alg.CoreFunSem value)))))
               (and
                  (jet_sx_state.rep
                     (jet_secp_scalar_get_b32_numeric.scalar_limb_rho
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@jet_secp_canonical_scalar_negate.canonical_scalar_negate Alg.CoreFunSem value)))
                     (@cons (prod Values.block BinNums.Z)
                        (@pair Values.block BinNums.Z (jet_sx_state.blk layout O) (jet_sx_state.bas layout O))
                        (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_writer_run.scalar_writer_initial_regs mf)
                  (and
                     (Memory.Mem.range_perm mf (jet_sx_state.blk layout O) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot layout
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape jet_secp_scalar_writer_run.scalar_writer_initial_regs) b ofs)) m
                        mf)))))
