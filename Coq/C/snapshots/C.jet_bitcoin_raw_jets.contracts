### C.jet_bitcoin_raw_jets.raw_env_rep
raw_env_rep =
fun
  (rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_bitcoin_ext_prim.ext_environment)
           (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop) (m : Memory.Mem.mem)
  (env : Values.val) (logical : jet_bitcoin_raw_env.raw_bitcoin_environment)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex
  (le (@length Digest.hash256 (jet_bitcoin_raw_env.raw_tap_path logical))
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
  (fun
     Hpath : le (@length Digest.hash256 (jet_bitcoin_raw_env.raw_tap_path logical))
               (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))) =>
   rep m env (jet_bitcoin_raw_env.project_raw_environment logical Hpath) fp)
     : forall
         (_ : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_bitcoin_ext_prim.ext_environment)
                (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop) (_ : Memory.Mem.mem)
         (_ : Values.val) (_ : jet_bitcoin_raw_env.raw_bitcoin_environment)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments raw_env_rep rep%function_scope m env logical fp%list_scope
### C.jet_bitcoin_raw_jets.raw_current_hash_sem
raw_current_hash_sem =
fun
  (p : jet_bitcoin_ext_prim.BitcoinExt.t (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (a : Ty.tySem Ty.Unit)
  (logical : jet_bitcoin_raw_env.raw_bitcoin_environment) =>
match
  @jet_bitcoin_raw_env.raw_ext_sem Ty.Unit (Word.Word (S (S (S (S (S O))))))
    jet_bitcoin_ext_prim.BitcoinExt.CurrentIndex a logical
  return (option (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| Some ix =>
    match
      @jet_bitcoin_raw_env.raw_ext_sem (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) p ix logical
      return (option (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
    with
    | Some t =>
        match t return (option (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) with
        | inl _ => @None (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        | inr h =>
            @Some
              (prod
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) h
        end
    | None => @None (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
    end
| None => @None (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
end
     : forall
         (_ : jet_bitcoin_ext_prim.BitcoinExt.t (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (_ : Ty.tySem Ty.Unit)
         (_ : jet_bitcoin_raw_env.raw_bitcoin_environment),
       option (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments raw_current_hash_sem p a logical
### C.jet_bitcoin_raw_jets.raw_current_annex_sem
raw_current_annex_sem =
fun (a : Ty.tySem Ty.Unit) (logical : jet_bitcoin_raw_env.raw_bitcoin_environment) =>
match
  @jet_bitcoin_raw_env.raw_ext_sem Ty.Unit (Word.Word (S (S (S (S (S O))))))
    jet_bitcoin_ext_prim.BitcoinExt.CurrentIndex a logical
  return (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
with
| Some ix =>
    match
      @jet_bitcoin_raw_env.raw_ext_sem (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        jet_bitcoin_ext_prim.BitcoinExt.InputAnnexHash ix logical
      return (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
    with
    | Some t =>
        match t return (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) with
        | inl _ => @None (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        | inr annex =>
            @Some
              (sum unit
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) annex
        end
    | None => @None (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
    end
| None => @None (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
end
     : forall (_ : Ty.tySem Ty.Unit) (_ : jet_bitcoin_raw_env.raw_bitcoin_environment),
       option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

