### C.jet_extend_wide_exec.eval_extend_wide_msb
eval_extend_wide_msb
     : forall (s : jet_extend_wide_loop.extend_wide_size) (e : Clight.env) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (r : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._input le) (@Some Values.val (Values.Vlong r))),
       Clight.eval_expr jet_exec.ge0 e le m (extend_wide_msb_expr s)
         (Values.Vint (jet_readBit_layout.bit_int (extend_wide_msb s r)))
### C.jet_extend_wide_exec.write_wide_sequence_run_app
write_wide_sequence_run_app
     : forall (s : jet_wide.wide_size) (bf : Values.block) (base : BinNums.Z) (xs ys : list Integers.Int64.int)
         (m mf : Memory.Mem.mem),
       iff (jet_write_wide_sequence.write_wide_sequence_run s bf base (@app Integers.Int64.int xs ys) m mf)
         (@ex Memory.Mem.mem
            (fun mi : Memory.Mem.mem =>
             and (jet_write_wide_sequence.write_wide_sequence_run s bf base xs m mi)
               (jet_write_wide_sequence.write_wide_sequence_run s bf base ys mi mf)))
### C.jet_extend_wide_exec.extend_wide_fill_from_sequence
extend_wide_fill_from_sequence
     : forall (s : jet_extend_wide_loop.extend_wide_size) (bf : Values.block) (base : BinNums.Z)
         (bit : bool) (n : nat) (m mf : Memory.Mem.mem)
         (_ : jet_write_wide_sequence.write_wide_sequence_run (jet_extend_wide_loop.extend_wide_input s) bf base
                (@List.repeat Integers.Int64.int
                   (jet_pad_bit_spec.extend_bit_long (jet_extend_wide_loop.extend_wide_input s) bit) n) m mf),
       jet_extend_wide_loop.extend_wide_fill_run s bf base bit n m mf
### C.jet_extend_wide_exec.extend_wide_body_shape
extend_wide_body_shape
     : forall s : jet_extend_wide_loop.extend_wide_size,
       @eq Clight.statement (Clight.fn_body (jet_extend_wide_loop.extend_wide_function s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence
                  (jet_binary_wide_exec.wide_binary_read (jet_extend_wide_loop.extend_wide_input s) jets._t'1)
                  (Clight.Sset jets._input (Clight.Etempvar jets._t'1 Ctypesdefs.tulong)))
               (Clight.Ssequence (Clight.Sset jets._msb (extend_wide_msb_expr s))
                  (Clight.Ssequence
                     (Clight.Ssequence (Clight.Sset jets._i (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))
                        (jet_extend_wide_loop.extend_wide_loop s))
                     (Clight.Ssequence
                        (jet_arith8_layout_exec.frame_writer_call
                           (jet_wide.wide_writer_id (jet_extend_wide_loop.extend_wide_input s)) Ctypesdefs.tulong
                           Ctypesdefs.tvoid (Clight.Etempvar jets._input Ctypesdefs.tulong))
                        (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))))))))
### C.jet_extend_wide_exec.eval_extend_wide_composes
eval_extend_wide_composes
     : forall (env : Values.val) (s : jet_extend_wide_loop.extend_wide_size) (m : Memory.Mem.mem)
         (ma : Memory.Mem.mem') (mc mr me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval) (r : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader (jet_extend_wide_loop.extend_wide_input s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vlong r))
         (_ : jet_write_wide_sequence.write_wide_sequence_run (jet_extend_wide_loop.extend_wide_input s) bd dbase
                (extend_wide_output_args s r) mr me)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function (jet_extend_wide_loop.extend_wide_function s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_extend_wide_exec.extend_wide_msb
extend_wide_msb =
fun (s : jet_extend_wide_loop.extend_wide_size) (r : Integers.Int64.int) =>
negb
  (Integers.Int64.eq
     (Integers.Int64.shru r
        (Integers.Int64.repr
           (BinInt.Z.sub (jet_wide.wide_bits (jet_extend_wide_loop.extend_wide_input s)) (BinNums.Zpos BinNums.xH))))
     Integers.Int64.zero)
     : forall (_ : jet_extend_wide_loop.extend_wide_size) (_ : Integers.Int64.int), bool

Arguments extend_wide_msb s r
### C.jet_extend_wide_exec.extend_wide_msb_expr
extend_wide_msb_expr =
fun s : jet_extend_wide_loop.extend_wide_size =>
Clight.Ecast
  (Clight.Ebinop Cop.Oshr (Clight.Etempvar jets._input Ctypesdefs.tulong)
     (Clight.Ebinop Cop.Osub
        (Clight.Econst_int (Integers.Int.repr (jet_wide.wide_bits (jet_extend_wide_loop.extend_wide_input s)))
           Ctypesdefs.tint) (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint) Ctypesdefs.tulong)
  Ctypesdefs.tbool
     : forall _ : jet_extend_wide_loop.extend_wide_size, Clight.expr

Arguments extend_wide_msb_expr s
### C.jet_extend_wide_exec.extend_wide_prepared
extend_wide_prepared =
fun (s : jet_extend_wide_loop.extend_wide_size) (le : Maps.PTree.tree Values.val) (r : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._msb (Values.Vint (jet_readBit_layout.bit_int (extend_wide_msb s r)))
  (@Maps.PTree.set Values.val jets._input (Values.Vlong r) (@Maps.PTree.set Values.val jets._t'1 (Values.Vlong r) le))
     : forall (_ : jet_extend_wide_loop.extend_wide_size) (_ : Maps.PTree.tree Values.val) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments extend_wide_prepared s le r
### C.jet_extend_wide_exec.extend_wide_output_args
extend_wide_output_args =
fun (s : jet_extend_wide_loop.extend_wide_size) (r : Integers.Int64.int) =>
@app Integers.Int64.int
  (@List.repeat Integers.Int64.int
     (jet_pad_bit_spec.extend_bit_long (jet_extend_wide_loop.extend_wide_input s) (extend_wide_msb s r))
     (BinInt.Z.to_nat (jet_extend_wide_loop.extend_wide_count s)))
  (@cons Integers.Int64.int r (@nil Integers.Int64.int))
     : forall (_ : jet_extend_wide_loop.extend_wide_size) (_ : Integers.Int64.int), list Integers.Int64.int

Arguments extend_wide_output_args s r
