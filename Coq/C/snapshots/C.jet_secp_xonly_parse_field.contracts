### C.jet_secp_xonly_parse_field.xonly_input_length
xonly_input_length
     : forall pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq nat (@length BinNums.Z (xonly_input_bytes pk))
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
### C.jet_secp_xonly_parse_field.xonly_input_bounds
xonly_input_bounds
     : forall pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @List.Forall BinNums.Z
         (fun x : BinNums.Z =>
          and (BinInt.Z.le BinNums.Z0 x)
            (BinInt.Z.le x
               (BinNums.Zpos
                  (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
         (xonly_input_bytes pk)
### C.jet_secp_xonly_parse_field.xonly_input_value
xonly_input_value
     : forall pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z (jet_secp_fe_math.be_val (xonly_input_bytes pk))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) pk)
### C.jet_secp_xonly_parse_field.xonly_parse_field_return_source
xonly_parse_field_return_source
     : @eq Clight.statement
         (jet_secp_root_chain_owned.root_drop_statements (S (S (S O)))
            (Clight.fn_body jets_secp.f_secp256k1_xonly_pubkey_parse)) xonly_parse_field_return
### C.jet_secp_xonly_parse_field.eval_xonly_field_read
eval_xonly_field_read
     : forall (pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bx bin : Values.block) (_ : not (@eq Values.block bx bin))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bin BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr (xonly_input_bytes pk))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_set_b32)
               (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               (Values.Vint (xonly_strict_flag pk)))
            (and
               (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_swu_raw_input.swu_raw_words pk)))
               (and
                  (Memory.Mem.range_perm mf bx BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bin BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bx)) (not (@eq Values.block b bin))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
### C.jet_secp_xonly_parse_field.exec_xonly_parse_field
exec_xonly_parse_field
     : forall (_ : jet_memcpy_model.memcpy_model) (pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bp bx bout bin : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._pk e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp jet_secp_curve_statements.curve_ge_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_set_xo_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_is_in_correct_subgroup e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_xonly_pubkey_save e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pubkey le)
                (@Some Values.val (Values.Vptr bout Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._input32 le)
                (@Some Values.val (Values.Vptr bin Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bp
                   (@cons Values.block bx (@cons Values.block bout (@cons Values.block bin (@nil Values.block))))))
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (@cons (prod Values.block BinNums.Z)
                          (@pair Values.block BinNums.Z bp
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                          (@cons (prod Values.block BinNums.Z)
                             (@pair Values.block BinNums.Z bx
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                             (@cons (prod Values.block BinNums.Z)
                                (@pair Values.block BinNums.Z bout
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                (@cons (prod Values.block BinNums.Z)
                                   (@pair Values.block BinNums.Z bin
                                      (BinNums.Zpos
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                   (@nil (prod Values.block BinNums.Z))))))),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bin BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr (xonly_input_bytes pk))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m xonly_parse_field_return Events.E0 lef
                  mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type (Values.Vint (xonly_parse_result pk)) Ctypesdefs.tint))))
               (and (xonly_parsed_result pk mf bout)
                  (and
                     (forall (b : Values.block) (hi : BinNums.Z)
                        (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                               (@cons (prod Values.block BinNums.Z)
                                  (@pair Values.block BinNums.Z bp
                                     (BinNums.Zpos
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                  (@cons (prod Values.block BinNums.Z)
                                     (@pair Values.block BinNums.Z bx
                                        (BinNums.Zpos
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                     (@cons (prod Values.block BinNums.Z)
                                        (@pair Values.block BinNums.Z bout
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                        (@cons (prod Values.block BinNums.Z)
                                           (@pair Values.block BinNums.Z bin
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                           (@nil (prod Values.block BinNums.Z))))))),
                      Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bp))
                              (and (not (@eq Values.block b bx))
                                 (and (not (@eq Values.block b bout)) (not (@eq Values.block b bin))))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
