  (@Alg.Core.Combinators.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@jet_secp_beta_spec.literal_fe_multiply_beta term))
  (@Alg.Core.Combinators.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@jet_secp_canonical_normalize.canonical_fe_normalize term))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term jet_secp_scalar_table_literal.literal_table_ge
         jet_secp_scalar_table_literal.literal_table_ge

