                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec)))
         (xs ys aux : forall (_ : nat) (_ : nat), Integers.Int64.int)
         (_ : forall (k : nat) (_ : lt k (S (S (S (S (S (S (S (S O))))))))),
              @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (jet_secp_rescale_literal.rescale_field_output (aux k))
                (@jet_secp_beta_spec.literal_fe_multiply_beta Alg.CoreFunSem
                   (jet_secp_rescale_literal.rescale_field_output (xs k))))
         (_ : forall (k : nat) (_ : lt k (S (S (S (S (S (S (S (S O))))))))),
              jet_secp_field_mul_small.mul_small_input_bounds (ys k)),
