eval_table_get_lambda_lookup5
     : forall (nib : Ty.tySem (Word.Word (S (S O)))) (xs ys aux : forall (_ : nat) (_ : nat), Integers.Int64.int)
         (m : Memory.Mem.mem) (bd bt bx : Values.block) (_ : not (@eq Values.block bd bt))
         (_ : not (@eq Values.block bd bx)) (_ : jet_secp_globalz_loop.globalz_table_rep m bt xs ys)
         (_ : forall (k : nat) (_ : lt k (S (S (S (S (S (S (S (S O))))))))),
              jet_secp_fe_nv.fe_at m bx
                (BinInt.Z.mul
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   (BinInt.Z.of_nat k)) (jet_secp_multiply_normalize_bridge.words5 (aux k)))
         (_ : forall (k : nat) (_ : lt k (S (S (S (S (S (S (S (S O))))))))),
