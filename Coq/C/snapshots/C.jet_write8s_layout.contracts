         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_write8s)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
                     (@cons Values.val
                        (Values.Vlong
                           (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_encoding.frame_output_cells_at mf bw edge cursor
                  (@List.concat BitMachine.Cell
                     (@List.map (Ty.tySem (Word.Word (S (S (S O))))) (list BitMachine.Cell)
                        (@Translate.encode (Word.Word (S (S (S O))))) xs)))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bf base bw edge
                        (BinInt.Z.sub cursor
