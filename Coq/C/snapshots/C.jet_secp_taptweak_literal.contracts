### C.jet_secp_taptweak_literal.literal_taptweak_matches_output
literal_taptweak_matches_output
     : forall pk h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_taptweak (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk h))
         (jet_secp_taptweak_finish.taptweak_output (jet_secp_taptweak_hash.taptweak_hash_word pk h) pk)
