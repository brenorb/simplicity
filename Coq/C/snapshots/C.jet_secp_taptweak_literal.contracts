### C.jet_secp_taptweak_literal.taptweak_assert_parametric
@taptweak_assert_parametric
     : forall (A B : Ty.Ty) (f : forall term : Alg.Assertion.Algebra, Alg.Assertion.domain term A (Ty.Sum Ty.Unit B))
         (_ : @Alg.Assertion.Parametric A (Ty.Sum Ty.Unit B) f),
       @Alg.Assertion.Parametric A B (fun term : Alg.Assertion.Algebra => @taptweak_assert A B term (f term))
### C.jet_secp_taptweak_literal.literal_taptweak_hash_parametric
literal_taptweak_hash_parametric
     : @Alg.Assertion.Parametric (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@literal_taptweak_hash)
### C.jet_secp_taptweak_literal.literal_taptweak_generate_parametric
literal_taptweak_generate_parametric
     : @Alg.Assertion.Parametric (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
         jet_secp_scalar_table_literal.literal_table_gej (@literal_taptweak_generate)
### C.jet_secp_taptweak_literal.literal_taptweak_parse_parametric
literal_taptweak_parse_parametric
     : @Alg.Assertion.Parametric (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@literal_taptweak_parse)
### C.jet_secp_taptweak_literal.literal_taptweak_parametric
literal_taptweak_parametric
     : @Alg.Assertion.Parametric (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@literal_taptweak)
### C.jet_secp_taptweak_literal.taptweak_assert_option
@taptweak_assert_option
     : forall (A B : Ty.Ty) (f : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) A (Ty.Sum Ty.Unit B))
         (x : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B))
         (@taptweak_assert A B (Alg.AssertionSem Option.option_Monad_Zero) f x)
         match f x return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B)) with
         | Some t =>
             match
               t return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B))
             with
             | inl _ => @None (Ty.tySem B)
             | inr value =>
                 @Some
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) B) value
             end
         | None => @None (Ty.tySem B)
         end
### C.jet_secp_taptweak_literal.taptweak_option_comp
@taptweak_option_comp
     : forall (A B C : Ty.Ty) (f : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) A B)
         (g : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) B C) (x : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@TC.comp A B C (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) f g x)
         (@Option.option_bind (Ty.tySem B) (Ty.tySem C) g (f x))
### C.jet_secp_taptweak_literal.taptweak_option_pair
@taptweak_option_pair
     : forall (A B C : Ty.Ty) (f : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) A B)
         (g : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) A C) (x : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod B C)))
         (@TC.pair A B C (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) f g x)
         (@Option.option_bind (Ty.tySem B) (prod (Ty.tySem B) (Ty.tySem C))
            (fun a : Ty.tySem B =>
             @option_map (Ty.tySem C) (prod (Ty.tySem B) (Ty.tySem C))
               (fun b : Ty.tySem C => @pair (Ty.tySem B) (Ty.tySem C) a b) (g x)) (f x))
### C.jet_secp_taptweak_literal.taptweak_option_take
@taptweak_option_take
     : forall (A B C : Ty.Ty) (f : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) A C)
         (a : Ty.tySem A) (b : Ty.tySem B),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@TC.take A B C (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) f
            (@pair (Ty.tySem A) (Ty.tySem B) a b)) (f a)
### C.jet_secp_taptweak_literal.taptweak_option_drop
@taptweak_option_drop
     : forall (A B C : Ty.Ty) (f : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) B C)
         (a : Ty.tySem A) (b : Ty.tySem B),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@TC.drop A B C (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) f
            (@pair (Ty.tySem A) (Ty.tySem B) a b)) (f b)
### C.jet_secp_taptweak_literal.taptweak_option_iden
@taptweak_option_iden
     : forall (A : Ty.Ty) (a : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem A))
         (@TC.iden A (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) a)
         (@Some (Ty.tySem A) a)
### C.jet_secp_taptweak_literal.taptweak_option_unit
@taptweak_option_unit
     : forall (A : Ty.Ty) (a : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem Ty.Unit))
         (@TC.unit A (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) a)
         (@Some unit tt)
### C.jet_secp_taptweak_literal.taptweak_core_option
@taptweak_core_option
     : forall (A B : Ty.Ty) (f : forall term : Alg.Core.Algebra, Alg.Core.domain term A B)
         (_ : @Alg.Core.Parametric A B f) (x : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B))
         (f (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) x)
         (@Some (Ty.tySem B) (f Alg.CoreFunSem x))
### C.jet_secp_taptweak_literal.taptweak_scribe_option
@taptweak_scribe_option
     : forall (A B : Ty.Ty) (b : Ty.tySem B) (x : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B))
         (@Alg.scribe A B b (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) x)
         (@Some (Ty.tySem B) b)
