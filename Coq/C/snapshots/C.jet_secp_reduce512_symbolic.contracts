                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (...)))))))))))))))))))))))
  (jet_sx_expr.XI2L Ctypes.Signed (jet_sx_expr.XIc Integers.Int.one))
     : jet_sx_expr.sx
