and
  (@eq Values.val (jet_sx_expr.den rho beta (jet_secp_scalar_mul512_symbolic.sc_lo sy))
     (Values.Vlong (jet_secp_reduce512_wide.wlo ma)))
  (and
     (@eq Values.val (jet_sx_expr.den rho beta (jet_secp_scalar_mul512_symbolic.sc_hi sy))
        (Values.Vlong (jet_secp_reduce512_wide.whi ma)))
     (@eq Values.val (jet_sx_expr.den rho beta (jet_secp_scalar_mul512_symbolic.sc_top sy))
        (Values.Vlong (jet_secp_reduce512_wide.wtop ma))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z)
