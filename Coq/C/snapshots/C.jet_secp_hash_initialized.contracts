### C.jet_secp_hash_initialized.eval_hash_to_curve_initialized_characterization
eval_hash_to_curve_initialized_characterization
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_ctz_model.ctz_model)
         (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (ve : Values.val) (m : Memory.Mem.mem)
         (bd : Values.block) (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor rc : BinNums.Z) (_ : jet_secp_hash_startup.hash_to_curve_ready m)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) key))
         (_ : jet_output_layout.write_frame_at m bd base bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun sx : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun sy : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun sz : forall _ : nat, Integers.Int64.int =>
                   @ex Integers.Int.int
                     (fun flag : Integers.Int.int =>
                      @ex (forall _ : nat, Integers.Int64.int)
                        (fun ox : forall _ : nat, Integers.Int64.int =>
                         @ex (forall _ : nat, Integers.Int64.int)
                           (fun oy : forall _ : nat, Integers.Int64.int =>
                            and
                              (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                 (@Ctypes.Internal Clight.function jets_secp.f_simplicity_hash_to_curve)
                                 (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                                    (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                                       (@cons Values.val ve (@nil Values.val)))) Events.E0 mf
                                 (Values.Vint
                                    (jet_secp_field_cmov.cmov_int
                                       (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                                          (jet_secp_generator_hash_map.generator_hash_accepted true key)))))
                              (and
                                 (@eq
                                    (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                                       (Ty.tySem
                                          (Ty.Prod (Word.Word (S (S (S (S (S (S ...)))))))
                                             (Word.Word (S (S (S (S (S (S ...))))))))))
                                    (@jet_secp_hash_to_curve_spec.literal_hash_to_curve
                                       (Alg.AssertionSem Option.option_Monad_Zero) key)
                                    match
                                      andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                                        (jet_secp_generator_hash_map.generator_hash_accepted true key)
                                      return
                                        (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                                           (Ty.tySem
                                              (Ty.Prod (Word.Word (S (S (S (S ...))))) (Word.Word (S (S (S (S ...))))))))
                                    with
                                    | true =>
                                        match
                                          Integers.Int.eq flag Integers.Int.zero
                                          return
                                            (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                                               (Ty.tySem
                                                  (Ty.Prod (Word.Word (S (S (S ...)))) (Word.Word (S (S (S ...)))))))
                                        with
                                        | true =>
                                            @Some
                                              (prod (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                 (Ty.tySem (Word.Word (S (S (S (S (...))))))))
                                              (@pair (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                 (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                 (jet_secp_rescale_literal.rescale_field_output ox)
                                                 (jet_secp_rescale_literal.rescale_field_output oy))
                                        | false =>
                                            @None
                                              (Ty.tySem
                                                 (Ty.Prod (Word.Word (S (S (S (S (...))))))
                                                    (Word.Word (S (S (S (S (...))))))))
                                        end
                                    | false =>
                                        @None
                                          (Ty.tySem
                                             (Ty.Prod (Word.Word (S (S (S (S (S (...)))))))
                                                (Word.Word (S (S (S (S (S (...)))))))))
                                    end)
                                 (and (jet_secp_hash_public_call.hash_public_value key sx sy sz flag ox oy)
                                    (and
                                       (jet_frame_inv.finv m bd base bw outedge cursor
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))
                                          bi mf
                                          (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                                             (jet_secp_generator_hash_map.generator_hash_accepted true key))
                                          match
                                            andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                                              (jet_secp_generator_hash_map.generator_hash_accepted true key)
                                            return (list BitMachine.Cell)
                                          with
                                          | true =>
                                              @Translate.encode
                                                (Ty.Prod (Word.Word (S (S (S (S (...))))))
                                                   (Word.Word (S (S (S (S (...)))))))
                                                (@pair (Ty.tySem (Word.Word (S (S (S (...))))))
                                                   (Ty.tySem (Word.Word (S (S (S (...))))))
                                                   (jet_secp_rescale_literal.rescale_field_output ox)
                                                   (jet_secp_rescale_literal.rescale_field_output oy))
                                          | false => @nil BitMachine.Cell
                                          end)
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) =>
                                              not (jet_secp_frame.extA m bd bw bi b)) m mf)
                                          (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                             (jet_secp_hash_startup.hash_to_curve_ready mf)))))))))))))
