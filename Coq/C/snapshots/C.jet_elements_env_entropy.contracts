              (@pair Values.block Ctypes.type bR (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
              (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._buf
                 (@pair Values.block Ctypes.type bBuf
                    (Ctypesdefs.tarray Ctypesdefs.tuchar
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                 (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._block
                    (@pair Values.block Ctypes.type bB
                       (Ctypesdefs.tarray Ctypesdefs.tuint
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                    Clight.empty_env))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block), Clight.env

Arguments ent_env bB bBuf bR bC bC1 bR1 bR2
### C.jet_elements_env_entropy.entropy_h1
entropy_h1 =
fun (txid : list Integers.Int.int) (ix : Integers.Int64.int) =>
jet_elements_entropy_hash_model.hash_buffer_regs
  (@app Integers.Int.int (jet_elements_support_sha_be32_write.be_bytes txid)
     (jet_elements_env_le32_write.c_le32_bytes ix))
     : forall (_ : list Integers.Int.int) (_ : Integers.Int64.int), list Integers.Int.int

Arguments entropy_h1 txid%list_scope ix
### C.jet_elements_env_entropy.entropy_regs
entropy_regs =
fun (txid : list Integers.Int.int) (ix : Integers.Int64.int) (con : list Integers.Int.int) =>
SHA256.hash_block jet_sha256_iv_init.sha256_iv_words
  (@app Integers.Int.int
     (jet_elements_entropy_hash_model.hash_buffer_regs
        (jet_elements_support_sha_be32_write.be_bytes (entropy_h1 txid ix))) con)
     : forall (_ : list Integers.Int.int) (_ : Integers.Int64.int) (_ : list Integers.Int.int), list Integers.Int.int

Arguments entropy_regs txid%list_scope ix con%list_scope
