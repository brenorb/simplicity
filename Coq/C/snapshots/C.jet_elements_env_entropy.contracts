### C.jet_elements_env_entropy.ent_blocks
ent_blocks
     : forall bB bBuf bR bC bC1 bR1 bR2 : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_support_sha_linkage.sha_ge (ent_env bB bBuf bR bC bC1 bR1 bR2))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bC1 BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bC BinNums.Z0)
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bR2 BinNums.Z0)
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bR1 BinNums.Z0)
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                        (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bBuf BinNums.Z0)
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                           (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bB BinNums.Z0)
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                              (@pair (prod Values.block BinNums.Z) BinNums.Z
                                 (@pair Values.block BinNums.Z bR BinNums.Z0)
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))))
