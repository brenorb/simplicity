### C.jet_elements_env_entropy.ent_entry
ent_entry
     : forall (m : Memory.Mem.mem) (m1 m2 m3 m4 m5 m6 m7 : Memory.Mem.mem') (bB bBuf bR bC bC1 bR1 bR2 : Values.block)
         (vres vop vcon : Values.val)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m1 bB))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bBuf))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 bR))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m4 bC))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m4 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m5 bC1))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m5 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m6 bR1))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m6 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m7 bR2)),
       Clight.function_entry2 jet_elements_support_sha_linkage.sha_ge
         jets_elements.f_simplicity_generateIssuanceEntropy
         (@cons Values.val vres (@cons Values.val vop (@cons Values.val vcon (@nil Values.val)))) m
         (ent_env bB bBuf bR bC bC1 bR1 bR2)
         (@Maps.PTree.set Values.val jets_elements._contract vcon
            (@Maps.PTree.set Values.val jets_elements._op vop
               (@Maps.PTree.set Values.val jets_elements.__res vres
                  (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_simplicity_generateIssuanceEntropy)))))
         m7
### C.jet_elements_env_entropy.ent_init_exec
ent_init_exec
     : forall (e : Clight.env) (idctx idres : AST.ident) (bx br bo : Values.block) (obase : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) idctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) idres e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_init e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bo bx))
         (_ : not (@eq Values.block br bx)) (_ : not (@eq Values.block br bo))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bo))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bo))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) br))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   br))
         (_ : and (BinInt.Z.le BinNums.Z0 obase)
                (BinInt.Z.le
                   (BinInt.Z.add obase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   Integers.Ptrofs.max_unsigned))
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) obase) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (aout : Clight.expr)
         (_ : forall m' : Memory.Mem.mem,
              Clight.eval_expr jet_elements_support_sha_linkage.sha_ge e le m' aout
                (Values.Vptr bo (Integers.Ptrofs.repr obase)))
         (_ : forall m' : Memory.Mem.mem,
              @eq (option Values.val)
                (Cop.sem_cast (Values.Vptr bo (Integers.Ptrofs.repr obase)) (Clight.typeof aout)
                   (Ctypesdefs.tptr Ctypesdefs.tuint) m')
                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr obase))))
         (_ : Memory.Mem.valid_block m
                (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression))
         (_ : Memory.Mem.valid_block m
                (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bo obase
                (BinInt.Z.add obase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable) (_ : jet_elements_support_sha_block_local.sha_dispatch_ok m)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter) BinNums.Z0)
                (@Some Values.val (Values.Vlong jet_elements_support_sha_uchars_exec.sha_max_counter))),
       @ex Memory.Mem.mem
         (fun mx : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m
               (ent_init_stmt idres idctx aout) Events.E0 le mx ClightBigstep.Out_normal)
            (and
               (jet_elements_env_ctxo.ctxo mx bx bo obase (@nil Integers.Int.int) jet_sha256_iv_init.sha256_iv_words
                  Integers.Int64.zero false)
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : not (@eq Values.block b br)) (_ : not (@eq Values.block b bx))
                     (_ : or (not (@eq Values.block b bo))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) obase)
                               (BinInt.Z.le
                                  (BinInt.Z.add obase
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch mx b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm mx b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mx b)))))
### C.jet_elements_env_entropy.ent_ev_buf
ent_ev_buf
     : forall (e : Clight.env) (bBuf : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._buf e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bBuf
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (le : Clight.temp_env) (m : Memory.Mem.mem),
       Clight.eval_expr jet_elements_support_sha_linkage.sha_ge e le m
         (Clight.Evar jets_elements._buf
            (Ctypesdefs.tarray Ctypesdefs.tuchar
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (Values.Vptr bBuf Integers.Ptrofs.zero)
### C.jet_elements_env_entropy.ent_from_uchars_exec
ent_from_uchars_exec
     : forall (_ : jet_memcpy_model.memcpy_model) (e : Clight.env) (idctx : AST.ident) (bx br bBuf bo : Values.block)
         (obase : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) idctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._buf e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bBuf
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_fromMidstate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_uchars e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bo bx))
         (_ : not (@eq Values.block br bx)) (_ : not (@eq Values.block br bo)) (_ : not (@eq Values.block bBuf bx))
         (_ : not (@eq Values.block bBuf bo))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bo))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bo))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) br))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   br))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)
                   bBuf))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bBuf))
         (_ : and (BinInt.Z.le BinNums.Z0 obase)
                (BinInt.Z.le
                   (BinInt.Z.add obase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   Integers.Ptrofs.max_unsigned)) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (asrc : Clight.expr) (bsrc : Values.block) (osrc : Integers.Ptrofs.int) (regsS l regs : list Integers.Int.int)
         (c : Integers.Int64.int) (ovf : bool) (_ : jet_elements_env_ctxo.ctxo m bx bo obase l regs c ovf)
         (_ : forall m' : Memory.Mem.mem,
              Clight.eval_expr jet_elements_support_sha_linkage.sha_ge e le m' asrc (Values.Vptr bsrc osrc))
         (_ : forall m' : Memory.Mem.mem,
              @eq (option Values.val)
                (Cop.sem_cast (Values.Vptr bsrc osrc) (Clight.typeof asrc) (Ctypesdefs.tptr Ctypesdefs.tuint) m')
                (@Some Values.val (Values.Vptr bsrc osrc))) (_ : not (@eq Values.block bBuf bsrc))
         (_ : @eq nat (@length Integers.Int.int regsS) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned osrc)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bsrc
                   (BinInt.Z.add (Integers.Ptrofs.unsigned osrc)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j regsS Integers.Int.zero))))
         (_ : Memory.Mem.range_perm m bBuf BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m2 : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m
                  (ent_from_stmt asrc) Events.E0 le m1 ClightBigstep.Out_normal)
               (and
                  (ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m1
                     (ent_uchars_stmt idctx) Events.E0 le m2 ClightBigstep.Out_normal)
                  (and
                     (jet_elements_env_ctxo.ctxo m2 bx bo obase
                        (@fst (list Integers.Int.int) (list Integers.Int.int)
                           (jet_elements_support_sha_uchars_prep.absorb_i l regs
                              (jet_elements_support_sha_be32_write.be_bytes regsS)))
                        (@snd (list Integers.Int.int) (list Integers.Int.int)
                           (jet_elements_support_sha_uchars_prep.absorb_i l regs
                              (jet_elements_support_sha_be32_write.be_bytes regsS)))
                        (Integers.Int64.add c
                           (Integers.Int64.repr
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                        (jet_elements_support_sha_uchars_exec.uc_overflow ovf c
                           (Integers.Int64.repr
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                     (and
                        (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                           (_ : Memory.Mem.valid_block m b) (_ : not (@eq Values.block b bx))
                           (_ : not (@eq Values.block b bBuf))
                           (_ : or (not (@eq Values.block b bo))
                                  (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) obase)
                                     (BinInt.Z.le
                                        (BinInt.Z.add obase
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) ofs))),
                         @eq (option Values.val) (Memory.Mem.load ch m2 b ofs) (Memory.Mem.load ch m b ofs))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.valid_block m b)
                              (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m2 b ofs k p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m2 b)))))))
### C.jet_elements_env_entropy.ent_u32le_exec
ent_u32le_exec
     : forall (_ : jet_memcpy_model.memcpy_model) (e : Clight.env) (idctx : AST.ident) (bx bo : Values.block)
         (obase : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) idctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_u32le e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bo bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bo))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
