                  (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S O))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@Word.ToZ.Theory.fromZ (Word.WordToZ (S O)) (BinInt.Z.of_nat n)) (Word.from_hash256 h))
