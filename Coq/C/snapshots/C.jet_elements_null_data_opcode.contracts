### C.jet_elements_null_data_opcode.elements_opcode_code_value
elements_opcode_code_value =
fun (push : bool) (n : nat) (bit small : bool) =>
match push return Integers.Int.int with
| true => Integers.Int.repr (BinInt.Z.of_nat n)
| false => jet_elements_null_data_nonpush.elements_nonpush_code n bit small
end
     : forall (_ : bool) (_ : nat) (_ : bool) (_ : bool), Integers.Int.int

Arguments elements_opcode_code_value push%bool_scope n%nat_scope (bit small)%bool_scope
### C.jet_elements_null_data_opcode.elements_opcode_value
elements_opcode_value =
fun (push : bool) (n : nat) (bit small : bool) (h : Digest.hash256) =>
match
  push
  return
    (Ty.tySem
       (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
          (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))
with
| true =>
    @inl (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S O)))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Sum Ty.Unit Ty.Unit))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S O)))))
      (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S O)))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S O)) (BinInt.Z.of_nat n)) (Word.from_hash256 h))
| false =>
    @inr
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S O)))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))
      (jet_elements_null_data_nonpush.elements_nonpush_value n bit small)
end
