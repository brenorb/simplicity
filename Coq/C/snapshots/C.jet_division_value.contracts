### C.jet_division_value.division_numeric_range
division_numeric_range
     : forall (remainder : bool) (a b bound : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.lt a bound))
         (_ : and (BinInt.Z.le BinNums.Z0 b) (BinInt.Z.lt b bound)),
       and (BinInt.Z.le BinNums.Z0 (division_numeric remainder a b))
         (BinInt.Z.lt (division_numeric remainder a b) bound)
### C.jet_division_value.division8_zero_test
division8_zero_test
     : forall t : Integers.Int.int,
       @eq bool
         (Integers.Int.eq Integers.Int.zero
            (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t))
         (BinInt.Z.eqb
            (Integers.Int.unsigned
               (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)) BinNums.Z0)
### C.jet_division_value.division8_signed
division8_signed
     : forall r : Integers.Int.int,
       @eq BinNums.Z
         (Integers.Int.signed
            (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r))
         (Integers.Int.unsigned
            (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r))
### C.jet_division_value.division8_raw_unsigned
division8_raw_unsigned
     : forall (remainder : bool) (r t : Integers.Int.int),
       @eq BinNums.Z (Integers.Int.unsigned (division8_raw remainder r t))
         (division_numeric remainder
            (Integers.Int.unsigned
               (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r))
            (Integers.Int.unsigned
               (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)))
### C.jet_division_value.division8_payload_unsigned
division8_payload_unsigned
     : forall (remainder : bool) (r t : Integers.Int.int),
       @eq BinNums.Z (Integers.Int.unsigned (division8_payload remainder r t))
         (division_numeric remainder
            (Integers.Int.unsigned
               (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r))
            (Integers.Int.unsigned
               (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)))
### C.jet_division_value.division_wide_raw_unsigned
division_wide_raw_unsigned
     : forall (remainder : bool) (r t : Integers.Int64.int),
       @eq BinNums.Z (Integers.Int64.unsigned (division_wide_raw remainder r t))
         (division_numeric remainder (Integers.Int64.unsigned r) (Integers.Int64.unsigned t))
### C.jet_division_value.division_numeric
division_numeric =
fun (remainder : bool) (a b : BinNums.Z) =>
match BinInt.Z.eqb b BinNums.Z0 return BinNums.Z with
| true => match remainder return BinNums.Z with
          | true => a
          | false => BinNums.Z0
          end
| false => match remainder return BinNums.Z with
           | true => BinInt.Z.modulo a b
           | false => BinInt.Z.div a b
           end
end
     : forall (_ : bool) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments division_numeric remainder%bool_scope (a b)%Z_scope
### C.jet_division_value.division8_nonzero
division8_nonzero =
fun (remainder : bool) (r t : Integers.Int.int) =>
match remainder return Integers.Int.int with
| true =>
    Integers.Int.mods (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r)
      (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)
| false =>
    Integers.Int.divs (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r)
      (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)
end
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments division8_nonzero remainder%bool_scope r t
### C.jet_division_value.division8_raw
division8_raw =
fun (remainder : bool) (r t : Integers.Int.int) =>
match
  Integers.Int.eq Integers.Int.zero
    (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)
  return Integers.Int.int
with
| true =>
    match remainder return Integers.Int.int with
    | true => Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r
    | false => Integers.Int.zero
    end
| false => division8_nonzero remainder r t
end
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments division8_raw remainder%bool_scope r t
### C.jet_division_value.division8_payload
division8_payload =
fun (remainder : bool) (r t : Integers.Int.int) =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (division8_raw remainder r t)
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments division8_payload remainder%bool_scope r t
### C.jet_division_value.division_wide_raw
division_wide_raw =
fun (remainder : bool) (r t : Integers.Int64.int) =>
match Integers.Int64.eq Integers.Int64.zero t return Integers.Int64.int with
| true => match remainder return Integers.Int64.int with
          | true => r
          | false => Integers.Int64.zero
          end
| false =>
    match remainder return Integers.Int64.int with
    | true => Integers.Int64.modu r t
    | false => Integers.Int64.divu r t
    end
end
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments division_wide_raw remainder%bool_scope r t
