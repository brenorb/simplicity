### C.jet_secp_multiply_checkpoint_ops.sx_accum
sx_accum =
fun (s : prod jet_sx_expr.sx jet_sx_expr.sx) (a b : jet_sx_expr.sx) =>
let p : prod jet_sx_expr.sx jet_sx_expr.sx := sx_product a b in
