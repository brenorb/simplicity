       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) in
let hl : jet_sx_expr.sx :=
  jet_sx_expr.XLb jet_sx_expr.Bmul
    (jet_sx_expr.XLsh jet_sx_expr.Hshru a
       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
    (sx_low32 b) in
let hh : jet_sx_expr.sx :=
  jet_sx_expr.XLb jet_sx_expr.Bmul
    (jet_sx_expr.XLsh jet_sx_expr.Hshru a
       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
    (jet_sx_expr.XLsh jet_sx_expr.Hshru b
       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) in
let mid : jet_sx_expr.sx :=
  jet_sx_expr.XLb jet_sx_expr.Badd
    (jet_sx_expr.XLb jet_sx_expr.Badd
       (jet_sx_expr.XLsh jet_sx_expr.Hshru ll
          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
       (sx_low32 lh)) (sx_low32 hl) in
