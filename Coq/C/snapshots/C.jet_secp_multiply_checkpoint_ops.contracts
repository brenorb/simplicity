  (jet_sx_expr.XLb jet_sx_expr.Badd
     (jet_sx_expr.XLsh jet_sx_expr.Hshl mid
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     (sx_low32 ll))
  (jet_sx_expr.XLb jet_sx_expr.Badd
     (jet_sx_expr.XLb jet_sx_expr.Badd
        (jet_sx_expr.XLb jet_sx_expr.Badd hh
           (jet_sx_expr.XLsh jet_sx_expr.Hshru lh
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        (jet_sx_expr.XLsh jet_sx_expr.Hshru hl
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (jet_sx_expr.XLsh jet_sx_expr.Hshru mid
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
