### C.jet_secp_multiply_checkpoint_ops.sx_product
sx_product =
fun a b : jet_sx_expr.sx =>
let ll : jet_sx_expr.sx := jet_sx_expr.XLb jet_sx_expr.Bmul (sx_low32 a) (sx_low32 b) in
let lh : jet_sx_expr.sx :=
  jet_sx_expr.XLb jet_sx_expr.Bmul (sx_low32 a)
