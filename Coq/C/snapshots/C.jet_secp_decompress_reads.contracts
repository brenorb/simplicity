### C.jet_secp_decompress_reads.decompress_input_windows
decompress_input_windows
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      odd x))),
       and (jet_input_layout.frame_input_bit_at m bi edge rc (Bit.toBool odd))
         (jet_encoding.frame_input_cells_at m bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH))
            (@List.map bool (option bool) (@Some bool)
               (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) x)))
### C.jet_secp_decompress_reads.eval_decompress_readers
eval_decompress_readers
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (m : Memory.Mem.mem) (bx br bl : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd base bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc
                (@Translate.encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      odd x))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : not (@eq Values.block bx bl)) (_ : not (@eq Values.block br bl)) (_ : not (@eq Values.block bx br))
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bx BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z br BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))))
         (_ : jet_frame_inv.finv m0 bd base bw outedge cursor N bi m false (@nil BitMachine.Cell)),
       @ex Memory.Mem.mem
         (fun mt : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets.f_readBit)
                  (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mt
                  (Values.Vint (jet_readBit_layout.bit_int (Bit.toBool odd))))
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mt
                     (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                     (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
                     Values.Vundef)
                  (and
                     (jet_secp_fe_nv.fe_at mr bx BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho x)))
                     (and
                        (Memory.Mem.range_perm mr bx BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mr br BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mr bl BinNums.Z0
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_frame_inv.finv m0 bd base bw outedge cursor N bi mr false (@nil BitMachine.Cell))
                                 (jet_sx_mem.lframe
                                    (jet_secp_rescale_public_reads.rescale_locals_outside m0 bd bw bi bx br bl) m mr)))))))))
