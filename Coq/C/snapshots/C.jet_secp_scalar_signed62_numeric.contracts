### C.jet_secp_scalar_signed62_numeric.scalar_to62_value
scalar_to62_value =
fun (w : forall _ : nat, Integers.Int64.int) (i : nat) =>
match i return BinNums.Z with
| O =>
    BinInt.Z.modulo (Integers.Int64.unsigned (w O))
      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
         (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
| S n =>
    match n return BinNums.Z with
    | O =>
        BinInt.Z.modulo
          (BinInt.Z.add
             (BinInt.Z.div (Integers.Int64.unsigned (w O))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
             (BinInt.Z.mul (Integers.Int64.unsigned (w (S O)))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinNums.Zpos (BinNums.xO BinNums.xH)))))
          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
             (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
    | S n0 =>
        match n0 return BinNums.Z with
        | O =>
            BinInt.Z.modulo
              (BinInt.Z.add
                 (BinInt.Z.div (Integers.Int64.unsigned (w (S O)))
                    (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                 (BinInt.Z.mul (Integers.Int64.unsigned (w (S (S O))))
                    (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                       (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))))
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
        | S n1 =>
            match n1 return BinNums.Z with
            | O =>
                BinInt.Z.modulo
                  (BinInt.Z.add
                     (BinInt.Z.div (Integers.Int64.unsigned (w (S (S O))))
                        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))))
                     (BinInt.Z.mul (Integers.Int64.unsigned (w (S (S (S O)))))
                        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))))
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
            | S _ =>
                BinInt.Z.div (Integers.Int64.unsigned (w (S (S (S O)))))
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
            end
        end
    end
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), BinNums.Z

