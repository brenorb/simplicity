### C.jet_secp_gej_curve_coordinate.coordinate_frame_other
coordinate_frame_other
     : forall (k j : jet_secp_point_write_run.point_coordinate) (w : forall _ : nat, Integers.Int64.int)
         (m mf : Memory.Mem.mem) (bout bin : Values.block)
         (_ : not (@eq jet_secp_point_write_run.point_coordinate k j)) (_ : not (@eq Values.block bout bin))
         (_ : jet_secp_fe_nv.fe_at m bin (jet_secp_point_write_run.point_coordinate_offset j)
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_sx_mem.lframe (jet_secp_point_square_coordinate.point_square_coordinate_frame k bout bin) m mf),
       jet_secp_fe_nv.fe_at mf bin (jet_secp_point_write_run.point_coordinate_offset j)
         (jet_secp_multiply_normalize_bridge.words5 w)
### C.jet_secp_gej_curve_coordinate.coordinate_frame_blocks
coordinate_frame_blocks
     : forall (k : jet_secp_point_write_run.point_coordinate) (bout bin : Values.block) (m mf : Memory.Mem.mem)
         (_ : jet_sx_mem.lframe (jet_secp_point_square_coordinate.point_square_coordinate_frame k bout bin) m mf),
       jet_sx_mem.lframe
         (fun (bx : Values.block) (_ : BinNums.Z) =>
          and (not (@eq Values.block bx bout)) (not (@eq Values.block bx bin))) m mf
### C.jet_secp_gej_curve_coordinate.coordinate_square_cube_calls
coordinate_square_cube_calls
     : forall (k : jet_secp_point_write_run.point_coordinate) (rho : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bout bin : Values.block) (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin (jet_secp_point_write_run.point_coordinate_offset k)
                (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                  (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vptr bin (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                        (@nil Values.val))) Events.E0 m1 Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m1
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                     (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                           (@cons Values.val
                              (Values.Vptr bin
                                 (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                              (@nil Values.val)))) Events.E0 mf Values.Vundef)
                  (and
                     (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_point_mul_storage.point_mul_words (jet_secp_square_numeric.square_words rho) rho)))
                     (and
                        (Memory.Mem.range_perm mf bout BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_secp_fe_nv.fe_at mf bin (jet_secp_point_write_run.point_coordinate_offset k)
                              (jet_secp_multiply_normalize_bridge.words5 rho))
                           (and
                              (Memory.Mem.range_perm mf bin BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (@eq BinNums.Z
                                    (BinInt.Z.modulo
                                       (jet_secp_multiply_finish_product.radix_value
                                          (jet_secp_point_mul_storage.point_mul_words
                                             (jet_secp_square_numeric.square_words rho) rho)) jet_secp_fe_math.feP)
                                    (BinInt.Z.modulo
                                       (BinInt.Z.mul
                                          (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value rho)
                                             (jet_secp_multiply_finish_product.radix_value rho))
                                          (jet_secp_multiply_finish_product.radix_value rho)) jet_secp_fe_math.feP))
                                 (and
                                    (jet_secp_square_columns.square_input_bounds
                                       (jet_secp_point_mul_storage.point_mul_words
                                          (jet_secp_square_numeric.square_words rho) rho))
                                    (and
                                       (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                                        BinInt.Z.lt
                                          (Integers.Int64.unsigned
                                             (jet_secp_point_mul_storage.point_mul_words
                                                (jet_secp_square_numeric.square_words rho) rho i))
                                          match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                                          | true =>
                                              BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))
                                          | false =>
                                              BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))
                                          end)
                                       (jet_sx_mem.lframe
                                          (jet_secp_point_square_coordinate.point_square_coordinate_frame k bout bin) m
                                          mf)))))))))))
