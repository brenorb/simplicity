### C.jet_secp_modinv_var_invariant.inv_coefficient_link
inv_coefficient_link =
fun (value : BinNums.Z) (len : nat) (rho : forall _ : nat, Integers.Int64.int) =>
forall high : bool,
@eq BinNums.Z
  (BinInt.Z.modulo
     (BinInt.Z.mul value (jet_secp_modinv_de_numeric.de62_input_value (jet_secp_modinv_var_de.inv_de_rho rho) high))
     jet_secp_fe_math.feP)
  (BinInt.Z.modulo (jet_secp_modinv_var_fg.inv_fg_active_value len rho high) jet_secp_fe_math.feP)
     : forall (_ : BinNums.Z) (_ : nat) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments inv_coefficient_link value%Z_scope len%nat_scope rho%function_scope
### C.jet_secp_modinv_var_invariant.inv_matrix_u
inv_matrix_u =
fun (rho : forall _ : nat, Integers.Int64.int) (high : bool) =>
Integers.Int64.signed
  (jet_secp_modinv_var_de.inv_de_rho rho
     match high return nat with
     | true => S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))
     | false => S (S (S (S (S (S (S (S (S (S O)))))))))
     end)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool), BinNums.Z

Arguments inv_matrix_u rho%function_scope high%bool_scope
### C.jet_secp_modinv_var_invariant.inv_matrix_v
inv_matrix_v =
fun (rho : forall _ : nat, Integers.Int64.int) (high : bool) =>
Integers.Int64.signed
  (jet_secp_modinv_var_de.inv_de_rho rho
     match high return nat with
     | true => S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
     | false => S (S (S (S (S (S (S (S (S (S (S O))))))))))
     end)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool), BinNums.Z

Arguments inv_matrix_v rho%function_scope high%bool_scope
### C.jet_secp_modinv_var_invariant.inv_matrix_divisible
inv_matrix_divisible =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) =>
forall high : bool,
BinInt.Z.divide
  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
     (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
  (jet_secp_modinv_fg_body.fg_matrix_value
     (jet_secp_modinv_var_fg.inv_fg_rho len (jet_secp_modinv_var_de.inv_de_next_rho rho)) high len)
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments inv_matrix_divisible len%nat_scope rho%function_scope
### C.jet_secp_modinv_var_invariant.inv_state_matches
inv_state_matches =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) (st : divstep.State) =>
and (@eq BinNums.Z (divstep.f st) (jet_secp_modinv_var_fg.inv_fg_active_value len rho false))
  (@eq BinNums.Z (divstep.g st) (jet_secp_modinv_var_fg.inv_fg_active_value len rho true))
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : divstep.State), Prop

Arguments inv_state_matches len%nat_scope rho%function_scope st
### C.jet_secp_modinv_var_invariant.inv_matrix_matches
inv_matrix_matches =
fun (rho : forall _ : nat, Integers.Int64.int) (st : divstep.State) =>
and
  (@eq BinNums.Z (inv_matrix_u rho false)
     (divstep.Trans.u
        (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))) st)))
  (and
     (@eq BinNums.Z (inv_matrix_v rho false)
        (divstep.Trans.v
           (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))) st)))
     (and
        (@eq BinNums.Z (inv_matrix_u rho true)
           (divstep.Trans.q
              (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))) st)))
        (@eq BinNums.Z (inv_matrix_v rho true)
           (divstep.Trans.r
              (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))) st)))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : divstep.State), Prop

Arguments inv_matrix_matches rho%function_scope st
