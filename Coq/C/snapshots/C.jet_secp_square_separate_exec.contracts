### C.jet_secp_square_separate_exec.sx_list_same_sound
sx_list_same_sound
     : forall (xs ys : list jet_sx_expr.sx) (_ : @eq bool (sx_list_same xs ys) true), @eq (list jet_sx_expr.sx) xs ys
### C.jet_secp_square_separate_exec.separate_tail
separate_tail
     : forall (writable : bool) (freed : option BinNums.Z),
       @eq (list jet_sx_state.region)
         (@List.tl jet_sx_state.region
            (jet_sx_eval.sregs (jet_secp_square_separate_layout.separate_state writable freed)))
         (@cons jet_sx_state.region (jet_secp_square_separate_layout.separate_input writable freed)
            (@nil jet_sx_state.region))
### C.jet_secp_square_separate_exec.separate_out_shape
separate_out_shape
     : forall (writable : bool) (freed : option BinNums.Z),
       @eq (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
         (jet_sx_state.rshape (separate_out writable freed))
         (@pair (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)
            (@pair (list (prod BinNums.Z AST.memory_chunk)) bool
               (@cons (prod BinNums.Z AST.memory_chunk) (@pair BinNums.Z AST.memory_chunk BinNums.Z0 AST.Mint64)
                  (@cons (prod BinNums.Z AST.memory_chunk)
                     (@pair BinNums.Z AST.memory_chunk (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                        AST.Mint64)
                     (@cons (prod BinNums.Z AST.memory_chunk)
                        (@pair BinNums.Z AST.memory_chunk
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) AST.Mint64)
                        (@cons (prod BinNums.Z AST.memory_chunk)
                           (@pair BinNums.Z AST.memory_chunk
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) AST.Mint64)
                           (@cons (prod BinNums.Z AST.memory_chunk)
                              (@pair BinNums.Z AST.memory_chunk
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 AST.Mint64) (@nil (prod BinNums.Z AST.memory_chunk))))))) true)
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
### C.jet_secp_square_separate_exec.separate_out_defined
separate_out_defined
     : forall (writable : bool) (freed : option BinNums.Z),
       @eq bool (jet_secp_multiply_run_run.field_cells_defined (jet_sx_state.rcells (separate_out writable freed)))
         true
### C.jet_secp_square_separate_exec.separate_out_rebuild
separate_out_rebuild
     : forall (writable : bool) (freed : option BinNums.Z),
       @eq jet_sx_state.region (separate_out writable freed)
         (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (separate_limbs writable freed)) true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
