### C.jet_secp_scalar_mul_separate.eval_scalar_mul_borrowed_separate
eval_scalar_mul_borrowed_separate
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (br : Values.block)
         (_ : jet_sx_state.rep rho beta jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs m)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (r : nat) (_ : lt r (S (S O))), not (@eq Values.block br (jet_sx_state.blk beta r))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf br BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo
                           (BinInt.Z.mul (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)
                              (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho (S (S (S (S O))))))
                           jet_secp_canonical_scalar.canonical_group_order))))
               (and (jet_sx_state.rep rho beta jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs mf)
                  (and
                     (Memory.Mem.range_perm mf br BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and (jet_clight_internal_permissions.keeps_permissions m mf)
                        (and (jet_clight_internal_preserve.readonly_preserved m mf)
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               and (not (@eq Values.block b br))
                                 (not
                                    (jet_sx_state.foot beta
                                       (@List.map jet_sx_state.region
                                          (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                          jet_sx_state.rshape
                                          jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs) b ofs))) m mf)))))))
### C.jet_secp_scalar_mul_separate.eval_scalar_mul_separate_values
eval_scalar_mul_separate_values
     : forall (a b : BinNums.Z) (m : Memory.Mem.mem) (br ba bb : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 a)
                (BinInt.Z.lt a
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 b)
                (BinInt.Z.lt b
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : not (@eq Values.block br ba)) (_ : not (@eq Values.block br bb)) (_ : not (@eq Values.block ba bb))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of a)))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of b)))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf br BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo (BinInt.Z.mul a b) jet_secp_canonical_scalar.canonical_group_order))))
               (and
                  (jet_sx_state.rep (jet_secp_scalar_mul_reader_bridge.scalar_mul_reader_rho a b)
                     (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                           (@nil (prod Values.block BinNums.Z))))
                     jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs mf)
                  (and
                     (Memory.Mem.range_perm mf br BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and (jet_clight_internal_permissions.keeps_permissions m mf)
                        (and (jet_clight_internal_preserve.readonly_preserved m mf)
                           (jet_sx_mem.lframe
                              (fun (block : Values.block) (_ : BinNums.Z) =>
                               and (not (@eq Values.block block br))
                                 (and (not (@eq Values.block block ba)) (not (@eq Values.block block bb)))) m mf)))))))
