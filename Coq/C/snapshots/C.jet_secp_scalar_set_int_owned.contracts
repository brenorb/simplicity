### C.jet_secp_scalar_set_int_owned.scalar_set_int_run_eq
scalar_set_int_run_eq
     : forall v : Integers.Int.int,
       @eq (option jet_sx_exec.res) (scalar_set_int_run v)
         (@Some jet_sx_exec.res (jet_sx_exec.RDone (scalar_set_int_state v) jet_sx_exec.ONormal))
### C.jet_secp_scalar_set_int_owned.scalar_set_int_output
scalar_set_int_output
     : forall v : Integers.Int.int,
       @eq (list jet_sx_state.region) (jet_sx_eval.sregs (scalar_set_int_state v))
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (scalar_set_int_out v)) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@nil jet_sx_state.region))
### C.jet_secp_scalar_set_int_owned.scalar_set_int_log
scalar_set_int_log
     : forall v : Integers.Int.int,
       @eq (list jet_sx_eval.event) (jet_sx_eval.slog (scalar_set_int_state v)) (@nil jet_sx_eval.event)
### C.jet_secp_scalar_set_int_owned.scalar_set_int_return
scalar_set_int_return
     : forall v : Integers.Int.int,
       @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps (scalar_set_int_state v)))
         (@None jet_sx_expr.sx)
### C.jet_secp_scalar_set_int_owned.scalar_set_int_initial
scalar_set_int_initial
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep rho
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@nil (prod Values.block BinNums.Z))) scalar_set_int_regs m
### C.jet_secp_scalar_set_int_owned.eval_scalar_set_int_owned
eval_scalar_set_int_owned
     : forall (v : Integers.Int.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_set_int)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vint v) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf b BinNums.Z0
                  (@cons Integers.Int64.int (Integers.Int64.repr (Integers.Int.unsigned v))
                     (@cons Integers.Int64.int Integers.Int64.zero
                        (@cons Integers.Int64.int Integers.Int64.zero
                           (@cons Integers.Int64.int Integers.Int64.zero (@nil Integers.Int64.int))))))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf)
                     (jet_clight_internal_preserve.readonly_preserved m mf)))))
