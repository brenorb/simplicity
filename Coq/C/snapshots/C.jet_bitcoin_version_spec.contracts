### C.jet_bitcoin_version_spec.bitcoin_version_word_signed_unsigned
bitcoin_version_word_signed_unsigned
     : forall version : Integers.Int.int,
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned version))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.signed version))
### C.jet_bitcoin_version_spec.bitcoin_version_carrier_matches_primitive
bitcoin_version_carrier_matches_primitive
     : forall (r : Integers.Int64.int) (environment : Bitcoin.Bitcoin.env)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r)
                (Integers.Int.unsigned (Bitcoin.sigTxVersion (Bitcoin.Bitcoin.envTx environment)))),
       @eq (option (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W32))))
         (@Some (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W32)))
            (jet_wide_spec.decode_wide jet_wide.W32
               (Integers.Int64.zero_ext
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) r)))
         (@Bitcoin.Bitcoin.sem Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.Version tt environment)
