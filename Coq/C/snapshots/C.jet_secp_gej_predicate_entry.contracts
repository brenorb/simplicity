### C.jet_secp_gej_predicate_entry.gej_predicate_public_entry
gej_predicate_public_entry
     : forall (v_env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem') (bl ba bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (@pair Memory.Mem.mem' Values.block mb ba)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_simplicity_gej_is_infinity
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val v_env (@nil Values.val))))
         m (jet_secp_gej_public_entry.gej_public_env bl ba) (gej_predicate_temps v_env bd dbase bs sbase) mb
### C.jet_secp_gej_predicate_entry.gej_predicate_src_temp
gej_predicate_src_temp
     : forall (v_env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z),
       @eq (option Values.val)
         (@Maps.PTree.get Values.val jets_secp._src (gej_predicate_temps v_env bd dbase bs sbase))
         (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)))
### C.jet_secp_gej_predicate_entry.gej_predicate_dst_temp
gej_predicate_dst_temp
     : forall (v_env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z),
       @eq (option Values.val)
         (@Maps.PTree.get Values.val jets_secp._dst (gej_predicate_temps v_env bd dbase bs sbase))
