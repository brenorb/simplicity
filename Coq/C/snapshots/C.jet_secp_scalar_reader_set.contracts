### C.jet_secp_scalar_reader_set.scalar_reader_byte_shift
scalar_reader_byte_shift = fun n : nat => jet_sx_expr.XLv (S n)
     : forall _ : nat, jet_sx_expr.sx

Arguments scalar_reader_byte_shift n%nat_scope
### C.jet_secp_scalar_reader_set.scalar_reader_set_concrete_temps
scalar_reader_set_concrete_temps =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) =>
@Maps.PTree.set Values.val jets_secp._overflow
  (jet_sx_expr.den rho (jet_sx_state.lay layout) (jet_sx_expr.XLc Integers.Int64.zero))
  (@Maps.PTree.set Values.val jets_secp._b32
     (jet_sx_expr.den rho (jet_sx_state.lay layout) (jet_sx_expr.XP (S (S O)) BinNums.Z0))
     (@Maps.PTree.set Values.val jets_secp._r
        (jet_sx_expr.den rho (jet_sx_state.lay layout) (jet_sx_expr.XP O BinNums.Z0))
        (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_scalar_set_b32))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : jet_sx_state.layout), Maps.PTree.tree Values.val

Arguments scalar_reader_set_concrete_temps rho%function_scope layout
### C.jet_secp_scalar_reader_set.scalar_reader_second
scalar_reader_second =
match Clight.fn_body jets_secp.f_read_scalar return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ second => second
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
