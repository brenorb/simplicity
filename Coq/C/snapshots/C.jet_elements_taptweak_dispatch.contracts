### C.jet_elements_taptweak_dispatch.eval_elements_taptweak_sha_compression_uchar
eval_elements_taptweak_sha_compression_uchar
     : forall (m : Memory.Mem.mem) (bs : Values.block) (os : Integers.Ptrofs.int) (bc : Values.block)
         (oc : Integers.Ptrofs.int) (regs bytes : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq nat (@length Integers.Int.int bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned) (_ : elements_taptweak_sha_dispatch_ok m)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
              and
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint32 m bs
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                   (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
                (Memory.Mem.valid_access m AST.Mint32 bs
                   (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                   Memtype.Writable))
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oc) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i bytes Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_sha256_compression_uchar)
               (@cons Values.val (Values.Vptr bs os) (@cons Values.val (Values.Vptr bc oc) (@nil Values.val)))
               Events.E0 mf Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 mf bs
                     (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                  (@Some Values.val
                     (Values.Vint
                        (@List.nth Integers.Int.int i (SHA256.hash_block regs (jet_sha_ctx8_model.be_words bytes))
                           Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : or (not (@eq Values.block b bs))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) (Integers.Ptrofs.unsigned os))
                               (BinInt.Z.le
                                  (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm mf b ofs k p)
                     (and (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
### C.jet_elements_taptweak_dispatch.eval_elements_taptweak_sha_compression_uchar_owned_at
eval_elements_taptweak_sha_compression_uchar_owned_at
     : forall (regs bytes : list Integers.Int.int) (m : Memory.Mem.mem) (bs bb : Values.block)
         (ob : Integers.Ptrofs.int) (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq nat (@length Integers.Int.int bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : jet_elements_taptweak_globals.elements_taptweak_sha_startup m)
         (_ : jet_uint32_array_init.uint32_array_at m bs BinNums.Z0 regs)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bb
                   (BinInt.Z.add (Integers.Ptrofs.unsigned ob) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i bytes Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_sha256_compression_uchar)
               (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bb ob) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                  (SHA256.hash_block regs (jet_sha_ctx8_model.be_words bytes)))
               (and
                  (Memory.Mem.range_perm mf bs BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bs)) m mf)
                     (and (jet_clight_internal_preserve.readonly_preserved m mf)
                        (jet_elements_taptweak_globals.elements_taptweak_sha_startup mf))))))
