### C.jet_secp_scalar_cadd_numeric.cadd_actual_words
cadd_actual_words
     : forall (rho : forall _ : nat, Integers.Int64.int) (flag : bool),
       @eq (list Integers.Int64.int) (jet_secp_scalar_cadd_function.cadd_output_words rho flag)
         (cadd_machine_words flag rho)
### C.jet_secp_scalar_cadd_numeric.cadd_pair_zero
cadd_pair_zero
     : forall p : prod Integers.Int64.int Integers.Int64.int,
       @eq (prod Integers.Int64.int Integers.Int64.int) (cadd_pair_add p Integers.Int64.zero) p
### C.jet_secp_scalar_cadd_numeric.cadd_pair_from_zero
cadd_pair_from_zero
     : forall lo x : Integers.Int64.int,
       let p : prod Integers.Int64.int Integers.Int64.int :=
         cadd_pair_add (@pair Integers.Int64.int Integers.Int64.int lo Integers.Int64.zero) x in
       and
         (and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned (@snd Integers.Int64.int Integers.Int64.int p)))
            (BinInt.Z.le (Integers.Int64.unsigned (@snd Integers.Int64.int Integers.Int64.int p))
               (BinNums.Zpos BinNums.xH)))
         (@eq BinNums.Z
            (BinInt.Z.add
               (BinInt.Z.mul (Integers.Int64.unsigned (@snd Integers.Int64.int Integers.Int64.int p))
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (Integers.Int64.unsigned (@fst Integers.Int64.int Integers.Int64.int p)))
            (BinInt.Z.add (Integers.Int64.unsigned lo) (Integers.Int64.unsigned x)))
### C.jet_secp_scalar_cadd_numeric.cadd_output_numeric
cadd_output_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (flag : bool),
       @eq BinNums.Z (cadd_output_value rho flag)
         (BinInt.Z.modulo
            (BinInt.Z.add (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)
               match flag return BinNums.Z with
               | true => BinNums.Zpos BinNums.xH
               | false => BinNums.Z0
               end)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_scalar_cadd_numeric.cadd_output_exact
cadd_output_exact
     : forall (rho : forall _ : nat, Integers.Int64.int) (flag : bool)
         (_ : BinInt.Z.lt
                (BinInt.Z.add (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)
                   match flag return BinNums.Z with
                   | true => BinNums.Zpos BinNums.xH
                   | false => BinNums.Z0
                   end)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @eq BinNums.Z (cadd_output_value rho flag)
         (BinInt.Z.add (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)
            match flag return BinNums.Z with
            | true => BinNums.Zpos BinNums.xH
            | false => BinNums.Z0
            end)
### C.jet_secp_scalar_cadd_numeric.cadd_output_canonical
cadd_output_canonical
     : forall (rho : forall _ : nat, Integers.Int64.int) (flag : bool),
       @eq (list Integers.Int64.int)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of (cadd_output_value rho flag)))
         (jet_secp_scalar_cadd_function.cadd_output_words rho flag)
### C.jet_secp_scalar_cadd_numeric.eval_scalar_cadd_numeric
eval_scalar_cadd_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (flag : bool) (m : Memory.Mem.mem)
         (b : Values.block)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m b BinNums.Z0
                (jet_secp_scalar_add_initial.scalar_add_values rho O))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_cadd_bit)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vint Integers.Int.zero)
                     (@cons Values.val
                        (Values.Vint
                           match flag return Integers.Int.int with
                           | true => Integers.Int.one
                           | false => Integers.Int.zero
                           end) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf b BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo
                           (BinInt.Z.add (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)
                              match flag return BinNums.Z with
                              | true => BinNums.Zpos BinNums.xH
                              | false => BinNums.Z0
                              end)
                           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and (jet_clight_internal_preserve.readonly_preserved m mf)
                        (jet_sx_mem.lframe (fun (b' : Values.block) (_ : BinNums.Z) => not (@eq Values.block b' b)) m
                           mf))))))
### C.jet_secp_scalar_cadd_numeric.eval_scalar_cadd_value
eval_scalar_cadd_value
     : forall (value : BinNums.Z) (flag : bool) (m : Memory.Mem.mem) (b : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m b BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_cadd_bit)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vint Integers.Int.zero)
                     (@cons Values.val
                        (Values.Vint
                           match flag return Integers.Int.int with
                           | true => Integers.Int.one
                           | false => Integers.Int.zero
                           end) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf b BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo
                           (BinInt.Z.add value
                              match flag return BinNums.Z with
                              | true => BinNums.Zpos BinNums.xH
                              | false => BinNums.Z0
                              end)
                           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and (jet_clight_internal_preserve.readonly_preserved m mf)
                        (jet_sx_mem.lframe (fun (b' : Values.block) (_ : BinNums.Z) => not (@eq Values.block b' b)) m
                           mf))))))
### C.jet_secp_scalar_cadd_numeric.cadd_pair_add
cadd_pair_add =
fun (p : prod Integers.Int64.int Integers.Int64.int) (x : Integers.Int64.int) =>
let lo : Integers.Int64.int := Integers.Int64.add (@fst Integers.Int64.int Integers.Int64.int p) x in
@pair Integers.Int64.int Integers.Int64.int lo
  (Integers.Int64.add (@snd Integers.Int64.int Integers.Int64.int p)
     (Integers.Int64.repr
        (Integers.Int.signed
           match Integers.Int64.ltu lo x return Integers.Int.int with
           | true => Integers.Int.one
           | false => Integers.Int.zero
           end)))
     : forall (_ : prod Integers.Int64.int Integers.Int64.int) (_ : Integers.Int64.int),
       prod Integers.Int64.int Integers.Int64.int

Arguments cadd_pair_add p x
### C.jet_secp_scalar_cadd_numeric.cadd_machine_words
cadd_machine_words =
fun (flag : bool) (rho : forall _ : nat, Integers.Int64.int) =>
let p0 : prod Integers.Int64.int Integers.Int64.int :=
  cadd_pair_add (@pair Integers.Int64.int Integers.Int64.int (rho O) Integers.Int64.zero)
    (jet_secp_scalar_cadd_control.cadd_selector_value flag O) in
let p1 : prod Integers.Int64.int Integers.Int64.int :=
  cadd_pair_add
    (cadd_pair_add
       (@pair Integers.Int64.int Integers.Int64.int (@snd Integers.Int64.int Integers.Int64.int p0) Integers.Int64.zero)
       (rho (S O))) Integers.Int64.zero in
let p2 : prod Integers.Int64.int Integers.Int64.int :=
  cadd_pair_add
    (cadd_pair_add
       (@pair Integers.Int64.int Integers.Int64.int (@snd Integers.Int64.int Integers.Int64.int p1) Integers.Int64.zero)
       (rho (S (S O)))) Integers.Int64.zero in
let p3 : prod Integers.Int64.int Integers.Int64.int :=
  cadd_pair_add
    (cadd_pair_add
       (@pair Integers.Int64.int Integers.Int64.int (@snd Integers.Int64.int Integers.Int64.int p2) Integers.Int64.zero)
       (rho (S (S (S O))))) Integers.Int64.zero in
@cons Integers.Int64.int (@fst Integers.Int64.int Integers.Int64.int p0)
  (@cons Integers.Int64.int (@fst Integers.Int64.int Integers.Int64.int p1)
     (@cons Integers.Int64.int (@fst Integers.Int64.int Integers.Int64.int p2)
        (@cons Integers.Int64.int (@fst Integers.Int64.int Integers.Int64.int p3) (@nil Integers.Int64.int))))
     : forall (_ : bool) (_ : forall _ : nat, Integers.Int64.int), list Integers.Int64.int

Arguments cadd_machine_words flag%bool_scope rho%function_scope
### C.jet_secp_scalar_cadd_numeric.cadd_output_value
cadd_output_value =
fun (rho : forall _ : nat, Integers.Int64.int) (flag : bool) =>
jet_secp_scalar_overflow_numeric.scalar_limb_value
  (fun i : nat =>
   @List.nth Integers.Int64.int i (jet_secp_scalar_cadd_function.cadd_output_words rho flag) Integers.Int64.zero)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool), BinNums.Z

Arguments cadd_output_value rho%function_scope flag%bool_scope
