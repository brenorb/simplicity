### C.jet_secp_linear_check_group.secp_jacobian_word_infinity
secp_jacobian_word_infinity
     : forall (point : Ty.tySem jet_secp_scalar_table_literal.literal_table_gej)
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : jet_secp_jacobian_word_group.secp_jacobian_word_rep (GZnZ.one jet_secp_fe_math.feP) point p),
       iff (@eq bool (Bit.toBool (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem point)) true)
         (@eq jet_secp_curve_group_sign.secp_group_point p jet_secp_curve_group_sign.secp_group_infinity)
### C.jet_secp_linear_check_group.secp_group_subtract_infinity
secp_group_subtract_infinity
     : forall p q : jet_secp_curve_group_sign.secp_group_point,
       iff
         (@eq
            (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
               (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
            (@SMain.add (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
               (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
               (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
               (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
               jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory p
               (@SMain.opp (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                  (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                  (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
                  (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                  jet_secp_curve_group.secp_group_seven jet_secp_curve_group.secp_group_zero_test
                  jet_secp_curve_group.secp_group_theory q)) jet_secp_curve_group_sign.secp_group_infinity)
         (@eq jet_secp_curve_group_sign.secp_group_point p q)
### C.jet_secp_linear_check_group.secp_literal_linear_check_group
