### C.jet_secp_affine_y_parity.affine_output_parity
affine_output_parity
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq bool
         (Bit.toBool
            (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem
               (jet_secp_rescale_literal.rescale_field_output w)))
         (BinInt.Z.testbit (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)
            BinNums.Z0)
### C.jet_secp_affine_y_parity.affine_y_parity_helpers_closed
affine_y_parity_helpers_closed
     : and
         (@eq bool
            (jet_clight_internal_frame.closed_stmtb jet_secp_field_io_preserve.field_io_helpers
               (Clight.fn_body jets_secp.f_secp256k1_fe_normalize_var)) true)
         (@eq bool
            (jet_clight_internal_frame.closed_stmtb jet_secp_field_io_preserve.field_io_helpers
               (Clight.fn_body jets_secp.f_secp256k1_fe_is_odd)) true)
### C.jet_secp_affine_y_parity.affine_y_normalizer_preserved
affine_y_normalizer_preserved
     : forall (m : Memory.Mem.mem) (args : list Values.val) (t : Events.trace) (mf : Memory.Mem.mem)
         (result : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var) args t mf result),
       jet_clight_internal_preserve.readonly_preserved m mf
### C.jet_secp_affine_y_parity.affine_y_parity_preserved
affine_y_parity_preserved
     : forall (m : Memory.Mem.mem) (args : list Values.val) (t : Events.trace) (mf : Memory.Mem.mem)
         (result : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd) args t mf result),
       jet_clight_internal_preserve.readonly_preserved m mf
### C.jet_secp_affine_y_parity.eval_affine_normalized_y_odd
eval_affine_normalized_y_odd
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (br : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m br
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mn : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var)
                  (@cons Values.val
                     (Values.Vptr br
                        (Integers.Ptrofs.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@nil Values.val)) Events.E0 mn Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mn
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd)
                     (@cons Values.val
                        (Values.Vptr br
                           (Integers.Ptrofs.repr
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@nil Values.val)) Events.E0 mf
                     (Values.Vint
                        (jet_readBit_layout.bit_int
                           (Bit.toBool
                              (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem
                                 (jet_secp_rescale_literal.rescale_field_output w))))))
                  (and
                     (Memory.Mem.range_perm mf br BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (pos : BinNums.Z) =>
                            or (not (@eq Values.block b br))
                              (or
                                 (BinInt.Z.lt pos
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (BinInt.Z.le
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    pos))) m mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))
