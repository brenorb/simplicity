### C.jet_sha256_read_local.sha256_read_local_entry
sha256_read_local_entry
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bl bc : Values.block) (cbase : BinNums.Z)
         (bf : Values.block) (base : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block ma bl)),
       Clight.function_entry2 jet_exec.ge0 jets.f_simplicity_read_sha256_context
         (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase))
            (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) m
         (sha256_read_env bl) (sha256_read_temps bc cbase bf base) ma
### C.jet_sha256_read_local.allocate_sha256_read_local
allocate_sha256_read_local
     : forall (m : Memory.Mem.mem) (bc : Values.block) (cbase : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (_ : jet_sha256_max_counter.sha256_max_counter_at m),
       @ex Memory.Mem.mem'
         (fun ma : Memory.Mem.mem' =>
          @ex Values.block
            (fun bl : Values.block =>
             and
               (@eq (prod Memory.Mem.mem' Values.block)
                  (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                  (@pair Memory.Mem.mem' Values.block ma bl))
               (and
                  (Clight.function_entry2 jet_exec.ge0 jets.f_simplicity_read_sha256_context
                     (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase))
                        (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) m
                     (sha256_read_env bl) (sha256_read_temps bc cbase bf base) ma)
                  (and
                     (Memory.Mem.range_perm ma bl BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) Memtype.Cur Memtype.Freeable)
                     (and (Memory.Mem.valid_access ma AST.Mint64 bl BinNums.Z0 Memtype.Writable)
                        (and (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), not (@eq Values.block b bl))
                           (and
                              (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                 (_ : Memory.Mem.valid_block m b),
                               @eq (option Values.val) (Memory.Mem.load chunk ma b ofs) (Memory.Mem.load chunk m b ofs))
                              (and
                                 (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                  Memory.Mem.perm ma b ofs kind p) (jet_sha256_max_counter.sha256_max_counter_at ma)))))))))
### C.jet_sha256_read_local.sha256_read_local_blocks
sha256_read_local_blocks
     : forall bl : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_exec.ge0 (sha256_read_env bl))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
### C.jet_sha256_read_local.free_sha256_read_local
free_sha256_read_local
     : forall (m : Memory.Mem.mem) (bl : Values.block)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.free_list m (Clight.blocks_of_env jet_exec.ge0 (sha256_read_env bl)))
               (@Some Memory.Mem.mem mf))
            (and
               (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                  (_ : not (@eq Values.block b bl)),
                @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
               (and
                  (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                     (_ : not (@eq Values.block b bl)) (_ : Memory.Mem.perm m b ofs kind p),
                   Memory.Mem.perm mf b ofs kind p)
                  (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m)))))
### C.jet_sha256_read_local.eval_sha256_read_context_from_body
eval_sha256_read_context_from_body
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mb : Memory.Mem.mem) (bl bc : Values.block)
         (cbase : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (le : Clight.temp_env)
         (overflow : bool)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (sha256_read_env bl) (sha256_read_temps bc cbase bf base) ma
                (Clight.fn_body jets.f_simplicity_read_sha256_context) Events.E0 le mb
                (ClightBigstep.Out_return
                   (@Some (prod Values.val Ctypes.type)
                      (@pair Values.val Ctypes.type (Values.Vint (jet_readBit_layout.bit_int (negb overflow)))
                         Ctypesdefs.tint))))
         (_ : Memory.Mem.range_perm mb bl BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function jets.f_simplicity_read_sha256_context)
               (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase))
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               (Values.Vint (jet_readBit_layout.bit_int (negb overflow))))
            (and
               (@eq (option Memory.Mem.mem)
                  (Memory.Mem.free_list mb (Clight.blocks_of_env jet_exec.ge0 (sha256_read_env bl)))
                  (@Some Memory.Mem.mem mf))
               (and
                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : not (@eq Values.block b bl)),
                   @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk mb b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                        (p : Memtype.permission) (_ : not (@eq Values.block b bl))
                        (_ : Memory.Mem.perm mb b ofs kind p), Memory.Mem.perm mf b ofs kind p)
                     (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock mb))))))
### C.jet_sha256_read_local.sha256_read_env
sha256_read_env =
fun bl : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets._len (@pair Values.block Ctypes.type bl Ctypesdefs.tulong)
  Clight.empty_env
     : forall _ : Values.block, Clight.env

Arguments sha256_read_env bl
### C.jet_sha256_read_local.sha256_read_temps
sha256_read_temps =
fun (bc : Values.block) (cbase : BinNums.Z) (bf : Values.block) (base : BinNums.Z) =>
@Maps.PTree.set Values.val jets._src (Values.Vptr bf (Integers.Ptrofs.repr base))
  (@Maps.PTree.set Values.val jets._ctx (Values.Vptr bc (Integers.Ptrofs.repr cbase))
     (Clight.create_undef_temps (Clight.fn_temps jets.f_simplicity_read_sha256_context)))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments sha256_read_temps bc cbase%Z_scope bf base%Z_scope
