### C.jet_right_pad_bit8_exec.right_pad_bit8_guard
right_pad_bit8_guard
     : @eq bool
         (Integers.Int.ltu (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))
            Integers.Int.iwordsize) true
### C.jet_right_pad_bit8_exec.eval_right_pad_bit8_expr
eval_right_pad_bit8_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bit : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._bit le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit)))),
       Clight.eval_expr jet_exec.ge0 e le m right_pad_bit8_expr (Values.Vint (right_pad_bit8_arg bit))
### C.jet_right_pad_bit8_exec.eval_right_pad_bit8_composes
eval_right_pad_bit8_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc mr me mf : Memory.Mem.mem)
         (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (bit : bool) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc (@Ctypes.Internal Clight.function jets.f_readBit)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint (jet_readBit_layout.bit_int bit)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vint (right_pad_bit8_arg bit)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_right_pad_low_1_8)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_right_pad_bit8_exec.le_right_pad_bit8
le_right_pad_bit8 =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (bit : bool) =>
@Maps.PTree.set Values.val jets._bit (Values.Vint (jet_readBit_layout.bit_int bit))
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vint (jet_readBit_layout.bit_int bit))
     (jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_right_pad_low_1_8 bd dofs bs sofs))
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : bool), Maps.PTree.tree Values.val

Arguments le_right_pad_bit8 env bd dofs bs sofs bit%bool_scope
### C.jet_right_pad_bit8_exec.right_pad_bit8_arg
right_pad_bit8_arg =
fun bit : bool =>
Integers.Int.shl (jet_readBit_layout.bit_int bit)
  (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))
     : forall _ : bool, Integers.Int.int

Arguments right_pad_bit8_arg bit%bool_scope
### C.jet_right_pad_bit8_exec.right_pad_bit8_expr
right_pad_bit8_expr =
Clight.Ecast
  (Clight.Ebinop Cop.Oshl (Clight.Ecast (Clight.Etempvar jets._bit Ctypesdefs.tbool) Ctypesdefs.tuchar)
     (Clight.Ebinop Cop.Osub
        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
           Ctypesdefs.tint) (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint) Ctypesdefs.tint)
  Ctypesdefs.tuchar
     : Clight.expr
