### C.jet_sha_ctx8_finalize_jet.fz_body
fz_body
     : @eq Clight.statement (Clight.fn_body jets_sha.f_simplicity_sha_256_ctx_8_finalize)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
               (Clight.Etempvar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
            (jet_sha_add_n_init.an_init fz_rest))
### C.jet_sha_ctx8_finalize_jet.fz_blocks
fz_blocks
     : forall bl bm bx : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_sha_linkage.sha_ge (fz_env bl bm bx))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bm BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))
### C.jet_sha_ctx8_finalize_jet.fz_write32s_symbol
fz_write32s_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_sha_linkage.sha_ge)
            jets_sha._write32s) (@Some Values.block (jet_sha_linkage.sha_symbol_block jets_sha._write32s))
### C.jet_sha_ctx8_finalize_jet.fz_write32s_funct
fz_write32s_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_sha_linkage.sha_ge)
            (Values.Vptr (jet_sha_linkage.sha_symbol_block jets_sha._write32s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_write32s))
### C.jet_sha_ctx8_finalize_jet.fz_entry
fz_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 : Memory.Mem.mem') (bl bm bx bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bm))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m3 bx)),
       Clight.function_entry2 jet_sha_linkage.sha_ge jets_sha.f_simplicity_sha_256_ctx_8_finalize
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (fz_env bl bm bx) (fz_temps env bd dbase bs sbase) m3
### C.jet_sha_ctx8_finalize_jet.fz_copy
fz_copy
     : forall (m mc : Memory.Mem.mem) (bl bm bx bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge (fz_env bl bm bx) le m
         (Clight.Sassign (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
### C.jet_sha_ctx8_finalize_jet.sg_in_write32s
sg_in_write32s
     : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function jets._write32s jets.f_write32s)
         jet_sha_transport.sha_core_helpers
### C.jet_sha_ctx8_finalize_jet.state_regs_cells
state_regs_cells
     : forall h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list BitMachine.Cell) (jet_write32s_layout.uint32_word_cells (jet_sha_ctx8_model.state_regs h))
         (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h)
### C.jet_sha_ctx8_finalize_jet.frame_input_cells_valid
frame_input_cells_valid
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (cells : list BitMachine.Cell)
         (_ : not (@eq (list BitMachine.Cell) cells (@nil BitMachine.Cell)))
         (_ : jet_encoding.frame_input_cells_at m bi edge rc cells), Memory.Mem.valid_block m bi
### C.jet_sha_ctx8_finalize_jet.sha_256_ctx_8_finalize_local_spec
sha_256_ctx_8_finalize_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       jet_sha_ctx8_add_jets.sha_jet_partial_local_spec jets_sha.f_simplicity_sha_256_ctx_8_finalize
         jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (fun a : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type =>
          @jet_sha_finalize_spec.ctx8_finalize_spec (Alg.AssertionSem Option.option_Monad_Zero) a)
### C.jet_sha_ctx8_finalize_jet.fz_env
fz_env =
fun bl bm bx : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._ctx
  (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._midstate
     (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._src
        (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Clight.empty_env))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments fz_env bl bm bx
### C.jet_sha_ctx8_finalize_jet.fz_temps
fz_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_sha._env env
  (@Maps.PTree.set Values.val jets_sha._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_sha._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_sha.f_simplicity_sha_256_ctx_8_finalize))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments fz_temps env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_sha_ctx8_finalize_jet.fz_read
fz_read =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_sha._t'1)
     (Clight.Evar jets_sha._simplicity_read_sha256_context
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))) (@nil Clight.expr))))
  (Clight.Sifthenelse (Clight.Eunop Cop.Onotbool (Clight.Etempvar jets_sha._t'1 Ctypesdefs.tbool) Ctypesdefs.tint)
     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint)))
     Clight.Sskip)
     : Clight.statement
### C.jet_sha_ctx8_finalize_jet.fz_finalize
fz_finalize =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_sha._sha256_finalize
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)) Ctypes.Tnil)
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))) (@nil Clight.expr))
     : Clight.statement
### C.jet_sha_ctx8_finalize_jet.fz_write
fz_write =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_sha._write32s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Etempvar jets_sha._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Efield (Clight.Evar jets_sha._midstate (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
           jets_sha._s
           (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (@cons Clight.expr
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              Ctypesdefs.tint) (@nil Clight.expr))))
     : Clight.statement
### C.jet_sha_ctx8_finalize_jet.fz_rest
fz_rest =
Clight.Ssequence fz_read
  (Clight.Ssequence fz_finalize
     (Clight.Ssequence fz_write
        (Clight.Sreturn
           (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)))))
     : Clight.statement
