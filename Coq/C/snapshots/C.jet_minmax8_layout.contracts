          @jet_minmax_spec.minmax_word_spec (S (S (S O))) false Alg.CoreFunSem xy)
### C.jet_minmax8_layout.max8_local_spec
max8_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_max_8
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) (Word.Word (S (S (S O))))
