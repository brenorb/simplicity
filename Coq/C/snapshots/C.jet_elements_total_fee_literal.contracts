### C.jet_elements_total_fee_literal.elements_total_fee_body_sem
elements_total_fee_body_sem
     : forall (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (index : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (acc : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))))
         (@elements_total_fee_body
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S O))))))) key index) acc) environment)
         (@Some (sum (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
            match
              @List.nth_error jet_elements_prim.txOutput
                (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
                (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) index))
              return
                (sum (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
            with
            | Some o =>
                @inr (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                  (total_fee_literal_step key acc o)
            | None =>
                @inl (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                  acc
            end)
