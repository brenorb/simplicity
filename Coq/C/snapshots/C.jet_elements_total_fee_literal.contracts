Arguments elements_total_fee_body {alg}
### C.jet_elements_total_fee_literal.total_fee_literal_program
total_fee_literal_program =
fun (alg : Alg.Core.Algebra)
  (body : Alg.Core.domain alg
            (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
               (Word.Word (S (S (S (S (S (S O))))))))
            (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))) =>
@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S O))))))))
  (Word.Word (S (S (S (S (S (S O))))))) alg
  (@Alg.Core.Combinators.pair (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S O))))))) alg
     (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) alg)
     (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S O))))))) alg
        (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) alg)
        (@Word.zero (S (S (S (S (S (S O)))))) alg)))
  (@Alg.Core.Combinators.comp
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
     (Word.Word (S (S (S (S (S (S O))))))) alg
     (@jet_forWhile_spec.for_while_program (S (S (S (S (S O))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))) alg body)
     (@Alg.Core.Combinators.copair (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))
        (Word.Word (S (S (S (S (S (S O))))))) alg
        (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) alg)
        (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) alg)))
     : forall (alg : Alg.Core.Algebra)
