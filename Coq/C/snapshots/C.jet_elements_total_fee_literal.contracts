                (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                   (Word.Word (S (S (S (S (S (S O))))))))
                (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))),
       Alg.Core.domain alg (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S O)))))))

Arguments total_fee_literal_program {alg} body
### C.jet_elements_total_fee_literal.elements_total_fee_spec
elements_total_fee_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@total_fee_literal_program (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
  (@elements_total_fee_body alg)
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Word.Word (S (S (S (S (S (S O)))))))

Arguments elements_total_fee_spec {alg}
### C.jet_elements_total_fee_literal.total_fee_literal_step
total_fee_literal_step =
fun (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (acc : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (o : jet_elements_prim.txOutput) =>
match jet_elements_prim.txoAsset o return (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) with
| jet_elements_prim.Explicit asset =>
    match jet_elements_prim.txoAmount o return (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) with
    | jet_elements_prim.Explicit v =>
        match
          Bit.toBool (jet_elements_fee_literal.fee_script_hash_test o)
          return (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
        with
        | true =>
            match
              Bit.toBool
                (@jet_equality_spec.equality_spec (Word.Word (S (S (S (S (S (S (S (S O))))))))) Alg.CoreFunSem
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) key (Word.from_hash256 asset)))
              return (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
            with
            | true =>
                @snd
                  (sum
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) Ty.Unit)
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) Ty.Unit))
                  (prod
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                            match n return Ty.Ty with
                            | O => X
                            | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                            end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                            match n return Ty.Ty with
                            | O => X
                            | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                            end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O))))))))
                  (@Word.adder (S (S (S (S (S (S O)))))) Alg.CoreFunSem
                     (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                        (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.unsigned v))
                        acc))
            | false => acc
            end
        | false => acc
        end
    | jet_elements_prim.Confidential _ _ => acc
    end
| jet_elements_prim.Confidential _ _ => acc
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (_ : jet_elements_prim.txOutput),
       Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))

Arguments total_fee_literal_step key acc o
### C.jet_elements_total_fee_literal.total_fee_literal_zero
total_fee_literal_zero =
@Word.zero (S (S (S (S (S (S O)))))) Alg.CoreFunSem tt
     : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))
### C.jet_elements_total_fee_literal.total_fee_literal_result
total_fee_literal_result =
fun (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (environment : jet_elements_prim.Elements.env) =>
@List.fold_left (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) jet_elements_prim.txOutput
  (total_fee_literal_step key) (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
  total_fee_literal_zero
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : jet_elements_prim.Elements.env),
       Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))

Arguments total_fee_literal_result key environment
