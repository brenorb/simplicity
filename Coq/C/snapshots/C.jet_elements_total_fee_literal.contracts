       @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (@jet_equality_spec.equality_spec (Ty.Sum L R) Alg.CoreFunSem
            (@pair
               (sum
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) L) (Ty.tySem R))
               (sum
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) L) (Ty.tySem R))
               (@inr
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) L) (Ty.tySem R) x)
               (@inr
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) L) (Ty.tySem R) y)))
         (@jet_equality_spec.equality_spec R Alg.CoreFunSem (@pair (Ty.tySem R) (Ty.tySem R) y x))
