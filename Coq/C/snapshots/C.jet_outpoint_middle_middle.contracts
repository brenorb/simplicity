### C.jet_outpoint_middle_middle.op_middle_then
op_middle_then
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (le' : Clight.temp_env)
         (m' : Memory.Mem.mem) (le'' : Clight.temp_env) (mf : Memory.Mem.mem) (rest : Clight.statement)
         (out : ClightBigstep.outcome)
         (_ : ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m
                jet_outpoint_middle_common.op_middle Events.E0 le' m' ClightBigstep.Out_normal)
         (_ : ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le' m' rest Events.E0 le'' mf out),
       ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m
         (Clight.Ssequence jet_outpoint_exec_shape.op_pegin
            (Clight.Ssequence
               (jet_outpoint_exec_shape.op_read
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (Clight.Ssequence
                  (jet_outpoint_exec_shape.op_absorb
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))) rest)))
         Events.E0 le'' mf out
