### C.jet_secp_odd_table_write.odd_table_write_source
odd_table_write_source
     : @eq Clight.statement odd_table_write_statement
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_ge_set_xy jets_secp.f_secp256k1_ge_set_xy
            (@None AST.ident)
            (@cons Clight.expr odd_table_entry_address
               (@cons Clight.expr (odd_table_local_address jets_secp._x)
                  (@cons Clight.expr (odd_table_local_address jets_secp._y) (@nil Clight.expr)))))
### C.jet_secp_odd_table_write.exec_odd_table_write
exec_odd_table_write
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (x y : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (br ba : Values.block)
         (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : not (@eq Values.block br ba))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ai e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_set_xy e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pre_a le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m odd_table_write_statement Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf br
                  (BinInt.Z.mul
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) i)
                  (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf br
                     (BinInt.Z.add
                        (BinInt.Z.mul
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           i)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf br
                           (BinInt.Z.add
                              (BinInt.Z.mul
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) i)
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                        (and
                           (jet_secp_fe_nv.fe_at mf ba
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 y))
                           (and
                              (Memory.Mem.range_perm mf br BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind)
                                    (p : Memtype.permission),
                                  iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p))
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (pos : BinNums.Z) =>
                                        or (not (@eq Values.block b br))
                                          (or
                                             (BinInt.Z.lt pos
                                                (BinInt.Z.mul
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) i))
                                             (BinInt.Z.le
                                                (BinInt.Z.add
                                                   (BinInt.Z.mul
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))
                                                      i)
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xI
                                                               (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                                pos))) m mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
### C.jet_secp_odd_table_write.odd_table_write_statement
odd_table_write_statement =
match
  @List.nth Clight.statement (S (S (S (S (S (S (S O)))))))
    (@fst (list Clight.statement) Clight.statement
       (jet_secp_statement_prefix.split_statement_last
          (Clight.fn_body jets_secp.f_secp256k1_ecmult_odd_multiples_table))) Clight.Sskip
  return Clight.statement
with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ _ => Clight.Sskip
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop s1 _ =>
        match s1 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ s4 =>
            match s4 return Clight.statement with
            | Clight.Sskip => Clight.Sskip
            | Clight.Sassign _ _ => Clight.Sskip
            | Clight.Sset _ _ => Clight.Sskip
            | Clight.Scall _ _ _ => Clight.Sskip
            | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
            | Clight.Ssequence _ writer => writer
            | Clight.Sifthenelse _ _ _ => Clight.Sskip
            | Clight.Sloop _ _ => Clight.Sskip
            | Clight.Sbreak => Clight.Sskip
            | Clight.Scontinue => Clight.Sskip
            | Clight.Sreturn _ => Clight.Sskip
            | Clight.Sswitch _ _ => Clight.Sskip
            | Clight.Slabel _ _ => Clight.Sskip
            | Clight.Sgoto _ => Clight.Sskip
            end
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_odd_table_write.odd_table_entry_address
odd_table_entry_address =
Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._pre_a (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type))
  (Clight.Etempvar jets_secp._i Ctypesdefs.tint) (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type)
     : Clight.expr
### C.jet_secp_odd_table_write.odd_table_local_address
odd_table_local_address =
fun fid : AST.ident =>
Clight.Eaddrof
  (Clight.Efield (Clight.Evar jets_secp._ai (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)) fid
     jet_secp_curve_statements.curve_fe_type) (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type)
     : forall _ : AST.ident, Clight.expr

Arguments odd_table_local_address fid
