### C.jet_secp_generator_sha_complete.generator_sha_block
generator_sha_block =
fun second : bool =>
@List.nth Clight.statement
  match second return nat with
  | true => S (S (S (S (S (S (S (S (S (S (S O))))))))))
  | false => S (S (S (S (S (S (S O))))))
  end
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal)))
  Clight.Sskip
     : forall _ : bool, Clight.statement

Arguments generator_sha_block second%bool_scope
### C.jet_secp_generator_sha_complete.generator_sha_regs
generator_sha_regs =
fun (second : bool) (key : list Integers.Int.int) =>
SHA256.hash_block jet_sha256_iv_init.sha256_iv_words
  (jet_sha_ctx8_model.be_words
     (@app Integers.Int.int (jet_secp_generator_sha_absorb.generator_sha_prefix_bytes second)
        (@app Integers.Int.int key
           (jet_sha_finalize_exec.sha_pad
              (Integers.Int64.repr
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
     : forall (_ : bool) (_ : list Integers.Int.int), SHA256.registers

Arguments generator_sha_regs second%bool_scope key%list_scope
