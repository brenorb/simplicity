        (Clight.Ederef
           (Clight.Etempvar jets_elements._env (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)))
           (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)) jets_elements._tx
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr))))
  (Clight.Ssequence
     (Clight.Sset jets_elements._t'7
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_elements._t'6
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr)))
              (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr)) jets_elements._input
