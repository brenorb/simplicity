### C.jet_elements_issuance_status_exec.issuance_status_compare_stmt
issuance_status_compare_stmt =
fun (temp : AST.ident) (ret : option AST.ident) (op : Cop.binary_operation) (k : Integers.Int.int) =>
Clight.Ssequence (Clight.Sset temp issuance_status_type_expr)
  (Clight.Scall ret
     (Clight.Evar jets_elements._writeBit
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Ebinop op (Clight.Econst_int k Ctypesdefs.tint) (Clight.Etempvar temp Ctypesdefs.tint)
              Ctypesdefs.tint) (@nil Clight.expr))))
     : forall (_ : AST.ident) (_ : option AST.ident) (_ : Cop.binary_operation) (_ : Integers.Int.int),
       Clight.statement

Arguments issuance_status_compare_stmt temp ret op k
### C.jet_elements_issuance_status_exec.issuance_status_payload_stmt
issuance_status_payload_stmt =
Clight.Ssequence
  (issuance_status_compare_stmt jets_elements._t'5 (@Some AST.ident jets_elements._t'2) Cop.One
     (Integers.Int.repr BinNums.Z0))
  (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'2 Ctypesdefs.tbool)
     (issuance_status_compare_stmt jets_elements._t'4 (@None AST.ident) Cop.Oeq
        (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
     (jet_elements_indexed_scalar.elements_skip_stmt (BinNums.Zpos BinNums.xH)))
     : Clight.statement
### C.jet_elements_issuance_status_exec.issuance_status_setup_stmt
issuance_status_setup_stmt =
