### C.jet_secp_rescale_entry.rescale_function_ok
rescale_function_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_secp256k1_gej_rescale) true
### C.jet_secp_rescale_entry.rescale_allocation_model
rescale_allocation_model
     : @eq (option (prod (list jet_sx_state.region) jet_sx_eval.venv))
         (jet_sx_mem.xalloc (jet_sx_mem.std_cells (Clight.genv_cenv jet_secp_linkage.secp_ge))
            (Clight.genv_cenv jet_secp_linkage.secp_ge) (Clight.fn_vars jets_secp.f_secp256k1_gej_rescale)
            (S (S O)))
         (@Some (prod (list jet_sx_state.region) jet_sx_eval.venv)
            (@pair (list jet_sx_state.region) jet_sx_eval.venv
               (@fst (list jet_sx_state.region) jet_sx_eval.venv jet_secp_rescale_prefix.rescale_allocated)
               (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_rescale_prefix.rescale_allocated)))
### C.jet_secp_rescale_entry.rescale_initial_regs
rescale_initial_regs
     : @eq (list jet_sx_state.region)
         (@app jet_sx_state.region rescale_input_regs
            (@fst (list jet_sx_state.region) jet_sx_eval.venv jet_secp_rescale_prefix.rescale_allocated))
         jet_secp_rescale_prefix.rescale_prefix_regs
### C.jet_secp_rescale_entry.rescale_binding_model
rescale_binding_model
     : @eq (option (Maps.PTree.t jet_sx_expr.sx))
         (jet_sx_mem.xbind (Clight.fn_params jets_secp.f_secp256k1_gej_rescale)
            (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
               (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx)))
            (Maps.PTree.empty jet_sx_expr.sx))
         (@Some (Maps.PTree.tree jet_sx_expr.sx) jet_secp_rescale_prefix.rescale_prefix_temps)
### C.jet_secp_rescale_entry.rescale_inputs_from_storage
rescale_inputs_from_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bp bs : Values.block)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bp bs)),
       jet_sx_state.rep rho
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) rescale_input_regs m
### C.jet_secp_rescale_entry.rescale_actual_entry
rescale_actual_entry
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta rescale_input_regs m),
       @ex (list (prod Values.block BinNums.Z))
         (fun betaN : list (prod Values.block BinNums.Z) =>
          @ex Clight.env
            (fun e : Clight.env =>
             @ex Clight.temp_env
               (fun le : Clight.temp_env =>
                @ex Memory.Mem.mem
                  (fun mi : Memory.Mem.mem =>
                   and
                     (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_gej_rescale
                        (@cons Values.val
                           (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                           (@cons Values.val
                              (Values.Vptr (jet_sx_state.blk beta (S O))
                                 (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O)))) (@nil Values.val))) m e le mi)
                     (and
                        (jet_sx_state.rep rho (@app (prod Values.block BinNums.Z) beta betaN)
                           jet_secp_rescale_prefix.rescale_prefix_regs mi)
                        (and
                           (jet_sx_eval.tmatch rho (@app (prod Values.block BinNums.Z) beta betaN)
                              jet_secp_rescale_prefix.rescale_prefix_temps le)
                           (and
                              (jet_sx_eval.ematch (@app (prod Values.block BinNums.Z) beta betaN)
                                 (@snd (list jet_sx_state.region) jet_sx_eval.venv
                                    jet_secp_rescale_prefix.rescale_allocated) e)
                              (and
                                 (@eq nat (@length (prod Values.block BinNums.Z) betaN)
                                    (@length jet_sx_state.region
                                       (@fst (list jet_sx_state.region) jet_sx_eval.venv
                                          jet_secp_rescale_prefix.rescale_allocated)))
                                 (and
                                    (@List.Forall (prod Values.block BinNums.Z)
                                       (fun p : prod Values.block BinNums.Z =>
                                        not (Memory.Mem.valid_block m (@fst Values.block BinNums.Z p))) betaN)
                                    (Memory.Mem.unchanged_on (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi))))))))))
### C.jet_secp_rescale_entry.rescale_prefix_point_outside
rescale_prefix_point_outside
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta jet_secp_rescale_prefix.rescale_prefix_regs m) (ofs : BinNums.Z),
       not
         (jet_sx_state.foot beta
            (@List.map jet_sx_state.region
               (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
               jet_secp_rescale_prefix.rescale_prefix_regs) (jet_sx_state.blk beta O) ofs)
### C.jet_secp_rescale_entry.rescale_prefix_point_frame
rescale_prefix_point_frame
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m mf : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta jet_secp_rescale_prefix.rescale_prefix_regs m)
         (_ : jet_sx_mem.lframe
                (fun (b : Values.block) (ofs : BinNums.Z) =>
                 not
                   (jet_sx_state.foot beta
                      (@List.map jet_sx_state.region
                         (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                         jet_sx_state.rshape jet_secp_rescale_prefix.rescale_prefix_regs) b ofs)) m mf),
       jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => @eq Values.block b (jet_sx_state.blk beta O)) m mf
### C.jet_secp_rescale_entry.rescale_input_regs
rescale_input_regs =
@cons jet_sx_state.region jet_secp_rescale_prefix.rescale_point_storage
  (@cons jet_sx_state.region
     (jet_secp_square_separate_layout.separate_input true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     (@nil jet_sx_state.region))
     : list jet_sx_state.region
