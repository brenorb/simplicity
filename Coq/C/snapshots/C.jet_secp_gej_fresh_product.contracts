### C.jet_secp_gej_fresh_product.gej_fresh_product_stmt
gej_fresh_product_stmt =
fun (y : bool) (dst point factor : AST.ident) =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address dst)
     (@cons Clight.expr
        (jet_secp_double_statements.double_point_address point
           match y return AST.ident with
           | true => jets_secp._y
           | false => jets_secp._x
           end) (@cons Clight.expr (jet_secp_curve_statements.curve_local_address factor) (@nil Clight.expr))))
     : forall (_ : bool) (_ : AST.ident) (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments gej_fresh_product_stmt y%bool_scope dst point factor
