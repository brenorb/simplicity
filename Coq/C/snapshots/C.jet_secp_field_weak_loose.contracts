### C.jet_secp_field_weak_loose.weak_loose_words_list
weak_loose_words_list
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int) (jet_secp_multiply_normalize_bridge.words5 (weak_loose_words w))
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_curve_weak.curve_weak_math_list (Integers.Int64.unsigned (w O))
               (Integers.Int64.unsigned (w (S O))) (Integers.Int64.unsigned (w (S (S O))))
               (Integers.Int64.unsigned (w (S (S (S O))))) (Integers.Int64.unsigned (w (S (S (S (S O))))))))
### C.jet_secp_field_weak_loose.weak_loose_numeric
weak_loose_numeric
     : forall (w : forall _ : nat, Integers.Int64.int)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (w i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       and
         (@eq BinNums.Z
            (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value (weak_loose_words w)) jet_secp_fe_math.feP)
            (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP))
         (jet_secp_field_mul_small.mul_small_input_bounds (weak_loose_words w))
### C.jet_secp_field_weak_loose.eval_field_weak_loose
eval_field_weak_loose
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (w i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_weak)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (weak_loose_words w)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (@eq BinNums.Z
                        (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value (weak_loose_words w))
                           jet_secp_fe_math.feP)
                        (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP))
                     (and (jet_secp_field_mul_small.mul_small_input_bounds (weak_loose_words w))
                        (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m
                           mf))))))
### C.jet_secp_field_weak_loose.negate_reader_words
negate_reader_words
     : forall value : BinNums.Z,
       @eq (list Integers.Int64.int)
         (jet_secp_field_negate_storage.negate_values (jet_secp_write_fe_numeric.write_fe_rho value BinNums.Z0))
         (jet_secp_multiply_normalize_bridge.words5
            (jet_secp_field_negate_separate.negate_sep_words (jet_secp_b32_exec.limb_rho value)))
### C.jet_secp_field_weak_loose.negate_reader_loose_bound
negate_reader_loose_bound
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (i : nat) (_ : lt i (S (S (S (S (S O)))))),
       BinInt.Z.le
         (Integers.Int64.unsigned
            (jet_secp_field_negate_separate.negate_sep_words (jet_secp_b32_exec.limb_rho value) i))
         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
### C.jet_secp_field_weak_loose.weak_loose_words
weak_loose_words =
fun (w : forall _ : nat, Integers.Int64.int) (i : nat) =>
Integers.Int64.repr
  (@List.nth BinNums.Z i
     (jet_secp_curve_weak.curve_weak_math_list (Integers.Int64.unsigned (w O)) (Integers.Int64.unsigned (w (S O)))
        (Integers.Int64.unsigned (w (S (S O)))) (Integers.Int64.unsigned (w (S (S (S O)))))
        (Integers.Int64.unsigned (w (S (S (S (S O))))))) BinNums.Z0)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments weak_loose_words w%function_scope i%nat_scope
