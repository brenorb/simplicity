### C.jet_secp_x_equiv_statements.eval_x_equiv_z_address
eval_x_equiv_z_address
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bp : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m x_equiv_z_address
         (Values.Vptr bp
