### C.jet_secp_x_equiv_statements.x_equiv_equal_stmt
x_equiv_equal_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_equal_var jets_secp.f_secp256k1_fe_equal_var
  (@Some AST.ident jets_secp._t'1)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._r)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._r2) (@nil Clight.expr)))
