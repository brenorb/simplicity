### C.jet_secp_x_equiv_statements.x_equiv_weak_stmt
x_equiv_weak_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_normalize_weak jets_secp.f_secp256k1_fe_normalize_weak
  (@None AST.ident)
