### C.jet_secp_x_equiv_statements.x_equiv_helper_stmt
x_equiv_helper_stmt =
Clight.Ssequence (Clight.Sloop Clight.Sskip Clight.Sbreak)
  (Clight.Ssequence x_equiv_square_stmt
     (Clight.Ssequence x_equiv_multiply_stmt
        (Clight.Ssequence jet_secp_x_equiv_copy.x_equiv_copy_stmt
           (Clight.Ssequence x_equiv_weak_stmt
              (Clight.Ssequence x_equiv_equal_stmt
                 (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tint))))))))
     : Clight.statement
