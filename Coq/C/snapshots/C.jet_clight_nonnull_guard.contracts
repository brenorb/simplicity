### C.jet_clight_nonnull_guard.exec_nonnull_return_zero
exec_nonnull_return_zero
     : forall (ge : Clight.genv) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (id : BinNums.positive) (ty : Ctypes.type) (b : Values.block) (ofs : Integers.Ptrofs.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le) (@Some Values.val (Values.Vptr b ofs)))
         (_ : @eq bool (Memory.Mem.weak_valid_pointer m b (Integers.Ptrofs.unsigned ofs)) true),
       ClightBigstep.Clight2.exec_stmt ge e le m (nonnull_return_zero id ty) Events.E0 le m ClightBigstep.Out_normal
