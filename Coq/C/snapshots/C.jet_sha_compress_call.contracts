### C.jet_sha_compress_call.mext_refl
mext_refl
     : forall m : Memory.Mem.mem, mext m m
### C.jet_sha_compress_call.mext_trans
mext_trans
     : forall (m1 m2 m3 : Memory.Mem.mem) (_ : mext m1 m2) (_ : mext m2 m3), mext m1 m3
### C.jet_sha_compress_call.mext_alloc
mext_alloc
     : forall (m : Memory.Mem.mem) (lo hi : BinNums.Z) (m' : Memory.Mem.mem') (b : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m lo hi)
                (@pair Memory.Mem.mem' Values.block m' b)), mext m m'
### C.jet_sha_compress_call.alloc4_access
alloc4_access
     : forall (m : Memory.Mem.mem) (m' : Memory.Mem.mem') (b : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                (@pair Memory.Mem.mem' Values.block m' b)),
       and (Memory.Mem.valid_access m' AST.Mint32 b BinNums.Z0 Memtype.Freeable)
         (and (not (Memory.Mem.valid_block m b))
            (and (Memory.Mem.valid_block m' b)
               (Memory.Mem.range_perm m' b BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) Memtype.Cur
                  Memtype.Freeable)))
### C.jet_sha_compress_call.free_list_blocks
free_list_blocks
     : forall (l : list (prod (prod Values.block BinNums.Z) BinNums.Z)) (m : Memory.Mem.mem)
         (_ : forall (b : Values.block) (lo hi : BinNums.Z)
                (_ : @List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                       (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z b lo) hi) l),
              Memory.Mem.range_perm m b lo hi Memtype.Cur Memtype.Freeable)
         (_ : @List.NoDup Values.block
                (@List.map (prod (prod Values.block BinNums.Z) BinNums.Z) Values.block
                   (fun x : prod (prod Values.block BinNums.Z) BinNums.Z =>
                    @fst Values.block BinNums.Z (@fst (prod Values.block BinNums.Z) BinNums.Z x)) l)),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and (@eq (option Memory.Mem.mem) (Memory.Mem.free_list m l) (@Some Memory.Mem.mem m'))
            (and
               (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                  (_ : not
                         (@List.In Values.block b
                            (@List.map (prod (prod Values.block BinNums.Z) BinNums.Z) Values.block
                               (fun x : prod (prod Values.block BinNums.Z) BinNums.Z =>
                                @fst Values.block BinNums.Z (@fst (prod Values.block BinNums.Z) BinNums.Z x)) l))),
                @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
               (and
                  (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                     (_ : not
                            (@List.In Values.block b
                               (@List.map (prod (prod Values.block BinNums.Z) BinNums.Z) Values.block
                                  (fun x : prod (prod Values.block BinNums.Z) BinNums.Z =>
                                   @fst Values.block BinNums.Z (@fst (prod Values.block BinNums.Z) BinNums.Z x)) l)))
                     (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                  (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b))))
### C.jet_sha_compress_call.eval_sha_compression
eval_sha_compression
     : forall (m : Memory.Mem.mem) (bs : Values.block) (os : Integers.Ptrofs.int) (bc : Values.block)
         (oc : Integers.Ptrofs.int) (regs blk : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq nat (@length Integers.Int.int blk) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : or (not (@eq Values.block bs bc))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (Integers.Ptrofs.unsigned oc))
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (Integers.Ptrofs.unsigned os))))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
              and
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint32 m bs
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                   (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
                (Memory.Mem.valid_access m AST.Mint32 bs
                   (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                   Memtype.Writable))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bc
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i blk Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_sha.f_sha256_compression_portable)
               (@cons Values.val (Values.Vptr bs os) (@cons Values.val (Values.Vptr bc oc) (@nil Values.val)))
               Events.E0 m' Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 m' bs
                     (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                  (@Some Values.val
                     (Values.Vint (@List.nth Integers.Int.int i (SHA256.hash_block regs blk) Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : or (not (@eq Values.block b bs))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) (Integers.Ptrofs.unsigned os))
                               (BinInt.Z.le
                                  (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
### C.jet_sha_compress_call.mext
mext =
fun m m' : Memory.Mem.mem =>
and (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)
  (and
     (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b),
      @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
     (and
        (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
           (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
        (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (p : Memtype.permission)
           (_ : Memory.Mem.valid_access m ch b ofs p), Memory.Mem.valid_access m' ch b ofs p)))
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments mext m m'
### C.jet_sha_compress_call.sha_locals_env
sha_locals_env =
fun ba bb bc0 bd be bf bg bh : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._h (@pair Values.block Ctypes.type bh Ctypesdefs.tuint)
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._g (@pair Values.block Ctypes.type bg Ctypesdefs.tuint)
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._f (@pair Values.block Ctypes.type bf Ctypesdefs.tuint)
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._e
           (@pair Values.block Ctypes.type be Ctypesdefs.tuint)
           (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._d
              (@pair Values.block Ctypes.type bd Ctypesdefs.tuint)
              (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._c
                 (@pair Values.block Ctypes.type bc0 Ctypesdefs.tuint)
                 (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._b
                    (@pair Values.block Ctypes.type bb Ctypesdefs.tuint)
                    (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._a
                       (@pair Values.block Ctypes.type ba Ctypesdefs.tuint) Clight.empty_env)))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments sha_locals_env ba bb bc0 bd be bf bg bh
