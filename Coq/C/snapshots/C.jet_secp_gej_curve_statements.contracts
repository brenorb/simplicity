### C.jet_secp_gej_curve_statements.gej_curve_helper_stmt
gej_curve_helper_stmt =
@List.fold_right Clight.statement Clight.statement Clight.Ssequence
  (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tint)))
  (@cons Clight.statement (gej_curve_square_stmt jets_secp._y2 jets_secp._y)
     (@cons Clight.statement (gej_curve_square_stmt jets_secp._x3 jets_secp._x)
        (@cons Clight.statement (gej_curve_mul_stmt jets_secp._x3 jets_secp._x)
           (@cons Clight.statement (gej_curve_square_stmt jets_secp._z6 jets_secp._z)
