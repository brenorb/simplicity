                 (@cons Clight.statement gej_curve_square_z_stmt
                    (@cons Clight.statement gej_curve_mul7_stmt
                       (@cons Clight.statement gej_curve_add_stmt
                          (@cons Clight.statement jet_secp_curve_statements.curve_equal_statement
                             (@nil Clight.statement))))))))))
     : Clight.statement
