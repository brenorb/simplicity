     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x3
        (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type) Clight.empty_env))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

