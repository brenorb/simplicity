### C.jet_elements_sha_program.mkprogram_eq
mkprogram_eq
     : forall (c1 c2 : list Ctypes.composite_definition)
         (d1 d2 : list (prod AST.ident (AST.globdef Clight.fundef Ctypes.type))) (p1 p2 : list AST.ident)
         (m1 m2 : AST.ident) (W1 : Clightdefs.wf_composites c1) (W2 : Clightdefs.wf_composites c2)
         (_ : @eq (list Ctypes.composite_definition) c1 c2)
         (_ : @eq (list (prod AST.ident (AST.globdef Clight.fundef Ctypes.type))) d1 d2)
         (_ : @eq (list AST.ident) p1 p2) (_ : @eq AST.ident m1 m2),
       @eq Clight.program (Clightdefs.mkprogram c1 d1 p1 m1 W1) (Clightdefs.mkprogram c2 d2 p2 m2 W2)
### C.jet_elements_sha_program.elements_sha_program
elements_sha_program
     : @eq Clight.program jets_elements.prog jets_elements.prog
### C.jet_elements_sha_program.elements_sha_genv
elements_sha_genv
     : @eq Clight.genv jet_elements_support_sha_linkage.sha_ge jet_elements_linkage.elements_ge
