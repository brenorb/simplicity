### C.jet_elements_env_tx_calls.mt_call_hash
mt_call_hash
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m m' : Memory.Mem.mem) (id : AST.ident) (bx : Values.block) (a2 : Clight.expr) (bt : Values.block)
         (ot : Integers.Ptrofs.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_hash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))))
         (_ : Clight.eval_expr jet_elements_support_sha_linkage.sha_ge e le m a2 (Values.Vptr bt ot))
         (_ : @eq Ctypes.type (Clight.typeof a2)
                (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
                (@Ctypes.Internal Clight.function jets_elements.f_sha256_hash)
                (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr BinNums.Z0))
                   (@cons Values.val (Values.Vptr bt ot) (@nil Values.val))) Events.E0 m' Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m
         (Clight.Scall (@None AST.ident)
            (Clight.Evar jets_elements._sha256_hash
               (Ctypes.Tfunction
                  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
                     (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
                        Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
            (@cons Clight.expr
               (Clight.Eaddrof (Clight.Evar id (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
               (@cons Clight.expr a2 (@nil Clight.expr)))) Events.E0 le m' ClightBigstep.Out_normal
