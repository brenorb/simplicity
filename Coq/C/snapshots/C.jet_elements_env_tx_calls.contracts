### C.jet_elements_env_tx_calls.sha_u32be_symbol
sha_u32be_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
            (Clight.genv_genv jet_elements_support_sha_linkage.sha_ge) jets_elements._sha256_u32be)
         (@Some Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_u32be))
### C.jet_elements_env_tx_calls.sha_u32be_funct
sha_u32be_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
            (Clight.genv_genv jet_elements_support_sha_linkage.sha_ge)
            (Values.Vptr (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_u32be)
               Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_elements.f_sha256_u32be))
