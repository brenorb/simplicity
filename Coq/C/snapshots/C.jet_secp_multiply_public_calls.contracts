### C.jet_secp_multiply_public_calls.exec_read_call
exec_read_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (id : BinNums.positive) (b bl : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b jet_secp_multiply_public_layout.field_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._src e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bl jet_secp_multiply_public_layout.frame_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._read_fe e)
                (@None (prod Values.block Ctypes.type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (jet_secp_multiply_public_layout.read_stmt id)
         Events.E0 le mf ClightBigstep.Out_normal
