### C.jet_secp_reduce512_final_checkpoint.third_checkpoint_limb_value
third_checkpoint_limb_value
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value (third_checkpoint_digits digits p4))
         (jet_secp_scalar_mul512_accumulate.column_words_value
            (jet_secp_reduce512_third_atomic.third_machine_outputs digits p4))
### C.jet_secp_reduce512_final_checkpoint.third_checkpoint_value
third_checkpoint_value
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned p4) (BinNums.Zpos (BinNums.xO BinNums.xH))),
       @eq BinNums.Z
         (jet_secp_reduce512_final_value.final_untruncated (third_checkpoint_digits digits p4)
            (third_checkpoint_c digits p4)) (jet_secp_reduce512_third_value.third_fold_value digits p4)
### C.jet_secp_reduce512_final_checkpoint.third_checkpoint_final_numeric
third_checkpoint_final_numeric
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (_ : BinInt.Z.le (Integers.Int.unsigned p4) (BinNums.Zpos (BinNums.xO BinNums.xH))),
       @eq BinNums.Z
         (jet_secp_reduce512_final_atomic.final_output_value (third_checkpoint_digits digits p4)
            (third_checkpoint_c digits p4) rho beta)
         (BinInt.Z.modulo (jet_secp_reduce512_third_value.third_fold_value digits p4)
            jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_reduce512_final_checkpoint.third_checkpoint_forget_stack
third_checkpoint_forget_stack
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq (list jet_sx_state.region)
         (jet_sx_forget_cells.forget_after (S (S O))
            (jet_sx_eval.sregs (jet_secp_reduce512_third_stage.reduce512_third_state digits p4)))
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg
               (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_reduce512_third_stage.reduce512_third_limbs digits p4)) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@app jet_sx_state.region
               (@List.tl jet_sx_state.region jet_secp_scalar_reduce512_run.scalar_reduce512_initial_regs)
               (@fst (list jet_sx_state.region) jet_sx_eval.venv jet_secp_reduce512_typed_stage.reduce512_allocated)))
### C.jet_secp_reduce512_final_checkpoint.third_checkpoint_param_sources
third_checkpoint_param_sources
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       and
         (@eq (option jet_sx_expr.sx)
            (@Maps.PTree.get jet_sx_expr.sx jets_secp._r
               (jet_sx_eval.stemps (jet_secp_reduce512_third_stage.reduce512_third_state digits p4)))
            (@Some jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)))
         (@eq (option jet_sx_expr.sx)
            (@Maps.PTree.get jet_sx_expr.sx jets_secp._l
               (jet_sx_eval.stemps (jet_secp_reduce512_third_stage.reduce512_third_state digits p4)))
            (@Some jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0)))
### C.jet_secp_reduce512_final_checkpoint.third_checkpoint_rep
third_checkpoint_rep
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta
                (jet_sx_eval.sregs (jet_secp_reduce512_third_stage.reduce512_third_state digits p4)) m),
       jet_sx_state.rep rho beta
         (jet_secp_reduce512_final_stage.reduce512_final_regs (third_checkpoint_digits digits p4)) m
### C.jet_secp_reduce512_final_checkpoint.third_checkpoint_tmatch
third_checkpoint_tmatch
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (le : Clight.temp_env)
         (_ : jet_sx_eval.tmatch rho beta
                (jet_sx_eval.stemps (jet_secp_reduce512_third_stage.reduce512_third_state digits p4)) le),
       jet_sx_eval.tmatch rho beta
         (jet_secp_reduce512_final_stage.reduce512_final_temps (third_checkpoint_c digits p4)) le
### C.jet_secp_reduce512_final_checkpoint.third_checkpoint_digits
third_checkpoint_digits =
fun (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int) (n : nat) =>
match n return Integers.Int64.int with
| O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_third_atomic.third_ma0 digits p4)
| S n0 =>
    match n0 return Integers.Int64.int with
    | O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_third_atomic.third_ma1 digits p4)
    | S n1 =>
        match n1 return Integers.Int64.int with
        | O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_third_atomic.third_ma2 digits p4)
        | S n2 =>
            match n2 return Integers.Int64.int with
            | O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_third_atomic.third_ma3 digits p4)
            | S _ => Integers.Int64.zero
            end
        end
    end
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int.int) (_ : nat), Integers.Int64.int

Arguments third_checkpoint_digits digits%function_scope p4 n%nat_scope
### C.jet_secp_reduce512_final_checkpoint.third_checkpoint_c
third_checkpoint_c =
fun (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int) =>
jet_secp_reduce512_wide.whi (jet_secp_reduce512_third_atomic.third_ma3 digits p4)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int.int), Integers.Int64.int

Arguments third_checkpoint_c digits%function_scope p4
