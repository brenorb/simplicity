### C.jet_secp_decompress_function.decompress_helper_env
decompress_helper_env =
fun b2 b3 : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x3
  (@pair Values.block Ctypes.type b3 jet_secp_curve_statements.curve_fe_type)
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x2
     (@pair Values.block Ctypes.type b2 jet_secp_curve_statements.curve_fe_type) Clight.empty_env)
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments decompress_helper_env b2 b3
### C.jet_secp_decompress_function.decompress_helper_temps
decompress_helper_temps =
fun (bx br : Values.block) (odd : bool) =>
@Maps.PTree.set Values.val jets_secp._odd
  (Values.Vint match odd return Integers.Int.int with
               | true => Integers.Int.one
               | false => Integers.Int.zero
               end)
  (@Maps.PTree.set Values.val jets_secp._x (Values.Vptr bx Integers.Ptrofs.zero)
     (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr br Integers.Ptrofs.zero)
        (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_ge_set_xo_var))))
     : forall (_ : Values.block) (_ : Values.block) (_ : bool), Maps.PTree.tree Values.val

