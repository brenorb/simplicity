       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@jet_sha256_ctx8_init_spec.AC.drop A B C
            (Alg.Assertion.toCore
               (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                  (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                     Option.option_Monad_Zero))) t p e)
         (t
            (@snd
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
