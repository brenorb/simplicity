                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) A)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) B) p) e)
### C.jet_sha_hash_loop.fx_iden
@fx_iden
     : forall (A : Ty.Ty) (a : Ty.tySem A) (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem A))
         (@jet_sha256_ctx8_init_spec.AC.iden A
            (Alg.Assertion.toCore
               (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                  (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                     Option.option_Monad_Zero))) a e) (@Some (Ty.tySem A) a)
### C.jet_sha_hash_loop.fx_case
@fx_case
     : forall (A B C D : Ty.Ty)
         (s : Alg.Core.domain
                (Alg.Assertion.toCore
                   (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                      (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                         Option.option_Monad_Zero))) (Ty.Prod A C) D)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                      (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                         Option.option_Monad_Zero))) (Ty.Prod B C) D) (p : Ty.tySem (Ty.Prod (Ty.Sum A B) C))
         (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem D))
         (@jet_sha256_ctx8_init_spec.AC.case A B C D
            (Alg.Assertion.toCore
               (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                  (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                     Option.option_Monad_Zero))) s t p e)
         match
           @fst
             (sum
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) A)
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) B))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                 | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                 end) C) p
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem D))
         with
         | inl a =>
             s
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) A)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C) a
                  (@snd
                     (sum
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) A)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) B))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                         | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                         end) C) p)) e
         | inr b =>
             t
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C) b
                  (@snd
                     (sum
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) A)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) B))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                         | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                         end) C) p)) e
         end
### C.jet_sha_hash_loop.fx_injl
@fx_injl
     : forall (A B C : Ty.Ty)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                      (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                         Option.option_Monad_Zero))) A B) (a : Ty.tySem A) (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum B C)))
         (@jet_sha256_ctx8_init_spec.AC.injl A B C
            (Alg.Assertion.toCore
               (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                  (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                     Option.option_Monad_Zero))) t a e)
         match
           t a e
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum B C)))
         with
         | Some b =>
             @Some
               (sum (Ty.tySem B)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C))
               (@inl (Ty.tySem B)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C) b)
         | None => @None (Ty.tySem (Ty.Sum B C))
         end
### C.jet_sha_hash_loop.fx_injr
@fx_injr
     : forall (A B C : Ty.Ty)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                      (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                         Option.option_Monad_Zero))) A C) (a : Ty.tySem A) (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum B C)))
         (@jet_sha256_ctx8_init_spec.AC.injr A B C
            (Alg.Assertion.toCore
               (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                  (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                     Option.option_Monad_Zero))) t a e)
         match
           t a e
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum B C)))
         with
         | Some b =>
             @Some
               (sum
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B) (Ty.tySem C))
               (@inr
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B) (Ty.tySem C) b)
         | None => @None (Ty.tySem (Ty.Sum B C))
         end
### C.jet_sha_hash_loop.fx_copair_iden
@fx_copair_iden
     : forall (A : Ty.Ty) (x : Ty.tySem (Ty.Sum A A)) (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem A))
         (@jet_sha256_ctx8_init_spec.AC.copair A A A
            (Alg.Assertion.toCore
               (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                  (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                     Option.option_Monad_Zero)))
            (@jet_sha256_ctx8_init_spec.AC.iden A
               (Alg.Assertion.toCore
                  (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                     (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                        Option.option_Monad_Zero))))
            (@jet_sha256_ctx8_init_spec.AC.iden A
               (Alg.Assertion.toCore
                  (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                     (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                        Option.option_Monad_Zero)))) x e)
         (@Some
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                end) A)
            match
              x
              return
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                    | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                    end) A)
            with
            | inl a => a
            | inr a => a
            end)
### C.jet_sha_hash_loop.hash_loop_body_sem
hash_loop_body_sem
     : forall (k : nat) (C W : Ty.Ty)
         (array : Alg.Assertion.domain
                    (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                       (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                          Option.option_Monad_Zero)) (Ty.Prod C W)
                    (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) (cw : Ty.tySem (Ty.Prod C W))
         (ctx : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
         (@hash_loop_body k
            (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
               (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))
            C W array (@pair (Ty.tySem (Ty.Prod C W)) (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cw ctx) e)
         match
           array cw e
           return
             (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                (Ty.tySem
                   (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
         with
         | Some t =>
             match
               t
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                    (Ty.tySem
                       (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
             with
             | inl _ =>
                 @Some
                   (sum (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
                      (prod
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                   (@inl (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
                      (prod
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) ctx)
             | inr x =>
                 match
                   jet_sha_ctx8_spec.ctx8_add_list ctx (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) k x)
                   return
                     (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                        (Ty.tySem
                           (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type
                              jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
                 with
                 | Some c' =>
                     @Some
                       (sum
                          (prod
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A B => sum (tySem A) (tySem B)
                                 | Ty.Prod A B => prod (tySem A) (tySem B)
                                 end)
                                (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                             (prod
                                ((fix tySem (X : Ty.Ty) : Set :=
                                    match X return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S O))))))))
                                ((fix tySem (X : Ty.Ty) : Set :=
                                    match X return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                          (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                       (@inr
                          (prod
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A B => sum (tySem A) (tySem B)
                                 | Ty.Prod A B => prod (tySem A) (tySem B)
                                 end)
                                (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                             (prod
                                ((fix tySem (X : Ty.Ty) : Set :=
                                    match X return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S O))))))))
                                ((fix tySem (X : Ty.Ty) : Set :=
                                    match X return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                          (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) c')
                 | None =>
                     @None
                       (Ty.tySem
                          (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                 end
             end
         | None =>
             @None
               (Ty.tySem (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         end
### C.jet_sha_hash_loop.firstn_snoc
@firstn_snoc
     : forall (A : Type) (l : list A) (n : nat) (x : A) (_ : @eq (option A) (@List.nth_error A l n) (@Some A x)),
       @eq (list A) (@List.firstn A (S n) l) (@app A (@List.firstn A n l) (@cons A x (@nil A)))
### C.jet_sha_hash_loop.loop_bytes_app
loop_bytes_app
     : forall (k : nat) (l1 l2 : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))),
       @eq (list (Ty.tySem (Word.Word (S (S (S O))))))
         (loop_bytes k (@app (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) l1 l2))
         (@app (Ty.tySem (Word.Word (S (S (S O))))) (loop_bytes k l1) (loop_bytes k l2))
### C.jet_sha_hash_loop.loop_prefix_some
loop_prefix_some
     : forall (k w : nat) (ctx0 : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
         (cf : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (jet_sha_ctx8_spec.ctx8_add_list ctx0
                   (loop_bytes k
                      (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                         (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)))
                (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cf)) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i
                   (BinInt.Z.of_nat
                      (@length (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                         (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                            (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs))))),
       @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (jet_sha_ctx8_spec.ctx8_add_list ctx0
            (loop_bytes k (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (BinInt.Z.to_nat i) xs)))
         (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            match
              jet_sha_ctx8_spec.ctx8_add_list ctx0
                (loop_bytes k
                   (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (BinInt.Z.to_nat i) xs))
              return (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            with
            | Some c' => c'
            | None => ctx0
            end)
### C.jet_sha_hash_loop.loop_step
loop_step
     : forall (k w : nat) (ctx0 : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
         (cf : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (jet_sha_ctx8_spec.ctx8_add_list ctx0
                   (loop_bytes k
                      (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                         (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)))
                (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cf)) (i : BinNums.Z)
         (x : Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinInt.Z.of_nat
                      (@length (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                         (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                            (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)))))
         (_ : @eq (option (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                (@List.nth_error (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) xs (BinInt.Z.to_nat i))
                (@Some (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) x)),
       @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (jet_sha_ctx8_spec.ctx8_add_list
            match
              jet_sha_ctx8_spec.ctx8_add_list ctx0
                (loop_bytes k
                   (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (BinInt.Z.to_nat i) xs))
              return (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            with
            | Some c' => c'
            | None => ctx0
            end (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) k x))
         (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            match
              jet_sha_ctx8_spec.ctx8_add_list ctx0
                (loop_bytes k
                   (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                      (BinInt.Z.to_nat (BinInt.Z.add i (BinNums.Zpos BinNums.xH))) xs))
              return (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            with
            | Some c' => c'
            | None => ctx0
            end)
### C.jet_sha_hash_loop.loop_items_length
loop_items_length
     : forall (k w : nat) (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))),
       @eq nat
         (@length (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
            (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
               (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs))
         (PeanoNat.Nat.min (BinInt.Z.to_nat (jet_forWhile_seq.wsize w))
            (@length (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) xs))
### C.jet_sha_hash_loop.hash_loop_sem
hash_loop_sem
     : forall (k w : nat) (C : Ty.Ty)
         (array : Alg.Assertion.domain
                    (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                       (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                          Option.option_Monad_Zero)) (Ty.Prod C (Word.Word w))
                    (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) (c : Ty.tySem C)
         (ctx0 : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (e : jet_bitcoin_ext_prim.ext_environment)
         (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
         (_ : forall
                i : (fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word w),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                   (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (array
                   (@pair (Ty.tySem C)
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word w)) c i) e)
                (@Some (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) xs
                       (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x => @inr unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None => @inl unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end)) (cf : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (jet_sha_ctx8_spec.ctx8_add_list ctx0
                   (loop_bytes k
                      (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                         (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)))
                (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cf)),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (@hash_loop_spec k w
            (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
               (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))
            C array (@pair (Ty.tySem C) (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) c ctx0) e)
         (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cf)
### C.jet_sha_hash_loop.hash_loop_body
hash_loop_body =
fun (k : nat) (term : Alg.Assertion.Algebra) (C W : Ty.Ty)
  (array : Alg.Assertion.domain term (Ty.Prod C W) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type) core
  (@jet_sha256_ctx8_init_spec.AC.pair (Ty.Prod (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
     (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) jet_sha256_ctx8_init_spec.sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.take (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type
        (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) core array)
     (@jet_sha256_ctx8_init_spec.AC.drop (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type
        jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core)))
  (@jet_sha256_ctx8_init_spec.AC.case Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)
     jet_sha256_ctx8_init_spec.sha256_ctx8_type
     (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type) core
     (@jet_sha256_ctx8_init_spec.AC.injl (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type)
        jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.drop Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
           jet_sha256_ctx8_init_spec.sha256_ctx8_type core
           (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core)))
     (@jet_sha256_ctx8_init_spec.AC.injr
        (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) k) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
        jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.comp
           (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) k) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k))
           jet_sha256_ctx8_init_spec.sha256_ctx8_type core
           (@jet_sha256_ctx8_init_spec.AC.pair
              (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) k) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k) core
              (@jet_sha256_ctx8_init_spec.AC.drop (Word.Vector (Word.Word (S (S (S O)))) k)
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                 (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core))
              (@jet_sha256_ctx8_init_spec.AC.take (Word.Vector (Word.Word (S (S (S O)))) k)
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k) core
                 (@jet_sha256_ctx8_init_spec.AC.iden (Word.Vector (Word.Word (S (S (S O)))) k) core)))
           (@jet_sha_ctx8_spec.ctx8_addn_spec k term))))
     : forall (k : nat) (term : Alg.Assertion.Algebra) (C W : Ty.Ty)
         (_ : Alg.Assertion.domain term (Ty.Prod C W) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))),
       Alg.Assertion.domain term (Ty.Prod (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)

Arguments hash_loop_body k%nat_scope {term} {C W}%ty_scope array
### C.jet_sha_hash_loop.hash_loop_spec
hash_loop_spec =
fun (k w : nat) (term : Alg.Assertion.Algebra) (C : Ty.Ty)
  (array : Alg.Assertion.domain term (Ty.Prod C (Word.Word w))
             (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod C jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  jet_sha256_ctx8_init_spec.sha256_ctx8_type core
  (@jet_forWhile_spec.for_while_program w C jet_sha256_ctx8_init_spec.sha256_ctx8_type
     jet_sha256_ctx8_init_spec.sha256_ctx8_type core (@hash_loop_body k term C (Word.Word w) array))
  (@jet_sha256_ctx8_init_spec.AC.copair jet_sha256_ctx8_init_spec.sha256_ctx8_type
     jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core)
     (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core))
     : forall (k w : nat) (term : Alg.Assertion.Algebra) (C : Ty.Ty)
         (_ : Alg.Assertion.domain term (Ty.Prod C (Word.Word w))
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))),
       Alg.Assertion.domain term (Ty.Prod C jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         jet_sha256_ctx8_init_spec.sha256_ctx8_type

Arguments hash_loop_spec (k w)%nat_scope {term} {C}%ty_scope array
### C.jet_sha_hash_loop.loop_bytes
loop_bytes =
fun (k : nat) (l : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))) =>
@List.concat (Ty.tySem (Word.Word (S (S (S O)))))
  (@List.map (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (list (Ty.tySem (Word.Word (S (S (S O))))))
     (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) k) l)
     : forall (k : nat) (_ : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))),
       list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments loop_bytes k%nat_scope l%list_scope
