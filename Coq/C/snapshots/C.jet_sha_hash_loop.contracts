### C.jet_sha_hash_loop.hash_loop_spec_parametric
hash_loop_spec_parametric
     : forall (k w : nat) (C : Ty.Ty) (alg1 alg2 : Alg.Assertion.Algebra) (R : Alg.Assertion.Parametric.Rel alg1 alg2)
         (a1 : Alg.Assertion.domain alg1 (Ty.Prod C (Word.Word w))
                 (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (a2 : Alg.Assertion.domain alg2 (Ty.Prod C (Word.Word w))
                 (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (_ : @Alg.Assertion.Parametric.rel alg1 alg2 R (Ty.Prod C (Word.Word w))
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) a1 a2),
       @Alg.Assertion.Parametric.rel alg1 alg2 R (Ty.Prod C jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         jet_sha256_ctx8_init_spec.sha256_ctx8_type (@hash_loop_spec k w alg1 C a1) (@hash_loop_spec k w alg2 C a2)
### C.jet_sha_hash_loop.fx_take
@fx_take
     : forall (A B C : Ty.Ty)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                      (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                         Option.option_Monad_Zero))) A C) (p : Ty.tySem (Ty.Prod A B))
         (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@jet_sha256_ctx8_init_spec.AC.take A B C
            (Alg.Assertion.toCore
               (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                  (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                     Option.option_Monad_Zero))) t p e)
         (t
            (@fst
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) A)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) B) p) e)
### C.jet_sha_hash_loop.fx_drop
@fx_drop
     : forall (A B C : Ty.Ty)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                      (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
