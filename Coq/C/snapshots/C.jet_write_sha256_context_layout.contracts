### C.jet_write_sha256_context_layout.word32_array_decode
word32_array_decode
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
            (Integers.Int.unsigned (jet_read32s_layout.word32_array_value x))) x
### C.jet_write_sha256_context_layout.uint32_word_cells_encode
uint32_word_cells_encode
     : forall xs : list (Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq (list BitMachine.Cell)
         (jet_write32s_layout.uint32_word_cells
            (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int
               jet_read32s_layout.word32_array_value xs))
         (@List.concat BitMachine.Cell
            (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (list BitMachine.Cell)
               (@Translate.encode (Word.Word (S (S (S (S (S O))))))) xs))
### C.jet_write_sha256_context_layout.eval_write_sha256_context_layout
eval_write_sha256_context_layout
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (bc : Values.block) (cbase : BinNums.Z) (bi : Values.block)
         (input : BinNums.Z) (counter : Integers.Int64.int) (overflow : bool)
         (buf : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
         (state : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : BinInt.Z.le BinNums.Z0 cbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le
                (BinInt.Z.add input
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bc bf)) (_ : not (@eq Values.block bc bw))
         (_ : not (@eq Values.block bi bf)) (_ : not (@eq Values.block bi bw))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bc
                   (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong counter)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bc cbase)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinInt.Z.add cbase
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int overflow))))
         (_ : jet_read8s_layout.uint8_array_at m bc
                (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
                   (jet_buffer_chunks.byte_chunks_values
                      (jet_buffer_input.buffer_byte_chunks (S (S (S (S (S O))))) buf))))
         (_ : @eq Integers.Int64.int
                (Integers.Int64.modu counter
                   (Integers.Int64.repr
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (Integers.Int64.repr
                   (BinInt.Z.of_nat
                      (@length (Ty.tySem (Word.Word (S (S (S O)))))
                         (jet_buffer_chunks.byte_chunks_values
                            (jet_buffer_input.buffer_byte_chunks (S (S (S (S (S O))))) buf))))))
         (_ : jet_uint32_array_init.uint32_array_at m bi input
                (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int
                   jet_read32s_layout.word32_array_value (jet_word32_chunks.word32_chunks (S (S (S O))) state)))
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function jets.f_simplicity_write_sha256_context)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase)) (@nil Values.val))) Events.E0 mf
               (Values.Vint (jet_readBit_layout.bit_int (negb overflow))))
            (and
               (jet_encoding.frame_output_cells_at mf bw edge cursor
                  (@Translate.encode
                     (Ty.Prod (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
                        (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (@pair
                        (Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                        (prod (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W64)))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) buf
                        (@pair (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W64)))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (jet_wide_spec.decode_wide jet_wide.W64
                              (Integers.Int64.zero_ext
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                 (Integers.Int64.shru counter
                                    (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))))) state))))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bf base bw edge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bf
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
