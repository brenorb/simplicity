### C.jet_secp_schnorr_challenge_finish.schnorr_digest_scalar_value
schnorr_digest_scalar_value
     : forall (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (be bb : Values.block),
       @eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value (schnorr_digest_scalar_limbs h be bb))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem h))
### C.jet_secp_schnorr_challenge_finish.eval_schnorr_challenge_finish
eval_schnorr_challenge_finish
     : forall (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (be bb bs : Values.block) (_ : not (@eq Values.block be bb)) (_ : not (@eq Values.block bb bs))
         (_ : jet_uint32_array_init.uint32_array_at m bs BinNums.Z0 (jet_sha_ctx8_model.state_regs h))
         (_ : Memory.Mem.range_perm m be BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_sha256_fromMidstate)
                  (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mi
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mi
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_set_b32)
                     (@cons Values.val (Values.Vptr be Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val)))) Events.E0 mf
                     Values.Vundef)
                  (and
                     (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf be
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat i)))
                        (@Some Values.val (Values.Vlong (schnorr_digest_scalar_limbs h be bb i))))
                     (and
                        (@eq BinNums.Z
                           (jet_secp_scalar_overflow_numeric.scalar_limb_value (schnorr_digest_scalar_limbs h be bb))
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                              (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem h)))
                        (and
                           (Memory.Mem.range_perm mf be BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bb BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bs BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block b be)) (not (@eq Values.block b bb))) m mf)
                                    (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
