### C.jet_elements_build_tapbranch_jet.el_btb_env
el_btb_env =
fun bl ba bb brs brr : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements.__res
  (@pair Values.block Ctypes.type brr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._result
     (@pair Values.block Ctypes.type brs (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._b
        (@pair Values.block Ctypes.type bb (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._a
           (@pair Values.block Ctypes.type ba (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
           (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._src
              (@pair Values.block Ctypes.type bl jet_nonce_context_shape.nc_fr) Clight.empty_env))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block),
       Clight.env

