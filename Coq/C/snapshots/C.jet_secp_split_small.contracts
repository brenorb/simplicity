### C.jet_secp_split_small.eval_scalar_split_lambda_small
eval_scalar_split_lambda_small
     : forall (k : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bk br1 br2 : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k)
                   jet_secp_canonical_scalar.canonical_group_order))
         (_ : jet_secp_split_constants.split_constants_ready m)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))))
         (_ : Memory.Mem.range_perm m bk BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : @List.NoDup Values.block
                (@cons Values.block bk (@cons Values.block br1 (@cons Values.block br2 (@nil Values.block))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_split_lambda)
               (@cons Values.val (Values.Vptr br1 Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr br2 Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf br1 BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo
                           (jet_secp_split_signed_bounds.split_signed_first
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))
                           jet_secp_canonical_scalar.canonical_group_order))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf br2 BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                           (BinInt.Z.modulo
                              (jet_secp_split_signed_bounds.split_signed_second
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))
                              jet_secp_canonical_scalar.canonical_group_order))))
                  (and
                     (and
                        (BinInt.Z.lt
                           (BinInt.Z.opp
                              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (jet_secp_split_signed_bounds.split_signed_first
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k)))
                        (BinInt.Z.lt
                           (jet_secp_split_signed_bounds.split_signed_first
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))
                           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (and
                        (and
                           (BinInt.Z.lt
                              (BinInt.Z.opp
                                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                              (jet_secp_split_signed_bounds.split_signed_second
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k)))
                           (BinInt.Z.lt
                              (jet_secp_split_signed_bounds.split_signed_second
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))
                              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                        (and
                           (jet_secp_scalar_get_b32_storage.scalar_at mf bk BinNums.Z0
                              (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                                 (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                                    (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))))
                           (and
                              (Memory.Mem.range_perm mf br1 BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf br2 BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bk BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and (jet_secp_split_constants.split_constants_ready mf)
                                       (and (jet_clight_internal_permissions.keeps_permissions m mf)
                                          (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                             (jet_sx_mem.lframe
                                                (jet_secp_split_function.split_function_frame bk br1 br2) m mf)))))))))))))
