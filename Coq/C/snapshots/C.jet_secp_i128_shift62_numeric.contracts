### C.jet_secp_i128_shift62_numeric.i128_shru62_unsigned
i128_shru62_unsigned
     : forall value : Integers.Int64.int,
       @eq BinNums.Z
         (Integers.Int64.unsigned
            (Integers.Int64.shru value
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (BinInt.Z.div (Integers.Int64.unsigned value)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
### C.jet_secp_i128_shift62_numeric.i128_shift62_low_unsigned
i128_shift62_low_unsigned
     : forall lo hi : Integers.Int64.int,
       @eq BinNums.Z (Integers.Int64.unsigned (jet_secp_i128_shift62.i128_shift62_low lo hi))
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.mul (Integers.Int64.unsigned hi) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
               (BinInt.Z.div (Integers.Int64.unsigned lo)
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
            Integers.Int64.modulus)
