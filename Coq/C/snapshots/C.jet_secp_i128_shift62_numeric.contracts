### C.jet_secp_i128_shift62_numeric.eval_i128_shift62_exact
eval_i128_shift62_exact
     : forall (m : Memory.Mem.mem) (b : Values.block) (lo hi : Integers.Int64.int)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Writable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m b BinNums.Z0) (@Some Values.val (Values.Vlong lo)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val (Values.Vlong hi))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_i128_rshift)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vint
                        (Integers.Int.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf b BinNums.Z0)
                  (@Some Values.val (Values.Vlong (jet_secp_i128_shift62.i128_shift62_low lo hi))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val (Values.Vlong (jet_secp_i128_shift62.i128_shift62_high hi))))
                  (and
                     (@eq BinNums.Z
                        (i128_signed_value (jet_secp_i128_shift62.i128_shift62_low lo hi)
                           (jet_secp_i128_shift62.i128_shift62_high hi))
                        (BinInt.Z.div (i128_signed_value lo hi)
                           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                              (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                     (and
                        (forall (bb : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m bb ofs k p), Memory.Mem.perm mf bb ofs k p)
                        (jet_sx_mem.lframe
                           (fun (bb : Values.block) (ofs : BinNums.Z) =>
                            not
                              (and (@eq Values.block bb b)
                                 (and (BinInt.Z.le BinNums.Z0 ofs)
                                    (BinInt.Z.lt ofs
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                           m mf))))))
### C.jet_secp_i128_shift62_numeric.i128_signed_value
i128_signed_value =
fun lo hi : Integers.Int64.int =>
BinInt.Z.add (BinInt.Z.mul (Integers.Int64.signed hi) Integers.Int64.modulus) (Integers.Int64.unsigned lo)
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int), BinNums.Z

Arguments i128_signed_value lo hi
