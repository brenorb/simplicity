### C.jet_secp_scalar_bits_var.exec_scalar_var_else
exec_scalar_var_else
     : forall (m : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (b : Values.block) (base off : BinNums.Z)
         (count : Integers.Int.int) (lo hi : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr b (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._offset le)
                (@Some Values.val (Values.Vint (Integers.Int.repr off))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._count le)
                (@Some Values.val (Values.Vint count)))
         (_ : and (BinInt.Z.le BinNums.Z0 off)
                (BinInt.Z.lt off
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : and
                (BinInt.Z.lt BinNums.Z0
                   (BinInt.Z.modulo off
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (BinInt.Z.lt
                   (BinInt.Z.modulo off
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : BinInt.Z.lt (Integers.Int.unsigned count)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.add
                         (BinInt.Z.div off
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                         (BinNums.Zpos BinNums.xH)))) Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b
                   (BinInt.Z.add base
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.div off
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                (@Some Values.val (Values.Vlong lo)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b
                   (BinInt.Z.add base
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add
                            (BinInt.Z.div off
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                            (BinNums.Zpos BinNums.xH))))) (@Some Values.val (Values.Vlong hi))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m scalar_var_else Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'3 (Values.Vlong hi)
            (@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vlong lo) le)) m
         (ClightBigstep.Out_return
            (@Some (prod Values.val Ctypes.type)
               (@pair Values.val Ctypes.type
                  (Values.Vlong
                     (Integers.Int64.and (scalar_var_join lo hi (Integers.Int.repr off)) (scalar_var_mask count)))
                  Ctypesdefs.tulong)))
### C.jet_secp_scalar_bits_var.scalar_var_storage_limb
scalar_var_storage_limb
     : forall (m : Memory.Mem.mem) (b : Values.block) (base value i : BinNums.Z)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m b base
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value)))
         (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m b
            (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) i)))
         (@Some Values.val
            (Values.Vlong
               (Integers.Int64.repr
                  (@List.nth BinNums.Z (BinInt.Z.to_nat i) (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value)
                     BinNums.Z0))))
### C.jet_secp_scalar_bits_var.eval_scalar_get_bits_var_slice
eval_scalar_get_bits_var_slice
     : forall (m : Memory.Mem.mem) (b : Values.block) (base value off count : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 off)
                (BinInt.Z.lt off
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) count)
                (BinInt.Z.lt count
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : BinInt.Z.le (BinInt.Z.add off count)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m b base
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value))),
       ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
         (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_get_bits_var)
         (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr base))
            (@cons Values.val (Values.Vint (Integers.Int.repr off))
               (@cons Values.val (Values.Vint (Integers.Int.repr count)) (@nil Values.val)))) Events.E0 m
         (Values.Vint
            (Integers.Int.repr
               (BinInt.Z.modulo (BinInt.Z.div value (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) off))
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) count))))
