               (@List.nth BinNums.Z (BinInt.Z.to_nat (BinInt.Z.add i (BinNums.Zpos BinNums.xH)))
                  (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value) BinNums.Z0)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
