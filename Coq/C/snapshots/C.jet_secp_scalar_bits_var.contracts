### C.jet_secp_scalar_bits_var.scalar_var_test_numeric
scalar_var_test_numeric
     : forall (off count : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 off)
                (BinInt.Z.lt off
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) count)
