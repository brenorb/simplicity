       @eq bool (scalar_var_test (Integers.Int.repr off) (Integers.Int.repr count))
         match
           Coqlib.zeq
             (BinInt.Z.div (BinInt.Z.sub (BinInt.Z.add off count) (BinNums.Zpos BinNums.xH))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
             (BinInt.Z.div off
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
           return bool
         with
         | left _ => true
         | right _ => false
         end
