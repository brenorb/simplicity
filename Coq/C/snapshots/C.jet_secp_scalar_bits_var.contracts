    | Clight.Sswitch _ _ => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
    | Clight.Slabel _ _ => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
    | Clight.Sgoto _ => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
    end
| Clight.Sifthenelse _ _ _ => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
| Clight.Sloop _ _ => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
| Clight.Sbreak => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
| Clight.Scontinue => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
| Clight.Sreturn _ => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
| Clight.Sswitch _ _ => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
| Clight.Slabel _ _ => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
| Clight.Sgoto _ => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
end
     : Clight.expr
### C.jet_secp_scalar_bits_var.scalar_var_test
scalar_var_test =
fun off count : Integers.Int.int =>
Integers.Int.eq
  (Integers.Int.shru (Integers.Int.sub (Integers.Int.add off count) Integers.Int.one)
     (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH)))))
  (Integers.Int.shru off (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH)))))
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int), bool

Arguments scalar_var_test off count
### C.jet_secp_scalar_bits_var.scalar_var_mask
scalar_var_mask =
fun count : Integers.Int.int =>
Integers.Int64.sub (Integers.Int64.shl Integers.Int64.one (Integers.Int64.repr (Integers.Int.unsigned count)))
  Integers.Int64.one
     : forall _ : Integers.Int.int, Integers.Int64.int

Arguments scalar_var_mask count
### C.jet_secp_scalar_bits_var.scalar_var_join
scalar_var_join =
fun (lo hi : Integers.Int64.int) (off : Integers.Int.int) =>
Integers.Int64.or (Integers.Int64.shru lo (Integers.Int64.repr (jet_secp_scalar_get_bits.scalar_bits_shift off)))
  (Integers.Int64.shl hi
     (Integers.Int64.repr
        (BinInt.Z.sub
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
           (jet_secp_scalar_get_bits.scalar_bits_shift off))))
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int.int), Integers.Int64.int

Arguments scalar_var_join lo hi off
### C.jet_secp_scalar_bits_var.scalar_var_temps
scalar_var_temps =
fun (b : Values.block) (base : BinNums.Z) (off count : Integers.Int.int) =>
@Maps.PTree.set Values.val jets_secp._count (Values.Vint count)
  (@Maps.PTree.set Values.val jets_secp._offset (Values.Vint off)
     (@Maps.PTree.set Values.val jets_secp._a (Values.Vptr b (Integers.Ptrofs.repr base))
        (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_scalar_get_bits_var))))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int.int) (_ : Integers.Int.int),
       Maps.PTree.tree Values.val

Arguments scalar_var_temps b base%Z_scope off count
