### C.jet_secp_scalar_bits_var.scalar_var_join_value
scalar_var_join_value
     : forall (lo hi : Integers.Int64.int) (shift count : BinNums.Z)
         (_ : and (BinInt.Z.lt BinNums.Z0 shift)
                (BinInt.Z.lt shift
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 count)
                (BinInt.Z.lt count
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq BinNums.Z
         (Integers.Int64.unsigned
            (Integers.Int64.and
               (Integers.Int64.or (Integers.Int64.shru lo (Integers.Int64.repr shift))
                  (Integers.Int64.shl hi
                     (Integers.Int64.repr
                        (BinInt.Z.sub
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                           shift))))
               (Integers.Int64.repr
                  (BinInt.Z.sub (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) count) (BinNums.Zpos BinNums.xH)))))
         (BinInt.Z.modulo
            (BinInt.Z.div
               (BinInt.Z.add (Integers.Int64.unsigned lo)
                  (BinInt.Z.mul (Integers.Int64.unsigned hi)
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) shift))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) count))
