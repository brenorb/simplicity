### C.jet_elements_token_amount_exec.token_issuance_rep_pres
token_issuance_rep_pres
     : forall (m1 m2 : Memory.Mem.mem) (bi : Values.block) (ibase : BinNums.Z) (o : option jet_elements_prim.issuance)
         (_ : token_issuance_rep m1 bi ibase o)
         (_ : forall (chunk : AST.memory_chunk) (ofs : BinNums.Z) (v : Values.val) (_ : BinInt.Z.le ibase ofs)
                (_ : BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                       (BinInt.Z.add ibase
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                (_ : @eq (option Values.val) (Memory.Mem.load chunk m1 bi ofs) (@Some Values.val v)),
              @eq (option Values.val) (Memory.Mem.load chunk m2 bi ofs) (@Some Values.val v)),
       token_issuance_rep m2 bi ibase o
