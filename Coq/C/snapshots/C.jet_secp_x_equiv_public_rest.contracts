### C.jet_secp_x_equiv_public_rest.eval_x_equiv_guarded_call
eval_x_equiv_guarded_call
     : forall (q x z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (inf : bool)
         (m : Memory.Mem.mem) (bp bq : Values.block) (_ : not (@eq Values.block bp bq))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho x)))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho z)))
         (_ : jet_secp_fe_nv.fe_at m bq BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho q)))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bq BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mn : Memory.Mem.mem =>
          and
            match inf return Prop with
            | true => @eq Memory.Mem.mem mn m
            | false =>
                ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_eq_x_var)
                  (@cons Values.val (Values.Vptr bq Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mn
                  (Values.Vint (jet_readBit_layout.bit_int (x_equiv_word_comparison q x z)))
            end
            (and
               (Memory.Mem.range_perm mn bp BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mn bq BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) =>
                      and (not (@eq Values.block b bp)) (not (@eq Values.block b bq))) m mn))))
