### C.jet_secp_x_equiv_public_rest.x_equiv_word_comparison
x_equiv_word_comparison =
fun q x z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
BinInt.Z.eqb
  (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x))
     jet_secp_fe_math.feP)
  (BinInt.Z.modulo
     (BinInt.Z.mul
        (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho z))
           (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho z)))
        (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho q)))
     jet_secp_fe_math.feP)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), bool

Arguments x_equiv_word_comparison q x z
