                      | false => @nil Values.val
                      end
                      (@cons Values.val (Values.Vint n)
                         (@cons Values.val
                            (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                            (@nil Values.val))))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (strauss_digit_lookup_statement high) Events.E0
