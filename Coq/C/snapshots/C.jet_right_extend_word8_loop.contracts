### C.jet_right_extend_word8_loop.right_extend_word8_loop_shape
right_extend_word8_loop_shape
     : forall s : jet_extend_word8_loop.extend_word8_size,
       @eq Clight.statement
         match Clight.fn_body (right_extend_word8_function s) return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s1 =>
             match s1 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s3 =>
                 match s3 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence _ s5 =>
                     match s5 return Clight.statement with
                     | Clight.Sskip => Clight.Sskip
                     | Clight.Sassign _ _ => Clight.Sskip
                     | Clight.Sset _ _ => Clight.Sskip
                     | Clight.Scall _ _ _ => Clight.Sskip
                     | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                     | Clight.Ssequence _ s7 =>
                         match s7 return Clight.statement with
                         | Clight.Sskip => Clight.Sskip
                         | Clight.Sassign _ _ => Clight.Sskip
                         | Clight.Sset _ _ => Clight.Sskip
                         | Clight.Scall _ _ _ => Clight.Sskip
                         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                         | Clight.Ssequence s8 _ =>
                             match s8 return Clight.statement with
                             | Clight.Sskip => Clight.Sskip
                             | Clight.Sassign _ _ => Clight.Sskip
                             | Clight.Sset _ _ => Clight.Sskip
                             | Clight.Scall _ _ _ => Clight.Sskip
                             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                             | Clight.Ssequence _ loop => loop
                             | Clight.Sifthenelse _ _ _ => Clight.Sskip
                             | Clight.Sloop _ _ => Clight.Sskip
                             | Clight.Sbreak => Clight.Sskip
                             | Clight.Scontinue => Clight.Sskip
                             | Clight.Sreturn _ => Clight.Sskip
                             | Clight.Sswitch _ _ => Clight.Sskip
                             | Clight.Slabel _ _ => Clight.Sskip
                             | Clight.Sgoto _ => Clight.Sskip
                             end
                         | Clight.Sifthenelse _ _ _ => Clight.Sskip
                         | Clight.Sloop _ _ => Clight.Sskip
                         | Clight.Sbreak => Clight.Sskip
                         | Clight.Scontinue => Clight.Sskip
                         | Clight.Sreturn _ => Clight.Sskip
                         | Clight.Sswitch _ _ => Clight.Sskip
                         | Clight.Slabel _ _ => Clight.Sskip
                         | Clight.Sgoto _ => Clight.Sskip
                         end
                     | Clight.Sifthenelse _ _ _ => Clight.Sskip
                     | Clight.Sloop _ _ => Clight.Sskip
                     | Clight.Sbreak => Clight.Sskip
                     | Clight.Scontinue => Clight.Sskip
                     | Clight.Sreturn _ => Clight.Sskip
                     | Clight.Sswitch _ _ => Clight.Sskip
                     | Clight.Slabel _ _ => Clight.Sskip
                     | Clight.Sgoto _ => Clight.Sskip
                     end
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end (right_extend_word8_loop s)
### C.jet_right_extend_word8_loop.exec_right_extend_word8_fill
exec_right_extend_word8_fill
     : forall (bl : Values.block) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bd : Values.block) (base : BinNums.Z) (bit : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._lsb le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vint (jet_extend_bit8_exec.extend_bit8_arg bit)) (@nil Values.val)))
                Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m right_extend_word8_fill Events.E0
         (@Maps.PTree.set Values.val jets._t'2 (Values.Vint (jet_extend_bit8_exec.extend_bit8_arg bit)) le) mf
         ClightBigstep.Out_normal
### C.jet_right_extend_word8_loop.exec_right_extend_word8_loop
exec_right_extend_word8_loop
     : forall (s : jet_extend_word8_loop.extend_word8_size) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bit : bool) (i : BinNums.Z)
         (n : nat) (_ : BinInt.Z.le BinNums.Z0 i)
         (_ : @eq BinNums.Z (BinInt.Z.add i (BinInt.Z.of_nat n)) (jet_extend_word8_loop.extend_word8_count s))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._lsb le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : right_extend_word8_fill_run bd base bit n m mf),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (right_extend_word8_loop s)
               Events.E0 lef mf ClightBigstep.Out_normal)
            (forall (id : AST.ident) (_ : not (@eq AST.ident id jets._i)) (_ : not (@eq AST.ident id jets._t'2)),
             @eq (option Values.val) (@Maps.PTree.get Values.val id lef) (@Maps.PTree.get Values.val id le)))
### C.jet_right_extend_word8_loop.eval_right_extend_word8_lsb
eval_right_extend_word8_lsb
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._input le) (@Some Values.val (Values.Vint r))),
       Clight.eval_expr jet_exec.ge0 e le m right_extend_word8_lsb_expr
         (Values.Vint (jet_readBit_layout.bit_int (right_extend_word8_lsb r)))
### C.jet_right_extend_word8_loop.right_extend_word8_function
right_extend_word8_function =
fun s : jet_extend_word8_loop.extend_word8_size =>
match s return Clight.function with
| jet_extend_word8_loop.E8to16 => jets.f_simplicity_right_extend_8_16
| jet_extend_word8_loop.E8to32 => jets.f_simplicity_right_extend_8_32
| jet_extend_word8_loop.E8to64 => jets.f_simplicity_right_extend_8_64
end
     : forall _ : jet_extend_word8_loop.extend_word8_size, Clight.function

Arguments right_extend_word8_function s
### C.jet_right_extend_word8_loop.right_extend_word8_choose
right_extend_word8_choose =
Clight.Sifthenelse (Clight.Etempvar jets._lsb Ctypesdefs.tbool)
  (Clight.Sset jets._t'2 (jet_extend_bit8_exec.extend_bit8_choice_expr true))
  (Clight.Sset jets._t'2 (jet_extend_bit8_exec.extend_bit8_choice_expr false))
     : Clight.statement
### C.jet_right_extend_word8_loop.right_extend_word8_fill
right_extend_word8_fill =
Clight.Ssequence right_extend_word8_choose
  (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write8 Ctypesdefs.tuchar Ctypesdefs.tvoid
     (Clight.Etempvar jets._t'2 Ctypesdefs.tint))
     : Clight.statement
### C.jet_right_extend_word8_loop.right_extend_word8_loop
right_extend_word8_loop =
fun s : jet_extend_word8_loop.extend_word8_size =>
Clight.Sloop
  (Clight.Ssequence (Clight.Sifthenelse (jet_extend_word8_loop.extend_word8_guard s) Clight.Sskip Clight.Sbreak)
     right_extend_word8_fill) jet_eq256_loop.eq256_loop_step
     : forall _ : jet_extend_word8_loop.extend_word8_size, Clight.statement

Arguments right_extend_word8_loop s
### C.jet_right_extend_word8_loop.right_extend_word8_fill_run
right_extend_word8_fill_run =
fix right_extend_word8_fill_run
  (bd : Values.block) (base : BinNums.Z) (bit : bool) (n : nat) (m mf : Memory.Mem.mem) {struct n} : Prop :=
  match n return Prop with
  | O => @eq Memory.Mem.mem m mf
  | S n0 =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         and
           (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
              (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
              (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                 (@cons Values.val (Values.Vint (jet_extend_bit8_exec.extend_bit8_arg bit)) (@nil Values.val)))
              Events.E0 mi Values.Vundef) (right_extend_word8_fill_run bd base bit n0 mi mf))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : bool) (_ : nat) (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments right_extend_word8_fill_run bd base%Z_scope bit%bool_scope n%nat_scope m mf
### C.jet_right_extend_word8_loop.right_extend_word8_lsb
right_extend_word8_lsb =
fun r : Integers.Int.int => negb (Integers.Int.eq (Integers.Int.and r Integers.Int.one) Integers.Int.zero)
     : forall _ : Integers.Int.int, bool

Arguments right_extend_word8_lsb r
### C.jet_right_extend_word8_loop.right_extend_word8_lsb_expr
right_extend_word8_lsb_expr =
Clight.Ecast
  (Clight.Ebinop Cop.Oand (Clight.Etempvar jets._input Ctypesdefs.tuchar)
     (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint) Ctypesdefs.tbool
     : Clight.expr
