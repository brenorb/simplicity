### C.jet_secp_literal_add_numeric.literal_fe_one256_value
literal_fe_one256_value
     : @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt)) (BinNums.Zpos BinNums.xH)
### C.jet_secp_literal_add_numeric.literal_fe_add_expand_value
literal_fe_add_expand_value
     : forall (c : sum unit unit) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S (S O))))))))))
            (@jet_secp_literal_add_program.literal_fe_add_expand Alg.CoreFunSem
               (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) c x)))
         (@Word.ToZ.Theory.toZ (Word.PairToZ Word.BitToZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))))
            (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) c x))
### C.jet_secp_literal_add_numeric.literal_fe_add_expand_pair_value
literal_fe_add_expand_pair_value
     : forall p : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
