### C.jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_completes
scalar_mul512_borrowed_completes
     : @eq bool
         match scalar_mul512_borrowed_run return bool with
         | Some r =>
             match r return bool with
             | jet_sx_exec.RDone _ o =>
                 match o return bool with
                 | jet_sx_exec.ONormal => true
                 | jet_sx_exec.OBreak => false
                 | jet_sx_exec.OContinue => false
                 | jet_sx_exec.OReturn _ => false
                 end
             | jet_sx_exec.RIf _ _ _ => false
             end
         | None => false
         end true
### C.jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_run_eq
scalar_mul512_borrowed_run_eq
     : @eq (option jet_sx_exec.res) scalar_mul512_borrowed_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone scalar_mul512_borrowed_state jet_sx_exec.ONormal))
### C.jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_return
scalar_mul512_borrowed_return
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_mul512_borrowed_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_log_nil
scalar_mul512_borrowed_log_nil
