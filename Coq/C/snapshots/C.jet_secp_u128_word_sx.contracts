### C.jet_secp_u128_word_sx.bop_beq
bop_beq =
fun a b : jet_sx_expr.bop =>
match a return bool with
| jet_sx_expr.Badd =>
    match b return bool with
    | jet_sx_expr.Badd => true
    | jet_sx_expr.Bsub => false
    | jet_sx_expr.Bmul => false
    | jet_sx_expr.Band => false
    | jet_sx_expr.Bor => false
    | jet_sx_expr.Bxor => false
    end
| jet_sx_expr.Bsub =>
    match b return bool with
    | jet_sx_expr.Badd => false
    | jet_sx_expr.Bsub => true
    | jet_sx_expr.Bmul => false
    | jet_sx_expr.Band => false
    | jet_sx_expr.Bor => false
    | jet_sx_expr.Bxor => false
    end
| jet_sx_expr.Bmul =>
    match b return bool with
    | jet_sx_expr.Badd => false
    | jet_sx_expr.Bsub => false
    | jet_sx_expr.Bmul => true
    | jet_sx_expr.Band => false
    | jet_sx_expr.Bor => false
    | jet_sx_expr.Bxor => false
    end
| jet_sx_expr.Band =>
    match b return bool with
    | jet_sx_expr.Badd => false
    | jet_sx_expr.Bsub => false
    | jet_sx_expr.Bmul => false
    | jet_sx_expr.Band => true
    | jet_sx_expr.Bor => false
    | jet_sx_expr.Bxor => false
    end
| jet_sx_expr.Bor =>
    match b return bool with
    | jet_sx_expr.Badd => false
    | jet_sx_expr.Bsub => false
    | jet_sx_expr.Bmul => false
    | jet_sx_expr.Band => false
    | jet_sx_expr.Bor => true
    | jet_sx_expr.Bxor => false
    end
| jet_sx_expr.Bxor =>
    match b return bool with
    | jet_sx_expr.Badd => false
    | jet_sx_expr.Bsub => false
    | jet_sx_expr.Bmul => false
    | jet_sx_expr.Band => false
    | jet_sx_expr.Bor => false
    | jet_sx_expr.Bxor => true
    end
end
     : forall (_ : jet_sx_expr.bop) (_ : jet_sx_expr.bop), bool

Arguments bop_beq a b
### C.jet_secp_u128_word_sx.shop_beq
shop_beq =
fun a b : jet_sx_expr.shop =>
match a return bool with
| jet_sx_expr.Hshl =>
    match b return bool with
    | jet_sx_expr.Hshl => true
    | jet_sx_expr.Hshr => false
    | jet_sx_expr.Hshru => false
    end
| jet_sx_expr.Hshr =>
    match b return bool with
    | jet_sx_expr.Hshl => false
    | jet_sx_expr.Hshr => true
    | jet_sx_expr.Hshru => false
    end
| jet_sx_expr.Hshru =>
    match b return bool with
    | jet_sx_expr.Hshl => false
    | jet_sx_expr.Hshr => false
    | jet_sx_expr.Hshru => true
    end
end
     : forall (_ : jet_sx_expr.shop) (_ : jet_sx_expr.shop), bool

Arguments shop_beq a b
### C.jet_secp_u128_word_sx.cmp_beq
cmp_beq =
fun a b : Integers.comparison =>
match a return bool with
| Integers.Ceq =>
    match b return bool with
    | Integers.Ceq => true
    | Integers.Cne => false
    | Integers.Clt => false
    | Integers.Cle => false
    | Integers.Cgt => false
    | Integers.Cge => false
    end
| Integers.Cne =>
    match b return bool with
    | Integers.Ceq => false
    | Integers.Cne => true
    | Integers.Clt => false
    | Integers.Cle => false
    | Integers.Cgt => false
    | Integers.Cge => false
    end
| Integers.Clt =>
    match b return bool with
    | Integers.Ceq => false
    | Integers.Cne => false
    | Integers.Clt => true
    | Integers.Cle => false
    | Integers.Cgt => false
    | Integers.Cge => false
    end
| Integers.Cle =>
    match b return bool with
    | Integers.Ceq => false
    | Integers.Cne => false
    | Integers.Clt => false
    | Integers.Cle => true
    | Integers.Cgt => false
    | Integers.Cge => false
    end
| Integers.Cgt =>
    match b return bool with
    | Integers.Ceq => false
    | Integers.Cne => false
    | Integers.Clt => false
    | Integers.Cle => false
    | Integers.Cgt => true
    | Integers.Cge => false
    end
| Integers.Cge =>
    match b return bool with
    | Integers.Ceq => false
    | Integers.Cne => false
    | Integers.Clt => false
    | Integers.Cle => false
    | Integers.Cgt => false
    | Integers.Cge => true
    end
end
     : forall (_ : Integers.comparison) (_ : Integers.comparison), bool

Arguments cmp_beq a b
### C.jet_secp_u128_word_sx.sg_beq
sg_beq =
fun a b : Ctypes.signedness =>
match a return bool with
| Ctypes.Signed => match b return bool with
                   | Ctypes.Signed => true
                   | Ctypes.Unsigned => false
                   end
| Ctypes.Unsigned => match b return bool with
                     | Ctypes.Signed => false
                     | Ctypes.Unsigned => true
                     end
end
     : forall (_ : Ctypes.signedness) (_ : Ctypes.signedness), bool

Arguments sg_beq a b
### C.jet_secp_u128_word_sx.isz_beq
isz_beq =
fun a b : Ctypes.intsize =>
match a return bool with
| Ctypes.I8 =>
    match b return bool with
    | Ctypes.I8 => true
    | Ctypes.I16 => false
    | Ctypes.I32 => false
    | Ctypes.IBool => false
    end
| Ctypes.I16 =>
    match b return bool with
    | Ctypes.I8 => false
    | Ctypes.I16 => true
    | Ctypes.I32 => false
    | Ctypes.IBool => false
    end
| Ctypes.I32 =>
    match b return bool with
    | Ctypes.I8 => false
    | Ctypes.I16 => false
    | Ctypes.I32 => true
    | Ctypes.IBool => false
    end
| Ctypes.IBool =>
    match b return bool with
    | Ctypes.I8 => false
    | Ctypes.I16 => false
    | Ctypes.I32 => false
    | Ctypes.IBool => true
    end
end
     : forall (_ : Ctypes.intsize) (_ : Ctypes.intsize), bool

