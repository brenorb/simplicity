### C.jet_secp_u128_word_sx.xreplace
xreplace =
fun (regs : list jet_sx_state.region) (r : nat) (d : BinNums.Z) (ch : AST.memory_chunk) (x : jet_sx_expr.sx) =>
match @List.nth_error jet_sx_state.region regs r return (option (list jet_sx_state.region)) with
| Some reg =>
    match jet_sx_state.find_cell (jet_sx_state.rcells reg) d ch return (option (list jet_sx_state.region)) with
    | Some _ =>
        @Some (list jet_sx_state.region)
          (@jet_sx_state.upd jet_sx_state.region regs r
             (jet_sx_state.mkreg (jet_sx_state.set_cell (jet_sx_state.rcells reg) d ch (@Some jet_sx_expr.sx x))
                (jet_sx_state.rw reg) (jet_sx_state.rfree reg)))
    | None => @None (list jet_sx_state.region)
    end
| None => @None (list jet_sx_state.region)
end
     : forall (_ : list jet_sx_state.region) (_ : nat) (_ : BinNums.Z) (_ : AST.memory_chunk) (_ : jet_sx_expr.sx),
       option (list jet_sx_state.region)

Arguments xreplace regs%list_scope r%nat_scope d%Z_scope ch x
