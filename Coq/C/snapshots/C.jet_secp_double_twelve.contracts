### C.jet_secp_double_twelve.double_first_twelve_calls
double_first_twelve_calls
     : forall (x y z : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba bs bl bt : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : not (@eq Values.block ba bs))
         (_ : not (@eq Values.block ba bl)) (_ : not (@eq Values.block ba bt)) (_ : not (@eq Values.block bs bl))
         (_ : not (@eq Values.block bs bt)) (_ : not (@eq Values.block bl bt))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       let lx : forall _ : nat, Integers.Int64.int :=
         jet_secp_double_l_scale.double_l_words (jet_secp_square_numeric.square_words x) in
       let x8 : forall _ : nat, Integers.Int64.int := jet_secp_square_numeric.square_words lx in
       let t8 : forall _ : nat, Integers.Int64.int :=
         jet_secp_double_middle.double_t_words x (jet_secp_square_numeric.square_words y) in
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m2 : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun m3 : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun m4 : Memory.Mem.mem =>
                   @ex Memory.Mem.mem
                     (fun m5 : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun m6 : Memory.Mem.mem =>
                         @ex Memory.Mem.mem
                           (fun m7 : Memory.Mem.mem =>
                            @ex Memory.Mem.mem
                              (fun m8 : Memory.Mem.mem =>
                               @ex Memory.Mem.mem
                                 (fun m9 : Memory.Mem.mem =>
                                  @ex Memory.Mem.mem
                                    (fun m10 : Memory.Mem.mem =>
                                     @ex Memory.Mem.mem
                                       (fun m11 : Memory.Mem.mem =>
                                        @ex Memory.Mem.mem
                                          (fun mf : Memory.Mem.mem =>
                                           and
                                             (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                                                (@cons Values.val (Values.Vptr ba ...) (@cons Values.val ... ...))
                                                Events.E0 m1 Values.Vundef)
                                             (and
                                                (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m1
                                                   (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                                                   (@cons Values.val ... ...) Events.E0 m2 Values.Vundef)
                                                (and
                                                   (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m2 ...
                                                      ... Events.E0 m3 Values.Vundef) (and ... ...)))))))))))))))
