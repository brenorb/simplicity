let issuanceAmount : forall _ : issuance, amountWith (list Integers.Byte.int) :=
  fun i : issuance =>
  match i return (amountWith (list Integers.Byte.int)) with
  | inl new => newIssuanceAmount new
  | inr re => reissuanceAmount re
  end in
let issuanceTokenAmount : forall _ : issuance, amountWith (list Integers.Byte.int) :=
  fun i : issuance =>
  match i return (amountWith (list Integers.Byte.int)) with
  | inl new => newIssuanceTokenAmount new
  | inr _ => @Explicit (list Integers.Byte.int) Integers.Int64.int Integers.Int64.zero
  end in
let issuanceProof :
  forall (_ : forall _ : issuance, amountWith (list Integers.Byte.int)) (_ : sigTxInput), list Integers.Byte.int :=
  fun (f : forall _ : issuance, amountWith (list Integers.Byte.int)) (txi : sigTxInput) =>
  match sigTxiIssuance txi return (list Integers.Byte.int) with
  | Some i => @viewPrf Integers.Int64.int (f i)
  | None => @nil Integers.Byte.int
  end in
fun (A B : Ty.Ty) (p : Elements.t A B) (a : Ty.tySem A) (e : Elements.env) =>
let tx : sigTx := Elements.envTx e in
let ix : nat := Elements.envIx e in
let atInput :
  forall (A0 : Ty.Ty) (_ : forall _ : sigTxInput, Ty.tySem A0) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
  option (Ty.tySem (Ty.Sum Ty.Unit A0)) :=
  fun (A0 : Ty.Ty) (f : forall _ : sigTxInput, Ty.tySem A0) (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
  @Some (Ty.tySem (Ty.Sum Ty.Unit A0))
    (cast A0
       (@option_map sigTxInput (Ty.tySem A0) f
          (@List.nth_error sigTxInput (sigTxIn tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))))) in
let atOutput :
  forall (A0 : Ty.Ty) (_ : forall _ : txOutput, Ty.tySem A0) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
  option (Ty.tySem (Ty.Sum Ty.Unit A0)) :=
  fun (A0 : Ty.Ty) (f : forall _ : txOutput, Ty.tySem A0) (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
  @Some (Ty.tySem (Ty.Sum Ty.Unit A0))
    (cast A0
       (@option_map txOutput (Ty.tySem A0) f
          (@List.nth_error txOutput (sigTxOut tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))))) in
match p in (Elements.prim A0 B0) return (forall _ : Ty.tySem A0, option (Ty.tySem B0)) with
| Elements.Version =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (sigTxVersion tx)))
| Elements.LockTime =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (sigTxLock tx)))
| Elements.InputPegin =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            (sigTxiPegin txi)))
| Elements.InputPrevOutpoint =>
    atInput (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
      (fun txi : sigTxInput => encodeOutpoint (sigTxiPreviousOutpoint txi))
| Elements.InputAsset =>
    atInput
      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : sigTxInput => encodeAsset (utxoAsset (sigTxiTxo txi)))
| Elements.InputAmount =>
    atInput
      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S O)))))))) (fun txi : sigTxInput => encodeAmount (utxoAmount (sigTxiTxo txi)))
| Elements.InputScriptHash =>
    atInput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txi : sigTxInput => encodeHash (Digest.byteStringHash (utxoScript (sigTxiTxo txi))))
| Elements.InputSequence =>
    atInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))
      (fun txi : sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (sigTxiSequence txi)))
| Elements.InputAnnexHash =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map (list Integers.Byte.int) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun x : list Integers.Byte.int => encodeHash (Digest.byteStringHash x)) (sigTxiAnnex txi)))
| Elements.InputScriptSigHash =>
    atInput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txi : sigTxInput => encodeHash (Digest.byteStringHash (sigTxiScriptSig txi)))
| Elements.ReissuanceBlinding =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            match sigTxiIssuance txi return (option Digest.hash256) with
            | Some i =>
                match i return (option Digest.hash256) with
                | inl _ => @None Digest.hash256
                | inr re => @Some Digest.hash256 (reissuanceBlindingNonce re)
                end
            | None => @None Digest.hash256
            end))
| Elements.NewIssuanceContract =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            match sigTxiIssuance txi return (option Digest.hash256) with
            | Some i =>
                match i return (option Digest.hash256) with
                | inl new => @Some Digest.hash256 (newIssuanceContractHash new)
                | inr _ => @None Digest.hash256
                end
            | None => @None Digest.hash256
            end))
| Elements.ReissuanceEntropy =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            match sigTxiIssuance txi return (option Digest.hash256) with
            | Some i =>
                match i return (option Digest.hash256) with
                | inl _ => @None Digest.hash256
                | inr re => @Some Digest.hash256 (reissuanceEntropy re)
                end
            | None => @None Digest.hash256
            end))
| Elements.IssuanceAssetAmount =>
    atInput
      (Ty.Sum Ty.Unit
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O)))))))))
      (fun txi : sigTxInput =>
       cast
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O))))))))
         (@option_map issuance
            (Ty.tySem
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S ...))))))))
                  (Word.Word (S (S (S (S (S (S O)))))))))
            (fun i : issuance =>
             encodeAmount (@clearPrf (list Integers.Byte.int) Integers.Int64.int (issuanceAmount i)))
            (sigTxiIssuance txi)))
| Elements.IssuanceTokenAmount =>
    atInput
      (Ty.Sum Ty.Unit
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O)))))))))
      (fun txi : sigTxInput =>
       cast
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O))))))))
         (@option_map issuance
            (Ty.tySem
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S ...))))))))
                  (Word.Word (S (S (S (S (S (S O)))))))))
            (fun i : issuance =>
             encodeAmount (@clearPrf (list Integers.Byte.int) Integers.Int64.int (issuanceTokenAmount i)))
            (sigTxiIssuance txi)))
| Elements.IssuanceAssetProof =>
    atInput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txi : sigTxInput => encodeHash (Digest.byteStringHash (issuanceProof issuanceAmount txi)))
| Elements.IssuanceTokenProof =>
    atInput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txi : sigTxInput => encodeHash (Digest.byteStringHash (issuanceProof issuanceTokenAmount txi)))
| Elements.CurrentIndex =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (BinInt.Z.of_nat ix))
| Elements.TapleafVersion =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S O))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O))))
         (Integers.Byte.unsigned (tapleafVersion (Elements.envTap e))))
| Elements.Tappath =>
    fun i : Ty.tySem (Word.Word (S (S (S O)))) =>
    @Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            (@List.nth_error Digest.hash256 (tappath (Elements.envTap e))
               (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) i)))))
| Elements.InternalKey =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Word.from_hash256 (tapInternalKey (Elements.envTap e)))
| Elements.OutputAsset =>
    atOutput
      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txo : txOutput => encodeAsset (@clearPrf (list Integers.Byte.int) Digest.hash256 (txoAsset txo)))
| Elements.OutputAmount =>
    atOutput
      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S O))))))))
      (fun txo : txOutput => encodeAmount (@clearPrf (list Integers.Byte.int) Integers.Int64.int (txoAmount txo)))
| Elements.OutputNonce =>
    atOutput
      (Ty.Sum Ty.Unit
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (fun txo : txOutput => encodeNonce (txoNonce txo))
| Elements.OutputScriptHash =>
    atOutput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txo : txOutput => encodeHash (Digest.byteStringHash (txoScript txo)))
| Elements.OutputNullDatum =>
    fun ij : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) =>
    let i : Ty.tySem (Word.Word (S (S (S (S (S O)))))) :=
      @fst
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O)))))))
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))) ij in
    let j : Ty.tySem (Word.Word (S (S (S (S (S O)))))) :=
      @snd
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O)))))))
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))) ij in
    @Some
      (Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S ...)))))))
                  (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))))
      (cast
         (Ty.Sum Ty.Unit
            (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S ...))))))))
               (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))
         match
           @List.nth_error txOutput (sigTxOut tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (...)))))) i))
           return
             (option
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S ...))))
                         (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))))
         with
         | Some txo =>
             match
               txNullData (txoScript txo)
               return
                 (option
                    (Ty.tySem
                       (Ty.Sum Ty.Unit
                          (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S ...)))
                             (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S ...)))))))
             with
             | Some nullData =>
                 @Some
                   (Ty.tySem
                      (Ty.Sum Ty.Unit
                         (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (...)))))
                            (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))
                   (cast
                      (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (...))))))
                         (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))
                      (@option_map (txNullDatumF (list Integers.Byte.int))
                         (Ty.tySem
                            (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (...))))
                               (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (...))))))
                         (fun d : txNullDatumF (list Integers.Byte.int) =>
                          encodeNullDatum
                            (@mapNullDatum (list Integers.Byte.int) Digest.hash256 Digest.byteStringHash d))
                         (@List.nth_error (txNullDatumF (list Integers.Byte.int)) nullData
                            (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (...))) j)))))
             | None =>
                 @None
                   (Ty.tySem
                      (Ty.Sum Ty.Unit
                         (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (...)))))
                            (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))
             end
         | None =>
             @None
               (Ty.tySem
                  (Ty.Sum Ty.Unit
                     (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (...))))))
                        (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))
         end)
| Elements.OutputSurjectionProof =>
    atOutput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txo : txOutput => encodeHash (Digest.byteStringHash (@viewPrf Digest.hash256 (txoAsset txo))))
| Elements.OutputRangeProof =>
    atOutput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txo : txOutput => encodeHash (Digest.byteStringHash (@viewPrf Integers.Int64.int (txoAmount txo))))
| Elements.GenesisBlockHash =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (encodeHash (Elements.envGenesisBlock e))
| Elements.ScriptCMR =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (encodeHash (tapScriptCMR (Elements.envTap e)))
| Elements.TransactionId =>
    fun _ : Ty.tySem Ty.Unit => @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (encodeHash (txid tx))
end a
     : forall (A B : Ty.Ty) (_ : Elements.t A B) (_ : Ty.tySem A) (_ : Elements.env), option (Ty.tySem B)

Arguments Elements.sem {A B}%ty_scope p a e
