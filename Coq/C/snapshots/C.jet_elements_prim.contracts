### C.jet_elements_prim.Elements.sem
Elements.sem =
let cast : forall (A : Ty.Ty) (_ : option (Ty.tySem A)), Ty.tySem (Ty.Sum Ty.Unit A) :=
  fun (A : Ty.Ty) (x : option (Ty.tySem A)) =>
  match x return (Ty.tySem (Ty.Sum Ty.Unit A)) with
  | Some a => @inr unit (Ty.tySem A) a
  | None =>
      @inl unit
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A0 B => sum (tySem A0) (tySem B)
            | Ty.Prod A0 B => prod (tySem A0) (tySem B)
            end) A) tt
  end in
let toBit : forall _ : bool, Ty.tySem (Ty.Sum Ty.Unit Ty.Unit) :=
  fun b : bool =>
  match b return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) with
  | true => @inr unit unit tt
  | false => @inl unit unit tt
  end in
let encodeHash : forall _ : Digest.hash256, Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
  fun h : Digest.hash256 => Word.from_hash256 h in
let encodeConfidential :
  forall (A : Set) (B : Ty.Ty) (_ : forall _ : A, Ty.tySem B) (_ : confidential unit A),
  Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B) :=
  fun (A : Set) (B : Ty.Ty) (enc : forall _ : A, Ty.tySem B) (c : confidential unit A) =>
  match
    c return (Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B))
  with
  | Explicit a =>
      @inr
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end) (Ty.Sum Ty.Unit Ty.Unit))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.tySem B) (enc a)
  | Confidential pt _ =>
      match
        pt
        return (Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B))
      with
      | Point odd x =>
          @inl (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                end) B)
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (toBit odd) (Word.from_hash256 x))
      end
  end in
let encodeAsset :
  forall _ : assetWith unit,
  Ty.tySem
    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
       (Word.Word (S (S (S (S (S (S (S (S O)))))))))) :=
  fun a : assetWith unit =>
  encodeConfidential Digest.hash256 (Word.Word (S (S (S (S (S (S (S (S O))))))))) encodeHash a in
let encodeAmount :
  forall _ : amountWith unit,
  Ty.tySem
    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
       (Word.Word (S (S (S (S (S (S O)))))))) :=
  fun a : amountWith unit =>
  encodeConfidential Integers.Int64.int (Word.Word (S (S (S (S (S (S O)))))))
    (fun v : Integers.Int64.int =>
     @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.unsigned v)
     :
     Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) a in
let encodeNonce :
  forall _ : option nonce,
  Ty.tySem
    (Ty.Sum Ty.Unit
       (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
          (Word.Word (S (S (S (S (S (S (S (S O))))))))))) :=
  fun n : option nonce =>
  cast
    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
       (Word.Word (S (S (S (S (S (S (S (S O))))))))))
    (@option_map nonce
       (Ty.tySem
          (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
       (fun x : nonce =>
        match
          x
          return
            (Ty.tySem
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        with
        | inl p =>
            match
              p
              return
                (Ty.tySem
                   (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            with
            | pair odd w =>
                @inl
                  (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (prod
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
                  (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (toBit odd) (Word.from_hash256 w))
            end
        | inr h =>
            @inr
              (prod
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Ty.Sum Ty.Unit Ty.Unit))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (encodeHash h)
        end) n) in
let encodeOutpoint :
  forall _ : outpoint,
  Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))) :=
  fun op : outpoint =>
  @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
    (encodeHash (opHash op))
    (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (opIndex op))
     :
     Ty.tySem (Word.Word (S (S (S (S (S O))))))) in
let encodeNullDatum :
  forall _ : txNullDatumF Digest.hash256,
  Ty.tySem
    (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
       (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))) :=
  fun d : txNullDatumF Digest.hash256 =>
  match
    d
    return
      (Ty.tySem
         (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))
  with
  | Immediate h =>
      @inl (prod (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (sum
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Ty.Sum Ty.Unit Ty.Unit))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word (S (S O)))))
        (@pair (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (@Word.ToZ.Theory.fromZ (Word.WordToZ (S O)) BinNums.Z0 : Ty.tySem (Word.Word (S O)))
           (encodeHash h))
  | PushData h =>
      @inl (prod (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (sum
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Ty.Sum Ty.Unit Ty.Unit))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word (S (S O)))))
        (@pair (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (@Word.ToZ.Theory.fromZ (Word.WordToZ (S O)) (BinNums.Zpos BinNums.xH) : Ty.tySem (Word.Word (S O)))
           (encodeHash h))
  | PushData2 h =>
      @inl (prod (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (sum
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Ty.Sum Ty.Unit Ty.Unit))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word (S (S O)))))
        (@pair (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (@Word.ToZ.Theory.fromZ (Word.WordToZ (S O)) (BinNums.Zpos (BinNums.xO BinNums.xH))
            :
            Ty.tySem (Word.Word (S O))) (encodeHash h))
  | PushData4 h =>
      @inl (prod (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (sum
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Ty.Sum Ty.Unit Ty.Unit))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word (S (S O)))))
        (@pair (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (@Word.ToZ.Theory.fromZ (Word.WordToZ (S O)) (BinNums.Zpos (BinNums.xI BinNums.xH))
            :
            Ty.tySem (Word.Word (S O))) (encodeHash h))
  | OP1Negate =>
      @inr
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word (S O)))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (sum (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
           (prod
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S O)))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
