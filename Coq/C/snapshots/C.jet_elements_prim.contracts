                  end) Ty.Unit)) (Ty.tySem (Word.Word (S (S O))))
           (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S O))) (BinNums.Zpos BinNums.xH) : Ty.tySem (Word.Word (S (S O)))))
  | OP3 =>
