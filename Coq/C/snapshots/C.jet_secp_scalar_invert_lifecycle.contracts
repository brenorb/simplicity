### C.jet_secp_scalar_invert_lifecycle.scalar_invert_entry
scalar_invert_entry
     : forall (v_env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem') (bl ba bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_simplicity_scalar_invert
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val v_env (@nil Values.val))))
         m (jet_secp_scalar_public_entry.scalar_public_env bl ba) (scalar_invert_temps v_env bd dbase bs sbase) mb
### C.jet_secp_scalar_invert_lifecycle.scalar_invert_src_temp
scalar_invert_src_temp
     : forall (v_env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z),
       @eq (option Values.val)
         (@Maps.PTree.get Values.val jets_secp._src (scalar_invert_temps v_env bd dbase bs sbase))
         (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)))
### C.jet_secp_scalar_invert_lifecycle.scalar_invert_public_body
scalar_invert_public_body
     : @eq Clight.statement (Clight.fn_body jets_secp.f_simplicity_scalar_invert)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_secp._src jet_secp_public_body.secp_frame_type)
               (Clight.Etempvar jets_secp._src jet_secp_public_body.secp_frame_type))
            jet_secp_scalar_invert_rest.scalar_invert_rest)
### C.jet_secp_scalar_invert_lifecycle.eval_secp_scalar_invert_initialized
eval_secp_scalar_invert_initialized
     : forall (v_env : Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
         (bi : Values.block) (edge rc : BinNums.Z) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_secp_modinfo_scalar_initialized.modinfo_scalar_initialized m0)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m0 bs sbase bi edge rc)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value)))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m0
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_scalar_invert)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val v_env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi mf true
                  (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                     (@jet_secp_scalar_invert_literal.literal_scalar_invert Alg.CoreFunSem value)))
               (and
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) => not (jet_secp_frame.extA m0 bd bw bi b)) m0 mf)
                  (and (jet_secp_modinfo_scalar_initialized.modinfo_scalar_initialized mf)
                     (jet_clight_internal_preserve.readonly_preserved m0 mf)))))
### C.jet_secp_scalar_invert_lifecycle.scalar_invert_temps
scalar_invert_temps =
fun (v_env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_secp._env v_env
  (@Maps.PTree.set Values.val jets_secp._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_secp._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_simplicity_scalar_invert))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments scalar_invert_temps v_env bd dbase%Z_scope bs sbase%Z_scope
