### C.jet_secp_rescale_writer.rescale_point_limbs
rescale_point_limbs
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int) (jet_secp_point_write_field.point_field_limbs (rescale_point_field w))
         (jet_secp_multiply_normalize_bridge.words5 w)
### C.jet_secp_rescale_writer.rescale_point_bounds
rescale_point_bounds
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds w),
       jet_secp_point_write_field.point_field_bounds (rescale_point_field w)
### C.jet_secp_rescale_writer.rescale_point_output
rescale_point_output
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_point_write_field.point_field_output (rescale_point_field w))
         (jet_secp_rescale_literal.rescale_field_output w)
### C.jet_secp_rescale_writer.rescale_output_encoding
rescale_output_encoding
     : forall x y z s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list BitMachine.Cell)
         (@app BitMachine.Cell
            (@app BitMachine.Cell
               (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                  (jet_secp_rescale_literal.rescale_field_output
                     (jet_secp_point_mul_storage.point_mul_words (jet_secp_square_spec_bridge.square_reader_rho x)
                        (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho s)))))
               (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                  (jet_secp_rescale_literal.rescale_field_output
                     (jet_secp_point_mul_storage.point_mul_words
                        (jet_secp_point_mul_storage.point_mul_words (jet_secp_square_spec_bridge.square_reader_rho y)
                           (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho s)))
                        (jet_secp_square_spec_bridge.square_reader_rho s)))))
            (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_rescale_literal.rescale_field_output
                  (jet_secp_point_mul_storage.point_mul_words (jet_secp_square_spec_bridge.square_reader_rho z)
                     (jet_secp_square_spec_bridge.square_reader_rho s)))))
         (@Translate.encode
            (Ty.Prod
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@jet_secp_rescale_literal.literal_gej_rescale Alg.CoreFunSem
               (@pair
                  (prod
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z) s)))
### C.jet_secp_rescale_writer.eval_write_gej_rescaled_literal
eval_write_gej_rescaled_literal
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (m : Memory.Mem.mem)
         (bp : Values.block) (x y z s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
                N) (_ : jet_frame_inv.finv m0 bd dbase bw edge cursor N bi m false (@nil BitMachine.Cell))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5
                   (jet_secp_point_mul_storage.point_mul_words (jet_secp_square_spec_bridge.square_reader_rho x)
                      (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho s)))))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5
                   (jet_secp_point_mul_storage.point_mul_words
                      (jet_secp_point_mul_storage.point_mul_words (jet_secp_square_spec_bridge.square_reader_rho y)
                         (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho s)))
                      (jet_secp_square_spec_bridge.square_reader_rho s))))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5
                   (jet_secp_point_mul_storage.point_mul_words (jet_secp_square_spec_bridge.square_reader_rho z)
                      (jet_secp_square_spec_bridge.square_reader_rho s))))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_write_gej)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_frame_inv.finv m0 bd dbase bw edge cursor N bi mf true
                  (@Translate.encode
                     (Ty.Prod
                        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                           (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@jet_secp_rescale_literal.literal_gej_rescale Alg.CoreFunSem
                        (@pair
                           (prod
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (@pair
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z) s))))
               (and
                  (Memory.Mem.range_perm mf bp BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) =>
                      and (not (@eq Values.block b bp)) (not (jet_secp_frame.extA m0 bd bw bi b))) m mf))))
### C.jet_secp_rescale_writer.rescale_point_field
rescale_point_field =
fun w : forall _ : nat, Integers.Int64.int =>
jet_secp_point_write_field.mkpointfield (w O) (w (S O)) (w (S (S O))) (w (S (S (S O)))) (w (S (S (S (S O)))))
     : forall _ : forall _ : nat, Integers.Int64.int, jet_secp_point_write_field.point_field

Arguments rescale_point_field w%function_scope
