### C.jet_secp_modinv_fg_start.fg_input_bounds
fg_input_bounds =
fun rho : forall _ : nat, Integers.Int64.int =>
and
  (forall high : bool,
   BinInt.Z.le
     (BinInt.Z.add (BinInt.Z.abs (Integers.Int64.signed (jet_secp_modinv_fg_iteration_numeric.fg_iter_u rho high)))
        (BinInt.Z.abs (Integers.Int64.signed (jet_secp_modinv_fg_iteration_numeric.fg_iter_v rho high))))
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
  (forall (high : bool) (j : nat) (_ : lt j (S (S (S (S (S O)))))),
   BinInt.Z.le (BinInt.Z.abs (Integers.Int64.signed (jet_secp_modinv_fg_loop_numeric.fg_array_word rho high j)))
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
     : forall _ : forall _ : nat, Integers.Int64.int, Prop

