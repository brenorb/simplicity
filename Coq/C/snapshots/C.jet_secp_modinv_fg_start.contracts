  end in
let v : nat :=
  match high return nat with
  | true => S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
  | false => S (S (S (S (S (S (S (S (S (S (S O))))))))))
  end in
@pair Integers.Int64.int Integers.Int64.int
  (jet_secp_i128_shift62.i128_shift62_low (jet_secp_modinv_fg_prefix_numeric.fg_row_low rho u v)
