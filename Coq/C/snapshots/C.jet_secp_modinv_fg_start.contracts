### C.jet_secp_modinv_fg_start.fg_start_rho
fg_start_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (n : nat) =>
match n return Integers.Int64.int with
| O => rho n
| S n0 =>
    match n0 return Integers.Int64.int with
    | O => rho n
    | S n1 =>
        match n1 return Integers.Int64.int with
        | O => rho n
        | S n2 =>
            match n2 return Integers.Int64.int with
            | O => rho n
            | S n3 =>
                match n3 return Integers.Int64.int with
                | O => rho n
                | S n4 =>
                    match n4 return Integers.Int64.int with
                    | O => rho n
                    | S n5 =>
                        match n5 return Integers.Int64.int with
                        | O => rho n
                        | S n6 =>
                            match n6 return Integers.Int64.int with
                            | O => rho n
                            | S n7 =>
                                match n7 return Integers.Int64.int with
                                | O => rho n
                                | S n8 =>
                                    match n8 return Integers.Int64.int with
                                    | O => rho n
                                    | S n9 =>
                                        match n9 return Integers.Int64.int with
                                        | O => rho n
                                        | S n10 =>
                                            match n10 return Integers.Int64.int with
                                            | O => rho n
                                            | S n11 =>
                                                match n11 return Integers.Int64.int with
                                                | O => rho n
                                                | S n12 =>
                                                    match n12 return Integers.Int64.int with
                                                    | O => rho n
                                                    | S n13 =>
                                                        match n13 return Integers.Int64.int with
                                                        | O => rho n
                                                        | S n14 =>
                                                            match n14 return Integers.Int64.int with
                                                            | O =>
                                                                @fst Integers.Int64.int Integers.Int64.int
                                                                  (fg_start_carry rho false)
                                                            | S n15 =>
                                                                match n15 return Integers.Int64.int with
                                                                | O =>
                                                                    @snd Integers.Int64.int Integers.Int64.int
                                                                      (fg_start_carry rho false)
                                                                | S n16 =>
                                                                    match n16 return Integers.Int64.int with
                                                                    | O =>
                                                                        @fst Integers.Int64.int Integers.Int64.int
                                                                          (fg_start_carry rho true)
                                                                    | S n17 =>
                                                                        match n17 return Integers.Int64.int with
                                                                        | O =>
                                                                            @snd Integers.Int64.int Integers.Int64.int
                                                                              (fg_start_carry rho true)
                                                                        | S _ => rho n
                                                                        end
                                                                    end
                                                                end
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

