### C.jet_secp_scalar_inverse_loop.scalar_inv_seed_ready
scalar_inv_seed_ready
     : forall (w : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (_ : jet_secp_signed62_numeric.signed62_normalized w)
         (_ : jet_sx_state.rep
                (jet_secp_modinv_seed_modulus.inv_mod_seed_rho jet_secp_scalar_normalize62.modinfo_scalar_limb w) beta
                (jet_secp_modinv_seed_modulus.inv_mod_seed_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) m)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_var_entry.inv_start_alloc) e)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._eta le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr (BinNums.Zneg BinNums.xH)))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._modinfo le)
                (@Some Values.val
                   (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le)
                (@Some Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))))))),
       scalar_inv_loop_ready (jet_secp_signed62_numeric.signed62_unsigned_value w) O beta e le m
         (S (S (S (S (S O)))))
         (jet_secp_modinv_seed_modulus.inv_mod_seed_rho jet_secp_scalar_normalize62.modinfo_scalar_limb w)
### C.jet_secp_scalar_inverse_loop.scalar_inv_trajectory
scalar_inv_trajectory =
fun (value : BinNums.Z) (n : nat) =>
@fst divstep.State (list divstep.Step)
  (divstep.stepN n
     (divstep.init jet_secp_canonical_scalar.canonical_group_order value
        jet_secp_scalar_inverse_result.scalar_inv_modulus_odd))
     : forall (_ : BinNums.Z) (_ : nat), divstep.State

Arguments scalar_inv_trajectory value%Z_scope n%nat_scope
### C.jet_secp_scalar_inverse_loop.scalar_inv_loop_temps
scalar_inv_loop_temps =
fun le lef : Clight.temp_env =>
forall (id : AST.ident) (_ : not (@eq AST.ident id jets_secp._eta)) (_ : not (@eq AST.ident id jets_secp._t'1))
  (_ : not (@eq AST.ident id jets_secp._t'7)) (_ : not (@eq AST.ident id jets_secp._t'8))
  (_ : not (@List.In AST.ident id jet_secp_modinv_var_post.inv_post_modified)),
@eq (option Values.val) (@Maps.PTree.get Values.val id lef) (@Maps.PTree.get Values.val id le)
     : forall (_ : Clight.temp_env) (_ : Clight.temp_env), Prop

Arguments scalar_inv_loop_temps le lef
### C.jet_secp_scalar_inverse_loop.scalar_inv_loop_ready
scalar_inv_loop_ready =
fun (value : BinNums.Z) (n : nat) (beta : jet_sx_state.layout) (e : Clight.env) (le0 : Maps.PTree.tree Values.val)
  (m : Memory.Mem.mem) (len : nat) (rho : forall _ : nat, Integers.Int64.int) =>
and (and (lt O len) (le len (S (S (S (S (S O)))))))
  (and
     (jet_sx_state.rep rho beta
        (jet_secp_modinv_seed_modulus.inv_mod_seed_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) m)
     (and
        (jet_sx_eval.ematch beta
           (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_var_entry.inv_start_alloc) e)
        (and
           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._eta le0)
              (@Some Values.val (Values.Vlong (Integers.Int64.repr (divstep.eta (scalar_inv_trajectory value n))))))
           (and
              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._modinfo le0)
                 (@Some Values.val
                    (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))))
              (and
                 (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le0)
                    (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat len)))))
                 (and (jet_secp_scalar_de_ranges.scalar_de62_state_bounds (jet_secp_modinv_var_de.inv_de_rho rho))
                    (and (jet_secp_modinv_var_invariant.inv_state_matches len rho (scalar_inv_trajectory value n))
                       (and
                          (jet_secp_scalar_de_invariant.scalar_de62_coefficient_link value
                             (jet_secp_modinv_var_de.inv_de_rho rho) (scalar_inv_trajectory value n))
                          (and (jet_secp_modinv_var_ranges.inv_fg_limb_bounds rho)
                             (and (jet_secp_modinv_var_ranges.inv_fg_value_capacity len rho)
                                (and
                                   (forall _ : @eq BinNums.Z value BinNums.Z0,
                                    @eq BinNums.Z
                                      (BinInt.Z.modulo
                                         (jet_secp_modinv_de_numeric.de62_input_value
                                            (jet_secp_modinv_var_de.inv_de_rho rho) false)
                                         jet_secp_canonical_scalar.canonical_group_order) BinNums.Z0)
                                   (or (@eq nat n O)
                                      (not (@eq BinNums.Z (divstep.g (scalar_inv_trajectory value n)) BinNums.Z0))))))))))))))
     : forall (_ : BinNums.Z) (_ : nat) (_ : jet_sx_state.layout) (_ : Clight.env) (_ : Maps.PTree.tree Values.val)
         (_ : Memory.Mem.mem) (_ : nat) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments scalar_inv_loop_ready value%Z_scope n%nat_scope beta e le m len%nat_scope rho%function_scope
### C.jet_secp_scalar_inverse_loop.scalar_inv_loop_done
scalar_inv_loop_done =
fun (value : BinNums.Z) (n : nat) (beta : jet_sx_state.layout) (le0 : Maps.PTree.tree Values.val)
  (m : Memory.Mem.mem) (len : nat) (rho : forall _ : nat, Integers.Int64.int) =>
and (and (lt O len) (le len (S (S (S (S (S O)))))))
  (and
     (jet_sx_state.rep rho beta
        (jet_secp_modinv_loop_modulus.inv_mod_loop_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) m)
     (and
        (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._eta le0)
           (@Some Values.val (Values.Vlong (Integers.Int64.repr (divstep.eta (scalar_inv_trajectory value n))))))
        (and
           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le0)
              (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat len)))))
           (and (jet_secp_scalar_de_ranges.scalar_de62_state_bounds (jet_secp_modinv_var_de.inv_de_rho rho))
              (and (jet_secp_modinv_var_invariant.inv_state_matches len rho (scalar_inv_trajectory value n))
                 (and
                    (jet_secp_scalar_de_invariant.scalar_de62_coefficient_link value
                       (jet_secp_modinv_var_de.inv_de_rho rho) (scalar_inv_trajectory value n))
                    (and (jet_secp_modinv_var_ranges.inv_fg_limb_bounds rho)
                       (and (jet_secp_modinv_var_ranges.inv_fg_value_capacity len rho)
                          (and (jet_secp_modinv_var_tail.inv_tail_low_bounds len rho)
                             (and
                                (forall _ : @eq BinNums.Z value BinNums.Z0,
                                 @eq BinNums.Z
                                   (BinInt.Z.modulo
                                      (jet_secp_modinv_de_numeric.de62_input_value
                                         (jet_secp_modinv_var_de.inv_de_rho rho) false)
                                      jet_secp_canonical_scalar.canonical_group_order) BinNums.Z0)
                                (@eq BinNums.Z (divstep.g (scalar_inv_trajectory value n)) BinNums.Z0)))))))))))
     : forall (_ : BinNums.Z) (_ : nat) (_ : jet_sx_state.layout) (_ : Maps.PTree.tree Values.val)
         (_ : Memory.Mem.mem) (_ : nat) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments scalar_inv_loop_done value%Z_scope n%nat_scope beta le m len%nat_scope rho%function_scope
