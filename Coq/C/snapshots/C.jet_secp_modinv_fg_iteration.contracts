### C.jet_secp_modinv_fg_iteration.fg_cf_call_run
fg_cf_call_run =
fun k : nat =>
jet_sx_exec.xstmt (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_modinv_fg_iteration_prefix.fg_fast_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
  (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_fg_prefix.fg_alloc)
  (jet_secp_modinv_fg_iteration_prefix.fg_iter_prefix_state k) fg_cf_low_call
