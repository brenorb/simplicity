Arguments fg_cf_call_run k%nat_scope
### C.jet_secp_modinv_fg_iteration.fg_cf_call_state
fg_cf_call_state =
fun k : nat =>
match k return jet_sx_eval.sstate with
| O => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
| S n =>
    match n return jet_sx_eval.sstate with
    | O =>
        match fg_cf_call_run (S O) return jet_sx_eval.sstate with
        | Some r =>
            match r return jet_sx_eval.sstate with
            | jet_sx_exec.RDone st _ => st
            | jet_sx_exec.RIf _ _ _ =>
                jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region)
                  (@nil jet_sx_eval.event) O
            end
        | None =>
            jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
        end
    | S n0 =>
