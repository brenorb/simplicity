### C.jet_secp_scalar_negate_exec.scalar_negate_limbs_length
scalar_negate_limbs_length
     : @eq nat (@length jet_sx_expr.sx scalar_negate_limbs) (S (S (S (S O))))
### C.jet_secp_scalar_negate_exec.scalar_negate_regions_exact
scalar_negate_regions_exact
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs jet_secp_scalar_negate_run.scalar_negate_state)
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 scalar_negate_limbs) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@nil jet_sx_state.region))
### C.jet_secp_scalar_negate_exec.scalar_negate_limbs_long
scalar_negate_limbs_long
     : @List.Forall jet_sx_expr.sx (fun x : jet_sx_expr.sx => @eq bool (jet_sx_expr.isk jet_sx_expr.KL x) true)
         scalar_negate_limbs
### C.jet_secp_scalar_negate_exec.eval_scalar_negate_from_owned_region
eval_scalar_negate_from_owned_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout jet_secp_scalar_writer_run.scalar_writer_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho layout (jet_sx_eval.sregs jet_secp_scalar_negate_run.scalar_negate_state) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape jet_secp_scalar_writer_run.scalar_writer_initial_regs) b ofs)) m mf)))
### C.jet_secp_scalar_negate_exec.scalar_negate_final_storage
scalar_negate_final_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout (jet_sx_eval.sregs jet_secp_scalar_negate_run.scalar_negate_state) m),
       and (@eq BinNums.Z (jet_sx_state.bas layout O) BinNums.Z0)
         (and
            (Memory.Mem.range_perm m (jet_sx_state.blk layout O) BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
               Memtype.Freeable)
            (forall (i : nat) (x : jet_sx_expr.sx)
               (_ : @eq (option jet_sx_expr.sx) (@List.nth_error jet_sx_expr.sx scalar_negate_limbs i)
                      (@Some jet_sx_expr.sx x)),
             @eq (option Values.val)
               (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk layout O)
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
               (@Some Values.val (Values.Vlong (jet_sx_expr.il (jet_sx_expr.den rho (jet_sx_state.lay layout) x))))))
### C.jet_secp_scalar_negate_exec.scalar_negate_limbs
scalar_negate_limbs =
match jet_sx_eval.sregs jet_secp_scalar_negate_run.scalar_negate_state return (list jet_sx_expr.sx) with
| nil => @nil jet_sx_expr.sx
| cons reg _ => @List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_frame.cell_sx (jet_sx_state.rcells reg)
end
     : list jet_sx_expr.sx
