### C.jet_secp_scalar_get_bits.scalar_bits_shift
scalar_bits_shift =
fun off : Integers.Int.int =>
Integers.Int.unsigned
  (Integers.Int.and off
     (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
     : forall _ : Integers.Int.int, BinNums.Z

