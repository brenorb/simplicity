### C.jet_secp_scalar_get_bits.scalar_bits_result
scalar_bits_result =
fun (limb : Integers.Int64.int) (off count : Integers.Int.int) =>
Integers.Int64.loword
  (Integers.Int64.and (Integers.Int64.shru limb (Integers.Int64.repr (scalar_bits_shift off)))
     (Integers.Int64.sub (Integers.Int64.shl Integers.Int64.one (Integers.Int64.repr (Integers.Int.unsigned count)))
        Integers.Int64.one))
