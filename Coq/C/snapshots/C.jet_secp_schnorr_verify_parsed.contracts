### C.jet_secp_schnorr_verify_parsed.xonly_parsed_result_framed
xonly_parsed_result_framed
     : forall (pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m mf : Memory.Mem.mem)
         (bkey : Values.block) (P : forall (_ : Values.block) (_ : BinNums.Z), Prop)
         (_ : jet_secp_xonly_parse_field.xonly_parsed_result pk m bkey) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall pos : BinNums.Z, P bkey pos), jet_secp_xonly_parse_field.xonly_parsed_result pk mf bkey
### C.jet_secp_schnorr_verify_parsed.eval_schnorrsig_verify_parsed
eval_schnorrsig_verify_parsed
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_memset_model.memset_model) (_ : jet_ctz_model.ctz_model)
         (pk msg r s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bsig bmsg bkey : Values.block) (_ : not (@eq Values.block bsig bmsg)) (_ : not (@eq Values.block bsig bkey))
         (_ : Memory.Mem.range_perm m bsig BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bsig BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes r)))
         (_ : jet_read8s_layout.uint8_array_at m bsig
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes s)))
         (_ : jet_secp_schnorr_challenge_absorb.schnorr_bytes_at m bmsg Integers.Ptrofs.zero
                (jet_secp_schnorr_challenge_hash.schnorr_word_bytes msg))
         (_ : @eq Integers.Int.int (jet_secp_xonly_parse_field.xonly_parse_result pk) Integers.Int.one)
         (_ : jet_secp_xonly_parse_field.xonly_parsed_result pk m bkey) (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : forall h : bool, jet_secp_generator_globals.generator_table_state h m)
         (_ : jet_secp_split_constants.split_constants_ready m) (_ : jet_secp_beta_global.beta_initialized m)
         (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_schnorrsig_verify)
               (@cons Values.val (Values.Vptr bsig Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bmsg Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vlong
                           (Integers.Int64.repr
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                        (@cons Values.val (Values.Vptr bkey Integers.Ptrofs.zero) (@nil Values.val))))) Events.E0 mf
               (Values.Vint
                  (jet_readBit_layout.bit_int
                     (Bit.toBool
                        (@jet_secp_schnorr_verify_literal.literal_bip0340_check Alg.CoreFunSem
                           (@pair
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk msg)
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) r s)))))))
            (and
               (Memory.Mem.range_perm mf bsig BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bsig)) m mf)
                  (jet_clight_forward.mem_forward m mf))))
