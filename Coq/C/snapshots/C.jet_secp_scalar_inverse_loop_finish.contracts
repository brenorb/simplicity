### C.jet_secp_scalar_inverse_loop_finish.scalar_inv_loop_array
scalar_inv_loop_array
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r n : nat)
         (_ : jet_sx_state.rep rho beta
                (jet_secp_modinv_loop_modulus.inv_mod_loop_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) m)
         (_ : @eq (option jet_sx_state.region)
                (@List.nth_error jet_sx_state.region
                   (jet_secp_modinv_loop_modulus.inv_mod_loop_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) r)
                (@Some jet_sx_state.region
                   (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 n)) true
                      (@Some BinNums.Z
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))),
       jet_secp_fe_nv.fe_at m (jet_sx_state.blk beta r) BinNums.Z0
         (jet_secp_multiply_normalize_bridge.words5 (fun i : nat => rho (Nat.add n i)))
### C.jet_secp_scalar_inverse_loop_finish.scalar_inv_loop_global
scalar_inv_loop_global
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta
                (jet_secp_modinv_loop_modulus.inv_mod_loop_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) m)
         (_ : @eq Values.block (jet_sx_state.blk beta (S O)) jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block)
         (_ : @eq BinNums.Z (jet_sx_state.bas beta (S O)) BinNums.Z0),
       jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep m
### C.jet_secp_scalar_inverse_loop_finish.scalar_inv_loop_owned
scalar_inv_loop_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat)
         (_ : jet_sx_state.rep rho beta
                (jet_secp_modinv_loop_modulus.inv_mod_loop_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) m)
         (_ : and (le (S (S O)) r) (lt r (S (S (S (S (S (S (S O))))))))),
       Memory.Mem.range_perm m (jet_sx_state.blk beta r) BinNums.Z0 (jet_secp_modinv_var_free.inv_local_size r)
         Memtype.Cur Memtype.Freeable
### C.jet_secp_scalar_inverse_loop_finish.exec_scalar_inv_loop_finish
exec_scalar_inv_loop_finish
     : forall (value : BinNums.Z) (n : nat) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (len : nat) (rho : forall _ : nat, Integers.Int64.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : and (BinInt.Z.le BinNums.Z0 value) (BinInt.Z.lt value jet_secp_canonical_scalar.canonical_group_order))
         (_ : jet_secp_scalar_inverse_loop.scalar_inv_loop_ready value n beta e le m len rho)
         (_ : @eq Values.block (jet_sx_state.blk beta (S O)) jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block)
         (_ : @eq BinNums.Z (jet_sx_state.bas beta (S O)) BinNums.Z0)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._x le)
                (@Some Values.val (Values.Vptr (jet_sx_state.blk beta O) Integers.Ptrofs.zero))),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun words : forall _ : nat, Integers.Int64.int =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun mr : Memory.Mem.mem =>
                   and
                     (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                        (Clight.Ssequence jet_secp_modinv_var_zero.inv_caller_loop
                           jet_secp_modinv_var_finish.inv_finish) Events.E0 lef mf ClightBigstep.Out_normal)
                     (and
                        (@eq (option Memory.Mem.mem)
                           (Memory.Mem.free_list mf (Clight.blocks_of_env jet_secp_linkage.secp_ge e))
                           (@Some Memory.Mem.mem mr))
                        (and
                           (jet_secp_fe_nv.fe_at mr (jet_sx_state.blk beta O) BinNums.Z0
                              (jet_secp_multiply_normalize_bridge.words5 words))
                           (and (jet_secp_signed62_numeric.signed62_normalized words)
                              (and
                                 (@eq BinNums.Z (jet_secp_signed62_numeric.signed62_unsigned_value words)
                                    (jet_secp_scalar_invert_literal.literal_scalar_invert_numeric value))
                                 (and
                                    (forall (input : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (_ : @eq BinNums.Z value
                                              (BinInt.Z.modulo
                                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S ...))))))) input)
                                                 jet_secp_canonical_scalar.canonical_group_order)),
                                     @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S ...))))))))))
                                       (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                          (jet_secp_signed62_numeric.signed62_unsigned_value words))
                                       (@jet_secp_scalar_invert_literal.literal_scalar_invert Alg.CoreFunSem input))
                                    (and
                                       (Memory.Mem.range_perm mr (jet_sx_state.blk beta O) BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and (jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep mr)
                                          (jet_sx_mem.lframe (scalar_inv_loop_finish_frame beta) m mr))))))))))))
### C.jet_secp_scalar_inverse_loop_finish.scalar_inv_loop_finish_frame
scalar_inv_loop_finish_frame =
fun (beta : jet_sx_state.layout) (b : Values.block) (ofs : BinNums.Z) =>
and (jet_secp_scalar_inverse_batch.scalar_inv_batch_frame beta b ofs)
  (and
     (jet_secp_modinv_normalize62_exec.norm62_outside (jet_sx_state.blk beta (S (S O)))
        jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block b ofs)
     (and (not (@eq Values.block b (jet_sx_state.blk beta O))) (jet_secp_modinv_var_free.inv_free_outside beta b)))
     : forall (_ : jet_sx_state.layout) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments scalar_inv_loop_finish_frame beta b ofs%Z_scope
