### C.jet_secp_scalar_lambda_global.scalar_lambda_global_symbol
scalar_lambda_global_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            jets_secp._secp256k1_const_lambda) (@Some Values.block scalar_lambda_block)
### C.jet_secp_scalar_lambda_global.scalar_lambda_global_info
scalar_lambda_global_info
     : @eq (option (AST.globvar Ctypes.type))
         (@Globalenvs.Genv.find_var_info Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            scalar_lambda_block) (@Some (AST.globvar Ctypes.type) jets_secp.v_secp256k1_const_lambda)
### C.jet_secp_scalar_lambda_global.scalar_lambda_words_value
scalar_lambda_words_value
     : @eq BinNums.Z (jet_secp_scalar_mul512_accumulate.column_words_value scalar_lambda_words) canonical_lambda_value
### C.jet_secp_scalar_lambda_global.scalar_lambda_words_count
scalar_lambda_words_count
     : @eq nat (@length Integers.Int64.int scalar_lambda_words) (S (S (S (S O))))
### C.jet_secp_scalar_lambda_global.scalar_lambda_genv_projection
scalar_lambda_genv_projection
     : @eq (Globalenvs.Genv.t Clight.fundef Ctypes.type) (Clight.genv_genv jet_secp_linkage.secp_ge)
         (@Globalenvs.Genv.globalenv (Ctypes.fundef Clight.function) Ctypes.type
            (@Ctypes.program_of_program Clight.function jets_secp.prog))
### C.jet_secp_scalar_lambda_global.scalar_lambda_global_initializes
scalar_lambda_global_initializes
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       scalar_lambda_global_rep m
### C.jet_secp_scalar_lambda_global.scalar_lambda_global_readonly_initial
scalar_lambda_global_readonly_initial
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m))
         (ofs : BinNums.Z), not (Memory.Mem.perm m scalar_lambda_block ofs Memtype.Max Memtype.Writable)
### C.jet_secp_scalar_lambda_global.scalar_lambda_global_unchanged
scalar_lambda_global_unchanged
     : forall (m m' : Memory.Mem.mem)
         (_ : Memory.Mem.unchanged_on
                (fun (b : Values.block) (_ : BinNums.Z) => @eq Values.block b scalar_lambda_block) m m')
         (_ : scalar_lambda_global_rep m), scalar_lambda_global_rep m'
### C.jet_secp_scalar_lambda_global.scalar_lambda_words
scalar_lambda_words =
@cons Integers.Int64.int
  (Integers.Int64.repr
     (BinNums.Zneg
        (BinNums.xO
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xI
