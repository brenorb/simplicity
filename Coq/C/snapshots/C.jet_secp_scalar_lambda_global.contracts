                                                        (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
           (@nil Integers.Int64.int))))
     : list Integers.Int64.int
### C.jet_secp_scalar_lambda_global.canonical_lambda_value
canonical_lambda_value =
BinNums.Zpos
  (BinNums.xO
     (BinNums.xI
        (BinNums.xO
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))))))))))))))))))
     : BinNums.Z
### C.jet_secp_scalar_lambda_global.scalar_lambda_block
scalar_lambda_block = jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_const_lambda
     : Values.block
### C.jet_secp_scalar_lambda_global.scalar_lambda_global_rep
scalar_lambda_global_rep =
fun m : Memory.Mem.mem =>
and (Memory.Mem.valid_block m scalar_lambda_block)
  (and
     (Memory.Mem.range_perm m scalar_lambda_block BinNums.Z0
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
        Memtype.Readable)
     (forall (i : nat) (w : Integers.Int64.int)
        (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int scalar_lambda_words i)
               (@Some Integers.Int64.int w)),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m scalar_lambda_block
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong w))))
     : forall _ : Memory.Mem.mem, Prop

Arguments scalar_lambda_global_rep m
