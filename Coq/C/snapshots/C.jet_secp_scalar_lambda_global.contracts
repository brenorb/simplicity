                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
  (@cons Integers.Int64.int
     (Integers.Int64.repr
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI
