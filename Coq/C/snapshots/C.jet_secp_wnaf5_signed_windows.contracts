                (@eq BinNums.Z
                   (BinInt.Z.modulo (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit))
                      (BinNums.Zpos (BinNums.xO BinNums.xH))) carry)),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit)) carry)
            (BinNums.Zpos (BinNums.xO BinNums.xH))) (BinNums.Zpos BinNums.xH)
