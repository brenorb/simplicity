### C.jet_secp_multiply_input_input.normalized_value_range
normalized_value_range
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and (BinInt.Z.le BinNums.Z0 (normalized_value x))
         (BinInt.Z.lt (normalized_value x)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_multiply_input_input.pair_rho_left
pair_rho_left
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (i : nat) (_ : lt i (S (S (S (S (S O)))))),
       @eq Integers.Int64.int (pair_rho x y i) (jet_secp_b32_exec.limb_rho (normalized_value x) i)
### C.jet_secp_multiply_input_input.pair_rho_right
pair_rho_right
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (i : nat),
       @eq Integers.Int64.int (pair_rho x y (Nat.add i (S (S (S (S (S O)))))))
         (jet_secp_b32_exec.limb_rho (normalized_value y) i)
### C.jet_secp_multiply_input_input.pair_rho_limb_bound
pair_rho_limb_bound
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (i : nat),
       and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned (pair_rho x y i)))
         (BinInt.Z.le (Integers.Int64.unsigned (pair_rho x y i))
            (BinNums.Zpos
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
### C.jet_secp_multiply_input_input.pair_input_bounds
pair_input_bounds
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       jet_secp_multiply_first_arithmetic.field_input_bounds (pair_rho x y)
### C.jet_secp_multiply_input_input.radix_limb_rho
radix_limb_rho
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (jet_secp_b32_exec.limb_rho value)) value
### C.jet_secp_multiply_input_input.pair_radix_left
pair_radix_left
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (pair_rho x y)) (normalized_value x)
### C.jet_secp_multiply_input_input.pair_radix_right
pair_radix_right
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (jet_secp_multiply_finish_product.radix_value (jet_secp_multiply_finish_product.second_input (pair_rho x y)))
         (normalized_value y)
### C.jet_secp_multiply_input_input.pair_product_word
pair_product_word
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_multiply_writer_bridge.product_word (pair_rho x y)) (input_product_word x y)
### C.jet_secp_multiply_input_input.vars5_offset_nth
vars5_offset_nth
     : forall (offset i : nat) (x : jet_sx_expr.sx)
         (_ : @eq (option jet_sx_expr.sx) (@List.nth_error jet_sx_expr.sx (jet_secp_fe_nv.vars5 offset) i)
                (@Some jet_sx_expr.sx x)),
       and (lt i (S (S (S (S (S O)))))) (@eq jet_sx_expr.sx x (jet_sx_expr.XLv (Nat.add offset i)))
### C.jet_secp_multiply_input_input.owned_field_region
owned_field_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r offset : nat) (value : BinNums.Z) (_ : @eq BinNums.Z (jet_sx_state.bas layout r) BinNums.Z0)
         (_ : jet_secp_fe_nv.fe_at m (jet_sx_state.blk layout r) (jet_sx_state.bas layout r)
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : Memory.Mem.range_perm m (jet_sx_state.blk layout r) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              @eq Integers.Int64.int (rho (Nat.add offset i)) (jet_secp_b32_exec.limb_rho value i)),
       jet_sx_state.region_ok rho layout m r
         (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 offset)) true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
### C.jet_secp_multiply_input_input.pair_initial_rep
pair_initial_rep
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bb : Values.block)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of (normalized_value x))))
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of (normalized_value y))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block ba bb)),
       jet_sx_state.rep (pair_rho x y)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) jet_secp_multiply_run_run.field_mul_regs m
### C.jet_secp_multiply_input_input.normalized_value
normalized_value =
fun x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
     : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))), BinNums.Z

Arguments normalized_value x
### C.jet_secp_multiply_input_input.pair_rho
pair_rho =
fun (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (n : nat) =>
match PeanoNat.Nat.ltb n (S (S (S (S (S O))))) return Integers.Int64.int with
| true => jet_secp_b32_exec.limb_rho (normalized_value x) n
| false => jet_secp_b32_exec.limb_rho (normalized_value y) (Nat.sub n (S (S (S (S (S O))))))
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : nat), Integers.Int64.int

Arguments pair_rho x y n%nat_scope
### C.jet_secp_multiply_input_input.input_product_word
input_product_word =
fun x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
  (BinInt.Z.modulo
     (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)) jet_secp_fe_math.feP)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))))

Arguments input_product_word x y
