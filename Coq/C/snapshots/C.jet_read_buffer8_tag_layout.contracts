### C.jet_read_buffer8_tag_layout.byte_chunk_tag_cells
byte_chunk_tag_cells
     : forall c : jet_buffer_input.byte_chunk,
       @eq (list BitMachine.Cell) (jet_buffer_input.byte_chunk_cells c)
         (@cons (option bool) (@Some bool (byte_chunk_tag c)) (byte_chunk_payload_cells c))
### C.jet_read_buffer8_tag_layout.eval_buffer8_read_tag_layout
eval_buffer8_read_tag_layout
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bi : Values.block)
         (edge cursor : BinNums.Z) (c : jet_buffer_input.byte_chunk) (_ : jet_frame_layout.frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 cursor)
                (BinInt.Z.le cursor (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))))
         (_ : jet_frame_layout.frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : not (@eq Values.block bf bi))
         (_ : jet_encoding.frame_input_cells_at m bi edge cursor (jet_buffer_input.byte_chunk_cells c)),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_readBit)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mr
               (Values.Vint (jet_readBit_layout.bit_int (byte_chunk_tag c))))
            (and (jet_frame_layout.frame_fields_at mr bf base bi edge (BinInt.Z.add cursor (BinNums.Zpos BinNums.xH)))
               (and
                  (jet_encoding.frame_input_cells_at mr bi edge (BinInt.Z.add cursor (BinNums.Zpos BinNums.xH))
                     (byte_chunk_payload_cells c))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mr b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mr b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mr b))))))
### C.jet_read_buffer8_tag_layout.byte_chunk_tag
byte_chunk_tag =
fun c : jet_buffer_input.byte_chunk =>
match @snd nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c return bool with
| Some _ => true
| None => false
end
     : forall _ : jet_buffer_input.byte_chunk, bool

Arguments byte_chunk_tag c
### C.jet_read_buffer8_tag_layout.byte_chunk_payload_cells
byte_chunk_payload_cells =
fun c : jet_buffer_input.byte_chunk =>
match @snd nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c return (list BitMachine.Cell) with
| Some xs =>
    @List.concat BitMachine.Cell
      (@List.map (Ty.tySem (Word.Word (S (S (S O))))) (list BitMachine.Cell)
         (@Translate.encode (Word.Word (S (S (S O))))) xs)
| None =>
    @List.repeat (option bool) (@None bool)
      (Nat.mul (S (S (S (S (S (S (S (S O)))))))) (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c))
end
     : forall _ : jet_buffer_input.byte_chunk, list BitMachine.Cell

Arguments byte_chunk_payload_cells c
