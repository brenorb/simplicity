### C.jet_secp_u128_shift64_body.u128_shift64_actual_body
u128_shift64_actual_body
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_u128_rshift)
         (Clight.Ssequence (Clight.Sloop Clight.Sskip Clight.Sbreak)
            (Clight.Sifthenelse jet_secp_u128_shift64_expr.u128_shift_test u128_shift64_then u128_shift64_else))
### C.jet_secp_u128_shift64_body.exec_u128_shift64_body
exec_u128_shift64_body
     : forall (m m1 mf : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (b : Values.block)
         (value : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._n le)
                (@Some Values.val
                   (Values.Vint
                      (Integers.Int.repr
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val (Values.Vlong value)))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.store AST.Mint64 m b BinNums.Z0 (Values.Vlong value))
                (@Some Memory.Mem.mem m1))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m1 b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                   (Values.Vlong Integers.Int64.zero)) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m
         (Clight.fn_body jets_secp.f_secp256k1_u128_rshift) Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'4 (Values.Vlong value) le) mf ClightBigstep.Out_normal
### C.jet_secp_u128_shift64_body.u128_shift64_then
u128_shift64_then =
Clight.Ssequence
  (Clight.Ssequence (Clight.Sset jets_secp._t'4 (jet_secp_u128_shift64_expr.u128_field jets_secp._hi))
     (Clight.Sassign (jet_secp_u128_shift64_expr.u128_field jets_secp._lo)
        (Clight.Ebinop Cop.Oshr (Clight.Etempvar jets_secp._t'4 Ctypesdefs.tulong)
           jet_secp_u128_shift64_expr.u128_shift_count Ctypesdefs.tulong)))
  (Clight.Sassign (jet_secp_u128_shift64_expr.u128_field jets_secp._hi)
     (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))
     : Clight.statement
### C.jet_secp_u128_shift64_body.u128_shift64_else
u128_shift64_else =
match Clight.fn_body jets_secp.f_secp256k1_u128_rshift return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ _ => Clight.Sskip
    | Clight.Sifthenelse _ _ other => other
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
