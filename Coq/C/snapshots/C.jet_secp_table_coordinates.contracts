table_witness_scaled_next =
fun n : nat =>
@pair (prod (prod (list BinNums.Z) (list BinNums.Z)) (list BinNums.Z)) (list BinNums.Z)
  (@pair (prod (list BinNums.Z) (list BinNums.Z)) (list BinNums.Z)
     (@pair (list BinNums.Z) (list BinNums.Z)
        (jet_secp_fast_polynomial.fast_polynomial_scale
           (BinInt.Z.modulo
              (BinInt.Z.mul
                 (BinInt.Z.div (BinInt.Z.add jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                    (BinNums.Zpos (BinNums.xO BinNums.xH)))
                 (BinInt.Z.div (BinInt.Z.add jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                    (BinNums.Zpos (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP)
           (jet_secp_fast_polynomial.fast_polynomial_mul (table_witness_d (Nat.add n (S (S O))))
              match PeanoNat.Nat.eqb n (S O) return (list BinNums.Z) with
              | true => @cons BinNums.Z (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH)) (@nil BinNums.Z)
              | false => table_witness_d (Nat.sub n (S (S O)))
              end))
        (jet_secp_fast_polynomial.fast_polynomial_mul (table_witness_sq (table_witness_f n))
           (table_witness_x (Nat.add n (S (S O))))))
     (jet_secp_fast_polynomial.fast_polynomial_mul (table_witness_cube (table_witness_f n))
        (table_witness_y (Nat.add n (S (S O))))))
  (jet_secp_fast_polynomial.fast_polynomial_mul (table_witness_f n) (table_witness_d (Nat.add n (S (S O)))))
     : forall _ : nat, prod (prod (prod (list BinNums.Z) (list BinNums.Z)) (list BinNums.Z)) (list BinNums.Z)

Arguments table_witness_scaled_next n%nat_scope
