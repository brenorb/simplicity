Arguments literal_scalar_table5 {term}
### C.jet_secp_scalar_table_literal.literal_table_advance
literal_table_advance =
fix literal_table_advance (n : nat) (a : Ty.tySem literal_table_gej) (b : Ty.tySem literal_table_ge) {struct n} :
    Ty.tySem literal_table_gej :=
  match n return (Ty.tySem literal_table_gej) with
  | O => a
  | S k =>
      @snd
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end)
              ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                  match n0 return Ty.Ty with
                  | O => X
                  | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end)
              ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                  match n0 return Ty.Ty with
                  | O => X
                  | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end)
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (@jet_secp_add_literal.literal_gej_ge_add_ex Alg.CoreFunSem
           (@pair (Ty.tySem literal_table_gej) (Ty.tySem literal_table_ge) (literal_table_advance k a b) b))
  end
     : forall (_ : nat) (_ : Ty.tySem literal_table_gej) (_ : Ty.tySem literal_table_ge), Ty.tySem literal_table_gej

Arguments literal_table_advance n%nat_scope a b
### C.jet_secp_scalar_table_literal.literal_table_ratio
