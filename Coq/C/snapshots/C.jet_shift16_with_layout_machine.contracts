### C.jet_shift16_with_layout_machine.eval_shift16_with_layout_machine
eval_shift16_with_layout_machine
     : forall (env : Values.val) (right : bool) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (fill : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (amount : Ty.tySem (Word.Word (S (S O))))
         (x : Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16))) (cursor rc : BinNums.Z)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.add
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                         (jet_wide.wide_bits jet_wide.W16)))))
         (_ : jet_input_layout.frame_input_bit_at m bi edge rc (Bit.toBool fill))
         (_ : @jet_input_layout.frame_input_word_at (S (S O)) m bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH))
                amount)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log jet_wide.W16) m bi edge
                (BinInt.Z.add rc
                   (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))) x)
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor (jet_wide.wide_bits jet_wide.W16)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function (jet_shift_wide_with_exec.shift_wide_with_function jet_wide.W16 right))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Word.Word (jet_wide.wide_log jet_wide.W16))
                     (shift16_with_machine_value right fill amount x)))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (jet_wide.wide_bits jet_wide.W16)))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (jet_wide.wide_bits jet_wide.W16))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_shift16_with_layout_machine.shift16_with_machine_value
shift16_with_machine_value =
fun (right : bool) (fill : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (amount : Ty.tySem (Word.Word (S (S O))))
  (x : Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16))) =>
jet_wide_spec.decode_wide jet_wide.W16
  (Integers.Int64.zero_ext (jet_wide.wide_bits jet_wide.W16)
     (jet_shift_wide_helper_exec.shift_wide_payload jet_wide.W16 right (Bit.toBool fill)
        (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log jet_wide.W16)) x))
        (Integers.Int.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S O))) amount))))
     : forall (_ : bool) (_ : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (_ : Ty.tySem (Word.Word (S (S O))))
         (_ : Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16))),
       Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16))

Arguments shift16_with_machine_value right%bool_scope fill amount x
