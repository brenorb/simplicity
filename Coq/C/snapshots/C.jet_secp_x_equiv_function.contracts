### C.jet_secp_x_equiv_function.x_equiv_function_ok
x_equiv_function_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_secp256k1_gej_eq_x_var) true
### C.jet_secp_x_equiv_function.x_equiv_function_entry
x_equiv_function_entry
     : forall (m : Memory.Mem.mem) (ma mi : Memory.Mem.mem') (bp bq br br2 : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block ma br))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mi br2)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_gej_eq_x_var
         (@cons Values.val (Values.Vptr bq Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) m
         (jet_secp_x_equiv_statements.x_equiv_helper_env br br2) (x_equiv_entry_temps bp bq) mi
### C.jet_secp_x_equiv_function.x_equiv_function_blocks
x_equiv_function_blocks
     : forall br br2 : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (jet_secp_x_equiv_statements.x_equiv_helper_env br br2))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z br2 BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z br BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
### C.jet_secp_x_equiv_function.eval_x_equiv_function
eval_x_equiv_function
     : forall (q x z : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bp bq : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds q) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : not (@eq Values.block bp bq))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : jet_secp_fe_nv.fe_at m bq BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 q))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bq BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_eq_x_var)
               (@cons Values.val (Values.Vptr bq Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               (Values.Vint (x_equiv_result q x z)))
            (and
               (Memory.Mem.range_perm mf bp BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mf bq BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) =>
                      and (not (@eq Values.block b bp)) (not (@eq Values.block b bq))) m mf))))
### C.jet_secp_x_equiv_function.x_equiv_result
x_equiv_result =
fun q x z : forall _ : nat, Integers.Int64.int =>
match
  BinInt.Z.eqb (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value x) jet_secp_fe_math.feP)
    (BinInt.Z.modulo
       (BinInt.Z.mul
          (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value z)
             (jet_secp_multiply_finish_product.radix_value z)) (jet_secp_multiply_finish_product.radix_value q))
       jet_secp_fe_math.feP) return Integers.Int.int
with
| true => Integers.Int.one
| false => Integers.Int.zero
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int), Integers.Int.int

Arguments x_equiv_result (q x z)%function_scope
### C.jet_secp_x_equiv_function.x_equiv_entry_temps
x_equiv_entry_temps =
fun bp bq : Values.block =>
@Maps.PTree.set Values.val jets_secp._a (Values.Vptr bp Integers.Ptrofs.zero)
  (@Maps.PTree.set Values.val jets_secp._x (Values.Vptr bq Integers.Ptrofs.zero)
     (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_gej_eq_x_var)))
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree Values.val

Arguments x_equiv_entry_temps bp bq
