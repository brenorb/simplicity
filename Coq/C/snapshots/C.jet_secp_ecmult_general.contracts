         (_ : jet_secp_odd_table_literal_walk.table_word_literal x ax)
         (_ : jet_secp_odd_table_literal_walk.table_word_literal y ay)
         (_ : jet_secp_odd_table_literal_walk.table_word_literal z az),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun ox : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun oy : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun oz : forall _ : nat, Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult)
                        (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vptr bng Integers.Ptrofs.zero) (@nil Values.val)))))
                        Events.E0 mf Values.Vundef)
                     (and (jet_secp_fe_nv.fe_at mf br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 ox))
                        (and
                           (jet_secp_fe_nv.fe_at mf br
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 oy))
                           (and
                              (jet_secp_fe_nv.fe_at mf br
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (jet_secp_multiply_normalize_bridge.words5 oz))
                              (and (jet_secp_square_columns.square_input_bounds ox)
                                 (and (jet_secp_square_columns.square_input_bounds oy)
                                    (and (jet_secp_square_columns.square_input_bounds oz)
                                       (and
                                          (@eq
                                             (prod
                                                (prod (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...))))))))
                                                (Ty.tySem (Word.Word (S (S (S (S (S (...)))))))))
                                             (@pair
                                                (prod (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...))))))))
                                                (Ty.tySem (Word.Word (S (S (S (S (S (...))))))))
                                                (@pair (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (jet_secp_rescale_literal.rescale_field_output ox)
                                                   (jet_secp_rescale_literal.rescale_field_output oy))
                                                (jet_secp_rescale_literal.rescale_field_output oz))
                                             (@jet_secp_strauss_complete_program.literal_off_curve_linear_combination_1
                                                Alg.CoreFunSem
                                                (@pair
                                                   (prod (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (prod
                                                         (prod (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (@pair (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (prod
                                                         (prod (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...)))))) raw
                                                      (@pair
                                                         (prod (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...)))))
                                                         (@pair (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))) ax ay) az)) ng)))
                                          (and
                                             (forall (b : Values.block) (hi : BinNums.Z)
                                                (_ : @List.In (prod Values.block BinNums.Z)
                                                       (@pair Values.block BinNums.Z b hi)
                                                       (@cons (prod Values.block BinNums.Z)
                                                          (@pair Values.block BinNums.Z br
                                                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...)))))
                                                          (@cons (prod Values.block BinNums.Z)
                                                             (@pair Values.block BinNums.Z bk
                                                                (BinNums.Zpos (BinNums.xO (BinNums.xO ...))))
                                                             (@cons (prod Values.block BinNums.Z)
                                                                (@pair Values.block BinNums.Z ba
                                                                   (BinNums.Zpos (BinNums.xO ...)))
                                                                (@cons (prod Values.block BinNums.Z)
                                                                   (@pair Values.block BinNums.Z bng (BinNums.Zpos ...))
                                                                   (@nil (prod Values.block BinNums.Z))))))),
                                              Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                                             (and
                                                (forall h : bool, jet_secp_generator_globals.generator_table_state h mf)
                                                (jet_sx_mem.lframe
                                                   (fun (b : Values.block) (_ : BinNums.Z) =>
                                                    not
                                                      (@List.In Values.block b
                                                         (@cons Values.block br
                                                            (@cons Values.block bk
                                                               (@cons Values.block ba (@cons Values.block bng ...))))))
                                                   m mf))))))))))))))
