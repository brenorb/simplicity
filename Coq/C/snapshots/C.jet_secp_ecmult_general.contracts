                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                   (@nil (prod Values.block BinNums.Z))))))),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem raw)))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bng BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem ng)))))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val
                   (Values.Vint
                      (jet_readBit_layout.bit_int
                         (Bit.toBool
                            (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem
                               (@pair
                                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
