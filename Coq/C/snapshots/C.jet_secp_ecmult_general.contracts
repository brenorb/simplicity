### C.jet_secp_ecmult_general.eval_ecmult_general
eval_ecmult_general
     : forall (_ : jet_memset_model.memset_model)
         (raw ng ax ay az : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (x y z : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (br bk ba bng : Values.block)
         (_ : forall h : bool, jet_secp_generator_globals.generator_table_state h m)
         (_ : jet_secp_split_constants.split_constants_ready m) (_ : jet_secp_beta_global.beta_initialized m)
         (_ : @List.NoDup Values.block
                (@cons Values.block br
                   (@cons Values.block bk (@cons Values.block ba (@cons Values.block bng (@nil Values.block))))))
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (@cons (prod Values.block BinNums.Z)
                          (@pair Values.block BinNums.Z br
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                          (@cons (prod Values.block BinNums.Z)
                             (@pair Values.block BinNums.Z bk
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                             (@cons (prod Values.block BinNums.Z)
                                (@pair Values.block BinNums.Z ba
