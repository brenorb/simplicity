### C.jet_secp_generator_hash_literal.generator_hash_prefix
generator_hash_prefix =
fun second : bool =>
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
  match second return BinNums.Z with
  | true =>
      BinNums.Zpos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
  | false =>
      BinNums.Zpos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
  end
     : forall _ : bool, Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))

