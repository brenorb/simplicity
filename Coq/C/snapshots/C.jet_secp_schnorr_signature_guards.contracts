### C.jet_secp_schnorr_signature_guards.exec_schnorr_scalar_reject
exec_schnorr_scalar_reject
     : forall (pk msg r s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bs bsig bf : Values.block)
         (_ : BinInt.Z.le jet_secp_canonical_scalar.canonical_group_order
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) s))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._s e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._overflow e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bf Ctypesdefs.tint)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_scalar_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._sig64 le)
                (@Some Values.val (Values.Vptr bsig Integers.Ptrofs.zero))) (_ : not (@eq Values.block bs bsig))
         (_ : not (@eq Values.block bf bs)) (_ : not (@eq Values.block bf bsig))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bsig BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bsig
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes s))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (jet_secp_root_chain_owned.root_drop_statements (S (S (S (S O))))
                     (Clight.fn_body jets_secp.f_secp256k1_schnorrsig_verify)) Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type (Values.Vint Integers.Int.zero) Ctypesdefs.tint))))
               (and
                  (@eq bool
                     (Bit.toBool
                        (@jet_secp_schnorr_verify_literal.literal_bip0340_check Alg.CoreFunSem
                           (@pair
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk msg)
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) r s)))) false)
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and
                        (jet_sx_mem.lframe
                           (fun (block : Values.block) (pos : BinNums.Z) =>
                            and
                              (not
                                 (jet_sx_state.foot
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z bsig
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bf BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z)))))
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape jet_secp_scalar_set_flag.scalar_flag_regs) block pos))
                              (not (@eq Values.block block bf))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
