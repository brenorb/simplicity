### C.jet_asset_local_counter.sha_chain_overflow
sha_chain_overflow
     : forall (c : Integers.Int64.int) (m n : BinNums.Z)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned c)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 m)
                (BinInt.Z.le m
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))),
       @eq bool
         (jet_elements_support_sha_uchars_exec.uc_overflow
            (jet_elements_support_sha_uchars_exec.uc_overflow false c (Integers.Int64.repr m))
            (Integers.Int64.add c (Integers.Int64.repr m)) (Integers.Int64.repr n))
         (jet_elements_support_sha_uchars_exec.uc_overflow false c (Integers.Int64.repr (BinInt.Z.add m n)))
### C.jet_asset_local_counter.asset_amount_counter
asset_amount_counter
     : forall (c : Integers.Int64.int) (a : Ty.tySem jet_amount_exec_common.amount_value_type),
       @eq Integers.Int64.int
         (Integers.Int64.add
            (Integers.Int64.add c
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (Integers.Int64.repr (jet_amount_exec_common.amount_count a)))
         (Integers.Int64.add c
            (Integers.Int64.repr
               (BinInt.Z.add (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (jet_amount_exec_common.amount_count a))))
### C.jet_asset_local_counter.asset_amount_overflow
asset_amount_overflow
     : forall (c : Integers.Int64.int) (a : Ty.tySem jet_amount_exec_common.amount_value_type)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned c)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))))),
       @eq bool
         (jet_amount_exec_common.amount_overflow (jet_amount_exec_compose.asset_overflow false c)
            (Integers.Int64.add c
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) a)
         (jet_elements_support_sha_uchars_exec.uc_overflow false c
            (Integers.Int64.repr
               (BinInt.Z.add (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (jet_amount_exec_common.amount_count a))))
