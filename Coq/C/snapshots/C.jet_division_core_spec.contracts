### C.jet_division_core_spec.div_mod_word_spec
div_mod_word_spec =
fun (n : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp
  (Ty.Prod
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) (Nat.add O n)) (Word.Word n))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
     (Ty.Prod
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) (Nat.add O n)) (Word.Word n)))
  (Ty.Prod (Word.Word (Nat.add O n))
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) (Nat.add O n))) term
  (@Alg.Core.Combinators.pair
     (Ty.Prod
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) (Nat.add O n)) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit)
     (Ty.Prod
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) (Nat.add O n)) (Word.Word n)) term
     (@Alg.Core.Combinators.drop
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
