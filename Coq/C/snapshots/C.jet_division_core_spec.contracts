                  end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Word.Word n) (Word.Word n) term
           (@Alg.Core.Combinators.iden (Word.Word n) term))) (@jet_order_spec.lt_word_spec term n))
     : forall (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word (S n)) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit)

