                  | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                  end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Word.Word n)) (Word.Word n) (Word.Word n) term
        (@Alg.Core.Combinators.take
           (Ty.Prod (Word.Word n)
              ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
