               match n0 return Ty.Ty with
               | O => X
               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
               end) (Ty.Sum Ty.Unit Ty.Unit) n) term)))
  (@Alg.Core.Combinators.comp (Word.Word (S n))
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) n) (Ty.Sum Ty.Unit Ty.Unit) term (@modulo_word_spec n term)
     (@jet_test_value_spec.is_zero_word_spec n term))
     : forall (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod
            ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                match n0 return Ty.Ty with
                | O => X
                | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                end) (Ty.Sum Ty.Unit Ty.Unit) n)
            ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                match n0 return Ty.Ty with
                | O => X
                | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Ty.Sum Ty.Unit Ty.Unit)

Arguments divides_word_spec n%nat_scope {term}
