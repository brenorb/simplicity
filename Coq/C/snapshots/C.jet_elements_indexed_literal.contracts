### C.jet_elements_indexed_literal.elements_indexed_literal_matches
@elements_indexed_literal_matches
     : forall (E X : Type) (B : Ty.Ty) (elems : forall _ : E, list X) (old literal : forall _ : X, Ty.tySem B)
         (_ : forall x : X, @eq (Ty.tySem B) (old x) (literal x))
         (a : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))) (environment : E),
       @eq (option (sum unit (Ty.tySem B)))
         (@Some (sum unit (Ty.tySem B))
            match
              @List.nth_error X (elems environment)
                (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
              return (sum unit (Ty.tySem B))
            with
            | Some x => @inr unit (Ty.tySem B) (old x)
            | None => @inl unit (Ty.tySem B) tt
            end) (@elements_indexed_literal_result E X B elems literal a environment)
### C.jet_elements_indexed_literal.haskell_encode_outpoint_matches
haskell_encode_outpoint_matches
     : forall op : jet_elements_prim.outpoint,
       @eq
         (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))))
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
            (Word.from_hash256 (jet_elements_prim.opHash op))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
               (Integers.Int.unsigned (jet_elements_prim.opIndex op)))) (haskell_encode_outpoint op)
