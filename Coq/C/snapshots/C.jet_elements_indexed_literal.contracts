### C.jet_elements_indexed_literal.elements_indexed_literal_result
elements_indexed_literal_result =
fun (E X : Type) (B : Ty.Ty) (elems : forall _ : E, list X) (encode : forall _ : X, Ty.tySem B)
  (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : E) =>
@Some (sum unit (Ty.tySem B))
  match
    @List.nth_error X (elems environment)
      (BinInt.Z.to_nat (jet_elements_sequence_literal.haskell_from_word (S (S (S (S (S O))))) a))
    return (sum unit (Ty.tySem B))
  with
  | Some x => @inr unit (Ty.tySem B) (encode x)
  | None => @inl unit (Ty.tySem B) tt
  end
     : forall (E X : Type) (B : Ty.Ty) (_ : forall _ : E, list X) (_ : forall _ : X, Ty.tySem B)
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : E), option (Ty.tySem (Ty.Sum Ty.Unit B))

Arguments elements_indexed_literal_result {E X}%type_scope {B}%ty_scope (elems encode)%function_scope a environment
### C.jet_elements_indexed_literal.haskell_encode_outpoint
haskell_encode_outpoint =
fun op : jet_elements_prim.outpoint =>
@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
  (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
     (jet_haskell_hash_word.haskell_integer_hash256 (Digest.hash256_to_bytelist (jet_elements_prim.opHash op))))
  (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S O)))))
     (Integers.Int.unsigned (jet_elements_prim.opIndex op)))
     : forall _ : jet_elements_prim.outpoint,
       Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))

Arguments haskell_encode_outpoint op
### C.jet_elements_indexed_literal.elements_input_prev_outpoint_literal_spec
elements_input_prev_outpoint_literal_spec =
@elements_indexed_literal_result jet_elements_prim.Elements.environment jet_elements_prim.sigTxInput
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
  (fun e : jet_elements_prim.Elements.environment => jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
  (fun txi : jet_elements_prim.sigTxInput => haskell_encode_outpoint (jet_elements_prim.sigTxiPreviousOutpoint txi))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.environment),
       option
         (Ty.tySem
            (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))))

Arguments elements_input_prev_outpoint_literal_spec a environment
### C.jet_elements_indexed_literal.elements_current_prev_outpoint_literal_spec
elements_current_prev_outpoint_literal_spec =
@jet_elements_current_sequence_literal.elements_current_literal_result
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
  elements_input_prev_outpoint_literal_spec
     : forall (_ : Ty.tySem Ty.Unit) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))

Arguments elements_current_prev_outpoint_literal_spec _ environment
### C.jet_elements_indexed_literal.elements_output_script_hash_literal_spec
elements_output_script_hash_literal_spec =
@elements_indexed_literal_result jet_elements_prim.Elements.environment jet_elements_prim.txOutput
  (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (fun e : jet_elements_prim.Elements.environment => jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx e))
  (fun txo : jet_elements_prim.txOutput =>
   jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
     (jet_haskell_hash_word.haskell_integer_hash256
        (Digest.hash256_to_bytelist (Digest.byteStringHash (jet_elements_prim.txoScript txo)))))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.environment),
       option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments elements_output_script_hash_literal_spec a environment
