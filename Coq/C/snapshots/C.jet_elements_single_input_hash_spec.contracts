### C.jet_elements_single_input_hash_spec.elements_single_input_hash_spec
elements_single_input_hash_spec =
fun alg : jet_elements_words_hash_program.EFP.Algebra =>
let term : Alg.Assertion.Algebra := jet_elements_words_hash_program.EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_buffer_empty_spec.AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.Prod
        (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.Prod
        (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
     (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
     (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
        jet_elements_prim.Elements.InputPegin)
     (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
        (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
        (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
           alg jet_elements_prim.Elements.InputPrevOutpoint)
        (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
           (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg jet_elements_prim.Elements.InputSequence)
           (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
              (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
              jet_elements_prim.Elements.InputAnnexHash))))
  (@jet_buffer_empty_spec.AC.case Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     elements_single_input_tail_type (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Alg.Assertion.toCore term)
     (@jet_buffer_empty_spec.AC.injl (Ty.Prod Ty.Unit elements_single_input_tail_type) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Alg.Assertion.toCore term)
        (@jet_buffer_empty_spec.AC.unit (Ty.Prod Ty.Unit elements_single_input_tail_type) (Alg.Assertion.toCore term)))
     (@jet_buffer_empty_spec.AC.injr
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) elements_single_input_tail_type)
        Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Alg.Assertion.toCore term)
