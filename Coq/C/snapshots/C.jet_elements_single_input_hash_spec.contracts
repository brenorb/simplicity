### C.jet_elements_single_input_hash_spec.elements_single_input_bytes
elements_single_input_bytes =
fun (pg : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (op : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
  (sq : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
  (ax : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) =>
@app (Ty.tySem (Word.Word (S (S (S O)))))
  (@app (Ty.tySem (Word.Word (S (S (S O)))))
     (jet_elements_outpoints_hash_program.elements_outpoint_bytes
        (@pair (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))) pg op))
     (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S O)) sq)) (jet_bitcoin_tx_hash.annex_elem_bytes ax)
     : forall (_ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (_ : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (_ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))),
       list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments elements_single_input_bytes pg op sq ax
### C.jet_elements_single_input_hash_spec.elements_single_input_result
elements_single_input_result =
fun (e : jet_elements_prim.Elements.env) (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error jet_elements_prim.sigTxInput (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))
  return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| Some txi =>
    @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Word.from_hash256
         (jet_bitcoin_composite_hash.sha256_bytes_of
            (elements_single_input_bytes
               match
                 jet_elements_prim.sigTxiPegin txi
                 return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               with
               | Some h => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
               | None =>
                   @inl unit
                     (prod
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                               match n return Ty.Ty with
                               | O => X
                               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                               match n return Ty.Ty with
                               | O => X
                               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
               end
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
                  (Word.from_hash256 (jet_elements_prim.opHash (jet_elements_prim.sigTxiPreviousOutpoint txi)))
                  (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
                     (Integers.Int.unsigned (jet_elements_prim.opIndex (jet_elements_prim.sigTxiPreviousOutpoint txi)))))
               (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
                  (Integers.Int.unsigned (jet_elements_prim.sigTxiSequence txi)))
               match
                 jet_elements_prim.sigTxiAnnex txi
                 return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               with
               | Some bs =>
                   @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.from_hash256 (Digest.byteStringHash bs))
               | None =>
                   @inl unit
                     (prod
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                               match n return Ty.Ty with
                               | O => X
                               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                               match n return Ty.Ty with
                               | O => X
                               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
               end)))
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
end
     : forall (_ : jet_elements_prim.Elements.env) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments elements_single_input_result e i
