### C.jet_secp_field_sum_bounds.field_tight_scaled
field_tight_scaled
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_field_mul_small.mul_small_input_bounds w),
       field_scaled_bounds (BinNums.Zpos BinNums.xH) w
### C.jet_secp_field_sum_bounds.field_sum_scaled_no_overflow
field_sum_scaled_no_overflow
     : forall (n m : BinNums.Z) (a b : forall _ : nat, Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 n)
         (_ : BinInt.Z.le BinNums.Z0 m)
         (_ : BinInt.Z.le (BinInt.Z.add n m) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
         (_ : field_scaled_bounds n a) (_ : field_scaled_bounds m b) (i : nat) (_ : lt i (S (S (S (S (S O)))))),
       BinInt.Z.le (BinInt.Z.add (Integers.Int64.unsigned (a i)) (Integers.Int64.unsigned (b i)))
         Integers.Int64.max_unsigned
### C.jet_secp_field_sum_bounds.field_sum_scaled_bounds
field_sum_scaled_bounds
     : forall (n m : BinNums.Z) (a b : forall _ : nat, Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 n)
         (_ : BinInt.Z.le BinNums.Z0 m)
         (_ : BinInt.Z.le (BinInt.Z.add n m) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
         (_ : field_scaled_bounds n a) (_ : field_scaled_bounds m b),
       field_scaled_bounds (BinInt.Z.add n m) (jet_secp_field_add_scaled.field_sum_words a b)
### C.jet_secp_field_sum_bounds.field_sum_exact_value
field_sum_exact_value
     : forall (a b : forall _ : nat, Integers.Int64.int)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.le (BinInt.Z.add (Integers.Int64.unsigned (a i)) (Integers.Int64.unsigned (b i)))
                Integers.Int64.max_unsigned),
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (jet_secp_field_add_scaled.field_sum_words a b))
         (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value a)
            (jet_secp_multiply_finish_product.radix_value b))
### C.jet_secp_field_sum_bounds.field_scaled_loose
field_scaled_loose
     : forall (n : BinNums.Z) (w : forall _ : nat, Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.le n (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : field_scaled_bounds n w), jet_secp_square_columns.square_input_bounds w
### C.jet_secp_field_sum_bounds.field_sum_twice_value
field_sum_twice_value
     : forall (a b : forall _ : nat, Integers.Int64.int) (_ : jet_secp_field_mul_small.mul_small_input_bounds a)
         (_ : jet_secp_field_mul_small.mul_small_input_bounds b),
       and
         (@eq BinNums.Z
            (jet_secp_multiply_finish_product.radix_value
               (jet_secp_field_add_scaled.field_sum_words (jet_secp_field_add_scaled.field_sum_words a b) b))
            (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value a)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (jet_secp_multiply_finish_product.radix_value b))))
         (field_scaled_bounds (BinNums.Zpos (BinNums.xI BinNums.xH))
            (jet_secp_field_add_scaled.field_sum_words (jet_secp_field_add_scaled.field_sum_words a b) b))
### C.jet_secp_field_sum_bounds.field_scaled_bounds
field_scaled_bounds =
fun (n : BinNums.Z) (w : forall _ : nat, Integers.Int64.int) =>
forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
BinInt.Z.lt (Integers.Int64.unsigned (w i))
  (BinInt.Z.mul n
     match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
     | true =>
         BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))))))
     | false =>
         BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))))))
     end)
     : forall (_ : BinNums.Z) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments field_scaled_bounds n%Z_scope w%function_scope
