### C.jet_secp_multiply_run_run.field_table_correct
field_table_correct
     : forall (id : AST.ident) (ent : jet_sx_exec.fentry)
         (_ : @eq (option jet_sx_exec.fentry) (jet_sx_exec.flookup field_table id) (@Some jet_sx_exec.fentry ent)),
       and
         (@ex Values.block
            (fun b : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                     id) (@Some Values.block b))
               (@eq (option Clight.fundef)
                  (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type
                     (Clight.genv_genv jet_secp_linkage.secp_ge) b)
                  (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (jet_sx_exec.fentry_fd ent))))))
         match ent return Prop with
         | jet_sx_exec.FInt _ => True
         | jet_sx_exec.FOra fd o =>
             jet_sx_exec.oracle_ok jet_secp_linkage.secp_ge
               (fun (_ : forall _ : nat, Integers.Int64.int) (_ : jet_sx_eval.event) => True)
               (fun (_ : forall _ : nat, Integers.Int64.int) (_ : list jet_sx_eval.event) (_ : Memory.Mem.mem) => True)
               (fun _ : Values.block => False) fd o
         end
### C.jet_secp_multiply_run_run.field_fun_sound
field_fun_sound
     : forall (fuel : nat) (fd : Clight.function) (args : list jet_sx_expr.sx) (regs : list jet_sx_state.region)
         (nv : nat) (result : jet_sx_exec.res)
         (_ : @eq (option jet_sx_exec.res)
                (jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge)
                   (@nil (prod AST.ident (prod nat Ctypes.type))) field_table fuel fd args regs
                   (@nil jet_sx_eval.event) nv) (@Some jet_sx_exec.res result))
         (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Values.val
            (fun vres : Values.val =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m (@Ctypes.Internal Clight.function fd)
                  (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho (jet_sx_state.lay layout)) args) Events.E0
                  mf vres)
               (and
                  (jet_sx_state.rep rho layout
                     (jet_sx_eval.sregs
                        (@fst jet_sx_eval.sstate jet_sx_exec.xout
                           (jet_sx_exec.rsel rho (jet_sx_state.lay layout) result))) mf)
                  (and
                     match
                       @Maps.PTree.get jet_sx_expr.sx BinNums.xH
                         (jet_sx_eval.stemps
                            (@fst jet_sx_eval.sstate jet_sx_exec.xout
                               (jet_sx_exec.rsel rho (jet_sx_state.lay layout) result))) return Prop
                     with
                     | Some x => @eq Values.val vres (jet_sx_expr.den rho (jet_sx_state.lay layout) x)
                     | None => @eq Values.val vres Values.Vundef
                     end
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape
                              (jet_sx_eval.sregs
                                 (@fst jet_sx_eval.sstate jet_sx_exec.xout
                                    (jet_sx_exec.rsel rho (jet_sx_state.lay layout) result))))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape regs))
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot layout
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape regs) b ofs)) m mf))))))
### C.jet_secp_multiply_run_run.field_mul_completes
field_mul_completes
     : @eq bool
         match field_mul_run return bool with
         | Some r =>
             match r return bool with
             | jet_sx_exec.RDone _ o =>
                 match o return bool with
                 | jet_sx_exec.ONormal => true
                 | jet_sx_exec.OBreak => false
                 | jet_sx_exec.OContinue => false
                 | jet_sx_exec.OReturn _ => false
                 end
             | jet_sx_exec.RIf _ _ _ => false
             end
         | None => false
         end true
### C.jet_secp_multiply_run_run.field_mul_run_eq
field_mul_run_eq
     : @eq (option jet_sx_exec.res) field_mul_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone field_mul_state jet_sx_exec.ONormal))
### C.jet_secp_multiply_run_run.field_mul_return
field_mul_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps field_mul_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_multiply_run_run.field_mul_limbs_length
field_mul_limbs_length
     : @eq nat (@length jet_sx_expr.sx field_mul_limbs) (S (S (S (S (S O)))))
### C.jet_secp_multiply_run_run.field_cells_rebuild
field_cells_rebuild
     : forall (cs : list jet_sx_state.cell) (ofs : BinNums.Z)
         (_ : @eq (list (prod BinNums.Z AST.memory_chunk))
                (@List.map jet_sx_state.cell (prod BinNums.Z AST.memory_chunk) jet_sx_state.cshape cs)
                (field_u64_shapes ofs (@length jet_sx_state.cell cs))) (_ : @eq bool (field_cells_defined cs) true),
       @eq (list jet_sx_state.cell) cs
         (jet_sx_rep.u64_cells ofs (@List.map jet_sx_state.cell jet_sx_expr.sx field_cell_value cs))
### C.jet_secp_multiply_run_run.field_mul_out_shape
field_mul_out_shape
     : @eq (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
         (jet_sx_state.rshape field_mul_out)
         (@pair (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)
            (@pair (list (prod BinNums.Z AST.memory_chunk)) bool
               (@cons (prod BinNums.Z AST.memory_chunk) (@pair BinNums.Z AST.memory_chunk BinNums.Z0 AST.Mint64)
                  (@cons (prod BinNums.Z AST.memory_chunk)
                     (@pair BinNums.Z AST.memory_chunk (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                        AST.Mint64)
                     (@cons (prod BinNums.Z AST.memory_chunk)
                        (@pair BinNums.Z AST.memory_chunk
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) AST.Mint64)
                        (@cons (prod BinNums.Z AST.memory_chunk)
                           (@pair BinNums.Z AST.memory_chunk
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) AST.Mint64)
                           (@cons (prod BinNums.Z AST.memory_chunk)
                              (@pair BinNums.Z AST.memory_chunk
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 AST.Mint64) (@nil (prod BinNums.Z AST.memory_chunk))))))) true)
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
### C.jet_secp_multiply_run_run.field_mul_out_defined
field_mul_out_defined
     : @eq bool (field_cells_defined (jet_sx_state.rcells field_mul_out)) true
### C.jet_secp_multiply_run_run.field_mul_tail
field_mul_tail
     : @eq (list jet_sx_state.region) (@List.tl jet_sx_state.region (jet_sx_eval.sregs field_mul_state))
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg
               (jet_sx_rep.u64_cells BinNums.Z0
                  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S O))))))
                     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
                        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S O))))))))
                           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S O)))))))))
                              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S O))))))))))
                                 (@nil jet_sx_expr.sx))))))) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@nil jet_sx_state.region))
### C.jet_secp_multiply_run_run.field_mul_nonempty
field_mul_nonempty
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs field_mul_state)
         (@cons jet_sx_state.region field_mul_out (@List.tl jet_sx_state.region (jet_sx_eval.sregs field_mul_state)))
### C.jet_secp_multiply_run_run.field_mul_out_rebuild
field_mul_out_rebuild
     : @eq jet_sx_state.region field_mul_out
         (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 field_mul_limbs) true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
### C.jet_secp_multiply_run_run.field_mul_output
field_mul_output
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs field_mul_state)
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 field_mul_limbs) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons jet_sx_state.region
               (jet_sx_state.mkreg
                  (jet_sx_rep.u64_cells BinNums.Z0
                     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S O))))))
                        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
                           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S O))))))))
                              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S O)))))))))
                                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S O))))))))))
                                    (@nil jet_sx_expr.sx))))))) true
                  (@Some BinNums.Z
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
               (@nil jet_sx_state.region)))
### C.jet_secp_multiply_run_run.eval_field_mul_inner_owned_inplace
eval_field_mul_inner_owned_inplace
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout field_mul_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul_inner)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk layout (S O))
                           (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_sx_state.rep rho layout
                  (@cons jet_sx_state.region
                     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 field_mul_limbs) true
                        (@Some BinNums.Z
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@cons jet_sx_state.region
                        (jet_sx_state.mkreg
                           (jet_sx_rep.u64_cells BinNums.Z0
                              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S O))))))
                                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
                                    (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S O))))))))
                                       (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S O)))))))))
                                          (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S O))))))))))
                                             (@nil jet_sx_expr.sx))))))) true
                           (@Some BinNums.Z
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@nil jet_sx_state.region))) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape field_mul_regs) b ofs)) m mf)))
### C.jet_secp_multiply_run_run.field_table
field_table =
@cons (prod AST.ident jet_sx_exec.fentry)
  (@pair AST.ident jet_sx_exec.fentry jets_secp._secp256k1_u128_rshift
     (jet_sx_exec.FOra jets_secp.f_secp256k1_u128_rshift jet_secp_multiply_run_dispatch.field_shift_oracle))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
     : list (prod AST.ident jet_sx_exec.fentry)
### C.jet_secp_multiply_run_run.field_mul_regs
field_mul_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells BinNums.Z0
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O))))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O))))) (@nil jet_sx_expr.sx))))))) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (jet_sx_rep.u64_cells BinNums.Z0
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S O))))))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S O))))))))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S O)))))))))
                       (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S O))))))))))
                          (@nil jet_sx_expr.sx))))))) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     (@nil jet_sx_state.region))
     : list jet_sx_state.region
### C.jet_secp_multiply_run_run.field_mul_run
field_mul_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type))) field_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_mul_inner
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
     (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
        (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx)))) field_mul_regs
  (@nil jet_sx_eval.event) (S (S (S (S (S (S (S (S (S (S O))))))))))
     : option jet_sx_exec.res
### C.jet_secp_multiply_run_run.field_mul_state
field_mul_state =
match field_mul_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_multiply_run_run.field_mul_limbs
field_mul_limbs =
@List.map jet_sx_state.cell jet_sx_expr.sx
  (fun c : jet_sx_state.cell =>
   match jet_sx_state.cval c return jet_sx_expr.sx with
   | Some x => x
   | None => jet_sx_expr.XIc Integers.Int.zero
   end)
  (jet_sx_state.rcells
     (@List.hd jet_sx_state.region (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))
        (jet_sx_eval.sregs field_mul_state)))
     : list jet_sx_expr.sx
### C.jet_secp_multiply_run_run.field_u64_shapes
field_u64_shapes =
fix field_u64_shapes (ofs : BinNums.Z) (n : nat) {struct n} : list (prod BinNums.Z AST.memory_chunk) :=
  match n return (list (prod BinNums.Z AST.memory_chunk)) with
  | O => @nil (prod BinNums.Z AST.memory_chunk)
  | S k =>
      @cons (prod BinNums.Z AST.memory_chunk) (@pair BinNums.Z AST.memory_chunk ofs AST.Mint64)
        (field_u64_shapes (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) k)
  end
     : forall (_ : BinNums.Z) (_ : nat), list (prod BinNums.Z AST.memory_chunk)

Arguments field_u64_shapes ofs%Z_scope n%nat_scope
### C.jet_secp_multiply_run_run.field_cell_value
field_cell_value =
fun c : jet_sx_state.cell =>
match jet_sx_state.cval c return jet_sx_expr.sx with
| Some x => x
| None => jet_sx_expr.XIc Integers.Int.zero
end
     : forall _ : jet_sx_state.cell, jet_sx_expr.sx

Arguments field_cell_value c
### C.jet_secp_multiply_run_run.field_cells_defined
field_cells_defined =
fun cs : list jet_sx_state.cell =>
@List.forallb jet_sx_state.cell
  (fun c : jet_sx_state.cell => match jet_sx_state.cval c return bool with
                                | Some _ => true
                                | None => false
                                end) cs
     : forall _ : list jet_sx_state.cell, bool

Arguments field_cells_defined cs%list_scope
### C.jet_secp_multiply_run_run.field_mul_out
field_mul_out =
@List.hd jet_sx_state.region (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))
  (jet_sx_eval.sregs field_mul_state)
     : jet_sx_state.region
