### C.jet_division_recursive_spec.div2n1n_successor_unfold
div2n1n_successor_unfold
     : forall (n : nat) (a1 a2 a3 a4 b1 b2 : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (Word.Word (S (S n))))
         (@jet_division_core_spec.div2n1n_word_spec (S n) Alg.CoreFunSem
            (@pair
               (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                  (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))))
               (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
               (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                  (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a1 a2)
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a3 a4))
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) b1 b2)))
         match
           @jet_division_core_spec.div2n1n_conditions (S n) Alg.CoreFunSem
             (@pair
                (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                   (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))))
                (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                   (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                   (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a1 a2)
                   (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a3 a4))
                (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) b1 b2))
           return (Ty.tySem (Word.Word (S (S n))))
         with
         | inl _ => @jet_division_core_spec.division_high_word (S (S n)) Alg.CoreFunSem tt
         | inr _ =>
             let first : Ty.tySem (Ty.Prod (Word.Word n) (Word.Word (S n))) :=
               @jet_division_core_spec.div3n2n_word_builder n Alg.CoreFunSem
                 (@jet_division_core_spec.div2n1n_word_spec n Alg.CoreFunSem)
                 (@pair (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
                    (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                    (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                       (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a1 a2) a3)
                    (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) b1 b2)) in
             let second : Ty.tySem (Ty.Prod (Word.Word n) (Word.Word (S n))) :=
               @jet_division_core_spec.div3n2n_word_builder n Alg.CoreFunSem
                 (@jet_division_core_spec.div2n1n_word_spec n Alg.CoreFunSem)
                 (@pair
                    (prod
                       (prod
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end)
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) n))
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end)
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) n))) (Ty.tySem (Word.Word n)))
                    (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                    (@pair
                       (prod
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end)
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) n))
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end)
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) n))) (Ty.tySem (Word.Word n))
                       (@snd
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Word n))
                          (prod
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A B => sum (tySem A) (tySem B)
                                 | Ty.Prod A B => prod (tySem A) (tySem B)
                                 end)
                                ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                    match n0 return Ty.Ty with
                                    | O => X
                                    | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                    end) (Ty.Sum Ty.Unit Ty.Unit) n))
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A B => sum (tySem A) (tySem B)
                                 | Ty.Prod A B => prod (tySem A) (tySem B)
                                 end)
                                ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                    match n0 return Ty.Ty with
                                    | O => X
                                    | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                    end) (Ty.Sum Ty.Unit Ty.Unit) n))) first) a4)
                    (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) b1 b2)) in
             @pair
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n)))
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n)))
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n))
                  (@fst
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n))
                     (prod
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                               match n0 return Ty.Ty with
                               | O => X
                               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                               end) (Ty.Sum Ty.Unit Ty.Unit) n))
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                               match n0 return Ty.Ty with
                               | O => X
                               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                               end) (Ty.Sum Ty.Unit Ty.Unit) n))) first)
                  (@fst
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n))
                     (prod
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                               match n0 return Ty.Ty with
                               | O => X
                               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                               end) (Ty.Sum Ty.Unit Ty.Unit) n))
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end)
                           ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                               match n0 return Ty.Ty with
                               | O => X
                               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                               end) (Ty.Sum Ty.Unit Ty.Unit) n))) second))
               (@snd
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n))
                  (prod
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))) second)
         end
### C.jet_division_recursive_spec.div2n1n_normalized_value
div2n1n_normalized_value
     : forall n : nat,
       jet_division_approx_spec.division_normalized_result n
         (@jet_division_core_spec.div2n1n_word_spec n Alg.CoreFunSem)
