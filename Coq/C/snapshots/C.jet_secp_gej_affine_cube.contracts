### C.jet_secp_gej_affine_cube.affine_cube_fields
affine_cube_fields
     : forall (a b : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bo ba bb : Values.block)
         (_ : jet_sx_state.rep (jet_secp_point_mul_storage.point_mul_valuation a b)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bo BinNums.Z0)
