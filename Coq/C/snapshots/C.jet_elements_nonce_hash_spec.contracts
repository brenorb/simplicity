### C.jet_elements_nonce_hash_spec.elements_nonce_bytes
elements_nonce_bytes =
fun v : Ty.tySem elements_nonce_type =>
match v return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl _ =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_zero
      (@nil (Ty.tySem (Word.Word (S (S (S O))))))
| inr t =>
    match t return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
    | inl t0 =>
        match t0 return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
        | pair odd h =>
            @cons (Ty.tySem (Word.Word (S (S (S O)))))
              match odd return (Ty.tySem (Word.Word (S (S (S O))))) with
              | inl _ => nonce_byte_two
              | inr _ => nonce_byte_three
              end (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
        end
    | inr h =>
        @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_one
          (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
