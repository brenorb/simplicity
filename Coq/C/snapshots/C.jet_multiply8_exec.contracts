### C.jet_multiply8_exec.multiply8_arg_unsigned
multiply8_arg_unsigned
     : forall w : Integers.Int64.int,
       @eq BinNums.Z (Integers.Int64.unsigned (multiply8_arg (jet_read8.read8_result w)))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) (jet_spec.decode_word8 w))
### C.jet_multiply8_exec.multiply8_decode
multiply8_decode
     : forall w z : Integers.Int64.int,
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
         (jet_wide_spec.decode_wide jet_wide.W16
            (Integers.Int64.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
               (multiply8_payload (jet_read8.read8_result w) (jet_read8.read8_result z))))
         (@jet_multiply_spec.multiply_word_spec (S (S (S O))) Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))
               (jet_spec.decode_word8 w) (jet_spec.decode_word8 z)))
### C.jet_multiply8_exec.multiply8_body
multiply8_body
     : @eq Clight.statement (Clight.fn_body jets.f_simplicity_multiply_8)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (jet_binary8_exec.binary8_read jets._t'1)
                  (Clight.Sset jets._x (Clight.Ecast (Clight.Etempvar jets._t'1 Ctypesdefs.tuchar) Ctypesdefs.tulong)))
               (Clight.Ssequence
                  (Clight.Ssequence (jet_binary8_exec.binary8_read jets._t'2)
                     (Clight.Sset jets._y
                        (Clight.Ecast (Clight.Etempvar jets._t'2 Ctypesdefs.tuchar) Ctypesdefs.tulong)))
                  (Clight.Ssequence
                     (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write16 Ctypesdefs.tulong
                        Ctypesdefs.tvoid multiply8_expr)
                     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))))
### C.jet_multiply8_exec.eval_multiply8_expr
eval_multiply8_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r t : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._x le)
                (@Some Values.val (Values.Vlong (multiply8_arg r))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._y le)
                (@Some Values.val (Values.Vlong (multiply8_arg t)))),
       Clight.eval_expr jet_exec.ge0 e le m multiply8_expr (Values.Vlong (multiply8_payload r t))
### C.jet_multiply8_exec.eval_multiply8_composes
eval_multiply8_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc mr mr2 me mf : Memory.Mem.mem)
         (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (r t : Integers.Int.int) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vint t))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function jets.f_simplicity_write16)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (multiply8_payload r t)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_multiply_8)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_multiply8_exec.multiply8_arg
multiply8_arg =
fun r : Integers.Int.int => Integers.Int64.repr (Integers.Int.unsigned r)
     : forall _ : Integers.Int.int, Integers.Int64.int

Arguments multiply8_arg r
### C.jet_multiply8_exec.multiply8_payload
multiply8_payload =
fun r t : Integers.Int.int => Integers.Int64.mul (multiply8_arg r) (multiply8_arg t)
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int64.int

Arguments multiply8_payload r t
### C.jet_multiply8_exec.multiply8_expr
multiply8_expr =
Clight.Ebinop Cop.Omul (Clight.Etempvar jets._x Ctypesdefs.tulong) (Clight.Etempvar jets._y Ctypesdefs.tulong)
  Ctypesdefs.tulong
     : Clight.expr
### C.jet_multiply8_exec.le_multiply8_x
le_multiply8_x =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (r : Integers.Int.int) =>
@Maps.PTree.set Values.val jets._x (Values.Vlong (multiply8_arg r))
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vint r)
     (jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_multiply_8 bd dofs bs sofs))
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Integers.Int.int), Maps.PTree.tree Values.val

Arguments le_multiply8_x env bd dofs bs sofs r
### C.jet_multiply8_exec.le_multiply8_y
le_multiply8_y =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (r t : Integers.Int.int) =>
@Maps.PTree.set Values.val jets._y (Values.Vlong (multiply8_arg t))
  (@Maps.PTree.set Values.val jets._t'2 (Values.Vint t) (le_multiply8_x env bd dofs bs sofs r))
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Integers.Int.int) (_ : Integers.Int.int), Maps.PTree.tree Values.val

Arguments le_multiply8_y env bd dofs bs sofs r t
