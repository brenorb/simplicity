### C.jet_secp_table_affine_first.table_initial_h_identity
table_initial_h_identity
     : forall x : BinNums.Z,
       Zdiv.eqm jet_secp_fe_math.feP
         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
            (BinInt.Z.sub (BinInt.Z.mul x (jet_secp_table_affine_seed.table_curve_s x))
               (jet_secp_table_affine_seed.table_double_x x)))
         (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) x)
            (BinInt.Z.add (BinInt.Z.mul (BinInt.Z.mul x x) x)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
### C.jet_secp_table_affine_first.table_initial_h_nonzero
table_initial_h_nonzero
     : forall (x y : BinNums.Z)
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo
                   (BinInt.Z.add (BinInt.Z.mul (BinInt.Z.mul x x) x)
                      (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (BinInt.Z.mul y y) jet_secp_fe_math.feP)),
       not
         (@eq BinNums.Z
            (BinInt.Z.modulo
               (BinInt.Z.sub (BinInt.Z.mul x (jet_secp_table_affine_seed.table_curve_s x))
                  (jet_secp_table_affine_seed.table_double_x x)) jet_secp_fe_math.feP) BinNums.Z0)
