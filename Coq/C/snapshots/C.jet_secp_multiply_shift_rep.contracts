### C.jet_secp_multiply_shift_rep.shift52_lo_den
shift52_lo_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (lo hi : jet_sx_expr.sx),
       @eq Values.val (jet_sx_expr.den rho layout (shift52_lo_sx lo hi))
         (Values.Vlong
            (jet_secp_multiply_shift_shift.shift52_low (jet_sx_expr.il (jet_sx_expr.den rho layout lo))
               (jet_sx_expr.il (jet_sx_expr.den rho layout hi))))
### C.jet_secp_multiply_shift_rep.shift52_hi_den
shift52_hi_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (hi : jet_sx_expr.sx),
       @eq Values.val (jet_sx_expr.den rho layout (shift52_hi_sx hi))
         (Values.Vlong (jet_secp_multiply_shift_shift.shift52_high (jet_sx_expr.il (jet_sx_expr.den rho layout hi))))
### C.jet_secp_multiply_shift_rep.eval_shift52_symbolic_stores
eval_shift52_symbolic_stores
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout)
         (regs : list jet_sx_state.region) (m : Memory.Mem.mem) (r : nat) (reg : jet_sx_state.region)
         (lo hi : jet_sx_expr.sx) (regs1 regs2 : list jet_sx_state.region) (_ : jet_sx_state.rep rho layout regs m)
         (_ : @eq (option jet_sx_state.region) (@List.nth_error jet_sx_state.region regs r)
                (@Some jet_sx_state.region reg))
         (_ : @eq (option BinNums.Z) (jet_sx_state.rfree reg)
                (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : @eq (option jet_sx_expr.sx) (jet_sx_state.xload regs r BinNums.Z0 Ctypesdefs.tulong)
                (@Some jet_sx_expr.sx lo))
         (_ : @eq (option jet_sx_expr.sx)
                (jet_sx_state.xload regs r (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                   Ctypesdefs.tulong) (@Some jet_sx_expr.sx hi))
         (_ : @eq bool (jet_sx_expr.isk jet_sx_expr.KL lo) true)
         (_ : @eq bool (jet_sx_expr.isk jet_sx_expr.KL hi) true)
         (_ : @eq (option (list jet_sx_state.region))
                (jet_sx_state.xstore regs r BinNums.Z0 AST.Mint64 (shift52_lo_sx lo hi))
                (@Some (list jet_sx_state.region) regs1))
         (_ : @eq (option (list jet_sx_state.region))
                (jet_sx_state.xstore regs1 r (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                   AST.Mint64 (shift52_hi_sx hi)) (@Some (list jet_sx_state.region) regs2)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_u128_rshift)
               (@cons Values.val (Values.Vptr (jet_sx_state.blk layout r) Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vint
                        (Integers.Int.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho layout regs2 mf)
               (and
                  (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                     (@List.map jet_sx_state.region
                        (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        jet_sx_state.rshape regs2)
                     (@List.map jet_sx_state.region
                        (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        jet_sx_state.rshape regs))
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (jet_sx_state.foot layout
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape regs) b ofs)) m mf))))
### C.jet_secp_multiply_shift_rep.shift52_lo_sx
shift52_lo_sx =
fun lo hi : jet_sx_expr.sx =>
jet_sx_expr.XLb jet_sx_expr.Bor
  (jet_sx_expr.XLsh jet_sx_expr.Hshl (jet_sx_expr.XLb jet_sx_expr.Bmul (jet_sx_expr.XLc Integers.Int64.one) hi)
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))
  (jet_sx_expr.XLsh jet_sx_expr.Hshru lo
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
     : forall (_ : jet_sx_expr.sx) (_ : jet_sx_expr.sx), jet_sx_expr.sx

Arguments shift52_lo_sx lo hi
### C.jet_secp_multiply_shift_rep.shift52_hi_sx
shift52_hi_sx =
fun hi : jet_sx_expr.sx =>
jet_sx_expr.XLsh jet_sx_expr.Hshru hi
  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))
     : forall _ : jet_sx_expr.sx, jet_sx_expr.sx

Arguments shift52_hi_sx hi
