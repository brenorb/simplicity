### C.jet_secp_schnorr_check_predicate.secp_schnorr_point_failed
secp_schnorr_point_failed
     : forall (pk raw s r : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
                   (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (@inl unit unit tt) pk))
                (@inl unit
                   (prod
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt)),
       @eq bool
         (Bit.toBool
            (@jet_secp_point_verify_literal.literal_point_check Alg.CoreFunSem
               (@pair
                  (prod
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) raw
                        (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (@inr unit unit tt) pk)) s)
                  (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@inl unit unit tt) r))))
         false
### C.jet_secp_schnorr_check_predicate.secp_schnorr_check_predicate
secp_schnorr_check_predicate
     : forall pk msg r s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (Bit.toBool
            (@jet_secp_schnorr_verify_literal.literal_bip0340_check Alg.CoreFunSem
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk msg)
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) r s))))
         (secp_schnorr_check_test pk msg r s)
