eval_bitcoin_env_taproot
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (be : Values.block)
         (ebase : BinNums.Z) (bt : Values.block) (tbase : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase)))) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le
                (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr m be
                   (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase)))),
