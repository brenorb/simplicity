bitcoin_tappath_sem
     : forall (environment : jet_bitcoin_ext_prim.BitcoinExt.env) (a : Ty.tySem (Word.Word (S (S (S O))))),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
