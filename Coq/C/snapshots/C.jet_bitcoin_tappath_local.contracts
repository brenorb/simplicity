  (Clight.Scall (@Some AST.ident jets_bitcoin._t'1)
     (Clight.Evar jets_bitcoin._simplicity_read8
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)) Ctypes.Tnil)
           Ctypesdefs.tuchar AST.cc_default))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_bitcoin._src (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))) (@nil Clight.expr)))
  (Clight.Sset jets_bitcoin._i (Clight.Ecast (Clight.Etempvar jets_bitcoin._t'1 Ctypesdefs.tuchar) Ctypesdefs.tuchar))
     : Clight.statement
### C.jet_bitcoin_tappath_local.tappath_cond
tappath_cond =
Clight.Ssequence (Clight.Sset jets_bitcoin._t'5 bitcoin_env_taproot_expr)
  (Clight.Ssequence
     (Clight.Sset jets_bitcoin._t'6
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_bitcoin._t'5
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTapEnv Ctypes.noattr)))
              (Ctypes.Tstruct jets_bitcoin._bitcoinTapEnv Ctypes.noattr)) jets_bitcoin._pathLen Ctypesdefs.tuchar))
     (Clight.Scall (@Some AST.ident jets_bitcoin._t'2)
        (Clight.Evar jets_bitcoin._writeBit
           (Ctypes.Tfunction
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
                 (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
        (@cons Clight.expr
           (Clight.Etempvar jets_bitcoin._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
           (@cons Clight.expr
              (Clight.Ebinop Cop.Olt (Clight.Etempvar jets_bitcoin._i Ctypesdefs.tuchar)
                 (Clight.Etempvar jets_bitcoin._t'6 Ctypesdefs.tuchar) Ctypesdefs.tint) (@nil Clight.expr)))))
     : Clight.statement
### C.jet_bitcoin_tappath_local.tappath_then
tappath_then =
Clight.Ssequence (Clight.Sset jets_bitcoin._t'3 bitcoin_env_taproot_expr)
  (Clight.Ssequence
     (Clight.Sset jets_bitcoin._t'4
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_bitcoin._t'3
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTapEnv Ctypes.noattr)))
              (Ctypes.Tstruct jets_bitcoin._bitcoinTapEnv Ctypes.noattr)) jets_bitcoin._path
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._sha256_midstate Ctypes.noattr))))
     (Clight.Scall (@None AST.ident)
        (Clight.Evar jets_bitcoin._writeHash
           (Ctypes.Tfunction
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
                 (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._sha256_midstate Ctypes.noattr))
