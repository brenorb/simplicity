### C.jet_secp_tweak_group.xonly_tweak_saved_coordinates
xonly_tweak_saved_coordinates
     : forall
         (value : prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (m : Memory.Mem.mem)
         (b : Values.block)
         (_ : jet_secp_xonly_tweak_function.xonly_tweak_saved_result
                (@Some
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) value) m b),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun w : forall _ : nat, Integers.Int64.int =>
          and (jet_secp_affine_storage.affine_storage_readable m b BinNums.Z0 w)
            (and
               (@eq BinNums.Z (jet_secp_storage_numeric.field_storage_value w)
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                     (@fst (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) value)))
               (@eq BinNums.Z
                  (jet_secp_storage_numeric.field_storage_value (fun i : nat => w (Nat.add (S (S (S (S O)))) i)))
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                     (@snd (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) value)))))
