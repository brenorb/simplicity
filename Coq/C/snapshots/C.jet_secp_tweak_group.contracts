### C.jet_secp_tweak_group.eckey_tweak_point_group
eckey_tweak_point_group
     : forall (ng ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay))) true)
         (_ : jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
                (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay) p),
       jet_secp_jacobian_word_group.secp_jacobian_word_rep (GZnZ.one jet_secp_fe_math.feP)
         (jet_secp_eckey_tweak_prepare.eckey_tweak_point ng ax ay)
         (@SMain.add (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.sub jet_secp_fe_math.feP)
            (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP)
            (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
            jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory p
            (jet_secp_lookup5_group.secp_group_signed_power jet_secp_curve_group_power.secp_group_generator
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem ng))))
