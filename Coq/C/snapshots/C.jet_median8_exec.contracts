### C.jet_median8_exec.median8
median8 = jets.f_simplicity_median_8
     : Clight.function
### C.jet_median8_exec.median8_raw
median8_raw =
fun r t u : Integers.Int.int =>
@jet_median_control.median_decision Integers.Int.int (jet_order8_exec.order8_bit jet_order_spec.OLt r t)
  (jet_order8_exec.order8_bit jet_order_spec.OLt t u) (jet_order8_exec.order8_bit jet_order_spec.OLt u r)
  (jet_order8_exec.order8_bit jet_order_spec.OLt r u) (jet_order8_exec.order8_bit jet_order_spec.OLt u t)
  (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r)
  (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)
  (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) u)
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments median8_raw r t u
### C.jet_median8_exec.median8_payload
median8_payload =
fun r t u : Integers.Int.int =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (median8_raw r t u)
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments median8_payload r t u
