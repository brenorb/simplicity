### C.jet_secp_tagged_copy.tagged_sha_copy_source
tagged_sha_copy_source
     : @eq Clight.statement
         match Clight.fn_body jets_secp.f_sha256_tagged_init return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence first _ => first
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end tagged_sha_copy
### C.jet_secp_tagged_copy.eval_tagged_iv_address
eval_tagged_iv_address
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (biv : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._iv le)
                (@Some Values.val (Values.Vptr biv Integers.Ptrofs.zero))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m
         (Clight.Efield
            (Clight.Ederef
               (Clight.Etempvar jets_secp._iv
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr)))
               (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr)) jets_secp._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr biv Integers.Ptrofs.zero)
### C.jet_secp_tagged_copy.exec_tagged_sha_copy
exec_tagged_sha_copy
     : forall (_ : jet_memcpy_model.memcpy_model) (regs : list Integers.Int.int)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bs biv : Values.block)
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._memcpy e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._output le)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._iv le)
                (@Some Values.val (Values.Vptr biv Integers.Ptrofs.zero))) (_ : not (@eq Values.block bs biv))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m biv BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Readable) (_ : jet_uint32_array_init.uint32_array_at m biv BinNums.Z0 regs),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (list Memdata.memval)
            (fun bytes : list Memdata.memval =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m tagged_sha_copy Events.E0 le mf
                  ClightBigstep.Out_normal)
               (and
                  (@eq (option (list Memdata.memval))
                     (Memory.Mem.loadbytes m biv BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (@Some (list Memdata.memval) bytes))
                  (and
                     (@eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bs BinNums.Z0 bytes)
                        (@Some Memory.Mem.mem mf))
                     (and (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0 regs)
                        (and (jet_clight_internal_permissions.keeps_permissions m mf)
                           (and
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bs)) m mf)
                              (jet_clight_internal_preserve.readonly_preserved m mf))))))))
