### C.jet_copyBits_separation.copy_read_word_region
copy_read_word_region
     : forall (edge rc count j : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j count)),
       and
         (BinInt.Z.le
            (BinInt.Z.sub edge
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                  (jet_bitmachine_rep.frame_words (BinInt.Z.add rc count))))
            (BinInt.Z.sub edge
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                  (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                     (BinInt.Z.div (BinInt.Z.add rc j)
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (BinInt.Z.le
            (BinInt.Z.add
               (BinInt.Z.sub edge
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                     (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                        (BinInt.Z.div (BinInt.Z.add rc j)
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) edge)
### C.jet_copyBits_separation.copy_write_word_region
copy_write_word_region
     : forall (edge cursor j : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j cursor)),
       and (BinInt.Z.le edge (jet_write_layout.write_word_address edge (BinInt.Z.sub cursor j)))
         (BinInt.Z.le
            (BinInt.Z.add (jet_write_layout.write_word_address edge (BinInt.Z.sub cursor j))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
            (BinInt.Z.add edge
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                  (jet_bitmachine_rep.frame_words cursor))))
### C.jet_copyBits_separation.copy_buffers_separated_words
copy_buffers_separated_words
     : forall (bd bi bw : Values.block) (edge outedge cursor rc count j k : BinNums.Z)
         (_ : jet_context_separated.jet_copy_buffers_separated bd bi bw edge outedge cursor rc count)
         (_ : BinInt.Z.le BinNums.Z0 rc) (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j count))
         (_ : and (BinInt.Z.le BinNums.Z0 k) (BinInt.Z.lt k cursor)),
       or (not (@eq Values.block bi bw))
         (or
            (BinInt.Z.le
               (BinInt.Z.add
                  (BinInt.Z.sub edge
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                        (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                           (BinInt.Z.div (BinInt.Z.add rc j)
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
               (jet_write_layout.write_word_address outedge (BinInt.Z.sub cursor k)))
            (BinInt.Z.le
               (BinInt.Z.add (jet_write_layout.write_word_address outedge (BinInt.Z.sub cursor k))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
               (BinInt.Z.sub edge
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                     (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                        (BinInt.Z.div (BinInt.Z.add rc j)
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))
