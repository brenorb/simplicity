### C.jet_secp_scalar_mul_caller_body.exec_scalar_mul_product_call
exec_scalar_mul_product_call
     : forall (beta : jet_sx_state.layout) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val
                   (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val
                   (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                      (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O)))))))
         (_ : @eq BinNums.Z (jet_sx_state.bas beta O) BinNums.Z0)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
                (@cons Values.val
                   (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                   (@cons Values.val
                      (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                      (@cons Values.val
                         (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                            (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O))))) (@nil Values.val)))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (scalar_mul_caller_env beta) le m
         scalar_mul_product_stmt Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_scalar_mul_caller_body.exec_scalar_mul_reduction_call
exec_scalar_mul_reduction_call
     : forall (beta : jet_sx_state.layout) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val
                   (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))))
         (_ : @eq BinNums.Z (jet_sx_state.bas beta O) BinNums.Z0)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_reduce_512)
                (@cons Values.val
                   (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
