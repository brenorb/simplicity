### C.jet_secp_scalar_mul_caller_body.scalar_mul_caller_source
scalar_mul_caller_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_scalar_mul)
         (Clight.Ssequence scalar_mul_product_stmt scalar_mul_reduction_stmt)
### C.jet_secp_scalar_mul_caller_body.scalar_mul_product_linkage
scalar_mul_product_linkage
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
               jets_secp._secp256k1_scalar_mul_512)
            (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_scalar_mul_512)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
               (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_scalar_mul_512)
                  Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)))
### C.jet_secp_scalar_mul_caller_body.scalar_mul_reduction_linkage
scalar_mul_reduction_linkage
     : and
