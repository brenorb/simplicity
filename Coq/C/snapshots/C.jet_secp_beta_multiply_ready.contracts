### C.jet_secp_beta_multiply_ready.borrowed_output_owned
borrowed_output_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout (jet_secp_multiply_borrowed_call.borrowed_output_regs rho) m),
       and (@eq BinNums.Z (jet_sx_state.bas layout O) BinNums.Z0)
         (and
            (Memory.Mem.range_perm m (jet_sx_state.blk layout O) BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
               Memtype.Freeable)
            (jet_secp_fe_nv.fe_at m (jet_sx_state.blk layout O) (jet_sx_state.bas layout O)
               (jet_secp_multiply_normalize_bridge.words5 (jet_secp_multiply_finish_execute.original_finish_words rho))))
### C.jet_secp_beta_multiply_ready.borrowed_output_writer_rep
borrowed_output_writer_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (rc : BinNums.Z)
         (_ : jet_sx_state.rep rho layout (jet_secp_multiply_borrowed_call.borrowed_output_regs rho) m),
       jet_sx_state.rep (jet_secp_multiply_writer_bridge.product_writer_rho rho rc)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z (jet_sx_state.blk layout O) BinNums.Z0)
            (@nil (prod Values.block BinNums.Z))) jet_secp_local_regions.local_write_initial_regs m
### C.jet_secp_beta_multiply_ready.beta_foot_owners
beta_foot_owners
     : forall (ba b : Values.block) (ofs : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z)
                      (@pair Values.block BinNums.Z jet_secp_beta_global.beta_block BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   jet_secp_multiply_borrowed_call.borrowed_mul_regs) b ofs),
       or (@eq Values.block b ba) (@eq Values.block b jet_secp_beta_global.beta_block)
### C.jet_secp_beta_multiply_ready.eval_beta_with_precise_frame
eval_beta_with_precise_frame
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba : Values.block) (rc : BinNums.Z)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of (jet_secp_multiply_input_input.normalized_value x))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_secp_beta_global.beta_initialized m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr jet_secp_beta_global.beta_block Integers.Ptrofs.zero)
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_sx_state.rep
                  (jet_secp_multiply_writer_bridge.product_writer_rho (jet_secp_beta_inputs.beta_input_rho x) rc)
                  (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                     (@nil (prod Values.block BinNums.Z))) jet_secp_local_regions.local_write_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_secp_beta_global.beta_initialized mf)
                     (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b ba)) m mf)))))
