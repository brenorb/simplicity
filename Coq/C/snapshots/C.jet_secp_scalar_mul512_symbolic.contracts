### C.jet_secp_scalar_mul512_symbolic.column_bind_den
column_bind_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : nat) (x : jet_sx_expr.sx),
       @eq Values.val (jet_sx_expr.den rho beta (column_bind a b x))
         (jet_sx_expr.den
            (fun n : nat =>
             match PeanoNat.Nat.eqb n O return Integers.Int64.int with
             | true => rho a
             | false => rho b
             end) beta x)
### C.jet_secp_scalar_mul512_symbolic.column_symbolic_product_lo_den
column_symbolic_product_lo_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : nat),
       @eq Values.val (jet_sx_expr.den rho beta (column_symbolic_product_lo a b))
         (Values.Vlong (jet_secp_umul128_numeric.umul128_lo_machine (rho a) (rho b)))
### C.jet_secp_scalar_mul512_symbolic.column_symbolic_product_hi_den
column_symbolic_product_hi_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
