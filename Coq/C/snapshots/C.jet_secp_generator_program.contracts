### C.jet_secp_generator_program.generator_combine_app
generator_combine_app
     : forall (A B : Type) (xs xs' : list A) (ys ys' : list B) (_ : @eq nat (@length A xs) (@length B ys)),
       @eq (list (prod A B)) (@List.combine A B (@app A xs xs') (@app B ys ys'))
         (@app (prod A B) (@List.combine A B xs ys) (@List.combine A B xs' ys'))
