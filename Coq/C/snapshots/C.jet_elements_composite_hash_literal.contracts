### C.jet_elements_composite_hash_literal.literal_elements_fixed_vector_hash_matches
literal_elements_fixed_vector_hash_matches
     : forall (k : nat) (alg : EFP.Algebra)
         (payload : EFP.domain alg Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)),
       @eq (EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@literal_elements_fixed_vector_hash k alg payload)
         (@jet_elements_composite_amounts_hash.elements_fixed_vector_hash_spec k alg payload)
