### C.jet_elements_composite_hash_literal.literal_elements_fixed_vector_hash
literal_elements_fixed_vector_hash =
fun (k : nat) (alg : EFP.Algebra) (payload : EFP.domain alg Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) =>
let term : Alg.Assertion.Algebra := EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@AC.comp Ty.Unit (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k) core
     (@jet_sha_hash_words_literal.literal_sha_hash_ctx_init core) payload)
  (@AC.comp (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k))
     jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_ctx8_literal.literal_ctx8_addn k term) (@jet_sha_finalize_literal.literal_ctx8_finalize term))
     : forall (k : nat) (alg : EFP.Algebra) (_ : EFP.domain alg Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)),
       EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments literal_elements_fixed_vector_hash k%nat_scope {alg} payload
### C.jet_elements_composite_hash_literal.literal_elements_outputs_hash
literal_elements_outputs_hash =
fun alg : EFP.Algebra =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore (EFP.CanonicalStructures.toAssertion alg) in
@literal_elements_fixed_vector_hash (S (S (S (S (S (S (S O))))))) alg
  (@AC.pair Ty.Unit
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_elements_amounts_hash_literal.literal_elements_output_amounts_hash alg)
        (@jet_elements_nonces_hash_literal.literal_elements_output_nonces_hash alg))
     (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_elements_array_hash_literal.literal_elements_output_scripts_hash alg)
        (@jet_elements_array_hash_literal.literal_elements_output_range_proofs_hash alg)))
     : forall alg : EFP.Algebra, EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments literal_elements_outputs_hash {alg}
### C.jet_elements_composite_hash_literal.literal_elements_input_utxos_hash
literal_elements_input_utxos_hash =
fun alg : EFP.Algebra =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore (EFP.CanonicalStructures.toAssertion alg) in
@literal_elements_fixed_vector_hash (S (S (S (S (S (S O)))))) alg
  (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_elements_amounts_hash_literal.literal_elements_input_amounts_hash alg)
     (@jet_elements_array_hash_literal.literal_elements_input_scripts_hash alg))
     : forall alg : EFP.Algebra, EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments literal_elements_input_utxos_hash {alg}
