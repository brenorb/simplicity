### C.jet_secp_schnorr_challenge_literal.literal_bip0340_challenge_parametric
literal_bip0340_challenge_parametric
     : @Alg.Core.Parametric literal_bip0340_args (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@literal_bip0340_challenge)
### C.jet_secp_schnorr_challenge_literal.literal_bip0340_challenge_value
literal_bip0340_challenge_value
     : forall pk msg r s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@literal_bip0340_challenge Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk msg)
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) r s)))
         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem
            (jet_secp_schnorr_challenge_hash.schnorr_challenge_hash_word r pk msg))
### C.jet_secp_schnorr_challenge_literal.eval_schnorr_challenge_literal
eval_schnorr_challenge_literal
     : forall (_ : jet_memcpy_model.memcpy_model) (pk msg r s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (m : Memory.Mem.mem) (be ba : Values.block) (oa : Integers.Ptrofs.int) (bm : Values.block)
         (om : Integers.Ptrofs.int) (bp : Values.block) (op : Integers.Ptrofs.int)
         (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : Memory.Mem.range_perm m be BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned op)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned om)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_secp_schnorr_challenge_absorb.schnorr_bytes_at m ba oa
                (jet_secp_schnorr_challenge_hash.schnorr_word_bytes r))
         (_ : jet_secp_schnorr_challenge_absorb.schnorr_bytes_at m bp op
                (jet_secp_schnorr_challenge_hash.schnorr_word_bytes pk))
         (_ : jet_secp_schnorr_challenge_absorb.schnorr_bytes_at m bm om
                (jet_secp_schnorr_challenge_hash.schnorr_word_bytes msg)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_schnorrsig_challenge)
               (@cons Values.val (Values.Vptr be Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba oa)
                     (@cons Values.val (Values.Vptr bm om)
                        (@cons Values.val
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           (@cons Values.val (Values.Vptr bp op) (@nil Values.val)))))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf be BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@literal_bip0340_challenge Alg.CoreFunSem
                              (@pair
                                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                 (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk msg)
                                 (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) r s)))))))
               (and
                  (Memory.Mem.range_perm mf be BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b be)) m mf)
                     (and (jet_clight_internal_preserve.readonly_preserved m mf)
                        (jet_secp_sha_startup.secp_sha_startup mf))))))
