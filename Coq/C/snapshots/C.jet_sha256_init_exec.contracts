### C.jet_sha256_init_exec.sha_init_entry
sha_init_entry
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bc br bi : Values.block) (input : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block ma bc)),
       Clight.function_entry2 jet_exec.ge0 jets.f_sha256_init
         (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input)) (@nil Values.val))) m
         (sha_init_env bc) (sha_init_temps br bi input) ma
### C.jet_sha256_init_exec.eval_sha256_init_composes
eval_sha256_init_composes
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mi mz me mf : Memory.Mem.mem) (bc br bi : Values.block)
         (input : BinNums.Z) (bytes : list Memdata.memval) (_ : not (@eq Values.block bc br))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block ma bc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 ma (@Ctypes.Internal Clight.function jets.f_sha256_iv)
                (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input)) (@nil Values.val)) Events.E0 mi
                Values.Vundef)
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (sha_init_env bc) (sha_init_temps br bi input) mi
                jet_sha256_init_fields_layout.sha_ctx_fields_stmt Events.E0 (sha_init_temps br bi input) mz
                ClightBigstep.Out_normal)
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mz bc BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mz br BinNums.Z0 bytes) (@Some Memory.Mem.mem me))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bc BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_sha256_init)
         (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input)) (@nil Values.val))) Events.E0 mf
         Values.Vundef
### C.jet_sha256_init_exec.sha_init_env
sha_init_env =
fun bc : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets.___compound
  (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets._sha256_context Ctypes.noattr)) Clight.empty_env
     : forall _ : Values.block, Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments sha_init_env bc
### C.jet_sha256_init_exec.sha_init_temps
sha_init_temps =
fun (br bi : Values.block) (input : BinNums.Z) =>
@Maps.PTree.set Values.val jets._output (Values.Vptr bi (Integers.Ptrofs.repr input))
  (@Maps.PTree.set Values.val jets.__res (Values.Vptr br Integers.Ptrofs.zero)
     (Clight.create_undef_temps (Clight.fn_temps jets.f_sha256_init)))
     : forall (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments sha_init_temps br bi input%Z_scope
