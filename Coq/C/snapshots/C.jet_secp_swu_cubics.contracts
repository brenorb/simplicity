### C.jet_secp_swu_cubics.exec_swu_cubic_square_call
exec_swu_cubic_square_call
     : forall (r a : BinNums.positive) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m mf : Memory.Mem.mem) (br ba : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) r e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) a e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (swu_cubic_square r a) Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_cubics.exec_swu_cubic_multiply_call
exec_swu_cubic_multiply_call
     : forall (r a : BinNums.positive) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m mf : Memory.Mem.mem) (br ba : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) r e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) a e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (swu_cubic_multiply r a) Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_cubics.exec_swu_cubic_add_call
exec_swu_cubic_add_call
     : forall (r : BinNums.positive) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m mf : Memory.Mem.mem) (br : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) r e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add_int)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (swu_cubic_add r) Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_cubics.exec_swu_cubic
exec_swu_cubic
     : forall (r a : BinNums.positive) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (br ba : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) r e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) a e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : not (@eq Values.block br ba)) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (swu_cubic_prefix r a) Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (swu_cubic_words w)))
               (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and
                     (Memory.Mem.range_perm mf br BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf ba BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_secp_field_sum_bounds.field_scaled_bounds (BinNums.Zpos (BinNums.xO BinNums.xH))
                              (swu_cubic_words w))
                           (and (jet_secp_square_columns.square_input_bounds (swu_cubic_words w))
                              (and
                                 (Zdiv.eqm jet_secp_fe_math.feP
                                    (jet_secp_multiply_finish_product.radix_value (swu_cubic_words w))
                                    (jet_secp_swu_candidates.swu_cubic (jet_secp_multiply_finish_product.radix_value w)))
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block b br)) (not (@eq Values.block b ba))) m mf)
                                    (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
### C.jet_secp_swu_cubics.swu_cubic_spec_match
swu_cubic_spec_match
     : forall (value x a : BinNums.Z) (_ : Zdiv.eqm jet_secp_fe_math.feP value (jet_secp_swu_candidates.swu_cubic x))
         (_ : Zdiv.eqm jet_secp_fe_math.feP x a),
       Zdiv.eqm jet_secp_fe_math.feP value (jet_secp_swu_candidates.swu_cubic a)
### C.jet_secp_swu_cubics.swu_cubics_source
swu_cubics_source
     : @eq Clight.statement jet_secp_swu_third_candidate.swu_after_third_candidate
         (jet_secp_statement_prefix.statement_sequence swu_cubics_statements swu_after_cubics)
### C.jet_secp_swu_cubics.swu_two_keep_free
swu_two_keep_free
     : forall (m mf : Memory.Mem.mem) (br ba : Values.block) (blocks : list Values.block)
         (_ : jet_sx_mem.lframe
                (fun (b : Values.block) (_ : BinNums.Z) =>
                 and (not (@eq Values.block b br)) (not (@eq Values.block b ba))) m mf)
         (_ : Memory.Mem.range_perm mf br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm mf ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : @List.Forall Values.block
                (fun b : Values.block =>
                 Memory.Mem.range_perm m b BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   Memtype.Cur Memtype.Freeable) blocks),
       @List.Forall Values.block
         (fun b : Values.block =>
          Memory.Mem.range_perm mf b BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable) blocks
### C.jet_secp_swu_cubics.swu_two_keep_field
swu_two_keep_field
     : forall (m mf : Memory.Mem.mem) (br ba b : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : not (@eq Values.block b br)) (_ : not (@eq Values.block b ba))
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_sx_mem.lframe
                (fun (b0 : Values.block) (_ : BinNums.Z) =>
                 and (not (@eq Values.block b0 br)) (not (@eq Values.block b0 ba))) m mf),
       jet_secp_fe_nv.fe_at mf b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w)
### C.jet_secp_swu_cubics.exec_swu_cubics
exec_swu_cubics
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (ba bb bc bA bB bC : Values.block) (a b c : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._alphain e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bA jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._betain e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bB jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._gammain e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bC jet_secp_curve_statements.curve_fe_type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block ba
                   (@cons Values.block bb
                      (@cons Values.block bc
                         (@cons Values.block bA (@cons Values.block bB (@cons Values.block bC (@nil Values.block))))))))
         (_ : jet_secp_square_columns.square_input_bounds a) (_ : jet_secp_square_columns.square_input_bounds b)
         (_ : jet_secp_square_columns.square_input_bounds c)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : jet_secp_fe_nv.fe_at m bc BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 c))
         (_ : @List.Forall Values.block
                (fun bi : Values.block =>
                 Memory.Mem.range_perm m bi BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   Memtype.Cur Memtype.Freeable)
                (@cons Values.block ba
                   (@cons Values.block bb
                      (@cons Values.block bc
                         (@cons Values.block bA (@cons Values.block bB (@cons Values.block bC (@nil Values.block)))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_cubics_prefix Events.E0 le mf
               ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
               (and (jet_secp_fe_nv.fe_at mf bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
                  (and (jet_secp_fe_nv.fe_at mf bc BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 c))
                     (and
                        (jet_secp_fe_nv.fe_at mf bA BinNums.Z0
                           (jet_secp_multiply_normalize_bridge.words5 (swu_cubic_words a)))
                        (and
                           (jet_secp_fe_nv.fe_at mf bB BinNums.Z0
                              (jet_secp_multiply_normalize_bridge.words5 (swu_cubic_words b)))
                           (and
                              (jet_secp_fe_nv.fe_at mf bC BinNums.Z0
                                 (jet_secp_multiply_normalize_bridge.words5 (swu_cubic_words c)))
                              (and
                                 (@List.Forall Values.block
                                    (fun bi : Values.block =>
                                     Memory.Mem.range_perm mf bi BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (@cons Values.block ba
                                       (@cons Values.block bb
                                          (@cons Values.block bc
                                             (@cons Values.block bA
                                                (@cons Values.block bB (@cons Values.block bC (@nil Values.block))))))))
                                 (and
                                    (jet_secp_field_sum_bounds.field_scaled_bounds
                                       (BinNums.Zpos (BinNums.xO BinNums.xH)) (swu_cubic_words a))
                                    (and (jet_secp_square_columns.square_input_bounds (swu_cubic_words a))
                                       (and
                                          (jet_secp_field_sum_bounds.field_scaled_bounds
                                             (BinNums.Zpos (BinNums.xO BinNums.xH)) (swu_cubic_words b))
                                          (and (jet_secp_square_columns.square_input_bounds (swu_cubic_words b))
                                             (and
                                                (jet_secp_field_sum_bounds.field_scaled_bounds
                                                   (BinNums.Zpos (BinNums.xO BinNums.xH)) (swu_cubic_words c))
                                                (and (jet_secp_square_columns.square_input_bounds (swu_cubic_words c))
                                                   (and
                                                      (Zdiv.eqm jet_secp_fe_math.feP
                                                         (jet_secp_multiply_finish_product.radix_value
                                                            (swu_cubic_words a))
                                                         (jet_secp_swu_candidates.swu_cubic
                                                            (jet_secp_multiply_finish_product.radix_value a)))
                                                      (and
                                                         (Zdiv.eqm jet_secp_fe_math.feP
                                                            (jet_secp_multiply_finish_product.radix_value
                                                               (swu_cubic_words b))
                                                            (jet_secp_swu_candidates.swu_cubic
                                                               (jet_secp_multiply_finish_product.radix_value b)))
                                                         (and
                                                            (Zdiv.eqm jet_secp_fe_math.feP
                                                               (jet_secp_multiply_finish_product.radix_value
                                                                  (swu_cubic_words c))
                                                               (jet_secp_swu_candidates.swu_cubic
                                                                  (jet_secp_multiply_finish_product.radix_value c)))
                                                            (and
                                                               (jet_sx_mem.lframe
                                                                  (fun (bi : Values.block) (_ : BinNums.Z) =>
                                                                   not (@List.In Values.block bi (...))) m mf)
                                                               (jet_clight_internal_preserve.readonly_preserved m mf)))))))))))))))))))
### C.jet_secp_swu_cubics.swu_cubic_square
swu_cubic_square =
fun r a : AST.ident =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_sqr jets_secp.f_secp256k1_fe_sqr
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address r)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address a) (@nil Clight.expr)))
     : forall (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments swu_cubic_square r a
### C.jet_secp_swu_cubics.swu_cubic_multiply
swu_cubic_multiply =
fun r a : AST.ident =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address r)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address r)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address a) (@nil Clight.expr))))
     : forall (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments swu_cubic_multiply r a
### C.jet_secp_swu_cubics.swu_cubic_add
swu_cubic_add =
fun r : AST.ident =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_add_int jets_secp.f_secp256k1_fe_add_int
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address r)
     (@cons Clight.expr
        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) Ctypesdefs.tint)
        (@nil Clight.expr)))
     : forall _ : AST.ident, Clight.statement

Arguments swu_cubic_add r
### C.jet_secp_swu_cubics.swu_cubic_statements
swu_cubic_statements =
fun r a : AST.ident =>
@cons Clight.statement (swu_cubic_square r a)
  (@cons Clight.statement (swu_cubic_multiply r a) (@cons Clight.statement (swu_cubic_add r) (@nil Clight.statement)))
     : forall (_ : AST.ident) (_ : AST.ident), list Clight.statement

Arguments swu_cubic_statements r a
### C.jet_secp_swu_cubics.swu_cubic_prefix
swu_cubic_prefix =
fun r a : AST.ident => jet_secp_statement_prefix.statement_sequence (swu_cubic_statements r a) Clight.Sskip
     : forall (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments swu_cubic_prefix r a
### C.jet_secp_swu_cubics.swu_cubic_words
swu_cubic_words =
fun w : forall _ : nat, Integers.Int64.int =>
jet_secp_field_add_int.add_int_words (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))
  (jet_secp_field_pair_multiply.field_pair_product (jet_secp_square_numeric.square_words w) w)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments swu_cubic_words w%function_scope i%nat_scope
### C.jet_secp_swu_cubics.swu_cubics_statements
swu_cubics_statements =
@app Clight.statement (swu_cubic_statements jets_secp._alphain jets_secp._x1)
  (@app Clight.statement (swu_cubic_statements jets_secp._betain jets_secp._x2)
     (swu_cubic_statements jets_secp._gammain jets_secp._x3))
     : list Clight.statement
### C.jet_secp_swu_cubics.swu_cubics_prefix
swu_cubics_prefix =
jet_secp_statement_prefix.statement_sequence swu_cubics_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_swu_cubics.swu_after_cubics
swu_after_cubics =
match jet_secp_swu_third_candidate.swu_after_third_candidate return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
