     : BinNums.Z
### C.jet_secp_split_signed_bounds.split_signed_first
split_signed_first =
fun k : BinNums.Z =>
BinInt.Z.sub (BinInt.Z.sub k (BinInt.Z.mul split_lattice_b2 (jet_secp_split_multipliers.split_coefficient true k)))
  (BinInt.Z.mul split_lattice_a2 (jet_secp_split_multipliers.split_coefficient false k))
     : forall _ : BinNums.Z, BinNums.Z

Arguments split_signed_first k%Z_scope
### C.jet_secp_split_signed_bounds.split_signed_second
split_signed_second =
fun k : BinNums.Z =>
BinInt.Z.sub
  (BinInt.Z.mul (jet_secp_split_constants.split_basis_value true) (jet_secp_split_multipliers.split_coefficient true k))
  (BinInt.Z.mul split_lattice_b2 (jet_secp_split_multipliers.split_coefficient false k))
     : forall _ : BinNums.Z, BinNums.Z

Arguments split_signed_second k%Z_scope
### C.jet_secp_split_signed_bounds.split_lattice_q1
split_lattice_q1 =
BinInt.Z.div
  (BinInt.Z.sub
     (BinInt.Z.mul (jet_secp_split_constants.split_basis_value true)
        jet_secp_scalar_lambda_global.canonical_lambda_value) split_lattice_b2)
  jet_secp_canonical_scalar.canonical_group_order
     : BinNums.Z
### C.jet_secp_split_signed_bounds.split_lattice_q2
split_lattice_q2 =
BinInt.Z.div
  (BinInt.Z.sub (BinInt.Z.mul (BinInt.Z.opp split_lattice_b2) jet_secp_scalar_lambda_global.canonical_lambda_value)
     split_lattice_a2) jet_secp_canonical_scalar.canonical_group_order
     : BinNums.Z
