### C.jet_secp_split_signed_bounds.split_signed_bounds
split_signed_bounds
     : forall (k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 k) (BinInt.Z.lt k jet_secp_canonical_scalar.canonical_group_order)),
       and
         (and
            (BinInt.Z.lt
               (BinInt.Z.opp
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               (split_signed_first k))
            (BinInt.Z.lt (split_signed_first k)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (and
            (BinInt.Z.lt
               (BinInt.Z.opp
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               (split_signed_second k))
            (BinInt.Z.lt (split_signed_second k)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_split_signed_bounds.split_lattice_relations
split_lattice_relations
     : and
         (@eq BinNums.Z
            (BinInt.Z.mul (jet_secp_split_constants.split_basis_value true)
               jet_secp_scalar_lambda_global.canonical_lambda_value)
            (BinInt.Z.add split_lattice_b2
               (BinInt.Z.mul split_lattice_q1 jet_secp_canonical_scalar.canonical_group_order)))
         (@eq BinNums.Z
            (BinInt.Z.mul (BinInt.Z.opp split_lattice_b2) jet_secp_scalar_lambda_global.canonical_lambda_value)
            (BinInt.Z.add split_lattice_a2
               (BinInt.Z.mul split_lattice_q2 jet_secp_canonical_scalar.canonical_group_order)))
### C.jet_secp_split_signed_bounds.split_order_nonzero
split_order_nonzero
     : not (@eq BinNums.Z jet_secp_canonical_scalar.canonical_group_order BinNums.Z0)
### C.jet_secp_split_signed_bounds.split_second_signed
split_second_signed
     : forall k : BinNums.Z,
       @eq BinNums.Z (jet_secp_split_constants.split_second_value k)
         (BinInt.Z.modulo (split_signed_second k) jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_signed_bounds.split_negate_sum_mod
split_negate_sum_mod
     : forall x k : BinNums.Z,
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.modulo (BinInt.Z.opp (BinInt.Z.modulo x jet_secp_canonical_scalar.canonical_group_order))
                  jet_secp_canonical_scalar.canonical_group_order) k) jet_secp_canonical_scalar.canonical_group_order)
         (BinInt.Z.modulo (BinInt.Z.sub k x) jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_signed_bounds.split_sub_product_mod
split_sub_product_mod
     : forall k x y : BinNums.Z,
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.sub k (BinInt.Z.mul (BinInt.Z.modulo x jet_secp_canonical_scalar.canonical_group_order) y))
            jet_secp_canonical_scalar.canonical_group_order)
         (BinInt.Z.modulo (BinInt.Z.sub k (BinInt.Z.mul x y)) jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_signed_bounds.split_lattice_residue
split_lattice_residue
     : forall k c1 c2 : BinNums.Z,
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.sub k
               (BinInt.Z.mul
                  (BinInt.Z.sub (BinInt.Z.mul (jet_secp_split_constants.split_basis_value true) c1)
                     (BinInt.Z.mul split_lattice_b2 c2)) jet_secp_scalar_lambda_global.canonical_lambda_value))
            jet_secp_canonical_scalar.canonical_group_order)
         (BinInt.Z.modulo
            (BinInt.Z.sub (BinInt.Z.sub k (BinInt.Z.mul split_lattice_b2 c1)) (BinInt.Z.mul split_lattice_a2 c2))
            jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_signed_bounds.split_first_signed
split_first_signed
     : forall k : BinNums.Z,
       @eq BinNums.Z (jet_secp_split_constants.split_first_value k)
         (BinInt.Z.modulo (split_signed_first k) jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_signed_bounds.split_lattice_b2
split_lattice_b2 =
BinNums.Zpos
  (BinNums.xI
     (BinNums.xO
        (BinNums.xI
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
     : BinNums.Z
### C.jet_secp_split_signed_bounds.split_lattice_a2
split_lattice_a2 =
BinNums.Zpos
  (BinNums.xO
     (BinNums.xO
        (BinNums.xO
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xO
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xO
