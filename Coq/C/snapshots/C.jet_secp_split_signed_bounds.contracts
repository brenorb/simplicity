### C.jet_secp_split_signed_bounds.split_rounded_error
split_rounded_error
     : forall (first : bool) (k : BinNums.Z),
       and
         (BinInt.Z.lt
            (BinInt.Z.opp
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
            (BinInt.Z.sub
               (BinInt.Z.mul
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
                  (jet_secp_split_multipliers.split_coefficient first k))
               (BinInt.Z.mul k (jet_secp_split_multipliers.split_multiplier_value first))))
         (BinInt.Z.le
            (BinInt.Z.sub
               (BinInt.Z.mul
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
                  (jet_secp_split_multipliers.split_coefficient first k))
               (BinInt.Z.mul k (jet_secp_split_multipliers.split_multiplier_value first)))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
