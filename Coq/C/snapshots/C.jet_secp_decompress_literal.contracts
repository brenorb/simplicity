### C.jet_secp_decompress_literal.decompress_odd_parametric
decompress_odd_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit)
         (@jet_secp_canonical_odd.canonical_fe_is_odd)
### C.jet_secp_decompress_literal.literal_y_from_x_parametric
literal_y_from_x_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@literal_y_from_x)
### C.jet_secp_decompress_literal.literal_decompress_flip_parametric
literal_decompress_flip_parametric
     : @Alg.Core.Parametric
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
            (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (Ty.Sum Ty.Unit Ty.Unit) (@literal_decompress_flip)
### C.jet_secp_decompress_literal.literal_decompress_point_parametric
literal_decompress_point_parametric
     : @Alg.Core.Parametric
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
            (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@literal_decompress_point)
### C.jet_secp_decompress_literal.literal_decompress_parametric
literal_decompress_parametric
     : @Alg.Core.Parametric (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Sum Ty.Unit
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_decompress)
### C.jet_secp_decompress_literal.literal_y_from_x_step
literal_y_from_x_step
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_y_from_x Alg.CoreFunSem x)
         (@jet_secp_root_literal.literal_fe_square_root Alg.CoreFunSem
            (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) jet_secp_curve_literal.curve_seven_word
                  (@jet_secp_rescale_literal.literal_fe_cube Alg.CoreFunSem x))))
### C.jet_secp_decompress_literal.literal_decompress_flip_value
literal_decompress_flip_value
     : forall (y x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)),
       @eq bool
         (Bit.toBool
            (@literal_decompress_flip Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) y
                  (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     odd x))))
         (xorb (Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem y)) (Bit.toBool odd))
### C.jet_secp_decompress_literal.literal_decompress_point_step
literal_decompress_point_step
     : forall (y x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)),
       @eq
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_decompress_point Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) y
               (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) odd
                  x)))
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
            match
              xorb (Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem y)) (Bit.toBool odd)
              return (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            with
            | true => @jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem y
            | false => y
            end)
### C.jet_secp_decompress_literal.literal_decompress_step
literal_decompress_step
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)),
       @eq
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@literal_decompress Alg.CoreFunSem
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) odd x))
         match
           @literal_y_from_x Alg.CoreFunSem x
           return
             (Ty.tySem
                (Ty.Sum Ty.Unit
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | inl _ =>
             @inl unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
         | inr y =>
             @inr unit
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
                  match
                    xorb (Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem y)) (Bit.toBool odd)
                    return (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  with
                  | true => @jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem y
                  | false => y
                  end)
         end
### C.jet_secp_decompress_literal.literal_y_from_x
literal_y_from_x =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
  (@Alg.Core.Combinators.pair (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)
        (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) jet_secp_curve_literal.curve_seven_word term))
     (@jet_secp_rescale_literal.literal_fe_cube term))
  (@Alg.Core.Combinators.comp
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
     (@jet_secp_literal_add_program.literal_fe_add term) (@jet_secp_root_literal.literal_fe_square_root term))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments literal_y_from_x {term}
### C.jet_secp_decompress_literal.literal_decompress_flip
literal_decompress_flip =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
  (Ty.Sum Ty.Unit Ty.Unit) term
  (@Alg.Core.Combinators.pair
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.Sum Ty.Unit Ty.Unit)
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) term
     (@Alg.Core.Combinators.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit) term
        (@jet_secp_canonical_odd.canonical_fe_is_odd term))
     (@Alg.Core.Combinators.iden
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) term))
  (@Bit.cond
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.Sum Ty.Unit Ty.Unit) term
     (@Bit.not
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) term
        (@Alg.Core.Combinators.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum Ty.Unit Ty.Unit) term
           (@Alg.Core.Combinators.take (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Ty.Sum Ty.Unit Ty.Unit) term (@Alg.Core.Combinators.iden (Ty.Sum Ty.Unit Ty.Unit) term))))
     (@Alg.Core.Combinators.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit) term
        (@Alg.Core.Combinators.take (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Sum Ty.Unit Ty.Unit) term (@Alg.Core.Combinators.iden (Ty.Sum Ty.Unit Ty.Unit) term))))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
            (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (Ty.Sum Ty.Unit Ty.Unit)

Arguments literal_decompress_flip {term}
### C.jet_secp_decompress_literal.literal_decompress_point
literal_decompress_point =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.pair
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
  (@Alg.Core.Combinators.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term (@jet_secp_canonical_normalize.canonical_fe_normalize term)))
  (@Alg.Core.Combinators.comp
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Alg.Core.Combinators.pair
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term (@literal_decompress_flip term)
        (@Alg.Core.Combinators.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
           (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)))
     (@Bit.cond (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@jet_secp_negate_literal_contract.literal_fe_negate term)
        (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
            (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments literal_decompress_point {term}
### C.jet_secp_decompress_literal.literal_decompress
literal_decompress =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  term
  (@Alg.Core.Combinators.pair (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
     (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term (@literal_y_from_x term))
     (@Alg.Core.Combinators.iden (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term))
  (@Alg.Core.Combinators.case Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) term
     (@Alg.Core.Combinators.injl
        (Ty.Prod Ty.Unit (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
        (@Alg.Core.Combinators.unit
           (Ty.Prod Ty.Unit (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) term))
     (@Alg.Core.Combinators.injr
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
        (@literal_decompress_point term)))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Sum Ty.Unit
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments literal_decompress {term}
