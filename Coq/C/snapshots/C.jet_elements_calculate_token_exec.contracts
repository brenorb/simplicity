     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
            (Clight.genv_genv jet_elements_support_sha_linkage.sha_ge) jets_elements._is_confidential)
         (@Some Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._is_confidential))
### C.jet_elements_calculate_token_exec.sha_is_confidential_funct
sha_is_confidential_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
            (Clight.genv_genv jet_elements_support_sha_linkage.sha_ge)
            (Values.Vptr (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._is_confidential)
               Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_elements.f_is_confidential))
### C.jet_elements_calculate_token_exec.calcToken_body_shape
calcToken_body_shape
     : @eq Clight.statement (Clight.fn_body jets_elements.f_simplicity_calculateToken)
         (jet_elements_calculate_asset_exec.calc_zeros O
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))
            (Clight.Ssequence jet_elements_calculate_asset_exec.calc_memcpy
               (Clight.Ssequence ct_tok (jet_elements_calculate_asset_exec.calc_tail jets_elements._t'3))))
### C.jet_elements_calculate_token_exec.calcToken_entry
calcToken_entry
     : forall (m : Memory.Mem.mem) (m1 m2 : Memory.Mem.mem') (bB bR : Values.block) (vres vent vpfx : Values.val)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m1 bB))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bR)),
       Clight.function_entry2 jet_elements_support_sha_linkage.sha_ge jets_elements.f_simplicity_calculateToken
         (@cons Values.val vres (@cons Values.val vent (@cons Values.val vpfx (@nil Values.val)))) m
         (jet_elements_calculate_asset_exec.calc_env bB bR)
         (@Maps.PTree.set Values.val jets_elements._prefix vpfx
            (@Maps.PTree.set Values.val jets_elements._entropy vent
               (@Maps.PTree.set Values.val jets_elements.__res vres
                  (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_simplicity_calculateToken))))) m2
### C.jet_elements_calculate_token_exec.eval_is_confidential
eval_is_confidential
     : forall (m : Memory.Mem.mem) (pfx : Integers.Int.int),
       ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
         (@Ctypes.Internal Clight.function jets_elements.f_is_confidential)
         (@cons Values.val (Values.Vint pfx) (@nil Values.val)) Events.E0 m (Values.Vint (b2i (is_conf pfx)))
### C.jet_elements_calculate_token_exec.eval_calculateToken
eval_calculateToken
     : forall (_ : jet_memcpy_model.memcpy_model) (m : Memory.Mem.mem) (bres : Values.block)
         (ores : BinNums.Z) (bent : Values.block) (oent : Integers.Ptrofs.int) (ent : list Integers.Int.int)
         (pfx : Integers.Int.int) (_ : BinInt.Z.le BinNums.Z0 ores)
         (_ : BinInt.Z.le
                (BinInt.Z.add ores
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) ores)
         (_ : Memory.Mem.range_perm m bres ores
                (BinInt.Z.add ores
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable)
         (_ : @eq nat (@length Integers.Int.int ent) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oent)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bent
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oent)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j ent Integers.Int.zero))))
         (_ : jet_elements_support_sha_block_local.sha_dispatch_ok m),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_simplicity_calculateToken)
               (@cons Values.val (Values.Vptr bres (Integers.Ptrofs.repr ores))
                  (@cons Values.val (Values.Vptr bent oent) (@cons Values.val (Values.Vint pfx) (@nil Values.val))))
               Events.E0 m' Values.Vundef)
            (and
               (forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 m' bres
                     (BinInt.Z.add ores
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                  (@Some Values.val
                     (Values.Vint (@List.nth Integers.Int.int j (calc_token_regs ent pfx) Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : or (not (@eq Values.block b bres))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) ores)
                               (BinInt.Z.le
                                  (BinInt.Z.add ores
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
### C.jet_elements_calculate_token_exec.b2i
b2i =
fun c : bool => match c return Integers.Int.int with
                | true => Integers.Int.one
                | false => Integers.Int.zero
                end
     : forall _ : bool, Integers.Int.int

Arguments b2i c%bool_scope
### C.jet_elements_calculate_token_exec.ct_tok
ct_tok =
Clight.Ssequence
  (Clight.Ssequence
     (Clight.Scall (@Some AST.ident jets_elements._t'1)
        (Clight.Evar jets_elements._is_confidential
           (Ctypes.Tfunction (Ctypes.Tcons Ctypesdefs.tint Ctypes.Tnil) Ctypesdefs.tbool AST.cc_default))
        (@cons Clight.expr (Clight.Etempvar jets_elements._prefix Ctypesdefs.tint) (@nil Clight.expr)))
     (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'1 Ctypesdefs.tbool)
        (Clight.Sset jets_elements._t'2
           (Clight.Ecast
              (Clight.Econst_int
                 (Integers.Int.repr
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))
                 Ctypesdefs.tint) Ctypesdefs.tint))
        (Clight.Sset jets_elements._t'2
           (Clight.Ecast
              (Clight.Econst_int
                 (Integers.Int.repr
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))
                 Ctypesdefs.tint) Ctypesdefs.tint))))
  (Clight.Sassign
     (Clight.Ederef
        (Clight.Ebinop Cop.Oadd
           (Clight.Evar jets_elements._block
              (Ctypesdefs.tarray Ctypesdefs.tuint
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tuint)) Ctypesdefs.tuint)
     (Clight.Etempvar jets_elements._t'2 Ctypesdefs.tint))
     : Clight.statement
### C.jet_elements_calculate_token_exec.is_conf
is_conf =
fun pfx : Integers.Int.int =>
orb (Integers.Int.eq (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))) pfx)
  (Integers.Int.eq (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) pfx)
     : forall _ : Integers.Int.int, bool

Arguments is_conf pfx
### C.jet_elements_calculate_token_exec.token_word
token_word =
fun pfx : Integers.Int.int =>
match is_conf pfx return Integers.Int.int with
| true =>
    Integers.Int.repr
      (BinNums.Zpos
         (BinNums.xO
            (BinNums.xO
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))))))))
| false =>
    Integers.Int.repr
      (BinNums.Zpos
         (BinNums.xO
            (BinNums.xO
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))))))))
end
     : forall _ : Integers.Int.int, Integers.Int.int

Arguments token_word pfx
### C.jet_elements_calculate_token_exec.calc_token_regs
calc_token_regs =
fun (ent : list Integers.Int.int) (pfx : Integers.Int.int) =>
SHA256.hash_block jet_sha256_iv_init.sha256_iv_words
  (@app Integers.Int.int ent
     (@cons Integers.Int.int (token_word pfx)
        (@List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S O))))))))))
     : forall (_ : list Integers.Int.int) (_ : Integers.Int.int), list Integers.Int.int

Arguments calc_token_regs ent%list_scope pfx
