### C.jet_calculation_local_local.calculation_jet_from_helper
calculation_jet_from_helper
     : forall (f : Clight.function) (jid : AST.ident) (p : option BinNums.Z) (cf : Clight.function)
         (spec : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
                 Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_calculation_lifecycle_entry.calculation_frame_header f)
         (_ : @eq Clight.statement (Clight.fn_body f) (jet_calculation_lifecycle_shape.calc_body jid p))
         (_ : forall bl bh br bt : Values.block,
              @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jid
                   (jet_calculation_lifecycle_entry.calculation_frame_env bl bh br bt))
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.block)
                (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
                   (Clight.genv_genv jet_elements_linkage.elements_ge) jid)
                (@Some Values.block (jet_elements_linkage.elements_symbol_block jid)))
         (_ : @eq (option Clight.fundef)
                (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
                   (Clight.genv_genv jet_elements_linkage.elements_ge)
                   (Values.Vptr (jet_elements_linkage.elements_symbol_block jid) Integers.Ptrofs.zero))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function cf)))
         (_ : @eq Ctypes.type (Clight.type_of_fundef (@Ctypes.Internal Clight.function cf))
                (Ctypes.Tfunction
                   (Ctypes.Tcons jet_calculation_lifecycle_shape.calc_mid_ptr
                      (Ctypes.Tcons jet_calculation_lifecycle_shape.calc_mid_ptr
                         (jet_calculation_lifecycle_shape.calc_suffix_types p))) Ctypesdefs.tvoid
                   jet_calculation_lifecycle_shape.calc_cc))
         (_ : jet_calculation_calls_calculation_calls.elements_calculation_word_call cf
                (jet_calculation_lifecycle_shape.calc_suffix_values p) spec), calculation_jet_local_spec f spec
### C.jet_calculation_local_local.calc_asset_not_local
calc_asset_not_local
     : forall bl bh br bt : Values.block,
       @eq (option (prod Values.block Ctypes.type))
         (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._simplicity_calculateAsset
            (jet_calculation_lifecycle_entry.calculation_frame_env bl bh br bt))
         (@None (prod Values.block Ctypes.type))
### C.jet_calculation_local_local.calc_token_not_local
calc_token_not_local
     : forall bl bh br bt : Values.block,
       @eq (option (prod Values.block Ctypes.type))
         (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._simplicity_calculateToken
            (jet_calculation_lifecycle_entry.calculation_frame_env bl bh br bt))
         (@None (prod Values.block Ctypes.type))
### C.jet_calculation_local_local.calc_asset_link
calc_asset_link
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
               jets_elements._simplicity_calculateAsset)
            (@Some Values.block (jet_elements_linkage.elements_symbol_block jets_elements._simplicity_calculateAsset)))
         (and
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
                  (Clight.genv_genv jet_elements_linkage.elements_ge)
                  (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._simplicity_calculateAsset)
                     Integers.Ptrofs.zero))
               (@Some (Ctypes.fundef Clight.function)
                  (@Ctypes.Internal Clight.function jets_elements.f_simplicity_calculateAsset)))
            (@eq Ctypes.type
               (Clight.type_of_fundef (@Ctypes.Internal Clight.function jets_elements.f_simplicity_calculateAsset))
               (Ctypes.Tfunction
                  (Ctypes.Tcons jet_calculation_lifecycle_shape.calc_mid_ptr
                     (Ctypes.Tcons jet_calculation_lifecycle_shape.calc_mid_ptr
                        (jet_calculation_lifecycle_shape.calc_suffix_types (@None BinNums.Z)))) Ctypesdefs.tvoid
                  jet_calculation_lifecycle_shape.calc_cc)))
### C.jet_calculation_local_local.calc_token_link
calc_token_link
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
               jets_elements._simplicity_calculateToken)
            (@Some Values.block (jet_elements_linkage.elements_symbol_block jets_elements._simplicity_calculateToken)))
         (and
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
                  (Clight.genv_genv jet_elements_linkage.elements_ge)
                  (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._simplicity_calculateToken)
                     Integers.Ptrofs.zero))
               (@Some (Ctypes.fundef Clight.function)
                  (@Ctypes.Internal Clight.function jets_elements.f_simplicity_calculateToken)))
            (@eq Ctypes.type
               (Clight.type_of_fundef (@Ctypes.Internal Clight.function jets_elements.f_simplicity_calculateToken))
               (Ctypes.Tfunction
                  (Ctypes.Tcons jet_calculation_lifecycle_shape.calc_mid_ptr
                     (Ctypes.Tcons jet_calculation_lifecycle_shape.calc_mid_ptr
                        (jet_calculation_lifecycle_shape.calc_suffix_types (@Some BinNums.Z (BinNums.Zpos BinNums.xH)))))
                  Ctypesdefs.tvoid jet_calculation_lifecycle_shape.calc_cc)))
### C.jet_calculation_local_local.calculate_asset_local_spec
calculate_asset_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       calculation_jet_local_spec jets_elements.f_simplicity_calculate_asset
         (@jet_elements_issuance_calc_spec.calculate_asset_spec Alg.CoreFunSem)
### C.jet_calculation_local_local.calculate_explicit_token_local_spec
calculate_explicit_token_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       calculation_jet_local_spec jets_elements.f_simplicity_calculate_explicit_token
         (@jet_elements_issuance_calc_spec.calculate_explicit_token_spec Alg.CoreFunSem)
### C.jet_calculation_local_local.calculate_confidential_token_local_spec
calculate_confidential_token_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       calculation_jet_local_spec jets_elements.f_simplicity_calculate_confidential_token
         (@jet_elements_issuance_calc_spec.calculate_confidential_token_spec Alg.CoreFunSem)
### C.jet_calculation_local_local.calculation_jet_local_spec
calculation_jet_local_spec =
fun (f : Clight.function)
  (spec : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
          Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
  (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor rc : BinNums.Z)
  (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (_ : jet_calculation_calls_calculation_calls.elements_calculation_dispatch_ok m)
  (_ : jet_frame_layout.frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc) (_ : BinInt.Z.le BinNums.Z0 rc)
  (_ : BinInt.Z.le
         (BinInt.Z.add rc
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         Integers.Int64.max_unsigned)
  (_ : jet_encoding.frame_input_cells_at m bi edge rc
         (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h))
  (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
         (BinNums.Zpos
            (BinNums.xO
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m (@Ctypes.Internal Clight.function f)
        (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
           (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
        Events.E0 mf (Values.Vint Integers.Int.one))
     (and
        (jet_encoding.frame_output_cells_at mf bw outedge cursor
           (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (spec h)))
        (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
           (and
              (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                 (BinInt.Z.sub cursor
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
              (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                 (_ : or (not (@eq Values.block b bd))
                        (or
                           (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                              (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (BinInt.Z.le
                              (BinInt.Z.add dbase
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                 (_ : or (not (@eq Values.block b bw))
                        (or
                           (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                              (BinInt.Z.add outedge
                                 (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                    (BinInt.Z.div
                                       (BinInt.Z.sub cursor
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                           (BinInt.Z.le
                              (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
               @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))))))
     : forall (_ : Clight.function)
         (_ : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
              Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), Prop

Arguments calculation_jet_local_spec f spec%function_scope
