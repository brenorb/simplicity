### C.jet_write_wide_sequence.write_wide_sequence_run_layout
write_wide_sequence_run_layout
     : forall (s : jet_wide.wide_size) (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z)
         (bw : Values.block) (edge cursor : BinNums.Z) (xs : list Integers.Int64.int)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinInt.Z.mul (jet_wide.wide_bits s) (BinInt.Z.of_nat (@length Integers.Int64.int xs)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and (write_wide_sequence_run s bf base xs m mf)
            (and (jet_encoding.frame_output_cells_at mf bw edge cursor (wide_sequence_cells s xs))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bf base bw edge
                        (BinInt.Z.sub cursor
                           (BinInt.Z.mul (jet_wide.wide_bits s) (BinInt.Z.of_nat (@length Integers.Int64.int xs)))))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bf
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor
                                       (BinInt.Z.mul (jet_wide.wide_bits s)
                                          (BinInt.Z.of_nat (@length Integers.Int64.int xs))))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
### C.jet_write_wide_sequence.write_wide_sequence_run
write_wide_sequence_run =
fix write_wide_sequence_run
  (s : jet_wide.wide_size) (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int64.int)
  (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons x xs0 =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         and
           (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
              (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
              (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                 (@cons Values.val (Values.Vlong x) (@nil Values.val))) Events.E0 mi Values.Vundef)
           (write_wide_sequence_run s bf base xs0 mi mf))
  end
     : forall (_ : jet_wide.wide_size) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int64.int)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments write_wide_sequence_run s bf base%Z_scope xs%list_scope m mf
### C.jet_write_wide_sequence.wide_sequence_cells
wide_sequence_cells =
fun (s : jet_wide.wide_size) (xs : list Integers.Int64.int) =>
@List.concat BitMachine.Cell
  (@List.map Integers.Int64.int (list BitMachine.Cell)
     (fun x : Integers.Int64.int =>
      @Translate.encode (Word.Word (jet_wide.wide_log s))
        (jet_wide_spec.decode_wide s (Integers.Int64.zero_ext (jet_wide.wide_bits s) x))) xs)
     : forall (_ : jet_wide.wide_size) (_ : list Integers.Int64.int), list BitMachine.Cell

Arguments wide_sequence_cells s xs%list_scope
