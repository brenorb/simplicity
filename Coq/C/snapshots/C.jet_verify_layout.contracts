### C.jet_verify_layout.eval_verify_layout
eval_verify_layout
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi : Values.block) (edge : BinNums.Z) (bit : bool)
         (rc : BinNums.Z) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))))
         (_ : jet_input_layout.frame_input_bit_at m bi edge rc bit),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function jets.f_simplicity_verify)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf
               (Values.Vint (jet_readBit_layout.bit_int bit)))
            (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b),
             @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs)))
### C.jet_verify_layout.verify_local_spec
verify_local_spec
     : jet_partial.jet_partial_local_spec jets.f_simplicity_verify (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit
         (fun x : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit) =>
          @jet_assertion_spec.verify_spec (Alg.AssertionSem Option.option_Monad_Zero) x)
### C.jet_verify_layout.verify_silent_guarantees
verify_silent_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi : Values.block) (edge : BinNums.Z)
         (x : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (rc : BinNums.Z) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))))
         (_ : jet_input_layout.frame_input_bit_at m bi edge rc (Bit.toBool x)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees jet_exec.ge0
               (@Ctypes.Internal Clight.function jets.f_simplicity_verify)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m
               (@jet_partial.jet_partial_return (Ty.tySem Ty.Unit)
                  (@jet_assertion_spec.verify_spec (Alg.AssertionSem Option.option_Monad_Zero) x)) mf)
            (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b),
             @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs)))
