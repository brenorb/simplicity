### C.jet_elements_single_input_payload.eih_ctxi_u32be
eih_ctxi_u32be
     : forall (_ : jet_memcpy_model.memcpy_model) (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (m : Memory.Mem.mem) (l regs : list Integers.Int.int) (x c : Integers.Int64.int)
         (ovf : bool) (_ : jet_elements_support_sha_ctxi.ctxi m bx bm l regs c ovf),
       let ovf' : bool :=
         jet_elements_support_sha_uchars_exec.uc_overflow ovf c
           (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))) in
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_sha256_u32be)
               (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vlong x) (@nil Values.val))) Events.E0 m'
               (Values.Vint (jet_readBit_layout.bit_int (negb ovf'))))
            (and
               (jet_elements_support_sha_ctxi.ctxi m' bx bm
                  (@fst (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs
                        (jet_elements_support_sha_be32_write.c_be32_bytes x)))
                  (@snd (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs
                        (jet_elements_support_sha_be32_write.c_be32_bytes x)))
                  (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))) ovf')
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
### C.jet_elements_single_input_payload.eval_eih_optional_hash
eval_eih_optional_hash
     : forall (_ : jet_memcpy_model.memcpy_model) (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (m : Memory.Mem.mem) (bin : Values.block) (ofs : BinNums.Z) (h : option Digest.hash256)
         (l regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool)
         (_ : jet_elements_support_sha_ctxi.ctxi m bx bm l regs c ovf) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bin bx)) (_ : not (@eq Values.block bin bm))
         (_ : forall (h0 : Digest.hash256) (_ : @eq (option Digest.hash256) h (@Some Digest.hash256 h0)),
              jet_uint32_array_init.uint32_array_at m bin ofs (Digest.hash256_reg h0)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex bool
            (fun ovf' : bool =>
             and (eih_optional_calls bx bin ofs h m mf)
               (and
                  (jet_elements_support_sha_ctxi.ctxi mf bx bm
                     (@fst (list Integers.Int.int) (list Integers.Int.int)
                        (jet_elements_support_sha_uchars_prep.absorb_i l regs (eih_optional_bytes h)))
                     (@snd (list Integers.Int.int) (list Integers.Int.int)
                        (jet_elements_support_sha_uchars_prep.absorb_i l regs (eih_optional_bytes h)))
                     (Integers.Int64.add c
                        (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int (eih_optional_bytes h))))) ovf')
                  (and
                     (forall (ch : AST.memory_chunk) (b : Values.block) (o : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b) (_ : not (@eq Values.block b bx))
                        (_ : not (@eq Values.block b bm)),
                      @eq (option Values.val) (Memory.Mem.load ch mf b o) (Memory.Mem.load ch m b o))
                     (and
                        (forall (b : Values.block) (o : BinNums.Z) (k : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b o k p),
                         Memory.Mem.perm mf b o k p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
### C.jet_elements_single_input_payload.eih_optional_bytes
eih_optional_bytes =
fun h : option Digest.hash256 =>
match h return (list Integers.Int.int) with
| Some h0 =>
    @cons Integers.Int.int Integers.Int.one (jet_elements_support_sha_be32_write.be_bytes (Digest.hash256_reg h0))
| None => @cons Integers.Int.int Integers.Int.zero (@nil Integers.Int.int)
end
     : forall _ : option Digest.hash256, list Integers.Int.int

Arguments eih_optional_bytes h
### C.jet_elements_single_input_payload.eih_optional_calls
eih_optional_calls =
fun (bx bin : Values.block) (ofs : BinNums.Z) (h : option Digest.hash256) (m mf : Memory.Mem.mem) =>
match h return Prop with
| Some _ =>
    @ex Memory.Mem.mem
      (fun mi : Memory.Mem.mem =>
       @ex Values.val
         (fun vr : Values.val =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_sha256_uchar)
               (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val))) Events.E0 mi vr)
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge mi
               (@Ctypes.Internal Clight.function jets_elements.f_sha256_hash)
               (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)))
| None =>
    @ex Values.val
      (fun vr : Values.val =>
       ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
         (@Ctypes.Internal Clight.function jets_elements.f_sha256_uchar)
         (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vint Integers.Int.zero) (@nil Values.val))) Events.E0 mf vr)
end
     : forall (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : option Digest.hash256)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments eih_optional_calls bx bin ofs%Z_scope h m mf
