### C.jet_secp_multiply_finish_word.word_unsigned_injective
word_unsigned_injective
     : forall (a b : Integers.Int64.int) (_ : @eq BinNums.Z (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)),
       @eq Integers.Int64.int a b
### C.jet_secp_multiply_finish_word.machine_product_one
machine_product_one
     : forall a : Integers.Int64.int,
       @eq (prod Integers.Int64.int Integers.Int64.int)
         (jet_secp_multiply_checkpoint_machine.machine_product a Integers.Int64.one)
         (@pair Integers.Int64.int Integers.Int64.int a Integers.Int64.zero)
### C.jet_secp_multiply_finish_word.machine_accum_word_is_mul_one
machine_accum_word_is_mul_one
     : forall (s : prod Integers.Int64.int Integers.Int64.int) (a : Integers.Int64.int),
       @eq (prod Integers.Int64.int Integers.Int64.int) (jet_secp_multiply_checkpoint_machine.machine_accum_word s a)
         (jet_secp_multiply_checkpoint_machine.machine_accum s a Integers.Int64.one)
### C.jet_secp_multiply_finish_word.machine_accum_word_exact
machine_accum_word_exact
     : forall (s : prod Integers.Int64.int Integers.Int64.int) (a : Integers.Int64.int)
         (_ : BinInt.Z.lt
                (BinInt.Z.add (jet_secp_multiply_checkpoint_machine.pair_value s) (Integers.Int64.unsigned a))
                (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)),
       @eq BinNums.Z
         (jet_secp_multiply_checkpoint_machine.pair_value (jet_secp_multiply_checkpoint_machine.machine_accum_word s a))
         (BinInt.Z.add (jet_secp_multiply_checkpoint_machine.pair_value s) (Integers.Int64.unsigned a))
### C.jet_secp_multiply_finish_word.add_u64_exact
add_u64_exact
     : forall (a b : Integers.Int64.int)
         (_ : BinInt.Z.lt (BinInt.Z.add (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))))),
       @eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.add a b))
         (BinInt.Z.add (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
