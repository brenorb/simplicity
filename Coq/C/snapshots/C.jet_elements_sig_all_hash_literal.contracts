### C.jet_elements_sig_all_hash_literal.elements_sig_all_hash_of
elements_sig_all_hash_of =
fun e : jet_elements_prim.Elements.env =>
jet_bitcoin_composite_hash.sha256_bytes_of
  (@app (Ty.tySem (Word.Word (S (S (S O)))))
     (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S (S O)))))))
        (@pair
           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (elements_genesis_word e)
              (elements_genesis_word e))
           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.from_hash256 (jet_elements_tx_hash_literal.elements_tx_hash_of e))
              (Word.from_hash256 (jet_elements_tap_env_hash_program.elements_tap_env_hash_of e)))))
     (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S O)) (elements_current_index_word e)))
     : forall _ : jet_elements_prim.Elements.env, Digest.hash256

Arguments elements_sig_all_hash_of e
### C.jet_elements_sig_all_hash_literal.literal_elements_sig_all_hash
literal_elements_sig_all_hash =
fun alg : EFP.Algebra =>
let term : Alg.Assertion.Algebra := EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@AC.comp Ty.Unit (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S O)))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S O)))))) core
     (@AC.comp Ty.Unit
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
        jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           core (@jet_sha_hash_words_literal.literal_sha_hash_ctx_init core)
           (@AC.pair Ty.Unit
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              core
              (@AC.comp Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 core
                 (@EFP.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) alg
                    jet_elements_prim.Elements.GenesisBlockHash)
                 (@AC.pair (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                    (@AC.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) core)
                    (@AC.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) core)))
              (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_elements_tx_hash_literal.literal_elements_tx_hash alg)
                 (@jet_elements_tap_hash_literal.literal_elements_tap_env_hash alg))))
        (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S (S (S (S (S (S O))))))) term))
     (@EFP.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg jet_elements_prim.Elements.CurrentIndex))
  (@AC.comp (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S O))))
     jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S O)) term) (@jet_sha_finalize_literal.literal_ctx8_finalize term))
     : forall alg : EFP.Algebra, EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments literal_elements_sig_all_hash {alg}
