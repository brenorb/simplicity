### C.jet_elements_null_data_loads.elements_append_stmt
elements_append_stmt =
fix elements_append_stmt (s tail : Clight.statement) {struct s} : Clight.statement :=
  match s return Clight.statement with
  | Clight.Sskip => Clight.Ssequence s tail
  | Clight.Sassign _ _ => Clight.Ssequence s tail
  | Clight.Sset _ _ => Clight.Ssequence s tail
  | Clight.Scall _ _ _ => Clight.Ssequence s tail
  | Clight.Sbuiltin _ _ _ _ => Clight.Ssequence s tail
  | Clight.Ssequence a b => Clight.Ssequence a (elements_append_stmt b tail)
  | Clight.Sifthenelse _ _ _ => Clight.Ssequence s tail
  | Clight.Sloop _ _ => Clight.Ssequence s tail
  | Clight.Sbreak => Clight.Ssequence s tail
