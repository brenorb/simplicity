### C.jet_read8s_exec.read8s_reader_symbol
read8s_reader_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._simplicity_read8)
         (@Some Values.block (jet_exec.jet_symbol_block jets._simplicity_read8))
### C.jet_read8s_exec.read8s_reader_funct
read8s_reader_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._simplicity_read8) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_simplicity_read8))
### C.jet_read8s_exec.read8s_body_shape
read8s_body_shape
     : @eq Clight.statement (Clight.fn_body jets.f_read8s) (Clight.Sloop read8s_loop_body read8s_loop_step)
### C.jet_read8s_exec.exec_read8s_body
exec_read8s_body
     : forall (m mi ms : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (bi : Values.block)
         (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (x : Integers.Int.int)
         (count : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le (BinInt.Z.add input (BinNums.Zpos BinNums.xH)) Integers.Ptrofs.max_unsigned)
         (_ : and (BinInt.Z.lt BinNums.Z0 count) (BinInt.Z.le count Integers.Int64.max_unsigned))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._frame le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._x le)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr count))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mi
                (Values.Vint x))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint8unsigned mi bi input
                   (Values.Vint
                      (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) x)))
                (@Some Memory.Mem.mem ms)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m read8s_loop_body Events.E0
         (read8s_body_env le bi input x) ms ClightBigstep.Out_normal
### C.jet_read8s_exec.exec_read8s_run
exec_read8s_run
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bi : Values.block)
         (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
         (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le (BinInt.Z.add input (BinInt.Z.of_nat (@length Integers.Int.int xs)))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le (BinInt.Z.of_nat (@length Integers.Int.int xs)) Integers.Int64.max_unsigned)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._frame le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._x le)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int xs))))))
         (_ : read8s_run bi input bf base xs m mf),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m (Clight.fn_body jets.f_read8s) Events.E0
            lef mf ClightBigstep.Out_normal)
### C.jet_read8s_exec.read8s_entry
read8s_entry
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bi : Values.block) (input count : BinNums.Z),
       Clight.function_entry2 jet_exec.ge0 jets.f_read8s
         (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
            (@cons Values.val (Values.Vlong (Integers.Int64.repr count))
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) m Clight.empty_env
         (read8s_env bf base bi input count) m
### C.jet_read8s_exec.eval_read8s_from_run
eval_read8s_from_run
     : forall (m mf : Memory.Mem.mem) (bi : Values.block) (input : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (xs : list Integers.Int.int) (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le (BinInt.Z.add input (BinInt.Z.of_nat (@length Integers.Int.int xs)))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le (BinInt.Z.of_nat (@length Integers.Int.int xs)) Integers.Int64.max_unsigned)
         (_ : read8s_run bi input bf base xs m mf),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_read8s)
         (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
            (@cons Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int xs))))
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) Events.E0 mf
         Values.Vundef
### C.jet_read8s_exec.read8s_run
read8s_run =
fix read8s_run
  (bi : Values.block) (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
  (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons x rest =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         @ex Memory.Mem.mem
           (fun ms : Memory.Mem.mem =>
            and
              (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                 (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                 (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mi
                 (Values.Vint x))
              (and
                 (@eq (option Memory.Mem.mem)
                    (Memory.Mem.store AST.Mint8unsigned mi bi input
                       (Values.Vint
                          (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) x)))
                    (@Some Memory.Mem.mem ms))
                 (read8s_run bi (BinInt.Z.add input (BinNums.Zpos BinNums.xH)) bf base rest ms mf))))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int.int)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments read8s_run bi input%Z_scope bf base%Z_scope xs%list_scope m mf
### C.jet_read8s_exec.read8s_loop_body
read8s_loop_body =
match Clight.fn_body jets.f_read8s return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop body _ => body
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_read8s_exec.read8s_loop_step
read8s_loop_step =
Clight.Sset jets._n
  (Clight.Ebinop Cop.Osub (Clight.Etempvar jets._n Ctypesdefs.tulong)
     (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint) Ctypesdefs.tulong)
     : Clight.statement
### C.jet_read8s_exec.read8s_body_env
read8s_body_env =
fun (le : Maps.PTree.tree Values.val) (bi : Values.block) (input : BinNums.Z) (x : Integers.Int.int) =>
@Maps.PTree.set Values.val jets._t'2 (Values.Vint x)
  (@Maps.PTree.set Values.val jets._x
     (Values.Vptr bi (Integers.Ptrofs.repr (BinInt.Z.add input (BinNums.Zpos BinNums.xH))))
     (@Maps.PTree.set Values.val jets._t'1 (Values.Vptr bi (Integers.Ptrofs.repr input)) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int.int),
       Maps.PTree.tree Values.val

Arguments read8s_body_env le bi input%Z_scope x
### C.jet_read8s_exec.read8s_env
read8s_env =
fun (bf : Values.block) (base : BinNums.Z) (bi : Values.block) (input count : BinNums.Z) =>
@Maps.PTree.set Values.val jets._n (Values.Vlong (Integers.Int64.repr count))
  (@Maps.PTree.set Values.val jets._x (Values.Vptr bi (Integers.Ptrofs.repr input))
     (@Maps.PTree.set Values.val jets._frame (Values.Vptr bf (Integers.Ptrofs.repr base))
        (Clight.create_undef_temps (Clight.fn_temps jets.f_read8s))))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z),
       Maps.PTree.tree Values.val

Arguments read8s_env bf base%Z_scope bi (input count)%Z_scope
