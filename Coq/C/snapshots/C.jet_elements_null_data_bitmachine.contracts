### C.jet_elements_null_data_bitmachine.bm_active_read_encoded_prefix
@bm_active_read_encoded_prefix
     : forall (A : Ty.Ty) (a : Ty.tySem A) (tail : list BitMachine.Cell) (m : Memory.Mem.mem)
         (L : jet_bitmachine_rep.bm_layout) (s : BitMachine.RunState) (_ : jet_bitmachine_rep.bm_rep m L s)
         (_ : @eq (list BitMachine.Cell) (BitMachine.nextData (BitMachine.activeReadFrame s))
                (@app BitMachine.Cell (@Translate.encode A a) tail)),
       and (jet_frame_layout.frame_base_valid (jet_bitmachine_rep.item_ofs (jet_bitmachine_rep.active_read_loc L)))
         (and
            (BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
               (jet_bitmachine_rep.item_ofs (jet_bitmachine_rep.active_read_loc L)))
            (and
               (jet_frame_layout.frame_fields_at m (jet_bitmachine_rep.frames_blk L)
                  (jet_bitmachine_rep.item_ofs (jet_bitmachine_rep.active_read_loc L)) (jet_bitmachine_rep.cells_blk L)
                  (jet_bitmachine_rep.edge_ofs (jet_bitmachine_rep.active_read_loc L)) (bm_active_read_cursor s))
               (and (BinInt.Z.le BinNums.Z0 (bm_active_read_cursor s))
                  (and
                     (BinInt.Z.le (BinInt.Z.add (bm_active_read_cursor s) (BinInt.Z.of_nat (Translate.bitSize A)))
                        Integers.Int64.max_unsigned)
                     (jet_encoding.frame_input_cells_at m (jet_bitmachine_rep.cells_blk L)
                        (jet_bitmachine_rep.edge_ofs (jet_bitmachine_rep.active_read_loc L))
                        (bm_active_read_cursor s) (@Translate.encode A a))))))
