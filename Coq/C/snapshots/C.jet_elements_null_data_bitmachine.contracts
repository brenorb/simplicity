### C.jet_elements_null_data_bitmachine.bm_active_read_cursor
bm_active_read_cursor =
fun s : BitMachine.RunState =>
BinInt.Z.add (jet_bitmachine_rep.read_padding (jet_bitmachine_rep.read_size (BitMachine.activeReadFrame s)))
  (BinInt.Z.of_nat (@length BitMachine.Cell (BitMachine.prevData (BitMachine.activeReadFrame s))))
     : forall _ : BitMachine.RunState, BinNums.Z

Arguments bm_active_read_cursor s
### C.jet_elements_null_data_bitmachine.elements_null_data_bm_environment_case
elements_null_data_bm_environment_case =
fun (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (edge cur : BinNums.Z)
  (be : Values.block) (ebase : BinNums.Z) (bt : Values.block) (txbase : BinNums.Z) (bout : Values.block)
  (outbase : BinNums.Z) (i : Integers.Int64.int) (jw : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
  (parsed : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int))) (unused_hash : Digest.hash256) =>
and
  (BinInt.Z.le (BinInt.Z.of_nat (@length (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) parsed))
     Integers.Int64.max_unsigned)
  (and
     (jet_elements_null_data_index.elements_null_data_count_path m be ebase bt txbase bout outbase i
        (Integers.Int64.repr
           (BinInt.Z.of_nat (@length (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) parsed))))
     (and
        (@List.Forall (prod (prod Values.block BinNums.Z) BinNums.Z)
           (fun pat : prod (prod Values.block BinNums.Z) BinNums.Z =>
            match pat return Prop with
            | pair y hi =>
                match y return Prop with
                | pair b lo =>
                    jet_application_sep.out_sep bd dbase bw edge cur
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                      b lo hi
                end
