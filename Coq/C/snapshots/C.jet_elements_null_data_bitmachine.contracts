### C.jet_elements_null_data_bitmachine.bm_state_after_output
bm_state_after_output =
fun (s : BitMachine.RunState) (cells : list BitMachine.Cell) =>
BitMachine.Build_RunState (BitMachine.inactiveReadFrames s) (BitMachine.activeReadFrame s)
  (BitMachine.Build_WriteFrame
     (@app BitMachine.Cell (@List.rev BitMachine.Cell cells) (BitMachine.writeData (BitMachine.activeWriteFrame s)))
     (Nat.sub (BitMachine.writeEmpty (BitMachine.activeWriteFrame s)) (@length BitMachine.Cell cells)))
  (BitMachine.inactiveWriteFrames s)
     : forall (_ : BitMachine.RunState) (_ : list BitMachine.Cell), BitMachine.RunState

Arguments bm_state_after_output s cells%list_scope
