           (jet_elements_null_data_guard_compose.elements_null_data_count_footprint be ebase bt txbase bout outbase i))
        (jet_elements_null_data_layout.elements_null_data_selected_initial m bd dbase bw edge cur
           (BinNums.Zpos
              (BinNums.xI
                 (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
           be ebase bt txbase bout outbase i
           (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) jw)) parsed unused_hash)))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (_ : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int))) (_ : Digest.hash256), Prop

