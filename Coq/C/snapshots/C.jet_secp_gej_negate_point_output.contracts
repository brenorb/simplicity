### C.jet_secp_gej_negate_point_output.gej_negate_preserved_coordinate
gej_negate_preserved_coordinate
     : forall (k : jet_secp_point_write_run.point_coordinate) (m mf : Memory.Mem.mem) (b : Values.block)
         (limbs : list Integers.Int64.int)
         (_ : not (@eq jet_secp_point_write_run.point_coordinate k jet_secp_point_write_run.PointY))
         (_ : @eq nat (@length Integers.Int64.int limbs) (S (S (S (S (S O))))))
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset k) limbs)
         (_ : Memory.Mem.range_perm mf b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : forall (chunk : AST.memory_chunk) (ofs : BinNums.Z)
                (_ : or
                       (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                       (BinInt.Z.le
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                          ofs))
                (_ : or
                       (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                       (BinInt.Z.le
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                          ofs)),
              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs)),
       jet_secp_fe_nv.fe_at mf b (jet_secp_point_write_run.point_coordinate_offset k) limbs
### C.jet_secp_gej_negate_point_output.eval_gej_negate_point_output
eval_gej_negate_point_output
     : forall (m : Memory.Mem.mem) (b : Values.block) (value : BinNums.Z) (flag : Integers.Int.int)
         (xlimbs zlimbs : list Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : @eq nat (@length Integers.Int64.int xlimbs) (S (S (S (S (S O))))))
         (_ : @eq nat (@length Integers.Int64.int zlimbs) (S (S (S (S (S O))))))
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 xlimbs)
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                zlimbs)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m b
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_neg)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf b BinNums.Z0 xlimbs)
               (and
                  (jet_secp_fe_nv.fe_at mf b
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_field_negate_storage.negate_values
                        (jet_secp_write_fe_numeric.write_fe_rho value BinNums.Z0)))
                  (and
                     (jet_secp_fe_nv.fe_at mf b
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        zlimbs)
                     (and
                        (Memory.Mem.range_perm mf b BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq (option Values.val)
                              (Memory.Mem.load AST.Mint32 mf b
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                              (@Some Values.val (Values.Vint flag)))
                           (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b))
                              m mf)))))))
