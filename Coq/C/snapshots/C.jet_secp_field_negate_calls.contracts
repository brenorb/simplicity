### C.jet_secp_field_negate_calls.negate_normalizer_bounds
negate_normalizer_bounds
     : forall (rho : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_fe_math.fe_limbs_ok (Integers.Int64.unsigned (rho (S O)))
                (Integers.Int64.unsigned (rho (S (S O)))) (Integers.Int64.unsigned (rho (S (S (S O)))))
                (Integers.Int64.unsigned (rho (S (S (S (S O)))))) (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))))
         (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       BinInt.Z.le (Integers.Int64.unsigned (jet_secp_field_negate_values.negate_value rho n))
         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
### C.jet_secp_field_negate_calls.eval_negate_normalization_calls
eval_negate_normalization_calls
     : forall (m : Memory.Mem.mem) (b : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_sx_state.rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))) jet_secp_local_regions.local_write_initial_regs m)
         (_ : jet_secp_fe_math.fe_limbs_ok (Integers.Int64.unsigned (rho (S O)))
                (Integers.Int64.unsigned (rho (S (S O)))) (Integers.Int64.unsigned (rho (S (S (S O)))))
                (Integers.Int64.unsigned (rho (S (S (S (S O)))))) (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))))
         (_ : @eq BinNums.Z
                (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho (S O)))
                   (Integers.Int64.unsigned (rho (S (S O)))) (Integers.Int64.unsigned (rho (S (S (S O)))))
                   (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                   (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                jet_secp_fe_math.feP),
       @ex Memory.Mem.mem
         (fun mn : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mn
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mn
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var)
                     (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
                     Values.Vundef)
                  (and
                     (jet_secp_fe_nv.fe_at mf b BinNums.Z0
                        (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                           (jet_secp_fe_math.fe_limbs_of
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                 (@jet_secp_canonical_negate.canonical_fe_negate Alg.CoreFunSem x)))))
                     (and
                        (Memory.Mem.range_perm mn b BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_sx_mem.lframe
                              (fun (b' : Values.block) (pos : BinNums.Z) =>
                               not
                                 (jet_sx_state.foot
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z)))
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape jet_secp_local_regions.local_write_initial_regs) b' pos)) m
                              mn)
                           (jet_sx_mem.lframe
                              (fun (b' : Values.block) (pos : BinNums.Z) =>
                               not
                                 (and (@eq Values.block b' b)
                                    (and (BinInt.Z.le BinNums.Z0 pos)
                                       (BinInt.Z.lt pos
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                              mn mf)))))))
