      | jet_sx_expr.XLsh op' a' k' =>
          andb (andb (@decision_bool jet_sx_expr.shop shop_eq_dec op op') (sx_same a0 a')) (BinInt.Z.eqb k k')
      | jet_sx_expr.XIcmp _ _ _ _ => false
      | jet_sx_expr.XLcmp _ _ _ _ => false
