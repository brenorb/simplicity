### C.jet_secp_square_sx_equality.decision_bool
decision_bool =
fun (A : Type) (dec : forall a b : A, sumbool (@eq A a b) (not (@eq A a b))) (a b : A) =>
match dec a b return bool with
| left _ => true
| right _ => false
end
     : forall (A : Type) (_ : forall a b : A, sumbool (@eq A a b) (not (@eq A a b))) (_ : A) (_ : A), bool

Arguments decision_bool {A}%type_scope dec%function_scope a b
### C.jet_secp_square_sx_equality.sx_same
sx_same =
fix sx_same (a b : jet_sx_expr.sx) {struct a} : bool :=
  match a return bool with
  | jet_sx_expr.XI _ => false
  | jet_sx_expr.XIc a0 =>
      match b return bool with
      | jet_sx_expr.XI _ => false
      | jet_sx_expr.XIc b0 => Integers.Int.eq a0 b0
      | jet_sx_expr.XL _ => false
