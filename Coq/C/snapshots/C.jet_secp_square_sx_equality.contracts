### C.jet_secp_square_sx_equality.signedness_eq_dec
signedness_eq_dec =
fun a b : Ctypes.signedness =>
Ctypes.signedness_rec
  (fun a0 : Ctypes.signedness =>
   forall x : Ctypes.signedness, sumbool (@eq Ctypes.signedness a0 x) (not (@eq Ctypes.signedness a0 x)))
  (fun x : Ctypes.signedness =>
   match
     x as s return (sumbool (@eq Ctypes.signedness Ctypes.Signed s) (not (@eq Ctypes.signedness Ctypes.Signed s)))
   with
   | Ctypes.Signed =>
       @left (@eq Ctypes.signedness Ctypes.Signed Ctypes.Signed)
         (not (@eq Ctypes.signedness Ctypes.Signed Ctypes.Signed)) (@eq_refl Ctypes.signedness Ctypes.Signed)
   | Ctypes.Unsigned =>
       @right (@eq Ctypes.signedness Ctypes.Signed Ctypes.Unsigned)
         (not (@eq Ctypes.signedness Ctypes.Signed Ctypes.Unsigned))
         ((fun H : @eq Ctypes.signedness Ctypes.Signed Ctypes.Unsigned =>
           let H0 : False :=
             @eq_ind Ctypes.signedness Ctypes.Signed
               (fun e : Ctypes.signedness =>
                match e return Prop with
                | Ctypes.Signed => True
                | Ctypes.Unsigned => False
                end) I Ctypes.Unsigned H in
           False_ind False H0)
          :
          not (@eq Ctypes.signedness Ctypes.Signed Ctypes.Unsigned))
   end)
  (fun x : Ctypes.signedness =>
   match
     x as s return (sumbool (@eq Ctypes.signedness Ctypes.Unsigned s) (not (@eq Ctypes.signedness Ctypes.Unsigned s)))
   with
   | Ctypes.Signed =>
       @right (@eq Ctypes.signedness Ctypes.Unsigned Ctypes.Signed)
         (not (@eq Ctypes.signedness Ctypes.Unsigned Ctypes.Signed))
         ((fun H : @eq Ctypes.signedness Ctypes.Unsigned Ctypes.Signed =>
           let H0 : False :=
             @eq_ind Ctypes.signedness Ctypes.Unsigned
               (fun e : Ctypes.signedness =>
                match e return Prop with
                | Ctypes.Signed => False
                | Ctypes.Unsigned => True
                end) I Ctypes.Signed H in
           False_ind False H0)
          :
          not (@eq Ctypes.signedness Ctypes.Unsigned Ctypes.Signed))
   | Ctypes.Unsigned =>
       @left (@eq Ctypes.signedness Ctypes.Unsigned Ctypes.Unsigned)
         (not (@eq Ctypes.signedness Ctypes.Unsigned Ctypes.Unsigned)) (@eq_refl Ctypes.signedness Ctypes.Unsigned)
   end) a b
