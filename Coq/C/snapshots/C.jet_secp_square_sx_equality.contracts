### C.jet_secp_square_sx_equality.decision_bool_sound
decision_bool_sound
     : forall (A : Type) (dec : forall a b : A, sumbool (@eq A a b) (not (@eq A a b))) (a b : A)
         (_ : @eq bool (@decision_bool A dec a b) true), @eq A a b
