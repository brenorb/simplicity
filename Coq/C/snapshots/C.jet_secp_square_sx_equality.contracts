      | jet_sx_expr.XLsh _ _ _ => false
      | jet_sx_expr.XIcmp _ _ _ _ => false
      | jet_sx_expr.XLcmp c' sg' a' b' =>
          andb
            (andb
               (andb (@decision_bool Integers.comparison comparison_eq_dec c c')
                  (@decision_bool Ctypes.signedness signedness_eq_dec sg sg')) (sx_same a0 a'))
            (sx_same b0 b')
      | jet_sx_expr.XI2L _ _ => false
      | jet_sx_expr.XL2I _ => false
      | jet_sx_expr.XIcast _ _ _ => false
      | jet_sx_expr.XInz _ => false
