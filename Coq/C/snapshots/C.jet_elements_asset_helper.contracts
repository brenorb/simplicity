         (_ : not (@eq AST.ident aid tB)) (_ : not (@eq AST.ident aid tC))
         (_ : not (@eq AST.ident jets_elements._dst tA)) (_ : not (@eq AST.ident jets_elements._dst tB))
         (_ : not (@eq AST.ident jets_elements._dst tC))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val aid le)
                (@Some Values.val (Values.Vptr ba (Integers.Ptrofs.repr abase))))
         (_ : @eq nat (@length Integers.Int.int xs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le BinNums.Z0 abase)
         (_ : BinInt.Z.le
                (BinInt.Z.add abase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_application_sep.out_sep bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) ba
                abase
                (BinInt.Z.add abase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : jet_uint32_array_init.uint32_array_at m ba abase xs)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.add abase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint pfx)))
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m (conf_body_stmt aid tA tB tC)
                  Events.E0 le' mf ClightBigstep.Out_normal)
               (jet_elements_effects.write_effect m mf bf base bw edge cursor
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xI
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (asset_cells pfx xs))))
