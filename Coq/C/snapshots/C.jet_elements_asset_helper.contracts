### C.jet_elements_asset_helper.exec_elements_conf_branch
exec_elements_conf_branch
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (aid : AST.ident) (tB : BinNums.positive) (tC : AST.ident) (bf : Values.block)
         (base : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z) (ba : Values.block)
         (abase : BinNums.Z) (pfx : Integers.Int.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._skipBits e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._writeBit e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq AST.ident aid tC))
         (_ : not (@eq AST.ident jets_elements._dst tC))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val aid le)
                (@Some Values.val (Values.Vptr ba (Integers.Ptrofs.repr abase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val tB le)
                (@Some Values.val
                   (Values.Vint (conf_bit_int (Integers.Int.eq (Integers.Int.repr (BinNums.Zpos BinNums.xH)) pfx)))))
         (_ : BinInt.Z.le BinNums.Z0 abase)
         (_ : BinInt.Z.le
                (BinInt.Z.add abase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.add abase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint pfx)))
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor (BinNums.Zpos BinNums.xH)),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m (asset_branch_stmt aid tB tC)
                  Events.E0 le' mf ClightBigstep.Out_normal)
               (and
                  (jet_elements_effects.write_effect m mf bf base bw edge cursor (BinNums.Zpos BinNums.xH)
                     (@cons BitMachine.Cell (asset_second_cell pfx) (@nil BitMachine.Cell)))
                  (and
                     (@eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le')
                        (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
                     (@eq (option Values.val) (@Maps.PTree.get Values.val aid le')
                        (@Some Values.val (Values.Vptr ba (Integers.Ptrofs.repr abase))))))))
### C.jet_elements_asset_helper.exec_elements_conf_body
exec_elements_conf_body
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (aid tA tB tC : AST.ident) (bf : Values.block) (base : BinNums.Z)
         (bw : Values.block) (edge cursor : BinNums.Z) (ba : Values.block) (abase : BinNums.Z)
         (xs : list Integers.Int.int) (pfx : Integers.Int.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._skipBits e)
