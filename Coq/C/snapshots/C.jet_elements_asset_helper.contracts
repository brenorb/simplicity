### C.jet_elements_asset_helper.conf_bit_int
conf_bit_int =
fun b : bool => match b return Integers.Int.int with
                | true => Integers.Int.one
                | false => Integers.Int.zero
                end
     : forall _ : bool, Integers.Int.int

Arguments conf_bit_int b%bool_scope
### C.jet_elements_asset_helper.asset_second_cell
asset_second_cell =
fun pfx : Integers.Int.int =>
match Integers.Int.eq (Integers.Int.repr (BinNums.Zpos BinNums.xH)) pfx return BitMachine.Cell with
| true => @None bool
| false => @Some bool (Integers.Int.eq (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) pfx)
end
     : forall _ : Integers.Int.int, BitMachine.Cell

Arguments asset_second_cell pfx
### C.jet_elements_asset_helper.asset_cells
asset_cells =
fun (pfx : Integers.Int.int) (xs : list Integers.Int.int) =>
@app (option bool)
  (@cons (option bool) (@Some bool (Integers.Int.eq (Integers.Int.repr (BinNums.Zpos BinNums.xH)) pfx))
     (@cons BitMachine.Cell (asset_second_cell pfx) (@nil BitMachine.Cell))) (jet_elements_hash_write.hash_cells xs)
     : forall (_ : Integers.Int.int) (_ : list Integers.Int.int), list BitMachine.Cell

Arguments asset_cells pfx xs%list_scope
### C.jet_elements_asset_helper.asset_branch_stmt
asset_branch_stmt =
fun aid tB tC : AST.ident =>
Clight.Sifthenelse (Clight.Etempvar tB Ctypesdefs.tbool)
  (Clight.Scall (@None AST.ident)
     (Clight.Evar jets_elements._skipBits
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
        (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
           (@nil Clight.expr))))
  (Clight.Ssequence
     (Clight.Sset tC
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar aid (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr)))
              (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr)) jets_elements._prefix Ctypesdefs.tint))
     (Clight.Scall (@None AST.ident)
        (Clight.Evar jets_elements._writeBit
           (Ctypes.Tfunction
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                 (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
        (@cons Clight.expr
           (Clight.Etempvar jets_elements._dst
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
           (@cons Clight.expr
              (Clight.Ebinop Cop.Oeq
                 (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) Ctypesdefs.tint)
                 (Clight.Etempvar tC Ctypesdefs.tint) Ctypesdefs.tint) (@nil Clight.expr)))))
     : forall (_ : AST.ident) (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments asset_branch_stmt aid tB tC
### C.jet_elements_asset_helper.conf_body_stmt
conf_body_stmt =
fun aid tA tB tC : AST.ident =>
Clight.Ssequence
  (Clight.Ssequence
     (Clight.Ssequence
        (Clight.Sset tA
           (Clight.Efield
              (Clight.Ederef
                 (Clight.Etempvar aid (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr)))
                 (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr)) jets_elements._prefix Ctypesdefs.tint))
        (Clight.Scall (@Some AST.ident tB)
           (Clight.Evar jets_elements._writeBit
              (Ctypes.Tfunction
                 (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                    (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
           (@cons Clight.expr
              (Clight.Etempvar jets_elements._dst
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
              (@cons Clight.expr
                 (Clight.Ebinop Cop.Oeq
                    (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
                    (Clight.Etempvar tA Ctypesdefs.tint) Ctypesdefs.tint) (@nil Clight.expr)))))
     (asset_branch_stmt aid tB tC))
  (Clight.Scall (@None AST.ident)
     (Clight.Evar jets_elements._writeHash
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tvoid AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof
              (Clight.Efield
                 (Clight.Ederef
                    (Clight.Etempvar aid (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr)))
                    (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr)) jets_elements._data
                 (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
           (@nil Clight.expr))))
     : forall (_ : AST.ident) (_ : AST.ident) (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments conf_body_stmt aid tA tB tC
### C.jet_elements_asset_helper.nonce_cells
nonce_cells =
fun (pfx : Integers.Int.int) (xs : list Integers.Int.int) =>
match Integers.Int.eq (Integers.Int.repr BinNums.Z0) pfx return (list BitMachine.Cell) with
| true =>
    @cons (option bool) (@Some bool false)
      (@List.repeat (option bool) (@None bool)
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
| false => @cons (option bool) (@Some bool true) (asset_cells pfx xs)
end
     : forall (_ : Integers.Int.int) (_ : list Integers.Int.int), list BitMachine.Cell

Arguments nonce_cells pfx xs%list_scope
### C.jet_elements_asset_helper.nonce_skip_stmt
nonce_skip_stmt =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._skipBits
