### C.jet_secp_multiply_finish_state.finish_state
finish_state =
fun (digits written : forall _ : nat, Integers.Int64.int) (c d : prod Integers.Int64.int Integers.Int64.int)
  (t3 t4 : Integers.Int64.int) =>
match finish_run digits written c d t3 t4 return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ => jet_secp_multiply_next_checkpoint.checkpoint_state digits written c d t3 t4
    end
| None => jet_secp_multiply_next_checkpoint.checkpoint_state digits written c d t3 t4
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : prod Integers.Int64.int Integers.Int64.int) (_ : prod Integers.Int64.int Integers.Int64.int)
         (_ : Integers.Int64.int) (_ : Integers.Int64.int), jet_sx_eval.sstate

