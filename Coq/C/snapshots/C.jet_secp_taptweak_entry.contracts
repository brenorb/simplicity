### C.jet_secp_taptweak_entry.taptweak_free
taptweak_free
     : forall (m : Memory.Mem.mem) (bb bi bo bp bt bh bs bc bc1 br br1 : Values.block)
         (_ : @List.NoDup Values.block (taptweak_locals bb bi bo bp bt bh bs bc bc1 br br1))
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (taptweak_storage bb bi bo bp bt bh bs bc bc1 br br1)),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.free_list m
                  (Clight.blocks_of_env jet_secp_linkage.secp_ge (taptweak_env bb bi bo bp bt bh bs bc bc1 br br1)))
               (@Some Memory.Mem.mem mf))
            (and
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (_ : BinNums.Z) =>
                   not (@List.In Values.block b (taptweak_locals bb bi bo bp bt bh bs bc bc1 br br1))) m mf)
               (jet_clight_internal_preserve.readonly_preserved m mf)))
