### C.jet_secp_taptweak_entry.taptweak_entry_ok
taptweak_entry_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_simplicity_generic_taptweak) true
### C.jet_secp_taptweak_entry.taptweak_entry
taptweak_entry
     : forall (m : Memory.Mem.mem) (vd vs vt vn : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bb : Values.block =>
             @ex Values.block
               (fun bi : Values.block =>
                @ex Values.block
                  (fun bo : Values.block =>
                   @ex Values.block
                     (fun bp : Values.block =>
                      @ex Values.block
                        (fun bt : Values.block =>
                         @ex Values.block
                           (fun bh : Values.block =>
                            @ex Values.block
                              (fun bs : Values.block =>
                               @ex Values.block
                                 (fun bc : Values.block =>
                                  @ex Values.block
                                    (fun bc1 : Values.block =>
                                     @ex Values.block
                                       (fun br : Values.block =>
                                        @ex Values.block
                                          (fun br1 : Values.block =>
                                           and
                                             (Clight.function_entry2 jet_secp_linkage.secp_ge
                                                jets_secp.f_simplicity_generic_taptweak
                                                (@cons Values.val vd (@cons Values.val vs (@cons Values.val vt (...))))
                                                m (taptweak_env bb bi bo bp bt bh bs bc bc1 br br1)
                                                (taptweak_temps vd vs vt vn) mi)
                                             (and
                                                (@List.NoDup Values.block
                                                   (taptweak_locals bb bi bo bp bt bh bs bc bc1 br br1))
                                                (and
                                                   (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                                    not (@List.In Values.block b ...))
                                                   (and
                                                      (forall ... ... ...,
                                                       Memory.Mem.range_perm mi b BinNums.Z0 hi Memtype.Cur
                                                         Memtype.Freeable) (and (...) (...)))))))))))))))))
