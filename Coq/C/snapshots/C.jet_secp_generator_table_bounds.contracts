### C.jet_secp_generator_table_bounds.generator_affine_bounds
generator_affine_bounds =
fun v : prod BinNums.Z BinNums.Z =>
and
  (and (BinInt.Z.le BinNums.Z0 (@fst BinNums.Z BinNums.Z v))
     (BinInt.Z.lt (@fst BinNums.Z BinNums.Z v) jet_secp_fe_math.feP))
  (and (BinInt.Z.le BinNums.Z0 (@snd BinNums.Z BinNums.Z v))
     (BinInt.Z.lt (@snd BinNums.Z BinNums.Z v) jet_secp_fe_math.feP))
     : forall _ : prod BinNums.Z BinNums.Z, Prop

Arguments generator_affine_bounds v
