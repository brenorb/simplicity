                                (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
                                (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
                       (@cons Clight.expr
                          (Clight.Etempvar jets_elements._ctx
                             (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
                          (@cons Clight.expr (Clight.Etempvar jets_elements._t'1 Ctypesdefs.tint) (@nil Clight.expr)))))
                 (Clight.Ssequence
                    (Clight.Scall (@None AST.ident)
                       (Clight.Evar jets_elements._sha256_hash
                          (Ctypes.Tfunction
                             (Ctypes.Tcons
                                (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
                                (Ctypes.Tcons
                                   (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
                                   Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
                       (@cons Clight.expr
                          (Clight.Etempvar jets_elements._ctx
                             (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
                          (@cons Clight.expr
                             (Clight.Eaddrof
                                (Clight.Efield
                                   (Clight.Efield
                                      (Clight.Ederef
                                         (Clight.Etempvar jets_elements._amt
                                            (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._confAmount Ctypes.noattr)))
                                         (Ctypes.Tstruct jets_elements._confAmount Ctypes.noattr))
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))))))
                                      (Ctypes.Tunion jets_elements.__4799 Ctypes.noattr)) jets_elements._confidential
                                   (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
                                (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
                             (@nil Clight.expr)))) (Clight.Sreturn (@None Clight.expr)))) Clight.LSnil))))
     : Clight.statement
### C.jet_elements_conf_amount_exec.amt_bytes
amt_bytes =
fun (pfx : Integers.Int.int) (v : Integers.Int64.int) (ws : list Integers.Int.int) =>
match Integers.Int.eq pfx (Integers.Int.repr (BinNums.Zpos BinNums.xH)) return (list Integers.Int.int) with
| true =>
    @cons Integers.Int.int (Integers.Int.repr (BinNums.Zpos BinNums.xH))
      (jet_elements_support_sha_be64_exec.c_be64_bytes v)
| false =>
    @cons Integers.Int.int
      match Integers.Int.eq pfx (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))) return Integers.Int.int with
      | true => Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
      | false => Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))
      end (jet_elements_support_sha_be32_write.be_bytes ws)
end
     : forall (_ : Integers.Int.int) (_ : Integers.Int64.int) (_ : list Integers.Int.int), list Integers.Int.int

Arguments amt_bytes pfx v ws%list_scope
### C.jet_elements_conf_amount_exec.ca_le
ca_le =
fun (bx ba : Values.block) (oa : BinNums.Z) =>
let ctxv : Values.val := Values.Vptr bx (Integers.Ptrofs.repr BinNums.Z0) in
let amtv : Values.val := Values.Vptr ba (Integers.Ptrofs.repr oa) in
@Maps.PTree.set Values.val jets_elements._amt amtv
  (@Maps.PTree.set Values.val jets_elements._ctx ctxv
     (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_simplicity_sha256_confAmt)))
     : forall (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments ca_le bx ba oa%Z_scope
### C.jet_elements_conf_amount_exec.amt_overflow
amt_overflow =
fun (c : Integers.Int64.int) (ovf : bool) (pfx : Integers.Int.int) =>
jet_elements_support_sha_uchars_exec.uc_overflow
  (jet_elements_support_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
  (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
  (Integers.Int64.repr
     match Integers.Int.eq pfx (Integers.Int.repr (BinNums.Zpos BinNums.xH)) return BinNums.Z with
     | true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))
     | false => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     end)
     : forall (_ : Integers.Int64.int) (_ : bool) (_ : Integers.Int.int), bool

Arguments amt_overflow c ovf%bool_scope pfx
