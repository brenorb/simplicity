### C.jet_secp_generator_table_samples.generator_entry_signed_numeric
generator_entry_signed_numeric =
fun (high : bool) (index : nat) (neg : bool) =>
match generator_entry_numeric high index return (prod BinNums.Z BinNums.Z) with
| pair x y =>
    @pair BinNums.Z BinNums.Z x
      match neg return BinNums.Z with
      | true => BinInt.Z.modulo (BinInt.Z.sub jet_secp_fe_math.feP y) jet_secp_fe_math.feP
      | false => y
      end
end
     : forall (_ : bool) (_ : nat) (_ : bool), prod BinNums.Z BinNums.Z

