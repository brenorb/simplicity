### C.jet_secp_add_normalized_owned.normalized_add_reader_facts
normalized_add_reader_facts
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (forall (n : nat) (_ : lt n (S (S (S (S (S O)))))),
          and
            (BinInt.Z.le (Integers.Int64.unsigned (normalized_add_rho a b (S n)))
               (BinInt.Z.sub
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                  (BinNums.Zpos BinNums.xH)))
            (BinInt.Z.le (Integers.Int64.unsigned (normalized_add_rho a b (Nat.add (S (S (S (S (S (S O)))))) n)))
               (BinInt.Z.sub
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                  (BinNums.Zpos BinNums.xH))))
         (and
            (@eq BinNums.Z (jet_secp_field_add_numeric.field_input_value (normalized_add_rho a b) (S O))
               (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                  jet_secp_canonical_normalize.canonical_field_order))
            (@eq BinNums.Z
               (jet_secp_field_add_numeric.field_input_value (normalized_add_rho a b) (S (S (S (S (S (S O)))))))
               (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                  jet_secp_canonical_normalize.canonical_field_order)))
### C.jet_secp_add_normalized_owned.eval_field_add_from_normalized_fields
eval_field_add_from_normalized_fields
     : forall (m : Memory.Mem.mem) (ba bb : Values.block)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : not (@eq Values.block ba bb))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem a)))))
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem b)))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_field_add_storage.add_values (normalized_add_rho a b)))
               (and
                  (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (jet_secp_write_fe_wide_exec.wide_fe_output
                        (jet_secp_field_add_values.add_value (normalized_add_rho a b) O)
                        (jet_secp_field_add_values.add_value (normalized_add_rho a b) (S O))
                        (jet_secp_field_add_values.add_value (normalized_add_rho a b) (S (S O)))
                        (jet_secp_field_add_values.add_value (normalized_add_rho a b) (S (S (S O))))
                        (jet_secp_field_add_values.add_value (normalized_add_rho a b) (S (S (S (S O))))))
                     (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b)))
                  (and
                     (Memory.Mem.range_perm mf ba BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bb BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe
                           (fun (b' : Values.block) (pos : BinNums.Z) =>
                            not
                              (jet_sx_state.foot
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))))
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape jet_secp_field_add.field_add_initial_regs) b' pos)) m mf))))))
### C.jet_secp_add_normalized_owned.normalized_add_rho
normalized_add_rho =
fun a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
jet_secp_add_reader_environment.add_reader_rho
  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
     (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem a))
  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
     (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem b))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : nat), Integers.Int64.int

Arguments normalized_add_rho a b _%nat_scope
