### C.jet_secp_gej_odd_body.exec_gej_odd_finite_from_calls
exec_gej_odd_finite_from_calls
     : forall (le : Maps.PTree.tree Values.val) (m ma mn mo mf : Memory.Mem.mem) (bl bp br bd : Values.block)
         (base : BinNums.Z) (bit : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_gej_var)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ma
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ma
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var)
                (@cons Values.val
                   (Values.Vptr br
                      (Integers.Ptrofs.repr
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                   (@nil Values.val)) Events.E0 mn Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mn
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd)
                (@cons Values.val
                   (Values.Vptr br
                      (Integers.Ptrofs.repr
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                   (@nil Values.val)) Events.E0 mo (Values.Vint (jet_readBit_layout.bit_int bit)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mo
                (@Ctypes.Internal Clight.function jets.f_writeBit)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vint (jet_readBit_layout.bit_int bit)) (@nil Values.val))) Events.E0 mf
                (Values.Vint (jet_readBit_layout.bit_int bit))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_gej_odd_entry.gej_odd_env bl bp br) le m
         gej_odd_finite_stmt Events.E0 (gej_odd_parity_temps le bit) mf ClightBigstep.Out_normal
### C.jet_secp_gej_odd_body.gej_odd_y_address
gej_odd_y_address =
