  (Clight.Efield (Clight.Evar jets_secp._b jet_secp_curve_statements.curve_ge_type) jets_secp._y
     jet_secp_curve_statements.curve_fe_type) (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type)
     : Clight.expr
### C.jet_secp_gej_odd_body.gej_odd_flag_stmt
gej_odd_flag_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_gej_is_infinity jets_secp.f_secp256k1_gej_is_infinity
  (@Some AST.ident jets_secp._t'2)
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_secp._a (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))) (@nil Clight.expr))
     : Clight.statement
### C.jet_secp_gej_odd_body.gej_odd_affine_stmt
gej_odd_affine_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_ge_set_gej_var jets_secp.f_secp256k1_ge_set_gej_var
  (@None AST.ident)
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_secp._b jet_secp_curve_statements.curve_ge_type)
        (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_secp._a (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_gej_odd_body.gej_odd_normalize_stmt
gej_odd_normalize_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_normalize_var jets_secp.f_secp256k1_fe_normalize_var
  (@None AST.ident) (@cons Clight.expr gej_odd_y_address (@nil Clight.expr))
     : Clight.statement
### C.jet_secp_gej_odd_body.gej_odd_parity_stmt
gej_odd_parity_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_is_odd jets_secp.f_secp256k1_fe_is_odd
  (@Some AST.ident jets_secp._t'1) (@cons Clight.expr gej_odd_y_address (@nil Clight.expr))
     : Clight.statement
### C.jet_secp_gej_odd_body.gej_odd_write_stmt
gej_odd_write_stmt =
fun argument : Clight.expr =>
Clight.Scall (@None AST.ident) (Clight.Evar jets_secp._writeBit (Clight.type_of_function jets.f_writeBit))
  (@cons Clight.expr
     (Clight.Etempvar jets_secp._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr)))
     (@cons Clight.expr argument (@nil Clight.expr)))
     : forall _ : Clight.expr, Clight.statement

Arguments gej_odd_write_stmt argument
### C.jet_secp_gej_odd_body.gej_odd_finite_stmt
gej_odd_finite_stmt =
Clight.Ssequence gej_odd_affine_stmt
  (Clight.Ssequence gej_odd_normalize_stmt
     (Clight.Ssequence gej_odd_parity_stmt (gej_odd_write_stmt (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tint))))
     : Clight.statement
### C.jet_secp_gej_odd_body.gej_odd_branch
gej_odd_branch =
Clight.Sifthenelse (Clight.Etempvar jets_secp._t'2 Ctypesdefs.tint)
  (gej_odd_write_stmt (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)) gej_odd_finite_stmt
     : Clight.statement
### C.jet_secp_gej_odd_body.gej_odd_after_read
gej_odd_after_read =
Clight.Ssequence (Clight.Ssequence gej_odd_flag_stmt gej_odd_branch)
  (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))
     : Clight.statement
### C.jet_secp_gej_odd_body.gej_odd_flagged
gej_odd_flagged =
