       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_gej_odd_entry.gej_odd_env bl bp br) le m
         jet_secp_gej_predicate_body.gej_predicate_read_stmt Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_gej_odd_body.exec_gej_odd_flag
exec_gej_odd_flag
     : forall (le : Clight.temp_env) (m : Memory.Mem.mem) (bl bp br : Values.block) (infinity : bool)
         (_ : @eq (option Values.val)
