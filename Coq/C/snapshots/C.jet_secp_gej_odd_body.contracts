@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint (jet_readBit_layout.bit_int infinity)) le
     : forall (_ : Maps.PTree.tree Values.val) (_ : bool), Maps.PTree.tree Values.val

Arguments gej_odd_flagged le infinity%bool_scope
### C.jet_secp_gej_odd_body.gej_odd_parity_temps
gej_odd_parity_temps =
