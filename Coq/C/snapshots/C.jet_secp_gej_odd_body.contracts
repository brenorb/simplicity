### C.jet_secp_gej_odd_body.exec_gej_odd_write
exec_gej_odd_write
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bl bp br bd : Values.block)
         (base : BinNums.Z) (argument : Clight.expr) (bit : bool)
