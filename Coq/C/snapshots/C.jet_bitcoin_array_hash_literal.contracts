@jet_sha_hash_words_literal.literal_sha_hash_words k (S (S (S (S (S O))))) term Ty.Unit
  (@Alg.Core.Combinators.drop Ty.Unit (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) (Alg.Assertion.toCore term)
     (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) alg p))
     : forall (k : nat)
         (_ : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) (alg : jet_bitcoin_full_prim.PF.Algebra),
       jet_bitcoin_full_prim.PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

