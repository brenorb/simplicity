                                         AST.Mint64 (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S (S ...)))))
                                      (@cons jet_sx_state.cell
                                         (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO ...))) AST.Mint64
                                            (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S ...))))
                                         (@nil jet_sx_state.cell)))))) true
                          (@Some BinNums.Z
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                       (@nil jet_sx_state.region)) (@nil jet_sx_eval.event) (S (S (S (S (S (S O)))))))
                 jet_sx_exec.ONormal)
        end return jet_sx_eval.sstate
      with
      | Some x =>
          match x return jet_sx_eval.sstate with
          | jet_sx_exec.RDone Σ _ => Σ
          | jet_sx_exec.RIf _ _ _ =>
              jet_sx_eval.mkst (@Maps.PTree.Empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
          end
      | None =>
          jet_sx_eval.mkst (@Maps.PTree.Empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
      end return (Maps.PTree.tree jet_sx_expr.sx)
    with
    | jet_sx_eval.mkst stemps _ _ _ => stemps
    end return (option jet_sx_expr.sx)
  with
  | Maps.PTree.Empty => @None jet_sx_expr.sx
  | Maps.PTree.Nodes x =>
      match x return (option jet_sx_expr.sx) with
      | Maps.PTree.Node001 _ => @None jet_sx_expr.sx
      | Maps.PTree.Node010 x0 => @Some jet_sx_expr.sx x0
      | Maps.PTree.Node011 x0 _ => @Some jet_sx_expr.sx x0
      | Maps.PTree.Node100 _ => @None jet_sx_expr.sx
      | Maps.PTree.Node101 _ _ => @None jet_sx_expr.sx
      | Maps.PTree.Node110 _ x0 => @Some jet_sx_expr.sx x0
      | Maps.PTree.Node111 _ x0 _ => @Some jet_sx_expr.sx x0
      end
  end return jet_sx_expr.sx
with
| Some x => x
| None => jet_sx_expr.XIc (Integers.Int.mkint BinNums.Z0 (Integers.Int.Z_mod_modulus_range' BinNums.Z0))
end
     : forall _ : jet_secp_point_write_run.point_coordinate, jet_sx_expr.sx

Arguments point_zero_ret k
