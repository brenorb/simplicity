       @eq bool (jet_sx_pure.leaves_log_nil (jet_sx_exec.RDone (point_zero_state k) jet_sx_exec.ONormal)) true
### C.jet_secp_point_zero_exec.point_zero_value
point_zero_value
     : forall (k : jet_secp_point_write_run.point_coordinate) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (jet_sx_expr.den rho layout (point_zero_ret k))
         (Values.Vint
            match
              Integers.Int64.eq (jet_secp_field_zero.field_or_value rho) Integers.Int64.zero return Integers.Int.int
            with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
### C.jet_secp_point_zero_exec.eval_point_zero_from_owned_region
eval_point_zero_from_owned_region
     : forall (k : jet_secp_point_write_run.point_coordinate) (m : Memory.Mem.mem) (layout : jet_sx_state.layout)
