### C.jet_elements_support_sha_uchars_loop.uframe
uframe =
fun (bx bo : Values.block) (cbase obase : BinNums.Z) (m m' : Memory.Mem.mem) =>
and
  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
     (_ : or (not (@eq Values.block b bx))
            (or
               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                  (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (BinInt.Z.le
                  (BinInt.Z.add cbase
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))) ofs)))
     (_ : or (not (@eq Values.block b bo))
            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) obase)
               (BinInt.Z.le
                  (BinInt.Z.add obase
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) ofs))),
   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
  (and
     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b))
     : forall (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Memory.Mem.mem)
         (_ : Memory.Mem.mem), Prop

Arguments uframe bx bo (cbase obase)%Z_scope m m'
