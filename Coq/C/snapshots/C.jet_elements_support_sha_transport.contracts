### C.jet_elements_support_sha_transport.map_eq_in
@map_eq_in
     : forall (A B : Type) (F G : forall _ : A, B) (l : list A)
         (_ : @eq (list B) (@List.map A B F l) (@List.map A B G l)) (x : A) (_ : @List.In A x l),
       @eq B (F x) (G x)
### C.jet_elements_support_sha_transport.helper_lookup_core
helper_lookup_core
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef) (helper_lookup jet_exec.ge0)
            sha_core_helpers)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun p : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) sha_core_helpers)
### C.jet_elements_support_sha_transport.helper_lookup_sha
helper_lookup_sha
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef)
            (helper_lookup jet_elements_support_sha_linkage.sha_ge) sha_core_helpers)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun p : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) sha_core_helpers)
### C.jet_elements_support_sha_transport.helper_lookup_exists
helper_lookup_exists
     : forall (ge : Clight.genv) (id : AST.ident) (f : Clight.function)
         (_ : @eq (option Clight.fundef) (helper_lookup ge (@pair AST.ident Clight.function id f))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))),
       @ex Values.block
         (fun b : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
               (@Some Values.block b))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
               (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))))
### C.jet_elements_support_sha_transport.sha_core_helpers_entries
sha_core_helpers_entries
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) sha_core_helpers),
       @ex Values.block
         (fun b1 : Values.block =>
          @ex Values.block
            (fun b2 : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) id)
                  (@Some Values.block b1))
               (and
                  (@eq (option Clight.fundef)
                     (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) b1)
                     (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))
                  (and
                     (@eq (option Values.block)
                        (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
                           (Clight.genv_genv jet_elements_support_sha_linkage.sha_ge) id) (@Some Values.block b2))
                     (@eq (option Clight.fundef)
                        (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type
                           (Clight.genv_genv jet_elements_support_sha_linkage.sha_ge) b2)
                        (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))))))
### C.jet_elements_support_sha_transport.helpers_okb_true
helpers_okb_true
     : @eq bool helpers_okb true
### C.jet_elements_support_sha_transport.sha_core_helpers_ok
sha_core_helpers_ok
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) sha_core_helpers),
       @eq bool
         (jet_transport.fundef_okb jet_exec.ge0 jet_elements_support_sha_linkage.sha_ge
            (@List.map (prod AST.ident Clight.function) AST.ident (@fst AST.ident Clight.function) sha_core_helpers)
            (@Ctypes.Internal Clight.function f)) true
### C.jet_elements_support_sha_transport.sha_transport_call
sha_transport_call
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) sha_core_helpers)
         (m : Memory.Mem.mem) (args : list Values.val) (t : Events.trace) (m' : Memory.Mem.mem)
         (res : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function f) args t m' res),
       ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
         (@Ctypes.Internal Clight.function f) args t m' res
### C.jet_elements_support_sha_transport.sha_core_helpers
sha_core_helpers =
@cons (prod AST.ident Clight.function) (@pair AST.ident Clight.function jets._LSBclear jets.f_LSBclear)
  (@cons (prod AST.ident Clight.function) (@pair AST.ident Clight.function jets._LSBkeep jets.f_LSBkeep)
     (@cons (prod AST.ident Clight.function)
        (@pair AST.ident Clight.function jets._simplicity_write8 jets.f_simplicity_write8)
        (@cons (prod AST.ident Clight.function)
           (@pair AST.ident Clight.function jets._simplicity_write16 jets.f_simplicity_write16)
           (@cons (prod AST.ident Clight.function)
              (@pair AST.ident Clight.function jets._simplicity_write32 jets.f_simplicity_write32)
              (@cons (prod AST.ident Clight.function)
                 (@pair AST.ident Clight.function jets._simplicity_write64 jets.f_simplicity_write64)
                 (@cons (prod AST.ident Clight.function)
                    (@pair AST.ident Clight.function jets._simplicity_read4 jets.f_simplicity_read4)
                    (@cons (prod AST.ident Clight.function)
                       (@pair AST.ident Clight.function jets._simplicity_read8 jets.f_simplicity_read8)
                       (@cons (prod AST.ident Clight.function)
                          (@pair AST.ident Clight.function jets._simplicity_read16 jets.f_simplicity_read16)
                          (@cons (prod AST.ident Clight.function)
                             (@pair AST.ident Clight.function jets._simplicity_read32 jets.f_simplicity_read32)
                             (@cons (prod AST.ident Clight.function)
                                (@pair AST.ident Clight.function jets._simplicity_read64 jets.f_simplicity_read64)
                                (@cons (prod AST.ident Clight.function)
                                   (@pair AST.ident Clight.function jets._peekBit jets.f_peekBit)
                                   (@cons (prod AST.ident Clight.function)
                                      (@pair AST.ident Clight.function jets._readBit jets.f_readBit)
                                      (@cons (prod AST.ident Clight.function)
                                         (@pair AST.ident Clight.function jets._writeBit jets.f_writeBit)
                                         (@cons (prod AST.ident Clight.function)
                                            (@pair AST.ident Clight.function jets._forwardBits jets.f_forwardBits)
                                            (@cons (prod AST.ident Clight.function)
                                               (@pair AST.ident Clight.function jets._skipBits jets.f_skipBits)
                                               (@cons (prod AST.ident Clight.function)
                                                  (@pair AST.ident Clight.function jets._write32s jets.f_write32s)
                                                  (@cons (prod AST.ident Clight.function)
                                                     (@pair AST.ident Clight.function jets._read32s jets.f_read32s)
                                                     (@cons (prod AST.ident Clight.function)
                                                        (@pair AST.ident Clight.function jets._write8s jets.f_write8s)
                                                        (@cons (prod AST.ident Clight.function)
                                                           (@pair AST.ident Clight.function jets._read8s jets.f_read8s)
                                                           (@cons (prod AST.ident Clight.function)
                                                              (@pair AST.ident Clight.function
                                                                 jets._simplicity_read_buffer8
                                                                 jets.f_simplicity_read_buffer8)
                                                              (@cons (prod AST.ident Clight.function)
                                                                 (@pair AST.ident Clight.function
                                                                    jets._simplicity_write_buffer8
                                                                    jets.f_simplicity_write_buffer8)
                                                                 (@cons (...) (...) (...)))))))))))))))))))))))
     : list (prod AST.ident Clight.function)
### C.jet_elements_support_sha_transport.helper_lookup
helper_lookup =
fun (ge : Clight.genv) (p : prod AST.ident Clight.function) =>
match
  @Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) (@fst AST.ident Clight.function p)
  return (option Clight.fundef)
with
| Some b => @Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b
| None => @None Clight.fundef
end
     : forall (_ : Clight.genv) (_ : prod AST.ident Clight.function), option Clight.fundef

Arguments helper_lookup ge p
### C.jet_elements_support_sha_transport.helpers_okb
helpers_okb =
@List.forallb (prod AST.ident Clight.function)
  (fun p : prod AST.ident Clight.function =>
   jet_transport.fundef_okb jet_exec.ge0 jet_elements_support_sha_linkage.sha_ge
     (@List.map (prod AST.ident Clight.function) AST.ident (@fst AST.ident Clight.function) sha_core_helpers)
     (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) sha_core_helpers
     : bool
