                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (...)))))))))))))))))))))))
  (@cons PocklingtonCertificat.singleCertif
     (PocklingtonCertificat.Pock_certif
        (BinNums.xI
           (BinNums.xI
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xI
                       (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
        (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))
        (@cons (prod BinNums.positive BinNums.positive)
           (@pair BinNums.positive BinNums.positive (BinNums.xO BinNums.xH) BinNums.xH)
           (@cons (prod BinNums.positive BinNums.positive)
              (@pair BinNums.positive BinNums.positive (BinNums.xI BinNums.xH) (BinNums.xO (BinNums.xO BinNums.xH)))
              (@cons (prod BinNums.positive BinNums.positive)
                 (@pair BinNums.positive BinNums.positive (BinNums.xI (BinNums.xO BinNums.xH)) (BinNums.xO BinNums.xH))
                 (@nil (prod BinNums.positive BinNums.positive))))) BinNums.xH)
     (@cons PocklingtonCertificat.singleCertif
        (PocklingtonCertificat.Pock_certif
           (BinNums.xI
