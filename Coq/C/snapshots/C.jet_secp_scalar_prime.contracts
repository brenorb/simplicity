### C.jet_secp_scalar_prime.secp256k1_scalar_prime
secp256k1_scalar_prime
     : Znumtheory.prime jet_secp_canonical_scalar.canonical_group_order
### C.jet_secp_scalar_prime.secp256k1_scalar_prime_certificate
secp256k1_scalar_prime_certificate =
PocklingtonCertificat.Pock_certif
  (BinNums.xI
     (BinNums.xO
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
  (BinNums.xI (BinNums.xO BinNums.xH))
  (@cons (prod BinNums.positive BinNums.positive)
     (@pair BinNums.positive BinNums.positive
        (BinNums.xI
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))))))))))))))))
        BinNums.xH)
     (@cons (prod BinNums.positive BinNums.positive)
        (@pair BinNums.positive BinNums.positive
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))))
           BinNums.xH)
        (@cons (prod BinNums.positive BinNums.positive)
           (@pair BinNums.positive BinNums.positive
              (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
              BinNums.xH)
           (@cons (prod BinNums.positive BinNums.positive)
              (@pair BinNums.positive BinNums.positive (BinNums.xO BinNums.xH) (BinNums.xO (BinNums.xI BinNums.xH)))
              (@nil (prod BinNums.positive BinNums.positive))))))
  (BinNums.xO
     (BinNums.xI
        (BinNums.xI
           (BinNums.xI
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
     : PocklingtonCertificat.singleCertif
### C.jet_secp_scalar_prime.secp256k1_scalar_prime_support
secp256k1_scalar_prime_support =
@cons PocklingtonCertificat.singleCertif
  (PocklingtonCertificat.Pock_certif
     (BinNums.xI
        (BinNums.xO
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xI
