### C.jet_write_sha256_context_empty_exec.ctx8_write_body
ctx8_write_body
     : @eq Clight.statement (Clight.fn_body jets.f_simplicity_write_sha256_context)
         (Clight.Ssequence
            (Clight.Ssequence
               (Clight.Sset jets._t'4
                  (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxCounter jets._ctx))
               ctx8_buffer_call)
            (Clight.Ssequence
               (Clight.Ssequence
                  (Clight.Sset jets._t'3
                     (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxCounter
                        jets._ctx)) ctx8_counter_call)
               (Clight.Ssequence
                  (Clight.Ssequence
                     (Clight.Sset jets._t'2
                        (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxOutput
                           jets._ctx)) ctx8_iv_call)
                  (Clight.Ssequence
                     (Clight.Sset jets._t'1
                        (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxOverflow
                           jets._ctx))
                     (Clight.Sreturn
                        (@Some Clight.expr
                           (Clight.Eunop Cop.Onotbool (Clight.Etempvar jets._t'1 Ctypesdefs.tbool) Ctypesdefs.tint)))))))
### C.jet_write_sha256_context_empty_exec.ctx8_buffer_symbol
ctx8_buffer_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            jets._simplicity_write_buffer8)
         (@Some Values.block (jet_exec.jet_symbol_block jets._simplicity_write_buffer8))
### C.jet_write_sha256_context_empty_exec.ctx8_buffer_funct
ctx8_buffer_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._simplicity_write_buffer8) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_simplicity_write_buffer8))
### C.jet_write_sha256_context_empty_exec.call_ctx8_empty_buffer
call_ctx8_empty_buffer
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bf : Values.block)
         (base : BinNums.Z) (bc : Values.block) (cbase : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._t'4 le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_simplicity_write_buffer8)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vptr bc
                         (Integers.Ptrofs.add (Integers.Ptrofs.repr cbase)
                            (Integers.Ptrofs.repr
                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (@cons Values.val (Values.Vlong Integers.Int64.zero)
                         (@cons Values.val
                            (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                            (@nil Values.val))))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m ctx8_buffer_call Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_write_sha256_context_empty_exec.eval_write_sha256_context_empty_composes
eval_write_sha256_context_empty_composes
     : forall (m mb mc mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bc : Values.block)
         (cbase : BinNums.Z) (bi : Values.block) (input : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 cbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bc
                   (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mb bc
                   (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr mc bc cbase)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned mf bc
                   (BinInt.Z.add cbase
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_simplicity_write_buffer8)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vptr bc
                         (Integers.Ptrofs.add (Integers.Ptrofs.repr cbase)
                            (Integers.Ptrofs.repr
                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (@cons Values.val (Values.Vlong Integers.Int64.zero)
                         (@cons Values.val
                            (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                            (@nil Values.val))))) Events.E0 mb Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb
                (@Ctypes.Internal Clight.function jets.f_simplicity_write64)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val))) Events.E0 mc Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc (@Ctypes.Internal Clight.function jets.f_write32s)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
                      (@cons Values.val
                         (Values.Vlong
                            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                         (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_write_sha256_context)
         (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
            (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase)) (@nil Values.val))) Events.E0 mf
         (Values.Vint Integers.Int.one)
### C.jet_write_sha256_context_empty_exec.ctx8_buffer_call
ctx8_buffer_call =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets._simplicity_write_buffer8
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar)
              (Ctypes.Tcons Ctypesdefs.tulong (Ctypes.Tcons Ctypesdefs.tint Ctypes.Tnil)))) Ctypesdefs.tvoid
        AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxBlock jets._ctx)
        (@cons Clight.expr
           (Clight.Ebinop Cop.Omod (Clight.Etempvar jets._t'4 Ctypesdefs.tulong)
              (Clight.Econst_int
                 (Integers.Int.repr
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                 Ctypesdefs.tint) Ctypesdefs.tulong)
           (@cons Clight.expr
              (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))))
                 Ctypesdefs.tint) (@nil Clight.expr)))))
     : Clight.statement
### C.jet_write_sha256_context_empty_exec.ctx8_counter_call
ctx8_counter_call =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets._simplicity_write64
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Ebinop Cop.Oshr (Clight.Etempvar jets._t'3 Ctypesdefs.tulong)
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH)))) Ctypesdefs.tint)
           Ctypesdefs.tulong) (@nil Clight.expr)))
     : Clight.statement
### C.jet_write_sha256_context_empty_exec.ctx8_iv_call
ctx8_iv_call =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets._write32s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
     (@cons Clight.expr (Clight.Etempvar jets._t'2 (Ctypesdefs.tptr Ctypesdefs.tuint))
        (@cons Clight.expr
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              Ctypesdefs.tint) (@nil Clight.expr))))
     : Clight.statement
### C.jet_write_sha256_context_empty_exec.ctx8_write_temps
ctx8_write_temps =
fun (bf : Values.block) (base : BinNums.Z) (bc : Values.block) (cbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets._ctx (Values.Vptr bc (Integers.Ptrofs.repr cbase))
  (@Maps.PTree.set Values.val jets._dst (Values.Vptr bf (Integers.Ptrofs.repr base))
     (Clight.create_undef_temps (Clight.fn_temps jets.f_simplicity_write_sha256_context)))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments ctx8_write_temps bf base%Z_scope bc cbase%Z_scope
