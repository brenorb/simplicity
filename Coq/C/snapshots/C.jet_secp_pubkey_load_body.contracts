### C.jet_secp_pubkey_load_body.pubkey_load_body_source
pubkey_load_body_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_pubkey_load)
         (Clight.Ssequence (Clight.Sifthenelse pubkey_load_size_test pubkey_load_branch pubkey_load_other)
            pubkey_load_tail)
### C.jet_secp_pubkey_load_body.eval_pubkey_ge_x_address
eval_pubkey_ge_x_address
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bout : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ge le)
                (@Some Values.val (Values.Vptr bout Integers.Ptrofs.zero))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m pubkey_ge_x_address (Values.Vptr bout Integers.Ptrofs.zero)
### C.jet_secp_pubkey_load_body.exec_pubkey_load_tail
exec_pubkey_load_tail
     : forall (w : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bout : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ge le)
                (@Some Values.val (Values.Vptr bout Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_is_zero e)
                (@None (prod Values.block Ctypes.type)))
         (_ : jet_secp_fe_nv.fe_at m bout BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_affine_storage.affine_storage_coord w false)))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m pubkey_load_tail Events.E0 lef m
            (ClightBigstep.Out_return
               (@Some (prod Values.val Ctypes.type)
                  (@pair Values.val Ctypes.type (Values.Vint (jet_readBit_layout.bit_int (pubkey_storage_accept w)))
                     Ctypesdefs.tint))))
### C.jet_secp_pubkey_load_body.pubkey_decode_allowed
pubkey_decode_allowed
     : jet_clight_internal_frame.allowed_call jet_secp_closed_helpers.secp_closed_helpers
         (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_from_storage)
### C.jet_secp_pubkey_load_body.exec_pubkey_load_body
exec_pubkey_load_body
     : forall (_ : jet_memcpy_model.memcpy_model) (w : forall _ : nat, Integers.Int64.int)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bin : Values.block) (base : BinNums.Z) (bout bs bx b_y : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._s e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_pubkey_copy.pubkey_storage_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._memcpy e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_from_storage e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_is_zero e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pubkey le)
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ge le)
                (@Some Values.val (Values.Vptr bout Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bout
                   (@cons Values.block bs (@cons Values.block bx (@cons Values.block b_y (@nil Values.block))))))
         (_ : not (@eq Values.block bin bs))
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (@cons (prod Values.block BinNums.Z)
                          (@pair Values.block BinNums.Z bout
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                          (@cons (prod Values.block BinNums.Z)
                             (@pair Values.block BinNums.Z bs
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                             (@cons (prod Values.block BinNums.Z)
                                (@pair Values.block BinNums.Z bx
                                   (BinNums.Zpos
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                (@cons (prod Values.block BinNums.Z)
                                   (@pair Values.block BinNums.Z b_y
                                      (BinNums.Zpos
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                   (@nil (prod Values.block BinNums.Z))))))),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_affine_storage.affine_storage_readable m bin base w),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (Clight.fn_body jets_secp.f_secp256k1_pubkey_load) Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type
                           (Values.Vint (jet_readBit_layout.bit_int (pubkey_storage_accept w))) Ctypesdefs.tint))))
               (and
                  (forall k : bool,
                   jet_secp_fe_nv.fe_at mf bout
                     match k return BinNums.Z with
                     | true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                     | false => BinNums.Z0
                     end (jet_secp_multiply_normalize_bridge.words5 (jet_secp_affine_storage.affine_storage_coord w k)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bout
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (forall (b : Values.block) (hi : BinNums.Z)
                           (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                                  (@cons (prod Values.block BinNums.Z)
                                     (@pair Values.block BinNums.Z bout
                                        (BinNums.Zpos
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                     (@cons (prod Values.block BinNums.Z)
                                        (@pair Values.block BinNums.Z bs
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                        (@cons (prod Values.block BinNums.Z)
                                           (@pair Values.block BinNums.Z bx
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                           (@cons (prod Values.block BinNums.Z)
                                              (@pair Values.block BinNums.Z b_y
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                              (@nil (prod Values.block BinNums.Z))))))),
                         Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (_ : BinNums.Z) =>
                               and (not (@eq Values.block b bout)) (not (@eq Values.block b bs))) m mf)
                           (jet_clight_internal_preserve.readonly_preserved m mf)))))))
