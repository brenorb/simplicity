### C.jet_secp_scalar_io_preserve.scalar_io_helpers
scalar_io_helpers =
@List.filter (prod BinNums.positive Clight.function)
  (fun it : prod BinNums.positive Clight.function =>
   @List.existsb BinNums.positive (BinPos.Pos.eqb (@fst BinNums.positive Clight.function it)) scalar_io_ids)
  scalar_io_base
     : list (prod BinNums.positive Clight.function)
