### C.jet_shift_wide_exec.shift_wide_helper_symbol
shift_wide_helper_symbol
     : forall (s : jet_wide.wide_size) (right : bool),
       @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (shift_wide_helper_id s right))
         (@Some Values.block (jet_exec.jet_symbol_block (shift_wide_helper_id s right)))
### C.jet_shift_wide_exec.shift_wide_helper_funct
shift_wide_helper_funct
     : forall (s : jet_wide.wide_size) (right : bool),
       @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block (shift_wide_helper_id s right)) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function)
            (@Ctypes.Internal Clight.function (jet_shift_wide_expr.shift_wide_helper s right)))
### C.jet_shift_wide_exec.exec_shift_wide_helper_call
exec_shift_wide_helper_call
     : forall (s : jet_wide.wide_size) (right : bool) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bl bd : Values.block) (dofs : Integers.Ptrofs.int) (a : Integers.Int.int) (r : Integers.Int64.int)
         (mr mr2 : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd dofs)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function
                   (jet_shift8_helper_exec.shift8_reader_function
                      match s return bool with
                      | jet_wide.W16 => true
                      | jet_wide.W32 => false
                      | jet_wide.W64 => false
                      end)) (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
                (@cons Values.val (Values.Vptr bd dofs)
                   (@cons Values.val (Values.Vlong (jet_shift_wide_helper_exec.shift_wide_payload s right false r a))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (shift_wide_helper_call s right)
         Events.E0 le mf ClightBigstep.Out_normal
### C.jet_shift_wide_exec.shift_wide_plain_body
shift_wide_plain_body
     : forall (s : jet_wide.wide_size) (right : bool),
       @eq Clight.statement (Clight.fn_body (shift_wide_plain_function s right))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence (shift_wide_helper_call s right)
               (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))
### C.jet_shift_wide_exec.eval_shift_wide_plain_composes
eval_shift_wide_plain_composes
     : forall (env : Values.val) (s : jet_wide.wide_size) (right : bool) (m : Memory.Mem.mem)
         (ma : Memory.Mem.mem') (mc mr mr2 me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval) (a : Integers.Int.int)
         (r : Integers.Int64.int) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function
                   (jet_shift8_helper_exec.shift8_reader_function
                      match s return bool with
                      | jet_wide.W16 => true
                      | jet_wide.W32 => false
                      | jet_wide.W64 => false
                      end)) (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (jet_shift_wide_helper_exec.shift_wide_payload s right false r a))
                      (@nil Values.val))) Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function (shift_wide_plain_function s right))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_shift_wide_exec.shift_wide_plain_function
shift_wide_plain_function =
fun (s : jet_wide.wide_size) (right : bool) =>
match s return Clight.function with
| jet_wide.W16 =>
    match right return Clight.function with
    | true => jets.f_simplicity_right_shift_16
    | false => jets.f_simplicity_left_shift_16
    end
| jet_wide.W32 =>
    match right return Clight.function with
    | true => jets.f_simplicity_right_shift_32
    | false => jets.f_simplicity_left_shift_32
    end
| jet_wide.W64 =>
    match right return Clight.function with
    | true => jets.f_simplicity_right_shift_64
    | false => jets.f_simplicity_left_shift_64
    end
end
     : forall (_ : jet_wide.wide_size) (_ : bool), Clight.function

Arguments shift_wide_plain_function s right%bool_scope
### C.jet_shift_wide_exec.shift_wide_helper_id
shift_wide_helper_id =
fun (s : jet_wide.wide_size) (right : bool) =>
match s return AST.ident with
| jet_wide.W16 =>
    match right return AST.ident with
    | true => jets._right_shift_helper_16
    | false => jets._left_shift_helper_16
    end
| jet_wide.W32 =>
    match right return AST.ident with
    | true => jets._right_shift_helper_32
    | false => jets._left_shift_helper_32
    end
| jet_wide.W64 =>
    match right return AST.ident with
    | true => jets._right_shift_helper_64
    | false => jets._left_shift_helper_64
    end
end
     : forall (_ : jet_wide.wide_size) (_ : bool), AST.ident

Arguments shift_wide_helper_id s right%bool_scope
### C.jet_shift_wide_exec.shift_wide_helper_call
shift_wide_helper_call =
fun (s : jet_wide.wide_size) (right : bool) =>
Clight.Scall (@None AST.ident)
  (Clight.Evar (shift_wide_helper_id s right)
     (Ctypes.Tfunction
        (Ctypes.Tcons Ctypesdefs.tbool
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
     (@cons Clight.expr (Clight.Etempvar jets._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))) (@nil Clight.expr))))
     : forall (_ : jet_wide.wide_size) (_ : bool), Clight.statement

Arguments shift_wide_helper_call s right%bool_scope
