### C.jet_secp_generator_base_group.secp_generator_base_curve
secp_generator_base_curve
     : forall second : bool,
       @eq (GZnZ.znz jet_secp_fe_math.feP)
         (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
            (secp_generator_base_y second) (S (S O)))
         (GZnZ.add jet_secp_fe_math.feP
            (GZnZ.add jet_secp_fe_math.feP
               (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                  (GZnZ.mul jet_secp_fe_math.feP) (secp_generator_base_x second) (S (S (S O))))
               (GZnZ.mul jet_secp_fe_math.feP (GZnZ.zero jet_secp_fe_math.feP) (secp_generator_base_x second)))
            jet_secp_curve_group.secp_group_seven)
### C.jet_secp_generator_base_group.secp_generator_base_low
secp_generator_base_low
     : @eq jet_secp_curve_group_sign.secp_group_point (secp_generator_base_group false)
         jet_secp_curve_group_power.secp_group_generator
### C.jet_secp_generator_base_group.secp_generator_high_coordinates
secp_generator_high_coordinates
     : let p : jet_secp_curve_group_certificate.secp_group_projective := secp_generator_high_projective in
       and
         (not
            (@eq BinNums.Z
               (GZnZ.val jet_secp_fe_math.feP
                  (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                     (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                     jet_secp_curve_group.secp_group_seven p)) BinNums.Z0))
         (and
            (@eq BinNums.Z
               (GZnZ.val jet_secp_fe_math.feP
                  (@SMain.x (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                     (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                     jet_secp_curve_group.secp_group_seven p))
               (GZnZ.val jet_secp_fe_math.feP
                  (GZnZ.mul jet_secp_fe_math.feP (secp_generator_base_x true)
                     (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                        (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                        (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven p))))
            (@eq BinNums.Z
               (GZnZ.val jet_secp_fe_math.feP
                  (@SMain.y (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                     (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                     jet_secp_curve_group.secp_group_seven p))
               (GZnZ.val jet_secp_fe_math.feP
                  (GZnZ.mul jet_secp_fe_math.feP (secp_generator_base_y true)
                     (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                        (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                        (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven p)))))
### C.jet_secp_generator_base_group.secp_generator_base_high
secp_generator_base_high
     : @eq jet_secp_curve_group_sign.secp_group_point (secp_generator_base_group true)
         (@EGroup.gpow jet_secp_curve_group_sign.secp_group_point
            (@SMain.add (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
               (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
               (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
               (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
               jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory)
            jet_secp_curve_group_power.secp_group_generator jet_secp_curve_group.secp_curve_group
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_generator_base_group.secp_affine_unit_group
secp_affine_unit_group
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Curve : @eq (GZnZ.znz jet_secp_fe_math.feP)
                    (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                       (GZnZ.mul jet_secp_fe_math.feP) (jet_secp_field_word_group.secp_field_word y)
                       (S (S O)))
                    (GZnZ.add jet_secp_fe_math.feP
                       (GZnZ.add jet_secp_fe_math.feP
                          (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                             (GZnZ.mul jet_secp_fe_math.feP) (jet_secp_field_word_group.secp_field_word x)
                             (S (S (S O))))
                          (GZnZ.mul jet_secp_fe_math.feP (GZnZ.zero jet_secp_fe_math.feP)
                             (jet_secp_field_word_group.secp_field_word x))) jet_secp_curve_group.secp_group_seven)),
       jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y)
         (@SMain.curve_elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
            jet_secp_curve_group.secp_group_seven (jet_secp_field_word_group.secp_field_word x)
            (jet_secp_field_word_group.secp_field_word y) Curve)
### C.jet_secp_generator_base_group.secp_literal_generator_base_group
secp_literal_generator_base_group
     : forall second : bool,
       jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
         (jet_secp_generate_literal.literal_generator_base_word second)
         (@EGroup.gpow jet_secp_curve_group_sign.secp_group_point
            (@SMain.add (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
               (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
               (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
               (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
               jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory)
            jet_secp_curve_group_power.secp_group_generator jet_secp_curve_group.secp_curve_group
            match second return BinNums.Z with
            | true =>
                BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            | false => BinNums.Zpos BinNums.xH
            end)
