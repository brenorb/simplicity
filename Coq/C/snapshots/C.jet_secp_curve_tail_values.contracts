### C.jet_secp_curve_tail_values.curve_shift_words
curve_shift_words =
fun (w : forall _ : nat, Integers.Int64.int) (n : nat) => w (Nat.sub n (S O))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments curve_shift_words w%function_scope n%nat_scope
### C.jet_secp_curve_tail_values.curve_weak_words
curve_weak_words =
fun (a b c d e : BinNums.Z) (i : nat) =>
@List.nth Integers.Int64.int i
  (@cons Integers.Int64.int (Integers.Int64.repr a)
     (@cons Integers.Int64.int (Integers.Int64.repr b)
        (@cons Integers.Int64.int (Integers.Int64.repr c)
           (@cons Integers.Int64.int (Integers.Int64.repr d)
              (@cons Integers.Int64.int (Integers.Int64.repr e) (@nil Integers.Int64.int)))))) Integers.Int64.zero
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : nat),
       Integers.Int64.int

Arguments curve_weak_words (a b c d e)%Z_scope i%nat_scope
### C.jet_secp_curve_tail_values.curve_equal_rho
curve_equal_rho =
fun (a b : forall _ : nat, Integers.Int64.int) (n : nat) =>
@List.nth Integers.Int64.int n
  (@cons Integers.Int64.int Integers.Int64.zero
     (@app Integers.Int64.int (jet_secp_multiply_normalize_bridge.words5 a)
        (jet_secp_multiply_normalize_bridge.words5 b))) Integers.Int64.zero
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments curve_equal_rho (a b)%function_scope n%nat_scope
