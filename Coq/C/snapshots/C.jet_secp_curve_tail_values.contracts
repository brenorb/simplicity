### C.jet_secp_curve_tail_values.curve_shift_field
curve_shift_field
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int) (jet_secp_field_add_initial.field_values (curve_shift_words w) (S O))
         (jet_secp_multiply_normalize_bridge.words5 w)
### C.jet_secp_curve_tail_values.curve_weak_field
curve_weak_field
     : forall a b c d e : BinNums.Z,
       @eq (list Integers.Int64.int) (jet_secp_multiply_normalize_bridge.words5 (curve_weak_words a b c d e))
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (@cons BinNums.Z a
               (@cons BinNums.Z b (@cons BinNums.Z c (@cons BinNums.Z d (@cons BinNums.Z e (@nil BinNums.Z)))))))
### C.jet_secp_curve_tail_values.curve_equal_first
curve_equal_first
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int) (jet_secp_field_add_initial.field_values (curve_equal_rho a b) (S O))
         (jet_secp_multiply_normalize_bridge.words5 a)
### C.jet_secp_curve_tail_values.curve_equal_second
curve_equal_second
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int)
         (jet_secp_field_add_initial.field_values (curve_equal_rho a b) (S (S (S (S (S (S O)))))))
         (jet_secp_multiply_normalize_bridge.words5 b)
### C.jet_secp_curve_tail_values.curve_equal_first_value
curve_equal_first_value
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (curve_equal_rho a b (S O)))
            (Integers.Int64.unsigned (curve_equal_rho a b (S (S O))))
            (Integers.Int64.unsigned (curve_equal_rho a b (S (S (S O)))))
            (Integers.Int64.unsigned (curve_equal_rho a b (S (S (S (S O))))))
            (Integers.Int64.unsigned (curve_equal_rho a b (S (S (S (S (S O))))))))
         (jet_secp_multiply_finish_product.radix_value a)
### C.jet_secp_curve_tail_values.curve_equal_second_value
curve_equal_second_value
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
