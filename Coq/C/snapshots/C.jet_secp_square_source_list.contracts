### C.jet_secp_square_source_list.original_square_symbolic_output
original_square_symbolic_output
     : @eq (list jet_sx_expr.sx) jet_secp_square_execution.square_limbs
         (@cons jet_sx_expr.sx jet_secp_square_schedule.sq_r0
            (@cons jet_sx_expr.sx jet_secp_square_schedule.sq_r1
               (@cons jet_sx_expr.sx jet_secp_square_schedule.sq_r2
                  (@cons jet_sx_expr.sx jet_secp_square_schedule.sq_r3
                     (@cons jet_sx_expr.sx jet_secp_square_schedule.sq_r4 (@nil jet_sx_expr.sx))))))
