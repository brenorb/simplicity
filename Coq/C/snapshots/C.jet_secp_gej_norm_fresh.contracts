### C.jet_secp_gej_norm_fresh.gej_normalize_runs_from_actual_init
gej_normalize_runs_from_actual_init
     : forall (x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (env : Values.val)
         (_ : forall (mc : Memory.Mem.mem) (w : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned w) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong w) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned w))))),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m : Memory.Mem.mem =>
             @ex Values.block
               (fun bd : Values.block =>
                @ex Values.block
                  (fun bs : Values.block =>
                   @ex Values.block
                     (fun bi : Values.block =>
                      @ex Values.block
                        (fun bw : Values.block =>
                         @ex BinNums.Z
                           (fun edge : BinNums.Z =>
                            @ex Memory.Mem.mem
                              (fun mf : Memory.Mem.mem =>
                               and
                                 (@eq (option Memory.Mem.mem)
                                    (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                                       (@Ctypes.program_of_program Clight.function jets_secp.prog))
                                    (@Some Memory.Mem.mem mi))
                                 (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mi)
                                    (and (jet_frame_layout.frame_fields_at m bs BinNums.Z0 bi edge BinNums.Z0)
                                       (and
                                          (jet_encoding.frame_input_cells_at m bi edge BinNums.Z0
                                             (@Translate.encode
                                                (Ty.Prod (Ty.Prod (Word.Word (S (S (...)))) (Word.Word (S (S (...)))))
                                                   (Word.Word (S (S (S (...))))))
                                                (@pair
                                                   (prod (Ty.tySem (Word.Word (S (...))))
                                                      (Ty.tySem (Word.Word (S (...)))))
                                                   (Ty.tySem (Word.Word (S (S (...)))))
                                                   (@pair (Ty.tySem (Word.Word (S (...))))
                                                      (Ty.tySem (Word.Word (S (...)))) x y) z)))
                                          (and
                                             (jet_output_layout.write_frame_at m bd BinNums.Z0 bw BinNums.Z0
                                                (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (...))))))
                                                (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))
                                             (and
                                                (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                                   (@Ctypes.Internal Clight.function
                                                      jets_secp.f_simplicity_gej_normalize)
                                                   (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                                                      (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                                                         (@cons Values.val env (@nil Values.val)))) Events.E0 mf
                                                   (Values.Vint Integers.Int.one))
                                                (and
                                                   (jet_frame_inv.finv m bd BinNums.Z0 bw BinNums.Z0
                                                      (BinNums.Zpos (BinNums.xI (BinNums.xO (...))))
                                                      (BinNums.Zpos (BinNums.xI (BinNums.xO (...)))) bi mf true
                                                      (@Translate.encode (Ty.Sum Ty.Unit (Ty.Prod (...) (...)))
                                                         (@jet_secp_gej_norm_branch.literal_gej_normalize
                                                            Alg.CoreFunSem (@pair (...) (...) (...) z))))
                                                   (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                                                      (forall (b : Values.block) (chunk : AST.memory_chunk)
                                                         (ofs : BinNums.Z) (_ : Memory.Mem.valid_block mi b),
                                                       @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                                         (Memory.Mem.load chunk mi b ofs)))))))))))))))))
