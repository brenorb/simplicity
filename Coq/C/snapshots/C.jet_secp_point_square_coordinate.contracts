### C.jet_secp_point_square_coordinate.eval_point_square_xy_storage
eval_point_square_xy_storage
     : forall (y : bool) (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin (jet_secp_curve_square.curve_square_offset y)
                (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable) (_ : not (@eq Values.block bout bin)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vptr bin (Integers.Ptrofs.repr (jet_secp_curve_square.curve_square_offset y)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_secp_fe_nv.fe_at mf bin (jet_secp_curve_square.curve_square_offset y)
                        (jet_secp_multiply_normalize_bridge.words5 rho))
                     (and
                        (Memory.Mem.range_perm mf bin BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (pos : BinNums.Z) =>
                            not
                              (or
                                 (and (@eq Values.block b bout)
                                    (and (BinInt.Z.le BinNums.Z0 pos)
                                       (BinInt.Z.lt pos
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                                 (and (@eq Values.block b bin)
                                    (and (BinInt.Z.le (jet_secp_curve_square.curve_square_offset y) pos)
                                       (BinInt.Z.lt pos
                                          (BinInt.Z.add (jet_secp_curve_square.curve_square_offset y)
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
                           m mf))))))
### C.jet_secp_point_square_coordinate.eval_point_square_coordinate
eval_point_square_coordinate
     : forall (k : jet_secp_point_write_run.point_coordinate) (rho : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bout bin : Values.block) (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin (jet_secp_point_write_run.point_coordinate_offset k)
                (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable) (_ : not (@eq Values.block bout bin)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vptr bin (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_secp_fe_nv.fe_at mf bin (jet_secp_point_write_run.point_coordinate_offset k)
                        (jet_secp_multiply_normalize_bridge.words5 rho))
                     (and
                        (Memory.Mem.range_perm mf bin BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_square_numeric.square_words rho))
                                 jet_secp_multiply_checkpoint_columns.field_prime)
                              (BinInt.Z.modulo
                                 (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value rho)
                                    (jet_secp_multiply_finish_product.radix_value rho))
                                 jet_secp_multiply_checkpoint_columns.field_prime))
                           (and
                              (jet_secp_square_columns.square_input_bounds (jet_secp_square_numeric.square_words rho))
                              (and
                                 (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                                  and
                                    (BinInt.Z.le BinNums.Z0
                                       (Integers.Int64.unsigned (jet_secp_square_numeric.square_words rho i)))
                                    (BinInt.Z.lt (Integers.Int64.unsigned (jet_secp_square_numeric.square_words rho i))
                                       match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                                       | true =>
                                           BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))
                                       | false =>
                                           BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))
                                       end)) (jet_sx_mem.lframe (point_square_coordinate_frame k bout bin) m mf)))))))))
### C.jet_secp_point_square_coordinate.point_square_coordinate_frame
point_square_coordinate_frame =
fun (k : jet_secp_point_write_run.point_coordinate) (bout bin b : Values.block) (pos : BinNums.Z) =>
not
  (or
     (and (@eq Values.block b bout)
        (and (BinInt.Z.le BinNums.Z0 pos)
           (BinInt.Z.lt pos (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
     (and (@eq Values.block b bin)
        (and (BinInt.Z.le (jet_secp_point_write_run.point_coordinate_offset k) pos)
           (BinInt.Z.lt pos
              (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
     : forall (_ : jet_secp_point_write_run.point_coordinate) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments point_square_coordinate_frame k bout bin b pos%Z_scope
