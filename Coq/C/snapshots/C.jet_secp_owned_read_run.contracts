                                                      (jet_sx_expr.XL2I (jet_sx_expr.XLv (S (S (S ...))))))
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                             (jet_sx_expr.XLsh jet_sx_expr.Hshl
                                                (jet_sx_expr.XI2L Ctypes.Unsigned
                                                   (jet_sx_expr.XL2I (jet_sx_expr.XLv (S (S (S (S ...)))))))
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                          (jet_sx_expr.XLsh jet_sx_expr.Hshl
                                             (jet_sx_expr.XI2L Ctypes.Unsigned
                                                (jet_sx_expr.XL2I (jet_sx_expr.XLv (S (S (S (S (S ...))))))))
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                                 (@cons jet_sx_state.cell
                                    (jet_sx_state.mkcell
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                       AST.Mint64
                                       (@Some jet_sx_expr.sx
                                          (jet_sx_expr.XLb jet_sx_expr.Bor
                                             (jet_sx_expr.XLb jet_sx_expr.Bor
                                                (jet_sx_expr.XLb jet_sx_expr.Bor
                                                   (jet_sx_expr.XLb jet_sx_expr.Bor
                                                      (jet_sx_expr.XLb jet_sx_expr.Bor
                                                         (jet_sx_expr.XI2L Ctypes.Unsigned
                                                            (jet_sx_expr.XL2I (jet_sx_expr.XLv (S ...))))
                                                         (jet_sx_expr.XLsh jet_sx_expr.Hshl
                                                            (jet_sx_expr.XI2L Ctypes.Unsigned
                                                               (jet_sx_expr.XL2I (jet_sx_expr.XLv ...)))
                                                            (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))))
                                                      (jet_sx_expr.XLsh jet_sx_expr.Hshl
                                                         (jet_sx_expr.XI2L Ctypes.Unsigned
                                                            (jet_sx_expr.XL2I (jet_sx_expr.XLv (S ...))))
                                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                                   (jet_sx_expr.XLsh jet_sx_expr.Hshl
                                                      (jet_sx_expr.XI2L Ctypes.Unsigned
                                                         (jet_sx_expr.XL2I (jet_sx_expr.XLv (S (S ...)))))
                                                      (BinNums.Zpos
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                                                (jet_sx_expr.XLsh jet_sx_expr.Hshl
                                                   (jet_sx_expr.XI2L Ctypes.Unsigned
                                                      (jet_sx_expr.XL2I (jet_sx_expr.XLv (S (S O)))))
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                             (jet_sx_expr.XLsh jet_sx_expr.Hshl
                                                (jet_sx_expr.XI2L Ctypes.Unsigned
                                                   (jet_sx_expr.XL2I (jet_sx_expr.XLv (S O))))
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                                    (@nil jet_sx_state.cell)))))) true (@Some BinNums.Z size))
                  (@cons jet_sx_state.region
                     (jet_sx_state.mkreg
                        (@cons jet_sx_state.cell
                           (jet_sx_state.mkcell BinNums.Z0 AST.Mint64 (@Some jet_sx_expr.sx (jet_sx_expr.XA bi edge)))
                           (@cons jet_sx_state.cell
                              (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 AST.Mint64
                                 (@Some jet_sx_expr.sx
                                    (jet_sx_expr.XLb jet_sx_expr.Badd (jet_sx_expr.XLv O)
                                       (jet_sx_expr.XLc
                                          (Integers.Int64.mkint
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))
                                             (Integers.Int64.Z_mod_modulus_range'
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))
                              (@nil jet_sx_state.cell))) true
                        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (@nil jet_sx_state.region)))
               (@cons jet_sx_eval.event
                  (jet_sx_eval.mkev (S O) (S O) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))
                     (@cons jet_sx_expr.sx (jet_sx_expr.XA bi edge)
                        (@cons jet_sx_expr.sx
                           (jet_sx_expr.XLc
                              (Integers.Int64.mkint BinNums.Z0 (Integers.Int64.Z_mod_modulus_range' BinNums.Z0)))
                           (@cons jet_sx_expr.sx
                              (jet_sx_expr.XLc
                                 (Integers.Int64.mkint
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    (Integers.Int64.Z_mod_modulus_range'
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                              (@nil jet_sx_expr.sx))))) (@nil jet_sx_eval.event))
               (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))) jet_sx_exec.ONormal))
end
     : forall (_ : BinNums.Z) (_ : jet_secp_point_write_run.point_coordinate) (_ : Values.block)
         (_ : Integers.Ptrofs.int), option jet_sx_exec.res

Arguments owned_read_tree size%Z_scope k bi edge
### C.jet_secp_owned_read_run.owned_read_result
owned_read_result =
fun (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block) (edge : Integers.Ptrofs.int)
=>
match owned_read_tree size k bi edge return jet_sx_exec.res with
| Some rr => rr
| None =>
    jet_sx_exec.RDone
      (jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O)
      jet_sx_exec.ONormal
end
     : forall (_ : BinNums.Z) (_ : jet_secp_point_write_run.point_coordinate) (_ : Values.block)
         (_ : Integers.Ptrofs.int), jet_sx_exec.res

Arguments owned_read_result size%Z_scope k bi edge
### C.jet_secp_owned_read_run.owned_read_storage_shape
owned_read_storage_shape =
fun (size : BinNums.Z) (state : jet_sx_eval.sstate) =>
and (@eq nat (@length jet_sx_state.region (jet_sx_eval.sregs state)) (S (S O)))
  (and
     (@eq (option BinNums.Z)
        (jet_sx_state.rfree
           (@List.nth jet_sx_state.region O (jet_sx_eval.sregs state)
              (jet_sx_state.mkreg (@nil jet_sx_state.cell) true (@None BinNums.Z)))) (@Some BinNums.Z size))
     (@eq (option BinNums.Z)
        (jet_sx_state.rfree
           (@List.nth jet_sx_state.region (S O) (jet_sx_eval.sregs state)
              (jet_sx_state.mkreg (@nil jet_sx_state.cell) true (@None BinNums.Z))))
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     : forall (_ : BinNums.Z) (_ : jet_sx_eval.sstate), Prop

Arguments owned_read_storage_shape size%Z_scope state
