### C.jet_secp_owned_read_run.owned_read_tree_nonempty
owned_read_tree_nonempty
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int),
       @eq bool match owned_read_tree size k bi edge return bool with
                | Some _ => true
                | None => false
                end true
### C.jet_secp_owned_read_run.owned_read_run_eq
owned_read_run_eq
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int),
       @eq (option jet_sx_exec.res) (owned_read_run size k bi edge)
         (@Some jet_sx_exec.res (owned_read_result size k bi edge))
### C.jet_secp_owned_read_run.owned_read_selected_log
owned_read_selected_log
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list jet_sx_eval.event)
         (jet_sx_eval.slog
            (@fst jet_sx_eval.sstate jet_sx_exec.xout (jet_sx_exec.rsel rho layout (owned_read_result size k bi edge))))
         (jet_secp_wrapper_run.read_fe_log bi edge)
### C.jet_secp_owned_read_run.owned_read_selected_return
owned_read_selected_return
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH
            (jet_sx_eval.stemps
               (@fst jet_sx_eval.sstate jet_sx_exec.xout
                  (jet_sx_exec.rsel rho layout (owned_read_result size k bi edge))))) (@None jet_sx_expr.sx)
### C.jet_secp_owned_read_run.owned_read_leaf_storage
owned_read_leaf_storage
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int),
       jet_secp_local_regions.all_leaf_property (owned_read_storage_shape size) (owned_read_result size k bi edge)
### C.jet_secp_owned_read_run.owned_read_selected_storage
owned_read_selected_storage
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       owned_read_storage_shape size
         (@fst jet_sx_eval.sstate jet_sx_exec.xout (jet_sx_exec.rsel rho layout (owned_read_result size k bi edge)))
### C.jet_secp_owned_read_run.owned_read_field_storage_size
owned_read_field_storage_size
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int)
         (_ : BinInt.Z.le
                (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size),
       @List.Forall jet_sx_state.cell
         (fun c : jet_sx_state.cell =>
          BinInt.Z.le (BinInt.Z.add (jet_sx_state.cofs c) (Memdata.size_chunk (jet_sx_state.cchunk c))) size)
         (jet_sx_state.rcells
            (@List.hd jet_sx_state.region (jet_sx_state.mkreg (@nil jet_sx_state.cell) true (@None BinNums.Z))
               (owned_read_initial_regs size k bi edge)))
### C.jet_secp_owned_read_run.owned_read_initial_regs
owned_read_initial_regs =
fun (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block) (edge : Integers.Ptrofs.int)
=>
let delta : BinNums.Z := jet_secp_point_write_run.point_coordinate_offset k in
@cons jet_sx_state.region
  (jet_secp_local_regions.free_region
     (jet_sx_state.mkreg
        (@cons jet_sx_state.cell (jet_sx_state.mkcell delta AST.Mint64 (@None jet_sx_expr.sx))
           (@cons jet_sx_state.cell
              (jet_sx_state.mkcell
                 (BinInt.Z.add delta (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) AST.Mint64
                 (@None jet_sx_expr.sx))
              (@cons jet_sx_state.cell
                 (jet_sx_state.mkcell
                    (BinInt.Z.add delta (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                    AST.Mint64 (@None jet_sx_expr.sx))
                 (@cons jet_sx_state.cell
                    (jet_sx_state.mkcell
                       (BinInt.Z.add delta
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))) AST.Mint64
                       (@None jet_sx_expr.sx))
                    (@cons jet_sx_state.cell
                       (jet_sx_state.mkcell
                          (BinInt.Z.add delta
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                          AST.Mint64 (@None jet_sx_expr.sx)) (@nil jet_sx_state.cell)))))) true
        (@None BinNums.Z)) size)
  (@cons jet_sx_state.region
     (jet_secp_local_regions.free_region
        (jet_sx_state.mkreg (jet_secp_frame.mk_frame_cells (jet_sx_expr.XA bi edge) Integers.Int64.zero) true
           (@None BinNums.Z)) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (@nil jet_sx_state.region))
     : forall (_ : BinNums.Z) (_ : jet_secp_point_write_run.point_coordinate) (_ : Values.block)
         (_ : Integers.Ptrofs.int), list jet_sx_state.region

Arguments owned_read_initial_regs size%Z_scope k bi edge
### C.jet_secp_owned_read_run.owned_read_run
owned_read_run =
fun (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block) (edge : Integers.Ptrofs.int)
=>
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_wrapper_run.read_fe_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))) jets_secp.f_read_fe
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O (jet_secp_point_write_run.point_coordinate_offset k))
     (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx)))
  (owned_read_initial_regs size k bi edge) (@nil jet_sx_eval.event) (S O)
     : forall (_ : BinNums.Z) (_ : jet_secp_point_write_run.point_coordinate) (_ : Values.block)
         (_ : Integers.Ptrofs.int), option jet_sx_exec.res

