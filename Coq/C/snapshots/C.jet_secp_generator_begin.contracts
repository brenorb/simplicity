### C.jet_secp_generator_begin.generator_initial_store_source
generator_initial_store_source
     : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
       @eq Clight.statement (generator_initial_store i)
         (Clight.Sassign (generator_initial_lhs i) (generator_initial_rhs i))
### C.jet_secp_generator_begin.generator_initial_rhs_type
generator_initial_rhs_type
     : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
       @eq Ctypes.type (Clight.typeof (generator_initial_rhs i)) Ctypesdefs.tulong
### C.jet_secp_generator_begin.eval_generator_initial_rhs
eval_generator_initial_rhs
     : forall (i : nat) (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (_ : lt i (S (S (S (S (S O)))))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m (generator_initial_rhs i)
         (Values.Vlong (generator_initial_value i))
### C.jet_secp_generator_begin.eval_generator_initial_array
eval_generator_initial_array
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bt : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m
         (Clight.Efield (Clight.Evar jets_secp._t jet_secp_curve_statements.curve_fe_type) jets_secp._n
            (Ctypesdefs.tarray Ctypesdefs.tulong (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
         (Values.Vptr bt Integers.Ptrofs.zero)
### C.jet_secp_generator_begin.eval_generator_initial_lhs
eval_generator_initial_lhs
     : forall (i : nat) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bt : Values.block) (_ : lt i (S (S (S (S (S O))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type))),
       Clight.eval_lvalue jet_secp_linkage.secp_ge e le m (generator_initial_lhs i) bt
         (Integers.Ptrofs.repr
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
         Ctypes.Full
### C.jet_secp_generator_begin.generator_initial_stores_source
generator_initial_stores_source
     : @eq Clight.statement (generator_initial_stores O (S (S (S (S (S O))))))
         (jet_secp_statement_prefix.statement_sequence
            (@List.firstn Clight.statement (S (S (S (S (S O)))))
               (@fst (list Clight.statement) Clight.statement
                  (jet_secp_statement_prefix.split_statement_last
                     (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal)))) Clight.Sskip)
### C.jet_secp_generator_begin.exec_generator_initial_stores
exec_generator_initial_stores
     : forall (count i : nat) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le0 : Clight.temp_env)
         (m : Memory.Mem.mem) (bt : Values.block) (_ : le (Nat.add i count) (S (S (S (S (S O))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 m (generator_initial_stores i count)
               Events.E0 le0 mi ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mi bt BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bt)) m mi)
                  (jet_clight_internal_preserve.readonly_preserved m mi))))
### C.jet_secp_generator_begin.generator_no_blind_source
generator_no_blind_source
     : @eq Clight.statement generator_no_blind
         (Clight.Sifthenelse (Clight.Etempvar jets_secp._blind32 (Ctypesdefs.tptr Ctypesdefs.tuchar))
            generator_blind_initialize Clight.Sskip)
### C.jet_secp_generator_begin.generator_initial_prefix_source
generator_initial_prefix_source
     : @eq Clight.statement generator_initial_prefix
         (jet_secp_statement_prefix.statement_sequence
            (@List.firstn Clight.statement (S (S (S (S (S O)))))
               (@fst (list Clight.statement) Clight.statement
                  (jet_secp_statement_prefix.split_statement_last
                     (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal))))
            (Clight.Ssequence (Clight.Sset jets_secp._ret (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))
               (Clight.Ssequence generator_no_blind Clight.Sskip)))
### C.jet_secp_generator_begin.exec_generator_initial_prefix
exec_generator_initial_prefix
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bt : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._blind32 le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_initial_prefix Events.E0
               (generator_initial_temps le) mi ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mi bt BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bt)) m mi)
                  (jet_clight_internal_preserve.readonly_preserved m mi))))
### C.jet_secp_generator_begin.generator_initial_store
generator_initial_store =
fun i : nat =>
@List.nth Clight.statement i
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal)))
  Clight.Sskip
     : forall _ : nat, Clight.statement

Arguments generator_initial_store i%nat_scope
### C.jet_secp_generator_begin.generator_initial_rhs
generator_initial_rhs =
fun i : nat =>
match generator_initial_store i return Clight.expr with
| Clight.Sskip => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Sassign _ rhs => rhs
| Clight.Sset _ _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Scall _ _ _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Sbuiltin _ _ _ _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Ssequence _ _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Sifthenelse _ _ _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Sloop _ _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Sbreak => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Scontinue => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Sreturn _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Sswitch _ _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Slabel _ _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
| Clight.Sgoto _ => Clight.Econst_long Integers.Int64.zero Ctypesdefs.tulong
end
     : forall _ : nat, Clight.expr

Arguments generator_initial_rhs i%nat_scope
### C.jet_secp_generator_begin.generator_initial_value
generator_initial_value =
fun i : nat =>
match PeanoNat.Nat.eqb i O return Integers.Int64.int with
| true => Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
| false => Integers.Int64.zero
end
     : forall _ : nat, Integers.Int64.int

Arguments generator_initial_value i%nat_scope
### C.jet_secp_generator_begin.generator_initial_lhs
generator_initial_lhs =
fun i : nat =>
Clight.Ederef
  (Clight.Ebinop Cop.Oadd
     (Clight.Efield (Clight.Evar jets_secp._t jet_secp_curve_statements.curve_fe_type) jets_secp._n
        (Ctypesdefs.tarray Ctypesdefs.tulong (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
     (Clight.Econst_int (Integers.Int.repr (BinInt.Z.of_nat i)) Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tulong))
  Ctypesdefs.tulong
     : forall _ : nat, Clight.expr

Arguments generator_initial_lhs i%nat_scope
### C.jet_secp_generator_begin.generator_initial_stores
generator_initial_stores =
fix generator_initial_stores (i count : nat) {struct count} : Clight.statement :=
  match count return Clight.statement with
  | O => Clight.Sskip
  | S count0 => Clight.Ssequence (generator_initial_store i) (generator_initial_stores (S i) count0)
  end
     : forall (_ : nat) (_ : nat), Clight.statement

Arguments generator_initial_stores (i count)%nat_scope
### C.jet_secp_generator_begin.generator_no_blind
generator_no_blind =
@List.nth Clight.statement (S (S (S (S (S (S O))))))
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal)))
  Clight.Sskip
     : Clight.statement
### C.jet_secp_generator_begin.generator_blind_initialize
generator_blind_initialize =
match generator_no_blind return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ yes _ => yes
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_generator_begin.generator_initial_prefix
generator_initial_prefix =
jet_secp_statement_prefix.statement_sequence
  (@List.firstn Clight.statement (S (S (S (S (S (S (S O)))))))
     (@fst (list Clight.statement) Clight.statement
        (jet_secp_statement_prefix.split_statement_last
           (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal)))) Clight.Sskip
     : Clight.statement
### C.jet_secp_generator_begin.generator_initial_temps
generator_initial_temps =
fun le : Maps.PTree.tree Values.val => @Maps.PTree.set Values.val jets_secp._ret (Values.Vint Integers.Int.one) le
     : forall _ : Maps.PTree.tree Values.val, Maps.PTree.tree Values.val

Arguments generator_initial_temps le
