### C.jet_full_decrement_wide_exec.wide_full_decrement
wide_full_decrement =
fun s : jet_wide.wide_size =>
match s return Clight.function with
| jet_wide.W16 => jets.f_simplicity_full_decrement_16
| jet_wide.W32 => jets.f_simplicity_full_decrement_32
| jet_wide.W64 => jets.f_simplicity_full_decrement_64
end
     : forall _ : jet_wide.wide_size, Clight.function

Arguments wide_full_decrement s
### C.jet_full_decrement_wide_exec.wide_full_decrement_borrow_expr
wide_full_decrement_borrow_expr =
Clight.Ebinop Cop.Olt
  (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
     (Clight.Etempvar jets._x Ctypesdefs.tulong) Ctypesdefs.tulong)
  (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
     (Clight.Etempvar jets._z Ctypesdefs.tbool) Ctypesdefs.tuint) Ctypesdefs.tint
     : Clight.expr
### C.jet_full_decrement_wide_exec.wide_full_decrement_payload_expr
wide_full_decrement_payload_expr =
Clight.Ecast
  (Clight.Ebinop Cop.Osub
     (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
        (Clight.Etempvar jets._x Ctypesdefs.tulong) Ctypesdefs.tulong) (Clight.Etempvar jets._z Ctypesdefs.tbool)
     Ctypesdefs.tulong) Ctypesdefs.tulong
     : Clight.expr
