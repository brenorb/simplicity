### C.jet_secp_reduce512_final_stage.reduce512_final_regs
reduce512_final_regs =
fun digits : forall _ : nat, Integers.Int64.int =>
@app jet_sx_state.region
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (jet_sx_rep.u64_cells BinNums.Z0
           (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits O))
              (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S O)))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S O))))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S (S O))))) (@nil jet_sx_expr.sx)))))) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@nil jet_sx_state.region))
  (@app jet_sx_state.region (@List.tl jet_sx_state.region jet_secp_scalar_reduce512_run.scalar_reduce512_initial_regs)
     (@fst (list jet_sx_state.region) jet_sx_eval.venv jet_secp_reduce512_typed_stage.reduce512_allocated))
     : forall _ : forall _ : nat, Integers.Int64.int, list jet_sx_state.region

