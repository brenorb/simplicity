### C.jet_secp_reduce512_final_stage.reduce512_final_source
reduce512_final_source
     : @eq Clight.statement
         (jet_secp_statement_prefix.statement_sequence jet_secp_reduce512_third_stage.reduce512_third_spine
            reduce512_final_suffix) (Clight.fn_body jets_secp.f_secp256k1_scalar_reduce_512)
### C.jet_secp_reduce512_final_stage.reduce512_final_completes
reduce512_final_completes
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int),
       @eq bool
         match reduce512_final_run digits carry return bool with
         | Some r =>
             match r return bool with
             | jet_sx_exec.RDone _ o =>
                 match o return bool with
                 | jet_sx_exec.ONormal => true
                 | jet_sx_exec.OBreak => false
                 | jet_sx_exec.OContinue => false
                 | jet_sx_exec.OReturn _ => false
                 end
             | jet_sx_exec.RIf _ _ _ => false
             end
         | None => false
         end true
### C.jet_secp_reduce512_final_stage.reduce512_final_run_eq
reduce512_final_run_eq
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int),
       @eq (option jet_sx_exec.res) (reduce512_final_run digits carry)
         (@Some jet_sx_exec.res (jet_sx_exec.RDone (reduce512_final_state digits carry) jet_sx_exec.ONormal))
### C.jet_secp_reduce512_final_stage.reduce512_final_log
reduce512_final_log
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int),
       @eq (list jet_sx_eval.event) (jet_sx_eval.slog (reduce512_final_state digits carry))
         (@List.repeat jet_sx_eval.event
            (jet_sx_eval.mkev O (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))) O (@nil jet_sx_expr.sx))
            (S (S (S O))))
### C.jet_secp_reduce512_final_stage.reduce512_final_limb_kinds
reduce512_final_limb_kinds
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int),
       @eq bool (@List.forallb jet_sx_expr.sx (jet_sx_expr.isk jet_sx_expr.KL) (reduce512_final_limbs digits carry))
         true
### C.jet_secp_reduce512_final_stage.reduce512_final_suffix
reduce512_final_suffix =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement jet_secp_reduce512_third_stage.reduce512_third_count
     jet_secp_reduce512_first_run.reduce512_spine) jet_secp_reduce512_first_run.reduce512_last
     : Clight.statement
### C.jet_secp_reduce512_final_stage.reduce512_final_temps
reduce512_final_temps =
fun carry : Integers.Int64.int =>
@Maps.PTree.set jet_sx_expr.sx jets_secp._c (jet_sx_expr.XL carry)
  (@Maps.PTree.set jet_sx_expr.sx jets_secp._l (jet_sx_expr.XP (S O) BinNums.Z0)
     (@Maps.PTree.set jet_sx_expr.sx jets_secp._r (jet_sx_expr.XP O BinNums.Z0) (Maps.PTree.empty jet_sx_expr.sx)))
