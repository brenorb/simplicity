### C.jet_secp_reduce512_final_stage.reduce512_final_state
reduce512_final_state =
fun (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int) =>
match reduce512_final_run digits carry return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ => reduce512_final_initial digits carry
    end
| None => reduce512_final_initial digits carry
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int64.int), jet_sx_eval.sstate

Arguments reduce512_final_state digits%function_scope carry
### C.jet_secp_reduce512_final_stage.reduce512_final_limbs
reduce512_final_limbs =
fun (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int) =>
@List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_frame.cell_sx
  (jet_sx_state.rcells
     (@List.hd jet_sx_state.region (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))
        (jet_sx_eval.sregs (reduce512_final_state digits carry))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int64.int), list jet_sx_expr.sx

