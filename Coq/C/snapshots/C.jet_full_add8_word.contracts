### C.jet_full_add8_word.full_add8_values_denote_spec
full_add8_values_denote_spec
     : forall (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (left right : Integers.Int64.int),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S O))))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S O)))))
            match
              full_add8_carry (Bit.toBool c) (jet_read8.read8_result left) (jet_read8.read8_result right)
              return (sum unit unit)
            with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (jet_spec.decode_word8
               (Integers.Int64.repr
                  (Integers.Int.unsigned
                     (full_add8_payload (Bit.toBool c) (jet_read8.read8_result left) (jet_read8.read8_result right))))))
         (@full_add8_spec Alg.CoreFunSem
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
               (prod (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))) c
               (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))
                  (jet_spec.decode_word8 left) (jet_spec.decode_word8 right))))
### C.jet_full_add8_word.full_add8_spec_parametric
full_add8_spec_parametric
     : @Alg.Core.Parametric
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))) (@full_add8_spec)
### C.jet_full_add8_word.full_add8_spec
full_add8_spec =
fun term : Alg.Core.Algebra => @Word.fullAdder (S (S (S O))) term
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))

Arguments full_add8_spec {term}
### C.jet_full_add8_word.full_add8_first_carry
full_add8_first_carry =
fun r t : Integers.Int.int =>
Integers.Int.ltu
  (Integers.Int.sub
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
     (jet_add8.add8_u t)) (jet_add8.add8_u r)
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int), bool

Arguments full_add8_first_carry r t
### C.jet_full_add8_word.full_add8_second_carry
full_add8_second_carry =
fun (cin : bool) (r t : Integers.Int.int) =>
Integers.Int.ltu
  (Integers.Int.sub
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
     (jet_readBit_layout.bit_int cin)) (jet_add8.add8_sum_raw r t)
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), bool

Arguments full_add8_second_carry cin%bool_scope r t
### C.jet_full_add8_word.full_add8_carry
full_add8_carry =
fun (cin : bool) (r t : Integers.Int.int) => orb (full_add8_first_carry r t) (full_add8_second_carry cin r t)
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), bool

Arguments full_add8_carry cin%bool_scope r t
### C.jet_full_add8_word.full_add8_raw
full_add8_raw =
fun (cin : bool) (r t : Integers.Int.int) =>
Integers.Int.add (jet_add8.add8_sum_raw r t) (jet_readBit_layout.bit_int cin)
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments full_add8_raw cin%bool_scope r t
### C.jet_full_add8_word.full_add8_payload
full_add8_payload =
fun (cin : bool) (r t : Integers.Int.int) =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (full_add8_raw cin r t)
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments full_add8_payload cin%bool_scope r t
