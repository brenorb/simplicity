### C.jet_elements_taptweak_split_constants.elements_taptweak_multiplier_block
elements_taptweak_multiplier_block =
fun first : bool =>
jet_elements_taptweak_globals.elements_taptweak_symbol_block (jet_secp_split_multipliers.split_multiplier_id first)
     : forall _ : bool, Values.block

Arguments elements_taptweak_multiplier_block first%bool_scope
### C.jet_elements_taptweak_split_constants.elements_taptweak_basis_block
elements_taptweak_basis_block =
fun first : bool =>
jet_elements_taptweak_globals.elements_taptweak_symbol_block (jet_secp_split_constants.split_basis_id first)
     : forall _ : bool, Values.block

Arguments elements_taptweak_basis_block first%bool_scope
### C.jet_elements_taptweak_split_constants.elements_taptweak_lambda_block
elements_taptweak_lambda_block =
jet_elements_taptweak_globals.elements_taptweak_symbol_block jets_secp._secp256k1_const_lambda
     : Values.block
### C.jet_elements_taptweak_split_constants.elements_taptweak_multipliers_ready
elements_taptweak_multipliers_ready =
fun m : Memory.Mem.mem =>
forall first : bool,
jet_secp_scalar_constant.scalar_constant_state (elements_taptweak_multiplier_block first)
  (jet_secp_split_multipliers.split_multiplier_words first) m
     : forall _ : Memory.Mem.mem, Prop

Arguments elements_taptweak_multipliers_ready m
### C.jet_elements_taptweak_split_constants.elements_taptweak_split_ready
elements_taptweak_split_ready =
fun m : Memory.Mem.mem =>
and (elements_taptweak_multipliers_ready m)
  (and
     (forall first : bool,
      jet_secp_scalar_constant.scalar_constant_state (elements_taptweak_basis_block first)
        (jet_secp_split_constants.split_basis_words first) m)
     (jet_secp_scalar_constant.scalar_constant_state elements_taptweak_lambda_block
        jet_secp_scalar_lambda_global.scalar_lambda_words m))
     : forall _ : Memory.Mem.mem, Prop

Arguments elements_taptweak_split_ready m
