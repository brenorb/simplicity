fun tail : Clight.statement =>
Clight.Ssequence affine_square_statement
  (Clight.Ssequence affine_cube_statement
     (Clight.Ssequence (affine_coordinate_statement false) (Clight.Ssequence (affine_coordinate_statement true) tail)))
     : forall _ : Clight.statement, Clight.statement

