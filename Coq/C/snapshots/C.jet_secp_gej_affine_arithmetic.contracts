  (@None AST.ident)
  (@cons Clight.expr
     (affine_point_address match y return AST.ident with
                           | true => jets_secp._y
                           | false => jets_secp._x
                           end)
     (@cons Clight.expr
        (affine_point_address match y return AST.ident with
                              | true => jets_secp._y
                              | false => jets_secp._x
                              end)
        (@cons Clight.expr
