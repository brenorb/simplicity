### C.jet_secp_gej_affine_arithmetic.affine_arithmetic_frame
affine_arithmetic_frame =
fun (bp b2 b3 bx : Values.block) (pos : BinNums.Z) =>
not
  (or
     (and (@eq Values.block bx bp)
        (and (BinInt.Z.le BinNums.Z0 pos)
           (BinInt.Z.lt pos
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
     (or
        (and (@eq Values.block bx b2)
           (and (BinInt.Z.le BinNums.Z0 pos)
              (BinInt.Z.lt pos
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
        (and (@eq Values.block bx b3)
           (and (BinInt.Z.le BinNums.Z0 pos)
              (BinInt.Z.lt pos
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments affine_arithmetic_frame bp b2 b3 bx pos%Z_scope
### C.jet_secp_gej_affine_arithmetic.affine_mul_frame
affine_mul_frame =
fun (k : jet_secp_point_write_run.point_coordinate) (bp bs bx : Values.block) (pos : BinNums.Z) =>
not
  (or
     (and (@eq Values.block bx bp)
        (and (BinInt.Z.le (jet_secp_point_write_run.point_coordinate_offset k) pos)
           (BinInt.Z.lt pos
              (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
     (and (@eq Values.block bx bs)
        (and (BinInt.Z.le BinNums.Z0 pos)
           (BinInt.Z.lt pos (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
     : forall (_ : jet_secp_point_write_run.point_coordinate) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments affine_mul_frame k bp bs bx pos%Z_scope
### C.jet_secp_gej_affine_arithmetic.affine_cube_frame
affine_cube_frame =
fun (bo bp bs bx : Values.block) (pos : BinNums.Z) =>
not
  (or
     (and (@eq Values.block bx bo)
        (and (BinInt.Z.le BinNums.Z0 pos)
           (BinInt.Z.lt pos (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
     (or
        (and (@eq Values.block bx bp)
           (and
              (BinInt.Z.le
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                 pos)
              (BinInt.Z.lt pos
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
        (and (@eq Values.block bx bs)
           (and (BinInt.Z.le BinNums.Z0 pos)
              (BinInt.Z.lt pos
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments affine_cube_frame bo bp bs bx pos%Z_scope
