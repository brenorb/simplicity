### C.jet_secp_signed62_slice.fe_repack_slice_foot
fe_repack_slice_foot
     : forall (bout : Values.block) (base : BinNums.Z) (bin b : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout base)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   fe_repack_slice_regs) b pos),
       or
         (and (@eq Values.block b bout)
            (and (BinInt.Z.le base pos)
               (BinInt.Z.lt pos
                  (BinInt.Z.add base
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
         (@eq Values.block b bin)
### C.jet_secp_signed62_slice.eval_fe_repack_to_slice
eval_fe_repack_to_slice
     : forall (to62 : bool) (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout : Values.block)
         (base : BinNums.Z) (bin : Values.block) (_ : not (@eq Values.block bout bin))
         (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bout base
                (BinInt.Z.add base
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function (jet_secp_signed62_repack.fe_repack_function to62))
               (@cons Values.val (Values.Vptr bout (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout base
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_signed62_repack.fe_repack_words to62 w)))
               (and (jet_secp_fe_nv.fe_at mf bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (pos : BinNums.Z) =>
                         and
                           (or (not (@eq Values.block b bout))
                              (or (BinInt.Z.lt pos base)
                                 (BinInt.Z.le
                                    (BinInt.Z.add base
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    pos))) (not (@eq Values.block b bin))) m mf)))))
