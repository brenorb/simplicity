### C.jet_bitcoin_version_exec.bitcoin_version_entry
bitcoin_version_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bl bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl)),
       Clight.function_entry2 jet_bitcoin_linkage.bitcoin_ge jets_bitcoin.f_simplicity_bitcoin_version
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (bitcoin_version_locals bl) (bitcoin_version_temps env bd dbase bs sbase) ma
### C.jet_bitcoin_version_exec.exec_bitcoin_version_copy
exec_bitcoin_version_copy
     : forall (m mc : Memory.Mem.mem) (bl bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_bitcoin_linkage.bitcoin_ge (bitcoin_version_locals bl) le m
         (Clight.Sassign (Clight.Evar jets_bitcoin._src (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_bitcoin._src (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
### C.jet_bitcoin_version_exec.call_bitcoin_version_write32
call_bitcoin_version_write32
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (version : Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_bitcoin._simplicity_write32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._t'2 le)
                (@Some Values.val (Values.Vlong version)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge m
                (@Ctypes.Internal Clight.function jets_bitcoin.f_simplicity_write32)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong version) (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_bitcoin_linkage.bitcoin_ge e le m
         (Clight.Scall (@None AST.ident)
            (Clight.Evar jets_bitcoin._simplicity_write32
               (Ctypes.Tfunction
                  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
                     (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
            (@cons Clight.expr
               (Clight.Etempvar jets_bitcoin._dst
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
               (@cons Clight.expr (Clight.Etempvar jets_bitcoin._t'2 Ctypesdefs.tulong) (@nil Clight.expr)))) Events.E0
         le mf ClightBigstep.Out_normal
### C.jet_bitcoin_version_exec.eval_bitcoin_version_composes
eval_bitcoin_version_composes
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc me mf : Memory.Mem.mem) (bl bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (be : Values.block) (ebase : BinNums.Z)
         (bt : Values.block) (txbase : BinNums.Z) (version : Integers.Int64.int) (bytes : list Memdata.memval)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
         (_ : BinInt.Z.le BinNums.Z0 txbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add txbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr mc be ebase)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mc bt
                   (BinInt.Z.add txbase
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                (@Some Values.val (Values.Vlong version)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge mc
                (@Ctypes.Internal Clight.function jets_bitcoin.f_simplicity_write32)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong version) (@nil Values.val))) Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge m
         (@Ctypes.Internal Clight.function jets_bitcoin.f_simplicity_bitcoin_version)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
               (@cons Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase)) (@nil Values.val)))) Events.E0 mf
         (Values.Vint Integers.Int.one)
### C.jet_bitcoin_version_exec.bitcoin_version_locals
bitcoin_version_locals =
fun bl : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_bitcoin._src
  (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)) Clight.empty_env
     : forall _ : Values.block, Clight.env

Arguments bitcoin_version_locals bl
### C.jet_bitcoin_version_exec.bitcoin_version_temps
bitcoin_version_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_bitcoin._env env
  (@Maps.PTree.set Values.val jets_bitcoin._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_bitcoin._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_bitcoin.f_simplicity_bitcoin_version))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments bitcoin_version_temps env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_bitcoin_version_exec.bitcoin_version_ready
bitcoin_version_ready =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
  (bt : Values.block) (txbase : BinNums.Z) (version : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_bitcoin._t'2 (Values.Vlong version)
  (@Maps.PTree.set Values.val jets_bitcoin._t'1 (Values.Vptr bt (Integers.Ptrofs.repr txbase))
     (bitcoin_version_temps env bd dbase bs sbase))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int), Clight.temp_env

Arguments bitcoin_version_ready env bd dbase%Z_scope bs sbase%Z_scope bt txbase%Z_scope version
