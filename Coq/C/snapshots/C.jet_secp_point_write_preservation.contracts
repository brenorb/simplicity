### C.jet_secp_point_write_preservation.point_coordinate_disjoint
point_coordinate_disjoint
     : forall (k j : jet_secp_point_write_run.point_coordinate)
         (_ : not (@eq jet_secp_point_write_run.point_coordinate k j)),
       or
         (BinInt.Z.le
            (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset j)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (jet_secp_point_write_run.point_coordinate_offset k))
         (BinInt.Z.le
            (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (jet_secp_point_write_run.point_coordinate_offset j))
### C.jet_secp_point_write_preservation.point_write_foot_bounds
point_write_foot_bounds
     : forall (k : jet_secp_point_write_run.point_coordinate) (b bx : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z)))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   (jet_secp_point_write_run.point_write_initial_regs k)) bx pos),
       and (@eq Values.block bx b)
         (and (BinInt.Z.le (jet_secp_point_write_run.point_coordinate_offset k) pos)
            (BinInt.Z.lt pos
               (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_point_write_preservation.point_write_preserves_zero_field
point_write_preserves_zero_field
     : forall (m mf m0 : Memory.Mem.mem) (bd bw bi b : Values.block) (k j : jet_secp_point_write_run.point_coordinate)
         (_ : not (@eq jet_secp_point_write_run.point_coordinate k j))
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset j)
                (@List.repeat Integers.Int64.int Integers.Int64.zero (S (S (S (S (S O)))))))
         (_ : Memory.Mem.range_perm mf b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : jet_sx_mem.lframe
                (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))) (jet_secp_point_write_run.point_write_initial_regs k) m) m
                mf),
       jet_secp_fe_nv.fe_at mf b (jet_secp_point_write_run.point_coordinate_offset j)
         (@List.repeat Integers.Int64.int Integers.Int64.zero (S (S (S (S (S O))))))
