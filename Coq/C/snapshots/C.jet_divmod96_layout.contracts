### C.jet_divmod96_layout.divmod96_final_stmt
divmod96_final_stmt =
Clight.Sassign (Clight.Ederef (Clight.Etempvar jets._r (Ctypesdefs.tptr Ctypesdefs.tulong)) Ctypesdefs.tulong)
  jet_divmod96_expr.divmod96_final_expr
