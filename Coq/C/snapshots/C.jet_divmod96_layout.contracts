### C.jet_divmod96_layout.exec_divmod96_body
exec_divmod96_body
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bq : Values.block)
         (qo : Integers.Ptrofs.int) (br : Values.block) (ro : Integers.Ptrofs.int) (ah al b : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._q le) (@Some Values.val (Values.Vptr bq qo)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._r le) (@Some Values.val (Values.Vptr br ro)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._ah le) (@Some Values.val (Values.Vlong ah)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._al le) (@Some Values.val (Values.Vlong al)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._b le) (@Some Values.val (Values.Vlong b)))
         (_ : BinInt.Z.le Integers.Int64.modulus
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned b)))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned ah) (Integers.Int64.unsigned b))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned al) jet_divmod96_value.divmod96_radix)
         (_ : Memory.Mem.valid_access m AST.Mint64 bq (Integers.Ptrofs.unsigned qo) Memtype.Writable)
         (_ : Memory.Mem.valid_access m AST.Mint64 br (Integers.Ptrofs.unsigned ro) Memtype.Writable)
         (_ : or (not (@eq Values.block bq br))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned qo)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (Integers.Ptrofs.unsigned ro))
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned ro)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (Integers.Ptrofs.unsigned qo)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             @ex Integers.Int64.int
               (fun qf : Integers.Int64.int =>
                @ex Integers.Int64.int
                  (fun rf : Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m (Clight.fn_body jets.f_div_mod_96_64)
                        Events.E0 lef mf ClightBigstep.Out_normal)
                     (and
                        (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bq (Integers.Ptrofs.unsigned qo))
                           (@Some Values.val (Values.Vlong qf)))
                        (and
                           (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf br (Integers.Ptrofs.unsigned ro))
                              (@Some Values.val (Values.Vlong rf)))
                           (and
                              (and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned qf))
                                 (BinInt.Z.lt (Integers.Int64.unsigned qf) jet_divmod96_value.divmod96_radix))
                              (and
                                 (and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned rf))
                                    (BinInt.Z.lt (Integers.Int64.unsigned rf) (Integers.Int64.unsigned b)))
                                 (and
                                    (@eq BinNums.Z
                                       (BinInt.Z.add
                                          (BinInt.Z.mul (Integers.Int64.unsigned ah) jet_divmod96_value.divmod96_radix)
                                          (Integers.Int64.unsigned al))
                                       (BinInt.Z.add
                                          (BinInt.Z.mul (Integers.Int64.unsigned qf) (Integers.Int64.unsigned b))
                                          (Integers.Int64.unsigned rf)))
                                    (and
                                       (forall (chunk : AST.memory_chunk) (bb : Values.block)
                                          (addr : BinNums.Z)
                                          (_ : or (not (@eq Values.block bb bq))
                                                 (or
                                                    (BinInt.Z.le (BinInt.Z.add addr (Memdata.size_chunk chunk))
                                                       (Integers.Ptrofs.unsigned qo))
                                                    (BinInt.Z.le
                                                       (BinInt.Z.add (Integers.Ptrofs.unsigned qo)
                                                          (BinNums.Zpos
                                                             (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) addr)))
                                          (_ : or (not (@eq Values.block bb br))
                                                 (or
                                                    (BinInt.Z.le (BinInt.Z.add addr (Memdata.size_chunk chunk))
                                                       (Integers.Ptrofs.unsigned ro))
                                                    (BinInt.Z.le
                                                       (BinInt.Z.add (Integers.Ptrofs.unsigned ro)
                                                          (BinNums.Zpos
                                                             (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) addr))),
                                        @eq (option Values.val) (Memory.Mem.load chunk mf bb addr)
                                          (Memory.Mem.load chunk m bb addr))
                                       (and
                                          (forall (bb : Values.block) (addr : BinNums.Z) (kind : Memtype.perm_kind)
                                             (p : Memtype.permission) (_ : Memory.Mem.perm m bb addr kind p),
                                           Memory.Mem.perm mf bb addr kind p)
                                          (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m)))))))))))))
