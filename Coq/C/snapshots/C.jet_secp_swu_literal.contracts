### C.jet_secp_swu_literal.literal_swu_step
literal_swu_step
     : forall t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_swu Alg.CoreFunSem t)
         (let p :
            Ty.tySem
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) :=
            @literal_swu_select Alg.CoreFunSem (@literal_swu_candidates Alg.CoreFunSem t) in
          match
            Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem t)
            return
              (Ty.tySem
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
          with
          | true => @jet_secp_gej_negate_literal.literal_ge_negate Alg.CoreFunSem p
          | false => p
          end)
### C.jet_secp_swu_literal.swu_spec_c
swu_spec_c =
Zpow_facts.Zpow_mod (BinInt.Z.modulo (BinNums.Zneg (BinNums.xI BinNums.xH)) jet_secp_fe_math.feP)
  (BinInt.Z.div (BinInt.Z.add jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
     (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP
     : BinNums.Z
### C.jet_secp_swu_literal.swu_spec_d
swu_spec_d =
BinInt.Z.modulo
  (BinInt.Z.div
     (BinInt.Z.add (BinInt.Z.modulo (BinInt.Z.sub swu_spec_c (BinNums.Zpos BinNums.xH)) jet_secp_fe_math.feP)
        match
          BinInt.Z.odd (BinInt.Z.modulo (BinInt.Z.sub swu_spec_c (BinNums.Zpos BinNums.xH)) jet_secp_fe_math.feP)
          return BinNums.Z
        with
        | true => jet_secp_fe_math.feP
        | false => BinNums.Z0
        end) (BinNums.Zpos (BinNums.xO BinNums.xH))) jet_secp_fe_math.feP
     : BinNums.Z
### C.jet_secp_swu_literal.swu_scribe256
swu_scribe256 =
fun (z : BinNums.Z) (term : Alg.Core.Algebra) (A : Ty.Ty) =>
@Alg.scribe A (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))))
  (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z) term
     : forall (_ : BinNums.Z) (term : Alg.Core.Algebra) (A : Ty.Ty),
       Alg.Core.domain term A (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments swu_scribe256 z%Z_scope {term} {A}%ty_scope
