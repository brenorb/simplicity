### C.jet_secp_swu_literal.literal_swu_candidates_step
literal_swu_candidates_step
     : forall t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       let s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         @jet_secp_square_execution.literal_fe_square Alg.CoreFunSem t in
       let a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         @jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))))) s
              (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                 (BinInt.Z.modulo (BinInt.Z.opp swu_spec_c) jet_secp_fe_math.feP))) in
       let w : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         @jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))))) s
              (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) in
       let b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         @jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))))) s
              (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                 (BinNums.Zpos (BinNums.xI BinNums.xH)))) in
       let i : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         @jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem
           (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) w b)) in
       @eq
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_swu_candidates Alg.CoreFunSem t)
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
                  (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a
                        (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) b i))))
                  (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) swu_spec_d)))
            (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (@jet_secp_rescale_literal.literal_fe_cube Alg.CoreFunSem w)
                        (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem i)))
                  (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))))
