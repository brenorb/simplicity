### C.jet_divmod128_free.divmod128_blocks_of_env
divmod128_blocks_of_env
     : forall bl bqh bql br : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_exec.ge0 (jet_divmod128_entry.divmod128_env bl bqh bql br))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bqh BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bql BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z br BinNums.Z0)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))
### C.jet_divmod128_free.free_divmod128_locals
free_divmod128_locals
     : forall (m : Memory.Mem.mem) (bl bqh bql br : Values.block) (_ : not (@eq Values.block bl bqh))
         (_ : not (@eq Values.block bl bql)) (_ : not (@eq Values.block bl br)) (_ : not (@eq Values.block bqh bql))
         (_ : not (@eq Values.block bqh br)) (_ : not (@eq Values.block bql br))
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bqh BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bql BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.free_list m
                  (Clight.blocks_of_env jet_exec.ge0 (jet_divmod128_entry.divmod128_env bl bqh bql br)))
               (@Some Memory.Mem.mem mf))
            (and
               (forall (chunk : AST.memory_chunk) (bb : Values.block) (addr : BinNums.Z)
                  (_ : not (@eq Values.block bb bl)) (_ : not (@eq Values.block bb bqh))
                  (_ : not (@eq Values.block bb bql)) (_ : not (@eq Values.block bb br)),
                @eq (option Values.val) (Memory.Mem.load chunk mf bb addr) (Memory.Mem.load chunk m bb addr))
               (and
                  (forall (bb : Values.block) (addr : BinNums.Z) (kind : Memtype.perm_kind)
                     (p : Memtype.permission) (_ : not (@eq Values.block bb bl)) (_ : not (@eq Values.block bb bqh))
                     (_ : not (@eq Values.block bb bql)) (_ : not (@eq Values.block bb br))
                     (_ : Memory.Mem.perm m bb addr kind p), Memory.Mem.perm mf bb addr kind p)
                  (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m)))))
