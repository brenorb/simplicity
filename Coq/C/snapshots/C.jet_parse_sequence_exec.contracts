### C.jet_parse_sequence_exec.eval_long_one_shift
eval_long_one_shift
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.lt k
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       Clight.eval_expr jet_exec.ge0 e le m (long_one_shift_expr k)
         (Values.Vlong (Integers.Int64.shl Integers.Int64.one (Integers.Int64.repr k)))
### C.jet_parse_sequence_exec.eval_parse_sequence_enabled
eval_parse_sequence_enabled
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._nSequence le)
                (@Some Values.val (Values.Vlong r))),
       Clight.eval_expr jet_exec.ge0 e le m parse_sequence_enabled_expr
         (Values.Vint
            match jet_parse_sequence_spec.parse_sequence_enabled r return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
### C.jet_parse_sequence_exec.cast_parse_sequence_enabled
cast_parse_sequence_enabled
     : forall (m : Memory.Mem.mem) (r : Integers.Int64.int),
       @eq (option Values.val)
         (Cop.sem_cast
            (Values.Vint
               match jet_parse_sequence_spec.parse_sequence_enabled r return Integers.Int.int with
               | true => Integers.Int.one
               | false => Integers.Int.zero
               end) (Clight.typeof parse_sequence_enabled_expr) Ctypesdefs.tbool m)
         (@Some Values.val
            (Values.Vint
               match jet_parse_sequence_spec.parse_sequence_enabled r return Integers.Int.int with
               | true => Integers.Int.one
               | false => Integers.Int.zero
               end))
### C.jet_parse_sequence_exec.eval_parse_sequence_tag
eval_parse_sequence_tag
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._nSequence le)
                (@Some Values.val (Values.Vlong r))),
       Clight.eval_expr jet_exec.ge0 e le m parse_sequence_tag_expr
         (Values.Vlong
            (Integers.Int64.and r
               (Integers.Int64.shl Integers.Int64.one
                  (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
### C.jet_parse_sequence_exec.cast_parse_sequence_tag
cast_parse_sequence_tag
     : forall (m : Memory.Mem.mem) (r : Integers.Int64.int),
       @eq (option Values.val)
         (Cop.sem_cast
            (Values.Vlong
               (Integers.Int64.and r
                  (Integers.Int64.shl Integers.Int64.one
                     (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
            (Clight.typeof parse_sequence_tag_expr) Ctypesdefs.tbool m)
         (@Some Values.val
            (Values.Vint
               match jet_parse_sequence_spec.parse_sequence_tag r return Integers.Int.int with
               | true => Integers.Int.one
               | false => Integers.Int.zero
               end))
### C.jet_parse_sequence_exec.eval_parse_sequence_payload
eval_parse_sequence_payload
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._nSequence le)
                (@Some Values.val (Values.Vlong r))),
       Clight.eval_expr jet_exec.ge0 e le m parse_sequence_payload_expr
