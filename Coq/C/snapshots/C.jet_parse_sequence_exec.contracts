### C.jet_parse_sequence_exec.symbol_skipBits
symbol_skipBits
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._skipBits)
         (@Some Values.block (jet_exec.jet_symbol_block jets._skipBits))
### C.jet_parse_sequence_exec.funct_skipBits
funct_skipBits
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._skipBits) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_skipBits))
### C.jet_parse_sequence_exec.eval_parse_sequence_composes
eval_parse_sequence_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc mr mb me mf : Memory.Mem.mem)
         (bl bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (r : Integers.Int64.int) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_read32)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr (@Ctypes.Internal Clight.function jets.f_writeBit)
                (@cons Values.val (Values.Vptr bd dofs)
                   (@cons Values.val
                      (Values.Vint
                         match jet_parse_sequence_spec.parse_sequence_enabled r return Integers.Int.int with
                         | true => Integers.Int.one
                         | false => Integers.Int.zero
                         end) (@nil Values.val))) Events.E0 mb
                (Values.Vint
                   match jet_parse_sequence_spec.parse_sequence_enabled r return Integers.Int.int with
                   | true => Integers.Int.one
                   | false => Integers.Int.zero
                   end)) (_ : parse_sequence_branch_calls mb me bd dofs r)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_parse_sequence)
         (@cons Values.val (Values.Vptr bd dofs)
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_parse_sequence_exec.long_one_shift_expr
long_one_shift_expr =
fun k : BinNums.Z =>
Clight.Ebinop Cop.Oshl
  (Clight.Ecast (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint) Ctypesdefs.tulong)
  (Clight.Econst_int (Integers.Int.repr k) Ctypesdefs.tint) Ctypesdefs.tulong
     : forall _ : BinNums.Z, Clight.expr

Arguments long_one_shift_expr k%Z_scope
### C.jet_parse_sequence_exec.parse_sequence_enabled_expr
parse_sequence_enabled_expr =
Clight.Ebinop Cop.Olt (Clight.Etempvar jets._nSequence Ctypesdefs.tulong)
  (long_one_shift_expr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))) Ctypesdefs.tint
     : Clight.expr
### C.jet_parse_sequence_exec.parse_sequence_tag_expr
parse_sequence_tag_expr =
Clight.Ebinop Cop.Oand (Clight.Etempvar jets._nSequence Ctypesdefs.tulong)
  (long_one_shift_expr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))) Ctypesdefs.tulong
     : Clight.expr
### C.jet_parse_sequence_exec.parse_sequence_payload_expr
parse_sequence_payload_expr =
Clight.Ebinop Cop.Oand (Clight.Etempvar jets._nSequence Ctypesdefs.tulong)
  (Clight.Econst_int
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
     Ctypesdefs.tint) Ctypesdefs.tulong
     : Clight.expr
### C.jet_parse_sequence_exec.le_parse_sequence_x
le_parse_sequence_x =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._nSequence (Values.Vlong r)
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vlong r)
     (jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_parse_sequence bd dofs bs sofs))
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments le_parse_sequence_x env bd dofs bs sofs r
### C.jet_parse_sequence_exec.le_parse_sequence_flag
le_parse_sequence_flag =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._t'2
  (Values.Vint
     match jet_parse_sequence_spec.parse_sequence_enabled r return Integers.Int.int with
     | true => Integers.Int.one
     | false => Integers.Int.zero
     end) (le_parse_sequence_x env bd dofs bs sofs r)
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments le_parse_sequence_flag env bd dofs bs sofs r
### C.jet_parse_sequence_exec.parse_sequence_branch_calls
parse_sequence_branch_calls =
fun (mb me : Memory.Mem.mem) (bd : Values.block) (dofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
match jet_parse_sequence_spec.parse_sequence_enabled r return Prop with
| true =>
    @ex Memory.Mem.mem
      (fun mt : Memory.Mem.mem =>
       and
         (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb (@Ctypes.Internal Clight.function jets.f_writeBit)
            (@cons Values.val (Values.Vptr bd dofs)
               (@cons Values.val
                  (Values.Vint
                     match jet_parse_sequence_spec.parse_sequence_tag r return Integers.Int.int with
                     | true => Integers.Int.one
                     | false => Integers.Int.zero
                     end) (@nil Values.val))) Events.E0 mt
            (Values.Vint
               match jet_parse_sequence_spec.parse_sequence_tag r return Integers.Int.int with
               | true => Integers.Int.one
               | false => Integers.Int.zero
               end))
         (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mt
            (@Ctypes.Internal Clight.function (jet_wide.wide_writer jet_wide.W16))
            (@cons Values.val (Values.Vptr bd dofs)
               (@cons Values.val (Values.Vlong (jet_parse_sequence_spec.parse_sequence_payload r)) (@nil Values.val)))
            Events.E0 me Values.Vundef))
| false =>
    ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb (@Ctypes.Internal Clight.function jets.f_skipBits)
      (@cons Values.val (Values.Vptr bd dofs)
         (@cons Values.val
            (Values.Vlong
               (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (@nil Values.val))) Events.E0 me Values.Vundef
end
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Integers.Int64.int), Prop

Arguments parse_sequence_branch_calls mb me bd dofs r
