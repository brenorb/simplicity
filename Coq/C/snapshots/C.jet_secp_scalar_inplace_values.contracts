### C.jet_secp_scalar_inplace_values.eval_scalar_mul_inplace_values
eval_scalar_mul_inplace_values
     : forall (a b : BinNums.Z) (m : Memory.Mem.mem) (ba bb : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 a)
                (BinInt.Z.lt a
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 b)
                (BinInt.Z.lt b
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : not (@eq Values.block ba bb))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of a)))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of b)))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf ba BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo (BinInt.Z.mul a b) jet_secp_canonical_scalar.canonical_group_order))))
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and (jet_clight_internal_preserve.readonly_preserved m mf)
                        (jet_sx_mem.lframe
                           (fun (block : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block block ba)) (not (@eq Values.block block bb))) m mf))))))
### C.jet_secp_scalar_inplace_values.scalar_negate_closed
scalar_negate_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers
            (Clight.fn_body jets_secp.f_secp256k1_scalar_negate)) true
### C.jet_secp_scalar_inplace_values.eval_scalar_negate_value
eval_scalar_negate_value
     : forall (a : BinNums.Z) (m : Memory.Mem.mem) (ba : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.lt a jet_secp_canonical_scalar.canonical_group_order))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of a)))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf ba BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo (BinInt.Z.opp a) jet_secp_canonical_scalar.canonical_group_order))))
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and (jet_clight_internal_preserve.readonly_preserved m mf)
                        (jet_sx_mem.lframe
                           (fun (block : Values.block) (_ : BinNums.Z) => not (@eq Values.block block ba)) m mf))))))
### C.jet_secp_scalar_inplace_values.eval_scalar_add_inplace_values
eval_scalar_add_inplace_values
     : forall (a b : BinNums.Z) (m : Memory.Mem.mem) (ba bb : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.lt a jet_secp_canonical_scalar.canonical_group_order))
         (_ : and (BinInt.Z.le BinNums.Z0 b) (BinInt.Z.lt b jet_secp_canonical_scalar.canonical_group_order))
         (_ : not (@eq Values.block ba bb))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of a)))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of b)))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               (Values.Vint
                  (jet_sx_expr.b2i (BinInt.Z.leb jet_secp_canonical_scalar.canonical_group_order (BinInt.Z.add a b)))))
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf ba BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo (BinInt.Z.add a b) jet_secp_canonical_scalar.canonical_group_order))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf bb BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of b)))
                  (and
                     (Memory.Mem.range_perm mf ba BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bb BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and (jet_clight_internal_permissions.keeps_permissions m mf)
                           (and (jet_clight_internal_preserve.readonly_preserved m mf)
                              (jet_sx_mem.lframe
                                 (fun (block : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block block ba)) (not (@eq Values.block block bb))) m mf))))))))
