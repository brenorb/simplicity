### C.jet_secp_globalz_start.globalz_start_frame
globalz_start_frame =
fun (br bf bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bf))
  (or (not (@eq Values.block bx br))
     (or
        (BinInt.Z.lt pos
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
        (BinInt.Z.le
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))) pos)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

