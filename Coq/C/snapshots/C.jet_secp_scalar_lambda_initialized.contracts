### C.jet_secp_scalar_lambda_initialized.scalar_lambda_initialized_from_init
scalar_lambda_initialized_from_init
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       scalar_lambda_initialized m
### C.jet_secp_scalar_lambda_initialized.scalar_lambda_initialized_survives
scalar_lambda_initialized_survives
     : forall (ge : Clight.genv) (m : Memory.Mem.mem) (f : Clight.fundef) (args : list Values.val)
         (t : Events.trace) (mf : Memory.Mem.mem) (result : Values.val) (_ : scalar_lambda_initialized m)
         (_ : ClightBigstep.Clight2.eval_funcall ge m f args t mf result)
         (_ : Memory.Mem.range_perm mf jet_secp_scalar_lambda_global.scalar_lambda_block BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Readable), scalar_lambda_initialized mf
### C.jet_secp_scalar_lambda_initialized.eval_secp_scalar_lambda_initialized
eval_secp_scalar_lambda_initialized
     : forall (env : Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
         (bi : Values.block) (edge rc : BinNums.Z) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : scalar_lambda_initialized m0) (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m0 bs sbase bi edge rc)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value)))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m0
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_scalar_multiply_lambda)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi mf true
                  (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                     (@jet_secp_canonical_scalar_lambda.canonical_scalar_multiply_lambda Alg.CoreFunSem value)))
               (and
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) => not (jet_secp_frame.extA m0 bd bw bi b)) m0 mf)
                  (scalar_lambda_initialized mf))))
### C.jet_secp_scalar_lambda_initialized.scalar_lambda_initialized
scalar_lambda_initialized =
fun m : Memory.Mem.mem =>
and (jet_secp_scalar_lambda_global.scalar_lambda_global_rep m)
  (jet_clight_readonly_frame.readonly_region_bounds m jet_secp_scalar_lambda_global.scalar_lambda_block BinNums.Z0
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : forall _ : Memory.Mem.mem, Prop

Arguments scalar_lambda_initialized m
