                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bf
