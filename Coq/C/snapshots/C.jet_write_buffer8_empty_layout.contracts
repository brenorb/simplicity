### C.jet_write_buffer8_empty_layout.buffer8_empty_calls_layout
buffer8_empty_calls_layout
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (xs : list BinNums.Z) (tail : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 tail)
         (_ : jet_write_buffer8_empty_run.buffer8_empty_chain xs)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinInt.Z.add (jet_write_buffer8_empty_cells.buffer8_empty_bits xs) tail)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and (jet_write_buffer8_empty_run.buffer8_empty_calls bf base xs m mf)
            (and
               (jet_encoding.frame_output_cells_at mf bw edge cursor
                  (jet_write_buffer8_empty_cells.buffer8_empty_output_cells xs))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and
                     (jet_output_layout.write_frame_at mf bf base bw edge
                        (BinInt.Z.sub cursor (jet_write_buffer8_empty_cells.buffer8_empty_bits xs)) tail)
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bf
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor (jet_write_buffer8_empty_cells.buffer8_empty_bits xs))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
### C.jet_write_buffer8_empty_layout.eval_write_buffer8_empty_layout
eval_write_buffer8_empty_layout
