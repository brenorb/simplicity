### C.jet_elements_annexes_hash_program.elements_annexes_of_sem
elements_annexes_of_sem
     : forall (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : jet_elements_prim.Elements.env),
       @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
         (@jet_elements_prim.Elements.sem (Word.Word (S (S (S (S (S O))))))
            (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            jet_elements_prim.Elements.InputAnnexHash i e)
         (@Some (sum unit (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
            match
              @List.nth_error (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                (elements_annexes_of e) (BinInt.Z.to_nat (jet_forWhile_seq.wz (S (S (S (S (S O))))) i))
              return (sum unit (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
            with
            | Some x => @inr unit (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) x
            | None => @inl unit (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
            end)
### C.jet_elements_annexes_hash_program.elements_input_annexes_hash_spec_sem
elements_input_annexes_hash_spec_sem
     : forall e : jet_elements_prim.Elements.env,
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
