### C.jet_elements_annexes_hash_program.elements_input_annexes_hash_spec
elements_input_annexes_hash_spec =
fun alg : jet_elements_words_hash_program.EFP.Algebra =>
let term : Alg.Assertion.Algebra := jet_elements_words_hash_program.EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha_hash_elems_reader.hash_elems_spec (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (fun term0 : Alg.Assertion.Algebra => @jet_bitcoin_ctx_hash_spec.annex_hash_spec term0) (S (S (S (S (S O))))) term
  (@jet_buffer_empty_spec.AC.drop Ty.Unit (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core
     (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
        jet_elements_prim.Elements.InputAnnexHash))
     : forall alg : jet_elements_words_hash_program.EFP.Algebra,
       jet_elements_words_hash_program.EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments elements_input_annexes_hash_spec {alg}
### C.jet_elements_annexes_hash_program.elements_annexes_of
elements_annexes_of =
fun e : jet_elements_prim.Elements.env =>
@List.map jet_elements_prim.sigTxInput (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (fun txi : jet_elements_prim.sigTxInput =>
   match
     jet_elements_prim.sigTxiAnnex txi return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
   with
   | Some bs =>
       @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.from_hash256 (Digest.byteStringHash bs))
   | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
   end) (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
     : forall _ : jet_elements_prim.Elements.env,
       list (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments elements_annexes_of e
### C.jet_elements_annexes_hash_program.elements_input_annexes_hash_of
elements_input_annexes_hash_of =
fun e : jet_elements_prim.Elements.env =>
jet_bitcoin_tx_hash.elems_hash_of (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  jet_bitcoin_tx_hash.annex_elem_bytes (S (S (S (S (S O))))) (elements_annexes_of e)
     : forall _ : jet_elements_prim.Elements.env, Digest.hash256

Arguments elements_input_annexes_hash_of e
