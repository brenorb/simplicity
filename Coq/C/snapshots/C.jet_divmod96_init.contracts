### C.jet_divmod96_init.divmod96_denominator_parts
divmod96_denominator_parts
     : forall (b : Integers.Int64.int)
         (_ : BinInt.Z.le Integers.Int64.modulus
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned b))),
       and
         (and (BinInt.Z.lt BinNums.Z0 (Integers.Int64.unsigned (jet_divmod96_value.divmod96_high b)))
            (BinInt.Z.lt (Integers.Int64.unsigned (jet_divmod96_value.divmod96_high b))
               jet_divmod96_value.divmod96_radix))
         (and
            (and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned (jet_divmod96_value.divmod96_low b)))
               (BinInt.Z.lt (Integers.Int64.unsigned (jet_divmod96_value.divmod96_low b))
                  jet_divmod96_value.divmod96_radix))
            (@eq BinNums.Z (Integers.Int64.unsigned b)
               (BinInt.Z.add
                  (BinInt.Z.mul (Integers.Int64.unsigned (jet_divmod96_value.divmod96_high b))
                     jet_divmod96_value.divmod96_radix) (Integers.Int64.unsigned (jet_divmod96_value.divmod96_low b)))))
### C.jet_divmod96_init.divmod96_divu_unsigned
divmod96_divu_unsigned
     : forall (ah bh : Integers.Int64.int) (_ : BinInt.Z.lt BinNums.Z0 (Integers.Int64.unsigned bh)),
       @eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.divu ah bh))
         (BinInt.Z.div (Integers.Int64.unsigned ah) (Integers.Int64.unsigned bh))
### C.jet_divmod96_init.divmod96_clamp_unsigned
divmod96_clamp_unsigned
     : forall (ah bh : Integers.Int64.int) (_ : BinInt.Z.lt BinNums.Z0 (Integers.Int64.unsigned bh)),
       @eq BinNums.Z (Integers.Int64.unsigned (divmod96_clamp ah bh))
         (jet_divmod96_arith.divmod96_estimate jet_divmod96_value.divmod96_radix (Integers.Int64.unsigned ah)
            (Integers.Int64.unsigned bh))
### C.jet_divmod96_init.divmod96_machine_initial_bounds
divmod96_machine_initial_bounds
     : forall (ah al b : Integers.Int64.int)
         (_ : BinInt.Z.le Integers.Int64.modulus
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned b)))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned ah) (Integers.Int64.unsigned b))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned al) jet_divmod96_value.divmod96_radix),
       let bh : Integers.Int64.int := jet_divmod96_value.divmod96_high b in
       let bl : Integers.Int64.int := jet_divmod96_value.divmod96_low b in
       let q : BinNums.Z := Integers.Int64.unsigned (divmod96_clamp ah bh) in
       and (and (BinInt.Z.le BinNums.Z0 q) (BinInt.Z.lt q jet_divmod96_value.divmod96_radix))
         (and
            (and
               (BinInt.Z.le BinNums.Z0
                  (BinInt.Z.sub (Integers.Int64.unsigned ah) (BinInt.Z.mul q (Integers.Int64.unsigned bh))))
               (BinInt.Z.le (BinInt.Z.sub (Integers.Int64.unsigned ah) (BinInt.Z.mul q (Integers.Int64.unsigned bh)))
                  (Integers.Int64.unsigned ah)))
            (and
               (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.mul q (Integers.Int64.unsigned bl)))
                  (BinInt.Z.lt (BinInt.Z.mul q (Integers.Int64.unsigned bl)) Integers.Int64.modulus))
               (and
                  (BinInt.Z.le (BinInt.Z.mul (BinNums.Zneg (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned b))
                     (BinInt.Z.sub
                        (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned ah) jet_divmod96_value.divmod96_radix)
                           (Integers.Int64.unsigned al)) (BinInt.Z.mul q (Integers.Int64.unsigned b))))
                  (BinInt.Z.lt
                     (BinInt.Z.sub
                        (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned ah) jet_divmod96_value.divmod96_radix)
                           (Integers.Int64.unsigned al)) (BinInt.Z.mul q (Integers.Int64.unsigned b)))
                     (Integers.Int64.unsigned b)))))
### C.jet_divmod96_init.divmod96_clamp
divmod96_clamp =
fun ah bh : Integers.Int64.int =>
let est : Integers.Int64.int := Integers.Int64.divu ah bh in
match
  negb
    (Integers.Int64.ltu
       (Integers.Int64.repr (BinInt.Z.sub jet_divmod96_value.divmod96_radix (BinNums.Zpos BinNums.xH))) est)
  return Integers.Int64.int
with
| true => est
| false => Integers.Int64.repr (BinInt.Z.sub jet_divmod96_value.divmod96_radix (BinNums.Zpos BinNums.xH))
end
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments divmod96_clamp ah bh
