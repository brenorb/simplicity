### C.jet_secp_field_pair_multiply.field_pair_left
field_pair_left
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int) (jet_secp_field_add_initial.field_values (field_pair_valuation a b) O)
         (jet_secp_multiply_normalize_bridge.words5 a)
### C.jet_secp_field_pair_multiply.field_pair_right
field_pair_right
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int)
         (jet_secp_field_add_initial.field_values (field_pair_valuation a b) (S (S (S (S (S O))))))
         (jet_secp_multiply_normalize_bridge.words5 b)
### C.jet_secp_field_pair_multiply.field_pair_radix_left
field_pair_radix_left
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (field_pair_valuation a b))
         (jet_secp_multiply_finish_product.radix_value a)
### C.jet_secp_field_pair_multiply.field_pair_radix_right
field_pair_radix_right
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (jet_secp_multiply_finish_product.radix_value
            (jet_secp_multiply_finish_product.second_input (field_pair_valuation a b)))
         (jet_secp_multiply_finish_product.radix_value b)
### C.jet_secp_field_pair_multiply.field_pair_input_bounds
field_pair_input_bounds
     : forall (a b : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds a)
         (_ : jet_secp_square_columns.square_input_bounds b),
       jet_secp_multiply_first_arithmetic.field_input_bounds (field_pair_valuation a b)
### C.jet_secp_field_pair_multiply.field_pair_initial
field_pair_initial
     : forall (a b : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba bb : Values.block)
         (_ : not (@eq Values.block ba bb))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep (field_pair_valuation a b)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) jet_secp_multiply_run_run.field_mul_regs m
### C.jet_secp_field_pair_multiply.field_pair_output
field_pair_output
     : forall (a b : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba bb : Values.block)
         (_ : jet_sx_state.rep (field_pair_valuation a b)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (jet_secp_multiply_call_call.field_output_regs (field_pair_valuation a b)) m),
       and (jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (field_pair_product a b)))
         (and (jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
            (and
               (Memory.Mem.range_perm m ba BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (Memory.Mem.range_perm m bb BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)))
### C.jet_secp_field_pair_multiply.eval_field_pair_multiply
eval_field_pair_multiply
     : forall (a b : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba bb : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds a) (_ : jet_secp_square_columns.square_input_bounds b)
         (_ : not (@eq Values.block ba bb))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf ba BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (field_pair_product a b)))
               (and (jet_secp_fe_nv.fe_at mf bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
                  (and
                     (Memory.Mem.range_perm mf ba BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bb BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value (field_pair_product a b))
                                 jet_secp_multiply_checkpoint_columns.field_prime)
                              (BinInt.Z.modulo
                                 (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                                    (jet_secp_multiply_finish_product.radix_value b))
                                 jet_secp_multiply_checkpoint_columns.field_prime))
                           (and (jet_secp_square_columns.square_input_bounds (field_pair_product a b))
                              (and
                                 (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                                  and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned (field_pair_product a b i)))
                                    (BinInt.Z.lt (Integers.Int64.unsigned (field_pair_product a b i))
                                       match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                                       | true =>
                                           BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))
                                       | false =>
                                           BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))
                                       end))
                                 (jet_sx_mem.lframe
                                    (fun (bx : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block bx ba)) (not (@eq Values.block bx bb))) m mf)))))))))
### C.jet_secp_field_pair_multiply.field_pair_valuation
field_pair_valuation =
fun (a b : forall _ : nat, Integers.Int64.int) (n : nat) =>
@List.nth Integers.Int64.int n
  (@app Integers.Int64.int (jet_secp_multiply_normalize_bridge.words5 a) (jet_secp_multiply_normalize_bridge.words5 b))
  Integers.Int64.zero
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments field_pair_valuation (a b)%function_scope n%nat_scope
### C.jet_secp_field_pair_multiply.field_pair_product
field_pair_product =
fun a b : forall _ : nat, Integers.Int64.int =>
jet_secp_multiply_finish_execute.original_finish_words (field_pair_valuation a b)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments field_pair_product (a b)%function_scope n%nat_scope
