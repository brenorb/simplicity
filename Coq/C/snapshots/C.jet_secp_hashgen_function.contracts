### C.jet_secp_hashgen_function.hashgen_result_lframe
hashgen_result_lframe
     : forall (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m mf : Memory.Mem.mem)
         (bg : Values.block) (sx sy sz : forall _ : nat, Integers.Int64.int) (sumflag : Integers.Int.int)
         (ox oy : forall _ : nat, Integers.Int64.int) (P : forall (_ : Values.block) (_ : BinNums.Z), Prop)
         (_ : hashgen_result key m bg sx sy sz sumflag ox oy) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall pos : BinNums.Z, P bg pos), hashgen_result key mf bg sx sy sz sumflag ox oy
### C.jet_secp_hashgen_function.eval_hashgen_internal
eval_hashgen_internal
     : forall (_ : jet_memcpy_model.memcpy_model) (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (m : Memory.Mem.mem) (bg ba : Values.block) (oa : Integers.Ptrofs.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : not (@eq Values.block ba bg))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : jet_secp_swu_startup.swu_startup m)
         (_ : forall prefix : bool, jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix m)
         (_ : Memory.Mem.range_perm m bg BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat i)))
                (@Some Values.val
                   (Values.Vint
                      (@List.nth Integers.Int.int i
                         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int
                            jet_read8s_layout.word8_array_value
                            (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) key))
                         Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun sx : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun sy : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun sz : forall _ : nat, Integers.Int64.int =>
                   @ex Integers.Int.int
                     (fun sumflag : Integers.Int.int =>
                      @ex (forall _ : nat, Integers.Int64.int)
                        (fun ox : forall _ : nat, Integers.Int64.int =>
                         @ex (forall _ : nat, Integers.Int64.int)
                           (fun oy : forall _ : nat, Integers.Int64.int =>
                            and
                              (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                 (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_generate_internal)
                                 (@cons Values.val (Values.Vptr bg Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr ba oa)
                                       (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val))))
                                 Events.E0 mf
                                 (Values.Vint
                                    (jet_secp_field_cmov.cmov_int
                                       (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                                          (jet_secp_generator_hash_map.generator_hash_accepted true key)))))
                              (and (hashgen_result key mf bg sx sy sz sumflag ox oy)
                                 (and
                                    (Memory.Mem.range_perm mf bg BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (forall (i : nat) (_ : lt i (S (S (S (S (S (S (...)))))))),
                                        @eq (option Values.val)
                                          (Memory.Mem.load AST.Mint8unsigned mf ba
                                             (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat i)))
                                          (@Some Values.val
                                             (Values.Vint
                                                (@List.nth Integers.Int.int i
                                                   (@List.map (Ty.tySem (Word.Word (S (...)))) Integers.Int.int
                                                      jet_read8s_layout.word8_array_value
                                                      (jet_buffer_input.vector_values (Word.Word (S (...)))
                                                         (S (S (...))) key)) Integers.Int.zero))))
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bg)) m
                                             mf)
                                          (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                             (and (jet_secp_sha_startup.secp_sha_startup mf)
                                                (and (jet_secp_swu_startup.swu_startup mf)
                                                   (forall prefix : bool,
                                                    jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix mf)))))))))))))))
### C.jet_secp_hashgen_function.hashgen_result
hashgen_result =
fun (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem) (bg : Values.block)
  (sx sy sz : forall _ : nat, Integers.Int64.int) (sumflag : Integers.Int.int)
  (ox oy : forall _ : nat, Integers.Int64.int) =>
and (jet_secp_square_columns.square_input_bounds sx)
  (and (jet_secp_square_columns.square_input_bounds sy)
     (and (jet_secp_square_columns.square_input_bounds sz)
        (and
           (@eq Integers.Int.int sumflag
              (jet_readBit_layout.bit_int
                 (Bit.toBool
                    (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
                       (jet_secp_rescale_literal.rescale_field_output sz)))))
           (and
              (forall (_ : @eq bool (jet_secp_generator_hash_map.generator_hash_accepted false key) true)
                 (_ : @eq bool (jet_secp_generator_hash_map.generator_hash_accepted true key) true),
               @eq
                 (prod
                    (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (@pair
                    (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (jet_secp_rescale_literal.rescale_field_output sx)
                       (jet_secp_rescale_literal.rescale_field_output sy))
                    (jet_secp_rescale_literal.rescale_field_output sz))
                 (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
                    (@pair
                       (prod
                          (Ty.tySem
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                       (Ty.tySem
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                             (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                       (@pair
                          (Ty.tySem
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                          (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem
                             (@jet_secp_generator_hash_literal.literal_generator_hash false Alg.CoreFunSem key))
                          (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))
                       (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem
                          (@jet_secp_generator_hash_literal.literal_generator_hash true Alg.CoreFunSem key)))))
              (and
                 (forall (second : bool) (i : nat)
                    (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))),
                  @eq (option Values.val)
                    (Memory.Mem.load AST.Mint8unsigned m bg
                       (BinInt.Z.add
                          match second return BinNums.Z with
                          | true =>
                              BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                          | false => BinNums.Z0
                          end (BinInt.Z.of_nat i)))
                    (@Some Values.val
                       (Values.Vint
                          (@List.nth Integers.Int.int i
                             (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                                (jet_secp_generator_codec.generator_saved_bytes
                                   (jet_secp_field_pair_multiply.field_pair_valuation ox oy)
                                   match second return nat with
                                   | true => S (S (S (S (S O))))
                                   | false => O
                                   end)) Integers.Int.zero))))
                 (and (jet_secp_square_columns.square_input_bounds ox)
                    (and (jet_secp_square_columns.square_input_bounds oy)
                       (and
                          (forall _ : @eq Integers.Int.int sumflag Integers.Int.zero,
                           @ex (forall _ : nat, Integers.Int64.int)
                             (fun zi : forall _ : nat, Integers.Int64.int =>
                              and
                                (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value zi)
                                   (jet_secp_invert_literal.literal_invert_numeric
                                      (jet_secp_fe_inv_prefix.fe_inv_value sz)))
                                (and
                                   (@eq (forall _ : nat, Integers.Int64.int) ox
                                      (jet_secp_point_mul_storage.point_mul_words sx
                                         (jet_secp_square_numeric.square_words zi)))
                                   (and
                                      (@eq (forall _ : nat, Integers.Int64.int) oy
                                         (jet_secp_point_mul_storage.point_mul_words sy
                                            (jet_secp_point_mul_storage.point_mul_words zi
                                               (jet_secp_square_numeric.square_words zi))))
                                      (and
                                         (@eq BinNums.Z
                                            (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value ox)
                                               jet_secp_fe_math.feP)
                                            (BinInt.Z.modulo
                                               (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value sx)
                                                  (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                                                     (jet_secp_multiply_finish_product.radix_value zi)))
                                               jet_secp_fe_math.feP))
                                         (@eq BinNums.Z
                                            (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value oy)
                                               jet_secp_fe_math.feP)
                                            (BinInt.Z.modulo
                                               (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value sy)
                                                  (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                                                     (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                                                        (jet_secp_multiply_finish_product.radix_value zi))))
                                               jet_secp_fe_math.feP)))))))
                          (forall _ : not (@eq Integers.Int.int sumflag Integers.Int.zero),
                           and
                             (@eq (forall _ : nat, Integers.Int64.int) ox
                                jet_secp_generator_affine_roundtrip.generator_infinite_words)
                             (@eq (forall _ : nat, Integers.Int64.int) oy
                                jet_secp_generator_affine_roundtrip.generator_infinite_words))))))))))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : Memory.Mem.mem)
         (_ : Values.block) (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments hashgen_result key m bg (sx sy sz)%function_scope sumflag (ox oy)%function_scope
