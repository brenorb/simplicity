### C.jet_taptweak_phase_glue_at.exec_taptweak_initial_then_at
exec_taptweak_initial_then_at
     : forall (ge : Clight.genv) (e : Clight.env) (le : Clight.temp_env) (m mi : Memory.Mem.mem)
         (lef : Clight.temp_env) (mf : Memory.Mem.mem) (out : ClightBigstep.outcome)
         (_ : ClightBigstep.Clight2.exec_stmt ge e le m jet_secp_taptweak_body_prefix.taptweak_initial_phase Events.E0
                le mi ClightBigstep.Out_normal)
         (_ : ClightBigstep.Clight2.exec_stmt ge e le mi
                (jet_secp_root_chain_owned.root_drop_statements (S (S (S (S O))))
                   (Clight.fn_body jets_secp.f_simplicity_generic_taptweak)) Events.E0 lef mf out),
       ClightBigstep.Clight2.exec_stmt ge e le m (Clight.fn_body jets_secp.f_simplicity_generic_taptweak) Events.E0 lef
         mf out
### C.jet_taptweak_phase_glue_at.exec_taptweak_key_then_at
exec_taptweak_key_then_at
     : forall (ge : Clight.genv) (e : Clight.env) (le : Clight.temp_env) (m mi : Memory.Mem.mem)
