                                              (jet_secp_linear_verify_arithmetic.linear_verify_arithmetic_storage ba bb
                                                 bk bg br bz)),
                                     Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                                    (and (jet_secp_linear_startup.linear_startup mf)
