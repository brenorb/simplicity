                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay))) true),
       @ex Memory.Mem.mem
         (fun ms : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mn : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mm : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun mf : Memory.Mem.mem =>
                   and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_set_ge)
                        (@cons Values.val (Values.Vptr bz Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ms
                        Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ms
