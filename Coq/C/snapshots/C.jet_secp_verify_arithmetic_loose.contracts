                              (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult)
                              (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vptr bz Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero)
                                       (@cons Values.val (Values.Vptr bg Integers.Ptrofs.zero) (@nil Values.val)))))
                              Events.E0 mm Values.Vundef)
                           (and
                              (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mm
                                 (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_add_ge_var)
                                 (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                                       (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                                          (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val)))))
                                 Events.E0 mf Values.Vundef)
                              (and
                                 (@eq (option Values.val)
