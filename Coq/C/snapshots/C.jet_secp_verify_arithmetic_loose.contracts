### C.jet_secp_verify_arithmetic_loose.verify_square_loose_bound
verify_square_loose_bound
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds w)
         (i : nat) (_ : lt i (S (S (S (S (S O)))))),
       BinInt.Z.le (Integers.Int64.unsigned (w i))
         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
### C.jet_secp_verify_arithmetic_loose.eval_verify_arithmetic_loose
eval_verify_arithmetic_loose
