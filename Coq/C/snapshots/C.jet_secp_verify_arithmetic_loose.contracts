                         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem raw)))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bg BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem ng)))))
         (_ : jet_secp_square_columns.square_input_bounds axr) (_ : jet_secp_square_columns.square_input_bounds ayr)
         (_ : jet_secp_square_columns.square_input_bounds bxr) (_ : jet_secp_square_columns.square_input_bounds byr)
