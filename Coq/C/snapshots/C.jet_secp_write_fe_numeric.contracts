### C.jet_secp_write_fe_numeric.eval_write_fe_from_canonical_field
eval_write_fe_from_canonical_field
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (w0 : bool) (outs0 : list BitMachine.Cell)
         (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : jet_secp_fe_nv.fe_at m b ofs
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value))))
         (_ : jet_sx_exec.xsep (jet_secp_write_fe_wrapper.write_ext m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b ofs)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : jet_secp_write_fe_wrapper.write_inv m0 bd dbase bw outedge cursor N bi rc w0 outs0
                (write_fe_rho (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value) rc)
                (@nil jet_sx_eval.event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr ofs)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi mf true
                  (@app BitMachine.Cell outs0
                     (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem value))))
               (jet_sx_mem.lframe
                  (jet_sx_exec.frame (jet_secp_write_fe_wrapper.write_ext m0 bd bw bi)
                     (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b ofs)
                        (@nil (prod Values.block BinNums.Z))) jet_secp_write_fe_wrapper.write_fe_initial_regs m) m mf)))
