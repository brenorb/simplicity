### C.jet_secp_add_pair_input.field_pair_input_slices
field_pair_input_slices
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))),
       and
         (jet_encoding.frame_input_cells_at m bi edge rc
            (@List.map bool (option bool) (@Some bool)
               (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) a)))
         (jet_encoding.frame_input_cells_at m bi edge
            (BinInt.Z.add rc
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
            (@List.map bool (option bool) (@Some bool)
               (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) b)))
