### C.jet_secp_fns.secp_pure_lookup
secp_pure_lookup
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef)
            (jet_sx_pure.symbol_lookup jet_secp_linkage.secp_ge) secp_pure)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun p : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) secp_pure)
### C.jet_secp_fns.secp_pure_ok
secp_pure_ok
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) secp_pure),
       @ex Values.block
         (fun b : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge) id)
               (@Some Values.block b))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge) b)
               (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))))
### C.jet_secp_fns.secp_pure
secp_pure =
@cons (prod AST.ident Clight.function)
  (@pair AST.ident Clight.function jets_secp._secp256k1_ctz64_var jets_secp.f_secp256k1_ctz64_var)
  (@cons (prod AST.ident Clight.function)
     (@pair AST.ident Clight.function jets_secp._secp256k1_umul128 jets_secp.f_secp256k1_umul128)
     (@cons (prod AST.ident Clight.function)
        (@pair AST.ident Clight.function jets_secp._secp256k1_mul128 jets_secp.f_secp256k1_mul128)
        (@cons (prod AST.ident Clight.function)
           (@pair AST.ident Clight.function jets_secp._secp256k1_u128_mul jets_secp.f_secp256k1_u128_mul)
           (@cons (prod AST.ident Clight.function)
              (@pair AST.ident Clight.function jets_secp._secp256k1_u128_accum_mul jets_secp.f_secp256k1_u128_accum_mul)
              (@cons (prod AST.ident Clight.function)
                 (@pair AST.ident Clight.function jets_secp._secp256k1_u128_accum_u64
                    jets_secp.f_secp256k1_u128_accum_u64)
                 (@cons (prod AST.ident Clight.function)
                    (@pair AST.ident Clight.function jets_secp._secp256k1_u128_rshift jets_secp.f_secp256k1_u128_rshift)
                    (@cons (prod AST.ident Clight.function)
                       (@pair AST.ident Clight.function jets_secp._secp256k1_u128_to_u64
                          jets_secp.f_secp256k1_u128_to_u64)
                       (@cons (prod AST.ident Clight.function)
                          (@pair AST.ident Clight.function jets_secp._secp256k1_u128_hi_u64
                             jets_secp.f_secp256k1_u128_hi_u64)
                          (@cons (prod AST.ident Clight.function)
                             (@pair AST.ident Clight.function jets_secp._secp256k1_u128_from_u64
                                jets_secp.f_secp256k1_u128_from_u64)
                             (@cons (prod AST.ident Clight.function)
                                (@pair AST.ident Clight.function jets_secp._secp256k1_i128_mul
                                   jets_secp.f_secp256k1_i128_mul)
                                (@cons (prod AST.ident Clight.function)
                                   (@pair AST.ident Clight.function jets_secp._secp256k1_i128_accum_mul
                                      jets_secp.f_secp256k1_i128_accum_mul)
                                   (@cons (prod AST.ident Clight.function)
                                      (@pair AST.ident Clight.function jets_secp._secp256k1_i128_rshift
                                         jets_secp.f_secp256k1_i128_rshift)
                                      (@cons (prod AST.ident Clight.function)
                                         (@pair AST.ident Clight.function jets_secp._secp256k1_i128_to_u64
                                            jets_secp.f_secp256k1_i128_to_u64)
                                         (@cons (prod AST.ident Clight.function)
                                            (@pair AST.ident Clight.function jets_secp._secp256k1_i128_to_i64
                                               jets_secp.f_secp256k1_i128_to_i64)
                                            (@cons (prod AST.ident Clight.function)
                                               (@pair AST.ident Clight.function
                                                  jets_secp._secp256k1_modinv64_signed62_assign
                                                  jets_secp.f_secp256k1_modinv64_signed62_assign)
                                               (@cons (prod AST.ident Clight.function)
                                                  (@pair AST.ident Clight.function
                                                     jets_secp._secp256k1_modinv64_normalize_62
                                                     jets_secp.f_secp256k1_modinv64_normalize_62)
                                                  (@cons (prod AST.ident Clight.function)
                                                     (@pair AST.ident Clight.function
                                                        jets_secp._secp256k1_modinv64_divsteps_62_var
                                                        jets_secp.f_secp256k1_modinv64_divsteps_62_var)
                                                     (@cons (prod AST.ident Clight.function)
                                                        (@pair AST.ident Clight.function
                                                           jets_secp._secp256k1_modinv64_update_de_62
                                                           jets_secp.f_secp256k1_modinv64_update_de_62)
                                                        (@cons (prod AST.ident Clight.function)
                                                           (@pair AST.ident Clight.function
                                                              jets_secp._secp256k1_modinv64_update_fg_62_var
                                                              jets_secp.f_secp256k1_modinv64_update_fg_62_var)
                                                           (@cons (prod AST.ident Clight.function)
                                                              (@pair AST.ident Clight.function
                                                                 jets_secp._secp256k1_modinv64_var
                                                                 jets_secp.f_secp256k1_modinv64_var)
                                                              (@cons (prod AST.ident Clight.function)
                                                                 (@pair AST.ident Clight.function
                                                                    jets_secp._secp256k1_fe_mul_inner
                                                                    jets_secp.f_secp256k1_fe_mul_inner)
                                                                 (@cons (...) (...) (...)))))))))))))))))))))))
     : list (prod AST.ident Clight.function)
