### C.jet_secp_generate_local.generate_initialized_local_spec_from_memset_steps
generate_initialized_local_spec_from_memset_steps
     : forall
         _ : forall (ma : Memory.Mem.mem) (mi : Memory.Mem.mem') (local ba b : Values.block)
               (_ : @eq (prod Memory.Mem.mem' Values.block)
                      (Memory.Mem.alloc ma BinNums.Z0
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (@pair Memory.Mem.mem' Values.block mi local))
               (_ : Memory.Mem.range_perm ma b BinNums.Z0
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                      Memtype.Cur Memtype.Freeable),
             @ex Memory.Mem.mem
               (fun mz : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_wnaf_digit.wnaf_env local)
                     (jet_secp_wnaf_entry15.wnaf_before_temps
                        (jet_secp_wnaf_entry15.wnaf_entry15_temps b BinNums.Z0 (Values.Vptr ba Integers.Ptrofs.zero)))
                     mi jet_secp_wnaf_entry15.wnaf_memset_call Events.E0
                     (jet_secp_wnaf_entry15.wnaf_before_temps
                        (jet_secp_wnaf_entry15.wnaf_entry15_temps b BinNums.Z0 (Values.Vptr ba Integers.Ptrofs.zero)))
                     mz ClightBigstep.Out_normal)
                  (and
                     (forall (i : BinNums.Z)
                        (_ : and (BinInt.Z.le BinNums.Z0 i)
                               (BinInt.Z.lt i
                                  (BinNums.Zpos
                                     (BinNums.xI
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mz b
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (jet_secp_wnaf_loop.wnaf_memory_effect b mi mz))),
       jet_secp_initialized_contract.secp_jet_initialized_local_spec jet_secp_generator_startup.generator_startup
         jets_secp.f_simplicity_generate (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@jet_secp_generate_program.literal_generate Alg.CoreFunSem)
### C.jet_secp_generate_local.generate_startup_old_blocks
generate_startup_old_blocks
     : forall (m mf : Memory.Mem.mem) (_ : jet_secp_generator_startup.generator_startup m)
         (_ : forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
              and (Memory.Mem.valid_block mf b)
                (and
                   (forall (chunk : AST.memory_chunk) (ofs : BinNums.Z),
                    @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                   (forall (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                      (_ : Memory.Mem.perm mf b ofs k p), Memory.Mem.perm m b ofs k p))),
       jet_secp_generator_startup.generator_startup mf
### C.jet_secp_generate_local.generate_runs_from_actual_init
generate_runs_from_actual_init
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (envv : Values.val)
         (_ : forall (ma : Memory.Mem.mem) (mi : Memory.Mem.mem') (local ba b : Values.block)
                (_ : @eq (prod Memory.Mem.mem' Values.block)
                       (Memory.Mem.alloc ma BinNums.Z0
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                       (@pair Memory.Mem.mem' Values.block mi local))
                (_ : Memory.Mem.range_perm ma b BinNums.Z0
                       (BinNums.Zpos
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                       Memtype.Cur Memtype.Freeable),
              @ex Memory.Mem.mem
                (fun mz : Memory.Mem.mem =>
                 and
                   (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_wnaf_digit.wnaf_env local)
                      (jet_secp_wnaf_entry15.wnaf_before_temps
                         (jet_secp_wnaf_entry15.wnaf_entry15_temps b BinNums.Z0 (Values.Vptr ba Integers.Ptrofs.zero)))
                      mi jet_secp_wnaf_entry15.wnaf_memset_call Events.E0
                      (jet_secp_wnaf_entry15.wnaf_before_temps
                         (jet_secp_wnaf_entry15.wnaf_entry15_temps b BinNums.Z0 (Values.Vptr ba Integers.Ptrofs.zero)))
                      mz ClightBigstep.Out_normal)
                   (and
                      (forall (i : BinNums.Z)
                         (_ : and (BinInt.Z.le BinNums.Z0 i)
                                (BinInt.Z.lt i
                                   (BinNums.Zpos
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
                       @eq (option Values.val)
                         (Memory.Mem.load AST.Mint32 mz b
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
                         (@Some Values.val (Values.Vint Integers.Int.zero)))
                      (jet_secp_wnaf_loop.wnaf_memory_effect b mi mz)))),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m : Memory.Mem.mem =>
             @ex Values.block
               (fun bd : Values.block =>
                @ex Values.block
                  (fun bs : Values.block =>
                   @ex Values.block
                     (fun bi : Values.block =>
                      @ex Values.block
                        (fun bw : Values.block =>
                         @ex BinNums.Z
                           (fun edge : BinNums.Z =>
                            @ex Memory.Mem.mem
                              (fun mf : Memory.Mem.mem =>
                               and
                                 (@eq (option Memory.Mem.mem)
                                    (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                                       (@Ctypes.program_of_program Clight.function jets_secp.prog))
                                    (@Some Memory.Mem.mem mi))
                                 (and (jet_secp_generator_startup.generator_startup mi)
                                    (and (jet_secp_generator_startup.generator_startup m)
                                       (and (jet_frame_layout.frame_fields_at m bs BinNums.Z0 bi edge BinNums.Z0)
                                          (and
                                             (jet_encoding.frame_input_cells_at m bi edge BinNums.Z0
                                                (@Translate.encode (Word.Word (S (S (S (...))))) value))
                                             (and
                                                (jet_output_layout.write_frame_at m bd BinNums.Z0 bw BinNums.Z0
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...)))))
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...))))))
                                                (and
                                                   (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                                      (@Ctypes.Internal Clight.function jets_secp.f_simplicity_generate)
                                                      (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                                                         (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                                                            (@cons Values.val envv (...)))) Events.E0 mf
                                                      (Values.Vint Integers.Int.one))
                                                   (and
                                                      (jet_frame_inv.finv m bd BinNums.Z0 bw BinNums.Z0
                                                         (BinNums.Zpos (BinNums.xO (...)))
                                                         (BinNums.Zpos (BinNums.xO (...))) bi mf true
                                                         (@Translate.encode
                                                            jet_secp_generate_literal.literal_generator_jacobian
                                                            (@jet_secp_generate_program.literal_generate Alg.CoreFunSem
                                                               value)))
                                                      (and (jet_secp_generator_startup.generator_startup mf)
                                                         (forall (b : Values.block) (chunk : AST.memory_chunk)
                                                            (ofs : BinNums.Z) (_ : Memory.Mem.valid_block mi b),
                                                          @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                                            (Memory.Mem.load chunk mi b ofs))))))))))))))))))
