### C.jet_secp_scalar_inverse_core.scalar_inv_core_body_source
scalar_inv_core_body_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_modinv64_var)
         (jet_secp_statement_prefix.statement_sequence
            (@List.firstn Clight.statement (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))
               (@fst (list Clight.statement) Clight.statement jet_secp_modinv_var_entry.inv_start_parts))
            (Clight.Ssequence jet_secp_modinv_var_zero.inv_caller_loop jet_secp_modinv_var_finish.inv_finish))
### C.jet_secp_scalar_inverse_core.scalar_inv_no_foot
scalar_inv_no_foot
     : forall (beta : jet_sx_state.layout)
         (sh : list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
         (b : Values.block) (ofs : BinNums.Z)
         (_ : forall (r : nat)
                (_ : lt r (@length (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) sh)),
              not (@eq Values.block b (jet_sx_state.blk beta r))), not (jet_sx_state.foot beta sh b ofs)
### C.jet_secp_scalar_inverse_core.scalar_inv_core_private_outside
scalar_inv_core_private_outside
     : forall (m : Memory.Mem.mem) (bs : Values.block) (betaN : list (prod Values.block BinNums.Z))
         (b : Values.block) (_ : @eq nat (@length (prod Values.block BinNums.Z) betaN) (S (S (S (S (S O))))))
         (_ : @List.Forall (prod Values.block BinNums.Z)
                (fun p : prod Values.block BinNums.Z => not (Memory.Mem.valid_block m (@fst Values.block BinNums.Z p)))
                betaN) (_ : Memory.Mem.valid_block m b),
       jet_secp_modinv_var_free.inv_free_outside
         (@app (prod Values.block BinNums.Z)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
               (@cons (prod Values.block BinNums.Z)
                  (@pair Values.block BinNums.Z jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block BinNums.Z0)
                  (@nil (prod Values.block BinNums.Z)))) betaN) b
### C.jet_secp_scalar_inverse_core.scalar_inv_core_prefix_outside
scalar_inv_core_prefix_outside
     : forall (m : Memory.Mem.mem) (bs : Values.block) (betaN : list (prod Values.block BinNums.Z))
         (b : Values.block) (ofs : BinNums.Z)
         (_ : @eq nat (@length (prod Values.block BinNums.Z) betaN) (S (S (S (S (S O))))))
         (_ : @List.Forall (prod Values.block BinNums.Z)
                (fun p : prod Values.block BinNums.Z => not (Memory.Mem.valid_block m (@fst Values.block BinNums.Z p)))
                betaN) (_ : Memory.Mem.valid_block m b) (_ : not (@eq Values.block b bs))
         (_ : not (@eq Values.block b jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block)),
       not
         (jet_sx_state.foot
            (@app (prod Values.block BinNums.Z)
               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
                  (@cons (prod Values.block BinNums.Z)
                     (@pair Values.block BinNums.Z jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block BinNums.Z0)
                     (@nil (prod Values.block BinNums.Z)))) betaN)
            (@List.map jet_sx_state.region
               (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
               (jet_sx_eval.sregs
                  (jet_secp_modinv_entry_modulus.inv_mod_start_state jet_secp_scalar_normalize62.modinfo_scalar_limb)))
            b ofs)
### C.jet_secp_scalar_inverse_core.scalar_inv_core_finish_outside
scalar_inv_core_finish_outside
     : forall (beta : jet_sx_state.layout) (b : Values.block) (ofs : BinNums.Z)
         (_ : not (@eq Values.block b (jet_sx_state.blk beta O)))
         (_ : not (@eq Values.block b jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block))
         (_ : @eq Values.block (jet_sx_state.blk beta (S O)) jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block)
         (_ : jet_secp_modinv_var_free.inv_free_outside beta b),
       jet_secp_scalar_inverse_loop_finish.scalar_inv_loop_finish_frame beta b ofs
### C.jet_secp_scalar_inverse_core.eval_scalar_inv_core
eval_scalar_inv_core
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bs : Values.block)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_secp_signed62_numeric.signed62_normalized w)
         (_ : and (BinInt.Z.le BinNums.Z0 (jet_secp_signed62_numeric.signed62_unsigned_value w))
                (BinInt.Z.lt (jet_secp_signed62_numeric.signed62_unsigned_value w)
                   jet_secp_canonical_scalar.canonical_group_order))
         (_ : not (@eq Values.block bs jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block))
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep m),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun words : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mr : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_var)
                  (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vptr jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block Integers.Ptrofs.zero)
                        (@nil Values.val))) Events.E0 mr Values.Vundef)
               (and (jet_secp_fe_nv.fe_at mr bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 words))
                  (and (jet_secp_signed62_numeric.signed62_normalized words)
                     (and
                        (@eq BinNums.Z (jet_secp_signed62_numeric.signed62_unsigned_value words)
                           (jet_secp_scalar_invert_literal.literal_scalar_invert_numeric
                              (jet_secp_signed62_numeric.signed62_unsigned_value w)))
                        (and
                           (forall (input : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (_ : @eq BinNums.Z (jet_secp_signed62_numeric.signed62_unsigned_value w)
                                     (BinInt.Z.modulo
                                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) input)
                                        jet_secp_canonical_scalar.canonical_group_order)),
                            @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
                              (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                 (jet_secp_signed62_numeric.signed62_unsigned_value words))
                              (@jet_secp_scalar_invert_literal.literal_scalar_invert Alg.CoreFunSem input))
                           (and
                              (Memory.Mem.range_perm mr bs BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep mr)
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bs))
                                       (not
                                          (@eq Values.block b jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block)))
                                    m mr)))))))))
