                                        (prod (prod (sum unit unit) (sum unit unit))
                                           (prod (sum unit unit) (sum unit unit)))
                                        (prod (prod (sum unit unit) (sum unit unit))
                                           (prod (sum unit unit) (sum unit unit)))))
                                  (prod
                                     (prod
                                        (prod (prod (sum unit unit) (sum unit unit))
                                           (prod (sum unit unit) (sum unit unit)))
                                        (prod (prod (sum unit unit) (sum unit unit))
                                           (prod (sum unit unit) (sum unit unit))))
                                     (prod
                                        (prod (prod (sum unit unit) (sum unit unit))
                                           (prod (sum unit unit) (sum unit unit)))
                                        (prod (prod (sum unit unit) (sum unit unit))
                                           (prod (sum unit unit) (sum unit unit))))))))) h))),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@vh_hash_spec pv ph
            (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) i e)
         (@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.from_hash256 (jet_bitcoin_composite_hash.sha256_bytes_of (vh_bytes v h)))))
### C.jet_bitcoin_vh_hash_spec.absorb_small
absorb_small
     : forall (bs l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (_ : lt
                (Nat.add (@length (Ty.tySem (Word.Word (S (S (S O))))) l)
                   (@length (Ty.tySem (Word.Word (S (S (S O))))) bs))
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq (prod (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int))
         (jet_sha_ctx8_model.absorb l regs bs)
         (@pair (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
            (@app (Ty.tySem (Word.Word (S (S (S O))))) l bs) regs)
### C.jet_bitcoin_vh_hash_spec.short_hash_regs
short_hash_regs
     : forall (bs : list (Ty.tySem (Word.Word (S (S (S O))))))
         (_ : lt (@length (Ty.tySem (Word.Word (S (S (S O))))) bs)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq SHA256.registers (Digest.hash256_reg (jet_bitcoin_composite_hash.sha256_bytes_of bs))
         (@snd (list Integers.Int.int) (list Integers.Int.int)
            (jet_sha_uchars_prep.absorb_i
               (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value bs)
               jet_sha256_iv_init.sha256_iv_words
               (jet_sha_finalize_exec.sha_pad
                  (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) bs))))))
### C.jet_bitcoin_vh_hash_spec.assert_spec
assert_spec =
fun (term : Alg.Assertion.Algebra) (A B : Ty.Ty) (t : Alg.Assertion.domain term A (Ty.Sum Ty.Unit B)) =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp A (Ty.Prod (Ty.Sum Ty.Unit B) Ty.Unit) B core
  (@jet_sha256_ctx8_init_spec.AC.pair A (Ty.Sum Ty.Unit B) Ty.Unit core t (@jet_sha256_ctx8_init_spec.AC.unit A core))
  (@Alg.Assertion.Combinators.assertr Ty.Unit B Ty.Unit B term jet_assertion_spec.assertion_cmr_fail0
     (@jet_sha256_ctx8_init_spec.AC.take B Ty.Unit B core (@jet_sha256_ctx8_init_spec.AC.iden B core)))
     : forall (term : Alg.Assertion.Algebra) (A B : Ty.Ty) (_ : Alg.Assertion.domain term A (Ty.Sum Ty.Unit B)),
       Alg.Assertion.domain term A B

Arguments assert_spec {term} {A B}%ty_scope t
### C.jet_bitcoin_vh_hash_spec.assert_iden_spec
assert_iden_spec =
fun (B : Ty.Ty) (term : Alg.Assertion.Algebra) =>
@assert_spec term (Ty.Sum Ty.Unit B) B
  (@jet_sha256_ctx8_init_spec.AC.iden (Ty.Sum Ty.Unit B) (Alg.Assertion.toCore term))
     : forall (B : Ty.Ty) (term : Alg.Assertion.Algebra), Alg.Assertion.domain term (Ty.Sum Ty.Unit B) B

Arguments assert_iden_spec B%ty_scope {term}
### C.jet_bitcoin_vh_hash_spec.vh_hash_spec
vh_hash_spec =
fun
  (pv : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
          (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
  (ph : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
          (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (alg : jet_bitcoin_full_prim.PF.Algebra) =>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) alg pv)
     (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg ph))
  (@jet_sha256_ctx8_init_spec.AC.case Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_sha256_ctx8_init_spec.AC.injl
        (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_sha256_ctx8_init_spec.AC.unit
           (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core))
     (@jet_sha256_ctx8_init_spec.AC.injr
        (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_sha256_ctx8_init_spec.AC.comp
           (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
           (@jet_sha256_ctx8_init_spec.AC.pair
              (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_sha256_ctx8_init_spec.AC.comp
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                    (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))) jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 core
                 (@jet_sha256_ctx8_init_spec.AC.pair
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                    core
                    (@jet_sha256_ctx8_init_spec.AC.comp
                       (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                          (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
                       jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                       (@jet_sha256_ctx8_init_spec.AC.unit
                          (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                             (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core)
                       (@jet_sha256_ctx8_init_spec.sha256_ctx8_init_spec core))
                    (@jet_sha256_ctx8_init_spec.AC.take (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O)))) core
                       (@jet_sha256_ctx8_init_spec.AC.iden (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O)))) core)))
                 (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S (S O))) term))
              (@jet_sha256_ctx8_init_spec.AC.drop (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@assert_iden_spec (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)))
           (@jet_sha256_ctx8_init_spec.AC.comp
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S (S (S (S O))))) term)
              (@jet_sha_finalize_spec.ctx8_finalize_spec term)))))
     : forall
         (_ : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
         (_ : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (alg : jet_bitcoin_full_prim.PF.Algebra),
       jet_bitcoin_full_prim.PF.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments vh_hash_spec pv ph {alg}
### C.jet_bitcoin_vh_hash_spec.vh_bytes
vh_bytes =
fun (v : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
=>
@app (Ty.tySem (Word.Word (S (S (S O))))) (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S O))) v)
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments vh_bytes v h
