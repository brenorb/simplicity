### C.jet_bitcoin_vh_hash_spec.assert_iden_spec_parametric
assert_iden_spec_parametric
     : forall B : Ty.Ty, @Alg.Assertion.Parametric (Ty.Sum Ty.Unit B) B (@assert_iden_spec B)
### C.jet_bitcoin_vh_hash_spec.assert_iden_option
assert_iden_option
     : forall (B : Ty.Ty) (x : Ty.tySem (Ty.Sum Ty.Unit B)),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B))
         (@assert_iden_spec B (Alg.AssertionSem Option.option_Monad_Zero) x)
         match x return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B)) with
         | inl _ => @None (Ty.tySem B)
         | inr b =>
             @Some
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B0 => sum (tySem A) (tySem B0)
                   | Ty.Prod A B0 => prod (tySem A) (tySem B0)
                   end) B) b
         end
