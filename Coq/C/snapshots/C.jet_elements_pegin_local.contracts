                            (BinNums.Zpos
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                            (Integers.Int64.unsigned r)))
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xI
                                     (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
