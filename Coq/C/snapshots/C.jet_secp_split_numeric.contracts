### C.jet_secp_split_numeric.literal_split_basis_range
literal_split_basis_range
     : forall first : bool,
       and (BinInt.Z.le BinNums.Z0 (jet_secp_split_literal.literal_split_basis_value first))
         (BinInt.Z.lt (jet_secp_split_literal.literal_split_basis_value first)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_split_numeric.literal_split_basis_word_value
literal_split_basis_word_value
     : forall first : bool,
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
            (jet_secp_split_literal.literal_split_basis_word first))
         (jet_secp_split_literal.literal_split_basis_value first)
### C.jet_secp_split_numeric.literal_split_product_numeric
literal_split_product_numeric
     : forall (first : bool) (k : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_split_literal.literal_split_product first Alg.CoreFunSem k))
         (BinInt.Z.mul
            (jet_secp_split_multipliers.split_coefficient first
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))
            (jet_secp_split_literal.literal_split_basis_value first))
