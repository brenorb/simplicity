### C.jet_secp_product_reduce_bridge.eight_words_nth
eight_words_nth
     : forall (xs : list Integers.Int64.int)
         (_ : @eq nat (@length Integers.Int64.int xs) (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Integers.Int64.int) xs
         (@cons Integers.Int64.int (@List.nth Integers.Int64.int O xs Integers.Int64.zero)
            (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S O) xs Integers.Int64.zero)
               (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S O)) xs Integers.Int64.zero)
                  (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S (S O))) xs Integers.Int64.zero)
                     (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S (S (S O)))) xs Integers.Int64.zero)
                        (@cons Integers.Int64.int
                           (@List.nth Integers.Int64.int (S (S (S (S (S O))))) xs Integers.Int64.zero)
                           (@cons Integers.Int64.int
                              (@List.nth Integers.Int64.int (S (S (S (S (S (S O)))))) xs Integers.Int64.zero)
                              (@cons Integers.Int64.int
                                 (@List.nth Integers.Int64.int (S (S (S (S (S (S (S O))))))) xs Integers.Int64.zero)
                                 (@nil Integers.Int64.int)))))))))
### C.jet_secp_product_reduce_bridge.product_reduce_input_map
product_reduce_input_map
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den (product_reduce_rho rho) beta)
            (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
               (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
                  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O))))
                        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O)))))
                           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S O))))))
                              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
                                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S O))))))))
                                    (@nil jet_sx_expr.sx))))))))))
         (@List.map Integers.Int64.int Values.val Values.Vlong
            (jet_secp_scalar_mul512_machine.scalar_mul512_machine_outputs rho))
### C.jet_secp_product_reduce_bridge.product_reduce_output_map
product_reduce_output_map
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta beta' : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den (product_reduce_rho rho) beta')
            (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S O)))))))))
               (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S O))))))))))
                  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S (S O)))))))))))
                     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
                        (@nil jet_sx_expr.sx))))))
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho beta)
            (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
               (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
                  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx))))))
### C.jet_secp_product_reduce_bridge.empty_region_index
empty_region_index
     : forall n : nat,
       @eq (option jet_sx_state.region) (@List.nth_error jet_sx_state.region (@nil jet_sx_state.region) n)
         (@None jet_sx_state.region)
### C.jet_secp_product_reduce_bridge.product_reduce_entry_rep
product_reduce_entry_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta (jet_sx_eval.sregs jet_secp_scalar_mul512_run.scalar_mul512_state) m),
       jet_sx_state.rep (product_reduce_rho rho) (product_reduce_layout beta)
         jet_secp_scalar_reduce512_run.scalar_reduce512_initial_regs m
### C.jet_secp_product_reduce_bridge.product_reduce_integer
product_reduce_integer
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (jet_secp_reduce512_body_numeric.reduce512_input_integer (product_reduce_rho rho))
         (BinInt.Z.mul (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)
            (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho (S (S (S (S O))))))
### C.jet_secp_product_reduce_bridge.product_reduce_foot_embed
product_reduce_foot_embed
     : forall (beta : jet_sx_state.layout) (b : Values.block) (ofs : BinNums.Z)
         (_ : jet_sx_state.foot (product_reduce_layout beta)
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   jet_secp_scalar_reduce512_run.scalar_reduce512_initial_regs) b ofs),
       jet_sx_state.foot beta
         (@List.map jet_sx_state.region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
            jet_sx_state.rshape jet_secp_scalar_mul512_fresh.scalar_mul512_fresh_regs) b ofs
### C.jet_secp_product_reduce_bridge.eval_product_then_reduce
eval_product_then_reduce
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta jet_secp_scalar_mul512_fresh.scalar_mul512_fresh_regs m),
       @ex Memory.Mem.mem
         (fun mp : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@cons Values.val
                           (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                              (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O))))) (@nil Values.val)))) Events.E0
                  mp Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mp
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_reduce_512)
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@cons Values.val
                           (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                           (@nil Values.val))) Events.E0 mf Values.Vundef)
                  (and
                     (jet_sx_state.rep (product_reduce_rho rho) (product_reduce_layout beta)
                        (jet_secp_reduce512_function_numeric.reduce512_numeric_owned_regs (product_reduce_rho rho)) mf)
                     (and
                        (@eq BinNums.Z
                           (jet_secp_reduce512_final_atomic.final_output_value
                              (jet_secp_reduce512_body_numeric.reduce512_body_digits (product_reduce_rho rho))
                              (jet_secp_reduce512_body_numeric.reduce512_body_carry (product_reduce_rho rho))
                              (product_reduce_rho rho) (jet_sx_state.lay (product_reduce_layout beta)))
                           (BinInt.Z.modulo
                              (BinInt.Z.mul (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)
                                 (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho (S (S (S (S O))))))
                              jet_secp_canonical_scalar.canonical_group_order))
                        (and
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (jet_sx_state.foot beta
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape jet_secp_scalar_mul512_fresh.scalar_mul512_fresh_regs) b ofs))
                              m mp)
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (jet_sx_state.foot (product_reduce_layout beta)
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape jet_secp_scalar_reduce512_run.scalar_reduce512_initial_regs)
                                    b ofs)) mp mf)))))))
### C.jet_secp_product_reduce_bridge.product_reduce_rho
product_reduce_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (n : nat) =>
match PeanoNat.Nat.ltb n (S (S (S (S (S (S (S (S O)))))))) return Integers.Int64.int with
| true =>
    @List.nth Integers.Int64.int n (jet_secp_scalar_mul512_machine.scalar_mul512_machine_outputs rho)
      Integers.Int64.zero
| false => rho (Nat.sub n (S (S (S (S (S (S (S (S O)))))))))
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments product_reduce_rho rho%function_scope n%nat_scope
### C.jet_secp_product_reduce_bridge.product_reduce_layout
product_reduce_layout =
fun beta : jet_sx_state.layout =>
@cons (prod Values.block BinNums.Z) (jet_sx_state.lay beta (S O))
  (@cons (prod Values.block BinNums.Z) (jet_sx_state.lay beta O) (@nil (prod Values.block BinNums.Z)))
     : forall _ : jet_sx_state.layout, jet_sx_state.layout

Arguments product_reduce_layout beta
