### C.jet_elements_write32_exec.eval_elements_write32_crossing_raw
eval_elements_write32_crossing_raw
     : forall (m mh mo ml mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor k : BinNums.Z) (oldhigh oldlow x : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid base)
         (_ : and
                (BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                   cursor) (BinInt.Z.le cursor Integers.Int64.max_unsigned))
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) k)
                (BinInt.Z.lt k
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq BinNums.Z (jet_write_layout.write_word_shift cursor) k) (_ : BinInt.Z.le BinNums.Z0 edge)
         (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                (jet_write_layout.write_word_address edge cursor))
         (_ : BinInt.Z.le
                (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (BinInt.Z.add Integers.Ptrofs.max_unsigned (BinNums.Zpos BinNums.xH)))
         (_ : jet_frame_layout.frame_fields_at m bf base bw edge cursor)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
                (@Some Values.val (Values.Vlong oldhigh)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor)
                   (Values.Vlong
                      (jet_word_slice.slice_high
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) k
                         oldhigh x))) (@Some Memory.Mem.mem mh))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mh bf
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong (Integers.Int64.repr cursor))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mh bf
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub cursor k)))) (@Some Memory.Mem.mem mo))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mo bw
                   (BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong oldlow)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mo bw
                   (BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (Values.Vlong
                      (jet_word_slice.slice_low
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) k x)))
                (@Some Memory.Mem.mem ml))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 ml bf
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub cursor k)))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 ml bf
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (Values.Vlong
                      (Integers.Int64.repr
                         (BinInt.Z.sub cursor
                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                (@Some Memory.Mem.mem mf)),
