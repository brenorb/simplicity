### C.jet_secp_rescale_owned.rescale_variable_table
rescale_variable_table
     : @eq jet_sx_eval.venv
         (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_rescale_prefix.rescale_allocated)
         (@cons (prod AST.ident (prod nat Ctypes.type))
            (@pair AST.ident (prod nat Ctypes.type) jets_secp._zz
               (@pair nat Ctypes.type (S (S O)) (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)))
            (@nil (prod AST.ident (prod nat Ctypes.type))))
### C.jet_secp_rescale_owned.rescale_local_blocks
rescale_local_blocks
     : forall bz : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (rescale_local_env bz))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bz BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
### C.jet_secp_rescale_owned.rescale_prefix_r
rescale_prefix_r
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx jets_secp._r (jet_sx_eval.stemps jet_secp_rescale_prefix.rescale_prefix_state))
         (@Some jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0))
### C.jet_secp_rescale_owned.rescale_prefix_s
rescale_prefix_s
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx jets_secp._s (jet_sx_eval.stemps jet_secp_rescale_prefix.rescale_prefix_state))
         (@Some jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0))
### C.jet_secp_rescale_owned.rescale_environment_exact
rescale_environment_exact
     : forall (e : Clight.env) (bp bs bz : Values.block)
         (_ : jet_sx_eval.ematch
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bz BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z)))))
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_rescale_prefix.rescale_allocated) e),
       @eq Clight.env e (rescale_local_env bz)
### C.jet_secp_rescale_owned.rescale_field_block_frame
rescale_field_block_frame
     : forall (m mf : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (w : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_fe_nv.fe_at m b ofs (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => @eq Values.block bx b) m mf),
       jet_secp_fe_nv.fe_at mf b ofs (jet_secp_multiply_normalize_bridge.words5 w)
### C.jet_secp_rescale_owned.eval_gej_rescale_owned
eval_gej_rescale_owned
     : forall (x y z s : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bp bs : Values.block)
         (flag : Integers.Int.int) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds y) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_square_columns.square_input_bounds s) (_ : not (@eq Values.block bp bs))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 s))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_rescale)
               (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bp BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5
                     (jet_secp_point_mul_storage.point_mul_words x (jet_secp_square_numeric.square_words s))))
               (and
                  (jet_secp_fe_nv.fe_at mf bp
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5
                        (jet_secp_point_mul_storage.point_mul_words
                           (jet_secp_point_mul_storage.point_mul_words y (jet_secp_square_numeric.square_words s)) s)))
                  (and
                     (jet_secp_fe_nv.fe_at mf bp
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_mul_storage.point_mul_words z s)))
                     (and (jet_secp_fe_nv.fe_at mf bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 s))
                        (and
                           (@eq (option Values.val)
                              (Memory.Mem.load AST.Mint32 mf bp
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                              (@Some Values.val (Values.Vint flag)))
                           (and
                              (Memory.Mem.range_perm mf bp BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bs BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_secp_square_columns.square_input_bounds
                                       (jet_secp_point_mul_storage.point_mul_words x
                                          (jet_secp_square_numeric.square_words s)))
                                    (and
                                       (jet_secp_square_columns.square_input_bounds
                                          (jet_secp_point_mul_storage.point_mul_words
                                             (jet_secp_point_mul_storage.point_mul_words y
                                                (jet_secp_square_numeric.square_words s)) s))
                                       (and
                                          (jet_secp_square_columns.square_input_bounds
                                             (jet_secp_point_mul_storage.point_mul_words z s))
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) =>
                                              and (not (@eq Values.block b bp)) (not (@eq Values.block b bs))) m mf))))))))))))
### C.jet_secp_rescale_owned.rescale_local_env
rescale_local_env =
fun bz : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._zz
  (@pair Values.block Ctypes.type bz (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)) Clight.empty_env
     : forall _ : Values.block, Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments rescale_local_env bz
