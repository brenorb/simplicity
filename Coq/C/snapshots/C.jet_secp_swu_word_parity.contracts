### C.jet_secp_swu_word_parity.swu_reader_words_odd
swu_reader_words_odd
     : forall t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool (jet_secp_field_odd_words.field_words_odd (jet_secp_square_spec_bridge.square_reader_rho t))
         (jet_secp_swu_parity.swu_input_odd t)
### C.jet_secp_swu_word_parity.swu_words_parity_matches_literal
swu_words_parity_matches_literal
     : forall (input x y : forall _ : nat, Integers.Int64.int) (_ : jet_secp_field_mul_small.mul_small_input_bounds y),
       @eq
         (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (jet_secp_rescale_literal.rescale_field_output x)
            (jet_secp_rescale_literal.rescale_field_output (swu_words_parity input y)))
         match
           jet_secp_field_odd_words.field_words_odd input
           return
             (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         with
         | true =>
             @jet_secp_gej_negate_literal.literal_ge_negate Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (jet_secp_rescale_literal.rescale_field_output x) (jet_secp_rescale_literal.rescale_field_output y))
         | false =>
             @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (jet_secp_rescale_literal.rescale_field_output x) (jet_secp_rescale_literal.rescale_field_output y)
         end
### C.jet_secp_swu_word_parity.swu_words_parity_reader
swu_words_parity_reader
     : forall (t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (w : forall _ : nat, Integers.Int64.int),
       @eq (forall _ : nat, Integers.Int64.int) (swu_words_parity (jet_secp_square_spec_bridge.square_reader_rho t) w)
         (jet_secp_swu_parity.swu_parity_words t w)
### C.jet_secp_swu_word_parity.swu_words_parity_reader_temps
swu_words_parity_reader_temps
     : forall (t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (le : Maps.PTree.tree Values.val),
       @eq (Maps.PTree.tree Values.val) (swu_words_parity_temps (jet_secp_square_spec_bridge.square_reader_rho t) le)
         (jet_secp_swu_parity.swu_parity_temps t le)
### C.jet_secp_swu_word_parity.swu_words_literal_output_reader
swu_words_literal_output_reader
     : forall t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (swu_words_literal_output (jet_secp_square_spec_bridge.square_reader_rho t) t)
         (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem t)
### C.jet_secp_swu_word_parity.exec_swu_words_odd_call
exec_swu_words_odd_call
     : forall (input : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bi : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_is_odd e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t le)
                (@Some Values.val (Values.Vptr bi Integers.Ptrofs.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd)
                (@cons Values.val (Values.Vptr bi Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
                (Values.Vint (jet_secp_field_cmov.cmov_int (jet_secp_field_odd_words.field_words_odd input)))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m jet_secp_swu_parity.swu_parity_odd_call
         Events.E0 (swu_words_parity_temps input le) mf ClightBigstep.Out_normal
### C.jet_secp_swu_word_parity.exec_swu_words_cmov_call
exec_swu_words_cmov_call
     : forall (input : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bt bp : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_cmov e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._tmp e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ge le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t'3 le)
                (@Some Values.val
                   (Values.Vint (jet_secp_field_cmov.cmov_int (jet_secp_field_odd_words.field_words_odd input)))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_cmov)
                (@cons Values.val
                   (Values.Vptr bp
                      (Integers.Ptrofs.repr
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                   (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                      (@cons Values.val
                         (Values.Vint (jet_secp_field_cmov.cmov_int (jet_secp_field_odd_words.field_words_odd input)))
                         (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m jet_secp_swu_parity.swu_parity_cmov_call
         Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_swu_word_parity.exec_swu_words_parity
exec_swu_words_parity
     : forall (input w : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bi bt bp : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_is_odd e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_cmov e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._tmp e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ge le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t le)
                (@Some Values.val (Values.Vptr bi Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bi (@cons Values.block bt (@cons Values.block bp (@nil Values.block)))))
         (_ : jet_secp_field_mul_small.mul_small_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bi BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 input))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bi BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m jet_secp_swu_parity.swu_parity_tail
               Events.E0 (swu_words_parity_temps input le) mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bp
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (jet_secp_multiply_normalize_bridge.words5 (swu_words_parity input w)))
               (and
                  (Memory.Mem.range_perm mf bi BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bt BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bp BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and (jet_sx_mem.lframe (jet_secp_swu_parity.swu_parity_frame bi bt bp) m mf)
                           (jet_clight_internal_preserve.readonly_preserved m mf)))))))
### C.jet_secp_swu_word_parity.swu_words_parity_temps
swu_words_parity_temps =
fun (input : forall _ : nat, Integers.Int64.int) (le : Maps.PTree.tree Values.val) =>
@Maps.PTree.set Values.val jets_secp._t'3
  (Values.Vint (jet_secp_field_cmov.cmov_int (jet_secp_field_odd_words.field_words_odd input))) le
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Maps.PTree.tree Values.val), Maps.PTree.tree Values.val

Arguments swu_words_parity_temps input%function_scope le
### C.jet_secp_swu_word_parity.swu_words_parity
swu_words_parity =
fun input w : forall _ : nat, Integers.Int64.int =>
match jet_secp_field_odd_words.field_words_odd input return (forall _ : nat, Integers.Int64.int) with
| true => jet_secp_field_negate_separate.negate_sep_words w
| false => w
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments swu_words_parity (input w)%function_scope i%nat_scope
### C.jet_secp_swu_word_parity.swu_words_literal_output
swu_words_literal_output =
fun (input : forall _ : nat, Integers.Int64.int) (t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
match
  jet_secp_field_odd_words.field_words_odd input
  return
    (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| true =>
    @jet_secp_gej_negate_literal.literal_ge_negate Alg.CoreFunSem
      (jet_secp_swu_literal_bridge.swu_selected_candidate t)
| false => jet_secp_swu_literal_bridge.swu_selected_candidate t
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments swu_words_literal_output input%function_scope t
