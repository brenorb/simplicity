### C.jet_secp_curve_group_sign.secp_group_curve_numeric
secp_group_curve_numeric
     : forall (x y : jet_secp_curve_group.secp_group_field)
         (_ : @eq (GZnZ.znz jet_secp_fe_math.feP)
                (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                   (GZnZ.mul jet_secp_fe_math.feP) y (S (S O)))
                (GZnZ.add jet_secp_fe_math.feP
                   (GZnZ.add jet_secp_fe_math.feP
                      (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                         (GZnZ.mul jet_secp_fe_math.feP) x (S (S (S O))))
                      (GZnZ.mul jet_secp_fe_math.feP (GZnZ.zero jet_secp_fe_math.feP) x))
                   jet_secp_curve_group.secp_group_seven)),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.mul (BinInt.Z.mul (GZnZ.val jet_secp_fe_math.feP x) (GZnZ.val jet_secp_fe_math.feP x))
                  (GZnZ.val jet_secp_fe_math.feP x)) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))
            jet_secp_fe_math.feP)
         (BinInt.Z.modulo (BinInt.Z.mul (GZnZ.val jet_secp_fe_math.feP y) (GZnZ.val jet_secp_fe_math.feP y))
            jet_secp_fe_math.feP)
### C.jet_secp_curve_group_sign.secp_group_field_opp_fixed
secp_group_field_opp_fixed
     : forall (y : jet_secp_curve_group.secp_group_field)
         (_ : @eq (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP y) y),
       @eq jet_secp_curve_group.secp_group_field y (GZnZ.zero jet_secp_fe_math.feP)
### C.jet_secp_curve_group_sign.secp_group_negation_fixed
secp_group_negation_fixed
     : forall (point : secp_group_point)
         (_ : @eq
                (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                   (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                   jet_secp_curve_group.secp_group_seven)
                (@SMain.opp (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                   (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                   (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
                   (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                   jet_secp_curve_group.secp_group_seven jet_secp_curve_group.secp_group_zero_test
                   jet_secp_curve_group.secp_group_theory point) point), @eq secp_group_point point secp_group_infinity
