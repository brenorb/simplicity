### C.jet_elements_lbtc_asset_exec.lbtc_body_shape
lbtc_body_shape
     : @eq Clight.statement (Clight.fn_body jets_elements.f_simplicity_lbtc_asset)
         (Clight.Ssequence jet_elements_wrapper.elements_copy_stmt
            (jet_u32_local_init.u32_local_prefix lbtc_array_expr O lbtc_asset_words
               (jet_elements_wrapper.elements_simple_rest lbtc_write_stmt)))
### C.jet_elements_lbtc_asset_exec.lbtc_blocks
lbtc_blocks
     : forall bl bh : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_linkage.elements_ge (lbtc_locals bl bh))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bh BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
### C.jet_elements_lbtc_asset_exec.lbtc_entry
lbtc_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem') (bl bh bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb bh)),
       Clight.function_entry2 jet_elements_linkage.elements_ge jets_elements.f_simplicity_lbtc_asset
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (lbtc_locals bl bh)
         (jet_elements_wrapper.elements_wrapper_temps jets_elements.f_simplicity_lbtc_asset env bd dbase bs sbase) mb
### C.jet_elements_lbtc_asset_exec.lbtc_copy
lbtc_copy
     : forall (m mc : Memory.Mem.mem) (bl bh bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge (lbtc_locals bl bh) le m
         jet_elements_wrapper.elements_copy_stmt Events.E0 le mc ClightBigstep.Out_normal
### C.jet_elements_lbtc_asset_exec.lbtc_array_eval
lbtc_array_eval
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bh : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._lbtc_assetid e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bh (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))),
       Clight.eval_expr jet_elements_linkage.elements_ge e le m lbtc_array_expr (Values.Vptr bh Integers.Ptrofs.zero)
### C.jet_elements_lbtc_asset_exec.lbtc_lhs_eval
lbtc_lhs_eval
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bh : Values.block) (j : nat)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._lbtc_assetid e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bh (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))))
         (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
       Clight.eval_lvalue jet_elements_linkage.elements_ge e le m (jet_u32_local_init.u32_local_lhs lbtc_array_expr j)
         bh
         (Integers.Ptrofs.repr
            (BinInt.Z.add BinNums.Z0
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j)))) Ctypes.Full
### C.jet_elements_lbtc_asset_exec.lbtc_write_call
lbtc_write_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m me : Memory.Mem.mem) (bh bd : Values.block) (dbase : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._lbtc_assetid e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bh (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._writeHash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                (@Ctypes.Internal Clight.function jets_elements.f_writeHash)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr bh Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 me
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m lbtc_write_stmt Events.E0 le me
         ClightBigstep.Out_normal
