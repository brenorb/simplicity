### C.jet_elements_lbtc_asset_exec.lbtc_array_expr
lbtc_array_expr =
Clight.Efield (Clight.Evar jets_elements._lbtc_assetid (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
  jets_elements._s
  (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     : Clight.expr
### C.jet_elements_lbtc_asset_exec.lbtc_write_stmt
lbtc_write_stmt =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._writeHash
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) Ctypes.Tnil))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Eaddrof
           (Clight.Evar jets_elements._lbtc_assetid (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_elements_lbtc_asset_exec.lbtc_locals
lbtc_locals =
fun bl bh : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._lbtc_assetid
  (@pair Values.block Ctypes.type bh (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._src
     (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Clight.empty_env)
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments lbtc_locals bl bh
