                (@Some Values.val (Values.Vlong value))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_u128_rshift)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vint
                        (Integers.Int.repr
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf b BinNums.Z0)
                  (@Some Values.val (Values.Vlong value)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val (Values.Vlong Integers.Int64.zero)))
                  (and
                     (forall (bb : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                        (p : Memtype.permission) (_ : Memory.Mem.perm m bb ofs k p), Memory.Mem.perm mf bb ofs k p)
                     (jet_sx_mem.lframe
                        (fun (bb : Values.block) (ofs : BinNums.Z) =>
                         not
                           (and (@eq Values.block bb b)
                              (and (BinInt.Z.le BinNums.Z0 ofs)
                                 (BinInt.Z.lt ofs
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) m
                        mf)))))
