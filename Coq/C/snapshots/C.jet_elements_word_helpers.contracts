### C.jet_elements_word_helpers.elements_clear_symbol
elements_clear_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            jets_elements._LSBclear)
         (@Some Values.block (jet_elements_linkage.elements_symbol_block jets_elements._LSBclear))
### C.jet_elements_word_helpers.elements_clear_funct
elements_clear_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._LSBclear) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_elements.f_LSBclear))
