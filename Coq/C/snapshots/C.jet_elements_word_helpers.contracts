### C.jet_elements_word_helpers.eval_elements_clear_width
eval_elements_clear_width
     : forall (m : Memory.Mem.mem) (w : Integers.Int64.int) (n : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
         (@Ctypes.Internal Clight.function jets_elements.f_LSBclear)
         (@cons Values.val (Values.Vlong w) (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))
         Events.E0 m (Values.Vlong (jet_word_bits.clear_low n w))
### C.jet_elements_word_helpers.eval_elements_keep_width
eval_elements_keep_width
     : forall (m : Memory.Mem.mem) (w : Integers.Int64.int) (n : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
         (@Ctypes.Internal Clight.function jets_elements.f_LSBkeep)
         (@cons Values.val (Values.Vlong w) (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))
         Events.E0 m (Values.Vlong (Integers.Int64.zero_ext n w))
