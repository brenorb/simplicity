### C.jet_secp_point_mul_numeric.field_operand_from_bounds
field_operand_from_bounds
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds w),
       jet_secp_field_mul_word_math.field_mul_operand_ok (Integers.Int64.unsigned (w O))
         (Integers.Int64.unsigned (w (S O))) (Integers.Int64.unsigned (w (S (S O))))
         (Integers.Int64.unsigned (w (S (S (S O))))) (Integers.Int64.unsigned (w (S (S (S (S O))))))
### C.jet_secp_point_mul_numeric.radix_value_as_fe_val
radix_value_as_fe_val
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value w)
         (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (w O)) (Integers.Int64.unsigned (w (S O)))
            (Integers.Int64.unsigned (w (S (S O)))) (Integers.Int64.unsigned (w (S (S (S O)))))
            (Integers.Int64.unsigned (w (S (S (S (S O)))))))
### C.jet_secp_point_mul_numeric.point_mul_value_and_bounds
point_mul_value_and_bounds
     : forall (a b : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds a)
         (_ : jet_secp_square_columns.square_input_bounds b),
       and
         (@eq BinNums.Z
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value (jet_secp_point_mul_storage.point_mul_words a b))
               jet_secp_multiply_checkpoint_columns.field_prime)
            (BinInt.Z.modulo
               (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                  (jet_secp_multiply_finish_product.radix_value b)) jet_secp_multiply_checkpoint_columns.field_prime))
         (jet_secp_square_columns.square_input_bounds (jet_secp_point_mul_storage.point_mul_words a b))
### C.jet_secp_point_mul_numeric.eval_point_mul_numeric
eval_point_mul_numeric
     : forall (k : jet_secp_point_write_run.point_coordinate) (a b : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bp bs : Values.block) (_ : jet_secp_square_columns.square_input_bounds a)
         (_ : jet_secp_square_columns.square_input_bounds b) (_ : not (@eq Values.block bp bs))
         (_ : jet_secp_fe_nv.fe_at m bp (jet_secp_point_write_run.point_coordinate_offset k)
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val
                  (Values.Vptr bp (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                  (@cons Values.val
                     (Values.Vptr bp (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                     (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bp (jet_secp_point_write_run.point_coordinate_offset k)
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_mul_storage.point_mul_words a b)))
               (and
                  (Memory.Mem.range_perm mf bp BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_secp_fe_nv.fe_at mf bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
                     (and
                        (Memory.Mem.range_perm mf bs BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_point_mul_storage.point_mul_words a b))
                                 jet_secp_multiply_checkpoint_columns.field_prime)
                              (BinInt.Z.modulo
                                 (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                                    (jet_secp_multiply_finish_product.radix_value b))
                                 jet_secp_multiply_checkpoint_columns.field_prime))
                           (and
                              (jet_secp_square_columns.square_input_bounds
                                 (jet_secp_point_mul_storage.point_mul_words a b))
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (pos : BinNums.Z) =>
                                  not
                                    (jet_sx_state.foot
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z bp BinNums.Z0)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bs BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z))))
                                       (@List.map jet_sx_state.region
                                          (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                          jet_sx_state.rshape (jet_secp_point_mul_run.point_mul_regs k)) bx pos)) m mf))))))))
