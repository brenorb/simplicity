### C.jet_read4_layout.eval_read4_layout_non_crossing
eval_read4_layout_non_crossing
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (w : Integers.Int64.int) (_ : jet_frame_layout.frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 cursor)
                (BinInt.Z.le cursor
                   (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : BinInt.Z.le
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
         (_ : and
                (BinInt.Z.le
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                         (BinInt.Z.div cursor
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                   edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned))
         (_ : jet_frame_layout.frame_fields_at m bf base bw edge cursor)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bw
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                            (BinInt.Z.div cursor
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong w)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bf
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (Values.Vlong
                      (Integers.Int64.repr (BinInt.Z.add cursor (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_simplicity_read4)
         (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mf
         (Values.Vint
            (read4_at
               (BinInt.Z.modulo cursor
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) w))
### C.jet_read4_layout.read4_result
read4_result =
fun w : Integers.Int64.int =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
  (Integers.Int.or Integers.Int.zero
     (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
        (Integers.Int.repr
           (Integers.Int64.unsigned
              (Integers.Int64.and w
                 (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
     : forall _ : Integers.Int64.int, Integers.Int.int

Arguments read4_result w
### C.jet_read4_layout.read4_at
read4_at =
fun (cursor : BinNums.Z) (w : Integers.Int64.int) =>
read4_result
  (Integers.Int64.shru w
     (Integers.Int64.repr
        (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))) cursor)))
     : forall (_ : BinNums.Z) (_ : Integers.Int64.int), Integers.Int.int

Arguments read4_at cursor%Z_scope w
### C.jet_read4_layout.le_read4_layout
le_read4_layout =
fun (bf : Values.block) (base : BinNums.Z) =>
@Maps.PTree.set Values.val jets._frame (Values.Vptr bf (Integers.Ptrofs.repr base))
  (Clight.create_undef_temps (Clight.fn_temps jets.f_simplicity_read4))
     : forall (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments le_read4_layout bf base%Z_scope
