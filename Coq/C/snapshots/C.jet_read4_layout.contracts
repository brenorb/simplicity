### C.jet_read4_layout.read4_cursor_arithmetic
read4_cursor_arithmetic
     : forall (cursor : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 cursor)
                (BinInt.Z.le cursor
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       and
         (@eq Integers.Int64.int
            (Integers.Int64.divu (Integers.Int64.repr cursor)
               (Integers.Int64.repr
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
            Integers.Int64.zero)
         (and
            (@eq Integers.Int64.int
               (Integers.Int64.modu (Integers.Int64.repr cursor)
                  (Integers.Int64.repr
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (Integers.Int64.repr cursor))
            (and
               (@eq Integers.Int64.int
                  (Integers.Int64.sub
                     (Integers.Int64.repr
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (Integers.Int64.repr cursor))
                  (Integers.Int64.repr
                     (BinInt.Z.sub
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        cursor)))
               (and
                  (@eq bool
                     (Integers.Int64.ltu
                        (Integers.Int64.repr
                           (BinInt.Z.sub
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              cursor)) (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))) false)
                  (and
                     (@eq Integers.Int64.int
                        (Integers.Int64.sub
                           (Integers.Int64.repr
                              (BinInt.Z.sub
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                 cursor)) (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (Integers.Int64.repr
                           (BinInt.Z.sub
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                              cursor)))
                     (and
                        (@eq bool
                           (Integers.Int64.ltu
                              (Integers.Int64.repr
                                 (BinInt.Z.sub
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                                    cursor)) Integers.Int64.iwordsize) true)
                        (@eq Integers.Int64.int
                           (Integers.Int64.add (Integers.Int64.repr cursor)
                              (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (Integers.Int64.repr
                              (BinInt.Z.add cursor (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
