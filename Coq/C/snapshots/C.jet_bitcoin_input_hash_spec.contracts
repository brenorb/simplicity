                               (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                            (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                               (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                         (prod
                            (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                               (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                            (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                               (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))))
                      sq)))
         (_ : @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                (@jet_bitcoin_full_prim.BitcoinFull.sem (Word.Word (S (S (S (S (S O))))))
                   (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (@jet_bitcoin_full_prim.BitcoinFull.Ext (Word.Word (S (S (S (S (S O))))))
                      (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                      jet_bitcoin_ext_prim.BitcoinExt.InputAnnexHash) i e)
                (@Some
                   (sum unit
                      (sum unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                   (@inr unit
                      (sum unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) ax))),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@input_hash_spec
            (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) i e)
         (@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.from_hash256 (jet_bitcoin_composite_hash.sha256_bytes_of (input_hash_bytes op sq ax)))))
### C.jet_bitcoin_input_hash_spec.stream_hash_regs
stream_hash_regs
     : forall bs : list (Ty.tySem (Word.Word (S (S (S O))))),
       @eq SHA256.registers (Digest.hash256_reg (jet_bitcoin_composite_hash.sha256_bytes_of bs))
         (@snd (list Integers.Int.int) (list Integers.Int.int)
            (jet_sha_uchars_prep.absorb_i
               (@fst (list Integers.Int.int) (list Integers.Int.int)
                  (jet_sha_uchars_prep.absorb_i (@nil Integers.Int.int) jet_sha256_iv_init.sha256_iv_words
                     (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int
                        jet_read8s_layout.word8_array_value bs)))
               (@snd (list Integers.Int.int) (list Integers.Int.int)
                  (jet_sha_uchars_prep.absorb_i (@nil Integers.Int.int) jet_sha256_iv_init.sha256_iv_words
                     (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int
                        jet_read8s_layout.word8_array_value bs)))
               (jet_sha_finalize_exec.sha_pad
                  (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) bs))))))
### C.jet_bitcoin_input_hash_spec.be32_bytes_word
be32_bytes_word
     : forall w : Integers.Int.int,
       @eq (list Integers.Int.int) (jet_sha_be32_write.c_be32_bytes (Integers.Int64.repr (Integers.Int.unsigned w)))
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
            (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S O))
               (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned w))))
### C.jet_bitcoin_input_hash_spec.w8_zero
w8_zero
     : @eq Integers.Int.int (jet_read8s_layout.word8_array_value jet_bitcoin_ctx_hash_spec.byte_zero)
         (Integers.Int.repr BinNums.Z0)
### C.jet_bitcoin_input_hash_spec.w8_one
w8_one
     : @eq Integers.Int.int (jet_read8s_layout.word8_array_value jet_bitcoin_ctx_hash_spec.byte_one)
         (Integers.Int.repr (BinNums.Zpos BinNums.xH))
### C.jet_bitcoin_input_hash_spec.input_hash_spec
input_hash_spec =
fun alg : jet_bitcoin_full_prim.PF.Algebra =>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_bitcoin_build_tapleaf_spec.AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
     (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@jet_bitcoin_build_tapleaf_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
     (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) core
     (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))) alg
        (@jet_bitcoin_full_prim.BitcoinFull.Base (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
           Bitcoin.Bitcoin.InputPrevOutpoint))
     (@jet_bitcoin_build_tapleaf_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core
        (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg
           (@jet_bitcoin_full_prim.BitcoinFull.Base (Word.Word (S (S (S (S (S O))))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) Bitcoin.Bitcoin.InputSequence))
        (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
           (@jet_bitcoin_full_prim.BitcoinFull.Ext (Word.Word (S (S (S (S (S O))))))
              (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              jet_bitcoin_ext_prim.BitcoinExt.InputAnnexHash))))
  (@jet_bitcoin_build_tapleaf_spec.AC.case Ty.Unit
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
     (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_bitcoin_build_tapleaf_spec.AC.injl
        (Ty.Prod Ty.Unit
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
              (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_bitcoin_build_tapleaf_spec.AC.unit
           (Ty.Prod Ty.Unit
              (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                 (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) core))
     (@jet_bitcoin_build_tapleaf_spec.AC.injr
        (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
              (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_bitcoin_build_tapleaf_spec.AC.comp
           (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
              (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                 (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
           (@jet_bitcoin_build_tapleaf_spec.AC.pair
              (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                 (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                    (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              core
              (@jet_bitcoin_build_tapleaf_spec.AC.comp
                 (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                    (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                       (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                 (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S O)))))))
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                 (@jet_bitcoin_build_tapleaf_spec.AC.pair
                    (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                       (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                          (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                    jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S O)))))) core
                    (@jet_bitcoin_build_tapleaf_spec.AC.comp
                       (Ty.Prod
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                          (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                             (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                       (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
                       jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                       (@jet_bitcoin_build_tapleaf_spec.AC.pair
                          (Ty.Prod
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                             (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                                (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                          jet_sha256_ctx8_init_spec.sha256_ctx8_type
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                          core
                          (@jet_bitcoin_build_tapleaf_spec.AC.comp
                             (Ty.Prod
                                (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                   (Word.Word (S (S (S (S (S O)))))))
                                (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                                   (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S ...))))))))))))
                             Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                             (@jet_bitcoin_build_tapleaf_spec.AC.unit
                                (Ty.Prod
                                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                      (Word.Word (S (S (S (S (S O)))))))
                                   (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                                      (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S ...))))))))))) core)
                             (@jet_sha256_ctx8_init_spec.sha256_ctx8_init_spec core))
                          (@jet_bitcoin_build_tapleaf_spec.AC.take
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                             (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                                (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                             core
                             (@jet_bitcoin_build_tapleaf_spec.AC.iden
                                (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                   (Word.Word (S (S (S (S (S O))))))) core)))
                       (@jet_bitcoin_ctx_hash_spec.outpoint_hash_spec term))
                    (@jet_bitcoin_build_tapleaf_spec.AC.drop
                       (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                       (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                          (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                       (Word.Word (S (S (S (S (S O)))))) core
                       (@jet_bitcoin_build_tapleaf_spec.AC.take (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                          (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                          (Word.Word (S (S (S (S (S O)))))) core
                          (@jet_bitcoin_vh_hash_spec.assert_iden_spec (Word.Word (S (S (S (S (S O)))))) term))))
                 (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S O)) term))
              (@jet_bitcoin_build_tapleaf_spec.AC.drop
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                 (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                    (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
                 (@jet_bitcoin_build_tapleaf_spec.AC.drop (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                    (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
                    (@jet_bitcoin_vh_hash_spec.assert_iden_spec
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term))))
           (@jet_bitcoin_build_tapleaf_spec.AC.comp
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_bitcoin_ctx_hash_spec.annex_hash_spec term) (@jet_sha_finalize_spec.ctx8_finalize_spec term)))))
     : forall alg : jet_bitcoin_full_prim.PF.Algebra,
       jet_bitcoin_full_prim.PF.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments input_hash_spec {alg}
### C.jet_bitcoin_input_hash_spec.input_hash_bytes
input_hash_bytes =
fun (op : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
  (sq : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
  (ax : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) =>
@app (Ty.tySem (Word.Word (S (S (S O))))) (jet_bitcoin_tx_hash.outpoint_bytes op)
  (@app (Ty.tySem (Word.Word (S (S (S O))))) (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S O)) sq)
     (jet_bitcoin_tx_hash.annex_elem_bytes ax))
     : forall (_ : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (_ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))),
       list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments input_hash_bytes op sq ax
