### C.jet_secp_owned_read_values.owned_read_selected_cells
owned_read_selected_cells
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list jet_sx_state.cell)
         (jet_secp_fe_nv.cells0
            (@fst jet_sx_eval.sstate jet_sx_exec.xout
               (jet_sx_exec.rsel rho layout (jet_secp_owned_read_run.owned_read_result size k bi edge))))
         (@List.map jet_sx_state.cell jet_sx_state.cell
            (jet_secp_point_read_values.point_shift_cell (jet_secp_point_write_run.point_coordinate_offset k))
            (jet_secp_fe_nv.cells0
               (@fst jet_sx_eval.sstate jet_sx_exec.xout
                  (jet_sx_exec.rsel rho layout (jet_secp_wrapper_run.read_fe_result bi edge)))))
### C.jet_secp_owned_read_values.owned_read_selected_checked
owned_read_selected_checked
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq bool
         (jet_sx_zrep.zreg_okb jet_secp_read_fe_numeric.read_bounds
            (jet_secp_point_write_run.point_coordinate_offset k)
            (jet_secp_fe_nv.cells0
               (@fst jet_sx_eval.sstate jet_sx_exec.xout
                  (jet_sx_exec.rsel rho layout (jet_secp_owned_read_run.owned_read_result size k bi edge))))) true
### C.jet_secp_owned_read_values.owned_read_selected_canonical
owned_read_selected_canonical
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (bi : Values.block) (edge : Integers.Ptrofs.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list BinNums.Z)
         (jet_sx_zrep.zcells
            (jet_sx_zval.zrho
               (jet_secp_wrapper_run.read_fe_rho
                  (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc))
            (jet_secp_fe_nv.cells0
               (@fst jet_sx_eval.sstate jet_sx_exec.xout
                  (jet_sx_exec.rsel
                     (jet_secp_wrapper_run.read_fe_rho
                        (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) layout
                     (jet_secp_owned_read_run.owned_read_result size k bi edge)))))
         (jet_secp_fe_math.fe_limbs_of
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem value)))
