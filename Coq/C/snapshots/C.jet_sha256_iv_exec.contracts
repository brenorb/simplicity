### C.jet_sha256_iv_exec.sha256_iv_jet_entry
sha256_iv_jet_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem') (bl biv bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb biv)),
       Clight.function_entry2 jet_exec.ge0 jets.f_simplicity_sha_256_iv
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (sha256_iv_jet_env bl biv) (sha256_iv_jet_temps env bd dbase bs sbase) mb
### C.jet_sha256_iv_exec.exec_sha256_iv_source_copy
exec_sha256_iv_source_copy
     : forall (m mc : Memory.Mem.mem) (bl biv bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (sha256_iv_jet_env bl biv) le m
         (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
            (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
### C.jet_sha256_iv_exec.sha256_iv_symbol
sha256_iv_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._sha256_iv)
         (@Some Values.block (jet_exec.jet_symbol_block jets._sha256_iv))
### C.jet_sha256_iv_exec.sha256_iv_funct
sha256_iv_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._sha256_iv) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_sha256_iv))
### C.jet_sha256_iv_exec.write32s_symbol
write32s_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._write32s)
         (@Some Values.block (jet_exec.jet_symbol_block jets._write32s))
### C.jet_sha256_iv_exec.write32s_funct
write32s_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._write32s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_write32s))
### C.jet_sha256_iv_exec.call_sha256_iv_init
call_sha256_iv_init
     : forall (m mf : Memory.Mem.mem) (bl biv : Values.block) (le : Clight.temp_env)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_sha256_iv)
                (@cons Values.val (Values.Vptr biv Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (sha256_iv_jet_env bl biv) le m
         (Clight.Scall (@None AST.ident)
            (Clight.Evar jets._sha256_iv
               (Ctypes.Tfunction (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint) Ctypes.Tnil) Ctypesdefs.tvoid
                  AST.cc_default))
            (@cons Clight.expr
               (Clight.Evar jets._iv
                  (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (@nil Clight.expr))) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_sha256_iv_exec.call_sha256_iv_write32s
call_sha256_iv_write32s
     : forall (m mf : Memory.Mem.mem) (bl biv : Values.block) (le : Maps.PTree.tree Values.val)
         (bd : Values.block) (dbase : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_write32s)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr biv Integers.Ptrofs.zero)
                      (@cons Values.val
                         (Values.Vlong
                            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                         (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (sha256_iv_jet_env bl biv) le m
         (Clight.Scall (@None AST.ident)
            (Clight.Evar jets._write32s
               (Ctypes.Tfunction
                  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
                     (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
                  Ctypesdefs.tvoid AST.cc_default))
            (@cons Clight.expr
               (Clight.Etempvar jets._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
               (@cons Clight.expr
                  (Clight.Evar jets._iv
                     (Ctypesdefs.tarray Ctypesdefs.tuint
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (@cons Clight.expr
                     (Clight.Econst_int
                        (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        Ctypesdefs.tint) (@nil Clight.expr))))) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_sha256_iv_exec.eval_sha256_iv_composes
eval_sha256_iv_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem') (mc mi me mt mf : Memory.Mem.mem)
         (bl biv bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb biv))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mb bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mb bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc (@Ctypes.Internal Clight.function jets.f_sha256_iv)
                (@cons Values.val (Values.Vptr biv Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mi Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mi (@Ctypes.Internal Clight.function jets.f_write32s)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr biv Integers.Ptrofs.zero)
                      (@cons Values.val
                         (Values.Vlong
                            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                         (@nil Values.val)))) Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mt))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free mt biv BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_sha_256_iv)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_sha256_iv_exec.sha256_iv_jet_env
sha256_iv_jet_env =
fun bl biv : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets._iv
  (@pair Values.block Ctypes.type biv
     (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
  (jet_one8.e_one8 bl)
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments sha256_iv_jet_env bl biv
### C.jet_sha256_iv_exec.sha256_iv_jet_temps
sha256_iv_jet_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_sha_256_iv bd (Integers.Ptrofs.repr dbase) bs
  (Integers.Ptrofs.repr sbase)
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments sha256_iv_jet_temps env bd dbase%Z_scope bs sbase%Z_scope
