### C.jets.f_forwardBits
f_forwardBits =
Clight.mkfunction Ctypesdefs.tvoid AST.cc_default
  (@cons (prod AST.ident Ctypes.type)
     (@pair AST.ident Ctypes.type _frame (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr)))
     (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type _n Ctypesdefs.tulong)
        (@nil (prod AST.ident Ctypes.type)))) (@nil (prod AST.ident Ctypes.type))
  (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type _t'1 Ctypesdefs.tulong)
     (@nil (prod AST.ident Ctypes.type)))
  (Clight.Ssequence
     (Clight.Sset _t'1
        (Clight.Efield
           (Clight.Ederef (Clight.Etempvar _frame (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr)))
              (Ctypes.Tstruct _frameItem Ctypes.noattr)) _offset Ctypesdefs.tulong))
     (Clight.Sassign
        (Clight.Efield
           (Clight.Ederef (Clight.Etempvar _frame (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr)))
              (Ctypes.Tstruct _frameItem Ctypes.noattr)) _offset Ctypesdefs.tulong)
        (Clight.Ebinop Cop.Oadd (Clight.Etempvar _t'1 Ctypesdefs.tulong) (Clight.Etempvar _n Ctypesdefs.tulong)
           Ctypesdefs.tulong)))
     : Clight.function
