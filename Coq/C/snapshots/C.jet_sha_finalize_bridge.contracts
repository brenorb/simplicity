### C.jet_sha_finalize_bridge.pad_equiv
pad_equiv
     : forall (l regs LB : list Integers.Int.int) (c : Integers.Int64.int)
         (_ : @eq BinNums.Z (BinInt.Z.of_nat (@length Integers.Int.int l))
                (BinInt.Z.modulo (Integers.Int64.unsigned c)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq nat (@length Integers.Int.int LB) (S (S (S (S (S (S (S (S O))))))))),
       let st : prod (list Integers.Int.int) (list Integers.Int.int) :=
         jet_sha_uchars_prep.absorb_i l regs
           (@cons Integers.Int.int
              (Integers.Int.repr
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
              (@List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S O))))))))) in
       @eq SHA256.registers
         (SHA256.hash_block (@snd (list Integers.Int.int) (list Integers.Int.int) st)
            (jet_sha_ctx8_model.be_words
               (@app Integers.Int.int
                  (@List.firstn Integers.Int.int
                     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))
                     (@app Integers.Int.int (@fst (list Integers.Int.int) (list Integers.Int.int) st)
                        (@List.repeat Integers.Int.int Integers.Int.zero
                           (Nat.sub (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))
                              (@length Integers.Int.int (@fst (list Integers.Int.int) (list Integers.Int.int) st))))))
                  LB)))
         (@snd (list Integers.Int.int) (list Integers.Int.int)
            (jet_sha_uchars_prep.absorb_i l regs (@app Integers.Int.int (jet_sha_finalize_exec.pad_bytes c) LB)))
