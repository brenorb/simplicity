### C.jet_secp_fe_inv_finish.fe_inv_local_blocks
fe_inv_local_blocks
     : forall bt bs : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (jet_secp_fe_inv_statements.fe_inv_env bt bs))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bs BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bt BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
### C.jet_secp_fe_inv_finish.exec_fe_inv_unpack_and_free
exec_fe_inv_unpack_and_free
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bt bs bd : Values.block)
         (w : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bd Integers.Ptrofs.zero))) (_ : not (@eq Values.block bt bs))
         (_ : not (@eq Values.block bd bt)) (_ : not (@eq Values.block bd bs))
         (_ : jet_secp_signed62_numeric.signed62_normalized w)
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_fe_inv_statements.fe_inv_env bt bs)
                  le m jet_secp_fe_inv_statements.fe_inv_unpack Events.E0 le mf ClightBigstep.Out_normal)
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.free_list mf
                        (Clight.blocks_of_env jet_secp_linkage.secp_ge (jet_secp_fe_inv_statements.fe_inv_env bt bs)))
                     (@Some Memory.Mem.mem mr))
                  (and
                     (jet_secp_fe_nv.fe_at mr bd BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_signed62_repack.fe_repack_words false w)))
                     (and
                        (Memory.Mem.range_perm mr bd BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_secp_fe_math.fe_limbs_ok
                              (Integers.Int64.unsigned (jet_secp_signed62_repack.fe_repack_words false w O))
                              (Integers.Int64.unsigned (jet_secp_signed62_repack.fe_repack_words false w (S O)))
                              (Integers.Int64.unsigned (jet_secp_signed62_repack.fe_repack_words false w (S (S O))))
                              (Integers.Int64.unsigned (jet_secp_signed62_repack.fe_repack_words false w (S (S (S O)))))
                              (Integers.Int64.unsigned
                                 (jet_secp_signed62_repack.fe_repack_words false w (S (S (S (S O)))))))
                           (and
                              (@eq BinNums.Z
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_signed62_repack.fe_repack_words false w))
                                 (jet_secp_signed62_numeric.signed62_unsigned_value w))
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block b bd))
                                    (and (not (@eq Values.block b bt)) (not (@eq Values.block b bs)))) m mr))))))))
