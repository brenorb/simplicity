                       (Memory.Mem.load AST.Mint64 m bt
                          (BinInt.Z.add tbase
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                       (@Some Values.val (Values.Vlong nI)))
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m bt
                          (BinInt.Z.add tbase
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                       (@Some Values.val (Values.Vlong ver)))
                (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add tbase BinNums.Z0))
                       (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
