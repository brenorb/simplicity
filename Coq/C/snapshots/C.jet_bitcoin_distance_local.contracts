                                (BinInt.Z.mul
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                   (Integers.Int64.unsigned ix)))
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
