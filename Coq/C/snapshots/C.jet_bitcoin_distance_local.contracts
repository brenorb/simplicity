                 (Clight.Etempvar jets_bitcoin._t'6 Ctypesdefs.tulong) Ctypesdefs.tint)
              (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint)))
              Clight.Sskip))))
  (Clight.Ssequence
     (Clight.Ssequence
        (Clight.Ssequence (Clight.Sset jets_bitcoin._t'2 jet_bitcoin_current_exec.bitcoin_env_tx_expr)
           (Clight.Ssequence (Clight.Sset jets_bitcoin._t'3 jet_bitcoin_current_exec.bitcoin_env_ix_expr)
              (Clight.Scall (@Some AST.ident jets_bitcoin._t'1) (Clight.Evar fid dist_fn_type)
                 (@cons Clight.expr
                    (Clight.Etempvar jets_bitcoin._t'2
                       (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
                    (@cons Clight.expr (Clight.Etempvar jets_bitcoin._t'3 Ctypesdefs.tulong) (@nil Clight.expr))))))
        (Clight.Scall (@None AST.ident)
           (Clight.Evar jets_bitcoin._simplicity_write16
              (Ctypes.Tfunction
                 (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
                    (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
           (@cons Clight.expr
              (Clight.Etempvar jets_bitcoin._dst
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
              (@cons Clight.expr (Clight.Etempvar jets_bitcoin._t'1 Ctypesdefs.tulong) (@nil Clight.expr)))))
     (Clight.Sreturn
