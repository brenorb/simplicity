### C.jet_bitcoin_distance_local.bitcoin_distance_env_rep
bitcoin_distance_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Values.block
              (fun bin : Values.block =>
               @ex BinNums.Z
                 (fun inbase : BinNums.Z =>
                  @ex Integers.Int64.int
                    (fun nI : Integers.Int64.int =>
                     @ex Integers.Int64.int
                       (fun ixv : Integers.Int64.int =>
                        @ex Integers.Int64.int
                          (fun ver : Integers.Int64.int =>
                           and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                             (and (BinInt.Z.le BinNums.Z0 ebase)
                                (and
                                   (BinInt.Z.le
                                      (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...))))))
                                      Integers.Ptrofs.max_unsigned)
                                   (and (BinInt.Z.le BinNums.Z0 txbase)
                                      (and
                                         (BinInt.Z.le (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO (...))))
                                            Integers.Ptrofs.max_unsigned)
                                         (and (BinInt.Z.le BinNums.Z0 inbase)
                                            (and (BinInt.Z.le (BinInt.Z.add inbase (...)) Integers.Ptrofs.max_unsigned)
                                               (and (@eq (...) (...) (...)) (and (...) (...))))))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_distance_env_rep m env environment
