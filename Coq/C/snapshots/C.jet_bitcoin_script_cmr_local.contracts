### C.jet_bitcoin_script_cmr_local.bitcoin_script_cmr_local_spec
bitcoin_script_cmr_local_spec
     : jet_application_sep.application_jet_local_spec_sep jets_bitcoin.f_simplicity_bitcoin_script_cmr
         jet_bitcoin_linkage.bitcoin_ge Bitcoin.Bitcoin.env Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         bitcoin_script_cmr_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : Bitcoin.Bitcoin.env) =>
          @bitcoin_script_cmr_spec
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a environment)
### C.jet_bitcoin_script_cmr_local.bitcoin_script_cmr_spec
bitcoin_script_cmr_spec =
fun alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra =>
@Bitcoin.PrimitiveBitcoin.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) alg
  Bitcoin.Bitcoin.ScriptCMR
     : forall alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra,
       Bitcoin.PrimitiveBitcoin.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments bitcoin_script_cmr_spec {alg}
### C.jet_bitcoin_script_cmr_local.bitcoin_script_cmr_env_rep
bitcoin_script_cmr_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
              (and (BinInt.Z.le BinNums.Z0 ebase)
                 (and
                    (BinInt.Z.le
                       (BinInt.Z.add ebase
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                       Integers.Ptrofs.max_unsigned)
                    (and (BinInt.Z.le BinNums.Z0 tbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add tbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val)
                                (Memory.Mem.load AST.Mptr m be
                                   (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                             (and
                                (jet_uint32_array_init.uint32_array_at m bt
                                   (BinInt.Z.add tbase
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                   (Digest.hash256_reg (Bitcoin.Bitcoin.envScriptCMR environment)))
                                (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                   (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                      (@pair (prod Values.block BinNums.Z) BinNums.Z
                                         (@pair Values.block BinNums.Z be
                                            (BinInt.Z.add ebase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                         (BinInt.Z.add ebase
                                            (BinNums.Zpos
                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                      (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                         (@pair (prod Values.block BinNums.Z) BinNums.Z
                                            (@pair Values.block BinNums.Z bt
                                               (BinInt.Z.add tbase
                                                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                            (BinInt.Z.add tbase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))
                                         (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments bitcoin_script_cmr_env_rep m env environment fp%list_scope
