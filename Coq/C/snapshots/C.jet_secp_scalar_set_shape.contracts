### C.jet_secp_scalar_set_shape.scalar_set_raw_state
scalar_set_raw_state =
match scalar_set_raw_tree return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone state _ => state
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_scalar_set_shape.scalar_set_raw_expressions
scalar_set_raw_expressions =
@List.map jet_sx_state.cell jet_sx_expr.sx
  (fun c : jet_sx_state.cell =>
   match jet_sx_state.cval c return jet_sx_expr.sx with
   | Some x => x
   | None => jet_sx_expr.XLc Integers.Int64.zero
   end) (jet_secp_fe_nv.cells0 scalar_set_raw_state)
     : list jet_sx_expr.sx
### C.jet_secp_scalar_set_shape.scalar_set_raw_sigma
scalar_set_raw_sigma =
fun n : nat => @List.nth jet_sx_expr.sx n scalar_set_raw_expressions (jet_sx_expr.XLc Integers.Int64.zero)
     : forall _ : nat, jet_sx_expr.sx

Arguments scalar_set_raw_sigma n%nat_scope
### C.jet_secp_scalar_set_shape.scalar_set_flag
scalar_set_flag =
jet_secp_scalar_bind.scalar_bind scalar_set_raw_sigma (jet_sx_expr.XIc Integers.Int.zero)
  jet_secp_scalar_overflow_exec.scalar_overflow_return
     : jet_sx_expr.sx
### C.jet_secp_scalar_set_shape.scalar_set_sigma
scalar_set_sigma =
fun n : nat =>
match PeanoNat.Nat.eqb n (S (S (S (S O)))) return jet_sx_expr.sx with
| true => jet_sx_expr.XI2L Ctypes.Signed scalar_set_flag
| false => scalar_set_raw_sigma n
end
     : forall _ : nat, jet_sx_expr.sx

Arguments scalar_set_sigma n%nat_scope
### C.jet_secp_scalar_set_shape.scalar_set_instantiate
scalar_set_instantiate =
jet_secp_scalar_bind.scalar_bind scalar_set_sigma scalar_set_flag
     : forall _ : jet_sx_expr.sx, jet_sx_expr.sx

Arguments scalar_set_instantiate x
### C.jet_secp_scalar_set_shape.scalar_set_raw_rho
scalar_set_raw_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) (n : nat) =>
jet_sx_expr.il (jet_sx_expr.den rho layout (scalar_set_raw_sigma n))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : nat),
