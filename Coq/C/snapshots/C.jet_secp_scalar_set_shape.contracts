fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) (i : nat) =>
jet_sx_expr.il
  (jet_sx_expr.den rho layout
     (scalar_set_instantiate
        (@List.nth jet_sx_expr.sx i
           (@cons jet_sx_expr.sx jet_secp_scalar_reduce_numeric.scalar_reduce_low0
              (@cons jet_sx_expr.sx jet_secp_scalar_reduce_numeric.scalar_reduce_low1
                 (@cons jet_sx_expr.sx jet_secp_scalar_reduce_numeric.scalar_reduce_low2
                    (@cons jet_sx_expr.sx jet_secp_scalar_reduce_numeric.scalar_reduce_low3 (@nil jet_sx_expr.sx)))))
           (jet_sx_expr.XLc Integers.Int64.zero))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : nat),
