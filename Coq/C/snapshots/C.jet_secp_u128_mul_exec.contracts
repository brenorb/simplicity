### C.jet_secp_u128_mul_exec.u128_mul_functions_ok
u128_mul_functions_ok
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) u128_mul_functions),
       @ex Values.block
         (fun b : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge) id)
               (@Some Values.block b))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge) b)
               (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))))
### C.jet_secp_u128_mul_exec.u128_mul_run_eq
u128_mul_run_eq
     : @eq (option jet_sx_exec.res) u128_mul_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone u128_mul_state jet_sx_exec.ONormal))
### C.jet_secp_u128_mul_exec.u128_mul_return
u128_mul_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps u128_mul_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_u128_mul_exec.u128_mul_output
u128_mul_output
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs u128_mul_state)
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg
               (jet_sx_rep.u64_cells BinNums.Z0
                  (@cons jet_sx_expr.sx jet_secp_umul128_exec.umul128_lo
                     (@cons jet_sx_expr.sx jet_secp_umul128_exec.umul128_hi (@nil jet_sx_expr.sx)))) true
               (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (@nil jet_sx_state.region))
### C.jet_secp_u128_mul_exec.u128_mul_log_nil
u128_mul_log_nil
     : @eq (list jet_sx_eval.event) (jet_sx_eval.slog u128_mul_state) (@nil jet_sx_eval.event)
### C.jet_secp_u128_mul_exec.eval_u128_mul_owned_product
eval_u128_mul_owned_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout u128_mul_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_u128_mul)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val (Values.Vlong (rho O))
                     (@cons Values.val (Values.Vlong (rho (S O))) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk layout O) (jet_sx_state.bas layout O))
                  (@Some Values.val
                     (Values.Vlong
                        (Integers.Int64.repr
                           (BinInt.Z.modulo
                              (BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S O))))
                              Integers.Int64.modulus)))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk layout O)
                        (BinInt.Z.add (jet_sx_state.bas layout O)
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val
                        (Values.Vlong
                           (Integers.Int64.repr
                              (BinInt.Z.div
                                 (BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S O))))
                                 Integers.Int64.modulus)))))
                  (and
                     (jet_sx_state.rep rho layout
                        (@cons jet_sx_state.region
                           (jet_sx_state.mkreg
                              (jet_sx_rep.u64_cells BinNums.Z0
                                 (@cons jet_sx_expr.sx jet_secp_umul128_exec.umul128_lo
                                    (@cons jet_sx_expr.sx jet_secp_umul128_exec.umul128_hi (@nil jet_sx_expr.sx))))
                              true
                              (@Some BinNums.Z
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                           (@nil jet_sx_state.region)) mf)
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot layout
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape u128_mul_initial_regs) b ofs)) m mf)))))
### C.jet_secp_u128_mul_exec.u128_mul_functions
u128_mul_functions =
@cons (prod AST.ident Clight.function)
  (@pair AST.ident Clight.function jets_secp._secp256k1_umul128 jets_secp.f_secp256k1_umul128)
  (@nil (prod AST.ident Clight.function))
     : list (prod AST.ident Clight.function)
### C.jet_secp_u128_mul_exec.u128_mul_initial_regs
u128_mul_initial_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells BinNums.Z0
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx)))) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  (@nil jet_sx_state.region)
     : list jet_sx_state.region
### C.jet_secp_u128_mul_exec.u128_mul_run
u128_mul_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table u128_mul_functions)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_u128_mul
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv O) (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O)) (@nil jet_sx_expr.sx))))
  u128_mul_initial_regs (@nil jet_sx_eval.event) (S (S (S (S O))))
     : option jet_sx_exec.res
### C.jet_secp_u128_mul_exec.u128_mul_tree
u128_mul_tree =
@Some jet_sx_exec.res
  (jet_sx_exec.RDone
     (jet_sx_eval.mkst (@Maps.PTree.Empty jet_sx_expr.sx)
        (@cons jet_sx_state.region
