### C.jet_elements_legacy_lock_spec.legacy_parse_tail_parametric
legacy_parse_tail_parametric
     : forall distance : bool,
       @Alg.Core.Parametric
         (Ty.Prod (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
            (Word.Word (S (S (S (S O)))))) (Word.Word (S (S (S (S O)))))
         (fun alg : Alg.Core.Algebra => @legacy_parse_tail distance alg)
### C.jet_elements_legacy_lock_spec.legacy_parse_tail_reader
legacy_parse_tail_reader
     : forall (distance : bool) (E : Type)
         (x : Ty.tySem
                (Ty.Prod (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
                   (Word.Word (S (S (S (S O))))))) (environment : E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Word.Word (S (S (S (S O)))))))
         (@legacy_parse_tail distance (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad)) x environment)
         (@Some (Ty.tySem (Word.Word (S (S (S (S O)))))) (@legacy_parse_tail distance Alg.CoreFunSem x))
### C.jet_elements_legacy_lock_spec.legacy_fold_body_reader
legacy_fold_body_reader
     : forall (distance : bool) (E : Type)
         (op : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad))
                 (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (p : Ty.tySem (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O)))))))
         (environment : E),
       @eq
         (Monad.CIMonad.domain Option.option_CIMonad
            (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))))
         (@legacy_fold_body distance (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad)) op p environment)
         (legacy_reader_step distance (fun w : Ty.tySem (Word.Word (S (S (S (S (S O)))))) => op w environment) p)
### C.jet_elements_legacy_lock_spec.legacy_fold_reader_list
legacy_fold_reader_list
     : forall (distance : bool) (X : Type) (xs : list X)
         (enc : forall _ : X, Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (op : Alg.Core.domain
                 (Alg.CoreSem (Reader.ReaderT_CIMonad jet_elements_prim.Elements.env Option.option_CIMonad))
                 (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (environment : jet_elements_prim.Elements.env)
         (a : prod
                (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                   (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                   (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
         (_ : BinInt.Z.lt (BinInt.Z.of_nat (@length X xs)) (jet_forWhile_seq.wsize (S (S (S (S (S O)))))))
         (_ : forall w : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
              @eq
                (Monad.CIMonad.domain Option.option_CIMonad
                   (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))) (op w environment)
                (@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                   match
                     @List.nth_error X xs (BinInt.Z.to_nat (jet_forWhile_seq.wz (S (S (S (S (S O))))) w))
                     return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                   with
                   | Some x => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (enc x)
                   | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))) tt
                   end)),
       @eq
         (Monad.CIMonad.domain Option.option_CIMonad
            (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))))
         (@jet_forWhile_spec.for_while_program (S (S (S (S (S O))))) Ty.Unit (Word.Word (S (S (S (S O)))))
            (Word.Word (S (S (S (S O)))))
            (Alg.CoreSem (Reader.ReaderT_CIMonad jet_elements_prim.Elements.env Option.option_CIMonad))
            (@legacy_fold_body distance
               (Alg.CoreSem (Reader.ReaderT_CIMonad jet_elements_prim.Elements.env Option.option_CIMonad)) op)
            (@pair unit
               (prod
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))) tt a)
            environment)
         (@Some
            (sum (Ty.tySem (Word.Word (S (S (S (S O))))))
               (prod
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))))
            (@inl (Ty.tySem (Word.Word (S (S (S (S O))))))
               (prod
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
               (@List.fold_left (Ty.tySem (Word.Word (S (S (S (S O)))))) X
                  (fun (acc : Ty.tySem (Word.Word (S (S (S (S O)))))) (x : X) => legacy_word_step distance acc (enc x))
                  xs a)))
### C.jet_elements_legacy_lock_spec.legacy_fold_program_parametric
legacy_fold_program_parametric
     : forall (distance : bool) (alg1 alg2 : Alg.Core.Algebra) (R : Alg.Core.Parametric.Rel alg1 alg2)
         (v1 : Alg.Core.domain alg1 Ty.Unit (Word.Word (S (S (S (S (S O)))))))
         (v2 : Alg.Core.domain alg2 Ty.Unit (Word.Word (S (S (S (S (S O)))))))
         (op1 : Alg.Core.domain alg1 (Word.Word (S (S (S (S (S O))))))
                  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (op2 : Alg.Core.domain alg2 (Word.Word (S (S (S (S (S O))))))
                  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (_ : @Alg.Core.Parametric.rel alg1 alg2 R Ty.Unit (Word.Word (S (S (S (S (S O)))))) v1 v2)
         (_ : @Alg.Core.Parametric.rel alg1 alg2 R (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) op1 op2),
       @Alg.Core.Parametric.rel alg1 alg2 R Ty.Unit (Word.Word (S (S (S (S O)))))
         (@legacy_fold_program distance alg1 v1 op1) (@legacy_fold_program distance alg2 v2 op2)
### C.jet_elements_legacy_lock_spec.legacy_sequence_value_range
legacy_sequence_value_range
     : forall (distance : bool) (s : BinNums.Z),
       and (BinInt.Z.le BinNums.Z0 (legacy_sequence_value distance s))
         (BinInt.Z.lt (legacy_sequence_value distance s)
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))))))
### C.jet_elements_legacy_lock_spec.legacy_max_word_value
legacy_max_word_value
     : forall a b : Ty.tySem (Word.Word (S (S (S (S O))))),
       @eq BinNums.Z
         (jet_forWhile_seq.wz (S (S (S (S O))))
            (@jet_minmax_spec.minmax_word_spec (S (S (S (S O)))) true Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S O)))))) (Ty.tySem (Word.Word (S (S (S (S O)))))) a b)))
         (BinInt.Z.max (jet_forWhile_seq.wz (S (S (S (S O)))) a) (jet_forWhile_seq.wz (S (S (S (S O)))) b))
### C.jet_elements_legacy_lock_spec.legacy_parse_tail_value
legacy_parse_tail_value
     : forall (distance : bool)
         (p : Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))))
         (a : prod
                (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                   (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                   (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S O))))))
         (@legacy_parse_tail distance Alg.CoreFunSem
            (@pair (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))))
               (prod
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))) p a))
         match p return (Ty.tySem (Word.Word (S (S (S (S O)))))) with
         | inl _ => a
         | inr t =>
             match t return (Ty.tySem (Word.Word (S (S (S (S O)))))) with
             | inl x =>
                 match distance return (Ty.tySem (Word.Word (S (S (S (S O)))))) with
                 | true =>
                     @jet_minmax_spec.minmax_word_spec (S (S (S (S O)))) true Alg.CoreFunSem
                       (@pair
                          (prod
                             (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                             (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                          (prod
                             (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                             (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                          x a)
                 | false => a
                 end
             | inr x =>
                 match distance return (Ty.tySem (Word.Word (S (S (S (S O)))))) with
                 | true => a
                 | false =>
                     @jet_minmax_spec.minmax_word_spec (S (S (S (S O)))) true Alg.CoreFunSem
                       (@pair
                          (prod
                             (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                             (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                          (prod
                             (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                             (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                          x a)
                 end
             end
         end
### C.jet_elements_legacy_lock_spec.legacy_word_step_value
legacy_word_step_value
     : forall (distance : bool) (a : Ty.tySem (Word.Word (S (S (S (S O))))))
         (x : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq BinNums.Z (jet_forWhile_seq.wz (S (S (S (S O)))) (legacy_word_step distance a x))
         (BinInt.Z.max (jet_forWhile_seq.wz (S (S (S (S O)))) a)
            (legacy_sequence_value distance (jet_forWhile_seq.wz (S (S (S (S (S O))))) x)))
### C.jet_elements_legacy_lock_spec.legacy_fold_value
legacy_fold_value
     : forall (distance : bool) (xs : list jet_elements_prim.sigTxInput) (a : Ty.tySem (Word.Word (S (S (S (S O)))))),
       @eq BinNums.Z
         (jet_forWhile_seq.wz (S (S (S (S O))))
            (@List.fold_left (Ty.tySem (Word.Word (S (S (S (S O)))))) jet_elements_prim.sigTxInput
               (fun (acc : Ty.tySem (Word.Word (S (S (S (S O)))))) (x : jet_elements_prim.sigTxInput) =>
                legacy_word_step distance acc
                  (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
                     (Integers.Int.unsigned (jet_elements_prim.sigTxiSequence x)))) xs a))
         (@List.fold_left BinNums.Z jet_elements_prim.sigTxInput
            (fun (acc : BinNums.Z) (x : jet_elements_prim.sigTxInput) =>
             BinInt.Z.max acc
               (legacy_sequence_value distance (Integers.Int.unsigned (jet_elements_prim.sigTxiSequence x)))) xs
            (jet_forWhile_seq.wz (S (S (S (S O)))) a))
### C.jet_elements_legacy_lock_spec.legacy_cache_value_range
legacy_cache_value_range
     : forall (distance : bool) (xs : list jet_elements_prim.sigTxInput),
       and (BinInt.Z.le BinNums.Z0 (legacy_cache_value distance xs))
         (BinInt.Z.lt (legacy_cache_value distance xs)
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))))))
### C.jet_elements_legacy_lock_spec.elements_legacy_version_check_value
elements_legacy_version_check_value
     : forall environment : jet_elements_prim.Elements.env,
       @ex (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (fun b : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit) =>
          and
            (@eq
               (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                  (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)))
               (@legacy_version_check
                  (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore
                     (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))
                  (@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim Ty.Unit
                     (Word.Word (S (S (S (S (S O))))))
                     (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)
                     jet_elements_prim.Elements.Version) tt environment) (@Some (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) b))
            (@eq bool (Bit.toBool b)
               (BinInt.Z.leb (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (Integers.Int.unsigned
                     (jet_elements_prim.sigTxVersion (jet_elements_prim.Elements.envTx environment))))))
### C.jet_elements_legacy_lock_spec.legacy_fold_finish_reader
legacy_fold_finish_reader
     : forall (distance : bool)
         (op : Alg.Core.domain
                 (Alg.CoreSem (Reader.ReaderT_CIMonad jet_elements_prim.Elements.env Option.option_CIMonad))
                 (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (a
          result : prod
                     (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                        (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                     (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                        (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
         (b : sum unit unit) (environment : jet_elements_prim.Elements.env)
         (_ : @eq
                (Monad.CIMonad.domain Option.option_CIMonad
                   (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))))
                (@jet_forWhile_spec.for_while_program (S (S (S (S (S O))))) Ty.Unit (Word.Word (S (S (S (S O)))))
                   (Word.Word (S (S (S (S O)))))
                   (Alg.CoreSem (Reader.ReaderT_CIMonad jet_elements_prim.Elements.env Option.option_CIMonad))
                   (@legacy_fold_body distance
                      (Alg.CoreSem (Reader.ReaderT_CIMonad jet_elements_prim.Elements.env Option.option_CIMonad)) op)
                   (@pair unit
                      (prod
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))) tt a)
                   environment)
                (@Some
                   (sum
                      (prod
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                      (prod
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))))
                   (@inl
                      (prod
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                      (prod
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                         (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                            (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                      result))),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Word.Word (S (S (S (S O)))))))
         (@legacy_fold_finish distance
            (Alg.CoreSem (Reader.ReaderT_CIMonad jet_elements_prim.Elements.env Option.option_CIMonad)) op
            (@pair (sum unit unit)
               (prod
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))) b a)
            environment)
         (@Some
            (prod
               (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
               (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
            match
              Bit.toBool b
              return
                (prod
                   (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                      (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                   (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                      (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
            with
            | true => result
            | false => a
            end)
### C.jet_elements_legacy_lock_spec.elements_legacy_lock_spec_value
elements_legacy_lock_spec_value
     : forall (distance : bool) (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S O)))))))
         (@elements_legacy_lock_spec distance
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt
            environment)
         (@Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S O)))))))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S O)))))
               match
                 BinInt.Z.leb (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (Integers.Int.unsigned
                      (jet_elements_prim.sigTxVersion (jet_elements_prim.Elements.envTx environment)))
                 return BinNums.Z
               with
               | true =>
                   legacy_cache_value distance
                     (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment))
               | false => BinNums.Z0
               end))
### C.jet_elements_legacy_lock_spec.legacy_parse_tail
legacy_parse_tail =
fun (distance : bool) (alg : Alg.Core.Algebra) =>
@Alg.Core.Combinators.case Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
  (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))) alg
  (@Alg.Core.Combinators.drop Ty.Unit (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))) alg
     (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S O))))) alg))
  match
    distance
    return
      (Alg.Core.domain alg
         (Ty.Prod (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))) (Word.Word (S (S (S (S O))))))
         (Word.Word (S (S (S (S O))))))
  with
  | true =>
      @Alg.Core.Combinators.case (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))
        (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))) alg
