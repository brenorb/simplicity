### C.jet_elements_legacy_lock_spec.legacy_fold_body
legacy_fold_body =
fun (distance : bool) (alg : Alg.Core.Algebra)
  (op : Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))) =>
