              (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
              (Word.Word (S (S (S (S O))))) alg
              (@Alg.Core.Combinators.take (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S O)))))
                 (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))) alg
