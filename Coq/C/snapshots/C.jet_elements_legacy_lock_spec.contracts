                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))) (Ty.tySem (Word.Word (S (S (S (S O))))))
             (legacy_word_step distance
                (@snd
                   (prod
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) Ty.Unit)
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word (S (S (S (S (S O))))))))
                   (prod
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end)
                         ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                             match n return Ty.Ty with
                             | O => X
                             | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                             end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end)
                         ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                             match n return Ty.Ty with
                             | O => X
                             | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                             end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))) p) x))
    end
| None => @None (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
end
     : forall (_ : bool)
         (_ : forall _ : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
              option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))))
         (_ : Ty.tySem (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O))))))),
       option (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))

Arguments legacy_reader_step distance%bool_scope op%function_scope p
### C.jet_elements_legacy_lock_spec.legacy_sequence_value
legacy_sequence_value =
fun (distance : bool) (s : BinNums.Z) =>
match
  BinInt.Z.testbit s (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))) return BinNums.Z
with
| true => BinNums.Z0
| false =>
    match
      match distance return bool with
      | true => negb (BinInt.Z.testbit s (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))
      | false => BinInt.Z.testbit s (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))
      end return BinNums.Z
    with
    | true =>
        BinInt.Z.modulo s
          (BinNums.Zpos
             (BinNums.xO
                (BinNums.xO
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))))
    | false => BinNums.Z0
    end
end
     : forall (_ : bool) (_ : BinNums.Z), BinNums.Z

Arguments legacy_sequence_value distance%bool_scope s%Z_scope
### C.jet_elements_legacy_lock_spec.legacy_cache_value
legacy_cache_value =
fun (distance : bool) (xs : list jet_elements_prim.sigTxInput) =>
@List.fold_left BinNums.Z jet_elements_prim.sigTxInput
  (fun (a : BinNums.Z) (x : jet_elements_prim.sigTxInput) =>
   BinInt.Z.max a (legacy_sequence_value distance (Integers.Int.unsigned (jet_elements_prim.sigTxiSequence x)))) xs
  BinNums.Z0
     : forall (_ : bool) (_ : list jet_elements_prim.sigTxInput), BinNums.Z

Arguments legacy_cache_value distance%bool_scope xs%list_scope
