  (Ty.Sum Ty.Unit Ty.Unit) alg
  (@Alg.Core.Combinators.pair Ty.Unit (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))) alg
     (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S O))))))
        (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S O))))) (BinNums.Zpos (BinNums.xO BinNums.xH))) alg)
     version) (@jet_order_spec.le_word_spec alg (S (S (S (S (S O))))))
     : forall (alg : Alg.Core.Algebra) (_ : Alg.Core.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))),
       Alg.Core.domain alg Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)

