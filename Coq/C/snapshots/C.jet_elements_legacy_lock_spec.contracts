  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O))))))
  (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))) alg
  (@Alg.Core.Combinators.pair
     (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O))))) alg
     (@Alg.Core.Combinators.take (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O)))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg
