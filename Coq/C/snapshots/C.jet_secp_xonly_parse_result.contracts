### C.jet_secp_xonly_parse_result.xonly_sum_distinct
@xonly_sum_distinct
     : forall (A B : Type) (a : A) (b : B), not (@eq (sum A B) (@inl A B a) (@inr A B b))
### C.jet_secp_xonly_parse_result.xonly_parse_success_iff
xonly_parse_success_iff
     : forall pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       iff (@eq Integers.Int.int (jet_secp_xonly_parse_field.xonly_parse_result pk) Integers.Int.one)
         (and
            (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) pk)
               jet_secp_fe_math.feP)
            (@ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (fun ax : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
                @ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (fun ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
                   @eq
                     (Ty.tySem
                        (Ty.Sum Ty.Unit
                           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                              (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                     (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
                        (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (@inl unit unit tt) pk))
                     (@inr unit
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay))))))
### C.jet_secp_xonly_parse_result.xonly_parse_failure_iff
xonly_parse_failure_iff
     : forall pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       iff (@eq Integers.Int.int (jet_secp_xonly_parse_field.xonly_parse_result pk) Integers.Int.zero)
         (or
            (BinInt.Z.le jet_secp_fe_math.feP
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) pk))
            (@eq
               (Ty.tySem
                  (Ty.Sum Ty.Unit
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
               (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
                  (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@inl unit unit tt) pk))
               (@inl unit
                  (prod
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt)))
### C.jet_secp_xonly_parse_result.eval_xonly_pubkey_parse_success
eval_xonly_pubkey_parse_success
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_memset_model.memset_model)
         (pk ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bout bin : Values.block)
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) pk)
                jet_secp_fe_math.feP)
         (_ : @eq
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
                   (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (@inl unit unit tt) pk))
                (@inr unit
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay)))
         (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bin BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes pk))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun storage : forall _ : nat, Integers.Int64.int =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_xonly_pubkey_parse)
                  (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                  (Values.Vint Integers.Int.one))
               (and (jet_secp_affine_storage.affine_storage_readable mf bout BinNums.Z0 storage)
                  (and
                     (@eq BinNums.Z (jet_secp_storage_numeric.field_storage_value storage)
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ax))
                     (and
                        (@eq BinNums.Z
                           (jet_secp_storage_numeric.field_storage_value
                              (fun i : nat => storage (Nat.add (S (S (S (S O)))) i)))
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ay))
                        (and
                           (Memory.Mem.range_perm mf bout BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bin BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bout)) (not (@eq Values.block b bin))) m mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
