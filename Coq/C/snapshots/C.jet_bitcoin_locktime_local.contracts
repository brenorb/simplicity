### C.jet_bitcoin_locktime_local.bitcoin_transaction_locktime_spec_parametric
bitcoin_transaction_locktime_spec_parametric
     : @Bitcoin.PrimitiveBitcoin.Primitive.Parametric Ty.Unit (Word.Word (S (S (S (S (S O))))))
         (@bitcoin_transaction_locktime_spec)
### C.jet_bitcoin_locktime_local.bitcoin_transaction_locktime_spec_sem
bitcoin_transaction_locktime_spec_sem
     : forall environment : Bitcoin.Bitcoin.env,
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (@bitcoin_transaction_locktime_spec
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt environment)
         (@Bitcoin.Bitcoin.sem Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.LockTime tt environment)
### C.jet_bitcoin_locktime_local.bitcoin_locktime_carrier_matches_primitive
bitcoin_locktime_carrier_matches_primitive
     : forall (r : Integers.Int64.int) (environment : Bitcoin.Bitcoin.env)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r)
                (Integers.Int.unsigned (Bitcoin.sigTxLock (Bitcoin.Bitcoin.envTx environment)))),
       @eq (option (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W32))))
         (@Some (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W32)))
            (jet_wide_spec.decode_wide jet_wide.W32
               (Integers.Int64.zero_ext
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) r)))
         (@Bitcoin.Bitcoin.sem Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.LockTime tt environment)
### C.jet_bitcoin_locktime_local.bitcoin_locktime_local_spec
bitcoin_locktime_local_spec
     : jet_application_contract.application_jet_local_spec jets_bitcoin.f_simplicity_bitcoin_lock_time
         jet_bitcoin_linkage.bitcoin_ge Bitcoin.Bitcoin.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
         bitcoin_locktime_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : Bitcoin.Bitcoin.env) =>
          @bitcoin_transaction_locktime_spec
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a environment)
### C.jet_bitcoin_locktime_local.bitcoin_transaction_locktime_spec
bitcoin_transaction_locktime_spec =
fun alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra =>
@Bitcoin.PrimitiveBitcoin.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
  Bitcoin.Bitcoin.LockTime
     : forall alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra,
       Bitcoin.PrimitiveBitcoin.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))

Arguments bitcoin_transaction_locktime_spec {alg}
### C.jet_bitcoin_locktime_local.bitcoin_locktime_env_rep
bitcoin_locktime_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun value : Integers.Int64.int =>
               and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                 (and (and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
                    (and (BinInt.Z.le BinNums.Z0 txbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add txbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                             (and
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint64 m bt
                                      (BinInt.Z.add txbase
                                         (BinNums.Zpos
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))))
                                   (@Some Values.val (Values.Vlong value)))
                                (@eq BinNums.Z (Integers.Int64.unsigned value)
                                   (Integers.Int.unsigned (Bitcoin.sigTxLock (Bitcoin.Bitcoin.envTx environment))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_locktime_env_rep m env environment
