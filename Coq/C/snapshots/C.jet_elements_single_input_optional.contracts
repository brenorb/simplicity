### C.jet_elements_single_input_optional.eih_uchar_stmt_exec
eih_uchar_stmt_exec
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bx : Values.block) (x : Integers.Int.int) (vr : Values.val)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_uchar e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))))
         (_ : @eq Integers.Int.int
                (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) x) x)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
                (@Ctypes.Internal Clight.function jets_elements.f_sha256_uchar)
                (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vint x) (@nil Values.val))) Events.E0 mf vr),
       ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m (eih_uchar_stmt x) Events.E0 le
         mf ClightBigstep.Out_normal
### C.jet_elements_single_input_optional.eih_optional_stmt_exec
eih_optional_stmt_exec
     : forall (temp flag field : AST.ident) (df dh : BinNums.Z) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bx bin : Values.block)
         (ofs : BinNums.Z) (h : option Digest.hash256) (_ : not (@eq AST.ident temp jets_elements._input))
         (_ : jet_elements_field_eval.elements_field_at jets_elements._sigInput flag df)
         (_ : jet_elements_field_eval.elements_field_at jets_elements._sigInput field dh)
         (_ : BinInt.Z.le BinNums.Z0 df)
         (_ : BinInt.Z.lt df
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : BinInt.Z.le BinNums.Z0 dh)
         (_ : BinInt.Z.le
                (BinInt.Z.add dh
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_uchar e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_hash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._input le)
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bin (BinInt.Z.add ofs df))
                (@Some Values.val
                   (Values.Vint
                      (jet_readBit_layout.bit_int match h return bool with
                                                  | Some _ => true
                                                  | None => false
                                                  end))))
         (_ : jet_elements_single_input_payload.eih_optional_calls bx bin (BinInt.Z.add ofs dh) h m mf),
       ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m
         (eih_optional_stmt temp flag field) Events.E0
         (@Maps.PTree.set Values.val temp
            (Values.Vint (jet_readBit_layout.bit_int match h return bool with
                                                     | Some _ => true
                                                     | None => false
                                                     end)) le) mf ClightBigstep.Out_normal
### C.jet_elements_single_input_optional.eih_input_field
eih_input_field =
fun (f : AST.ident) (t : Ctypes.type) =>
Clight.Efield
  (Clight.Ederef
     (Clight.Etempvar jets_elements._input (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)))
     (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)) f t
     : forall (_ : AST.ident) (_ : Ctypes.type), Clight.expr

Arguments eih_input_field f t
### C.jet_elements_single_input_optional.eih_uchar_stmt
eih_uchar_stmt =
fun x : Integers.Int.int =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._sha256_uchar
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
     (@cons Clight.expr (Clight.Econst_int x Ctypesdefs.tint) (@nil Clight.expr)))
     : forall _ : Integers.Int.int, Clight.statement

Arguments eih_uchar_stmt x
### C.jet_elements_single_input_optional.eih_hash_stmt
eih_hash_stmt =
fun f : AST.ident =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._sha256_hash
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) Ctypes.Tnil))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Eaddrof (eih_input_field f (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
        (@nil Clight.expr)))
     : forall _ : AST.ident, Clight.statement

Arguments eih_hash_stmt f
### C.jet_elements_single_input_optional.eih_optional_stmt
eih_optional_stmt =
fun temp flag field : AST.ident =>
Clight.Ssequence (Clight.Sset temp (eih_input_field flag Ctypesdefs.tbool))
  (Clight.Sifthenelse (Clight.Etempvar temp Ctypesdefs.tbool)
     (Clight.Ssequence (eih_uchar_stmt Integers.Int.one) (eih_hash_stmt field)) (eih_uchar_stmt Integers.Int.zero))
     : forall (_ : AST.ident) (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments eih_optional_stmt temp flag field
