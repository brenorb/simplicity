### C.jet_secp_modinv_fg_store.exec_fg_symbolic_index_store
exec_fg_symbolic_index_store
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem) (st : jet_sx_eval.sstate) (ve : jet_sx_eval.venv)
         (id : BinNums.positive) (r : nat) (reg : jet_sx_state.region) (ix : Clight.expr) (k : BinNums.Z)
         (src : Clight.expr) (term : jet_sx_expr.sx) (regs' : list jet_sx_state.region)
         (_ : jet_sx_state.rep rho beta (jet_sx_eval.sregs st) m)
         (_ : jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps st) le) (_ : jet_sx_eval.ematch beta ve e)
         (_ : @eq (option jet_sx_state.region) (@List.nth_error jet_sx_state.region (jet_sx_eval.sregs st) r)
                (@Some jet_sx_state.region reg))
         (_ : @eq (option BinNums.Z) (jet_sx_state.rfree reg)
                (@Some BinNums.Z
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx id (jet_sx_eval.stemps st))
                (@Some jet_sx_expr.sx (jet_sx_expr.XP r BinNums.Z0)))
         (_ : and (BinInt.Z.le BinNums.Z0 k) (BinInt.Z.lt k (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
         (_ : @eq Ctypes.type (Clight.typeof ix) Ctypesdefs.tint)
         (_ : @eq Ctypes.type (Clight.typeof src) Ctypesdefs.tulong)
         (_ : Clight.eval_expr jet_secp_linkage.secp_ge e le m ix (Values.Vint (Integers.Int.repr k)))
         (_ : @eq (option jet_sx_expr.sx)
                (jet_sx_eval.xexpr (Clight.genv_cenv jet_secp_linkage.secp_ge) ve
                   (@nil (prod AST.ident (prod nat Ctypes.type))) st src) (@Some jet_sx_expr.sx term))
         (_ : @eq bool (jet_sx_expr.isk jet_sx_expr.KL term) true)
         (_ : @eq (option (list jet_sx_state.region))
                (jet_sx_state.xstore (jet_sx_eval.sregs st) r
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) k) AST.Mint64 term)
                (@Some (list jet_sx_state.region) regs')),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (Clight.Sassign (jet_secp_modinv_fg_index.fg_index id ix) src) Events.E0 le mf ClightBigstep.Out_normal)
            (and (jet_sx_state.rep rho beta regs' mf)
               (and
                  (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                     (@List.map jet_sx_state.region
                        (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        jet_sx_state.rshape regs')
                     (@List.map jet_sx_state.region
                        (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        jet_sx_state.rshape (jet_sx_eval.sregs st)))
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (jet_sx_state.foot beta
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape (jet_sx_eval.sregs st)) b ofs)) m mf))))
