### C.jet_median_wide_exec.wide_median
wide_median =
fun s : jet_wide.wide_size =>
match s return Clight.function with
| jet_wide.W16 => jets.f_simplicity_median_16
| jet_wide.W32 => jets.f_simplicity_median_32
| jet_wide.W64 => jets.f_simplicity_median_64
end
     : forall _ : jet_wide.wide_size, Clight.function

Arguments wide_median s
### C.jet_median_wide_exec.median_int64
median_int64 =
fun r t u : Integers.Int64.int =>
@jet_median_spec.median_select Integers.Int64.int
  (fun a b : Integers.Int64.int => jet_order_wide_exec.wide_order_bit jet_order_spec.OLt a b) r t u
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments median_int64 r t u
