                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_double_var)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_double_all_calls.double_output_x_words x y)))
               (and
                  (jet_secp_fe_nv.fe_at mf br
