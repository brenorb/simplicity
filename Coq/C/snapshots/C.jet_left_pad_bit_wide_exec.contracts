### C.jet_left_pad_bit_wide_exec.wide_left_pad_bit_body
wide_left_pad_bit_body
     : forall s : jet_wide.wide_size,
       @eq Clight.statement (Clight.fn_body (wide_left_pad_bit s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence jet_complement1_exec.bit_jet_read
                  (Clight.Sset jets._bit (Clight.Ecast (Clight.Etempvar jets._t'1 Ctypesdefs.tbool) Ctypesdefs.tbool)))
               (Clight.Ssequence
                  (jet_arith8_layout_exec.frame_writer_call (jet_wide.wide_writer_id s) Ctypesdefs.tulong
                     Ctypesdefs.tvoid (Clight.Etempvar jets._bit Ctypesdefs.tbool))
                  (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))))))
### C.jet_left_pad_bit_wide_exec.wide_left_pad_bit_decode
wide_left_pad_bit_decode
     : forall (s : jet_wide.wide_size) (x : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)),
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log s)))
         (jet_wide_spec.decode_wide s
            (Integers.Int64.zero_ext (jet_wide.wide_bits s) (jet_readBit_layout.bit_long (Bit.toBool x))))
         (@jet_spec.left_pad_low_1_n Alg.CoreFunSem (jet_wide.wide_log s) x)
### C.jet_left_pad_bit_wide_exec.eval_wide_left_pad_bit_composes
eval_wide_left_pad_bit_composes
     : forall (env : Values.val) (s : jet_wide.wide_size) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (mc mr me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bytes : list Memdata.memval) (bit : bool) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc (@Ctypes.Internal Clight.function jets.f_readBit)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint (jet_readBit_layout.bit_int bit)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (jet_readBit_layout.bit_long bit)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function (wide_left_pad_bit s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_left_pad_bit_wide_exec.wide_left_pad_bit
wide_left_pad_bit =
fun s : jet_wide.wide_size =>
match s return Clight.function with
| jet_wide.W16 => jets.f_simplicity_left_pad_low_1_16
| jet_wide.W32 => jets.f_simplicity_left_pad_low_1_32
| jet_wide.W64 => jets.f_simplicity_left_pad_low_1_64
end
     : forall _ : jet_wide.wide_size, Clight.function

Arguments wide_left_pad_bit s
### C.jet_left_pad_bit_wide_exec.le_wide_left_pad_bit
le_wide_left_pad_bit =
fun (env : Values.val) (s : jet_wide.wide_size) (bd : Values.block) (dofs : Integers.Ptrofs.int)
  (bs : Values.block) (sofs : Integers.Ptrofs.int) (bit : bool) =>
@Maps.PTree.set Values.val jets._bit (Values.Vint (jet_readBit_layout.bit_int bit))
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vint (jet_readBit_layout.bit_int bit))
     (jet_arith8_layout_exec.le_arith8_layout env (wide_left_pad_bit s) bd dofs bs sofs))
     : forall (_ : Values.val) (_ : jet_wide.wide_size) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : bool), Maps.PTree.tree Values.val

Arguments le_wide_left_pad_bit env s bd dofs bs sofs bit%bool_scope
