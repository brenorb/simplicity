### C.jet_secp_checksig_hash.checksig_pad_bytes
checksig_pad_bytes
     : @eq (list Integers.Int.int)
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
            (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O)))))) checksig_pad_word))
         (jet_sha_finalize_exec.sha_pad
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_checksig_hash.checksig_hash_registers
checksig_hash_registers
     : forall ir h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Integers.Int.int) (jet_sha_ctx8_model.state_regs (checksig_hash_word ir h))
         (SHA256.hash_block
            (SHA256.hash_block (jet_sha_ctx8_model.state_regs jet_secp_checksig_tag.checksig_iv_word)
               (jet_sha_ctx8_model.be_words
                  (@app Integers.Int.int (jet_secp_schnorr_challenge_hash.schnorr_word_bytes ir)
                     (jet_secp_schnorr_challenge_hash.schnorr_word_bytes h))))
            (jet_sha_ctx8_model.be_words
               (jet_sha_finalize_exec.sha_pad
                  (Integers.Int64.repr
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
### C.jet_secp_checksig_hash.eval_checksig_sha_calls
eval_checksig_sha_calls
     : forall (_ : jet_memcpy_model.memcpy_model) (ir h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (m : Memory.Mem.mem) (bc bs bm : Values.block) (om : Integers.Ptrofs.int) (_ : not (@eq Values.block bc bs))
         (_ : not (@eq Values.block bc bm)) (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned om)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bc BinNums.Z0)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : jet_uint32_array_init.uint32_array_at m bs BinNums.Z0
                (jet_sha_ctx8_model.state_regs jet_secp_checksig_tag.checksig_iv_word))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val
                   (Values.Vlong
                      (Integers.Int64.repr
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : jet_secp_schnorr_challenge_absorb.schnorr_bytes_at m bm om
                (@app Integers.Int.int (jet_secp_schnorr_challenge_hash.schnorr_word_bytes ir)
                   (jet_secp_schnorr_challenge_hash.schnorr_word_bytes h))),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_sha256_uchars)
                  (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bm om)
                        (@cons Values.val
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                           (@nil Values.val)))) Events.E0 m1 (Values.Vint Integers.Int.one))
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m1
                     (@Ctypes.Internal Clight.function jets_secp.f_sha256_finalize)
                     (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
                     (Values.Vint Integers.Int.one))
                  (and
                     (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                        (jet_sha_ctx8_model.state_regs (checksig_hash_word ir h)))
                     (and
                        (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                           (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
                        (and
                           (@eq (option Values.val)
                              (Memory.Mem.load AST.Mint64 mf bc
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                              (@Some Values.val
                                 (Values.Vlong
                                    (Integers.Int64.repr
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                           (and
                              (@eq (option Values.val)
                                 (Memory.Mem.load AST.Mint8unsigned mf bc
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                 (@Some Values.val (Values.Vint Integers.Int.zero)))
                              (and
                                 (Memory.Mem.range_perm mf bc BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bs BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (jet_sx_mem.lframe
                                          (fun (b : Values.block) (_ : BinNums.Z) =>
                                           and (not (@eq Values.block b bc)) (not (@eq Values.block b bs))) m mf)
                                       (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                          (jet_secp_sha_startup.secp_sha_startup mf))))))))))))
