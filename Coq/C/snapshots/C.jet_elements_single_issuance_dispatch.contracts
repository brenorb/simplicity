### C.jet_elements_single_issuance_dispatch.eis_payload_le
eis_payload_le =
fun (txi : jet_elements_prim.sigTxInput) (le : Clight.temp_env) (bin : Values.block) (ofs : BinNums.Z)
  (bz : Values.block) =>
let le0 : Maps.PTree.tree Values.val :=
  @Maps.PTree.set Values.val jets_elements._t'4 (Values.Vint (jet_elements_single_issuance_rep.eis_tag txi)) le in
match jet_elements_prim.sigTxiIssuance txi return Clight.temp_env with
| Some i =>
    match i return Clight.temp_env with
    | inl _ =>
        @Maps.PTree.set Values.val jets_elements._t'5 (Values.Vint Integers.Int.one)
          (jet_elements_single_issuance_amount.eis_token_le le0 true bin ofs bz)
    | inr _ =>
        @Maps.PTree.set Values.val jets_elements._t'5
          (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
          (jet_elements_single_issuance_amount.eis_token_le le0 false bin ofs bz)
    end
| None => le0
end
     : forall (_ : jet_elements_prim.sigTxInput) (_ : Clight.temp_env) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block), Clight.temp_env

Arguments eis_payload_le txi le bin ofs%Z_scope bz
