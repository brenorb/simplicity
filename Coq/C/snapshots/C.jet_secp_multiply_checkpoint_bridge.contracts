### C.jet_secp_multiply_checkpoint_bridge.first_machine_observations
first_machine_observations =
fun (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (le : Maps.PTree.tree Values.val)
  (m : Memory.Mem.mem) =>
and
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk beta (S (S O)))
        (BinInt.Z.add (jet_sx_state.bas beta (S (S O))) BinNums.Z0))
     (@Some Values.val (Values.Vlong (@fst Integers.Int64.int Integers.Int64.int (first_final_c_machine rho)))))
  (and
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk beta (S (S O)))
           (BinInt.Z.add (jet_sx_state.bas beta (S (S O)))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (@Some Values.val (Values.Vlong (@snd Integers.Int64.int Integers.Int64.int (first_final_c_machine rho)))))
     (and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk beta (S (S (S O))))
              (BinInt.Z.add (jet_sx_state.bas beta (S (S (S O)))) BinNums.Z0))
           (@Some Values.val (Values.Vlong (@fst Integers.Int64.int Integers.Int64.int (first_final_d_machine rho)))))
        (and
           (@eq (option Values.val)
              (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk beta (S (S (S O))))
                 (BinInt.Z.add (jet_sx_state.bas beta (S (S (S O))))
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
              (@Some Values.val (Values.Vlong (@snd Integers.Int64.int Integers.Int64.int (first_final_d_machine rho)))))
           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t3 le)
              (@Some Values.val (Values.Vlong (first_t3_machine rho)))))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : jet_sx_state.layout) (_ : Maps.PTree.tree Values.val)
         (_ : Memory.Mem.mem), Prop

