### C.jet_secp_generator_hash_map.exec_generator_hash_map
exec_generator_hash_map
     : forall (_ : jet_memcpy_model.memcpy_model) (second prior : bool)
         (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (br bc bs bb bt bp ba : Values.block) (oa : Integers.Ptrofs.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_init e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_uchars e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_finalize e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_fromMidstate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._shallue_van_de_woestijne e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   (jet_secp_generator_sha_start.generator_sha_result_id second) e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   (jet_secp_generator_sha_start.generator_sha_context_id second) e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_buf e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._b32 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._add e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp jet_secp_curve_statements.curve_ge_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   (jet_secp_generator_sha_absorb.generator_sha_prefix_id second) e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._key32 le)
                (@Some Values.val (Values.Vptr ba oa)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ret le)
                (@Some Values.val (Values.Vint (jet_secp_field_cmov.cmov_int prior))))
         (_ : @List.NoDup Values.block
                (@cons Values.block ba
                   (@cons Values.block br
                      (@cons Values.block bc
                         (@cons Values.block bs
                            (@cons Values.block bb (@cons Values.block bt (@cons Values.block bp (@nil Values.block)))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : jet_secp_swu_startup.swu_startup m)
         (_ : forall prefix : bool, jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix m)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat i)))
                (@Some Values.val
                   (Values.Vint
                      (@List.nth Integers.Int.int i
                         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int
                            jet_read8s_layout.word8_array_value
                            (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) key))
                         Integers.Int.zero)))),
       let hash : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         @jet_secp_generator_hash_literal.literal_generator_hash second Alg.CoreFunSem key in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun x : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun y : forall _ : nat, Integers.Int64.int =>
                and
                  (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (generator_hash_map_stage second)
                     Events.E0 (generator_hash_map_temps second prior key le) mf ClightBigstep.Out_normal)
                  (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                     (and
                        (jet_secp_fe_nv.fe_at mf bp
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           (jet_secp_multiply_normalize_bridge.words5 y))
                        (and
                           (@eq (option Values.val)
                              (Memory.Mem.load AST.Mint32 mf bp
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                              (@Some Values.val (Values.Vint Integers.Int.zero)))
                           (and (jet_secp_square_columns.square_input_bounds x)
                              (and (jet_secp_square_columns.square_input_bounds y)
                                 (and
                                    (@eq
                                       (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (...))))))))))
                                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (...)))))))))))
                                       (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (...))))))))))
                                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (...))))))))))
                                          (jet_secp_rescale_literal.rescale_field_output x)
                                          (jet_secp_rescale_literal.rescale_field_output y))
                                       (jet_secp_swu_word_parity.swu_words_literal_output
                                          (jet_secp_swu_raw_input.swu_raw_words hash) hash))
                                    (and
                                       (forall _ : @eq bool (generator_hash_accepted second key) true,
                                        @eq
                                          (prod (Ty.tySem (Word.Word (S (S (S (S (S (S ...))))))))
                                             (Ty.tySem (Word.Word (S (S (S (S (S (S ...)))))))))
                                          (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S ...))))))))
                                             (Ty.tySem (Word.Word (S (S (S (S (S (S ...))))))))
                                             (jet_secp_rescale_literal.rescale_field_output x)
                                             (jet_secp_rescale_literal.rescale_field_output y))
                                          (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem hash))
                                       (and
                                          (Memory.Mem.range_perm mf br BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (Memory.Mem.range_perm mf bc BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                                Memtype.Cur Memtype.Freeable)
                                             (and
                                                (Memory.Mem.range_perm mf bs BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (and
                                                   (Memory.Mem.range_perm mf bb BinNums.Z0
                                                      (BinNums.Zpos
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))
                                                      Memtype.Cur Memtype.Freeable)
                                                   (and
                                                      (Memory.Mem.range_perm mf bt BinNums.Z0
                                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...)))))
                                                         Memtype.Cur Memtype.Freeable)
                                                      (and
                                                         (Memory.Mem.range_perm mf bp BinNums.Z0
                                                            (BinNums.Zpos (BinNums.xO (BinNums.xO (...)))) Memtype.Cur
                                                            Memtype.Freeable)
                                                         (and
                                                            (forall (i : nat) (_ : lt i (S ...)),
                                                             @eq (option Values.val)
                                                               (Memory.Mem.load AST.Mint8unsigned mf ba
                                                                  (BinInt.Z.add ... ...))
                                                               (@Some Values.val (Values.Vint ...)))
                                                            (and (jet_sx_mem.lframe (fun ... ... => and ... ...) m mf)
                                                               (and
                                                                  (jet_clight_internal_preserve.readonly_preserved m mf)
                                                                  (and (...) (...)))))))))))))))))))))
### C.jet_secp_generator_hash_map.generator_hash_map_statements
generator_hash_map_statements =
fun second : bool =>
@List.firstn Clight.statement (S (S (S O)))
  (@List.skipn Clight.statement (PeanoNat.Nat.pred (jet_secp_generator_digest_mapping.generator_digest_index second))
     (@fst (list Clight.statement) Clight.statement
        (jet_secp_statement_prefix.split_statement_last
           (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal))))
     : forall _ : bool, list Clight.statement

Arguments generator_hash_map_statements second%bool_scope
### C.jet_secp_generator_hash_map.generator_hash_map_stage
generator_hash_map_stage =
fun second : bool => jet_secp_statement_prefix.statement_sequence (generator_hash_map_statements second) Clight.Sskip
     : forall _ : bool, Clight.statement

Arguments generator_hash_map_stage second%bool_scope
### C.jet_secp_generator_hash_map.generator_hash_digest
generator_hash_digest =
fun (second : bool) (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
jet_secp_sha_owned.secp_sha_digest_bytes
  (jet_sha_ctx8_model.state_regs (@jet_secp_generator_hash_literal.literal_generator_hash second Alg.CoreFunSem key))
     : forall (_ : bool) (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), list BinNums.Z

Arguments generator_hash_digest second%bool_scope key
### C.jet_secp_generator_hash_map.generator_hash_accepted
generator_hash_accepted =
fun (second : bool) (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
BinInt.Z.ltb
  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
     (@jet_secp_generator_hash_literal.literal_generator_hash second Alg.CoreFunSem key)) jet_secp_fe_math.feP
     : forall (_ : bool) (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), bool

Arguments generator_hash_accepted second%bool_scope key
### C.jet_secp_generator_hash_map.generator_hash_map_temps
generator_hash_map_temps =
fun (second prior : bool) (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (le : Maps.PTree.tree Values.val) =>
@Maps.PTree.set Values.val jets_secp._ret
  (Values.Vint (jet_secp_field_cmov.cmov_int (andb prior (generator_hash_accepted second key))))
  (@Maps.PTree.set Values.val (jet_secp_generator_digest_mapping.generator_digest_slot second)
     (Values.Vint (jet_secp_field_cmov.cmov_int (generator_hash_accepted second key))) le)
     : forall (_ : bool) (_ : bool) (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Maps.PTree.tree Values.val), Maps.PTree.tree Values.val

Arguments generator_hash_map_temps (second prior)%bool_scope key le
