### C.jet_secp_b32_owned.get_b32_source_region
get_b32_source_region
     : @eq (option jet_sx_state.region)
         (@List.nth_error jet_sx_state.region (jet_sx_eval.sregs jet_secp_fe_b32.gb_leaf) (S O))
         (@Some jet_sx_state.region
            (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 O)) false (@None BinNums.Z)))
### C.jet_secp_b32_owned.get_b32_closed
get_b32_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers
            (Clight.fn_body jets_secp.f_secp256k1_fe_get_b32)) true
### C.jet_secp_b32_owned.get_b32_allowed
get_b32_allowed
     : jet_clight_internal_frame.allowed_call jet_secp_closed_helpers.secp_closed_helpers
         (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_get_b32)
### C.jet_secp_b32_owned.get_b32_foot_bounds
get_b32_foot_bounds
     : forall (bout : Values.block) (offset : BinNums.Z) (bin : Values.block) (base : BinNums.Z)
         (b : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout offset)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin base)
                      (@nil (prod Values.block BinNums.Z))))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   (@cons jet_sx_state.region
                      (jet_sx_state.mkreg
                         (jet_secp_fe_b32.byte_undef BinNums.Z0
                            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))) true
                         (@None BinNums.Z))
                      (@cons jet_sx_state.region
                         (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 O)) false
                            (@None BinNums.Z)) (@nil jet_sx_state.region)))) b pos),
       or
         (and (@eq Values.block b bout)
            (and (BinInt.Z.le offset pos)
               (BinInt.Z.lt pos
                  (BinInt.Z.add offset
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (and (@eq Values.block b bin)
            (and (BinInt.Z.le base pos)
               (BinInt.Z.lt pos
                  (BinInt.Z.add base
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_b32_owned.get_b32_final_source
get_b32_final_source
     : forall (value : BinNums.Z) (b : Values.block) (offset : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (m mf : Memory.Mem.mem)
         (_ : jet_secp_fe_nv.fe_at m bf base
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : jet_clight_internal_permissions.keeps_permissions m mf)
         (_ : jet_sx_state.rep (jet_secp_b32_exec.limb_rho value)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b offset)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bf base)
                      (@nil (prod Values.block BinNums.Z)))) (jet_sx_eval.sregs jet_secp_fe_b32.gb_leaf) mf),
       jet_secp_fe_nv.fe_at mf bf base
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value))
### C.jet_secp_b32_owned.eval_fe_get_b32_owned
eval_fe_get_b32_owned
     : forall (m : Memory.Mem.mem) (b : Values.block) (offset : BinNums.Z) (bf : Values.block)
         (base value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : BinInt.Z.le BinNums.Z0 offset)
         (_ : BinInt.Z.le
                (BinInt.Z.add offset
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b offset
                (BinInt.Z.add offset
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bf base
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : not (@eq Values.block b bf)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_get_b32)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr offset))
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_read8s_layout.uint8_array_at mf b offset
                  (@List.map BinNums.Z Integers.Int.int Integers.Int.repr (jet_secp_fe_b32.be_bytes value)))
               (and
                  (jet_secp_fe_nv.fe_at mf bf base
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and
                        (jet_sx_mem.lframe
                           (fun (block : Values.block) (pos : BinNums.Z) =>
                            not
                              (jet_sx_state.foot
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b offset)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bf base)
                                       (@nil (prod Values.block BinNums.Z))))
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape
                                    (@cons jet_sx_state.region
                                       (jet_sx_state.mkreg
                                          (jet_secp_fe_b32.byte_undef BinNums.Z0
                                             (S (S (S (S (S (S (S (S (S (...))))))))))) true
                                          (@None BinNums.Z))
                                       (@cons jet_sx_state.region
                                          (jet_sx_state.mkreg
                                             (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 O)) false
                                             (@None BinNums.Z)) (@nil jet_sx_state.region)))) block pos)) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
