                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)) Integers.Ptrofs.max_unsigned),
       @eq BinNums.Z
         (Integers.Ptrofs.unsigned
            (Integers.Ptrofs.add o
               (Integers.Ptrofs.mul (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                  (Integers.Ptrofs.of_ints (Integers.Int.repr i)))))
         (BinInt.Z.add (Integers.Ptrofs.unsigned o)
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
### C.jet_elements_support_sha_hash_exec.fm_pair_exec
fm_pair_exec
     : forall (bh bmid : Values.block) (oh omid : Integers.Ptrofs.int) (regs : list Integers.Int.int)
         (_ : not (@eq Values.block bh bmid))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned omid)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (i : nat) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : lt i (S (S (S (S (S (S (S (S O))))))))) (_ : fm_ok bh bmid oh omid regs m)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._midstate le)
                (@Some Values.val (Values.Vptr bmid omid)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._hash le)
                (@Some Values.val (Values.Vptr bh oh))),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge Clight.empty_env le m
               (fm_pair i) Events.E0
               (@Maps.PTree.set Values.val (fm_temp i)
                  (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero)) le) m' ClightBigstep.Out_normal)
            (and
               (forall (q : nat) (_ : lt q (S (S (S (S O))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint8unsigned m' bh
                     (BinInt.Z.add
                        (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                        (BinInt.Z.of_nat q)))
                  (@Some Values.val (Values.Vint (@List.nth Integers.Int.int q (fm_word regs i) Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : or (not (@eq Values.block b bh))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                                  (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                        (BinInt.Z.of_nat i))))
                               (BinInt.Z.le
                                  (BinInt.Z.add
                                     (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                           (BinInt.Z.of_nat i))) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
### C.jet_elements_support_sha_hash_exec.fm_seq_exec
