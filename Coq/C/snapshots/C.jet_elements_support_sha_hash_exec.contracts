                  (fm_seq i n) Events.E0 le' m' ClightBigstep.Out_normal)
               (and
                  (forall (j q : nat) (_ : and (le i j) (lt j (S (S (S (S (S (S (S (S O))))))))))
                     (_ : lt q (S (S (S (S O))))),
                   @eq (option Values.val)
                     (Memory.Mem.load AST.Mint8unsigned m' bh
                        (BinInt.Z.add
