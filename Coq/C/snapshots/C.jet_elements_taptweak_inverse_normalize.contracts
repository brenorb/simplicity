               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vlong sign)
                     (@cons Values.val
                        (Values.Vptr jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_block
                           Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5
                     (jet_secp_modinv_normalize62_exec.norm62_machine w jet_secp_modinfo_fe_copy.modinfo_fe_limb sign)))
               (and
                  (jet_secp_signed62_numeric.signed62_normalized
                     (jet_secp_modinv_normalize62_exec.norm62_machine w jet_secp_modinfo_fe_copy.modinfo_fe_limb sign))
                  (and
                     (@eq BinNums.Z
                        (jet_secp_signed62_numeric.signed62_unsigned_value
                           (jet_secp_modinv_normalize62_exec.norm62_machine w jet_secp_modinfo_fe_copy.modinfo_fe_limb
