### C.jet_read4_input_word.frame_input_word_at_bit4
frame_input_word_at_bit4
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x : Ty.tySem (Word.Word (S (S O))))
         (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))
         (_ : @jet_input_layout.frame_input_word_at (S (S O)) m bw edge cursor x),
       jet_input_layout.frame_input_bit_at m bw edge
         (BinInt.Z.add cursor (BinInt.Z.sub (BinNums.Zpos (BinNums.xI BinNums.xH)) j))
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S O))) x) j)
### C.jet_read4_input_word.read4_layout_input_bits
read4_layout_input_bits
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (high low : Integers.Int64.int)
         (x : Ty.tySem (Word.Word (S (S O)))) (j : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : @jet_input_layout.frame_input_word_at (S (S O)) m bw edge cursor x)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bw
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                            (BinInt.Z.div cursor
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong high)))
         (_ : forall
                _ : BinInt.Z.lt
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                      (BinInt.Z.modulo cursor
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bw
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                            (BinInt.Z.div cursor
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong low)))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))),
       @eq bool (Integers.Int.testbit (jet_read4_layout_total.read4_layout_result cursor high low) j)
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S O))) x) j)
