### C.jet_elements_amount_jets.elements_asset_amount_local
@elements_asset_amount_local
     : forall (A : Type) (elems_of : forall _ : jet_elements_prim.Elements.env, list A)
         (ga : forall _ : A, jet_elements_prim.assetWith unit) (gm : forall _ : A, jet_elements_prim.amountWith unit)
         (countfield arrfield sid : AST.ident) (cdelta adelta sz poffa poffm : BinNums.Z) (pexpr1 pexpr2 : Clight.expr)
         (f : Clight.function)
         (_ : @eq Ctypes.type (Clight.typeof pexpr1)
                (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr)))
         (_ : @eq Ctypes.type (Clight.typeof pexpr2)
                (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._confAmount Ctypes.noattr)))
         (_ : jet_elements_field_eval.elements_field_at jets_elements._elementsTransaction countfield cdelta)
         (_ : jet_elements_field_eval.elements_field_at jets_elements._elementsTransaction arrfield adelta)
         (_ : and (BinInt.Z.le BinNums.Z0 cdelta)
                (BinInt.Z.le (BinInt.Z.add cdelta (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 adelta)
                (BinInt.Z.le (BinInt.Z.add adelta (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.lt BinNums.Z0 sz)
                (BinInt.Z.le sz
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 poffa)
                (BinInt.Z.le
                   (BinInt.Z.add poffa
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))) sz))
         (_ : and (BinInt.Z.le BinNums.Z0 poffm)
                (BinInt.Z.le
                   (BinInt.Z.add poffm
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) sz))
         (_ : forall (e : Clight.env) (le' : Maps.PTree.tree Values.val) (m' : Memory.Mem.mem)
                (bin : Values.block) (inbase : BinNums.Z) (r : Integers.Int64.int)
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._t'6 le')
                       (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._i le')
                       (@Some Values.val (Values.Vlong r))) (_ : BinInt.Z.le BinNums.Z0 inbase)
                (_ : BinInt.Z.le (BinInt.Z.add (BinInt.Z.add inbase (BinInt.Z.mul sz (Integers.Int64.unsigned r))) sz)
                       Integers.Ptrofs.max_unsigned),
              Clight.eval_expr jet_elements_linkage.elements_ge e le' m' pexpr1
                (Values.Vptr bin
                   (Integers.Ptrofs.repr
                      (BinInt.Z.add (BinInt.Z.add inbase (BinInt.Z.mul sz (Integers.Int64.unsigned r))) poffa))))
         (_ : forall (e : Clight.env) (le' : Maps.PTree.tree Values.val) (m' : Memory.Mem.mem)
                (bin : Values.block) (inbase : BinNums.Z) (r : Integers.Int64.int)
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._t'4 le')
                       (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._i le')
                       (@Some Values.val (Values.Vlong r))) (_ : BinInt.Z.le BinNums.Z0 inbase)
                (_ : BinInt.Z.le (BinInt.Z.add (BinInt.Z.add inbase (BinInt.Z.mul sz (Integers.Int64.unsigned r))) sz)
                       Integers.Ptrofs.max_unsigned),
              Clight.eval_expr jet_elements_linkage.elements_ge e le' m' pexpr2
                (Values.Vptr bin
                   (Integers.Ptrofs.repr
                      (BinInt.Z.add (BinInt.Z.add inbase (BinInt.Z.mul sz (Integers.Int64.unsigned r))) poffm))))
         (_ : jet_elements_wrapper.elements_wrapper_shape f
                (jet_elements_indexed_exec.elements_indexed_rest jets_elements._t'7 jets_elements._t'8 countfield
                   (jet_elements_indexed_ptr2.elements_indexed_then_ptr2 jets_elements._t'5 jets_elements._t'6
                      jets_elements._t'3 jets_elements._t'4 arrfield sid pexpr1 jets_elements._asset
                      (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr) pexpr2 jets_elements._amt
                      (Ctypes.Tstruct jets_elements._confAmount Ctypes.noattr))
                   (jet_elements_indexed_scalar.elements_skip_stmt
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))
         (spec : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
                 option
                   (Ty.tySem
                      (Ty.Sum Ty.Unit
                         (Ty.Prod
                            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                               (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                               (Word.Word (S (S (S (S (S (S O))))))))))))
         (_ : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env),
              @eq
                (option
                   (Ty.tySem
                      (Ty.Sum Ty.Unit
                         (Ty.Prod
                            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                               (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                               (Word.Word (S (S (S (S (S (S O)))))))))))) (spec a environment)
                (@Some
                   (Ty.tySem
                      (Ty.Sum Ty.Unit
                         (Ty.Prod
                            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                               (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                               (Word.Word (S (S (S (S (S (S O)))))))))))
                   (@amount_pair_result A (elems_of environment) ga gm a))),
       jet_application_sep.application_jet_local_spec_sep f jet_elements_linkage.elements_ge
         jet_elements_prim.Elements.env (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit
            (Ty.Prod
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S O))))))))))
         (@jet_elements_indexed_ptr.indexed_ptr_rep jet_elements_prim.Elements.env A elems_of
            (fun (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (x : A) =>
             and (jet_elements_asset_jets.asset_rep m b (BinInt.Z.add ofs poffa) (ga x))
               (amount_rep m b (BinInt.Z.add ofs poffm) (gm x))) sz BinNums.Z0 adelta cdelta) spec
