### C.jet_elements_amount_jets.elements_amount_pair_spec
elements_amount_pair_spec =
fun (alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra) (A CM CA : Ty.Ty)
  (pm : jet_elements_prim.PrimitiveElements.Primitive.domain alg A (Ty.Sum Ty.Unit CM))
  (pa : jet_elements_prim.PrimitiveElements.Primitive.domain alg A (Ty.Sum Ty.Unit CA)) =>
@Alg.Core.Combinators.comp A (Ty.Prod (Ty.Sum Ty.Unit CM) (Ty.Sum Ty.Unit CA)) (Ty.Sum Ty.Unit (Ty.Prod CA CM))
  (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
  (@Alg.Core.Combinators.pair A (Ty.Sum Ty.Unit CM) (Ty.Sum Ty.Unit CA)
     (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg) pm pa)
  (@Alg.Core.Combinators.case Ty.Unit CM (Ty.Sum Ty.Unit CA) (Ty.Sum Ty.Unit (Ty.Prod CA CM))
     (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
     (@Alg.Core.Combinators.injl (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit CA)) Ty.Unit (Ty.Prod CA CM)
        (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
        (@Alg.Core.Combinators.unit (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit CA))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)))
     (@Alg.Core.Combinators.comp (Ty.Prod CM (Ty.Sum Ty.Unit CA)) (Ty.Prod (Ty.Sum Ty.Unit CA) CM)
        (Ty.Sum Ty.Unit (Ty.Prod CA CM)) (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
        (@Alg.Core.Combinators.pair (Ty.Prod CM (Ty.Sum Ty.Unit CA)) (Ty.Sum Ty.Unit CA) CM
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
           (@Alg.Core.Combinators.drop CM (Ty.Sum Ty.Unit CA) (Ty.Sum Ty.Unit CA)
              (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
              (@Alg.Core.Combinators.iden (Ty.Sum Ty.Unit CA)
                 (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)))
           (@Alg.Core.Combinators.take CM (Ty.Sum Ty.Unit CA) CM
              (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
              (@Alg.Core.Combinators.iden CM
                 (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))))
        (@Alg.Core.Combinators.case Ty.Unit CA CM (Ty.Sum Ty.Unit (Ty.Prod CA CM))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
           (@Alg.Core.Combinators.injl (Ty.Prod Ty.Unit CM) Ty.Unit (Ty.Prod CA CM)
              (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
              (@Alg.Core.Combinators.unit (Ty.Prod Ty.Unit CM)
                 (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)))
           (@Alg.Core.Combinators.injr (Ty.Prod CA CM) Ty.Unit (Ty.Prod CA CM)
              (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
              (@Alg.Core.Combinators.iden (Ty.Prod CA CM)
                 (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))))))
     : forall (alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra) (A CM CA : Ty.Ty)
         (_ : jet_elements_prim.PrimitiveElements.Primitive.domain alg A (Ty.Sum Ty.Unit CM))
         (_ : jet_elements_prim.PrimitiveElements.Primitive.domain alg A (Ty.Sum Ty.Unit CA)),
       jet_elements_prim.PrimitiveElements.Primitive.domain alg A (Ty.Sum Ty.Unit (Ty.Prod CA CM))

Arguments elements_amount_pair_spec {alg} {A CM CA}%ty_scope pm pa
### C.jet_elements_amount_jets.amount_words
amount_words =
fun a : jet_elements_prim.amountWith unit =>
match a return (list Integers.Int.int) with
| jet_elements_prim.Explicit _ => @List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S (S O))))))))
| jet_elements_prim.Confidential pt _ =>
    match pt return (list Integers.Int.int) with
    | jet_elements_prim.Point _ x => Digest.hash256_reg x
    end
end
     : forall _ : jet_elements_prim.amountWith unit, list Integers.Int.int

Arguments amount_words a
### C.jet_elements_amount_jets.amount_value
amount_value =
fun a : jet_elements_prim.amountWith unit =>
match a return Integers.Int64.int with
| jet_elements_prim.Explicit v => v
| jet_elements_prim.Confidential _ _ => Integers.Int64.zero
end
     : forall _ : jet_elements_prim.amountWith unit, Integers.Int64.int

Arguments amount_value a
### C.jet_elements_amount_jets.amount_rep
amount_rep =
fun (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (a : jet_elements_prim.amountWith unit) =>
and
  match a return Prop with
  | jet_elements_prim.Explicit v =>
      @eq (option Values.val) (Memory.Mem.load AST.Mint64 m b ofs) (@Some Values.val (Values.Vlong v))
  | jet_elements_prim.Confidential pt _ =>
      match pt return Prop with
      | jet_elements_prim.Point _ x => jet_uint32_array_init.uint32_array_at m b ofs (Digest.hash256_reg x)
      end
  end
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint32 m b
        (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@Some Values.val (Values.Vint (@jet_elements_asset_jets.conf_prefix Integers.Int64.int a))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : jet_elements_prim.amountWith unit), Prop

Arguments amount_rep m b ofs%Z_scope a
### C.jet_elements_amount_jets.amount_pcells
amount_pcells =
fun a : jet_elements_prim.amountWith unit =>
jet_elements_amt_helper.amt_cells (@jet_elements_asset_jets.conf_prefix Integers.Int64.int a)
  (amount_words a) (amount_value a)
     : forall _ : jet_elements_prim.amountWith unit, list BitMachine.Cell

Arguments amount_pcells a
### C.jet_elements_amount_jets.encode_amount
encode_amount =
fun a : jet_elements_prim.amountWith unit =>
match
  a
  return
    (Ty.tySem
       (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
          (Word.Word (S (S (S (S (S (S O)))))))))
with
| jet_elements_prim.Explicit v =>
    @inr
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Sum Ty.Unit Ty.Unit))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.unsigned v))
| jet_elements_prim.Confidential pt _ =>
    match
      pt
      return
        (Ty.tySem
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O)))))))))
    with
    | jet_elements_prim.Point odd x =>
        @inl (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
          (prod
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O))))))))
          (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (jet_elements_asset_jets.conf_toBit odd) (Word.from_hash256 x))
    end
end
     : forall _ : jet_elements_prim.amountWith unit,
       Ty.tySem
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O))))))))

Arguments encode_amount a
### C.jet_elements_amount_jets.amount_pair_result
amount_pair_result =
fun (A : Type) (elems : list A) (ga : forall _ : A, jet_elements_prim.assetWith unit)
  (gm : forall _ : A, jet_elements_prim.amountWith unit) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error A elems (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return
    (Ty.tySem
       (Ty.Sum Ty.Unit
          (Ty.Prod
             (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Word.Word (S (S (S (S (S (S O)))))))))))
with
| Some x =>
    @inr unit
      (prod
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S O))))))))))
      (@pair
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S O))))))))) (jet_elements_asset_jets.encode_asset (ga x))
         (encode_amount (gm x)))
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A0 B => sum (tySem A0) (tySem B)
             | Ty.Prod A0 B => prod (tySem A0) (tySem B)
             end)
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A0 B => sum (tySem A0) (tySem B)
             | Ty.Prod A0 B => prod (tySem A0) (tySem B)
             end)
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S O)))))))))) tt
end
     : forall (A : Type) (_ : list A) (_ : forall _ : A, jet_elements_prim.assetWith unit)
         (_ : forall _ : A, jet_elements_prim.amountWith unit) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Prod
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S O))))))))))

Arguments amount_pair_result {A}%type_scope elems%list_scope (ga gm)%function_scope a
