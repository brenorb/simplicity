### C.jet_elements_amount_jets.amount_rep_mono
amount_rep_mono
     : forall (m1 m2 : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (a : jet_elements_prim.amountWith unit)
         (_ : amount_rep m1 b ofs a)
         (_ : forall (chunk : AST.memory_chunk) (o : BinNums.Z) (v : Values.val) (_ : BinInt.Z.le ofs o)
                (_ : BinInt.Z.le (BinInt.Z.add o (Memdata.size_chunk chunk))
                       (BinInt.Z.add ofs
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (_ : @eq (option Values.val) (Memory.Mem.load chunk m1 b o) (@Some Values.val v)),
              @eq (option Values.val) (Memory.Mem.load chunk m2 b o) (@Some Values.val v)),
       amount_rep m2 b ofs a
### C.jet_elements_amount_jets.amount_rep_runs
amount_rep_runs
     : forall (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge : BinNums.Z)
         (m' : Memory.Mem.mem) (bin : Values.block) (ofs : BinNums.Z) (a : jet_elements_prim.amountWith unit)
         (cur : BinNums.Z) (_ : amount_rep m' bin ofs a) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_application_sep.out_sep bd dbase bw outedge cur
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                bin ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : jet_output_layout.write_frame_at m' bd dbase bw outedge cur
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun me : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m'
               (@Ctypes.Internal Clight.function jets_elements.f_amt)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs)) (@nil Values.val))) Events.E0 me
               Values.Vundef)
            (jet_elements_effects.write_effect m' me bd dbase bw outedge cur
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xI
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (amount_pcells a)))
### C.jet_elements_amount_jets.encode_inr_pair
