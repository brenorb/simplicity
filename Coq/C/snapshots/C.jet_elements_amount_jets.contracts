### C.jet_elements_amount_jets.elements_amount_pair_sem
@elements_amount_pair_sem
     : forall (A CM CA : Ty.Ty)
         (tm : forall (_ : Ty.tySem A) (_ : jet_elements_prim.Elements.env), option (Ty.tySem (Ty.Sum Ty.Unit CM)))
         (ta : forall (_ : Ty.tySem A) (_ : jet_elements_prim.Elements.env), option (Ty.tySem (Ty.Sum Ty.Unit CA)))
         (a : Ty.tySem A) (env : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum Ty.Unit (Ty.Prod CA CM))))
         (@elements_amount_pair_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) A CM CA tm
            ta a env)
         match
           tm a env
           return
             (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                (Ty.tySem (Ty.Sum Ty.Unit (Ty.Prod CA CM))))
         with
         | Some t =>
             match
               t
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                    (Ty.tySem (Ty.Sum Ty.Unit (Ty.Prod CA CM))))
             with
             | inl _ =>
                 match
                   ta a env
                   return
                     (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                        (Ty.tySem (Ty.Sum Ty.Unit (Ty.Prod CA CM))))
                 with
                 | Some _ =>
                     @Some
                       (sum unit
                          (prod
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                 | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                 end) CA)
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                 | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                 end) CM)))
                       (@inl unit
                          (prod
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                 | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                 end) CA)
                             ((fix tySem (X : Ty.Ty) : Set :=
                                 match X return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                 | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                 end) CM)) tt)
                 | None => @None (Ty.tySem (Ty.Sum Ty.Unit (Ty.Prod CA CM)))
                 end
             | inr am =>
                 match
                   ta a env
                   return
                     (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                        (Ty.tySem (Ty.Sum Ty.Unit (Ty.Prod CA CM))))
                 with
                 | Some t0 =>
                     match
                       t0
                       return
                         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                            (Ty.tySem (Ty.Sum Ty.Unit (Ty.Prod CA CM))))
                     with
                     | inl _ =>
                         @Some
                           (sum unit
                              (prod
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CA)
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CM)))
                           (@inl unit
                              (prod
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CA)
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CM)) tt)
                     | inr ast =>
                         @Some
                           (sum unit
                              (prod
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CA)
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CM)))
                           (@inr unit
                              (prod
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CA)
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CM))
                              (@pair
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CA)
                                 ((fix tySem (X : Ty.Ty) : Set :=
                                     match X return Set with
                                     | Ty.Unit => unit
                                     | Ty.Sum A0 B => sum (tySem A0) (tySem B)
                                     | Ty.Prod A0 B => prod (tySem A0) (tySem B)
                                     end) CM) ast am))
                     end
                 | None => @None (Ty.tySem (Ty.Sum Ty.Unit (Ty.Prod CA CM)))
                 end
             end
         | None => @None (Ty.tySem (Ty.Sum Ty.Unit (Ty.Prod CA CM)))
         end
