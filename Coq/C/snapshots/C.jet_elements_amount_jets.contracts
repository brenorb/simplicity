### C.jet_elements_amount_jets.encode_conf64_inr
encode_conf64_inr
     : forall w : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))),
       @eq (list BitMachine.Cell)
         (@Translate.encode
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S O))))))))
            (@inr
               (prod (sum unit unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) w))
         (@cons (option bool) (@Some bool true)
            (@app (option bool)
               (@List.repeat (option bool) (@None bool)
                  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))
               (@Translate.encode (Word.Word (S (S (S (S (S (S O))))))) w)))
