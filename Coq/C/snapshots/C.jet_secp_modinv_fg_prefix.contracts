### C.jet_secp_modinv_fg_prefix.fg_sound
fg_sound
     : forall fuel : nat,
       jet_sx_exec.sound_rec jet_secp_linkage.secp_ge (@nil (prod AST.ident (prod nat Ctypes.type)))
         (fun (_ : forall _ : nat, Integers.Int64.int) (_ : jet_sx_eval.event) => True)
         (fun (_ : forall _ : nat, Integers.Int64.int) (_ : list jet_sx_eval.event) (_ : Memory.Mem.mem) => True)
         (fun _ : Values.block => False)
         (jet_sx_exec.xstmt (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
            fg_table fuel)
### C.jet_secp_modinv_fg_prefix.exec_fg_prefix
exec_fg_prefix
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem) (_ : jet_sx_state.rep rho beta (jet_sx_eval.sregs fg_initial) m)
         (_ : jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps fg_initial) le)
         (_ : jet_sx_eval.ematch beta (@snd (list jet_sx_state.region) jet_sx_eval.venv fg_alloc) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m fg_prefix Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and (jet_sx_state.rep rho beta fg_prefix_out mf)
                  (and
                     (jet_sx_eval.tmatch rho beta
                        (jet_sx_eval.stemps
                           (@fst jet_sx_eval.sstate jet_sx_exec.xout
                              (jet_sx_exec.rsel rho (jet_sx_state.lay beta) fg_prefix_tree))) le')
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot beta
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape (jet_sx_eval.sregs fg_initial)) b ofs)) m mf)))))
