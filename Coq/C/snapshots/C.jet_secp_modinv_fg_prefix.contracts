       @List.Forall (prod BinNums.positive jet_sx_expr.sx)
         (fun p : prod BinNums.positive jet_sx_expr.sx =>
          @eq (option jet_sx_expr.sx)
            (@Maps.PTree.get jet_sx_expr.sx (@fst BinNums.positive jet_sx_expr.sx p)
               (jet_sx_eval.stemps
