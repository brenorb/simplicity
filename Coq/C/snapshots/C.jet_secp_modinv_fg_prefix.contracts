### C.jet_secp_modinv_fg_prefix.fg_table
fg_table =
@cons (prod AST.ident jet_sx_exec.fentry)
  (@pair AST.ident jet_sx_exec.fentry jets_secp._secp256k1_i128_rshift
     (jet_sx_exec.FOra jets_secp.f_secp256k1_i128_rshift jet_secp_i128_shift62_oracle.i128_shift62_oracle))
