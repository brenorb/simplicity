### C.jet_secp_modinv_fg_prefix.fg_prefix_tree
fg_prefix_tree =
match fg_prefix_run return jet_sx_exec.res with
| Some tree => tree
| None => jet_sx_exec.RDone fg_initial jet_sx_exec.ONormal
end
     : jet_sx_exec.res
### C.jet_secp_modinv_fg_prefix.fg_product_sigma
fg_product_sigma =
fun (a b : jet_sx_expr.sx) (n : nat) =>
match n return jet_sx_expr.sx with
| O => a
| S n0 => match n0 return jet_sx_expr.sx with
          | O => b
          | S _ => jet_sx_expr.XLc Integers.Int64.zero
          end
end
     : forall (_ : jet_sx_expr.sx) (_ : jet_sx_expr.sx) (_ : nat), jet_sx_expr.sx

Arguments fg_product_sigma a b n%nat_scope
### C.jet_secp_modinv_fg_prefix.fg_product_lo
fg_product_lo =
fun a b : jet_sx_expr.sx =>
jet_secp_symbolic_substitution.sx_subst (fg_product_sigma a b) jet_secp_i128_mul_exec.smul128_lo
     : forall (_ : jet_sx_expr.sx) (_ : jet_sx_expr.sx), jet_sx_expr.sx

Arguments fg_product_lo a b
### C.jet_secp_modinv_fg_prefix.fg_product_hi
fg_product_hi =
fun a b : jet_sx_expr.sx =>
jet_secp_symbolic_substitution.sx_subst (fg_product_sigma a b) jet_secp_i128_mul_exec.smul128_hi
     : forall (_ : jet_sx_expr.sx) (_ : jet_sx_expr.sx), jet_sx_expr.sx

Arguments fg_product_hi a b
### C.jet_secp_modinv_fg_prefix.fg_row_lo
fg_row_lo =
fun u v : jet_sx_expr.sx =>
jet_sx_expr.XLb jet_sx_expr.Badd (fg_product_lo u (jet_sx_expr.XLv O))
  (fg_product_lo v (jet_sx_expr.XLv (S (S (S (S (S O)))))))
