Arguments fg_row_lo u v
### C.jet_secp_modinv_fg_prefix.fg_row_hi
fg_row_hi =
fun u v : jet_sx_expr.sx =>
jet_sx_expr.XLb jet_sx_expr.Badd (fg_product_hi u (jet_sx_expr.XLv O))
  (jet_sx_expr.XLb jet_sx_expr.Badd (fg_product_hi v (jet_sx_expr.XLv (S (S (S (S (S O)))))))
     (jet_sx_expr.XI2L Ctypes.Signed
        (jet_sx_expr.XLcmp Integers.Clt Ctypes.Unsigned (fg_row_lo u v)
           (fg_product_lo v (jet_sx_expr.XLv (S (S (S (S (S O))))))))))
     : forall (_ : jet_sx_expr.sx) (_ : jet_sx_expr.sx), jet_sx_expr.sx

Arguments fg_row_hi u v
### C.jet_secp_modinv_fg_prefix.fg_shifted_row
fg_shifted_row =
fun u v : jet_sx_expr.sx =>
@cons jet_sx_expr.sx (jet_secp_i128_shift62_rep.i128_shift62_lo_sx (fg_row_lo u v) (fg_row_hi u v))
