### C.jet_right_rotate_wide_layout_machine.eval_right_rotate_byte_layout_machine
eval_right_rotate_byte_layout_machine
     : forall (env : Values.val) (s : jet_left_rotate_wide_exec.byte_rotate_size) (m : Memory.Mem.mem)
         (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (amount : Ty.tySem (Word.Word (S (S (S O)))))
         (x : Ty.tySem (Word.Word (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s))))
         (cursor rc : BinNums.Z) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.add (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (jet_wide.wide_bits (jet_left_rotate_wide_exec.byte_rotate_width s))))))
         (_ : @jet_input_layout.frame_input_word_at (S (S (S O))) m bi edge rc amount)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s))
                m bi edge (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) x)
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
                (jet_wide.wide_bits (jet_left_rotate_wide_exec.byte_rotate_width s))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function (jet_right_rotate_wide_exec.right_rotate_byte_function s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Word.Word (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s)))
                     (right_rotate_byte_machine_value s amount x)))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (jet_wide.wide_bits (jet_left_rotate_wide_exec.byte_rotate_width s))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (jet_wide.wide_bits (jet_left_rotate_wide_exec.byte_rotate_width s)))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_right_rotate_wide_layout_machine.right_rotate_byte_machine_value
right_rotate_byte_machine_value =
fun (s : jet_left_rotate_wide_exec.byte_rotate_size) (amount : Ty.tySem (Word.Word (S (S (S O)))))
  (x : Ty.tySem (Word.Word (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s)))) =>
jet_wide_spec.decode_wide (jet_left_rotate_wide_exec.byte_rotate_width s)
  (Integers.Int64.zero_ext (jet_wide.wide_bits (jet_left_rotate_wide_exec.byte_rotate_width s))
     (jet_right_rotate_wide_exec.right_rotate_byte_payload s
        (Integers.Int64.repr
           (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s))) x))
        (Integers.Int.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) amount))))
     : forall (s : jet_left_rotate_wide_exec.byte_rotate_size) (_ : Ty.tySem (Word.Word (S (S (S O)))))
         (_ : Ty.tySem (Word.Word (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s)))),
       Ty.tySem (Word.Word (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s)))

Arguments right_rotate_byte_machine_value s amount x
