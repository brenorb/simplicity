### C.jet_secp_point_set_bit.eval_point_set_bit
eval_point_set_bit
     : forall (k : jet_secp_point_write_run.point_coordinate) (bit : bool) (m : Memory.Mem.mem)
         (b : Values.block)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_set_int)
               (@cons Values.val
                  (Values.Vptr b (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                  (@cons Values.val
                     (Values.Vint
                        match bit return Integers.Int.int with
                        | true => Integers.Int.one
                        | false => Integers.Int.zero
                        end) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b (jet_secp_point_write_run.point_coordinate_offset k)
                  (jet_secp_multiply_normalize_bridge.words5 (point_set_bit_words bit)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (bx : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block bx b))
                        (or (BinInt.Z.lt pos (jet_secp_point_write_run.point_coordinate_offset k))
                           (BinInt.Z.le
                              (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                     m mf))))
