     (@None jet_sx_expr.sx))
  (@cons BinNums.Z BinNums.Z0
     (@cons BinNums.Z (BinNums.Zpos BinNums.xH)
        (@cons BinNums.Z (BinNums.Zpos (BinNums.xO BinNums.xH))
           (@cons BinNums.Z (BinNums.Zpos (BinNums.xI BinNums.xH))
              (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (@nil BinNums.Z))))))
     : forall _ : jet_secp_point_write_run.point_coordinate, list jet_sx_state.cell

