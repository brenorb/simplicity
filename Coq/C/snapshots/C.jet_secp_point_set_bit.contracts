Arguments point_set_bit_tree k bit%bool_scope
### C.jet_secp_point_set_bit.point_set_bit_state
point_set_bit_state =
fun (k : jet_secp_point_write_run.point_coordinate) (bit : bool) =>
match point_set_bit_tree k bit return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    | jet_sx_exec.RIf _ a _ =>
        match a return jet_sx_eval.sstate with
        | jet_sx_exec.RDone st _ => st
        | jet_sx_exec.RIf _ _ _ =>
            jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
        end
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : forall (_ : jet_secp_point_write_run.point_coordinate) (_ : bool), jet_sx_eval.sstate

Arguments point_set_bit_state k bit%bool_scope
### C.jet_secp_point_set_bit.point_set_bit_cond
point_set_bit_cond =
fun bit : bool =>
jet_sx_expr.XIcmp Integers.Cle Ctypes.Signed (jet_sx_expr.XIc Integers.Int.zero)
  (jet_sx_expr.XI match bit return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end)
     : forall _ : bool, jet_sx_expr.sx

Arguments point_set_bit_cond bit%bool_scope
### C.jet_secp_point_set_bit.point_set_bit_out
point_set_bit_out =
fun bit : bool =>
@cons jet_sx_expr.sx
  (jet_sx_expr.XI2L Ctypes.Signed
     (jet_sx_expr.XI match bit return Integers.Int.int with
                     | true => Integers.Int.one
                     | false => Integers.Int.zero
                     end))
  (@cons jet_sx_expr.sx (jet_sx_expr.XI2L Ctypes.Signed (jet_sx_expr.XIc Integers.Int.zero))
     (@cons jet_sx_expr.sx (jet_sx_expr.XI2L Ctypes.Signed (jet_sx_expr.XIc Integers.Int.zero))
        (@cons jet_sx_expr.sx (jet_sx_expr.XI2L Ctypes.Signed (jet_sx_expr.XIc Integers.Int.zero))
           (@cons jet_sx_expr.sx (jet_sx_expr.XI2L Ctypes.Signed (jet_sx_expr.XIc Integers.Int.zero))
              (@nil jet_sx_expr.sx)))))
     : forall _ : bool, list jet_sx_expr.sx

Arguments point_set_bit_out bit%bool_scope
### C.jet_secp_point_set_bit.point_set_bit_words
point_set_bit_words =
fun (bit : bool) (i : nat) =>
match PeanoNat.Nat.eqb i O return Integers.Int64.int with
| true => match bit return Integers.Int64.int with
          | true => Integers.Int64.one
          | false => Integers.Int64.zero
          end
| false => Integers.Int64.zero
end
     : forall (_ : bool) (_ : nat), Integers.Int64.int

Arguments point_set_bit_words bit%bool_scope i%nat_scope
