### C.jet_secp_scalar_add_separate.scalar_add_separate_cells_ok
scalar_add_separate_cells_ok
     : and
         (@eq bool (jet_sx_state.cells_sorted BinNums.Z0 jet_secp_scalar_add_separate_run.scalar_add_separate_cells)
            true)
         (@List.Forall jet_sx_state.cell
            (fun c : jet_sx_state.cell =>
             and
               (BinInt.Z.le (BinInt.Z.add (jet_sx_state.cofs c) (Memdata.size_chunk (jet_sx_state.cchunk c)))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (and (BinInt.Z.divide (Memdata.align_chunk (jet_sx_state.cchunk c)) (jet_sx_state.cofs c))
                  (@eq (option jet_sx_expr.sx) (jet_sx_state.cval c) (@None jet_sx_expr.sx))))
            jet_secp_scalar_add_separate_run.scalar_add_separate_cells)
