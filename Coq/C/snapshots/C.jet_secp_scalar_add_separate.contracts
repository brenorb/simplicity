### C.jet_secp_scalar_add_separate.eval_scalar_add_separate_owned
eval_scalar_add_separate_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (br ba bb : Values.block)
         (_ : not (@eq Values.block br ba)) (_ : not (@eq Values.block br bb)) (_ : not (@eq Values.block ba bb))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0
                (jet_secp_scalar_add_initial.scalar_add_values rho O))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bb BinNums.Z0
                (jet_secp_scalar_add_initial.scalar_add_values rho (S (S (S (S O))))))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : and (BinInt.Z.le BinNums.Z0 (jet_secp_scalar_add_numeric.scalar_add_input_value rho))
                (BinInt.Z.lt (jet_secp_scalar_add_numeric.scalar_add_input_value rho)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) jet_secp_canonical_scalar.canonical_group_order))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               (Values.Vint
                  (jet_sx_expr.b2i
                     (BinInt.Z.leb jet_secp_canonical_scalar.canonical_group_order
                        (jet_secp_scalar_add_numeric.scalar_add_input_value rho)))))
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf br BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo (jet_secp_scalar_add_numeric.scalar_add_input_value rho)
                           jet_secp_canonical_scalar.canonical_group_order))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf ba BinNums.Z0
                     (jet_secp_scalar_add_initial.scalar_add_values rho O))
                  (and
                     (jet_secp_scalar_get_b32_storage.scalar_at mf bb BinNums.Z0
                        (jet_secp_scalar_add_initial.scalar_add_values rho (S (S (S (S O))))))
                     (and
                        (Memory.Mem.range_perm mf br BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf ba BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bb BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_clight_internal_permissions.keeps_permissions m mf)
                                 (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block b br))
                                          (and (not (@eq Values.block b ba)) (not (@eq Values.block b bb)))) m mf))))))))))
### C.jet_secp_scalar_add_separate.eval_scalar_add_separate_values
eval_scalar_add_separate_values
     : forall (a b : BinNums.Z) (m : Memory.Mem.mem) (br ba bb : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.lt a jet_secp_canonical_scalar.canonical_group_order))
         (_ : and (BinInt.Z.le BinNums.Z0 b) (BinInt.Z.lt b jet_secp_canonical_scalar.canonical_group_order))
         (_ : not (@eq Values.block br ba)) (_ : not (@eq Values.block br bb)) (_ : not (@eq Values.block ba bb))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of a)))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of b)))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               (Values.Vint
                  (jet_sx_expr.b2i (BinInt.Z.leb jet_secp_canonical_scalar.canonical_group_order (BinInt.Z.add a b)))))
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf br BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo (BinInt.Z.add a b) jet_secp_canonical_scalar.canonical_group_order))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf ba BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of a)))
                  (and
                     (jet_secp_scalar_get_b32_storage.scalar_at mf bb BinNums.Z0
                        (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                           (jet_secp_scalar_get_b32_numeric.scalar_limbs_of b)))
                     (and
                        (Memory.Mem.range_perm mf br BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf ba BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bb BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_clight_internal_permissions.keeps_permissions m mf)
                                 (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                    (jet_sx_mem.lframe
                                       (fun (block : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block block br))
                                          (and (not (@eq Values.block block ba)) (not (@eq Values.block block bb)))) m
                                       mf))))))))))
