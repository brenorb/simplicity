### C.jet_divmod_wide_exec.wide_divmod_body
wide_divmod_body
     : forall s : jet_wide.wide_size,
       @eq Clight.statement (Clight.fn_body (wide_divmod s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (jet_binary_wide_exec.wide_binary_read s jets._t'1)
                  (Clight.Sset jets._x (Clight.Etempvar jets._t'1 Ctypesdefs.tulong)))
               (Clight.Ssequence
                  (Clight.Ssequence (jet_binary_wide_exec.wide_binary_read s jets._t'2)
                     (Clight.Sset jets._y (Clight.Etempvar jets._t'2 Ctypesdefs.tulong)))
                  (Clight.Ssequence
                     (Clight.Ssequence (jet_divmod_expr.divmod_wide_choose jets._t'3 false)
                        (jet_arith8_layout_exec.frame_writer_call (jet_wide.wide_writer_id s) Ctypesdefs.tulong
                           Ctypesdefs.tvoid (Clight.Etempvar jets._t'3 Ctypesdefs.tulong)))
                     (Clight.Ssequence
                        (Clight.Ssequence (jet_divmod_expr.divmod_wide_choose jets._t'4 true)
                           (jet_arith8_layout_exec.frame_writer_call (jet_wide.wide_writer_id s) Ctypesdefs.tulong
                              Ctypesdefs.tvoid (Clight.Etempvar jets._t'4 Ctypesdefs.tulong)))
                        (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))))))))
### C.jet_divmod_wide_exec.eval_wide_divmod_composes
eval_wide_divmod_composes
     : forall (env : Values.val) (s : jet_wide.wide_size) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (mc mr mr2 mq me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bytes : list Memdata.memval) (r t : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong t))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (jet_division_value.division_wide_raw false r t)) (@nil Values.val)))
                Events.E0 mq Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mq
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (jet_division_value.division_wide_raw true r t)) (@nil Values.val)))
                Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function (wide_divmod s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_divmod_wide_exec.wide_divmod
wide_divmod =
fun s : jet_wide.wide_size =>
match s return Clight.function with
| jet_wide.W16 => jets.f_simplicity_div_mod_16
| jet_wide.W32 => jets.f_simplicity_div_mod_32
| jet_wide.W64 => jets.f_simplicity_div_mod_64
end
     : forall _ : jet_wide.wide_size, Clight.function

Arguments wide_divmod s
### C.jet_divmod_wide_exec.le_wide_divmod_x
le_wide_divmod_x =
fun (env : Values.val) (s : jet_wide.wide_size) (bd : Values.block) (dofs : Integers.Ptrofs.int)
  (bs : Values.block) (sofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._x (Values.Vlong r)
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vlong r)
     (jet_arith8_layout_exec.le_arith8_layout env (wide_divmod s) bd dofs bs sofs))
     : forall (_ : Values.val) (_ : jet_wide.wide_size) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments le_wide_divmod_x env s bd dofs bs sofs r
### C.jet_divmod_wide_exec.le_wide_divmod_y
le_wide_divmod_y =
fun (env : Values.val) (s : jet_wide.wide_size) (bd : Values.block) (dofs : Integers.Ptrofs.int)
  (bs : Values.block) (sofs : Integers.Ptrofs.int) (r t : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._y (Values.Vlong t)
  (@Maps.PTree.set Values.val jets._t'2 (Values.Vlong t) (le_wide_divmod_x env s bd dofs bs sofs r))
     : forall (_ : Values.val) (_ : jet_wide.wide_size) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments le_wide_divmod_y env s bd dofs bs sofs r t
