### C.jet_tapdata_host_recipe.tap_host_step
tap_host_step =
fun (s : tap_host_state) (kw : prod Integers.Int.int Integers.Int.int) =>
match s return tap_host_state with
| pair p p0 =>
    match p return tap_host_state with
    | pair p1 p2 =>
        match p1 return tap_host_state with
        | pair a b =>
            match p2 return tap_host_state with
            | pair c d =>
                match p0 return tap_host_state with
                | pair p3 p4 =>
                    match p3 return tap_host_state with
                    | pair e f =>
                        match p4 return tap_host_state with
                        | pair g h =>
                            match kw return tap_host_state with
                            | pair k w =>
                                let t1 : Integers.Int.int :=
                                  Integers.Int.add
                                    (Integers.Int.add
                                       (Integers.Int.add (Integers.Int.add h (tap_host_bsig1 e)) (tap_host_ch e f g)) k)
                                    w in
                                let t2 : Integers.Int.int := Integers.Int.add (tap_host_bsig0 a) (tap_host_maj a b c)
                                  in
                                @pair
                                  (prod (prod Integers.Int.int Integers.Int.int)
                                     (prod Integers.Int.int Integers.Int.int))
                                  (prod (prod Integers.Int.int Integers.Int.int)
                                     (prod Integers.Int.int Integers.Int.int))
                                  (@pair (prod Integers.Int.int Integers.Int.int)
                                     (prod Integers.Int.int Integers.Int.int)
                                     (@pair Integers.Int.int Integers.Int.int (Integers.Int.add t1 t2) a)
                                     (@pair Integers.Int.int Integers.Int.int b c))
                                  (@pair (prod Integers.Int.int Integers.Int.int)
                                     (prod Integers.Int.int Integers.Int.int)
                                     (@pair Integers.Int.int Integers.Int.int (Integers.Int.add d t1) e)
                                     (@pair Integers.Int.int Integers.Int.int f g))
                            end
                        end
                    end
                end
            end
        end
    end
end
     : forall (_ : tap_host_state) (_ : prod Integers.Int.int Integers.Int.int), tap_host_state

Arguments tap_host_step s kw
### C.jet_tapdata_host_recipe.tap_host_schedule_word
tap_host_schedule_word =
fun (ws : list Integers.Int.int) (j : nat) =>
Integers.Int.add
  (Integers.Int.add
     (Integers.Int.add (tap_host_lsig1 (@List.nth Integers.Int.int (Nat.sub j (S (S O))) ws Integers.Int.zero))
        (@List.nth Integers.Int.int (Nat.sub j (S (S (S (S (S (S (S O)))))))) ws Integers.Int.zero))
     (tap_host_lsig0
        (@List.nth Integers.Int.int (Nat.sub j (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))) ws
           Integers.Int.zero)))
  (@List.nth Integers.Int.int (Nat.sub j (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))) ws
     Integers.Int.zero)
