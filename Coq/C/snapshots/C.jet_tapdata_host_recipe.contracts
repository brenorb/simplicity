### C.jet_tapdata_host_recipe.tap_host_hash
tap_host_hash =
fun s : tap_host_state =>
match s return Digest.hash256 with
| pair p p0 =>
    match p return Digest.hash256 with
    | pair p1 p2 =>
        match p1 return Digest.hash256 with
        | pair a b =>
            match p2 return Digest.hash256 with
            | pair c d =>
                match p0 return Digest.hash256 with
                | pair p3 p4 =>
                    match p3 return Digest.hash256 with
                    | pair e f =>
                        match p4 return Digest.hash256 with
                        | pair g h =>
                            Digest.Hash256
                              (@cons Integers.Int.int a
                                 (@cons Integers.Int.int b
                                    (@cons Integers.Int.int c
                                       (@cons Integers.Int.int d
                                          (@cons Integers.Int.int e
                                             (@cons Integers.Int.int f
                                                (@cons Integers.Int.int g
                                                   (@cons Integers.Int.int h (@nil Integers.Int.int)))))))))
                              (@eq_refl nat
                                 (@length Integers.Int.int
                                    (@cons Integers.Int.int a
                                       (@cons Integers.Int.int b
                                          (@cons Integers.Int.int c
                                             (@cons Integers.Int.int d
                                                (@cons Integers.Int.int e
                                                   (@cons Integers.Int.int f
                                                      (@cons Integers.Int.int g
                                                         (@cons Integers.Int.int h (@nil Integers.Int.int)))))))))))
                        end
                    end
                end
            end
        end
    end
end
