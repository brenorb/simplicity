    (BinInt.Z.sub
       (BinNums.Zpos
          (BinNums.xO
             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
       (BinInt.Z.modulo bits
          (BinNums.Zpos
             (BinNums.xO
                (BinNums.xO
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
    (BinNums.Zpos BinNums.xH) in
let k : BinNums.Z :=
  match BinInt.Z.leb r (BinNums.Zneg BinNums.xH) return BinNums.Z with
  | true =>
      BinInt.Z.add r
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
  | false => r
  end in
@app Integers.Int.int
  (@cons Integers.Int.int
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     (@nil Integers.Int.int))
  (@app Integers.Int.int
     (@List.repeat Integers.Int.int Integers.Int.zero
        (BinInt.Z.to_nat
           (BinInt.Z.sub
              (BinInt.Z.div (BinInt.Z.add k (BinNums.Zpos BinNums.xH))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) (BinNums.Zpos BinNums.xH))))
     (@List.map BinNums.Z Integers.Int.int
