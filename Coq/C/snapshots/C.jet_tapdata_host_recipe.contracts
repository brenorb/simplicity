fun (s : tap_host_state) (bs : list Integers.Int.int) =>
let first16 : list Integers.Int.int :=
  @List.map nat Integers.Int.int (tap_host_be32 bs)
    (List.seq O (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))) in
let ws : list Integers.Int.int :=
  @List.fold_left (list Integers.Int.int) nat
    (fun (ws : list Integers.Int.int) (j : nat) =>
     @app Integers.Int.int ws (@cons Integers.Int.int (tap_host_schedule_word ws j) (@nil Integers.Int.int)))
    (List.seq (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))
       (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))) first16 in
tap_host_feedforward s
  (@List.fold_left tap_host_state (prod Integers.Int.int Integers.Int.int) tap_host_step
     (@List.combine Integers.Int.int Integers.Int.int SHA256.K256 ws) s)
