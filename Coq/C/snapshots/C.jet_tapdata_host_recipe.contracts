### C.jet_tapdata_host_recipe.tap_host_feedforward
tap_host_feedforward =
fun s t : tap_host_state =>
match s return tap_host_state with
| pair p p0 =>
    match p return tap_host_state with
    | pair p1 p2 =>
        match p1 return tap_host_state with
        | pair a b =>
            match p2 return tap_host_state with
            | pair c d =>
                match p0 return tap_host_state with
                | pair p3 p4 =>
                    match p3 return tap_host_state with
                    | pair e f =>
                        match p4 return tap_host_state with
                        | pair g h =>
                            match t return tap_host_state with
                            | pair p5 p6 =>
                                match p5 return tap_host_state with
                                | pair p7 p8 =>
                                    match p7 return tap_host_state with
                                    | pair a' b' =>
                                        match p8 return tap_host_state with
                                        | pair c' d' =>
                                            match p6 return tap_host_state with
                                            | pair p9 p10 =>
                                                match p9 return tap_host_state with
                                                | pair e' f' =>
                                                    match p10 return tap_host_state with
                                                    | pair g' h' =>
                                                        @pair
                                                          (prod (prod Integers.Int.int Integers.Int.int)
                                                             (prod Integers.Int.int Integers.Int.int))
                                                          (prod (prod Integers.Int.int Integers.Int.int)
                                                             (prod Integers.Int.int Integers.Int.int))
                                                          (@pair (prod Integers.Int.int Integers.Int.int)
                                                             (prod Integers.Int.int Integers.Int.int)
                                                             (@pair Integers.Int.int Integers.Int.int
                                                                (Integers.Int.add a a') (Integers.Int.add b b'))
                                                             (@pair Integers.Int.int Integers.Int.int
                                                                (Integers.Int.add c c') (Integers.Int.add d d')))
                                                          (@pair (prod Integers.Int.int Integers.Int.int)
                                                             (prod Integers.Int.int Integers.Int.int)
                                                             (@pair Integers.Int.int Integers.Int.int
                                                                (Integers.Int.add e e') (Integers.Int.add f f'))
                                                             (@pair Integers.Int.int Integers.Int.int
                                                                (Integers.Int.add g g') (Integers.Int.add h h')))
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end
     : forall (_ : tap_host_state) (_ : tap_host_state), tap_host_state

