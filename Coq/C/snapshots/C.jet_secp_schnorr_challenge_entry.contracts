### C.jet_secp_schnorr_challenge_entry.schnorr_challenge_entry
schnorr_challenge_entry
     : forall (m : Memory.Mem.mem) (m1 m2 m3 m4 : Memory.Mem.mem') (bb bs bc br be ba : Values.block)
         (oa : Integers.Ptrofs.int) (bm : Values.block) (om : Integers.Ptrofs.int) (bp : Values.block)
         (op : Integers.Ptrofs.int)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m1 bb))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m3 bc))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m4 br)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_schnorrsig_challenge
         (@cons Values.val (Values.Vptr be Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vptr ba oa)
               (@cons Values.val (Values.Vptr bm om)
                  (@cons Values.val
                     (Values.Vlong
                        (Integers.Int64.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (@cons Values.val (Values.Vptr bp op) (@nil Values.val)))))) m (schnorr_challenge_env bb bs bc br)
         (schnorr_challenge_temps be ba oa bm om bp op) m4
### C.jet_secp_schnorr_challenge_entry.schnorr_challenge_blocks
schnorr_challenge_blocks
     : forall bb bs bc br : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (schnorr_challenge_env bb bs bc br))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bs BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bc BinNums.Z0)
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z br BinNums.Z0)
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bb BinNums.Z0)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))
