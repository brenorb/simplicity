### C.jet_secp_generator_globalz_call.exec_generator_no_points
exec_generator_no_points
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bn : Values.block) (nofs : BinNums.Z) (bs : Values.block) (base : BinNums.Z)
         (ba : Values.block) (aofs : Integers.Ptrofs.int) (bz : Values.block) (zofs : Integers.Ptrofs.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_scalar_is_zero e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_table_set_globalz e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._na le)
                (@Some Values.val (Values.Vptr bn (Integers.Ptrofs.repr nofs))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._num le)
                (@Some Values.val (Values.Vlong Integers.Int64.one)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._no le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._state le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr base))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bn nofs
                (@cons Integers.Int64.int Integers.Int64.zero
                   (@cons Integers.Int64.int Integers.Int64.zero
                      (@cons Integers.Int64.int Integers.Int64.zero
                         (@cons Integers.Int64.int Integers.Int64.zero (@nil Integers.Int64.int))))))
         (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr m bs
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vptr ba aofs)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bs (BinInt.Z.add base BinNums.Z0))
                (@Some Values.val (Values.Vptr bz zofs))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_no_points_phase Events.E0
               (generator_no_points_temps le (Values.Vptr ba aofs) (Values.Vptr bz zofs)) mf ClightBigstep.Out_normal)
            (Memory.Mem.unchanged_on (fun (_ : Values.block) (_ : BinNums.Z) => True) m mf))
### C.jet_secp_generator_globalz_call.generator_globalz_statement
generator_globalz_statement =
@List.nth Clight.statement (S (S (S (S (S (S O))))))
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_ecmult_strauss_wnaf)))
  Clight.Sskip
     : Clight.statement
### C.jet_secp_generator_globalz_call.generator_auxiliary_statement
generator_auxiliary_statement =
@List.nth Clight.statement (S (S (S (S (S (S (S O)))))))
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_ecmult_strauss_wnaf)))
  Clight.Sskip
     : Clight.statement
### C.jet_secp_generator_globalz_call.generator_auxiliary_body
generator_auxiliary_body =
match generator_auxiliary_statement return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ _ => Clight.Sskip
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop s1 _ =>
        match s1 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ body => body
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_generator_globalz_call.generator_state_pointer
generator_state_pointer =
fun (field : AST.ident) (ty : Ctypes.type) =>
Clight.Efield
  (Clight.Ederef
     (Clight.Etempvar jets_secp._state
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._secp256k1_strauss_state Ctypes.noattr)))
     (Ctypes.Tstruct jets_secp._secp256k1_strauss_state Ctypes.noattr)) field (Ctypesdefs.tptr ty)
     : forall (_ : AST.ident) (_ : Ctypes.type), Clight.expr

Arguments generator_state_pointer field ty
### C.jet_secp_generator_globalz_call.generator_globalz_count
generator_globalz_count =
Clight.Ebinop Cop.Omul
  (Clight.Ebinop Cop.Oshl (Clight.Econst_long Integers.Int64.one Ctypesdefs.tlong)
     (Clight.Ebinop Cop.Osub
        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))) Ctypesdefs.tint)
        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))) Ctypesdefs.tint) Ctypesdefs.tint)
     Ctypesdefs.tlong) (Clight.Etempvar jets_secp._no Ctypesdefs.tulong) Ctypesdefs.tulong
     : Clight.expr
### C.jet_secp_generator_globalz_call.generator_globalz_call_temps
generator_globalz_call_temps =
fun (le : Clight.temp_env) (aptr zrptr : Values.val) =>
@Maps.PTree.set Values.val jets_secp._t'33 zrptr (@Maps.PTree.set Values.val jets_secp._t'32 aptr le)
     : forall (_ : Clight.temp_env) (_ : Values.val) (_ : Values.val), Maps.PTree.tree Values.val

Arguments generator_globalz_call_temps le aptr zrptr
### C.jet_secp_generator_globalz_call.generator_no_points_phase
generator_no_points_phase =
jet_secp_statement_prefix.statement_sequence
  (@List.firstn Clight.statement (S (S (S O)))
     (@List.skipn Clight.statement (S (S (S (S (S O)))))
        (@fst (list Clight.statement) Clight.statement
           (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_ecmult_strauss_wnaf)))))
  Clight.Sskip
     : Clight.statement
### C.jet_secp_generator_globalz_call.generator_no_points_temps
generator_no_points_temps =
fun (le : Maps.PTree.tree Values.val) (aptr zrptr : Values.val) =>
@Maps.PTree.set Values.val jets_secp._np (Values.Vlong Integers.Int64.zero)
  (generator_globalz_call_temps (jet_secp_generator_preprocess.generator_preprocessed_temps le) aptr zrptr)
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.val) (_ : Values.val), Maps.PTree.tree Values.val

Arguments generator_no_points_temps le aptr zrptr
