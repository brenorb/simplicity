eval_generator_state_pointer
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (b : Values.block)
         (base : BinNums.Z) (field : AST.ident) (delta : BinNums.Z) (ty : Ctypes.type) (v : Values.val)
         (_ : @List.In (prod AST.ident BinNums.Z) (@pair AST.ident BinNums.Z field delta)
                (@cons (prod AST.ident BinNums.Z)
