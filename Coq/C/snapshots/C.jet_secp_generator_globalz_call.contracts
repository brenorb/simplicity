### C.jet_secp_generator_globalz_call.exec_generator_globalz_empty
exec_generator_globalz_empty
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bs : Values.block) (base : BinNums.Z) (ba : Values.block) (aofs : Integers.Ptrofs.int)
         (bz : Values.block) (zofs : Integers.Ptrofs.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_table_set_globalz e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._state le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._no le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero))) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr m bs
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vptr ba aofs)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bs (BinInt.Z.add base BinNums.Z0))
                (@Some Values.val (Values.Vptr bz zofs))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_globalz_statement Events.E0
               (generator_globalz_call_temps le (Values.Vptr ba aofs) (Values.Vptr bz zofs)) mf
               ClightBigstep.Out_normal)
            (Memory.Mem.unchanged_on (fun (_ : Values.block) (_ : BinNums.Z) => True) m mf))
