### C.jet_secp_generator_globalz_call.generator_globalz_statement_source
generator_globalz_statement_source
     : @eq Clight.statement generator_globalz_statement
         (Clight.Ssequence
            (Clight.Sset jets_secp._t'32
               (generator_state_pointer jets_secp._pre_a (Ctypes.Tstruct jets_secp.__6121 Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Sset jets_secp._t'33
                  (generator_state_pointer jets_secp._aux (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)))
               (jet_secp_curve_statements.curve_call jets_secp._secp256k1_ge_table_set_globalz
                  jets_secp.f_secp256k1_ge_table_set_globalz (@None AST.ident)
                  (@cons Clight.expr generator_globalz_count
                     (@cons Clight.expr
                        (Clight.Etempvar jets_secp._t'32
                           (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6121 Ctypes.noattr)))
                        (@cons Clight.expr
                           (Clight.Etempvar jets_secp._t'33
                              (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)))
                           (@nil Clight.expr)))))))
### C.jet_secp_generator_globalz_call.generator_auxiliary_statement_source
generator_auxiliary_statement_source
     : @eq Clight.statement generator_auxiliary_statement
         (Clight.Ssequence
            (Clight.Sset jets_secp._np
               (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Ctypesdefs.tulong))
            (Clight.Sloop
               (Clight.Ssequence
                  (Clight.Sifthenelse
                     (Clight.Ebinop Cop.Olt (Clight.Etempvar jets_secp._np Ctypesdefs.tulong)
                        (Clight.Etempvar jets_secp._no Ctypesdefs.tulong) Ctypesdefs.tint) Clight.Sskip Clight.Sbreak)
                  generator_auxiliary_body)
               (Clight.Sset jets_secp._np
                  (Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._np Ctypesdefs.tulong)
                     (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tulong))))
### C.jet_secp_generator_globalz_call.generator_strauss_field
generator_strauss_field
     : forall (field : AST.ident) (delta : BinNums.Z)
         (_ : @List.In (prod AST.ident BinNums.Z) (@pair AST.ident BinNums.Z field delta)
                (@cons (prod AST.ident BinNums.Z)
                   (@pair AST.ident BinNums.Z jets_secp._pre_a
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (@cons (prod AST.ident BinNums.Z) (@pair AST.ident BinNums.Z jets_secp._aux BinNums.Z0)
                      (@nil (prod AST.ident BinNums.Z))))),
       @ex Ctypes.composite
         (fun co : Ctypes.composite =>
          and
            (@eq (option Ctypes.composite)
               (@Maps.PTree.get Ctypes.composite jets_secp._secp256k1_strauss_state
                  (Clight.genv_cenv jet_secp_linkage.secp_ge)) (@Some Ctypes.composite co))
            (@eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
               (Ctypes.field_offset (Clight.genv_cenv jet_secp_linkage.secp_ge) field (Ctypes.co_members co))
               (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield delta Ctypes.Full))))
