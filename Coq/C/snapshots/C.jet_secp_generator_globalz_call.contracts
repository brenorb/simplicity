generator_no_points_preserves
     : forall (le : Maps.PTree.tree Values.val) (aptr zrptr : Values.val) (id : AST.ident)
         (_ : not (@eq AST.ident id jets_secp._np)) (_ : not (@eq AST.ident id jets_secp._t'1))
         (_ : not (@eq AST.ident id jets_secp._t'2)) (_ : not (@eq AST.ident id jets_secp._t'32))
         (_ : not (@eq AST.ident id jets_secp._t'33)),
