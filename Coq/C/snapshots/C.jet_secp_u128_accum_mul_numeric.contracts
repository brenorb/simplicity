### C.jet_secp_u128_accum_mul_numeric.accum_mul_lo_den
accum_mul_lo_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (jet_sx_expr.den rho layout jet_secp_u128_accum_mul_exec.accum_mul_lo)
         (Values.Vlong (accum_mul_lo_machine rho))
### C.jet_secp_u128_accum_mul_numeric.accum_mul_hi_den
accum_mul_hi_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (jet_sx_expr.den rho layout jet_secp_u128_accum_mul_exec.accum_mul_hi)
         (Values.Vlong (accum_mul_hi_machine rho))
### C.jet_secp_u128_accum_mul_numeric.accum_mul_unsigned_outputs
accum_mul_unsigned_outputs
     : forall rho : forall _ : nat, Integers.Int64.int,
       let product : BinNums.Z := BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S O)))
         in
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (accum_mul_lo_machine rho))
            (BinInt.Z.modulo
               (BinInt.Z.add (Integers.Int64.unsigned (rho (S (S O)))) (BinInt.Z.modulo product Integers.Int64.modulus))
               Integers.Int64.modulus))
         (@eq BinNums.Z (Integers.Int64.unsigned (accum_mul_hi_machine rho))
            (BinInt.Z.modulo
               (BinInt.Z.add
                  (BinInt.Z.add (Integers.Int64.unsigned (rho (S (S (S O)))))
                     (BinInt.Z.div product Integers.Int64.modulus))
                  (BinInt.Z.div
                     (BinInt.Z.add (Integers.Int64.unsigned (rho (S (S O))))
                        (BinInt.Z.modulo product Integers.Int64.modulus)) Integers.Int64.modulus))
               Integers.Int64.modulus))
### C.jet_secp_u128_accum_mul_numeric.accum_mul_two_limb_mod
accum_mul_two_limb_mod
     : forall (M H L P : BinNums.Z) (_ : BinInt.Z.lt BinNums.Z0 M),
       @eq BinNums.Z
         (BinInt.Z.add
            (BinInt.Z.mul
               (BinInt.Z.modulo
                  (BinInt.Z.add (BinInt.Z.add H (BinInt.Z.div P M))
                     (BinInt.Z.div (BinInt.Z.add L (BinInt.Z.modulo P M)) M)) M) M)
            (BinInt.Z.modulo (BinInt.Z.add L (BinInt.Z.modulo P M)) M))
         (BinInt.Z.modulo (BinInt.Z.add (BinInt.Z.add (BinInt.Z.mul H M) L) P) (BinInt.Z.mul M M))
### C.jet_secp_u128_accum_mul_numeric.accum_mul_numeric_value
accum_mul_numeric_value
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned (accum_mul_hi_machine rho)) Integers.Int64.modulus)
            (Integers.Int64.unsigned (accum_mul_lo_machine rho)))
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned (rho (S (S (S O))))) Integers.Int64.modulus)
                  (Integers.Int64.unsigned (rho (S (S O)))))
               (BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S O)))))
            (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus))
### C.jet_secp_u128_accum_mul_numeric.eval_u128_accum_mul_owned_product
eval_u128_accum_mul_owned_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout jet_secp_u128_accum_mul_exec.u128_accum_mul_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_u128_accum_mul)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val (Values.Vlong (rho O))
                     (@cons Values.val (Values.Vlong (rho (S O))) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk layout O) (jet_sx_state.bas layout O))
                  (@Some Values.val (Values.Vlong (accum_mul_lo_machine rho))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk layout O)
                        (BinInt.Z.add (jet_sx_state.bas layout O)
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val (Values.Vlong (accum_mul_hi_machine rho))))
                  (and
                     (@eq BinNums.Z
                        (BinInt.Z.add
                           (BinInt.Z.mul (Integers.Int64.unsigned (accum_mul_hi_machine rho)) Integers.Int64.modulus)
                           (Integers.Int64.unsigned (accum_mul_lo_machine rho)))
                        (BinInt.Z.modulo
                           (BinInt.Z.add
                              (BinInt.Z.add
                                 (BinInt.Z.mul (Integers.Int64.unsigned (rho (S (S (S O))))) Integers.Int64.modulus)
                                 (Integers.Int64.unsigned (rho (S (S O)))))
                              (BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S O)))))
                           (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)))
                     (and
                        (jet_sx_state.rep rho layout
                           (@cons jet_sx_state.region
                              (jet_sx_state.mkreg
                                 (jet_sx_rep.u64_cells BinNums.Z0
                                    (@cons jet_sx_expr.sx jet_secp_u128_accum_mul_exec.accum_mul_lo
                                       (@cons jet_sx_expr.sx jet_secp_u128_accum_mul_exec.accum_mul_hi
                                          (@nil jet_sx_expr.sx)))) true
                                 (@Some BinNums.Z
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              (@nil jet_sx_state.region)) mf)
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot layout
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape jet_secp_u128_accum_mul_exec.u128_accum_mul_initial_regs) b ofs))
                           m mf))))))
### C.jet_secp_u128_accum_mul_numeric.accum_mul_lo_machine
accum_mul_lo_machine =
fun rho : forall _ : nat, Integers.Int64.int =>
Integers.Int64.add (rho (S (S O))) (jet_secp_umul128_numeric.umul128_lo_machine (rho O) (rho (S O)))
     : forall _ : forall _ : nat, Integers.Int64.int, Integers.Int64.int

Arguments accum_mul_lo_machine rho%function_scope
### C.jet_secp_u128_accum_mul_numeric.accum_mul_hi_machine
accum_mul_hi_machine =
fun rho : forall _ : nat, Integers.Int64.int =>
Integers.Int64.add (rho (S (S (S O))))
  (Integers.Int64.add (jet_secp_umul128_numeric.umul128_hi_machine (rho O) (rho (S O)))
     (Integers.Int64.repr
        (Integers.Int.signed
           match
             Integers.Int64.ltu (accum_mul_lo_machine rho)
               (jet_secp_umul128_numeric.umul128_lo_machine (rho O) (rho (S O))) return Integers.Int.int
           with
           | true => Integers.Int.one
           | false => Integers.Int.zero
           end)))
     : forall _ : forall _ : nat, Integers.Int64.int, Integers.Int64.int

Arguments accum_mul_hi_machine rho%function_scope
