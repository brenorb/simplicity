### C.jet_elements_single_issuance_tail.eis_active_tail_shape
eis_active_tail_shape
     : @eq Clight.statement eis_active_tail
         (Clight.Ssequence (jet_elements_single_issuance_none.eis_hash_stmt jets_elements._assetRangeProofHash)
            (Clight.Ssequence (jet_elements_single_issuance_none.eis_hash_stmt jets_elements._tokenRangeProofHash)
               (Clight.Ssequence (jet_elements_single_input_optional.eih_uchar_stmt Integers.Int.one)
                  jet_elements_single_issuance_blinding.eis_blinding_stmt)))
### C.jet_elements_single_issuance_tail.eis_tail_bytes_length
eis_tail_bytes_length
     : forall (isnew : bool) (ha ht q ent : Digest.hash256),
       @eq nat (@length Integers.Int.int (eis_tail_bytes isnew ha ht q ent))
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
### C.jet_elements_single_issuance_tail.exec_eis_active_tail
exec_eis_active_tail
     : forall (_ : jet_memcpy_model.memcpy_model) (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (isnew : bool) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bin : Values.block) (ofs : BinNums.Z)
         (bb : Values.block) (ha ht q ent : Digest.hash256) (l regs : list Integers.Int.int)
         (c : Integers.Int64.int) (ovf : bool) (_ : jet_elements_support_sha_ctxi.ctxi m bx bm l regs c ovf)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements.___compound__3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_uchars e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_hash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_uchar e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._issuance le)
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs)))) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bin bx)) (_ : not (@eq Values.block bin bm))
         (_ : not (@eq Values.block bb bin)) (_ : not (@eq Values.block bb bx)) (_ : not (@eq Values.block bb bm))
         (_ : not
                (@eq Values.block bb
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bb
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bin
                   (BinInt.Z.add ofs
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                (@Some Values.val (Values.Vint (jet_elements_single_issuance_amount.eis_kind isnew))))
         (_ : jet_uint32_array_init.uint32_array_at m bin
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
                (Digest.hash256_reg ha))
         (_ : jet_uint32_array_init.uint32_array_at m bin
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (Digest.hash256_reg ht)) (_ : jet_uint32_array_init.uint32_array_at m bin ofs (Digest.hash256_reg q))
         (_ : forall _ : @eq bool isnew false,
              jet_uint32_array_init.uint32_array_at m bin
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (Digest.hash256_reg ent))
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex bool
            (fun ovf' : bool =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m eis_active_tail
                  Events.E0
                  (@Maps.PTree.set Values.val jets_elements._t'5
                     (Values.Vint (jet_elements_single_issuance_amount.eis_kind isnew)) le) mf ClightBigstep.Out_normal)
               (and
                  (jet_elements_support_sha_ctxi.ctxi mf bx bm
                     (@fst (list Integers.Int.int) (list Integers.Int.int)
                        (jet_elements_support_sha_uchars_prep.absorb_i l regs (eis_tail_bytes isnew ha ht q ent)))
                     (@snd (list Integers.Int.int) (list Integers.Int.int)
                        (jet_elements_support_sha_uchars_prep.absorb_i l regs (eis_tail_bytes isnew ha ht q ent)))
                     (Integers.Int64.add c
                        (Integers.Int64.repr
                           (BinNums.Zpos
                              (BinNums.xI
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     ovf')
                  (and
                     (forall (ch : AST.memory_chunk) (b : Values.block) (o : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b) (_ : not (@eq Values.block b bb))
                        (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
                      @eq (option Values.val) (Memory.Mem.load ch mf b o) (Memory.Mem.load ch m b o))
                     (and
                        (forall (b : Values.block) (o : BinNums.Z) (k : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b o k p),
                         Memory.Mem.perm mf b o k p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
