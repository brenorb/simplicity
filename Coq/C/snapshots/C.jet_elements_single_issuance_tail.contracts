### C.jet_elements_single_issuance_tail.eis_tail_bytes
eis_tail_bytes =
fun (isnew : bool) (ha ht q ent : Digest.hash256) =>
@app Integers.Int.int
  (@app Integers.Int.int
     (@app Integers.Int.int (jet_elements_support_sha_be32_write.be_bytes (Digest.hash256_reg ha))
        (jet_elements_support_sha_be32_write.be_bytes (Digest.hash256_reg ht)))
     (@cons Integers.Int.int Integers.Int.one (@nil Integers.Int.int)))
  (jet_elements_single_issuance_blinding.eis_blinding_bytes isnew q ent)
     : forall (_ : bool) (_ : Digest.hash256) (_ : Digest.hash256) (_ : Digest.hash256) (_ : Digest.hash256),
       list Integers.Int.int

Arguments eis_tail_bytes isnew%bool_scope ha ht q ent
