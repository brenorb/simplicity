### C.jet_bitcoin_tx_sig_hash_literal.literal_bitcoin_tx_hash
literal_bitcoin_tx_hash =
fun alg : jet_bitcoin_full_prim.PF.Algebra =>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@AC.comp Ty.Unit (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@AC.comp Ty.Unit
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
           (@AC.comp Ty.Unit
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type core
              (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) core
                 (@jet_sha_hash_words_literal.literal_sha_hash_ctx_init core)
                 (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))) core
                    (@jet_bitcoin_full_prim.PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
                       (@jet_bitcoin_full_prim.BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S O))))))
                          Bitcoin.Bitcoin.Version))
                    (@jet_bitcoin_full_prim.PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
                       (@jet_bitcoin_full_prim.BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S O))))))
                          Bitcoin.Bitcoin.LockTime)))) (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S (S O))) term))
           (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_bitcoin_inputs_hash_literal.literal_bitcoin_inputs_hash alg)
              (@jet_bitcoin_composite_hash_literal.literal_bitcoin_outputs_hash alg)))
        (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S (S (S (S (S O)))))) term))
     (@jet_bitcoin_composite_hash_literal.literal_bitcoin_input_utxos_hash alg))
  (@AC.comp
     (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
     jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S (S (S (S O))))) term)
     (@jet_sha_finalize_literal.literal_ctx8_finalize term))
     : forall alg : jet_bitcoin_full_prim.PF.Algebra,
       jet_bitcoin_full_prim.PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments literal_bitcoin_tx_hash {alg}
### C.jet_bitcoin_tx_sig_hash_literal.literal_bitcoin_sig_all_hash
literal_bitcoin_sig_all_hash =
fun alg : jet_bitcoin_full_prim.PF.Algebra =>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@AC.comp Ty.Unit (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S O)))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S O)))))) core
     (@AC.comp Ty.Unit
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
           (@jet_sha_hash_words_literal.literal_sha_hash_ctx_init core)
           (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@literal_bitcoin_tx_hash alg)
              (@jet_bitcoin_tap_hash_literal.literal_bitcoin_tap_env_hash alg)))
        (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S (S (S (S (S O)))))) term))
     (@jet_bitcoin_full_prim.PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
        (@jet_bitcoin_full_prim.BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.CurrentIndex)))
  (@AC.comp (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S O))))
     jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S O)) term) (@jet_sha_finalize_literal.literal_ctx8_finalize term))
