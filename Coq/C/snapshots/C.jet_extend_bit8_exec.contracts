### C.jet_extend_bit8_exec.extend_bit8_body
extend_bit8_body
     : @eq Clight.statement (Clight.fn_body jets.f_simplicity_left_extend_1_8)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence jet_complement1_exec.bit_jet_read
                  (Clight.Sset jets._bit (Clight.Ecast (Clight.Etempvar jets._t'1 Ctypesdefs.tbool) Ctypesdefs.tbool)))
               (Clight.Ssequence
                  (Clight.Ssequence extend_bit8_choose
                     (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write8 Ctypesdefs.tuchar
                        Ctypesdefs.tvoid (Clight.Etempvar jets._t'2 Ctypesdefs.tint)))
                  (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))))))
### C.jet_extend_bit8_exec.eval_extend_bit8_choice_expr
eval_extend_bit8_choice_expr
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (bit : bool),
       Clight.eval_expr jet_exec.ge0 e le m (extend_bit8_choice_expr bit) (Values.Vint (extend_bit8_arg bit))
### C.jet_extend_bit8_exec.exec_extend_bit8_choose
exec_extend_bit8_choose
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bit : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._bit le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit)))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m extend_bit8_choose Events.E0
         (@Maps.PTree.set Values.val jets._t'2 (Values.Vint (extend_bit8_arg bit)) le) m ClightBigstep.Out_normal
### C.jet_extend_bit8_exec.extend_bit8_cast
extend_bit8_cast
     : forall (bit : bool) (m : Memory.Mem.mem),
       @eq (option Values.val) (Cop.sem_cast (Values.Vint (extend_bit8_arg bit)) Ctypesdefs.tint Ctypesdefs.tuchar m)
         (@Some Values.val (Values.Vint (extend_bit8_arg bit)))
### C.jet_extend_bit8_exec.eval_extend_bit8_composes
eval_extend_bit8_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc mr me mf : Memory.Mem.mem)
         (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (bit : bool) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc (@Ctypes.Internal Clight.function jets.f_readBit)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint (jet_readBit_layout.bit_int bit)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vint (extend_bit8_arg bit)) (@nil Values.val))) Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_left_extend_1_8)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_extend_bit8_exec.extend_bit8_arg
extend_bit8_arg =
fun bit : bool =>
match bit return Integers.Int.int with
| true =>
    Integers.Int.repr
      (BinNums.Zpos
         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
| false => Integers.Int.zero
end
     : forall _ : bool, Integers.Int.int

Arguments extend_bit8_arg bit%bool_scope
### C.jet_extend_bit8_exec.extend_bit8_choice_expr
extend_bit8_choice_expr =
fun bit : bool =>
Clight.Ecast
  match bit return Clight.expr with
  | true =>
      Clight.Econst_int
        (Integers.Int.repr
           (BinNums.Zpos
              (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
        Ctypesdefs.tint
  | false => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
  end Ctypesdefs.tint
     : forall _ : bool, Clight.expr

Arguments extend_bit8_choice_expr bit%bool_scope
### C.jet_extend_bit8_exec.extend_bit8_choose
extend_bit8_choose =
Clight.Sifthenelse (Clight.Etempvar jets._bit Ctypesdefs.tbool) (Clight.Sset jets._t'2 (extend_bit8_choice_expr true))
  (Clight.Sset jets._t'2 (extend_bit8_choice_expr false))
     : Clight.statement
### C.jet_extend_bit8_exec.le_extend_bit8
le_extend_bit8 =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (bit : bool) =>
@Maps.PTree.set Values.val jets._bit (Values.Vint (jet_readBit_layout.bit_int bit))
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vint (jet_readBit_layout.bit_int bit))
     (jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_left_extend_1_8 bd dofs bs sofs))
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : bool), Maps.PTree.tree Values.val

Arguments le_extend_bit8 env bd dofs bs sofs bit%bool_scope
