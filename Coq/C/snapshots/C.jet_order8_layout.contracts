### C.jet_order8_layout.eval_order8_layout_matches_spec
eval_order8_layout_matches_spec
     : forall (env : Values.val) (k : jet_order_spec.order_op) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (x y : Ty.tySem (Word.Word (S (S (S O))))) (cursor rc : BinNums.Z)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : jet_input_layout.byte_slice_at m bi edge rc x)
         (_ : jet_input_layout.byte_slice_at m bi edge
                (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) y)
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor (BinNums.Zpos BinNums.xH)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function (jet_order8_exec.order8 k))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Ty.Sum Ty.Unit Ty.Unit)
                     (@jet_order_spec.order_word_spec k (S (S (S O))) Alg.CoreFunSem
                        (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O))))) x y))))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_order8_layout.order8_local_spec
order8_local_spec
     : forall k : jet_order_spec.order_op,
       jet_bitmachine_rep.jet_local_spec (jet_order8_exec.order8 k)
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) (Ty.Sum Ty.Unit Ty.Unit)
         (fun xy : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) =>
          @jet_order_spec.order_word_spec k (S (S (S O))) Alg.CoreFunSem xy)
### C.jet_order8_layout.lt8_local_spec
lt8_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_lt_8
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) (Ty.Sum Ty.Unit Ty.Unit)
         (fun xy : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) =>
          @jet_order_spec.order_word_spec jet_order_spec.OLt (S (S (S O))) Alg.CoreFunSem xy)
### C.jet_order8_layout.le8_local_spec
le8_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_le_8
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) (Ty.Sum Ty.Unit Ty.Unit)
         (fun xy : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) =>
          @jet_order_spec.order_word_spec jet_order_spec.OLe (S (S (S O))) Alg.CoreFunSem xy)
### C.jet_order8_layout.order8_context
order8_context
     : forall k : jet_order_spec.order_op,
       @jet_canonical.jet_context_for (jet_order8_exec.order8 k)
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) (Ty.Sum Ty.Unit Ty.Unit)
         (@jet_order_spec.order_word_spec k (S (S (S O))))
### C.jet_order8_layout.order8_guarantees
order8_guarantees
     : forall (k : jet_order_spec.order_op) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add read_cursor
                   (BinInt.Z.of_nat (Translate.bitSize (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))))
                Integers.Int64.max_unsigned)
         (_ : jet_encoding.frame_input_cells_at m bi edge read_cursor
                (@Translate.encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a))
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.of_nat (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function (jet_order8_exec.order8 k))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Ty.Sum Ty.Unit Ty.Unit)
                     (@jet_order_spec.order_word_spec k (S (S (S O))) Alg.CoreFunSem a)))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit)))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_order8_layout.order8_context_guarantees
order8_context_guarantees
     : forall (k : jet_order_spec.order_op) (env : Values.val) (m : Memory.Mem.mem) (L : jet_bitmachine_rep.bm_layout)
         (ctx : BitMachine.Context) (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))),
       let s0 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState
              (@Translate.encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a)
              (BitMachine.newWriteFrame (Translate.bitSize (Ty.Sum Ty.Unit Ty.Unit)))) in
       let s1 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState
              (@Translate.encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a)
              (BitMachine.fullWriteFrame
                 (@Translate.encode (Ty.Sum Ty.Unit Ty.Unit)
                    (@jet_order_spec.order_word_spec k (S (S (S O))) Alg.CoreFunSem a)))) in
       forall (_ : jet_bitmachine_rep.bm_rep m L s0) (_ : jet_bitmachine_rep.bm_separated L s0)
         (_ : jet_bitmachine_rep.active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function (jet_order8_exec.order8 k)) (jet_bitmachine_rep.jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (jet_bitmachine_rep.bm_rep mf L s1)
               (BitMachine.runProgram (@jet_order_spec.order_word_spec k (S (S (S O))) Translate.Naive.translate)
                  (BitMachine.Running s0) (BitMachine.Running s1))))
