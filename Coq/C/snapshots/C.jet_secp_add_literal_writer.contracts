### C.jet_secp_add_literal_writer.add_writer_literal_output
add_writer_literal_output
     : forall (rho : forall _ : nat, Integers.Int64.int) (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : forall (n : nat) (_ : lt n (S (S (S (S (S O)))))),
              and
                (BinInt.Z.le (Integers.Int64.unsigned (rho (S n)))
                   (BinInt.Z.sub
                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                      (BinNums.Zpos BinNums.xH)))
                (BinInt.Z.le (Integers.Int64.unsigned (rho (Nat.add (S (S (S (S (S (S O)))))) n)))
                   (BinInt.Z.sub
                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                      (BinNums.Zpos BinNums.xH))))
         (_ : @eq BinNums.Z (jet_secp_field_add_numeric.field_input_value rho (S O))
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   jet_secp_canonical_normalize.canonical_field_order))
         (_ : @eq BinNums.Z (jet_secp_field_add_numeric.field_input_value rho (S (S (S (S (S (S O)))))))
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                   jet_secp_canonical_normalize.canonical_field_order)),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_write_fe_wide_exec.wide_fe_output (jet_secp_field_add_values.add_value rho O)
            (jet_secp_field_add_values.add_value rho (S O)) (jet_secp_field_add_values.add_value rho (S (S O)))
            (jet_secp_field_add_values.add_value rho (S (S (S O))))
            (jet_secp_field_add_values.add_value rho (S (S (S (S O))))))
         (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))
