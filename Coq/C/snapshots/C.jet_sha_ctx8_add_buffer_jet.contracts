### C.jet_sha_ctx8_add_buffer_jet.ab_entry
ab_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 m5 : Memory.Mem.mem')
         (bl bm bb bn bx bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bm))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                (@pair Memory.Mem.mem' Values.block m3 bb))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block m4 bn))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m4 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m5 bx)),
       Clight.function_entry2 jet_sha_linkage.sha_ge jets_sha.f_simplicity_sha_256_ctx_8_add_buffer_511
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (ab_env bl bm bb bn bx) (ab_temps env bd dbase bs sbase) m5
### C.jet_sha_ctx8_add_buffer_jet.ab_copy
ab_copy
     : forall (m mc : Memory.Mem.mem) (bl bm bb bn bx bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge (ab_env bl bm bb bn bx) le m
         (Clight.Sassign (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
### C.jet_sha_ctx8_add_buffer_jet.alloc_chain5
alloc_chain5
     : forall (m : Memory.Mem.mem) (m1 m2 m3 m4 m5 : Memory.Mem.mem') (b1 b2 b3 b4 b5 : Values.block)
         (z1 z2 z3 z4 z5 : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m BinNums.Z0 z1)
                (@pair Memory.Mem.mem' Values.block m1 b1))
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m1 BinNums.Z0 z2)
                (@pair Memory.Mem.mem' Values.block m2 b2))
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m2 BinNums.Z0 z3)
                (@pair Memory.Mem.mem' Values.block m3 b3))
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m3 BinNums.Z0 z4)
                (@pair Memory.Mem.mem' Values.block m4 b4))
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m4 BinNums.Z0 z5)
                (@pair Memory.Mem.mem' Values.block m5 b5)),
       and (jet_sha_compress_call.mext m m5)
         (and
            (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
             and (not (@eq Values.block b b1))
               (and (not (@eq Values.block b b2))
                  (and (not (@eq Values.block b b3)) (and (not (@eq Values.block b b4)) (not (@eq Values.block b b5))))))
            (and
               (@List.NoDup Values.block
                  (@cons Values.block b1
                     (@cons Values.block b2
                        (@cons Values.block b3 (@cons Values.block b4 (@cons Values.block b5 (@nil Values.block)))))))
               (and (Memory.Mem.range_perm m5 b1 BinNums.Z0 z1 Memtype.Cur Memtype.Freeable)
                  (and (Memory.Mem.range_perm m5 b2 BinNums.Z0 z2 Memtype.Cur Memtype.Freeable)
                     (and (Memory.Mem.range_perm m5 b3 BinNums.Z0 z3 Memtype.Cur Memtype.Freeable)
                        (and (Memory.Mem.range_perm m5 b4 BinNums.Z0 z4 Memtype.Cur Memtype.Freeable)
                           (and (Memory.Mem.range_perm m5 b5 BinNums.Z0 z5 Memtype.Cur Memtype.Freeable)
                              (and (Memory.Mem.valid_block m5 b1)
                                 (and (Memory.Mem.valid_block m5 b2)
                                    (and (Memory.Mem.valid_block m5 b3)
                                       (and (Memory.Mem.valid_block m5 b4) (Memory.Mem.valid_block m5 b5))))))))))))
### C.jet_sha_ctx8_add_buffer_jet.nodup5
@nodup5
     : forall (A : Type) (a b c d e : A)
         (_ : @List.NoDup A (@cons A a (@cons A b (@cons A c (@cons A d (@cons A e (@nil A))))))),
       and (not (@eq A a b))
         (and (not (@eq A a c))
            (and (not (@eq A a d))
               (and (not (@eq A a e))
                  (and (not (@eq A b c))
                     (and (not (@eq A b d))
                        (and (not (@eq A b e)) (and (not (@eq A c d)) (and (not (@eq A c e)) (not (@eq A d e))))))))))
### C.jet_sha_ctx8_add_buffer_jet.sha_256_ctx_8_add_buffer_511_local_spec
sha_256_ctx_8_add_buffer_511_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       jet_sha_ctx8_add_jets.sha_jet_partial_local_spec jets_sha.f_simplicity_sha_256_ctx_8_add_buffer_511
         (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
            (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S (S (S (S O))))))))))
         jet_sha256_ctx8_init_spec.sha256_ctx8_type
         (fun
            a : Ty.tySem
                  (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                     (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S (S (S (S O))))))))))
          =>
          @jet_sha_add_buffer_spec.ctx8_add_buffer_spec (S (S (S (S (S (S (S (S O))))))))
            (Alg.AssertionSem Option.option_Monad_Zero) a)
### C.jet_sha_ctx8_add_buffer_jet.ab_env
ab_env =
fun bl bm bb bn bx : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._ctx
  (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._buf_len
     (@pair Values.block Ctypes.type bn Ctypesdefs.tulong)
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._buf
        (@pair Values.block Ctypes.type bb
           (Ctypesdefs.tarray Ctypesdefs.tuchar
              (BinNums.Zpos
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._midstate
           (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
           (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._src
              (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Clight.empty_env))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block),
       Clight.env

Arguments ab_env bl bm bb bn bx
### C.jet_sha_ctx8_add_buffer_jet.ab_temps
ab_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_sha._env env
  (@Maps.PTree.set Values.val jets_sha._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_sha._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_sha.f_simplicity_sha_256_ctx_8_add_buffer_511))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments ab_temps env bd dbase%Z_scope bs sbase%Z_scope
