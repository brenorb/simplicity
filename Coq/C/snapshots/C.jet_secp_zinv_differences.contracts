                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence jet_secp_mixed_difference.mixed_difference_statements
                  Clight.Sskip) Events.E0 le mf ClightBigstep.Out_normal)
            (and (jet_secp_zinv_start.zinv_start_fields mf bp ba bb baz bz bu bv bs bt x y z u v inv)
               (and (jet_secp_zinv_start.zinv_start_owned mf bp ba bb baz bz bu bv bs bt)
                  (and
                     (jet_secp_fe_nv.fe_at mf bh BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (zinv_h_words x z u inv)))
                     (and
                        (jet_secp_fe_nv.fe_at mf bi BinNums.Z0
                           (jet_secp_multiply_normalize_bridge.words5 (zinv_i_words y z v inv)))
                        (and
