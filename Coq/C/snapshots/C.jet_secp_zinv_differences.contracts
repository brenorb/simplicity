                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bi BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (zinv_h_words x z u inv))
                                    (BinInt.Z.add
                                       (BinInt.Z.sub
                                          (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                             jet_secp_fe_math.feP)
                                          (jet_secp_multiply_finish_product.radix_value
                                             (jet_secp_field_weak_loose.weak_loose_words x)))
                                       (jet_secp_multiply_finish_product.radix_value
                                          (jet_secp_point_mul_storage.point_mul_words u
                                             (jet_secp_zinv_start.zinv_z12_words z inv)))))
                                 (and
                                    (@eq BinNums.Z
                                       (jet_secp_multiply_finish_product.radix_value (zinv_i_words y z v inv))
                                       (BinInt.Z.add
                                          (BinInt.Z.sub
                                             (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                                jet_secp_fe_math.feP)
                                             (jet_secp_multiply_finish_product.radix_value
                                                (jet_secp_zinv_preparation.zinv_s2_words v
                                                   (jet_secp_zinv_start.zinv_z12_words z inv)
                                                   (jet_secp_zinv_start.zinv_az_words z inv))))
                                          (jet_secp_multiply_finish_product.radix_value
                                             (jet_secp_field_weak_loose.weak_loose_words y))))
                                    (and (jet_secp_square_columns.square_input_bounds (zinv_h_words x z u inv))
                                       (and (jet_secp_square_columns.square_input_bounds (zinv_i_words y z v inv))
                                          (jet_sx_mem.lframe (zinv_difference_frame bu bv bs bt bz baz bp ba bb bh bi)
                                             m mf))))))))))))
