### C.jet_secp_signed62_repack.fe_repack_run_eq
fe_repack_run_eq
     : forall to62 : bool,
       @eq (option jet_sx_exec.res) (fe_repack_run to62)
         (@Some jet_sx_exec.res (jet_sx_exec.RDone (fe_repack_state to62) jet_sx_exec.ONormal))
### C.jet_secp_signed62_repack.fe_repack_return
fe_repack_return
     : forall to62 : bool,
       @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps (fe_repack_state to62)))
         (@None jet_sx_expr.sx)
### C.jet_secp_signed62_repack.fe_repack_output_shape
fe_repack_output_shape
     : forall to62 : bool,
       @eq (list jet_sx_state.region) (jet_sx_eval.sregs (fe_repack_state to62)) (fe_repack_out_regs to62)
### C.jet_secp_signed62_repack.fe_repack_output_den
fe_repack_output_den
     : forall (to62 : bool) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta)) (fe_repack_out to62))
         (@List.map Integers.Int64.int Values.val Values.Vlong
            (jet_secp_multiply_normalize_bridge.words5 (fe_repack_words to62 rho)))
### C.jet_secp_signed62_repack.eval_fe_repack_symbolic
eval_fe_repack_symbolic
     : forall (to62 : bool) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem) (_ : jet_sx_state.rep rho beta fe_repack_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function (fe_repack_function to62))
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho beta (fe_repack_out_regs to62) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot beta
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape fe_repack_regs) b pos)) m mf)))
### C.jet_secp_signed62_repack.fe_repack_fields
fe_repack_fields
     : forall (to62 : bool) (w : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem) (_ : jet_sx_state.rep w beta (fe_repack_out_regs to62) m),
       and
         (jet_secp_fe_nv.fe_at m (jet_sx_state.blk beta O) (jet_sx_state.bas beta O)
            (jet_secp_multiply_normalize_bridge.words5 (fe_repack_words to62 w)))
         (and
            (jet_secp_fe_nv.fe_at m (jet_sx_state.blk beta (S O)) (jet_sx_state.bas beta (S O))
               (jet_secp_multiply_normalize_bridge.words5 w))
            (and
               (Memory.Mem.range_perm m (jet_sx_state.blk beta O) BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (Memory.Mem.range_perm m (jet_sx_state.blk beta (S O)) BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)))
### C.jet_secp_signed62_repack.eval_fe_repack_from_storage
eval_fe_repack_from_storage
     : forall (to62 : bool) (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function (fe_repack_function to62))
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (fe_repack_words to62 w)))
               (and (jet_secp_fe_nv.fe_at mf bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and
                     (Memory.Mem.range_perm mf bout BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bin BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bout)) (not (@eq Values.block b bin))) m mf))))))
### C.jet_secp_signed62_repack.fe_repack_function
fe_repack_function =
fun to62 : bool =>
match to62 return Clight.function with
| true => jets_secp.f_secp256k1_fe_to_signed62
| false => jets_secp.f_secp256k1_fe_from_signed62
end
     : forall _ : bool, Clight.function

