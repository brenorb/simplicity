### C.jet_secp_signed62_repack.fe_repack_tree
fe_repack_tree =
fun to62 : bool => match to62 return (option jet_sx_exec.res) with
                   | true => fe_to62_tree
                   | false => fe_from62_tree
                   end
     : forall _ : bool, option jet_sx_exec.res

