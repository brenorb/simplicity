### C.jet_elements_issuance_proofs_hash_program.elements_issuance_asset_proof_bytes
elements_issuance_asset_proof_bytes =
fun txi : jet_elements_prim.sigTxInput =>
match jet_elements_prim.sigTxiIssuance txi return (list Integers.Byte.int) with
| Some i =>
    @jet_elements_prim.viewPrf Integers.Int64.int
      match i return (jet_elements_prim.confidential (list Integers.Byte.int) Integers.Int64.int) with
      | inl ni => jet_elements_prim.newIssuanceAmount ni
      | inr ri => jet_elements_prim.reissuanceAmount ri
      end
| None => @nil Integers.Byte.int
end
     : forall _ : jet_elements_prim.sigTxInput, list Integers.Byte.int

Arguments elements_issuance_asset_proof_bytes txi
### C.jet_elements_issuance_proofs_hash_program.elements_issuance_token_proof_bytes
elements_issuance_token_proof_bytes =
fun txi : jet_elements_prim.sigTxInput =>
match jet_elements_prim.sigTxiIssuance txi return (list Integers.Byte.int) with
| Some i =>
    @jet_elements_prim.viewPrf Integers.Int64.int
      match i return (jet_elements_prim.confidential (list Integers.Byte.int) Integers.Int64.int) with
      | inl ni => jet_elements_prim.newIssuanceTokenAmount ni
      | inr _ => @jet_elements_prim.Explicit (list Integers.Byte.int) Integers.Int64.int Integers.Int64.zero
      end
| None => @nil Integers.Byte.int
end
     : forall _ : jet_elements_prim.sigTxInput, list Integers.Byte.int

Arguments elements_issuance_token_proof_bytes txi
### C.jet_elements_issuance_proofs_hash_program.elements_issuance_proofs_of
elements_issuance_proofs_of =
fun e : jet_elements_prim.Elements.env =>
@List.map jet_elements_prim.sigTxInput
  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (fun txi : jet_elements_prim.sigTxInput =>
   @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.from_hash256 (Digest.byteStringHash (elements_issuance_asset_proof_bytes txi)))
     (Word.from_hash256 (Digest.byteStringHash (elements_issuance_token_proof_bytes txi))))
  (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
     : forall _ : jet_elements_prim.Elements.env, list (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))))

Arguments elements_issuance_proofs_of e
