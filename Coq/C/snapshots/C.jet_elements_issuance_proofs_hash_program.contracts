let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type)
