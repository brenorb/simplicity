     : forall _ : BinNums.Z, BinNums.Z

Arguments swu_c_candidate2 t%Z_scope
### C.jet_secp_swu_candidates.swu_c_candidate3
swu_c_candidate3 =
fun t : BinNums.Z =>
BinInt.Z.add (BinNums.Zpos BinNums.xH)
  (BinInt.Z.mul
     (BinInt.Z.pow (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
        (BinNums.Zpos (BinNums.xI BinNums.xH))) (swu_joint_inverse t))
     : forall _ : BinNums.Z, BinNums.Z

