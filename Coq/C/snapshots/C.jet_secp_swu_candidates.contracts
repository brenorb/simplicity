### C.jet_secp_swu_candidates.swu_inv
swu_inv = fun a : BinNums.Z => modinv.modInv a jet_secp_fe_math.feP
     : forall _ : BinNums.Z, BinNums.Z

Arguments swu_inv a%Z_scope
### C.jet_secp_swu_candidates.swu_cubic
swu_cubic =
fun x : BinNums.Z =>
BinInt.Z.add (BinInt.Z.pow x (BinNums.Zpos (BinNums.xI BinNums.xH)))
  (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))
     : forall _ : BinNums.Z, BinNums.Z

Arguments swu_cubic x%Z_scope
### C.jet_secp_swu_candidates.swu_x1
swu_x1 =
fun c t : BinNums.Z =>
swu_div
  (BinInt.Z.sub
     (BinInt.Z.mul c (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.mul t t)))
     (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
     (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments swu_x1 (c t)%Z_scope
### C.jet_secp_swu_candidates.swu_x2
swu_x2 =
fun c t : BinNums.Z =>
swu_div
  (BinInt.Z.sub
     (BinInt.Z.mul (BinInt.Z.opp c)
        (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.mul t t)))
     (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
     (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments swu_x2 (c t)%Z_scope
### C.jet_secp_swu_candidates.swu_x3
swu_x3 =
fun t : BinNums.Z =>
swu_div
  (BinInt.Z.sub (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) t) t)
     (BinInt.Z.pow (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
        (BinNums.Zpos (BinNums.xO BinNums.xH))))
  (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) t) t)
     : forall _ : BinNums.Z, BinNums.Z

Arguments swu_x3 t%Z_scope
### C.jet_secp_swu_candidates.swu_product_factor
swu_product_factor =
fun c t : BinNums.Z =>
swu_div
  (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) c)
     (BinInt.Z.pow t (BinNums.Zpos (BinNums.xI BinNums.xH))))
  (BinInt.Z.pow (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     (BinNums.Zpos (BinNums.xI BinNums.xH)))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

