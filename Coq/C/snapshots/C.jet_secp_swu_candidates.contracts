### C.jet_secp_swu_candidates.swu_c_candidates_third
swu_c_candidates_third
     : forall (x y z : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
         (t : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                (swu_cubic (swu_c_candidate1 t)))
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                (swu_cubic (swu_c_candidate2 t)))
         (_ : Zdiv.eqm jet_secp_fe_math.feP (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z)
                (swu_cubic (swu_c_candidate3 t)))
