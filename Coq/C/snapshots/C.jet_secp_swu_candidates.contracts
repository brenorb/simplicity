     : BinNums.Z
### C.jet_secp_swu_candidates.swu_joint_inverse
swu_joint_inverse =
fun t : BinNums.Z =>
swu_inv
  (BinInt.Z.mul (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zneg (BinNums.xI BinNums.xH)) t) t))
     : forall _ : BinNums.Z, BinNums.Z

Arguments swu_joint_inverse t%Z_scope
### C.jet_secp_swu_candidates.swu_c_candidate1
swu_c_candidate1 =
fun t : BinNums.Z =>
BinInt.Z.add swu_d_constant
  (BinInt.Z.mul
     (BinInt.Z.mul (BinInt.Z.mul (BinInt.Z.mul swu_negc_constant t) t)
        (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zneg (BinNums.xI BinNums.xH)) t) t)) (swu_joint_inverse t))
     : forall _ : BinNums.Z, BinNums.Z

