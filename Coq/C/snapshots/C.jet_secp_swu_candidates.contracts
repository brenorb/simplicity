         (_ : Zdiv.eqm jet_secp_fe_math.feP (BinInt.Z.mul c c) (BinNums.Zneg (BinNums.xI BinNums.xH))),
       Zdiv.eqm jet_secp_fe_math.feP
         (BinInt.Z.mul
            (BinInt.Z.add
               (BinInt.Z.pow
                  (BinInt.Z.sub
                     (BinInt.Z.mul c (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) s))
                     (BinInt.Z.add s (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (BinNums.Zpos (BinNums.xI BinNums.xH)))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))
                  (BinInt.Z.pow (BinInt.Z.add s (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (BinNums.Zpos (BinNums.xI BinNums.xH)))))
            (BinInt.Z.add
               (BinInt.Z.pow
                  (BinInt.Z.sub
                     (BinInt.Z.mul (BinInt.Z.opp c)
                        (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) s))
                     (BinInt.Z.add s (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (BinNums.Zpos (BinNums.xI BinNums.xH)))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))
                  (BinInt.Z.pow (BinInt.Z.add s (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (BinNums.Zpos (BinNums.xI BinNums.xH))))))
         (BinInt.Z.mul
            (BinNums.Zneg
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))
            (BinInt.Z.add
               (BinInt.Z.pow
                  (BinInt.Z.sub (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) s)
                     (BinInt.Z.pow (BinInt.Z.add s (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (BinNums.Zpos (BinNums.xO BinNums.xH)))) (BinNums.Zpos (BinNums.xI BinNums.xH)))
               (BinInt.Z.mul
                  (BinNums.Zpos
                     (BinNums.xI
                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (BinInt.Z.pow s (BinNums.Zpos (BinNums.xI BinNums.xH))))))
### C.jet_secp_swu_candidates.swu_candidate_pair_square
swu_candidate_pair_square
     : forall (c t : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (BinInt.Z.mul c c) (BinNums.Zneg (BinNums.xI BinNums.xH)))
         (_ : not (Zdiv.eqm jet_secp_fe_math.feP t BinNums.Z0)),
       Zdiv.eqm jet_secp_fe_math.feP (BinInt.Z.mul (swu_cubic (swu_x1 c t)) (swu_cubic (swu_x2 c t)))
         (BinInt.Z.mul (BinInt.Z.mul (swu_product_factor c t) (swu_product_factor c t)) (swu_cubic (swu_x3 t)))
### C.jet_secp_swu_candidates.swu_constant_square
swu_constant_square
     : Zdiv.eqm jet_secp_fe_math.feP (BinInt.Z.mul swu_c_constant swu_c_constant)
         (BinNums.Zneg (BinNums.xI BinNums.xH))
### C.jet_secp_swu_candidates.swu_negc_constant_link
swu_negc_constant_link
