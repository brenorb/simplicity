       @eq bool (Bit.toBool (jet_secp_root_check.literal_root_check z)) true
### C.jet_secp_swu_candidates.swu_div
swu_div =
fun a b : BinNums.Z => BinInt.Z.mul a (modinv.modInv b jet_secp_fe_math.feP)
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

