                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (...)))))))))))))))))))))))
     : BinNums.Z
### C.jet_secp_swu_candidates.swu_c_constant
swu_c_constant = BinInt.Z.sub jet_secp_fe_math.feP swu_negc_constant
     : BinNums.Z
### C.jet_secp_swu_candidates.swu_d_constant
swu_d_constant =
BinNums.Zpos
  (BinNums.xO
