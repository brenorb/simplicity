         (@elements_issuance_blinding_entropy_spec)
### C.jet_elements_blinding_entropy_spec.elements_blinding_entropies_sem
elements_blinding_entropies_sem
     : forall (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem blinding_entropy_result_type))
         (@elements_issuance_blinding_entropy_spec
            (jet_elements_words_hash_program.EFP.Theory.PrimitivePrimSem Option.option_Monad_Zero) i e)
         (@Some (sum unit (Ty.tySem blinding_entropy_value_type))
            match
              @List.nth_error (Ty.tySem blinding_entropy_value_type) (elements_blinding_entropies e)
                (BinInt.Z.to_nat (jet_forWhile_seq.wz (S (S (S (S (S O))))) i))
              return (sum unit (Ty.tySem blinding_entropy_value_type))
            with
            | Some x => @inr unit (Ty.tySem blinding_entropy_value_type) x
            | None => @inl unit (Ty.tySem blinding_entropy_value_type) tt
            end)
