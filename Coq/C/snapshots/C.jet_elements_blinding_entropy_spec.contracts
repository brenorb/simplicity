### C.jet_elements_blinding_entropy_spec.blinding_entropy_body_value
blinding_entropy_body_value =
fun blinding entropy : Ty.tySem blinding_digest_option =>
match blinding return (Ty.tySem blinding_entropy_result_type) with
| inl _ =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
