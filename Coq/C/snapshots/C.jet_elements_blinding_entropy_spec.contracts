                                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) b h))
            end
        end
    end
end
     : forall (_ : Ty.tySem blinding_digest_option) (_ : Ty.tySem blinding_digest_option),
       Ty.tySem blinding_entropy_result_type

Arguments blinding_entropy_body_value blinding entropy
### C.jet_elements_blinding_entropy_spec.blinding_entropy_route_spec
blinding_entropy_route_spec =
fun core : Alg.Core.Algebra =>
@jet_buffer_empty_spec.AC.case Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Prod blinding_digest_option blinding_digest_option) (Ty.Sum Ty.Unit blinding_entropy_value_type) core
  (@jet_buffer_empty_spec.AC.injl (Ty.Prod Ty.Unit (Ty.Prod blinding_digest_option blinding_digest_option)) Ty.Unit
     blinding_entropy_value_type core
     (@jet_buffer_empty_spec.AC.unit (Ty.Prod Ty.Unit (Ty.Prod blinding_digest_option blinding_digest_option)) core))
  (@jet_buffer_empty_spec.AC.case Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Prod blinding_digest_option blinding_digest_option) blinding_entropy_result_type core
     (@jet_buffer_empty_spec.AC.drop Ty.Unit (Ty.Prod blinding_digest_option blinding_digest_option)
        blinding_entropy_result_type core (@blinding_entropy_body_spec core))
     (@jet_buffer_empty_spec.AC.injr
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Ty.Prod blinding_digest_option blinding_digest_option))
        Ty.Unit
        (Ty.Sum Ty.Unit
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core
        (@jet_buffer_empty_spec.AC.injr
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Ty.Prod blinding_digest_option blinding_digest_option)) Ty.Unit
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
           (@jet_buffer_empty_spec.AC.pair
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Ty.Prod blinding_digest_option blinding_digest_option)) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_buffer_empty_spec.AC.comp
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                    (Ty.Prod blinding_digest_option blinding_digest_option)) Ty.Unit
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_buffer_empty_spec.AC.unit
                    (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       (Ty.Prod blinding_digest_option blinding_digest_option)) core)
                 (@Word.zero (S (S (S (S (S (S (S (S O)))))))) core))
              (@jet_buffer_empty_spec.AC.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Ty.Prod blinding_digest_option blinding_digest_option) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 core (@jet_buffer_empty_spec.AC.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) core))))))
     : forall core : Alg.Core.Algebra,
       Alg.Core.domain core (Ty.Prod blinding_digest_option (Ty.Prod blinding_digest_option blinding_digest_option))
         blinding_entropy_result_type

Arguments blinding_entropy_route_spec {core}
### C.jet_elements_blinding_entropy_spec.elements_issuance_blinding_entropy_spec
elements_issuance_blinding_entropy_spec =
fun alg : jet_elements_words_hash_program.EFP.Algebra =>
let core : Alg.Core.Algebra :=
  Alg.Assertion.toCore (jet_elements_words_hash_program.EFP.CanonicalStructures.toAssertion alg) in
@jet_buffer_empty_spec.AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.Prod (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) blinding_entropy_result_type
  core
  (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.Prod (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) core
     (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
        jet_elements_prim.Elements.NewIssuanceContract)
     (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core
        (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
           jet_elements_prim.Elements.ReissuanceBlinding)
        (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
           jet_elements_prim.Elements.ReissuanceEntropy))) (@blinding_entropy_route_spec core)
     : forall alg : jet_elements_words_hash_program.EFP.Algebra,
       jet_elements_words_hash_program.EFP.domain alg (Word.Word (S (S (S (S (S O)))))) blinding_entropy_result_type

Arguments elements_issuance_blinding_entropy_spec {alg}
### C.jet_elements_blinding_entropy_spec.elements_blinding_entropy_of_input
elements_blinding_entropy_of_input =
fun txi : jet_elements_prim.sigTxInput =>
match jet_elements_prim.sigTxiIssuance txi return (Ty.tySem blinding_entropy_value_type) with
| Some i =>
    match i return (Ty.tySem blinding_entropy_value_type) with
    | inl new =>
        @inr unit
          (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
          (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) BinNums.Z0)
             (Word.from_hash256 (jet_elements_prim.newIssuanceContractHash new)))
    | inr re =>
        @inr unit
          (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
          (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Word.from_hash256 (jet_elements_prim.reissuanceBlindingNonce re))
             (Word.from_hash256 (jet_elements_prim.reissuanceEntropy re)))
    end
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
end
     : forall _ : jet_elements_prim.sigTxInput, Ty.tySem blinding_entropy_value_type

Arguments elements_blinding_entropy_of_input txi
### C.jet_elements_blinding_entropy_spec.elements_blinding_entropies
elements_blinding_entropies =
fun e : jet_elements_prim.Elements.env =>
@List.map jet_elements_prim.sigTxInput (Ty.tySem blinding_entropy_value_type) elements_blinding_entropy_of_input
  (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
     : forall _ : jet_elements_prim.Elements.env, list (Ty.tySem blinding_entropy_value_type)

Arguments elements_blinding_entropies e
