### C.jet_add8_word.add8_values_denote_spec
add8_values_denote_spec
     : forall left right : Integers.Int64.int,
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S O))))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S O)))))
            match
              Integers.Int.ltu
                (Integers.Int.sub
                   (Integers.Int.repr
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                   (jet_add8.add8_u (jet_read8.read8_result right))) (jet_add8.add8_u (jet_read8.read8_result left))
              return (sum unit unit)
            with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (jet_spec.decode_word8
               (Integers.Int64.repr
                  (Integers.Int.unsigned
                     (jet_add8.add8_byte (jet_read8.read8_result left) (jet_read8.read8_result right))))))
         (@add8_spec Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))
               (jet_spec.decode_word8 left) (jet_spec.decode_word8 right)))
### C.jet_add8_word.add8_spec
add8_spec =
fun term : Alg.Core.Algebra => @Word.adder (S (S (S O))) term
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))

Arguments add8_spec {term}
### C.jet_add8_word.decode_carry_word8
decode_carry_word8 =
fun w : Integers.Int64.int =>
@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S O)))))
  match
    Integers.Int64.testbit w (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) return (sum unit unit)
  with
  | true => @inr unit unit tt
  | false => @inl unit unit tt
  end (jet_spec.decode_word8 w)
     : forall _ : Integers.Int64.int, Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))

Arguments decode_carry_word8 w
