### C.jet_secp_fe_inverse_loop.field_inv_trajectory_batch
field_inv_trajectory_batch
     : forall (value : BinNums.Z) (n : nat),
       @eq divstep.State
         (@fst divstep.State (list divstep.Step)
            (divstep.stepN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))
               (field_inv_trajectory value n)))
         (field_inv_trajectory value
            (Nat.add (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))) n))
### C.jet_secp_fe_inverse_loop.field_inv_trajectory_zero
