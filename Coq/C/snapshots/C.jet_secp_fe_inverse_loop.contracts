     : forall (value : BinNums.Z) (n : nat) (_ : @eq BinNums.Z value BinNums.Z0),
       @eq BinNums.Z (divstep.g (field_inv_trajectory value n)) BinNums.Z0
### C.jet_secp_fe_inverse_loop.field_inv_loop_eta
field_inv_loop_eta
     : forall (value : BinNums.Z) (n : nat)
         (_ : and (BinInt.Z.le BinNums.Z0 value) (BinInt.Z.lt value jet_secp_fe_math.feP))
         (_ : or (@eq nat n O) (not (@eq BinNums.Z (divstep.g (field_inv_trajectory value n)) BinNums.Z0))),
       and
         (BinInt.Z.le
            (BinNums.Zneg
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xO
                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
            (divstep.eta (field_inv_trajectory value n)))
         (BinInt.Z.lt (divstep.eta (field_inv_trajectory value n))
            (BinNums.Zpos
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xO
                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_fe_inverse_loop.exec_field_inv_loop_fuel
exec_field_inv_loop_fuel
     : forall
         (_ : forall (m : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 m
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (fuel : nat) (value : BinNums.Z) (n : nat) (beta : jet_sx_state.layout) (e : Clight.env)
         (le0 : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (len : nat) (rho : forall _ : nat, Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 value) (BinInt.Z.lt value jet_secp_fe_math.feP))
         (_ : field_inv_loop_ready value n beta e le0 m len rho)
         (_ : @eq BinNums.Z
                (divstep.g
                   (field_inv_trajectory value
                      (Nat.add (Nat.mul (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))) fuel)
                         n))) BinNums.Z0),
       @ex nat
         (fun nf : nat =>
          @ex nat
            (fun lenf : nat =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun rhof : forall _ : nat, Integers.Int64.int =>
                @ex Clight.temp_env
                  (fun lef : Clight.temp_env =>
                   @ex Memory.Mem.mem
                     (fun mf : Memory.Mem.mem =>
                      and
                        (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 m
                           jet_secp_modinv_var_zero.inv_caller_loop Events.E0 lef mf ClightBigstep.Out_normal)
                        (and (le (Nat.add n (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))) nf)
                           (and (field_inv_loop_done value nf beta lef mf lenf rhof)
                              (and (field_inv_loop_temps le0 lef)
                                 (and (jet_sx_mem.lframe (jet_secp_fe_inverse_batch.field_inv_batch_frame beta) m mf)
                                    (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
### C.jet_secp_fe_inverse_loop.exec_field_inv_loop
