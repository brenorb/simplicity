  jets_secp.f_secp256k1_fe_set_b32
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
     (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx)))
  (@cons jet_sx_state.region fe_undef
     (@cons jet_sx_state.region
        (jet_sx_state.mkreg
           (byte_cells BinNums.Z0 (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))) O)
           false (@None BinNums.Z)) (@nil jet_sx_state.region))) (@nil jet_sx_eval.event)
