     : forall (bs : list BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bs)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
