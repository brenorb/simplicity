### C.jet_secp_fe_b32.byte_undef
byte_undef =
fix byte_undef (ofs : BinNums.Z) (n : nat) {struct n} : list jet_sx_state.cell :=
  match n return (list jet_sx_state.cell) with
  | O => @nil jet_sx_state.cell
  | S n0 =>
      @cons jet_sx_state.cell (jet_sx_state.mkcell ofs AST.Mint8unsigned (@None jet_sx_expr.sx))
        (byte_undef (BinInt.Z.add ofs (BinNums.Zpos BinNums.xH)) n0)
  end
     : forall (_ : BinNums.Z) (_ : nat), list jet_sx_state.cell

Arguments byte_undef ofs%Z_scope n%nat_scope
