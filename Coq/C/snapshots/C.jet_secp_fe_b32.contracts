### C.jet_secp_fe_b32.gb_math
gb_math
     : forall (W : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 W)
                (BinInt.Z.lt W
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq (list BinNums.Z)
         (jet_sx_zrep.zcells (fun n : nat => @List.nth BinNums.Z n (jet_secp_fe_math.fe_limbs_of W) BinNums.Z0)
            (jet_secp_fe_nv.cells0 gb_leaf)) (be_bytes W)
### C.jet_secp_fe_b32.byte_cells
byte_cells =
fix byte_cells (ofs : BinNums.Z) (n v : nat) {struct n} : list jet_sx_state.cell :=
  match n return (list jet_sx_state.cell) with
  | O => @nil jet_sx_state.cell
  | S n0 =>
      @cons jet_sx_state.cell
        (jet_sx_state.mkcell ofs AST.Mint8unsigned (@Some jet_sx_expr.sx (jet_sx_expr.XL2I (jet_sx_expr.XLv v))))
        (byte_cells (BinInt.Z.add ofs (BinNums.Zpos BinNums.xH)) n0 (S v))
  end
     : forall (_ : BinNums.Z) (_ : nat) (_ : nat), list jet_sx_state.cell

Arguments byte_cells ofs%Z_scope (n v)%nat_scope
### C.jet_secp_fe_b32.fe_undef
fe_undef =
jet_sx_state.mkreg
  (@cons jet_sx_state.cell (jet_sx_state.mkcell BinNums.Z0 AST.Mint64 (@None jet_sx_expr.sx))
     (@cons jet_sx_state.cell
        (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
           (@None jet_sx_expr.sx))
        (@cons jet_sx_state.cell
           (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              AST.Mint64 (@None jet_sx_expr.sx))
           (@cons jet_sx_state.cell
              (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))
                 AST.Mint64 (@None jet_sx_expr.sx))
              (@cons jet_sx_state.cell
                 (jet_sx_state.mkcell
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                    AST.Mint64 (@None jet_sx_expr.sx)) (@nil jet_sx_state.cell)))))) true (@None BinNums.Z)
     : jet_sx_state.region
