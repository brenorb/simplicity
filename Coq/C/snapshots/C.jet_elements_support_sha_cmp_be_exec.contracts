                     Ctypesdefs.tint))))
### C.jet_elements_support_sha_cmp_be_exec.eval_sha256_cmp_be
eval_sha256_cmp_be
     : forall (m : Memory.Mem.mem) (ba bb : Values.block) (oa ob : Integers.Ptrofs.int)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (xs ys : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int xs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq nat (@length Integers.Int.int ys) (S (S (S (S (S (S (S (S O)))))))))
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j xs Integers.Int.zero))))
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bb
                   (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j ys Integers.Int.zero)))),
       ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
         (@Ctypes.Internal Clight.function jets_elements.f_sha256_cmp_be)
         (@cons Values.val (Values.Vptr ba oa) (@cons Values.val (Values.Vptr bb ob) (@nil Values.val))) Events.E0 m
         (Values.Vint (cmp_model xs ys))
### C.jet_elements_support_sha_cmp_be_exec.cmp_elem
cmp_elem =
fun (p : AST.ident) (i : BinNums.Z) =>
Clight.Ederef
  (Clight.Ebinop Cop.Oadd
     (Clight.Efield
        (Clight.Ederef
           (Clight.Etempvar p (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
           (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) jets_elements._s
        (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (Clight.Econst_int (Integers.Int.repr i) Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tuint)) Ctypesdefs.tuint
     : forall (_ : AST.ident) (_ : BinNums.Z), Clight.expr

Arguments cmp_elem p i%Z_scope
### C.jet_elements_support_sha_cmp_be_exec.cmp_blk
cmp_blk =
fun (i : BinNums.Z) (ta tb tc td tr : AST.ident) =>
Clight.Ssequence (Clight.Sset ta (cmp_elem jets_elements._a i))
  (Clight.Ssequence (Clight.Sset tb (cmp_elem jets_elements._b i))
     (Clight.Sifthenelse
        (Clight.Ebinop Cop.One (Clight.Etempvar ta Ctypesdefs.tuint) (Clight.Etempvar tb Ctypesdefs.tuint)
           Ctypesdefs.tint)
        (Clight.Ssequence
           (Clight.Ssequence (Clight.Sset tc (cmp_elem jets_elements._a i))
              (Clight.Ssequence (Clight.Sset td (cmp_elem jets_elements._b i))
                 (Clight.Sifthenelse
                    (Clight.Ebinop Cop.Olt (Clight.Etempvar tc Ctypesdefs.tuint) (Clight.Etempvar td Ctypesdefs.tuint)
                       Ctypesdefs.tint)
                    (Clight.Sset tr
                       (Clight.Ecast
                          (Clight.Eunop Cop.Oneg
                             (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
                             Ctypesdefs.tint) Ctypesdefs.tint))
                    (Clight.Sset tr
                       (Clight.Ecast (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
                          Ctypesdefs.tint)))))
           (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar tr Ctypesdefs.tint)))) Clight.Sskip))
     : forall (_ : BinNums.Z) (_ : AST.ident) (_ : AST.ident) (_ : AST.ident) (_ : AST.ident) (_ : AST.ident),
       Clight.statement

Arguments cmp_blk i%Z_scope ta tb tc td tr
### C.jet_elements_support_sha_cmp_be_exec.cmp_body
cmp_body =
Clight.Ssequence
  (cmp_blk BinNums.Z0 jets_elements._t'37 jets_elements._t'38 jets_elements._t'39 jets_elements._t'40
     jets_elements._t'1)
  (Clight.Ssequence
     (cmp_blk (BinNums.Zpos BinNums.xH) jets_elements._t'33 jets_elements._t'34 jets_elements._t'35 jets_elements._t'36
        jets_elements._t'2)
     (Clight.Ssequence
        (cmp_blk (BinNums.Zpos (BinNums.xO BinNums.xH)) jets_elements._t'29 jets_elements._t'30 jets_elements._t'31
           jets_elements._t'32 jets_elements._t'3)
        (Clight.Ssequence
           (cmp_blk (BinNums.Zpos (BinNums.xI BinNums.xH)) jets_elements._t'25 jets_elements._t'26 jets_elements._t'27
              jets_elements._t'28 jets_elements._t'4)
           (Clight.Ssequence
              (cmp_blk (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) jets_elements._t'21 jets_elements._t'22
                 jets_elements._t'23 jets_elements._t'24 jets_elements._t'5)
              (Clight.Ssequence
                 (cmp_blk (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))) jets_elements._t'17 jets_elements._t'18
                    jets_elements._t'19 jets_elements._t'20 jets_elements._t'6)
                 (Clight.Ssequence
                    (cmp_blk (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))) jets_elements._t'13
                       jets_elements._t'14 jets_elements._t'15 jets_elements._t'16 jets_elements._t'7)
                    (Clight.Ssequence
                       (cmp_blk (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))) jets_elements._t'9
                          jets_elements._t'10 jets_elements._t'11 jets_elements._t'12 jets_elements._t'8)
                       (Clight.Sreturn
                          (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint))))))))))
     : Clight.statement
### C.jet_elements_support_sha_cmp_be_exec.cmp_res
cmp_res =
fun x y : Integers.Int.int =>
match Integers.Int.ltu x y return Integers.Int.int with
| true => Integers.Int.neg (Integers.Int.repr (BinNums.Zpos BinNums.xH))
| false => Integers.Int.repr (BinNums.Zpos BinNums.xH)
end
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments cmp_res x y
### C.jet_elements_support_sha_cmp_be_exec.cmp_model
cmp_model =
fix cmp_model (xs ys : list Integers.Int.int) {struct xs} : Integers.Int.int :=
  match xs return Integers.Int.int with
  | nil => Integers.Int.zero
  | cons x xs' =>
      match ys return Integers.Int.int with
      | nil => Integers.Int.zero
      | cons y ys' =>
          match Integers.Int.eq x y return Integers.Int.int with
          | true => cmp_model xs' ys'
          | false => cmp_res x y
          end
      end
  end
     : forall (_ : list Integers.Int.int) (_ : list Integers.Int.int), Integers.Int.int

Arguments cmp_model (xs ys)%list_scope
### C.jet_elements_support_sha_cmp_be_exec.cmp_good
cmp_good =
fun (ba bb : Values.block) (oa ob : Integers.Ptrofs.int) (le : Clight.temp_env) =>
and (@eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._a le) (@Some Values.val (Values.Vptr ba oa)))
  (@eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._b le) (@Some Values.val (Values.Vptr bb ob)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Ptrofs.int)
         (_ : Clight.temp_env), Prop

Arguments cmp_good ba bb oa ob le
