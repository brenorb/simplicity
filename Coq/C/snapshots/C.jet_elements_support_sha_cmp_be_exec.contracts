                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (e : Clight.env) (le : Clight.temp_env) (i : BinNums.Z)
         (ta tb tc td tr : AST.ident) (rest : Clight.statement) (x y : Integers.Int.int)
         (xs ys : list Integers.Int.int) (_ : cmp_good ba bb oa ob le) (_ : not (@eq AST.ident ta jets_elements._a))
         (_ : not (@eq AST.ident ta jets_elements._b)) (_ : not (@eq AST.ident tb jets_elements._a))
         (_ : not (@eq AST.ident tb jets_elements._b)) (_ : not (@eq AST.ident ta tb))
         (_ : not (@eq AST.ident tc jets_elements._a)) (_ : not (@eq AST.ident tc jets_elements._b))
         (_ : not (@eq AST.ident td jets_elements._a)) (_ : not (@eq AST.ident td jets_elements._b))
         (_ : not (@eq AST.ident tc td))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint x)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bb
                   (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint y)))
         (_ : forall (le' : Clight.temp_env) (_ : cmp_good ba bb oa ob le'),
              @ex Clight.temp_env
                (fun le'' : Clight.temp_env =>
                 ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le' m rest Events.E0 le'' m
                   (ClightBigstep.Out_return
                      (@Some (prod Values.val Ctypes.type)
                         (@pair Values.val Ctypes.type (Values.Vint (cmp_model xs ys)) Ctypesdefs.tint))))),
       @ex Clight.temp_env
