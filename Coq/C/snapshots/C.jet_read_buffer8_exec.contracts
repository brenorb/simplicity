### C.jet_read_buffer8_exec.buffer8_read_loop_shape
buffer8_read_loop_shape
     : @eq Clight.statement buffer8_read_loop
         (Clight.Sloop
            (Clight.Ssequence
               (Clight.Sifthenelse jet_write_buffer8_empty_exec.buffer8_guard_expr Clight.Sskip Clight.Sbreak)
               (Clight.Ssequence buffer8_read_tag
                  (Clight.Sifthenelse (Clight.Etempvar jets._t'2 Ctypesdefs.tbool) buffer8_read_present
                     buffer8_read_absent)))
            (Clight.Sset jets._i
               (Clight.Ebinop Cop.Odiv (Clight.Etempvar jets._i Ctypesdefs.tulong)
                  (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))) Ctypesdefs.tint)
                  Ctypesdefs.tulong)))
### C.jet_read_buffer8_exec.buffer8_read_forward_symbol
buffer8_read_forward_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._forwardBits)
         (@Some Values.block (jet_exec.jet_symbol_block jets._forwardBits))
### C.jet_read_buffer8_exec.buffer8_read_forward_funct
buffer8_read_forward_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._forwardBits) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_forwardBits))
### C.jet_read_buffer8_exec.buffer8_read_array_symbol
buffer8_read_array_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._read8s)
         (@Some Values.block (jet_exec.jet_symbol_block jets._read8s))
### C.jet_read_buffer8_exec.buffer8_read_array_funct
buffer8_read_array_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._read8s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_read8s))
### C.jet_read_buffer8_exec.call_buffer8_read_tag
call_buffer8_read_tag
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mr : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bit : bool)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._readBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_readBit)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mr
                (Values.Vint (jet_readBit_layout.bit_int bit))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m buffer8_read_tag Events.E0
         (@Maps.PTree.set Values.val jets._t'2 (Values.Vint (jet_readBit_layout.bit_int bit)) le) mr
         ClightBigstep.Out_normal
### C.jet_read_buffer8_exec.exec_buffer8_read_absent
exec_buffer8_read_absent
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bf : Values.block) (base j : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._forwardBits e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_forwardBits)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) j)))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m buffer8_read_absent Events.E0 le mf ClightBigstep.Out_normal
### C.jet_read_buffer8_exec.exec_buffer8_read_present
exec_buffer8_read_present
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mr mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bo : Values.block)
         (output : BinNums.Z) (bl : Values.block) (slot j count : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._read8s e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._buf le)
                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._len le)
                (@Some Values.val (Values.Vptr bl (Integers.Ptrofs.repr slot))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j)))) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le (BinInt.Z.add output j) Integers.Ptrofs.max_unsigned)
         (_ : and (BinInt.Z.le BinNums.Z0 slot) (BinInt.Z.le slot Integers.Ptrofs.max_unsigned))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : and (BinInt.Z.le BinNums.Z0 count) (BinInt.Z.le count Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_read8s)
                (@cons Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))
                   (@cons Values.val (Values.Vlong (Integers.Int64.repr j))
                      (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) Events.E0 mr
                Values.Vundef)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 mr bl slot)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr count))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mr bl slot (Values.Vlong (Integers.Int64.repr (BinInt.Z.add count j))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m buffer8_read_present Events.E0
         (buffer8_read_present_temps le bo (BinInt.Z.add output j) count) mf ClightBigstep.Out_normal
### C.jet_read_buffer8_exec.exec_buffer8_read_body
exec_buffer8_read_body
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mr mf : Memory.Mem.mem) (lef : Clight.temp_env) (bf : Values.block) (base j : BinNums.Z)
         (bit : bool)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._readBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.lt BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_readBit)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mr
                (Values.Vint (jet_readBit_layout.bit_int bit)))
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e
                (@Maps.PTree.set Values.val jets._t'2 (Values.Vint (jet_readBit_layout.bit_int bit)) le) mr
                match bit return Clight.statement with
                | true => buffer8_read_present
                | false => buffer8_read_absent
                end Events.E0 lef mf ClightBigstep.Out_normal),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m buffer8_read_body Events.E0 lef mf ClightBigstep.Out_normal
### C.jet_read_buffer8_exec.exec_buffer8_read_halve
exec_buffer8_read_halve
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m buffer8_read_update Events.E0
         (@Maps.PTree.set Values.val jets._i
            (Values.Vlong (Integers.Int64.repr (BinInt.Z.div j (BinNums.Zpos (BinNums.xO BinNums.xH))))) le) m
         ClightBigstep.Out_normal
### C.jet_read_buffer8_exec.exec_buffer8_read_stop
exec_buffer8_read_stop
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m buffer8_read_loop Events.E0 le m ClightBigstep.Out_normal
### C.jet_read_buffer8_exec.buffer8_read_loop
buffer8_read_loop =
match Clight.fn_body jets.f_simplicity_read_buffer8 return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ loop => loop
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_read_buffer8_exec.buffer8_read_body
buffer8_read_body =
match buffer8_read_loop return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop body _ => body
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_read_buffer8_exec.buffer8_read_update
buffer8_read_update =
match buffer8_read_loop return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ update => update
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_read_buffer8_exec.buffer8_read_present
buffer8_read_present =
match buffer8_read_body return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ _ => Clight.Sskip
        | Clight.Sifthenelse _ yes _ => yes
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_read_buffer8_exec.buffer8_read_absent
buffer8_read_absent =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets._forwardBits
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._src (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
     (@cons Clight.expr jet_write_buffer8_empty_exec.buffer8_skip_expr (@nil Clight.expr)))
     : Clight.statement
### C.jet_read_buffer8_exec.buffer8_read_tag
buffer8_read_tag =
Clight.Scall (@Some AST.ident jets._t'2)
  (Clight.Evar jets._readBit
     (Ctypes.Tfunction (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)) Ctypes.Tnil)
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._src (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
     (@nil Clight.expr))
     : Clight.statement
### C.jet_read_buffer8_exec.buffer8_read_present_temps
buffer8_read_present_temps =
fun (le : Maps.PTree.tree Values.val) (bo : Values.block) (output count : BinNums.Z) =>
@Maps.PTree.set Values.val jets._t'3 (Values.Vlong (Integers.Int64.repr count))
  (@Maps.PTree.set Values.val jets._buf (Values.Vptr bo (Integers.Ptrofs.repr output)) le)
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z),
       Maps.PTree.tree Values.val

Arguments buffer8_read_present_temps le bo (output count)%Z_scope
