     : jet_sx_expr.sx
### C.jet_secp_square_schedule.masked
masked =
fun s : prod jet_sx_expr.sx jet_sx_expr.sx =>
jet_sx_expr.XLb jet_sx_expr.Band (@fst jet_sx_expr.sx jet_sx_expr.sx s) mask
     : forall _ : prod jet_sx_expr.sx jet_sx_expr.sx, jet_sx_expr.sx

