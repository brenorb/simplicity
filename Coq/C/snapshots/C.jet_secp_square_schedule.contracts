                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
     : jet_sx_expr.sx
### C.jet_secp_square_schedule.red
red =
jet_sx_expr.XLc
  (Integers.Int64.repr
     (BinNums.Zpos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xI
