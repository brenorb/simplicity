### C.jet_secp_field_add_int.add_int_run
add_int_run
     : forall c : Integers.Int.int,
       @eq (option jet_sx_exec.res)
         (jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
            (jet_sx_pure.int_table jet_secp_fns.secp_pure)
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))
            jets_secp.f_secp256k1_fe_add_int (add_int_args c) add_int_regs (@nil jet_sx_eval.event)
            (S (S (S (S (S O)))))) (@Some jet_sx_exec.res (jet_sx_exec.RDone (add_int_state c) jet_sx_exec.ONormal))
### C.jet_secp_field_add_int.add_int_return
add_int_return
     : forall c : Integers.Int.int,
       @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps (add_int_state c)))
         (@None jet_sx_expr.sx)
### C.jet_secp_field_add_int.add_int_output
add_int_output
     : forall c : Integers.Int.int,
       @eq (list jet_sx_state.region) (jet_sx_eval.sregs (add_int_state c))
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (add_int_out c)) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@nil jet_sx_state.region))
### C.jet_secp_field_add_int.add_int_output_den
add_int_output_den
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den w (jet_sx_state.lay beta)) (add_int_out c))
         (@List.map Integers.Int64.int Values.val Values.Vlong
            (jet_secp_multiply_normalize_bridge.words5 (add_int_words c w)))
### C.jet_secp_field_add_int.eval_field_add_int_symbolic
eval_field_add_int_symbolic
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout)
         (m : Memory.Mem.mem) (_ : jet_sx_state.rep w layout add_int_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add_int)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val (Values.Vint c) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_sx_state.rep w layout
                  (@cons jet_sx_state.region
                     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (add_int_out c)) true
                        (@Some BinNums.Z
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@nil jet_sx_state.region)) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape add_int_regs) b pos)) m mf)))
### C.jet_secp_field_add_int.add_int_initial
add_int_initial
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep w
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@nil (prod Values.block BinNums.Z))) add_int_regs m
### C.jet_secp_field_add_int.add_int_result
add_int_result
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout)
         (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep w layout
                (@cons jet_sx_state.region
                   (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (add_int_out c)) true
                      (@Some BinNums.Z
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                   (@nil jet_sx_state.region)) m),
       and
         (jet_secp_fe_nv.fe_at m (jet_sx_state.blk layout O) (jet_sx_state.bas layout O)
            (jet_secp_multiply_normalize_bridge.words5 (add_int_words c w)))
         (Memory.Mem.range_perm m (jet_sx_state.blk layout O) BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
### C.jet_secp_field_add_int.add_int_unsigned_zero
add_int_unsigned_zero
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add (Integers.Int64.unsigned (w O)) (Integers.Int.signed c)))
                (BinInt.Z.le (BinInt.Z.add (Integers.Int64.unsigned (w O)) (Integers.Int.signed c))
                   Integers.Int64.max_unsigned)),
       @eq BinNums.Z (Integers.Int64.unsigned (add_int_words c w O))
         (BinInt.Z.add (Integers.Int64.unsigned (w O)) (Integers.Int.signed c))
### C.jet_secp_field_add_int.add_int_radix
add_int_radix
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add (Integers.Int64.unsigned (w O)) (Integers.Int.signed c)))
                (BinInt.Z.le (BinInt.Z.add (Integers.Int64.unsigned (w O)) (Integers.Int.signed c))
                   Integers.Int64.max_unsigned)),
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (add_int_words c w))
         (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value w) (Integers.Int.signed c))
### C.jet_secp_field_add_int.add_int_bounds
add_int_bounds
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.signed c))
                (BinInt.Z.le (Integers.Int.signed c) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : jet_secp_field_mul_small.mul_small_input_bounds w),
       jet_secp_square_columns.square_input_bounds (add_int_words c w)
### C.jet_secp_field_add_int.eval_field_add_int_from_storage
eval_field_add_int_from_storage
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem)
         (b : Values.block) (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add_int)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vint c) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (add_int_words c w)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf))))
### C.jet_secp_field_add_int.eval_field_add_int_small
eval_field_add_int_small
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem)
         (b : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.signed c))
                (BinInt.Z.le (Integers.Int.signed c) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : jet_secp_field_mul_small.mul_small_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add_int)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vint c) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (add_int_words c w)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (add_int_words c w))
                        (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value w) (Integers.Int.signed c)))
                     (and (jet_secp_square_columns.square_input_bounds (add_int_words c w))
                        (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m
                           mf))))))
### C.jet_secp_field_add_int.add_int_regs
add_int_regs = jet_secp_field_mul_small.mul_small_regs
     : list jet_sx_state.region
### C.jet_secp_field_add_int.add_int_args
add_int_args =
fun c : Integers.Int.int =>
@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0) (@cons jet_sx_expr.sx (jet_sx_expr.XI c) (@nil jet_sx_expr.sx))
     : forall _ : Integers.Int.int, list jet_sx_expr.sx

Arguments add_int_args c
### C.jet_secp_field_add_int.add_int_state
add_int_state =
fun c : Integers.Int.int =>
match
  jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
    (jet_sx_pure.int_table jet_secp_fns.secp_pure)
    (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))
    jets_secp.f_secp256k1_fe_add_int (add_int_args c) add_int_regs (@nil jet_sx_eval.event)
    (S (S (S (S (S O))))) return jet_sx_eval.sstate
with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : forall _ : Integers.Int.int, jet_sx_eval.sstate

Arguments add_int_state c
### C.jet_secp_field_add_int.add_int_out
add_int_out =
fun c : Integers.Int.int =>
@cons jet_sx_expr.sx
  (jet_sx_expr.XLb jet_sx_expr.Badd (jet_sx_expr.XLv O) (jet_sx_expr.XI2L Ctypes.Signed (jet_sx_expr.XI c)))
  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O))))
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O))))) (@nil jet_sx_expr.sx)))))
     : forall _ : Integers.Int.int, list jet_sx_expr.sx

Arguments add_int_out c
### C.jet_secp_field_add_int.add_int_words
add_int_words =
fun (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (i : nat) =>
match PeanoNat.Nat.eqb i O return Integers.Int64.int with
| true => Integers.Int64.add (w O) (Integers.Int64.repr (Integers.Int.signed c))
| false => w i
end
     : forall (_ : Integers.Int.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments add_int_words c w%function_scope i%nat_scope
