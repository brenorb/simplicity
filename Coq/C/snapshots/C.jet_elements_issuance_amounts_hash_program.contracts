     : forall
         (g : forall alg : jet_elements_words_hash_program.EFP.Algebra,
              jet_elements_words_hash_program.EFP.domain alg (Word.Word (S (S (S (S (S O))))))
                jet_elements_issuance_entropy_spec.issuance_digest_option)
         (pm : jet_elements_prim.Elements.t (Word.Word (S (S (S (S (S O))))))
                 jet_elements_issuance_entropy_spec.issuance_amount_option)
         (_ : @jet_elements_words_hash_program.EFP.Parametric (Word.Word (S (S (S (S (S O))))))
                jet_elements_issuance_entropy_spec.issuance_digest_option g),
