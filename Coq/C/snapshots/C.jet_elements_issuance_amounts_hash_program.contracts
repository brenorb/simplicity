### C.jet_elements_issuance_amounts_hash_program.elements_issuance_pair_spec_sem
elements_issuance_pair_spec_sem
     : forall
         (g : forall alg : jet_elements_words_hash_program.EFP.Algebra,
              jet_elements_words_hash_program.EFP.domain alg (Word.Word (S (S (S (S (S O))))))
                jet_elements_issuance_entropy_spec.issuance_digest_option)
         (pm : jet_elements_prim.Elements.t (Word.Word (S (S (S (S (S O))))))
                 jet_elements_issuance_entropy_spec.issuance_amount_option)
         (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)))
         (@elements_issuance_pair_spec g pm
            (jet_elements_words_hash_program.EFP.Theory.PrimitivePrimSem Option.option_Monad_Zero) i e)
         match
           g (jet_elements_words_hash_program.EFP.Theory.PrimitivePrimSem Option.option_Monad_Zero) i e
           return
             (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                (Ty.tySem (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)))
         with
         | Some h =>
             match
               @jet_elements_prim.Elements.sem (Word.Word (S (S (S (S (S O))))))
                 jet_elements_issuance_entropy_spec.issuance_amount_option pm i e
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                    (Ty.tySem (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)))
             with
             | Some a =>
                 @Some
                   (Ty.tySem (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type))
                   (@issuance_pair_route Alg.CoreFunSem
                      (@pair (Ty.tySem jet_elements_issuance_entropy_spec.issuance_digest_option)
                         (Ty.tySem jet_elements_issuance_entropy_spec.issuance_amount_option) h a))
             | None =>
                 @None
                   (Ty.tySem (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type))
             end
         | None =>
             @None (Ty.tySem (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type))
         end
