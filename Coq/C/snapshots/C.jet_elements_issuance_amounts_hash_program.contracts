         (@elements_issuance_pair_spec (@jet_elements_issuance_entropy_spec.elements_issuance_asset_spec)
            jet_elements_prim.Elements.IssuanceAssetAmount
            (jet_elements_words_hash_program.EFP.Theory.PrimitivePrimSem Option.option_Monad_Zero) i e)
         (@Some (sum unit (Ty.tySem jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type))
            match
              @List.nth_error (Ty.tySem jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)
                (elements_issuance_asset_pairs e) (BinInt.Z.to_nat (jet_forWhile_seq.wz (S (S (S (S (S O))))) i))
              return (sum unit (Ty.tySem jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type))
            with
            | Some x => @inr unit (Ty.tySem jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type) x
            | None => @inl unit (Ty.tySem jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type) tt
            end)
