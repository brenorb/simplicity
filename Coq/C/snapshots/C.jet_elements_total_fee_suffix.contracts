                (@Some Values.val tableval))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bt
                   (BinInt.Z.add txbase
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xI
                                     (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val
                   (Values.Vlong
                      (Integers.Int64.repr (BinInt.Z.of_nat (@length jet_elements_fee_lookup_table.fee_entry entries))))))
         (_ : not (@eq Values.val tableval Values.Vundef))
         (_ : jet_elements_fee_lookup_table.fee_lookup_storage m (Values.Vptr ba Integers.Ptrofs.zero) tableval key
                entries) (_ : jet_elements_fee_lookup_sorted.fee_lookup_sorted entries)
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cursor
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
