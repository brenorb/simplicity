### C.jet_secp_taptweak_function.taptweak_input_valid
taptweak_input_valid
     : forall (m : Memory.Mem.mem) (bin : Values.block) (edge rc : BinNums.Z)
         (pk h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_encoding.frame_input_cells_at m bin edge rc
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk h))), Memory.Mem.valid_block m bin
### C.jet_secp_taptweak_function.taptweak_output_bit_preserved
taptweak_output_bit_preserved
     : forall (m mf : Memory.Mem.mem) (bw : Values.block) (edge q : BinNums.Z) (bit : bool)
         (_ : forall (ofs : BinNums.Z) (w : Integers.Int64.int)
                (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw ofs) (@Some Values.val (Values.Vlong w))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bw ofs) (@Some Values.val (Values.Vlong w)))
         (_ : jet_encoding.frame_output_bit_at m bw edge q bit), jet_encoding.frame_output_bit_at mf bw edge q bit
### C.jet_secp_taptweak_function.eval_generic_taptweak
eval_generic_taptweak
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_memset_model.memset_model) (_ : jet_ctz_model.ctz_model)
         (pk h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bd : Values.block) (base : BinNums.Z) (bf bin bw : Values.block) (edge outedge rc cursor : BinNums.Z)
         (_ : jet_secp_taptweak_writer_state.taptweak_ready m)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bf bin)) (_ : not (@eq Values.block bf bd))
         (_ : not (@eq Values.block bf bw)) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bf BinNums.Z0 bin edge rc)
         (_ : jet_encoding.frame_input_cells_at m bin edge rc
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk h)))
         (_ : jet_output_layout.write_frame_at m bd base bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_generic_taptweak)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bf Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr jet_secp_taptweak_tag.taptweak_tag_block Integers.Ptrofs.zero)
                        (@cons Values.val
                           (Values.Vlong
                              (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (@nil Values.val))))) Events.E0 mf
               (Values.Vint
                  (jet_readBit_layout.bit_int
                     (jet_secp_taptweak_parsed_native.taptweak_result (jet_secp_taptweak_hash.taptweak_hash_word pk h)
                        pk))))
            (and
               match
                 jet_secp_taptweak_finish.taptweak_output (jet_secp_taptweak_hash.taptweak_hash_word pk h) pk
                 return Prop
               with
               | Some value =>
                   and
                     (jet_encoding.frame_output_cells_at mf bw outedge cursor
                        (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) value))
                     (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                        (jet_frame_layout.frame_fields_at mf bd base bw outedge
                           (BinInt.Z.sub cursor
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
               | None => True
               end
               (and
                  (Memory.Mem.range_perm mf bf BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                     Memtype.Freeable)
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b) (_ : not (@eq Values.block b bf))
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and (jet_clight_forward.mem_forward m mf) (jet_secp_taptweak_writer_state.taptweak_ready mf))))))
