            (@eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) payload)
               (BinInt.Z.add
                  (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) x)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) y))
                  (BinInt.Z.mul
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                     (@Word.ToZ.Theory.toZ Word.BitToZ
                        (@Word.leftmost (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))) Alg.CoreFunSem y))))))
