### C.jet_secp_wnaf_literal_state.literal_wnaf_sub128_positive
literal_wnaf_sub128_positive
     : forall (x y : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S O))))))))))
         (_ : and
                (BinInt.Z.le BinNums.Z0
                   (BinInt.Z.add
                      (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) x)
                         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) y))
                      (BinInt.Z.mul
                         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                            (BinNums.Zpos
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                         (@Word.ToZ.Theory.toZ Word.BitToZ
                            (@Word.leftmost (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))) Alg.CoreFunSem y)))))
                (BinInt.Z.lt
                   (BinInt.Z.add
                      (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) x)
                         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) y))
                      (BinInt.Z.mul
                         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                            (BinNums.Zpos
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                         (@Word.ToZ.Theory.toZ Word.BitToZ
                            (@Word.leftmost (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))) Alg.CoreFunSem y))))
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
