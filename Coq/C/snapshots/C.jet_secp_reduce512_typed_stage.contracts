### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_source
reduce512_typed_stage_source
     : @eq Clight.statement
         (jet_secp_statement_prefix.statement_sequence jet_secp_reduce512_first_run.reduce512_first_spine
            reduce512_typed_stage) jet_secp_reduce512_second_run.reduce512_second_prefix
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_completes
reduce512_typed_stage_completes
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int),
       @eq bool
         match reduce512_typed_stage_run digits m6 return bool with
         | Some r =>
             match r return bool with
             | jet_sx_exec.RDone _ o =>
                 match o return bool with
                 | jet_sx_exec.ONormal => true
                 | jet_sx_exec.OBreak => false
                 | jet_sx_exec.OContinue => false
                 | jet_sx_exec.OReturn _ => false
                 end
             | jet_sx_exec.RIf _ _ _ => false
             end
         | None => false
         end true
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_run_eq
reduce512_typed_stage_run_eq
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int),
       @eq (option jet_sx_exec.res) (reduce512_typed_stage_run digits m6)
         (@Some jet_sx_exec.res (jet_sx_exec.RDone (reduce512_typed_stage_state digits m6) jet_sx_exec.ONormal))
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_log
reduce512_typed_stage_log
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int),
       @eq (list jet_sx_eval.event) (jet_sx_eval.slog (reduce512_typed_stage_state digits m6)) (@nil jet_sx_eval.event)
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_limb_kinds
reduce512_typed_stage_limb_kinds
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int),
       @eq bool (@List.forallb jet_sx_expr.sx (jet_sx_expr.isk jet_sx_expr.KL) (reduce512_typed_stage_limbs digits m6))
         true
### C.jet_secp_reduce512_typed_stage.reduce512_allocated
reduce512_allocated =
match
  jet_sx_mem.xalloc (jet_sx_mem.std_cells (Clight.genv_cenv jet_secp_linkage.secp_ge))
    (Clight.genv_cenv jet_secp_linkage.secp_ge) (Clight.fn_vars jets_secp.f_secp256k1_scalar_reduce_512)
    (S (S O)) return (prod (list jet_sx_state.region) jet_sx_eval.venv)
with
| Some p => p
| None =>
    @pair (list jet_sx_state.region) (list (prod AST.ident (prod nat Ctypes.type))) (@nil jet_sx_state.region)
      (@nil (prod AST.ident (prod nat Ctypes.type)))
end
     : prod (list jet_sx_state.region) jet_sx_eval.venv
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_spine
reduce512_typed_stage_spine =
@List.firstn Clight.statement
  (Nat.sub jet_secp_reduce512_second_run.reduce512_second_count jet_secp_reduce512_first_run.reduce512_first_count)
  (@List.skipn Clight.statement jet_secp_reduce512_first_run.reduce512_first_count
     jet_secp_reduce512_first_run.reduce512_spine)
     : list Clight.statement
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage
reduce512_typed_stage =
jet_secp_statement_prefix.statement_sequence reduce512_typed_stage_spine Clight.Sskip
     : Clight.statement
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_temps
reduce512_typed_stage_temps =
fun (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int) =>
@Maps.PTree.set jet_sx_expr.sx jets_secp._m6 (jet_sx_expr.XI m6)
  (@Maps.PTree.set jet_sx_expr.sx jets_secp._m5 (jet_sx_expr.XL (digits (S (S (S (S (S O)))))))
     (@Maps.PTree.set jet_sx_expr.sx jets_secp._m4 (jet_sx_expr.XL (digits (S (S (S (S O))))))
        (@Maps.PTree.set jet_sx_expr.sx jets_secp._m3 (jet_sx_expr.XL (digits (S (S (S O)))))
           (@Maps.PTree.set jet_sx_expr.sx jets_secp._m2 (jet_sx_expr.XL (digits (S (S O))))
              (@Maps.PTree.set jet_sx_expr.sx jets_secp._m1 (jet_sx_expr.XL (digits (S O)))
                 (@Maps.PTree.set jet_sx_expr.sx jets_secp._m0 (jet_sx_expr.XL (digits O))
                    (@Maps.PTree.set jet_sx_expr.sx jets_secp._l (jet_sx_expr.XP (S O) BinNums.Z0)
                       (@Maps.PTree.set jet_sx_expr.sx jets_secp._r (jet_sx_expr.XP O BinNums.Z0)
                          (Maps.PTree.empty jet_sx_expr.sx)))))))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int.int), Maps.PTree.tree jet_sx_expr.sx

Arguments reduce512_typed_stage_temps digits%function_scope m6
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_initial
reduce512_typed_stage_initial =
fun (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int) =>
jet_sx_eval.mkst (reduce512_typed_stage_temps digits m6)
  (@app jet_sx_state.region jet_secp_scalar_reduce512_run.scalar_reduce512_initial_regs
     (@fst (list jet_sx_state.region) jet_sx_eval.venv reduce512_allocated)) (@nil jet_sx_eval.event)
  (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int.int), jet_sx_eval.sstate

Arguments reduce512_typed_stage_initial digits%function_scope m6
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_run
reduce512_typed_stage_run =
fun (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int) =>
jet_sx_compact.compact_stmt (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_shift64_executor.secp_shift64_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
  (@snd (list jet_sx_state.region) jet_sx_eval.venv reduce512_allocated) (reduce512_typed_stage_initial digits m6)
  reduce512_typed_stage
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int.int), option jet_sx_exec.res

Arguments reduce512_typed_stage_run digits%function_scope m6
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_state
reduce512_typed_stage_state =
fun (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int) =>
match reduce512_typed_stage_run digits m6 return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ => reduce512_typed_stage_initial digits m6
    end
| None => reduce512_typed_stage_initial digits m6
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int.int), jet_sx_eval.sstate

Arguments reduce512_typed_stage_state digits%function_scope m6
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_temp
reduce512_typed_stage_temp =
fun (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int) (id : BinNums.positive) =>
match
  @Maps.PTree.get jet_sx_expr.sx id (jet_sx_eval.stemps (reduce512_typed_stage_state digits m6)) return jet_sx_expr.sx
with
| Some x => x
| None => jet_sx_expr.XV Values.Vundef
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int.int) (_ : BinNums.positive), jet_sx_expr.sx

Arguments reduce512_typed_stage_temp digits%function_scope m6 id%positive_scope
### C.jet_secp_reduce512_typed_stage.reduce512_typed_stage_limbs
reduce512_typed_stage_limbs =
fun (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int) =>
@cons jet_sx_expr.sx (reduce512_typed_stage_temp digits m6 jets_secp._p0)
  (@cons jet_sx_expr.sx (reduce512_typed_stage_temp digits m6 jets_secp._p1)
     (@cons jet_sx_expr.sx (reduce512_typed_stage_temp digits m6 jets_secp._p2)
        (@cons jet_sx_expr.sx (reduce512_typed_stage_temp digits m6 jets_secp._p3)
           (@cons jet_sx_expr.sx
              (jet_sx_expr.XI2L Ctypes.Unsigned (reduce512_typed_stage_temp digits m6 jets_secp._p4))
              (@nil jet_sx_expr.sx)))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int.int), list jet_sx_expr.sx

Arguments reduce512_typed_stage_limbs digits%function_scope m6
