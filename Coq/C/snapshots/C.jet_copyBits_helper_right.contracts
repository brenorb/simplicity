### C.jet_copyBits_helper_right.copy_partial_right_shape
copy_partial_right_shape
     : @eq Clight.statement jet_copyBits_helper_exec.copy_partial_right
         (Clight.Ssequence copy_right_fill
            (Clight.Ssequence
               (Clight.Sifthenelse
                  (Clight.Ebinop Cop.Ole (Clight.Etempvar jets._n Ctypesdefs.tulong)
                     (Clight.Etempvar jets._dst_shift Ctypesdefs.tulong) Ctypesdefs.tint)
                  (Clight.Sreturn (@None Clight.expr)) Clight.Sskip) copy_right_after_return))
### C.jet_copyBits_helper_right.exec_copy_right_fill
exec_copy_right_fill
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bi : Values.block)
         (src_ofs : Integers.Ptrofs.int) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int)
         (ss ds : BinNums.Z) (old source : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ds)
                (BinInt.Z.le ds
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : and (BinInt.Z.le ds ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_ptr le)
                (@Some Values.val (Values.Vptr bi src_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le)
                (@Some Values.val (Values.Vptr bw dst_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bi (Integers.Ptrofs.unsigned src_ofs))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs))
                (@Some Values.val (Values.Vlong (jet_word_bits.clear_low ds old))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (copy_right_value ss ds old source))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m copy_right_fill Events.E0
         (copy_right_env le ss ds old source) mf ClightBigstep.Out_normal
### C.jet_copyBits_helper_right.exec_copy_tail_short_right
exec_copy_tail_short_right
     : forall (le : Maps.PTree.tree Values.val) (m mc mf : Memory.Mem.mem) (bi : Values.block)
         (src_ofs : Integers.Ptrofs.int) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int)
         (ss ds n : BinNums.Z) (old source : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ds)
                (BinInt.Z.le ds
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : and (BinInt.Z.le ds ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and (BinInt.Z.lt BinNums.Z0 n) (BinInt.Z.le n ds))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_ptr le)
                (@Some Values.val (Values.Vptr bi src_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le)
                (@Some Values.val (Values.Vptr bw dst_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr n))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs))
                (@Some Values.val (Values.Vlong old)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (jet_word_bits.clear_low ds old))) (@Some Memory.Mem.mem mc))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 mc bi (Integers.Ptrofs.unsigned src_ofs))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mc bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (copy_right_value ss ds old source))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m jet_copyBits_helper_exec.copy_helper_tail
         Events.E0 (copy_right_env (jet_copyBits_helper_exec.copy_clear_env le ds old) ss ds old source) mf
         (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type)))
### C.jet_copyBits_helper_right.eval_copy_helper_short_right
eval_copy_helper_short_right
     : forall (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (old source : Integers.Int64.int) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : jet_frame_layout.frame_base_valid base) (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : jet_frame_layout.frame_fields_at m bd base bw outedge cursor)
         (_ : and (BinInt.Z.le BinNums.Z0 rc) (BinInt.Z.le rc Integers.Int64.max_unsigned))
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) cursor) (BinInt.Z.le cursor Integers.Int64.max_unsigned))
         (_ : and
                (BinInt.Z.le
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                         (BinInt.Z.div rc
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                   edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned)) (_ : BinInt.Z.le BinNums.Z0 outedge)
         (_ : BinInt.Z.le (jet_write_layout.write_word_address outedge cursor) Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.lt BinNums.Z0
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (BinInt.Z.sub
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   (BinInt.Z.modulo rc
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : and (BinInt.Z.lt BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinInt.Z.modulo cursor
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : or (not (@eq Values.block bd bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) base)
                   (BinInt.Z.le
                      (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (jet_write_layout.write_word_address outedge cursor))))
         (_ : or (not (@eq Values.block bi bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add
                         (BinInt.Z.sub edge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                  (BinInt.Z.div rc
                                     (BinNums.Zpos
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (jet_write_layout.write_word_address outedge cursor))
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.sub edge
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                               (BinInt.Z.div rc
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                            (BinInt.Z.div rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address outedge cursor))
                (@Some Values.val (Values.Vlong old)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bw (jet_write_layout.write_word_address outedge cursor)
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_copyBitsHelper)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf bw (jet_write_layout.write_word_address outedge cursor))
                  (@Some Values.val
                     (Values.Vlong
                        (copy_right_value
                           (BinInt.Z.sub
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              (BinInt.Z.modulo rc
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                           (BinInt.Z.modulo cursor
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) old
                           source))))
               (and (jet_frame_layout.frame_fields_at mf bd base bw outedge cursor)
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (jet_write_layout.write_word_address outedge cursor))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
### C.jet_copyBits_helper_right.copy_right_fill
copy_right_fill =
Clight.Ssequence
  (Clight.Ssequence (Clight.Sset jets._t'9 (jet_copyBits_helper_exec.copy_word jets._src_ptr))
     (Clight.Scall (@Some AST.ident jets._t'3)
        (Clight.Evar jets._LSBkeep
           (Ctypes.Tfunction (Ctypes.Tcons Ctypesdefs.tulong (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil))
              Ctypesdefs.tulong AST.cc_default))
        (@cons Clight.expr
           (Clight.Ecast
              (Clight.Ebinop Cop.Oshr (Clight.Etempvar jets._t'9 Ctypesdefs.tulong)
                 (Clight.Ebinop Cop.Osub (Clight.Etempvar jets._src_shift Ctypesdefs.tulong)
                    (Clight.Etempvar jets._dst_shift Ctypesdefs.tulong) Ctypesdefs.tulong) Ctypesdefs.tulong)
              Ctypesdefs.tulong)
           (@cons Clight.expr (Clight.Etempvar jets._dst_shift Ctypesdefs.tulong) (@nil Clight.expr)))))
  (Clight.Ssequence (Clight.Sset jets._t'8 (jet_copyBits_helper_exec.copy_word jets._dst_ptr))
     (Clight.Sassign (jet_copyBits_helper_exec.copy_word jets._dst_ptr)
        (Clight.Ebinop Cop.Oor (Clight.Etempvar jets._t'8 Ctypesdefs.tulong)
           (Clight.Etempvar jets._t'3 Ctypesdefs.tulong) Ctypesdefs.tulong)))
     : Clight.statement
### C.jet_copyBits_helper_right.copy_right_after_return
copy_right_after_return =
match jet_copyBits_helper_exec.copy_partial_right return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ rest => rest
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_copyBits_helper_right.copy_right_payload
copy_right_payload =
fun (ss ds : BinNums.Z) (source : Integers.Int64.int) =>
Integers.Int64.zero_ext ds (Integers.Int64.shru source (Integers.Int64.repr (BinInt.Z.sub ss ds)))
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int), Integers.Int64.int

Arguments copy_right_payload (ss ds)%Z_scope source
### C.jet_copyBits_helper_right.copy_right_value
copy_right_value =
fun (ss ds : BinNums.Z) (old source : Integers.Int64.int) =>
Integers.Int64.or (jet_word_bits.clear_low ds old) (copy_right_payload ss ds source)
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments copy_right_value (ss ds)%Z_scope old source
### C.jet_copyBits_helper_right.copy_right_env
copy_right_env =
fun (le : Maps.PTree.tree Values.val) (ss ds : BinNums.Z) (old source : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._t'8 (Values.Vlong (jet_word_bits.clear_low ds old))
  (@Maps.PTree.set Values.val jets._t'3 (Values.Vlong (copy_right_payload ss ds source))
     (@Maps.PTree.set Values.val jets._t'9 (Values.Vlong source) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments copy_right_env le (ss ds)%Z_scope old source
