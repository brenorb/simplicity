fun (pa pb pu pv ps pt p12 p22 bh bi b2 b3 bt bx : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block bx pa))
  (and (not (@eq Values.block bx pb))
     (and (not (@eq Values.block bx pu))
        (and (not (@eq Values.block bx pv))
           (and (not (@eq Values.block bx ps))
              (and (not (@eq Values.block bx pt))
                 (and (not (@eq Values.block bx p12))
                    (and (not (@eq Values.block bx p22))
                       (and (not (@eq Values.block bx bh))
                          (and (not (@eq Values.block bx bi))
                             (and (not (@eq Values.block bx b2))
                                (and (not (@eq Values.block bx b3)) (not (@eq Values.block bx bt)))))))))))))
