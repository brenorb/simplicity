### C.jet_elements_taptweak_generator_globals.elements_taptweak_eval_generator_table_lookup
elements_taptweak_eval_generator_table_lookup
     : forall (high : bool) (n : BinNums.Z) (m : Memory.Mem.mem) (bout : Values.block)
         (_ : and (BinInt.Z.lt BinNums.Z0 (BinInt.Z.abs n))
                (BinInt.Z.lt (BinInt.Z.abs n)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))))
         (_ : elements_taptweak_generator_table_state high m)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult_table_get_ge_storage)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr (elements_taptweak_generator_table_block high) Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vint (Integers.Int.repr n))
                        (@cons Values.val
                           (Values.Vint
                              (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                           (@nil Values.val))))) Events.E0 mf Values.Vundef)
            (and
               (Memory.Mem.range_perm mf bout BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (forall k : bool,
                   jet_secp_fe_nv.fe_at mf bout
                     match k return BinNums.Z with
                     | true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                     | false => BinNums.Z0
                     end
                     (jet_secp_table_decode.table_signed_coordinate
                        (jet_secp_generator_globals.generator_entry_words high
                           (BinInt.Z.to_nat (jet_secp_table_index.table_storage_index n)))
                        (negb (BinInt.Z.ltb BinNums.Z0 n)) k))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bout
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and (elements_taptweak_generator_table_state high mf)
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (pos : BinNums.Z) =>
                            or (not (@eq Values.block b bout))
                              (or (BinInt.Z.lt pos BinNums.Z0)
                                 (BinInt.Z.le
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    pos))) m mf))))))
