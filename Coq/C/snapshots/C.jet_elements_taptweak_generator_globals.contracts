### C.jet_elements_taptweak_generator_globals.elements_taptweak_generator_table_rep
elements_taptweak_generator_table_rep =
fun (high : bool) (m : Memory.Mem.mem) =>
and (Memory.Mem.valid_block m (elements_taptweak_generator_table_block high))
  (and
     (Memory.Mem.range_perm m (elements_taptweak_generator_table_block high) BinNums.Z0
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))))))))
        Memtype.Cur Memtype.Readable)
     (forall (i : nat)
        (_ : BinInt.Z.lt (BinInt.Z.of_nat i)
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))))),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m (elements_taptweak_generator_table_block high)
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong (jet_secp_generator_globals.generator_table_word high i)))))
     : forall (_ : bool) (_ : Memory.Mem.mem), Prop

Arguments elements_taptweak_generator_table_rep high%bool_scope m
### C.jet_elements_taptweak_generator_globals.elements_taptweak_generator_table_state
elements_taptweak_generator_table_state =
fun (high : bool) (m : Memory.Mem.mem) =>
and (elements_taptweak_generator_table_rep high m)
  (jet_clight_readonly_frame.readonly_region_bounds m (elements_taptweak_generator_table_block high) BinNums.Z0
     (BinNums.Zpos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))))))))
     : forall (_ : bool) (_ : Memory.Mem.mem), Prop

