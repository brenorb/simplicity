### C.jet_secp_pubkey_save_function.pubkey_save_body_source
pubkey_save_body_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_pubkey_save)
         (Clight.Sifthenelse jet_secp_pubkey_load_body.pubkey_load_size_test
            (Clight.Ssequence pubkey_save_pack jet_secp_pubkey_save_copy.pubkey_save_copy_stmt) pubkey_save_other)
### C.jet_secp_pubkey_save_function.pubkey_save_blocks
pubkey_save_blocks
     : forall bs : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (pubkey_save_env bs))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bs BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
### C.jet_secp_pubkey_save_function.pubkey_save_entry_owned
pubkey_save_entry_owned
     : forall (m : Memory.Mem.mem) (key point : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bs : Values.block =>
             and
               (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_pubkey_save
                  (@cons Values.val key (@cons Values.val point (@nil Values.val))) m (pubkey_save_env bs)
                  (pubkey_save_temps key point) mi)
               (and (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), not (@eq Values.block b bs))
                  (and
                     (Memory.Mem.range_perm mi bs BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                        (and (jet_clight_internal_permissions.keeps_permissions m mi)
                           (jet_clight_internal_preserve.readonly_preserved m mi)))))))
### C.jet_secp_pubkey_save_function.eval_pubkey_save
eval_pubkey_save
     : forall (_ : jet_memcpy_model.memcpy_model) (wx wy : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bin bout : Values.block) (_ : jet_secp_square_columns.square_input_bounds wx)
         (_ : jet_secp_square_columns.square_input_bounds wy)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 wx))
         (_ : jet_secp_fe_nv.fe_at m bin
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 wy))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_pubkey_save)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_affine_storage.affine_storage_readable mf bout BinNums.Z0
                  (jet_secp_ge_storage_body.ge_storage_words wx wy))
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m mf)
                     (jet_clight_internal_preserve.readonly_preserved m mf)))))
### C.jet_secp_pubkey_save_function.xonly_pubkey_save_entry
xonly_pubkey_save_entry
     : forall (m : Memory.Mem.mem) (key point : Values.val),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_xonly_pubkey_save
         (@cons Values.val key (@cons Values.val point (@nil Values.val))) m Clight.empty_env
         (xonly_save_temps key point) m
### C.jet_secp_pubkey_save_function.eval_xonly_pubkey_save
eval_xonly_pubkey_save
     : forall (_ : jet_memcpy_model.memcpy_model) (wx wy : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bin bout : Values.block) (_ : jet_secp_square_columns.square_input_bounds wx)
         (_ : jet_secp_square_columns.square_input_bounds wy)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 wx))
         (_ : jet_secp_fe_nv.fe_at m bin
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 wy))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_xonly_pubkey_save)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_affine_storage.affine_storage_readable mf bout BinNums.Z0
                  (jet_secp_ge_storage_body.ge_storage_words wx wy))
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m mf)
                     (jet_clight_internal_preserve.readonly_preserved m mf)))))
