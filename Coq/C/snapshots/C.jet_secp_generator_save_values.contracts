### C.jet_secp_generator_save_values.generator_save_leaf
generator_save_leaf =
fun (flag : Integers.Int.int) (x y : bool) =>
let rx : jet_sx_exec.res :=
  match jet_secp_generator_save.generator_save_result flag return jet_sx_exec.res with
  | jet_sx_exec.RDone Σ o => jet_sx_exec.RDone Σ o
  | jet_sx_exec.RIf _ a b => match x return jet_sx_exec.res with
                             | true => a
                             | false => b
                             end
  end in
let ry : jet_sx_exec.res :=
  match rx return jet_sx_exec.res with
  | jet_sx_exec.RDone _ _ => rx
  | jet_sx_exec.RIf _ a b => match y return jet_sx_exec.res with
                             | true => a
                             | false => b
                             end
  end in
match ry return jet_sx_eval.sstate with
| jet_sx_exec.RDone st _ => st
| jet_sx_exec.RIf _ _ _ =>
    jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : forall (_ : Integers.Int.int) (_ : bool) (_ : bool), jet_sx_eval.sstate

Arguments generator_save_leaf flag (x y)%bool_scope
