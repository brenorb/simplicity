### C.jet_secp_generator_save_values.generator_save_byte_cells
generator_save_byte_cells =
fix generator_save_byte_cells (ofs : BinNums.Z) (bytes : list jet_sx_expr.sx) {struct bytes} :
    list jet_sx_state.cell :=
  match bytes return (list jet_sx_state.cell) with
  | nil => @nil jet_sx_state.cell
  | cons x xs =>
      @cons jet_sx_state.cell (jet_sx_state.mkcell ofs AST.Mint8unsigned (@Some jet_sx_expr.sx x))
        (generator_save_byte_cells (BinInt.Z.add ofs (BinNums.Zpos BinNums.xH)) xs)
  end
     : forall (_ : BinNums.Z) (_ : list jet_sx_expr.sx), list jet_sx_state.cell

