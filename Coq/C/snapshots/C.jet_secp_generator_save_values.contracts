generator_save_coord_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (offset : nat) =>
jet_secp_write_fe_wide_values.wide_fe_rho (rho offset) (rho (Nat.add (S O) offset)) (rho (Nat.add (S (S O)) offset))
  (rho (Nat.add (S (S (S O))) offset)) (rho (Nat.add (S (S (S (S O)))) offset)) BinNums.Z0
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat) (_ : nat), Integers.Int64.int

