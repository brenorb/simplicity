### C.jet_secp_generator_save_values.generator_save_output_regs
generator_save_output_regs =
fun (flag : Integers.Int.int) (x y : bool) =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (@app jet_sx_state.cell
        (jet_sx_rep.u64_cells BinNums.Z0
           (generator_save_normalized O
              match x return jet_sx_eval.sstate with
              | true => jet_secp_fe_nv.nv_a
              | false => jet_secp_fe_nv.nv_b
              end))
        (@app jet_sx_state.cell
           (jet_sx_rep.u64_cells
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
              (generator_save_normalized (S (S (S (S (S O)))))
                 match y return jet_sx_eval.sstate with
                 | true => jet_secp_fe_nv.nv_a
                 | false => jet_secp_fe_nv.nv_b
                 end))
           (@cons jet_sx_state.cell
              (jet_sx_state.mkcell
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                 AST.Mint32 (@Some jet_sx_expr.sx (jet_sx_expr.XI flag))) (@nil jet_sx_state.cell)))) true
     (@Some BinNums.Z
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (@app jet_sx_state.cell (generator_save_byte_cells BinNums.Z0 (generator_save_bytes O x))
           (generator_save_byte_cells
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
              (generator_save_bytes (S (S (S (S (S O))))) y))) true
        (@Some BinNums.Z
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     (@nil jet_sx_state.region))
     : forall (_ : Integers.Int.int) (_ : bool) (_ : bool), list jet_sx_state.region

