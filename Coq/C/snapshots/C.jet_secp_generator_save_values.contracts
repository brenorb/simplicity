### C.jet_secp_generator_save_values.generator_save_final_regs
generator_save_final_regs =
fun (flag : Integers.Int.int) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) =>
generator_save_output_regs flag (generator_save_choice rho beta O)
  (generator_save_choice rho beta (S (S (S (S (S O))))))
