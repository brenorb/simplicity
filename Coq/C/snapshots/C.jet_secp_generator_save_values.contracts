### C.jet_secp_generator_save_values.generator_save_value
generator_save_value =
fun (rho : forall _ : nat, Integers.Int64.int) (offset : nat) =>
BinInt.Z.modulo
  (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho offset))
     (Integers.Int64.unsigned (rho (Nat.add (S O) offset))) (Integers.Int64.unsigned (rho (Nat.add (S (S O)) offset)))
     (Integers.Int64.unsigned (rho (Nat.add (S (S (S O))) offset)))
     (Integers.Int64.unsigned (rho (Nat.add (S (S (S (S O)))) offset)))) jet_secp_fe_math.feP
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), BinNums.Z

Arguments generator_save_value rho%function_scope offset%nat_scope
