### C.jet_secp_split_arithmetic_calls.split_product_source
split_product_source
     : forall first : bool,
       @eq Clight.statement (split_product_statement first)
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_scalar_mul jets_secp.f_secp256k1_scalar_mul
            (@None AST.ident)
            (@cons Clight.expr (split_scalar_address (jet_secp_split_rounding_calls.split_local_id first))
               (@cons Clight.expr (split_scalar_address (jet_secp_split_rounding_calls.split_local_id first))
                  (@cons Clight.expr (split_scalar_address (jet_secp_split_constants.split_basis_id first))
                     (@nil Clight.expr)))))
### C.jet_secp_split_arithmetic_calls.split_second_source
split_second_source
     : @eq Clight.statement split_second_statement
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_scalar_add jets_secp.f_secp256k1_scalar_add
            (@None AST.ident)
            (@cons Clight.expr (split_scalar_parameter jets_secp._r2)
               (@cons Clight.expr (split_scalar_address jets_secp._c1)
                  (@cons Clight.expr (split_scalar_address jets_secp._c2) (@nil Clight.expr)))))
### C.jet_secp_split_arithmetic_calls.split_lambda_source
split_lambda_source
     : @eq Clight.statement split_lambda_statement
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_scalar_mul jets_secp.f_secp256k1_scalar_mul
            (@None AST.ident)
            (@cons Clight.expr (split_scalar_parameter jets_secp._r1)
               (@cons Clight.expr (split_scalar_parameter jets_secp._r2)
                  (@cons Clight.expr (split_scalar_address jets_secp._secp256k1_const_lambda) (@nil Clight.expr)))))
### C.jet_secp_split_arithmetic_calls.split_negate_source
split_negate_source
     : @eq Clight.statement split_negate_statement
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_scalar_negate jets_secp.f_secp256k1_scalar_negate
            (@None AST.ident)
            (@cons Clight.expr (split_scalar_parameter jets_secp._r1)
               (@cons Clight.expr (split_scalar_parameter jets_secp._r1) (@nil Clight.expr))))
### C.jet_secp_split_arithmetic_calls.split_last_source
split_last_source
     : @eq Clight.statement split_last_statement
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_scalar_add jets_secp.f_secp256k1_scalar_add
            (@None AST.ident)
            (@cons Clight.expr (split_scalar_parameter jets_secp._r1)
               (@cons Clight.expr (split_scalar_parameter jets_secp._r1)
                  (@cons Clight.expr (split_scalar_parameter jets_secp._k) (@nil Clight.expr)))))
### C.jet_secp_split_arithmetic_calls.split_arithmetic_source
split_arithmetic_source
     : @eq Clight.statement split_arithmetic_suffix
         (Clight.Ssequence (split_product_statement true)
            (Clight.Ssequence (split_product_statement false)
               (Clight.Ssequence split_second_statement
                  (Clight.Ssequence split_lambda_statement
                     (Clight.Ssequence split_negate_statement split_last_statement)))))
### C.jet_secp_split_arithmetic_calls.split_whole_source
split_whole_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_scalar_split_lambda)
         (jet_secp_statement_prefix.statement_sequence
            (@List.firstn Clight.statement (S (S (S (S (S O)))))
               (@fst (list Clight.statement) Clight.statement jet_secp_split_rounding_calls.split_parts))
            split_arithmetic_suffix)
### C.jet_secp_split_arithmetic_calls.exec_split_product
exec_split_product
     : forall (first : bool) (bc1 bc2 : Values.block) (le : Clight.temp_env) (m mf : Memory.Mem.mem)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
                (@cons Values.val
                   (Values.Vptr match first return Values.block with
                                | true => bc1
                                | false => bc2
                                end Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vptr match first return Values.block with
                                   | true => bc1
                                   | false => bc2
                                   end Integers.Ptrofs.zero)
                      (@cons Values.val
                         (Values.Vptr (jet_secp_split_constants.split_basis_block first) Integers.Ptrofs.zero)
                         (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_split_rounding_calls.split_local_env bc1 bc2)
         le m (split_product_statement first) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_split_arithmetic_calls.exec_split_second
exec_split_second
     : forall (bc1 bc2 : Values.block) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (br : Values.block) (ret : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r2 le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bc1 Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr bc2 Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                (Values.Vint ret)),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_split_rounding_calls.split_local_env bc1 bc2)
         le m split_second_statement Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_split_arithmetic_calls.exec_split_lambda
exec_split_lambda
     : forall (bc1 bc2 : Values.block) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
