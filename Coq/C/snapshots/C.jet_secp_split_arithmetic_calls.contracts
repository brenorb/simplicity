### C.jet_secp_split_arithmetic_calls.split_scalar_address
split_scalar_address =
fun id : AST.ident =>
Clight.Eaddrof (Clight.Evar id (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
     : forall _ : AST.ident, Clight.expr

Arguments split_scalar_address id
### C.jet_secp_split_arithmetic_calls.split_scalar_parameter
split_scalar_parameter =
fun id : AST.ident => Clight.Etempvar id (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
     : forall _ : AST.ident, Clight.expr

Arguments split_scalar_parameter id
### C.jet_secp_split_arithmetic_calls.split_product_statement
split_product_statement =
fun first : bool =>
@List.nth Clight.statement
  match first return nat with
  | true => S (S (S (S (S O))))
  | false => S (S (S (S (S (S O)))))
  end (@fst (list Clight.statement) Clight.statement jet_secp_split_rounding_calls.split_parts) Clight.Sskip
     : forall _ : bool, Clight.statement

Arguments split_product_statement first%bool_scope
### C.jet_secp_split_arithmetic_calls.split_second_statement
split_second_statement =
@List.nth Clight.statement (S (S (S (S (S (S (S O)))))))
  (@fst (list Clight.statement) Clight.statement jet_secp_split_rounding_calls.split_parts) Clight.Sskip
     : Clight.statement
### C.jet_secp_split_arithmetic_calls.split_lambda_statement
split_lambda_statement =
