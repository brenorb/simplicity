### C.jet_secp_split_arithmetic_calls.split_last_statement
split_last_statement =
@snd (list Clight.statement) Clight.statement jet_secp_split_rounding_calls.split_parts
     : Clight.statement
### C.jet_secp_split_arithmetic_calls.split_arithmetic_suffix
split_arithmetic_suffix =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement (S (S (S (S (S O)))))
     (@fst (list Clight.statement) Clight.statement jet_secp_split_rounding_calls.split_parts))
  (@snd (list Clight.statement) Clight.statement jet_secp_split_rounding_calls.split_parts)
     : Clight.statement
