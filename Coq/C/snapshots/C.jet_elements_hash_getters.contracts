        (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)) ptrfield
     (Ctypesdefs.tptr (Ctypes.Tstruct sid Ctypes.noattr)))
     : forall (_ : AST.ident) (_ : AST.ident), Clight.statement

