### C.jet_secp_table_affine_nonzero.table_walk_scale
table_walk_scale =
fix table_walk_scale (j : nat) (x : BinNums.Z) {struct j} : BinNums.Z :=
  match j return BinNums.Z with
  | O => BinNums.Zpos BinNums.xH
  | S previous =>
      let k : BinNums.Z := table_walk_scale previous x in
      BinInt.Z.mul (BinInt.Z.mul (BinInt.Z.mul k k) k)
        (jet_secp_polynomial.polynomial_value
           (jet_secp_table_coordinates.table_witness_f (Nat.add (Nat.mul (S (S O)) previous) (S O))) x)
  end
     : forall (_ : nat) (_ : BinNums.Z), BinNums.Z

Arguments table_walk_scale j%nat_scope x%Z_scope
