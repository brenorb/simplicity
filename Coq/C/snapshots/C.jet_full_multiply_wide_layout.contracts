### C.jet_full_multiply_wide_layout.wide_full_multiply_decode
wide_full_multiply_decode
     : forall (s : jet_multiply_wide_exec.multiply_wide_size)
         (x y z d : Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
         (r t u v : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))
                   x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))
                   y))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned u)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))
                   z))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned v)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))
                   d)),
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_output_size s))))
         (jet_wide_spec.decode_wide (jet_multiply_wide_exec.multiply_output_size s)
            (Integers.Int64.zero_ext (jet_wide.wide_bits (jet_multiply_wide_exec.multiply_output_size s))
               (jet_full_multiply_wide_exec.full_multiply_value r t u v)))
         (@jet_full_multiply_wide_exec.wide_full_multiply_spec s Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                  (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))))
               (prod (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                  (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))))
               (@pair (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                  (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))) x y)
               (@pair (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                  (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))) z d)))
### C.jet_full_multiply_wide_layout.eval_wide_full_multiply_layout_matches_spec
eval_wide_full_multiply_layout_matches_spec
     : forall (env : Values.val) (s : jet_multiply_wide_exec.multiply_wide_size) (m : Memory.Mem.mem)
         (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z)
         (x y z d : Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
         (cursor rc : BinNums.Z) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                         (jet_wide.wide_bits (jet_multiply_wide_exec.multiply_input_size s))))))
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))
                m bi edge rc x)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))
                m bi edge (BinInt.Z.add rc (jet_wide.wide_bits (jet_multiply_wide_exec.multiply_input_size s))) y)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))
                m bi edge
                (BinInt.Z.add rc
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (jet_wide.wide_bits (jet_multiply_wide_exec.multiply_input_size s)))) z)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))
                m bi edge
                (BinInt.Z.add rc
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH))
                      (jet_wide.wide_bits (jet_multiply_wide_exec.multiply_input_size s)))) d)
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
                (jet_wide.wide_bits (jet_multiply_wide_exec.multiply_output_size s))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function (jet_full_multiply_wide_exec.wide_full_multiply s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_output_size s)))
                     (@jet_full_multiply_wide_exec.wide_full_multiply_spec s Alg.CoreFunSem
                        (@pair
                           (prod
                              (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                              (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))))
                           (prod
                              (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                              (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))))
                           (@pair
                              (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                              (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                              x y)
                           (@pair
                              (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                              (Ty.tySem (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
                              z d)))))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (jet_wide.wide_bits (jet_multiply_wide_exec.multiply_output_size s))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (jet_wide.wide_bits (jet_multiply_wide_exec.multiply_output_size s)))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
