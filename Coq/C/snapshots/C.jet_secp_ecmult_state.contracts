### C.jet_secp_ecmult_state.ecmult_state_initialize_source
ecmult_state_initialize_source
     : @eq Clight.statement ecmult_state_initialize
         (Clight.Ssequence
            (ecmult_state_assignment jets_secp._aux (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
            (Clight.Ssequence
               (ecmult_state_assignment jets_secp._pre_a (Ctypes.Tstruct jets_secp.__6121 Ctypes.noattr)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
               (Clight.Ssequence
                  (ecmult_state_assignment jets_secp._ps
                     (Ctypes.Tstruct jets_secp._secp256k1_strauss_point_state Ctypes.noattr)
                     (BinNums.Zpos BinNums.xH)) Clight.Sskip)))
### C.jet_secp_ecmult_state.ecmult_state_layout
ecmult_state_layout
     : forall (id : AST.ident) (delta : BinNums.Z) (ty : Ctypes.type)
         (_ : @List.In (prod (prod AST.ident BinNums.Z) Ctypes.type)
                (@pair (prod AST.ident BinNums.Z) Ctypes.type (@pair AST.ident BinNums.Z id delta) ty)
                ecmult_state_slots),
       @ex Ctypes.composite
         (fun co : Ctypes.composite =>
          and
            (@eq (option Ctypes.composite)
               (@Maps.PTree.get Ctypes.composite jets_secp._secp256k1_strauss_state
                  (Clight.genv_cenv jet_secp_linkage.secp_ge)) (@Some Ctypes.composite co))
            (@eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
               (Ctypes.field_offset (Clight.genv_cenv jet_secp_linkage.secp_ge) id (Ctypes.co_members co))
               (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield delta Ctypes.Full))))
### C.jet_secp_ecmult_state.exec_ecmult_state_assignment
exec_ecmult_state_assignment
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mi : Memory.Mem.mem) (bs b : Values.block) (id : AST.ident) (delta : BinNums.Z)
         (ty : Ctypes.type) (n : BinNums.Z)
         (_ : @List.In (prod (prod AST.ident BinNums.Z) Ctypes.type)
                (@pair (prod AST.ident BinNums.Z) Ctypes.type (@pair AST.ident BinNums.Z id delta) ty)
                ecmult_state_slots)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._state e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs (Ctypes.Tstruct jets_secp._secp256k1_strauss_state Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type b (Ctypesdefs.tarray ty n))))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.store AST.Mptr m bs delta (Values.Vptr b Integers.Ptrofs.zero))
                (@Some Memory.Mem.mem mi)),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (ecmult_state_assignment id ty n) Events.E0 le
         mi ClightBigstep.Out_normal
### C.jet_secp_ecmult_state.ecmult_state_store_owned
ecmult_state_store_owned
     : forall (m : Memory.Mem.mem) (bs : Values.block) (delta : BinNums.Z) (b : Values.block)
         (_ : @List.In BinNums.Z delta
                (@cons BinNums.Z BinNums.Z0
                   (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                         (@nil BinNums.Z)))))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem) (Memory.Mem.store AST.Mptr m bs delta (Values.Vptr b Integers.Ptrofs.zero))
               (@Some Memory.Mem.mem mi))
            (and
               (Memory.Mem.range_perm mi bs BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) Memtype.Cur
                  Memtype.Freeable)
               (Memory.Mem.unchanged_on
                  (fun (block : Values.block) (pos : BinNums.Z) =>
                   or (not (@eq Values.block block bs))
                     (or (BinInt.Z.lt pos delta)
                        (BinInt.Z.le
                           (BinInt.Z.add delta (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) pos)))
                  m mi)))
### C.jet_secp_ecmult_state.exec_ecmult_state_initialize
exec_ecmult_state_initialize
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bs bx ba bp : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._state e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs (Ctypes.Tstruct jets_secp._secp256k1_strauss_state Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._aux e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx
                      (Ctypesdefs.tarray (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._pre_a e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba
                      (Ctypesdefs.tarray (Ctypes.Tstruct jets_secp.__6121 Ctypes.noattr)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ps e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp
                      (Ctypesdefs.tarray (Ctypes.Tstruct jets_secp._secp256k1_strauss_point_state Ctypes.noattr)
                         (BinNums.Zpos BinNums.xH)))))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m ecmult_state_initialize Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bs BinNums.Z0)
                  (@Some Values.val (Values.Vptr bx Integers.Ptrofs.zero)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mptr mf bs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mptr mf bs
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
                     (and
                        (Memory.Mem.range_perm mf bs BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) Memtype.Cur
                           Memtype.Freeable)
                        (Memory.Mem.unchanged_on
                           (fun (block : Values.block) (_ : BinNums.Z) => not (@eq Values.block block bs)) m mf))))))
### C.jet_secp_ecmult_state.ecmult_state_slots
ecmult_state_slots =
@cons (prod (prod AST.ident BinNums.Z) Ctypes.type)
  (@pair (prod AST.ident BinNums.Z) Ctypes.type (@pair AST.ident BinNums.Z jets_secp._aux BinNums.Z0)
     (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
  (@cons (prod (prod AST.ident BinNums.Z) Ctypes.type)
     (@pair (prod AST.ident BinNums.Z) Ctypes.type
        (@pair AST.ident BinNums.Z jets_secp._pre_a (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
        (Ctypes.Tstruct jets_secp.__6121 Ctypes.noattr))
     (@cons (prod (prod AST.ident BinNums.Z) Ctypes.type)
        (@pair (prod AST.ident BinNums.Z) Ctypes.type
           (@pair AST.ident BinNums.Z jets_secp._ps
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
           (Ctypes.Tstruct jets_secp._secp256k1_strauss_point_state Ctypes.noattr))
        (@nil (prod (prod AST.ident BinNums.Z) Ctypes.type))))
     : list (prod (prod AST.ident BinNums.Z) Ctypes.type)
### C.jet_secp_ecmult_state.ecmult_state_assignment
ecmult_state_assignment =
fun (id : AST.ident) (ty : Ctypes.type) (n : BinNums.Z) =>
Clight.Sassign
  (Clight.Efield (Clight.Evar jets_secp._state (Ctypes.Tstruct jets_secp._secp256k1_strauss_state Ctypes.noattr)) id
     (Ctypesdefs.tptr ty)) (Clight.Evar id (Ctypesdefs.tarray ty n))
     : forall (_ : AST.ident) (_ : Ctypes.type) (_ : BinNums.Z), Clight.statement

Arguments ecmult_state_assignment id ty n%Z_scope
### C.jet_secp_ecmult_state.ecmult_state_initialize
ecmult_state_initialize =
jet_secp_statement_prefix.statement_sequence
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_ecmult))) Clight.Sskip
     : Clight.statement
