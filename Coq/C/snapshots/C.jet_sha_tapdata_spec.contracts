### C.jet_sha_tapdata_spec.tapdata_init_spec_parametric
tapdata_init_spec_parametric
     : @Alg.Core.Parametric Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type (@tapdata_init_spec)
### C.jet_sha_tapdata_spec.one64_value
one64_value
     : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) one64) (BinNums.Zpos BinNums.xH)
### C.jet_sha_tapdata_spec.tapdata_init_spec_value
tapdata_init_spec_value
     : @eq (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (@tapdata_init_spec Alg.CoreFunSem tt)
         (@pair (Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (jet_buffer_empty_spec.buffer_empty_value (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) one64 tapdata_prefix))
### C.jet_sha_tapdata_spec.tag_hash_eval
tag_hash_eval
     : @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@SHA256.hashBlock Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))) iv_word tag_block)) tag_word
### C.jet_sha_tapdata_spec.tapdata_prefix_eval
tapdata_prefix_eval
     : @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@SHA256.hashBlock Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) iv_word
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tag_word tag_word))) tapdata_prefix
### C.jet_sha_tapdata_spec.iv_word_regs
iv_word_regs
     : @eq (list Integers.Int.int) (jet_sha_ctx8_model.state_regs iv_word) jet_sha256_iv_init.sha256_iv_words
### C.jet_sha_tapdata_spec.tag_block_bytes
tag_block_bytes
     : @eq (list BinNums.Z)
         (@List.map Integers.Int.int BinNums.Z Integers.Int.unsigned
            (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
               (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O)))))) tag_block)))
         (@List.map Integers.Int.int BinNums.Z Integers.Int.unsigned
            (@app Integers.Int.int tag_bytes
               (jet_sha_finalize_exec.sha_pad (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))))
### C.jet_sha_tapdata_spec.tapdata_prefix
tapdata_prefix =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
  (BinNums.Zpos
     (BinNums.xO
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))
### C.jet_sha_tapdata_spec.one64_spec
one64_spec =
fun term : Alg.Core.Algebra =>
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))) term
  (@Bit.true Ty.Unit term) (@jet_spec.left_pad_low_1_n term (S (S (S (S (S (S O)))))))
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))

Arguments one64_spec {term}
### C.jet_sha_tapdata_spec.tapdata_init_spec
tapdata_init_spec =
fun term : Alg.Core.Algebra =>
@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit
  (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
  (@jet_buffer_empty_spec.buffer_empty_spec (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) Ty.Unit term)
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term (@one64_spec term)
     (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) tapdata_prefix term))
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type

Arguments tapdata_init_spec {term}
### C.jet_sha_tapdata_spec.one64
one64 = @one64_spec Alg.CoreFunSem tt
     : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))
### C.jet_sha_tapdata_spec.iv_word
iv_word =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
  (BinNums.Zpos
     (BinNums.xI
        (BinNums.xO
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))
### C.jet_sha_tapdata_spec.tag_word
tag_word =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
  (BinNums.Zpos
     (BinNums.xO
        (BinNums.xI
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (...)))))))))))))))))))))))
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))
### C.jet_sha_tapdata_spec.tag_block
tag_block =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S (S O))))))))))
  (BinNums.Zpos
     (BinNums.xO
        (BinNums.xO
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
### C.jet_sha_tapdata_spec.tag_bytes
tag_bytes =
@List.map BinNums.Z Integers.Int.int Integers.Int.repr
  (@cons BinNums.Z
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
     (@cons BinNums.Z
        (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
        (@cons BinNums.Z
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
           (@cons BinNums.Z
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
              (@cons BinNums.Z
                 (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                 (@cons BinNums.Z
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                    (@cons BinNums.Z
                       (BinNums.Zpos
                          (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                       (@nil BinNums.Z))))))))
     : list Integers.Int.int
