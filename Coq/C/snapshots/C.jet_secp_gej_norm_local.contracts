### C.jet_secp_gej_norm_local.gej_norm_split_input
gej_norm_split_input
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z)
         (x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode
                   (Ty.Prod
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair
                      (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))),
       and
         (jet_encoding.frame_input_cells_at m bi edge rc
            (@List.map bool (option bool) (@Some bool)
               (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) x)))
         (and
            (jet_encoding.frame_input_cells_at m bi edge
               (BinInt.Z.add rc
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               (@List.map bool (option bool) (@Some bool)
                  (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) y)))
            (jet_encoding.frame_input_cells_at m bi edge
               (BinInt.Z.add rc
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
               (@List.map bool (option bool) (@Some bool)
                  (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) z))))
### C.jet_secp_gej_norm_local.gej_normalize_initialized_local_spec_from_count_calls
gej_normalize_initialized_local_spec_from_count_calls
     : forall
         _ : forall (mc : Memory.Mem.mem) (w : Integers.Int64.int)
               (_ : not (@eq BinNums.Z (Integers.Int64.unsigned w) BinNums.Z0)),
             ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
               (@cons Values.val (Values.Vlong w) (@nil Values.val)) Events.E0 mc
               (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned w)))),
       jet_secp_initialized_contract.secp_jet_initialized_local_spec jet_secp_modinfo_fe_caller.modinfo_fe_state
         jets_secp.f_simplicity_gej_normalize
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Sum Ty.Unit
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@jet_secp_gej_norm_branch.literal_gej_normalize Alg.CoreFunSem)
