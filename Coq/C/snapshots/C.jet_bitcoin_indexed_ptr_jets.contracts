fun alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra =>
@Bitcoin.PrimitiveBitcoin.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg Bitcoin.Bitcoin.OutputScriptHash
     : forall alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra,
       Bitcoin.PrimitiveBitcoin.Primitive.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments bitcoin_output_script_hash_spec {alg}
### C.jet_bitcoin_indexed_ptr_jets.script_hash_words
script_hash_words =
fun txo : Bitcoin.txOutput => Digest.hash256_reg (Digest.byteStringHash (Bitcoin.txoScript txo))
     : forall _ : Bitcoin.txOutput, list Integers.Int.int

Arguments script_hash_words txo
### C.jet_bitcoin_indexed_ptr_jets.bitcoin_output_script_hash_result
bitcoin_output_script_hash_result =
fun (environment : Bitcoin.Bitcoin.env) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error Bitcoin.txOutput (Bitcoin.sigTxOut (Bitcoin.Bitcoin.envTx environment))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| Some txo =>
    @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Word.from_hash256 (Digest.byteStringHash (Bitcoin.txoScript txo)))
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
end
     : forall (_ : Bitcoin.Bitcoin.env) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments bitcoin_output_script_hash_result environment a
### C.jet_bitcoin_indexed_ptr_jets.bitcoin_input_prev_outpoint_spec
