### C.jet_secp_negate_writer_bridge.wide_field_initial_rep
wide_field_initial_rep
     : forall (t0 t1 t2 t3 t4 : Integers.Int64.int) (rc : BinNums.Z) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0
                (@cons Integers.Int64.int t0
                   (@cons Integers.Int64.int t1
                      (@cons Integers.Int64.int t2
                         (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int)))))))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep (jet_secp_write_fe_wide_values.wide_fe_rho t0 t1 t2 t3 t4 rc)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@nil (prod Values.block BinNums.Z))) jet_secp_local_regions.local_write_initial_regs m
### C.jet_secp_negate_writer_bridge.wide_local_final_freeable
wide_local_final_freeable
     : forall (rho : forall _ : nat, Integers.Int64.int) (b : Values.block) (m : Memory.Mem.mem)
         (bd : Values.block) (base : Integers.Ptrofs.int)
         (_ : jet_sx_state.rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z)))
                (jet_sx_eval.sregs
                   (@fst jet_sx_eval.sstate jet_sx_exec.xout
                      (jet_sx_exec.rsel rho
                         (jet_sx_state.lay
                            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                               (@nil (prod Values.block BinNums.Z))))
                         (jet_secp_local_regions.local_write_result bd base)))) m),
       Memory.Mem.range_perm m b BinNums.Z0
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
         Memtype.Freeable
### C.jet_secp_negate_writer_bridge.wide_negate_output
