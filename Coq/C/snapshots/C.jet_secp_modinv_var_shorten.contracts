### C.jet_secp_modinv_var_shorten.inv_shortened_length
inv_shortened_length =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) =>
match inv_control_shrink len rho return nat with
| true => Nat.sub len (S O)
| false => len
end
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int), nat

