### C.jet_secp_modinv_var_shorten.inv_control_shrink
inv_control_shrink =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) =>
inv_shorten_guard len (inv_control_word rho false (Nat.sub len (S O))) (inv_control_word rho true (Nat.sub len (S O)))
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int), bool

