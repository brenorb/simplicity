### C.jet_secp_modinv_var_shorten.inv_shorten_modified
inv_shorten_modified =
@cons AST.ident jets_secp._fn
  (@cons AST.ident jets_secp._gn
     (@cons AST.ident jets_secp._cond
        (@cons AST.ident jets_secp._t'4
           (@cons AST.ident jets_secp._t'3 (@cons AST.ident jets_secp._len (@nil AST.ident))))))
     : list AST.ident
### C.jet_secp_modinv_var_shorten.inv_shorten_temp_frame
inv_shorten_temp_frame =
fun le lf : Clight.temp_env =>
forall (id : AST.ident) (_ : not (@List.In AST.ident id inv_shorten_modified)),
@eq (option Values.val) (@Maps.PTree.get Values.val id lf) (@Maps.PTree.get Values.val id le)
     : forall (_ : Clight.temp_env) (_ : Clight.temp_env), Prop

Arguments inv_shorten_temp_frame le lf
### C.jet_secp_modinv_var_shorten.inv_shorten_get_expr
inv_shorten_get_expr =
fun (len : nat) (high : bool) (i : nat) =>
match PeanoNat.Nat.eqb i (Nat.sub len (S (S O))) return jet_sx_expr.sx with
| true => inv_shorten_expr len high
| false => jet_sx_expr.XLv (Nat.add (inv_shorten_offset high) i)
end
     : forall (_ : nat) (_ : bool) (_ : nat), jet_sx_expr.sx

