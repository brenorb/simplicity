fun (rho : forall _ : nat, Integers.Int64.int) (high : bool) (i : nat) => rho (Nat.add (inv_shorten_offset high) i)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool) (_ : nat), Integers.Int64.int

