### C.jet_secp_modinv_var_shorten.inv_control_short_word
inv_control_short_word =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) (high : bool) (i : nat) =>
match inv_control_shrink len rho return Integers.Int64.int with
| true => inv_shorten_words len (inv_control_word rho high) i
| false => inv_control_word rho high i
end
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : bool) (_ : nat), Integers.Int64.int

