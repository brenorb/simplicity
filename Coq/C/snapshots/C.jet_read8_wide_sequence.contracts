### C.jet_read8_wide_sequence.read8_result_cast_id
read8_result_cast_id
     : forall w : Integers.Int64.int,
       @eq Integers.Int.int
         (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
            (jet_read8.read8_result w)) (jet_read8.read8_result w)
### C.jet_read8_wide_sequence.read8_result_exact_unsigned
read8_result_exact_unsigned
     : forall w : Integers.Int64.int,
       @eq BinNums.Z (Integers.Int.unsigned (jet_read8.read8_result w))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) (jet_spec.decode_word8 w))
### C.jet_read8_wide_sequence.eval_read8_wide_sequence
eval_read8_wide_sequence
     : forall (s : jet_wide.wide_size) (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z)
         (bi : Values.block) (edge rc : BinNums.Z) (amount : Ty.tySem (Word.Word (S (S (S O)))))
         (x : Ty.tySem (Word.Word (jet_wide.wide_log s))) (_ : jet_frame_layout.frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.add (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (jet_wide.wide_bits s))))) (_ : jet_frame_layout.frame_fields_at m bf base bi edge rc)
         (_ : @jet_input_layout.frame_input_word_at (S (S (S O))) m bi edge rc amount)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge
                (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) x)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : not (@eq Values.block bf bi)),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex Integers.Int.int
               (fun a : Integers.Int.int =>
                @ex Integers.Int64.int
                  (fun r : Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                        (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                        (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mr
                        (Values.Vint a))
                     (and
                        (@eq BinNums.Z (Integers.Int.unsigned a)
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) amount))
                        (and
                           (@eq Integers.Int.int
                              (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) a)
                              a)
                           (and
                              (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                                 (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                                 (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))
                                 Events.E0 mf (Values.Vlong r))
                              (and
                                 (@eq BinNums.Z (Integers.Int64.unsigned r)
                                    (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) x))
                                 (and
                                    (jet_frame_layout.frame_fields_at mf bf base bi edge
                                       (BinInt.Z.add rc
                                          (BinInt.Z.add
                                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                             (jet_wide.wide_bits s))))
                                    (and
                                       (forall (chunk : AST.memory_chunk) (b : Values.block)
                                          (ofs : BinNums.Z)
                                          (_ : or (not (@eq Values.block b bf))
                                                 (or
                                                    (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                       (BinInt.Z.add base
                                                          (BinNums.Zpos
                                                             (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                    (BinInt.Z.le
                                                       (BinInt.Z.add base
                                                          (BinNums.Zpos
                                                             (BinNums.xO
                                                                (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                       ofs))),
                                        @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                          (Memory.Mem.load chunk m b ofs))
                                       (and
                                          (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                             (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                           Memory.Mem.perm mf b ofs kind p)
                                          (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                           Memory.Mem.valid_block mf b))))))))))))
