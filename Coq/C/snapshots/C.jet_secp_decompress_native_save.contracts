### C.jet_secp_decompress_native_save.native_field_words_limbs
native_field_words_limbs
     : forall f : jet_secp_point_write_field.point_field,
       @eq (list Integers.Int64.int) (jet_secp_multiply_normalize_bridge.words5 (native_field_words f))
         (jet_secp_point_write_field.point_field_limbs f)
### C.jet_secp_decompress_native_save.native_field_words_value
native_field_words_value
     : forall f : jet_secp_point_write_field.point_field,
       @eq BinNums.Z (jet_secp_fe_inv_prefix.fe_inv_value (native_field_words f))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (jet_secp_point_write_field.point_field_output f))
### C.jet_secp_decompress_native_save.native_canonical_square_bounds
native_canonical_square_bounds
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       jet_secp_square_columns.square_input_bounds
         (native_field_words (jet_secp_point_field_bridge.point_canonical_field value))
### C.jet_secp_decompress_native_save.native_negative_square_bounds
native_negative_square_bounds
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       jet_secp_square_columns.square_input_bounds
         (native_field_words (jet_secp_point_field_bridge.point_negative_field value))
### C.jet_secp_decompress_native_save.eval_decompressed_native_save
eval_decompressed_native_save
     : forall (_ : jet_memcpy_model.memcpy_model) (w : forall _ : nat, Integers.Int64.int)
         (pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bin bout : Values.block) (_ : jet_secp_root_chain_numeric.root_words_match w pk)
         (_ : @eq
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
                   (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      odd pk))
                (@inr unit
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay)))
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_secp_fe_nv.fe_at m bin
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_point_write_field.point_field_limbs
                   (jet_secp_decompress_output.decompress_y_field w (Bit.toBool odd))))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun storage : forall _ : nat, Integers.Int64.int =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_xonly_pubkey_save)
                  (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                  Values.Vundef)
               (and (jet_secp_affine_storage.affine_storage_readable mf bout BinNums.Z0 storage)
                  (and
                     (@eq BinNums.Z (jet_secp_storage_numeric.field_storage_value storage)
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ax))
                     (and
                        (@eq BinNums.Z
                           (jet_secp_storage_numeric.field_storage_value
                              (fun i : nat => storage (Nat.add (S (S (S (S O)))) i)))
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ay))
                        (and
                           (Memory.Mem.range_perm mf bout BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m mf)
                              (jet_clight_internal_preserve.readonly_preserved m mf))))))))
