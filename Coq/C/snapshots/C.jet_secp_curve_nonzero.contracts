### C.jet_secp_curve_nonzero.secp_minus_seven_not_cube
secp_minus_seven_not_cube
     : not
         (@eq BinNums.Z
            (Zpow_facts.Zpow_mod (BinNums.Zneg (BinNums.xI (BinNums.xI BinNums.xH)))
               (BinNums.Zpos jet_secp_curve_polynomial.secp_cubic_exponent) jet_secp_fe_math.feP)
            (BinNums.Zpos BinNums.xH))
### C.jet_secp_curve_nonzero.secp_curve_y_nonzero
secp_curve_y_nonzero
     : forall (x y : BinNums.Z)
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo
                   (BinInt.Z.add (BinInt.Z.mul (BinInt.Z.mul x x) x)
                      (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (BinInt.Z.mul y y) jet_secp_fe_math.feP)),
       not (@eq BinNums.Z (BinInt.Z.modulo y jet_secp_fe_math.feP) BinNums.Z0)
