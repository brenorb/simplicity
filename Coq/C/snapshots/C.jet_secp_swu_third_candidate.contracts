### C.jet_secp_swu_third_candidate.swu_add_int_scaled
swu_add_int_scaled
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.signed c))
                (BinInt.Z.le (Integers.Int.signed c) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : jet_secp_field_mul_small.mul_small_input_bounds w),
       jet_secp_field_sum_bounds.field_scaled_bounds (BinNums.Zpos (BinNums.xO BinNums.xH))
         (jet_secp_field_add_int.add_int_words c w)
### C.jet_secp_swu_third_candidate.swu_third_source
swu_third_source
     : @eq Clight.statement jet_secp_swu_second_candidate.swu_after_second_candidate
         (jet_secp_statement_prefix.statement_sequence swu_third_statements swu_after_third_candidate)
### C.jet_secp_swu_third_candidate.exec_swu_third_square_call
exec_swu_third_square_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bc bw : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._wd e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bw jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bw Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_third_square Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_third_candidate.exec_swu_third_multiply_call
exec_swu_third_multiply_call
     : forall (inv : bool) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bc br : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   match inv return BinNums.positive with
                   | true => jets_secp._jinv
                   | false => jets_secp._wd
                   end e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (swu_third_multiply inv) Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_third_candidate.exec_swu_third_add_call
exec_swu_third_add_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bc : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add_int)
                (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos BinNums.xH))) (@nil Values.val)))
                Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_third_add Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_third_candidate.exec_swu_third_candidate
exec_swu_third_candidate
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bc bw bj : Values.block) (w inv : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._wd e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bw jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._jinv e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bj jet_secp_curve_statements.curve_fe_type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bc (@cons Values.block bw (@cons Values.block bj (@nil Values.block)))))
         (_ : jet_secp_swu_startup.swu_startup m) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_square_columns.square_input_bounds inv)
         (_ : jet_secp_fe_nv.fe_at m bw BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_secp_fe_nv.fe_at m bj BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bw BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bj BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_third_prefix Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bc BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (swu_third_words w inv)))
               (and (jet_secp_fe_nv.fe_at mf bw BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and (jet_secp_fe_nv.fe_at mf bj BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                     (and
                        (Memory.Mem.range_perm mf bc BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bw BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bj BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_secp_field_sum_bounds.field_scaled_bounds (BinNums.Zpos (BinNums.xO BinNums.xH))
                                    (swu_third_words w inv))
                                 (and (jet_secp_square_columns.square_input_bounds (swu_third_words w inv))
                                    (and
                                       (Zdiv.eqm jet_secp_fe_math.feP
                                          (jet_secp_multiply_finish_product.radix_value (swu_third_words w inv))
                                          (BinInt.Z.add
                                             (BinInt.Z.mul
                                                (BinInt.Z.mul
                                                   (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value w)
                                                      (jet_secp_multiply_finish_product.radix_value w))
                                                   (jet_secp_multiply_finish_product.radix_value w))
                                                (jet_secp_multiply_finish_product.radix_value inv))
                                             (BinNums.Zpos BinNums.xH)))
                                       (and (jet_secp_swu_startup.swu_startup mf)
                                          (and
                                             (jet_sx_mem.lframe
                                                (fun (b : Values.block) (_ : BinNums.Z) =>
                                                 and (not (@eq Values.block b bc))
                                                   (and (not (@eq Values.block b bw)) (not (@eq Values.block b bj)))) m
                                                mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))))))))
### C.jet_secp_swu_third_candidate.swu_setup_wd_square
swu_setup_wd_square
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds w),
       and
         (jet_secp_square_columns.square_input_bounds
            (jet_secp_swu_joint_setup.swu_setup_wd (jet_secp_square_numeric.square_words w)))
         (Zdiv.eqm jet_secp_fe_math.feP
            (jet_secp_multiply_finish_product.radix_value
               (jet_secp_swu_joint_setup.swu_setup_wd (jet_secp_square_numeric.square_words w)))
            (BinInt.Z.add
               (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value w)
                  (jet_secp_multiply_finish_product.radix_value w))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
### C.jet_secp_swu_third_candidate.swu_third_spec_match
swu_third_spec_match
     : forall (t : BinNums.Z) (wd inv : forall _ : nat, Integers.Int64.int) (value : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_multiply_finish_product.radix_value wd)
                (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value inv)
                (jet_secp_swu_candidates.swu_joint_inverse t))
         (_ : Zdiv.eqm jet_secp_fe_math.feP value
                (BinInt.Z.add
                   (BinInt.Z.mul
                      (BinInt.Z.mul
                         (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value wd)
                            (jet_secp_multiply_finish_product.radix_value wd))
                         (jet_secp_multiply_finish_product.radix_value wd))
                      (jet_secp_multiply_finish_product.radix_value inv)) (BinNums.Zpos BinNums.xH))),
       Zdiv.eqm jet_secp_fe_math.feP value (jet_secp_swu_candidates.swu_c_candidate3 t)
### C.jet_secp_swu_third_candidate.swu_through_third_source
swu_through_third_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_shallue_van_de_woestijne)
         (jet_secp_statement_prefix.statement_sequence swu_through_third_statements swu_after_third_candidate)
### C.jet_secp_swu_third_candidate.exec_swu_through_third
exec_swu_through_third
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (bt bw ba bx bj bb bc : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_clight_internal_frame.plain_env e)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._negc e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_inv_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._d e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._wd e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bw jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._jinv e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bj jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t le)
                (@Some Values.val (Values.Vptr bt Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bt
                   (@cons Values.block bw
                      (@cons Values.block ba
                         (@cons Values.block bx
                            (@cons Values.block bj (@cons Values.block bb (@cons Values.block bc (@nil Values.block)))))))))
         (_ : jet_secp_swu_startup.swu_startup m) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : @List.Forall Values.block
                (fun b : Values.block =>
                 Memory.Mem.range_perm m b BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   Memtype.Cur Memtype.Freeable)
                (@cons Values.block bt
                   (@cons Values.block bw
                      (@cons Values.block ba
                         (@cons Values.block bx
                            (@cons Values.block bj (@cons Values.block bb (@cons Values.block bc (@nil Values.block))))))))),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun inv : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_through_third Events.E0 le mf
                  ClightBigstep.Out_normal)
               (and (jet_secp_fe_nv.fe_at mf bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and
                     (jet_secp_fe_nv.fe_at mf bw BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_swu_joint_setup.swu_setup_wd (jet_secp_square_numeric.square_words w))))
                     (and
                        (jet_secp_fe_nv.fe_at mf ba BinNums.Z0
                           (jet_secp_multiply_normalize_bridge.words5
                              (jet_secp_swu_second_candidate.swu_input_first_words w inv)))
                        (and
                           (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                              (jet_secp_multiply_normalize_bridge.words5
                                 (jet_secp_swu_joint_setup.swu_setup_x3d (jet_secp_square_numeric.square_words w))))
                           (and (jet_secp_fe_nv.fe_at mf bj BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                              (and
                                 (jet_secp_fe_nv.fe_at mf bb BinNums.Z0
                                    (jet_secp_multiply_normalize_bridge.words5
                                       (jet_secp_swu_second_candidate.swu_second_words
                                          (jet_secp_swu_second_candidate.swu_input_first_words w inv))))
                                 (and
                                    (jet_secp_fe_nv.fe_at mf bc BinNums.Z0
                                       (jet_secp_multiply_normalize_bridge.words5 (swu_input_third_words w inv)))
                                    (and
                                       (@List.Forall Values.block
                                          (fun b : Values.block =>
                                           Memory.Mem.range_perm mf b BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (@cons Values.block bt
                                             (@cons Values.block bw
                                                (@cons Values.block ba
                                                   (@cons Values.block bx
                                                      (@cons Values.block bj
                                                         (@cons Values.block bb
                                                            (@cons Values.block bc (@nil Values.block)))))))))
                                       (and (jet_secp_square_columns.square_input_bounds inv)
                                          (and
                                             (jet_secp_field_sum_bounds.field_scaled_bounds
                                                (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                (jet_secp_swu_second_candidate.swu_input_first_words w inv))
                                             (and
                                                (jet_secp_square_columns.square_input_bounds
                                                   (jet_secp_swu_second_candidate.swu_input_first_words w inv))
                                                (and
                                                   (jet_secp_square_columns.square_input_bounds
                                                      (jet_secp_swu_second_candidate.swu_second_words
                                                         (jet_secp_swu_second_candidate.swu_input_first_words w inv)))
                                                   (and
                                                      (jet_secp_field_sum_bounds.field_scaled_bounds
                                                         (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                         (swu_input_third_words w inv))
                                                      (and
                                                         (jet_secp_square_columns.square_input_bounds
                                                            (swu_input_third_words w inv))
                                                         (and
                                                            (Zdiv.eqm jet_secp_fe_math.feP
                                                               (jet_secp_multiply_finish_product.radix_value
                                                                  (jet_secp_swu_second_candidate.swu_input_first_words
                                                                     w inv))
                                                               (jet_secp_swu_candidates.swu_c_candidate1
                                                                  (jet_secp_multiply_finish_product.radix_value w)))
                                                            (and
                                                               (Zdiv.eqm jet_secp_fe_math.feP
                                                                  (jet_secp_multiply_finish_product.radix_value
                                                                     (jet_secp_swu_second_candidate.swu_second_words
                                                                        (...)))
                                                                  (jet_secp_swu_candidates.swu_c_candidate2
                                                                     (jet_secp_multiply_finish_product.radix_value w)))
