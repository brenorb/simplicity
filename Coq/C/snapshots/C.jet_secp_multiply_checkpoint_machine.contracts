### C.jet_secp_multiply_checkpoint_machine.pair_value
pair_value =
fun s : prod Integers.Int64.int Integers.Int64.int =>
BinInt.Z.add (Integers.Int64.unsigned (@fst Integers.Int64.int Integers.Int64.int s))
  (BinInt.Z.mul Integers.Int64.modulus (Integers.Int64.unsigned (@snd Integers.Int64.int Integers.Int64.int s)))
     : forall _ : prod Integers.Int64.int Integers.Int64.int, BinNums.Z

Arguments pair_value s
### C.jet_secp_multiply_checkpoint_machine.machine_product
machine_product =
fun a b : Integers.Int64.int =>
@pair Integers.Int64.int Integers.Int64.int (jet_secp_umul128_numeric.umul128_lo_machine a b)
  (jet_secp_umul128_numeric.umul128_hi_machine a b)
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int), prod Integers.Int64.int Integers.Int64.int

Arguments machine_product a b
### C.jet_secp_multiply_checkpoint_machine.machine_carry
machine_carry =
fun lo a : Integers.Int64.int =>
Integers.Int64.repr
  (Integers.Int.signed
     match Integers.Int64.ltu lo a return Integers.Int.int with
     | true => Integers.Int.one
     | false => Integers.Int.zero
     end)
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments machine_carry lo a
### C.jet_secp_multiply_checkpoint_machine.machine_accum
machine_accum =
fun (s : prod Integers.Int64.int Integers.Int64.int) (a b : Integers.Int64.int) =>
let p : prod Integers.Int64.int Integers.Int64.int := machine_product a b in
let lo : Integers.Int64.int :=
  Integers.Int64.add (@fst Integers.Int64.int Integers.Int64.int s) (@fst Integers.Int64.int Integers.Int64.int p) in
@pair Integers.Int64.int Integers.Int64.int lo
  (Integers.Int64.add (@snd Integers.Int64.int Integers.Int64.int s)
     (Integers.Int64.add (@snd Integers.Int64.int Integers.Int64.int p)
        (machine_carry lo (@fst Integers.Int64.int Integers.Int64.int p))))
     : forall (_ : prod Integers.Int64.int Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       prod Integers.Int64.int Integers.Int64.int

Arguments machine_accum s a b
### C.jet_secp_multiply_checkpoint_machine.machine_accum_word
machine_accum_word =
fun (s : prod Integers.Int64.int Integers.Int64.int) (a : Integers.Int64.int) =>
let lo : Integers.Int64.int := Integers.Int64.add (@fst Integers.Int64.int Integers.Int64.int s) a in
@pair Integers.Int64.int Integers.Int64.int lo
  (Integers.Int64.add (@snd Integers.Int64.int Integers.Int64.int s) (machine_carry lo a))
     : forall (_ : prod Integers.Int64.int Integers.Int64.int) (_ : Integers.Int64.int),
       prod Integers.Int64.int Integers.Int64.int

Arguments machine_accum_word s a
### C.jet_secp_multiply_checkpoint_machine.machine_shift52
machine_shift52 =
