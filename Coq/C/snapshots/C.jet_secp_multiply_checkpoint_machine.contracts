@pair Integers.Int64.int Integers.Int64.int (@snd Integers.Int64.int Integers.Int64.int s) Integers.Int64.zero
     : forall _ : prod Integers.Int64.int Integers.Int64.int, prod Integers.Int64.int Integers.Int64.int

