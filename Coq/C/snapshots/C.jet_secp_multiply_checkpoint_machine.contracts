### C.jet_secp_multiply_checkpoint_machine.pair_den
pair_den =
fun (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
  (s : prod jet_sx_expr.sx jet_sx_expr.sx) =>
@pair Integers.Int64.int Integers.Int64.int (word_den rho beta (@fst jet_sx_expr.sx jet_sx_expr.sx s))
  (word_den rho beta (@snd jet_sx_expr.sx jet_sx_expr.sx s))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z)
         (_ : prod jet_sx_expr.sx jet_sx_expr.sx), prod Integers.Int64.int Integers.Int64.int

