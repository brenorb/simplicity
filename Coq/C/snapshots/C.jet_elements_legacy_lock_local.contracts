### C.jet_elements_legacy_lock_local.legacy_ltu_two
legacy_ltu_two
     : forall ver : Integers.Int64.int,
       @eq bool (Integers.Int64.ltu ver (Integers.Int64.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
         (negb (BinInt.Z.leb (BinNums.Zpos (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned ver)))
### C.jet_elements_legacy_lock_local.legacy_lock_decode_result
legacy_lock_decode_result
     : forall (distance : bool) (environment : jet_elements_prim.Elements.environment)
         (ver cached : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned ver)
                (Integers.Int.unsigned (jet_elements_prim.sigTxVersion (jet_elements_prim.Elements.envTx environment))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned cached)
                (jet_elements_legacy_lock_spec.legacy_cache_value distance
                   (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment)))),
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
         (jet_wide_spec.decode_wide jet_wide.W16
            (Integers.Int64.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
               (jet_elements_legacy_lock_exec.legacy_lock_result ver cached)))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S O)))))
            match
              BinInt.Z.leb (BinNums.Zpos (BinNums.xO BinNums.xH))
                (Integers.Int.unsigned (jet_elements_prim.sigTxVersion (jet_elements_prim.Elements.envTx environment)))
              return BinNums.Z
            with
            | true =>
                jet_elements_legacy_lock_spec.legacy_cache_value distance
                  (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment))
            | false => BinNums.Z0
            end)
