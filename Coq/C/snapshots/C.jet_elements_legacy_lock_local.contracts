         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
               (legacy_lock_id distance))
            (@Some Values.block (jet_elements_linkage.elements_symbol_block (legacy_lock_id distance))))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
               (Values.Vptr (jet_elements_linkage.elements_symbol_block (legacy_lock_id distance)) Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (legacy_lock_helper distance))))
