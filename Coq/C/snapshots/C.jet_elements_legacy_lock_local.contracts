     : forall _ : bool, AST.ident

Arguments legacy_lock_field distance%bool_scope
### C.jet_elements_legacy_lock_local.legacy_lock_delta
legacy_lock_delta =
fun distance : bool =>
match distance return BinNums.Z with
| true =>
    BinNums.Zpos
      (BinNums.xO
         (BinNums.xO
            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
| false =>
    BinNums.Zpos
      (BinNums.xO
         (BinNums.xO
            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
end
     : forall _ : bool, BinNums.Z

Arguments legacy_lock_delta distance%bool_scope
### C.jet_elements_legacy_lock_local.legacy_lock_helper
legacy_lock_helper =
fun distance : bool =>
match distance return Clight.function with
| true => jets_elements.f_obsolete_lockDistance
| false => jets_elements.f_obsolete_lockDuration
end
     : forall _ : bool, Clight.function

Arguments legacy_lock_helper distance%bool_scope
### C.jet_elements_legacy_lock_local.legacy_lock_jet
legacy_lock_jet =
fun distance : bool =>
match distance return Clight.function with
| true => jets_elements.f_simplicity_broken_do_not_use_tx_lock_distance
| false => jets_elements.f_simplicity_broken_do_not_use_tx_lock_duration
end
     : forall _ : bool, Clight.function

Arguments legacy_lock_jet distance%bool_scope
### C.jet_elements_legacy_lock_local.elements_legacy_lock_env_rep
elements_legacy_lock_env_rep =
fun (distance : bool) (m : Memory.Mem.mem) (env : Values.val) (environment : jet_elements_prim.Elements.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun base : BinNums.Z =>
            @ex Integers.Int64.int
              (fun ver : Integers.Int64.int =>
               @ex Integers.Int64.int
                 (fun cached : Integers.Int64.int =>
                  and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                    (and (BinInt.Z.le BinNums.Z0 ebase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add ebase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and (BinInt.Z.le BinNums.Z0 base)
                             (and
                                (BinInt.Z.le
                                   (BinInt.Z.add base
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))
                                   Integers.Ptrofs.max_unsigned)
                                (and
                                   (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                      (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr base))))
                                   (and
                                      (@eq (option Values.val)
                                         (Memory.Mem.load AST.Mint64 m bt
                                            (BinInt.Z.add base
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                         (@Some Values.val (Values.Vlong ver)))
                                      (and
                                         (@eq BinNums.Z (Integers.Int64.unsigned ver)
                                            (Integers.Int.unsigned
                                               (jet_elements_prim.sigTxVersion
                                                  (jet_elements_prim.Elements.envTx environment))))
                                         (and
                                            (@eq (option Values.val)
                                               (Memory.Mem.load AST.Mint64 m bt
                                                  (BinInt.Z.add base (legacy_lock_delta distance)))
                                               (@Some Values.val (Values.Vlong cached)))
                                            (and
                                               (@eq BinNums.Z (Integers.Int64.unsigned cached)
                                                  (jet_elements_legacy_lock_spec.legacy_cache_value distance
                                                     (jet_elements_prim.sigTxIn
                                                        (jet_elements_prim.Elements.envTx environment))))
                                               (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                                     (@pair (prod Values.block BinNums.Z) BinNums.Z
                                                        (@pair Values.block BinNums.Z be ebase)
                                                        (BinInt.Z.add ebase ...))
                                                     (@cons (prod ... BinNums.Z) (@pair ... BinNums.Z ... ...)
                                                        (@nil ...)))))))))))))))))))
     : forall (_ : bool) (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments elements_legacy_lock_env_rep distance%bool_scope m env environment fp%list_scope
