### C.jet_elements_legacy_lock_local.legacy_lock_id
legacy_lock_id =
fun distance : bool =>
match distance return AST.ident with
| true => jets_elements._obsolete_lockDistance
| false => jets_elements._obsolete_lockDuration
end
     : forall _ : bool, AST.ident

Arguments legacy_lock_id distance%bool_scope
