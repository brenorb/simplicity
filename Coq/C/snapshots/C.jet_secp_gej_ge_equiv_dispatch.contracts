### C.jet_secp_gej_ge_equiv_dispatch.equiv_normalized_reader_residue
equiv_normalized_reader_residue
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho a))
            jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem a)) jet_secp_fe_math.feP)
### C.jet_secp_gej_ge_equiv_dispatch.equiv_negated_reader_residue
equiv_negated_reader_residue
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (jet_secp_multiply_finish_product.radix_value
               (jet_secp_field_negate_separate.negate_sep_words (jet_secp_square_spec_bridge.square_reader_rho a)))
            jet_secp_fe_math.feP)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem a))
### C.jet_secp_gej_ge_equiv_dispatch.equiv_weak_negated_reader
equiv_weak_negated_reader
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (@eq BinNums.Z
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value
                  (jet_secp_field_weak_loose.weak_loose_words
                     (jet_secp_field_negate_separate.negate_sep_words (jet_secp_square_spec_bridge.square_reader_rho a))))
               jet_secp_fe_math.feP)
            (BinInt.Z.modulo
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem a)) jet_secp_fe_math.feP))
         (jet_secp_field_mul_small.mul_small_input_bounds
            (jet_secp_field_weak_loose.weak_loose_words
               (jet_secp_field_negate_separate.negate_sep_words (jet_secp_square_spec_bridge.square_reader_rho a))))
### C.jet_secp_gej_ge_equiv_dispatch.mixed_h_residue_test
mixed_h_residue_test
     : forall (x z u : forall _ : nat, Integers.Int64.int)
         (a c b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_field_mul_small.mul_small_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_square_columns.square_input_bounds u)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value x) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) c)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value u) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                   jet_secp_fe_math.feP)),
       @eq bool
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value (jet_secp_mixed_finite_return.mixed_h_words x z u))
               jet_secp_fe_math.feP) BinNums.Z0)
         (Bit.toBool
            (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
               (jet_secp_mixed_dispatch_literal.mixed_literal_h a c b)))
### C.jet_secp_gej_ge_equiv_dispatch.mixed_i_residue_test
mixed_i_residue_test
     : forall (y z v : forall _ : nat, Integers.Int64.int)
         (a c b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_field_mul_small.mul_small_input_bounds y) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_square_columns.square_input_bounds v)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value y) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) c)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value v) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                   jet_secp_fe_math.feP)),
       @eq bool
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value (jet_secp_mixed_finite_return.mixed_i_words y z v))
               jet_secp_fe_math.feP) BinNums.Z0)
         (Bit.toBool
            (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
               (jet_secp_mixed_dispatch_literal.mixed_literal_i a c b)))
### C.jet_secp_gej_ge_equiv_dispatch.equiv_negated_h_test
equiv_negated_h_test
     : forall x z u : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value
                  (jet_secp_mixed_finite_return.mixed_h_words (jet_secp_square_spec_bridge.square_reader_rho x)
                     (jet_secp_square_spec_bridge.square_reader_rho z)
                     (jet_secp_square_spec_bridge.square_reader_rho u))) jet_secp_fe_math.feP) BinNums.Z0)
         (Bit.toBool
            (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
               (jet_secp_mixed_dispatch_literal.mixed_literal_h
                  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
                  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem z) u)))
### C.jet_secp_gej_ge_equiv_dispatch.equiv_negated_i_test
equiv_negated_i_test
     : forall y z v : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value
                  (jet_secp_mixed_finite_return.mixed_i_words
                     (jet_secp_field_weak_loose.weak_loose_words
                        (jet_secp_field_negate_separate.negate_sep_words
                           (jet_secp_square_spec_bridge.square_reader_rho y)))
                     (jet_secp_square_spec_bridge.square_reader_rho z)
                     (jet_secp_square_spec_bridge.square_reader_rho v))) jet_secp_fe_math.feP) BinNums.Z0)
         (Bit.toBool
            (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
               (jet_secp_mixed_dispatch_literal.mixed_literal_i
                  (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem y)
                  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem z) v)))
