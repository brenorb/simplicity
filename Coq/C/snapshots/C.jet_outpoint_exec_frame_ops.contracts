### C.jet_outpoint_exec_frame_ops.op_read_cell
op_read_cell
     : forall (bl bm bb bx bi : Values.block) (_ : not (@eq Values.block bl bx)) (_ : not (@eq Values.block bl bm))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bi bl)) (le : Clight.temp_env) (m : Memory.Mem.mem) (edge rc : BinNums.Z)
         (bit : bool) (cells : list (option bool)) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (id : AST.ident)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))))
         (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc (@cons (option bool) (@Some bool bit) cells))
         (_ : jet_elements_support_sha_ctx_abs.ctx_abs m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
               (jet_outpoint_exec_shape.op_env bl bm bb bx) le m (jet_nonce_context_shape.nc_readbit id) Events.E0
               (@Maps.PTree.set Values.val id (Values.Vint (jet_readBit_layout.bit_int bit)) le) mf
               ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)))
               (and (jet_encoding.frame_input_cells_at mf bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) cells)
                  (and (jet_elements_support_sha_ctx_abs.ctx_abs mf bx bm l regs c ovf)
                     (jet_nonce_exec_effects.nonce_effects m mf (@cons Values.block bl (@nil Values.block)))))))
### C.jet_outpoint_exec_frame_ops.op_skip_exec
op_skip_exec
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bl bi : Values.block) (edge rc : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._src e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bl jet_nonce_context_shape.nc_fr)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._forwardBits e)
                (@None (prod Values.block Ctypes.type))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m jet_outpoint_exec_shape.op_skip
               Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                  (BinInt.Z.add rc
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
               (jet_nonce_exec_effects.nonce_effects m mf (@cons Values.block bl (@nil Values.block)))))
