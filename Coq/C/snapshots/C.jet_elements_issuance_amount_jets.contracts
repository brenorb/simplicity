### C.jet_elements_issuance_amount_jets.issuance_amount
issuance_amount =
fun i : jet_elements_prim.issuance =>
match i return (jet_elements_prim.amountWith (list Integers.Byte.int)) with
| inl new => jet_elements_prim.newIssuanceAmount new
| inr re => jet_elements_prim.reissuanceAmount re
end
     : forall _ : jet_elements_prim.issuance, jet_elements_prim.amountWith (list Integers.Byte.int)

Arguments issuance_amount i
### C.jet_elements_issuance_amount_jets.assetamt_pexpr
assetamt_pexpr =
Clight.Eaddrof
  (Clight.Efield
     (Clight.Ederef
        (Clight.Etempvar jets_elements._issuance
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._assetIssuance Ctypes.noattr)))
        (Ctypes.Tstruct jets_elements._assetIssuance Ctypes.noattr)) jets_elements._assetAmt
     (Ctypes.Tstruct jets_elements._confAmount Ctypes.noattr))
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._confAmount Ctypes.noattr))
     : Clight.expr
### C.jet_elements_issuance_amount_jets.issuance_amount_rep
issuance_amount_rep =
fun (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (txi : jet_elements_prim.sigTxInput) =>
and
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint32 m b
        (BinInt.Z.add ofs
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
     (@Some Values.val (Values.Vint (jet_elements_issuance_jets.issuance_tag (jet_elements_prim.sigTxiIssuance txi)))))
  (forall (i : jet_elements_prim.issuance)
     (_ : @eq (option jet_elements_prim.issuance) (jet_elements_prim.sigTxiIssuance txi)
            (@Some jet_elements_prim.issuance i)),
   jet_elements_amount_jets.amount_rep m b
     (BinInt.Z.add ofs
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
     (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (issuance_amount i)))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : jet_elements_prim.sigTxInput), Prop

Arguments issuance_amount_rep m b ofs%Z_scope txi
### C.jet_elements_issuance_amount_jets.issuance_amount_pcells
issuance_amount_pcells =
fun txi : jet_elements_prim.sigTxInput =>
jet_elements_issuance_helper.issuance_tagged_cells
  (@jet_elements_issuance_jets.opt_is_some jet_elements_prim.issuance (jet_elements_prim.sigTxiIssuance txi))
  (BinNums.Zpos
     (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
  match jet_elements_prim.sigTxiIssuance txi return (list BitMachine.Cell) with
  | Some i =>
      jet_elements_amount_jets.amount_pcells
        (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (issuance_amount i))
  | None => @nil BitMachine.Cell
  end
     : forall _ : jet_elements_prim.sigTxInput, list BitMachine.Cell

Arguments issuance_amount_pcells txi
### C.jet_elements_issuance_amount_jets.issuance_amount_result
issuance_amount_result =
fun (elems : list jet_elements_prim.sigTxInput) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error jet_elements_prim.sigTxInput elems
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return
    (Ty.tySem
       (Ty.Sum Ty.Unit
          (Ty.Sum Ty.Unit
             (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Word.Word (S (S (S (S (S (S O)))))))))))
with
| Some txi =>
    @inr unit
      (sum unit
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S O))))))))))
      match
        jet_elements_prim.sigTxiIssuance txi
        return
          (sum unit
             (Ty.tySem
                (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Word.Word (S (S (S (S (S (S O))))))))))
      with
      | Some i =>
          @inr unit
            (Ty.tySem
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S O)))))))))
            (jet_elements_amount_jets.encode_amount
               (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (issuance_amount i)))
      | None =>
          @inl unit
            (Ty.tySem
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S O))))))))) tt
      end
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S O)))))))))) tt
end
     : forall (_ : list jet_elements_prim.sigTxInput) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S O))))))))))

Arguments issuance_amount_result elems%list_scope a
### C.jet_elements_issuance_amount_jets.elements_issuance_asset_amount_spec
elements_issuance_asset_amount_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
  (Ty.Sum Ty.Unit
     (Ty.Sum Ty.Unit
        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S O)))))))))) alg jet_elements_prim.Elements.IssuanceAssetAmount
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S O))))))))))

Arguments elements_issuance_asset_amount_spec {alg}
