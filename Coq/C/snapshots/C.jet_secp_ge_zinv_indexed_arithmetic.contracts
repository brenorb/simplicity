### C.jet_secp_ge_zinv_indexed_arithmetic.ge_zinv_indexed_arithmetic_frame
ge_zinv_indexed_arithmetic_frame =
fun (br : Values.block) (base : BinNums.Z) (ba bf b2 b3 b : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block b b2))
  (and (not (@eq Values.block b b3))
     (and (not (@eq Values.block b bf))
        (and
           (or (not (@eq Values.block b br))
              (or (BinInt.Z.lt pos base)
                 (BinInt.Z.le
                    (BinInt.Z.add base
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                    pos)))
           (or (not (@eq Values.block b ba))
              (or (BinInt.Z.lt pos BinNums.Z0)
                 (BinInt.Z.le
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos))))))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

