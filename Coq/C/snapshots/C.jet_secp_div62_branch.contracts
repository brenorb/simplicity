### C.jet_secp_div62_branch.div62_continued_temps
div62_continued_temps =
fun (le : Maps.PTree.tree Values.val) (neg : bool) (eta i : BinNums.Z) (f g u v q r : Integers.Int64.int) =>
jet_secp_div62_cancel.div62_cancel_temps
  (jet_secp_div62_limit.div62_limit_temps (div62_branch_entry le neg eta f g u v q r) neg
     match neg return BinNums.Z with
     | true => BinInt.Z.opp eta
     | false => eta
     end i) neg match neg return Integers.Int64.int with
                | true => g
                | false => f
                end match neg return Integers.Int64.int with
                    | true => Integers.Int64.neg f
                    | false => g
                    end match neg return Integers.Int64.int with
                        | true => q
                        | false => u
                        end match neg return Integers.Int64.int with
                            | true => r
                            | false => v
                            end
  match neg return Integers.Int64.int with
  | true => Integers.Int64.neg u
  | false => q
  end match neg return Integers.Int64.int with
      | true => Integers.Int64.neg v
      | false => r
      end
  (jet_secp_div62_limit.div62_mask neg match neg return BinNums.Z with
                                       | true => BinInt.Z.opp eta
                                       | false => eta
                                       end i)
     : forall (_ : Maps.PTree.tree Values.val) (_ : bool) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int), Maps.PTree.tree Values.val

