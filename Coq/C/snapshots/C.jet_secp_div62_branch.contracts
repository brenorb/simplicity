Arguments div62_swap_temps le eta f g u v q r
### C.jet_secp_div62_branch.div62_branch_entry
div62_branch_entry =
fun (le : Maps.PTree.tree Values.val) (neg : bool) (eta : BinNums.Z) (f g u v q r : Integers.Int64.int) =>
match neg return (Maps.PTree.tree Values.val) with
| true => div62_swap_temps le (Integers.Int64.repr eta) f g u v q r
| false => le
end
     : forall (_ : Maps.PTree.tree Values.val) (_ : bool) (_ : BinNums.Z) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
