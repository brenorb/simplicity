                       (@Maps.PTree.set Values.val jets_secp._tmp (Values.Vlong f)
                          (@Maps.PTree.set Values.val jets_secp._eta (Values.Vlong (Integers.Int64.neg eta)) le)))))))))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
