### C.jet_bitcoin_raw_env.bitcoin_ext_raw_projection
@bitcoin_ext_raw_projection
     : forall (A B : Ty.Ty) (p : jet_bitcoin_ext_prim.BitcoinExt.t A B) (a : Ty.tySem A)
         (environment : raw_bitcoin_environment)
         (Hpath : le (@length Digest.hash256 (raw_tap_path environment))
                    (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq (option (Ty.tySem B))
         (@jet_bitcoin_ext_prim.BitcoinExt.sem A B p a (project_raw_environment environment Hpath))
         (@raw_ext_sem A B p a environment)
### C.jet_bitcoin_raw_env.raw_input_data
Variant raw_input_data : Set :=
    Build_raw_input_data : forall (_ : list Integers.Byte.int) (_ : option (list Integers.Byte.int))
                             (_ : list Integers.Byte.int), raw_input_data.

Arguments Build_raw_input_data raw_redeemed_script%list_scope raw_annex raw_script_sig%list_scope
### C.jet_bitcoin_raw_env.raw_bitcoin_environment
Variant raw_bitcoin_environment : Set :=
    Build_raw_bitcoin_environment : forall (raw_base : Bitcoin.Bitcoin.environment) (raw_inputs : list raw_input_data)
                                      (_ : @eq nat (@length raw_input_data raw_inputs)
                                             (@length Bitcoin.sigTxInput
                                                (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx raw_base))))
                                      (_ : Integers.Byte.int) (_ : list Digest.hash256) (_ : Digest.hash256),
                                    raw_bitcoin_environment.

Arguments Build_raw_bitcoin_environment raw_base raw_inputs%list_scope raw_inputs_length raw_leaf_version
  raw_tap_path%list_scope raw_internal_key
### C.jet_bitcoin_raw_env.put_bytes_le
put_bytes_le =
fun (width : nat) (value : BinNums.Z) =>
@List.map nat Integers.Byte.int
  (fun i : nat =>
   Integers.Byte.repr
     (BinInt.Z.div value
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))))
  (List.seq O width)
     : forall (_ : nat) (_ : BinNums.Z), list Integers.Byte.int

Arguments put_bytes_le width%nat_scope value%Z_scope
### C.jet_bitcoin_raw_env.put_compact_size
put_compact_size =
fun n : nat =>
let value : BinNums.Z := BinInt.Z.of_nat n in
match
  BinInt.Z.leb value
    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
  return (list Integers.Byte.int)
with
| true => @cons Integers.Byte.int (Integers.Byte.repr value) (@nil Integers.Byte.int)
| false =>
    match
      BinInt.Z.leb value
        (BinNums.Zpos
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))))))
      return (list Integers.Byte.int)
    with
    | true =>
        @cons Integers.Byte.int
          (Integers.Byte.repr
             (BinNums.Zpos
                (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
          (put_bytes_le (S (S O)) value)
    | false =>
        match
          BinInt.Z.leb value
            (BinNums.Zpos
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))))))))))
          return (list Integers.Byte.int)
        with
        | true =>
            @cons Integers.Byte.int
              (Integers.Byte.repr
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
              (put_bytes_le (S (S (S (S O)))) value)
        | false =>
            @cons Integers.Byte.int
              (Integers.Byte.repr
                 (BinNums.Zpos
                    (BinNums.xI
                       (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
              (put_bytes_le (S (S (S (S (S (S (S (S O)))))))) value)
        end
    end
end
     : forall _ : nat, list Integers.Byte.int

Arguments put_compact_size n%nat_scope
### C.jet_bitcoin_raw_env.put_raw_input
put_raw_input =
fun input : prod Bitcoin.sigTxInput raw_input_data =>
match input return (list Integers.Byte.int) with
| pair txi data =>
    @app Integers.Byte.int (Bitcoin.putOutpoint (Bitcoin.sigTxiPreviousOutpoint txi))
      (@app Integers.Byte.int (put_compact_size (@length Integers.Byte.int (raw_script_sig data)))
         (@app Integers.Byte.int (raw_script_sig data) (Bitcoin.putInt32le (Bitcoin.sigTxiSequence txi))))
end
     : forall _ : prod Bitcoin.sigTxInput raw_input_data, list Integers.Byte.int

Arguments put_raw_input input
### C.jet_bitcoin_raw_env.put_raw_output
put_raw_output =
fun output : Bitcoin.txOutput =>
@app Integers.Byte.int (Bitcoin.putInt64le (Bitcoin.txoValue output))
  (@app Integers.Byte.int (put_compact_size (@length Integers.Byte.int (Bitcoin.txoScript output)))
     (Bitcoin.txoScript output))
     : forall _ : Bitcoin.txOutput, list Integers.Byte.int

Arguments put_raw_output output
### C.jet_bitcoin_raw_env.put_no_witness_transaction
put_no_witness_transaction =
fun environment : raw_bitcoin_environment =>
let tx : Bitcoin.sigTx := Bitcoin.Bitcoin.envTx (raw_base environment) in
@app Integers.Byte.int (Bitcoin.putInt32le (Bitcoin.sigTxVersion tx))
  (@app Integers.Byte.int (put_compact_size (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn tx)))
     (@app Integers.Byte.int
        (@List.concat Integers.Byte.int
           (@List.map (prod Bitcoin.sigTxInput raw_input_data) (list Integers.Byte.int) put_raw_input
              (@List.combine Bitcoin.sigTxInput raw_input_data (Bitcoin.sigTxIn tx) (raw_inputs environment))))
        (@app Integers.Byte.int (put_compact_size (@length Bitcoin.txOutput (Bitcoin.sigTxOut tx)))
           (@app Integers.Byte.int
              (@List.concat Integers.Byte.int
                 (@List.map Bitcoin.txOutput (list Integers.Byte.int) put_raw_output (Bitcoin.sigTxOut tx)))
              (Bitcoin.putInt32le (Bitcoin.sigTxLock tx))))))
     : forall _ : raw_bitcoin_environment, list Integers.Byte.int

Arguments put_no_witness_transaction environment
### C.jet_bitcoin_raw_env.raw_transaction_id
raw_transaction_id =
fun environment : raw_bitcoin_environment =>
Digest.byteStringHash (Digest.hash256_to_bytelist (Digest.byteStringHash (put_no_witness_transaction environment)))
     : forall _ : raw_bitcoin_environment, Digest.hash256

Arguments raw_transaction_id environment
### C.jet_bitcoin_raw_env.project_raw_environment
project_raw_environment =
fun (environment : raw_bitcoin_environment)
  (Hpath : le (@length Digest.hash256 (raw_tap_path environment))
             (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))) =>
jet_bitcoin_ext_prim.Build_ext_environment (raw_base environment)
  (@List.map raw_input_data Digest.hash256 (fun i : raw_input_data => Digest.byteStringHash (raw_redeemed_script i))
     (raw_inputs environment))
  (@List.map raw_input_data (option Digest.hash256)
     (fun i : raw_input_data => @option_map (list Integers.Byte.int) Digest.hash256 Digest.byteStringHash (raw_annex i))
     (raw_inputs environment))
  (@List.map raw_input_data Digest.hash256 (fun i : raw_input_data => Digest.byteStringHash (raw_script_sig i))
     (raw_inputs environment)) (Integers.Byte.unsigned (raw_leaf_version environment)) (raw_tap_path environment)
  (raw_internal_key environment) (raw_transaction_id environment)
  (@eq_ind_r nat (@length raw_input_data (raw_inputs environment))
     (fun n : nat =>
      @eq nat n (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx (raw_base environment)))))
     (raw_inputs_length environment)
     (@length Digest.hash256
        (@List.map raw_input_data Digest.hash256
           (fun i : raw_input_data => Digest.byteStringHash (raw_redeemed_script i)) (raw_inputs environment)))
     (@List.map_length raw_input_data Digest.hash256
        (fun i : raw_input_data => Digest.byteStringHash (raw_redeemed_script i)) (raw_inputs environment)))
  (@eq_ind_r nat (@length raw_input_data (raw_inputs environment))
     (fun n : nat =>
      @eq nat n (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx (raw_base environment)))))
     (raw_inputs_length environment)
     (@length (option Digest.hash256)
        (@List.map raw_input_data (option Digest.hash256)
           (fun i : raw_input_data =>
            @option_map (list Integers.Byte.int) Digest.hash256 Digest.byteStringHash (raw_annex i))
           (raw_inputs environment)))
     (@List.map_length raw_input_data (option Digest.hash256)
        (fun i : raw_input_data =>
         @option_map (list Integers.Byte.int) Digest.hash256 Digest.byteStringHash (raw_annex i))
        (raw_inputs environment)))
  (@eq_ind_r nat (@length raw_input_data (raw_inputs environment))
     (fun n : nat =>
      @eq nat n (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx (raw_base environment)))))
     (raw_inputs_length environment)
     (@length Digest.hash256
        (@List.map raw_input_data Digest.hash256 (fun i : raw_input_data => Digest.byteStringHash (raw_script_sig i))
           (raw_inputs environment)))
     (@List.map_length raw_input_data Digest.hash256
        (fun i : raw_input_data => Digest.byteStringHash (raw_script_sig i)) (raw_inputs environment)))
  (Integers.Byte.unsigned_range (raw_leaf_version environment)) Hpath
     : forall (environment : raw_bitcoin_environment)
         (_ : le (@length Digest.hash256 (raw_tap_path environment))
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))),
       jet_bitcoin_ext_prim.ext_environment

Arguments project_raw_environment environment Hpath
### C.jet_bitcoin_raw_env.raw_ext_sem
raw_ext_sem =
fun (A B : Ty.Ty) (p : jet_bitcoin_ext_prim.BitcoinExt.t A B) (a : Ty.tySem A) (environment : raw_bitcoin_environment)
=>
let cast : forall (C : Ty.Ty) (_ : option (Ty.tySem C)), Ty.tySem (Ty.Sum Ty.Unit C) :=
  fun (C : Ty.Ty) (x : option (Ty.tySem C)) =>
  match x return (Ty.tySem (Ty.Sum Ty.Unit C)) with
  | Some c => @inr unit (Ty.tySem C) c
  | None =>
      @inl unit
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
            end) C) tt
  end in
match p in (jet_bitcoin_ext_prim.BitcoinExt.prim A0 B0) return (forall _ : Ty.tySem A0, option (Ty.tySem B0)) with
| jet_bitcoin_ext_prim.BitcoinExt.CurrentIndex =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
         (BinInt.Z.of_nat (Bitcoin.Bitcoin.envIx (raw_base environment))))
| jet_bitcoin_ext_prim.BitcoinExt.InputScriptHash =>
    fun i : Ty.tySem (Word.Word (S (S (S (S (S O)))))) =>
    @Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map raw_input_data (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun data : raw_input_data => Word.from_hash256 (Digest.byteStringHash (raw_redeemed_script data)))
            (@List.nth_error raw_input_data (raw_inputs environment)
               (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i)))))
| jet_bitcoin_ext_prim.BitcoinExt.InputAnnexHash =>
    fun i : Ty.tySem (Word.Word (S (S (S (S (S O)))))) =>
    @Some (sum unit (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
      match
        @List.nth_error raw_input_data (raw_inputs environment)
          (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))
        return (sum unit (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
      with
      | Some data =>
          @inr unit (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
               (@option_map (list Integers.Byte.int) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (fun bytes : list Integers.Byte.int => Word.from_hash256 (Digest.byteStringHash bytes))
                  (raw_annex data)))
      | None => @inl unit (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
      end
| jet_bitcoin_ext_prim.BitcoinExt.InputScriptSigHash =>
    fun i : Ty.tySem (Word.Word (S (S (S (S (S O)))))) =>
    @Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map raw_input_data (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun data : raw_input_data => Word.from_hash256 (Digest.byteStringHash (raw_script_sig data)))
            (@List.nth_error raw_input_data (raw_inputs environment)
               (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i)))))
| jet_bitcoin_ext_prim.BitcoinExt.TapleafVersion =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S O))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O)))) (Integers.Byte.unsigned (raw_leaf_version environment)))
| jet_bitcoin_ext_prim.BitcoinExt.Tappath =>
    fun i : Ty.tySem (Word.Word (S (S (S O)))) =>
    @Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) Word.from_hash256
            (@List.nth_error Digest.hash256 (raw_tap_path environment)
               (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) i)))))
| jet_bitcoin_ext_prim.BitcoinExt.InternalKey =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 (raw_internal_key environment))
| jet_bitcoin_ext_prim.BitcoinExt.TransactionId =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 (raw_transaction_id environment))
end a
     : forall (A B : Ty.Ty) (_ : jet_bitcoin_ext_prim.BitcoinExt.t A B) (_ : Ty.tySem A) (_ : raw_bitcoin_environment),
       option (Ty.tySem B)

Arguments raw_ext_sem {A B}%ty_scope p a environment
