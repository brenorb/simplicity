### C.jet_elements_current_index_local.elements_current_index_env_rep
elements_current_index_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : jet_elements_prim.Elements.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Integers.Int64.int
        (fun index : Integers.Int64.int =>
         and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
           (and (BinInt.Z.le BinNums.Z0 ebase)
              (and
                 (BinInt.Z.le
                    (BinInt.Z.add ebase
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                    Integers.Ptrofs.max_unsigned)
                 (and
                    (@eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m be
                          (BinInt.Z.add ebase
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                       (@Some Values.val (Values.Vlong index)))
                    (@eq BinNums.Z (Integers.Int64.unsigned index)
                       (BinInt.Z.of_nat (jet_elements_prim.Elements.envIx environment)))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env), Prop

Arguments elements_current_index_env_rep m env environment
