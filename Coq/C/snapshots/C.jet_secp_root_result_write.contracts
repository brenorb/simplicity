         (fun mt : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets.f_writeBit)
                  (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                     (@cons Values.val
