         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val (Values.Vlong value))),
       Clight.eval_expr jet_secp_linkage.secp_ge Clight.empty_env le m (u128_field jets_secp._hi) (Values.Vlong value)
