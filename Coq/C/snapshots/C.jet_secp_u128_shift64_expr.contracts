### C.jet_secp_u128_shift64_expr.u128_field_lvalue
u128_field_lvalue
     : forall (m : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (b : Values.block) (fld : AST.ident)
         (off : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : or (and (@eq AST.ident fld jets_secp._lo) (@eq BinNums.Z off BinNums.Z0))
                (and (@eq AST.ident fld jets_secp._hi)
                   (@eq BinNums.Z off (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))),
       Clight.eval_lvalue jet_secp_linkage.secp_ge Clight.empty_env le m (u128_field fld) b
         (Integers.Ptrofs.add Integers.Ptrofs.zero (Integers.Ptrofs.repr off)) Ctypes.Full
