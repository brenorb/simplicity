### C.jet_secp_mixed_equal_ratio_slice.mixed_equal_slice_frame
mixed_equal_slice_frame =
fun (bp bi br : Values.block) (base : BinNums.Z) (b : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block b bp))
  (and (not (@eq Values.block b bi))
     (or (not (@eq Values.block b br))
        (or (BinInt.Z.lt pos base)
           (BinInt.Z.le
              (BinInt.Z.add base
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments mixed_equal_slice_frame bp bi br base%Z_scope b pos%Z_scope
