                                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))
           (Integers.Int.unsigned i))
  end
     : forall (_ : list Integers.Int.int) (_ : BinNums.Z), BinNums.Z

