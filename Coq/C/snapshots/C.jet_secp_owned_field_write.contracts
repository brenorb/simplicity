### C.jet_secp_owned_field_write.eval_owned_field_write
eval_owned_field_write
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (written0 : bool) (outs0 : list BitMachine.Cell)
         (m : Memory.Mem.mem) (br : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le
                (BinInt.Z.add (BinInt.Z.of_nat (@length BitMachine.Cell outs0))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (jet_secp_frame.extA m0 bd bw bi br))
         (_ : jet_frame_inv.finv m0 bd base bw edge cursor N bi m written0 outs0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                  (@app BitMachine.Cell outs0
                     (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (jet_secp_rescale_literal.rescale_field_output w))))
               (and
                  (Memory.Mem.range_perm mf br BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) =>
                      and (not (@eq Values.block b br)) (not (jet_secp_frame.extA m0 bd bw bi b))) m mf))))
