### C.jet_guarantees.one8_context_guarantees
one8_context_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : jet_bitmachine_rep.bm_layout) (ctx : BitMachine.Context)
         (a : Ty.tySem Ty.Unit),
       let s0 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState (@Translate.encode Ty.Unit a)
              (BitMachine.newWriteFrame (Translate.bitSize (Word.Word (S (S (S O))))))) in
       let s1 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState (@Translate.encode Ty.Unit a)
              (BitMachine.fullWriteFrame
                 (@Translate.encode (Word.Word (S (S (S O)))) (@jet_spec.one8_spec Alg.CoreFunSem a)))) in
       forall (_ : jet_bitmachine_rep.bm_rep m L s0) (_ : jet_bitmachine_rep.bm_separated L s0)
         (_ : jet_bitmachine_rep.active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function jets.f_simplicity_one_8) (jet_bitmachine_rep.jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (jet_bitmachine_rep.bm_rep mf L s1)
               (BitMachine.runProgram (@jet_spec.one8_spec Translate.Naive.translate) (BitMachine.Running s0)
                  (BitMachine.Running s1))))
