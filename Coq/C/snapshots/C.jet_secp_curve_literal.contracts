               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y)
               (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt)))
### C.jet_secp_curve_literal.literal_curve_cube_numeric
literal_curve_cube_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_rescale_literal.literal_fe_cube Alg.CoreFunSem x))
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)) jet_secp_fe_math.feP)
### C.jet_secp_curve_literal.literal_curve_negate_numeric
literal_curve_negate_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem x))
         (BinInt.Z.modulo
            (BinInt.Z.sub jet_secp_fe_math.feP
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)) jet_secp_fe_math.feP)
### C.jet_secp_curve_literal.literal_curve_zero_numeric
literal_curve_zero_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem x))
         (BinInt.Z.eqb
            (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
               jet_secp_fe_math.feP) BinNums.Z0)
### C.jet_secp_curve_literal.curve_mod_add_neg_eq
curve_mod_add_neg_eq
     : forall a b k : BinNums.Z,
       @eq bool
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (BinInt.Z.add k
                  (BinInt.Z.add (BinInt.Z.modulo a jet_secp_fe_math.feP)
                     (BinInt.Z.modulo (BinInt.Z.sub jet_secp_fe_math.feP (BinInt.Z.modulo b jet_secp_fe_math.feP))
                        jet_secp_fe_math.feP))) jet_secp_fe_math.feP) BinNums.Z0)
         (BinInt.Z.eqb (BinInt.Z.modulo b jet_secp_fe_math.feP)
            (BinInt.Z.modulo (BinInt.Z.add a k) jet_secp_fe_math.feP))
### C.jet_secp_curve_literal.literal_ge_curve_numeric
literal_ge_curve_numeric
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (Bit.toBool
            (@literal_ge_is_on_curve Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y)))
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)) jet_secp_fe_math.feP)
            (BinInt.Z.modulo
               (BinInt.Z.add
                  (BinInt.Z.mul
                     (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
                  (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) jet_secp_fe_math.feP))
### C.jet_secp_curve_literal.curve_square_parametric
curve_square_parametric
