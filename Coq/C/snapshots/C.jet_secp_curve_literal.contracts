### C.jet_secp_curve_literal.literal_gej_is_on_curve_parametric
literal_gej_is_on_curve_parametric
     : @Alg.Core.Parametric
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit) (@literal_gej_is_on_curve)
### C.jet_secp_curve_literal.literal_ge_is_on_curve_parametric
literal_ge_is_on_curve_parametric
     : @Alg.Core.Parametric
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Sum Ty.Unit Ty.Unit) (@literal_ge_is_on_curve)
### C.jet_secp_curve_literal.curve_seven_word
curve_seven_word =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
  (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))
### C.jet_secp_curve_literal.literal_gej_is_on_curve
literal_gej_is_on_curve =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp
  (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Sum Ty.Unit Ty.Unit) term
  (@Alg.Core.Combinators.pair
     (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Alg.Core.Combinators.comp
        (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.pair
           (Ty.Prod
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
           (@Alg.Core.Combinators.comp
              (Ty.Prod
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O)))))))))) Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              term
              (@Alg.Core.Combinators.unit
                 (Ty.Prod
                    (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 term) (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) curve_seven_word term))
           (@Alg.Core.Combinators.comp
              (Ty.Prod
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
              (@Alg.Core.Combinators.drop
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                 (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))
              (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                 (@jet_secp_rescale_literal.literal_fe_cube term) (@jet_secp_square_execution.literal_fe_square term))))
        (@jet_secp_negate_literal_contract.literal_fe_multiply term))
     (@Alg.Core.Combinators.comp
        (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.take
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
           (@Alg.Core.Combinators.pair
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
              (@Alg.Core.Combinators.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                 (@jet_secp_rescale_literal.literal_fe_cube term))
              (@Alg.Core.Combinators.comp
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                 (@Alg.Core.Combinators.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                    (@jet_secp_square_execution.literal_fe_square term))
                 (@jet_secp_negate_literal_contract.literal_fe_negate term))))
        (@jet_secp_literal_add_program.literal_fe_add term)))
  (@Alg.Core.Combinators.comp
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit) term
     (@jet_secp_literal_add_program.literal_fe_add term) (@jet_secp_canonical_zero.canonical_fe_is_zero term))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit)

Arguments literal_gej_is_on_curve {term}
### C.jet_secp_curve_literal.literal_ge_is_on_curve
literal_ge_is_on_curve =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit) term
  (@Alg.Core.Combinators.pair
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Alg.Core.Combinators.iden
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term)
     (@Alg.Core.Combinators.comp
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.unit
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term)
        (@jet_secp_literal_add_program.literal_fe_one256 term))) (@literal_gej_is_on_curve term)
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Sum Ty.Unit Ty.Unit)

Arguments literal_ge_is_on_curve {term}
