### C.jet_secp_curve_literal.curve_seven_value
curve_seven_value
     : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) curve_seven_word)
         (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))
### C.jet_secp_curve_literal.literal_gej_curve_step
literal_gej_curve_step
     : forall x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (@literal_gej_is_on_curve Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))
         (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
            (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) curve_seven_word
                        (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem
                           (@jet_secp_rescale_literal.literal_fe_cube Alg.CoreFunSem z))))
                  (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (@jet_secp_rescale_literal.literal_fe_cube Alg.CoreFunSem x)
                        (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem
                           (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem y)))))))
### C.jet_secp_curve_literal.literal_ge_curve_step
literal_ge_curve_step
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
