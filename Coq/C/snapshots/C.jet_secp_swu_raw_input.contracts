### C.jet_secp_swu_raw_input.swu_raw_matches
swu_raw_matches
     : forall t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       jet_secp_root_chain_numeric.root_words_match (swu_raw_words t) t
### C.jet_secp_swu_raw_input.swu_digest_value
swu_digest_value
     : forall (bytes : list BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes),
       @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) (swu_digest_word bytes))
         (jet_secp_fe_math.be_val bytes)
### C.jet_secp_swu_raw_input.swu_digest_input
swu_digest_input
     : forall (bytes : list BinNums.Z) (m : Memory.Mem.mem) (bi : Values.block)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes)
         (_ : jet_secp_fe_nv.fe_at m bi BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of (jet_secp_fe_math.be_val bytes)))),
       jet_secp_fe_nv.fe_at m bi BinNums.Z0
         (jet_secp_multiply_normalize_bridge.words5 (swu_raw_words (swu_digest_word bytes)))
### C.jet_secp_swu_raw_input.swu_raw_odd
swu_raw_odd
     : forall t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool (jet_secp_field_odd_words.field_words_odd (swu_raw_words t))
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) t) BinNums.Z0)
### C.jet_secp_swu_raw_input.swu_raw_accepted_output
swu_raw_accepted_output
     : forall (t : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) t)
                jet_secp_fe_math.feP),
       @eq
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (jet_secp_swu_word_parity.swu_words_literal_output (swu_raw_words t) t)
         (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem t)
### C.jet_secp_swu_raw_input.eval_swu_raw_function
eval_swu_raw_function
     : forall (t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bp bi : Values.block)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : not (@eq Values.block bp bi)) (_ : jet_secp_swu_startup.swu_startup m)
         (_ : jet_secp_fe_nv.fe_at m bi BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (swu_raw_words t)))
         (_ : Memory.Mem.range_perm m bi BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun x : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun y : forall _ : nat, Integers.Int64.int =>
                and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                     (@Ctypes.Internal Clight.function jets_secp.f_shallue_van_de_woestijne)
                     (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bi Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                     Values.Vundef)
                  (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                     (and
                        (jet_secp_fe_nv.fe_at mf bp
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           (jet_secp_multiply_normalize_bridge.words5 y))
                        (and
                           (@eq (option Values.val)
                              (Memory.Mem.load AST.Mint32 mf bp
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                              (@Some Values.val (Values.Vint Integers.Int.zero)))
                           (and
                              (Memory.Mem.range_perm mf bi BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bp BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and (jet_secp_square_columns.square_input_bounds x)
                                    (and (jet_secp_square_columns.square_input_bounds y)
                                       (and
                                          (@eq
                                             (prod (Ty.tySem (Word.Word (S (S (S (S (S (S ...))))))))
                                                (Ty.tySem (Word.Word (S (S (S (S (S (S ...)))))))))
                                             (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S ...))))))))
                                                (Ty.tySem (Word.Word (S (S (S (S (S (S ...))))))))
                                                (jet_secp_rescale_literal.rescale_field_output x)
                                                (jet_secp_rescale_literal.rescale_field_output y))
                                             (jet_secp_swu_word_parity.swu_words_literal_output (swu_raw_words t) t))
                                          (and (jet_secp_swu_startup.swu_startup mf)
                                             (and
                                                (jet_sx_mem.lframe
                                                   (fun (b : Values.block) (_ : BinNums.Z) =>
                                                    and (not (@eq Values.block b bp)) (not (@eq Values.block b bi))) m
                                                   mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))))))))))
### C.jet_secp_swu_raw_input.swu_raw_words
swu_raw_words =
fun t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
jet_secp_b32_exec.limb_rho (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) t)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : nat), Integers.Int64.int

Arguments swu_raw_words t n%nat_scope
### C.jet_secp_swu_raw_input.swu_digest_word
swu_digest_word =
fun bytes : list BinNums.Z =>
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) (jet_secp_fe_math.be_val bytes)
     : forall _ : list BinNums.Z, Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))))

Arguments swu_digest_word bytes%list_scope
