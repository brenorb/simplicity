### C.jet_secp_scalar_negate_storage.scalar_negate_output_limbs_numeric
scalar_negate_output_limbs_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Integers.Int64.int)
         (@List.map jet_sx_expr.sx Integers.Int64.int
            (fun x : jet_sx_expr.sx => jet_sx_expr.il (jet_sx_expr.den rho layout x))
            jet_secp_scalar_negate_exec.scalar_negate_limbs)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
               (jet_secp_scalar_negate_numeric.scalar_negate_output_value rho layout)))
### C.jet_secp_scalar_negate_storage.scalar_negate_output_scalar_at
scalar_negate_output_scalar_at
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout (jet_sx_eval.sregs jet_secp_scalar_negate_run.scalar_negate_state) m),
       and
         (jet_secp_scalar_get_b32_storage.scalar_at m (jet_sx_state.blk layout O) (jet_sx_state.bas layout O)
            (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
               (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                  (jet_secp_scalar_negate_numeric.scalar_negate_output_value rho (jet_sx_state.lay layout)))))
         (Memory.Mem.range_perm m (jet_sx_state.blk layout O) BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
### C.jet_secp_scalar_negate_storage.eval_scalar_negate_numeric_owned
eval_scalar_negate_numeric_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout jet_secp_scalar_writer_run.scalar_writer_initial_regs m)
         (_ : and (BinInt.Z.le BinNums.Z0 (jet_secp_scalar_overflow_numeric.scalar_limb_value rho))
                (BinInt.Z.lt (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)
                   jet_secp_canonical_scalar.canonical_group_order)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf (jet_sx_state.blk layout O) (jet_sx_state.bas layout O)
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo (BinInt.Z.opp (jet_secp_scalar_overflow_numeric.scalar_limb_value rho))
                           jet_secp_canonical_scalar.canonical_group_order))))
               (and
                  (Memory.Mem.range_perm mf (jet_sx_state.blk layout O) BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (jet_sx_state.foot layout
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape jet_secp_scalar_writer_run.scalar_writer_initial_regs) b ofs)) m mf))))
### C.jet_secp_scalar_negate_storage.scalar_writer_initial_rep_from_negate
scalar_writer_initial_rep_from_negate
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout (jet_sx_eval.sregs jet_secp_scalar_negate_run.scalar_negate_state) m),
       jet_sx_state.rep
         (jet_secp_scalar_get_b32_numeric.scalar_limb_rho
            (jet_secp_scalar_negate_numeric.scalar_negate_output_value rho (jet_sx_state.lay layout)))
         (@cons (prod Values.block BinNums.Z)
            (@pair Values.block BinNums.Z (jet_sx_state.blk layout O) (jet_sx_state.bas layout O))
            (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_writer_run.scalar_writer_initial_regs m
