### C.jet_full_decrement8_exec.full_decrement8_borrow_expr
full_decrement8_borrow_expr =
Clight.Ebinop Cop.Olt
  (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
     (Clight.Etempvar jets._x Ctypesdefs.tuchar) Ctypesdefs.tuint)
  (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
     (Clight.Etempvar jets._z Ctypesdefs.tbool) Ctypesdefs.tuint) Ctypesdefs.tint
     : Clight.expr
### C.jet_full_decrement8_exec.full_decrement8_payload_expr
full_decrement8_payload_expr =
Clight.Ecast
  (Clight.Ebinop Cop.Osub
     (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
        (Clight.Etempvar jets._x Ctypesdefs.tuchar) Ctypesdefs.tuint) (Clight.Etempvar jets._z Ctypesdefs.tbool)
     Ctypesdefs.tuint) Ctypesdefs.tuchar
     : Clight.expr
