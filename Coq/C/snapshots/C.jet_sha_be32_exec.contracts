### C.jet_sha_be32_exec.be_words_nth
be_words_nth
     : forall (i : nat) (bs : list Integers.Int.int)
         (_ : lt (Nat.add (Nat.mul (S (S (S (S O)))) i) (S (S (S O)))) (@length Integers.Int.int bs)),
       @eq Integers.Int.int (@List.nth Integers.Int.int i (jet_sha_ctx8_model.be_words bs) Integers.Int.zero)
         (jet_sha_ctx8_model.be32 (@List.nth Integers.Int.int (Nat.mul (S (S (S (S O)))) i) bs Integers.Int.zero)
            (@List.nth Integers.Int.int (Nat.add (Nat.mul (S (S (S (S O)))) i) (S O)) bs Integers.Int.zero)
            (@List.nth Integers.Int.int (Nat.add (Nat.mul (S (S (S (S O)))) i) (S (S O))) bs Integers.Int.zero)
