### C.jet_sha_be32_exec.lor_shift8
lor_shift8
     : forall (hi lo : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 hi)
         (_ : and (BinInt.Z.le BinNums.Z0 lo)
                (BinInt.Z.lt lo
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @eq BinNums.Z
         (BinInt.Z.lor (BinInt.Z.shiftl hi (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) lo)
         (BinInt.Z.add
            (BinInt.Z.mul hi
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))) lo)
