### C.jet_sha_be32_exec.ptr_byte_offset
ptr_byte_offset
     : forall (o : Integers.Ptrofs.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))
         (_ : BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned o) i) Integers.Ptrofs.max_unsigned),
       @eq BinNums.Z
         (Integers.Ptrofs.unsigned
            (Integers.Ptrofs.add o
               (Integers.Ptrofs.mul (Integers.Ptrofs.repr (BinNums.Zpos BinNums.xH))
                  (Integers.Ptrofs.of_ints (Integers.Int.repr i))))) (BinInt.Z.add (Integers.Ptrofs.unsigned o) i)
### C.jet_sha_be32_exec.eval_sha_ReadBE32
