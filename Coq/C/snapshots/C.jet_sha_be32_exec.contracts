### C.jet_sha_be32_exec.c_be32
c_be32 =
fun x1 x2 x3 x4 : Integers.Int.int =>
Integers.Int.or
  (Integers.Int.or
     (Integers.Int.or
        (Integers.Int.shl x1
           (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
        (Integers.Int.shl
           (Integers.Int.and x2
              (Integers.Int.repr
                 (BinNums.Zpos
                    (BinNums.xI
                       (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
           (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (Integers.Int.shl
        (Integers.Int.and x3
           (Integers.Int.repr
              (BinNums.Zpos
                 (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
        (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  (Integers.Int.and x4
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int),
       Integers.Int.int

Arguments c_be32 x1 x2 x3 x4
### C.jet_sha_be32_exec.be32_le
be32_le =
fun (b : Values.block) (o : Integers.Ptrofs.int) (x1 x2 x3 x4 : Integers.Int.int) =>
@Maps.PTree.set Values.val jets_sha._t'4 (Values.Vint x4)
  (@Maps.PTree.set Values.val jets_sha._t'3 (Values.Vint x3)
     (@Maps.PTree.set Values.val jets_sha._t'2 (Values.Vint x2)
        (@Maps.PTree.set Values.val jets_sha._t'1 (Values.Vint x1)
           (@Maps.PTree.set Values.val jets_sha._b (Values.Vptr b o)
              (Clight.create_undef_temps (Clight.fn_temps jets_sha.f_ReadBE32))))))
     : forall (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Int.int) (_ : Integers.Int.int)
         (_ : Integers.Int.int) (_ : Integers.Int.int), Clight.temp_env

