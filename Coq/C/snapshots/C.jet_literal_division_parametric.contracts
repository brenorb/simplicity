### C.jet_literal_division_parametric.literal_builder_parametric
literal_builder_parametric
     : forall (n : nat) (term1 term2 : Alg.Core.Algebra) (R : Alg.Core.Parametric.Rel term1 term2)
         (rec1 : Alg.Core.domain term1 (Ty.Prod (Word.Word (S n)) (Word.Word n)) (Word.Word (S n)))
         (rec2 : Alg.Core.domain term2 (Ty.Prod (Word.Word (S n)) (Word.Word n)) (Word.Word (S n)))
         (_ : @Alg.Core.Parametric.rel term1 term2 R (Ty.Prod (Word.Word (S n)) (Word.Word n))
                (Word.Word (S n)) rec1 rec2),
       @Alg.Core.Parametric.rel term1 term2 R (Ty.Prod (Ty.Prod (Word.Word (S n)) (Word.Word n)) (Word.Word (S n)))
         (Ty.Prod (Word.Word n) (Word.Word (S n)))
         (@jet_literal_division_add.literal_div3n2n_word_builder n term1 rec1)
         (@jet_literal_division_add.literal_div3n2n_word_builder n term2 rec2)
### C.jet_literal_division_parametric.literal_div2n1n_parametric
literal_div2n1n_parametric
     : forall n : nat,
       @Alg.Core.Parametric (Ty.Prod (Word.Word (S n)) (Word.Word n)) (Word.Word (S n))
         (@jet_literal_division_add.literal_div2n1n_word_spec n)
### C.jet_literal_division_parametric.literal_div_mod_parametric
literal_div_mod_parametric
     : forall n : nat,
       @Alg.Core.Parametric (Word.Word (S n)) (Word.Word (S n)) (@jet_literal_division_add.literal_div_mod_word_spec n)
### C.jet_literal_division_parametric.literal_modulo_parametric
literal_modulo_parametric
     : forall n : nat,
       @Alg.Core.Parametric (Word.Word (S n))
         ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
             match n0 return Ty.Ty with
             | O => X
             | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
             end) (Ty.Sum Ty.Unit Ty.Unit) n) (@jet_literal_division_add.literal_modulo_word_spec n)
### C.jet_literal_division_parametric.literal_fe_normalize512_parametric
literal_fe_normalize512_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@jet_secp_negate_literal_contract.literal_fe_normalize512)
### C.jet_literal_division_parametric.literal_fe_multiply_parametric
literal_fe_multiply_parametric
     : @Alg.Core.Parametric
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@jet_secp_negate_literal_contract.literal_fe_multiply)
### C.jet_literal_division_parametric.literal_fe_negate_parametric
literal_fe_negate_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@jet_secp_negate_literal_contract.literal_fe_negate)
