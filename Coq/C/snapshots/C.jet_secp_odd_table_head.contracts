### C.jet_secp_odd_table_head.odd_table_head_source
odd_table_head_source
     : @eq Clight.statement odd_table_head
         (Clight.Ssequence (Clight.Sloop Clight.Sskip Clight.Sbreak)
            (Clight.Ssequence
               (jet_secp_curve_statements.curve_call jets_secp._secp256k1_gej_double_var
                  jets_secp.f_secp256k1_gej_double_var (@None AST.ident)
                  (@cons Clight.expr (odd_table_local_point jets_secp._d)
                     (@cons Clight.expr
                        (Clight.Etempvar jets_secp._a (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
                        (@cons Clight.expr
                           (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
                              (Ctypesdefs.tptr Ctypesdefs.tvoid)) (@nil Clight.expr)))))
               (Clight.Ssequence
                  (jet_secp_curve_statements.curve_call jets_secp._secp256k1_ge_set_xy jets_secp.f_secp256k1_ge_set_xy
                     (@None AST.ident)
                     (@cons Clight.expr
                        (Clight.Eaddrof (Clight.Evar jets_secp._d_ge jet_secp_curve_statements.curve_ge_type)
                           (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type))
                        (@cons Clight.expr (odd_table_local_field_address jets_secp._d jets_secp._x)
                           (@cons Clight.expr (odd_table_local_field_address jets_secp._d jets_secp._y)
                              (@nil Clight.expr)))))
                  (Clight.Ssequence
                     (jet_secp_curve_statements.curve_call jets_secp._secp256k1_ge_set_gej_zinv
                        jets_secp.f_secp256k1_ge_set_gej_zinv (@None AST.ident)
                        (@cons Clight.expr odd_table_first_entry
                           (@cons Clight.expr
                              (Clight.Etempvar jets_secp._a
                                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
                              (@cons Clight.expr (odd_table_local_field_address jets_secp._d jets_secp._z)
                                 (@nil Clight.expr))))) Clight.Sskip))))
### C.jet_secp_odd_table_head.eval_odd_table_local_field
eval_odd_table_local_field
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (name : BinNums.positive) (fid : AST.ident) (delta : BinNums.Z)
         (b : Values.block)
         (_ : @List.In (prod AST.ident BinNums.Z) (@pair AST.ident BinNums.Z fid delta)
                (@cons (prod AST.ident BinNums.Z) (@pair AST.ident BinNums.Z jets_secp._x BinNums.Z0)
                   (@cons (prod AST.ident BinNums.Z)
                      (@pair AST.ident BinNums.Z jets_secp._y
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                      (@cons (prod AST.ident BinNums.Z)
                         (@pair AST.ident BinNums.Z jets_secp._z
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                         (@nil (prod AST.ident BinNums.Z))))))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) name e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))),
       Clight.eval_lvalue jet_secp_linkage.secp_ge e le m (odd_table_local_field name fid) b
         (Integers.Ptrofs.repr delta) Ctypes.Full
