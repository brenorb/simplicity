### C.jet_secp_odd_table_head.exec_odd_table_head
exec_odd_table_head
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (x y z : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (br bp bd bg : Values.block)
         (_ : @List.NoDup Values.block
                (@cons Values.block br
                   (@cons Values.block bp (@cons Values.block bd (@cons Values.block bg (@nil Values.block))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bd (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._d_ge e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bg jet_secp_curve_statements.curve_ge_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_double_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_set_xy e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_set_gej_zinv e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pre_a le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bg BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m odd_table_head Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5
                     (jet_secp_ge_zinv_arithmetic.ge_zinv_x_words x
                        (jet_secp_double_all_calls.double_output_z_words y z))))
               (and
                  (jet_secp_fe_nv.fe_at mf br
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5
                        (jet_secp_ge_zinv_arithmetic.ge_zinv_y_words y
                           (jet_secp_double_all_calls.double_output_z_words y z))))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf br
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                        (and
                           (jet_secp_fe_nv.fe_at mf bp
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 y))
                           (and
                              (jet_secp_fe_nv.fe_at mf bp
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (jet_secp_multiply_normalize_bridge.words5 z))
                              (and
                                 (@eq (option Values.val)
                                    (Memory.Mem.load AST.Mint32 mf bp
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                    (@Some Values.val (Values.Vint Integers.Int.zero)))
                                 (and
                                    (jet_secp_fe_nv.fe_at mf bg BinNums.Z0
                                       (jet_secp_multiply_normalize_bridge.words5
                                          (jet_secp_double_all_calls.double_output_x_words x y)))
                                    (and
                                       (jet_secp_fe_nv.fe_at mf bg
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                          (jet_secp_multiply_normalize_bridge.words5
                                             (jet_secp_double_all_calls.double_output_y_words x y)))
                                       (and
                                          (@eq (option Values.val)
                                             (Memory.Mem.load AST.Mint32 mf bg
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                             (@Some Values.val (Values.Vint Integers.Int.zero)))
                                          (and
                                             (jet_secp_fe_nv.fe_at mf bd
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                                (jet_secp_multiply_normalize_bridge.words5
                                                   (jet_secp_double_all_calls.double_output_z_words y z)))
                                             (and
                                                (jet_secp_square_columns.square_input_bounds
                                                   (jet_secp_ge_zinv_arithmetic.ge_zinv_x_words x
                                                      (jet_secp_double_all_calls.double_output_z_words y z)))
                                                (and
                                                   (jet_secp_square_columns.square_input_bounds
                                                      (jet_secp_ge_zinv_arithmetic.ge_zinv_y_words y
                                                         (jet_secp_double_all_calls.double_output_z_words y z)))
                                                   (and
                                                      (jet_secp_square_columns.square_input_bounds
                                                         (jet_secp_double_all_calls.double_output_x_words x y))
                                                      (and
                                                         (jet_secp_square_columns.square_input_bounds
                                                            (jet_secp_double_all_calls.double_output_y_words x y))
                                                         (and
                                                            (jet_secp_square_columns.square_input_bounds
                                                               (jet_secp_double_all_calls.double_output_z_words y z))
                                                            (and
                                                               (Memory.Mem.range_perm mf br BinNums.Z0
                                                                  (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))
                                                                  Memtype.Cur Memtype.Freeable)
                                                               (and
                                                                  (Memory.Mem.range_perm mf bp BinNums.Z0
                                                                     (BinNums.Zpos (BinNums.xO ...)) Memtype.Cur
                                                                     Memtype.Freeable)
                                                                  (and
                                                                     (Memory.Mem.range_perm mf bd BinNums.Z0
                                                                        (BinNums.Zpos ...) Memtype.Cur Memtype.Freeable)
                                                                     (and
                                                                        (Memory.Mem.range_perm mf bg BinNums.Z0 ...
                                                                           Memtype.Cur Memtype.Freeable)
                                                                        (and ... ...))))))))))))))))))))))
### C.jet_secp_odd_table_head.odd_table_head_statements
odd_table_head_statements =
@List.firstn Clight.statement (S (S (S (S O))))
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_ecmult_odd_multiples_table)))
     : list Clight.statement
### C.jet_secp_odd_table_head.odd_table_head
odd_table_head =
jet_secp_statement_prefix.statement_sequence odd_table_head_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_odd_table_head.odd_table_local_point
odd_table_local_point =
fun name : AST.ident =>
Clight.Eaddrof (Clight.Evar name (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
     : forall _ : AST.ident, Clight.expr

Arguments odd_table_local_point name
### C.jet_secp_odd_table_head.odd_table_local_field
odd_table_local_field =
fun name fid : AST.ident =>
Clight.Efield (Clight.Evar name (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)) fid
  jet_secp_curve_statements.curve_fe_type
     : forall (_ : AST.ident) (_ : AST.ident), Clight.expr

Arguments odd_table_local_field name fid
### C.jet_secp_odd_table_head.odd_table_local_field_address
odd_table_local_field_address =
fun name fid : AST.ident =>
Clight.Eaddrof (odd_table_local_field name fid) (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type)
     : forall (_ : AST.ident) (_ : AST.ident), Clight.expr

Arguments odd_table_local_field_address name fid
### C.jet_secp_odd_table_head.odd_table_first_entry
odd_table_first_entry =
Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._pre_a (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type))
  (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type)
     : Clight.expr
### C.jet_secp_odd_table_head.odd_table_head_frame
odd_table_head_frame =
fun (br bp bd bg b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b br))
  (and (not (@eq Values.block b bp)) (and (not (@eq Values.block b bd)) (not (@eq Values.block b bg))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments odd_table_head_frame br bp bd bg b _%Z_scope
