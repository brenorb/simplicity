### C.jet_elements_support_sha_compress_fun.interp_spine_run
interp_spine_run
     : forall (fuel : nat) (s : Clight.statement) (st : jet_elements_support_sha_interp.cst),
       @eq (option jet_elements_support_sha_interp.cst) (jet_elements_support_sha_interp.interp_spine fuel s st)
         (run (split_spine fuel s) st)
### C.jet_elements_support_sha_compress_fun.run_app
run_app
     : forall (l1 l2 : list Clight.statement) (st : jet_elements_support_sha_interp.cst),
       @eq (option jet_elements_support_sha_interp.cst) (run (@app Clight.statement l1 l2) st)
         match run l1 st return (option jet_elements_support_sha_interp.cst) with
         | Some st1 => run l2 st1
         | None => @None jet_elements_support_sha_interp.cst
         end
### C.jet_elements_support_sha_compress_fun.body_elems_eq
body_elems_eq
     : @eq (list Clight.statement)
         (split_spine (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
            (Clight.fn_body jets_elements.f_sha256_compression_portable)) body_elems
### C.jet_elements_support_sha_compress_fun.int_eq_true_eq
int_eq_true_eq
     : forall (a b : Integers.Int.int) (_ : @eq bool (Integers.Int.eq a b) true), @eq Integers.Int.int a b
### C.jet_elements_support_sha_compress_fun.int_mul_one'
int_mul_one'
     : forall (o x : Integers.Int.int) (_ : @eq bool (Integers.Int.eq o Integers.Int.one) true),
       @eq Integers.Int.int (Integers.Int.mul o x) x
### C.jet_elements_support_sha_compress_fun.rnd_function_c
rnd_function_c
     : forall (x0 x1 x2 x3 x4 x5 x6 x7 Kc K W wt : Integers.Int.int) (_ : @eq bool (Integers.Int.eq Kc K) true)
         (_ : @eq Integers.Int.int wt W),
       @eq SHA256.registers
         (SHA256.rnd_function
            (@cons Integers.Int.int x0
               (@cons Integers.Int.int x1
                  (@cons Integers.Int.int x2
                     (@cons Integers.Int.int x3
                        (@cons Integers.Int.int x4
                           (@cons Integers.Int.int x5
                              (@cons Integers.Int.int x6 (@cons Integers.Int.int x7 (@nil Integers.Int.int))))))))) K W)
         (@cons Integers.Int.int
            (Integers.Int.add (jet_elements_support_sha_round.c_T1 x7 x4 x5 x6 (Integers.Int.add Kc wt))
               (jet_elements_support_sha_round.c_T2 x0 x1 x2))
            (@cons Integers.Int.int x0
               (@cons Integers.Int.int x1
                  (@cons Integers.Int.int x2
                     (@cons Integers.Int.int
                        (Integers.Int.add x3 (jet_elements_support_sha_round.c_T1 x7 x4 x5 x6 (Integers.Int.add Kc wt)))
                        (@cons Integers.Int.int x4
                           (@cons Integers.Int.int x5 (@cons Integers.Int.int x6 (@nil Integers.Int.int)))))))))
### C.jet_elements_support_sha_compress_fun.W_first
W_first
     : forall (c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 : Integers.Int.int) (t : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 t)
                (BinInt.Z.lt t (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))),
       @eq Integers.Int.int (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15) t)
         (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 t)
### C.jet_elements_support_sha_compress_fun.W_step
W_step
     : forall (c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 : Integers.Int.int) (t : BinNums.Z)
         (wa wb wc wd one : Integers.Int.int)
         (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) t)
         (_ : @eq Integers.Int.int wa
                (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)
                   (BinInt.Z.sub t (BinNums.Zpos (BinNums.xO BinNums.xH)))))
         (_ : @eq Integers.Int.int wb
                (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)
                   (BinInt.Z.sub t (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))))
         (_ : @eq Integers.Int.int wc
                (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)
                   (BinInt.Z.sub t (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
         (_ : @eq Integers.Int.int wd
                (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)
                   (BinInt.Z.sub t (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq bool (Integers.Int.eq one Integers.Int.one) true),
       @eq Integers.Int.int
         (Integers.Int.add
            (Integers.Int.add
               (Integers.Int.add (Integers.Int.mul one wd) (jet_elements_support_sha_linkage.c_sigma1 wa)) wb)
            (jet_elements_support_sha_linkage.c_sigma0 wc))
         (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15) t)
### C.jet_elements_support_sha_compress_fun.split_spine
split_spine =
fix split_spine (fuel : nat) (s : Clight.statement) {struct fuel} : list Clight.statement :=
  match fuel return (list Clight.statement) with
  | O => @cons Clight.statement s (@nil Clight.statement)
  | S fuel0 =>
      match s return (list Clight.statement) with
      | Clight.Sskip => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Sassign _ _ => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Sset _ _ => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Scall _ _ _ => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Sbuiltin _ _ _ _ => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Ssequence a b => @cons Clight.statement a (split_spine fuel0 b)
      | Clight.Sifthenelse _ _ _ => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Sloop _ _ => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Sbreak => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Scontinue => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Sreturn _ => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Sswitch _ _ => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Slabel _ _ => @cons Clight.statement s (@nil Clight.statement)
      | Clight.Sgoto _ => @cons Clight.statement s (@nil Clight.statement)
      end
  end
     : forall (_ : nat) (_ : Clight.statement), list Clight.statement

Arguments split_spine fuel%nat_scope s
### C.jet_elements_support_sha_compress_fun.run
run =
fix run (l : list Clight.statement) (st : jet_elements_support_sha_interp.cst) {struct l} :
    option jet_elements_support_sha_interp.cst :=
  match l return (option jet_elements_support_sha_interp.cst) with
  | nil => @Some jet_elements_support_sha_interp.cst st
  | cons a l' =>
      match
        jet_elements_support_sha_interp.interp a (jet_elements_support_sha_interp.reset st)
        return (option jet_elements_support_sha_interp.cst)
      with
      | Some st1 => run l' st1
      | None => @None jet_elements_support_sha_interp.cst
      end
  end
     : forall (_ : list Clight.statement) (_ : jet_elements_support_sha_interp.cst),
       option jet_elements_support_sha_interp.cst

Arguments run l%list_scope st
### C.jet_elements_support_sha_compress_fun.body_elems
body_elems =
@cons Clight.statement
  (Clight.Ssequence
