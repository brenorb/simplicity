                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))
                  in
                match
                  negb (BinInt.Z.eqb (jet_sx_zval.b2z (negb (BinInt.Z.eqb x2 BinNums.Z0))) BinNums.Z0)
                  return (prod (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z) BinNums.Z)
                with
                | true =>
                    match
                      nv_pass (BinInt.Z.add t0b feR) t1b t2b t3b t4b
                      return (prod (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z) BinNums.Z)
                    with
                    | pair p2 r4 =>
                        match
                          p2 return (prod (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z) BinNums.Z)
                        with
                        | pair p3 r3 =>
                            match
                              p3 return (prod (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z) BinNums.Z)
                            with
                            | pair p4 r2 =>
                                match
                                  p4
                                  return (prod (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z) BinNums.Z)
                                with
                                | pair r0 r1 =>
                                    @pair (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z) BinNums.Z
                                      (@pair (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z
                                         (@pair (prod BinNums.Z BinNums.Z) BinNums.Z (@pair BinNums.Z BinNums.Z r0 r1)
                                            r2) r3)
                                      (BinInt.Z.land r4
                                         (BinNums.Zpos
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))
                                end
                            end
                        end
                    end
                | false =>
                    @pair (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z) BinNums.Z
                      (@pair (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z
                         (@pair (prod BinNums.Z BinNums.Z) BinNums.Z (@pair BinNums.Z BinNums.Z t0b t1b) t2b) t3b) t4b
                end
            end
        end
    end
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       prod (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z) BinNums.Z

Arguments nvz (t0 t1 t2 t3 t4)%Z_scope
### C.jet_secp_fe_math.fe_limbs_of
fe_limbs_of =
fun V : BinNums.Z =>
@cons BinNums.Z
  (BinInt.Z.modulo V
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
  (@cons BinNums.Z
     (BinInt.Z.modulo
        (BinInt.Z.div V
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
     (@cons BinNums.Z
        (BinInt.Z.modulo
           (BinInt.Z.div V
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
        (@cons BinNums.Z
           (BinInt.Z.modulo
              (BinInt.Z.div V
                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
           (@cons BinNums.Z
              (BinInt.Z.div V
                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))))
              (@nil BinNums.Z)))))
     : forall _ : BinNums.Z, list BinNums.Z

