### C.jet_secp_fe_math.be_val
be_val =
fun bs : list BinNums.Z =>
@List.fold_left BinNums.Z BinNums.Z
  (fun acc b : BinNums.Z =>
   BinInt.Z.add
     (BinInt.Z.mul acc
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
     b) bs BinNums.Z0
     : forall _ : list BinNums.Z, BinNums.Z

