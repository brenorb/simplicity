     : Clight.statement
### C.jet_elements_fee_lookup_branches.fee_lookup_fee
fee_lookup_fee =
Clight.Efield
  (Clight.Ederef
     (Clight.Etempvar jets_elements._t'2 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))
     (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)) jets_elements._assetFee Ctypesdefs.tulong
     : Clight.expr
### C.jet_elements_fee_lookup_branches.fee_lookup_hit
fee_lookup_hit =
Clight.Ssequence (Clight.Sset jets_elements._t'2 jet_elements_fee_lookup_compare.fee_lookup_mid)
  (Clight.Ssequence (Clight.Sset jets_elements._t'3 fee_lookup_fee)
     (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_elements._t'3 Ctypesdefs.tulong))))
     : Clight.statement
### C.jet_elements_fee_lookup_branches.fee_lookup_hit_temps
fee_lookup_hit_temps =
fun (bp : Values.block) (ofs : BinNums.Z) (fee : Integers.Int64.int) (le : Maps.PTree.tree Values.val) =>
@Maps.PTree.set Values.val jets_elements._t'3 (Values.Vlong fee)
  (@Maps.PTree.set Values.val jets_elements._t'2 (Values.Vptr bp (Integers.Ptrofs.repr ofs)) le)
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Maps.PTree.tree Values.val),
       Maps.PTree.tree Values.val

Arguments fee_lookup_hit_temps bp ofs%Z_scope fee le
### C.jet_elements_fee_lookup_branches.fee_lookup_moved
fee_lookup_moved =
fun (high : bool) (bt : Values.block) (base len : BinNums.Z) (le : Maps.PTree.tree Values.val) =>
match high return (Maps.PTree.tree Values.val) with
| true =>
    @Maps.PTree.set Values.val jets_elements._len
      (Values.Vlong
         (Integers.Int64.repr
            (BinInt.Z.sub len
               (BinInt.Z.add (BinInt.Z.div len (BinNums.Zpos (BinNums.xO BinNums.xH))) (BinNums.Zpos BinNums.xH)))))
      (@Maps.PTree.set Values.val jets_elements._feeOutputs
         (Values.Vptr bt
            (Integers.Ptrofs.repr
               (BinInt.Z.add base
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                     (BinInt.Z.add (BinInt.Z.div len (BinNums.Zpos (BinNums.xO BinNums.xH))) (BinNums.Zpos BinNums.xH))))))
         le)
| false =>
    @Maps.PTree.set Values.val jets_elements._len
      (Values.Vlong (Integers.Int64.repr (BinInt.Z.div len (BinNums.Zpos (BinNums.xO BinNums.xH))))) le
end
     : forall (_ : bool) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Maps.PTree.tree Values.val),
       Maps.PTree.tree Values.val

Arguments fee_lookup_moved high%bool_scope bt (base len)%Z_scope le
### C.jet_elements_fee_lookup_branches.fee_lookup_next_length
fee_lookup_next_length =
fun (high : bool) (len : BinNums.Z) =>
match high return BinNums.Z with
| true =>
    BinInt.Z.sub len (BinInt.Z.add (BinInt.Z.div len (BinNums.Zpos (BinNums.xO BinNums.xH))) (BinNums.Zpos BinNums.xH))
| false => BinInt.Z.div len (BinNums.Zpos (BinNums.xO BinNums.xH))
end
     : forall (_ : bool) (_ : BinNums.Z), BinNums.Z

Arguments fee_lookup_next_length high%bool_scope len%Z_scope
### C.jet_elements_fee_lookup_branches.fee_lookup_next_base
fee_lookup_next_base =
fun (high : bool) (base len : BinNums.Z) =>
match high return BinNums.Z with
| true =>
    BinInt.Z.add base
      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
         (BinInt.Z.add (BinInt.Z.div len (BinNums.Zpos (BinNums.xO BinNums.xH))) (BinNums.Zpos BinNums.xH)))
| false => base
end
     : forall (_ : bool) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments fee_lookup_next_base high%bool_scope (base len)%Z_scope
### C.jet_elements_fee_lookup_branches.fee_lookup_branch_temps
fee_lookup_branch_temps =
fun (c : comparison) (bt : Values.block) (base len : BinNums.Z) (bp : Values.block) (ofs : BinNums.Z)
  (fee : Integers.Int64.int) (le : Maps.PTree.tree Values.val) =>
match c return (Maps.PTree.tree Values.val) with
| Eq => fee_lookup_hit_temps bp ofs fee le
| Lt => fee_lookup_moved false bt base len le
| Gt => fee_lookup_moved true bt base len le
end
     : forall (_ : comparison) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Values.block)
         (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Maps.PTree.tree Values.val), Maps.PTree.tree Values.val

Arguments fee_lookup_branch_temps c bt (base len)%Z_scope bp ofs%Z_scope fee le
### C.jet_elements_fee_lookup_branches.fee_lookup_branch_out
fee_lookup_branch_out =
fun (c : comparison) (fee : Integers.Int64.int) =>
match c return ClightBigstep.outcome with
| Eq =>
    ClightBigstep.Out_return
      (@Some (prod Values.val Ctypes.type) (@pair Values.val Ctypes.type (Values.Vlong fee) Ctypesdefs.tulong))
| Lt => ClightBigstep.Out_normal
| Gt => ClightBigstep.Out_normal
end
     : forall (_ : comparison) (_ : Integers.Int64.int), ClightBigstep.outcome

Arguments fee_lookup_branch_out c fee
### C.jet_elements_fee_lookup_branches.fee_lookup_loop
fee_lookup_loop =
Clight.Swhile (Clight.Etempvar jets_elements._len Ctypesdefs.tulong) jet_elements_fee_lookup_compare.fee_lookup_work
     : Clight.statement
