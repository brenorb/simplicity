                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : jet_memcmp_model.bytes_at m bk keybase key) (_ : jet_memcmp_model.bytes_at m bp ofs candidate),
       @ex Integers.Int.int
         (fun cmp : Integers.Int.int =>
          and (jet_memcmp_model.memcmp_sign (jet_memcmp_model.bytes_cmp key candidate) cmp)
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge Clight.empty_env le m
               jet_elements_fee_lookup_compare.fee_lookup_work Events.E0
               (fee_lookup_branch_temps (jet_memcmp_model.bytes_cmp key candidate) bt base len bp ofs fee
                  (jet_elements_fee_lookup_compare.fee_lookup_compared bp ofs cmp le)) m
               (fee_lookup_branch_out (jet_memcmp_model.bytes_cmp key candidate) fee)))
### C.jet_elements_fee_lookup_branches.fee_lookup_eq
fee_lookup_eq =
Clight.Ebinop Cop.Oeq (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
  (Clight.Etempvar jets_elements._cmp Ctypesdefs.tint) Ctypesdefs.tint
     : Clight.expr
### C.jet_elements_fee_lookup_branches.fee_lookup_gt
fee_lookup_gt =
Clight.Ebinop Cop.Olt (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
  (Clight.Etempvar jets_elements._cmp Ctypesdefs.tint) Ctypesdefs.tint
     : Clight.expr
### C.jet_elements_fee_lookup_branches.fee_lookup_offset
fee_lookup_offset =
Clight.Ebinop Cop.Oadd jet_elements_fee_lookup_compare.fee_lookup_half
  (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tulong
     : Clight.expr
### C.jet_elements_fee_lookup_branches.fee_lookup_advance
fee_lookup_advance =
Clight.Ebinop Cop.Oadd
  (Clight.Etempvar jets_elements._feeOutputs
     (Ctypesdefs.tptr (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))) fee_lookup_offset
  (Ctypesdefs.tptr (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))
     : Clight.expr
### C.jet_elements_fee_lookup_branches.fee_lookup_tail_len
fee_lookup_tail_len =
Clight.Ebinop Cop.Osub (Clight.Etempvar jets_elements._len Ctypesdefs.tulong) fee_lookup_offset Ctypesdefs.tulong
     : Clight.expr
### C.jet_elements_fee_lookup_branches.fee_lookup_upper
fee_lookup_upper =
Clight.Ssequence (Clight.Sset jets_elements._feeOutputs fee_lookup_advance)
  (Clight.Sset jets_elements._len fee_lookup_tail_len)
     : Clight.statement
### C.jet_elements_fee_lookup_branches.fee_lookup_lower
fee_lookup_lower =
