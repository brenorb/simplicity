### C.jet_secp_generator_iteration.exec_generator_iteration
exec_generator_iteration
     : forall (d1 d128 : Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)
         (x y z inv : forall _ : nat, Integers.Int64.int)
