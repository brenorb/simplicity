                                                               (fun (b : Values.block) (_ : BinNums.Z) =>
                                                                and (not ...) (and ... ...)) m mf))))))))))))))))))
### C.jet_secp_generator_iteration.generator_digit_action
generator_digit_action =
fun (high : bool) (digit : Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)
  (point : Ty.tySem jet_secp_generate_literal.literal_generator_jacobian) =>
match digit return (Ty.tySem jet_secp_generate_literal.literal_generator_jacobian) with
| inl _ => point
| inr word =>
    @jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
      (@pair (Ty.tySem jet_secp_generate_literal.literal_generator_jacobian)
         (Ty.tySem jet_secp_generate_literal.literal_generator_point) point
         (@jet_secp_generate_literal.literal_generate_small high Alg.CoreFunSem word))
end
     : forall (_ : bool) (_ : Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)
         (_ : Ty.tySem jet_secp_generate_literal.literal_generator_jacobian),
       Ty.tySem jet_secp_generate_literal.literal_generator_jacobian

Arguments generator_digit_action high%bool_scope digit point
