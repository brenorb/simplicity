         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (i bits1 bits128 : BinNums.Z) (b1 b128 bp ba bb : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
