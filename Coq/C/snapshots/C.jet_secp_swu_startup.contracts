### C.jet_secp_swu_startup.swu_constant_state
swu_constant_state =
fun (d : bool) (m : Memory.Mem.mem) =>
and
  (Memory.Mem.range_perm m (swu_constant_block d) BinNums.Z0
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
     Memtype.Readable)
  (and
     (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m (swu_constant_block d)
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong (swu_constant_digits d i))))
     (jet_clight_readonly_frame.readonly_region_bounds m (swu_constant_block d) BinNums.Z0
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     : forall (_ : bool) (_ : Memory.Mem.mem), Prop

