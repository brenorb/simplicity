### C.jet_secp_gej_norm_output.affine_normalized_words_literal
affine_normalized_words_literal
     : forall (ox oy x y zi : forall _ : nat, Integers.Int64.int)
         (a b c : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value x) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value y) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value zi) jet_secp_fe_math.feP)
                (BinInt.Z.modulo
                   (jet_secp_invert_literal.literal_invert_numeric
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) c)) jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value ox)
                   jet_secp_multiply_checkpoint_columns.field_prime)
                (BinInt.Z.modulo
                   (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value x)
                      (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                         (jet_secp_multiply_finish_product.radix_value zi)))
                   jet_secp_multiply_checkpoint_columns.field_prime))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value oy)
                   jet_secp_multiply_checkpoint_columns.field_prime)
                (BinInt.Z.modulo
                   (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value y)
                      (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                         (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                            (jet_secp_multiply_finish_product.radix_value zi))))
                   jet_secp_multiply_checkpoint_columns.field_prime)),
       @eq
         (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (jet_secp_rescale_literal.rescale_field_output ox)
            (jet_secp_rescale_literal.rescale_field_output oy))
         (@jet_secp_gej_norm_literal.literal_gej_norm Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b) c))
### C.jet_secp_gej_norm_output.exec_affine_normalized_output
exec_affine_normalized_output
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bp ba b2 b3 : Values.block) (x y zi : forall _ : nat, Integers.Int64.int)
         (a b c : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N)
         (_ : jet_frame_inv.finv m0 bd base bw edge cursor N bi m true
                (@cons (option bool) (@Some bool true) (@nil (option bool))))
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b2 BinNums.Z0)
                         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b3 BinNums.Z0)
                            (@nil (prod Values.block BinNums.Z)))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero))) (_ : not (@eq Values.block bp b2))
         (_ : not (@eq Values.block bp b3)) (_ : not (@eq Values.block b2 b3)) (_ : not (@eq Values.block ba bp))
         (_ : not (@eq Values.block ba b2)) (_ : not (@eq Values.block ba b3))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds zi)
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 zi))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b3 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value x) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value y) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value zi) jet_secp_fe_math.feP)
                (BinInt.Z.modulo
                   (jet_secp_invert_literal.literal_invert_numeric
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) c)) jet_secp_fe_math.feP)),
       @ex Memory.Mem.mem
         (fun mx : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
                     (jet_secp_gej_affine_arithmetic.affine_local_env b2 b3) le m
                     (jet_secp_gej_affine_arithmetic.affine_arithmetic_context
                        jet_secp_gej_affine_arithmetic.affine_finish_statement) Events.E0 le mx
                     ClightBigstep.Out_normal)
                  (and
                     (@eq (option Memory.Mem.mem)
                        (Memory.Mem.free_list mx
                           (Clight.blocks_of_env jet_secp_linkage.secp_ge
                              (jet_secp_gej_affine_arithmetic.affine_local_env b2 b3))) (@Some Memory.Mem.mem mr))
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mr
                           (@Ctypes.Internal Clight.function jets_secp.f_write_ge)
                           (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                              (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                           Values.Vundef)
                        (and
                           (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                              (@app (option bool) (@cons (option bool) (@Some bool true) (@nil (option bool)))
                                 (@Translate.encode
                                    (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                       (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (@jet_secp_gej_norm_literal.literal_gej_norm Alg.CoreFunSem
                                       (@pair
                                          (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S ...)))))))))
                                             (Ty.tySem (Word.Word (S (S (S (S (S (S (S ...))))))))))
                                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                          (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S ...)))))))))
                                             (Ty.tySem (Word.Word (S (S (S (S (S (S (S ...))))))))) a b) c)))))
                           (and
                              (Memory.Mem.range_perm mf bp BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf ba BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (jet_sx_mem.lframe
                                    (fun (bx : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block bx bp))
                                       (and (not (@eq Values.block bx ba))
                                          (and (not (@eq Values.block bx b2))
                                             (and (not (@eq Values.block bx b3))
                                                (not (jet_secp_frame.extA m0 bd bw bi bx)))))) m mf)))))))))
