       @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O)))))))
         (@jet_bitcoin_full_prim.BitcoinFull.sem (Word.Word (S (S (S (S (S O))))))
