            (@jet_bitcoin_full_prim.BitcoinFull.Base (Word.Word (S (S (S (S (S O))))))
               (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) Bitcoin.Bitcoin.OutputValue) i e)
         (@Some (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))))
            match
