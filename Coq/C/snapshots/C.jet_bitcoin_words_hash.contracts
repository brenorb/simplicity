### C.jet_bitcoin_words_hash.prim_words_hash_spec_parametric
prim_words_hash_spec_parametric
     : forall (k w : nat)
         (p : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word w)
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))),
       @jet_bitcoin_full_prim.PF.Parametric Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@prim_words_hash_spec k w p)
### C.jet_bitcoin_words_hash.prim_words_hash_spec_sem
prim_words_hash_spec_sem
     : forall (k w : nat)
         (p : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word w)
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (xs_of : forall _ : jet_bitcoin_ext_prim.ext_environment,
                  list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
         (_ : forall (i : Ty.tySem (Word.Word w)) (e : jet_bitcoin_full_prim.BitcoinFull.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (@jet_bitcoin_full_prim.BitcoinFull.sem (Word.Word w)
                   (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) p i e)
                (@Some (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (xs_of e)
                       (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x => @inr unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None => @inl unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end))
         (_ : BinInt.Z.lt
                (BinInt.Z.div
                   (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)) (jet_forWhile_seq.wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                jet_sha_ctx8_spec.ctx8_limit) (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@prim_words_hash_spec k w p
            (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt
            e)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.from_hash256 (words_hash_of k w (xs_of e))))
### C.jet_bitcoin_words_hash.tx_words_hash_jet
tx_words_hash_jet
     : forall (k w : nat)
         (p : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word w)
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (xs_of : forall _ : jet_bitcoin_full_prim.BitcoinFull.env,
                  list
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Word.Vector (Word.Word (S (S (S O)))) k))) (f : Clight.function)
         (field : AST.ident) (hdelta : BinNums.Z)
         (_ : forall (i : Ty.tySem (Word.Word w)) (e : jet_bitcoin_full_prim.BitcoinFull.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (@jet_bitcoin_full_prim.BitcoinFull.sem (Word.Word w)
                   (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) p i e)
                (@Some
                   (sum unit
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end) (Word.Vector (Word.Word (S (S (S O)))) k)) (xs_of e)
                       (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return
                       (sum unit
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x =>
                       @inr unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None =>
                       @inl unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end))
         (_ : BinInt.Z.lt
                (BinInt.Z.div
                   (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)) (jet_forWhile_seq.wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                jet_sha_ctx8_spec.ctx8_limit)
         (_ : jet_bitcoin_wrapper.bitcoin_wrapper_shape f
                (jet_bitcoin_wrapper.bitcoin_simple_rest
                   (jet_bitcoin_hash_getters.bitcoin_hash_mid_writeHash jets_bitcoin._tx
                      jets_bitcoin._bitcoinTransaction field)))
         (_ : jet_bitcoin_field_eval.bitcoin_field_at jets_bitcoin._bitcoinTransaction field hdelta)
         (_ : and (BinInt.Z.le BinNums.Z0 hdelta)
                (BinInt.Z.le
                   (BinInt.Z.add hdelta
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))))),
       jet_application_sep.application_jet_local_spec_sep f jet_bitcoin_linkage.bitcoin_ge
         jet_bitcoin_ext_prim.ext_environment Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@jet_bitcoin_hash_getter_local.hash_getter_rep jet_bitcoin_full_prim.BitcoinFull.env
            (fun e : jet_bitcoin_full_prim.BitcoinFull.env => words_hash_of k w (xs_of e)) BinNums.Z0 hdelta
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))))
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_bitcoin_ext_prim.ext_environment) =>
          @prim_words_hash_spec k w p
            (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
