  (alg : jet_bitcoin_full_prim.PF.Algebra) =>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha_hash_words.hash_words_spec k w term Ty.Unit
  (@jet_buffer_empty_spec.AC.drop Ty.Unit (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) core
     (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word w)
        (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) alg p))
     : forall (k w : nat)
         (_ : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word w)
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) (alg : jet_bitcoin_full_prim.PF.Algebra),
       jet_bitcoin_full_prim.PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

