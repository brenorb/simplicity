### C.jet_secp_square_affine_y_caller.affine_y_square_initial
affine_y_square_initial
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bout bin)),
       jet_sx_state.rep rho
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) jet_secp_square_affine_y.affine_y_square_regs m
### C.jet_secp_square_affine_y_caller.affine_y_square_fields
affine_y_square_fields
     : forall (rho : forall _ : nat, Integers.Int64.int) (m mf : Memory.Mem.mem) (bout bin : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : jet_sx_state.rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@cons jet_sx_state.region
                   (jet_sx_state.mkreg
                      (jet_sx_rep.u64_cells
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                         jet_secp_square_execution.square_limbs) true
                      (@Some BinNums.Z
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                   (@cons jet_sx_state.region jet_secp_square_affine_y.affine_y_square_input (@nil jet_sx_state.region)))
                mf),
       and
         (jet_secp_fe_nv.fe_at mf bout
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
            (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
         (and
            (Memory.Mem.range_perm mf bout BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
               Memtype.Cur Memtype.Freeable)
            (and (jet_secp_fe_nv.fe_at mf bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
               (Memory.Mem.range_perm mf bin BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)))
### C.jet_secp_square_affine_y_caller.eval_square_affine_y_from_storage
eval_square_affine_y_from_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bout bin)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val
                  (Values.Vptr bout
                     (Integers.Ptrofs.repr
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_secp_fe_nv.fe_at mf bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
                     (and
                        (Memory.Mem.range_perm mf bin BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_square_numeric.square_words rho))
                                 jet_secp_multiply_checkpoint_columns.field_prime)
                              (BinInt.Z.modulo
                                 (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value rho)
                                    (jet_secp_multiply_finish_product.radix_value rho))
                                 jet_secp_multiply_checkpoint_columns.field_prime))
                           (and
                              (jet_secp_square_columns.square_input_bounds (jet_secp_square_numeric.square_words rho))
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (pos : BinNums.Z) =>
                                  not
                                    (jet_sx_state.foot
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z bout BinNums.Z0)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bin BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z))))
                                       (@List.map jet_sx_state.region
                                          (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                          jet_sx_state.rshape jet_secp_square_affine_y.affine_y_square_regs) b pos)) m
                                 mf))))))))
