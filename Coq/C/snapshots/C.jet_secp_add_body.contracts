### C.jet_secp_add_body.exec_secp_add_rest_calls
exec_secp_add_rest_calls
     : forall (le : Maps.PTree.tree Values.val) (m ma mb mn mf : Memory.Mem.mem) (bl ba bb bd : Values.block)
         (dbase : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ma
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ma
                (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mb
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mb
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mn
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mn
                (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (secp_public_add_env bl ba bb) le m secp_fe_add_rest
         Events.E0 le mf
         (ClightBigstep.Out_return
            (@Some (prod Values.val Ctypes.type)
               (@pair Values.val Ctypes.type (Values.Vint Integers.Int.one) Ctypesdefs.tint)))
### C.jet_secp_add_body.secp_public_add_env
secp_public_add_env =
fun bl ba bb : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._b
  (@pair Values.block Ctypes.type bb jet_secp_public_body.secp_field_type) (jet_secp_public_copy.secp_public_env bl ba)
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments secp_public_add_env bl ba bb
### C.jet_secp_add_body.secp_read_field_stmt
secp_read_field_stmt =
fun id : AST.ident =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_secp._read_fe
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr jet_secp_public_body.secp_field_type)
           (Ctypes.Tcons (Ctypesdefs.tptr jet_secp_public_body.secp_frame_type) Ctypes.Tnil)) Ctypesdefs.tvoid
        AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar id jet_secp_public_body.secp_field_type)
        (Ctypesdefs.tptr jet_secp_public_body.secp_field_type))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_secp._src jet_secp_public_body.secp_frame_type)
           (Ctypesdefs.tptr jet_secp_public_body.secp_frame_type)) (@nil Clight.expr)))
     : forall _ : AST.ident, Clight.statement

Arguments secp_read_field_stmt id
### C.jet_secp_add_body.secp_public_add_stmt
secp_public_add_stmt =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_secp._secp256k1_fe_add
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr jet_secp_public_body.secp_field_type)
           (Ctypes.Tcons (Ctypesdefs.tptr jet_secp_public_body.secp_field_type) Ctypes.Tnil)) Ctypesdefs.tvoid
        AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_secp._a jet_secp_public_body.secp_field_type)
        (Ctypesdefs.tptr jet_secp_public_body.secp_field_type))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_secp._b jet_secp_public_body.secp_field_type)
           (Ctypesdefs.tptr jet_secp_public_body.secp_field_type)) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_add_body.secp_fe_add_rest
secp_fe_add_rest =
Clight.Ssequence (secp_read_field_stmt jets_secp._a)
  (Clight.Ssequence (secp_read_field_stmt jets_secp._b)
     (Clight.Ssequence secp_public_add_stmt
        (Clight.Ssequence jet_secp_public_body.secp_public_write_stmt
           (Clight.Sreturn
              (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint))))))
     : Clight.statement
