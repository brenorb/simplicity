### C.jet_secp_generate_group.secp_generator_signed_minus_one
secp_generator_signed_minus_one
     : forall p : jet_secp_curve_group_sign.secp_group_point,
       @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (jet_secp_lookup5_group.secp_group_signed_power p (BinNums.Zneg BinNums.xH))
         (@SMain.opp (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.sub jet_secp_fe_math.feP)
            (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP)
            (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
            jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory p)
### C.jet_secp_generate_group.secp_literal_generate_run_group
secp_literal_generate_run_group
     : forall (n : nat) (base : Ty.tySem jet_secp_generate_literal.literal_generator_point)
         (point : jet_secp_curve_group_sign.secp_group_point) (word : Ty.tySem (Word.Word n))
         (_ : jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP) base point),
       jet_secp_jacobian_word_group.secp_jacobian_word_rep (GZnZ.one jet_secp_fe_math.feP)
         (jet_secp_generate_literal.literal_generate_signed_run n base word)
         (jet_secp_lookup5_group.secp_group_signed_power point (secp_generator_signed_word n word))
### C.jet_secp_generate_group.secp_literal_generate_signed_group
secp_literal_generate_signed_group
     : forall (n : nat) (second : bool) (word : Ty.tySem (Word.Word n)),
       jet_secp_jacobian_word_group.secp_jacobian_word_rep (GZnZ.one jet_secp_fe_math.feP)
         (@jet_secp_generate_literal.literal_generate_signed n Alg.CoreFunSem
            (@jet_secp_generate_literal.literal_generator_base second Alg.CoreFunSem) word)
         (jet_secp_lookup5_group.secp_group_signed_power
            (@EGroup.gpow jet_secp_curve_group_sign.secp_group_point
               (@SMain.add (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                  (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                  (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
                  (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                  jet_secp_curve_group.secp_group_seven jet_secp_curve_group.secp_group_zero_test
                  jet_secp_curve_group.secp_group_theory) jet_secp_curve_group_power.secp_group_generator
               jet_secp_curve_group.secp_curve_group
               match second return BinNums.Z with
               | true =>
                   BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
               | false => BinNums.Zpos BinNums.xH
               end) (secp_generator_signed_word n word))
