### C.jet_elements_fee_compare.fee_script_hash_test_true_iff
fee_script_hash_test_true_iff
     : forall o : jet_elements_prim.txOutput,
       iff (@eq bool (Bit.toBool (jet_elements_fee_literal.fee_script_hash_test o)) true)
         (@eq Digest.hash256 (Digest.byteStringHash (jet_elements_prim.txoScript o))
            (Digest.byteStringHash (@nil Integers.Byte.int)))
### C.jet_elements_fee_compare.processed_fee_empty_true_iff
processed_fee_empty_true_iff
     : forall o : jet_elements_prim.txOutput,
       iff (@eq bool (jet_elements_fee_flag_caller.processed_fee_empty o) true)
         (@eq jet_elements_prim.script (jet_elements_prim.txoScript o) (@nil Integers.Byte.int))
### C.jet_elements_fee_compare.processed_fee_bit_components
processed_fee_bit_components
     : forall o : jet_elements_prim.txOutput,
       @eq bool (jet_elements_fee_flag_caller.processed_fee_bit o)
         (andb (fee_explicit_components o) (jet_elements_fee_flag_caller.processed_fee_empty o))
### C.jet_elements_fee_compare.fee_spec_bit_components
fee_spec_bit_components
     : forall o : jet_elements_prim.txOutput,
       @eq bool (Bit.toBool (jet_elements_fee_literal.fee_spec_bit o))
         (andb (fee_explicit_components o) (Bit.toBool (jet_elements_fee_literal.fee_script_hash_test o)))
### C.jet_elements_fee_compare.processed_fee_true_implies_literal_true
processed_fee_true_implies_literal_true
     : forall (o : jet_elements_prim.txOutput) (_ : @eq bool (jet_elements_fee_flag_caller.processed_fee_bit o) true),
       @eq bool (Bit.toBool (jet_elements_fee_literal.fee_spec_bit o)) true
### C.jet_elements_fee_compare.processed_fee_literal_mismatch_iff
processed_fee_literal_mismatch_iff
     : forall o : jet_elements_prim.txOutput,
       iff
         (not
            (@eq bool (jet_elements_fee_flag_caller.processed_fee_bit o)
               (Bit.toBool (jet_elements_fee_literal.fee_spec_bit o))))
         (and (@eq bool (fee_explicit_components o) true)
            (and (not (@eq jet_elements_prim.script (jet_elements_prim.txoScript o) (@nil Integers.Byte.int)))
               (@eq Digest.hash256 (Digest.byteStringHash (jet_elements_prim.txoScript o))
                  (Digest.byteStringHash (@nil Integers.Byte.int)))))
### C.jet_elements_fee_compare.output_fee_result_mismatch_iff
output_fee_result_mismatch_iff
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env),
       iff
         (not
            (@eq (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
               (jet_elements_fee_flag_caller.processed_fee_result a environment)
               (jet_elements_fee_literal.fee_spec_result a environment)))
         (@ex jet_elements_prim.txOutput
            (fun o : jet_elements_prim.txOutput =>
             and
               (@eq (option jet_elements_prim.txOutput)
                  (@List.nth_error jet_elements_prim.txOutput
                     (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
                     (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a)))
                  (@Some jet_elements_prim.txOutput o))
               (and (@eq bool (fee_explicit_components o) true)
                  (and (not (@eq jet_elements_prim.script (jet_elements_prim.txoScript o) (@nil Integers.Byte.int)))
                     (@eq Digest.hash256 (Digest.byteStringHash (jet_elements_prim.txoScript o))
                        (Digest.byteStringHash (@nil Integers.Byte.int)))))))
### C.jet_elements_fee_compare.elements_output_fee_implementation_comparison
elements_output_fee_implementation_comparison
     : and
         (jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_output_is_fee
            jet_elements_linkage.elements_ge jet_elements_prim.Elements.env (Word.Word (S (S (S (S (S O))))))
            (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))
            (@jet_elements_indexed_ptr.indexed_ptr_rep jet_elements_prim.Elements.environment
               jet_elements_prim.txOutput
               (fun e : jet_elements_prim.Elements.environment =>
                jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx e))
               jet_elements_fee_flag_caller.processed_fee_rep
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
               BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
            (fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
             @Some (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
               (jet_elements_fee_flag_caller.processed_fee_result a environment)))
         (forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env),
          iff
            (not
               (@eq (option (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))))
                  (@Some (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
                     (jet_elements_fee_flag_caller.processed_fee_result a environment))
                  (@jet_elements_fee_literal.elements_output_fee_spec
                     (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
                     environment)))
            (@ex jet_elements_prim.txOutput
               (fun o : jet_elements_prim.txOutput =>
                and
                  (@eq (option jet_elements_prim.txOutput)
                     (@List.nth_error jet_elements_prim.txOutput
                        (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
                        (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a)))
                     (@Some jet_elements_prim.txOutput o))
                  (and (@eq bool (fee_explicit_components o) true)
                     (and (not (@eq jet_elements_prim.script (jet_elements_prim.txoScript o) (@nil Integers.Byte.int)))
                        (@eq Digest.hash256 (Digest.byteStringHash (jet_elements_prim.txoScript o))
                           (Digest.byteStringHash (@nil Integers.Byte.int))))))))
### C.jet_elements_fee_compare.fee_explicit_components
fee_explicit_components =
fun o : jet_elements_prim.txOutput =>
match jet_elements_prim.txoAsset o return bool with
| jet_elements_prim.Explicit _ =>
    match jet_elements_prim.txoAmount o return bool with
    | jet_elements_prim.Explicit _ => true
    | jet_elements_prim.Confidential _ _ => false
    end
| jet_elements_prim.Confidential _ _ => false
end
     : forall _ : jet_elements_prim.txOutput, bool

Arguments fee_explicit_components o
