forall (id : BinNums.positive) (w : forall _ : nat, Integers.Int64.int)
  (_ : @eq (option (forall _ : nat, Integers.Int64.int)) (@Maps.PTree.get (forall _ : nat, Integers.Int64.int) id s)
         (@Some (forall _ : nat, Integers.Int64.int) w)),
and (@List.In BinNums.positive id root_private_ids)
  (and (jet_secp_square_columns.square_input_bounds w)
     (@ex Values.block
        (fun b : Values.block =>
         and
           (@eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
              (@Some (prod Values.block Ctypes.type)
                 (@pair Values.block Ctypes.type b jet_secp_curve_statements.curve_fe_type)))
           (jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w)))))
