### C.jet_secp_root_chain_owned.root_chain_step_valid
root_chain_step_valid =
fun i : prod (prod (prod nat AST.ident) AST.ident) AST.ident =>
match i return Prop with
| pair p r =>
    match p return Prop with
    | pair p0 s =>
        match p0 return Prop with
        | pair n d =>
            and
              (BinInt.Z.le (BinInt.Z.of_nat n)
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
              (and (@List.In AST.ident d root_private_ids) (and (not (@eq AST.ident d s)) (not (@eq AST.ident d r))))
        end
    end
end
     : forall _ : prod (prod (prod nat AST.ident) AST.ident) AST.ident, Prop

Arguments root_chain_step_valid i
### C.jet_secp_root_chain_owned.root_chain_update
root_chain_update =
fun (i : prod (prod (prod nat AST.ident) AST.ident) AST.ident) (s : Maps.PTree.t (forall _ : nat, Integers.Int64.int))
=>
match i return (option (Maps.PTree.tree (forall _ : nat, Integers.Int64.int))) with
| pair p b =>
    match p return (option (Maps.PTree.tree (forall _ : nat, Integers.Int64.int))) with
    | pair p0 a =>
        match p0 return (option (Maps.PTree.tree (forall _ : nat, Integers.Int64.int))) with
        | pair n d =>
            match
              @Maps.PTree.get (forall _ : nat, Integers.Int64.int) a s
              return (option (Maps.PTree.tree (forall _ : nat, Integers.Int64.int)))
            with
            | Some w =>
                match
                  @Maps.PTree.get (forall _ : nat, Integers.Int64.int) b s
                  return (option (Maps.PTree.tree (forall _ : nat, Integers.Int64.int)))
                with
                | Some v =>
                    @Some (Maps.PTree.tree (forall _ : nat, Integers.Int64.int))
                      (@Maps.PTree.set (forall _ : nat, Integers.Int64.int) d
                         (jet_secp_root_stage.root_stage_words n w v) s)
                | None => @None (Maps.PTree.tree (forall _ : nat, Integers.Int64.int))
                end
            | None => @None (Maps.PTree.tree (forall _ : nat, Integers.Int64.int))
            end
        end
    end
end
     : forall (_ : prod (prod (prod nat AST.ident) AST.ident) AST.ident)
         (_ : Maps.PTree.t (forall _ : nat, Integers.Int64.int)),
       option (Maps.PTree.tree (forall _ : nat, Integers.Int64.int))

Arguments root_chain_update i s
### C.jet_secp_root_chain_owned.root_chain_run
root_chain_run =
fix root_chain_run
  (steps : list (prod (prod (prod nat AST.ident) AST.ident) AST.ident))
  (s : Maps.PTree.t (forall _ : nat, Integers.Int64.int)) {struct steps} :
    option (Maps.PTree.t (forall _ : nat, Integers.Int64.int)) :=
  match steps return (option (Maps.PTree.t (forall _ : nat, Integers.Int64.int))) with
  | nil => @Some (Maps.PTree.t (forall _ : nat, Integers.Int64.int)) s
  | cons i tail =>
      match root_chain_update i s return (option (Maps.PTree.t (forall _ : nat, Integers.Int64.int))) with
      | Some next => root_chain_run tail next
      | None => @None (Maps.PTree.t (forall _ : nat, Integers.Int64.int))
      end
  end
     : forall (_ : list (prod (prod (prod nat AST.ident) AST.ident) AST.ident))
         (_ : Maps.PTree.t (forall _ : nat, Integers.Int64.int)),
       option (Maps.PTree.t (forall _ : nat, Integers.Int64.int))

Arguments root_chain_run steps%list_scope s
### C.jet_secp_root_chain_owned.root_chain_body
root_chain_body =
fix root_chain_body
  (steps : list (prod (prod (prod nat AST.ident) AST.ident) AST.ident)) (last : Clight.statement) {struct steps} :
    Clight.statement :=
  match steps return Clight.statement with
  | nil => last
  | cons y tail =>
      match y return Clight.statement with
      | pair y0 r =>
          match y0 return Clight.statement with
          | pair y1 s =>
              match y1 return Clight.statement with
              | pair n d =>
                  Clight.Ssequence (jet_secp_root_stage.root_stage_copy d s)
                    (Clight.Ssequence (jet_secp_root_square_loop.root_square_for d (BinInt.Z.of_nat n))
                       (Clight.Ssequence (jet_secp_root_stage.root_stage_mul d r) (root_chain_body tail last)))
              end
          end
      end
  end
     : forall (_ : list (prod (prod (prod nat AST.ident) AST.ident) AST.ident)) (_ : Clight.statement),
       Clight.statement

Arguments root_chain_body steps%list_scope last
### C.jet_secp_root_chain_owned.root_chain_initial
root_chain_initial =
fun w2 w3 : forall _ : nat, Integers.Int64.int =>
@Maps.PTree.set (forall _ : nat, Integers.Int64.int) jets_secp._x2 w2
  (@Maps.PTree.set (forall _ : nat, Integers.Int64.int) jets_secp._x3 w3
     (Maps.PTree.empty (forall _ : nat, Integers.Int64.int)))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int),
       Maps.PTree.tree (forall _ : nat, Integers.Int64.int)

Arguments root_chain_initial (w2 w3)%function_scope
### C.jet_secp_root_chain_owned.root_chain_final
root_chain_final =
fun w2 w3 : forall _ : nat, Integers.Int64.int =>
match
  root_chain_run root_chain_steps (root_chain_initial w2 w3) return (Maps.PTree.t (forall _ : nat, Integers.Int64.int))
with
| Some sf => sf
| None => Maps.PTree.empty (forall _ : nat, Integers.Int64.int)
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int),
       Maps.PTree.t (forall _ : nat, Integers.Int64.int)

Arguments root_chain_final (w2 w3)%function_scope
### C.jet_secp_root_chain_owned.root_drop_statements
root_drop_statements =
fix root_drop_statements (n : nat) (s : Clight.statement) {struct n} : Clight.statement :=
  match n return Clight.statement with
  | O => s
  | S k =>
      match s return Clight.statement with
      | Clight.Sskip => Clight.Sskip
      | Clight.Sassign _ _ => Clight.Sskip
      | Clight.Sset _ _ => Clight.Sskip
      | Clight.Scall _ _ _ => Clight.Sskip
      | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
      | Clight.Ssequence _ rest => root_drop_statements k rest
      | Clight.Sifthenelse _ _ _ => Clight.Sskip
      | Clight.Sloop _ _ => Clight.Sskip
      | Clight.Sbreak => Clight.Sskip
      | Clight.Scontinue => Clight.Sskip
      | Clight.Sreturn _ => Clight.Sskip
      | Clight.Sswitch _ _ => Clight.Sskip
      | Clight.Slabel _ _ => Clight.Sskip
      | Clight.Sgoto _ => Clight.Sskip
      end
  end
     : forall (_ : nat) (_ : Clight.statement), Clight.statement

Arguments root_drop_statements n%nat_scope s
### C.jet_secp_root_chain_owned.root_after_chain
root_after_chain =
root_drop_statements (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  (Clight.fn_body jets_secp.f_secp256k1_fe_sqrt_var)
     : Clight.statement
