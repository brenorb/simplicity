### C.jet_secp_square_separate_caller.field_words_region
field_words_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat) (_ : @eq BinNums.Z (jet_sx_state.bas layout r) BinNums.Z0)
         (_ : jet_secp_fe_nv.fe_at m (jet_sx_state.blk layout r) BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m (jet_sx_state.blk layout r) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.region_ok rho layout m r
         (jet_secp_square_separate_layout.separate_input true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
### C.jet_secp_square_separate_caller.separate_square_initial_rep
separate_square_initial_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bout bin)),
       jet_sx_state.rep rho
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin BinNums.Z0)
               (@nil (prod Values.block BinNums.Z))))
         (jet_secp_square_separate_layout.separate_regs true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
         m
### C.jet_secp_square_separate_caller.separate_input_field
separate_input_field
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat) (freed : option BinNums.Z)
         (_ : jet_sx_state.region_ok rho layout m r (jet_secp_square_separate_layout.separate_input true freed)),
       jet_secp_fe_nv.fe_at m (jet_sx_state.blk layout r) (jet_sx_state.bas layout r)
         (jet_secp_multiply_normalize_bridge.words5 rho)
### C.jet_secp_square_separate_caller.separate_output_field
separate_output_field
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (writable : bool) (freed : option BinNums.Z) (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : jet_sx_state.rep rho layout
                (@cons jet_sx_state.region
                   (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_square_execution.square_limbs) true
                      (@Some BinNums.Z
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                   (@cons jet_sx_state.region (jet_secp_square_separate_layout.separate_input writable freed)
                      (@nil jet_sx_state.region))) m),
       and
         (jet_secp_fe_nv.fe_at m (jet_sx_state.blk layout O) (jet_sx_state.bas layout O)
            (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
         (Memory.Mem.range_perm m (jet_sx_state.blk layout O) BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
### C.jet_secp_square_separate_caller.square_output_region_field
square_output_region_field
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat) (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : jet_sx_state.region_ok rho layout m r
                (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_square_execution.square_limbs) true
                   (@Some BinNums.Z
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))),
       and
         (jet_secp_fe_nv.fe_at m (jet_sx_state.blk layout r) (jet_sx_state.bas layout r)
            (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
         (Memory.Mem.range_perm m (jet_sx_state.blk layout r) BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
### C.jet_secp_square_separate_caller.eval_square_separate_from_storage
eval_square_separate_from_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bout bin)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_secp_fe_nv.fe_at mf bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
                     (and
                        (Memory.Mem.range_perm mf bin BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_square_numeric.square_words rho))
                                 jet_secp_multiply_checkpoint_columns.field_prime)
                              (BinInt.Z.modulo
                                 (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value rho)
                                    (jet_secp_multiply_finish_product.radix_value rho))
                                 jet_secp_multiply_checkpoint_columns.field_prime))
                           (and
                              (jet_secp_square_columns.square_input_bounds (jet_secp_square_numeric.square_words rho))
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block b bout)) (not (@eq Values.block b bin))) m mf))))))))
