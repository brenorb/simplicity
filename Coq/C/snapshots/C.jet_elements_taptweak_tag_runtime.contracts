         (jet_secp_curve_statements.curve_call id fd (@None AST.ident) args) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_elements_taptweak_tag_runtime.exec_elements_taptweak_short_tag
exec_elements_taptweak_short_tag
     : forall (_ : jet_memcpy_model.memcpy_model) (bytes : list Integers.Int.int)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (br bc bs bt : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_init e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_uchars e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_finalize e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp.__res__1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets_secp._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets_secp._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._taptweakTag e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._tagName__3 le)
                (@Some Values.val (Values.Vptr bt Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._tagLen le)
                (@Some Values.val
                   (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int bytes))))))
         (_ : @List.NoDup Values.block
                (@cons Values.block br (@cons Values.block bc (@cons Values.block bs (@nil Values.block)))))
         (_ : not (@eq Values.block bt br)) (_ : not (@eq Values.block bt bc)) (_ : not (@eq Values.block bt bs))
         (_ : lt (@length Integers.Int.int bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : jet_elements_taptweak_globals.elements_taptweak_sha_startup m)
         (_ : jet_read8s_layout.uint8_array_at m bt BinNums.Z0 bytes)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
               jet_secp_taptweak_tag_exec.taptweak_tag_stmt Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                  (jet_secp_taptweak_tag_runtime.short_tag_regs bytes))
               (and
                  (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                     (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf bc
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (@Some Values.val
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint8unsigned mf bc
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@Some Values.val (Values.Vint Integers.Int.zero)))
                        (and
                           (Memory.Mem.range_perm mf br BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bc BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bs BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block b br))
                                          (and (not (@eq Values.block b bc)) (not (@eq Values.block b bs)))) m mf)
                                    (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                       (and (jet_elements_taptweak_globals.elements_taptweak_sha_startup mf)
                                          (jet_read8s_layout.uint8_array_at mf bt BinNums.Z0 bytes))))))))))))
