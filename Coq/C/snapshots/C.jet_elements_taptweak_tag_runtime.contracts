### C.jet_elements_taptweak_tag_runtime.elements_taptweak_sha_call_symbols
elements_taptweak_sha_call_symbols
     : forall (id : AST.ident) (fd : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id fd)
                elements_taptweak_sha_call_functions),
       and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
               (Clight.genv_genv jet_elements_taptweak_pure.elements_taptweak_ge) id)
            (@Some Values.block (jet_elements_taptweak_globals.elements_taptweak_symbol_block id)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
               (Clight.genv_genv jet_elements_taptweak_pure.elements_taptweak_ge)
               (Values.Vptr (jet_elements_taptweak_globals.elements_taptweak_symbol_block id) Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function fd)))
### C.jet_elements_taptweak_tag_runtime.exec_elements_taptweak_sha_call
exec_elements_taptweak_sha_call
     : forall (id : AST.ident) (fd : Clight.function) (args : list Clight.expr) (vargs : list Values.val)
         (v : Values.val) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id fd)
                elements_taptweak_sha_call_functions)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@None (prod Values.block Ctypes.type)))
         (_ : Clight.eval_exprlist jet_elements_taptweak_pure.elements_taptweak_ge e le m args
                (Ctypes.type_of_params (Clight.fn_params fd)) vargs)
