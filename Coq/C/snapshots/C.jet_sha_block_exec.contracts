### C.jet_sha_block_exec.sha_read32s_symbol
sha_read32s_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_sha_linkage.sha_ge)
            jets_sha._read32s) (@Some Values.block (jet_sha_linkage.sha_symbol_block jets_sha._read32s))
### C.jet_sha_block_exec.sha_read32s_funct
sha_read32s_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_sha_linkage.sha_ge)
            (Values.Vptr (jet_sha_linkage.sha_symbol_block jets_sha._read32s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_read32s))
### C.jet_sha_block_exec.sha_write32s_symbol
sha_write32s_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_sha_linkage.sha_ge)
            jets_sha._write32s) (@Some Values.block (jet_sha_linkage.sha_symbol_block jets_sha._write32s))
### C.jet_sha_block_exec.sha_write32s_funct
sha_write32s_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_sha_linkage.sha_ge)
            (Values.Vptr (jet_sha_linkage.sha_symbol_block jets_sha._write32s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_write32s))
### C.jet_sha_block_exec.sha_dispatch_symbol
sha_dispatch_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_sha_linkage.sha_ge)
            jets_sha._simplicity_sha256_compression)
         (@Some Values.block (jet_sha_linkage.sha_symbol_block jets_sha._simplicity_sha256_compression))
### C.jet_sha_block_exec.sha_block_blocks
sha_block_blocks
     : forall bl bh bb : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_sha_linkage.sha_ge (sha_block_env bl bh bb))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bh BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bb BinNums.Z0)
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))
### C.jet_sha_block_exec.sha_block_entry
sha_block_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb mc : Memory.Mem.mem') (bl bh bb bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb bh))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mb BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block mc bb)),
       Clight.function_entry2 jet_sha_linkage.sha_ge jets_sha.f_simplicity_sha_256_block
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (sha_block_env bl bh bb) (sha_block_temps env bd dbase bs sbase) mc
### C.jet_sha_block_exec.exec_sha_block_copy
exec_sha_block_copy
     : forall (m mc : Memory.Mem.mem) (bl bh bb bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge (sha_block_env bl bh bb) le m
         (Clight.Sassign (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
### C.jet_sha_block_exec.call_sha_read32s
call_sha_read32s
     : forall (arr : AST.ident) (n k : BinNums.Z) (bl bh bb ba : Values.block) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) arr (sha_block_env bl bh bb))
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba (Ctypesdefs.tarray Ctypesdefs.tuint n))))
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.le k
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
                (@Ctypes.Internal Clight.function jets.f_read32s)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong (Integers.Int64.repr k))
                      (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge (sha_block_env bl bh bb) le m
         (Clight.Scall (@None AST.ident) (Clight.Evar jets_sha._read32s read32s_ty)
            (@cons Clight.expr (Clight.Evar arr (Ctypesdefs.tarray Ctypesdefs.tuint n))
               (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr k) Ctypesdefs.tint)
                  (@cons Clight.expr
                     (Clight.Eaddrof (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
                        (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
                     (@nil Clight.expr))))) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_sha_block_exec.eval_sha_block_composes
eval_sha_block_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb mc : Memory.Mem.mem')
         (mcp mr1 mr2 m4 me mf : Memory.Mem.mem) (bl bh bb bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb bh))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mb BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block mc bb))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mc bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mc bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mcp))
         (_ : ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge mcp
                (@Ctypes.Internal Clight.function jets.f_read32s)
                (@cons Values.val (Values.Vptr bh Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mr1
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge mr1
                (@Ctypes.Internal Clight.function jets.f_read32s)
                (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr
                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mr2
                Values.Vundef)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr mr2
                   (jet_sha_linkage.sha_symbol_block jets_sha._simplicity_sha256_compression) BinNums.Z0)
                (@Some Values.val
                   (Values.Vptr (jet_sha_linkage.sha_symbol_block jets_sha._sha256_compression_portable)
                      Integers.Ptrofs.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge mr2
                (@Ctypes.Internal Clight.function jets_sha.f_sha256_compression_portable)
                (@cons Values.val (Values.Vptr bh Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 m4
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m4
                (@Ctypes.Internal Clight.function jets.f_write32s)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr bh Integers.Ptrofs.zero)
                      (@cons Values.val
                         (Values.Vlong
                            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                         (@nil Values.val)))) Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free_list me
                   (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                      (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                         (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bh BinNums.Z0)
                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bb BinNums.Z0)
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
         (@Ctypes.Internal Clight.function jets_sha.f_simplicity_sha_256_block)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_sha_block_exec.sha_block_env
sha_block_env =
fun bl bh bb : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._block
  (@pair Values.block Ctypes.type bb
     (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._h
     (@pair Values.block Ctypes.type bh
        (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._src
        (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Clight.empty_env))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments sha_block_env bl bh bb
### C.jet_sha_block_exec.sha_block_temps
sha_block_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_sha._env env
  (@Maps.PTree.set Values.val jets_sha._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_sha._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_sha.f_simplicity_sha_256_block))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments sha_block_temps env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_sha_block_exec.read32s_ty
read32s_ty =
Ctypes.Tfunction
  (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint)
     (Ctypes.Tcons Ctypesdefs.tulong
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Ctypes.Tnil)))
  Ctypesdefs.tvoid AST.cc_default
     : Ctypes.type
### C.jet_sha_block_exec.compression_ty
compression_ty =
Ctypes.Tfunction
  (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint) (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint) Ctypes.Tnil))
  Ctypesdefs.tvoid AST.cc_default
     : Ctypes.type
