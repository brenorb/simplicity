### C.jet_secp_scalar_normalize62.scalar_norm62_modulus_bound
scalar_norm62_modulus_bound
     : jet_secp_modinv_normalize62_modulus.modnorm62_limb_bounds modinfo_scalar_limb
### C.jet_secp_scalar_normalize62.scalar_norm62_modulus_value
scalar_norm62_modulus_value
     : @eq BinNums.Z
         (jet_secp_modinv_normalize62_words.norm62_value_z (S (S (S (S O))))
            (fun i : nat => Integers.Int64.signed (modinfo_scalar_limb i)))
         jet_secp_canonical_scalar.canonical_group_order
### C.jet_secp_scalar_normalize62.scalar_norm62_modulus_range
scalar_norm62_modulus_range
     : and
         (BinInt.Z.le
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
            jet_secp_canonical_scalar.canonical_group_order)
         (BinInt.Z.le jet_secp_canonical_scalar.canonical_group_order
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_scalar_normalize62.scalar_norm62_machine_numeric
scalar_norm62_machine_numeric
     : forall (w : forall _ : nat, Integers.Int64.int) (sign : Integers.Int64.int)
         (_ : jet_secp_modinv_normalize62_modulus.modnorm62_limb_bounds w)
         (_ : and
                (BinInt.Z.lt
                   (BinInt.Z.mul (BinNums.Zneg (BinNums.xO BinNums.xH)) jet_secp_canonical_scalar.canonical_group_order)
                   (jet_secp_modinv_normalize62_words.norm62_value_z (S (S (S (S O))))
                      (fun i : nat => Integers.Int64.signed (w i))))
                (BinInt.Z.lt
                   (jet_secp_modinv_normalize62_words.norm62_value_z (S (S (S (S O))))
                      (fun i : nat => Integers.Int64.signed (w i))) jet_secp_canonical_scalar.canonical_group_order)),
       and
         (jet_secp_signed62_numeric.signed62_normalized
            (jet_secp_modinv_normalize62_exec.norm62_machine w modinfo_scalar_limb sign))
         (@eq BinNums.Z
            (jet_secp_signed62_numeric.signed62_unsigned_value
               (jet_secp_modinv_normalize62_exec.norm62_machine w modinfo_scalar_limb sign))
            (BinInt.Z.modulo
               (BinInt.Z.mul
                  match Integers.Int64.lt sign Integers.Int64.zero return BinNums.Z with
                  | true => BinNums.Zneg BinNums.xH
                  | false => BinNums.Zpos BinNums.xH
                  end
                  (jet_secp_modinv_normalize62_words.norm62_value_z (S (S (S (S O))))
                     (fun i : nat => Integers.Int64.signed (w i)))) jet_secp_canonical_scalar.canonical_group_order))
### C.jet_secp_scalar_normalize62.scalar_norm62_input_words
scalar_norm62_input_words
     : forall (w : forall _ : nat, Integers.Int64.int) (sign : Integers.Int64.int),
       @eq (list Integers.Int64.int) (jet_secp_multiply_normalize_bridge.words5 (scalar_norm62_rho w sign))
         (jet_secp_multiply_normalize_bridge.words5 w)
### C.jet_secp_scalar_normalize62.scalar_norm62_output_words
scalar_norm62_output_words
     : forall (w : forall _ : nat, Integers.Int64.int) (sign : Integers.Int64.int),
       @eq (list Integers.Int64.int)
         (jet_secp_multiply_normalize_bridge.words5
            (jet_secp_modinv_normalize62_exec.norm62_machine (scalar_norm62_rho w sign)
               (fun i : nat => scalar_norm62_rho w sign (Nat.add (S (S (S (S (S O))))) i))
               (scalar_norm62_rho w sign (S (S (S (S (S (S (S (S (S (S O)))))))))))))
         (jet_secp_multiply_normalize_bridge.words5
            (jet_secp_modinv_normalize62_exec.norm62_machine w modinfo_scalar_limb sign))
### C.jet_secp_scalar_normalize62.scalar_norm62_initial_modulus
scalar_norm62_initial_modulus
     : forall (w : forall _ : nat, Integers.Int64.int) (sign : Integers.Int64.int) (m : Memory.Mem.mem)
         (_ : jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep m),
       jet_secp_modinv_normalize62_exec.norm62_modulus_at m jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block
         (fun i : nat => scalar_norm62_rho w sign (Nat.add (S (S (S (S (S O))))) i))
### C.jet_secp_scalar_normalize62.eval_scalar_norm62_numeric
eval_scalar_norm62_numeric
     : forall (w : forall _ : nat, Integers.Int64.int) (sign : Integers.Int64.int) (m : Memory.Mem.mem)
         (br : Values.block) (_ : jet_secp_modinv_normalize62_modulus.modnorm62_limb_bounds w)
         (_ : and
                (BinInt.Z.lt
                   (BinInt.Z.mul (BinNums.Zneg (BinNums.xO BinNums.xH)) jet_secp_canonical_scalar.canonical_group_order)
                   (jet_secp_modinv_normalize62_words.norm62_value_z (S (S (S (S O))))
                      (fun i : nat => Integers.Int64.signed (w i))))
                (BinInt.Z.lt
                   (jet_secp_modinv_normalize62_words.norm62_value_z (S (S (S (S O))))
                      (fun i : nat => Integers.Int64.signed (w i))) jet_secp_canonical_scalar.canonical_group_order))
         (_ : not (@eq Values.block br jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block))
         (_ : jet_secp_fe_nv.fe_at m br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_normalize_62)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vlong sign)
                     (@cons Values.val
                        (Values.Vptr jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block Integers.Ptrofs.zero)
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5
                     (jet_secp_modinv_normalize62_exec.norm62_machine w modinfo_scalar_limb sign)))
               (and
                  (jet_secp_signed62_numeric.signed62_normalized
                     (jet_secp_modinv_normalize62_exec.norm62_machine w modinfo_scalar_limb sign))
                  (and
                     (@eq BinNums.Z
                        (jet_secp_signed62_numeric.signed62_unsigned_value
                           (jet_secp_modinv_normalize62_exec.norm62_machine w modinfo_scalar_limb sign))
                        (BinInt.Z.modulo
                           (BinInt.Z.mul
                              match Integers.Int64.lt sign Integers.Int64.zero return BinNums.Z with
                              | true => BinNums.Zneg BinNums.xH
                              | false => BinNums.Zpos BinNums.xH
                              end
                              (jet_secp_modinv_normalize62_words.norm62_value_z (S (S (S (S O))))
                                 (fun i : nat => Integers.Int64.signed (w i))))
                           jet_secp_canonical_scalar.canonical_group_order))
                     (and
                        (Memory.Mem.range_perm mf br BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and (jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep mf)
                           (jet_sx_mem.lframe
                              (jet_secp_modinv_normalize62_exec.norm62_outside br
                                 jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block) m mf)))))))
### C.jet_secp_scalar_normalize62.modinfo_scalar_limb
modinfo_scalar_limb =
fun i : nat => @List.nth Integers.Int64.int i jet_secp_modinfo_scalar_global.modinfo_scalar_words Integers.Int64.zero
     : forall _ : nat, Integers.Int64.int

Arguments modinfo_scalar_limb i%nat_scope
### C.jet_secp_scalar_normalize62.scalar_norm62_rho
scalar_norm62_rho =
fun (w : forall _ : nat, Integers.Int64.int) (sign : Integers.Int64.int) (n : nat) =>
match PeanoNat.Nat.ltb n (S (S (S (S (S O))))) return Integers.Int64.int with
| true => w n
| false =>
    match PeanoNat.Nat.ltb n (S (S (S (S (S (S (S (S (S (S O)))))))))) return Integers.Int64.int with
    | true => modinfo_scalar_limb (Nat.sub n (S (S (S (S (S O))))))
    | false => sign
    end
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments scalar_norm62_rho w%function_scope sign n%nat_scope
