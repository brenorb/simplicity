                                          (BinInt.Z.sub
                                             (BinInt.Z.mul
                                                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                                (jet_secp_modinv_de_numeric.de62_input_value
                                                   (jet_secp_modinv_var_de.inv_de_rho (scalar_inv_updates_rho len rho))
                                                   high))
