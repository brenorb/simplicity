### C.jet_secp_scalar_inverse_updates.scalar_inv_de_next_rho
scalar_inv_de_next_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (n : nat) =>
match
  andb (PeanoNat.Nat.leb (S (S (S (S (S O))))) n)
    (PeanoNat.Nat.ltb n (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))) return Integers.Int64.int
with
| true =>
    jet_secp_scalar_de_revalue.scalar_de62_next_rho (jet_secp_modinv_var_de.inv_de_rho rho)
      (Nat.sub n (S (S (S (S (S O))))))
| false => rho n
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments scalar_inv_de_next_rho rho%function_scope n%nat_scope
### C.jet_secp_scalar_inverse_updates.scalar_inv_updates
scalar_inv_updates =
Clight.Ssequence jet_secp_modinv_var_de.inv_de_statement jet_secp_modinv_var_fg.inv_fg_statement
     : Clight.statement
### C.jet_secp_scalar_inverse_updates.scalar_inv_updates_rho
scalar_inv_updates_rho =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) =>
jet_secp_modinv_var_fg.inv_fg_next_rho len (scalar_inv_de_next_rho rho)
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments scalar_inv_updates_rho len%nat_scope rho%function_scope n%nat_scope
