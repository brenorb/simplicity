### C.jet_secp_mixed_x_tail.mixed_x_source
mixed_x_source
     : @eq Clight.statement jet_secp_mixed_products.mixed_after_products
         (jet_secp_statement_prefix.statement_sequence mixed_x_statements mixed_after_x)
### C.jet_secp_mixed_x_tail.mixed_x_bounds
mixed_x_bounds
     : forall (i g t : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds i)
         (_ : jet_secp_field_mul_small.mul_small_input_bounds g)
         (_ : jet_secp_field_mul_small.mul_small_input_bounds t),
       and
         (jet_secp_field_sum_bounds.field_scaled_bounds (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
            (mixed_x_words i g t))
         (and
            (jet_secp_field_sum_bounds.field_scaled_bounds (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))
               (mixed_tx_words i g t))
            (and
               (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (mixed_x_words i g t))
                  (BinInt.Z.add
                     (BinInt.Z.add
                        (jet_secp_multiply_finish_product.radix_value (jet_secp_square_numeric.square_words i))
                        (jet_secp_multiply_finish_product.radix_value g))
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (jet_secp_multiply_finish_product.radix_value t))))
               (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (mixed_tx_words i g t))
                  (BinInt.Z.add
                     (BinInt.Z.add
                        (jet_secp_multiply_finish_product.radix_value (jet_secp_square_numeric.square_words i))
                        (jet_secp_multiply_finish_product.radix_value g))
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH))
                        (jet_secp_multiply_finish_product.radix_value t))))))
### C.jet_secp_mixed_x_tail.exec_mixed_x_tail
exec_mixed_x_tail
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bp bi bg bt : Values.block) (i g t : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._i e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bi jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._h3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bg jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bp bi))
         (_ : not (@eq Values.block bp bg)) (_ : not (@eq Values.block bp bt)) (_ : not (@eq Values.block bi bg))
         (_ : not (@eq Values.block bi bt)) (_ : not (@eq Values.block bg bt))
         (_ : jet_secp_square_columns.square_input_bounds i) (_ : jet_secp_field_mul_small.mul_small_input_bounds g)
         (_ : jet_secp_field_mul_small.mul_small_input_bounds t)
         (_ : jet_secp_fe_nv.fe_at m bi BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 i))
         (_ : jet_secp_fe_nv.fe_at m bg BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 g))
         (_ : jet_secp_fe_nv.fe_at m bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 t))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bi BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bg BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence mixed_x_statements Clight.Sskip) Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (mixed_x_words i g t)))
               (and
                  (jet_secp_fe_nv.fe_at mf bt BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (mixed_tx_words i g t)))
                  (and (jet_secp_fe_nv.fe_at mf bi BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 i))
                     (and (jet_secp_fe_nv.fe_at mf bg BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 g))
                        (and
                           (Memory.Mem.range_perm mf bp BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bi BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bg BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bt BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (jet_secp_field_sum_bounds.field_scaled_bounds
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                          (mixed_x_words i g t))
                                       (and
                                          (jet_secp_field_sum_bounds.field_scaled_bounds
                                             (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))
                                             (mixed_tx_words i g t))
                                          (and
                                             (@eq BinNums.Z
                                                (jet_secp_multiply_finish_product.radix_value (mixed_x_words i g t))
                                                (BinInt.Z.add
                                                   (BinInt.Z.add
                                                      (jet_secp_multiply_finish_product.radix_value
                                                         (jet_secp_square_numeric.square_words i))
                                                      (jet_secp_multiply_finish_product.radix_value g))
                                                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                      (jet_secp_multiply_finish_product.radix_value t))))
                                             (and
                                                (@eq BinNums.Z
                                                   (jet_secp_multiply_finish_product.radix_value (mixed_tx_words i g t))
                                                   (BinInt.Z.add
                                                      (BinInt.Z.add
                                                         (jet_secp_multiply_finish_product.radix_value
                                                            (jet_secp_square_numeric.square_words i))
                                                         (jet_secp_multiply_finish_product.radix_value g))
                                                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH))
                                                         (jet_secp_multiply_finish_product.radix_value t))))
                                                (jet_sx_mem.lframe (mixed_x_frame bp bi bg bt) m mf))))))))))))))
### C.jet_secp_mixed_x_tail.mixed_x_words
mixed_x_words =
fun i g t : forall _ : nat, Integers.Int64.int =>
jet_secp_field_add_scaled.field_sum_words
  (jet_secp_field_add_scaled.field_sum_words
     (jet_secp_field_add_scaled.field_sum_words (jet_secp_square_numeric.square_words i) g) t) t
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments mixed_x_words (i g t)%function_scope i%nat_scope
### C.jet_secp_mixed_x_tail.mixed_tx_words
mixed_tx_words =
fun i g t : forall _ : nat, Integers.Int64.int => jet_secp_field_add_scaled.field_sum_words t (mixed_x_words i g t)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments mixed_tx_words (i g t)%function_scope i%nat_scope
### C.jet_secp_mixed_x_tail.mixed_x_square
mixed_x_square =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_sqr jets_secp.f_secp256k1_fe_sqr
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._r jets_secp._x)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._i) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_mixed_x_tail.mixed_x_add
mixed_x_add =
fun g : bool =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_add jets_secp.f_secp256k1_fe_add
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._r jets_secp._x)
     (@cons Clight.expr
        (jet_secp_curve_statements.curve_local_address
           match g return AST.ident with
           | true => jets_secp._h3
           | false => jets_secp._t
           end) (@nil Clight.expr)))
     : forall _ : bool, Clight.statement

Arguments mixed_x_add g%bool_scope
### C.jet_secp_mixed_x_tail.mixed_t_add
mixed_t_add =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_add jets_secp.f_secp256k1_fe_add
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._t)
     (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._r jets_secp._x) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_mixed_x_tail.mixed_x_statements
mixed_x_statements =
@cons Clight.statement mixed_x_square
  (@cons Clight.statement (mixed_x_add true)
     (@cons Clight.statement (mixed_x_add false)
        (@cons Clight.statement (mixed_x_add false) (@cons Clight.statement mixed_t_add (@nil Clight.statement)))))
     : list Clight.statement
### C.jet_secp_mixed_x_tail.mixed_after_x
mixed_after_x =
match jet_secp_mixed_products.mixed_after_products return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ s4 =>
            match s4 return Clight.statement with
            | Clight.Sskip => Clight.Sskip
            | Clight.Sassign _ _ => Clight.Sskip
            | Clight.Sset _ _ => Clight.Sskip
            | Clight.Scall _ _ _ => Clight.Sskip
            | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
            | Clight.Ssequence _ s6 =>
                match s6 return Clight.statement with
                | Clight.Sskip => Clight.Sskip
                | Clight.Sassign _ _ => Clight.Sskip
                | Clight.Sset _ _ => Clight.Sskip
                | Clight.Scall _ _ _ => Clight.Sskip
                | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                | Clight.Ssequence _ rest => rest
                | Clight.Sifthenelse _ _ _ => Clight.Sskip
                | Clight.Sloop _ _ => Clight.Sskip
                | Clight.Sbreak => Clight.Sskip
                | Clight.Scontinue => Clight.Sskip
                | Clight.Sreturn _ => Clight.Sskip
                | Clight.Sswitch _ _ => Clight.Sskip
                | Clight.Slabel _ _ => Clight.Sskip
                | Clight.Sgoto _ => Clight.Sskip
                end
            | Clight.Sifthenelse _ _ _ => Clight.Sskip
            | Clight.Sloop _ _ => Clight.Sskip
            | Clight.Sbreak => Clight.Sskip
            | Clight.Scontinue => Clight.Sskip
            | Clight.Sreturn _ => Clight.Sskip
            | Clight.Sswitch _ _ => Clight.Sskip
            | Clight.Slabel _ _ => Clight.Sskip
            | Clight.Sgoto _ => Clight.Sskip
            end
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_mixed_x_tail.mixed_x_frame
mixed_x_frame =
fun (bp bi bg bt bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bi))
  (and (not (@eq Values.block bx bg))
     (and (not (@eq Values.block bx bt))
        (or (not (@eq Values.block bx bp))
           (or (BinInt.Z.lt pos BinNums.Z0)
              (BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                 pos)))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments mixed_x_frame bp bi bg bt bx pos%Z_scope
