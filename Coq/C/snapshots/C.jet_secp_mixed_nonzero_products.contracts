### C.jet_secp_mixed_nonzero_products.mixed_nonzero_products_source
mixed_nonzero_products_source
     : @eq Clight.statement jet_secp_mixed_difference.mixed_after_difference
         (jet_secp_statement_prefix.statement_sequence mixed_nonzero_products_statements
            jet_secp_mixed_products.mixed_after_products)
### C.jet_secp_mixed_nonzero_products.exec_mixed_nonzero_products
exec_mixed_nonzero_products
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bp bh b2 b3 bt bu : Values.block) (x y z h u : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._rzr le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._h e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bh jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._h2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b2 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._h3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b3 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._u1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bu jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalizes_to_zero_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bp
                   (@cons Values.block bh
                      (@cons Values.block b2
                         (@cons Values.block b3 (@cons Values.block bt (@cons Values.block bu (@nil Values.block))))))))
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : jet_secp_square_columns.square_input_bounds h)
         (_ : jet_secp_square_columns.square_input_bounds u)
         (_ : not
                (@eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value h) jet_secp_fe_math.feP)
                   BinNums.Z0))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : jet_secp_fe_nv.fe_at m bh BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 h))
         (_ : jet_secp_fe_nv.fe_at m bu BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bh BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b3 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bu BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence mixed_nonzero_products_statements Clight.Sskip) Events.E0
               (@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint Integers.Int.zero) le) mf
               ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf bp
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (jet_secp_fe_nv.fe_at mf bp
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_mul_storage.point_mul_words z h)))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf bp
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                           (@Some Values.val (Values.Vint Integers.Int.zero)))
                        (and (jet_secp_fe_nv.fe_at mf bh BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 h))
                           (and (jet_secp_fe_nv.fe_at mf bu BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
                              (and
                                 (jet_secp_fe_nv.fe_at mf b2 BinNums.Z0
                                    (jet_secp_multiply_normalize_bridge.words5 (mixed_h2_words h)))
                                 (and
                                    (jet_secp_fe_nv.fe_at mf b3 BinNums.Z0
                                       (jet_secp_multiply_normalize_bridge.words5 (mixed_h3_words h)))
                                    (and
                                       (jet_secp_fe_nv.fe_at mf bt BinNums.Z0
                                          (jet_secp_multiply_normalize_bridge.words5 (mixed_t_words u h)))
                                       (and
                                          (Memory.Mem.range_perm mf bp BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (Memory.Mem.range_perm mf bh BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                Memtype.Cur Memtype.Freeable)
                                             (and
                                                (Memory.Mem.range_perm mf b2 BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (and
                                                   (Memory.Mem.range_perm mf b3 BinNums.Z0
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                      Memtype.Cur Memtype.Freeable)
                                                   (and
                                                      (Memory.Mem.range_perm mf bt BinNums.Z0
                                                         (BinNums.Zpos
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                         Memtype.Cur Memtype.Freeable)
                                                      (and
                                                         (Memory.Mem.range_perm mf bu BinNums.Z0
                                                            (BinNums.Zpos
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))
                                                            Memtype.Cur Memtype.Freeable)
                                                         (and
                                                            (jet_secp_square_columns.square_input_bounds
                                                               (jet_secp_point_mul_storage.point_mul_words z h))
                                                            (and
                                                               (jet_secp_square_columns.square_input_bounds
                                                                  (mixed_h2_words h))
                                                               (and
                                                                  (jet_secp_field_mul_small.mul_small_input_bounds
                                                                     (mixed_h3_words h))
                                                                  (and
                                                                     (jet_secp_field_mul_small.mul_small_input_bounds
                                                                        (mixed_t_words u h))
                                                                     (and (@eq BinNums.Z ... ...) (and ... ...))))))))))))))))))))))
### C.jet_secp_mixed_nonzero_products.mixed_h2_words
mixed_h2_words =
fun h : forall _ : nat, Integers.Int64.int =>
jet_secp_field_negate_separate.negate_sep_words (jet_secp_square_numeric.square_words h)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments mixed_h2_words h%function_scope i%nat_scope
### C.jet_secp_mixed_nonzero_products.mixed_h3_words
mixed_h3_words =
fun h : forall _ : nat, Integers.Int64.int => jet_secp_point_mul_storage.point_mul_words (mixed_h2_words h) h
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments mixed_h3_words h%function_scope i%nat_scope
### C.jet_secp_mixed_nonzero_products.mixed_t_words
mixed_t_words =
fun u h : forall _ : nat, Integers.Int64.int => jet_secp_point_mul_storage.point_mul_words u (mixed_h2_words h)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments mixed_t_words (u h)%function_scope i%nat_scope
### C.jet_secp_mixed_nonzero_products.mixed_nonzero_products_statements
mixed_nonzero_products_statements =
@app Clight.statement jet_secp_mixed_nonzero_start.mixed_nonzero_prefix_statements
  jet_secp_mixed_products.mixed_product_statements
     : list Clight.statement
### C.jet_secp_mixed_nonzero_products.mixed_nonzero_products_frame
mixed_nonzero_products_frame =
fun (bp bh b2 b3 bt bu bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx b3))
  (and (not (@eq Values.block bx bt))
     (and (not (@eq Values.block bx bu)) (jet_secp_mixed_nonzero_start.mixed_nonzero_start_frame bp bh b2 bx pos)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments mixed_nonzero_products_frame bp bh b2 b3 bt bu bx pos%Z_scope
