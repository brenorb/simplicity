                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.lt len
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))),
       @eq bool
         (jet_sha_uchars_exec.uc_overflow false
            (jet_read_sha256_counter.sha256_read_counter r (Integers.Int64.repr len)) (Integers.Int64.repr n))
         (negb
            (BinInt.Z.ltb
               (BinInt.Z.add (Integers.Int64.unsigned r)
                  (BinInt.Z.div (BinInt.Z.add len n)
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               jet_sha_ctx8_spec.ctx8_limit))
