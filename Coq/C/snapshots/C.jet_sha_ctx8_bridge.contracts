### C.jet_sha_ctx8_bridge.buffer_values_list
buffer_values_list
     : forall (depth : nat) (buf : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) depth)),
       @eq (list (Ty.tySem (Word.Word (S (S (S O))))))
         (jet_buffer_chunks.byte_chunks_values (jet_buffer_input.buffer_byte_chunks depth buf))
         (jet_sha_ctx8_spec.buffer_list (Word.Word (S (S (S O)))) depth buf)
### C.jet_sha_ctx8_bridge.buffer_exists
buffer_exists
     : forall (X : Ty.Ty) (depth : nat) (l : list (Ty.tySem X))
         (_ : lt (@length (Ty.tySem X) l) (PeanoNat.Nat.pow (S (S O)) (S depth))),
       @ex (Ty.tySem (jet_buffer_empty_spec.buffer_type X depth))
         (fun buf : Ty.tySem (jet_buffer_empty_spec.buffer_type X depth) =>
          @eq (list (Ty.tySem X)) (jet_sha_ctx8_spec.buffer_list X depth buf) l)
