### C.jet_sha_ctx8_bridge.absorb_length
absorb_length
     : forall (bs l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (_ : lt (@length (Ty.tySem (Word.Word (S (S (S O))))) l)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       and
         (@eq BinNums.Z
            (BinInt.Z.of_nat
               (@length (Ty.tySem (Word.Word (S (S (S O)))))
                  (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                     (jet_sha_ctx8_model.absorb l regs bs))))
            (BinInt.Z.modulo
               (BinInt.Z.add (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) l))
                  (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) bs)))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (lt
            (@length (Ty.tySem (Word.Word (S (S (S O)))))
               (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                  (jet_sha_ctx8_model.absorb l regs bs)))
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
### C.jet_sha_ctx8_bridge.add_counter_c
add_counter_c
     : forall (r : Integers.Int64.int) (len : BinNums.Z)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned r)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
