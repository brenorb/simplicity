                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.lt len
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq BinNums.Z
         (Integers.Int64.unsigned (jet_read_sha256_counter.sha256_read_counter r (Integers.Int64.repr len)))
         (BinInt.Z.add
