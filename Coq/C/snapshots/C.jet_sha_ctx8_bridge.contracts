               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (Integers.Int64.unsigned r)) len)
### C.jet_sha_ctx8_bridge.add_counter_sum
add_counter_sum
     : forall (r : Integers.Int64.int) (len n : BinNums.Z)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned r)
                (BinNums.Zpos
                   (BinNums.xO
