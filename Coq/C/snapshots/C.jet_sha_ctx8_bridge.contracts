         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.lt len
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))),
       @eq BinNums.Z
         (Integers.Int64.unsigned
            (Integers.Int64.add (jet_read_sha256_counter.sha256_read_counter r (Integers.Int64.repr len))
               (Integers.Int64.repr n)))
         (BinInt.Z.add
            (BinInt.Z.add
               (BinInt.Z.mul
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (Integers.Int64.unsigned r)) len) n)
### C.jet_sha_ctx8_bridge.add_counter_overflow
add_counter_overflow
     : forall (r : Integers.Int64.int) (len n : BinNums.Z)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned r)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
