### C.jet_copyBits_partial_crossing_cells.copy_partial_cross_value_bits
copy_partial_cross_value_bits
     : forall (ss ds : BinNums.Z) (old source next : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (and (BinInt.Z.lt ss ds)
                   (BinInt.Z.le ds
                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq bool
         (Integers.Int64.testbit (jet_copyBits_partial_crossing.copy_partial_cross_value ss ds old source next) i)
         match Coqlib.zlt i (BinInt.Z.sub ds ss) return bool with
         | left _ =>
             Integers.Int64.testbit next
               (BinInt.Z.add i
                  (BinInt.Z.sub
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (BinInt.Z.sub ds ss)))
         | right _ =>
             match Coqlib.zlt i ds return bool with
             | left _ => Integers.Int64.testbit source (BinInt.Z.sub i (BinInt.Z.sub ds ss))
             | right _ => Integers.Int64.testbit old i
             end
         end
