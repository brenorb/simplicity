### C.jet_secp_double_literal.literal_gej_double_step
literal_gej_double_step
     : forall x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Prod
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_gej_double Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))
         match
           Bit.toBool
             (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem
                (@pair
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))
           return
             (Ty.tySem
                (Ty.Prod
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         with
         | true => @jet_secp_literal_infinity.literal_gej_infinity Alg.CoreFunSem tt
         | false =>
             @literal_gej_double_body Alg.CoreFunSem
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)
         end
