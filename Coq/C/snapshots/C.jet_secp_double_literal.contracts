     (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S (S O))))))))) term
     (@Bit.false (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S (S O))))))))) term)
