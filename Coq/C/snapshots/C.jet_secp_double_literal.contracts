  (@Alg.Core.Combinators.comp
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Word.full_right_shift1 (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S (S O)))))))) term)
     (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit))
           (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
