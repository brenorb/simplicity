### C.jet_secp_double_literal.literal_gej_double_body_step
literal_gej_double_body_step
     : forall x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       let s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
