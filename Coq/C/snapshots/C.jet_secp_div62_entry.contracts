### C.jet_secp_div62_entry.div62_initializers_source
div62_initializers_source
     : @eq Clight.statement div62_initializers
         (Clight.Ssequence
            (Clight.Sset jets_secp._u
               (Clight.Ecast (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tulong))
            (Clight.Ssequence
               (Clight.Sset jets_secp._v
                  (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Ctypesdefs.tulong))
               (Clight.Ssequence
                  (Clight.Sset jets_secp._q
                     (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Ctypesdefs.tulong))
                  (Clight.Ssequence
                     (Clight.Sset jets_secp._r
                        (Clight.Ecast (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tulong))
                     (Clight.Ssequence (Clight.Sset jets_secp._f (Clight.Etempvar jets_secp._f0 Ctypesdefs.tulong))
                        (Clight.Ssequence (Clight.Sset jets_secp._g (Clight.Etempvar jets_secp._g0 Ctypesdefs.tulong))
                           (Clight.Ssequence
                              (Clight.Sset jets_secp._i
                                 (Clight.Econst_int
                                    (Integers.Int.repr
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                    Ctypesdefs.tint)) Clight.Sskip)))))))
### C.jet_secp_div62_entry.exec_div62_initializers
exec_div62_initializers
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (f0 g0 : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._f0 le)
                (@Some Values.val (Values.Vlong f0)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._g0 le)
                (@Some Values.val (Values.Vlong g0))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m div62_initializers Events.E0
         (div62_initial_temps le f0 g0) m ClightBigstep.Out_normal
### C.jet_secp_div62_entry.div62_initial_temps_outside
div62_initial_temps_outside
     : forall (le : Maps.PTree.tree Values.val) (f0 g0 : Integers.Int64.int) (id : AST.ident)
         (_ : not
                (@List.In AST.ident id
                   (@cons AST.ident jets_secp._u
                      (@cons AST.ident jets_secp._v
                         (@cons AST.ident jets_secp._q
                            (@cons AST.ident jets_secp._r
                               (@cons AST.ident jets_secp._f
                                  (@cons AST.ident jets_secp._g (@cons AST.ident jets_secp._i (@nil AST.ident)))))))))),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (div62_initial_temps le f0 g0))
         (@Maps.PTree.get Values.val id le)
### C.jet_secp_div62_entry.div62_function_entry
div62_function_entry
     : forall (m : Memory.Mem.mem) (eta f0 g0 : Integers.Int64.int) (b : Values.block),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_modinv64_divsteps_62_var
         (@cons Values.val (Values.Vlong eta)
            (@cons Values.val (Values.Vlong f0)
               (@cons Values.val (Values.Vlong g0)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val))))) m Clight.empty_env
         (div62_entry_temps eta f0 g0 b) m
### C.jet_secp_div62_entry.div62_entry_to_loop
div62_entry_to_loop
     : forall (m : Memory.Mem.mem) (st : divstep.State) (precision : BinNums.Z) (f0 g0 : Integers.Int64.int)
         (b : Values.block)
         (_ : and
                (BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                   precision)
                (BinInt.Z.le precision
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : Zdiv.eqm (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) precision) (Integers.Int64.unsigned f0)
                (divstep.f st))
         (_ : Zdiv.eqm (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) precision) (Integers.Int64.unsigned g0)
                (divstep.g st)),
       @ex Clight.temp_env
         (fun le0 : Clight.temp_env =>
          @ex Clight.temp_env
            (fun le1 : Clight.temp_env =>
             and
               (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_modinv64_divsteps_62_var
                  (@cons Values.val (Values.Vlong (Integers.Int64.repr (divstep.eta st)))
                     (@cons Values.val (Values.Vlong f0)
                        (@cons Values.val (Values.Vlong g0)
                           (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val))))) m
                  Clight.empty_env le0 m)
               (and
                  (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le0 m div62_initializers
                     Events.E0 le1 m ClightBigstep.Out_normal)
                  (and (jet_secp_div62_transition.div62_pending_matrix le1 divstep.Trans.I BinNums.Z0)
                     (and (jet_secp_div62_transition.div62_pending_fg le1 st precision BinNums.Z0)
                        (and
                           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._eta le1)
                              (@Some Values.val (Values.Vlong (Integers.Int64.repr (divstep.eta st)))))
                           (and
                              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le1)
                                 (@Some Values.val
                                    (Values.Vint
                                       (Integers.Int.repr
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t le1)
                                 (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero))))))))))
### C.jet_secp_div62_entry.div62_initializers
div62_initializers =
jet_secp_statement_prefix.statement_sequence
  (@List.firstn Clight.statement (S (S (S (S (S (S (S O)))))))
     (@fst (list Clight.statement) Clight.statement jet_secp_div62_count.div62_parts)) Clight.Sskip
     : Clight.statement
### C.jet_secp_div62_entry.div62_initial_temps
div62_initial_temps =
fun (le : Maps.PTree.tree Values.val) (f0 g0 : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_secp._i
  (Values.Vint
     (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
  (@Maps.PTree.set Values.val jets_secp._g (Values.Vlong g0)
     (@Maps.PTree.set Values.val jets_secp._f (Values.Vlong f0)
        (@Maps.PTree.set Values.val jets_secp._r (Values.Vlong Integers.Int64.one)
           (@Maps.PTree.set Values.val jets_secp._q (Values.Vlong Integers.Int64.zero)
              (@Maps.PTree.set Values.val jets_secp._v (Values.Vlong Integers.Int64.zero)
                 (@Maps.PTree.set Values.val jets_secp._u (Values.Vlong Integers.Int64.one) le))))))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments div62_initial_temps le f0 g0
### C.jet_secp_div62_entry.div62_entry_temps
div62_entry_temps =
fun (eta f0 g0 : Integers.Int64.int) (b : Values.block) =>
@Maps.PTree.set Values.val jets_secp._t (Values.Vptr b Integers.Ptrofs.zero)
  (@Maps.PTree.set Values.val jets_secp._g0 (Values.Vlong g0)
     (@Maps.PTree.set Values.val jets_secp._f0 (Values.Vlong f0)
        (@Maps.PTree.set Values.val jets_secp._eta (Values.Vlong eta)
           (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_modinv64_divsteps_62_var)))))
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Values.block),
       Maps.PTree.tree Values.val

