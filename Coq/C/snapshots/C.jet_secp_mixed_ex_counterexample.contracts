         (@Some (option bool) (@Some bool false))
### C.jet_secp_mixed_ex_counterexample.extended_ratio_literal_head
extended_ratio_literal_head
     : @eq (option BitMachine.Cell) (@List.nth_error BitMachine.Cell extended_ratio_literal_cells O)
         (@Some (option bool) (@Some bool true))
### C.jet_secp_mixed_ex_counterexample.extended_ratio_cells_differ
extended_ratio_cells_differ
     : not (@eq (list BitMachine.Cell) extended_ratio_actual_cells extended_ratio_literal_cells)
### C.jet_secp_mixed_ex_counterexample.extended_ratio_output_length
extended_ratio_output_length
     : @eq nat (@length BitMachine.Cell extended_ratio_actual_cells)
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))))
### C.jet_secp_mixed_ex_counterexample.extended_ratio_output_conflict
extended_ratio_output_conflict
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (_ : jet_encoding.frame_output_cells_at m bw edge cursor extended_ratio_actual_cells),
       not (jet_encoding.frame_output_cells_at m bw edge cursor extended_ratio_literal_cells)
### C.jet_secp_mixed_ex_counterexample.gej_ge_add_ex_public_counterexample
gej_ge_add_ex_public_counterexample
     : forall env : Values.val,
       @ex Memory.Mem.mem
         (fun minit : Memory.Mem.mem =>
          @ex Memory.Mem.mem
