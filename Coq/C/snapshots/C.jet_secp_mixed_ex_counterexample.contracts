                                                         (Word.Word (S (...))))
                                                      (Ty.Prod (Word.Word (S (...))) (Word.Word (S (...)))))
                                                   extended_ratio_input))
                                             (and
                                                (jet_output_layout.write_frame_at m bd BinNums.Z0 bw BinNums.Z0
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...)))))
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...))))))
                                                (and
                                                   (and (not (@eq Values.block bd bi))
                                                      (and (not (@eq Values.block bd bw))
                                                         (and (not (...)) (and (...) (...)))))
                                                   (and
                                                      (forall (b : Values.block) (_ : Memory.Mem.valid_block minit b),
                                                       and (Memory.Mem.valid_block m b) (and (not ...) (and ... ...)))
                                                      (and
                                                         (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                                            (@Ctypes.Internal Clight.function
                                                               jets_secp.f_simplicity_gej_ge_add_ex)
                                                            (@cons Values.val (...) (...)) Events.E0 mf
                                                            (Values.Vint Integers.Int.one))
                                                         (and
                                                            (jet_frame_layout.frame_fields_at mf bd BinNums.Z0 bw
                                                               BinNums.Z0 BinNums.Z0) (and (...) (...)))))))))))))))))))
### C.jet_secp_mixed_ex_counterexample.extended_ratio_input
extended_ratio_input =
@pair
  (prod
     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (@pair
