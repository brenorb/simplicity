### C.jet_elements_tappath_local.tappath_index_ptr
tappath_index_ptr
     : forall (pbase z : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 pbase)
         (_ : and (BinInt.Z.le BinNums.Z0 z)
                (BinInt.Z.lt z
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add
                   (BinInt.Z.add pbase
                      (BinInt.Z.mul
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) z))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned),
       @eq Integers.Ptrofs.int
         (Integers.Ptrofs.add (Integers.Ptrofs.repr pbase)
            (Integers.Ptrofs.mul
               (Integers.Ptrofs.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (Integers.Ptrofs.of_ints (Integers.Int.repr z))))
         (Integers.Ptrofs.repr
            (BinInt.Z.add pbase
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  z)))
