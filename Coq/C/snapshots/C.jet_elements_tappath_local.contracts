eval_elements_env_taproot
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (be : Values.block)
         (ebase : BinNums.Z) (bt : Values.block) (tbase : BinNums.Z)
