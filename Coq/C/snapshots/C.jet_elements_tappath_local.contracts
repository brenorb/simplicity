     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) (@nil Clight.expr)))
  (Clight.Sset jets_elements._i (Clight.Ecast (Clight.Etempvar jets_elements._t'1 Ctypesdefs.tuchar) Ctypesdefs.tuchar))
     : Clight.statement
### C.jet_elements_tappath_local.tappath_cond
tappath_cond =
Clight.Ssequence (Clight.Sset jets_elements._t'5 elements_env_taproot_expr)
  (Clight.Ssequence
     (Clight.Sset jets_elements._t'6
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_elements._t'5
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTapEnv Ctypes.noattr)))
              (Ctypes.Tstruct jets_elements._elementsTapEnv Ctypes.noattr)) jets_elements._pathLen Ctypesdefs.tuchar))
     (Clight.Scall (@Some AST.ident jets_elements._t'2)
        (Clight.Evar jets_elements._writeBit
           (Ctypes.Tfunction
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                 (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
        (@cons Clight.expr
           (Clight.Etempvar jets_elements._dst
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
           (@cons Clight.expr
              (Clight.Ebinop Cop.Olt (Clight.Etempvar jets_elements._i Ctypesdefs.tuchar)
                 (Clight.Etempvar jets_elements._t'6 Ctypesdefs.tuchar) Ctypesdefs.tint) (@nil Clight.expr)))))
     : Clight.statement
### C.jet_elements_tappath_local.tappath_then
tappath_then =
Clight.Ssequence (Clight.Sset jets_elements._t'3 elements_env_taproot_expr)
  (Clight.Ssequence
     (Clight.Sset jets_elements._t'4
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_elements._t'3
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTapEnv Ctypes.noattr)))
              (Ctypes.Tstruct jets_elements._elementsTapEnv Ctypes.noattr)) jets_elements._path
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))))
     (Clight.Scall (@None AST.ident)
        (Clight.Evar jets_elements._writeHash
           (Ctypes.Tfunction
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                 (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
