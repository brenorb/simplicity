### C.jet_elements_tappath_local.tappath_head
tappath_head =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_elements._t'1)
     (Clight.Evar jets_elements._simplicity_read8
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Ctypes.Tnil)
