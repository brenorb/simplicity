                 (Clight.Etempvar jets_elements._i Ctypesdefs.tuchar)
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
              (@nil Clight.expr)))))
