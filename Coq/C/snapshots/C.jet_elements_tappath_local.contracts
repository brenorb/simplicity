### C.jet_elements_tappath_local.tappath_rest
tappath_rest =
Clight.Ssequence tappath_head
  (Clight.Ssequence
     (Clight.Ssequence tappath_cond
        (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'2 Ctypesdefs.tbool) tappath_then
           (jet_elements_indexed_scalar.elements_skip_stmt
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
     (Clight.Sreturn
        (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint))))
     : Clight.statement
### C.jet_elements_tappath_local.tappath_cells
tappath_cells =
fun (path : list Digest.hash256) (a : Ty.tySem (Word.Word (S (S (S O))))) =>
match
  @List.nth_error Digest.hash256 path (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) a))
  return (list BitMachine.Cell)
with
| Some h => @cons (option bool) (@Some bool true) (jet_elements_hash_write.hash_cells (Digest.hash256_reg h))
| None =>
    @cons (option bool) (@Some bool false)
      (@List.repeat (option bool) (@None bool)
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
end
     : forall (_ : list Digest.hash256) (_ : Ty.tySem (Word.Word (S (S (S O))))), list BitMachine.Cell

Arguments tappath_cells path%list_scope a
### C.jet_elements_tappath_local.elements_tappath_env_rep
elements_tappath_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (e : jet_elements_prim.Elements.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            @ex Values.block
              (fun bp : Values.block =>
               @ex BinNums.Z
                 (fun pbase : BinNums.Z =>
                  and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                    (and
                       (le (@length Digest.hash256 (jet_elements_prim.tappath (jet_elements_prim.Elements.envTap e)))
                          (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))
                       (and (BinInt.Z.le BinNums.Z0 ebase)
                          (and
                             (BinInt.Z.le
                                (BinInt.Z.add ebase
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                Integers.Ptrofs.max_unsigned)
                             (and (BinInt.Z.le BinNums.Z0 tbase)
                                (and
                                   (BinInt.Z.le
                                      (BinInt.Z.add tbase
                                         (BinNums.Zpos
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))
                                      Integers.Ptrofs.max_unsigned)
                                   (and (BinInt.Z.le BinNums.Z0 pbase)
                                      (and
                                         (BinInt.Z.le
                                            (BinInt.Z.add pbase
                                               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))
                                                  (BinInt.Z.of_nat
                                                     (@length Digest.hash256 (jet_elements_prim.tappath ...)))))
                                            Integers.Ptrofs.max_unsigned)
                                         (and
                                            (@eq (option Values.val)
                                               (Memory.Mem.load AST.Mptr m be
                                                  (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO ...))))
                                               (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                                            (and
                                               (@eq (option Values.val)
                                                  (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add tbase BinNums.Z0))
                                                  (@Some Values.val (Values.Vptr bp (Integers.Ptrofs.repr pbase))))
                                               (and
                                                  (@eq (option Values.val)
                                                     (Memory.Mem.load AST.Mint8unsigned m bt (BinInt.Z.add tbase ...))
                                                     (@Some Values.val (Values.Vint ...)))
                                                  (and
                                                     (forall (j : nat) (h : Digest.hash256) (_ : ...),
                                                      jet_elements_hash_elem.hash_elem_rep m bp (...) h)
                                                     (@eq (list ...) fp (@cons ... ... ...)))))))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments elements_tappath_env_rep m env e fp%list_scope
### C.jet_elements_tappath_local.elements_tappath_spec
elements_tappath_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim (Word.Word (S (S (S O))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg jet_elements_prim.Elements.Tappath
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S O))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments elements_tappath_spec {alg}
### C.jet_elements_tappath_local.elements_tappath_result
elements_tappath_result =
fun (path : list Digest.hash256) (a : Ty.tySem (Word.Word (S (S (S O))))) =>
match
  @List.nth_error Digest.hash256 path (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) a))
  return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| Some h => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
end
     : forall (_ : list Digest.hash256) (_ : Ty.tySem (Word.Word (S (S (S O))))),
       Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments elements_tappath_result path%list_scope a
