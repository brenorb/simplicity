### C.jet_secp_generator_load_storage.generator_byte_member
generator_byte_member
     : forall (count : nat) (ofs : BinNums.Z) (start i : nat) (_ : lt i count),
       @List.In jet_sx_state.cell
         (jet_sx_state.mkcell (BinInt.Z.add ofs (BinInt.Z.of_nat i)) AST.Mint8unsigned
            (@Some jet_sx_expr.sx (jet_sx_expr.XL2I (jet_sx_expr.XLv (Nat.add start i)))))
         (jet_secp_fe_b32.byte_cells ofs count start)
### C.jet_secp_generator_load_storage.generator_point_initial
generator_point_initial
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat) (_ : @eq BinNums.Z (jet_sx_state.bas beta r) BinNums.Z0)
         (_ : Memory.Mem.range_perm m (jet_sx_state.blk beta r) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       jet_sx_state.region_ok rho beta m r jet_secp_affine_storage.affine_storage_undef
### C.jet_secp_generator_load_storage.generator_load_initial
generator_load_initial
     : forall (xs ys : list BinNums.Z) (m : Memory.Mem.mem) (bp bg : Values.block)
         (_ : @eq nat (@length BinNums.Z xs)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length BinNums.Z ys)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                xs)
         (_ : @List.Forall BinNums.Z
                (fun y : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 y)
                   (BinInt.Z.le y
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                ys) (_ : not (@eq Values.block bp bg))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bg BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bg (BinInt.Z.of_nat i))
                (@Some Values.val
                   (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i (@app BinNums.Z xs ys) BinNums.Z0))))),
       jet_sx_state.rep (jet_secp_generator_load_values.generator_byte_pair xs ys)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bg BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) jet_secp_generator_load.generator_load_regs m
### C.jet_secp_generator_load_storage.generator_load_fields
generator_load_fields
     : forall (xs ys : list BinNums.Z) (m : Memory.Mem.mem) (bp bg : Values.block)
         (_ : @eq nat (@length BinNums.Z xs)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length BinNums.Z ys)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                xs)
         (_ : @List.Forall BinNums.Z
                (fun y : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 y)
                   (BinInt.Z.le y
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                ys)
         (_ : jet_sx_state.rep (jet_secp_generator_load_values.generator_byte_pair xs ys)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bg BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))) jet_secp_generator_load.generator_load_out_regs m),
       and
         (jet_secp_fe_nv.fe_at m bp BinNums.Z0
            (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
               (jet_secp_fe_math.fe_limbs_of (jet_secp_fe_math.be_val xs))))
         (and
            (jet_secp_fe_nv.fe_at m bp
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
               (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                  (jet_secp_fe_math.fe_limbs_of (jet_secp_fe_math.be_val ys))))
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 m bp
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@Some Values.val (Values.Vint Integers.Int.zero)))
               (and
                  (Memory.Mem.range_perm m bp BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm m bg BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))),
                      @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bg (BinInt.Z.of_nat i))
                        (@Some Values.val
                           (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i (@app BinNums.Z xs ys) BinNums.Z0)))))))))
### C.jet_secp_generator_load_storage.eval_generator_load_from_storage
eval_generator_load_from_storage
     : forall (xs ys : list BinNums.Z) (m : Memory.Mem.mem) (bp bg : Values.block)
         (_ : @eq nat (@length BinNums.Z xs)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length BinNums.Z ys)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                xs)
         (_ : @List.Forall BinNums.Z
                (fun y : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 y)
                   (BinInt.Z.le y
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                ys) (_ : not (@eq Values.block bp bg))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bg BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bg (BinInt.Z.of_nat i))
                (@Some Values.val
                   (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i (@app BinNums.Z xs ys) BinNums.Z0))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_load)
               (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bg Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bp BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_fe_math.fe_limbs_of (jet_secp_fe_math.be_val xs))))
               (and
                  (jet_secp_fe_nv.fe_at mf bp
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_fe_math.fe_limbs_of (jet_secp_fe_math.be_val ys))))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bp
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (Memory.Mem.range_perm mf bp BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bg BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))),
                               @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned mf bg (BinInt.Z.of_nat i))
                                 (@Some Values.val
                                    (Values.Vint
                                       (Integers.Int.repr (@List.nth BinNums.Z i (@app BinNums.Z xs ys) BinNums.Z0)))))
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bp)) (not (@eq Values.block b bg))) m mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
