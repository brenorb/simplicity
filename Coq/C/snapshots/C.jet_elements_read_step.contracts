### C.jet_elements_read_step.wide_reader_helper
wide_reader_helper
     : forall s : jet_wide.wide_size,
       @ex AST.ident
         (fun id : AST.ident =>
          @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id (jet_wide.wide_reader s))
            jet_elements_transport.elements_core_helpers)
### C.jet_elements_read_step.elements_read_wide_step
elements_read_wide_step
     : forall (s : jet_wide.wide_size) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc : Memory.Mem.mem)
         (bl bs : Values.block) (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (x : Ty.tySem (Word.Word (jet_wide.wide_log s))) (bytes : list Memdata.memval)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (jet_wide.wide_bits s))))
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge rc x)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          @ex Integers.Int64.int
            (fun r : Integers.Int64.int =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mc
                  (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                  (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val)) Events.E0 mr
                  (Values.Vlong r))
               (and
                  (@eq BinNums.Z (Integers.Int64.unsigned r)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) x))
                  (and
                     (jet_frame_layout.frame_fields_at mr bl BinNums.Z0 bi edge
                        (BinInt.Z.add rc (jet_wide.wide_bits s)))
                     (and
                        (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                           (_ : not (@eq Values.block b bl)),
                         @eq (option Values.val) (Memory.Mem.load chunk mr b ofs) (Memory.Mem.load chunk mc b ofs))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm mc b ofs kind p),
                            Memory.Mem.perm mr b ofs kind p)
                           (and
                              (forall (b : Values.block) (_ : Memory.Mem.valid_block mc b), Memory.Mem.valid_block mr b)
                              (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                 (v : Values.val)
                                 (_ : @eq (option Values.val) (Memory.Mem.load chunk m b ofs) (@Some Values.val v)),
                               @eq (option Values.val) (Memory.Mem.load chunk mr b ofs) (@Some Values.val v)))))))))
