### C.jet_elements_single_issuance_active.eis_some_shape
eis_some_shape
     : @eq Clight.statement jet_elements_single_issuance_prep.eis_some
         (Clight.Ssequence jet_elements_single_issuance_asset.eis_asset_prefix
            (Clight.Ssequence jet_elements_single_issuance_amount.eis_asset_amount_stmt
               (Clight.Ssequence jet_elements_single_issuance_asset.eis_token_prefix
