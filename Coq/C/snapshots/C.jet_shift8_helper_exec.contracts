### C.jet_shift8_helper_exec.shift8_reader_symbol
shift8_reader_symbol
     : forall nibble : bool,
       @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (shift8_reader_id nibble)) (@Some Values.block (jet_exec.jet_symbol_block (shift8_reader_id nibble)))
### C.jet_shift8_helper_exec.shift8_reader_funct
shift8_reader_funct
     : forall nibble : bool,
       @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block (shift8_reader_id nibble)) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (shift8_reader_function nibble)))
### C.jet_shift8_helper_exec.exec_shift8_reader
exec_shift8_reader
     : forall (nibble : bool) (result : AST.ident) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bs : Values.block) (sofs : Integers.Ptrofs.int) (r : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src le)
                (@Some Values.val (Values.Vptr bs sofs)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function (shift8_reader_function nibble))
                (@cons Values.val (Values.Vptr bs sofs) (@nil Values.val)) Events.E0 mf (Values.Vint r)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m (jet_shift8_expr.shift8_reader nibble result)
         Events.E0 (@Maps.PTree.set Values.val result (Values.Vint r) le) mf ClightBigstep.Out_normal
### C.jet_shift8_helper_exec.shift8_fill_env_output
shift8_fill_env_output
     : forall (fill : bool) (r : Integers.Int.int) (le : Maps.PTree.tree Values.val)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._output le) (@Some Values.val (Values.Vint r))),
       @eq (option Values.val) (@Maps.PTree.get Values.val jets._output (shift8_fill_env fill r le))
         (@Some Values.val (Values.Vint (shift8_maybe_fill fill r)))
### C.jet_shift8_helper_exec.shift8_fill_env_other
shift8_fill_env_other
     : forall (fill : bool) (r : Integers.Int.int) (le : Maps.PTree.tree Values.val) (id : AST.ident)
         (_ : not (@eq AST.ident id jets._output)),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (shift8_fill_env fill r le))
         (@Maps.PTree.get Values.val id le)
### C.jet_shift8_helper_exec.exec_shift8_fill_step
exec_shift8_fill_step
     : forall (fill : bool) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (r : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._with le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int fill))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._output le) (@Some Values.val (Values.Vint r))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m jet_shift8_expr.shift8_fill_step Events.E0
         (shift8_fill_env fill r le) m ClightBigstep.Out_normal
### C.jet_shift8_helper_exec.entry_shift8_helper
entry_shift8_helper
     : forall (right fill : bool) (m : Memory.Mem.mem) (bd : Values.block) (dofs : Integers.Ptrofs.int)
         (bs : Values.block) (sofs : Integers.Ptrofs.int),
       Clight.function_entry2 jet_exec.ge0 (jet_shift8_expr.shift8_helper right)
         (@cons Values.val (Values.Vint (jet_readBit_layout.bit_int fill))
            (@cons Values.val (Values.Vptr bd dofs) (@cons Values.val (Values.Vptr bs sofs) (@nil Values.val)))) m
         Clight.empty_env (le_shift8_helper right fill bd dofs bs sofs) m
### C.jet_shift8_helper_exec.eval_shift8_helper_composes
eval_shift8_helper_composes
     : forall (right fill : bool) (m mr mr2 mf : Memory.Mem.mem) (bd : Values.block) (dofs : Integers.Ptrofs.int)
         (bs : Values.block) (sofs : Integers.Ptrofs.int) (a r : Integers.Int.int)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_simplicity_read4)
                (@cons Values.val (Values.Vptr bs sofs) (@nil Values.val)) Events.E0 mr (Values.Vint a))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                (@cons Values.val (Values.Vptr bs sofs) (@nil Values.val)) Events.E0 mr2 (Values.Vint r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd dofs)
                   (@cons Values.val
                      (Values.Vint
                         (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (shift8_payload right fill r a))) (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function (jet_shift8_expr.shift8_helper right))
         (@cons Values.val (Values.Vint (jet_readBit_layout.bit_int fill))
            (@cons Values.val (Values.Vptr bd dofs) (@cons Values.val (Values.Vptr bs sofs) (@nil Values.val))))
         Events.E0 mf Values.Vundef
### C.jet_shift8_helper_exec.shift8_reader_function
shift8_reader_function =
fun nibble : bool =>
match nibble return Clight.function with
| true => jets.f_simplicity_read4
| false => jets.f_simplicity_read8
end
     : forall _ : bool, Clight.function

Arguments shift8_reader_function nibble%bool_scope
### C.jet_shift8_helper_exec.shift8_reader_id
shift8_reader_id =
fun nibble : bool =>
match nibble return AST.ident with
| true => jets._simplicity_read4
| false => jets._simplicity_read8
end
     : forall _ : bool, AST.ident

Arguments shift8_reader_id nibble%bool_scope
### C.jet_shift8_helper_exec.shift8_maybe_fill
shift8_maybe_fill =
fun (fill : bool) (r : Integers.Int.int) =>
match fill return Integers.Int.int with
| true => jet_shift8_expr.shift8_fill_result r
| false => r
end
     : forall (_ : bool) (_ : Integers.Int.int), Integers.Int.int

Arguments shift8_maybe_fill fill%bool_scope r
### C.jet_shift8_helper_exec.shift8_fill_env
shift8_fill_env =
fun (fill : bool) (r : Integers.Int.int) (le : Maps.PTree.tree Values.val) =>
match fill return (Maps.PTree.tree Values.val) with
| true => @Maps.PTree.set Values.val jets._output (Values.Vint (jet_shift8_expr.shift8_fill_result r)) le
| false => le
end
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Maps.PTree.tree Values.val), Maps.PTree.tree Values.val

Arguments shift8_fill_env fill%bool_scope r le
### C.jet_shift8_helper_exec.shift8_count_result
shift8_count_result =
fun (right : bool) (r a : Integers.Int.int) =>
match
  Coqlib.zlt (Integers.Int.unsigned a) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
  return Integers.Int.int
with
| left _ => jet_shift8_expr.shift8_scalar_result right r a
| right _ => Integers.Int.zero
end
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments shift8_count_result right%bool_scope r a
### C.jet_shift8_helper_exec.shift8_payload
shift8_payload =
fun (right fill : bool) (r a : Integers.Int.int) =>
shift8_maybe_fill fill
  (shift8_count_result right
     (shift8_maybe_fill fill (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r))
     (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) a))
     : forall (_ : bool) (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments shift8_payload (right fill)%bool_scope r a
### C.jet_shift8_helper_exec.le_shift8_helper
le_shift8_helper =
fun (right fill : bool) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) =>
@Maps.PTree.set Values.val jets._src (Values.Vptr bs sofs)
  (@Maps.PTree.set Values.val jets._dst (Values.Vptr bd dofs)
     (@Maps.PTree.set Values.val jets._with (Values.Vint (jet_readBit_layout.bit_int fill))
        (Clight.create_undef_temps (Clight.fn_temps (jet_shift8_expr.shift8_helper right)))))
     : forall (_ : bool) (_ : bool) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int), Maps.PTree.tree Values.val

Arguments le_shift8_helper (right fill)%bool_scope bd dofs bs sofs
