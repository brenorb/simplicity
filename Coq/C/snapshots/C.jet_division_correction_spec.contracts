### C.jet_division_correction_spec.division_high_word_value
division_high_word_value
     : forall n : nat,
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ n) (@jet_division_core_spec.division_high_word n Alg.CoreFunSem tt))
         (BinInt.Z.sub (jet_predicate_spec.word_modulus n) (BinNums.Zpos BinNums.xH))
### C.jet_division_correction_spec.div3n2n_loop1_unfold
div3n2n_loop1_unfold
     : forall (n : nat) (r b : Ty.tySem (Word.Word (S n))) (q : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (Ty.Prod (Word.Word n) (Word.Word (S n))))
         (@jet_division_core_spec.div3n2n_loop1_spec n Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S n))) (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (S n)))) r
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (S n))) q b)))
         (let s : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S n))) :=
            @Word.adder (S n) Alg.CoreFunSem (@pair (Ty.tySem (Word.Word (S n))) (Ty.tySem (Word.Word (S n))) r b) in
          let d :
            (fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word n) :=
            @snd (sum unit unit)
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end) (Word.Word n)) (@jet_subtract_spec.decrement_word_spec Alg.CoreFunSem n q) in
          match
            @fst (sum unit unit)
              (prod
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                        match n0 return Ty.Ty with
                        | O => X
                        | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                        end) (Ty.Sum Ty.Unit Ty.Unit) n))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                        match n0 return Ty.Ty with
                        | O => X
                        | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                        end) (Ty.Sum Ty.Unit Ty.Unit) n))) s
            return (Ty.tySem (Ty.Prod (Word.Word n) (Word.Word (S n))))
          with
          | inl _ =>
              @jet_division_core_spec.div3n2n_loop2_spec n Alg.CoreFunSem
                (@pair
                   (prod
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end)
                         ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                             match n0 return Ty.Ty with
                             | O => X
                             | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                             end) (Ty.Sum Ty.Unit Ty.Unit) n))
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end)
                         ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                             match n0 return Ty.Ty with
                             | O => X
                             | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                             end) (Ty.Sum Ty.Unit Ty.Unit) n)))
                   (prod
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word n)) (Ty.tySem (Word.Word (S n))))
                   (@snd (sum unit unit)
                      (prod
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end)
                            ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                match n0 return Ty.Ty with
                                | O => X
                                | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                end) (Ty.Sum Ty.Unit Ty.Unit) n))
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end)
                            ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                match n0 return Ty.Ty with
                                | O => X
                                | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                end) (Ty.Sum Ty.Unit Ty.Unit) n))) s)
                   (@pair
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word n)) (Ty.tySem (Word.Word (S n))) d b))
          | inr _ =>
              @pair
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) (Word.Word n))
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                          match n0 return Ty.Ty with
                          | O => X
                          | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                          end) (Ty.Sum Ty.Unit Ty.Unit) n))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                          match n0 return Ty.Ty with
                          | O => X
                          | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                          end) (Ty.Sum Ty.Unit Ty.Unit) n))) d
                (@snd (sum unit unit)
                   (prod
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end)
                         ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
