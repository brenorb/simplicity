          end)
### C.jet_division_correction_spec.div3n2n_loop0_unfold
div3n2n_loop0_unfold
     : forall (n : nat) (r b : Ty.tySem (Word.Word (S n))) (q : Ty.tySem (Word.Word n)) (c : sum unit unit),
       @eq (Ty.tySem (Ty.Prod (Word.Word n) (Word.Word (S n))))
         (@jet_division_core_spec.div3n2n_loop0_spec n Alg.CoreFunSem
            (@pair (prod (sum unit unit) (Ty.tySem (Word.Word (S n))))
               (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (S n))))
               (@pair (sum unit unit) (Ty.tySem (Word.Word (S n))) c r)
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (S n))) q b)))
         match c return (Ty.tySem (Ty.Prod (Word.Word n) (Word.Word (S n)))) with
         | inl _ => @pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (S n))) q r
         | inr _ =>
             @jet_division_core_spec.div3n2n_loop1_spec n Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S n))) (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (S n)))) r
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (S n))) q b))
         end
### C.jet_division_correction_spec.division_add_balance
division_add_balance
     : forall (n : nat) (x y : Ty.tySem (Word.Word n)),
       let z : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) :=
         @Word.adder n Alg.CoreFunSem (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y) in
       @eq BinNums.Z
         (BinInt.Z.add
            (BinInt.Z.mul (jet_predicate_spec.word_modulus n)
               (@Word.ToZ.Theory.toZ Word.BitToZ
                  (@fst (sum unit unit)
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n)) z)))
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@snd (sum unit unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n)) z)))
         (BinInt.Z.add (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
### C.jet_division_correction_spec.division_decrement_positive
division_decrement_positive
     : forall (n : nat) (q : Ty.tySem (Word.Word n))
         (_ : BinInt.Z.lt BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ n) q)),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ n)
            (@snd (sum unit unit)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word n)) (@jet_subtract_spec.decrement_word_spec Alg.CoreFunSem n q)))
         (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ n) q) (BinNums.Zpos BinNums.xH))
### C.jet_division_correction_spec.div3n2n_loop2_value
div3n2n_loop2_value
     : forall (n : nat) (r b : Ty.tySem (Word.Word (S n))) (q : Ty.tySem (Word.Word n)) (delta : BinNums.Z)
         (_ : BinInt.Z.lt BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ n) q))
         (_ : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) r)
                (BinInt.Z.add delta (jet_predicate_spec.word_modulus (S n))))
         (_ : and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add delta (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) b)))
                (BinInt.Z.lt (BinInt.Z.add delta (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) b))
                   (jet_predicate_spec.word_modulus (S n)))),
       let z : Ty.tySem (Ty.Prod (Word.Word n) (Word.Word (S n))) :=
         @jet_division_core_spec.div3n2n_loop2_spec n Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word (S n))) (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (S n)))) r
              (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (S n))) q b)) in
       and
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@fst
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n))
                  (prod
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))) z))
            (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ n) q) (BinNums.Zpos BinNums.xH)))
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S n))
               (@snd
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n))
                  (prod
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))) z))
            (BinInt.Z.add delta (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) b)))
