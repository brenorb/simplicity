### C.jet_right_extend_wide_loop.right_extend_wide_loop_shape
right_extend_wide_loop_shape
     : forall s : jet_extend_wide_loop.extend_wide_size,
       @eq Clight.statement
         match Clight.fn_body (right_extend_wide_function s) return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s1 =>
             match s1 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s3 =>
                 match s3 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence _ s5 =>
                     match s5 return Clight.statement with
                     | Clight.Sskip => Clight.Sskip
                     | Clight.Sassign _ _ => Clight.Sskip
                     | Clight.Sset _ _ => Clight.Sskip
                     | Clight.Scall _ _ _ => Clight.Sskip
                     | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                     | Clight.Ssequence _ s7 =>
                         match s7 return Clight.statement with
                         | Clight.Sskip => Clight.Sskip
                         | Clight.Sassign _ _ => Clight.Sskip
                         | Clight.Sset _ _ => Clight.Sskip
                         | Clight.Scall _ _ _ => Clight.Sskip
                         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                         | Clight.Ssequence s8 _ =>
                             match s8 return Clight.statement with
                             | Clight.Sskip => Clight.Sskip
                             | Clight.Sassign _ _ => Clight.Sskip
                             | Clight.Sset _ _ => Clight.Sskip
                             | Clight.Scall _ _ _ => Clight.Sskip
                             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                             | Clight.Ssequence _ loop => loop
                             | Clight.Sifthenelse _ _ _ => Clight.Sskip
                             | Clight.Sloop _ _ => Clight.Sskip
                             | Clight.Sbreak => Clight.Sskip
                             | Clight.Scontinue => Clight.Sskip
                             | Clight.Sreturn _ => Clight.Sskip
                             | Clight.Sswitch _ _ => Clight.Sskip
                             | Clight.Slabel _ _ => Clight.Sskip
                             | Clight.Sgoto _ => Clight.Sskip
                             end
                         | Clight.Sifthenelse _ _ _ => Clight.Sskip
                         | Clight.Sloop _ _ => Clight.Sskip
                         | Clight.Sbreak => Clight.Sskip
                         | Clight.Scontinue => Clight.Sskip
                         | Clight.Sreturn _ => Clight.Sskip
                         | Clight.Sswitch _ _ => Clight.Sskip
                         | Clight.Slabel _ _ => Clight.Sskip
                         | Clight.Sgoto _ => Clight.Sskip
                         end
                     | Clight.Sifthenelse _ _ _ => Clight.Sskip
                     | Clight.Sloop _ _ => Clight.Sskip
                     | Clight.Sbreak => Clight.Sskip
                     | Clight.Scontinue => Clight.Sskip
                     | Clight.Sreturn _ => Clight.Sskip
                     | Clight.Sswitch _ _ => Clight.Sskip
                     | Clight.Slabel _ _ => Clight.Sskip
                     | Clight.Sgoto _ => Clight.Sskip
                     end
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end (right_extend_wide_loop s)
### C.jet_right_extend_wide_loop.eval_extend_wide_limit
eval_extend_wide_limit
     : forall (s : jet_extend_wide_loop.extend_wide_size) (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem),
       Clight.eval_expr jet_exec.ge0 e le m (jet_extend_wide_loop.extend_wide_limit s)
         (Values.Vint (Integers.Int.repr (jet_extend_wide_loop.extend_wide_count s)))
### C.jet_right_extend_wide_loop.eval_extend_wide_guard
eval_extend_wide_guard
     : forall (s : jet_extend_wide_loop.extend_wide_size) (e : Clight.env) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i)))),
       Clight.eval_expr jet_exec.ge0 e le m (jet_extend_wide_loop.extend_wide_guard s)
         (Values.Vint (jet_readBit_layout.bit_int (BinInt.Z.ltb i (jet_extend_wide_loop.extend_wide_count s))))
### C.jet_right_extend_wide_loop.exec_right_extend_wide_fill
exec_right_extend_wide_fill
     : forall (s : jet_extend_wide_loop.extend_wide_size) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bit : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._lsb le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer (jet_extend_wide_loop.extend_wide_input s)))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vlong (jet_pad_bit_spec.extend_bit_long (jet_extend_wide_loop.extend_wide_input s) bit))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (right_extend_wide_fill s) Events.E0
         (@Maps.PTree.set Values.val jets._t'2
            (jet_extend_bit_wide_exec.extend_bit_raw (jet_extend_wide_loop.extend_wide_input s) bit) le) mf
         ClightBigstep.Out_normal
### C.jet_right_extend_wide_loop.exec_right_extend_wide_loop
exec_right_extend_wide_loop
     : forall (s : jet_extend_wide_loop.extend_wide_size) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bit : bool) (i : BinNums.Z)
         (n : nat) (_ : BinInt.Z.le BinNums.Z0 i)
         (_ : @eq BinNums.Z (BinInt.Z.add i (BinInt.Z.of_nat n)) (jet_extend_wide_loop.extend_wide_count s))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._lsb le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : right_extend_wide_fill_run s bd base bit n m mf),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (right_extend_wide_loop s)
               Events.E0 lef mf ClightBigstep.Out_normal)
            (forall (id : AST.ident) (_ : not (@eq AST.ident id jets._i)) (_ : not (@eq AST.ident id jets._t'2)),
             @eq (option Values.val) (@Maps.PTree.get Values.val id lef) (@Maps.PTree.get Values.val id le)))
### C.jet_right_extend_wide_loop.eval_right_extend_wide_lsb
eval_right_extend_wide_lsb
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._input le) (@Some Values.val (Values.Vlong r))),
       Clight.eval_expr jet_exec.ge0 e le m right_extend_wide_lsb_expr
         (Values.Vint (jet_readBit_layout.bit_int (right_extend_wide_lsb r)))
### C.jet_right_extend_wide_loop.right_extend_wide_function
right_extend_wide_function =
fun s : jet_extend_wide_loop.extend_wide_size =>
match s return Clight.function with
| jet_extend_wide_loop.E16to32 => jets.f_simplicity_right_extend_16_32
| jet_extend_wide_loop.E16to64 => jets.f_simplicity_right_extend_16_64
| jet_extend_wide_loop.E32to64 => jets.f_simplicity_right_extend_32_64
end
     : forall _ : jet_extend_wide_loop.extend_wide_size, Clight.function

Arguments right_extend_wide_function s
### C.jet_right_extend_wide_loop.right_extend_wide_choose
right_extend_wide_choose =
fun s : jet_extend_wide_loop.extend_wide_size =>
Clight.Sifthenelse (Clight.Etempvar jets._lsb Ctypesdefs.tbool)
  (Clight.Sset jets._t'2
     (jet_extend_bit_wide_exec.extend_bit_choice_expr (jet_extend_wide_loop.extend_wide_input s) true))
  (Clight.Sset jets._t'2
     (jet_extend_bit_wide_exec.extend_bit_choice_expr (jet_extend_wide_loop.extend_wide_input s) false))
     : forall _ : jet_extend_wide_loop.extend_wide_size, Clight.statement

Arguments right_extend_wide_choose s
### C.jet_right_extend_wide_loop.right_extend_wide_fill
right_extend_wide_fill =
fun s : jet_extend_wide_loop.extend_wide_size =>
Clight.Ssequence (right_extend_wide_choose s)
  (jet_arith8_layout_exec.frame_writer_call (jet_wide.wide_writer_id (jet_extend_wide_loop.extend_wide_input s))
     Ctypesdefs.tulong Ctypesdefs.tvoid
     (Clight.Etempvar jets._t'2 (jet_extend_bit_wide_exec.extend_bit_type (jet_extend_wide_loop.extend_wide_input s))))
     : forall _ : jet_extend_wide_loop.extend_wide_size, Clight.statement

Arguments right_extend_wide_fill s
### C.jet_right_extend_wide_loop.right_extend_wide_loop
right_extend_wide_loop =
fun s : jet_extend_wide_loop.extend_wide_size =>
Clight.Sloop
  (Clight.Ssequence (Clight.Sifthenelse (jet_extend_wide_loop.extend_wide_guard s) Clight.Sskip Clight.Sbreak)
     (right_extend_wide_fill s)) jet_eq256_loop.eq256_loop_step
     : forall _ : jet_extend_wide_loop.extend_wide_size, Clight.statement

Arguments right_extend_wide_loop s
### C.jet_right_extend_wide_loop.right_extend_wide_fill_run
right_extend_wide_fill_run =
fix right_extend_wide_fill_run
  (s : jet_extend_wide_loop.extend_wide_size) (bd : Values.block) (base : BinNums.Z) (bit : bool)
  (n : nat) (m mf : Memory.Mem.mem) {struct n} : Prop :=
  match n return Prop with
  | O => @eq Memory.Mem.mem m mf
  | S n0 =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         and
           (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
              (@Ctypes.Internal Clight.function (jet_wide.wide_writer (jet_extend_wide_loop.extend_wide_input s)))
              (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                 (@cons Values.val
                    (Values.Vlong (jet_pad_bit_spec.extend_bit_long (jet_extend_wide_loop.extend_wide_input s) bit))
                    (@nil Values.val))) Events.E0 mi Values.Vundef) (right_extend_wide_fill_run s bd base bit n0 mi mf))
  end
     : forall (_ : jet_extend_wide_loop.extend_wide_size) (_ : Values.block) (_ : BinNums.Z)
         (_ : bool) (_ : nat) (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments right_extend_wide_fill_run s bd base%Z_scope bit%bool_scope n%nat_scope m mf
### C.jet_right_extend_wide_loop.right_extend_wide_lsb
right_extend_wide_lsb =
fun r : Integers.Int64.int => negb (Integers.Int64.eq (Integers.Int64.and r Integers.Int64.one) Integers.Int64.zero)
     : forall _ : Integers.Int64.int, bool

Arguments right_extend_wide_lsb r
### C.jet_right_extend_wide_loop.right_extend_wide_lsb_expr
right_extend_wide_lsb_expr =
Clight.Ecast
  (Clight.Ebinop Cop.Oand (Clight.Etempvar jets._input Ctypesdefs.tulong)
     (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tulong) Ctypesdefs.tbool
     : Clight.expr
