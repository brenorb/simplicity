Arguments diagonal rho%function_scope n%nat_scope
### C.jet_secp_square_columns.square_input_bounds
square_input_bounds =
fun rho : forall _ : nat, Integers.Int64.int =>
forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
BinInt.Z.lt (Integers.Int64.unsigned (rho i))
  match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
  | true =>
      BinNums.Zpos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))
  | false =>
      BinNums.Zpos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))
  end
     : forall _ : forall _ : nat, Integers.Int64.int, Prop

Arguments square_input_bounds rho%function_scope
