### C.jet_secp_root_square_bridge.literal_fe_squares_successor
literal_fe_squares_successor
     : forall (n : nat) (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_root_literal.literal_fe_squares (S n) Alg.CoreFunSem a)
         (@jet_secp_root_literal.literal_fe_squares n Alg.CoreFunSem
            (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem a))
### C.jet_secp_root_square_bridge.root_square_words_match
root_square_words_match
     : forall (n : nat) (w : forall _ : nat, Integers.Int64.int)
         (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   jet_secp_fe_math.feP)),
       and (jet_secp_square_columns.square_input_bounds (jet_secp_root_square_loop.root_square_words n w))
         (@eq BinNums.Z
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value (jet_secp_root_square_loop.root_square_words n w))
               jet_secp_fe_math.feP)
            (BinInt.Z.modulo
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_root_literal.literal_fe_squares n Alg.CoreFunSem a)) jet_secp_fe_math.feP))
### C.jet_secp_root_square_bridge.exec_root_square_for_literal
exec_root_square_for_literal
     : forall (n : nat) (id : BinNums.positive) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (b : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : BinInt.Z.le (BinInt.Z.of_nat n)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   jet_secp_fe_math.feP))
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (jet_secp_root_square_loop.root_square_for id (BinInt.Z.of_nat n)) Events.E0 lef mf
                  ClightBigstep.Out_normal)
               (and
                  (jet_secp_fe_nv.fe_at mf b BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (jet_secp_root_square_loop.root_square_words n w)))
                  (and
                     (Memory.Mem.range_perm mf b BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_secp_square_columns.square_input_bounds (jet_secp_root_square_loop.root_square_words n w))
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_root_square_loop.root_square_words n w)) jet_secp_fe_math.feP)
                              (BinInt.Z.modulo
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                    (@jet_secp_root_literal.literal_fe_squares n Alg.CoreFunSem a))
                                 jet_secp_fe_math.feP))
                           (and
                              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._j lef)
                                 (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat n)))))
                              (and
                                 (forall (k : AST.ident) (_ : not (@eq AST.ident k jets_secp._j)),
                                  @eq (option Values.val) (@Maps.PTree.get Values.val k lef)
                                    (@Maps.PTree.get Values.val k le))
                                 (jet_sx_mem.lframe
                                    (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf)))))))))
