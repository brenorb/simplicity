### C.jet_secp_eea_literal.literal_eea_result
literal_eea_result =
fun n : nat =>
Ty.Prod
  (Ty.Prod (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
     (Ty.Prod (Word.Word n) (Word.Word n))) (Word.Word n)
     : forall _ : nat, Ty.Ty

