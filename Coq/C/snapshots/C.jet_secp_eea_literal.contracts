### C.jet_secp_eea_literal.literal_eea_row
literal_eea_row =
fun n : nat => Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)
     : forall _ : nat, Ty.Ty

Arguments literal_eea_row n%nat_scope
### C.jet_secp_eea_literal.literal_eea_state
literal_eea_state = fun n : nat => Ty.Prod (literal_eea_row n) (literal_eea_row n)
     : forall _ : nat, Ty.Ty

