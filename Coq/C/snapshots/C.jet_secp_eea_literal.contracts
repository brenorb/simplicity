     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (literal_eea_state n) (literal_eea_row n)

Arguments literal_eea_row_step n%nat_scope {term}
### C.jet_secp_eea_literal.literal_eea_step
literal_eea_step =
fun (n : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp
  (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
     (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
     (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
        (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))))
  (Ty.Prod (literal_eea_row n) (literal_eea_row n)) term
  (@Alg.Core.Combinators.pair
     (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
        (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))) (Ty.Sum Ty.Unit Ty.Unit)
     (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
        (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))) term
     (@Alg.Core.Combinators.comp
        (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
           (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))) (Ty.Prod (Word.Word n) (Word.Word n))
        (Ty.Sum Ty.Unit Ty.Unit) term
        (@Alg.Core.Combinators.pair
           (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
              (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))) (Word.Word n)
           (Word.Word n) term
           (@Alg.Core.Combinators.drop (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
              (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) (Word.Word n) term
              (@Alg.Core.Combinators.drop (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)
                 (Word.Word n) term (@Alg.Core.Combinators.iden (Word.Word n) term)))
           (@Alg.Core.Combinators.take (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
              (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) (Word.Word n) term
              (@Alg.Core.Combinators.drop (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)
                 (Word.Word n) term (@Alg.Core.Combinators.iden (Word.Word n) term))))
        (@jet_order_spec.lt_word_spec term n))
     (@Alg.Core.Combinators.iden
        (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
           (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))) term))
  (@Bit.cond (literal_eea_state n) (Ty.Prod (literal_eea_row n) (literal_eea_row n)) term
     (@Alg.Core.Combinators.pair (literal_eea_state n) (literal_eea_row n) (literal_eea_row n) term
        (@literal_eea_row_step n term)
        (@Alg.Core.Combinators.drop (literal_eea_row n) (literal_eea_row n) (literal_eea_row n) term
           (@Alg.Core.Combinators.iden (literal_eea_row n) term)))
     (@Alg.Core.Combinators.pair (Ty.Prod (literal_eea_row n) (literal_eea_row n)) (literal_eea_row n)
        (literal_eea_row n) term
        (@Alg.Core.Combinators.take (literal_eea_row n) (literal_eea_row n) (literal_eea_row n) term
           (@Alg.Core.Combinators.iden (literal_eea_row n) term))
        (@Alg.Core.Combinators.comp (Ty.Prod (literal_eea_row n) (literal_eea_row n))
           (Ty.Prod (literal_eea_row n) (literal_eea_row n)) (literal_eea_row n) term
           (@Alg.Core.Combinators.pair (Ty.Prod (literal_eea_row n) (literal_eea_row n)) (literal_eea_row n)
              (literal_eea_row n) term
              (@Alg.Core.Combinators.drop (literal_eea_row n) (literal_eea_row n) (literal_eea_row n) term
                 (@Alg.Core.Combinators.iden (literal_eea_row n) term))
              (@Alg.Core.Combinators.take (literal_eea_row n) (literal_eea_row n) (literal_eea_row n) term
                 (@Alg.Core.Combinators.iden (literal_eea_row n) term))) (@literal_eea_row_step n term))))
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (literal_eea_state n) (literal_eea_state n)

Arguments literal_eea_step n%nat_scope {term}
### C.jet_secp_eea_literal.literal_eea_iterate
literal_eea_iterate =
fix literal_eea_iterate (n depth : nat) (term : Alg.Core.Algebra) {struct depth} :
    Alg.Core.domain term (literal_eea_state n) (literal_eea_state n) :=
  match depth return (Alg.Core.domain term (literal_eea_state n) (literal_eea_state n)) with
  | O =>
      @Alg.Core.Combinators.comp (literal_eea_state n) (literal_eea_state n) (literal_eea_state n) term
        (@literal_eea_step n term) (@literal_eea_step n term)
  | S d =>
      @Alg.Core.Combinators.comp (literal_eea_state n) (literal_eea_state n) (literal_eea_state n) term
        (literal_eea_iterate n d term) (literal_eea_iterate n d term)
  end
     : forall (n _ : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (literal_eea_state n) (literal_eea_state n)

Arguments literal_eea_iterate (n depth)%nat_scope {term}
### C.jet_secp_eea_literal.literal_eea_one
literal_eea_one =
fun (n : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector (Word.Word O) n) term
  (@Bit.true Ty.Unit term) (@jet_extend_word_spec.left_pad_word_spec O n false term)
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term Ty.Unit (Word.Word n)

Arguments literal_eea_one n%nat_scope {term}
### C.jet_secp_eea_literal.literal_eea_pre
literal_eea_pre =
fun (n : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.pair (Ty.Prod (Word.Word n) (Word.Word n))
  (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
  (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) term
  (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))
     (Word.Word n) term
     (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n) (Word.Word n) term
        (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word n) (Word.Word n)) Ty.Unit (Word.Word n) term
           (@Alg.Core.Combinators.unit (Ty.Prod (Word.Word n) (Word.Word n)) term) (@literal_eea_one n term))
        (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word n) (Word.Word n)) Ty.Unit (Word.Word n) term
           (@Alg.Core.Combinators.unit (Ty.Prod (Word.Word n) (Word.Word n)) term) (@Word.zero n term)))
     (@Alg.Core.Combinators.take (Word.Word n) (Word.Word n) (Word.Word n) term
        (@Alg.Core.Combinators.iden (Word.Word n) term)))
  (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))
     (Word.Word n) term
     (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n) (Word.Word n) term
        (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word n) (Word.Word n)) Ty.Unit (Word.Word n) term
           (@Alg.Core.Combinators.unit (Ty.Prod (Word.Word n) (Word.Word n)) term) (@Word.zero n term))
        (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word n) (Word.Word n)) Ty.Unit (Word.Word n) term
           (@Alg.Core.Combinators.unit (Ty.Prod (Word.Word n) (Word.Word n)) term) (@literal_eea_one n term)))
     (@Alg.Core.Combinators.drop (Word.Word n) (Word.Word n) (Word.Word n) term
        (@Alg.Core.Combinators.iden (Word.Word n) term)))
     : forall (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word n)) (literal_eea_state n)

Arguments literal_eea_pre n%nat_scope {term}
### C.jet_secp_eea_literal.literal_eea_post
literal_eea_post =
fun (n : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp
  (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
     (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)))
