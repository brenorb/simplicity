### C.jet_secp_eea_literal.literal_eea_row_step_expansion
literal_eea_row_step_expansion
     : forall (n : nat) (a b c d e f : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (literal_eea_row n))
         (@literal_eea_row_step n Alg.CoreFunSem
            (@pair (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
               (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
               (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b) c)
               (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) d e) f)))
         match
           @jet_literal_division_add.literal_div_mod_word_spec n Alg.CoreFunSem
             (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) c f) return (Ty.tySem (literal_eea_row n))
         with
         | pair q r =>
             @pair
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n)))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                      match n0 return Ty.Ty with
                      | O => X
                      | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                      end) (Ty.Sum Ty.Unit Ty.Unit) n))
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                         match n0 return Ty.Ty with
                         | O => X
                         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                         end) (Ty.Sum Ty.Unit Ty.Unit) n))
                  (@snd
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))
                     (@Word.fullMultiplier n Alg.CoreFunSem
                        (@pair
                           (prod
                              ((fix tySem (X : Ty.Ty) : Set :=
                                  match X return Set with
                                  | Ty.Unit => unit
                                  | Ty.Sum A B => sum (tySem A) (tySem B)
                                  | Ty.Prod A B => prod (tySem A) (tySem B)
                                  end)
                                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                     match n0 return Ty.Ty with
                                     | O => X
                                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Ty.tySem (Word.Word n)))
                           (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                           (@pair
                              ((fix tySem (X : Ty.Ty) : Set :=
                                  match X return Set with
                                  | Ty.Unit => unit
                                  | Ty.Sum A B => sum (tySem A) (tySem B)
                                  | Ty.Prod A B => prod (tySem A) (tySem B)
                                  end)
                                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                     match n0 return Ty.Ty with
                                     | O => X
                                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Ty.tySem (Word.Word n)) q d)
                           (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a (@Word.zero n Alg.CoreFunSem tt)))))
                  (@snd
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                            match n0 return Ty.Ty with
                            | O => X
                            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                            end) (Ty.Sum Ty.Unit Ty.Unit) n))
                     (@Word.fullMultiplier n Alg.CoreFunSem
                        (@pair
                           (prod
                              ((fix tySem (X : Ty.Ty) : Set :=
                                  match X return Set with
                                  | Ty.Unit => unit
                                  | Ty.Sum A B => sum (tySem A) (tySem B)
                                  | Ty.Prod A B => prod (tySem A) (tySem B)
                                  end)
                                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                     match n0 return Ty.Ty with
                                     | O => X
                                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Ty.tySem (Word.Word n)))
                           (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                           (@pair
                              ((fix tySem (X : Ty.Ty) : Set :=
                                  match X return Set with
                                  | Ty.Unit => unit
                                  | Ty.Sum A B => sum (tySem A) (tySem B)
                                  | Ty.Prod A B => prod (tySem A) (tySem B)
                                  end)
                                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                     match n0 return Ty.Ty with
                                     | O => X
                                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Ty.tySem (Word.Word n)) q e)
                           (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) b (@Word.zero n Alg.CoreFunSem tt))))))
               r
         end
### C.jet_secp_eea_literal.literal_eea_step_expansion
literal_eea_step_expansion
     : forall (n : nat) (a b c d e f : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (literal_eea_state n))
         (@literal_eea_step n Alg.CoreFunSem
            (@pair (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
               (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
               (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b) c)
               (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) d e) f)))
         match
           @jet_order_spec.lt_word_spec Alg.CoreFunSem n (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) f c)
           return (Ty.tySem (literal_eea_state n))
         with
         | inl _ =>
             @pair (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
               (Ty.tySem (literal_eea_row n))
               (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b) c)
               (@literal_eea_row_step n Alg.CoreFunSem
                  (@pair (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
                     (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
                     (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                        (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) d e) f)
                     (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                        (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b) c)))
         | inr _ =>
             @pair (Ty.tySem (literal_eea_row n))
               (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
               (@literal_eea_row_step n Alg.CoreFunSem
                  (@pair (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
                     (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
                     (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                        (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a b) c)
                     (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                        (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) d e) f)))
               (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) d e) f)
         end
### C.jet_secp_eea_literal.literal_eea_run_add
literal_eea_run_add
     : forall (n a b : nat) (s : Ty.tySem (literal_eea_state n)),
       @eq (Ty.tySem (literal_eea_state n)) (literal_eea_run n (Nat.add a b) s)
         (literal_eea_run n b (literal_eea_run n a s))
### C.jet_secp_eea_literal.literal_eea_iterate_run
literal_eea_iterate_run
     : forall (n depth : nat) (s : Ty.tySem (literal_eea_state n)),
       @eq (Ty.tySem (literal_eea_state n)) (@literal_eea_iterate n depth Alg.CoreFunSem s)
         (literal_eea_run n (PeanoNat.Nat.pow (S (S O)) (S depth)) s)
### C.jet_secp_eea_literal.literal_eea_pre_expansion
literal_eea_pre_expansion
     : forall (n : nat) (x y : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (literal_eea_state n))
         (@literal_eea_pre n Alg.CoreFunSem (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y))
         (@pair (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
            (prod (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n)))
            (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) (@literal_eea_one n Alg.CoreFunSem tt)
                  (@Word.zero n Alg.CoreFunSem tt)) x)
            (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) (@Word.zero n Alg.CoreFunSem tt)
                  (@literal_eea_one n Alg.CoreFunSem tt)) y))
