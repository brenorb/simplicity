        (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))) term
     (@Alg.Core.Combinators.drop (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
        (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit) term
        (@Alg.Core.Combinators.drop (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term
           (@jet_test_value_spec.is_zero_word_spec n term)))
     (@Alg.Core.Combinators.iden
        (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
