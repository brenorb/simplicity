                           end) (Ty.Sum Ty.Unit Ty.Unit) n))
                    (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
                    (Word.Word n) term
                    (@Alg.Core.Combinators.drop (Ty.Prod (Word.Word n) (Word.Word n))
                       (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n) term
                       (@Alg.Core.Combinators.drop (Word.Word n) (Word.Word n) (Word.Word n) term
                          (@Alg.Core.Combinators.iden (Word.Word n) term)))))
              (@Alg.Core.Combinators.pair
                 (Ty.Prod
                    (Ty.Prod (Word.Word n)
                       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                           match n0 return Ty.Ty with
                           | O => X
                           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                           end) (Ty.Sum Ty.Unit Ty.Unit) n))
                    (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))))
                 (Word.Word n) (Word.Word n) term
                 (@Alg.Core.Combinators.drop
                    (Ty.Prod (Word.Word n)
                       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                           match n0 return Ty.Ty with
                           | O => X
                           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                           end) (Ty.Sum Ty.Unit Ty.Unit) n))
                    (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
                    (Word.Word n) term
                    (@Alg.Core.Combinators.take (Ty.Prod (Word.Word n) (Word.Word n))
                       (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n) term
                       (@Alg.Core.Combinators.drop (Word.Word n) (Word.Word n) (Word.Word n) term
                          (@Alg.Core.Combinators.iden (Word.Word n) term))))
                 (@Alg.Core.Combinators.comp
                    (Ty.Prod
