           (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
           (Ty.Prod (Word.Word n) (Word.Word n)) term
           (@Alg.Core.Combinators.injl
              (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
                 (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))) (Ty.Prod (Word.Word n) (Word.Word n))
              (Ty.Prod (Word.Word n) (Word.Word n)) term
              (@Alg.Core.Combinators.take (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
                 (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))
                 term
                 (@Alg.Core.Combinators.take (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)
                    (Ty.Prod (Word.Word n) (Word.Word n)) term
                    (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word n) (Word.Word n)) term))))
           (@Alg.Core.Combinators.drop (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
              (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)) term
              (@Alg.Core.Combinators.take (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)
                 (Ty.Prod (Word.Word n) (Word.Word n)) term
                 (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word n) (Word.Word n)) term))))
        (@Alg.Core.Combinators.take (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
           (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) (Word.Word n) term
           (@Alg.Core.Combinators.drop (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)
              (Word.Word n) term (@Alg.Core.Combinators.iden (Word.Word n) term))))
     (@Alg.Core.Combinators.pair
        (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
           (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)))
        (Ty.Prod (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
           (Ty.Prod (Word.Word n) (Word.Word n))) (Word.Word n) term
        (@Alg.Core.Combinators.pair
           (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
              (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)))
           (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
           (Ty.Prod (Word.Word n) (Word.Word n)) term
           (@Alg.Core.Combinators.injr
              (Ty.Prod (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
                 (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))) (Ty.Prod (Word.Word n) (Word.Word n))
              (Ty.Prod (Word.Word n) (Word.Word n)) term
              (@Alg.Core.Combinators.drop (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
                 (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))
                 term
                 (@Alg.Core.Combinators.take (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)
                    (Ty.Prod (Word.Word n) (Word.Word n)) term
                    (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word n) (Word.Word n)) term))))
           (@Alg.Core.Combinators.take (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
              (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)) term
              (@Alg.Core.Combinators.take (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)
                 (Ty.Prod (Word.Word n) (Word.Word n)) term
                 (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word n) (Word.Word n)) term))))
        (@Alg.Core.Combinators.drop (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n))
           (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)) (Word.Word n) term
           (@Alg.Core.Combinators.drop (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)
              (Word.Word n) term (@Alg.Core.Combinators.iden (Word.Word n) term)))))
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (literal_eea_state n) (literal_eea_result n)

Arguments literal_eea_post n%nat_scope {term}
### C.jet_secp_eea_literal.literal_eea
literal_eea =
fun (n : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word n) (Word.Word n)) (literal_eea_state n) (literal_eea_result n) term
  (@literal_eea_pre n term)
  (@Alg.Core.Combinators.comp (literal_eea_state n) (literal_eea_state n) (literal_eea_result n) term
     (@literal_eea_iterate n n term) (@literal_eea_post n term))
     : forall (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word n)) (literal_eea_result n)

Arguments literal_eea n%nat_scope {term}
### C.jet_secp_eea_literal.literal_bezout
literal_bezout =
fun (n : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word n) (Word.Word n)) (literal_eea_result n)
  (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))) term
  (@literal_eea n term)
  (@Alg.Core.Combinators.take
     (Ty.Prod (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
        (Ty.Prod (Word.Word n) (Word.Word n))) (Word.Word n)
     (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))) term
     (@Alg.Core.Combinators.take (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
        (Ty.Prod (Word.Word n) (Word.Word n))
        (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))) term
        (@Alg.Core.Combinators.iden
           (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))) term)))
     : forall (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word n))
         (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))

Arguments literal_bezout n%nat_scope {term}
### C.jet_secp_eea_literal.literal_eea_run
literal_eea_run =
fix literal_eea_run (n count : nat) (s : Ty.tySem (literal_eea_state n)) {struct count} :
    Ty.tySem (literal_eea_state n) :=
  match count return (Ty.tySem (literal_eea_state n)) with
  | O => s
  | S k => literal_eea_run n k (@literal_eea_step n Alg.CoreFunSem s)
  end
     : forall (n _ : nat) (_ : Ty.tySem (literal_eea_state n)), Ty.tySem (literal_eea_state n)

Arguments literal_eea_run (n count)%nat_scope s
