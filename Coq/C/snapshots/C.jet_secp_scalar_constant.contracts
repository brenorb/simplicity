### C.jet_secp_scalar_constant.scalar_constant_initializes
scalar_constant_initializes
     : forall (gv : AST.globvar Ctypes.type) (b : Values.block) (words : list Integers.Int64.int)
         (m : Memory.Mem.mem)
         (_ : @eq (option (AST.globvar Ctypes.type))
                (@Globalenvs.Genv.find_var_info Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge) b)
                (@Some (AST.globvar Ctypes.type) gv))
         (_ : @eq nat (@length Integers.Int64.int words) (S (S (S (S O)))))
         (_ : @eq (list AST.init_data) (@AST.gvar_init Ctypes.type gv)
                (@List.map Integers.Int64.int AST.init_data AST.Init_int64 words))
         (_ : @eq bool (@AST.gvar_readonly Ctypes.type gv) true)
         (_ : @eq bool (@AST.gvar_volatile Ctypes.type gv) false)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       scalar_constant_state b words m
### C.jet_secp_scalar_constant.scalar_constant_valid
scalar_constant_valid
     : forall (b : Values.block) (words : list Integers.Int64.int) (m : Memory.Mem.mem)
         (_ : scalar_constant_state b words m), Memory.Mem.valid_block m b
### C.jet_secp_scalar_constant.scalar_constant_readonly
scalar_constant_readonly
     : forall (b : Values.block) (words : list Integers.Int64.int) (m mf : Memory.Mem.mem)
         (_ : scalar_constant_state b words m) (_ : jet_clight_internal_preserve.readonly_preserved m mf),
       scalar_constant_state b words mf
### C.jet_secp_scalar_constant.scalar_constant_separate
scalar_constant_separate
     : forall (b : Values.block) (words : list Integers.Int64.int) (m : Memory.Mem.mem) (bx : Values.block)
         (_ : scalar_constant_state b words m)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable), not (@eq Values.block bx b)
### C.jet_secp_scalar_constant.scalar_constant_state
scalar_constant_state =
fun (b : Values.block) (words : list Integers.Int64.int) (m : Memory.Mem.mem) =>
and (jet_secp_scalar_get_b32_storage.scalar_at m b BinNums.Z0 words)
  (forall ofs : BinNums.Z, not (Memory.Mem.perm m b ofs Memtype.Max Memtype.Writable))
     : forall (_ : Values.block) (_ : list Integers.Int64.int) (_ : Memory.Mem.mem), Prop

Arguments scalar_constant_state b words%list_scope m
