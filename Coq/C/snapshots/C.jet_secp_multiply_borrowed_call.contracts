### C.jet_secp_multiply_borrowed_call.borrowed_final_shape
borrowed_final_shape
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
         (@List.map jet_sx_state.region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
            jet_sx_state.rshape (borrowed_final_regs rho))
         (@List.map jet_sx_state.region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
            jet_sx_state.rshape
            (@app jet_sx_state.region borrowed_mul_regs
               (@fst (list jet_sx_state.region) jet_sx_eval.venv jet_secp_multiply_checkpoint_prefix.mul_allocated)))
### C.jet_secp_multiply_borrowed_call.firstn2_borrow
firstn2_borrow
     : forall regs : list jet_sx_state.region,
       @eq (list jet_sx_state.region)
         (@List.firstn jet_sx_state.region (S (S O)) (jet_borrowed_region.borrow_at (S O) regs))
         (jet_borrowed_region.borrow_at (S O) (@List.firstn jet_sx_state.region (S (S O)) regs))
### C.jet_secp_multiply_borrowed_call.borrowed_final_prefix
borrowed_final_prefix
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq (list jet_sx_state.region) (@List.firstn jet_sx_state.region (S (S O)) (borrowed_final_regs rho))
         (borrowed_output_regs rho)
### C.jet_secp_multiply_borrowed_call.borrowed_body_for_call
borrowed_body_for_call
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta
                (@app jet_sx_state.region borrowed_mul_regs
                   (@fst (list jet_sx_state.region) jet_sx_eval.venv jet_secp_multiply_checkpoint_prefix.mul_allocated))
                m) (_ : jet_sx_eval.tmatch rho beta jet_secp_multiply_checkpoint_prefix.prefix_temps le)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_multiply_checkpoint_prefix.mul_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (Clight.fn_body jets_secp.f_secp256k1_fe_mul_inner) Events.E0 le' mf ClightBigstep.Out_normal)
               (and (jet_sx_state.rep rho beta (borrowed_final_regs rho) mf)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (jet_sx_state.foot beta
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape
                              (@app jet_sx_state.region borrowed_mul_regs
                                 (@fst (list jet_sx_state.region) jet_sx_eval.venv
                                    jet_secp_multiply_checkpoint_prefix.mul_allocated))) b ofs)) m mf))))
