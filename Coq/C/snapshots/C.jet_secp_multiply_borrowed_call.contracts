### C.jet_secp_multiply_borrowed_call.eval_original_field_mul_wrapper_borrowed_product
eval_original_field_mul_wrapper_borrowed_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_secp_multiply_first_arithmetic.field_input_bounds rho)
         (_ : jet_sx_state.rep rho beta borrowed_mul_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho beta (borrowed_output_regs rho) mf)
               (and
                  (jet_secp_multiply_finish_execute.output_words beta
                     (jet_secp_multiply_finish_execute.original_finish_words rho) mf)
                  (and
                     (@eq BinNums.Z
                        (BinInt.Z.modulo
                           (jet_secp_multiply_finish_product.radix_value
                              (jet_secp_multiply_finish_execute.original_finish_words rho))
                           jet_secp_multiply_checkpoint_columns.field_prime)
                        (BinInt.Z.modulo
                           (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value rho)
                              (jet_secp_multiply_finish_product.radix_value
                                 (jet_secp_multiply_finish_product.second_input rho)))
                           jet_secp_multiply_checkpoint_columns.field_prime))
                     (and
                        (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                         and
                           (BinInt.Z.le BinNums.Z0
                              (Integers.Int64.unsigned (jet_secp_multiply_finish_execute.original_finish_words rho i)))
                           (BinInt.Z.lt
                              (Integers.Int64.unsigned (jet_secp_multiply_finish_execute.original_finish_words rho i))
                              match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                              | true =>
                                  BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))
                              | false =>
                                  BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))
                              end))
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot beta
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape borrowed_mul_regs) b ofs)) m mf))))))
### C.jet_secp_multiply_borrowed_call.borrowed_mul_regs
borrowed_mul_regs =
jet_borrowed_region.borrow_at (S O) jet_secp_multiply_run_run.field_mul_regs
     : list jet_sx_state.region
### C.jet_secp_multiply_borrowed_call.borrowed_final_regs
borrowed_final_regs =
fun rho : forall _ : nat, Integers.Int64.int =>
jet_borrowed_region.borrow_at (S O)
  (jet_sx_eval.sregs (jet_secp_multiply_finish_execute.original_finish_checkpoint rho))
     : forall _ : forall _ : nat, Integers.Int64.int, list jet_sx_state.region

Arguments borrowed_final_regs rho%function_scope
### C.jet_secp_multiply_borrowed_call.borrowed_output_regs
borrowed_output_regs =
fun rho : forall _ : nat, Integers.Int64.int =>
jet_borrowed_region.borrow_at (S O) (jet_secp_multiply_call_call.field_output_regs rho)
     : forall _ : forall _ : nat, Integers.Int64.int, list jet_sx_state.region

Arguments borrowed_output_regs rho%function_scope
