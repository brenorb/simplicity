### C.jet_secp_generator_save_storage.generator_save_output_loads
generator_save_output_loads
     : forall (flag : Integers.Int.int) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S (S (S O))))))))))),
              BinInt.Z.le (Integers.Int64.unsigned (rho i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : jet_sx_state.rep rho beta (jet_secp_generator_save_values.generator_save_final_regs flag rho beta) m),
       and
         (Memory.Mem.range_perm m (jet_sx_state.blk beta O) BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
            Memtype.Cur Memtype.Freeable)
         (and
            (Memory.Mem.range_perm m (jet_sx_state.blk beta (S O)) BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               Memtype.Cur Memtype.Freeable)
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 m (jet_sx_state.blk beta O)
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@Some Values.val (Values.Vint flag)))
               (forall (second : bool) (i : nat)
                  (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint8unsigned m (jet_sx_state.blk beta (S O))
                     (BinInt.Z.add
                        match second return BinNums.Z with
                        | true =>
                            BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        | false => BinNums.Z0
                        end (BinInt.Z.of_nat i)))
                  (@Some Values.val
                     (Values.Vint
                        (@List.nth Integers.Int.int i
                           (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                              (jet_secp_fe_b32.be_bytes
                                 (jet_secp_generator_save_values.generator_save_value rho
                                    match second return nat with
                                    | true => S (S (S (S (S O))))
                                    | false => O
                                    end))) Integers.Int.zero))))))
### C.jet_secp_generator_save_storage.eval_generator_save_bytes
eval_generator_save_bytes
     : forall (flag : Integers.Int.int) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem) (_ : jet_sx_state.rep rho beta (jet_secp_generator_save.generator_save_regs flag) m)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S (S (S O))))))))))),
              BinInt.Z.le (Integers.Int64.unsigned (rho i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_save)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (Memory.Mem.range_perm mf (jet_sx_state.blk beta O) BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mf (jet_sx_state.blk beta (S O)) BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf (jet_sx_state.blk beta O)
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint flag)))
                     (and
                        (forall (second : bool) (i : nat)
                           (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))),
                         @eq (option Values.val)
                           (Memory.Mem.load AST.Mint8unsigned mf (jet_sx_state.blk beta (S O))
                              (BinInt.Z.add
                                 match second return BinNums.Z with
                                 | true =>
                                     BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 | false => BinNums.Z0
                                 end (BinInt.Z.of_nat i)))
                           (@Some Values.val
                              (Values.Vint
                                 (@List.nth Integers.Int.int i
                                    (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                                       (jet_secp_fe_b32.be_bytes
                                          (jet_secp_generator_save_values.generator_save_value rho
                                             match second return nat with
                                             | true => S (S (S (S (S O))))
                                             | false => O
                                             end))) Integers.Int.zero))))
                        (and
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (pos : BinNums.Z) =>
                               not
                                 (jet_sx_state.foot beta
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape (jet_secp_generator_save.generator_save_regs flag)) b pos))
                              m mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))
