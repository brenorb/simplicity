### C.jet_carry_wide_layout.carry_wide_output_at
carry_wide_output_at =
fun (s : jet_wide.wide_size) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
  (value : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (jet_wide.wide_log s)))) =>
and
  (@ex Integers.Int64.int
     (fun w : Integers.Int64.int =>
      and
        (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
           (@Some Values.val (Values.Vlong w)))
        (@eq (sum unit unit)
           match
             Integers.Int64.testbit w
               (BinInt.Z.modulo (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
             return (sum unit unit)
           with
           | true => @inr unit unit tt
           | false => @inl unit unit tt
           end
           (@fst
              (sum
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) Ty.Unit)
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) Ty.Unit))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end) (Word.Word (jet_wide.wide_log s))) value))))
  (jet_wide_spec.wide_output_at s m bw edge (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
     (@snd
        (sum
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) Ty.Unit)
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) Ty.Unit))
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end) (Word.Word (jet_wide.wide_log s))) value))
     : forall (s : jet_wide.wide_size) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (jet_wide.wide_log s)))), Prop

Arguments carry_wide_output_at s m bw (edge cursor)%Z_scope value
