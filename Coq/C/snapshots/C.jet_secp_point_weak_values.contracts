### C.jet_secp_point_weak_values.point_weak_bounds
point_weak_bounds =
fun n : nat =>
@pair BinNums.Z BinNums.Z BinNums.Z0
  match PeanoNat.Nat.eqb n (S (S (S (S (S O))))) return BinNums.Z with
  | true =>
      BinNums.Zpos
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
  | false =>
      BinNums.Zpos
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
  end
     : forall _ : nat, prod BinNums.Z BinNums.Z

Arguments point_weak_bounds n%nat_scope
### C.jet_secp_point_weak_values.point_weak_math
point_weak_math =
fun t0 t1 t2 t3 t4 : BinNums.Z =>
jet_secp_fe_math.nv_pass
  (BinInt.Z.add t0
     (BinInt.Z.mul
        (BinInt.Z.div t4
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))
        jet_secp_fe_math.feR)) t1 t2 t3
  (BinInt.Z.land t4
     (BinNums.Zpos
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       prod (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z) BinNums.Z

Arguments point_weak_math (t0 t1 t2 t3 t4)%Z_scope
### C.jet_secp_point_weak_values.point_weak_math_list
point_weak_math_list =
fun t0 t1 t2 t3 t4 : BinNums.Z =>
match point_weak_math t0 t1 t2 t3 t4 return (list BinNums.Z) with
| pair p e =>
    match p return (list BinNums.Z) with
    | pair p0 d =>
        match p0 return (list BinNums.Z) with
        | pair p1 c =>
            match p1 return (list BinNums.Z) with
            | pair a b =>
                @cons BinNums.Z a
                  (@cons BinNums.Z b (@cons BinNums.Z c (@cons BinNums.Z d (@cons BinNums.Z e (@nil BinNums.Z)))))
            end
        end
    end
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), list BinNums.Z

