### C.jet_secp_modinv_tail_modulus.exec_inv_mod_tail
exec_inv_mod_tail
     : forall (mu : forall _ : nat, Integers.Int64.int) (len : nat) (rho : forall _ : nat, Integers.Int64.int)
         (beta : jet_sx_state.layout) (e : Clight.env) (le0 : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : and (lt O len) (le len (S (S (S (S (S O)))))))
         (_ : jet_sx_state.rep rho beta (jet_secp_modinv_loop_modulus.inv_mod_loop_regs mu) m)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_var_entry.inv_start_alloc) e)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le0)
                (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat len)))))
         (_ : jet_secp_modinv_var_tail.inv_tail_low_bounds len rho),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex ClightBigstep.outcome
               (fun out : ClightBigstep.outcome =>
                and
                  (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 m
                     jet_secp_modinv_var_post.inv_post_control Events.E0 lef mf out)
                  (and
                     (jet_sx_state.rep (jet_secp_modinv_var_tail.inv_tail_next_rho len rho) beta
                        (jet_secp_modinv_loop_modulus.inv_mod_loop_regs mu) mf)
                     (and
                        (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len lef)
                           (@Some Values.val
                              (Values.Vint
                                 (Integers.Int.repr
                                    (BinInt.Z.of_nat (jet_secp_modinv_var_tail.inv_tail_length len rho))))))
                        (and
                           (forall high : bool,
                            @eq BinNums.Z
                              (jet_secp_modinv_var_fg.inv_fg_active_value
                                 (jet_secp_modinv_var_tail.inv_tail_length len rho)
                                 (jet_secp_modinv_var_tail.inv_tail_next_rho len rho) high)
                              (jet_secp_modinv_var_fg.inv_fg_active_value len rho high))
                           (and
                              (jet_secp_modinv_var_tail.inv_tail_low_bounds
                                 (jet_secp_modinv_var_tail.inv_tail_length len rho)
                                 (jet_secp_modinv_var_tail.inv_tail_next_rho len rho))
                              (and
                                 (iff (@eq ClightBigstep.outcome out ClightBigstep.Out_break)
                                    (@eq BinNums.Z
                                       (jet_secp_modinv_var_fg.inv_fg_active_value
                                          (jet_secp_modinv_var_tail.inv_tail_length len rho)
                                          (jet_secp_modinv_var_tail.inv_tail_next_rho len rho) true) BinNums.Z0))
                                 (and
                                    (forall _ : @eq ClightBigstep.outcome out ClightBigstep.Out_normal,
                                     not
                                       (@eq BinNums.Z
                                          (jet_secp_modinv_var_fg.inv_fg_active_value
                                             (jet_secp_modinv_var_tail.inv_tail_length len rho)
                                             (jet_secp_modinv_var_tail.inv_tail_next_rho len rho) true) BinNums.Z0))
                                    (and
                                       (or (@eq ClightBigstep.outcome out ClightBigstep.Out_break)
                                          (@eq ClightBigstep.outcome out ClightBigstep.Out_normal))
                                       (and
                                          (and (lt O (jet_secp_modinv_var_tail.inv_tail_length len rho))
                                             (le (jet_secp_modinv_var_tail.inv_tail_length len rho)
                                                (S (S (S (S (S O)))))))
                                          (and (jet_secp_modinv_var_post.inv_post_temp_frame le0 lef)
                                             (jet_sx_mem.lframe
                                                (fun (b : Values.block) (_ : BinNums.Z) =>
                                                 and
                                                   (not (@eq Values.block b (jet_sx_state.blk beta (S (S (S (...)))))))
                                                   (not (@eq Values.block b (jet_sx_state.blk beta (S (S (S (...))))))))
                                                m mf)))))))))))))
