                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word n)) (Ty.tySem (Word.Word (Nat.add m n))) x
               (@eq_rect Ty.Ty (Word.Vector (Word.Word n) m) Ty.tySem v (Word.Word (Nat.add m n)) (vector_word_eq n m))))
         (@pair (Ty.tySem (Word.Word (Nat.add m n)))
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end) (Word.Word n))
            (@eq_rect Ty.Ty (Word.Vector (Word.Word n) m) Ty.tySem
               (@fst
                  ((fix tySem (X : Ty.Ty) : Set :=
