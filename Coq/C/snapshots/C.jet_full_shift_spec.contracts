                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Vector (Word.Word n) m))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n))
                  (@Word.full_right_shift1 (Word.Word n) m Alg.CoreFunSem
                     (@pair
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) (Word.Word n)) (Ty.tySem (Word.Vector (Word.Word n) m)) x v)))
               (Word.Word (Nat.add m n)) (vector_word_eq n m))
            (@snd
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Vector (Word.Word n) m))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word n))
               (@Word.full_right_shift1 (Word.Word n) m Alg.CoreFunSem
                  (@pair
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n)) (Ty.tySem (Word.Vector (Word.Word n) m)) x v))))
### C.jet_full_shift_spec.full_left_word_spec_value
full_left_word_spec_value
     : forall (n m : nat) (v : Ty.tySem (Word.Word (Nat.add m n))) (x : Ty.tySem (Word.Word n)),
       let result : Ty.tySem (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n))) :=
         @full_left_word_spec n m Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word (Nat.add m n))) (Ty.tySem (Word.Word n)) v x) in
       @eq BinNums.Z
         (BinInt.Z.add
            (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n)) v)
               (Zpower.two_power_nat (Word.ToZ.Theory.bitSize (Word.WordToZ n))))
            (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
         (BinInt.Z.add
            (BinInt.Z.mul
               (@Word.ToZ.Theory.toZ (Word.WordToZ n)
                  (@fst
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (Nat.add m n))) result))
               (Zpower.two_power_nat (Word.ToZ.Theory.bitSize (Word.WordToZ (Nat.add m n)))))
            (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
               (@snd
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (Nat.add m n))) result)))
### C.jet_full_shift_spec.full_right_word_spec_value
full_right_word_spec_value
     : forall (n m : nat) (x : Ty.tySem (Word.Word n)) (v : Ty.tySem (Word.Word (Nat.add m n))),
       let result : Ty.tySem (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n)) :=
         @full_right_word_spec n m Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word (Nat.add m n))) x v) in
       @eq BinNums.Z
         (BinInt.Z.add
            (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)
               (Zpower.two_power_nat (Word.ToZ.Theory.bitSize (Word.WordToZ (Nat.add m n)))))
            (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n)) v))
         (BinInt.Z.add
            (BinInt.Z.mul
               (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
                  (@fst
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (Nat.add m n)))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n)) result)) (Zpower.two_power_nat (Word.ToZ.Theory.bitSize (Word.WordToZ n))))
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@snd
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (Nat.add m n)))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n)) result)))
