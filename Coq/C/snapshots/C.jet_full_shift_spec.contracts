### C.jet_full_shift_spec.full_right_word_spec_quotient
full_right_word_spec_quotient
     : forall (n m : nat)
         (x : (fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Word n))
         (v : (fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Word (Nat.add m n))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
            (@fst
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word (Nat.add m n)))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word n))
               (@full_right_word_spec n m Alg.CoreFunSem
                  (@pair
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (Nat.add m n))) x v))))
         (BinInt.Z.div
            (BinInt.Z.add
               (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)
                  (Zpower.two_power_nat (Word.ToZ.Theory.bitSize (Word.WordToZ (Nat.add m n)))))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n)) v))
            (Zpower.two_power_nat (Word.ToZ.Theory.bitSize (Word.WordToZ n))))
### C.jet_full_shift_spec.full_right_word_spec_remainder
full_right_word_spec_remainder
     : forall (n m : nat)
         (x : (fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Word n))
         (v : (fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Word (Nat.add m n))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ n)
            (@snd
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word (Nat.add m n)))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word n))
               (@full_right_word_spec n m Alg.CoreFunSem
                  (@pair
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (Nat.add m n))) x v))))
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)
                  (Zpower.two_power_nat (Word.ToZ.Theory.bitSize (Word.WordToZ (Nat.add m n)))))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n)) v))
            (Zpower.two_power_nat (Word.ToZ.Theory.bitSize (Word.WordToZ n))))
### C.jet_full_shift_spec.pair_type_eq
pair_type_eq =
fun (A B C D : Ty.Ty) (e : @eq Ty.Ty A C) (f : @eq Ty.Ty B D) =>
match e in (eq _ a) return (@eq Ty.Ty (Ty.Prod A B) (Ty.Prod a D)) with
| eq_refl =>
    match f in (eq _ a) return (@eq Ty.Ty (Ty.Prod A B) (Ty.Prod A a)) with
    | eq_refl => @eq_refl Ty.Ty (Ty.Prod A B)
    end
end
     : forall (A B C D : Ty.Ty) (_ : @eq Ty.Ty A C) (_ : @eq Ty.Ty B D), @eq Ty.Ty (Ty.Prod A B) (Ty.Prod C D)

Arguments pair_type_eq A B C D e f
### C.jet_full_shift_spec.vector_word_eq
vector_word_eq =
fix vector_word_eq (n m : nat) {struct m} : @eq Ty.Ty (Word.Vector (Word.Word n) m) (Word.Word (Nat.add m n)) :=
  match m as m0 return (@eq Ty.Ty (Word.Vector (Word.Word n) m0) (Word.Word (Nat.add m0 n))) with
  | O => @eq_refl Ty.Ty (Word.Vector (Word.Word n) O)
  | S k =>
      pair_type_eq (Word.Vector (Word.Word n) k) (Word.Vector (Word.Word n) k) (Word.Word (Nat.add k n))
        (Word.Word (Nat.add k n)) (vector_word_eq n k) (vector_word_eq n k)
  end
     : forall n m : nat, @eq Ty.Ty (Word.Vector (Word.Word n) m) (Word.Word (Nat.add m n))

Arguments vector_word_eq (n m)%nat_scope
### C.jet_full_shift_spec.full_left_word_spec
full_left_word_spec =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@eq_rect Ty.Ty (Word.Vector (Word.Word n) m)
  (fun V : Ty.Ty => Alg.Core.domain term (Ty.Prod V (Word.Word n)) (Ty.Prod (Word.Word n) V))
  (@Word.full_left_shift1 (Word.Word n) m term) (Word.Word (Nat.add m n)) (vector_word_eq n m)
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n))
         (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n)))

Arguments full_left_word_spec (n m)%nat_scope {term}
### C.jet_full_shift_spec.full_right_word_spec
full_right_word_spec =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@eq_rect Ty.Ty (Word.Vector (Word.Word n) m)
  (fun V : Ty.Ty => Alg.Core.domain term (Ty.Prod (Word.Word n) V) (Ty.Prod V (Word.Word n)))
  (@Word.full_right_shift1 (Word.Word n) m term) (Word.Word (Nat.add m n)) (vector_word_eq n m)
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n)))
         (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n))

Arguments full_right_word_spec (n m)%nat_scope {term}
