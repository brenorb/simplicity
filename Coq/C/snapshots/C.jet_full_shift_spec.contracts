### C.jet_full_shift_spec.cast_pair_value
cast_pair_value
     : forall (A B C D : Ty.Ty) (e : @eq Ty.Ty A C) (f : @eq Ty.Ty B D) (a : Ty.tySem A) (b : Ty.tySem B),
       @eq (Ty.tySem (Ty.Prod C D))
         (@eq_rect Ty.Ty (Ty.Prod A B) Ty.tySem (@pair (Ty.tySem A) (Ty.tySem B) a b) (Ty.Prod C D)
            (pair_type_eq A B C D e f))
         (@pair (Ty.tySem C) (Ty.tySem D) (@eq_rect Ty.Ty A Ty.tySem a C e) (@eq_rect Ty.Ty B Ty.tySem b D f))
### C.jet_full_shift_spec.vector_word_bits
vector_word_bits
     : forall n m : nat,
       @eq nat (jet_vector_shift_word.vector_bits (Word.WordToZ n) m)
         (Word.ToZ.Theory.bitSize (Word.WordToZ (Nat.add m n)))
### C.jet_full_shift_spec.vector_word_value
vector_word_value
     : forall (n m : nat) (v : Ty.tySem (Word.Vector (Word.Word n) m)),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add m n))
            (@eq_rect Ty.Ty (Word.Vector (Word.Word n) m) Ty.tySem v (Word.Word (Nat.add m n)) (vector_word_eq n m)))
         (jet_vector_shift_word.vector_value (Word.WordToZ n) m v)
### C.jet_full_shift_spec.full_left_word_spec_parametric
full_left_word_spec_parametric
     : forall n m : nat,
       @Alg.Core.Parametric (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n))
         (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n))) (@full_left_word_spec n m)
### C.jet_full_shift_spec.full_right_word_spec_parametric
full_right_word_spec_parametric
     : forall n m : nat,
       @Alg.Core.Parametric (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n)))
         (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n)) (@full_right_word_spec n m)
### C.jet_full_shift_spec.cast_value_inverse
cast_value_inverse
     : forall (A B : Ty.Ty) (e : @eq Ty.Ty A B) (v : Ty.tySem B),
       @eq (Ty.tySem B) (@eq_rect Ty.Ty A Ty.tySem (@eq_rect Ty.Ty B Ty.tySem v A (@eq_sym Ty.Ty A B e)) B e) v
### C.jet_full_shift_spec.cast_full_left_core
cast_full_left_core
     : forall (A B C : Ty.Ty) (e : @eq Ty.Ty A C) (f : Ty.Arrow (Ty.Prod A B) (Ty.Prod B A))
         (v : Ty.tySem A) (x : Ty.tySem B),
       @eq (Ty.tySem (Ty.Prod B C))
         (@eq_rect Ty.Ty A (fun V : Ty.Ty => Ty.Arrow (Ty.Prod V B) (Ty.Prod B V)) f C e
            (@pair (Ty.tySem C) (Ty.tySem B) (@eq_rect Ty.Ty A Ty.tySem v C e) x))
         (@pair
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                end) B) (Ty.tySem C)
            (@fst
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) B)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) A) (f (@pair (Ty.tySem A) (Ty.tySem B) v x)))
            (@eq_rect Ty.Ty A Ty.tySem
               (@snd
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) A) (f (@pair (Ty.tySem A) (Ty.tySem B) v x))) C e))
### C.jet_full_shift_spec.cast_full_right_core
cast_full_right_core
     : forall (A B C : Ty.Ty) (e : @eq Ty.Ty A C) (f : Ty.Arrow (Ty.Prod B A) (Ty.Prod A B))
         (x : Ty.tySem B) (v : Ty.tySem A),
       @eq (Ty.tySem (Ty.Prod C B))
         (@eq_rect Ty.Ty A (fun V : Ty.Ty => Ty.Arrow (Ty.Prod B V) (Ty.Prod V B)) f C e
            (@pair (Ty.tySem B) (Ty.tySem C) x (@eq_rect Ty.Ty A Ty.tySem v C e)))
         (@pair (Ty.tySem C)
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                end) B)
            (@eq_rect Ty.Ty A Ty.tySem
               (@fst
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) A)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B) (f (@pair (Ty.tySem B) (Ty.tySem A) x v))) C e)
            (@snd
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) A)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) B) (f (@pair (Ty.tySem B) (Ty.tySem A) x v))))
### C.jet_full_shift_spec.full_left_word_spec_core
full_left_word_spec_core
     : forall (n m : nat) (v : Ty.tySem (Word.Vector (Word.Word n) m))
         (x : (fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Word n)),
       @eq (Ty.tySem (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n))))
         (@full_left_word_spec n m Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (Nat.add m n)))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word n))
               (@eq_rect Ty.Ty (Word.Vector (Word.Word n) m) Ty.tySem v (Word.Word (Nat.add m n)) (vector_word_eq n m))
               x))
         (@pair
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end) (Word.Word n)) (Ty.tySem (Word.Word (Nat.add m n)))
            (@fst
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word n))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Vector (Word.Word n) m))
               (@Word.full_left_shift1 (Word.Word n) m Alg.CoreFunSem
                  (@pair (Ty.tySem (Word.Vector (Word.Word n) m))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word n)) v x)))
            (@eq_rect Ty.Ty (Word.Vector (Word.Word n) m) Ty.tySem
               (@snd
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Vector (Word.Word n) m))
                  (@Word.full_left_shift1 (Word.Word n) m Alg.CoreFunSem
                     (@pair (Ty.tySem (Word.Vector (Word.Word n) m))
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) (Word.Word n)) v x))) (Word.Word (Nat.add m n)) (vector_word_eq n m)))
### C.jet_full_shift_spec.full_right_word_spec_core
full_right_word_spec_core
     : forall (n m : nat)
         (x : (fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
