### C.jet_secp_storage_unpack.storage_unpack_run_eq
storage_unpack_run_eq
     : @eq (option jet_sx_exec.res) storage_unpack_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone storage_unpack_state jet_sx_exec.ONormal))
### C.jet_secp_storage_unpack.storage_unpack_return
storage_unpack_return
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps storage_unpack_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_storage_unpack.storage_unpack_output_shape
storage_unpack_output_shape
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs storage_unpack_state) storage_unpack_out_regs
### C.jet_secp_storage_unpack.storage_unpack_output_den
storage_unpack_output_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta)) storage_unpack_out)
         (@List.map Integers.Int64.int Values.val Values.Vlong
            (jet_secp_multiply_normalize_bridge.words5 (storage_unpack_words rho)))
### C.jet_secp_storage_unpack.eval_storage_unpack_symbolic
eval_storage_unpack_symbolic
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta storage_unpack_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_from_storage)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho beta storage_unpack_out_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot beta
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape storage_unpack_regs) b pos)) m mf)))
### C.jet_secp_storage_unpack.storage_unpack_initial
storage_unpack_initial
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout : Values.block)
         (dbase : BinNums.Z) (bin : Values.block) (sbase : BinNums.Z) (_ : not (@eq Values.block bout bin))
         (_ : BinInt.Z.le BinNums.Z0 dbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) dbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add dbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bout dbase
                (BinInt.Z.add dbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable) (_ : field_storage_readable m bin sbase w),
       jet_sx_state.rep w
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout dbase)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin sbase)
               (@nil (prod Values.block BinNums.Z)))) storage_unpack_regs m
### C.jet_secp_storage_unpack.storage_readable_region
storage_readable_region
     : forall (w : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat)
         (_ : jet_sx_state.region_ok w beta m r
                (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 storage_unpack_input) false (@None BinNums.Z))),
       field_storage_readable m (jet_sx_state.blk beta r) (jet_sx_state.bas beta r) w
### C.jet_secp_storage_unpack.storage_unpack_fields
storage_unpack_fields
     : forall (w : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep w beta storage_unpack_out_regs m),
       and
         (jet_secp_fe_nv.fe_at m (jet_sx_state.blk beta O) (jet_sx_state.bas beta O)
            (jet_secp_multiply_normalize_bridge.words5 (storage_unpack_words w)))
         (field_storage_readable m (jet_sx_state.blk beta (S O)) (jet_sx_state.bas beta (S O)) w)
### C.jet_secp_storage_unpack.eval_fe_from_storage_readonly
eval_fe_from_storage_readonly
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout : Values.block)
         (dbase : BinNums.Z) (bin : Values.block) (sbase : BinNums.Z) (_ : not (@eq Values.block bout bin))
         (_ : BinInt.Z.le BinNums.Z0 dbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) dbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add dbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bout dbase
                (BinInt.Z.add dbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable) (_ : field_storage_readable m bin sbase w),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_from_storage)
               (@cons Values.val (Values.Vptr bout (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr sbase)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout dbase (jet_secp_multiply_normalize_bridge.words5 (storage_unpack_words w)))
               (and (field_storage_readable mf bin sbase w)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      not
                        (jet_sx_state.foot
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout dbase)
                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin sbase)
                                 (@nil (prod Values.block BinNums.Z))))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape storage_unpack_regs) b pos)) m mf))))
### C.jet_secp_storage_unpack.storage_unpack_args
storage_unpack_args =
@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
  (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx))
     : list jet_sx_expr.sx
### C.jet_secp_storage_unpack.storage_unpack_input
storage_unpack_input =
@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx))))
     : list jet_sx_expr.sx
### C.jet_secp_storage_unpack.storage_unpack_regs
storage_unpack_regs =
@cons jet_sx_state.region jet_secp_fe_b32.fe_undef
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 storage_unpack_input) false (@None BinNums.Z))
     (@nil jet_sx_state.region))
     : list jet_sx_state.region
### C.jet_secp_storage_unpack.storage_unpack_out
storage_unpack_out =
@cons jet_sx_expr.sx
  (jet_sx_expr.XLb jet_sx_expr.Band (jet_sx_expr.XLv O)
     (jet_sx_expr.XLc
        (Integers.Int64.repr
           (BinInt.Z.sub
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
              (BinNums.Zpos BinNums.xH)))))
  (@cons jet_sx_expr.sx
     (jet_sx_expr.XLb jet_sx_expr.Bor
        (jet_sx_expr.XLsh jet_sx_expr.Hshru (jet_sx_expr.XLv O)
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
        (jet_sx_expr.XLb jet_sx_expr.Band
           (jet_sx_expr.XLsh jet_sx_expr.Hshl (jet_sx_expr.XLv (S O))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))
           (jet_sx_expr.XLc
              (Integers.Int64.repr
                 (BinInt.Z.sub
                    (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                    (BinNums.Zpos BinNums.xH))))))
     (@cons jet_sx_expr.sx
        (jet_sx_expr.XLb jet_sx_expr.Bor
           (jet_sx_expr.XLsh jet_sx_expr.Hshru (jet_sx_expr.XLv (S O))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
           (jet_sx_expr.XLb jet_sx_expr.Band
              (jet_sx_expr.XLsh jet_sx_expr.Hshl (jet_sx_expr.XLv (S (S O)))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
              (jet_sx_expr.XLc
                 (Integers.Int64.repr
                    (BinInt.Z.sub
                       (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                       (BinNums.Zpos BinNums.xH))))))
        (@cons jet_sx_expr.sx
           (jet_sx_expr.XLb jet_sx_expr.Bor
              (jet_sx_expr.XLsh jet_sx_expr.Hshru (jet_sx_expr.XLv (S (S O)))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))
              (jet_sx_expr.XLb jet_sx_expr.Band
                 (jet_sx_expr.XLsh jet_sx_expr.Hshl (jet_sx_expr.XLv (S (S (S O))))
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                 (jet_sx_expr.XLc
                    (Integers.Int64.repr
                       (BinInt.Z.sub
                          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                          (BinNums.Zpos BinNums.xH))))))
           (@cons jet_sx_expr.sx
              (jet_sx_expr.XLsh jet_sx_expr.Hshru (jet_sx_expr.XLv (S (S (S O))))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
              (@nil jet_sx_expr.sx)))))
     : list jet_sx_expr.sx
### C.jet_secp_storage_unpack.storage_unpack_words
storage_unpack_words =
fun (w : forall _ : nat, Integers.Int64.int) (i : nat) =>
@List.nth Integers.Int64.int i
  (@cons Integers.Int64.int
     (Integers.Int64.and (w O)
        (Integers.Int64.repr
           (BinInt.Z.sub
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
              (BinNums.Zpos BinNums.xH))))
     (@cons Integers.Int64.int
        (Integers.Int64.or
           (Integers.Int64.shru (w O)
              (Integers.Int64.repr
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
           (Integers.Int64.and
              (Integers.Int64.shl (w (S O))
                 (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
              (Integers.Int64.repr
                 (BinInt.Z.sub
                    (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                    (BinNums.Zpos BinNums.xH)))))
        (@cons Integers.Int64.int
           (Integers.Int64.or
              (Integers.Int64.shru (w (S O))
                 (Integers.Int64.repr
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
              (Integers.Int64.and
                 (Integers.Int64.shl (w (S (S O)))
                    (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                 (Integers.Int64.repr
                    (BinInt.Z.sub
                       (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                       (BinNums.Zpos BinNums.xH)))))
           (@cons Integers.Int64.int
              (Integers.Int64.or
                 (Integers.Int64.shru (w (S (S O)))
                    (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                 (Integers.Int64.and
                    (Integers.Int64.shl (w (S (S (S O))))
                       (Integers.Int64.repr
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
                    (Integers.Int64.repr
                       (BinInt.Z.sub
                          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                          (BinNums.Zpos BinNums.xH)))))
              (@cons Integers.Int64.int
                 (Integers.Int64.shru (w (S (S (S O))))
                    (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                 (@nil Integers.Int64.int)))))) Integers.Int64.zero
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments storage_unpack_words w%function_scope i%nat_scope
### C.jet_secp_storage_unpack.storage_unpack_run
storage_unpack_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_from_storage storage_unpack_args storage_unpack_regs (@nil jet_sx_eval.event)
  (S (S (S (S O))))
     : option jet_sx_exec.res
### C.jet_secp_storage_unpack.storage_unpack_state
storage_unpack_state =
match storage_unpack_tree return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_storage_unpack.storage_unpack_out_regs
storage_unpack_out_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 storage_unpack_out) true (@None BinNums.Z))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 storage_unpack_input) false (@None BinNums.Z))
     (@nil jet_sx_state.region))
     : list jet_sx_state.region
### C.jet_secp_storage_unpack.field_storage_readable
field_storage_readable =
fun (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (w : forall _ : nat, Integers.Int64.int) =>
and (BinInt.Z.le BinNums.Z0 base)
  (and (BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) base)
     (and
        (BinInt.Z.le
           (BinInt.Z.add base
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
           Integers.Ptrofs.max_unsigned)
        (and
           (Memory.Mem.range_perm m b base
              (BinInt.Z.add base
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
              Memtype.Cur Memtype.Readable)
           (forall (i : nat) (_ : lt i (S (S (S (S O))))),
            @eq (option Values.val)
              (Memory.Mem.load AST.Mint64 m b
                 (BinInt.Z.add base
                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))
              (@Some Values.val (Values.Vlong (w i)))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments field_storage_readable m b base%Z_scope w%function_scope
