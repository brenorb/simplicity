elements_nonces_of_sem
     : forall (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : jet_elements_prim.Elements.env),
       @eq
         (option
            (Ty.tySem
               (Ty.Sum Ty.Unit
                  (Ty.Sum Ty.Unit
                     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O))))))))))))))
         (@jet_elements_prim.Elements.sem (Word.Word (S (S (S (S (S O))))))
            (Ty.Sum Ty.Unit
               (Ty.Sum Ty.Unit
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) jet_elements_prim.Elements.OutputNonce i e)
         (@Some (sum unit (Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type))
            match
              @List.nth_error (Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type) (elements_nonces_of e)
                (BinInt.Z.to_nat (jet_forWhile_seq.wz (S (S (S (S (S O))))) i))
              return (sum unit (Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type))
