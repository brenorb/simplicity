### C.jet_elements_nonces_hash_program.elements_output_nonces_hash_spec
elements_output_nonces_hash_spec =
fun alg : jet_elements_words_hash_program.EFP.Algebra =>
let term : Alg.Assertion.Algebra := jet_elements_words_hash_program.EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha_hash_elems_reader.hash_elems_spec jet_elements_nonce_hash_spec.elements_nonce_type
  (fun term0 : Alg.Assertion.Algebra => @jet_elements_nonce_hash_spec.elements_nonce_hash_spec term0)
  (S (S (S (S (S O))))) term
  (@jet_buffer_empty_spec.AC.drop Ty.Unit (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit
        (Ty.Sum Ty.Unit
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) core
     (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit
           (Ty.Sum Ty.Unit
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) alg jet_elements_prim.Elements.OutputNonce))
     : forall alg : jet_elements_words_hash_program.EFP.Algebra,
       jet_elements_words_hash_program.EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments elements_output_nonces_hash_spec {alg}
### C.jet_elements_nonces_hash_program.elements_nonce_encode
elements_nonce_encode =
fun n : option jet_elements_prim.nonce =>
match n return (Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type) with
| Some n0 =>
    match n0 return (Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type) with
    | inl p =>
        match p return (Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type) with
        | pair odd w =>
            @inr unit
              (sum (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                           match n1 return Ty.Ty with
                           | O => X
                           | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                           match n1 return Ty.Ty with
                           | O => X
                           | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))))
              (@inl (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                           match n1 return Ty.Ty with
                           | O => X
                           | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                           match n1 return Ty.Ty with
                           | O => X
                           | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
                 (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    match odd return (sum unit unit) with
                    | true => @inr unit unit tt
                    | false => @inl unit unit tt
                    end (Word.from_hash256 w)))
        end
    | inr h =>
        @inr unit
          (sum
             (prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) (Ty.Sum Ty.Unit Ty.Unit))
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
          (@inr
             (prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) (Ty.Sum Ty.Unit Ty.Unit))
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h))
    end
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
end
     : forall _ : option jet_elements_prim.nonce, Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type

Arguments elements_nonce_encode n
### C.jet_elements_nonces_hash_program.elements_nonces_of
elements_nonces_of =
fun e : jet_elements_prim.Elements.env =>
@List.map jet_elements_prim.txOutput (Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type)
  (fun txo : jet_elements_prim.txOutput => elements_nonce_encode (jet_elements_prim.txoNonce txo))
  (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx e))
     : forall _ : jet_elements_prim.Elements.env, list (Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type)

Arguments elements_nonces_of e
### C.jet_elements_nonces_hash_program.elements_output_nonces_hash_of
elements_output_nonces_hash_of =
fun e : jet_elements_prim.Elements.env =>
jet_bitcoin_tx_hash.elems_hash_of jet_elements_nonce_hash_spec.elements_nonce_type
  jet_elements_nonce_hash_spec.elements_nonce_bytes (S (S (S (S (S O))))) (elements_nonces_of e)
     : forall _ : jet_elements_prim.Elements.env, Digest.hash256

Arguments elements_output_nonces_hash_of e
