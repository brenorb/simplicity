                         Ty.Prod rec rec))) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) amount x)))
         (@jet_complement_spec.complement_spec (S (S (S (S (S (S O)))))) Alg.CoreFunSem
            (@jet_shift64_spec.shift64_plain_spec true Alg.CoreFunSem
               (@pair
                  (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) amount
