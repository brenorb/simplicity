                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end)
                        (let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                         Ty.Prod rec rec))) (x : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))),
       @eq (Ty.tySem (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O))))))))
         (@shift64_with_spec true Alg.CoreFunSem
            (@pair (sum unit unit)
