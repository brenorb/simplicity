### C.jet_secp_curve_square_caller.curve_square_initial
curve_square_initial
     : forall (k : bool) (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin (jet_secp_curve_square.curve_square_offset k)
                (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : not (@eq Values.block bout bin)),
       jet_sx_state.rep rho
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) (jet_secp_curve_square.curve_square_regs k) m
### C.jet_secp_curve_square_caller.curve_square_fields
curve_square_fields
     : forall (k : bool) (rho : forall _ : nat, Integers.Int64.int) (m mf : Memory.Mem.mem)
         (bout bin : Values.block) (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : jet_secp_fe_nv.fe_at m bin (jet_secp_curve_square.curve_square_offset k)
                (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : jet_sx_state.rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@cons jet_sx_state.region
                   (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_square_execution.square_limbs) true
                      (@Some BinNums.Z
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                   (@cons jet_sx_state.region (jet_secp_curve_square.curve_square_input k) (@nil jet_sx_state.region)))
                mf),
       and
         (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
            (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
         (and
            (Memory.Mem.range_perm mf bout BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
               Memtype.Freeable)
            (and
               (jet_secp_fe_nv.fe_at mf bin (jet_secp_curve_square.curve_square_offset k)
                  (jet_secp_multiply_normalize_bridge.words5 rho))
               (Memory.Mem.range_perm mf bin BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)))
### C.jet_secp_curve_square_caller.eval_curve_square_from_storage
eval_curve_square_from_storage
     : forall (k : bool) (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin (jet_secp_curve_square.curve_square_offset k)
                (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : not (@eq Values.block bout bin)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vptr bin (Integers.Ptrofs.repr (jet_secp_curve_square.curve_square_offset k)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_secp_fe_nv.fe_at mf bin (jet_secp_curve_square.curve_square_offset k)
                        (jet_secp_multiply_normalize_bridge.words5 rho))
                     (and
                        (Memory.Mem.range_perm mf bin BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_square_numeric.square_words rho))
                                 jet_secp_multiply_checkpoint_columns.field_prime)
                              (BinInt.Z.modulo
                                 (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value rho)
                                    (jet_secp_multiply_finish_product.radix_value rho))
                                 jet_secp_multiply_checkpoint_columns.field_prime))
                           (and
                              (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                               and
                                 (BinInt.Z.le BinNums.Z0
                                    (Integers.Int64.unsigned (jet_secp_square_numeric.square_words rho i)))
                                 (BinInt.Z.lt (Integers.Int64.unsigned (jet_secp_square_numeric.square_words rho i))
                                    match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                                    | true =>
                                        BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))
                                    | false =>
                                        BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))
                                    end))
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (pos : BinNums.Z) =>
                                  not
                                    (jet_sx_state.foot
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z bout BinNums.Z0)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bin BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z))))
                                       (@List.map jet_sx_state.region
                                          (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                          jet_sx_state.rshape (jet_secp_curve_square.curve_square_regs k)) bx pos)) m
                                 mf))))))))
