### C.jet_elements_count_bridge.elements_transaction_num_inputs_spec_length
elements_transaction_num_inputs_spec_length
     : forall environment : jet_elements_prim.Elements.env,
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (@jet_elements_count_canonical.elements_transaction_num_inputs_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt
            environment)
         (@Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
               (BinInt.Z.of_nat
                  (@length jet_elements_prim.sigTxInput
                     (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment))))))
### C.jet_elements_count_bridge.elements_transaction_num_outputs_spec_length
elements_transaction_num_outputs_spec_length
     : forall environment : jet_elements_prim.Elements.env,
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (@jet_elements_count_canonical.elements_transaction_num_outputs_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt
            environment)
         (@Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
               (BinInt.Z.of_nat
                  (@length jet_elements_prim.txOutput
                     (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))))))
