### C.jet_secp_swu_selection.swu_euler_exponent_twice
swu_euler_exponent_twice
     : @eq BinNums.Z
         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
            (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
               (BinNums.Zpos (BinNums.xO BinNums.xH)))) (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
### C.jet_secp_swu_selection.swu_square_character
swu_square_character
     : forall (a : BinNums.Z) (_ : not (@eq BinNums.Z (BinInt.Z.modulo a jet_secp_fe_math.feP) BinNums.Z0)),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.pow (BinInt.Z.mul a a)
               (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                  (BinNums.Zpos (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP) (BinNums.Zpos BinNums.xH)
### C.jet_secp_swu_selection.swu_minus_eight_character
swu_minus_eight_character
     : @eq BinNums.Z
         (Zpow_facts.Zpow_mod (BinNums.Zneg (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
            (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
               (BinNums.Zpos (BinNums.xO BinNums.xH))) jet_secp_fe_math.feP)
         (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
### C.jet_secp_swu_selection.swu_minus_eight_not_square
swu_minus_eight_not_square
     : forall a : BinNums.Z,
       not
         (@eq BinNums.Z (BinInt.Z.modulo (BinInt.Z.mul a a) jet_secp_fe_math.feP)
            (BinInt.Z.modulo (BinNums.Zneg (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP))
### C.jet_secp_swu_selection.swu_candidate_denominator_nonzero
swu_candidate_denominator_nonzero
     : forall t : BinNums.Z,
       not
         (@eq BinNums.Z
            (BinInt.Z.modulo
               (BinInt.Z.add (BinInt.Z.mul t t) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
               jet_secp_fe_math.feP) BinNums.Z0)
### C.jet_secp_swu_selection.swu_mod_square_one
swu_mod_square_one
     : forall (z : BinNums.Z)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (BinInt.Z.mul z z) jet_secp_fe_math.feP) (BinNums.Zpos BinNums.xH)),
       or (@eq BinNums.Z (BinInt.Z.modulo z jet_secp_fe_math.feP) (BinNums.Zpos BinNums.xH))
         (@eq BinNums.Z (BinInt.Z.modulo z jet_secp_fe_math.feP)
            (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH)))
### C.jet_secp_swu_selection.swu_field_character_sign
swu_field_character_sign
     : forall (a : BinNums.Z) (_ : not (@eq BinNums.Z (BinInt.Z.modulo a jet_secp_fe_math.feP) BinNums.Z0)),
       or
         (@eq BinNums.Z
            (BinInt.Z.modulo
               (BinInt.Z.pow a
                  (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                     (BinNums.Zpos (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP) (BinNums.Zpos BinNums.xH))
         (@eq BinNums.Z
            (BinInt.Z.modulo
               (BinInt.Z.pow a
                  (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                     (BinNums.Zpos (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP)
            (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH)))
### C.jet_secp_swu_selection.swu_root_power_character
swu_root_power_character
     : forall a : BinNums.Z,
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.mul (BinInt.Z.pow a jet_secp_swu_root_power.swu_root_exponent)
               (BinInt.Z.pow a jet_secp_swu_root_power.swu_root_exponent)) jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (BinInt.Z.mul a
               (BinInt.Z.pow a
                  (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                     (BinNums.Zpos (BinNums.xO BinNums.xH))))) jet_secp_fe_math.feP)
### C.jet_secp_swu_selection.swu_character_one_square
swu_character_one_square
     : forall (a : BinNums.Z)
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo
                   (BinInt.Z.pow a
                      (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                         (BinNums.Zpos (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP) (BinNums.Zpos BinNums.xH)),
       @ex BinNums.Z
         (fun b : BinNums.Z =>
          @eq BinNums.Z (BinInt.Z.modulo a jet_secp_fe_math.feP)
            (BinInt.Z.modulo (BinInt.Z.mul b b) jet_secp_fe_math.feP))
### C.jet_secp_swu_selection.swu_nonsquare_nonzero
swu_nonsquare_nonzero
     : forall (a : BinNums.Z)
         (_ : forall b : BinNums.Z,
              not
                (@eq BinNums.Z (BinInt.Z.modulo a jet_secp_fe_math.feP)
                   (BinInt.Z.modulo (BinInt.Z.mul b b) jet_secp_fe_math.feP))),
       not (@eq BinNums.Z (BinInt.Z.modulo a jet_secp_fe_math.feP) BinNums.Z0)
### C.jet_secp_swu_selection.swu_nonsquare_character
swu_nonsquare_character
     : forall (a : BinNums.Z)
         (_ : forall b : BinNums.Z,
              not
                (@eq BinNums.Z (BinInt.Z.modulo a jet_secp_fe_math.feP)
                   (BinInt.Z.modulo (BinInt.Z.mul b b) jet_secp_fe_math.feP))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.pow a
               (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                  (BinNums.Zpos (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP)
         (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
### C.jet_secp_swu_selection.swu_character_product
swu_character_product
     : forall a b : BinNums.Z,
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.pow (BinInt.Z.mul a b)
               (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                  (BinNums.Zpos (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (BinInt.Z.modulo
                  (BinInt.Z.pow a
                     (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                        (BinNums.Zpos (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP)
               (BinInt.Z.modulo
                  (BinInt.Z.pow b
                     (BinInt.Z.div (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                        (BinNums.Zpos (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP)) jet_secp_fe_math.feP)
### C.jet_secp_swu_selection.swu_three_nonsquares_not_square
swu_three_nonsquares_not_square
     : forall (a b c : BinNums.Z)
         (_ : forall r : BinNums.Z,
              not
                (@eq BinNums.Z (BinInt.Z.modulo a jet_secp_fe_math.feP)
                   (BinInt.Z.modulo (BinInt.Z.mul r r) jet_secp_fe_math.feP)))
         (_ : forall r : BinNums.Z,
              not
                (@eq BinNums.Z (BinInt.Z.modulo b jet_secp_fe_math.feP)
                   (BinInt.Z.modulo (BinInt.Z.mul r r) jet_secp_fe_math.feP)))
         (_ : forall r : BinNums.Z,
              not
                (@eq BinNums.Z (BinInt.Z.modulo c jet_secp_fe_math.feP)
                   (BinInt.Z.modulo (BinInt.Z.mul r r) jet_secp_fe_math.feP))) (r : BinNums.Z),
       not
         (@eq BinNums.Z (BinInt.Z.modulo (BinInt.Z.mul (BinInt.Z.mul a b) c) jet_secp_fe_math.feP)
            (BinInt.Z.modulo (BinInt.Z.mul r r) jet_secp_fe_math.feP))
### C.jet_secp_swu_selection.swu_third_root_check_from_product
swu_third_root_check_from_product
     : forall (x y z : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
         (_ : @ex BinNums.Z
                (fun r : BinNums.Z =>
                 @eq BinNums.Z
                   (BinInt.Z.modulo
                      (BinInt.Z.mul
                         (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))
                         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z))
                      jet_secp_fe_math.feP) (BinInt.Z.modulo (BinInt.Z.mul r r) jet_secp_fe_math.feP)))
         (_ : @eq bool (Bit.toBool (jet_secp_root_check.literal_root_check x)) false)
         (_ : @eq bool (Bit.toBool (jet_secp_root_check.literal_root_check y)) false),
       @eq bool (Bit.toBool (jet_secp_root_check.literal_root_check z)) true
### C.jet_secp_swu_selection.swu_candidate_numerator_identity
swu_candidate_numerator_identity
     : forall s : BinNums.Z,
       @eq BinNums.Z
         (BinInt.Z.add
            (BinInt.Z.add
               (BinInt.Z.pow
                  (BinInt.Z.add
                     (BinInt.Z.sub (BinInt.Z.mul s s)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) s))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (BinNums.Zpos (BinNums.xI BinNums.xH)))
               (BinInt.Z.mul
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                     (BinInt.Z.add
                        (BinInt.Z.sub (BinInt.Z.mul s s)
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) s))
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (BinInt.Z.pow (BinInt.Z.add s (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))))
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
               (BinInt.Z.pow (BinInt.Z.add s (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                  (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))))
         (BinInt.Z.mul
            (BinNums.Zneg (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (BinInt.Z.add
               (BinInt.Z.pow
                  (BinInt.Z.sub (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) s)
                     (BinInt.Z.pow (BinInt.Z.add s (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (BinNums.Zpos (BinNums.xO BinNums.xH)))) (BinNums.Zpos (BinNums.xI BinNums.xH)))
               (BinInt.Z.mul
                  (BinNums.Zpos
                     (BinNums.xI
                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (BinInt.Z.pow s (BinNums.Zpos (BinNums.xI BinNums.xH))))))
