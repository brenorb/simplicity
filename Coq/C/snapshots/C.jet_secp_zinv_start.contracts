### C.jet_secp_zinv_start.zinv_z12_words
zinv_z12_words =
fun z inv : forall _ : nat, Integers.Int64.int => jet_secp_square_numeric.square_words (zinv_az_words z inv)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments zinv_z12_words (z inv)%function_scope n%nat_scope
### C.jet_secp_zinv_start.zinv_start_statements
zinv_start_statements =
@app Clight.statement
  (@cons Clight.statement jet_secp_zinv_initial_products.zinv_az_statement
     (@cons Clight.statement jet_secp_zinv_initial_products.zinv_z12_statement (@nil Clight.statement)))
  jet_secp_zinv_preparation.zinv_preparation_statements
     : list Clight.statement
### C.jet_secp_zinv_start.zinv_start_fields
zinv_start_fields =
fun (m : Memory.Mem.mem) (bp ba bb baz bz bu bv bs bt : Values.block)
  (x y z u v inv : forall _ : nat, Integers.Int64.int) =>
and (jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
  (and
     (jet_secp_fe_nv.fe_at m bp
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
        (jet_secp_multiply_normalize_bridge.words5 y))
     (and
        (jet_secp_fe_nv.fe_at m bp
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
           (jet_secp_multiply_normalize_bridge.words5 z))
        (and (jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
           (and
              (jet_secp_fe_nv.fe_at m ba
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                 (jet_secp_multiply_normalize_bridge.words5 v))
              (and (jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                 (and
                    (jet_secp_fe_nv.fe_at m baz BinNums.Z0
                       (jet_secp_multiply_normalize_bridge.words5 (zinv_az_words z inv)))
                    (and
                       (jet_secp_fe_nv.fe_at m bz BinNums.Z0
                          (jet_secp_multiply_normalize_bridge.words5 (zinv_z12_words z inv)))
                       (and
                          (jet_secp_fe_nv.fe_at m bu BinNums.Z0
                             (jet_secp_multiply_normalize_bridge.words5 (jet_secp_field_weak_loose.weak_loose_words x)))
                          (and
                             (jet_secp_fe_nv.fe_at m bv BinNums.Z0
                                (jet_secp_multiply_normalize_bridge.words5
                                   (jet_secp_point_mul_storage.point_mul_words u (zinv_z12_words z inv))))
                             (and
                                (jet_secp_fe_nv.fe_at m bs BinNums.Z0
                                   (jet_secp_multiply_normalize_bridge.words5
                                      (jet_secp_field_weak_loose.weak_loose_words y)))
                                (jet_secp_fe_nv.fe_at m bt BinNums.Z0
                                   (jet_secp_multiply_normalize_bridge.words5
                                      (jet_secp_zinv_preparation.zinv_s2_words v (zinv_z12_words z inv)
                                         (zinv_az_words z inv))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments zinv_start_fields m bp ba bb baz bz bu bv bs bt (x y z u v inv)%function_scope
### C.jet_secp_zinv_start.zinv_start_owned
zinv_start_owned =
fun (m : Memory.Mem.mem) (bp ba bb baz bz bu bv bs bt : Values.block) =>
and
  (Memory.Mem.range_perm m bp BinNums.Z0
     (BinNums.Zpos
        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     Memtype.Cur Memtype.Freeable)
  (and
     (Memory.Mem.range_perm m ba BinNums.Z0
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
        Memtype.Cur Memtype.Freeable)
     (and
        (Memory.Mem.range_perm m bb BinNums.Z0
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
           Memtype.Freeable)
        (and
           (Memory.Mem.range_perm m baz BinNums.Z0
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
              Memtype.Freeable)
           (and
              (Memory.Mem.range_perm m bz BinNums.Z0
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                 Memtype.Freeable)
              (and
                 (Memory.Mem.range_perm m bu BinNums.Z0
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                    Memtype.Cur Memtype.Freeable)
                 (and
                    (Memory.Mem.range_perm m bv BinNums.Z0
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                       Memtype.Cur Memtype.Freeable)
                    (and
                       (Memory.Mem.range_perm m bs BinNums.Z0
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                          Memtype.Cur Memtype.Freeable)
                       (Memory.Mem.range_perm m bt BinNums.Z0
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                          Memtype.Cur Memtype.Freeable))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block), Prop

Arguments zinv_start_owned m bp ba bb baz bz bu bv bs bt
### C.jet_secp_zinv_start.zinv_start_tight
zinv_start_tight =
fun x y z u v inv : forall _ : nat, Integers.Int64.int =>
and (jet_secp_field_mul_small.mul_small_input_bounds (jet_secp_field_weak_loose.weak_loose_words x))
  (and (jet_secp_field_mul_small.mul_small_input_bounds (jet_secp_field_weak_loose.weak_loose_words y))
     (and (jet_secp_field_mul_small.mul_small_input_bounds (zinv_az_words z inv))
        (and (jet_secp_field_mul_small.mul_small_input_bounds (zinv_z12_words z inv))
           (and
              (jet_secp_field_mul_small.mul_small_input_bounds
                 (jet_secp_point_mul_storage.point_mul_words u (zinv_z12_words z inv)))
              (jet_secp_field_mul_small.mul_small_input_bounds
                 (jet_secp_zinv_preparation.zinv_s2_words v (zinv_z12_words z inv) (zinv_az_words z inv)))))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments zinv_start_tight (x y z u v inv)%function_scope
### C.jet_secp_zinv_start.zinv_start_frame
zinv_start_frame =
fun (bu bv bs bt bz baz bp ba bb bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bu))
  (and (not (@eq Values.block bx bv))
     (and (not (@eq Values.block bx bs))
        (and (not (@eq Values.block bx bt))
           (and (not (@eq Values.block bx bz))
              (and (not (@eq Values.block bx baz))
                 (and
                    (or (not (@eq Values.block bx bp))
                       (or
                          (BinInt.Z.lt pos
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                          (BinInt.Z.le
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                             pos)))
                    (and
                       (or (not (@eq Values.block bx ba))
                          (or (BinInt.Z.lt pos BinNums.Z0)
                             (BinInt.Z.le
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                       (not (@eq Values.block bx bb)))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments zinv_start_frame bu bv bs bt bz baz bp ba bb bx pos%Z_scope
