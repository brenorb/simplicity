### C.jet_secp_table_field_equiv.table_word_equiv
table_word_equiv =
fun x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
@eq BinNums.Z
  (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x) jet_secp_fe_math.feP)
  (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y) jet_secp_fe_math.feP)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), Prop

Arguments table_word_equiv x y
