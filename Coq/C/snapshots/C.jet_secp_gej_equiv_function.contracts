### C.jet_secp_gej_equiv_function.gej_equiv_entry
gej_equiv_entry
     : forall (m : Memory.Mem.mem) (mi : Memory.Mem.mem') (bp ba bt : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (@pair Memory.Mem.mem' Values.block mi bt)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_gej_eq_var
         (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) m
         (jet_secp_gej_equiv_statements.gej_equiv_env bt) (gej_equiv_entry_temps bp ba) mi
### C.jet_secp_gej_equiv_function.gej_equiv_blocks
gej_equiv_blocks
     : forall bt : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (jet_secp_gej_equiv_statements.gej_equiv_env bt))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bt BinNums.Z0)
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
### C.jet_secp_gej_equiv_function.eval_gej_equiv_reader
eval_gej_equiv_reader
     : forall (x y z u v w : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bp ba : Values.block) (_ : not (@eq Values.block bp ba))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho x)))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho y)))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho z)))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho u)))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho v)))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho w)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val
                   (Values.Vint
                      (jet_readBit_layout.bit_int
                         (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val
                   (Values.Vint
                      (jet_readBit_layout.bit_int
                         (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem w))))))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_eq_var)
               (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               (Values.Vint
                  (jet_readBit_layout.bit_int
                     (Bit.toBool
                        (@jet_secp_gej_equiv_literal.literal_gej_equiv Alg.CoreFunSem
                           (@pair
                              (prod
                                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (prod
                                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (@pair
                                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)
                              (@pair
                                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) u v) w)))))))
            (and
               (Memory.Mem.range_perm mf bp BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) =>
                      and (not (@eq Values.block b bp)) (not (@eq Values.block b ba))) m mf))))
### C.jet_secp_gej_equiv_function.gej_equiv_entry_temps
gej_equiv_entry_temps =
fun bp ba : Values.block =>
@Maps.PTree.set Values.val jets_secp._b (Values.Vptr ba Integers.Ptrofs.zero)
  (@Maps.PTree.set Values.val jets_secp._a (Values.Vptr bp Integers.Ptrofs.zero)
     (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_gej_eq_var)))
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree Values.val

Arguments gej_equiv_entry_temps bp ba
