### C.jet_secp_scalar_overflow_numeric.scalar_overflow_matches_bound
scalar_overflow_matches_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq bool (jet_secp_scalar_overflow_flags.scalar_overflow_bool rho)
         (BinInt.Z.leb jet_secp_canonical_scalar.canonical_group_order (scalar_limb_value rho))
### C.jet_secp_scalar_overflow_numeric.eval_scalar_overflow_numeric
eval_scalar_overflow_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout jet_secp_scalar_overflow_exec.scalar_overflow_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_check_overflow)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  (jet_sx_expr.b2i
                     (BinInt.Z.leb jet_secp_canonical_scalar.canonical_group_order (scalar_limb_value rho)))))
            (and (jet_sx_state.rep rho layout jet_secp_scalar_overflow_exec.scalar_overflow_initial_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape jet_secp_scalar_overflow_exec.scalar_overflow_initial_regs) b ofs)) m mf)))
### C.jet_secp_scalar_overflow_numeric.scalar_limb_value
scalar_limb_value =
fun rho : forall _ : nat, Integers.Int64.int =>
BinInt.Z.add
  (BinInt.Z.add
     (BinInt.Z.add (Integers.Int64.unsigned (rho O))
        (BinInt.Z.mul
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
           (Integers.Int64.unsigned (rho (S O)))))
     (BinInt.Z.mul
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        (Integers.Int64.unsigned (rho (S (S O))))))
  (BinInt.Z.mul
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))
     (Integers.Int64.unsigned (rho (S (S (S O))))))
     : forall _ : forall _ : nat, Integers.Int64.int, BinNums.Z

Arguments scalar_limb_value rho%function_scope
