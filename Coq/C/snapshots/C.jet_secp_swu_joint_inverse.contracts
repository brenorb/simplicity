### C.jet_secp_swu_joint_inverse.exec_swu_joint_inverse
exec_swu_joint_inverse
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (bw bx bj : Values.block)
         (w : forall _ : nat, Integers.Int64.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_clight_internal_frame.plain_env e)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_inv_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._wd e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bw jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._jinv e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bj jet_secp_curve_statements.curve_fe_type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bw (@cons Values.block bx (@cons Values.block bj (@nil Values.block)))))
         (_ : jet_secp_swu_startup.swu_startup m) (_ : jet_secp_field_mul_small.mul_small_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bw BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bw BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bj BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun result : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_joint_inverse_prefix Events.E0 le
                  mf ClightBigstep.Out_normal)
               (and
                  (jet_secp_fe_nv.fe_at mf bw BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (jet_secp_swu_joint_setup.swu_setup_wd w)))
                  (and
                     (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_swu_joint_setup.swu_setup_x3d w)))
                     (and (jet_secp_fe_nv.fe_at mf bj BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 result))
                        (and
                           (Memory.Mem.range_perm mf bw BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bx BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bj BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and (jet_secp_square_columns.square_input_bounds result)
                                    (and
                                       (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value result)
                                          (modinv.modInv
                                             (BinInt.Z.mul
                                                (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value w)
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                                (BinInt.Z.mul (BinNums.Zneg (BinNums.xI BinNums.xH))
                                                   (jet_secp_multiply_finish_product.radix_value w)))
                                             jet_secp_fe_math.feP))
                                       (and (jet_secp_swu_startup.swu_startup mf)
                                          (and
                                             (jet_sx_mem.lframe
                                                (fun (b : Values.block) (_ : BinNums.Z) =>
                                                 and (not (@eq Values.block b bw))
                                                   (and (not (@eq Values.block b bx)) (not (@eq Values.block b bj)))) m
                                                mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))))))))
### C.jet_secp_swu_joint_inverse.swu_joint_inverse_congruent
swu_joint_inverse_congruent
     : forall (w : forall _ : nat, Integers.Int64.int) (t : BinNums.Z) (result : forall _ : nat, Integers.Int64.int)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_multiply_finish_product.radix_value w) (BinInt.Z.mul t t))
         (_ : @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value result)
                (modinv.modInv
                   (BinInt.Z.mul
                      (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value w)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.mul (BinNums.Zneg (BinNums.xI BinNums.xH))
                         (jet_secp_multiply_finish_product.radix_value w))) jet_secp_fe_math.feP)),
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value result)
         (jet_secp_swu_candidates.swu_joint_inverse t)
### C.jet_secp_swu_joint_inverse.swu_joint_product
swu_joint_product =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._jinv)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._wd)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x3d) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_swu_joint_inverse.swu_joint_invert
swu_joint_invert =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_inv_var jets_secp.f_secp256k1_fe_inv_var
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._jinv)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._jinv) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_swu_joint_inverse.swu_after_joint_inverse
swu_after_joint_inverse =
match jet_secp_swu_joint_setup.swu_after_joint_setup return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ rest => rest
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_swu_joint_inverse.swu_joint_inverse_statements
swu_joint_inverse_statements =
@app Clight.statement jet_secp_swu_joint_setup.swu_joint_setup_statements
  (@cons Clight.statement swu_joint_product (@cons Clight.statement swu_joint_invert (@nil Clight.statement)))
     : list Clight.statement
### C.jet_secp_swu_joint_inverse.swu_joint_inverse_prefix
swu_joint_inverse_prefix =
jet_secp_statement_prefix.statement_sequence swu_joint_inverse_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_swu_joint_inverse.swu_joint_words
swu_joint_words =
fun w : forall _ : nat, Integers.Int64.int =>
jet_secp_point_mul_storage.point_mul_words (jet_secp_swu_joint_setup.swu_setup_wd w)
  (jet_secp_swu_joint_setup.swu_setup_x3d w)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments swu_joint_words w%function_scope i%nat_scope
