### C.jet_secp_swu_joint_inverse.swu_joint_inverse_source
swu_joint_inverse_source
     : @eq Clight.statement jet_secp_swu_joint_setup.swu_after_joint_setup
         (Clight.Ssequence swu_joint_product (Clight.Ssequence swu_joint_invert swu_after_joint_inverse))
### C.jet_secp_swu_joint_inverse.swu_joint_inverse_prefix_source
swu_joint_inverse_prefix_source
     : @eq Clight.statement jet_secp_swu_initial.swu_after_initial
         (jet_secp_statement_prefix.statement_sequence swu_joint_inverse_statements swu_after_joint_inverse)
### C.jet_secp_swu_joint_inverse.swu_joint_words_value
swu_joint_words_value
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_field_mul_small.mul_small_input_bounds w),
       @eq BinNums.Z
         (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value (swu_joint_words w)) jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value w)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
               (BinInt.Z.mul (BinNums.Zneg (BinNums.xI BinNums.xH)) (jet_secp_multiply_finish_product.radix_value w)))
            jet_secp_fe_math.feP)
### C.jet_secp_swu_joint_inverse.swu_joint_inverse_value
swu_joint_inverse_value
     : forall (w result : forall _ : nat, Integers.Int64.int) (_ : jet_secp_field_mul_small.mul_small_input_bounds w)
         (_ : @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value result)
                (jet_secp_invert_literal.literal_invert_numeric
                   (jet_secp_fe_inv_prefix.fe_inv_value (swu_joint_words w)))),
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value result)
         (modinv.modInv
            (BinInt.Z.mul
               (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value w)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
               (BinInt.Z.mul (BinNums.Zneg (BinNums.xI BinNums.xH)) (jet_secp_multiply_finish_product.radix_value w)))
            jet_secp_fe_math.feP)
