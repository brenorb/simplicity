           (Alg.Assertion.toCore term)))
     (@AC.injr
        (Ty.Prod jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type
           jet_elements_single_issuance_spec.elements_single_issuance_tail_type) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Alg.Assertion.toCore term)
