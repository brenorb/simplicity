### C.jet_secp_gej_norm_rest.exec_gej_norm_payload_calls
exec_gej_norm_payload_calls
     : forall (le : Maps.PTree.tree Values.val) (m mr mf : Memory.Mem.mem) (bl bp br bd : Values.block)
         (base : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_gej_var)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mr
                (@Ctypes.Internal Clight.function jets_secp.f_write_ge)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_gej_norm_branch.gej_norm_env bl bp br) le m
         (Clight.Ssequence jet_secp_gej_norm_branch.gej_norm_affine_stmt jet_secp_gej_norm_branch.gej_norm_payload_stmt)
         Events.E0 le mf ClightBigstep.Out_normal
