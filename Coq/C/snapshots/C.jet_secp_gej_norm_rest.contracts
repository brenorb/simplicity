### C.jet_secp_gej_norm_rest.exec_gej_norm_branch_initialized
exec_gej_norm_branch_initialized
     : forall (le : Maps.PTree.tree Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z)
         (bw : Values.block) (edge cursor N : BinNums.Z) (bi : Values.block) (m : Memory.Mem.mem)
         (bl bp br : Values.block) (x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : forall (mc : Memory.Mem.mem) (w : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned w) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong w) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned w)))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N)
         (_ : jet_frame_inv.finv m0 bd base bw edge cursor N bi m true
                (@cons (option bool)
                   (@Some bool (negb (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z))))
                   (@nil (option bool))))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho x)))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho y)))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho z)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val
                   (Values.Vint
                      (jet_readBit_layout.bit_int
                         (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z))))))
         (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : not (@eq Values.block bp bl)) (_ : not (@eq Values.block br bp))
         (_ : not (@eq Values.block br bl))
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z br BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z)))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_gej_norm_branch.gej_norm_env bl bp br)
               (jet_secp_gej_norm_branch.gej_norm_tagged le
                  (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z))) m
               jet_secp_gej_norm_branch.gej_norm_branch Events.E0
               (jet_secp_gej_norm_branch.gej_norm_tagged le
                  (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z))) mf
               ClightBigstep.Out_normal)
            (and
               (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                  (@Translate.encode
                     (Ty.Sum Ty.Unit
                        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                           (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (@jet_secp_gej_norm_branch.literal_gej_normalize Alg.CoreFunSem
                        (@pair
                           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))))
               (and
                  (Memory.Mem.range_perm mf bp BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bl BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                        Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf br BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (_ : BinNums.Z) =>
                               and (not (@eq Values.block b bp))
                                 (and (not (@eq Values.block b br))
                                    (and (not (@eq Values.block b bl)) (not (jet_secp_frame.extA m0 bd bw bi b))))) m
                              mf)
                           (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                              (jet_clight_internal_preserve.readonly_preserved m mf))))))))
### C.jet_secp_gej_norm_rest.exec_gej_norm_after_copy
exec_gej_norm_after_copy
     : forall (le : Clight.temp_env) (m mt mf : Memory.Mem.mem) (bl bp br : Values.block) (infinity : bool)
         (_ : ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_gej_norm_branch.gej_norm_env bl bp br)
