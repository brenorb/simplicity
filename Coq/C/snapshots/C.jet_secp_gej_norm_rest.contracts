                   jet_secp_gej_norm_branch.gej_norm_header) Events.E0
                (jet_secp_gej_norm_branch.gej_norm_tagged le infinity) mt ClightBigstep.Out_normal)
         (_ : ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_gej_norm_branch.gej_norm_env bl bp br)
                (jet_secp_gej_norm_branch.gej_norm_tagged le infinity) mt jet_secp_gej_norm_branch.gej_norm_branch
                Events.E0 (jet_secp_gej_norm_branch.gej_norm_tagged le infinity) mf ClightBigstep.Out_normal),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_gej_norm_branch.gej_norm_env bl bp br) le m
         (Clight.Ssequence jet_secp_gej_predicate_body.gej_predicate_read_stmt
            jet_secp_gej_norm_branch.gej_norm_after_read) Events.E0
         (jet_secp_gej_norm_branch.gej_norm_tagged le infinity) mf
         (ClightBigstep.Out_return
            (@Some (prod Values.val Ctypes.type)
               (@pair Values.val Ctypes.type (Values.Vint Integers.Int.one) Ctypesdefs.tint)))
