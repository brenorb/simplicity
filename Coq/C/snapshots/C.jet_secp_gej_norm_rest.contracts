               jets_secp._write_ge) (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._write_ge)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
               (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._write_ge) Integers.Ptrofs.zero))
