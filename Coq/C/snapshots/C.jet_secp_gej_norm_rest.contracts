### C.jet_secp_gej_norm_rest.gej_norm_right_encoding
gej_norm_right_encoding
     : forall
         p : Ty.tySem
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       @eq (list BitMachine.Cell)
         (@Translate.encode
            (Ty.Sum Ty.Unit
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (@inr unit
               (Ty.tySem
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               p))
         (@app (option bool) (@cons (option bool) (@Some bool true) (@nil (option bool)))
            (@Translate.encode
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) p))
### C.jet_secp_gej_norm_rest.gej_norm_payload_link
