### C.jet_secp_modinv_fg_loop_numeric.exec_fg_loop_numeric
exec_fg_loop_numeric
     : forall (count k : nat) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (e : Clight.env) (le0 : Clight.temp_env) (m : Memory.Mem.mem) (_ : le (S O) k)
         (_ : le (Nat.add k count) (S (S (S (S (S O))))))
         (_ : @eq Integers.Int.int
                (Integers.Int64.loword (rho (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))
                (Integers.Int.repr (BinInt.Z.of_nat (Nat.add k count)))) (_ : fg_state_bounds rho)
         (_ : jet_sx_state.rep rho beta jet_secp_modinv_fg_iteration_prefix.fg_iter_regs m)
         (_ : jet_sx_eval.tmatch rho beta (jet_secp_modinv_fg_iteration_prefix.fg_iter_temps k) le0)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_fg_prefix.fg_alloc) e),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 m jet_secp_modinv_fg_index.fg_loop
                  Events.E0 lef mf ClightBigstep.Out_normal)
               (and
                  (forall high : bool,
                   @eq BinNums.Z (fg_completed_value count (jet_secp_modinv_fg_loop.fg_loop_rho count rho k) high k)
                     (BinInt.Z.add
                        (jet_secp_modinv_fg_iteration_arith.fg_pair_value
                           (jet_secp_modinv_fg_iteration_numeric.fg_iter_input rho high))
                        (fg_combination_tail count rho high k)))
                  (and (fg_state_bounds (jet_secp_modinv_fg_loop.fg_loop_rho count rho k))
                     (and
                        (jet_sx_state.rep (jet_secp_modinv_fg_loop.fg_loop_rho count rho k) beta
                           jet_secp_modinv_fg_iteration_prefix.fg_iter_regs mf)
                        (and
                           (jet_sx_eval.tmatch (jet_secp_modinv_fg_loop.fg_loop_rho count rho k) beta
                              (jet_secp_modinv_fg_iteration_prefix.fg_iter_temps (Nat.add k count)) lef)
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (jet_sx_state.foot beta
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape jet_secp_modinv_fg_iteration_prefix.fg_iter_regs) b ofs)) m
                              mf)))))))
### C.jet_secp_modinv_fg_loop_numeric.fg_array_word
fg_array_word =
fun (rho : forall _ : nat, Integers.Int64.int) (high : bool) (j : nat) =>
rho match high return nat with
    | true => Nat.add (S (S (S (S (S O))))) j
    | false => j
    end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool) (_ : nat), Integers.Int64.int

Arguments fg_array_word rho%function_scope high%bool_scope j%nat_scope
### C.jet_secp_modinv_fg_loop_numeric.fg_combination
fg_combination =
fun (rho : forall _ : nat, Integers.Int64.int) (high : bool) (j : nat) =>
BinInt.Z.add
  (BinInt.Z.mul (Integers.Int64.signed (jet_secp_modinv_fg_iteration_numeric.fg_iter_u rho high))
     (Integers.Int64.signed (rho j)))
  (BinInt.Z.mul (Integers.Int64.signed (jet_secp_modinv_fg_iteration_numeric.fg_iter_v rho high))
     (Integers.Int64.signed (rho (Nat.add (S (S (S (S (S O))))) j))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool) (_ : nat), BinNums.Z

Arguments fg_combination rho%function_scope high%bool_scope j%nat_scope
### C.jet_secp_modinv_fg_loop_numeric.fg_state_bounds
fg_state_bounds =
fun rho : forall _ : nat, Integers.Int64.int =>
and
  (forall high : bool,
   and
     (BinInt.Z.le
        (BinInt.Z.abs
           (jet_secp_modinv_fg_iteration_arith.fg_pair_value
              (jet_secp_modinv_fg_iteration_numeric.fg_iter_input rho high)))
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
     (BinInt.Z.le
        (BinInt.Z.add (BinInt.Z.abs (Integers.Int64.signed (jet_secp_modinv_fg_iteration_numeric.fg_iter_u rho high)))
           (BinInt.Z.abs (Integers.Int64.signed (jet_secp_modinv_fg_iteration_numeric.fg_iter_v rho high))))
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
  (forall (high : bool) (j : nat) (_ : lt j (S (S (S (S (S O)))))),
   BinInt.Z.le (BinInt.Z.abs (Integers.Int64.signed (fg_array_word rho high j)))
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
     : forall _ : forall _ : nat, Integers.Int64.int, Prop

Arguments fg_state_bounds rho%function_scope
### C.jet_secp_modinv_fg_loop_numeric.fg_combination_tail
fg_combination_tail =
fix fg_combination_tail
  (count : nat) (rho : forall _ : nat, Integers.Int64.int) (high : bool) (k : nat) {struct count} : BinNums.Z :=
  match count return BinNums.Z with
  | O => BinNums.Z0
  | S n =>
      BinInt.Z.add (fg_combination rho high k)
        (BinInt.Z.mul
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
           (fg_combination_tail n rho high (S k)))
  end
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : bool) (_ : nat), BinNums.Z

Arguments fg_combination_tail count%nat_scope rho%function_scope high%bool_scope k%nat_scope
### C.jet_secp_modinv_fg_loop_numeric.fg_completed_value
fg_completed_value =
fix fg_completed_value
  (count : nat) (rho : forall _ : nat, Integers.Int64.int) (high : bool) (k : nat) {struct count} : BinNums.Z :=
  match count return BinNums.Z with
  | O => jet_secp_modinv_fg_iteration_arith.fg_pair_value (jet_secp_modinv_fg_iteration_numeric.fg_iter_input rho high)
  | S n =>
      BinInt.Z.add (Integers.Int64.signed (fg_array_word rho high (Nat.sub k (S O))))
        (BinInt.Z.mul
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
           (fg_completed_value n rho high (S k)))
  end
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : bool) (_ : nat), BinNums.Z

Arguments fg_completed_value count%nat_scope rho%function_scope high%bool_scope k%nat_scope
