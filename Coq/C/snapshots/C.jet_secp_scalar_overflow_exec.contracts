### C.jet_secp_scalar_overflow_exec.scalar_overflow_state
scalar_overflow_state =
match scalar_overflow_tree return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone state _ => state
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_scalar_overflow_exec.scalar_overflow_return
scalar_overflow_return =
match @Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_overflow_state) return jet_sx_expr.sx with
| Some x => x
| None => jet_sx_expr.XIc Integers.Int.zero
end
     : jet_sx_expr.sx
