### C.jet_secp_scalar_overflow_exec.scalar_overflow_run_eq
scalar_overflow_run_eq
     : @eq (option jet_sx_exec.res) scalar_overflow_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone scalar_overflow_state jet_sx_exec.ONormal))
### C.jet_secp_scalar_overflow_exec.scalar_overflow_return_eq
scalar_overflow_return_eq
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_overflow_state))
         (@Some jet_sx_expr.sx scalar_overflow_return)
### C.jet_secp_scalar_overflow_exec.scalar_overflow_regions
scalar_overflow_regions
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs scalar_overflow_state) scalar_overflow_initial_regs
### C.jet_secp_scalar_overflow_exec.eval_scalar_overflow_from_readable_region
eval_scalar_overflow_from_readable_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout scalar_overflow_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_check_overflow)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@nil Values.val)) Events.E0 mf
               (jet_sx_expr.den rho (jet_sx_state.lay layout) scalar_overflow_return))
            (and (jet_sx_state.rep rho layout scalar_overflow_initial_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape scalar_overflow_initial_regs) b ofs)) m mf)))
### C.jet_secp_scalar_overflow_exec.scalar_overflow_initial_regs
scalar_overflow_initial_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells BinNums.Z0
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx)))))) false
     (@None BinNums.Z)) (@nil jet_sx_state.region)
     : list jet_sx_state.region
### C.jet_secp_scalar_overflow_exec.scalar_overflow_run
scalar_overflow_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_scalar_check_overflow
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0) (@nil jet_sx_expr.sx)) scalar_overflow_initial_regs
  (@nil jet_sx_eval.event) (S (S (S (S O))))
     : option jet_sx_exec.res
### C.jet_secp_scalar_overflow_exec.scalar_overflow_tree
