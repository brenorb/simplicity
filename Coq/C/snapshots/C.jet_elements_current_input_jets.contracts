               (jet_elements_issuance_amount_jets.issuance_amount_pcells x)))
### C.jet_elements_current_input_jets.encode_issuance_amount_cells
encode_issuance_amount_cells
     : forall txi : jet_elements_prim.sigTxInput,
       @eq (list BitMachine.Cell)
         (@Translate.encode
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S O)))))))))
            match
              jet_elements_prim.sigTxiIssuance txi
              return
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Word.Word (S (S (S (S (S (S O))))))))))
            with
            | Some i =>
                @inr unit
                  (Ty.tySem
                     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Word.Word (S (S (S (S (S (S O)))))))))
                  (jet_elements_amount_jets.encode_amount
                     (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int
                        (jet_elements_issuance_amount_jets.issuance_amount i)))
            | None =>
                @inl unit
                  (sum
                     (prod (sum unit unit)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S O))))))))) tt
            end) (jet_elements_issuance_amount_jets.issuance_amount_pcells txi)
