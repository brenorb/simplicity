### C.jet_elements_current_input_jets.issuance_amount_rep_pres
issuance_amount_rep_pres
     : forall (m1 m2 : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (x : jet_elements_prim.sigTxInput)
         (_ : jet_elements_issuance_amount_jets.issuance_amount_rep m1 b ofs x)
         (_ : forall (chunk : AST.memory_chunk) (o : BinNums.Z) (v : Values.val) (_ : BinInt.Z.le ofs o)
                (_ : BinInt.Z.le (BinInt.Z.add o (Memdata.size_chunk chunk))
                       (BinInt.Z.add ofs
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                (_ : @eq (option Values.val) (Memory.Mem.load chunk m1 b o) (@Some Values.val v)),
              @eq (option Values.val) (Memory.Mem.load chunk m2 b o) (@Some Values.val v)),
       jet_elements_issuance_amount_jets.issuance_amount_rep m2 b ofs x
