               (@Ctypes.Internal Clight.function
                  (jet_elements_issuance_helper.issuance_tagged_fun Cop.One (Integers.Int.repr BinNums.Z0)
                     jet_elements_issuance_amount_jets.assetamt_pexpr jets_elements._amt
                     (Ctypes.Tstruct jets_elements._confAmount Ctypes.noattr)
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xI
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs)) (@nil Values.val))) Events.E0 me
               Values.Vundef)
