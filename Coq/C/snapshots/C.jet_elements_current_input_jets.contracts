### C.jet_elements_current_input_jets.elements_current_input_ptr
elements_current_input_ptr
     : forall (nbits : BinNums.Z) (pcells : forall _ : jet_elements_prim.sigTxInput, list BitMachine.Cell)
         (elemrep : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : jet_elements_prim.sigTxInput),
                    Prop) (Bpay : Ty.Ty) (cid : AST.ident) (pt : Ctypes.type) (poff psz : BinNums.Z)
         (pexpr : Clight.expr) (cf f : Clight.function)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) nbits)
                (BinInt.Z.le nbits
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))
         (_ : @eq Ctypes.type (Clight.typeof pexpr) (Ctypesdefs.tptr pt))
         (_ : forall bl : Values.block,
              @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) cid
                   (jet_elements_version_exec.elements_version_locals bl)) (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.block)
                (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
                   (Clight.genv_genv jet_elements_linkage.elements_ge) cid)
                (@Some Values.block (jet_elements_linkage.elements_symbol_block cid)))
         (_ : @eq (option Clight.fundef)
                (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
                   (Clight.genv_genv jet_elements_linkage.elements_ge)
                   (Values.Vptr (jet_elements_linkage.elements_symbol_block cid) Integers.Ptrofs.zero))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function cf)))
         (_ : @eq Ctypes.type (Clight.type_of_fundef (@Ctypes.Internal Clight.function cf))
                (Ctypes.Tfunction
                   (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                      (Ctypes.Tcons (Ctypesdefs.tptr pt) Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
         (_ : and (BinInt.Z.le BinNums.Z0 poff)
                (BinInt.Z.le (BinInt.Z.add poff psz)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : forall (m1 m2 : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (x : jet_elements_prim.sigTxInput)
                (_ : elemrep m1 b ofs x)
                (_ : forall (chunk : AST.memory_chunk) (o : BinNums.Z) (v : Values.val) (_ : BinInt.Z.le ofs o)
                       (_ : BinInt.Z.le (BinInt.Z.add o (Memdata.size_chunk chunk)) (BinInt.Z.add ofs psz))
                       (_ : @eq (option Values.val) (Memory.Mem.load chunk m1 b o) (@Some Values.val v)),
                     @eq (option Values.val) (Memory.Mem.load chunk m2 b o) (@Some Values.val v)),
              elemrep m2 b ofs x)
         (_ : forall (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge : BinNums.Z)
                (m' : Memory.Mem.mem) (bin : Values.block) (ofs : BinNums.Z) (x : jet_elements_prim.sigTxInput)
                (cur : BinNums.Z) (_ : elemrep m' bin ofs x) (_ : BinInt.Z.le BinNums.Z0 ofs)
                (_ : BinInt.Z.le (BinInt.Z.add ofs psz) Integers.Ptrofs.max_unsigned)
                (_ : jet_application_sep.out_sep bd dbase bw outedge cur nbits bin ofs (BinInt.Z.add ofs psz))
                (_ : jet_output_layout.write_frame_at m' bd dbase bw outedge cur nbits),
              @ex Memory.Mem.mem
                (fun me : Memory.Mem.mem =>
                 and
                   (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m'
                      (@Ctypes.Internal Clight.function cf)
                      (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                         (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs)) (@nil Values.val))) Events.E0
                      me Values.Vundef)
                   (jet_elements_effects.write_effect m' me bd dbase bw outedge cur nbits (pcells x))))
         (_ : forall (e : Clight.env) (le' : Maps.PTree.tree Values.val) (m' : Memory.Mem.mem)
                (bin : Values.block) (inbase : BinNums.Z) (ixv : Integers.Int64.int)
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._t'2 le')
                       (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._t'3 le')
                       (@Some Values.val (Values.Vlong ixv))) (_ : BinInt.Z.le BinNums.Z0 inbase)
                (_ : BinInt.Z.le
                       (BinInt.Z.add
                          (BinInt.Z.add
                             (BinInt.Z.add inbase
                                (BinInt.Z.mul
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                   (Integers.Int64.unsigned ixv))) poff) psz) Integers.Ptrofs.max_unsigned),
              Clight.eval_expr jet_elements_linkage.elements_ge e le' m' pexpr
                (Values.Vptr bin
                   (Integers.Ptrofs.repr
                      (BinInt.Z.add
                         (BinInt.Z.add inbase
                            (BinInt.Z.mul
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                               (Integers.Int64.unsigned ixv))) poff))))
         (_ : jet_elements_wrapper.elements_wrapper_shape f
                (jet_elements_current_ptr.elements_current_ptr_rest jets_elements._t'1 jets_elements._t'2
                   jets_elements._t'3 jets_elements._t'4 jets_elements._t'5 jets_elements._t'6 jets_elements._input
                   jets_elements._numInputs jets_elements._sigInput pexpr cid pt))
         (_ : @eq BinNums.Z (BinInt.Z.of_nat (Translate.bitSize Bpay)) nbits)
         (t : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
              option (Ty.tySem (Ty.Sum Ty.Unit Bpay))) (fres : forall _ : jet_elements_prim.sigTxInput, Ty.tySem Bpay)
         (_ : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : jet_elements_prim.Elements.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit Bpay))) (t a e)
                (@Some (sum unit (Ty.tySem Bpay))
                   match
                     @List.nth_error jet_elements_prim.sigTxInput
                       (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
                       (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
                     return (sum unit (Ty.tySem Bpay))
                   with
                   | Some txi => @inr unit (Ty.tySem Bpay) (fres txi)
                   | None => @inl unit (Ty.tySem Bpay) tt
                   end))
         (_ : forall txi : jet_elements_prim.sigTxInput,
              @eq (list BitMachine.Cell) (@Translate.encode Bpay (fres txi)) (pcells txi))
         (_ : forall x : jet_elements_prim.sigTxInput,
              @eq BinNums.Z (BinInt.Z.of_nat (@length BitMachine.Cell (pcells x))) nbits),
       jet_application_sep.application_jet_local_spec_sep f jet_elements_linkage.elements_ge
         jet_elements_prim.Elements.env Ty.Unit Bpay
         (@jet_elements_current_ptr_jets.current_ptr_rep jet_elements_prim.Elements.environment
            jet_elements_prim.sigTxInput
            (fun e : jet_elements_prim.Elements.environment =>
             jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e)) jet_elements_prim.Elements.envIx elemrep
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
            poff BinNums.Z0
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env) =>
          @jet_elements_current_spec.elements_current_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) Bpay t a
            environment)
