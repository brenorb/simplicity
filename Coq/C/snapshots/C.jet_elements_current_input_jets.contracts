              @eq bool (Integers.Int.eq K (jet_elements_issuance_jets.issuance_tag o))
                (@jet_elements_issuance_jets.opt_is_some Digest.hash256 (gh o)))
         (_ : and (BinInt.Z.le BinNums.Z0 delta)
                (BinInt.Z.le
                   (BinInt.Z.add delta
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : @eq Ctypes.type (Clight.typeof pexpr_h)
                (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
         (_ : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m' : Memory.Mem.mem)
                (bi : Values.block) (ibase : BinNums.Z)
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._issuance le)
                       (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr ibase))))
                (_ : BinInt.Z.le BinNums.Z0 ibase)
                (_ : BinInt.Z.le
                       (BinInt.Z.add ibase
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                       Integers.Ptrofs.max_unsigned),
              Clight.eval_expr jet_elements_linkage.elements_ge e le m' pexpr_h
                (Values.Vptr bi (Integers.Ptrofs.repr (BinInt.Z.add ibase delta)))) (bd : Values.block)
         (dbase : BinNums.Z) (bw : Values.block) (outedge : BinNums.Z) (m' : Memory.Mem.mem)
         (bin : Values.block) (ofs : BinNums.Z) (x : jet_elements_prim.sigTxInput) (cur : BinNums.Z)
         (_ : jet_elements_issuance_jets.issuance_hash_rep delta gh m' bin ofs x) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_application_sep.out_sep bd dbase bw outedge cur
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                bin ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : jet_output_layout.write_frame_at m' bd dbase bw outedge cur
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun me : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m'
               (@Ctypes.Internal Clight.function
                  (jet_elements_issuance_helper.issuance_tagged_fun Cop.Oeq K pexpr_h jets_elements._writeHash
                     (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs)) (@nil Values.val))) Events.E0 me
               Values.Vundef)
            (jet_elements_effects.write_effect m' me bd dbase bw outedge cur
               (BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (jet_elements_issuance_jets.issuance_hash_pcells gh x)))
