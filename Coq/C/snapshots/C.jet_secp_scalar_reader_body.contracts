### C.jet_secp_scalar_reader_body.exec_scalar_reader_body
exec_scalar_reader_body
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list BitMachine.Cell) (cap : BinNums.Z)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : jet_sx_state.layout) (e : Clight.env) (le : Clight.temp_env)
         (_ : jet_sx_state.rep (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                (jet_sx_eval.sregs (jet_secp_scalar_reader_run.scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m)
         (_ : jet_sx_eval.tmatch (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                jet_secp_scalar_reader_run.scalar_reader_temps le)
         (_ : jet_sx_eval.ematch layout jet_secp_scalar_reader_run.scalar_reader_venv e)
         (_ : jet_sx_exec.xsep (jet_secp_scalar_reader_body.rd_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_reader_body.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (jet_secp_wrapper_run.read_fe_rho ibits rc) (@nil jet_sx_eval.event) m),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (Clight.fn_body jets_secp.f_read_scalar) Events.E0 le' mf ClightBigstep.Out_normal)
               (and
                  (jet_sx_state.rep (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                     (jet_sx_eval.sregs
                        (jet_secp_scalar_reader_set.scalar_reader_set_state bi (Integers.Ptrofs.repr edge))) mf)
                  (and
                     (jet_sx_eval.tmatch (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                        jet_secp_scalar_reader_run.scalar_reader_temps le')
                     (and
                        (jet_secp_scalar_reader_body.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                           (jet_secp_wrapper_run.read_fe_rho ibits rc)
                           (jet_secp_scalar_reader_run.scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                        (jet_sx_mem.lframe
                           (jet_sx_exec.frame (jet_secp_scalar_reader_body.rd_ext m0 bd bw bi) layout
                              (jet_sx_eval.sregs
                                 (jet_secp_scalar_reader_run.scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m)
                           m mf))))))
### C.jet_secp_scalar_reader_body.exec_scalar_reader_body_numeric
exec_scalar_reader_body_numeric
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list BitMachine.Cell) (cap : BinNums.Z)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : jet_sx_state.layout) (e : Clight.env) (le : Clight.temp_env)
         (_ : jet_sx_state.rep (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                (jet_sx_eval.sregs (jet_secp_scalar_reader_run.scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m)
         (_ : jet_sx_eval.tmatch (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                jet_secp_scalar_reader_run.scalar_reader_temps le)
         (_ : jet_sx_eval.ematch layout jet_secp_scalar_reader_run.scalar_reader_venv e)
         (_ : jet_sx_exec.xsep (jet_secp_scalar_reader_body.rd_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_reader_body.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (jet_secp_wrapper_run.read_fe_rho ibits rc) (@nil jet_sx_eval.event) m),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (Clight.fn_body jets_secp.f_read_scalar) Events.E0 le' mf ClightBigstep.Out_normal)
               (and
                  (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                   @eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk layout O)
                        (BinInt.Z.add (jet_sx_state.bas layout O)
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat i))))
                     (@Some Values.val
                        (Values.Vlong
                           (jet_secp_scalar_reader_value.scalar_reader_limb (jet_secp_wrapper_run.read_fe_rho ibits rc)
                              (jet_sx_state.lay layout) i))))
                  (and
                     (@eq BinNums.Z
                        (jet_secp_scalar_overflow_numeric.scalar_limb_value
                           (jet_secp_scalar_reader_value.scalar_reader_limb (jet_secp_wrapper_run.read_fe_rho ibits rc)
                              (jet_sx_state.lay layout)))
                        (BinInt.Z.modulo
                           (jet_secp_fe_math.be_val
                              (jet_secp_input_bytes.input_bytes
                                 (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))) ibits))
                           jet_secp_canonical_scalar.canonical_group_order))
                     (and
                        (jet_sx_state.rep (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                           (jet_sx_eval.sregs
                              (jet_secp_scalar_reader_set.scalar_reader_set_state bi (Integers.Ptrofs.repr edge))) mf)
                        (and (@eq BinNums.Z (jet_sx_state.bas layout (S (S O))) BinNums.Z0)
                           (and
                              (Memory.Mem.range_perm mf (jet_sx_state.blk layout (S (S O))) BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_sx_eval.tmatch (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                                    jet_secp_scalar_reader_run.scalar_reader_temps le')
                                 (and
                                    (jet_secp_scalar_reader_body.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                                       (jet_secp_wrapper_run.read_fe_rho ibits rc)
                                       (jet_secp_scalar_reader_run.scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                                    (jet_sx_mem.lframe
                                       (jet_sx_exec.frame (jet_secp_scalar_reader_body.rd_ext m0 bd bw bi) layout
                                          (jet_sx_eval.sregs
                                             (jet_secp_scalar_reader_run.scalar_reader_initial bi
                                                (Integers.Ptrofs.repr edge))) m) m mf))))))))))
