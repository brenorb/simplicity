### C.jet_secp_wnaf_literal_tail.literal_wnaf_small_odd_digit
literal_wnaf_small_odd_digit
     : forall (word : Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) word)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))))
         (_ : @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                (@Word.rightmost (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))) Alg.CoreFunSem word)
                (@inr unit unit tt)),
       @ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
         (fun next : Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))) =>
          @ex (Ty.tySem (Word.Word (S (S (S (S O))))))
            (fun digit : Ty.tySem (Word.Word (S (S (S (S O))))) =>
             and
               (@eq
                  (Ty.tySem (Ty.Prod jet_secp_wnaf_literal.literal_wnaf_state jet_secp_wnaf_literal.literal_wnaf_digit))
                  (@jet_secp_wnaf_literal.literal_wnaf15_step Alg.CoreFunSem
                     (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
                        (@inl unit unit tt) word))
                  (@pair (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))))
                     (sum unit (Ty.tySem (Word.Word (S (S (S (S O)))))))
                     (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
                        (@inl unit unit tt) next) (@inr unit (Ty.tySem (Word.Word (S (S (S (S O)))))) digit)))
               (and
                  (@eq BinNums.Z (jet_secp_wnaf_literal_mask.literal_wnaf_signed16 digit)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) word))
                  (@eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) next) BinNums.Z0))))
### C.jet_secp_wnaf_literal_tail.literal_wnaf_small_odd_run
literal_wnaf_small_odd_run
     : forall (count : nat) (word : Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) word)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))))
         (_ : @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                (@Word.rightmost (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))) Alg.CoreFunSem word)
                (@inr unit unit tt)),
       @ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
         (fun final : Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))) =>
          @ex (Ty.tySem (Word.Word (S (S (S (S O))))))
            (fun digit : Ty.tySem (Word.Word (S (S (S (S O))))) =>
             and
               (@eq
                  (prod (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_state)
                     (list (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)))
                  (jet_secp_wnaf_literal.literal_wnaf_run (S count)
                     (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
                        (@inl unit unit tt) word))
                  (@pair (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))))
                     (list (sum unit (Ty.tySem (Word.Word (S (S (S (S O))))))))
                     (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
                        (@inl unit unit tt) final)
                     (@app (sum unit (Ty.tySem (Word.Word (S (S (S (S O)))))))
                        (@List.repeat (sum unit (Ty.tySem (Word.Word (S (S (S (S O)))))))
                           (@inl unit (Ty.tySem (Word.Word (S (S (S (S O)))))) tt) count)
                        (@cons (sum unit (Ty.tySem (Word.Word (S (S (S (S O)))))))
                           (@inr unit (Ty.tySem (Word.Word (S (S (S (S O)))))) digit)
                           (@nil (sum unit (Ty.tySem (Word.Word (S (S (S (S O))))))))))))
               (and
                  (@eq BinNums.Z (jet_secp_wnaf_literal_mask.literal_wnaf_signed16 digit)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) word))
                  (@eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) final) BinNums.Z0))))
### C.jet_secp_wnaf_literal_tail.literal_wnaf_last_window
literal_wnaf_last_window
     : forall (n bit width carry : BinNums.Z) (word : Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le BinNums.Z0 bit)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) width)
                (BinInt.Z.le width (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
         (_ : and (BinInt.Z.le BinNums.Z0 (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit)))
                (BinInt.Z.lt (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit))
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.sub width (BinNums.Zpos BinNums.xH)))))
         (_ : or (@eq BinNums.Z carry BinNums.Z0) (@eq BinNums.Z carry (BinNums.Zpos BinNums.xH)))
         (_ : not
                (@eq BinNums.Z
                   (BinInt.Z.modulo (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit))
                      (BinNums.Zpos (BinNums.xO BinNums.xH))) carry))
         (_ : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) word)
                (BinInt.Z.add (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit)) carry)),
       @ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
         (fun final : Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))) =>
          @ex (Ty.tySem (Word.Word (S (S (S (S O))))))
            (fun digit : Ty.tySem (Word.Word (S (S (S (S O))))) =>
             and
               (@eq
                  (prod (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_state)
                     (list (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)))
                  (jet_secp_wnaf_literal.literal_wnaf_run (BinInt.Z.to_nat width)
                     (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
                        (@inl unit unit tt) word))
                  (@pair (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))))
                     (list (sum unit (Ty.tySem (Word.Word (S (S (S (S O))))))))
                     (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
                        (@inl unit unit tt) final)
                     (@app (sum unit (Ty.tySem (Word.Word (S (S (S (S O)))))))
                        (@List.repeat (sum unit (Ty.tySem (Word.Word (S (S (S (S O)))))))
                           (@inl unit (Ty.tySem (Word.Word (S (S (S (S O)))))) tt)
                           (BinInt.Z.to_nat (BinInt.Z.sub width (BinNums.Zpos BinNums.xH))))
                        (@cons (sum unit (Ty.tySem (Word.Word (S (S (S (S O)))))))
                           (@inr unit (Ty.tySem (Word.Word (S (S (S (S O)))))) digit)
                           (@nil (sum unit (Ty.tySem (Word.Word (S (S (S (S O))))))))))))
               (and
                  (@eq BinNums.Z (jet_secp_wnaf_literal_mask.literal_wnaf_signed16 digit)
                     (jet_secp_wnaf_digit.wnaf_digit (jet_secp_wnaf_digit.wnaf_word n bit width carry)
                        (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                  (and
                     (@eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) final)
                        BinNums.Z0)
                     (@eq BinNums.Z
                        (jet_secp_wnaf_digit.wnaf_carry (jet_secp_wnaf_digit.wnaf_word n bit width carry)
                           (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))) BinNums.Z0)))))
