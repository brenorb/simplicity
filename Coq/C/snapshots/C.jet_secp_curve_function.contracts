                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))))))
### C.jet_secp_curve_function.curve_entry_temps
curve_entry_temps =
fun ba : Values.block =>
@Maps.PTree.set Values.val jets_secp._a (Values.Vptr ba Integers.Ptrofs.zero)
  (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_ge_is_valid_var))
     : forall _ : Values.block, Maps.PTree.tree Values.val

