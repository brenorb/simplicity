### C.jet_secp_table_get_execution.table_get_closed
table_get_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers
            (Clight.fn_body jets_secp.f_secp256k1_ecmult_table_get_ge)) true
### C.jet_secp_table_get_execution.eval_table_get_ge
eval_table_get_ge
     : forall (negative : bool) (j : BinNums.Z) (m : Memory.Mem.mem) (bd bt : Values.block)
         (x y : forall _ : nat, Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : not (@eq Values.block bd bt))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bt
                (BinInt.Z.mul
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) j)
                (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bt
                (BinInt.Z.add
                   (BinInt.Z.mul
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) j)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bt
                   (BinInt.Z.add
                      (BinInt.Z.mul
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) j)
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult_table_get_ge)
               (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vint (Integers.Int.repr (jet_secp_table_get_control.table_get_digit negative j)))
                        (@cons Values.val
                           (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                           (@nil Values.val))))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf bd BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf bd
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5
                        match negative return (forall _ : nat, Integers.Int64.int) with
                        | true => jet_secp_field_negate_separate.negate_sep_words y
                        | false => y
                        end))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bd
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (Memory.Mem.range_perm mf bd BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bt BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                              Memtype.Cur Memtype.Freeable)
                           (and (jet_clight_internal_permissions.keeps_permissions m mf)
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
