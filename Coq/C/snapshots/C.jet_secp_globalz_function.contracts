### C.jet_secp_globalz_function.eval_ge_table_set_globalz_eight
eval_ge_table_set_globalz_eight
     : forall (xs ys ratios : forall (_ : nat) (_ : nat), Integers.Int64.int) (m : Memory.Mem.mem)
         (br bz : Values.block) (_ : not (@eq Values.block br bz))
         (_ : jet_secp_globalz_loop.globalz_table_bounds xs ys)
         (_ : jet_secp_globalz_loop.globalz_ratios_bounds ratios)
         (_ : jet_secp_globalz_loop.globalz_table_rep m br xs ys)
         (_ : jet_secp_globalz_loop.globalz_ratios_rep m bz ratios)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                Memtype.Cur Memtype.Freeable),
       match
         jet_secp_globalz_loop.globalz_walk (S (S (S (S (S (S (S O))))))) xs (globalz_start_ys ys) ratios
           (ratios (S (S (S (S (S (S (S O)))))))) return Prop
       with
       | pair p _ =>
           match p return Prop with
           | pair xf yf =>
               @ex Memory.Mem.mem
                 (fun mf : Memory.Mem.mem =>
                  and
                    (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                       (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_table_set_globalz)
                       (@cons Values.val
                          (Values.Vlong
                             (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                          (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                             (@cons Values.val (Values.Vptr bz Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                       Values.Vundef)
                    (and (jet_secp_globalz_loop.globalz_table_rep mf br xf yf)
                       (and (jet_secp_globalz_loop.globalz_ratios_rep mf bz ratios)
                          (and (jet_secp_globalz_loop.globalz_table_bounds xf yf)
                             (and
                                (Memory.Mem.range_perm mf br BinNums.Z0
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                                   Memtype.Cur Memtype.Freeable)
                                (and
                                   (Memory.Mem.range_perm mf bz BinNums.Z0
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                                      Memtype.Cur Memtype.Freeable)
                                   (and (jet_clight_internal_permissions.keeps_permissions m mf)
                                      (and
                                         (jet_sx_mem.lframe
                                            (fun (b : Values.block) (_ : BinNums.Z) =>
                                             and (not (@eq Values.block b br)) (not (@eq Values.block b bz))) m mf)
                                         (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
           end
       end
### C.jet_secp_globalz_function.globalz_entry_temps
globalz_entry_temps =
fun br bz : Values.block =>
@Maps.PTree.set Values.val jets_secp._zr (Values.Vptr bz Integers.Ptrofs.zero)
  (@Maps.PTree.set Values.val jets_secp._a (Values.Vptr br Integers.Ptrofs.zero)
     (@Maps.PTree.set Values.val jets_secp._len
        (Values.Vlong (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_ge_table_set_globalz))))
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree Values.val

Arguments globalz_entry_temps br bz
### C.jet_secp_globalz_function.globalz_start_ys
globalz_start_ys =
fun ys : forall (_ : nat) (_ : nat), Integers.Int64.int =>
jet_secp_globalz_loop.globalz_replace ys (S (S (S (S (S (S (S O)))))))
  (jet_secp_field_weak_loose.weak_loose_words (ys (S (S (S (S (S (S (S O)))))))))
     : forall (_ : forall (_ : nat) (_ : nat), Integers.Int64.int) (_ : nat) (_ : nat), Integers.Int64.int

