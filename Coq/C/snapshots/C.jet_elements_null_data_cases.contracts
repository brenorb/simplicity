### C.jet_elements_null_data_cases.elements_null_data_small_switch_expr
elements_null_data_small_switch_expr
     : @eq Clight.expr (@fst Clight.expr Clight.labeled_statements elements_null_data_small_switch)
         (Clight.Etempvar jets_elements._t'31 Ctypesdefs.tint)
### C.jet_elements_null_data_cases.elements_null_data_small_selected
elements_null_data_small_selected
     : forall (n : nat) (_ : lt n (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))),
       @ex Clight.statement
         (fun tail : Clight.statement =>
          @eq Clight.statement
            (Clight.seq_of_labeled_statement
               (Clight.select_switch
                  (BinInt.Z.add (BinInt.Z.of_nat n) (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))
                  (@snd Clight.expr Clight.labeled_statements elements_null_data_small_switch)))
            (Clight.Ssequence (jet_elements_const_bits.elements_const_bits (elements_nibble_bits n)) tail))
### C.jet_elements_null_data_cases.elements_null_data_push_switch_expr
elements_null_data_push_switch_expr
     : @eq Clight.expr (@fst Clight.expr Clight.labeled_statements elements_null_data_push_switch)
         (Clight.Etempvar jets_elements._t'15 Ctypesdefs.tint)
