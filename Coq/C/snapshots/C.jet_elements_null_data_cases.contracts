### C.jet_elements_null_data_cases.exec_elements_null_data_small_switch
exec_elements_null_data_small_switch
     : forall (n : nat) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (edge cur : BinNums.Z)
         (_ : lt n (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._writeBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._t'31 le)
                (@Some Values.val
                   (Values.Vint
                      (Integers.Int.repr
                         (BinInt.Z.add (BinInt.Z.of_nat n) (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))))))
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cur
                (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m
               (Clight.Sswitch (@fst Clight.expr Clight.labeled_statements elements_null_data_small_switch)
                  (@snd Clight.expr Clight.labeled_statements elements_null_data_small_switch)) Events.E0 le mf
               ClightBigstep.Out_normal)
            (jet_elements_effects.write_effect m mf bd dbase bw edge cur
               (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
               (@Translate.encode (Word.Word (S (S O)))
                  (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S O))) (BinInt.Z.of_nat n)))))
### C.jet_elements_null_data_cases.elements_statement_switches
elements_statement_switches =
fix elements_statement_switches (s : Clight.statement) : list (prod Clight.expr Clight.labeled_statements) :=
  match s return (list (prod Clight.expr Clight.labeled_statements)) with
  | Clight.Sskip => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sassign _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sset _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Scall _ _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sbuiltin _ _ _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Ssequence a b =>
      @app (prod Clight.expr Clight.labeled_statements) (elements_statement_switches a) (elements_statement_switches b)
  | Clight.Sifthenelse _ a b =>
      @app (prod Clight.expr Clight.labeled_statements) (elements_statement_switches a) (elements_statement_switches b)
  | Clight.Sloop a b =>
      @app (prod Clight.expr Clight.labeled_statements) (elements_statement_switches a) (elements_statement_switches b)
  | Clight.Sbreak => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Scontinue => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sreturn _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sswitch a cases =>
      @cons (prod Clight.expr Clight.labeled_statements) (@pair Clight.expr Clight.labeled_statements a cases)
        (@nil (prod Clight.expr Clight.labeled_statements))
  | Clight.Slabel _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sgoto _ => @nil (prod Clight.expr Clight.labeled_statements)
  end
     : forall _ : Clight.statement, list (prod Clight.expr Clight.labeled_statements)

Arguments elements_statement_switches s
### C.jet_elements_null_data_cases.elements_null_data_small_switch
elements_null_data_small_switch =
@List.nth (prod Clight.expr Clight.labeled_statements) O
  (elements_statement_switches (Clight.fn_body jets_elements.f_simplicity_output_null_datum))
  (@pair Clight.expr Clight.labeled_statements (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Clight.LSnil)
     : prod Clight.expr Clight.labeled_statements
### C.jet_elements_null_data_cases.elements_nibble_bits
elements_nibble_bits =
fun n : nat =>
@List.map BinNums.Z bool (BinInt.Z.testbit (BinInt.Z.of_nat n))
  (@cons BinNums.Z (BinNums.Zpos (BinNums.xI BinNums.xH))
     (@cons BinNums.Z (BinNums.Zpos (BinNums.xO BinNums.xH))
        (@cons BinNums.Z (BinNums.Zpos BinNums.xH) (@cons BinNums.Z BinNums.Z0 (@nil BinNums.Z)))))
     : forall _ : nat, list bool

Arguments elements_nibble_bits n%nat_scope
### C.jet_elements_null_data_cases.elements_null_data_push_switch
elements_null_data_push_switch =
@List.nth (prod Clight.expr Clight.labeled_statements) (S O)
  (elements_statement_switches (Clight.fn_body jets_elements.f_simplicity_output_null_datum))
  (@pair Clight.expr Clight.labeled_statements (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Clight.LSnil)
     : prod Clight.expr Clight.labeled_statements
### C.jet_elements_null_data_cases.elements_push_kind_bits
elements_push_kind_bits =
fun n : nat =>
@List.map BinNums.Z bool (BinInt.Z.testbit (BinInt.Z.of_nat n))
  (@cons BinNums.Z (BinNums.Zpos BinNums.xH) (@cons BinNums.Z BinNums.Z0 (@nil BinNums.Z)))
     : forall _ : nat, list bool

Arguments elements_push_kind_bits n%nat_scope
