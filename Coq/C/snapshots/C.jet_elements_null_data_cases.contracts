### C.jet_elements_null_data_cases.elements_push_kind_cells
elements_push_kind_cells
     : forall (n : nat) (_ : lt n (S (S (S (S O))))),
       @eq (list (option bool)) (@List.map bool (option bool) (@Some bool) (elements_push_kind_bits n))
         (@Translate.encode (Word.Word (S O)) (@Word.ToZ.Theory.fromZ (Word.WordToZ (S O)) (BinInt.Z.of_nat n)))
### C.jet_elements_null_data_cases.exec_elements_null_data_push_switch
exec_elements_null_data_push_switch
     : forall (n : nat) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (edge cur : BinNums.Z)
         (_ : lt n (S (S (S (S O)))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._writeBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._t'15 le)
                (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat n)))))
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cur (BinNums.Zpos (BinNums.xO BinNums.xH))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m
               (Clight.Sswitch (@fst Clight.expr Clight.labeled_statements elements_null_data_push_switch)
                  (@snd Clight.expr Clight.labeled_statements elements_null_data_push_switch)) Events.E0 le mf
               ClightBigstep.Out_normal)
            (jet_elements_effects.write_effect m mf bd dbase bw edge cur (BinNums.Zpos (BinNums.xO BinNums.xH))
               (@Translate.encode (Word.Word (S O)) (@Word.ToZ.Theory.fromZ (Word.WordToZ (S O)) (BinInt.Z.of_nat n)))))
### C.jet_elements_null_data_cases.elements_nibble_cells
elements_nibble_cells
     : forall (n : nat) (_ : lt n (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))),
       @eq (list (option bool)) (@List.map bool (option bool) (@Some bool) (elements_nibble_bits n))
