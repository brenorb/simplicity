### C.jet_secp_modinv_fg_owned.eval_fg_transition_owned
eval_fg_transition_owned
     : forall (len : nat) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem) (_ : and (lt O len) (le len (S (S (S (S (S O)))))))
         (_ : @eq Integers.Int.int
                (Integers.Int64.loword (rho (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))
                (Integers.Int.repr (BinInt.Z.of_nat len))) (_ : jet_secp_modinv_fg_start.fg_input_bounds rho)
         (_ : jet_sx_state.rep rho beta fg_owned_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_update_fg_62_var)
               (@cons Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat len)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@cons Values.val
                           (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                              (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O))))) (@nil Values.val))))) Events.E0
               mf Values.Vundef)
            (and
               (forall (high : bool) (j : nat) (_ : lt j len),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf
                     (jet_sx_state.blk beta match high return nat with
                                            | true => S O
                                            | false => O
                                            end)
                     (BinInt.Z.add (jet_sx_state.bas beta match high return nat with
                                                          | true => S O
                                                          | false => O
                                                          end)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat j))))
                  (@Some Values.val (Values.Vlong (jet_secp_modinv_fg_body.fg_body_word len rho high j))))
               (and
                  (forall high : bool,
                   @eq BinNums.Z (jet_secp_modinv_fg_body.fg_body_value len rho high)
                     (BinInt.Z.div (jet_secp_modinv_fg_body.fg_matrix_value rho high len)
                        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                  (and (jet_sx_state.rep (jet_secp_modinv_fg_body.fg_body_rho len rho) beta (fg_owned_out len) mf)
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot beta
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape jet_secp_modinv_fg_prefix.fg_regs) b ofs)) m mf)))))
### C.jet_secp_modinv_fg_owned.fg_matrix_cells
fg_matrix_cells =
jet_sx_rep.u64_cells BinNums.Z0
  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S (S O)))))))))))
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))
              (@nil jet_sx_expr.sx)))))
     : list jet_sx_state.cell
### C.jet_secp_modinv_fg_owned.fg_matrix_region
fg_matrix_region =
fun owned : bool =>
jet_sx_state.mkreg fg_matrix_cells owned
  match owned return (option BinNums.Z) with
  | true => @Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
  | false => @None BinNums.Z
  end
     : forall _ : bool, jet_sx_state.region

Arguments fg_matrix_region owned%bool_scope
### C.jet_secp_modinv_fg_owned.fg_region_default
fg_region_default = jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z)
     : jet_sx_state.region
### C.jet_secp_modinv_fg_owned.fg_owned_regs
fg_owned_regs =
@cons jet_sx_state.region (@List.nth jet_sx_state.region O jet_secp_modinv_fg_prefix.fg_regs fg_region_default)
  (@cons jet_sx_state.region (@List.nth jet_sx_state.region (S O) jet_secp_modinv_fg_prefix.fg_regs fg_region_default)
     (@cons jet_sx_state.region (fg_matrix_region true) (@nil jet_sx_state.region)))
     : list jet_sx_state.region
### C.jet_secp_modinv_fg_owned.fg_result_array
fg_result_array =
fun (len : nat) (high : bool) =>
@List.nth jet_sx_state.region match high return nat with
                              | true => S O
                              | false => O
                              end (jet_secp_modinv_fg_call.fg_call_out len) fg_region_default
     : forall (_ : nat) (_ : bool), jet_sx_state.region

Arguments fg_result_array len%nat_scope high%bool_scope
### C.jet_secp_modinv_fg_owned.fg_owned_out
fg_owned_out =
fun len : nat =>
@cons jet_sx_state.region (fg_result_array len false)
  (@cons jet_sx_state.region (fg_result_array len true)
     (@cons jet_sx_state.region (fg_matrix_region true) (@nil jet_sx_state.region)))
     : forall _ : nat, list jet_sx_state.region

Arguments fg_owned_out len%nat_scope
### C.jet_secp_modinv_fg_owned.fg_three_distinct
fg_three_distinct =
fun beta : jet_sx_state.layout =>
forall (i j : nat) (_ : lt i (S (S (S O)))) (_ : lt j (S (S (S O)))) (_ : not (@eq nat i j)),
not (@eq Values.block (jet_sx_state.blk beta i) (jet_sx_state.blk beta j))
     : forall _ : jet_sx_state.layout, Prop

Arguments fg_three_distinct beta
