         (_ : jet_sx_state.rsep beta
                (@cons jet_sx_state.region a
                   (@cons jet_sx_state.region b (@cons jet_sx_state.region c (@nil jet_sx_state.region)))))
         (_ : jet_sx_state.region_ok rho beta m O a) (_ : jet_sx_state.region_ok rho beta m (S O) b)
         (_ : jet_sx_state.region_ok rho beta m (S (S O)) c),
       jet_sx_state.rep rho beta
