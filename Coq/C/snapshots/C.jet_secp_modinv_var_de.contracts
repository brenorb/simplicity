### C.jet_secp_modinv_var_de.inv_matrix_address
inv_matrix_address =
Clight.Eaddrof (Clight.Evar jets_secp._t inv_matrix_type) (Ctypesdefs.tptr inv_matrix_type)
     : Clight.expr
### C.jet_secp_modinv_var_de.inv_metadata_type
inv_metadata_type = Ctypes.Tstruct jets_secp._secp256k1_modinv64_modinfo Ctypes.noattr
     : Ctypes.type
### C.jet_secp_modinv_var_de.inv_metadata_arg
inv_metadata_arg = Clight.Etempvar jets_secp._modinfo (Ctypesdefs.tptr inv_metadata_type)
     : Clight.expr
### C.jet_secp_modinv_var_de.inv_de_next_rho
inv_de_next_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (n : nat) =>
match
  andb (PeanoNat.Nat.leb (S (S (S (S (S O))))) n)
    (PeanoNat.Nat.ltb n (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))) return Integers.Int64.int
with
| true => jet_secp_modinv_de_revalue.de62_next_rho (inv_de_rho rho) (Nat.sub n (S (S (S (S (S O))))))
| false => rho n
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments inv_de_next_rho rho%function_scope n%nat_scope
