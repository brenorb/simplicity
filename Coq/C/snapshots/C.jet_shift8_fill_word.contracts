### C.jet_shift8_fill_word.complement_spec_involutive
complement_spec_involutive
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (Word.Word n))
         (@jet_complement_spec.complement_spec n Alg.CoreFunSem
            (@jet_complement_spec.complement_spec n Alg.CoreFunSem x)) x
### C.jet_shift8_fill_word.low_byte_mask_bit
low_byte_mask_bit
     : forall (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))),
       @eq bool
         (Integers.Int.testbit
            (Integers.Int.repr
               (BinNums.Zpos
                  (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
            j) true
### C.jet_shift8_fill_word.shift8_fill_result_bits
shift8_fill_result_bits
     : forall (r : Integers.Int.int) (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))),
       @eq bool (Integers.Int.testbit (jet_shift8_expr.shift8_fill_result r) j) (negb (Integers.Int.testbit r j))
### C.jet_shift8_fill_word.shift8_fill_result_repr
shift8_fill_result_repr
     : forall (x : Ty.tySem (Word.Word (S (S (S O))))) (r : Integers.Int.int)
         (_ : @eq BinNums.Z (Integers.Int.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x)),
       @eq Integers.Int.int (jet_shift8_expr.shift8_fill_result r)
         (Integers.Int.repr
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O))))
               (@jet_complement_spec.complement_spec (S (S (S O))) Alg.CoreFunSem x)))
### C.jet_shift8_fill_word.shift8_fill_result_unsigned
shift8_fill_result_unsigned
     : forall (x : Ty.tySem (Word.Word (S (S (S O))))) (r : Integers.Int.int)
         (_ : @eq BinNums.Z (Integers.Int.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x)),
       @eq BinNums.Z (Integers.Int.unsigned (jet_shift8_expr.shift8_fill_result r))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O))))
            (@jet_complement_spec.complement_spec (S (S (S O))) Alg.CoreFunSem x))
