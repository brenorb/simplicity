                                            | true =>
                                                Integers.Int64.mkint (BinNums.Zpos BinNums.xH)
                                                  (Integers.Int64.Z_mod_modulus_range' (BinNums.Zpos BinNums.xH))
                                            | false =>
                                                Integers.Int64.mkint BinNums.Z0
                                                  (Integers.Int64.Z_mod_modulus_range' BinNums.Z0)
                                            end)))) (jet_sx_expr.XLv (S (S O))))
                             (jet_sx_expr.XLc
                                match
                                  match flag return bool with
                                  | true => false
                                  | false => false
                                  end return Integers.Int64.int
                                with
                                | true =>
                                    Integers.Int64.mkint (BinNums.Zpos BinNums.xH)
                                      (Integers.Int64.Z_mod_modulus_range' (BinNums.Zpos BinNums.xH))
                                | false =>
                                    Integers.Int64.mkint BinNums.Z0 (Integers.Int64.Z_mod_modulus_range' BinNums.Z0)
                                end))
                          (jet_sx_expr.XLc
                             match
                               match flag return bool with
                               | true => false
                               | false => false
                               end return Integers.Int64.int
                             with
                             | true =>
                                 Integers.Int64.mkint (BinNums.Zpos BinNums.xH)
                                   (Integers.Int64.Z_mod_modulus_range' (BinNums.Zpos BinNums.xH))
                             | false =>
                                 Integers.Int64.mkint BinNums.Z0 (Integers.Int64.Z_mod_modulus_range' BinNums.Z0)
                             end)))) (jet_sx_expr.XLv (S (S (S O)))))
              (jet_sx_expr.XLc
                 match match flag return bool with
                       | true => false
                       | false => false
                       end return Integers.Int64.int with
                 | true =>
                     Integers.Int64.mkint (BinNums.Zpos BinNums.xH)
                       (Integers.Int64.Z_mod_modulus_range' (BinNums.Zpos BinNums.xH))
                 | false => Integers.Int64.mkint BinNums.Z0 (Integers.Int64.Z_mod_modulus_range' BinNums.Z0)
                 end)) (@nil jet_sx_expr.sx))))
     : forall _ : bool, list jet_sx_expr.sx

Arguments cadd_output_sx flag%bool_scope
### C.jet_secp_scalar_cadd_function.cadd_output_regs
cadd_output_regs =
fun flag : bool =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (cadd_output_sx flag)) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
  (@nil jet_sx_state.region)
     : forall _ : bool, list jet_sx_state.region

Arguments cadd_output_regs flag%bool_scope
### C.jet_secp_scalar_cadd_function.cadd_output_words
cadd_output_words =
fun (rho : forall _ : nat, Integers.Int64.int) (flag : bool) =>
@List.map jet_sx_expr.sx Integers.Int64.int (jet_sx_exec.lv rho) (cadd_output_sx flag)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool), list Integers.Int64.int

Arguments cadd_output_words rho%function_scope flag%bool_scope
