### C.jet_rotate16_word.rotate16_machine_denotes
rotate16_machine_denotes
     : forall (right : bool) (amount : Ty.tySem (Word.Word (S (S O))))
         (x : Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16))),
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
