### C.jet_secp_xonly_tweak_function.affine_storage_table_literal
affine_storage_table_literal
     : forall (w : forall _ : nat, Integers.Int64.int) (k : bool)
         (a : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
         (_ : @eq BinNums.Z
                (jet_secp_storage_numeric.field_storage_value
                   (fun i : nat => w (Nat.add match k return nat with
                                              | true => S (S (S (S O)))
                                              | false => O
                                              end i)))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)),
       jet_secp_odd_table_literal_walk.table_word_literal (jet_secp_affine_storage.affine_storage_coord w k) a
### C.jet_secp_xonly_tweak_function.tweak_bytes_result_option
tweak_bytes_result_option
     : forall ng ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool (jet_secp_tweak_bytes_function.tweak_bytes_result ng ax ay)
         match jet_secp_tweak_bytes_function.tweak_bytes_value ng ax ay return bool with
         | Some _ => true
         | None => false
         end
### C.jet_secp_xonly_tweak_function.eval_xonly_pubkey_tweak_add
eval_xonly_pubkey_tweak_add
