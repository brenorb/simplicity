### C.jet_word_endpoint_constants.last_word_frame_constructible
last_word_frame_constructible
     : forall seed : Integers.Int64.int,
       @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          @ex Values.block
            (fun b : Values.block =>
             and
               (jet_output_layout.write_frame_at m b BinNums.Z0 b last_word_address
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m b last_word_address)
                  (@Some Values.val (Values.Vlong seed)))))
### C.jet_word_endpoint_constants.constants_run_at_last_word
constants_run_at_last_word
     : forall (s : jet_constant.constant_size) (high : bool) (seed : Integers.Int64.int) (env : Values.val),
       @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex Values.block
               (fun b : Values.block =>
                and
                  (jet_output_layout.write_frame_at m b BinNums.Z0 b last_word_address
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (jet_constant.constant_bits s))
                  (and
                     (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m b last_word_address)
                        (@Some Values.val (Values.Vlong seed)))
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                           (@Ctypes.Internal Clight.function (jet_constant.constant_jet s high))
                           (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                                 (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
                        (and
                           (jet_encoding.frame_output_cells_at mf b last_word_address
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              (@Translate.encode (Word.Word (jet_constant.constant_log s))
                                 (@jet_constant.constant_spec s high Alg.CoreFunSem tt)))
                           (and
                              (jet_output_layout.write_prefix_at m mf b last_word_address
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              (and
                                 (jet_frame_layout.frame_fields_at mf b BinNums.Z0 b last_word_address
                                    (BinInt.Z.sub
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                       (jet_constant.constant_bits s)))
                                 (forall (chunk : AST.memory_chunk) (b' : Values.block) (ofs : BinNums.Z)
                                    (_ : Memory.Mem.valid_block m b')
                                    (_ : or (not (@eq Values.block b' b))
                                           (or
                                              (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                              (BinInt.Z.le
                                                 (BinNums.Zpos
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs)))
                                    (_ : or (not (@eq Values.block b' b))
                                           (or
                                              (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                 last_word_address)
                                              (BinInt.Z.le
                                                 (BinInt.Z.add last_word_address
                                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                                 ofs))),
                                  @eq (option Values.val) (Memory.Mem.load chunk mf b' ofs)
                                    (Memory.Mem.load chunk m b' ofs))))))))))
### C.jet_word_endpoint_constants.last_word_address
last_word_address =
BinInt.Z.sub Integers.Ptrofs.max_unsigned (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))
     : BinNums.Z
