         (le1 : Clight.temp_env) (m1 : Memory.Mem.mem) (le2 : Clight.temp_env) (m2 : Memory.Mem.mem)
         (out : ClightBigstep.outcome)
         (_ : ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m a Events.E0 le1 m1
