### C.jet_secp_wnaf_digit.exec_wnaf_window_digit
exec_wnaf_window_digit
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (n bit width w carry : BinNums.Z)
         (b : Values.block) (base sign : BinNums.Z) (bs : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.lt n
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 bit)
                (BinInt.Z.lt bit
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) width) (BinInt.Z.le width w))
         (_ : and (BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) w)
                (BinInt.Z.le w (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
         (_ : BinInt.Z.le (BinInt.Z.add bit width)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : or (@eq BinNums.Z carry BinNums.Z0) (@eq BinNums.Z carry (BinNums.Zpos BinNums.xH)))
         (_ : not
                (@eq BinNums.Z
                   (BinInt.Z.modulo (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit))
                      (BinNums.Zpos (BinNums.xO BinNums.xH))) carry))
         (_ : or (@eq BinNums.Z sign (BinNums.Zpos BinNums.xH)) (@eq BinNums.Z sign (BinNums.Zneg BinNums.xH)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._now le)
                (@Some Values.val (Values.Vint (Integers.Int.repr width))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._carry le)
                (@Some Values.val (Values.Vint (Integers.Int.repr carry))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._w le)
                (@Some Values.val (Values.Vint (Integers.Int.repr w))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._wnaf le)
                (@Some Values.val (Values.Vptr b (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._bit le)
                (@Some Values.val (Values.Vint (Integers.Int.repr bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._sign le)
                (@Some Values.val (Values.Vint (Integers.Int.repr sign))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bs BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n))) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) bit))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.valid_access m AST.Mint32 b
                (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) bit))
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (wnaf_env bs) le m wnaf_window_digit Events.E0
               (wnaf_digit_final
                  (@Maps.PTree.set Values.val jets_secp._t'3
                     (Values.Vint
                        (Integers.Int.repr
                           (BinInt.Z.modulo (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit))
                              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) width)))) le)
                  (wnaf_word n bit width carry) w) mf ClightBigstep.Out_normal)
            (and
               (@eq (option Memory.Mem.mem)
                  (Memory.Mem.store AST.Mint32 m b
                     (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) bit))
                     (Values.Vint (Integers.Int.repr (BinInt.Z.mul sign (wnaf_digit (wnaf_word n bit width carry) w)))))
                  (@Some Memory.Mem.mem mf))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint32 mf b
                        (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) bit)))
                     (@Some Values.val
                        (Values.Vint
                           (Integers.Int.repr (BinInt.Z.mul sign (wnaf_digit (wnaf_word n bit width carry) w))))))
                  (and
                     (or (@eq BinNums.Z (wnaf_carry (wnaf_word n bit width carry) w) BinNums.Z0)
                        (@eq BinNums.Z (wnaf_carry (wnaf_word n bit width carry) w) (BinNums.Zpos BinNums.xH)))
                     (and
                        (and
                           (BinInt.Z.lt
                              (BinInt.Z.opp
                                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                    (BinInt.Z.sub w (BinNums.Zpos BinNums.xH))))
                              (wnaf_digit (wnaf_word n bit width carry) w))
                           (BinInt.Z.lt (wnaf_digit (wnaf_word n bit width carry) w)
                              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                 (BinInt.Z.sub w (BinNums.Zpos BinNums.xH)))))
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo (wnaf_digit (wnaf_word n bit width carry) w)
                                 (BinNums.Zpos (BinNums.xO BinNums.xH))) (BinNums.Zpos BinNums.xH))
                           (@eq BinNums.Z
                              (BinInt.Z.add (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit))
                                 carry)
                              (BinInt.Z.add (wnaf_digit (wnaf_word n bit width carry) w)
                                 (BinInt.Z.mul (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) width)
                                    (BinInt.Z.add
                                       (BinInt.Z.div n
                                          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.add bit width)))
                                       (wnaf_carry (wnaf_word n bit width carry) w)))))))))))
### C.jet_secp_wnaf_digit.wnaf_word
wnaf_word =
fun n bit width carry : BinNums.Z =>
BinInt.Z.add
  (BinInt.Z.modulo (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit))
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) width)) carry
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments wnaf_word (n bit width carry)%Z_scope
### C.jet_secp_wnaf_digit.wnaf_carry
wnaf_carry =
fun word w : BinNums.Z =>
BinInt.Z.div word (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.sub w (BinNums.Zpos BinNums.xH)))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments wnaf_carry (word w)%Z_scope
### C.jet_secp_wnaf_digit.wnaf_digit
wnaf_digit =
fun word w : BinNums.Z =>
BinInt.Z.sub word (BinInt.Z.mul (wnaf_carry word w) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) w))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments wnaf_digit (word w)%Z_scope
