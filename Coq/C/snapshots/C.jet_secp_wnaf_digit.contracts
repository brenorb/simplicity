### C.jet_secp_wnaf_digit.wnaf_loop
wnaf_loop =
@List.nth Clight.statement (S (S (S (S (S (S (S (S (S (S (S O))))))))))) wnaf_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_wnaf_digit.wnaf_loop_body
wnaf_loop_body =
match wnaf_loop return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop s s0 =>
    match s return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ body =>
        match s0 return Clight.statement with
        | Clight.Sskip => body
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ _ => Clight.Sskip
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_wnaf_digit.wnaf_loop_statements
wnaf_loop_statements =
@fst (list Clight.statement) Clight.statement (jet_secp_statement_prefix.split_statement_last wnaf_loop_body)
     : list Clight.statement
### C.jet_secp_wnaf_digit.wnaf_word_add
wnaf_word_add =
match @List.nth Clight.statement (S (S (S O))) wnaf_loop_statements Clight.Sskip return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ add => add
| Clight.Sifthenelse _ _ _ => Clight.Sskip
