         (_ : or (@eq BinNums.Z carry BinNums.Z0) (@eq BinNums.Z carry (BinNums.Zpos BinNums.xH)))
         (_ : not
                (@eq BinNums.Z
                   (BinInt.Z.modulo (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit))
                      (BinNums.Zpos (BinNums.xO BinNums.xH))) carry)),
