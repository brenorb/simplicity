       ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_sigma1)
         (@cons Values.val (Values.Vint x) (@nil Values.val)) Events.E0 m (Values.Vint (c_sigma1 x))
### C.jet_sha_linkage.c_Ch_correct
c_Ch_correct
     : forall x y z : Integers.Int.int, @eq Integers.Int.int (c_Ch x y z) (SHA256.Ch x y z)
### C.jet_sha_linkage.c_Maj_correct
c_Maj_correct
     : forall x y z : Integers.Int.int, @eq Integers.Int.int (c_Maj x y z) (SHA256.Maj x y z)
### C.jet_sha_linkage.c_rot_correct
c_rot_correct
     : forall (r : BinNums.Z) (x : Integers.Int.int)
         (_ : and (BinInt.Z.lt BinNums.Z0 r)
                (BinInt.Z.lt r
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq Integers.Int.int (c_rot r x) (SHA256.Rotr r x)
### C.jet_sha_linkage.c_Sigma0_correct
c_Sigma0_correct
     : forall x : Integers.Int.int, @eq Integers.Int.int (c_Sigma0 x) (SHA256.Sigma_0 x)
### C.jet_sha_linkage.c_Sigma1_correct
c_Sigma1_correct
     : forall x : Integers.Int.int, @eq Integers.Int.int (c_Sigma1 x) (SHA256.Sigma_1 x)
### C.jet_sha_linkage.c_sigma0_correct
c_sigma0_correct
     : forall x : Integers.Int.int, @eq Integers.Int.int (c_sigma0 x) (SHA256.sigma_0 x)
### C.jet_sha_linkage.c_sigma1_correct
c_sigma1_correct
     : forall x : Integers.Int.int, @eq Integers.Int.int (c_sigma1 x) (SHA256.sigma_1 x)
### C.jet_sha_linkage.sha_ge
sha_ge = Clight.globalenv jets_sha.prog
     : Clight.genv
### C.jet_sha_linkage.sha_symbol_block
sha_symbol_block =
fun id : AST.ident =>
match @Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv sha_ge) id return Values.block with
| Some b => b
| None => BinNums.xH
end
     : forall _ : AST.ident, Values.block

Arguments sha_symbol_block id
### C.jet_sha_linkage.c_Ch
c_Ch =
fun x y z : Integers.Int.int => Integers.Int.xor z (Integers.Int.and x (Integers.Int.xor y z))
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments c_Ch x y z
### C.jet_sha_linkage.c_Maj
c_Maj =
fun x y z : Integers.Int.int => Integers.Int.or (Integers.Int.and x y) (Integers.Int.and z (Integers.Int.or x y))
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments c_Maj x y z
### C.jet_sha_linkage.c_rot
c_rot =
fun (r : BinNums.Z) (x : Integers.Int.int) =>
Integers.Int.or (Integers.Int.shru x (Integers.Int.repr r))
  (Integers.Int.shl (Integers.Int.mul (Integers.Int.repr (BinNums.Zpos BinNums.xH)) x)
     (Integers.Int.repr
        (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) r)))
     : forall (_ : BinNums.Z) (_ : Integers.Int.int), Integers.Int.int

Arguments c_rot r%Z_scope x
### C.jet_sha_linkage.c_Sigma0
c_Sigma0 =
fun x : Integers.Int.int =>
Integers.Int.xor
  (Integers.Int.xor (c_rot (BinNums.Zpos (BinNums.xO BinNums.xH)) x)
     (c_rot (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))) x))
  (c_rot (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))) x)
     : forall _ : Integers.Int.int, Integers.Int.int

Arguments c_Sigma0 x
### C.jet_sha_linkage.c_Sigma1
c_Sigma1 =
fun x : Integers.Int.int =>
Integers.Int.xor
  (Integers.Int.xor (c_rot (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))) x)
     (c_rot (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))) x))
  (c_rot (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) x)
     : forall _ : Integers.Int.int, Integers.Int.int

Arguments c_Sigma1 x
### C.jet_sha_linkage.c_sigma0
c_sigma0 =
fun x : Integers.Int.int =>
Integers.Int.xor
  (Integers.Int.xor (c_rot (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))) x)
     (c_rot (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))) x))
  (Integers.Int.shru x (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))))
     : forall _ : Integers.Int.int, Integers.Int.int

Arguments c_sigma0 x
### C.jet_sha_linkage.c_sigma1
c_sigma1 =
fun x : Integers.Int.int =>
Integers.Int.xor
  (Integers.Int.xor (c_rot (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) x)
     (c_rot (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))) x))
  (Integers.Int.shru x (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
     : forall _ : Integers.Int.int, Integers.Int.int

Arguments c_sigma1 x
