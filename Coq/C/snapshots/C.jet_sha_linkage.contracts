     : forall (m : Memory.Mem.mem) (x : Integers.Int.int),
       ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_Sigma0)
         (@cons Values.val (Values.Vint x) (@nil Values.val)) Events.E0 m (Values.Vint (c_Sigma0 x))
