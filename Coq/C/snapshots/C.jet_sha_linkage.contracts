### C.jet_sha_linkage.sha_Ch_symbol
sha_Ch_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv sha_ge) jets_sha._Ch)
         (@Some Values.block (sha_symbol_block jets_sha._Ch))
### C.jet_sha_linkage.sha_Ch_funct
sha_Ch_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv sha_ge)
            (Values.Vptr (sha_symbol_block jets_sha._Ch) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_sha.f_Ch))
