### C.jet_sha_linkage.eval_sha_Ch
eval_sha_Ch
     : forall (m : Memory.Mem.mem) (x y z : Integers.Int.int),
       ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_Ch)
         (@cons Values.val (Values.Vint x)
            (@cons Values.val (Values.Vint y) (@cons Values.val (Values.Vint z) (@nil Values.val)))) Events.E0 m
         (Values.Vint (c_Ch x y z))
### C.jet_sha_linkage.eval_sha_Maj
eval_sha_Maj
     : forall (m : Memory.Mem.mem) (x y z : Integers.Int.int),
       ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_Maj)
         (@cons Values.val (Values.Vint x)
            (@cons Values.val (Values.Vint y) (@cons Values.val (Values.Vint z) (@nil Values.val)))) Events.E0 m
         (Values.Vint (c_Maj x y z))
