match high return AST.ident with
| true => jets_secp._secp256k1_pre_g_128
| false => jets_secp._secp256k1_pre_g
end
     : forall _ : bool, AST.ident

Arguments generator_table_id high%bool_scope
### C.jet_secp_generator_globals.generator_table_global
generator_table_global =
fun high : bool =>
match high return (AST.globvar Ctypes.type) with
| true => jets_secp.v_secp256k1_pre_g_128
| false => jets_secp.v_secp256k1_pre_g
end
     : forall _ : bool, AST.globvar Ctypes.type

Arguments generator_table_global high%bool_scope
### C.jet_secp_generator_globals.generator_table_init
generator_table_init =
fun high : bool => @AST.gvar_init Ctypes.type (generator_table_global high)
     : forall _ : bool, list AST.init_data

Arguments generator_table_init high%bool_scope
### C.jet_secp_generator_globals.generator_table_block
