### C.jet_secp_generator_globals.eval_generator_table_lookup
eval_generator_table_lookup
     : forall (high : bool) (n : BinNums.Z) (m : Memory.Mem.mem) (bout : Values.block)
         (_ : and (BinInt.Z.lt BinNums.Z0 (BinInt.Z.abs n))
                (BinInt.Z.lt (BinInt.Z.abs n)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))))
         (_ : generator_table_state high m)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult_table_get_ge_storage)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr (generator_table_block high) Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vint (Integers.Int.repr n))
                        (@cons Values.val
                           (Values.Vint
                              (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                           (@nil Values.val))))) Events.E0 mf Values.Vundef)
            (and
               (Memory.Mem.range_perm mf bout BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (forall k : bool,
                   jet_secp_fe_nv.fe_at mf bout
                     match k return BinNums.Z with
                     | true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                     | false => BinNums.Z0
                     end
                     (jet_secp_table_decode.table_signed_coordinate
                        (generator_entry_words high (BinInt.Z.to_nat (jet_secp_table_index.table_storage_index n)))
                        (negb (BinInt.Z.ltb BinNums.Z0 n)) k))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bout
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and (generator_table_state high mf)
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (pos : BinNums.Z) =>
                            or (not (@eq Values.block b bout))
                              (or (BinInt.Z.lt pos BinNums.Z0)
                                 (BinInt.Z.le
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    pos))) m mf))))))
### C.jet_secp_generator_globals.generator_table_state_unchanged
generator_table_state_unchanged
     : forall (high : bool) (m mf : Memory.Mem.mem)
         (_ : Memory.Mem.unchanged_on
                (fun (b : Values.block) (_ : BinNums.Z) => @eq Values.block b (generator_table_block high)) m mf)
         (_ : generator_table_state high m), generator_table_state high mf
### C.jet_secp_generator_globals.generator_table_state_alloc
generator_table_state_alloc
     : forall (high : bool) (m : Memory.Mem.mem) (lo hi : BinNums.Z) (mf : Memory.Mem.mem')
         (fresh : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m lo hi)
                (@pair Memory.Mem.mem' Values.block mf fresh)) (_ : generator_table_state high m),
       generator_table_state high mf
### C.jet_secp_generator_globals.generator_tables_initialized_memory_exists
generator_tables_initialized_memory_exists
     : @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                  (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m))
            (and (generator_table_state false m) (generator_table_state true m)))
### C.jet_secp_generator_globals.generator_table_lookup_fresh
generator_table_lookup_fresh
     : forall (high : bool) (n : BinNums.Z)
         (_ : and (BinInt.Z.lt BinNums.Z0 (BinInt.Z.abs n))
                (BinInt.Z.lt (BinInt.Z.abs n)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))))),
       @ex Memory.Mem.mem
         (fun m0 : Memory.Mem.mem =>
          @ex Memory.Mem.mem'
            (fun m : Memory.Mem.mem' =>
             @ex Values.block
               (fun bout : Values.block =>
                @ex Memory.Mem.mem
                  (fun mf : Memory.Mem.mem =>
                   and
                     (@eq (option Memory.Mem.mem)
                        (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                           (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m0))
                     (and
                        (@eq (prod Memory.Mem.mem' Values.block)
                           (Memory.Mem.alloc m0 BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@pair Memory.Mem.mem' Values.block m bout))
                        (and
                           (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                              (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult_table_get_ge_storage)
                              (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vptr (generator_table_block high) Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vint (Integers.Int.repr n))
                                       (@cons Values.val
                                          (Values.Vint
                                             (Integers.Int.repr
                                                (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                                          (@nil Values.val))))) Events.E0 mf Values.Vundef)
                           (and
                              (Memory.Mem.range_perm mf bout BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (forall k : bool,
                                  jet_secp_fe_nv.fe_at mf bout
                                    match k return BinNums.Z with
                                    | true =>
                                        BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                                    | false => BinNums.Z0
                                    end
                                    (jet_secp_table_decode.table_signed_coordinate
                                       (generator_entry_words high
                                          (BinInt.Z.to_nat (jet_secp_table_index.table_storage_index n)))
                                       (negb (BinInt.Z.ltb BinNums.Z0 n)) k))
                                 (and
                                    (@eq (option Values.val)
                                       (Memory.Mem.load AST.Mint32 mf bout
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                       (@Some Values.val (Values.Vint Integers.Int.zero)))
                                    (and (generator_table_state high mf)
                                       (jet_sx_mem.lframe
                                          (fun (b : Values.block) (pos : BinNums.Z) =>
                                           or (not (@eq Values.block b bout))
                                             (or (BinInt.Z.lt pos BinNums.Z0)
                                                (BinInt.Z.le
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI ...)))))) pos)))
                                          m mf)))))))))))
### C.jet_secp_generator_globals.init_is64
init_is64 =
fun d : AST.init_data =>
match d return bool with
| AST.Init_int8 _ => false
| AST.Init_int16 _ => false
| AST.Init_int32 _ => false
| AST.Init_int64 _ => true
| AST.Init_float32 _ => false
| AST.Init_float64 _ => false
| AST.Init_space _ => false
| AST.Init_addrof _ _ => false
end
     : forall _ : AST.init_data, bool

Arguments init_is64 d
### C.jet_secp_generator_globals.init_word64
init_word64 =
fun d : AST.init_data =>
match d return Integers.Int64.int with
| AST.Init_int8 _ => Integers.Int64.zero
| AST.Init_int16 _ => Integers.Int64.zero
| AST.Init_int32 _ => Integers.Int64.zero
| AST.Init_int64 x => x
| AST.Init_float32 _ => Integers.Int64.zero
| AST.Init_float64 _ => Integers.Int64.zero
| AST.Init_space _ => Integers.Int64.zero
| AST.Init_addrof _ _ => Integers.Int64.zero
end
     : forall _ : AST.init_data, Integers.Int64.int

Arguments init_word64 d
### C.jet_secp_generator_globals.generator_table_id
generator_table_id =
