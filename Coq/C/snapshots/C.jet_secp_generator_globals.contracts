               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))
         (@Some Values.val
            (Values.Vlong (init_word64 (@List.nth AST.init_data i ds (AST.Init_int64 Integers.Int64.zero)))))
