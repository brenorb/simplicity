Arguments generator_table_block high%bool_scope
### C.jet_secp_generator_globals.generator_table_word
generator_table_word =
fun (high : bool) (i : nat) =>
init_word64 (@List.nth AST.init_data i (generator_table_init high) (AST.Init_int64 Integers.Int64.zero))
     : forall (_ : bool) (_ : nat), Integers.Int64.int

Arguments generator_table_word high%bool_scope i%nat_scope
### C.jet_secp_generator_globals.generator_entry_words
generator_entry_words =
fun (high : bool) (index i : nat) =>
generator_table_word high (Nat.add (Nat.mul (S (S (S (S (S (S (S (S O)))))))) index) i)
     : forall (_ : bool) (_ : nat) (_ : nat), Integers.Int64.int

Arguments generator_entry_words high%bool_scope (index i)%nat_scope
### C.jet_secp_generator_globals.generator_table_rep
generator_table_rep =
fun (high : bool) (m : Memory.Mem.mem) =>
and (Memory.Mem.valid_block m (generator_table_block high))
  (and
     (Memory.Mem.range_perm m (generator_table_block high) BinNums.Z0
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))))))))
        Memtype.Cur Memtype.Readable)
     (forall (i : nat)
        (_ : BinInt.Z.lt (BinInt.Z.of_nat i)
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))))),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m (generator_table_block high)
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong (generator_table_word high i)))))
     : forall (_ : bool) (_ : Memory.Mem.mem), Prop

Arguments generator_table_rep high%bool_scope m
### C.jet_secp_generator_globals.generator_table_state
generator_table_state =
fun (high : bool) (m : Memory.Mem.mem) =>
and (generator_table_rep high m)
  (jet_clight_readonly_frame.readonly_region_bounds m (generator_table_block high) BinNums.Z0
     (BinNums.Zpos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))))))))
     : forall (_ : bool) (_ : Memory.Mem.mem), Prop

Arguments generator_table_state high%bool_scope m
