### C.jet_secp_generator_globals.init64_array_loads
@init64_array_loads
     : forall (F V : Type) (ge : Globalenvs.Genv.t F V) (ds : list AST.init_data) (m : Memory.Mem.mem)
         (b : Values.block) (base : BinNums.Z) (_ : @eq bool (@List.forallb AST.init_data init_is64 ds) true)
         (_ : @Globalenvs.Genv.load_store_init_data F V ge m b base ds) (i : nat) (_ : lt i (@length AST.init_data ds)),
       @eq (option Values.val)
