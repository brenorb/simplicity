### C.jet_elements_taptweak_xonly_tweak_entry.elements_taptweak_xonly_tweak_vars_checked
elements_taptweak_xonly_tweak_vars_checked
     : @eq bool
         (jet_transport.vars_okb jet_secp_linkage.secp_ge jet_elements_taptweak_pure.elements_taptweak_ge
            (Clight.fn_vars jets_secp.f_secp256k1_xonly_pubkey_tweak_add)) true
### C.jet_elements_taptweak_xonly_tweak_entry.elements_taptweak_xonly_tweak_entry
elements_taptweak_xonly_tweak_entry
     : forall (m : Memory.Mem.mem) (output input bytes : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bk : Values.block =>
             and
               (Clight.function_entry2 jet_elements_taptweak_pure.elements_taptweak_ge
                  jets_secp.f_secp256k1_xonly_pubkey_tweak_add
                  (@cons Values.val output (@cons Values.val input (@cons Values.val bytes (@nil Values.val)))) m
                  (jet_secp_xonly_tweak_entry.xonly_tweak_env bk)
                  (jet_secp_xonly_tweak_entry.xonly_tweak_temps output input bytes) mi)
               (and (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), not (@eq Values.block b bk))
                  (and
                     (Memory.Mem.range_perm mi bk BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                        (and (jet_clight_internal_permissions.keeps_permissions m mi)
                           (jet_clight_internal_preserve.readonly_preserved m mi)))))))
