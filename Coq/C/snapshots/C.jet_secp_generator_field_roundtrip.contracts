### C.jet_secp_generator_field_roundtrip.generator_field_pair_bounds
generator_field_pair_bounds
     : forall (x y : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds y) (i : nat)
         (_ : lt i (S (S (S (S (S (S (S (S (S (S O))))))))))),
       BinInt.Z.le (Integers.Int64.unsigned (jet_secp_field_pair_multiply.field_pair_valuation x y i))
         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
### C.jet_secp_generator_field_roundtrip.generator_field_pair_values
generator_field_pair_values
     : forall (x y : forall _ : nat, Integers.Int64.int) (second : bool),
       @eq BinNums.Z
         (jet_secp_generator_save_values.generator_save_value (jet_secp_field_pair_multiply.field_pair_valuation x y)
            match second return nat with
            | true => S (S (S (S (S O))))
            | false => O
            end)
         (BinInt.Z.modulo
            (jet_secp_multiply_finish_product.radix_value
               match second return (forall _ : nat, Integers.Int64.int) with
               | true => y
               | false => x
               end) jet_secp_multiply_checkpoint_columns.field_prime)
### C.jet_secp_generator_field_roundtrip.generator_field_pair_output
generator_field_pair_output
     : forall x y : forall _ : nat, Integers.Int64.int,
       @eq
         (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (jet_secp_generator_load_write.generator_loaded_output
            (jet_secp_generator_codec.generator_saved_bytes (jet_secp_field_pair_multiply.field_pair_valuation x y) O)
            (jet_secp_generator_codec.generator_saved_bytes (jet_secp_field_pair_multiply.field_pair_valuation x y)
               (S (S (S (S (S O)))))))
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (jet_secp_rescale_literal.rescale_field_output x)
            (jet_secp_rescale_literal.rescale_field_output y))
### C.jet_secp_generator_field_roundtrip.eval_generator_field_roundtrip
eval_generator_field_roundtrip
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (x y : forall _ : nat, Integers.Int64.int)
         (flag : Integers.Int.int) (m : Memory.Mem.mem) (br bg : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N) (_ : jet_frame_inv.finv m0 bd base bw edge cursor N bi m false (@nil BitMachine.Cell))
         (_ : not (@eq Values.block br bg)) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_fe_nv.fe_at m br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m br
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m br
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag)))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bg BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z br BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bg BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))),
       @ex Memory.Mem.mem
         (fun ms : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun ml : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_save)
                     (@cons Values.val (Values.Vptr bg Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ms
                     Values.Vundef)
                  (and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ms
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_load)
                        (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr bg Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ml
                        Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ml
                           (@Ctypes.Internal Clight.function jets_secp.f_write_ge)
                           (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                              (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                           Values.Vundef)
                        (and
                           (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                              (@Translate.encode
                                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                    (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (jet_secp_rescale_literal.rescale_field_output x)
                                    (jet_secp_rescale_literal.rescale_field_output y))))
                           (and
                              (Memory.Mem.range_perm mf br BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bg BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block b br))
                                          (and (not (@eq Values.block b bg)) (not (jet_secp_frame.extA m0 bd bw bi b))))
                                       m mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
