### C.jet_rotate8_exec.rotate8_helper_symbol
rotate8_helper_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._rotate_8)
         (@Some Values.block (jet_exec.jet_symbol_block jets._rotate_8))
### C.jet_rotate8_exec.rotate8_helper_funct
rotate8_helper_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._rotate_8) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_rotate_8))
### C.jet_rotate8_exec.zero_ext8_unsigned_range
zero_ext8_unsigned_range
     : forall r : Integers.Int.int,
       and
         (BinInt.Z.le BinNums.Z0
            (Integers.Int.unsigned
               (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r)))
         (BinInt.Z.lt
            (Integers.Int.unsigned
               (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r))
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
### C.jet_rotate8_exec.exec_rotate8_scalar_call
exec_rotate8_scalar_call
     : forall (right : bool) (bl : Values.block) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (r a : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned r))
                (BinInt.Z.lt (Integers.Int.unsigned r)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._input le) (@Some Values.val (Values.Vint r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._amt le) (@Some Values.val (Values.Vint a))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (rotate8_scalar_call right) Events.E0
         (@Maps.PTree.set Values.val jets._t'3 (Values.Vint (rotate8_scalar_value right r a)) le) m
         ClightBigstep.Out_normal
### C.jet_rotate8_exec.rotate8_body
rotate8_body
     : forall right : bool,
       @eq Clight.statement (Clight.fn_body (rotate8_function right))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (jet_read4_call.nibble_read jets._t'1)
                  (Clight.Sset jets._amt
                     (jet_rotate8_count.rotate8_amount_expr (Clight.Etempvar jets._t'1 Ctypesdefs.tuchar))))
               (Clight.Ssequence
                  (Clight.Ssequence (jet_binary8_exec.binary8_read jets._t'2)
                     (Clight.Sset jets._input
                        (Clight.Ecast (Clight.Etempvar jets._t'2 Ctypesdefs.tuchar) Ctypesdefs.tuchar)))
                  (Clight.Ssequence
                     (Clight.Ssequence (rotate8_scalar_call right)
                        (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write8 Ctypesdefs.tuchar
                           Ctypesdefs.tvoid (Clight.Etempvar jets._t'3 Ctypesdefs.tuchar)))
                     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))))
### C.jet_rotate8_exec.eval_rotate8_composes
eval_rotate8_composes
     : forall (env : Values.val) (right : bool) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (mc mr mr2 me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bytes : list Memdata.memval) (a r : Integers.Int.int)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_read4)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vint r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vint (rotate8_payload right r a)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function (rotate8_function right))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_rotate8_exec.rotate8_function
rotate8_function =
fun right : bool =>
match right return Clight.function with
| true => jets.f_simplicity_right_rotate_8
| false => jets.f_simplicity_left_rotate_8
end
     : forall _ : bool, Clight.function

Arguments rotate8_function right%bool_scope
### C.jet_rotate8_exec.rotate8_scalar_value
rotate8_scalar_value =
fun (right : bool) (r a : Integers.Int.int) =>
jet_rotate8_helper.rotate8_result r
  match right return Integers.Int.int with
  | true => jet_rotate8_count.rotate8_reverse_amount a
  | false => a
  end
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments rotate8_scalar_value right%bool_scope r a
### C.jet_rotate8_exec.rotate8_raw
rotate8_raw =
fun (right : bool) (r a : Integers.Int.int) =>
rotate8_scalar_value right (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r)
  (jet_rotate8_count.rotate8_amount a)
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments rotate8_raw right%bool_scope r a
### C.jet_rotate8_exec.rotate8_payload
rotate8_payload =
fun (right : bool) (r a : Integers.Int.int) =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (rotate8_raw right r a)
     : forall (_ : bool) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments rotate8_payload right%bool_scope r a
### C.jet_rotate8_exec.rotate8_scalar_amount
rotate8_scalar_amount =
fun (right : bool) (a : Integers.Int.int) =>
match right return Integers.Int.int with
| true => jet_rotate8_count.rotate8_reverse_amount a
| false => a
end
     : forall (_ : bool) (_ : Integers.Int.int), Integers.Int.int

Arguments rotate8_scalar_amount right%bool_scope a
### C.jet_rotate8_exec.rotate8_scalar_count_expr
rotate8_scalar_count_expr =
fun right : bool =>
match right return Clight.expr with
| true => jet_rotate8_count.rotate8_reverse_amount_expr
| false => Clight.Etempvar jets._amt Ctypesdefs.tuchar
end
     : forall _ : bool, Clight.expr

Arguments rotate8_scalar_count_expr right%bool_scope
### C.jet_rotate8_exec.rotate8_scalar_call
rotate8_scalar_call =
fun right : bool =>
Clight.Scall (@Some AST.ident jets._t'3)
  (Clight.Evar jets._rotate_8
     (Ctypes.Tfunction (Ctypes.Tcons Ctypesdefs.tuchar (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tuchar
        AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._input Ctypesdefs.tuchar)
     (@cons Clight.expr (rotate8_scalar_count_expr right) (@nil Clight.expr)))
     : forall _ : bool, Clight.statement

Arguments rotate8_scalar_call right%bool_scope
