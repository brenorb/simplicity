### C.jet_read_sha256_counter.sha256_read_counter_actual_stmt
sha256_read_counter_actual_stmt
     : @eq Clight.statement
         match Clight.fn_body jets.f_simplicity_read_sha256_context return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s0 =>
             match s0 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s2 =>
                 match s2 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence stmt _ => stmt
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end sha256_read_counter_stmt
### C.jet_read_sha256_counter.exec_sha256_read_counter_store
exec_sha256_read_counter_store
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bc : Values.block)
         (base : BinNums.Z) (count len : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._compressionCount le)
                (@Some Values.val (Values.Vlong count)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._t'5 le) (@Some Values.val (Values.Vlong len)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bc
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (Values.Vlong (sha256_read_counter count len))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m
         (Clight.Sassign
            (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxCounter jets._ctx)
            (Clight.Ebinop Cop.Oadd
               (Clight.Ebinop Cop.Oshl
                  (Clight.Ebinop Cop.Omul (Clight.Etempvar jets._compressionCount Ctypesdefs.tulong)
                     (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tuint)
                     Ctypesdefs.tulong)
                  (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))
                     Ctypesdefs.tint) Ctypesdefs.tulong) (Clight.Etempvar jets._t'5 Ctypesdefs.tulong)
               Ctypesdefs.tulong)) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_read_sha256_counter.exec_sha256_read_counter_from_observation
exec_sha256_read_counter_from_observation
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bc : Values.block) (base : BinNums.Z) (bl : Values.block)
         (count len : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._len e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bl Ctypesdefs.tulong)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bl BinNums.Z0)
                (@Some Values.val (Values.Vlong len)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._compressionCount le)
                (@Some Values.val (Values.Vlong count)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bc
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m sha256_read_counter_stmt Events.E0 lef mf
                  ClightBigstep.Out_normal)
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.store AST.Mint64 m bc
                        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (Values.Vlong (sha256_read_counter count len))) (@Some Memory.Mem.mem mf))
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf bc
                        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val (Values.Vlong (sha256_read_counter count len)))))))
### C.jet_read_sha256_counter.exec_sha256_read_counter_from_memory
exec_sha256_read_counter_from_memory
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bc : Values.block) (base : BinNums.Z) (bl : Values.block)
         (count len : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._len e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bl Ctypesdefs.tulong)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bl BinNums.Z0)
                (@Some Values.val (Values.Vlong len)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._compressionCount le)
                (@Some Values.val (Values.Vlong count)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bc
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : jet_sha256_max_counter.sha256_max_counter_at m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m sha256_read_counter_stmt Events.E0 lef mf
                  ClightBigstep.Out_normal)
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.store AST.Mint64 m bc
                        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (Values.Vlong (sha256_read_counter count len))) (@Some Memory.Mem.mem mf))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf bc
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (@Some Values.val (Values.Vlong (sha256_read_counter count len))))
                     (jet_sha256_max_counter.sha256_max_counter_at mf)))))
### C.jet_read_sha256_counter.sha256_read_counter
sha256_read_counter =
fun count len : Integers.Int64.int =>
Integers.Int64.add
  (Integers.Int64.shl (Integers.Int64.mul count (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
     (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))) len
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments sha256_read_counter count len
### C.jet_read_sha256_counter.sha256_read_counter_stmt
sha256_read_counter_stmt =
Clight.Ssequence (Clight.Sset jets._t'5 (Clight.Evar jets._len Ctypesdefs.tulong))
  (Clight.Sassign (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxCounter jets._ctx)
     (Clight.Ebinop Cop.Oadd
        (Clight.Ebinop Cop.Oshl
           (Clight.Ebinop Cop.Omul (Clight.Etempvar jets._compressionCount Ctypesdefs.tulong)
              (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tuint) Ctypesdefs.tulong)
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH)))) Ctypesdefs.tint)
           Ctypesdefs.tulong) (Clight.Etempvar jets._t'5 Ctypesdefs.tulong) Ctypesdefs.tulong))
     : Clight.statement
