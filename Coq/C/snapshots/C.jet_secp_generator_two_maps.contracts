### C.jet_secp_generator_two_maps.generator_first_accumulate_source
generator_first_accumulate_source
     : @eq Clight.statement generator_first_accumulate
         (Clight.Sifthenelse (Clight.Etempvar jets_secp._blind32 (Ctypesdefs.tptr Ctypesdefs.tuchar))
            generator_blinded_accumulate
            (jet_secp_curve_statements.curve_call jets_secp._secp256k1_gej_set_ge jets_secp.f_secp256k1_gej_set_ge
               (@None AST.ident)
               (@cons Clight.expr
                  (Clight.Eaddrof (Clight.Evar jets_secp._accum (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
                     (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
                  (@cons Clight.expr
                     (Clight.Eaddrof (Clight.Evar jets_secp._add jet_secp_curve_statements.curve_ge_type)
                        (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type)) (@nil Clight.expr)))))
### C.jet_secp_generator_two_maps.generator_accumulate_closed
generator_accumulate_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers
            (Clight.fn_body jets_secp.f_secp256k1_gej_set_ge)) true
### C.jet_secp_generator_two_maps.exec_generator_first_accumulate
exec_generator_first_accumulate
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bx bp : Values.block) (x y : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._accum e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._add e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp jet_secp_curve_statements.curve_ge_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_set_ge e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._blind32 le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero))) (_ : not (@eq Values.block bx bp))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_first_accumulate Events.E0 le mf
               ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf bx
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (jet_secp_fe_nv.fe_at mf bx
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_set_bit.point_set_bit_words true)))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf bx
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                           (@Some Values.val (Values.Vint Integers.Int.zero)))
                        (and
                           (Memory.Mem.range_perm mf bx BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bx)) m mf)
                              (jet_clight_internal_preserve.readonly_preserved m mf))))))))
### C.jet_secp_generator_two_maps.generator_two_maps_source
generator_two_maps_source
     : @eq Clight.statement generator_two_maps
         (jet_secp_statement_prefix.statement_sequence
