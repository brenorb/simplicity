### C.jet_secp_generator_two_maps.generator_two_maps_ret
generator_two_maps_ret
     : forall (prior : bool) (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (le : Maps.PTree.tree Values.val),
       @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ret (generator_two_maps_temps prior key le))
