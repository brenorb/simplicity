                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_fromMidstate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._shallue_van_de_woestijne e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_set_ge e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   (jet_secp_generator_sha_start.generator_sha_result_id false) e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br0 jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   (jet_secp_generator_sha_start.generator_sha_context_id false) e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc0 jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   (jet_secp_generator_sha_start.generator_sha_result_id true) e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br1 jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   (jet_secp_generator_sha_start.generator_sha_context_id true) e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc1 jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_buf e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._b32 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._add e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp jet_secp_curve_statements.curve_ge_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._accum e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))))
         (_ : forall second : bool,
              @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   (jet_secp_generator_sha_absorb.generator_sha_prefix_id second) e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._key32 le)
                (@Some Values.val (Values.Vptr ba oa)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._blind32 le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ret le)
                (@Some Values.val (Values.Vint (jet_secp_field_cmov.cmov_int prior))))
         (_ : @List.NoDup Values.block
                (@cons Values.block ba
                   (@cons Values.block br0
                      (@cons Values.block bc0
                         (@cons Values.block br1
                            (@cons Values.block bc1
                               (@cons Values.block bs
                                  (@cons Values.block bb
                                     (@cons Values.block bt
                                        (@cons Values.block bp (@cons Values.block bx (@nil Values.block))))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : jet_secp_swu_startup.swu_startup m)
         (_ : forall prefix : bool, jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix m)
         (_ : Memory.Mem.range_perm m br0 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc0 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat i)))
                (@Some Values.val
                   (Values.Vint
                      (@List.nth Integers.Int.int i
                         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int
                            jet_read8s_layout.word8_array_value
                            (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) key))
                         Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun x0 : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun y0 : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun x1 : forall _ : nat, Integers.Int64.int =>
                   @ex (forall _ : nat, Integers.Int64.int)
                     (fun y1 : forall _ : nat, Integers.Int64.int =>
                      and
                        (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_two_maps Events.E0
                           (generator_two_maps_temps prior key le) mf ClightBigstep.Out_normal)
                        (and (jet_secp_fe_nv.fe_at mf bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x0))
                           (and
                              (jet_secp_fe_nv.fe_at mf bx
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 (jet_secp_multiply_normalize_bridge.words5 y0))
                              (and
                                 (jet_secp_fe_nv.fe_at mf bx
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    (jet_secp_multiply_normalize_bridge.words5
                                       (jet_secp_point_set_bit.point_set_bit_words true)))
                                 (and
                                    (@eq (option Values.val)
                                       (Memory.Mem.load AST.Mint32 mf bx
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                       (@Some Values.val (Values.Vint Integers.Int.zero)))
                                    (and
                                       (jet_secp_fe_nv.fe_at mf bp BinNums.Z0
                                          (jet_secp_multiply_normalize_bridge.words5 x1))
                                       (and
                                          (jet_secp_fe_nv.fe_at mf bp
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                             (jet_secp_multiply_normalize_bridge.words5 y1))
                                          (and
                                             (@eq (option Values.val)
                                                (Memory.Mem.load AST.Mint32 mf bp
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))
                                                (@Some Values.val (Values.Vint Integers.Int.zero)))
                                             (and (jet_secp_square_columns.square_input_bounds x0)
                                                (and (jet_secp_square_columns.square_input_bounds y0)
                                                   (and (jet_secp_square_columns.square_input_bounds x1)
                                                      (and (jet_secp_square_columns.square_input_bounds y1)
                                                         (and
                                                            (@eq (prod (Ty.tySem ...) (Ty.tySem ...))
                                                               (@pair (Ty.tySem ...) (Ty.tySem ...)
                                                                  (jet_secp_rescale_literal.rescale_field_output x0)
                                                                  (jet_secp_rescale_literal.rescale_field_output y0))
                                                               (jet_secp_swu_word_parity.swu_words_literal_output
                                                                  (jet_secp_swu_raw_input.swu_raw_words ...)
                                                                  (@jet_secp_generator_hash_literal.literal_generator_hash
                                                                     false Alg.CoreFunSem key)))
                                                            (and
                                                               (@eq (prod ... ...) (@pair ... ... ... ...)
                                                                  (jet_secp_swu_word_parity.swu_words_literal_output
                                                                     ... ...)) (and (..., ...) (and ... ...))))))))))))))))))))
### C.jet_secp_generator_two_maps.generator_first_accumulate
generator_first_accumulate =
@List.nth Clight.statement (S (S (S (S (S (S (S (S (S (S O))))))))))
  (@fst (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal)))
  Clight.Sskip
     : Clight.statement
### C.jet_secp_generator_two_maps.generator_blinded_accumulate
generator_blinded_accumulate =
match generator_first_accumulate return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ yes _ => yes
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_generator_two_maps.generator_two_maps
generator_two_maps =
jet_secp_statement_prefix.statement_sequence
  (@List.firstn Clight.statement (S (S (S (S (S (S (S O)))))))
     (@List.skipn Clight.statement (S (S (S (S (S (S (S O)))))))
        (@fst (list Clight.statement) Clight.statement
           (jet_secp_statement_prefix.split_statement_last
              (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal))))) Clight.Sskip
     : Clight.statement
### C.jet_secp_generator_two_maps.generator_two_maps_temps
generator_two_maps_temps =
fun (prior : bool) (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (le : Maps.PTree.tree Values.val) =>
jet_secp_generator_hash_map.generator_hash_map_temps true
  (andb prior (jet_secp_generator_hash_map.generator_hash_accepted false key)) key
  (jet_secp_generator_hash_map.generator_hash_map_temps false prior key le)
     : forall (_ : bool) (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : Maps.PTree.tree Values.val),
       Maps.PTree.tree Values.val

Arguments generator_two_maps_temps prior%bool_scope key le
