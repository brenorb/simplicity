               (jet_secp_field_cmov.cmov_int
                  (andb (andb prior (jet_secp_generator_hash_map.generator_hash_accepted false key))
                     (jet_secp_generator_hash_map.generator_hash_accepted true key)))))
### C.jet_secp_generator_two_maps.exec_generator_two_maps
exec_generator_two_maps
     : forall (_ : jet_memcpy_model.memcpy_model) (prior : bool)
         (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (br0 bc0 br1 bc1 bs bb bt bp bx ba : Values.block) (oa : Integers.Ptrofs.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_init e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_uchars e)
