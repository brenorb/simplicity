### C.jet_write_buffer8_exec.buffer8_write_array_symbol
buffer8_write_array_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._write8s)
         (@Some Values.block (jet_exec.jet_symbol_block jets._write8s))
### C.jet_write_buffer8_exec.buffer8_write_array_funct
buffer8_write_array_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._write8s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_write8s))
### C.jet_write_buffer8_exec.eval_buffer8_tag
eval_buffer8_tag
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j len : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : and (BinInt.Z.le BinNums.Z0 len) (BinInt.Z.le len Integers.Int64.max_unsigned))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._len le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr len)))),
       Clight.eval_expr jet_exec.ge0 e le m jet_write_buffer8_empty_exec.buffer8_tag_expr
         (Values.Vint (jet_readBit_layout.bit_int (BinInt.Z.leb j len)))
### C.jet_write_buffer8_exec.exec_buffer8_write_present
exec_buffer8_write_present
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bi : Values.block)
         (input j len : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._write8s e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._buf le)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._len le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr len))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j)))) (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le (BinInt.Z.add input j) Integers.Ptrofs.max_unsigned)
         (_ : and (and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j len)) (BinInt.Z.le len Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_write8s)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
                      (@cons Values.val (Values.Vlong (Integers.Int64.repr j)) (@nil Values.val)))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m jet_write_buffer8_empty_exec.buffer8_present_branch
         Events.E0 (buffer8_write_present_temps le bi input len j) mf ClightBigstep.Out_normal
### C.jet_write_buffer8_exec.exec_buffer8_write_absent
exec_buffer8_write_absent
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bf : Values.block) (base j : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._skipBits e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_skipBits)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) j)))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m jet_write_buffer8_empty_exec.buffer8_skip_call Events.E0 le
         mf ClightBigstep.Out_normal
### C.jet_write_buffer8_exec.exec_buffer8_write_body
exec_buffer8_write_body
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mb mf : Memory.Mem.mem) (lef : Clight.temp_env) (bf : Values.block) (base j len : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._writeBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._len le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr len))))
         (_ : and (BinInt.Z.lt BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : and (BinInt.Z.le BinNums.Z0 len) (BinInt.Z.le len Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_writeBit)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vint (jet_readBit_layout.bit_int (BinInt.Z.leb j len))) (@nil Values.val)))
                Events.E0 mb (Values.Vint (jet_readBit_layout.bit_int (BinInt.Z.leb j len))))
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e
                (@Maps.PTree.set Values.val jets._t'2 (Values.Vint (jet_readBit_layout.bit_int (BinInt.Z.leb j len)))
                   le) mb
                match BinInt.Z.leb j len return Clight.statement with
                | true => jet_write_buffer8_empty_exec.buffer8_present_branch
                | false => jet_write_buffer8_empty_exec.buffer8_skip_call
                end Events.E0 lef mf ClightBigstep.Out_normal),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m jet_write_buffer8_empty_exec.buffer8_loop_body Events.E0 lef
         mf ClightBigstep.Out_normal
### C.jet_write_buffer8_exec.exec_buffer8_write_halve
exec_buffer8_write_halve
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m jet_write_buffer8_empty_exec.buffer8_loop_update Events.E0
         (@Maps.PTree.set Values.val jets._i
            (Values.Vlong (Integers.Int64.repr (BinInt.Z.div j (BinNums.Zpos (BinNums.xO BinNums.xH))))) le) m
         ClightBigstep.Out_normal
### C.jet_write_buffer8_exec.buffer8_write_present_temps
buffer8_write_present_temps =
fun (le : Maps.PTree.tree Values.val) (bi : Values.block) (input len j : BinNums.Z) =>
@Maps.PTree.set Values.val jets._len (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub len j)))
  (@Maps.PTree.set Values.val jets._buf (Values.Vptr bi (Integers.Ptrofs.repr (BinInt.Z.add input j))) le)
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       Maps.PTree.tree Values.val

Arguments buffer8_write_present_temps le bi (input len j)%Z_scope
