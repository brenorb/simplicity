### C.jet_elements_output_is_fee_spec.fee_tail_parametric
fee_tail_parametric
     : @Alg.Core.Parametric
         (Ty.Prod
            (Ty.Sum Ty.Unit
               (Ty.Prod
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit))
         (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) (fun term : Alg.Core.Algebra => @fee_tail term)
### C.jet_elements_output_is_fee_spec.fee_hash_const_parametric
fee_hash_const_parametric
     : forall A : Ty.Ty,
       @Alg.Core.Parametric A (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (fun term : Alg.Core.Algebra =>
          @Alg.scribe A (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) elements_empty_hash) term)
### C.jet_elements_output_is_fee_spec.reader_pure
@reader_pure
     : forall (E : Type) (A B : Ty.Ty) (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg A B)
         (_ : @Alg.Core.Parametric A B t) (x : Ty.tySem A) (environment : E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem B))
         (t (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad)) x environment)
         (@Some (Ty.tySem B) (t Alg.CoreFunSem x))
### C.jet_elements_output_is_fee_spec.fee_program_reader_sem
@fee_program_reader_sem
     : forall (E : Type) (A : Ty.Ty)
         (pamt : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad)) A
                   (Ty.Sum Ty.Unit
                      (Ty.Prod
                         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                            (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                            (Word.Word (S (S (S (S (S (S O)))))))))))
         (ph : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad)) A
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (a : Ty.tySem A)
         (environment : E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))))
         (@fee_program (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad)) A pamt ph a environment)
         match
           pamt a environment
           return (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))))
         with
         | Some p =>
             match
               ph a environment
               return (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))))
             with
             | Some h =>
                 @Some (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
                   (@fee_tail Alg.CoreFunSem
                      (@pair
                         (Ty.tySem
                            (Ty.Sum Ty.Unit
                               (Ty.Prod
                                  (Ty.Sum
                                     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                     (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                  (Ty.Sum
                                     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                     (Word.Word (S (S (S (S (S (S O))))))))))) (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) p
                         (@jet_equality_spec.equality_spec
                            (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) Alg.CoreFunSem
                            (@pair (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                               (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) h
                               (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) elements_empty_hash)))))
             | None => @None (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
             end
         | None => @None (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
         end
### C.jet_elements_output_is_fee_spec.fee_tail_value
fee_tail_value
     : forall
         (x : Ty.tySem
                (Ty.Prod
                   (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Word.Word (S (S (S (S (S (S O)))))))))) (b : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)),
       @eq (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
         (@fee_tail Alg.CoreFunSem
            (@pair
               (sum unit
                  (Ty.tySem
                     (Ty.Prod
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S O))))))))))) (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
               (@inr unit
                  (Ty.tySem
                     (Ty.Prod
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S O)))))))))) x) b))
         (@inr unit (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
            match
              andb
                (@fee_explicit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                   (@fst
                      (sum
                         (prod (sum unit unit)
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                      (sum
                         (prod (sum unit unit)
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S O))))))))) x))
                (@fee_explicit (Word.Word (S (S (S (S (S (S O)))))))
                   (@snd
                      (sum
                         (prod (sum unit unit)
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                      (sum
                         (prod (sum unit unit)
                            ((fix tySem (X : Ty.Ty) : Set :=
                                match X return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S O))))))))) x))
              return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
            with
            | true => b
            | false => @inl unit unit tt
            end)
### C.jet_elements_output_is_fee_spec.bit_of_toBool
bit_of_toBool
     : forall b : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit),
       @eq (sum unit unit)
         match Bit.toBool b return (sum unit unit) with
         | true => @inr unit unit tt
         | false => @inl unit unit tt
         end b
### C.jet_elements_output_is_fee_spec.elements_output_is_fee_sem
elements_output_is_fee_sem
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))))
         (@elements_output_is_fee_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
         (@Some (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))) (canonical_fee_result a environment))
### C.jet_elements_output_is_fee_spec.elements_empty_hash
elements_empty_hash =
Word.from_hash256 (Digest.byteStringHash (@nil Integers.Byte.int))
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))
### C.jet_elements_output_is_fee_spec.fee_hash_test
fee_hash_test =
fun (alg : Alg.Core.Algebra) (A : Ty.Ty)
  (ph : Alg.Core.domain alg A (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) =>
@AC.comp A
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.Sum Ty.Unit Ty.Unit) alg
  (@AC.pair A (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg ph
     (@Alg.scribe A (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) elements_empty_hash
         :
         Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg))
  (@jet_equality_spec.equality_spec (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg)
     : forall (alg : Alg.Core.Algebra) (A : Ty.Ty)
         (_ : Alg.Core.domain alg A (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))),
       Alg.Core.domain alg A (Ty.Sum Ty.Unit Ty.Unit)

Arguments fee_hash_test {alg} {A}%ty_scope ph
### C.jet_elements_output_is_fee_spec.fee_tail
fee_tail =
fun alg : Alg.Core.Algebra =>
@AC.case Ty.Unit
  (Ty.Prod
     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) alg
  (@AC.injl (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) alg
     (@AC.unit (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) alg))
  (@AC.injr
     (Ty.Prod
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit)) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) alg
     (@AC.comp
        (Ty.Prod
           (Ty.Prod
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit))
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O))))))))
           (Ty.Prod
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit)))
        (Ty.Sum Ty.Unit Ty.Unit) alg
        (@AC.pair
           (Ty.Prod
              (Ty.Prod
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O))))))))
           (Ty.Prod
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit)) alg
           (@AC.take
              (Ty.Prod
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit)
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S O)))))))) alg
              (@AC.drop
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S O))))))))
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S O)))))))) alg
                 (@AC.iden
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S O)))))))) alg)))
           (@AC.pair
              (Ty.Prod
                 (Ty.Prod
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit))
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit) alg
              (@AC.take
                 (Ty.Prod
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit)
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg
                 (@AC.take
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S O))))))))
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg
                    (@AC.iden
                       (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                          (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg)))
              (@AC.drop
                 (Ty.Prod
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit) alg
                 (@AC.iden (Ty.Sum Ty.Unit Ty.Unit) alg))))
        (@AC.case (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S O)))))))
           (Ty.Prod
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit)) (Ty.Sum Ty.Unit Ty.Unit) alg
           (@Bit.false
              (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.Prod
                    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit))) alg)
           (@AC.drop (Word.Word (S (S (S (S (S (S O)))))))
              (Ty.Prod
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit))
              (Ty.Sum Ty.Unit Ty.Unit) alg
              (@AC.case (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit) alg
                 (@Bit.false
                    (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Ty.Sum Ty.Unit Ty.Unit)) alg)
                 (@AC.drop (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit)
                    (Ty.Sum Ty.Unit Ty.Unit) alg (@AC.iden (Ty.Sum Ty.Unit Ty.Unit) alg)))))))
     : forall alg : Alg.Core.Algebra,
       Alg.Core.domain alg
         (Ty.Prod
            (Ty.Sum Ty.Unit
               (Ty.Prod
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit))
         (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))

Arguments fee_tail {alg}
### C.jet_elements_output_is_fee_spec.fee_program
fee_program =
fun (alg : Alg.Core.Algebra) (A : Ty.Ty)
  (pamt : Alg.Core.domain alg A
            (Ty.Sum Ty.Unit
               (Ty.Prod
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S O)))))))))))
  (ph : Alg.Core.domain alg A (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) =>
@AC.comp A
  (Ty.Prod
     (Ty.Sum Ty.Unit
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit))
  (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) alg
  (@AC.pair A
     (Ty.Sum Ty.Unit
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit) alg pamt (@fee_hash_test alg A ph))
  (@fee_tail alg)
     : forall (alg : Alg.Core.Algebra) (A : Ty.Ty)
         (_ : Alg.Core.domain alg A
                (Ty.Sum Ty.Unit
                   (Ty.Prod
                      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Word.Word (S (S (S (S (S (S O)))))))))))
         (_ : Alg.Core.domain alg A (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))),
       Alg.Core.domain alg A (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))

Arguments fee_program {alg} {A}%ty_scope pamt ph
### C.jet_elements_output_is_fee_spec.elements_output_is_fee_spec
elements_output_is_fee_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@fee_program (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
  (Word.Word (S (S (S (S (S O)))))) (@jet_elements_amount_jets.elements_output_amount_spec alg)
  (@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg jet_elements_prim.Elements.OutputScriptHash)
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))

Arguments elements_output_is_fee_spec {alg}
### C.jet_elements_output_is_fee_spec.fee_explicit
fee_explicit =
fun (X : Ty.Ty)
  (c : Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) X)) =>
match c return bool with
| inl _ => false
| inr _ => true
end
     : forall (X : Ty.Ty)
         (_ : Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) X)),
       bool

Arguments fee_explicit {X}%ty_scope c
### C.jet_elements_output_is_fee_spec.canonical_fee_bit
canonical_fee_bit =
fun o : jet_elements_prim.txOutput =>
andb
  (andb
     (@fee_explicit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (jet_elements_asset_jets.encode_asset
           (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256 (jet_elements_prim.txoAsset o))))
     (@fee_explicit (Word.Word (S (S (S (S (S (S O)))))))
        (jet_elements_amount_jets.encode_amount
           (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (jet_elements_prim.txoAmount o)))))
  (Bit.toBool
     ((@jet_equality_spec.equality_spec (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) Alg.CoreFunSem
       :
       Ty.Arrow
         (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.Sum Ty.Unit Ty.Unit))
        (@pair (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.from_hash256 (Digest.byteStringHash (jet_elements_prim.txoScript o))))
           (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) elements_empty_hash))))
     : forall _ : jet_elements_prim.txOutput, bool

Arguments canonical_fee_bit o
### C.jet_elements_output_is_fee_spec.canonical_fee_result
canonical_fee_result =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
match
  @List.nth_error jet_elements_prim.txOutput
    (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
with
| Some o =>
    @inr unit (sum unit unit)
      match canonical_fee_bit o return (sum unit unit) with
      | true => @inr unit unit tt
      | false => @inl unit unit tt
      end
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)) tt
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))

Arguments canonical_fee_result a environment
