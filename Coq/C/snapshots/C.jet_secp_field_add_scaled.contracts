### C.jet_secp_field_add_scaled.field_sum_output
field_sum_output
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int)
         (jet_secp_field_add_storage.add_values (jet_secp_curve_tail_values.curve_equal_rho a b))
         (jet_secp_multiply_normalize_bridge.words5 (field_sum_words a b))
### C.jet_secp_field_add_scaled.field_sum_unsigned
field_sum_unsigned
     : forall (a b : forall _ : nat, Integers.Int64.int) (i : nat)
         (_ : BinInt.Z.le (BinInt.Z.add (Integers.Int64.unsigned (a i)) (Integers.Int64.unsigned (b i)))
                Integers.Int64.max_unsigned),
       @eq BinNums.Z (Integers.Int64.unsigned (field_sum_words a b i))
         (BinInt.Z.add (Integers.Int64.unsigned (a i)) (Integers.Int64.unsigned (b i)))
