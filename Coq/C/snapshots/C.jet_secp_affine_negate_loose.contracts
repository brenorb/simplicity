### C.jet_secp_affine_negate_loose.eval_affine_negate_loose_point
eval_affine_negate_loose_point
     : forall (y : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (xlimbs : list Integers.Int64.int) (flag : Integers.Int.int)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (y i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : @eq nat (@length Integers.Int64.int xlimbs) (S (S (S (S (S O))))))
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 xlimbs)
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m b
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_neg)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf b BinNums.Z0 xlimbs)
               (and
                  (jet_secp_fe_nv.fe_at mf b
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5
                        (jet_secp_field_negate_separate.negate_sep_words (jet_secp_field_weak_loose.weak_loose_words y))))
                  (and
                     (Memory.Mem.range_perm mf b BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf b
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@Some Values.val (Values.Vint flag)))
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_field_negate_separate.negate_sep_words
                                       (jet_secp_field_weak_loose.weak_loose_words y))) jet_secp_fe_math.feP)
                              (BinInt.Z.modulo (BinInt.Z.opp (jet_secp_multiply_finish_product.radix_value y))
                                 jet_secp_fe_math.feP))
                           (and
                              (jet_secp_square_columns.square_input_bounds
                                 (jet_secp_field_negate_separate.negate_sep_words
                                    (jet_secp_field_weak_loose.weak_loose_words y)))
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf))))))))
