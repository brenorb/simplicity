### C.jet_secp_gej_negate_literal.literal_gej_negate_step
literal_gej_negate_step
     : forall x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Prod
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_gej_negate Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))
         (@pair
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
               (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem y))
            (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem z))
### C.jet_secp_gej_negate_literal.point_normalized_field_output
point_normalized_field_output
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_point_write_field.point_field_output
            (jet_secp_point_field_bridge.point_canonical_field
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x))))
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
### C.jet_secp_gej_negate_literal.point_normalized_negative_field_output
point_normalized_negative_field_output
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_point_write_field.point_field_output
            (jet_secp_point_field_bridge.point_negative_field
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x))))
         (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem x)
### C.jet_secp_gej_negate_literal.point_encode_pair
@point_encode_pair
     : forall (A B : Ty.Ty) (a : Ty.tySem A) (b : Ty.tySem B),
       @eq (list BitMachine.Cell) (@Translate.encode (Ty.Prod A B) (@pair (Ty.tySem A) (Ty.tySem B) a b))
         (@app BitMachine.Cell (@Translate.encode A a) (@Translate.encode B b))
### C.jet_secp_gej_negate_literal.literal_gej_negate_writer_encoding
literal_gej_negate_writer_encoding
     : forall x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list BitMachine.Cell)
         (@app BitMachine.Cell
            (@app BitMachine.Cell
               (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                  (jet_secp_point_write_field.point_field_output
                     (jet_secp_point_field_bridge.point_canonical_field
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)))))
               (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                  (jet_secp_point_write_field.point_field_output
                     (jet_secp_point_field_bridge.point_negative_field
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem y))))))
            (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_point_write_field.point_field_output
                  (jet_secp_point_field_bridge.point_canonical_field
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem z))))))
         (@Translate.encode
            (Ty.Prod
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@literal_gej_negate Alg.CoreFunSem
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)))
### C.jet_secp_gej_negate_literal.literal_ge_negate
literal_ge_negate =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.pair
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
  (@Alg.Core.Combinators.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@jet_secp_canonical_normalize.canonical_fe_normalize term))
  (@Alg.Core.Combinators.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@jet_secp_negate_literal_contract.literal_fe_negate term))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments literal_ge_negate {term}
### C.jet_secp_gej_negate_literal.literal_gej_negate
literal_gej_negate =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.pair
  (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
  (@Alg.Core.Combinators.take
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
     (@literal_ge_negate term))
  (@Alg.Core.Combinators.drop
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@jet_secp_canonical_normalize.canonical_fe_normalize term))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments literal_gej_negate {term}
