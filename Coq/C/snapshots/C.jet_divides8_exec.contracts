divides8_body
     : @eq Clight.statement (Clight.fn_body jets.f_simplicity_divides_8)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (jet_binary8_exec.binary8_read jets._t'1)
                  (Clight.Sset jets._x (Clight.Ecast (Clight.Etempvar jets._t'1 Ctypesdefs.tuchar) Ctypesdefs.tuchar)))
               (Clight.Ssequence
                  (Clight.Ssequence (jet_binary8_exec.binary8_read jets._t'2)
                     (Clight.Sset jets._y
