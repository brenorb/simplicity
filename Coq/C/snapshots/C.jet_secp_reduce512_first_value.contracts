               (BinInt.Z.mul (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                  (Integers.Int64.unsigned jet_secp_reduce512_symbolic.wide_C0))))
         (and
            (@eq BinNums.Z (jet_secp_reduce512_wide.wide_value (jet_secp_reduce512_first_symbolic.first_ma1 rho))
               (BinInt.Z.add
                  (BinInt.Z.add
                     (jet_secp_reduce512_wide.wide_value
                        (jet_secp_reduce512_wide.wide_extract_fast (jet_secp_reduce512_first_symbolic.first_ma0 rho)))
                     (Integers.Int64.unsigned (rho (S O))))
                  (jet_secp_reduce512_accumulate.wide_operation_sum (first_ops1 rho))))
            (and
               (@eq BinNums.Z (jet_secp_reduce512_wide.wide_value (jet_secp_reduce512_first_symbolic.first_ma2 rho))
                  (BinInt.Z.add
                     (jet_secp_reduce512_wide.wide_value
                        (jet_secp_reduce512_wide.wide_extract (jet_secp_reduce512_first_symbolic.first_ma1 rho)))
                     (jet_secp_reduce512_accumulate.wide_operation_sum (first_ops2 rho))))
               (and
                  (@eq BinNums.Z (jet_secp_reduce512_wide.wide_value (jet_secp_reduce512_first_symbolic.first_ma3 rho))
                     (BinInt.Z.add
                        (jet_secp_reduce512_wide.wide_value
                           (jet_secp_reduce512_wide.wide_extract (jet_secp_reduce512_first_symbolic.first_ma2 rho)))
                        (jet_secp_reduce512_accumulate.wide_operation_sum (first_ops3 rho))))
                  (and
                     (@eq BinNums.Z
                        (jet_secp_reduce512_wide.wide_value (jet_secp_reduce512_first_symbolic.first_ma4 rho))
                        (BinInt.Z.add
                           (jet_secp_reduce512_wide.wide_value
                              (jet_secp_reduce512_wide.wide_extract (jet_secp_reduce512_first_symbolic.first_ma3 rho)))
                           (jet_secp_reduce512_accumulate.wide_operation_sum (first_ops4 rho))))
                     (@eq BinNums.Z
                        (jet_secp_reduce512_wide.wide_value (jet_secp_reduce512_first_symbolic.first_ma5 rho))
                        (BinInt.Z.add
                           (jet_secp_reduce512_wide.wide_value
                              (jet_secp_reduce512_wide.wide_extract (jet_secp_reduce512_first_symbolic.first_ma4 rho)))
                           (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S O)))))))))))))))
