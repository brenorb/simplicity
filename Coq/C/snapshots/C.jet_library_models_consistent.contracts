libc_memset_sem (ge : Globalenvs.Senv.t)
  : forall (_ : list Values.val) (_ : Memory.Mem.mem) (_ : Events.trace) (_ : Values.val) (_ : Memory.Mem.mem), Prop :=
    libc_memset_sem_intro : forall (bdst : Values.block) (odst : Integers.Ptrofs.int) (c : Integers.Int.int)
                              (sz : Integers.Int64.int) (m m' : Memory.Mem.mem)
