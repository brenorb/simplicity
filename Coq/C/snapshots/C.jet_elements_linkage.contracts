### C.jet_elements_linkage.elements_write32_symbol
elements_write32_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv elements_ge)
            jets_elements._simplicity_write32)
         (@Some Values.block (elements_symbol_block jets_elements._simplicity_write32))
### C.jet_elements_linkage.elements_write32_funct
elements_write32_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv elements_ge)
            (Values.Vptr (elements_symbol_block jets_elements._simplicity_write32) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_elements.f_simplicity_write32))
### C.jet_elements_linkage.elements_write32_body_shared
elements_write32_body_shared
     : @eq Clight.function jets_elements.f_simplicity_write32 jets.f_simplicity_write32
### C.jet_elements_linkage.elements_env_tx_field
elements_env_tx_field
     : match @Maps.PTree.get Ctypes.composite jets_elements._txEnv (Clight.genv_cenv elements_ge) return Prop with
       | Some co =>
           @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
             (Ctypes.field_offset (Clight.genv_cenv elements_ge) jets_elements._tx (Ctypes.co_members co))
             (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield BinNums.Z0 Ctypes.Full))
       | None => False
       end
### C.jet_elements_linkage.elements_tx_version_field
elements_tx_version_field
     : match
         @Maps.PTree.get Ctypes.composite jets_elements._elementsTransaction (Clight.genv_cenv elements_ge) return Prop
       with
       | Some co =>
           @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
             (Ctypes.field_offset (Clight.genv_cenv elements_ge) jets_elements._version (Ctypes.co_members co))
             (@Errors.OK (prod BinNums.Z Ctypes.bitfield)
                (@pair BinNums.Z Ctypes.bitfield
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                   Ctypes.Full))
       | None => False
       end
### C.jet_elements_linkage.elements_tx_lockTime_field
elements_tx_lockTime_field
     : match
         @Maps.PTree.get Ctypes.composite jets_elements._elementsTransaction (Clight.genv_cenv elements_ge) return Prop
       with
       | Some co =>
           @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
             (Ctypes.field_offset (Clight.genv_cenv elements_ge) jets_elements._lockTime (Ctypes.co_members co))
             (@Errors.OK (prod BinNums.Z Ctypes.bitfield)
                (@pair BinNums.Z Ctypes.bitfield
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                   Ctypes.Full))
       | None => False
       end
