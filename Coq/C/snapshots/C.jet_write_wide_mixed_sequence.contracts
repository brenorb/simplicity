### C.jet_write_wide_mixed_sequence.wide_mixed_bits_nonnegative
wide_mixed_bits_nonnegative
     : forall xs : list (prod jet_wide.wide_size Integers.Int64.int), BinInt.Z.le BinNums.Z0 (wide_mixed_bits xs)
### C.jet_write_wide_mixed_sequence.write_wide_mixed_run_layout
write_wide_mixed_run_layout
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (xs : list (prod jet_wide.wide_size Integers.Int64.int))
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor (wide_mixed_bits xs)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and (write_wide_mixed_run bf base bw xs m mf)
            (and (jet_encoding.frame_output_cells_at mf bw edge cursor (wide_mixed_cells xs))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and (jet_frame_layout.frame_fields_at mf bf base bw edge (BinInt.Z.sub cursor (wide_mixed_bits xs)))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bf
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div (BinInt.Z.sub cursor (wide_mixed_bits xs))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
### C.jet_write_wide_mixed_sequence.wide_mixed_bits
wide_mixed_bits =
fix wide_mixed_bits (xs : list (prod jet_wide.wide_size Integers.Int64.int)) : BinNums.Z :=
  match xs return BinNums.Z with
  | nil => BinNums.Z0
  | cons p xs0 =>
      match p return BinNums.Z with
      | pair s _ => BinInt.Z.add (jet_wide.wide_bits s) (wide_mixed_bits xs0)
      end
  end
     : forall _ : list (prod jet_wide.wide_size Integers.Int64.int), BinNums.Z

Arguments wide_mixed_bits xs%list_scope
### C.jet_write_wide_mixed_sequence.write_wide_mixed_run
write_wide_mixed_run =
fix write_wide_mixed_run
  (bf : Values.block) (base : BinNums.Z) (bw : Values.block) (xs : list (prod jet_wide.wide_size Integers.Int64.int))
  (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons p xs0 =>
      match p return Prop with
      | pair s x =>
          @ex Memory.Mem.mem
            (fun mi : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                  (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                     (@cons Values.val (Values.Vlong x) (@nil Values.val))) Events.E0 mi Values.Vundef)
               (and
                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : not (@eq Values.block b bf)) (_ : not (@eq Values.block b bw)),
                   @eq (option Values.val) (Memory.Mem.load chunk mi b ofs) (Memory.Mem.load chunk m b ofs))
                  (write_wide_mixed_run bf base bw xs0 mi mf)))
      end
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block)
         (_ : list (prod jet_wide.wide_size Integers.Int64.int)) (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments write_wide_mixed_run bf base%Z_scope bw xs%list_scope m mf
### C.jet_write_wide_mixed_sequence.wide_mixed_cells
wide_mixed_cells =
fun xs : list (prod jet_wide.wide_size Integers.Int64.int) =>
@List.concat BitMachine.Cell
  (@List.map (prod jet_wide.wide_size Integers.Int64.int) (list BitMachine.Cell)
     (fun sx : prod jet_wide.wide_size Integers.Int64.int =>
      @Translate.encode (Word.Word (jet_wide.wide_log (@fst jet_wide.wide_size Integers.Int64.int sx)))
        (jet_wide_spec.decode_wide (@fst jet_wide.wide_size Integers.Int64.int sx)
           (Integers.Int64.zero_ext (jet_wide.wide_bits (@fst jet_wide.wide_size Integers.Int64.int sx))
              (@snd jet_wide.wide_size Integers.Int64.int sx)))) xs)
     : forall _ : list (prod jet_wide.wide_size Integers.Int64.int), list BitMachine.Cell

Arguments wide_mixed_cells xs%list_scope
