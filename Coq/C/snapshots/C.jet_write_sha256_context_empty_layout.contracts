### C.jet_write_sha256_context_empty_layout.ctx8_zero_writer_value
ctx8_zero_writer_value
     : @eq (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W64)))
         (jet_wide_spec.decode_wide jet_wide.W64
            (Integers.Int64.zero_ext
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               Integers.Int64.zero)) (@Word.zero (S (S (S (S (S (S O)))))) Alg.CoreFunSem tt)
### C.jet_write_sha256_context_empty_layout.eval_write_sha256_context_empty_layout
eval_write_sha256_context_empty_layout
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (bc : Values.block) (cbase : BinNums.Z) (bi : Values.block)
         (input : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 cbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le
                (BinInt.Z.add input
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bc bf)) (_ : not (@eq Values.block bc bw))
         (_ : not (@eq Values.block bi bf)) (_ : not (@eq Values.block bi bw))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bc
                   (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bc cbase)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinInt.Z.add cbase
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : jet_uint32_array_init.uint32_array_at m bi input jet_sha256_iv_init.sha256_iv_words)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function jets.f_simplicity_write_sha256_context)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase)) (@nil Values.val))) Events.E0 mf
               (Values.Vint Integers.Int.one))
            (and
               (jet_encoding.frame_output_cells_at mf bw edge cursor
                  (@Translate.encode jet_sha256_ctx8_init_spec.sha256_ctx8_type
                     (@jet_sha256_ctx8_init_spec.sha256_ctx8_init_spec Alg.CoreFunSem tt)))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bf base bw edge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bf
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
