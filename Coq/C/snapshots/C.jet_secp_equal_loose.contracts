### C.jet_secp_equal_loose.field_equal_loose_diff_bounds
field_equal_loose_diff_bounds
     : forall (rho : forall _ : nat, BinNums.Z)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (field_equal_loose_bounds n)) (rho n))
                (BinInt.Z.le (rho n) (@snd BinNums.Z BinNums.Z (field_equal_loose_bounds n))))
         (n : nat) (_ : and (le (S O) n) (le n (S (S (S (S (S O))))))),
       and (BinInt.Z.le BinNums.Z0 (jet_secp_curve_equal.curve_equal_diff rho n))
         (BinInt.Z.le (jet_secp_curve_equal.curve_equal_diff rho n)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
### C.jet_secp_equal_loose.eval_field_equal_loose_numeric
eval_field_equal_loose_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout jet_secp_curve_equal.curve_equal_regs m)
         (_ : forall n : nat,
              and
                (BinInt.Z.le (@fst BinNums.Z BinNums.Z (field_equal_loose_bounds n)) (Integers.Int64.unsigned (rho n)))
                (BinInt.Z.le (Integers.Int64.unsigned (rho n)) (@snd BinNums.Z BinNums.Z (field_equal_loose_bounds n)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_equal_var)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout (S O))
                        (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val))) Events.E0 mf
               (Values.Vint
                  match
                    BinInt.Z.eqb
                      (BinInt.Z.modulo
                         (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho (S O)))
                            (Integers.Int64.unsigned (rho (S (S O)))) (Integers.Int64.unsigned (rho (S (S (S O)))))
                            (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S O)))))))) jet_secp_fe_math.feP)
                      (BinInt.Z.modulo
                         (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho (S (S (S (S (S (S O))))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S O)))))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S (S O))))))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S (S (S O)))))))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S (S (S (S O)))))))))))))
                         jet_secp_fe_math.feP) return Integers.Int.int
                  with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (and (jet_sx_state.rep rho layout jet_secp_curve_equal.curve_equal_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape jet_secp_curve_equal.curve_equal_regs) b pos)) m mf)))
