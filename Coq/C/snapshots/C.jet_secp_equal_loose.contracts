                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_equal_var)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               (Values.Vint
                  match
                    BinInt.Z.eqb
                      (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value a) jet_secp_fe_math.feP)
                      (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value b) jet_secp_fe_math.feP)
                    return Integers.Int.int
                  with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
