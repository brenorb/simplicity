### C.jet_secp_equal_loose.field_equal_loose_checked
field_equal_loose_checked
     : and
         (@eq (option (prod BinNums.Z BinNums.Z))
            (jet_sx_zval.zb field_equal_loose_bounds jet_secp_curve_equal.curve_equal_ret)
            (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))))
         (and (@eq bool (jet_sx_expr.isk jet_sx_expr.KI jet_secp_curve_equal.curve_equal_ret) true)
            (and
               (@eq (option (prod BinNums.Z BinNums.Z))
                  (jet_sx_zval.zb field_equal_loose_bounds jet_secp_curve_equal.curve_equal_cond)
                  (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))))
