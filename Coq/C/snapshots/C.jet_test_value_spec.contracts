### C.jet_test_value_spec.is_zero_word_spec_parametric
is_zero_word_spec_parametric
     : forall n : nat, @Alg.Core.Parametric (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) (@is_zero_word_spec n)
### C.jet_test_value_spec.is_one_word_spec_parametric
is_one_word_spec_parametric
     : forall n : nat, @Alg.Core.Parametric (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) (@is_one_word_spec n)
### C.jet_test_value_spec.test_value_spec_parametric
test_value_spec_parametric
     : forall (n : nat) (one : bool),
       @Alg.Core.Parametric (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) (@test_value_spec n one)
### C.jet_test_value_spec.is_zero_word_spec_numeric
is_zero_word_spec_numeric
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq bool (Bit.toBool (@is_zero_word_spec n Alg.CoreFunSem x))
         (BinInt.Z.eqb (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) BinNums.Z0)
### C.jet_test_value_spec.word_modulus_at_least_two
word_modulus_at_least_two
     : forall n : nat, BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) (jet_predicate_spec.word_modulus n)
### C.jet_test_value_spec.decrement_payload_zero_iff_one
decrement_payload_zero_iff_one
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq bool
         (BinInt.Z.eqb
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@snd (sum unit unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n)) (@jet_subtract_spec.decrement_word_spec Alg.CoreFunSem n x))) BinNums.Z0)
         (BinInt.Z.eqb (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (BinNums.Zpos BinNums.xH))
### C.jet_test_value_spec.is_one_word_spec_numeric
is_one_word_spec_numeric
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq bool (Bit.toBool (@is_one_word_spec n Alg.CoreFunSem x))
         (BinInt.Z.eqb (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (BinNums.Zpos BinNums.xH))
### C.jet_test_value_spec.test_value_spec_numeric
test_value_spec_numeric
     : forall (n : nat) (one : bool) (x : Ty.tySem (Word.Word n)),
       @eq bool (Bit.toBool (@test_value_spec n one Alg.CoreFunSem x))
         (test_value_numeric one (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
### C.jet_test_value_spec.is_zero_word_spec
is_zero_word_spec =
fun (n : nat) (term : Alg.Core.Algebra) =>
@Bit.not (Word.Word n) term (@jet_predicate_spec.predicate_spec n false term)
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit)

Arguments is_zero_word_spec n%nat_scope {term}
### C.jet_test_value_spec.is_one_word_spec
is_one_word_spec =
fun (n : nat) (term : Alg.Core.Algebra) =>
@jet_subtract_spec.AC.comp (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit) term
  (@jet_subtract_spec.decrement_word_spec term n)
  (@jet_subtract_spec.AC.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term
     (@is_zero_word_spec n term))
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit)

Arguments is_one_word_spec n%nat_scope {term}
### C.jet_test_value_spec.test_value_spec
test_value_spec =
fun (n : nat) (one : bool) (term : Alg.Core.Algebra) =>
match one return (Alg.Core.domain term (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit)) with
| true => @is_one_word_spec n term
| false => @is_zero_word_spec n term
end
     : forall (n : nat) (_ : bool) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit)

Arguments test_value_spec n%nat_scope one%bool_scope {term}
### C.jet_test_value_spec.test_value_numeric
test_value_numeric =
fun (one : bool) (v : BinNums.Z) =>
BinInt.Z.eqb v match one return BinNums.Z with
               | true => BinNums.Zpos BinNums.xH
               | false => BinNums.Z0
               end
     : forall (_ : bool) (_ : BinNums.Z), bool

Arguments test_value_numeric one%bool_scope v%Z_scope
