### C.jet_elements_output_hash_payload.eoh_nonce_len
eoh_nonce_len
     : forall n : option jet_elements_prim.nonce,
       or
         (@eq nat
            (@length Integers.Int.int
               (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
                  (jet_elements_nonce_hash_spec.elements_nonce_bytes (jet_elements_asset_jets.encode_nonce n))))
            (S O))
         (@eq nat
            (@length Integers.Int.int
               (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
                  (jet_elements_nonce_hash_spec.elements_nonce_bytes (jet_elements_asset_jets.encode_nonce n))))
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
### C.jet_elements_output_hash_payload.eval_eoh_payload
eval_eoh_payload
     : forall (_ : jet_memcpy_model.memcpy_model) (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (m : Memory.Mem.mem) (bin : Values.block) (ofs : BinNums.Z)
         (a : jet_elements_prim.assetWith unit) (v : jet_elements_prim.amountWith unit)
         (n : option jet_elements_prim.nonce) (s r : Digest.hash256)
         (_ : jet_elements_support_sha_ctxi.ctxi m bx bm (@nil Integers.Int.int) jet_sha256_iv_init.sha256_iv_words
                Integers.Int64.zero false) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bin bx)) (_ : not (@eq Values.block bin bm))
         (_ : jet_elements_asset_jets.asset_rep m bin ofs a)
         (_ : jet_elements_amount_jets.amount_rep m bin
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))) v)
         (_ : jet_elements_asset_jets.nonce_rep m bin
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))) n)
         (_ : jet_uint32_array_init.uint32_array_at m bin
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                (Digest.hash256_reg s))
         (_ : jet_uint32_array_init.uint32_array_at m bin
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (Digest.hash256_reg r)),
       @ex Memory.Mem.mem
         (fun ma : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mv : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mn : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun ms : Memory.Mem.mem =>
                   @ex Memory.Mem.mem
                     (fun mr : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun mf : Memory.Mem.mem =>
                         @ex Values.val
                           (fun vr : Values.val =>
                            and
                              (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
                                 (@Ctypes.Internal Clight.function jets_elements.f_simplicity_sha256_confAsset)
                                 (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs)) (@nil Values.val)))
                                 Events.E0 ma Values.Vundef)
                              (and
                                 (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge ma
                                    (@Ctypes.Internal Clight.function jets_elements.f_simplicity_sha256_confAmt)
                                    (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                       (@cons Values.val
                                          (Values.Vptr bin
                                             (Integers.Ptrofs.repr
                                                (BinInt.Z.add ofs
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...))))))))
                                          (@nil Values.val))) Events.E0 mv Values.Vundef)
                                 (and
                                    (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge mv
                                       (@Ctypes.Internal Clight.function jets_elements.f_simplicity_sha256_confNonce)
                                       (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                          (@cons Values.val
                                             (Values.Vptr bin
                                                (Integers.Ptrofs.repr
                                                   (BinInt.Z.add ofs
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))
                                             (@nil Values.val))) Events.E0 mn Values.Vundef)
                                    (and
                                       (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge mn
                                          (@Ctypes.Internal Clight.function jets_elements.f_sha256_hash)
                                          (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                             (@cons Values.val
                                                (Values.Vptr bin
                                                   (Integers.Ptrofs.repr
                                                      (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO ...))))))
                                                (@nil Values.val))) Events.E0 ms Values.Vundef)
                                       (and
                                          (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge
                                             ms (@Ctypes.Internal Clight.function jets_elements.f_sha256_hash)
                                             (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                                (@cons Values.val
                                                   (Values.Vptr bin
                                                      (Integers.Ptrofs.repr
                                                         (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO ...)))))
                                                   (@nil Values.val))) Events.E0 mr Values.Vundef)
                                          (and
                                             (ClightBigstep.Clight2.eval_funcall
                                                jet_elements_support_sha_linkage.sha_ge mr
                                                (@Ctypes.Internal Clight.function jets_elements.f_sha256_finalize)
                                                (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                                   (@nil Values.val)) Events.E0 mf vr)
                                             (and
                                                (forall (j : nat) (_ : lt j (S (S (S (...))))),
                                                 @eq (option Values.val)
                                                   (Memory.Mem.load AST.Mint32 mf bm
                                                      (BinInt.Z.add BinNums.Z0
                                                         (BinInt.Z.mul (BinNums.Zpos (...)) (BinInt.Z.of_nat j))))
                                                   (@Some Values.val
                                                      (Values.Vint
                                                         (@List.nth Integers.Int.int j (Digest.hash256_reg (...))
                                                            Integers.Int.zero))))
                                                (and
                                                   (forall (ch : AST.memory_chunk) (b : Values.block)
                                                      (o : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                                                      (_ : not (@eq Values.block b bx))
                                                      (_ : not (@eq Values.block b bm)),
                                                    @eq (option Values.val) (Memory.Mem.load ch mf b o)
                                                      (Memory.Mem.load ch m b o))
                                                   (and
                                                      (forall (b : Values.block) (o : BinNums.Z)
                                                         (k : Memtype.perm_kind) (q : Memtype.permission)
                                                         (_ : Memory.Mem.valid_block m b)
                                                         (_ : Memory.Mem.perm m b o k q), Memory.Mem.perm mf b o k q)
                                                      (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                                       Memory.Mem.valid_block mf b))))))))))))))))
### C.jet_elements_output_hash_payload.eoh_hash_of
eoh_hash_of =
fun (a : jet_elements_prim.assetWith unit) (v : jet_elements_prim.amountWith unit) (n : option jet_elements_prim.nonce)
  (s r : Digest.hash256) =>
jet_bitcoin_composite_hash.sha256_bytes_of
  (jet_elements_output_hash_spec.elements_output_hash_bytes
     (@pair
        (Ty.tySem
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (Ty.tySem
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O))))))))) (jet_elements_asset_jets.encode_asset a)
        (jet_elements_amount_jets.encode_amount v)) (jet_elements_asset_jets.encode_nonce n)
     (Word.from_hash256 s) (Word.from_hash256 r))
     : forall (_ : jet_elements_prim.assetWith unit) (_ : jet_elements_prim.amountWith unit)
         (_ : option jet_elements_prim.nonce) (_ : Digest.hash256) (_ : Digest.hash256), Digest.hash256

Arguments eoh_hash_of a v n s r
