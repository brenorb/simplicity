@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x3 (@pair Values.block Ctypes.type b_x3 curve_fe_type)
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._y2 (@pair Values.block Ctypes.type b_y2 curve_fe_type)
     Clight.empty_env)
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

