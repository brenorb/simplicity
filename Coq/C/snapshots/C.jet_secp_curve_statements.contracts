Clight.Scall result (Clight.Evar id (Clight.type_of_function fd)) args
     : forall (_ : AST.ident) (_ : Clight.function) (_ : option AST.ident) (_ : list Clight.expr), Clight.statement

Arguments curve_call id fd result args%list_scope
### C.jet_secp_curve_statements.curve_square_statement
curve_square_statement =
fun y : bool =>
curve_call jets_secp._secp256k1_fe_sqr jets_secp.f_secp256k1_fe_sqr (@None AST.ident)
  (@cons Clight.expr
     (curve_local_address match y return AST.ident with
                          | true => jets_secp._y2
                          | false => jets_secp._x3
                          end)
     (@cons Clight.expr
        (curve_field_address match y return AST.ident with
                             | true => jets_secp._y
                             | false => jets_secp._x
                             end) (@nil Clight.expr)))
     : forall _ : bool, Clight.statement

Arguments curve_square_statement y%bool_scope
### C.jet_secp_curve_statements.curve_mul_statement
curve_mul_statement =
curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul (@None AST.ident)
  (@cons Clight.expr (curve_local_address jets_secp._x3)
     (@cons Clight.expr (curve_local_address jets_secp._x3)
        (@cons Clight.expr (curve_field_address jets_secp._x) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_curve_statements.curve_add_statement
curve_add_statement =
curve_call jets_secp._secp256k1_fe_add_int jets_secp.f_secp256k1_fe_add_int (@None AST.ident)
  (@cons Clight.expr (curve_local_address jets_secp._x3)
     (@cons Clight.expr
        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) Ctypesdefs.tint)
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_curve_statements.curve_weak_statement
curve_weak_statement =
curve_call jets_secp._secp256k1_fe_normalize_weak jets_secp.f_secp256k1_fe_normalize_weak (@None AST.ident)
  (@cons Clight.expr (curve_local_address jets_secp._x3) (@nil Clight.expr))
     : Clight.statement
### C.jet_secp_curve_statements.curve_equal_statement
curve_equal_statement =
curve_call jets_secp._secp256k1_fe_equal_var jets_secp.f_secp256k1_fe_equal_var (@Some AST.ident jets_secp._t'1)
  (@cons Clight.expr (curve_local_address jets_secp._y2)
     (@cons Clight.expr (curve_local_address jets_secp._x3) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_curve_statements.curve_arithmetic_statement
curve_arithmetic_statement =
Clight.Ssequence (curve_square_statement true)
  (Clight.Ssequence (curve_square_statement false)
     (Clight.Ssequence curve_mul_statement
        (Clight.Ssequence curve_add_statement
           (Clight.Ssequence curve_weak_statement
              (Clight.Ssequence curve_equal_statement
                 (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tint))))))))
     : Clight.statement
### C.jet_secp_curve_statements.curve_flag_statement
curve_flag_statement =
Clight.Ssequence (Clight.Sset jets_secp._t'2 (curve_affine_field jets_secp._infinity Ctypesdefs.tint))
  (Clight.Sifthenelse (Clight.Etempvar jets_secp._t'2 Ctypesdefs.tint)
     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint)))
     Clight.Sskip)
     : Clight.statement
