### C.jet_sha_ctx8_model.be32
be32 =
fun b0 b1 b2 b3 : Integers.Int.int =>
Integers.Int.repr
  (BinInt.Z.add
     (BinInt.Z.add
        (BinInt.Z.add
           (BinInt.Z.mul (Integers.Int.unsigned b0)
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))))))
           (BinInt.Z.mul (Integers.Int.unsigned b1)
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))))))
        (BinInt.Z.mul (Integers.Int.unsigned b2)
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
     (Integers.Int.unsigned b3))
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int),
       Integers.Int.int

Arguments be32 b0 b1 b2 b3
### C.jet_sha_ctx8_model.be_words
be_words =
fix be_words (bs : list Integers.Int.int) : list Integers.Int.int :=
  match bs return (list Integers.Int.int) with
  | nil => @nil Integers.Int.int
  | cons b0 l =>
      match l return (list Integers.Int.int) with
      | nil => @nil Integers.Int.int
      | cons b1 l0 =>
          match l0 return (list Integers.Int.int) with
          | nil => @nil Integers.Int.int
          | cons b2 l1 =>
              match l1 return (list Integers.Int.int) with
              | nil => @nil Integers.Int.int
              | cons b3 rest => @cons Integers.Int.int (be32 b0 b1 b2 b3) (be_words rest)
              end
          end
      end
  end
     : forall _ : list Integers.Int.int, list Integers.Int.int

Arguments be_words bs%list_scope
