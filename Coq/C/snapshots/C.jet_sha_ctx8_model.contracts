  (jet_word32_chunks.word32_chunks (S (S (S O))) h)
     : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))), list Integers.Int.int

Arguments state_regs h
### C.jet_sha_ctx8_model.absorb_step
absorb_step =
fun (st : prod (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int))
  (x : Ty.tySem (Word.Word (S (S (S O))))) =>
let l' : list (Ty.tySem (Word.Word (S (S (S O))))) :=
  @app (Ty.tySem (Word.Word (S (S (S O)))))
    (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) st)
    (@cons (Ty.tySem (Word.Word (S (S (S O))))) x (@nil (Ty.tySem (Word.Word (S (S (S O))))))) in
match
  PeanoNat.Nat.eqb (@length (Ty.tySem (Word.Word (S (S (S O))))) l')
    (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))
  return (prod (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int))
with
| true =>
    @pair (list (Ty.tySem (Word.Word (S (S (S O)))))) SHA256.registers (@nil (Ty.tySem (Word.Word (S (S (S O))))))
      (SHA256.hash_block (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) st)
         (be_words
            (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value l')))
| false =>
    @pair (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) l'
      (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) st)
end
     : forall (_ : prod (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int))
         (_ : Ty.tySem (Word.Word (S (S (S O))))),
       prod (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)

Arguments absorb_step st x
### C.jet_sha_ctx8_model.absorb
absorb =
fun (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
  (bs : list (Ty.tySem (Word.Word (S (S (S O)))))) =>
@List.fold_left (prod (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int))
  (Ty.tySem (Word.Word (S (S (S O))))) absorb_step bs
  (@pair (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) l regs)
     : forall (_ : list (Ty.tySem (Word.Word (S (S (S O)))))) (_ : list Integers.Int.int)
         (_ : list (Ty.tySem (Word.Word (S (S (S O)))))),
       prod (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)

Arguments absorb (l regs bs)%list_scope
