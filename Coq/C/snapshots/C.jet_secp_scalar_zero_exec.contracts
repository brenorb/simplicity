### C.jet_secp_scalar_zero_exec.scalar_zero_run_eq
scalar_zero_run_eq
     : @eq (option jet_sx_exec.res) scalar_zero_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone scalar_zero_state jet_sx_exec.ONormal))
### C.jet_secp_scalar_zero_exec.scalar_zero_return
scalar_zero_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_zero_state))
         (@Some jet_sx_expr.sx scalar_zero_ret)
### C.jet_secp_scalar_zero_exec.scalar_zero_regions
scalar_zero_regions
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs scalar_zero_state) scalar_initial_regs
### C.jet_secp_scalar_zero_exec.scalar_zero_value
scalar_zero_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (jet_sx_expr.den rho layout scalar_zero_ret)
         (Values.Vint
            match Integers.Int64.eq (scalar_or_value rho) Integers.Int64.zero return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
### C.jet_secp_scalar_zero_exec.eval_scalar_zero_from_owned_region
eval_scalar_zero_from_owned_region
     : forall (m : Memory.Mem.mem) (layout : jet_sx_state.layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : jet_sx_state.rep rho layout scalar_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_is_zero)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  match Integers.Int64.eq (scalar_or_value rho) Integers.Int64.zero return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (and (jet_sx_state.rep rho layout scalar_initial_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape scalar_initial_regs) b pos)) m mf)))
### C.jet_secp_scalar_zero_exec.scalar_initial_regs
scalar_initial_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells BinNums.Z0
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O))))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O))))) (@nil jet_sx_expr.sx)))))) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
  (@nil jet_sx_state.region)
     : list jet_sx_state.region
### C.jet_secp_scalar_zero_exec.scalar_zero_run
scalar_zero_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_scalar_is_zero (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0) (@nil jet_sx_expr.sx))
  scalar_initial_regs (@nil jet_sx_eval.event) (S (S (S (S (S O)))))
     : option jet_sx_exec.res
### C.jet_secp_scalar_zero_exec.scalar_zero_tree
scalar_zero_tree =
@Some jet_sx_exec.res
  (jet_sx_exec.RDone
     (jet_sx_eval.mkst
        (@Maps.PTree.Nodes jet_sx_expr.sx
           (@Maps.PTree.Node010 jet_sx_expr.sx
              (jet_sx_expr.XLcmp Integers.Ceq Ctypes.Unsigned
                 (jet_sx_expr.XLb jet_sx_expr.Bor
                    (jet_sx_expr.XLb jet_sx_expr.Bor
                       (jet_sx_expr.XLb jet_sx_expr.Bor (jet_sx_expr.XLv (S O)) (jet_sx_expr.XLv (S (S O))))
                       (jet_sx_expr.XLv (S (S (S O))))) (jet_sx_expr.XLv (S (S (S (S O))))))
                 (jet_sx_expr.XI2L Ctypes.Signed
                    (jet_sx_expr.XIc (Integers.Int.mkint BinNums.Z0 (Integers.Int.Z_mod_modulus_range' BinNums.Z0)))))))
        (@cons jet_sx_state.region
           (jet_sx_state.mkreg
              (@cons jet_sx_state.cell
                 (jet_sx_state.mkcell BinNums.Z0 AST.Mint64 (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S O))))
                 (@cons jet_sx_state.cell
                    (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
                       (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))))
                    (@cons jet_sx_state.cell
                       (jet_sx_state.mkcell
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) AST.Mint64
                          (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O))))))
                       (@cons jet_sx_state.cell
                          (jet_sx_state.mkcell
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) AST.Mint64
                             (@Some jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O))))))) (@nil jet_sx_state.cell)))))
              true
              (@Some BinNums.Z
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
           (@nil jet_sx_state.region)) (@nil jet_sx_eval.event) (S (S (S (S (S O)))))) jet_sx_exec.ONormal)
     : option jet_sx_exec.res
### C.jet_secp_scalar_zero_exec.scalar_zero_state
scalar_zero_state =
match scalar_zero_tree return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone state _ => state
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_scalar_zero_exec.scalar_zero_ret
scalar_zero_ret =
jet_sx_expr.XLcmp Integers.Ceq Ctypes.Unsigned
  (jet_sx_expr.XLb jet_sx_expr.Bor
     (jet_sx_expr.XLb jet_sx_expr.Bor
        (jet_sx_expr.XLb jet_sx_expr.Bor (jet_sx_expr.XLv (S O)) (jet_sx_expr.XLv (S (S O))))
        (jet_sx_expr.XLv (S (S (S O))))) (jet_sx_expr.XLv (S (S (S (S O))))))
  (jet_sx_expr.XI2L Ctypes.Signed
     (jet_sx_expr.XIc (Integers.Int.mkint BinNums.Z0 (Integers.Int.Z_mod_modulus_range' BinNums.Z0))))
     : jet_sx_expr.sx
### C.jet_secp_scalar_zero_exec.scalar_or_value
scalar_or_value =
fun rho : forall _ : nat, Integers.Int64.int =>
Integers.Int64.or (Integers.Int64.or (Integers.Int64.or (rho (S O)) (rho (S (S O)))) (rho (S (S (S O)))))
  (rho (S (S (S (S O)))))
     : forall _ : forall _ : nat, Integers.Int64.int, Integers.Int64.int

Arguments scalar_or_value rho%function_scope
