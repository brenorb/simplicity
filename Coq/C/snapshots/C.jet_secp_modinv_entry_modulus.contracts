### C.jet_secp_modinv_entry_modulus.inv_mod_init_state
inv_mod_init_state =
fun mu : forall _ : nat, Integers.Int64.int =>
match inv_mod_init_run mu return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ => inv_mod_start_state mu
    end
| None => inv_mod_start_state mu
