### C.jet_secp_multiply_input_reader.pair_input_windows
pair_input_windows
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z)
         (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))),
       and
         (jet_encoding.frame_input_cells_at m bi edge rc
            (@List.map bool (option bool) (@Some bool)
               (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) x)))
         (jet_encoding.frame_input_cells_at m bi edge
            (BinInt.Z.add rc
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
            (@List.map bool (option bool) (@Some bool)
               (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) y)))
### C.jet_secp_multiply_input_reader.local_read_selected_frame
local_read_selected_frame
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (bi : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list jet_sx_state.cell)
         (jet_sx_state.rcells
            (@List.nth jet_sx_state.region (S O)
               (jet_sx_eval.sregs
                  (@fst jet_sx_eval.sstate jet_sx_exec.xout
                     (jet_sx_exec.rsel rho layout (jet_secp_local_regions.local_read_result bi edge))))
               (jet_sx_state.mkreg (@nil jet_sx_state.cell) true (@None BinNums.Z))))
         (jet_secp_frame.mk_frame_cells (jet_sx_expr.XA bi edge)
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_multiply_input_reader.local_read_final_cursor
local_read_final_cursor
     : forall (bits : list bool) (rc : BinNums.Z) (m : Memory.Mem.mem) (ba bl bi : Values.block)
         (edge : BinNums.Z)
         (_ : jet_sx_state.rep (jet_secp_wrapper_run.read_fe_rho bits rc)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (jet_sx_eval.sregs
                   (@fst jet_sx_eval.sstate jet_sx_exec.xout
                      (jet_sx_exec.rsel (jet_secp_wrapper_run.read_fe_rho bits rc)
                         (jet_sx_state.lay
                            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                  (@nil (prod Values.block BinNums.Z)))))
                         (jet_secp_local_regions.local_read_result bi (Integers.Ptrofs.repr edge))))) m),
       jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge
         (BinInt.Z.add rc
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_multiply_input_reader.two_read_foot_owner
two_read_foot_owner
     : forall (a l bi : Values.block) (edge : Integers.Ptrofs.int) (b : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z a BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z l BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   (jet_secp_local_regions.local_read_initial_regs bi edge)) b pos),
       or (@eq Values.block b a) (@eq Values.block b l)
### C.jet_secp_multiply_input_reader.reader_preserves_other
reader_preserves_other
     : forall (ext : forall _ : Values.block, Prop) (a l bi : Values.block) (edge : Integers.Ptrofs.int)
         (m mf : Memory.Mem.mem) (other : Values.block) (_ : not (@eq Values.block other a))
         (_ : not (@eq Values.block other l)) (_ : not (ext other)) (_ : Memory.Mem.valid_block m other)
         (_ : jet_sx_mem.lframe
                (jet_sx_exec.frame ext
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z a BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z l BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))
                   (jet_secp_local_regions.local_read_initial_regs bi edge) m) m mf),
       jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => @eq Values.block b other) m mf
### C.jet_secp_multiply_input_reader.eval_read_fe_with_cursor
eval_read_fe_with_cursor
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bl : Values.block) (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) x)))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : not (@eq Values.block ba bl))
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi m false (@nil BitMachine.Cell)),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mr ba BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_fe_math.fe_limbs_of (jet_secp_multiply_input_input.normalized_value x))))
               (and
                  (Memory.Mem.range_perm mr ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mr bl BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                        Memtype.Freeable)
                     (and
                        (jet_frame_layout.frame_fields_at mr bl BinNums.Z0 bi edge
                           (BinInt.Z.add rc
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                        (and (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi mr false (@nil BitMachine.Cell))
                           (jet_sx_mem.lframe
                              (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))))
                                 (jet_secp_local_regions.local_read_initial_regs bi (Integers.Ptrofs.repr edge)) m) m
                              mr)))))))
