### C.jet_secp_swu_before_roots.swu_through_cubics_source
swu_through_cubics_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_shallue_van_de_woestijne)
         (jet_secp_statement_prefix.statement_sequence swu_through_cubics_statements
            jet_secp_swu_cubics.swu_after_cubics)
### C.jet_secp_swu_before_roots.exec_swu_through_cubics
exec_swu_through_cubics
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (bt bw ba bx bj bb bc bA bB bC : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_clight_internal_frame.plain_env e)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._negc e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_inv_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._d e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._wd e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bw jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._jinv e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bj jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._alphain e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bA jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._betain e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bB jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._gammain e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bC jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t le)
                (@Some Values.val (Values.Vptr bt Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bt
                   (@cons Values.block bw
                      (@cons Values.block ba
                         (@cons Values.block bx
                            (@cons Values.block bj
                               (@cons Values.block bb
                                  (@cons Values.block bc
                                     (@cons Values.block bA
                                        (@cons Values.block bB (@cons Values.block bC (@nil Values.block))))))))))))
         (_ : jet_secp_swu_startup.swu_startup m) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : @List.Forall Values.block
                (fun bi : Values.block =>
                 Memory.Mem.range_perm m bi BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   Memtype.Cur Memtype.Freeable)
                (@cons Values.block bt
                   (@cons Values.block bw
                      (@cons Values.block ba
                         (@cons Values.block bx
                            (@cons Values.block bj
                               (@cons Values.block bb
                                  (@cons Values.block bc
                                     (@cons Values.block bA
                                        (@cons Values.block bB (@cons Values.block bC (@nil Values.block)))))))))))),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun inv : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_through_cubics Events.E0 le mf
                  ClightBigstep.Out_normal)
               (and (jet_secp_fe_nv.fe_at mf bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and
                     (jet_secp_fe_nv.fe_at mf bw BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_swu_joint_setup.swu_setup_wd (jet_secp_square_numeric.square_words w))))
                     (and
                        (jet_secp_fe_nv.fe_at mf ba BinNums.Z0
                           (jet_secp_multiply_normalize_bridge.words5
                              (jet_secp_swu_second_candidate.swu_input_first_words w inv)))
                        (and
                           (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                              (jet_secp_multiply_normalize_bridge.words5
                                 (jet_secp_swu_joint_setup.swu_setup_x3d (jet_secp_square_numeric.square_words w))))
                           (and (jet_secp_fe_nv.fe_at mf bj BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                              (and
                                 (jet_secp_fe_nv.fe_at mf bb BinNums.Z0
                                    (jet_secp_multiply_normalize_bridge.words5
                                       (jet_secp_swu_second_candidate.swu_second_words
                                          (jet_secp_swu_second_candidate.swu_input_first_words w inv))))
                                 (and
                                    (jet_secp_fe_nv.fe_at mf bc BinNums.Z0
                                       (jet_secp_multiply_normalize_bridge.words5
                                          (jet_secp_swu_third_candidate.swu_input_third_words w inv)))
                                    (and
                                       (jet_secp_fe_nv.fe_at mf bA BinNums.Z0
                                          (jet_secp_multiply_normalize_bridge.words5
                                             (jet_secp_swu_cubics.swu_cubic_words
                                                (jet_secp_swu_second_candidate.swu_input_first_words w inv))))
                                       (and
                                          (jet_secp_fe_nv.fe_at mf bB BinNums.Z0
                                             (jet_secp_multiply_normalize_bridge.words5
                                                (jet_secp_swu_cubics.swu_cubic_words
                                                   (jet_secp_swu_second_candidate.swu_second_words
                                                      (jet_secp_swu_second_candidate.swu_input_first_words w inv)))))
                                          (and
                                             (jet_secp_fe_nv.fe_at mf bC BinNums.Z0
                                                (jet_secp_multiply_normalize_bridge.words5
                                                   (jet_secp_swu_cubics.swu_cubic_words
                                                      (jet_secp_swu_third_candidate.swu_input_third_words w inv))))
                                             (and
                                                (@List.Forall Values.block
                                                   (fun bi : Values.block =>
                                                    Memory.Mem.range_perm mf bi BinNums.Z0
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                      Memtype.Cur Memtype.Freeable)
                                                   (@cons Values.block bt
                                                      (@cons Values.block bw
                                                         (@cons Values.block ba
                                                            (@cons Values.block bx
                                                               (@cons Values.block bj
                                                                  (@cons Values.block bb (@cons Values.block bc (...)))))))))
                                                (and (jet_secp_square_columns.square_input_bounds inv)
                                                   (and
                                                      (jet_secp_square_columns.square_input_bounds
                                                         (jet_secp_swu_second_candidate.swu_input_first_words w inv))
                                                      (and
                                                         (jet_secp_square_columns.square_input_bounds
                                                            (jet_secp_swu_second_candidate.swu_second_words
                                                               (jet_secp_swu_second_candidate.swu_input_first_words w
                                                                  inv)))
                                                         (and
                                                            (jet_secp_square_columns.square_input_bounds
                                                               (jet_secp_swu_third_candidate.swu_input_third_words w
                                                                  inv))
                                                            (and
                                                               (@List.Forall (forall _ : nat, Integers.Int64.int)
                                                                  (jet_secp_field_sum_bounds.field_scaled_bounds
                                                                     (BinNums.Zpos (...)))
                                                                  (@cons (forall ..., Integers.Int64.int)
                                                                     (jet_secp_swu_cubics.swu_cubic_words (...))
                                                                     (@cons (...) (...) (...))))
                                                               (and
                                                                  (@List.Forall (forall ..., Integers.Int64.int)
                                                                     jet_secp_square_columns.square_input_bounds
                                                                     (@cons (...) (...) (...)))
                                                                  (and (Zdiv.eqm jet_secp_fe_math.feP (...) (...))
                                                                     (and (...) (...))))))))))))))))))))))
### C.jet_secp_swu_before_roots.swu_through_cubics_statements
swu_through_cubics_statements =
@app Clight.statement jet_secp_swu_third_candidate.swu_through_third_statements
  jet_secp_swu_cubics.swu_cubics_statements
     : list Clight.statement
### C.jet_secp_swu_before_roots.swu_through_cubics
swu_through_cubics =
jet_secp_statement_prefix.statement_sequence swu_through_cubics_statements Clight.Sskip
     : Clight.statement
