### C.jet_secp_reduce512_checkpoint.tmatch_checkpoint_set
tmatch_checkpoint_set
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (ts : Maps.PTree.t jet_sx_expr.sx) (le : Clight.temp_env) (id : BinNums.positive)
         (x : jet_sx_expr.sx) (_ : jet_sx_eval.tmatch rho beta ts le)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta) x))),
       jet_sx_eval.tmatch rho beta (@Maps.PTree.set jet_sx_expr.sx id x ts) le
### C.jet_secp_reduce512_checkpoint.first_checkpoint_m6_bound
first_checkpoint_m6_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned (first_checkpoint_m6 rho)))
         (BinInt.Z.le (Integers.Int.unsigned (first_checkpoint_m6 rho)) (BinNums.Zpos BinNums.xH))
### C.jet_secp_reduce512_checkpoint.first_checkpoint_values
first_checkpoint_values
     : forall rho : forall _ : nat, Integers.Int64.int,
       and
         (@eq BinNums.Z (jet_secp_reduce512_typed_value.stage_low256 (first_checkpoint_digits rho))
            (jet_secp_reduce512_fold_bounds.first_low256 rho))
         (@eq BinNums.Z
            (jet_secp_reduce512_typed_value.stage_high256 (first_checkpoint_digits rho) (first_checkpoint_m6 rho))
            (jet_secp_reduce512_fold_bounds.first_high256 rho))
### C.jet_secp_reduce512_checkpoint.first_checkpoint_second_value
first_checkpoint_second_value
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (jet_secp_scalar_mul512_accumulate.column_words_value
            (jet_secp_reduce512_typed_atomic.stage_machine_outputs (first_checkpoint_digits rho)
               (first_checkpoint_m6 rho))) (jet_secp_reduce512_fold_bounds.second_fold_bridge_value rho)
### C.jet_secp_reduce512_checkpoint.first_checkpoint_p4_bound
first_checkpoint_p4_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and
         (BinInt.Z.le BinNums.Z0
            (jet_secp_reduce512_typed_value.stage_p4_integer (first_checkpoint_digits rho) (first_checkpoint_m6 rho)))
         (BinInt.Z.le
            (jet_secp_reduce512_typed_value.stage_p4_integer (first_checkpoint_digits rho) (first_checkpoint_m6 rho))
            (BinNums.Zpos (BinNums.xO BinNums.xH)))
### C.jet_secp_reduce512_checkpoint.first_raw_checkpoint_sources
first_raw_checkpoint_sources
     : and
         (@eq (option jet_sx_expr.sx)
            (@Maps.PTree.get jet_sx_expr.sx jets_secp._r
               (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state))
            (@Some jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)))
         (and
            (@eq (option jet_sx_expr.sx)
               (@Maps.PTree.get jet_sx_expr.sx jets_secp._l
                  (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state))
               (@Some jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0)))
            (and
               (@eq (option jet_sx_expr.sx)
                  (@Maps.PTree.get jet_sx_expr.sx jets_secp._m0
                     (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state))
                  (@Some jet_sx_expr.sx
                     (jet_secp_scalar_mul512_symbolic.sc_lo jet_secp_reduce512_first_symbolic.first_sy0)))
               (and
                  (@eq (option jet_sx_expr.sx)
                     (@Maps.PTree.get jet_sx_expr.sx jets_secp._m1
                        (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state))
                     (@Some jet_sx_expr.sx
                        (jet_secp_scalar_mul512_symbolic.sc_lo jet_secp_reduce512_first_symbolic.first_sy1)))
                  (and
                     (@eq (option jet_sx_expr.sx)
                        (@Maps.PTree.get jet_sx_expr.sx jets_secp._m2
                           (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state))
                        (@Some jet_sx_expr.sx
                           (jet_secp_scalar_mul512_symbolic.sc_lo jet_secp_reduce512_first_symbolic.first_sy2)))
                     (and
                        (@eq (option jet_sx_expr.sx)
                           (@Maps.PTree.get jet_sx_expr.sx jets_secp._m3
                              (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state))
                           (@Some jet_sx_expr.sx
                              (jet_secp_scalar_mul512_symbolic.sc_lo jet_secp_reduce512_first_symbolic.first_sy3)))
                        (and
                           (@eq (option jet_sx_expr.sx)
                              (@Maps.PTree.get jet_sx_expr.sx jets_secp._m4
                                 (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state))
                              (@Some jet_sx_expr.sx
                                 (jet_secp_scalar_mul512_symbolic.sc_lo jet_secp_reduce512_first_symbolic.first_sy4)))
                           (and
                              (@eq (option jet_sx_expr.sx)
                                 (@Maps.PTree.get jet_sx_expr.sx jets_secp._m5
                                    (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state))
                                 (@Some jet_sx_expr.sx
                                    (jet_secp_scalar_mul512_symbolic.sc_lo jet_secp_reduce512_first_symbolic.first_sy5)))
                              (@eq (option jet_sx_expr.sx)
                                 (@Maps.PTree.get jet_sx_expr.sx jets_secp._m6
                                    (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state))
                                 (@Some jet_sx_expr.sx
                                    (jet_sx_expr.XL2I
                                       (jet_secp_scalar_mul512_symbolic.sc_hi
                                          jet_secp_reduce512_first_symbolic.first_sy5)))))))))))
### C.jet_secp_reduce512_checkpoint.first_checkpoint_tmatch
first_checkpoint_tmatch
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (le : Clight.temp_env)
         (_ : jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps jet_secp_reduce512_first_run.reduce512_first_state) le),
       jet_sx_eval.tmatch rho beta
         (jet_secp_reduce512_typed_stage.reduce512_typed_stage_temps (first_checkpoint_digits rho)
            (first_checkpoint_m6 rho)) le
### C.jet_secp_reduce512_checkpoint.first_checkpoint_digits
first_checkpoint_digits =
fun (rho : forall _ : nat, Integers.Int64.int) (n : nat) =>
match n return Integers.Int64.int with
| O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_first_symbolic.first_ma0 rho)
| S n0 =>
    match n0 return Integers.Int64.int with
    | O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_first_symbolic.first_ma1 rho)
    | S n1 =>
        match n1 return Integers.Int64.int with
        | O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_first_symbolic.first_ma2 rho)
        | S n2 =>
            match n2 return Integers.Int64.int with
            | O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_first_symbolic.first_ma3 rho)
            | S n3 =>
                match n3 return Integers.Int64.int with
                | O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_first_symbolic.first_ma4 rho)
                | S n4 =>
                    match n4 return Integers.Int64.int with
                    | O => jet_secp_reduce512_wide.wlo (jet_secp_reduce512_first_symbolic.first_ma5 rho)
                    | S _ => Integers.Int64.zero
                    end
                end
            end
        end
    end
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments first_checkpoint_digits rho%function_scope n%nat_scope
### C.jet_secp_reduce512_checkpoint.first_checkpoint_m6
first_checkpoint_m6 =
fun rho : forall _ : nat, Integers.Int64.int =>
Integers.Int64.loword (jet_secp_reduce512_wide.whi (jet_secp_reduce512_first_symbolic.first_ma5 rho))
     : forall _ : forall _ : nat, Integers.Int64.int, Integers.Int.int

Arguments first_checkpoint_m6 rho%function_scope
