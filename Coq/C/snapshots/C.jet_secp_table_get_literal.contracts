### C.jet_secp_table_get_literal.lookup5_decoded_normalized
lookup5_decoded_normalized
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem
            (jet_secp_rescale_literal.rescale_field_output w)) (jet_secp_rescale_literal.rescale_field_output w)
### C.jet_secp_table_get_literal.lookup5_decoded_negative
lookup5_decoded_negative
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_field_mul_small.mul_small_input_bounds w),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_rescale_literal.rescale_field_output (jet_secp_field_negate_separate.negate_sep_words w))
         (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem
            (jet_secp_rescale_literal.rescale_field_output w))
### C.jet_secp_table_get_literal.eval_table_get_lookup5
eval_table_get_lookup5
     : forall (nib : Ty.tySem (Word.Word (S (S O)))) (xs ys : forall (_ : nat) (_ : nat), Integers.Int64.int)
         (m : Memory.Mem.mem) (bd bt : Values.block) (_ : not (@eq Values.block bd bt))
         (_ : jet_secp_globalz_loop.globalz_table_rep m bt xs ys)
         (_ : jet_secp_globalz_loop.globalz_table_bounds xs ys)
         (_ : forall (k : nat) (_ : lt k (S (S (S (S (S (S (S (S O))))))))),
              jet_secp_field_mul_small.mul_small_input_bounds (ys k))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       let j : nat := BinInt.Z.to_nat (jet_secp_lookup5_literal.lookup5_index nib) in
       let outy : forall _ : nat, Integers.Int64.int :=
         match jet_secp_lookup5_literal.lookup5_negative nib return (forall _ : nat, Integers.Int64.int) with
         | true => jet_secp_field_negate_separate.negate_sep_words (ys j)
         | false => ys j
         end in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult_table_get_ge)
               (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vint (Integers.Int.repr (jet_secp_lookup5_literal.lookup5_digit nib)))
                        (@cons Values.val
                           (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                           (@nil Values.val))))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf bd BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (xs j)))
               (and
                  (jet_secp_fe_nv.fe_at mf bd
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 outy))
                  (and
                     (@eq
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (jet_secp_rescale_literal.rescale_field_output (xs j))
                           (jet_secp_rescale_literal.rescale_field_output outy))
                        (@jet_secp_lookup5_literal.literal_lookup5 Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S O))))
                              (Ty.tySem (jet_secp_scalar_table_literal.literal_table_vector (S (S (S O))))) nib
                              (jet_secp_globalz_pass2.globalz_word_vector
                                 (jet_secp_globalz_word_walk.globalz_decoded_points xs ys)))))
                     (and (jet_secp_square_columns.square_input_bounds (xs j))
                        (and (jet_secp_square_columns.square_input_bounds outy)
                           (and
                              (@eq (option Values.val)
                                 (Memory.Mem.load AST.Mint32 mf bd
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                 (@Some Values.val (Values.Vint Integers.Int.zero)))
                              (and
                                 (Memory.Mem.range_perm mf bd BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bt BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and (jet_clight_internal_permissions.keeps_permissions m mf)
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m
                                             mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))))))))
