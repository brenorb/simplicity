### C.jet_secp_pubkey_load_coordinates.affine_storage_coord_canonical
affine_storage_coord_canonical
     : forall (w : forall _ : nat, Integers.Int64.int) (k : bool),
       @eq (list Integers.Int64.int)
         (jet_secp_multiply_normalize_bridge.words5 (jet_secp_affine_storage.affine_storage_coord w k))
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_fe_math.fe_limbs_of
               (jet_secp_storage_numeric.field_storage_value
                  (fun i : nat => w (Nat.add match k return nat with
                                             | true => S (S (S (S O)))
                                             | false => O
                                             end i)))))
### C.jet_secp_pubkey_load_coordinates.pubkey_storage_accept_curve
pubkey_storage_accept_curve
     : forall (w : forall _ : nat, Integers.Int64.int) (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq BinNums.Z (jet_secp_storage_numeric.field_storage_value w)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))) true),
       @eq bool (jet_secp_pubkey_load_body.pubkey_storage_accept w) true
### C.jet_secp_pubkey_load_coordinates.eval_xonly_pubkey_load_coordinates
eval_xonly_pubkey_load_coordinates
     : forall (_ : jet_memcpy_model.memcpy_model) (w : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bin : Values.block) (base : BinNums.Z) (bout : Values.block)
         (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_affine_storage.affine_storage_readable m bin base w)
         (_ : @eq BinNums.Z (jet_secp_storage_numeric.field_storage_value w)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
         (_ : @eq BinNums.Z
                (jet_secp_storage_numeric.field_storage_value (fun i : nat => w (Nat.add (S (S (S (S O)))) i)))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))) true),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_xonly_pubkey_load)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               (Values.Vint Integers.Int.one))
            (and
               (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_fe_math.fe_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))))
               (and
                  (jet_secp_fe_nv.fe_at mf bout
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_fe_math.fe_limbs_of
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bout
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (Memory.Mem.range_perm mf bout BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout))
                              m mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))
