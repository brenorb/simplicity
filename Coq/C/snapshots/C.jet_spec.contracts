### C.jet_spec.left_pad_low_1_n
left_pad_low_1_n =
fix left_pad_low_1_n (term : Alg.Core.Algebra) (n : nat) {struct n} :
    Alg.Core.domain term (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) :=
  match n as n0 return (Alg.Core.domain term (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n0)) with
  | O => @Alg.Core.Combinators.iden (Ty.Sum Ty.Unit Ty.Unit) term
  | S n0 =>
      @Alg.Core.Combinators.pair (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n0) (Word.Word n0) term
        (@Word.fill (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit) n0 term
           (@Alg.Core.Combinators.comp (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) term
              (@Alg.Core.Combinators.unit (Ty.Sum Ty.Unit Ty.Unit) term) (@Bit.false Ty.Unit term)))
        (left_pad_low_1_n term n0)
  end
     : forall (term : Alg.Core.Algebra) (n : nat), Alg.Core.domain term (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)

Arguments left_pad_low_1_n {term} n%nat_scope
### C.jet_spec.left_pad_low_1_8
left_pad_low_1_8 =
fun term : Alg.Core.Algebra => @left_pad_low_1_n term (S (S (S O)))
     : forall term : Alg.Core.Algebra, Alg.Core.domain term (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))

Arguments left_pad_low_1_8 {term}
### C.jet_spec.one8_spec
one8_spec =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))) term
  (@Bit.true Ty.Unit term) (@left_pad_low_1_8 term)
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit (Word.Word (S (S (S O))))

Arguments one8_spec {term}
### C.jet_spec.full_increment8_spec
full_increment8_spec =
fun term : Alg.Core.Algebra => @jet_increment_spec.full_increment_word_spec term (S (S (S O)))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))

Arguments full_increment8_spec {term}
### C.jet_spec.increment8_spec
increment8_spec =
fun term : Alg.Core.Algebra => @jet_increment_spec.increment_word_spec term (S (S (S O)))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S O)))) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))

Arguments increment8_spec {term}
### C.jet_spec.increment8_spec_value
increment8_spec_value =
@increment8_spec Alg.CoreFunSem
     : forall _ : Ty.tySem (Word.Word (S (S (S O)))),
       Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
### C.jet_spec.one8_spec_value
one8_spec_value = @one8_spec Alg.CoreFunSem tt
     : Ty.tySem (Word.Word (S (S (S O))))
### C.jet_spec.decode_word8
decode_word8 =
fun w : Integers.Int64.int => @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O)))) (Integers.Int64.unsigned w)
     : forall _ : Integers.Int64.int, Ty.tySem (Word.Word (S (S (S O))))

Arguments decode_word8 w
### C.jet_spec.one8_output_spec
one8_output_spec =
fun (m : Memory.Mem.mem) (bw : Values.block) =>
@ex Integers.Int64.int
  (fun w : Integers.Int64.int =>
   and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw BinNums.Z0) (@Some Values.val (Values.Vlong w)))
     (@eq (Ty.tySem (Word.Word (S (S (S O))))) (decode_word8 w) one8_spec_value))
     : forall (_ : Memory.Mem.mem) (_ : Values.block), Prop

Arguments one8_output_spec m bw
### C.jet_spec.full_increment8_spec
full_increment8_spec =
fun term : Alg.Core.Algebra => @jet_increment_spec.full_increment_word_spec term (S (S (S O)))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))

Arguments full_increment8_spec {term}
