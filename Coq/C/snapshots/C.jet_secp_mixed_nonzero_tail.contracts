### C.jet_secp_mixed_nonzero_tail.mixed_nonzero_tail_frame
mixed_nonzero_tail_frame =
fun (bp bh b2 b3 bt bu bi bs bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bh))
  (and (not (@eq Values.block bx b2))
     (and (not (@eq Values.block bx b3))
        (and (not (@eq Values.block bx bt))
           (and (not (@eq Values.block bx bu))
              (and (not (@eq Values.block bx bi))
                 (and (not (@eq Values.block bx bs))
                    (or (not (@eq Values.block bx bp))
                       (or (BinInt.Z.lt pos BinNums.Z0)
                          (BinInt.Z.le
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                             pos)))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments mixed_nonzero_tail_frame bp bh b2 b3 bt bu bi bs bx pos%Z_scope
