### C.jet_elements_taptweak_split_rounding.elements_taptweak_rounding_frame
elements_taptweak_rounding_frame =
fun (bk bc1 bc2 b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b bc1))
  (and (not (@eq Values.block b bc2))
     (and (not (@eq Values.block b bk))
        (and (not (@eq Values.block b (jet_elements_taptweak_split_constants.elements_taptweak_multiplier_block true)))
           (not (@eq Values.block b (jet_elements_taptweak_split_constants.elements_taptweak_multiplier_block false))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments elements_taptweak_rounding_frame bk bc1 bc2 b _%Z_scope
