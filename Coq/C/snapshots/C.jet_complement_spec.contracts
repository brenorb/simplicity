### C.jet_complement_spec.complement_spec_parametric
complement_spec_parametric
     : forall n : nat, @Alg.Core.Parametric (Word.Word n) (Word.Word n) (@complement_spec n)
### C.jet_complement_spec.complement_int_denotes
complement_int_denotes
     : forall (n : nat) (x : Ty.tySem (Word.Word n)) (r : Integers.Int.int)
         (_ : BinInt.Z.le (Zpower.two_power_nat n)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : @eq BinNums.Z (Integers.Int.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)),
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ n) (Integers.Int.unsigned (Integers.Int.not r)))
         (@complement_spec n Alg.CoreFunSem x)
### C.jet_complement_spec.complement_int64_denotes
complement_int64_denotes
     : forall (n : nat) (x : Ty.tySem (Word.Word n)) (r : Integers.Int64.int)
         (_ : BinInt.Z.le (Zpower.two_power_nat n)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)),
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ n) (Integers.Int64.unsigned (Integers.Int64.not r)))
         (@complement_spec n Alg.CoreFunSem x)
### C.jet_complement_spec.complement_spec
complement_spec =
fix complement_spec (n : nat) (term : Alg.Core.Algebra) {struct n} :
    Alg.Core.domain term (Word.Word n) (Word.Word n) :=
  match n as n0 return (Alg.Core.domain term (Word.Word n0) (Word.Word n0)) with
  | O => @Bit.not (Ty.Sum Ty.Unit Ty.Unit) term (@Alg.Core.Combinators.iden (Ty.Sum Ty.Unit Ty.Unit) term)
  | S n0 =>
      @Alg.Core.Combinators.pair (Word.Word (S n0)) (Word.Word n0) (Word.Word n0) term
        (@Alg.Core.Combinators.take (Word.Word n0) (Word.Word n0) (Word.Word n0) term (complement_spec n0 term))
        (@Alg.Core.Combinators.drop (Word.Word n0) (Word.Word n0) (Word.Word n0) term (complement_spec n0 term))
  end
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (Word.Word n) (Word.Word n)

Arguments complement_spec n%nat_scope {term}
