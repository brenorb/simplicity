### C.jet_complement1_layout.eval_complement1_layout_matches_spec
eval_complement1_layout_matches_spec
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (x : Ty.tySem (Word.Word O)) (cursor rc : BinNums.Z) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))))
         (_ : jet_input_layout.frame_input_bit_at m bi edge rc (Bit.toBool x))
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor (BinNums.Zpos BinNums.xH)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function jets.f_simplicity_complement_1)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Word.Word O) (@jet_complement_spec.complement_spec O Alg.CoreFunSem x)))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_complement1_layout.complement1_local_spec
complement1_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_complement_1 (Word.Word O) (Word.Word O)
         (fun x : Ty.tySem (Word.Word O) => @jet_complement_spec.complement_spec O Alg.CoreFunSem x)
### C.jet_complement1_layout.complement1_context
complement1_context
     : @jet_canonical.jet_context_for jets.f_simplicity_complement_1 (Word.Word O) (Word.Word O)
         (@jet_complement_spec.complement_spec O)
### C.jet_complement1_layout.complement1_guarantees
complement1_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Word.Word O)) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (Translate.bitSize (Word.Word O))))
                Integers.Int64.max_unsigned)
         (_ : jet_encoding.frame_input_cells_at m bi edge read_cursor (@Translate.encode (Word.Word O) a))
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.of_nat (Translate.bitSize (Word.Word O)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function jets.f_simplicity_complement_1)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Word.Word O) (@jet_complement_spec.complement_spec O Alg.CoreFunSem a)))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize (Word.Word O)))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize (Word.Word O))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_complement1_layout.complement1_context_guarantees
complement1_context_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : jet_bitmachine_rep.bm_layout) (ctx : BitMachine.Context)
         (a : Ty.tySem (Word.Word O)),
       let s0 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState (@Translate.encode (Word.Word O) a)
              (BitMachine.newWriteFrame (Translate.bitSize (Word.Word O)))) in
       let s1 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState (@Translate.encode (Word.Word O) a)
              (BitMachine.fullWriteFrame
                 (@Translate.encode (Word.Word O) (@jet_complement_spec.complement_spec O Alg.CoreFunSem a)))) in
       forall (_ : jet_bitmachine_rep.bm_rep m L s0) (_ : jet_bitmachine_rep.bm_separated L s0)
         (_ : jet_bitmachine_rep.active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function jets.f_simplicity_complement_1) (jet_bitmachine_rep.jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (jet_bitmachine_rep.bm_rep mf L s1)
               (BitMachine.runProgram (@jet_complement_spec.complement_spec O Translate.Naive.translate)
                  (BitMachine.Running s0) (BitMachine.Running s1))))
