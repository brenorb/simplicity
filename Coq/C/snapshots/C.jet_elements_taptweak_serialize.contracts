### C.jet_elements_taptweak_serialize.elements_taptweak_serialize_lookup
elements_taptweak_serialize_lookup
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef)
            (jet_secp_linkage.secp_helper_lookup jet_elements_taptweak_pure.elements_taptweak_ge)
            elements_taptweak_serialize_helpers)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun it : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function it)))
            elements_taptweak_serialize_helpers)
### C.jet_elements_taptweak_serialize.elements_taptweak_serialize_x_checked
elements_taptweak_serialize_x_checked
     : @eq bool
         (jet_transport.expr_okb jet_secp_linkage.secp_ge jet_elements_taptweak_pure.elements_taptweak_ge
            jet_secp_schnorr_serialize_return.schnorr_key_x_address) true
### C.jet_elements_taptweak_serialize.eval_elements_taptweak_serialize_x
eval_elements_taptweak_serialize_x
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (b : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._pk e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b jet_secp_curve_statements.curve_ge_type))),
       Clight.eval_expr jet_elements_taptweak_pure.elements_taptweak_ge e le m
         jet_secp_schnorr_serialize_return.schnorr_key_x_address (Values.Vptr b Integers.Ptrofs.zero)
### C.jet_elements_taptweak_serialize.exec_elements_taptweak_serialize_call
exec_elements_taptweak_serialize_call
     : forall (id : AST.ident) (fd : Clight.function) (result : option AST.ident) (args : list Clight.expr)
         (vargs : list Values.val) (v : Values.val) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m mf : Memory.Mem.mem)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id fd)
                elements_taptweak_serialize_helpers)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@None (prod Values.block Ctypes.type)))
         (_ : Clight.eval_exprlist jet_elements_taptweak_pure.elements_taptweak_ge e le m args
                (Ctypes.type_of_params (Clight.fn_params fd)) vargs)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
                (@Ctypes.Internal Clight.function fd) vargs Events.E0 mf v),
       ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
         (jet_secp_curve_statements.curve_call id fd result args) Events.E0 (Clight.set_opttemp result v le) mf
         ClightBigstep.Out_normal
### C.jet_elements_taptweak_serialize.eval_elements_taptweak_xonly_serialize
eval_elements_taptweak_xonly_serialize
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_memset_model.memset_model)
         (ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (w : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bout bin : Values.block) (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_affine_storage.affine_storage_readable m bin BinNums.Z0 w)
         (_ : @eq BinNums.Z (jet_secp_storage_numeric.field_storage_value w)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ax))
         (_ : @eq BinNums.Z
                (jet_secp_storage_numeric.field_storage_value (fun i : nat => w (Nat.add (S (S (S (S O)))) i)))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ay))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay))) true),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_xonly_pubkey_serialize)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               (Values.Vint Integers.Int.one))
            (and
               (jet_read8s_layout.uint8_array_at mf bout BinNums.Z0
                  (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                     (jet_secp_fe_b32.be_bytes
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ax))))
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bin BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m
                           mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))
