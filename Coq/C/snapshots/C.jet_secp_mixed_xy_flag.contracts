### C.jet_secp_mixed_xy_flag.mixed_flag_of_residue
mixed_flag_of_residue
     : forall (z : forall _ : nat, Integers.Int64.int) (az : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) az)
                   jet_secp_fe_math.feP)),
       @eq Integers.Int.int (jet_secp_field_zero_owned.field_zero_result z)
         (jet_readBit_layout.bit_int (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem az)))
### C.jet_secp_mixed_xy_flag.mixed_xy_flag_preserved
mixed_xy_flag_preserved
     : forall (x y z u v : forall _ : nat, Integers.Int64.int) (flag : Integers.Int.int)
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : jet_secp_square_columns.square_input_bounds u)
         (_ : jet_secp_square_columns.square_input_bounds v)
         (_ : @eq Integers.Int.int flag (jet_secp_field_zero_owned.field_zero_result z)),
       @eq Integers.Int.int (jet_secp_mixed_body_loose.mixed_mode_body_flag true flag x y z u v)
         (jet_secp_field_zero_owned.field_zero_result
            (jet_secp_mixed_body_loose.mixed_mode_body_z_words true flag x y z u v))
