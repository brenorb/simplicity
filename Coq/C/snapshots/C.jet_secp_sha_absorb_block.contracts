### C.jet_secp_sha_absorb_block.secp_sha_uchar_symbol
secp_sha_uchar_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            jets_sha._sha256_compression_uchar)
         (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._sha256_compression_uchar))
### C.jet_secp_sha_absorb_block.secp_sha_uchar_funct
secp_sha_uchar_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._sha256_compression_uchar) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_sha256_compression_uchar))
### C.jet_secp_sha_absorb_block.exec_secp_sha_fill_block
exec_secp_sha_fill_block
     : forall (_ : jet_memcpy_model.memcpy_model) (l bytes regs : list Integers.Int.int)
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bc bs ba : Values.block) (oa : Integers.Ptrofs.int)
         (_ : lt (@length Integers.Int.int l)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (Nat.add (@length Integers.Int.int l) (@length Integers.Int.int bytes))
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : not (@eq Values.block bc ba)) (_ : not (@eq Values.block bc bs))
         (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat (@length Integers.Int.int bytes)))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._ctx le)
                (@Some Values.val (Values.Vptr bc Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._arr le)
                (@Some Values.val (Values.Vptr ba oa)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._block le)
                (@Some Values.val
                   (Values.Vptr bc
                      (Integers.Ptrofs.repr
                         (BinInt.Z.add (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                            (BinInt.Z.of_nat (@length Integers.Int.int l)))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._delta le)
                (@Some Values.val
                   (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int bytes))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._len le)
                (@Some Values.val
                   (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int bytes))))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bc BinNums.Z0)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : jet_uint32_array_init.uint32_array_at m bs BinNums.Z0 regs)
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int l)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinInt.Z.add (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i l Integers.Int.zero))))
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int bytes)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i bytes Integers.Int.zero)))),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m
                  jet_sha_uchars_loop.uc_loop Events.E0 lef mf ClightBigstep.Out_normal)
               (and
                  (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._ctx lef)
                     (@Maps.PTree.get Values.val jets_sha._ctx le))
                  (and
                     (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._len lef)
                        (@Some Values.val (Values.Vlong Integers.Int64.zero)))
                     (and
                        (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._delta lef)
                           (@Some Values.val
                              (Values.Vlong
                                 (Integers.Int64.repr
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                        (and
                           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._block lef)
                              (@Some Values.val
                                 (Values.Vptr bc
                                    (Integers.Ptrofs.repr
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                           (and
                              (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                                 (SHA256.hash_block regs (jet_sha_ctx8_model.be_words (@app Integers.Int.int l bytes))))
                              (and
                                 (Memory.Mem.range_perm mf bc BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bs BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (forall (ch : AST.memory_chunk) (ofs : BinNums.Z)
                                          (_ : or
                                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                                                    (BinNums.Zpos
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                 (BinInt.Z.le
                                                    (BinNums.Zpos
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                                    ofs)),
                                        @eq (option Values.val) (Memory.Mem.load ch mf bc ofs)
                                          (Memory.Mem.load ch m bc ofs))
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) =>
                                              and (not (@eq Values.block b bc)) (not (@eq Values.block b bs))) m mf)
                                          (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                             (jet_secp_sha_startup.secp_sha_startup mf)))))))))))))
