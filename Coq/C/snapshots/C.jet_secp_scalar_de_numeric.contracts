           (jet_secp_modinv_de_correction_numeric.de62_first_value rho high))
        (jet_secp_modinv_de_correction_numeric.de62_multiple_value rho high))
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
