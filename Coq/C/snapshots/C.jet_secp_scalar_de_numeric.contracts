        (BinInt.Z.add
           (BinInt.Z.div (scalar_de62_acc_value rho high n)
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
           (jet_secp_modinv_de_numeric.de62_limb_sum rho high (S n)))
        (BinInt.Z.mul (Integers.Int64.signed (jet_secp_scalar_normalize62.modinfo_scalar_limb (S n)))
           (scalar_de62_correction_value rho high))
