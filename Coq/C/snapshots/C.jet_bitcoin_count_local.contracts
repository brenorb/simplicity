           (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) return Prop
       with
       | Some co =>
           @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
             (Ctypes.field_offset (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) jets_bitcoin._numInputs
                (Ctypes.co_members co))
             (@Errors.OK (prod BinNums.Z Ctypes.bitfield)
                (@pair BinNums.Z Ctypes.bitfield
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                   Ctypes.Full))
       | None => False
       end
