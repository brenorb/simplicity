### C.jet_bitcoin_count_local.bitcoin_count_carrier_encoding
bitcoin_count_carrier_encoding
     : forall (r : Integers.Int64.int) (count : BinNums.Z) (_ : @eq BinNums.Z (Integers.Int64.unsigned r) count),
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W32)))
         (jet_wide_spec.decode_wide jet_wide.W32
            (Integers.Int64.zero_ext
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) r))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) count)
### C.jet_bitcoin_count_local.bitcoin_count_getter_local_spec
bitcoin_count_getter_local_spec
     : forall (f : Clight.function) (field : AST.ident) (delta : BinNums.Z)
         (count : forall _ : Bitcoin.Bitcoin.env, BinNums.Z)
         (spec : forall (_ : Ty.tySem Ty.Unit) (_ : Bitcoin.Bitcoin.env),
                 option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 delta)
                (BinInt.Z.le delta
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_vars f)
                (Clight.fn_vars jets_bitcoin.f_simplicity_bitcoin_version))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_params f)
                (Clight.fn_params jets_bitcoin.f_simplicity_bitcoin_version))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_temps f)
                (Clight.fn_temps jets_bitcoin.f_simplicity_bitcoin_version))
         (_ : @eq Ctypes.type (Clight.fn_return f) Ctypesdefs.tbool)
         (_ : @eq Clight.statement (Clight.fn_body f) (jet_bitcoin_getter32_exec.bitcoin_getter32_body field))
         (_ : match
                @Maps.PTree.get Ctypes.composite jets_bitcoin._bitcoinTransaction
                  (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) return Prop
              with
              | Some co =>
                  @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
                    (Ctypes.field_offset (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) field (Ctypes.co_members co))
                    (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield delta Ctypes.Full))
              | None => False
              end)
         (_ : forall environment : Bitcoin.Bitcoin.env,
              @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) (spec tt environment)
                (@Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
                   (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (count environment)))),
       jet_application_contract.application_jet_local_spec f jet_bitcoin_linkage.bitcoin_ge Bitcoin.Bitcoin.env Ty.Unit
         (Word.Word (S (S (S (S (S O)))))) (bitcoin_count_env_rep delta count) spec
### C.jet_bitcoin_count_local.bitcoin_num_inputs_local_spec
bitcoin_num_inputs_local_spec
     : jet_application_contract.application_jet_local_spec jets_bitcoin.f_simplicity_bitcoin_num_inputs
         jet_bitcoin_linkage.bitcoin_ge Bitcoin.Bitcoin.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
         bitcoin_num_inputs_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : Bitcoin.Bitcoin.env) =>
          @jet_bitcoin_count_canonical.bitcoin_transaction_num_inputs_spec
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a environment)
### C.jet_bitcoin_count_local.bitcoin_num_outputs_local_spec
bitcoin_num_outputs_local_spec
     : jet_application_contract.application_jet_local_spec jets_bitcoin.f_simplicity_bitcoin_num_outputs
         jet_bitcoin_linkage.bitcoin_ge Bitcoin.Bitcoin.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
         bitcoin_num_outputs_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : Bitcoin.Bitcoin.env) =>
          @jet_bitcoin_count_canonical.bitcoin_transaction_num_outputs_spec
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a environment)
### C.jet_bitcoin_count_local.bitcoin_count_env_rep
bitcoin_count_env_rep =
fun (delta : BinNums.Z) (count : forall _ : Bitcoin.Bitcoin.env, BinNums.Z) (m : Memory.Mem.mem)
  (env : Values.val) (environment : Bitcoin.Bitcoin.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun value : Integers.Int64.int =>
               and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                 (and (and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
                    (and (BinInt.Z.le BinNums.Z0 txbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add txbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                             (and
                                (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (BinInt.Z.add txbase delta))
                                   (@Some Values.val (Values.Vlong value)))
                                (@eq BinNums.Z (Integers.Int64.unsigned value) (count environment))))))))))))
     : forall (_ : BinNums.Z) (_ : forall _ : Bitcoin.Bitcoin.env, BinNums.Z) (_ : Memory.Mem.mem)
         (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_count_env_rep delta%Z_scope count%function_scope m env environment
### C.jet_bitcoin_count_local.bitcoin_num_inputs_env_rep
bitcoin_num_inputs_env_rep =
bitcoin_count_env_rep
  (BinNums.Zpos
     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
  (fun environment : Bitcoin.Bitcoin.env =>
   BinInt.Z.of_nat (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx environment))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_num_inputs_env_rep m env environment
### C.jet_bitcoin_count_local.bitcoin_num_outputs_env_rep
bitcoin_num_outputs_env_rep =
bitcoin_count_env_rep
  (BinNums.Zpos
     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
  (fun environment : Bitcoin.Bitcoin.env =>
   BinInt.Z.of_nat (@length Bitcoin.txOutput (Bitcoin.sigTxOut (Bitcoin.Bitcoin.envTx environment))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_num_outputs_env_rep m env environment
