### C.jet_copyBits_wide_memcpy.memcpy_two_words_effect
memcpy_two_words_effect
     : forall (_ : jet_memcpy_model.memcpy_model) (m : Memory.Mem.mem) (bi : Values.block)
         (src : BinNums.Z) (bw : Values.block) (dst : BinNums.Z) (v0 v1 : Integers.Int64.int)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bi src) (@Some Values.val (Values.Vlong v0)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (BinInt.Z.add src (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong v1)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bw dst Memtype.Writable)
         (_ : Memory.Mem.valid_access m AST.Mint64 bw
                (BinInt.Z.add dst (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : BinInt.Z.le BinNums.Z0 src)
         (_ : BinInt.Z.le
                (BinInt.Z.add src (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 dst)
         (_ : BinInt.Z.le
                (BinInt.Z.add dst (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (BinInt.Z.add Integers.Ptrofs.max_unsigned (BinNums.Zpos BinNums.xH)))
         (_ : or (not (@eq Values.block bi bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add src (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      dst)
                   (BinInt.Z.le
                      (BinInt.Z.add dst (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      src))),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (Events.external_call
               (AST.EF_external
                  (String.String (Ascii.Ascii true false true true false true true false)
                     (String.String (Ascii.Ascii true false true false false true true false)
                        (String.String (Ascii.Ascii true false true true false true true false)
                           (String.String (Ascii.Ascii true true false false false true true false)
                              (String.String (Ascii.Ascii false false false false true true true false)
                                 (String.String (Ascii.Ascii true false false true true true true false)
                                    String.EmptyString)))))) jet_memcpy_model.memcpy_sig)
               (@Globalenvs.Genv.to_senv Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0))
               (@cons Values.val (Values.Vptr bw (Integers.Ptrofs.repr dst))
                  (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr src))
                     (@cons Values.val
                        (Values.Vlong
                           (Integers.Int64.repr
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        (@nil Values.val)))) m Events.E0 (Values.Vptr bw (Integers.Ptrofs.repr dst)) m')
            (and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m' bw dst) (@Some Values.val (Values.Vlong v0)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 m' bw
                        (BinInt.Z.add dst (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val (Values.Vlong v1)))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bw))
                               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) dst)
                                  (BinInt.Z.le
                                     (BinInt.Z.add dst
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk m' b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm m' b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b))))))
