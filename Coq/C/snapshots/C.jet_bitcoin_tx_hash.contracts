### C.jet_bitcoin_tx_hash.outpoints_sem
outpoints_sem
     : forall (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq
         (option
            (Ty.tySem
               (Ty.Sum Ty.Unit
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))))
         (@jet_bitcoin_full_prim.BitcoinFull.sem (Word.Word (S (S (S (S (S O))))))
            (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
            (@jet_bitcoin_full_prim.BitcoinFull.Base (Word.Word (S (S (S (S (S O))))))
               (Ty.Sum Ty.Unit
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
               Bitcoin.Bitcoin.InputPrevOutpoint) i e)
         (@Some
            (sum unit
               (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))))
            match
              @List.nth_error
                (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
                (outpoints_of e) (BinInt.Z.to_nat (jet_forWhile_seq.wz (S (S (S (S (S O))))) i))
              return
                (sum unit
                   (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))))
            with
            | Some x =>
                @inr unit
                  (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
                  x
            | None =>
                @inl unit
                  (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
                  tt
            end)
### C.jet_bitcoin_tx_hash.input_outpoints_hash_spec_sem
input_outpoints_hash_spec_sem
     : forall e : jet_bitcoin_full_prim.BitcoinFull.env,
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@input_outpoints_hash_spec
            (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt
            e)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.from_hash256 (input_outpoints_hash_of e)))
### C.jet_bitcoin_tx_hash.bitcoin_input_outpoints_hash_local_spec
bitcoin_input_outpoints_hash_local_spec
     : jet_application_sep.application_jet_local_spec_sep jets_bitcoin.f_simplicity_bitcoin_input_outpoints_hash
         jet_bitcoin_linkage.bitcoin_ge jet_bitcoin_ext_prim.ext_environment Ty.Unit
         (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@jet_bitcoin_hash_getter_local.hash_getter_rep jet_bitcoin_ext_prim.ext_environment input_outpoints_hash_of
            BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))))
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_bitcoin_ext_prim.ext_environment) =>
          @input_outpoints_hash_spec
            (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
