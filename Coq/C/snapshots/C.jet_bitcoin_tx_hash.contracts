### C.jet_bitcoin_tx_hash.elems_hash_spec
elems_hash_spec =
fun (X : Ty.Ty)
  (add : forall term : Alg.Assertion.Algebra,
         Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
           jet_sha256_ctx8_init_spec.sha256_ctx8_type) (w : nat)
  (p : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit X)) (alg : jet_bitcoin_full_prim.PF.Algebra)
=>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.unit Ty.Unit core) (@jet_sha256_ctx8_init_spec.sha256_ctx8_init_spec core))
  (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type)
     (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_hash_loop_gen.gen_loop_run X add w term Ty.Unit
        (@jet_sha256_ctx8_init_spec.AC.drop Ty.Unit (Word.Word w) (Ty.Sum Ty.Unit X) core
           (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word w) (Ty.Sum Ty.Unit X) alg p)))
     (@jet_sha256_ctx8_init_spec.AC.copair jet_sha256_ctx8_init_spec.sha256_ctx8_type
        jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_sha_finalize_spec.ctx8_finalize_spec term) (@jet_sha_finalize_spec.ctx8_finalize_spec term)))
     : forall (X : Ty.Ty)
         (_ : forall term : Alg.Assertion.Algebra,
              Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type) (w : nat)
         (_ : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit X))
         (alg : jet_bitcoin_full_prim.PF.Algebra),
       jet_bitcoin_full_prim.PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments elems_hash_spec X%ty_scope add%function_scope w%nat_scope p {alg}
### C.jet_bitcoin_tx_hash.elems_hash_of
elems_hash_of =
fun (X : Ty.Ty) (bytes_of : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
  (w : nat) (xs : list (Ty.tySem X)) =>
jet_bitcoin_composite_hash.sha256_bytes_of
  (jet_sha_hash_loop_gen.gen_bytes X bytes_of
     (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs))
     : forall (X : Ty.Ty) (_ : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
         (_ : nat) (_ : list (Ty.tySem X)), Digest.hash256

