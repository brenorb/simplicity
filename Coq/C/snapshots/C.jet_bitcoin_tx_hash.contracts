### C.jet_bitcoin_tx_hash.elems_hash_spec_parametric
elems_hash_spec_parametric
     : forall (X : Ty.Ty)
         (add : forall term : Alg.Assertion.Algebra,
                Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                  jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @Alg.Assertion.Parametric (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type add) (w : nat)
         (p : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit X)),
       @jet_bitcoin_full_prim.PF.Parametric Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@elems_hash_spec X add w p)
### C.jet_bitcoin_tx_hash.gen_bytes_length_le
gen_bytes_length_le
     : forall (X : Ty.Ty) (bytes_of : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
         (N : BinNums.Z)
         (_ : forall x : Ty.tySem X,
              BinInt.Z.le (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (bytes_of x))) N)
         (l : list (Ty.tySem X)),
       BinInt.Z.le
         (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (jet_sha_hash_loop_gen.gen_bytes X bytes_of l)))
         (BinInt.Z.mul N (BinInt.Z.of_nat (@length (Ty.tySem X) l)))
### C.jet_bitcoin_tx_hash.elems_hash_spec_sem
elems_hash_spec_sem
     : forall (X : Ty.Ty)
         (add : forall term : Alg.Assertion.Algebra,
                Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                  jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @Alg.Assertion.Parametric (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type add)
         (bytes_of : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
         (_ : forall
                (c : prod
                       ((fix tySem (X0 : Ty.Ty) : Set :=
                           match X0 return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                       (prod
                          ((fix tySem (X0 : Ty.Ty) : Set :=
                              match X0 return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Word (S (S (S (S (S (S O))))))))
                          ((fix tySem (X0 : Ty.Ty) : Set :=
                              match X0 return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (x : (fix tySem (X0 : Ty.Ty) : Set :=
                        match X0 return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) X),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                   (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (add (Alg.AssertionSem Option.option_Monad_Zero)
                   (@pair
                      (prod
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) X) c x)) (jet_sha_ctx8_spec.ctx8_add_list c (bytes_of x))) (w : nat)
         (p : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit X)) (N : BinNums.Z)
         (_ : forall x : Ty.tySem X,
              BinInt.Z.le (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (bytes_of x))) N)
         (_ : BinInt.Z.le BinNums.Z0 N)
         (_ : BinInt.Z.lt
                (BinInt.Z.div (BinInt.Z.mul N (jet_forWhile_seq.wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                jet_sha_ctx8_spec.ctx8_limit)
         (xs_of : forall _ : jet_bitcoin_ext_prim.ext_environment, list (Ty.tySem X))
         (_ : forall (i : Ty.tySem (Word.Word w)) (e : jet_bitcoin_full_prim.BitcoinFull.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit X)))
                (@jet_bitcoin_full_prim.BitcoinFull.sem (Word.Word w) (Ty.Sum Ty.Unit X) p i e)
                (@Some (sum unit (Ty.tySem X))
                   match
                     @List.nth_error (Ty.tySem X) (xs_of e) (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return (sum unit (Ty.tySem X))
                   with
                   | Some x => @inr unit (Ty.tySem X) x
                   | None => @inl unit (Ty.tySem X) tt
                   end)) (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@elems_hash_spec X add w p
            (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt
            e)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.from_hash256 (elems_hash_of X bytes_of w (xs_of e))))
