### C.jet_secp_schnorr_return_owned.schnorr_equal_allowed
schnorr_equal_allowed
     : jet_clight_internal_frame.allowed_call jet_secp_field_io_preserve.field_io_helpers
         (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_equal_var)
### C.jet_secp_schnorr_return_owned.exec_schnorr_return_owned
exec_schnorr_return_owned
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (br bx : Values.block) (x y r : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._r e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_curve_statements.curve_ge_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._rx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalize_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_is_odd e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_equal_var e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block br bx))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.lt (Integers.Int64.unsigned (r i))
                match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                | true =>
                    BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
                | false =>
                    BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
                end) (_ : jet_secp_fe_nv.fe_at m br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m br
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 r))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       let odd : bool :=
         Bit.toBool
           (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem
              (jet_secp_rescale_literal.rescale_field_output y)) in
       let equal : bool :=
         BinInt.Z.eqb (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value r) jet_secp_fe_math.feP)
           (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value x) jet_secp_fe_math.feP) in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               jet_secp_schnorr_return_control.schnorr_return_tail Events.E0
               (jet_secp_schnorr_return_control.schnorr_return_temps le odd equal) mf
               (ClightBigstep.Out_return
                  (@Some (prod Values.val Ctypes.type)
                     (@pair Values.val Ctypes.type (Values.Vint (jet_readBit_layout.bit_int (andb (negb odd) equal)))
                        Ctypesdefs.tint))))
            (and
               (Memory.Mem.range_perm mf br BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mf bx BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (_ : BinNums.Z) =>
                         and (not (@eq Values.block b br)) (not (@eq Values.block b bx))) m mf)
                     (jet_clight_internal_preserve.readonly_preserved m mf)))))
