### C.jet_elements_nonce_hash_repr.elements_nonce_canonical_bytes
elements_nonce_canonical_bytes
     : forall n : option jet_elements_prim.nonce,
       @eq (list Integers.Int.int)
         (jet_elements_confidential_exec.conf_bytes (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH)))
            (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) (jet_elements_asset_jets.nonce_prefix n)
            (jet_elements_asset_jets.nonce_words n))
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
            (jet_elements_nonce_hash_spec.elements_nonce_bytes (jet_elements_asset_jets.encode_nonce n)))
### C.jet_elements_nonce_hash_repr.eval_sha256_nonce_repr
eval_sha256_nonce_repr
     : forall (_ : jet_memcpy_model.memcpy_model) (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (m : Memory.Mem.mem) (l regs : list Integers.Int.int) (c : Integers.Int64.int)
         (ovf : bool) (bn : Values.block) (on : BinNums.Z) (n : option jet_elements_prim.nonce)
         (_ : jet_elements_support_sha_ctxi.ctxi m bx bm l regs c ovf)
         (_ : and (BinInt.Z.le BinNums.Z0 on)
                (BinInt.Z.le
                   (BinInt.Z.add on
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   Integers.Ptrofs.max_unsigned)) (_ : not (@eq Values.block bn bx)) (_ : not (@eq Values.block bn bm))
         (_ : jet_elements_asset_jets.nonce_rep m bn on n),
       let B : list Integers.Int.int :=
         @List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
           (jet_elements_nonce_hash_spec.elements_nonce_bytes (jet_elements_asset_jets.encode_nonce n)) in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_simplicity_sha256_confNonce)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr BinNums.Z0))
                  (@cons Values.val (Values.Vptr bn (Integers.Ptrofs.repr on)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_elements_support_sha_ctxi.ctxi mf bx bm
                  (@fst (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs B))
                  (@snd (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs B))
                  (Integers.Int64.add c (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int B))))
                  (jet_elements_confidential_exec.conf_overflow c ovf (jet_elements_asset_jets.nonce_prefix n)))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
                   @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm mf b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
### C.jet_elements_nonce_hash_repr.elements_nonce_rep_mono
elements_nonce_rep_mono
     : forall (m1 m2 : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (n : option jet_elements_prim.nonce)
         (_ : jet_elements_asset_jets.nonce_rep m1 b ofs n)
         (_ : forall (chunk : AST.memory_chunk) (o : BinNums.Z) (v : Values.val) (_ : BinInt.Z.le ofs o)
                (_ : BinInt.Z.le (BinInt.Z.add o (Memdata.size_chunk chunk))
                       (BinInt.Z.add ofs
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (_ : @eq (option Values.val) (Memory.Mem.load chunk m1 b o) (@Some Values.val v)),
              @eq (option Values.val) (Memory.Mem.load chunk m2 b o) (@Some Values.val v)),
       jet_elements_asset_jets.nonce_rep m2 b ofs n
