### C.jet_elements_locktime_local.elements_transaction_locktime_spec
elements_transaction_locktime_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
  jet_elements_prim.Elements.LockTime
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))

Arguments elements_transaction_locktime_spec {alg}
### C.jet_elements_locktime_local.elements_locktime_env_rep
elements_locktime_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : jet_elements_prim.Elements.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun value : Integers.Int64.int =>
               and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                 (and (and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
                    (and (BinInt.Z.le BinNums.Z0 txbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add txbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                             (and
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint64 m bt
                                      (BinInt.Z.add txbase
                                         (BinNums.Zpos
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))))
                                   (@Some Values.val (Values.Vlong value)))
                                (@eq BinNums.Z (Integers.Int64.unsigned value)
                                   (Integers.Int.unsigned
                                      (jet_elements_prim.sigTxLock (jet_elements_prim.Elements.envTx environment))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env), Prop

Arguments elements_locktime_env_rep m env environment
