### C.jet_elements_locktime_local.elements_locktime_carrier_matches_primitive
elements_locktime_carrier_matches_primitive
     : forall (r : Integers.Int64.int) (environment : jet_elements_prim.Elements.env)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r)
                (Integers.Int.unsigned (jet_elements_prim.sigTxLock (jet_elements_prim.Elements.envTx environment)))),
       @eq (option (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W32))))
         (@Some (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W32)))
            (jet_wide_spec.decode_wide jet_wide.W32
               (Integers.Int64.zero_ext
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) r)))
         (@jet_elements_prim.Elements.sem Ty.Unit (Word.Word (S (S (S (S (S O)))))) jet_elements_prim.Elements.LockTime
            tt environment)
### C.jet_elements_locktime_local.elements_locktime_local_spec
elements_locktime_local_spec
     : jet_application_contract.application_jet_local_spec jets_elements.f_simplicity_lock_time
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
