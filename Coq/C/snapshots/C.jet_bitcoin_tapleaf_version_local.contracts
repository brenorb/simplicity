### C.jet_bitcoin_tapleaf_version_local.bitcoin_tapleaf_version_local_spec
bitcoin_tapleaf_version_local_spec
     : jet_application_sep.application_jet_local_spec_sep jets_bitcoin.f_simplicity_bitcoin_tapleaf_version
         jet_bitcoin_linkage.bitcoin_ge jet_bitcoin_ext_prim.ext_environment Ty.Unit (Word.Word (S (S (S O))))
         bitcoin_tapleaf_version_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_bitcoin_ext_prim.ext_environment) =>
          @bitcoin_tapleaf_version_spec
            (jet_bitcoin_ext_prim.PrimitiveBitcoinExt.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
### C.jet_bitcoin_tapleaf_version_local.bitcoin_tapleaf_version_spec
bitcoin_tapleaf_version_spec =
fun alg : jet_bitcoin_ext_prim.PrimitiveBitcoinExt.Primitive.Algebra =>
@jet_bitcoin_ext_prim.PrimitiveBitcoinExt.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S O)))) alg
  jet_bitcoin_ext_prim.BitcoinExt.TapleafVersion
     : forall alg : jet_bitcoin_ext_prim.PrimitiveBitcoinExt.Primitive.Algebra,
       jet_bitcoin_ext_prim.PrimitiveBitcoinExt.Primitive.domain alg Ty.Unit (Word.Word (S (S (S O))))

Arguments bitcoin_tapleaf_version_spec {alg}
### C.jet_bitcoin_tapleaf_version_local.bitcoin_tapleaf_version_env_rep
bitcoin_tapleaf_version_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (e : jet_bitcoin_ext_prim.ext_environment)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
              (and (BinInt.Z.le BinNums.Z0 ebase)
                 (and
                    (BinInt.Z.le
                       (BinInt.Z.add ebase
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                       Integers.Ptrofs.max_unsigned)
                    (and (BinInt.Z.le BinNums.Z0 tbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add tbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val)
                                (Memory.Mem.load AST.Mptr m be
                                   (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                             (and
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint8unsigned m bt
                                      (BinInt.Z.add tbase
                                         (BinNums.Zpos
                                            (BinNums.xI
                                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI ...)))))))))
                                   (@Some Values.val
                                      (Values.Vint (Integers.Int.repr (jet_bitcoin_ext_prim.extTapleafVersion e)))))
                                (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                   (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                      (@pair (prod Values.block BinNums.Z) BinNums.Z
                                         (@pair Values.block BinNums.Z be
                                            (BinInt.Z.add ebase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                         (BinInt.Z.add ebase
                                            (BinNums.Zpos
                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                      (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_bitcoin_ext_prim.ext_environment)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments bitcoin_tapleaf_version_env_rep m env e fp%list_scope
