### C.jet_bitcoin_getter32_layout.eval_bitcoin_getter32_layout
eval_bitcoin_getter32_layout
     : forall (f : Clight.function) (field : AST.ident) (delta : BinNums.Z) (m : Memory.Mem.mem)
         (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (be : Values.block) (ebase : BinNums.Z) (bt : Values.block)
         (txbase : BinNums.Z) (version : Integers.Int64.int) (bytes : list Memdata.memval)
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_vars f)
                (Clight.fn_vars jets_bitcoin.f_simplicity_bitcoin_version))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_params f)
                (Clight.fn_params jets_bitcoin.f_simplicity_bitcoin_version))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_temps f)
                (Clight.fn_temps jets_bitcoin.f_simplicity_bitcoin_version))
         (_ : @eq Ctypes.type (Clight.fn_return f) Ctypesdefs.tbool)
         (_ : @eq Clight.statement (Clight.fn_body f) (jet_bitcoin_getter32_exec.bitcoin_getter32_body field))
         (_ : match
                @Maps.PTree.get Ctypes.composite jets_bitcoin._bitcoinTransaction
                  (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) return Prop
              with
              | Some co =>
                  @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
                    (Ctypes.field_offset (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) field (Ctypes.co_members co))
                    (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield delta Ctypes.Full))
              | None => False
              end) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
         (_ : BinInt.Z.le BinNums.Z0 txbase) (_ : BinInt.Z.le BinNums.Z0 delta)
         (_ : BinInt.Z.le (BinInt.Z.add txbase delta) Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (BinInt.Z.add txbase delta))
                (@Some Values.val (Values.Vlong version)))
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cursor
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge m (@Ctypes.Internal Clight.function f)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase)) (@nil Values.val)))) Events.E0 mf
               (Values.Vint Integers.Int.one))
            (and
               (jet_wide_spec.wide_output_at jet_wide.W32 mf bw edge cursor
                  (jet_wide_spec.decode_wide jet_wide.W32
                     (Integers.Int64.zero_ext
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        version)))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw edge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (jet_output_slice.slice_write_low
                                        (BinNums.Zpos
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                        edge cursor))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
