### C.jet_secp_point_zy_multiply.eval_point_zy_mul_owned
eval_point_zy_mul_owned
     : forall (z y : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val
                  (Values.Vptr b
                     (Integers.Ptrofs.repr
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                  (@cons Values.val
                     (Values.Vptr b
                        (Integers.Ptrofs.repr
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                     (@cons Values.val
                        (Values.Vptr b
                           (Integers.Ptrofs.repr
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_mul_storage.point_mul_words z y)))
               (and
                  (jet_secp_fe_nv.fe_at mf b
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (Memory.Mem.range_perm mf b BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (@eq BinNums.Z
                           (BinInt.Z.modulo
                              (jet_secp_multiply_finish_product.radix_value
                                 (jet_secp_point_mul_storage.point_mul_words z y)) jet_secp_fe_math.feP)
                           (BinInt.Z.modulo
                              (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value z)
                                 (jet_secp_multiply_finish_product.radix_value y)) jet_secp_fe_math.feP))
                        (and
                           (jet_secp_square_columns.square_input_bounds
                              (jet_secp_point_mul_storage.point_mul_words z y))
                           (and
                              (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                               BinInt.Z.lt (Integers.Int64.unsigned (jet_secp_point_mul_storage.point_mul_words z y i))
                                 match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
