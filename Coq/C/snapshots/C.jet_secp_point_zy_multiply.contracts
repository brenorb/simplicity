                                     BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))
                                 | false =>
                                     BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))
                                 end)
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (pos : BinNums.Z) =>
                                  or (not (@eq Values.block bx b))
                                    (or
                                       (BinInt.Z.lt pos
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                       (BinInt.Z.le
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                          pos))) m mf))))))))
