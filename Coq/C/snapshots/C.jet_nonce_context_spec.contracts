### C.jet_nonce_context_spec.nonce_prefix_ints
nonce_prefix_ints
     : and (@eq Integers.Int.int (jet_read8s_layout.word8_array_value (nonce_byte BinNums.Z0)) Integers.Int.zero)
         (and
            (@eq Integers.Int.int (jet_read8s_layout.word8_array_value (nonce_byte (BinNums.Zpos BinNums.xH)))
               Integers.Int.one)
            (and
               (@eq Integers.Int.int
                  (jet_read8s_layout.word8_array_value (nonce_byte (BinNums.Zpos (BinNums.xO BinNums.xH))))
                  (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
               (@eq Integers.Int.int
                  (jet_read8s_layout.word8_array_value (nonce_byte (BinNums.Zpos (BinNums.xI BinNums.xH))))
                  (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))))))
### C.jet_nonce_context_spec.nonce_none_stream
nonce_none_stream
     : @eq (list Integers.Int.int)
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
            (nonce_hash_bytes
               (@inl unit
                  (sum
                     (prod (sum unit unit)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt)))
         (@cons Integers.Int.int Integers.Int.zero (@nil Integers.Int.int))
