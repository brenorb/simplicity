### C.jet_nonce_context_spec.nonce_prefix_spec_parametric
nonce_prefix_spec_parametric
     : @Alg.Core.Parametric nonce_conf_type
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@nonce_prefix_spec)
### C.jet_nonce_context_spec.nonce_hash_spec_parametric
nonce_hash_spec_parametric
     : @Alg.Assertion.Parametric nonce_hash_input_type jet_sha256_ctx8_init_spec.sha256_ctx8_type (@nonce_hash_spec)
### C.jet_nonce_context_spec.nonce_prefix_core
nonce_prefix_core
     : forall p : Ty.tySem nonce_conf_type,
       @eq (Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@nonce_prefix_spec Alg.CoreFunSem p) (nonce_prefix_value p)
### C.jet_nonce_context_spec.nonce_hash_option
nonce_hash_option
     : forall (c : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (a : Ty.tySem nonce_value_type),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (@nonce_hash_spec (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (Ty.tySem nonce_value_type) c a))
         (jet_sha_ctx8_spec.ctx8_add_list c (nonce_hash_bytes a))
### C.jet_nonce_context_spec.nonce_hash_bytes_length
nonce_hash_bytes_length
     : forall a : Ty.tySem nonce_value_type,
       @eq nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (nonce_hash_bytes a))
         match a return nat with
         | inl _ => S O
         | inr _ => S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
         end
### C.jet_nonce_context_spec.nonce_hash_input_bits
nonce_hash_input_bits
     : @eq nat (Translate.bitSize nonce_hash_input_type)
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))))
### C.jet_nonce_context_spec.nonce_none_encoding
nonce_none_encoding
     : @eq (list BitMachine.Cell)
         (@Translate.encode nonce_value_type
            (@inl unit
               (sum
                  (prod (sum unit unit)
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt))
         (@cons (option bool) (@Some bool false)
            (@List.repeat (option bool) (@None bool)
               (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))))
### C.jet_nonce_context_spec.nonce_explicit_encoding
nonce_explicit_encoding
     : forall h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list BitMachine.Cell)
         (@Translate.encode nonce_value_type
            (@inr unit
               (sum
                  (prod (sum unit unit)
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@inr
                  (prod (sum unit unit)
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) h)))
         (@app (option bool)
            (@cons (option bool) (@Some bool true)
               (@cons (option bool) (@Some bool true) (@cons (option bool) (@None bool) (@nil (option bool)))))
            (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h))
