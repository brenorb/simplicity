              (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))))
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
              (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) jet_sha256_ctx8_init_spec.sha256_ctx8_type
           core
           (@jet_sha256_ctx8_init_spec.AC.pair
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
              core
              (@jet_sha256_ctx8_init_spec.AC.comp
                 (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))))
                 (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S O)))))
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                 (@jet_sha256_ctx8_init_spec.AC.pair
                    (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                       (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))))
                    jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S O)))) core
                    (@jet_sha256_ctx8_init_spec.AC.take jet_sha256_ctx8_init_spec.sha256_ctx8_type
                       (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                       jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                       (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core))
                    (@jet_sha256_ctx8_init_spec.AC.drop jet_sha256_ctx8_init_spec.sha256_ctx8_type
                       (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                       (Word.Word (S (S (S O)))) core
                       (@jet_sha256_ctx8_init_spec.AC.take (Word.Word (S (S (S O))))
                          (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) (Word.Word (S (S (S O)))) core
                          (@jet_sha256_ctx8_init_spec.AC.iden (Word.Word (S (S (S O)))) core))))
                 (@jet_sha_ctx8_spec.ctx8_add1_spec term))
              (@jet_sha256_ctx8_init_spec.AC.drop jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                 (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) core
                 (@jet_sha256_ctx8_init_spec.AC.drop (Word.Word (S (S (S O))))
                    (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
                    (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) core
                    (@jet_sha256_ctx8_init_spec.AC.iden (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
                       core)))) (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S (S (S (S O))))) term))))
     : forall term : Alg.Assertion.Algebra,
       Alg.Assertion.domain term nonce_hash_input_type jet_sha256_ctx8_init_spec.sha256_ctx8_type

Arguments nonce_hash_spec {term}
### C.jet_nonce_context_spec.nonce_prefix_value
nonce_prefix_value =
fun p : Ty.tySem nonce_conf_type =>
match
  p return (prod (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| inl t =>
    match
      t return (prod (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
    with
    | pair odd h =>
        @pair (Ty.tySem (Word.Word (S (S (S O)))))
          (prod
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
          match odd return (Ty.tySem (Word.Word (S (S (S O))))) with
          | inl _ => nonce_byte (BinNums.Zpos (BinNums.xO BinNums.xH))
          | inr _ => nonce_byte (BinNums.Zpos (BinNums.xI BinNums.xH))
          end h
    end
| inr h =>
    @pair (Ty.tySem (Word.Word (S (S (S O)))))
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) (nonce_byte (BinNums.Zpos BinNums.xH)) h
end
     : forall _ : Ty.tySem nonce_conf_type,
       prod (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments nonce_prefix_value p
### C.jet_nonce_context_spec.nonce_hash_bytes
nonce_hash_bytes =
fun a : Ty.tySem nonce_value_type =>
match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl _ =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) (nonce_byte BinNums.Z0) (@nil (Ty.tySem (Word.Word (S (S (S O))))))
| inr p =>
    @cons (Ty.tySem (Word.Word (S (S (S O)))))
      (@fst (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (nonce_prefix_value p))
      (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))
         (@snd (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (nonce_prefix_value p)))
end
     : forall _ : Ty.tySem nonce_value_type, list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments nonce_hash_bytes a
