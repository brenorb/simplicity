### C.jet_secp_scalar_split128_effects.scalar_split128_permissions
scalar_split128_permissions
     : forall (m mf : Memory.Mem.mem) (args : list Values.val) (result : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_split_128) args Events.E0 mf result),
       and (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m))
         (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
          iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p))
