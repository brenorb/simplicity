### C.jet_elements_taptweak_inverse_entry.elements_taptweak_inverse_vars_checked
elements_taptweak_inverse_vars_checked
     : @eq bool
         (jet_transport.vars_okb jet_secp_linkage.secp_ge jet_elements_taptweak_pure.elements_taptweak_ge
            (Clight.fn_vars jets_secp.f_secp256k1_modinv64_var)) true
### C.jet_elements_taptweak_inverse_entry.elements_taptweak_inverse_ready_checked
elements_taptweak_inverse_ready_checked
     : @eq bool
         (jet_transport_locals.locals_stmt_okb jet_secp_linkage.secp_ge jet_elements_taptweak_pure.elements_taptweak_ge
            (@List.map (prod BinNums.positive Clight.function) BinNums.positive (@fst BinNums.positive Clight.function)
               jet_elements_taptweak_curve_transport.elements_taptweak_curve_helpers)
            (@List.map (prod AST.ident Ctypes.type) AST.ident (@fst AST.ident Ctypes.type)
               (Clight.fn_vars jets_secp.f_secp256k1_modinv64_var)) jet_secp_modinv_var_copies.inv_ready_prefix) true
### C.jet_elements_taptweak_inverse_entry.elements_taptweak_inverse_ready_closed
elements_taptweak_inverse_ready_closed
     : and
         (@eq bool
            (jet_clight_internal_frame.closed_stmtb
               jet_elements_taptweak_curve_transport.elements_taptweak_curve_helpers
               jet_secp_modinv_var_copies.inv_ready_prefix) true)
         (@eq bool
            (@List.forallb (prod AST.ident Ctypes.type)
               (fun local : prod AST.ident Ctypes.type =>
                jet_clight_internal_frame.nonfunction_type (@snd AST.ident Ctypes.type local))
               (Clight.fn_vars jets_secp.f_secp256k1_modinv64_var)) true)
### C.jet_elements_taptweak_inverse_entry.elements_taptweak_inv_start_rep_from_storage
elements_taptweak_inv_start_rep_from_storage
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bs : Values.block)
         (_ : not (@eq Values.block bs jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_block))
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_global_rep m),
       jet_sx_state.rep w
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
            (@cons (prod Values.block BinNums.Z)
               (@pair Values.block BinNums.Z jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_block
                  BinNums.Z0) (@nil (prod Values.block BinNums.Z)))) jet_secp_modinv_var_entry.inv_start_regs m
### C.jet_elements_taptweak_inverse_entry.elements_taptweak_inv_entry_to_loop
elements_taptweak_inv_entry_to_loop
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta jet_secp_modinv_var_entry.inv_start_regs m)
         (_ : @eq BinNums.Z (jet_sx_state.bas beta (S O)) BinNums.Z0),
       @ex (list (prod Values.block BinNums.Z))
         (fun betaN : list (prod Values.block BinNums.Z) =>
          @ex Clight.env
            (fun e : Clight.env =>
             @ex Clight.temp_env
               (fun le : Clight.temp_env =>
                @ex Memory.Mem.mem
                  (fun mi : Memory.Mem.mem =>
                   @ex Clight.temp_env
                     (fun lef : Clight.temp_env =>
                      @ex Memory.Mem.mem
                        (fun mf : Memory.Mem.mem =>
                         and
                           (Clight.function_entry2 jet_elements_taptweak_pure.elements_taptweak_ge
                              jets_secp.f_secp256k1_modinv64_var
                              (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta))
                                 jet_secp_modinv_var_entry.inv_start_args) m e le mi)
                           (and
                              (ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le mi
                                 jet_secp_modinv_var_copies.inv_ready_prefix Events.E0 lef mf ClightBigstep.Out_normal)
                              (and
                                 (jet_sx_state.rep rho (@app (prod Values.block BinNums.Z) beta betaN)
                                    jet_secp_modinv_var_copies.inv_fg_regs mf)
                                 (and
                                    (jet_sx_eval.tmatch rho (@app (prod Values.block BinNums.Z) beta betaN)
                                       jet_secp_modinv_var_copies.inv_loop_start_temps lef)
                                    (and
                                       (jet_sx_eval.ematch (@app (prod Values.block BinNums.Z) beta betaN)
                                          (@snd (list jet_sx_state.region) jet_sx_eval.venv
                                             jet_secp_modinv_var_entry.inv_start_alloc) e)
                                       (and
                                          (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len lef)
                                             (@Some Values.val
                                                (Values.Vint
                                                   (Integers.Int.repr
                                                      (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                          (and
                                             (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._eta lef)
                                                (@Some Values.val
                                                   (Values.Vlong (Integers.Int64.repr (BinNums.Zneg BinNums.xH)))))
                                             (and
                                                (@List.Forall (prod Values.block BinNums.Z)
                                                   (fun p : prod Values.block BinNums.Z =>
                                                    not (Memory.Mem.valid_block m (@fst Values.block BinNums.Z p)))
                                                   betaN)
                                                (and
                                                   (jet_sx_mem.lframe
                                                      (fun (b : Values.block) (ofs : BinNums.Z) =>
                                                       not
                                                         (jet_sx_state.foot
                                                            (@app (prod Values.block BinNums.Z) beta betaN)
                                                            (@List.map jet_sx_state.region
                                                               (prod ... ...) jet_sx_state.rshape
                                                               (jet_sx_eval.sregs
                                                                  jet_secp_modinv_var_entry.inv_start_state)) b ofs)) m
                                                      mf)
                                                   (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                                      (jet_clight_internal_permissions.keeps_permissions m mf))))))))))))))))
