### C.jet_secp_zinv_shared_preparation.zinv_shared_preparation_source
zinv_shared_preparation_source
     : @eq Clight.statement jet_secp_zinv_initial_products.zinv_after_z12
         (jet_secp_statement_prefix.statement_sequence zinv_shared_preparation zinv_after_shared_preparation)
### C.jet_secp_zinv_shared_preparation.exec_zinv_shared_preparation
exec_zinv_shared_preparation
     : forall (x y u v t : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bp ba bu bv bs bt bz : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._u1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bu jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._u2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bv jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._s1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._s2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._z12 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bz jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalize_weak e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bp
                   (@cons Values.block ba
                      (@cons Values.block bu
                         (@cons Values.block bv
                            (@cons Values.block bs (@cons Values.block bt (@cons Values.block bz (@nil Values.block)))))))))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (x i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (y i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : jet_secp_square_columns.square_input_bounds u) (_ : jet_secp_square_columns.square_input_bounds v)
         (_ : jet_secp_square_columns.square_input_bounds t)
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 v))
         (_ : jet_secp_fe_nv.fe_at m bz BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 t))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bu BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bv BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence zinv_shared_preparation Clight.Sskip) Events.E0 le mf
               ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf bp
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
                     (and
                        (jet_secp_fe_nv.fe_at mf ba
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           (jet_secp_multiply_normalize_bridge.words5 v))
                        (and (jet_secp_fe_nv.fe_at mf bz BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 t))
                           (and
                              (jet_secp_fe_nv.fe_at mf bu BinNums.Z0
                                 (jet_secp_multiply_normalize_bridge.words5
                                    (jet_secp_field_weak_loose.weak_loose_words x)))
                              (and
                                 (jet_secp_fe_nv.fe_at mf bv BinNums.Z0
                                    (jet_secp_multiply_normalize_bridge.words5
                                       (jet_secp_point_mul_storage.point_mul_words u t)))
                                 (and
                                    (jet_secp_fe_nv.fe_at mf bs BinNums.Z0
                                       (jet_secp_multiply_normalize_bridge.words5
                                          (jet_secp_field_weak_loose.weak_loose_words y)))
                                    (and
                                       (jet_secp_fe_nv.fe_at mf bt BinNums.Z0
                                          (jet_secp_multiply_normalize_bridge.words5
                                             (jet_secp_point_mul_storage.point_mul_words v t)))
                                       (and
                                          (Memory.Mem.range_perm mf bp BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (Memory.Mem.range_perm mf ba BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                                Memtype.Cur Memtype.Freeable)
                                             (and
                                                (Memory.Mem.range_perm mf bu BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (and
                                                   (Memory.Mem.range_perm mf bv BinNums.Z0
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                      Memtype.Cur Memtype.Freeable)
                                                   (and
                                                      (Memory.Mem.range_perm mf bs BinNums.Z0
                                                         (BinNums.Zpos
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                         Memtype.Cur Memtype.Freeable)
                                                      (and
                                                         (Memory.Mem.range_perm mf bt BinNums.Z0
                                                            (BinNums.Zpos
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))
                                                            Memtype.Cur Memtype.Freeable)
                                                         (and
                                                            (Memory.Mem.range_perm mf bz BinNums.Z0
                                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))
                                                               Memtype.Cur Memtype.Freeable)
                                                            (and
                                                               (jet_secp_field_mul_small.mul_small_input_bounds
                                                                  (jet_secp_field_weak_loose.weak_loose_words x))
                                                               (and
                                                                  (jet_secp_field_mul_small.mul_small_input_bounds
                                                                     (jet_secp_field_weak_loose.weak_loose_words y))
                                                                  (and
                                                                     (jet_secp_square_columns.square_input_bounds
                                                                        (jet_secp_point_mul_storage.point_mul_words u t))
                                                                     (and
                                                                        (jet_secp_square_columns.square_input_bounds
                                                                           ...) (jet_sx_mem.lframe ... m mf))))))))))))))))))))))
### C.jet_secp_zinv_shared_preparation.zinv_statement_drop
zinv_statement_drop =
fix zinv_statement_drop (n : nat) (s : Clight.statement) {struct n} : Clight.statement :=
  match n return Clight.statement with
  | O => s
  | S n0 =>
      match s return Clight.statement with
      | Clight.Sskip => Clight.Sskip
      | Clight.Sassign _ _ => Clight.Sskip
      | Clight.Sset _ _ => Clight.Sskip
      | Clight.Scall _ _ _ => Clight.Sskip
      | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
      | Clight.Ssequence _ tail => zinv_statement_drop n0 tail
      | Clight.Sifthenelse _ _ _ => Clight.Sskip
      | Clight.Sloop _ _ => Clight.Sskip
      | Clight.Sbreak => Clight.Sskip
      | Clight.Scontinue => Clight.Sskip
      | Clight.Sreturn _ => Clight.Sskip
      | Clight.Sswitch _ _ => Clight.Sskip
      | Clight.Slabel _ _ => Clight.Sskip
      | Clight.Sgoto _ => Clight.Sskip
      end
  end
     : forall (_ : nat) (_ : Clight.statement), Clight.statement

Arguments zinv_statement_drop n%nat_scope s
### C.jet_secp_zinv_shared_preparation.zinv_shared_preparation
zinv_shared_preparation =
@app Clight.statement (jet_secp_zinv_coordinate.zinv_coordinate_statements false)
  (jet_secp_zinv_coordinate.zinv_coordinate_statements true)
     : list Clight.statement
### C.jet_secp_zinv_shared_preparation.zinv_after_shared_preparation
zinv_after_shared_preparation =
zinv_statement_drop (S (S (S (S (S (S O)))))) jet_secp_zinv_initial_products.zinv_after_z12
     : Clight.statement
### C.jet_secp_zinv_shared_preparation.zinv_shared_frame
zinv_shared_frame =
fun (bu bv bs bt bz ba bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bu))
  (and (not (@eq Values.block bx bv))
     (and (not (@eq Values.block bx bs))
        (and (not (@eq Values.block bx bt))
           (and (not (@eq Values.block bx bz))
              (or (not (@eq Values.block bx ba))
                 (or (BinInt.Z.lt pos BinNums.Z0)
                    (BinInt.Z.le
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments zinv_shared_frame bu bv bs bt bz ba bx pos%Z_scope
