### C.jet_secp_affine_skip.affine_skip_ge_source
affine_skip_ge_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_skip_ge)
         (Clight.Ssequence affine_skip_fe_stmt affine_skip_fe_stmt)
### C.jet_secp_affine_skip.affine_skip_fe_link
affine_skip_fe_link
     : @ex Values.block
         (fun bf : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                  jets_secp._skip_fe) (@Some Values.block bf))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                  bf) (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_skip_fe))))
### C.jet_secp_affine_skip.exec_affine_skip_field
exec_affine_skip_field
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bd : Values.block)
         (base : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_skip_fe)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m affine_skip_fe_stmt Events.E0 le
         mf ClightBigstep.Out_normal
### C.jet_secp_affine_skip.eval_secp_skip_ge_from_prefix
eval_secp_skip_ge_from_prefix
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (written0 : bool) (outs0 : list BitMachine.Cell)
         (m : Memory.Mem.mem) (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le
                (BinInt.Z.add (BinInt.Z.of_nat (@length BitMachine.Cell outs0))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                N) (_ : jet_frame_inv.finv m0 bd base bw edge cursor N bi m written0 outs0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_skip_ge)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mf
               Values.Vundef)
            (and
               (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                  (@app BitMachine.Cell outs0
                     (@List.repeat (option bool) (@None bool)
                        (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))
               (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m mf)))
### C.jet_secp_affine_skip.affine_skip_fe_stmt
affine_skip_fe_stmt =
Clight.Scall (@None AST.ident) (Clight.Evar jets_secp._skip_fe (Clight.type_of_function jets_secp.f_skip_fe))
  (@cons Clight.expr
     (Clight.Etempvar jets_secp._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr)))
     (@nil Clight.expr))
     : Clight.statement
