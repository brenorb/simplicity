               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (jet_secp_rescale_literal.rescale_field_output
                  (jet_secp_double_var_owned.double_var_x_words flag (jet_secp_square_spec_bridge.square_reader_rho a)
                     (jet_secp_square_spec_bridge.square_reader_rho b)))
               (jet_secp_rescale_literal.rescale_field_output
                  (jet_secp_double_var_owned.double_var_y_words flag (jet_secp_square_spec_bridge.square_reader_rho a)
                     (jet_secp_square_spec_bridge.square_reader_rho b))))
            (jet_secp_rescale_literal.rescale_field_output
               (jet_secp_double_var_owned.double_var_z_words flag (jet_secp_square_spec_bridge.square_reader_rho b)
                  (jet_secp_square_spec_bridge.square_reader_rho c))))
         (@jet_secp_double_literal.literal_gej_double Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b) c))
### C.jet_secp_double_literal_bridge.eval_double_var_literal
eval_double_var_literal
     : forall (a b c : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba : Values.block)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val
                   (Values.Vint
                      (jet_readBit_layout.bit_int
                         (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem c))))))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho a)))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho b)))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho c)))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun x : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun y : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun z : forall _ : nat, Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_double_var)
                        (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val)))) Events.E0 mf
                        Values.Vundef)
                     (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                        (and
                           (jet_secp_fe_nv.fe_at mf ba
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 y))
                           (and
                              (jet_secp_fe_nv.fe_at mf ba
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (jet_secp_multiply_normalize_bridge.words5 z))
                              (and
                                 (Memory.Mem.range_perm mf ba BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and (jet_secp_square_columns.square_input_bounds x)
                                    (and (jet_secp_square_columns.square_input_bounds y)
                                       (and (jet_secp_square_columns.square_input_bounds z)
                                          (and
                                             (@eq
                                                (prod
                                                   (prod (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...))))))))
                                                (@pair
                                                   (prod (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (@pair (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (jet_secp_rescale_literal.rescale_field_output x)
                                                      (jet_secp_rescale_literal.rescale_field_output y))
                                                   (jet_secp_rescale_literal.rescale_field_output z))
                                                (@jet_secp_double_literal.literal_gej_double Alg.CoreFunSem
                                                   (@pair
                                                      (prod (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (@pair (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))) a b) c)))
                                             (jet_sx_mem.lframe
                                                (fun (b0 : Values.block) (_ : BinNums.Z) =>
                                                 not (@eq Values.block b0 ba)) m mf)))))))))))))
