### C.jet_secp_double_literal_bridge.double_field_output_matches
double_field_output_matches
     : forall (w : forall _ : nat, Integers.Int64.int) (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (jet_secp_rescale_literal.rescale_field_output w) a
### C.jet_secp_double_literal_bridge.double_body_writer_outputs_literal
double_body_writer_outputs_literal
     : forall (x y z : forall _ : nat, Integers.Int64.int)
         (a b c : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value x) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value y) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) c)
                   jet_secp_fe_math.feP)),
       @eq
         (prod
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@pair
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (jet_secp_rescale_literal.rescale_field_output (jet_secp_double_all_calls.double_output_x_words x y))
               (jet_secp_rescale_literal.rescale_field_output (jet_secp_double_all_calls.double_output_y_words x y)))
            (jet_secp_rescale_literal.rescale_field_output (jet_secp_double_all_calls.double_output_z_words y z)))
         (@jet_secp_double_literal.literal_gej_double_body Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b) c))
### C.jet_secp_double_literal_bridge.double_reader_outputs_literal
double_reader_outputs_literal
     : forall a b c : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       let flag : Integers.Int.int :=
         jet_readBit_layout.bit_int (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem c)) in
       @eq
         (prod
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@pair
