### C.jet_elements_taptweak_strauss_finish_support.elements_taptweak_strauss_readonly_blocks
elements_taptweak_strauss_readonly_blocks =
@cons Values.block (jet_elements_taptweak_split_constants.elements_taptweak_multiplier_block true)
  (@cons Values.block (jet_elements_taptweak_split_constants.elements_taptweak_multiplier_block false)
     (@cons Values.block (jet_elements_taptweak_split_constants.elements_taptweak_basis_block true)
        (@cons Values.block (jet_elements_taptweak_split_constants.elements_taptweak_basis_block false)
           (@cons Values.block jet_elements_taptweak_split_constants.elements_taptweak_lambda_block
              (@cons Values.block jet_elements_taptweak_beta.elements_taptweak_beta_block (@nil Values.block))))))
     : list Values.block
