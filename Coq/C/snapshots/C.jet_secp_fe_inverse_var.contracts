### C.jet_secp_fe_inverse_var.exec_fe_inv_inverse
exec_fe_inv_inverse
     : forall (le : Clight.temp_env) (mp mc : Memory.Mem.mem) (bt bs : Values.block)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mp
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_var)
                (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr jet_secp_modinfo_fe_global.modinfo_fe_block Integers.Ptrofs.zero)
                      (@nil Values.val))) Events.E0 mc Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_fe_inv_statements.fe_inv_env bt bs) le mp
         jet_secp_fe_inv_statements.fe_inv_inverse Events.E0 le mc ClightBigstep.Out_normal
### C.jet_secp_fe_inverse_var.eval_fe_inverse_var_slice
eval_fe_inverse_var_slice
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bx : Values.block)
         (sbase : BinNums.Z) (bd : Values.block) (dbase size : BinNums.Z)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bx sbase (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m) (_ : BinInt.Z.le BinNums.Z0 dbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) dbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add dbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add dbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : Memory.Mem.range_perm m bd BinNums.Z0 size Memtype.Cur Memtype.Freeable),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun result : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_inv_var)
                  (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                     (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr sbase)) (@nil Values.val))) Events.E0 mf
                  Values.Vundef)
               (and (jet_secp_fe_nv.fe_at mf bd dbase (jet_secp_multiply_normalize_bridge.words5 result))
                  (and (jet_secp_square_columns.square_input_bounds result)
                     (and
                        (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value result)
                           (jet_secp_invert_literal.literal_invert_numeric (jet_secp_fe_inv_prefix.fe_inv_value w)))
                        (and
                           (forall (input : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (_ : @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value w)
                                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) input)),
                            @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
                              (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                 (jet_secp_multiply_finish_product.radix_value result))
                              (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem input))
                           (and (Memory.Mem.range_perm mf bd BinNums.Z0 size Memtype.Cur Memtype.Freeable)
                              (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (pos : BinNums.Z) =>
                                        or (not (@eq Values.block b bd))
                                          (or (BinInt.Z.lt pos dbase)
                                             (BinInt.Z.le
                                                (BinInt.Z.add dbase
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                                pos))) m mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
### C.jet_secp_fe_inverse_var.eval_fe_inverse_var
eval_fe_inverse_var
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bx bd : Values.block)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m)
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun result : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_inv_var)
                  (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                  Values.Vundef)
               (and (jet_secp_fe_nv.fe_at mf bd BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 result))
                  (and (jet_secp_square_columns.square_input_bounds result)
                     (and
                        (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value result)
                           (jet_secp_invert_literal.literal_invert_numeric (jet_secp_fe_inv_prefix.fe_inv_value w)))
                        (and
                           (forall (input : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (_ : @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value w)
                                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) input)),
                            @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
                              (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                 (jet_secp_multiply_finish_product.radix_value result))
                              (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem input))
                           (and
                              (Memory.Mem.range_perm mf bd BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m mf)
                                    (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
### C.jet_secp_fe_inverse_var.eval_fe_inverse_var_point
eval_fe_inverse_var_point
     : forall (w x y : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bp : Values.block)
         (_ : forall (mc : Memory.Mem.mem) (z : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned z) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong z) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned z)))))
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y)) (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun result : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_inv_var)
                  (@cons Values.val
                     (Values.Vptr bp
                        (Integers.Ptrofs.repr
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                     (@cons Values.val
                        (Values.Vptr bp
                           (Integers.Ptrofs.repr
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                        (@nil Values.val))) Events.E0 mf Values.Vundef)
               (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                  (and
                     (jet_secp_fe_nv.fe_at mf bp
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        (jet_secp_multiply_normalize_bridge.words5 y))
                     (and
                        (jet_secp_fe_nv.fe_at mf bp
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (jet_secp_multiply_normalize_bridge.words5 result))
                        (and (jet_secp_square_columns.square_input_bounds result)
                           (and
                              (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value result)
                                 (jet_secp_invert_literal.literal_invert_numeric
                                    (jet_secp_fe_inv_prefix.fe_inv_value w)))
                              (and
                                 (forall (input : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (_ : @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value w)
                                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) input)),
                                  @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
                                    (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                       (jet_secp_multiply_finish_product.radix_value result))
                                    (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem input))
                                 (and
                                    (Memory.Mem.range_perm mf bp BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (pos : BinNums.Z) =>
                                              or (not (@eq Values.block b bp))
                                                (or
                                                   (BinInt.Z.lt pos
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))
                                                   (BinInt.Z.le
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI ...))))))
                                                      pos))) m mf)
                                          (jet_clight_internal_preserve.readonly_preserved m mf))))))))))))
