### C.jet_nonce_context_shape.nc_body_shape
nc_body_shape
     : @eq Clight.statement (Clight.fn_body jets_elements.f_simplicity_nonce_hash)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_elements._src nc_fr) (Clight.Etempvar jets_elements._src nc_fr))
            (jet_elements_support_sha_add_n_init.an_init
               (Clight.Ssequence nc_context_read (Clight.Ssequence nc_nonce nc_context_write))))
### C.jet_nonce_context_shape.nc_header
nc_header
     : and
         (@eq (list (prod AST.ident Ctypes.type)) (Clight.fn_vars jets_elements.f_simplicity_nonce_hash)
            (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_elements._src nc_fr)
               (@cons (prod AST.ident Ctypes.type)
                  (@pair AST.ident Ctypes.type jets_elements._midstate
                     (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
                  (@cons (prod AST.ident Ctypes.type)
                     (@pair AST.ident Ctypes.type jets_elements._buf
                        (Ctypesdefs.tarray Ctypesdefs.tuchar
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (@cons (prod AST.ident Ctypes.type)
                        (@pair AST.ident Ctypes.type jets_elements._ctx
                           (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
                        (@nil (prod AST.ident Ctypes.type)))))))
         (and
            (@eq (list (prod AST.ident Ctypes.type)) (Clight.fn_temps jets_elements.f_simplicity_nonce_hash)
               (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_elements._t'5 Ctypesdefs.tbool)
                  (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_elements._t'4 Ctypesdefs.tbool)
                     (@cons (prod AST.ident Ctypes.type)
                        (@pair AST.ident Ctypes.type jets_elements._t'3 Ctypesdefs.tbool)
                        (@cons (prod AST.ident Ctypes.type)
                           (@pair AST.ident Ctypes.type jets_elements._t'2 Ctypesdefs.tbool)
                           (@cons (prod AST.ident Ctypes.type)
                              (@pair AST.ident Ctypes.type jets_elements._t'1 Ctypesdefs.tbool)
                              (@nil (prod AST.ident Ctypes.type))))))))
            (and (@eq Ctypes.type (Clight.fn_return jets_elements.f_simplicity_nonce_hash) Ctypesdefs.tbool)
               (@eq AST.calling_convention (Clight.fn_callconv jets_elements.f_simplicity_nonce_hash) AST.cc_default)))
### C.jet_nonce_context_shape.nc_blocks
nc_blocks
     : forall bl bm bb bx : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_linkage.elements_ge (nc_env bl bm bb bx))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bm BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bb BinNums.Z0)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))
### C.jet_nonce_context_shape.nc_entry
nc_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 : Memory.Mem.mem') (bl bm bb bx bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bm))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 bb))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m4 bx)),
       Clight.function_entry2 jet_elements_linkage.elements_ge jets_elements.f_simplicity_nonce_hash
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (nc_env bl bm bb bx) (nc_temps env bd dbase bs sbase) m4
### C.jet_nonce_context_shape.nc_fr
nc_fr = Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr
     : Ctypes.type
### C.jet_nonce_context_shape.nc_readbit
nc_readbit =
fun id : AST.ident =>
Clight.Scall (@Some AST.ident id)
  (Clight.Evar jets_elements._readBit
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Ctypes.Tnil)
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._src nc_fr)
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) (@nil Clight.expr))
     : forall _ : AST.ident, Clight.statement

Arguments nc_readbit id
### C.jet_nonce_context_shape.nc_uchar
nc_uchar =
fun k : BinNums.Z =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._sha256_uchar
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
     (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr k) Ctypesdefs.tint) (@nil Clight.expr)))
     : forall _ : BinNums.Z, Clight.statement

Arguments nc_uchar k%Z_scope
### C.jet_nonce_context_shape.nc_forward
nc_forward =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._forwardBits
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._src nc_fr)
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
     (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_nonce_context_shape.nc_readbytes
nc_readbytes =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._read8s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar)
           (Ctypes.Tcons Ctypesdefs.tulong
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Evar jets_elements._buf
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@cons Clight.expr
        (Clight.Econst_int
           (Integers.Int.repr
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
           Ctypesdefs.tint)
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_elements._src nc_fr)
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) (@nil Clight.expr))))
     : Clight.statement
### C.jet_nonce_context_shape.nc_uchars
nc_uchars =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._sha256_uchars
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Evar jets_elements._buf
           (Ctypesdefs.tarray Ctypesdefs.tuchar
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        (@cons Clight.expr
           (Clight.Econst_int
              (Integers.Int.repr
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
              Ctypesdefs.tint) (@nil Clight.expr))))
     : Clight.statement
### C.jet_nonce_context_shape.nc_prefix
nc_prefix =
Clight.Ssequence (nc_readbit jets_elements._t'3)
  (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'3 Ctypesdefs.tbool)
     (Clight.Ssequence nc_forward (nc_uchar (BinNums.Zpos BinNums.xH)))
     (Clight.Ssequence (nc_readbit jets_elements._t'2)
        (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'2 Ctypesdefs.tbool)
           (nc_uchar (BinNums.Zpos (BinNums.xI BinNums.xH))) (nc_uchar (BinNums.Zpos (BinNums.xO BinNums.xH))))))
     : Clight.statement
### C.jet_nonce_context_shape.nc_nonce
nc_nonce =
Clight.Ssequence (nc_readbit jets_elements._t'4)
  (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'4 Ctypesdefs.tbool)
     (Clight.Ssequence nc_prefix (Clight.Ssequence nc_readbytes nc_uchars)) (nc_uchar BinNums.Z0))
     : Clight.statement
### C.jet_nonce_context_shape.nc_context_read
nc_context_read =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_elements._t'1)
     (Clight.Evar jets_elements._simplicity_read_sha256_context
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_elements._src nc_fr)
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) (@nil Clight.expr))))
  (Clight.Sifthenelse (Clight.Eunop Cop.Onotbool (Clight.Etempvar jets_elements._t'1 Ctypesdefs.tbool) Ctypesdefs.tint)
     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint)))
     Clight.Sskip)
     : Clight.statement
### C.jet_nonce_context_shape.nc_context_write
nc_context_write =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_elements._t'5)
     (Clight.Evar jets_elements._simplicity_write_sha256_context
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof
              (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
           (@nil Clight.expr))))
  (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_elements._t'5 Ctypesdefs.tbool)))
     : Clight.statement
### C.jet_nonce_context_shape.nc_env
nc_env =
fun bl bm bb bx : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._ctx
  (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._buf
     (@pair Values.block Ctypes.type bb
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._midstate
        (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._src (@pair Values.block Ctypes.type bl nc_fr)
           Clight.empty_env)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments nc_env bl bm bb bx
### C.jet_nonce_context_shape.nc_temps
nc_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_elements._env env
  (@Maps.PTree.set Values.val jets_elements._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_elements._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_simplicity_nonce_hash))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments nc_temps env bd dbase%Z_scope bs sbase%Z_scope
