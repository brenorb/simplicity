### C.jet_nonce_exec_phase.nonce_counter_one_then_32
nonce_counter_one_then_32
     : forall c : Integers.Int64.int,
       @eq Integers.Int64.int
         (Integers.Int64.add (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
            (Integers.Int64.repr
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (Integers.Int64.add c
            (Integers.Int64.repr
               (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
### C.jet_nonce_exec_phase.nonce_present_prefix
nonce_present_prefix
     : forall (_ : jet_memcpy_model.memcpy_model) (bl bm bb bx bi : Values.block) (_ : not (@eq Values.block bl bx))
         (_ : not (@eq Values.block bl bm))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bi bl)) (_ : not (@eq Values.block bi bx)) (_ : not (@eq Values.block bi bm))
         (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (le : Clight.temp_env) (m : Memory.Mem.mem) (edge rc : BinNums.Z)
         (p : Ty.tySem jet_nonce_context_spec.nonce_conf_type) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xI
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode jet_nonce_context_spec.nonce_conf_type p))
         (_ : jet_elements_support_sha_ctx_abs.ctx_abs m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
               (jet_nonce_context_shape.nc_env bl bm bb bx) le m jet_nonce_context_shape.nc_prefix Events.E0
               (nonce_present_temps p le) mf ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                  (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO BinNums.xH))))
               (and
                  (jet_encoding.frame_input_cells_at mf bi edge
                     (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO BinNums.xH)))
                     (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (@snd (Ty.tySem (Word.Word (S (S (S O)))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (jet_nonce_context_spec.nonce_prefix_value p))))
                  (and
                     (jet_elements_support_sha_ctx_abs.ctx_abs mf bx bm
                        (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                           (jet_sha_ctx8_model.absorb l regs
                              (@cons (Ty.tySem (Word.Word (S (S (S O)))))
                                 (@fst (Ty.tySem (Word.Word (S (S (S O)))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (jet_nonce_context_spec.nonce_prefix_value p))
                                 (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
                        (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                           (jet_sha_ctx8_model.absorb l regs
                              (@cons (Ty.tySem (Word.Word (S (S (S O)))))
                                 (@fst (Ty.tySem (Word.Word (S (S (S O)))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (jet_nonce_context_spec.nonce_prefix_value p))
                                 (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
                        (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
                        (jet_elements_support_sha_uchars_exec.uc_overflow ovf c
                           (Integers.Int64.repr (BinNums.Zpos BinNums.xH))))
                     (jet_nonce_exec_effects.nonce_effects m mf
                        (@cons Values.block bl (@cons Values.block bx (@cons Values.block bm (@nil Values.block)))))))))
### C.jet_nonce_exec_phase.nonce_phase_exec
nonce_phase_exec
     : forall (_ : jet_memcpy_model.memcpy_model) (bl bm bb bx bi : Values.block) (_ : not (@eq Values.block bl bx))
         (_ : not (@eq Values.block bl bm))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bb bx)) (_ : not (@eq Values.block bb bm))
         (_ : not
                (@eq Values.block bb
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bb
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bl bb)) (_ : not (@eq Values.block bi bl)) (_ : not (@eq Values.block bi bb))
         (_ : not (@eq Values.block bi bx)) (_ : not (@eq Values.block bi bm)) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (le : Clight.temp_env) (m : Memory.Mem.mem) (edge rc : BinNums.Z)
         (a : Ty.tySem jet_nonce_context_spec.nonce_value_type) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode jet_nonce_context_spec.nonce_value_type a))
         (_ : jet_elements_support_sha_ctx_abs.ctx_abs m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
               (jet_nonce_context_shape.nc_env bl bm bb bx) le m jet_nonce_context_shape.nc_nonce Events.E0
               (nonce_phase_temps a le) mf ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge (BinInt.Z.add rc (nonce_phase_read_bits a)))
               (and
                  (jet_elements_support_sha_ctx_abs.ctx_abs mf bx bm
                     (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                        (jet_sha_ctx8_model.absorb l regs (jet_nonce_context_spec.nonce_hash_bytes a)))
                     (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                        (jet_sha_ctx8_model.absorb l regs (jet_nonce_context_spec.nonce_hash_bytes a)))
                     (Integers.Int64.add c (Integers.Int64.repr (nonce_phase_count a))) (nonce_phase_overflow ovf c a))
                  (jet_nonce_exec_effects.nonce_effects m mf
                     (@cons Values.block bl
                        (@cons Values.block bb (@cons Values.block bx (@cons Values.block bm (@nil Values.block)))))))))
### C.jet_nonce_exec_phase.nonce_present_temps
nonce_present_temps =
fun (p : Ty.tySem jet_nonce_context_spec.nonce_conf_type) (le : Clight.temp_env) =>
match p return (Maps.PTree.tree Values.val) with
| inl t =>
    match t return (Maps.PTree.tree Values.val) with
    | pair odd _ =>
        @Maps.PTree.set Values.val jets_elements._t'2
          (Values.Vint (jet_readBit_layout.bit_int match odd return bool with
                                                   | inl _ => false
                                                   | inr _ => true
                                                   end))
          (@Maps.PTree.set Values.val jets_elements._t'3 (Values.Vint Integers.Int.zero) le)
    end
| inr _ => @Maps.PTree.set Values.val jets_elements._t'3 (Values.Vint Integers.Int.one) le
end
     : forall (_ : Ty.tySem jet_nonce_context_spec.nonce_conf_type) (_ : Clight.temp_env), Maps.PTree.tree Values.val

Arguments nonce_present_temps p le
### C.jet_nonce_exec_phase.nonce_phase_temps
nonce_phase_temps =
fun (a : Ty.tySem jet_nonce_context_spec.nonce_value_type) (le : Clight.temp_env) =>
match a return (Maps.PTree.tree Values.val) with
| inl _ => @Maps.PTree.set Values.val jets_elements._t'4 (Values.Vint Integers.Int.zero) le
| inr p => nonce_present_temps p (@Maps.PTree.set Values.val jets_elements._t'4 (Values.Vint Integers.Int.one) le)
end
     : forall (_ : Ty.tySem jet_nonce_context_spec.nonce_value_type) (_ : Clight.temp_env), Maps.PTree.tree Values.val

Arguments nonce_phase_temps a le
### C.jet_nonce_exec_phase.nonce_phase_count
nonce_phase_count =
fun a : Ty.tySem jet_nonce_context_spec.nonce_value_type =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos BinNums.xH
| inr _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
end
     : forall _ : Ty.tySem jet_nonce_context_spec.nonce_value_type, BinNums.Z

Arguments nonce_phase_count a
### C.jet_nonce_exec_phase.nonce_phase_read_bits
nonce_phase_read_bits =
fun a : Ty.tySem jet_nonce_context_spec.nonce_value_type =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos BinNums.xH
| inr _ =>
    BinNums.Zpos
      (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
end
     : forall _ : Ty.tySem jet_nonce_context_spec.nonce_value_type, BinNums.Z

Arguments nonce_phase_read_bits a
### C.jet_nonce_exec_phase.nonce_phase_overflow
nonce_phase_overflow =
fun (ovf : bool) (c : Integers.Int64.int) (a : Ty.tySem jet_nonce_context_spec.nonce_value_type) =>
match a return bool with
| inl _ => jet_elements_support_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH))
| inr _ =>
    jet_elements_support_sha_uchars_exec.uc_overflow
      (jet_elements_support_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
      (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
      (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
end
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Ty.tySem jet_nonce_context_spec.nonce_value_type), bool

Arguments nonce_phase_overflow ovf%bool_scope c a
