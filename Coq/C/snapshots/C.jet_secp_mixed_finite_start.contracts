### C.jet_secp_mixed_finite_start.mixed_finite_source
mixed_finite_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_gej_add_ge_var)
         (Clight.Ssequence jet_secp_mixed_head.mixed_head
            (Clight.Ssequence mixed_b_head (Clight.Ssequence mixed_square_stmt mixed_after_square)))
### C.jet_secp_mixed_finite_start.eval_mixed_b_field
eval_mixed_b_field
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bb : Values.block)
         (fid : AST.ident) (delta : BinNums.Z) (ty : Ctypes.type)
         (_ : @List.In (prod AST.ident BinNums.Z) (@pair AST.ident BinNums.Z fid delta)
                (@cons (prod AST.ident BinNums.Z) (@pair AST.ident BinNums.Z jets_secp._x BinNums.Z0)
                   (@cons (prod AST.ident BinNums.Z)
                      (@pair AST.ident BinNums.Z jets_secp._y
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                      (@cons (prod AST.ident BinNums.Z)
                         (@pair AST.ident BinNums.Z jets_secp._infinity
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                         (@nil (prod AST.ident BinNums.Z))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val (Values.Vptr bb Integers.Ptrofs.zero))),
       Clight.eval_lvalue jet_secp_linkage.secp_ge e le m (mixed_b_field fid ty) bb (Integers.Ptrofs.repr delta)
         Ctypes.Full
### C.jet_secp_mixed_finite_start.exec_mixed_b_head_finite
exec_mixed_b_head_finite
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bb : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val (Values.Vptr bb Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bb
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m mixed_b_head Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'3 (Values.Vint Integers.Int.zero) le) m ClightBigstep.Out_normal
### C.jet_secp_mixed_finite_start.exec_mixed_finite_start
exec_mixed_finite_start
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (ba bb bz : Values.block) (z : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val (Values.Vptr bb Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._z12 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bz jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block ba bz))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bb
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero))) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m mixed_start_stmt Events.E0
               (@Maps.PTree.set Values.val jets_secp._t'3 (Values.Vint Integers.Int.zero)
                  (@Maps.PTree.set Values.val jets_secp._t'4 (Values.Vint Integers.Int.zero) le)) mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bz BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words z)))
               (and
                  (Memory.Mem.range_perm mf bz BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_secp_fe_nv.fe_at mf ba
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5 z))
                     (and
                        (Memory.Mem.range_perm mf ba BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value (jet_secp_square_numeric.square_words z))
                                 jet_secp_multiply_checkpoint_columns.field_prime)
                              (BinInt.Z.modulo
                                 (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value z)
                                    (jet_secp_multiply_finish_product.radix_value z))
                                 jet_secp_multiply_checkpoint_columns.field_prime))
                           (and (jet_secp_square_columns.square_input_bounds (jet_secp_square_numeric.square_words z))
                              (jet_sx_mem.lframe
                                 (jet_secp_point_square_coordinate.point_square_coordinate_frame
                                    jet_secp_point_write_run.PointZ bz ba) m mf))))))))
### C.jet_secp_mixed_finite_start.mixed_b_field
mixed_b_field =
fun (fid : AST.ident) (ty : Ctypes.type) =>
Clight.Efield
  (Clight.Ederef (Clight.Etempvar jets_secp._b (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type))
     jet_secp_curve_statements.curve_ge_type) fid ty
     : forall (_ : AST.ident) (_ : Ctypes.type), Clight.expr

Arguments mixed_b_field fid ty
### C.jet_secp_mixed_finite_start.mixed_b_head
mixed_b_head =
match jet_secp_mixed_head.mixed_tail return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence h _ => h
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_mixed_finite_start.mixed_finite_rest
mixed_finite_rest =
match jet_secp_mixed_head.mixed_tail return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ t => t
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_mixed_finite_start.mixed_square_stmt
mixed_square_stmt =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_sqr jets_secp.f_secp256k1_fe_sqr
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._z12)
     (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._a jets_secp._z) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_mixed_finite_start.mixed_after_square
mixed_after_square =
match mixed_finite_rest return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ t => t
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_mixed_finite_start.mixed_start_stmt
mixed_start_stmt =
Clight.Ssequence jet_secp_mixed_head.mixed_head (Clight.Ssequence mixed_b_head mixed_square_stmt)
     : Clight.statement
