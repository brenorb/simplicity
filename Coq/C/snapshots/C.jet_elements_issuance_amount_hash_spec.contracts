### C.jet_elements_issuance_amount_hash_spec.issuance_asset_amount_absorb_spec_parametric
issuance_asset_amount_absorb_spec_parametric
     : @Alg.Assertion.Parametric (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type issuance_asset_amount_value_type)
         jet_sha256_ctx8_init_spec.sha256_ctx8_type (@issuance_asset_amount_absorb_spec)
### C.jet_elements_issuance_amount_hash_spec.issuance_asset_amount_absorb_option
issuance_asset_amount_absorb_option
     : forall
         (c : prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (S (S (S (S (S (S O))))))))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (v : sum unit
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) jet_elements_asset_amount_hash_spec.elements_amount_hash_type))),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (@issuance_asset_amount_absorb_spec (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                  (prod
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S O))))))))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
               (sum unit
                  (prod
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) jet_elements_asset_amount_hash_spec.elements_amount_hash_type))) c v))
         (jet_sha_ctx8_spec.ctx8_add_list c (issuance_asset_amount_bytes v))
### C.jet_elements_issuance_amount_hash_spec.issuance_asset_amount_bytes_bound
issuance_asset_amount_bytes_bound
     : forall v : Ty.tySem issuance_asset_amount_value_type,
       BinInt.Z.le (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (issuance_asset_amount_bytes v)))
         (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
### C.jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type
issuance_asset_amount_value_type =
Ty.Sum Ty.Unit
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) jet_elements_asset_amount_hash_spec.elements_amount_hash_type)
     : Ty.Ty
### C.jet_elements_issuance_amount_hash_spec.issuance_asset_amount_absorb_spec
issuance_asset_amount_absorb_spec =
fun term : Alg.Assertion.Algebra =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp
  (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
     (Ty.Sum Ty.Unit
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           jet_elements_asset_amount_hash_spec.elements_amount_hash_type)))
  (Ty.Prod
     (Ty.Sum Ty.Unit
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           jet_elements_asset_amount_hash_spec.elements_amount_hash_type)) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  jet_sha256_ctx8_init_spec.sha256_ctx8_type core
  (@jet_sha256_ctx8_init_spec.AC.pair
     (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
        (Ty.Sum Ty.Unit
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              jet_elements_asset_amount_hash_spec.elements_amount_hash_type)))
     (Ty.Sum Ty.Unit
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           jet_elements_asset_amount_hash_spec.elements_amount_hash_type)) jet_sha256_ctx8_init_spec.sha256_ctx8_type
     core
     (@jet_sha256_ctx8_init_spec.AC.drop jet_sha256_ctx8_init_spec.sha256_ctx8_type
        (Ty.Sum Ty.Unit
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              jet_elements_asset_amount_hash_spec.elements_amount_hash_type))
        (Ty.Sum Ty.Unit
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              jet_elements_asset_amount_hash_spec.elements_amount_hash_type)) core
        (@jet_sha256_ctx8_init_spec.AC.iden
           (Ty.Sum Ty.Unit
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 jet_elements_asset_amount_hash_spec.elements_amount_hash_type)) core))
     (@jet_sha256_ctx8_init_spec.AC.take jet_sha256_ctx8_init_spec.sha256_ctx8_type
        (Ty.Sum Ty.Unit
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              jet_elements_asset_amount_hash_spec.elements_amount_hash_type))
        jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core)))
  (@jet_sha256_ctx8_init_spec.AC.case Ty.Unit
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        jet_elements_asset_amount_hash_spec.elements_amount_hash_type) jet_sha256_ctx8_init_spec.sha256_ctx8_type
     jet_sha256_ctx8_init_spec.sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type)
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S O))))))
        jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.pair (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type)
           jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S O))))) core
           (@jet_sha256_ctx8_init_spec.AC.drop Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
              jet_sha256_ctx8_init_spec.sha256_ctx8_type core
              (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core))
           (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type) Ty.Unit
              (Word.Word (S (S (S (S O))))) core
              (@jet_sha256_ctx8_init_spec.AC.unit (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type) core)
              (@Word.zero (S (S (S (S O)))) core))) (@jet_sha_ctx8_spec.ctx8_addn_spec (S O) term))
     (@jet_sha256_ctx8_init_spec.AC.comp
        (Ty.Prod
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              jet_elements_asset_amount_hash_spec.elements_amount_hash_type) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              jet_elements_asset_amount_hash_spec.elements_amount_hash_type))
        jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.pair
           (Ty.Prod
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 jet_elements_asset_amount_hash_spec.elements_amount_hash_type)
              jet_sha256_ctx8_init_spec.sha256_ctx8_type) jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              jet_elements_asset_amount_hash_spec.elements_amount_hash_type) core
           (@jet_sha256_ctx8_init_spec.AC.drop
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 jet_elements_asset_amount_hash_spec.elements_amount_hash_type)
              jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type core
              (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core))
           (@jet_sha256_ctx8_init_spec.AC.pair
              (Ty.Prod
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                    jet_elements_asset_amount_hash_spec.elements_amount_hash_type)
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type)
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              jet_elements_asset_amount_hash_spec.elements_amount_hash_type core
              (@jet_sha256_ctx8_init_spec.AC.injr
                 (Ty.Prod
                    (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       jet_elements_asset_amount_hash_spec.elements_amount_hash_type)
                    jet_sha256_ctx8_init_spec.sha256_ctx8_type)
                 (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_sha256_ctx8_init_spec.AC.take
                    (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       jet_elements_asset_amount_hash_spec.elements_amount_hash_type)
                    jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                    (@jet_sha256_ctx8_init_spec.AC.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       jet_elements_asset_amount_hash_spec.elements_amount_hash_type
                       (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                       (@jet_sha256_ctx8_init_spec.AC.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) core))))
              (@jet_sha256_ctx8_init_spec.AC.take
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                    jet_elements_asset_amount_hash_spec.elements_amount_hash_type)
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 jet_elements_asset_amount_hash_spec.elements_amount_hash_type core
                 (@jet_sha256_ctx8_init_spec.AC.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                    jet_elements_asset_amount_hash_spec.elements_amount_hash_type
                    jet_elements_asset_amount_hash_spec.elements_amount_hash_type core
                    (@jet_sha256_ctx8_init_spec.AC.iden jet_elements_asset_amount_hash_spec.elements_amount_hash_type
                       core))))) (@jet_elements_asset_amount_hash_spec.elements_asset_amount_hash_spec term)))
     : forall term : Alg.Assertion.Algebra,
       Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type issuance_asset_amount_value_type)
         jet_sha256_ctx8_init_spec.sha256_ctx8_type

Arguments issuance_asset_amount_absorb_spec {term}
### C.jet_elements_issuance_amount_hash_spec.issuance_asset_amount_bytes
issuance_asset_amount_bytes =
fun v : Ty.tySem issuance_asset_amount_value_type =>
match v return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl _ =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_zero
      (@cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_zero
         (@nil (Ty.tySem (Word.Word (S (S (S O)))))))
| inr t =>
    match t return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
    | pair asset amount =>
        jet_elements_asset_amount_hash_spec.elements_asset_amount_bytes
          (@pair
             (sum
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Ty.Sum Ty.Unit Ty.Unit))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                          match n return Ty.Ty with
                          | O => X
                          | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                          end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                          match n return Ty.Ty with
                          | O => X
                          | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                          end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))))
             (sum
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) (Word.Word (S (S (S (S (S (S O)))))))))
             (@inr
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Ty.Sum Ty.Unit Ty.Unit))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                          match n return Ty.Ty with
                          | O => X
                          | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                          end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                          match n return Ty.Ty with
                          | O => X
                          | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                          end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) asset) amount)
    end
end
     : forall _ : Ty.tySem issuance_asset_amount_value_type, list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments issuance_asset_amount_bytes v
