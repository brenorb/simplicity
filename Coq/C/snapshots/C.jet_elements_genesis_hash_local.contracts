### C.jet_elements_genesis_hash_local.elements_genesis_hash_spec_parametric
elements_genesis_hash_spec_parametric
     : @jet_elements_prim.PrimitiveElements.Primitive.Parametric Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@elements_genesis_hash_spec)
### C.jet_elements_genesis_hash_local.elements_genesis_hash_body
elements_genesis_hash_body
     : jet_elements_wrapper.elements_wrapper_shape jets_elements.f_simplicity_genesis_block_hash
         (jet_elements_wrapper.elements_simple_rest elements_genesis_mid)
### C.jet_elements_genesis_hash_local.elements_txEnv_genesisHash
elements_txEnv_genesisHash
     : jet_elements_field_eval.elements_field_at jets_elements._txEnv jets_elements._genesisHash
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
### C.jet_elements_genesis_hash_local.eval_elements_genesis_array_arg
eval_elements_genesis_array_arg
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (be : Values.block)
         (ebase : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase)))) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le
                (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                Integers.Ptrofs.max_unsigned),
       Clight.eval_expr jet_elements_linkage.elements_ge e le m
         (Clight.Efield
            (Clight.Efield
               (Clight.Ederef
                  (Clight.Etempvar jets_elements._env
                     (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)))
                  (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)) jets_elements._genesisHash
               (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) jets_elements._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr be
            (Integers.Ptrofs.repr
               (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
### C.jet_elements_genesis_hash_local.exec_elements_genesis_mid
exec_elements_genesis_mid
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (mc me : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (be : Values.block)
         (ebase : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._write32s e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase)))) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le
                (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                Integers.Ptrofs.max_unsigned)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mc
                (@Ctypes.Internal Clight.function jets_elements.f_write32s)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val
                      (Values.Vptr be
                         (Integers.Ptrofs.repr
                            (BinInt.Z.add ebase
                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (@cons Values.val
                         (Values.Vlong
                            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                         (@nil Values.val)))) Events.E0 me Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le mc elements_genesis_mid Events.E0 le me
         ClightBigstep.Out_normal
### C.jet_elements_genesis_hash_local.elements_genesis_block_hash_local_spec
elements_genesis_block_hash_local_spec
     : jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_genesis_block_hash
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env Ty.Unit
         (Word.Word (S (S (S (S (S (S (S (S O))))))))) elements_genesis_hash_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env) =>
          @elements_genesis_hash_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
### C.jet_elements_genesis_hash_local.elements_genesis_hash_spec
elements_genesis_hash_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  alg jet_elements_prim.Elements.GenesisBlockHash
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments elements_genesis_hash_spec {alg}
### C.jet_elements_genesis_hash_local.elements_genesis_mid
elements_genesis_mid =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._write32s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Efield
           (Clight.Efield
              (Clight.Ederef
                 (Clight.Etempvar jets_elements._env
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)))
                 (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)) jets_elements._genesisHash
              (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) jets_elements._s
           (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (@cons Clight.expr
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              Ctypesdefs.tint) (@nil Clight.expr))))
     : Clight.statement
### C.jet_elements_genesis_hash_local.elements_genesis_hash_env_rep
elements_genesis_hash_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : jet_elements_prim.Elements.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
        (and (BinInt.Z.le BinNums.Z0 ebase)
           (and
              (BinInt.Z.le
                 (BinInt.Z.add ebase
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                 Integers.Ptrofs.max_unsigned)
              (and
                 (jet_uint32_array_init.uint32_array_at m be
                    (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                    (Digest.hash256_reg (jet_elements_prim.Elements.envGenesisBlock environment)))
                 (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                    (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                       (@pair (prod Values.block BinNums.Z) BinNums.Z
                          (@pair Values.block BinNums.Z be
                             (BinInt.Z.add ebase
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                          (BinInt.Z.add ebase
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))
                       (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments elements_genesis_hash_env_rep m env environment fp%list_scope
