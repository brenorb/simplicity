### C.jet_secp_rescale_public_reads.rescale_locals_outside
rescale_locals_outside =
fun (m0 : Memory.Mem.mem) (bd bw bi bp bc bl b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b bp))
  (and (not (@eq Values.block b bc)) (and (not (@eq Values.block b bl)) (not (jet_secp_frame.extA m0 bd bw bi b))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

