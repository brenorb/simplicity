### C.jet_secp_xonly_parse_control.xonly_parse_decode_return_source
xonly_parse_decode_return_source
     : @eq Clight.statement
         (jet_secp_root_chain_owned.root_drop_statements (S (S (S (S O))))
            (Clight.fn_body jets_secp.f_secp256k1_xonly_pubkey_parse)) xonly_parse_decode_return
### C.jet_secp_xonly_parse_control.exec_xonly_guard_one
exec_xonly_guard_one
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (id : BinNums.positive)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vint Integers.Int.one))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (xonly_parse_guard id) Events.E0 le m
         ClightBigstep.Out_normal
### C.jet_secp_xonly_parse_control.exec_xonly_guard_zero
exec_xonly_guard_zero
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (id : BinNums.positive)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (xonly_parse_guard id) Events.E0 le m
         (ClightBigstep.Out_return
            (@Some (prod Values.val Ctypes.type)
               (@pair Values.val Ctypes.type (Values.Vint Integers.Int.zero) Ctypesdefs.tint)))
### C.jet_secp_xonly_parse_control.eval_xonly_correct_subgroup
eval_xonly_correct_subgroup
     : forall (m : Memory.Mem.mem) (point : Values.val),
       ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
         (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_is_in_correct_subgroup)
         (@cons Values.val point (@nil Values.val)) Events.E0 m (Values.Vint Integers.Int.one)
