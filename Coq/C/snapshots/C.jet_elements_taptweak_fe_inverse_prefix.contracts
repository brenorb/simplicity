### C.jet_elements_taptweak_fe_inverse_prefix.exec_fe_inv_prefix_for_linked_metadata
exec_fe_inv_prefix_for_linked_metadata
     : forall (le : Maps.PTree.tree Values.val) (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem)
         (bx : Values.block) (sbase : BinNums.Z) (bt bs : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._x le)
                (@Some Values.val (Values.Vptr bx (Integers.Ptrofs.repr sbase))))
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bx sbase (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bt bx)) (_ : not (@eq Values.block bs bx))
         (_ : not (@eq Values.block bt bs))
         (_ : not (@eq Values.block bt jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_block))
         (_ : not (@eq Values.block bs jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_block))
         (_ : jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_global_rep m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_fe_inv_statements.fe_inv_env bt bs) le
               m jet_secp_fe_inv_prefix.fe_inv_prefix Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (jet_sx_state.rep (jet_secp_fe_inv_prefix.fe_inv_packed_words w)
                  (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
                     (@cons (prod Values.block BinNums.Z)
                        (@pair Values.block BinNums.Z jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_block
                           BinNums.Z0) (@nil (prod Values.block BinNums.Z)))) jet_secp_modinv_var_entry.inv_start_regs
                  mf)
               (and
                  (jet_secp_fe_nv.fe_at mf bs BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (jet_secp_fe_inv_prefix.fe_inv_packed_words w)))
                  (and
                     (jet_secp_fe_nv.fe_at mf bt BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_fe_inv_prefix.fe_inv_canonical_words w)))
                     (and (jet_secp_fe_nv.fe_at mf bx sbase (jet_secp_multiply_normalize_bridge.words5 w))
                        (and
                           (Memory.Mem.range_perm mf bt BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bs BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_secp_signed62_numeric.signed62_normalized
                                    (jet_secp_fe_inv_prefix.fe_inv_packed_words w))
                                 (and
                                    (@eq BinNums.Z
                                       (jet_secp_signed62_numeric.signed62_unsigned_value
                                          (jet_secp_fe_inv_prefix.fe_inv_packed_words w))
                                       (jet_secp_fe_inv_prefix.fe_inv_value w))
                                    (and (jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_global_rep mf)
                                       (jet_sx_mem.lframe
                                          (fun (b : Values.block) (_ : BinNums.Z) =>
                                           and (not (@eq Values.block b bt)) (not (@eq Values.block b bs))) m mf)))))))))))
### C.jet_elements_taptweak_fe_inverse_prefix.elements_taptweak_fe_inv_entry_to_core
