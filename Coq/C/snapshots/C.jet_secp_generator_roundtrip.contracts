### C.jet_secp_generator_roundtrip.generator_saved_concat_loads
generator_saved_concat_loads
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bg : Values.block)
         (_ : forall (second : bool) (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bg
                   (BinInt.Z.add
                      match second return BinNums.Z with
                      | true =>
                          BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      | false => BinNums.Z0
                      end (BinInt.Z.of_nat i)))
                (@Some Values.val
                   (Values.Vint
                      (@List.nth Integers.Int.int i
                         (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                            (jet_secp_generator_codec.generator_saved_bytes rho
                               match second return nat with
                               | true => S (S (S (S (S O))))
                               | false => O
                               end)) Integers.Int.zero)))) (i : nat)
         (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bg (BinInt.Z.of_nat i))
         (@Some Values.val
            (Values.Vint
               (Integers.Int.repr
                  (@List.nth BinNums.Z i
                     (@app BinNums.Z (jet_secp_generator_codec.generator_saved_bytes rho O)
                        (jet_secp_generator_codec.generator_saved_bytes rho (S (S (S (S (S O))))))) BinNums.Z0))))
### C.jet_secp_generator_roundtrip.eval_generator_save_load_write
eval_generator_save_load_write
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (rho : forall _ : nat, Integers.Int64.int)
         (flag : Integers.Int.int) (m : Memory.Mem.mem) (bp bg : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N) (_ : jet_frame_inv.finv m0 bd base bw edge cursor N bi m false (@nil BitMachine.Cell))
         (_ : not (@eq Values.block bp bg))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_field_add_initial.field_values rho O))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_field_add_initial.field_values rho (S (S (S (S (S O)))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag)))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bg BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bg BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S (S (S O))))))))))),
              BinInt.Z.le (Integers.Int64.unsigned (rho i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       @ex Memory.Mem.mem
         (fun ms : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun ml : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_save)
                     (@cons Values.val (Values.Vptr bg Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ms
                     Values.Vundef)
                  (and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ms
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_load)
                        (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr bg Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ml
                        Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ml
                           (@Ctypes.Internal Clight.function jets_secp.f_write_ge)
                           (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                              (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                           Values.Vundef)
                        (and
                           (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                              (@Translate.encode
                                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                    (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (jet_secp_generator_load_write.generator_loaded_output
                                    (jet_secp_generator_codec.generator_saved_bytes rho O)
                                    (jet_secp_generator_codec.generator_saved_bytes rho (S (S (S (S (S O)))))))))
                           (and
                              (Memory.Mem.range_perm mf bp BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bg BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block b bp))
                                          (and (not (@eq Values.block b bg)) (not (jet_secp_frame.extA m0 bd bw bi b))))
                                       m mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
