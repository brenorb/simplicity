### C.jet_secp_modinv_var_zero.inv_test_modified
inv_test_modified =
@cons AST.ident jets_secp._t'5
  (@cons AST.ident jets_secp._cond (@cons AST.ident jets_secp._j (@cons AST.ident jets_secp._t'6 (@nil AST.ident))))
     : list AST.ident
