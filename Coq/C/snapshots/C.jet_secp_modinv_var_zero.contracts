### C.jet_secp_modinv_var_zero.inv_or_zero
inv_or_zero
     : forall a b : Integers.Int64.int,
       iff (@eq Integers.Int64.int (Integers.Int64.or a b) Integers.Int64.zero)
         (and (@eq Integers.Int64.int a Integers.Int64.zero) (@eq Integers.Int64.int b Integers.Int64.zero))
### C.jet_secp_modinv_var_zero.inv_gather_zero
inv_gather_zero
     : forall (n : nat) (w : forall _ : nat, Integers.Int64.int) (j : nat) (acc : Integers.Int64.int),
       iff (@eq Integers.Int64.int (inv_gather_words n w j acc) Integers.Int64.zero)
         (and (@eq Integers.Int64.int acc Integers.Int64.zero)
            (forall (i : nat) (_ : lt i n), @eq Integers.Int64.int (w (Nat.add j i)) Integers.Int64.zero))
