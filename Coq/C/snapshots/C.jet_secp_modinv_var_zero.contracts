### C.jet_secp_modinv_var_zero.inv_signed62_zero
inv_signed62_zero
     : forall (n : nat) (w : forall _ : nat, BinNums.Z)
         (_ : forall (i : nat) (_ : lt i n),
              and (BinInt.Z.le BinNums.Z0 (w i))
                (BinInt.Z.lt (w i)
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))),
       iff (@eq BinNums.Z (jet_secp_modinv_normalize62_words.norm62_value_z n w) BinNums.Z0)
         (forall (i : nat) (_ : le i n), @eq BinNums.Z (w i) BinNums.Z0)
### C.jet_secp_modinv_var_zero.inv_zero_out_value
inv_zero_out_value
     : forall (len : nat) (w : forall _ : nat, Integers.Int64.int) (_ : lt O len) (_ : inv_active_low_bounds len w),
       iff (@eq ClightBigstep.outcome (inv_zero_out len w) ClightBigstep.Out_break)
         (@eq BinNums.Z (inv_active_value len w) BinNums.Z0)
### C.jet_secp_modinv_var_zero.exec_inv_zero_test_numeric
exec_inv_zero_test_numeric
     : forall (len : nat) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (e : Clight.env) (le0 : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : and (lt O len) (le len (S (S (S (S (S O))))))) (_ : jet_sx_state.rep rho beta inv_control_regs m)
         (_ : jet_sx_eval.tmatch rho beta (inv_control_temps len) le0)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_var_entry.inv_start_alloc) e)
         (_ : inv_active_low_bounds len (fun i : nat => rho (Nat.add (S (S (S (S (S (S (S (S (S (S O)))))))))) i))),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex ClightBigstep.outcome
            (fun out : ClightBigstep.outcome =>
             and (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 m inv_zero_test Events.E0 lef m out)
               (and
                  (iff (@eq ClightBigstep.outcome out ClightBigstep.Out_break)
                     (@eq BinNums.Z
                        (inv_active_value len
                           (fun i : nat => rho (Nat.add (S (S (S (S (S (S (S (S (S (S O)))))))))) i))) BinNums.Z0))
                  (and
                     (or (@eq ClightBigstep.outcome out ClightBigstep.Out_break)
                        (@eq ClightBigstep.outcome out ClightBigstep.Out_normal))
                     (and (inv_test_frame le0 lef)
                        (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len lef)
                           (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat len))))))))))
### C.jet_secp_modinv_var_zero.inv_caller_loop
inv_caller_loop =
match jet_secp_modinv_var_copies.inv_after_ready return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence s _ => s
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_modinv_var_zero.inv_caller_loop_body
inv_caller_loop_body =
match inv_caller_loop return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop s _ => s
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_modinv_var_zero.inv_caller_loop_parts
inv_caller_loop_parts =
jet_secp_statement_prefix.split_statement_last inv_caller_loop_body
     : prod (list Clight.statement) Clight.statement
### C.jet_secp_modinv_var_zero.inv_zero_test
inv_zero_test =
@List.nth Clight.statement (S (S (S (S O)))) (@fst (list Clight.statement) Clight.statement inv_caller_loop_parts)
  Clight.Sskip
     : Clight.statement
### C.jet_secp_modinv_var_zero.inv_shortening
inv_shortening =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement (S (S (S (S (S O)))))
     (@fst (list Clight.statement) Clight.statement inv_caller_loop_parts))
  (@snd (list Clight.statement) Clight.statement inv_caller_loop_parts)
     : Clight.statement
### C.jet_secp_modinv_var_zero.inv_control_regs
inv_control_regs =
@jet_sx_state.upd jet_sx_state.region
  (@jet_sx_state.upd jet_sx_state.region (jet_sx_eval.sregs jet_secp_modinv_var_entry.inv_start_state)
     (S (S (S (S O))))
     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 (S (S (S (S (S O))))))) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
  (S (S (S (S (S O)))))
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 (S (S (S (S (S (S (S (S (S (S O)))))))))))) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     : list jet_sx_state.region
### C.jet_secp_modinv_var_zero.inv_control_temps
inv_control_temps =
fun len : nat =>
@Maps.PTree.set jet_sx_expr.sx jets_secp._len (jet_sx_expr.XIc (Integers.Int.repr (BinInt.Z.of_nat len)))
  (Maps.PTree.empty jet_sx_expr.sx)
     : forall _ : nat, Maps.PTree.tree jet_sx_expr.sx

Arguments inv_control_temps len%nat_scope
### C.jet_secp_modinv_var_zero.inv_g_array
inv_g_array =
Clight.Efield (Clight.Evar jets_secp._g jet_secp_modinv_fg_index.fg_s62_type) jets_secp._v
  (Ctypesdefs.tarray Ctypesdefs.tlong (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))))
     : Clight.expr
### C.jet_secp_modinv_var_zero.inv_g_index
inv_g_index =
