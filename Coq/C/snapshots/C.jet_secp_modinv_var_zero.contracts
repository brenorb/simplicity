@eq (option Values.val) (@Maps.PTree.get Values.val id lf) (@Maps.PTree.get Values.val id le)
     : forall (_ : Clight.temp_env) (_ : Clight.temp_env), Prop

Arguments inv_test_frame le lf
### C.jet_secp_modinv_var_zero.inv_gather_words
inv_gather_words =
fix inv_gather_words
  (n : nat) (w : forall _ : nat, Integers.Int64.int) (j : nat) (acc : Integers.Int64.int) {struct n} :
    Integers.Int64.int :=
  match n return Integers.Int64.int with
  | O => acc
  | S n0 => inv_gather_words n0 w (S j) (Integers.Int64.or acc (w j))
  end
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : nat) (_ : Integers.Int64.int), Integers.Int64.int

Arguments inv_gather_words n%nat_scope w%function_scope j%nat_scope acc
