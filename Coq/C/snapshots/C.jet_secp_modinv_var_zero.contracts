inv_gather_work_env =
fun (le : Maps.PTree.tree Values.val) (w acc : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_secp._cond (Values.Vlong (Integers.Int64.or acc w))
  (@Maps.PTree.set Values.val jets_secp._t'6 (Values.Vlong w) le)
     : forall (_ : Maps.PTree.tree Values.val) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments inv_gather_work_env le w acc
### C.jet_secp_modinv_var_zero.inv_g_is_zero
inv_g_is_zero =
fun (len : nat) (w : forall _ : nat, Integers.Int64.int) =>
andb (Integers.Int64.eq (w O) Integers.Int64.zero)
  (Integers.Int64.eq (inv_gather_words (Nat.sub len (S O)) w (S O) Integers.Int64.zero) Integers.Int64.zero)
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int), bool

Arguments inv_g_is_zero len%nat_scope w%function_scope
### C.jet_secp_modinv_var_zero.inv_zero_out
inv_zero_out =
fun (len : nat) (w : forall _ : nat, Integers.Int64.int) =>
match inv_g_is_zero len w return ClightBigstep.outcome with
| true => ClightBigstep.Out_break
| false => ClightBigstep.Out_normal
end
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int), ClightBigstep.outcome

Arguments inv_zero_out len%nat_scope w%function_scope
### C.jet_secp_modinv_var_zero.inv_active_value
inv_active_value =
fun (len : nat) (w : forall _ : nat, Integers.Int64.int) =>
jet_secp_modinv_normalize62_words.norm62_value_z (Nat.sub len (S O)) (fun i : nat => Integers.Int64.signed (w i))
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int), BinNums.Z

Arguments inv_active_value len%nat_scope w%function_scope
### C.jet_secp_modinv_var_zero.inv_active_low_bounds
inv_active_low_bounds =
fun (len : nat) (w : forall _ : nat, Integers.Int64.int) =>
forall (i : nat) (_ : lt (S i) len),
and (BinInt.Z.le BinNums.Z0 (Integers.Int64.signed (w i)))
  (BinInt.Z.lt (Integers.Int64.signed (w i))
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments inv_active_low_bounds len%nat_scope w%function_scope
