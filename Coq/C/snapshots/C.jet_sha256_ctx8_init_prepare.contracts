### C.jet_sha256_ctx8_init_prepare.prepare_sha256_ctx8_init
prepare_sha256_ctx8_init
     : forall (m : Memory.Mem.mem) (bs : Values.block) (sbase : BinNums.Z) (source : Values.block)
         (edge rc : BinNums.Z) (_ : jet_frame_layout.frame_fields_at m bs sbase source edge rc),
       @ex Memory.Mem.mem'
         (fun ma : Memory.Mem.mem' =>
          @ex Memory.Mem.mem'
            (fun mb : Memory.Mem.mem' =>
             @ex Memory.Mem.mem'
               (fun mc : Memory.Mem.mem' =>
                @ex Memory.Mem.mem'
                  (fun md : Memory.Mem.mem' =>
                   @ex Memory.Mem.mem
                     (fun ms : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun mi : Memory.Mem.mem =>
                         @ex Memory.Mem.mem
                           (fun mx : Memory.Mem.mem =>
                            @ex Values.block
                              (fun bl : Values.block =>
                               @ex Values.block
                                 (fun bi : Values.block =>
                                  @ex Values.block
                                    (fun bc : Values.block =>
                                     @ex Values.block
                                       (fun br : Values.block =>
                                        @ex (list Memdata.memval)
                                          (fun srcbytes : list Memdata.memval =>
                                           @ex (list Memdata.memval)
                                             (fun ctxbytes : list Memdata.memval =>
                                              and
                                                (@eq (prod Memory.Mem.mem' Values.block)
                                                   (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos ...))
                                                   (@pair Memory.Mem.mem' Values.block ma bl))
                                                (and
                                                   (@eq (prod Memory.Mem.mem' Values.block)
                                                      (Memory.Mem.alloc ma BinNums.Z0 ...)
                                                      (@pair Memory.Mem.mem' Values.block mb bi))
                                                   (and (@eq ... ... ...) (and ... ...))))))))))))))))
