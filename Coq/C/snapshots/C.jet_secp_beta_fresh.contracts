### C.jet_secp_beta_fresh.beta_words_readable
beta_words_readable
     : forall (m : Memory.Mem.mem) (b : Values.block)
         (_ : forall (i : nat) (w : Integers.Int64.int)
                (_ : @eq (option Integers.Int64.int)
                       (@List.nth_error Integers.Int64.int jet_secp_beta_global.beta_words i)
                       (@Some Integers.Int64.int w)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vlong w))),
       Memory.Mem.range_perm m b BinNums.Z0
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
         Memtype.Readable
### C.jet_secp_beta_fresh.beta_initialized_old_blocks
beta_initialized_old_blocks
     : forall (m m' : Memory.Mem.mem) (_ : jet_secp_beta_global.beta_initialized m)
         (_ : forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
              and (Memory.Mem.valid_block m' b)
                (and
                   (forall (chunk : AST.memory_chunk) (ofs : BinNums.Z),
                    @eq (option Values.val) (Memory.Mem.load chunk m' b ofs) (Memory.Mem.load chunk m b ofs))
                   (forall (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                      (_ : Memory.Mem.perm m' b ofs k p), Memory.Mem.perm m b ofs k p))),
       jet_secp_beta_global.beta_initialized m'
### C.jet_secp_beta_fresh.beta_runs_from_initialized
beta_runs_from_initialized
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (env : Values.val)
         (m0 : Memory.Mem.mem) (_ : jet_secp_beta_global.beta_initialized m0),
       @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          @ex Values.block
            (fun bd : Values.block =>
             @ex Values.block
               (fun bs : Values.block =>
                @ex Values.block
                  (fun bi : Values.block =>
                   @ex Values.block
                     (fun bw : Values.block =>
                      @ex BinNums.Z
                        (fun edge : BinNums.Z =>
                         @ex Memory.Mem.mem
                           (fun mf : Memory.Mem.mem =>
                            and (jet_secp_beta_global.beta_initialized m)
                              (and (jet_frame_layout.frame_fields_at m bs BinNums.Z0 bi edge BinNums.Z0)
                                 (and
                                    (jet_encoding.frame_input_cells_at m bi edge BinNums.Z0
                                       (@Translate.encode (Word.Word (S (S (S (S (S (S (S ...)))))))) value))
                                    (and
                                       (jet_output_layout.write_frame_at m bd BinNums.Z0 bw BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))
                                       (and
                                          (forall (b : Values.block) (chunk : AST.memory_chunk)
                                             (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m0 b),
                                           @eq (option Values.val) (Memory.Mem.load chunk m b ofs)
                                             (Memory.Mem.load chunk m0 b ofs))
                                          (and
                                             (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                                (@Ctypes.Internal Clight.function
                                                   jets_secp.f_simplicity_fe_multiply_beta)
                                                (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                                                   (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                                                      (@cons Values.val env (@nil Values.val)))) Events.E0 mf
                                                (Values.Vint Integers.Int.one))
                                             (and
                                                (jet_frame_inv.finv m bd BinNums.Z0 bw BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))) bi mf
                                                   true
                                                   (@Translate.encode (Word.Word (S (S (S ...))))
                                                      (@jet_secp_beta_spec.literal_fe_multiply_beta Alg.CoreFunSem
                                                         value)))
                                                (and (jet_secp_beta_global.beta_initialized mf)
                                                   (forall (b : Values.block) (chunk : AST.memory_chunk)
                                                      (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m0 b),
                                                    @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                                      (Memory.Mem.load chunk m0 b ofs))))))))))))))))
### C.jet_secp_beta_fresh.beta_runs_from_actual_init
beta_runs_from_actual_init
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (env : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m : Memory.Mem.mem =>
             @ex Values.block
               (fun bd : Values.block =>
                @ex Values.block
                  (fun bs : Values.block =>
                   @ex Values.block
                     (fun bi : Values.block =>
                      @ex Values.block
                        (fun bw : Values.block =>
                         @ex BinNums.Z
                           (fun edge : BinNums.Z =>
                            @ex Memory.Mem.mem
                              (fun mf : Memory.Mem.mem =>
                               and
                                 (@eq (option Memory.Mem.mem)
                                    (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                                       (@Ctypes.program_of_program Clight.function jets_secp.prog))
                                    (@Some Memory.Mem.mem mi))
                                 (and (jet_secp_beta_global.beta_initialized mi)
                                    (and (jet_secp_beta_global.beta_initialized m)
                                       (and (jet_frame_layout.frame_fields_at m bs BinNums.Z0 bi edge BinNums.Z0)
                                          (and
                                             (jet_encoding.frame_input_cells_at m bi edge BinNums.Z0
                                                (@Translate.encode (Word.Word (S (S (S (...))))) value))
                                             (and
                                                (jet_output_layout.write_frame_at m bd BinNums.Z0 bw BinNums.Z0
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...)))))
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...))))))
                                                (and
                                                   (forall (b : Values.block) (chunk : AST.memory_chunk)
                                                      (ofs : BinNums.Z) (_ : Memory.Mem.valid_block mi b),
                                                    @eq (option Values.val) (Memory.Mem.load chunk m b ofs)
                                                      (Memory.Mem.load chunk mi b ofs))
                                                   (and
                                                      (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                                         (@Ctypes.Internal Clight.function
                                                            jets_secp.f_simplicity_fe_multiply_beta)
                                                         (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                                                            (@cons Values.val (...) (...))) Events.E0 mf
                                                         (Values.Vint Integers.Int.one))
                                                      (and
                                                         (jet_frame_inv.finv m bd BinNums.Z0 bw BinNums.Z0
                                                            (BinNums.Zpos (...)) (BinNums.Zpos (...)) bi mf true
                                                            (@Translate.encode (...) (...)))
                                                         (and (jet_secp_beta_global.beta_initialized mf)
                                                            (forall ... ... ... ..., @eq ... ... ...))))))))))))))))))
