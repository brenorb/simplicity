                                                      (jet_sx_mem.lframe (double_separate_frame br ba bs bl bt) m mf))))))))))))))))
### C.jet_secp_double_separate_tail.double_separate_tail
double_separate_tail =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement (S (S (S (S (S O)))))
     (@fst (list Clight.statement) Clight.statement
        (jet_secp_statement_prefix.split_statement_last jet_secp_double_statements.double_arithmetic_body)))
  (@snd (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last jet_secp_double_statements.double_arithmetic_body))
     : Clight.statement
### C.jet_secp_double_separate_tail.double_separate_frame
double_separate_frame =
fun (br ba bs bl bt b : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block b bs))
  (and (not (@eq Values.block b bl))
     (and (not (@eq Values.block b bt))
        (and
           (or (not (@eq Values.block b br))
              (or (BinInt.Z.lt pos BinNums.Z0)
                 (BinInt.Z.le
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))) pos)))
           (or (not (@eq Values.block b ba))
              (or (BinInt.Z.lt pos BinNums.Z0)
                 (BinInt.Z.le
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))) pos))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments double_separate_frame br ba bs bl bt b pos%Z_scope
