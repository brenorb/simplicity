  (@LC.case Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Prod jet_elements_issuance_entropy_spec.issuance_digest_option
        jet_elements_issuance_entropy_spec.issuance_prevout_option)
     jet_elements_issuance_entropy_spec.issuance_digest_option core
     (@LC.drop Ty.Unit
        (Ty.Prod jet_elements_issuance_entropy_spec.issuance_digest_option
