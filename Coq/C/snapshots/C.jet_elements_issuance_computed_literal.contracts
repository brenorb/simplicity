     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@LC.unit
        (Ty.Prod Ty.Unit
           (Ty.Prod jet_elements_issuance_entropy_spec.issuance_digest_option
