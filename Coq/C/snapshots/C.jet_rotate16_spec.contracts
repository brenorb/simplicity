### C.jet_rotate16_spec.word4_reverse_items_spec
@word4_reverse_items_spec
     : forall term : Alg.Core.Algebra,
       @eq (list (Alg.Core.domain term (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S O))) (Ty.Sum Ty.Unit Ty.Unit)))
         (@List.rev (Alg.Core.domain term (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S O))) (Ty.Sum Ty.Unit Ty.Unit))
            (@jet_rotate_spec.vector_items_spec (Ty.Sum Ty.Unit Ty.Unit) (S (S O)) term))
         (@List.map nat (Alg.Core.domain term (Word.Word (S (S O))) (Ty.Sum Ty.Unit Ty.Unit))
            (fun i : nat => @jet_word_bit_spec.word_bit_spec (S (S O)) i term) (List.seq O (S (S (S (S O))))))
### C.jet_rotate16_spec.rotate16_spec_parametric
rotate16_spec_parametric
     : forall right : bool,
       @Alg.Core.Parametric (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S (S O)))))) (Word.Word (S (S (S (S O)))))
         (@rotate16_spec right)
### C.jet_rotate16_spec.rotate16_controls_normalform
rotate16_controls_normalform
     : forall (right : bool)
         (amount : prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
         (x : Ty.tySem (Word.Word (S (S (S (S O)))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S O))))))
         (@rotate16_spec right Alg.CoreFunSem
            (@pair (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
               (Ty.tySem (Word.Word (S (S (S (S O)))))) amount x))
         (jet_rotate_control_word.rotate_control_word_fun (S (S O)) (S (S (S (S O)))) right O
            (S (S (S (S O)))) amount x)
### C.jet_rotate16_spec.rotate_control_nibble_amount4
rotate_control_nibble_amount4
     : forall amount : Ty.tySem (Word.Word (S (S O))),
       @eq BinNums.Z (jet_rotate_control_word.rotate_control_word_amount (S (S O)) O (S (S (S (S O)))) amount)
         (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S O))) amount)
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
### C.jet_rotate16_spec.rotate16_spec_bits
rotate16_spec_bits
     : forall (right : bool)
         (amount : prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
         (x : prod
                (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                   (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                   (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
         (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))),
       @eq bool
         (BinInt.Z.testbit
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S O)))))
               (@rotate16_spec right Alg.CoreFunSem
                  (@pair (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod
                        (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                           (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                        (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                           (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                     amount x))) j)
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S O))))) x)
            (BinInt.Z.modulo
               (BinInt.Z.sub j
                  (jet_rotate_control_word.rotate_signed_amount right
                     (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S O))) amount)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
### C.jet_rotate16_spec.rotate16_spec
rotate16_spec =
fun (right : bool) (term : Alg.Core.Algebra) =>
match
  right
  return
    (Alg.Core.domain term (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S (S O)))))) (Word.Word (S (S (S (S O))))))
with
| true => @jet_right_rotate_spec.right_rotate_word_spec (S (S O)) (S (S (S (S O)))) term
| false => @jet_rotate_spec.left_rotate_word_spec (S (S O)) (S (S (S (S O)))) term
end
     : forall (_ : bool) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S (S O)))))) (Word.Word (S (S (S (S O)))))

Arguments rotate16_spec right%bool_scope {term}
