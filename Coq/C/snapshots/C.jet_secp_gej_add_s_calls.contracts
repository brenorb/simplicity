fun second : bool =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr
     (jet_secp_curve_statements.curve_local_address
        match second return AST.ident with
        | true => jets_secp._s2
        | false => jets_secp._s1
        end)
     (@cons Clight.expr
        (jet_secp_curve_statements.curve_local_address
           match second return AST.ident with
           | true => jets_secp._s2
           | false => jets_secp._s1
           end)
        (@cons Clight.expr
           (jet_secp_double_statements.double_point_address
              match second return AST.ident with
              | true => jets_secp._a
              | false => jets_secp._b
              end jets_secp._z) (@nil Clight.expr))))
     : forall _ : bool, Clight.statement

