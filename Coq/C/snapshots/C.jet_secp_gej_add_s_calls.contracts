### C.jet_secp_gej_add_s_calls.gej_add_s_frame
gej_add_s_frame =
fun (py pz bs bz b : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block b bs))
  (and (not (@eq Values.block b bz))
     (and
        (or (not (@eq Values.block b py))
           (or
              (BinInt.Z.lt pos
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
              (BinInt.Z.le
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                 pos)))
        (or (not (@eq Values.block b pz))
           (or
              (BinInt.Z.lt pos
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
              (BinInt.Z.le
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                 pos)))))
