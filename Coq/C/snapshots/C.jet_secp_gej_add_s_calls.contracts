jet_secp_gej_fresh_product.gej_fresh_product_stmt true
  match second return AST.ident with
  | true => jets_secp._s2
  | false => jets_secp._s1
  end match second return AST.ident with
      | true => jets_secp._b
      | false => jets_secp._a
      end match second return AST.ident with
          | true => jets_secp._z12
          | false => jets_secp._z22
          end
