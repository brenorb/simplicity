### C.jet_secp_curve_weak.curve_weak_state
curve_weak_state =
match curve_weak_tree return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_curve_weak.curve_weak_bounds
curve_weak_bounds =
fun n : nat =>
@pair BinNums.Z BinNums.Z BinNums.Z0
  match andb (PeanoNat.Nat.leb (S O) n) (PeanoNat.Nat.leb n (S (S (S (S (S O)))))) return BinNums.Z with
  | true =>
      BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
  | false => Integers.Int64.max_unsigned
  end
     : forall _ : nat, prod BinNums.Z BinNums.Z

Arguments curve_weak_bounds n%nat_scope
### C.jet_secp_curve_weak.curve_weak_math
curve_weak_math =
fun t0 t1 t2 t3 t4 : BinNums.Z =>
jet_secp_fe_math.nv_pass
  (BinInt.Z.add t0
