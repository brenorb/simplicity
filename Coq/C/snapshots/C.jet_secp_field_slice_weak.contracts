### C.jet_secp_field_slice_weak.eval_field_slice_weak
eval_field_slice_weak
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (base : BinNums.Z)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (w i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : jet_secp_fe_nv.fe_at m b base (jet_secp_multiply_normalize_bridge.words5 w)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_weak)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b base
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_field_weak_loose.weak_loose_words w)))
               (and
                  (@eq BinNums.Z
                     (BinInt.Z.modulo
                        (jet_secp_multiply_finish_product.radix_value (jet_secp_field_weak_loose.weak_loose_words w))
                        jet_secp_fe_math.feP)
                     (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP))
                  (and (jet_secp_square_columns.square_input_bounds (jet_secp_field_weak_loose.weak_loose_words w))
                     (and (jet_clight_internal_permissions.keeps_permissions m mf)
                        (and
                           (jet_sx_mem.lframe
                              (fun (bx : Values.block) (pos : BinNums.Z) =>
                               or (not (@eq Values.block bx b))
                                 (or (BinInt.Z.lt pos base)
                                    (BinInt.Z.le
                                       (BinInt.Z.add base
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                       pos))) m mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))
### C.jet_secp_field_slice_weak.field_slice_weak_regs
field_slice_weak_regs =
@cons jet_sx_state.region (jet_secp_fe_nv.fe_reg (jet_secp_fe_nv.vars5 (S O))) (@nil jet_sx_state.region)
     : list jet_sx_state.region
