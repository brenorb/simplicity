### C.jet_elements_issuance_status_spec.issuance_status_route_parametric
issuance_status_route_parametric
     : @Alg.Core.Parametric (Ty.Prod issuance_status_digest_option issuance_status_digest_option) issuance_status_type
         (@issuance_status_route)
### C.jet_elements_issuance_status_spec.elements_issuance_status_spec_parametric
elements_issuance_status_spec_parametric
     : @jet_elements_prim.PrimitiveElements.Primitive.Parametric (Word.Word (S (S (S (S (S O)))))) issuance_status_type
         (@elements_issuance_status_spec)
### C.jet_elements_issuance_status_spec.elements_issuance_status_sem
elements_issuance_status_sem
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem issuance_status_type))
         (@elements_issuance_status_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
         (@Some (Ty.tySem issuance_status_type)
            (issuance_status_result (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment)) a))
### C.jet_elements_issuance_status_spec.issuance_status_digest_option
issuance_status_digest_option =
Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     : Ty.Ty
### C.jet_elements_issuance_status_spec.issuance_status_payload
issuance_status_payload = Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)
     : Ty.Ty
### C.jet_elements_issuance_status_spec.issuance_status_type
issuance_status_type = Ty.Sum Ty.Unit issuance_status_payload
     : Ty.Ty
### C.jet_elements_issuance_status_spec.issuance_status_route
issuance_status_route =
fun core : Alg.Core.Algebra =>
@ISC.case Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))) core
  (@ISC.injl (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) Ty.Unit
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) core
     (@ISC.unit (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) core))
  (@ISC.case Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))) core
     (@ISC.drop Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))) core
        (@ISC.copair Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))) core
           (@ISC.injl Ty.Unit Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) core (@ISC.unit Ty.Unit core))
           (@ISC.copair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))) core
              (@ISC.injr Ty.Unit Ty.Unit (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) core
                 (@ISC.injl Ty.Unit Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) core (@ISC.unit Ty.Unit core)))
              (@ISC.injr (Word.Word (S (S (S (S (S (S (S (S O))))))))) Ty.Unit
                 (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) core
                 (@ISC.injr (Word.Word (S (S (S (S (S (S (S (S O))))))))) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) core
                    (@Bit.false (Word.Word (S (S (S (S (S (S (S (S O))))))))) core))))))
     (@ISC.injr
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) Ty.Unit
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)) core
        (@ISC.injr
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) Ty.Unit
           (Ty.Sum Ty.Unit Ty.Unit) core
           (@Bit.true
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) core))))
     : forall core : Alg.Core.Algebra,
       Alg.Core.domain core (Ty.Prod issuance_status_digest_option issuance_status_digest_option) issuance_status_type

Arguments issuance_status_route {core}
### C.jet_elements_issuance_status_spec.elements_issuance_status_spec
elements_issuance_status_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_current_spec.elements_comp alg (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) issuance_status_type
  (@jet_elements_prim_sem.elements_pair alg (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
        jet_elements_prim.Elements.ReissuanceEntropy)
     (@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
        jet_elements_prim.Elements.NewIssuanceContract))
  (@jet_elements_prim_sem.elements_core (Ty.Prod issuance_status_digest_option issuance_status_digest_option)
     issuance_status_type (@issuance_status_route) alg)
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S O)))))) issuance_status_type

Arguments elements_issuance_status_spec {alg}
### C.jet_elements_issuance_status_spec.issuance_status_of_input
issuance_status_of_input =
fun txi : jet_elements_prim.sigTxInput =>
match jet_elements_prim.sigTxiIssuance txi return (Ty.tySem issuance_status_payload) with
| Some i =>
    match i return (Ty.tySem issuance_status_payload) with
    | inl _ => @inr unit (sum unit unit) (@inl unit unit tt)
    | inr _ => @inr unit (sum unit unit) (@inr unit unit tt)
    end
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)) tt
end
     : forall _ : jet_elements_prim.sigTxInput, Ty.tySem issuance_status_payload

Arguments issuance_status_of_input txi
### C.jet_elements_issuance_status_spec.issuance_status_result
issuance_status_result =
fun (elems : list jet_elements_prim.sigTxInput) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error jet_elements_prim.sigTxInput elems
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return (Ty.tySem issuance_status_type)
with
| Some txi => @inr unit (Ty.tySem issuance_status_payload) (issuance_status_of_input txi)
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Sum Ty.Unit Ty.Unit))) tt
end
     : forall (_ : list jet_elements_prim.sigTxInput) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem issuance_status_type

Arguments issuance_status_result elems%list_scope a
