                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_add_ge_var)
               (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val))))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bp BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_mixed_body.mixed_body_x_words flag x y z u v)))
               (and
                  (jet_secp_fe_nv.fe_at mf bp
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 (jet_secp_mixed_body.mixed_body_y_words flag x y z u v)))
                  (and
                     (jet_secp_fe_nv.fe_at mf bp
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_mixed_body.mixed_body_z_words flag x y z u v)))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf bp
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                           (@Some Values.val (Values.Vint (jet_secp_mixed_body.mixed_body_flag flag x y z u v))))
                        (and
                           (Memory.Mem.range_perm mf bp BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf ba BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_secp_square_columns.square_input_bounds
                                    (jet_secp_mixed_body.mixed_body_x_words flag x y z u v))
                                 (and
                                    (jet_secp_square_columns.square_input_bounds
                                       (jet_secp_mixed_body.mixed_body_y_words flag x y z u v))
                                    (and
                                       (jet_secp_square_columns.square_input_bounds
                                          (jet_secp_mixed_body.mixed_body_z_words flag x y z u v))
                                       (jet_sx_mem.lframe
                                          (fun (b : Values.block) (_ : BinNums.Z) =>
                                           and (not (@eq Values.block b bp)) (not (@eq Values.block b ba))) m mf)))))))))))
