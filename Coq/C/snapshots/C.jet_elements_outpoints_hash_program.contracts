     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))))
  (fun txi : jet_elements_prim.sigTxInput =>
   @pair (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))))
     match
       jet_elements_prim.sigTxiPegin txi return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     with
     | Some h => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
     | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
     end
     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
        (Word.from_hash256 (jet_elements_prim.opHash (jet_elements_prim.sigTxiPreviousOutpoint txi)))
        (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
           (Integers.Int.unsigned (jet_elements_prim.opIndex (jet_elements_prim.sigTxiPreviousOutpoint txi))))))
  (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
     : forall _ : jet_elements_prim.Elements.env, list (Ty.tySem elements_outpoint_type)

