### C.jet_sha_ctx8_add_jets.sha_jet_partial_local_spec
sha_jet_partial_local_spec =
fun (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, option (Ty.tySem B)) =>
forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
  (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
  (a : Ty.tySem A) (_ : jet_sha_add_n_exec.sha_globals_ok m) (_ : jet_frame_layout.frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
  (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (Translate.bitSize A))) Integers.Int64.max_unsigned)
  (_ : jet_encoding.frame_input_cells_at m bi edge read_cursor (@Translate.encode A a))
  (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (Translate.bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m (@Ctypes.Internal Clight.function f)
        (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
           (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
        Events.E0 mf (@jet_partial.jet_partial_return (Ty.tySem B) (spec a)))
     (and
        match spec a return Prop with
        | Some b =>
            and (jet_encoding.frame_output_cells_at mf bw outedge cursor (@Translate.encode B b))
              (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                 (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                    (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B)))))
        | None => True
        end
        (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
           (_ : or (not (@eq Values.block b bd))
                  (or
                     (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                        (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (BinInt.Z.le
                        (BinInt.Z.add dbase
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
           (_ : or (not (@eq Values.block b bw))
                  (or
                     (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                        (BinInt.Z.add outedge
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B)))
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (BinInt.Z.le
                        (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
         @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))
     : forall (_ : Clight.function) (A B : Ty.Ty) (_ : forall _ : Ty.tySem A, option (Ty.tySem B)), Prop

Arguments sha_jet_partial_local_spec f (A B)%ty_scope spec%function_scope
### C.jet_sha_ctx8_add_jets.add_n_ty
add_n_ty =
Ctypes.Tfunction
  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
     (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
        (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil))) Ctypesdefs.tbool AST.cc_default
     : Ctypes.type
### C.jet_sha_ctx8_add_jets.aw_body
aw_body =
fun K : BinNums.Z =>
Clight.Ssequence
  (Clight.Sassign (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
     (Clight.Etempvar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
  (Clight.Ssequence
     (Clight.Scall (@Some AST.ident jets_sha._t'1) (Clight.Evar jets_sha._sha_256_ctx_8_add_n add_n_ty)
        (@cons Clight.expr
           (Clight.Etempvar jets_sha._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
           (@cons Clight.expr
              (Clight.Eaddrof (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
              (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr K) Ctypesdefs.tint) (@nil Clight.expr)))))
     (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_sha._t'1 Ctypesdefs.tbool))))
     : forall _ : BinNums.Z, Clight.statement

Arguments aw_body K%Z_scope
### C.jet_sha_ctx8_add_jets.aw_fun
aw_fun =
fun (f : Clight.function) (K : BinNums.Z) =>
and (@eq Ctypes.type (Clight.fn_return f) Ctypesdefs.tbool)
  (and
     (@eq (list (prod AST.ident Ctypes.type)) (Clight.fn_params f)
        (@cons (prod AST.ident Ctypes.type)
           (@pair AST.ident Ctypes.type jets_sha._dst
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
           (@cons (prod AST.ident Ctypes.type)
              (@pair AST.ident Ctypes.type jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
              (@cons (prod AST.ident Ctypes.type)
                 (@pair AST.ident Ctypes.type jets_sha._env
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._txEnv Ctypes.noattr)))
                 (@nil (prod AST.ident Ctypes.type))))))
     (and
        (@eq (list (prod AST.ident Ctypes.type)) (Clight.fn_vars f)
           (@cons (prod AST.ident Ctypes.type)
              (@pair AST.ident Ctypes.type jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
              (@nil (prod AST.ident Ctypes.type))))
        (and
           (@eq (list (prod AST.ident Ctypes.type)) (Clight.fn_temps f)
              (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_sha._t'1 Ctypesdefs.tbool)
                 (@nil (prod AST.ident Ctypes.type)))) (@eq Clight.statement (Clight.fn_body f) (aw_body K)))))
     : forall (_ : Clight.function) (_ : BinNums.Z), Prop

Arguments aw_fun f K%Z_scope
### C.jet_sha_ctx8_add_jets.aw_env
aw_env =
fun bl : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._src
  (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Clight.empty_env
     : forall _ : Values.block, Clight.env

Arguments aw_env bl
### C.jet_sha_ctx8_add_jets.aw_temps
aw_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_sha._env env
  (@Maps.PTree.set Values.val jets_sha._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_sha._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps
           (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_sha._t'1 Ctypesdefs.tbool)
              (@nil (prod AST.ident Ctypes.type))))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments aw_temps env bd dbase%Z_scope bs sbase%Z_scope
