### C.jet_sha_hash_loop_gen.fx_copair
@fx_copair
     : forall (A B D : Ty.Ty)
         (s : Alg.Core.domain
                (Alg.Assertion.toCore
                   (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                      (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                         Option.option_Monad_Zero))) A D)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                      (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                         Option.option_Monad_Zero))) B D) (x : Ty.tySem (Ty.Sum A B))
         (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem D))
         (@jet_sha256_ctx8_init_spec.AC.copair A B D
            (Alg.Assertion.toCore
               (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                  (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                     Option.option_Monad_Zero))) s t x e)
         match x return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem D)) with
         | inl a => s a e
         | inr b => t b e
         end
### C.jet_sha_hash_loop_gen.gen_loop_run_parametric
gen_loop_run_parametric
     : forall (X : Ty.Ty)
         (add : forall term : Alg.Assertion.Algebra,
                Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                  jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @Alg.Assertion.Parametric (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type add) (w : nat) (C : Ty.Ty)
         (alg1 alg2 : Alg.Assertion.Algebra) (R : Alg.Assertion.Parametric.Rel alg1 alg2)
         (a1 : Alg.Assertion.domain alg1 (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit X))
         (a2 : Alg.Assertion.domain alg2 (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit X))
         (_ : @Alg.Assertion.Parametric.rel alg1 alg2 R (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit X) a1 a2),
       @Alg.Assertion.Parametric.rel alg1 alg2 R (Ty.Prod C jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (@gen_loop_run X add w alg1 C a1) (@gen_loop_run X add w alg2 C a2)
### C.jet_sha_hash_loop_gen.gen_loop_body_sem
gen_loop_body_sem
     : forall (X : Ty.Ty)
         (add : forall term : Alg.Assertion.Algebra,
                Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                  jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @Alg.Assertion.Parametric (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type add)
         (bytes_of : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
         (_ : forall
                (c : prod
                       ((fix tySem (X0 : Ty.Ty) : Set :=
                           match X0 return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                       (prod
                          ((fix tySem (X0 : Ty.Ty) : Set :=
                              match X0 return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Word (S (S (S (S (S (S O))))))))
                          ((fix tySem (X0 : Ty.Ty) : Set :=
                              match X0 return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (x : (fix tySem (X0 : Ty.Ty) : Set :=
                        match X0 return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) X),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                   (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (add (Alg.AssertionSem Option.option_Monad_Zero)
                   (@pair
                      (prod
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) X) c x)) (jet_sha_ctx8_spec.ctx8_add_list c (bytes_of x))) (C W : Ty.Ty)
         (array : Alg.Assertion.domain
                    (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                       (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                          Option.option_Monad_Zero)) (Ty.Prod C W) (Ty.Sum Ty.Unit X)) (cw : Ty.tySem (Ty.Prod C W))
         (ctx : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (e : jet_bitcoin_full_prim.BitcoinFull.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
         (@gen_loop_body X add
            (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
               (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))
            C W array (@pair (Ty.tySem (Ty.Prod C W)) (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cw ctx) e)
         match
           array cw e
           return
             (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                (Ty.tySem
                   (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
         with
         | Some t =>
             match
               t
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                    (Ty.tySem
                       (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
             with
             | inl _ =>
                 @Some
                   (sum (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
                      (prod
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                   (@inl (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
                      (prod
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) ctx)
             | inr x =>
                 match
                   jet_sha_ctx8_spec.ctx8_add_list ctx (bytes_of x)
                   return
                     (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                        (Ty.tySem
                           (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type
                              jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
                 with
                 | Some c' =>
                     @Some
                       (sum
                          (prod
                             ((fix tySem (X0 : Ty.Ty) : Set :=
                                 match X0 return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A B => sum (tySem A) (tySem B)
                                 | Ty.Prod A B => prod (tySem A) (tySem B)
                                 end)
                                (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                             (prod
                                ((fix tySem (X0 : Ty.Ty) : Set :=
                                    match X0 return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S O))))))))
                                ((fix tySem (X0 : Ty.Ty) : Set :=
                                    match X0 return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                          (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                       (@inr
                          (prod
                             ((fix tySem (X0 : Ty.Ty) : Set :=
                                 match X0 return Set with
                                 | Ty.Unit => unit
                                 | Ty.Sum A B => sum (tySem A) (tySem B)
                                 | Ty.Prod A B => prod (tySem A) (tySem B)
                                 end)
                                (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                             (prod
                                ((fix tySem (X0 : Ty.Ty) : Set :=
                                    match X0 return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S O))))))))
                                ((fix tySem (X0 : Ty.Ty) : Set :=
                                    match X0 return Set with
                                    | Ty.Unit => unit
                                    | Ty.Sum A B => sum (tySem A) (tySem B)
                                    | Ty.Prod A B => prod (tySem A) (tySem B)
                                    end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                          (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) c')
                 | None =>
                     @None
                       (Ty.tySem
                          (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                 end
             end
         | None =>
             @None
               (Ty.tySem (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         end
### C.jet_sha_hash_loop_gen.gen_bytes_app
gen_bytes_app
     : forall (X : Ty.Ty) (bytes_of : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
         (l1 l2 : list (Ty.tySem X)),
       @eq (list (Ty.tySem (Word.Word (S (S (S O)))))) (gen_bytes X bytes_of (@app (Ty.tySem X) l1 l2))
         (@app (Ty.tySem (Word.Word (S (S (S O))))) (gen_bytes X bytes_of l1) (gen_bytes X bytes_of l2))
### C.jet_sha_hash_loop_gen.gen_prefix_some
gen_prefix_some
     : forall (X : Ty.Ty) (bytes_of : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
         (w : nat) (ctx0 : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (xs : list (Ty.tySem X))
         (cf : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (jet_sha_ctx8_spec.ctx8_add_list ctx0
                   (gen_bytes X bytes_of (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)))
                (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cf)) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i
                   (BinInt.Z.of_nat
                      (@length (Ty.tySem X) (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs))))),
       @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (jet_sha_ctx8_spec.ctx8_add_list ctx0
            (gen_bytes X bytes_of (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat i) xs)))
         (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            match
              jet_sha_ctx8_spec.ctx8_add_list ctx0
                (gen_bytes X bytes_of (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat i) xs))
              return (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            with
            | Some c' => c'
            | None => ctx0
            end)
### C.jet_sha_hash_loop_gen.gen_step
gen_step
     : forall (X : Ty.Ty) (bytes_of : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
         (w : nat) (ctx0 : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (xs : list (Ty.tySem X))
         (cf : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (jet_sha_ctx8_spec.ctx8_add_list ctx0
                   (gen_bytes X bytes_of (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)))
                (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cf)) (i : BinNums.Z)
         (x : Ty.tySem X)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinInt.Z.of_nat
                      (@length (Ty.tySem X) (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)))))
         (_ : @eq (option (Ty.tySem X)) (@List.nth_error (Ty.tySem X) xs (BinInt.Z.to_nat i)) (@Some (Ty.tySem X) x)),
       @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (jet_sha_ctx8_spec.ctx8_add_list
            match
              jet_sha_ctx8_spec.ctx8_add_list ctx0
                (gen_bytes X bytes_of (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat i) xs))
              return (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            with
            | Some c' => c'
            | None => ctx0
            end (bytes_of x))
         (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            match
              jet_sha_ctx8_spec.ctx8_add_list ctx0
                (gen_bytes X bytes_of
                   (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat (BinInt.Z.add i (BinNums.Zpos BinNums.xH))) xs))
              return (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
            with
            | Some c' => c'
            | None => ctx0
            end)
### C.jet_sha_hash_loop_gen.gen_loop_run_sem
gen_loop_run_sem
     : forall (X : Ty.Ty)
         (add : forall term : Alg.Assertion.Algebra,
                Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                  jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @Alg.Assertion.Parametric (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type add)
         (bytes_of : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
         (_ : forall
                (c : prod
                       ((fix tySem (X0 : Ty.Ty) : Set :=
                           match X0 return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                       (prod
                          ((fix tySem (X0 : Ty.Ty) : Set :=
                              match X0 return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Word (S (S (S (S (S (S O))))))))
                          ((fix tySem (X0 : Ty.Ty) : Set :=
                              match X0 return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (x : (fix tySem (X0 : Ty.Ty) : Set :=
                        match X0 return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) X),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                   (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (add (Alg.AssertionSem Option.option_Monad_Zero)
                   (@pair
                      (prod
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) X) c x)) (jet_sha_ctx8_spec.ctx8_add_list c (bytes_of x))) (w : nat)
         (C : Ty.Ty)
         (array : Alg.Assertion.domain
                    (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                       (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                          Option.option_Monad_Zero)) (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit X))
         (c : Ty.tySem C) (ctx0 : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (e : jet_bitcoin_ext_prim.ext_environment) (xs : list (Ty.tySem X))
         (_ : forall
                i : (fix tySem (X0 : Ty.Ty) : Set :=
                       match X0 return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word w),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum Ty.Unit X)))
                (array
                   (@pair (Ty.tySem C)
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word w)) c i) e)
                (@Some (sum unit (Ty.tySem X))
                   match
                     @List.nth_error (Ty.tySem X) xs (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return (sum unit (Ty.tySem X))
                   with
                   | Some x => @inr unit (Ty.tySem X) x
                   | None => @inl unit (Ty.tySem X) tt
                   end)) (cf : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (jet_sha_ctx8_spec.ctx8_add_list ctx0
                   (gen_bytes X bytes_of (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)))
                (@Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) cf)),
       @ex (Ty.tySem (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (fun
            r : Ty.tySem (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)
          =>
          and
            (@eq
               (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                  (Ty.tySem
                     (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)))
               (@gen_loop_run X add w
                  (jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion
                     (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem
                        Option.option_Monad_Zero)) C array
                  (@pair (Ty.tySem C) (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) c ctx0) e)
               (@Some
                  (Ty.tySem
                     (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)) r))
            (@eq
               (prod
                  ((fix tySem (X0 : Ty.Ty) : Set :=
                      match X0 return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                  (prod
                     ((fix tySem (X0 : Ty.Ty) : Set :=
                         match X0 return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S O))))))))
                     ((fix tySem (X0 : Ty.Ty) : Set :=
                         match X0 return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
               match
                 r
                 return
                   (prod
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                      (prod
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S O))))))))
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
               with
               | inl a => a
               | inr a => a
               end cf))
### C.jet_sha_hash_loop_gen.gen_loop_body
gen_loop_body =
fun (X : Ty.Ty)
  (add : forall term : Alg.Assertion.Algebra,
         Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
           jet_sha256_ctx8_init_spec.sha256_ctx8_type) (term : Alg.Assertion.Algebra) (C W : Ty.Ty)
  (array : Alg.Assertion.domain term (Ty.Prod C W) (Ty.Sum Ty.Unit X)) =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  (Ty.Prod (Ty.Sum Ty.Unit X) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type) core
  (@jet_sha256_ctx8_init_spec.AC.pair (Ty.Prod (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
     (Ty.Sum Ty.Unit X) jet_sha256_ctx8_init_spec.sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.take (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type
        (Ty.Sum Ty.Unit X) core array)
     (@jet_sha256_ctx8_init_spec.AC.drop (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type
        jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core)))
  (@jet_sha256_ctx8_init_spec.AC.case Ty.Unit X jet_sha256_ctx8_init_spec.sha256_ctx8_type
     (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type) core
     (@jet_sha256_ctx8_init_spec.AC.injl (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type)
        jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.drop Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
           jet_sha256_ctx8_init_spec.sha256_ctx8_type core
           (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core)))
     (@jet_sha256_ctx8_init_spec.AC.injr (Ty.Prod X jet_sha256_ctx8_init_spec.sha256_ctx8_type)
        jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod X jet_sha256_ctx8_init_spec.sha256_ctx8_type)
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X) jet_sha256_ctx8_init_spec.sha256_ctx8_type core
           (@jet_sha256_ctx8_init_spec.AC.pair (Ty.Prod X jet_sha256_ctx8_init_spec.sha256_ctx8_type)
              jet_sha256_ctx8_init_spec.sha256_ctx8_type X core
              (@jet_sha256_ctx8_init_spec.AC.drop X jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                 (@jet_sha256_ctx8_init_spec.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type core))
              (@jet_sha256_ctx8_init_spec.AC.take X jet_sha256_ctx8_init_spec.sha256_ctx8_type X core
                 (@jet_sha256_ctx8_init_spec.AC.iden X core))) (add term))))
     : forall (X : Ty.Ty)
         (_ : forall term : Alg.Assertion.Algebra,
              Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type) (term : Alg.Assertion.Algebra)
         (C W : Ty.Ty) (_ : Alg.Assertion.domain term (Ty.Prod C W) (Ty.Sum Ty.Unit X)),
       Alg.Assertion.domain term (Ty.Prod (Ty.Prod C W) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)

Arguments gen_loop_body X%ty_scope add%function_scope {term} {C W}%ty_scope array
### C.jet_sha_hash_loop_gen.gen_loop_run
gen_loop_run =
fun (X : Ty.Ty)
  (add : forall term : Alg.Assertion.Algebra,
         Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
           jet_sha256_ctx8_init_spec.sha256_ctx8_type) (w : nat) (term : Alg.Assertion.Algebra)
  (C : Ty.Ty) (array : Alg.Assertion.domain term (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit X)) =>
@jet_forWhile_spec.for_while_program w C jet_sha256_ctx8_init_spec.sha256_ctx8_type
  jet_sha256_ctx8_init_spec.sha256_ctx8_type (Alg.Assertion.toCore term)
  (@gen_loop_body X add term C (Word.Word w) array)
     : forall (X : Ty.Ty)
         (_ : forall term : Alg.Assertion.Algebra,
              Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type) (w : nat) (term : Alg.Assertion.Algebra)
         (C : Ty.Ty) (_ : Alg.Assertion.domain term (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit X)),
       Alg.Assertion.domain term (Ty.Prod C jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)

Arguments gen_loop_run X%ty_scope add%function_scope w%nat_scope {term} {C}%ty_scope array
### C.jet_sha_hash_loop_gen.gen_bytes
gen_bytes =
fun (X : Ty.Ty) (bytes_of : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O)))))) (l : list (Ty.tySem X))
=>
@List.concat (Ty.tySem (Word.Word (S (S (S O)))))
  (@List.map (Ty.tySem X) (list (Ty.tySem (Word.Word (S (S (S O)))))) bytes_of l)
     : forall (X : Ty.Ty) (_ : forall _ : Ty.tySem X, list (Ty.tySem (Word.Word (S (S (S O))))))
         (_ : list (Ty.tySem X)), list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments gen_bytes X%ty_scope bytes_of%function_scope l%list_scope
