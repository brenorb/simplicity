### C.jet_secp_eea_numeric.eea_row_step_numeric
eea_row_step_numeric =
fun (modulus : BinNums.Z) (r t : prod (prod BinNums.Z BinNums.Z) BinNums.Z) =>
match r return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
| pair p c =>
    match p return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
    | pair a b =>
        match t return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
        | pair p0 f =>
            match p0 return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
            | pair d e =>
                let q : BinNums.Z := jet_division_value.division_numeric false c f in
                @pair (prod BinNums.Z BinNums.Z) BinNums.Z
                  (@pair BinNums.Z BinNums.Z (BinInt.Z.modulo (BinInt.Z.add a (BinInt.Z.mul q d)) modulus)
                     (BinInt.Z.modulo (BinInt.Z.add b (BinInt.Z.mul q e)) modulus))
                  (jet_division_value.division_numeric true c f)
            end
        end
    end
end
     : forall (_ : BinNums.Z) (_ : prod (prod BinNums.Z BinNums.Z) BinNums.Z)
         (_ : prod (prod BinNums.Z BinNums.Z) BinNums.Z), prod (prod BinNums.Z BinNums.Z) BinNums.Z

Arguments eea_row_step_numeric modulus%Z_scope r t
### C.jet_secp_eea_numeric.eea_step_numeric
eea_step_numeric =
fun (modulus : BinNums.Z)
  (s : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)) =>
match s return (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)) with
| pair r t =>
    match
      BinInt.Z.ltb (@snd (prod BinNums.Z BinNums.Z) BinNums.Z t) (@snd (prod BinNums.Z BinNums.Z) BinNums.Z r)
      return (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z))
    with
    | true =>
        @pair (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)
          (eea_row_step_numeric modulus r t) t
    | false =>
        @pair (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z) r
          (eea_row_step_numeric modulus t r)
    end
end
     : forall (_ : BinNums.Z)
         (_ : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)),
       prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)

Arguments eea_step_numeric modulus%Z_scope s
### C.jet_secp_eea_numeric.eea_run_numeric
eea_run_numeric =
fix eea_run_numeric
  (modulus : BinNums.Z) (count : nat)
  (s : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)) {struct count} :
    prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z) :=
  match
    count return (prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z))
  with
  | O => s
  | S k => eea_run_numeric modulus k (eea_step_numeric modulus s)
  end
     : forall (_ : BinNums.Z) (_ : nat)
         (_ : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)),
       prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)

Arguments eea_run_numeric modulus%Z_scope count%nat_scope s
### C.jet_secp_eea_numeric.eea_bezout_denote
eea_bezout_denote =
fun (n : nat) (v : Ty.tySem (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))) =>
match v return (sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)) with
| inl t =>
    match t return (sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)) with
    | pair a b =>
        @inl (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)
          (@pair BinNums.Z BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ n) a)
             (@Word.ToZ.Theory.toZ (Word.WordToZ n) b))
    end
| inr t =>
    match t return (sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)) with
    | pair d e =>
        @inr (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)
          (@pair BinNums.Z BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ n) d)
             (@Word.ToZ.Theory.toZ (Word.WordToZ n) e))
    end
end
     : forall (n : nat)
         (_ : Ty.tySem (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))),
       sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)

Arguments eea_bezout_denote n%nat_scope v
### C.jet_secp_eea_numeric.eea_bezout_numeric
eea_bezout_numeric =
fun s : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z) =>
match s return (sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)) with
| pair p p0 =>
    match p return (sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)) with
    | pair p1 _ =>
        match p1 return (sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)) with
        | pair a b =>
            match p0 return (sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)) with
            | pair p2 f =>
                match p2 return (sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)) with
                | pair d e =>
                    match
                      BinInt.Z.eqb f BinNums.Z0 return (sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z))
                    with
                    | true =>
                        @inl (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z a b)
                    | false =>
                        @inr (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z d e)
                    end
                end
            end
        end
    end
end
     : forall _ : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z),
       sum (prod BinNums.Z BinNums.Z) (prod BinNums.Z BinNums.Z)

Arguments eea_bezout_numeric s
