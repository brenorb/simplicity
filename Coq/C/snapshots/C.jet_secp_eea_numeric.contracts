### C.jet_secp_eea_numeric.eea_low_word_numeric
eea_low_word_numeric
     : forall (n : nat) (p : Ty.tySem (Word.Word (S n))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ n)
            (@snd
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                      match n0 return Ty.Ty with
                      | O => X
                      | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                      end) (Ty.Sum Ty.Unit Ty.Unit) n))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                      match n0 return Ty.Ty with
                      | O => X
                      | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                      end) (Ty.Sum Ty.Unit Ty.Unit) n)) p))
         (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) p) (jet_predicate_spec.word_modulus n))
### C.jet_secp_eea_numeric.eea_multiply_low_numeric
eea_multiply_low_numeric
     : forall (n : nat) (q d a : Ty.tySem (Word.Word n)),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ n)
            (@snd
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                      match n0 return Ty.Ty with
                      | O => X
                      | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                      end) (Ty.Sum Ty.Unit Ty.Unit) n))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                      match n0 return Ty.Ty with
                      | O => X
                      | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                      end) (Ty.Sum Ty.Unit Ty.Unit) n))
               (@Word.fullMultiplier n Alg.CoreFunSem
                  (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                     (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                     (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) q d)
                     (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a (@Word.zero n Alg.CoreFunSem tt))))))
         (BinInt.Z.modulo
            (BinInt.Z.add (@Word.ToZ.Theory.toZ (Word.WordToZ n) a)
               (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ n) q) (@Word.ToZ.Theory.toZ (Word.WordToZ n) d)))
            (jet_predicate_spec.word_modulus n))
