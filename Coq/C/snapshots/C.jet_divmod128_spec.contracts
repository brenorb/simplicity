### C.jet_divmod128_spec.divmod128_input_value
divmod128_input_value
     : forall (xh : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (xm xl : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (ah am al : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned ah)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) xh))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned am) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) xm))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned al) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) xl)),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) xh
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xm xl)))
         (BinInt.Z.add
            (BinInt.Z.mul
               (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned ah) jet_divmod96_value.divmod96_radix)
                  (Integers.Int64.unsigned am)) jet_divmod96_value.divmod96_radix) (Integers.Int64.unsigned al))
### C.jet_divmod128_spec.divmod128_valid_representation
divmod128_valid_representation
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
         (b : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (qh ql rf : Integers.Int64.int)
         (_ : BinInt.Z.le (jet_predicate_spec.word_modulus (S (S (S (S (S (S O)))))))
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) b)))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) a)
                (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) b)
                   (jet_predicate_spec.word_modulus (S (S (S (S (S (S O)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned qh))
                (BinInt.Z.lt (Integers.Int64.unsigned qh) jet_divmod96_value.divmod96_radix))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned ql))
                (BinInt.Z.lt (Integers.Int64.unsigned ql) jet_divmod96_value.divmod96_radix))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned rf))
                (BinInt.Z.lt (Integers.Int64.unsigned rf)
                   (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) b)))
         (_ : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) a)
                (BinInt.Z.add
                   (BinInt.Z.mul
                      (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned qh) jet_divmod96_value.divmod96_radix)
                         (Integers.Int64.unsigned ql))
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) b)) (Integers.Int64.unsigned rf))),
       @eq
         (prod
            (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
               (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))))
         (@pair
            (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
               (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
               (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
               (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int64.unsigned qh))
               (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int64.unsigned ql)))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.unsigned rf)))
         (@jet_division_core_spec.div2n1n_word_spec (S (S (S (S (S (S O)))))) Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) a b))
### C.jet_divmod128_spec.divmod128_conditions_match
divmod128_conditions_match
     : forall (xh : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (xm xl : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (y : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (ah am al b : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned ah)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) xh))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned am) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) xm))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned al) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) xl))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned b)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) y)),
       @eq bool
         (Bit.toBool
            (@jet_division_core_spec.div2n1n_conditions (S (S (S (S (S (S O)))))) Alg.CoreFunSem
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S (S (S O)))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                     xh
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
                        xm xl)) y))) (divmod128_guard ah b)
