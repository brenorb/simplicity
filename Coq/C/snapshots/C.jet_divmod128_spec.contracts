### C.jet_divmod128_spec.divmod128_guard
divmod128_guard =
fun ah b : Integers.Int64.int =>
andb
  (negb
     (Integers.Int64.ltu b
        (Integers.Int64.repr
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))))
  (Integers.Int64.ltu ah b)
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int), bool

Arguments divmod128_guard ah b
