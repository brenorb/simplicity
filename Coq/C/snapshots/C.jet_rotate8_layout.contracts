### C.jet_rotate8_layout.rotate8_local_spec
rotate8_local_spec
     : forall right : bool,
       jet_bitmachine_rep.jet_local_spec (jet_rotate8_exec.rotate8_function right)
         (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) (Word.Word (S (S (S O))))
         (fun ax : Ty.tySem (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) =>
          @jet_rotate8_spec.rotate8_spec right Alg.CoreFunSem ax)
### C.jet_rotate8_layout.left_rotate8_local_spec
left_rotate8_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_left_rotate_8
         (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) (Word.Word (S (S (S O))))
         (fun ax : Ty.tySem (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) =>
          @jet_rotate8_spec.rotate8_spec false Alg.CoreFunSem ax)
### C.jet_rotate8_layout.right_rotate8_local_spec
right_rotate8_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_right_rotate_8
         (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) (Word.Word (S (S (S O))))
         (fun ax : Ty.tySem (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) =>
          @jet_rotate8_spec.rotate8_spec true Alg.CoreFunSem ax)
### C.jet_rotate8_layout.rotate8_context
rotate8_context
     : forall right : bool,
       @jet_canonical.jet_context_for (jet_rotate8_exec.rotate8_function right)
         (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) (Word.Word (S (S (S O))))
         (@jet_rotate8_spec.rotate8_spec right)
### C.jet_rotate8_layout.rotate8_guarantees
rotate8_guarantees
     : forall (right : bool) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))))
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add read_cursor
                   (BinInt.Z.of_nat (Translate.bitSize (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))))))
                Integers.Int64.max_unsigned)
         (_ : jet_encoding.frame_input_cells_at m bi edge read_cursor
                (@Translate.encode (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) a))
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.of_nat (Translate.bitSize (Word.Word (S (S (S O))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function (jet_rotate8_exec.rotate8_function right))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Word.Word (S (S (S O)))) (@jet_rotate8_spec.rotate8_spec right Alg.CoreFunSem a)))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize (Word.Word (S (S (S O))))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat (Translate.bitSize (Word.Word (S (S (S O)))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_rotate8_layout.rotate8_context_guarantees
rotate8_context_guarantees
     : forall (right : bool) (env : Values.val) (m : Memory.Mem.mem) (L : jet_bitmachine_rep.bm_layout)
         (ctx : BitMachine.Context) (a : Ty.tySem (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O)))))),
       let s0 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState (@Translate.encode (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) a)
              (BitMachine.newWriteFrame (Translate.bitSize (Word.Word (S (S (S O))))))) in
       let s1 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState (@Translate.encode (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) a)
              (BitMachine.fullWriteFrame
                 (@Translate.encode (Word.Word (S (S (S O)))) (@jet_rotate8_spec.rotate8_spec right Alg.CoreFunSem a))))
         in
       forall (_ : jet_bitmachine_rep.bm_rep m L s0) (_ : jet_bitmachine_rep.bm_separated L s0)
         (_ : jet_bitmachine_rep.active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function (jet_rotate8_exec.rotate8_function right))
               (jet_bitmachine_rep.jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (jet_bitmachine_rep.bm_rep mf L s1)
               (BitMachine.runProgram (@jet_rotate8_spec.rotate8_spec right Translate.Naive.translate)
                  (BitMachine.Running s0) (BitMachine.Running s1))))
