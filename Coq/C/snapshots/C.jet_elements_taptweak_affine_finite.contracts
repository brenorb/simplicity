### C.jet_elements_taptweak_affine_finite.exec_elements_taptweak_affine_inverse_from_call
exec_elements_taptweak_affine_inverse_from_call
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bp b2 b3 : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_inv_var)
                (@cons Values.val
                   (Values.Vptr bp
                      (Integers.Ptrofs.repr
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                   (@cons Values.val
                      (Values.Vptr bp
                         (Integers.Ptrofs.repr
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge
         (jet_secp_gej_affine_arithmetic.affine_local_env b2 b3) le m
         jet_secp_gej_affine_entry.affine_inverse_statement Events.E0 le mf ClightBigstep.Out_normal
### C.jet_elements_taptweak_affine_finite.eval_elements_taptweak_affine_finite
eval_elements_taptweak_affine_finite
     : forall (_ : jet_ctz_model.ctz_model) (x y z : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem)
         (bp br : Values.block) (_ : not (@eq Values.block bp br)) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds y) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_state m)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun zi : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_gej_var)
                  (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                  Values.Vundef)
               (and
                  (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5
                        (jet_secp_point_mul_storage.point_mul_words x (jet_secp_square_numeric.square_words zi))))
                  (and
                     (jet_secp_fe_nv.fe_at mf br
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_point_mul_storage.point_mul_words y
                              (jet_secp_point_mul_storage.point_mul_words zi (jet_secp_square_numeric.square_words zi)))))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf br
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@Some Values.val (Values.Vint Integers.Int.zero)))
                        (and
                           (Memory.Mem.range_perm mf bp BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf br BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_secp_square_columns.square_input_bounds
                                    (jet_secp_point_mul_storage.point_mul_words x
                                       (jet_secp_square_numeric.square_words zi)))
                                 (and
                                    (jet_secp_square_columns.square_input_bounds
                                       (jet_secp_point_mul_storage.point_mul_words y
                                          (jet_secp_point_mul_storage.point_mul_words zi
                                             (jet_secp_square_numeric.square_words zi))))
                                    (and
                                       (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value zi)
                                          (jet_secp_invert_literal.literal_invert_numeric
                                             (jet_secp_fe_inv_prefix.fe_inv_value z)))
                                       (and
                                          (@eq BinNums.Z
                                             (BinInt.Z.modulo
                                                (jet_secp_multiply_finish_product.radix_value
                                                   (jet_secp_point_mul_storage.point_mul_words x
                                                      (jet_secp_square_numeric.square_words zi)))
                                                jet_secp_multiply_checkpoint_columns.field_prime)
                                             (BinInt.Z.modulo
                                                (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value x)
                                                   (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                                                      (jet_secp_multiply_finish_product.radix_value zi)))
                                                jet_secp_multiply_checkpoint_columns.field_prime))
                                          (and
                                             (@eq BinNums.Z
                                                (BinInt.Z.modulo
                                                   (jet_secp_multiply_finish_product.radix_value
                                                      (jet_secp_point_mul_storage.point_mul_words y
                                                         (jet_secp_point_mul_storage.point_mul_words zi
                                                            (jet_secp_square_numeric.square_words zi))))
                                                   jet_secp_multiply_checkpoint_columns.field_prime)
                                                (BinInt.Z.modulo
                                                   (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value y)
                                                      (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                                                         (BinInt.Z.mul
                                                            (jet_secp_multiply_finish_product.radix_value zi)
                                                            (jet_secp_multiply_finish_product.radix_value zi))))
                                                   jet_secp_multiply_checkpoint_columns.field_prime))
                                             (and (jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_state mf)
                                                (and
                                                   (jet_sx_mem.lframe
                                                      (fun (b : Values.block) (_ : BinNums.Z) =>
                                                       and (not (@eq Values.block b bp)) (not (@eq Values.block b br)))
                                                      m mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))))))))))
