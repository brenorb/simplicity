### C.jet_multiply_wide_exec.wide_multiply_body
wide_multiply_body
     : forall s : multiply_wide_size,
       @eq Clight.statement (Clight.fn_body (wide_multiply s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (jet_binary_wide_exec.wide_binary_read (multiply_input_size s) jets._t'1)
                  (Clight.Sset jets._x (Clight.Etempvar jets._t'1 Ctypesdefs.tulong)))
               (Clight.Ssequence
                  (Clight.Ssequence (jet_binary_wide_exec.wide_binary_read (multiply_input_size s) jets._t'2)
                     (Clight.Sset jets._y (Clight.Etempvar jets._t'2 Ctypesdefs.tulong)))
                  (Clight.Ssequence
                     (jet_arith8_layout_exec.frame_writer_call (jet_wide.wide_writer_id (multiply_output_size s))
                        Ctypesdefs.tulong Ctypesdefs.tvoid wide_multiply_expr)
                     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))))
### C.jet_multiply_wide_exec.eval_wide_multiply_expr
eval_wide_multiply_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r t : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._x le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._y le) (@Some Values.val (Values.Vlong t))),
       Clight.eval_expr jet_exec.ge0 e le m wide_multiply_expr (Values.Vlong (Integers.Int64.mul r t))
### C.jet_multiply_wide_exec.eval_wide_multiply_composes
eval_wide_multiply_composes
     : forall (env : Values.val) (s : multiply_wide_size) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (mc mr mr2 me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bytes : list Memdata.memval) (r t : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader (multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader (multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong t))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer (multiply_output_size s)))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (Integers.Int64.mul r t)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function (wide_multiply s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_multiply_wide_exec.multiply_input_size
multiply_input_size =
fun s : multiply_wide_size => match s return jet_wide.wide_size with
                              | M16 => jet_wide.W16
                              | M32 => jet_wide.W32
                              end
     : forall _ : multiply_wide_size, jet_wide.wide_size

Arguments multiply_input_size s
### C.jet_multiply_wide_exec.multiply_output_size
multiply_output_size =
fun s : multiply_wide_size => match s return jet_wide.wide_size with
                              | M16 => jet_wide.W32
                              | M32 => jet_wide.W64
                              end
     : forall _ : multiply_wide_size, jet_wide.wide_size

Arguments multiply_output_size s
### C.jet_multiply_wide_exec.wide_multiply
wide_multiply =
fun s : multiply_wide_size =>
match s return Clight.function with
| M16 => jets.f_simplicity_multiply_16
| M32 => jets.f_simplicity_multiply_32
end
     : forall _ : multiply_wide_size, Clight.function

Arguments wide_multiply s
### C.jet_multiply_wide_exec.wide_multiply_expr
wide_multiply_expr =
Clight.Ebinop Cop.Omul (Clight.Etempvar jets._x Ctypesdefs.tulong) (Clight.Etempvar jets._y Ctypesdefs.tulong)
  Ctypesdefs.tulong
     : Clight.expr
### C.jet_multiply_wide_exec.wide_multiply_spec
wide_multiply_spec =
fun (s : multiply_wide_size) (term : Alg.Core.Algebra) =>
match
  s as s0
  return
    (Alg.Core.domain term
       (Ty.Prod (Word.Word (jet_wide.wide_log (multiply_input_size s0)))
          (Word.Word (jet_wide.wide_log (multiply_input_size s0))))
       (Word.Word (jet_wide.wide_log (multiply_output_size s0))))
with
| M16 => @jet_multiply_spec.multiply_word_spec (S (S (S (S O)))) term
| M32 => @jet_multiply_spec.multiply_word_spec (S (S (S (S (S O))))) term
end
     : forall (s : multiply_wide_size) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod (Word.Word (jet_wide.wide_log (multiply_input_size s)))
            (Word.Word (jet_wide.wide_log (multiply_input_size s))))
         (Word.Word (jet_wide.wide_log (multiply_output_size s)))

Arguments wide_multiply_spec s {term}
### C.jet_multiply_wide_exec.le_wide_multiply_x
le_wide_multiply_x =
fun (env : Values.val) (s : multiply_wide_size) (bd : Values.block) (dofs : Integers.Ptrofs.int)
  (bs : Values.block) (sofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._x (Values.Vlong r)
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vlong r)
     (jet_arith8_layout_exec.le_arith8_layout env (wide_multiply s) bd dofs bs sofs))
     : forall (_ : Values.val) (_ : multiply_wide_size) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments le_wide_multiply_x env s bd dofs bs sofs r
### C.jet_multiply_wide_exec.le_wide_multiply_y
le_wide_multiply_y =
fun (env : Values.val) (s : multiply_wide_size) (bd : Values.block) (dofs : Integers.Ptrofs.int)
  (bs : Values.block) (sofs : Integers.Ptrofs.int) (r t : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._y (Values.Vlong t)
  (@Maps.PTree.set Values.val jets._t'2 (Values.Vlong t) (le_wide_multiply_x env s bd dofs bs sofs r))
     : forall (_ : Values.val) (_ : multiply_wide_size) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments le_wide_multiply_y env s bd dofs bs sofs r t
