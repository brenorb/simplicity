### C.jet_secp_wnaf_negative_prepare.exec_wnaf_sign_large
exec_wnaf_sign_large
     : forall (le : Clight.temp_env) (m : Memory.Mem.mem) (n : BinNums.Z) (bs : Values.block)
         (_ : and
                (BinInt.Z.le
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                   n) (BinInt.Z.lt n jet_secp_canonical_scalar.canonical_group_order))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bs BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n)))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_wnaf_digit.wnaf_env bs) le m
               jet_secp_wnaf_prepare.wnaf_sign_select Events.E0 (wnaf_negative_temps le) mf ClightBigstep.Out_normal)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf bs BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (BinInt.Z.modulo (BinInt.Z.opp n) jet_secp_canonical_scalar.canonical_group_order))))
               (and
                  (Memory.Mem.range_perm mf bs BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_sx_mem.lframe (fun (old : Values.block) (_ : BinNums.Z) => not (@eq Values.block old bs)) m
                        mf)
                     (and (jet_clight_internal_permissions.keeps_permissions m mf)
