### C.jet_multiply_spec.multiply_word_spec_parametric
multiply_word_spec_parametric
     : forall n : nat,
       @Alg.Core.Parametric (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word (S n)) (@multiply_word_spec n)
### C.jet_multiply_spec.multiply_word_spec_numeric
multiply_word_spec_numeric
     : forall (n : nat) (x y : Ty.tySem (Word.Word n)),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S n))
            (@multiply_word_spec n Alg.CoreFunSem (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)))
         (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
### C.jet_multiply_spec.multiply_int64_denotes
multiply_int64_denotes
     : forall (n : nat) (x y : Ty.tySem (Word.Word n)) (r t : Integers.Int64.int)
         (_ : BinInt.Z.le (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) (S n)))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y)),
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S n))))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S n)) (Integers.Int64.unsigned (Integers.Int64.mul r t)))
         (@multiply_word_spec n Alg.CoreFunSem (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y))
### C.jet_multiply_spec.multiply_word_spec
multiply_word_spec =
fun (n : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word n) (Word.Word n))
  (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word (S n))) (Word.Word (S n)) term
  (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n))
     (Word.Word (S n)) term (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word n) (Word.Word n)) term)
     (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word n) (Word.Word n)) Ty.Unit (Word.Word (S n)) term
        (@Alg.Core.Combinators.unit (Ty.Prod (Word.Word n) (Word.Word n)) term) (@Word.zero (S n) term)))
  (@Word.fullMultiplier n term)
     : forall (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word (S n))

Arguments multiply_word_spec n%nat_scope {term}
