     : forall (A B : Type) (xs : list A) (ys : list B) (da : A) (db : B) (n : nat) (_ : @eq nat (@length A xs) n)
         (_ : @eq nat (@length B ys) n),
       @eq (list (prod A B))
         (@List.map nat (prod A B)
            (fun j : nat => @pair A B (@List.nth A j (@List.rev A xs) da) (@List.nth B j (@List.rev B ys) db))
            (@List.rev nat (List.seq O n))) (@List.combine A B xs ys)
