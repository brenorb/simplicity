wnaf_literal_digit_at =
fun (word : Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))) (i : BinNums.Z) =>
@List.nth
  (sum unit
     ((fix tySem (X : Ty.Ty) : Set :=
         match X return Set with
         | Ty.Unit => unit
         | Ty.Sum A B => sum (tySem A) (tySem B)
         | Ty.Prod A B => prod (tySem A) (tySem B)
         end) (Word.Word (S (S (S (S O))))))) (BinInt.Z.to_nat i)
  (@List.rev
     (sum unit
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end) (Word.Word (S (S (S (S O)))))))
     (jet_secp_wnaf_literal.literal_wnaf15_digits
        (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))) (@inl unit unit tt) word)))
  (@inl unit
     (prod
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end)
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end)
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))) tt)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))) (_ : BinNums.Z),
       Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit

Arguments wnaf_literal_digit_at word i%Z_scope
