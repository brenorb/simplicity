       @eq (list (prod B C)) (@List.combine B C (@List.map A B f xs) (@List.map A C g xs))
         (@List.map A (prod B C) (fun x : A => @pair B C (f x) (g x)) xs)
### C.jet_secp_generator_digit_index.generator_combine_rev
generator_combine_rev
     : forall (A B : Type) (xs : list A) (ys : list B) (_ : @eq nat (@length A xs) (@length B ys)),
       @eq (list (prod A B)) (@List.combine A B (@List.rev A xs) (@List.rev B ys))
         (@List.rev (prod A B) (@List.combine A B xs ys))
### C.jet_secp_generator_digit_index.generator_pair_enumerate_reverse
