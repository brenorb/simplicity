### C.jet_secp_square_separate_numeric.separate_result_loads
separate_result_loads
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (writable : bool) (freed : option BinNums.Z) (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : jet_sx_state.rep rho layout
                (@cons jet_sx_state.region
                   (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_square_execution.square_limbs) true
                      (@Some BinNums.Z
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                   (@cons jet_sx_state.region (jet_secp_square_separate_layout.separate_input writable freed)
                      (@nil jet_sx_state.region))) m),
       jet_secp_multiply_finish_execute.output_words layout (jet_secp_square_numeric.square_words rho) m
### C.jet_secp_square_separate_numeric.eval_original_square_separate_numeric
eval_original_square_separate_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (writable : bool) (freed : option BinNums.Z) (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : jet_sx_state.rep rho layout (jet_secp_square_separate_layout.separate_regs writable freed) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout (S O))
                        (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_sx_state.rep rho layout
                  (@cons jet_sx_state.region
                     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_square_execution.square_limbs) true
                        (@Some BinNums.Z
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@cons jet_sx_state.region (jet_secp_square_separate_layout.separate_input writable freed)
                        (@nil jet_sx_state.region))) mf)
               (and
                  (jet_secp_multiply_finish_execute.output_words layout (jet_secp_square_numeric.square_words rho) mf)
                  (and
                     (@eq BinNums.Z
                        (BinInt.Z.modulo
                           (jet_secp_multiply_finish_product.radix_value (jet_secp_square_numeric.square_words rho))
                           jet_secp_multiply_checkpoint_columns.field_prime)
                        (BinInt.Z.modulo
                           (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value rho)
                              (jet_secp_multiply_finish_product.radix_value rho))
                           jet_secp_multiply_checkpoint_columns.field_prime))
                     (and
                        (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                         and
                           (BinInt.Z.le BinNums.Z0
                              (Integers.Int64.unsigned (jet_secp_square_numeric.square_words rho i)))
                           (BinInt.Z.lt (Integers.Int64.unsigned (jet_secp_square_numeric.square_words rho i))
                              match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                              | true =>
                                  BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))
                              | false =>
                                  BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))
                              end))
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot layout
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape (jet_secp_square_separate_layout.separate_regs writable freed))
                                 b ofs)) m mf))))))
### C.jet_secp_square_separate_numeric.square_result_reusable
square_result_reusable
     : forall (rho : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds rho),
       jet_secp_square_columns.square_input_bounds (jet_secp_square_numeric.square_words rho)
### C.jet_secp_square_separate_numeric.eval_original_square_separate_literal
eval_original_square_separate_literal
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (layout : jet_sx_state.layout)
         (m : Memory.Mem.mem) (writable : bool) (freed : option BinNums.Z)
         (_ : jet_sx_state.rep (jet_secp_square_spec_bridge.square_reader_rho x) layout
                (jet_secp_square_separate_layout.separate_regs writable freed) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout (S O))
                        (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_sx_state.rep (jet_secp_square_spec_bridge.square_reader_rho x) layout
                  (@cons jet_sx_state.region
                     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_square_execution.square_limbs) true
                        (@Some BinNums.Z
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@cons jet_sx_state.region (jet_secp_square_separate_layout.separate_input writable freed)
                        (@nil jet_sx_state.region))) mf)
               (and
                  (jet_secp_multiply_finish_execute.output_words layout
                     (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho x)) mf)
                  (and
                     (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (jet_secp_write_fe_wide_exec.wide_fe_output
                           (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho x) O)
                           (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho x)
                              (S O))
                           (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho x)
                              (S (S O)))
                           (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho x)
                              (S (S (S O))))
                           (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho x)
                              (S (S (S (S O)))))) (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem x))
                     (and
                        (jet_secp_square_columns.square_input_bounds
                           (jet_secp_square_numeric.square_words (jet_secp_square_spec_bridge.square_reader_rho x)))
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot layout
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape (jet_secp_square_separate_layout.separate_regs writable freed))
                                 b ofs)) m mf))))))
