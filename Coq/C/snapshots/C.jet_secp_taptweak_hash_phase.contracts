### C.jet_secp_taptweak_hash_phase.exec_taptweak_hash_phase
exec_taptweak_hash_phase
     : forall (_ : jet_memcpy_model.memcpy_model) (pk h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bb bc bs bt bf bin : Values.block) (edge cursor : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._buf e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ctx__1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._output_hash e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._input_hash e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._read32s e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_hash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_finalize e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_fromMidstate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bf Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bb
                   (@cons Values.block bc
                      (@cons Values.block bs
                         (@cons Values.block bt (@cons Values.block bf (@cons Values.block bin (@nil Values.block))))))))
         (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (@cons (prod Values.block BinNums.Z)
                          (@pair Values.block BinNums.Z bb
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                          (@cons (prod Values.block BinNums.Z)
                             (@pair Values.block BinNums.Z bc
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                             (@cons (prod Values.block BinNums.Z)
                                (@pair Values.block BinNums.Z bs
                                   (BinNums.Zpos
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                (@cons (prod Values.block BinNums.Z)
                                   (@pair Values.block BinNums.Z bt
                                      (BinNums.Zpos
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                   (@cons (prod Values.block BinNums.Z)
                                      (@pair Values.block BinNums.Z bf
                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                      (@nil (prod Values.block BinNums.Z)))))))),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_taptweak_tag.taptweak_startup m)
         (_ : jet_secp_taptweak_key_phase.secp_sha_view m bc bs
                (jet_sha_ctx8_model.state_regs jet_secp_taptweak_tag.taptweak_iv_word)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                (jet_secp_schnorr_challenge_hash.schnorr_word_bytes pk))
         (_ : jet_frame_layout.frame_fields_at m bf BinNums.Z0 bin edge cursor)
         (_ : jet_encoding.frame_input_cells_at m bin edge cursor
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m taptweak_hash_phase Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_read8s_layout.uint8_array_at mf bb BinNums.Z0
                  (jet_secp_schnorr_challenge_hash.schnorr_word_bytes (jet_secp_taptweak_hash.taptweak_hash_word pk h)))
               (and
                  (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                     (jet_sha_ctx8_model.state_regs (jet_secp_taptweak_hash.taptweak_hash_word pk h)))
                  (and (jet_uint32_array_init.uint32_array_at mf bt BinNums.Z0 (jet_sha_ctx8_model.state_regs h))
                     (and
                        (jet_frame_layout.frame_fields_at mf bf BinNums.Z0 bin edge
                           (BinInt.Z.add cursor
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                        (and
                           (forall (b : Values.block) (hi : BinNums.Z)
                              (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                                     (@cons (prod Values.block BinNums.Z)
                                        (@pair Values.block BinNums.Z bb
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                        (@cons (prod Values.block BinNums.Z)
                                           (@pair Values.block BinNums.Z bc
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                           (@cons (prod Values.block BinNums.Z)
                                              (@pair Values.block BinNums.Z bs
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                              (@cons (prod Values.block BinNums.Z)
                                                 (@pair Values.block BinNums.Z bt
                                                    (BinNums.Zpos
                                                       (BinNums.xO
                                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                                 (@cons (prod Values.block BinNums.Z)
                                                    (@pair Values.block BinNums.Z bf
                                                       (BinNums.Zpos
                                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                    (@nil (prod Values.block BinNums.Z)))))))),
                            Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                           (and
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block b bf))
                                    (and (not (@eq Values.block b bt))
                                       (and (not (@eq Values.block b bc))
                                          (and (not (@eq Values.block b bs)) (not (@eq Values.block b bb)))))) m mf)
                              (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                 (jet_secp_taptweak_tag.taptweak_startup mf)))))))))
