### C.jet_secp_generator_point_numeric.literal_mixed_step
literal_mixed_step
     : forall x y z bx byword : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       let h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         jet_secp_mixed_dispatch_literal.mixed_literal_h x z bx in
       let i : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         jet_secp_mixed_dispatch_literal.mixed_literal_i y z byword in
       let u : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         @jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x
              (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem
                 (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))) in
       let v : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
         @jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) y
              (@jet_secp_rescale_literal.literal_fe_cube Alg.CoreFunSem
                 (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))) in
       @eq
         (Ty.tySem
            (Ty.Prod
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
            (@pair
               (prod
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) bx byword)))
         match
           Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z)
           return
             (Ty.tySem
                (Ty.Prod
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         with
         | true =>
             @pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem bx)
                  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem byword))
               (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem
                  (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))
         | false =>
             match
               Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem h)
               return
                 (Ty.tySem
                    (Ty.Prod
                       (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                          (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
             with
             | true =>
                 match
                   Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem i)
                   return
                     (Ty.tySem
                        (Ty.Prod
                           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 with
                 | true =>
                     @jet_secp_double_literal.literal_gej_double Alg.CoreFunSem
                       (@pair
                          (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                          (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)
                 | false => @jet_secp_literal_infinity.literal_gej_infinity Alg.CoreFunSem tt
                 end
             | false =>
                 @pair
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (jet_secp_mixed_nonzero_literal.mixed_literal_rx h i u)
                      (jet_secp_mixed_nonzero_literal.mixed_literal_ry h i u v))
                   (jet_secp_mixed_nonzero_literal.mixed_literal_rz h z)
             end
         end
