### C.jet_secp_generator_point_numeric.literal_halve_numeric
literal_halve_numeric =
fun x : BinNums.Z =>
match BinInt.Z.eqb (BinInt.Z.modulo x (BinNums.Zpos (BinNums.xO BinNums.xH))) BinNums.Z0 return BinNums.Z with
| true => BinInt.Z.div x (BinNums.Zpos (BinNums.xO BinNums.xH))
| false =>
    BinInt.Z.modulo
      (BinInt.Z.add
         (BinInt.Z.div (BinInt.Z.add jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
            (BinNums.Zpos (BinNums.xO BinNums.xH))) (BinInt.Z.div x (BinNums.Zpos (BinNums.xO BinNums.xH))))
      jet_secp_fe_math.feP
end
     : forall _ : BinNums.Z, BinNums.Z

Arguments literal_halve_numeric x%Z_scope
