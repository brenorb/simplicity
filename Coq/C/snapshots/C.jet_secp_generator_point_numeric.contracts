### C.jet_secp_generator_point_numeric.literal_mixed_nonzero_numeric
literal_mixed_nonzero_numeric =
fun u v h i z : BinNums.Z =>
let t : BinNums.Z :=
  BinInt.Z.modulo (BinInt.Z.mul (BinInt.Z.modulo (BinInt.Z.mul h h) jet_secp_fe_math.feP) u) jet_secp_fe_math.feP in
let g : BinNums.Z := BinInt.Z.modulo (BinInt.Z.mul (BinInt.Z.mul h h) h) jet_secp_fe_math.feP in
let rx : BinNums.Z :=
  BinInt.Z.modulo
    (BinInt.Z.add
       (BinInt.Z.modulo
          (BinInt.Z.add g
             (BinInt.Z.modulo (BinInt.Z.mul (BinNums.Zneg (BinNums.xO BinNums.xH)) t) jet_secp_fe_math.feP))
          jet_secp_fe_math.feP) (BinInt.Z.modulo (BinInt.Z.mul i i) jet_secp_fe_math.feP)) jet_secp_fe_math.feP in
@pair (prod BinNums.Z BinNums.Z) BinNums.Z
  (@pair BinNums.Z BinNums.Z rx
     (BinInt.Z.modulo
        (BinInt.Z.add (BinInt.Z.modulo (BinInt.Z.mul g v) jet_secp_fe_math.feP)
           (BinInt.Z.modulo
              (BinInt.Z.mul i
                 (BinInt.Z.modulo
                    (BinInt.Z.add rx (BinInt.Z.modulo (BinInt.Z.sub jet_secp_fe_math.feP t) jet_secp_fe_math.feP))
                    jet_secp_fe_math.feP)) jet_secp_fe_math.feP)) jet_secp_fe_math.feP))
  (BinInt.Z.modulo
     (BinInt.Z.mul (BinInt.Z.modulo (BinInt.Z.mul h z) jet_secp_fe_math.feP)
        (BinInt.Z.modulo (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH)) jet_secp_fe_math.feP))
     jet_secp_fe_math.feP)
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
