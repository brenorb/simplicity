### C.jet_secp_generator_point_numeric.literal_mixed_numeric
literal_mixed_numeric =
fun x y z bx byword : BinNums.Z =>
match literal_zero_numeric z return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
| true =>
    @pair (prod BinNums.Z BinNums.Z) BinNums.Z
      (@pair BinNums.Z BinNums.Z (BinInt.Z.modulo bx jet_secp_fe_math.feP)
         (BinInt.Z.modulo byword jet_secp_fe_math.feP)) (BinNums.Zpos BinNums.xH)
| false =>
    match literal_mixed_values x y z bx byword return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
    | pair p i =>
        match p return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
        | pair p0 h =>
            match p0 return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
            | pair u v =>
                match literal_zero_numeric h return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
                | true =>
                    match literal_zero_numeric i return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
                    | true => literal_double_numeric x y z
                    | false =>
                        @pair (prod BinNums.Z BinNums.Z) BinNums.Z (@pair BinNums.Z BinNums.Z BinNums.Z0 BinNums.Z0)
                          BinNums.Z0
                    end
                | false => literal_mixed_nonzero_numeric u v h i z
                end
            end
        end
    end
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       prod (prod BinNums.Z BinNums.Z) BinNums.Z

