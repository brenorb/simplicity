### C.jet_secp_generator_point_numeric.literal_double_numeric
literal_double_numeric =
fun x y z : BinNums.Z =>
match
  orb (BinInt.Z.eqb z BinNums.Z0) (BinInt.Z.eqb z jet_secp_fe_math.feP)
  return (prod (prod BinNums.Z BinNums.Z) BinNums.Z)
with
| true => @pair (prod BinNums.Z BinNums.Z) BinNums.Z (@pair BinNums.Z BinNums.Z BinNums.Z0 BinNums.Z0) BinNums.Z0
| false => literal_double_body_numeric x y z
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), prod (prod BinNums.Z BinNums.Z) BinNums.Z

