### C.jet_secp_generator_point_numeric.literal_mixed_values
literal_mixed_values =
fun x y z bx byword : BinNums.Z =>
let u : BinNums.Z :=
  BinInt.Z.modulo
    (BinInt.Z.mul x
       (BinInt.Z.modulo (BinInt.Z.mul (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH)) jet_secp_fe_math.feP))
    jet_secp_fe_math.feP in
let v : BinNums.Z :=
  BinInt.Z.modulo
    (BinInt.Z.mul y
       (BinInt.Z.modulo
          (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zpos BinNums.xH) (BinNums.Zpos BinNums.xH)) (BinNums.Zpos BinNums.xH))
          jet_secp_fe_math.feP)) jet_secp_fe_math.feP in
let h : BinNums.Z :=
  BinInt.Z.modulo
    (BinInt.Z.add u
       (BinInt.Z.modulo
          (BinInt.Z.mul (BinInt.Z.modulo (BinInt.Z.sub jet_secp_fe_math.feP bx) jet_secp_fe_math.feP)
             (BinInt.Z.modulo (BinInt.Z.mul z z) jet_secp_fe_math.feP)) jet_secp_fe_math.feP)) jet_secp_fe_math.feP in
let i : BinNums.Z :=
  BinInt.Z.modulo
    (BinInt.Z.add v
       (BinInt.Z.modulo
          (BinInt.Z.mul (BinInt.Z.modulo (BinInt.Z.sub jet_secp_fe_math.feP byword) jet_secp_fe_math.feP)
             (BinInt.Z.modulo (BinInt.Z.mul (BinInt.Z.mul z z) z) jet_secp_fe_math.feP)) jet_secp_fe_math.feP))
    jet_secp_fe_math.feP in
@pair (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z
  (@pair (prod BinNums.Z BinNums.Z) BinNums.Z (@pair BinNums.Z BinNums.Z u v) h) i
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) BinNums.Z

