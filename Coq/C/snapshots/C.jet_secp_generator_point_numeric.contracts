### C.jet_secp_generator_point_numeric.literal_double_body_numeric
literal_double_body_numeric =
fun x y z : BinNums.Z =>
let s : BinNums.Z := BinInt.Z.modulo (BinInt.Z.mul y y) jet_secp_fe_math.feP in
let l : BinNums.Z :=
  literal_halve_numeric
    (BinInt.Z.modulo
       (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) (BinInt.Z.modulo (BinInt.Z.mul x x) jet_secp_fe_math.feP))
       jet_secp_fe_math.feP) in
let t : BinNums.Z :=
  BinInt.Z.modulo (BinInt.Z.sub jet_secp_fe_math.feP (BinInt.Z.modulo (BinInt.Z.mul s x) jet_secp_fe_math.feP))
    jet_secp_fe_math.feP in
let rx : BinNums.Z :=
  BinInt.Z.modulo
    (BinInt.Z.add (BinInt.Z.modulo (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) t) jet_secp_fe_math.feP)
       (BinInt.Z.modulo (BinInt.Z.mul l l) jet_secp_fe_math.feP)) jet_secp_fe_math.feP in
@pair (prod BinNums.Z BinNums.Z) BinNums.Z
  (@pair BinNums.Z BinNums.Z rx
     (BinInt.Z.modulo
        (BinInt.Z.sub jet_secp_fe_math.feP
           (BinInt.Z.modulo
              (BinInt.Z.add
                 (BinInt.Z.modulo (BinInt.Z.mul l (BinInt.Z.modulo (BinInt.Z.add rx t) jet_secp_fe_math.feP))
                    jet_secp_fe_math.feP) (BinInt.Z.modulo (BinInt.Z.mul s s) jet_secp_fe_math.feP))
              jet_secp_fe_math.feP)) jet_secp_fe_math.feP)) (BinInt.Z.modulo (BinInt.Z.mul y z) jet_secp_fe_math.feP)
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), prod (prod BinNums.Z BinNums.Z) BinNums.Z

