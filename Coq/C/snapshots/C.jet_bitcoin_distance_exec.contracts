### C.jet_bitcoin_distance_exec.version_ok
version_ok =
fun ver : Integers.Int64.int =>
negb (Integers.Int64.ltu ver (Integers.Int64.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
     : forall _ : Integers.Int64.int, bool

Arguments version_ok ver
### C.jet_bitcoin_distance_exec.dist_result
dist_result =
fun (ver seq : Integers.Int64.int) (c : bool) =>
match
  andb (andb (version_ok ver) (jet_parse_sequence_spec.parse_sequence_enabled seq)) c return Integers.Int64.int
with
| true => jet_parse_sequence_spec.parse_sequence_payload seq
| false => Integers.Int64.zero
end
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : bool), Integers.Int64.int

Arguments dist_result ver seq c%bool_scope
