  (@jet_buffer_empty_spec.AC.case Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type
     elements_single_issuance_tail_type (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Alg.Assertion.toCore term)
     (@jet_buffer_empty_spec.AC.injl (Ty.Prod Ty.Unit elements_single_issuance_tail_type) Ty.Unit
