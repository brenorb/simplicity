let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_buffer_empty_spec.AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)
     (Ty.Prod (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)
