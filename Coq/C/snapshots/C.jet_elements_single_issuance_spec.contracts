### C.jet_elements_single_issuance_spec.elements_single_issuance_bytes
elements_single_issuance_bytes =
fun (a t : Ty.tySem jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)
  (s r : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (b : Ty.tySem jet_elements_blinding_entropy_spec.blinding_entropy_value_type) =>
@app (Ty.tySem (Word.Word (S (S (S O)))))
  (@app (Ty.tySem (Word.Word (S (S (S O)))))
     (@app (Ty.tySem (Word.Word (S (S (S O)))))
        (@app (Ty.tySem (Word.Word (S (S (S O)))))
           (jet_elements_issuance_amount_hash_spec.issuance_asset_amount_bytes a)
           (jet_elements_issuance_amount_hash_spec.issuance_asset_amount_bytes t))
        (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) s))
     (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) r))
  (jet_elements_blinding_entropy_hash_spec.blinding_entropy_bytes b)
     : forall (_ : Ty.tySem jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)
