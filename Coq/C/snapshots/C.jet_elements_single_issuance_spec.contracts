              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           jet_elements_blinding_entropy_spec.blinding_entropy_result_type)))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)
     (Ty.Prod (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)
        (Ty.Prod
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           jet_elements_blinding_entropy_spec.blinding_entropy_result_type))
     (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
     (@jet_elements_issuance_amounts_hash_program.elements_issuance_pair_spec
        (@jet_elements_issuance_entropy_spec.elements_issuance_asset_spec)
        jet_elements_prim.Elements.IssuanceAssetAmount alg)
     (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit jet_elements_issuance_amount_hash_spec.issuance_asset_amount_value_type)
        (Ty.Prod
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           jet_elements_blinding_entropy_spec.blinding_entropy_result_type)
        (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
        (@jet_elements_issuance_amounts_hash_program.elements_issuance_pair_spec
           (@jet_elements_issuance_entropy_spec.elements_issuance_token_spec)
           jet_elements_prim.Elements.IssuanceTokenAmount alg)
        (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
