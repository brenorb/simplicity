### C.jet_secp_point_write_field.eval_point_bounded_field_write
eval_point_bounded_field_write
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (f : point_field)
         (w0 : bool) (outs0 : list BitMachine.Cell) (k : jet_secp_point_write_run.point_coordinate)
         (m : Memory.Mem.mem) (b : Values.block) (_ : jet_output_layout.write_frame_at m0 bd dbase bw edge cursor N)
         (_ : point_field_bounds f)
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset k) (point_field_limbs f))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : jet_secp_frame.invA m0 bd dbase bw edge cursor N bi rc w0 outs0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (point_field_rho f rc) (@nil jet_sx_eval.event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val
                     (Values.Vptr b (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_frame_inv.finv m0 bd dbase bw edge cursor N bi mf true
                  (@app BitMachine.Cell outs0
                     (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (point_field_output f))))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                           (@nil (prod Values.block BinNums.Z))) (jet_secp_point_write_run.point_write_initial_regs k)
                        m) m mf))))
### C.jet_secp_point_write_field.point_field
Variant point_field : Set :=
    mkpointfield : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
                     (_ : Integers.Int64.int) (_ : Integers.Int64.int), point_field.

Arguments mkpointfield pf0 pf1 pf2 pf3 pf4
### C.jet_secp_point_write_field.point_field_limbs
point_field_limbs =
fun f : point_field =>
@cons Integers.Int64.int (pf0 f)
  (@cons Integers.Int64.int (pf1 f)
     (@cons Integers.Int64.int (pf2 f)
        (@cons Integers.Int64.int (pf3 f) (@cons Integers.Int64.int (pf4 f) (@nil Integers.Int64.int)))))
     : forall _ : point_field, list Integers.Int64.int

Arguments point_field_limbs f
### C.jet_secp_point_write_field.point_field_bounds
point_field_bounds =
fun f : point_field =>
and
  (BinInt.Z.le (Integers.Int64.unsigned (pf0 f))
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
  (and
     (BinInt.Z.le (Integers.Int64.unsigned (pf1 f))
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
     (and
        (BinInt.Z.le (Integers.Int64.unsigned (pf2 f))
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
        (and
           (BinInt.Z.le (Integers.Int64.unsigned (pf3 f))
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
           (BinInt.Z.le (Integers.Int64.unsigned (pf4 f))
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
     : forall _ : point_field, Prop

Arguments point_field_bounds f
### C.jet_secp_point_write_field.point_field_output
point_field_output =
fun f : point_field => jet_secp_write_fe_wide_exec.wide_fe_output (pf0 f) (pf1 f) (pf2 f) (pf3 f) (pf4 f)
     : forall _ : point_field, Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments point_field_output f
### C.jet_secp_point_write_field.point_field_rho
point_field_rho =
fun (f : point_field) (rc : BinNums.Z) =>
jet_secp_write_fe_wide_values.wide_fe_rho (pf0 f) (pf1 f) (pf2 f) (pf3 f) (pf4 f) rc
     : forall (_ : point_field) (_ : BinNums.Z) (_ : nat), Integers.Int64.int

Arguments point_field_rho f rc%Z_scope n%nat_scope
