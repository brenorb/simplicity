### C.jet_bitcoin_version_local.bitcoin_version_local_spec
bitcoin_version_local_spec
     : jet_application_contract.application_jet_local_spec jets_bitcoin.f_simplicity_bitcoin_version
         jet_bitcoin_linkage.bitcoin_ge Bitcoin.Bitcoin.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
         bitcoin_version_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : Bitcoin.Bitcoin.env) =>
          @jet_bitcoin_version_canonical.bitcoin_transaction_version_spec
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a environment)
### C.jet_bitcoin_version_local.bitcoin_version_env_rep
bitcoin_version_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun version : Integers.Int64.int =>
               and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                 (and (and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
                    (and (BinInt.Z.le BinNums.Z0 txbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add txbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                             (and
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint64 m bt
                                      (BinInt.Z.add txbase
                                         (BinNums.Zpos
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))))
                                   (@Some Values.val (Values.Vlong version)))
                                (@eq BinNums.Z (Integers.Int64.unsigned version)
                                   (Integers.Int.unsigned (Bitcoin.sigTxVersion (Bitcoin.Bitcoin.envTx environment))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_version_env_rep m env environment
