### C.jet_secp_gej_ge_equiv_reader.gej_ge_equiv_result_cases
gej_ge_equiv_result_cases
     : forall (x : forall _ : nat, Integers.Int64.int) (value : BinNums.Z) (z u v : forall _ : nat, Integers.Int64.int)
         (flag : Integers.Int.int),
       or
         (@eq Integers.Int.int (jet_secp_gej_ge_equiv_function.gej_ge_equiv_result x value z u v flag) Integers.Int.one)
