### C.jet_secp_generator_initialize.generator_initial_counters_source
generator_initial_counters_source
     : @eq Clight.statement generator_initial_counters
         (Clight.Ssequence (Clight.Sset jets_secp._bits_ng_1 (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))
            (Clight.Ssequence
               (Clight.Sset jets_secp._bits_ng_128 (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))
               (Clight.Ssequence (Clight.Sset jets_secp._bits (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))
                  (Clight.Ssequence
                     (Clight.Sset jets_secp._no
                        (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Ctypesdefs.tulong))
                     Clight.Sskip))))
### C.jet_secp_generator_initialize.generator_initialize_source
generator_initialize_source
     : @eq Clight.statement generator_initialize
         (jet_secp_statement_prefix.statement_sequence
            (@List.firstn Clight.statement (S (S (S (S O))))
               (@fst (list Clight.statement) Clight.statement
                  (jet_secp_statement_prefix.split_statement_last
                     (Clight.fn_body jets_secp.f_secp256k1_ecmult_strauss_wnaf))))
            (Clight.Ssequence generator_set_denominator Clight.Sskip))
### C.jet_secp_generator_initialize.exec_generator_initial_counters
exec_generator_initial_counters
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_initial_counters Events.E0
         (generator_initial_temps le) m ClightBigstep.Out_normal
### C.jet_secp_generator_initialize.exec_generator_initialize
exec_generator_initialize
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bz : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._Z e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bz (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_initialize Events.E0
               (generator_initial_temps le) mi ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mi bz BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_set_bit.point_set_bit_words true)))
               (and
                  (Memory.Mem.range_perm mi bz BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bz)) m mi))))
### C.jet_secp_generator_initialize.generator_initial_preserves
generator_initial_preserves
     : forall (le : Maps.PTree.tree Values.val) (id : AST.ident) (_ : not (@eq AST.ident id jets_secp._no))
         (_ : not (@eq AST.ident id jets_secp._bits)) (_ : not (@eq AST.ident id jets_secp._bits_ng_128))
         (_ : not (@eq AST.ident id jets_secp._bits_ng_1)),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (generator_initial_temps le))
         (@Maps.PTree.get Values.val id le)
### C.jet_secp_generator_initialize.generator_prepare_non_generator_source
generator_prepare_non_generator_source
