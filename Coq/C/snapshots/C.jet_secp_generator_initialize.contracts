            jet_secp_generator_globalz_call.generator_no_points_phase)
### C.jet_secp_generator_initialize.exec_generator_prepare_non_generator
exec_generator_prepare_non_generator
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bz bn : Values.block) (nofs : BinNums.Z) (bs : Values.block)
         (base : BinNums.Z) (ba : Values.block) (aofs : Integers.Ptrofs.int) (br : Values.block)
         (zofs : Integers.Ptrofs.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._Z e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bz (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_scalar_is_zero e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_table_set_globalz e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._na le)
                (@Some Values.val (Values.Vptr bn (Integers.Ptrofs.repr nofs))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._num le)
                (@Some Values.val (Values.Vlong Integers.Int64.one)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._state le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr base))))
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bn bz)) (_ : not (@eq Values.block bs bz))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bn nofs
                (@cons Integers.Int64.int Integers.Int64.zero
                   (@cons Integers.Int64.int Integers.Int64.zero
                      (@cons Integers.Int64.int Integers.Int64.zero
                         (@cons Integers.Int64.int Integers.Int64.zero (@nil Integers.Int64.int))))))
         (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr m bs
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vptr ba aofs)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bs (BinInt.Z.add base BinNums.Z0))
                (@Some Values.val (Values.Vptr br zofs))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_prepare_non_generator Events.E0
               (generator_ready_temps le (Values.Vptr ba aofs) (Values.Vptr br zofs)) mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bz BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_set_bit.point_set_bit_words true)))
               (and
                  (Memory.Mem.range_perm mf bz BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bz)) m mf))))
### C.jet_secp_generator_initialize.generator_initial_counters
