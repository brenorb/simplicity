### C.jet_secp_square_inplace_storage.eval_square_inplace_from_storage
eval_square_inplace_from_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (@eq BinNums.Z
                        (BinInt.Z.modulo
                           (jet_secp_multiply_finish_product.radix_value (jet_secp_square_numeric.square_words rho))
                           jet_secp_multiply_checkpoint_columns.field_prime)
                        (BinInt.Z.modulo
                           (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value rho)
                              (jet_secp_multiply_finish_product.radix_value rho))
                           jet_secp_multiply_checkpoint_columns.field_prime))
                     (and (jet_secp_square_columns.square_input_bounds (jet_secp_square_numeric.square_words rho))
                        (and
                           (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                            and
                              (BinInt.Z.le BinNums.Z0
                                 (Integers.Int64.unsigned (jet_secp_square_numeric.square_words rho i)))
                              (BinInt.Z.lt (Integers.Int64.unsigned (jet_secp_square_numeric.square_words rho i))
                                 match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                                 | true =>
                                     BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))
                                 | false =>
                                     BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))
                                 end))
                           (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b))
                              m mf)))))))
