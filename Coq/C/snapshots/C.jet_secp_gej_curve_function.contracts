### C.jet_secp_gej_curve_function.gej_curve_result
gej_curve_result =
fun x y z : forall _ : nat, Integers.Int64.int =>
match
  BinInt.Z.eqb
    (BinInt.Z.modulo
       (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value y) (jet_secp_multiply_finish_product.radix_value y))
       jet_secp_fe_math.feP)
    (BinInt.Z.modulo
       (BinInt.Z.add
          (BinInt.Z.mul
             (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value x)
                (jet_secp_multiply_finish_product.radix_value x)) (jet_secp_multiply_finish_product.radix_value x))
          (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))
             (BinInt.Z.mul
                (BinInt.Z.mul
                   (BinInt.Z.mul
                      (BinInt.Z.mul
                         (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value z)
                            (jet_secp_multiply_finish_product.radix_value z))
                         (jet_secp_multiply_finish_product.radix_value z))
                      (jet_secp_multiply_finish_product.radix_value z))
                   (jet_secp_multiply_finish_product.radix_value z)) (jet_secp_multiply_finish_product.radix_value z))))
       jet_secp_fe_math.feP) return Integers.Int.int
with
| true => Integers.Int.one
| false => Integers.Int.zero
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int), Integers.Int.int

Arguments gej_curve_result (x y z)%function_scope
