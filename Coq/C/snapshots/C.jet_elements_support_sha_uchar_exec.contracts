### C.jet_elements_support_sha_uchar_exec.uch_blocks
uch_blocks
     : forall bv : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_support_sha_linkage.sha_ge (uch_env bv))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bv BinNums.Z0)
               (BinNums.Zpos BinNums.xH)) (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
### C.jet_elements_support_sha_uchar_exec.eval_sha256_uchar
eval_sha256_uchar
     : forall (_ : jet_memcpy_model.memcpy_model) (m : Memory.Mem.mem) (bx : Values.block)
         (cbase : BinNums.Z) (bo : Values.block) (obase : BinNums.Z) (l regs : list Integers.Int.int)
         (x : Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : BinInt.Z.le BinNums.Z0 cbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 obase)
         (_ : BinInt.Z.le
                (BinInt.Z.add obase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bo bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bo))
         (_ : @eq Integers.Int.int
                (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) x) x)
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bx cbase)
                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr obase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bx
                   (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong c)))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo (Integers.Int64.unsigned c)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (BinInt.Z.of_nat (@length Integers.Int.int l)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bx
                   (BinInt.Z.add cbase
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int ovf))))
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int l)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bx
                   (BinInt.Z.add
                      (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i l Integers.Int.zero))))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
              and
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint32 m bo
                      (BinInt.Z.add obase
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                   (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
                (Memory.Mem.valid_access m AST.Mint32 bo
                   (BinInt.Z.add obase
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                   Memtype.Writable)) (_ : jet_elements_support_sha_block_local.sha_dispatch_ok m)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter) BinNums.Z0)
                (@Some Values.val (Values.Vlong jet_elements_support_sha_uchars_exec.sha_max_counter)))
         (_ : Memory.Mem.range_perm m bx
                (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Writable)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) cbase),
       let vn : Integers.Int64.int := Integers.Int64.repr (BinNums.Zpos BinNums.xH) in
       let ovf' : bool := jet_elements_support_sha_uchars_exec.uc_overflow ovf c vn in
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_sha256_uchar)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr cbase))
                  (@cons Values.val (Values.Vint x) (@nil Values.val))) Events.E0 m'
               (Values.Vint (jet_readBit_layout.bit_int (negb ovf'))))
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr m' bx cbase)
                  (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr obase))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 m' bx
                        (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val (Values.Vlong (Integers.Int64.add c vn))))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint8unsigned m' bx
                           (BinInt.Z.add cbase
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                        (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int ovf'))))
                     (and
                        (forall (i : nat)
                           (_ : lt i
                                  (@length Integers.Int.int
                                     (@fst (list Integers.Int.int) (list Integers.Int.int)
                                        (jet_elements_support_sha_uchars_prep.absorb_i l regs
                                           (@cons Integers.Int.int x (@nil Integers.Int.int)))))),
                         @eq (option Values.val)
                           (Memory.Mem.load AST.Mint8unsigned m' bx
                              (BinInt.Z.add
                                 (BinInt.Z.add cbase
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (BinInt.Z.of_nat i)))
                           (@Some Values.val
                              (Values.Vint
                                 (@List.nth Integers.Int.int i
                                    (@fst (list Integers.Int.int) (list Integers.Int.int)
                                       (jet_elements_support_sha_uchars_prep.absorb_i l regs
                                          (@cons Integers.Int.int x (@nil Integers.Int.int)))) Integers.Int.zero))))
                        (and
                           (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                            @eq (option Values.val)
                              (Memory.Mem.load AST.Mint32 m' bo
                                 (BinInt.Z.add obase
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                       (BinInt.Z.of_nat i))))
                              (@Some Values.val
                                 (Values.Vint
                                    (@List.nth Integers.Int.int i
                                       (@snd (list Integers.Int.int) (list Integers.Int.int)
                                          (jet_elements_support_sha_uchars_prep.absorb_i l regs
                                             (@cons Integers.Int.int x (@nil Integers.Int.int)))) Integers.Int.zero))))
                           (and
                              (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                 (_ : Memory.Mem.valid_block m b)
                                 (_ : or (not (@eq Values.block b bx))
                                        (or
                                           (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                                              (BinInt.Z.add cbase
                                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                           (BinInt.Z.le
                                              (BinInt.Z.add cbase
                                                 (BinNums.Zpos
                                                    (BinNums.xI
                                                       (BinNums.xO
                                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                              ofs)))
                                 (_ : or (not (@eq Values.block b bo))
                                        (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) obase)
                                           (BinInt.Z.le
                                              (BinInt.Z.add obase
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                              ofs))),
                               @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                              (and
                                 (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.valid_block m b)
                                    (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                                 (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                  Memory.Mem.valid_block m' b)))))))))
### C.jet_elements_support_sha_uchar_exec.uch_env
uch_env =
fun bv : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._x (@pair Values.block Ctypes.type bv Ctypesdefs.tuchar)
  Clight.empty_env
     : forall _ : Values.block, Clight.env

Arguments uch_env bv
