### C.jet_asset_exec_asset.asset_prefix_machine
asset_prefix_machine
     : and
         (@eq Integers.Int.int
            (jet_read8s_layout.word8_array_value
               (jet_nonce_context_spec.nonce_byte (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
            (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
         (@eq Integers.Int.int
            (jet_read8s_layout.word8_array_value
               (jet_nonce_context_spec.nonce_byte (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))
            (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))
### C.jet_asset_exec_asset.asset_bytes_length
asset_bytes_length
     : forall p : Ty.tySem jet_nonce_context_spec.nonce_conf_type,
       @eq nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (asset_bytes p))
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
### C.jet_asset_exec_asset.asset_prefix_exec
asset_prefix_exec
     : forall (_ : jet_memcpy_model.memcpy_model) (bl bm bb bx bi : Values.block) (_ : not (@eq Values.block bl bx))
         (_ : not (@eq Values.block bl bm))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bi bl)) (_ : not (@eq Values.block bi bx)) (_ : not (@eq Values.block bi bm))
         (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (le : Clight.temp_env) (m : Memory.Mem.mem) (edge rc : BinNums.Z)
         (p : Ty.tySem jet_nonce_context_spec.nonce_conf_type) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xI
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode jet_nonce_context_spec.nonce_conf_type p))
         (_ : jet_elements_support_sha_ctx_abs.ctx_abs m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
               (jet_nonce_context_shape.nc_env bl bm bb bx) le m jet_asset_exec_shape.asset_prefix Events.E0
               (jet_nonce_exec_phase.nonce_present_temps p le) mf ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                  (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO BinNums.xH))))
               (and
                  (jet_encoding.frame_input_cells_at mf bi edge
                     (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO BinNums.xH)))
                     (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (@snd (Ty.tySem (Word.Word (S (S (S O)))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (asset_prefix_value p))))
                  (and
                     (jet_elements_support_sha_ctx_abs.ctx_abs mf bx bm
                        (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                           (jet_sha_ctx8_model.absorb l regs
                              (@cons (Ty.tySem (Word.Word (S (S (S O)))))
                                 (@fst (Ty.tySem (Word.Word (S (S (S O)))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (asset_prefix_value p)) (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
                        (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                           (jet_sha_ctx8_model.absorb l regs
                              (@cons (Ty.tySem (Word.Word (S (S (S O)))))
                                 (@fst (Ty.tySem (Word.Word (S (S (S O)))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (asset_prefix_value p)) (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
                        (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
                        (jet_elements_support_sha_uchars_exec.uc_overflow ovf c
                           (Integers.Int64.repr (BinNums.Zpos BinNums.xH))))
                     (jet_nonce_exec_effects.nonce_effects m mf
                        (@cons Values.block bl (@cons Values.block bx (@cons Values.block bm (@nil Values.block)))))))))
### C.jet_asset_exec_asset.asset_phase_exec
asset_phase_exec
     : forall (_ : jet_memcpy_model.memcpy_model) (bl bm bb bx bi : Values.block) (_ : not (@eq Values.block bl bx))
         (_ : not (@eq Values.block bl bm))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bb bx)) (_ : not (@eq Values.block bb bm))
         (_ : not
                (@eq Values.block bb
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bb
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bl bb)) (_ : not (@eq Values.block bi bl)) (_ : not (@eq Values.block bi bb))
         (_ : not (@eq Values.block bi bx)) (_ : not (@eq Values.block bi bm)) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (le : Clight.temp_env) (m : Memory.Mem.mem) (edge rc : BinNums.Z)
         (p : Ty.tySem jet_nonce_context_spec.nonce_conf_type) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xI
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode jet_nonce_context_spec.nonce_conf_type p))
         (_ : jet_elements_support_sha_ctx_abs.ctx_abs m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
               (jet_nonce_context_shape.nc_env bl bm bb bx) le m jet_asset_exec_shape.asset_phase Events.E0
               (jet_nonce_exec_phase.nonce_present_temps p le) mf ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                  (BinInt.Z.add rc
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xI
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
               (and
                  (jet_elements_support_sha_ctx_abs.ctx_abs mf bx bm
                     (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                        (jet_sha_ctx8_model.absorb l regs (asset_bytes p)))
                     (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                        (jet_sha_ctx8_model.absorb l regs (asset_bytes p)))
                     (Integers.Int64.add c
                        (Integers.Int64.repr
                           (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (jet_elements_support_sha_uchars_exec.uc_overflow
                        (jet_elements_support_sha_uchars_exec.uc_overflow ovf c
                           (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
                        (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
                        (Integers.Int64.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (jet_nonce_exec_effects.nonce_effects m mf
                     (@cons Values.block bl
                        (@cons Values.block bb (@cons Values.block bx (@cons Values.block bm (@nil Values.block)))))))))
### C.jet_asset_exec_asset.asset_prefix_value
asset_prefix_value =
fun p : Ty.tySem jet_nonce_context_spec.nonce_conf_type =>
match
  p return (prod (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| inl t =>
    match
      t return (prod (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
    with
    | pair odd h =>
        @pair (Ty.tySem (Word.Word (S (S (S O)))))
          (prod
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
          (jet_nonce_context_spec.nonce_byte
             match odd return BinNums.Z with
             | inl _ => BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))
             | inr _ => BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))
             end) h
    end
| inr h =>
    @pair (Ty.tySem (Word.Word (S (S (S O)))))
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
      (jet_nonce_context_spec.nonce_byte (BinNums.Zpos BinNums.xH)) h
end
     : forall _ : Ty.tySem jet_nonce_context_spec.nonce_conf_type,
       prod (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments asset_prefix_value p
### C.jet_asset_exec_asset.asset_bytes
asset_bytes =
fun p : Ty.tySem jet_nonce_context_spec.nonce_conf_type =>
@cons (Ty.tySem (Word.Word (S (S (S O)))))
  (@fst (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (asset_prefix_value p))
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))
     (@snd (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (asset_prefix_value p)))
     : forall _ : Ty.tySem jet_nonce_context_spec.nonce_conf_type, list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments asset_bytes p
