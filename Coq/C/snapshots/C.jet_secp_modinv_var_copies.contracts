          @ex Clight.env
            (fun e : Clight.env =>
             @ex Clight.temp_env
               (fun le : Clight.temp_env =>
                @ex Memory.Mem.mem
                  (fun mi : Memory.Mem.mem =>
                   @ex Clight.temp_env
                     (fun lef : Clight.temp_env =>
                      @ex Memory.Mem.mem
                        (fun mf : Memory.Mem.mem =>
                         and
                           (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_modinv64_var
                              (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta))
                                 jet_secp_modinv_var_entry.inv_start_args) m e le mi)
                           (and
                              (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le mi inv_ready_prefix
                                 Events.E0 lef mf ClightBigstep.Out_normal)
                              (and
                                 (jet_sx_state.rep rho (@app (prod Values.block BinNums.Z) beta betaN) inv_fg_regs mf)
                                 (and
                                    (jet_sx_eval.tmatch rho (@app (prod Values.block BinNums.Z) beta betaN)
                                       inv_loop_start_temps lef)
                                    (and
                                       (jet_sx_eval.ematch (@app (prod Values.block BinNums.Z) beta betaN)
                                          (@snd (list jet_sx_state.region) jet_sx_eval.venv
                                             jet_secp_modinv_var_entry.inv_start_alloc) e)
                                       (and
                                          (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len lef)
                                             (@Some Values.val
                                                (Values.Vint
                                                   (Integers.Int.repr
                                                      (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                          (and
                                             (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._eta lef)
                                                (@Some Values.val
                                                   (Values.Vlong (Integers.Int64.repr (BinNums.Zneg BinNums.xH)))))
                                             (and
                                                (@List.Forall (prod Values.block BinNums.Z)
                                                   (fun p : prod Values.block BinNums.Z =>
                                                    not (Memory.Mem.valid_block m (@fst Values.block BinNums.Z p)))
                                                   betaN)
                                                (jet_sx_mem.lframe
                                                   (fun (b : Values.block) (ofs : BinNums.Z) =>
                                                    not
                                                      (jet_sx_state.foot
                                                         (@app (prod Values.block BinNums.Z) beta betaN)
                                                         (@List.map jet_sx_state.region
                                                            (prod (prod ... bool) (option BinNums.Z))
                                                            jet_sx_state.rshape
                                                            (jet_sx_eval.sregs
                                                               jet_secp_modinv_var_entry.inv_start_state)) b ofs)) m mf))))))))))))))
### C.jet_secp_modinv_var_copies.inv_modulus_exprs
inv_modulus_exprs =
@List.map Integers.Int64.int jet_sx_expr.sx jet_sx_expr.XLc
  (@List.firstn Integers.Int64.int (S (S (S (S (S O))))) jet_secp_modinfo_fe_global.modinfo_fe_words)
     : list jet_sx_expr.sx
### C.jet_secp_modinv_var_copies.inv_input_exprs
inv_input_exprs =
@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O))))
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O))))) (@nil jet_sx_expr.sx)))))
     : list jet_sx_expr.sx
### C.jet_secp_modinv_var_copies.inv_f_regs
inv_f_regs =
@jet_sx_state.upd jet_sx_state.region (jet_sx_eval.sregs jet_secp_modinv_var_entry.inv_init_state)
  (S (S (S (S O))))
  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 inv_modulus_exprs) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     : list jet_sx_state.region
### C.jet_secp_modinv_var_copies.inv_fg_regs
inv_fg_regs =
@jet_sx_state.upd jet_sx_state.region inv_f_regs (S (S (S (S (S O)))))
  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 inv_input_exprs) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     : list jet_sx_state.region
### C.jet_secp_modinv_var_copies.inv_copy_regs
inv_copy_regs =
fun g : bool =>
match g return (list jet_sx_state.region) with
| true => inv_f_regs
| false => jet_sx_eval.sregs jet_secp_modinv_var_entry.inv_init_state
end
     : forall _ : bool, list jet_sx_state.region

Arguments inv_copy_regs g%bool_scope
### C.jet_secp_modinv_var_copies.inv_copy_words
inv_copy_words =
fun (rho : forall _ : nat, Integers.Int64.int) (g : bool) (i : nat) =>
match g return Integers.Int64.int with
| true => rho i
| false => jet_secp_modinfo_fe_copy.modinfo_fe_limb i
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool) (_ : nat), Integers.Int64.int

Arguments inv_copy_words rho%function_scope g%bool_scope i%nat_scope
### C.jet_secp_modinv_var_copies.inv_copy_expr
inv_copy_expr =
fun (g : bool) (i : nat) =>
match g return jet_sx_expr.sx with
| true => jet_sx_expr.XLv i
| false => jet_sx_expr.XLc (jet_secp_modinfo_fe_copy.modinfo_fe_limb i)
end
     : forall (_ : bool) (_ : nat), jet_sx_expr.sx

Arguments inv_copy_expr g%bool_scope i%nat_scope
### C.jet_secp_modinv_var_copies.inv_copy_exprs
inv_copy_exprs =
fun g : bool => match g return (list jet_sx_expr.sx) with
                | true => inv_input_exprs
                | false => inv_modulus_exprs
                end
     : forall _ : bool, list jet_sx_expr.sx

Arguments inv_copy_exprs g%bool_scope
### C.jet_secp_modinv_var_copies.inv_copy_target
inv_copy_target =
fun g : bool => match g return nat with
                | true => S (S (S (S (S O))))
                | false => S (S (S (S O)))
                end
     : forall _ : bool, nat

Arguments inv_copy_target g%bool_scope
### C.jet_secp_modinv_var_copies.inv_copy_source
inv_copy_source = fun g : bool => match g return nat with
                                  | true => O
                                  | false => S O
                                  end
     : forall _ : bool, nat

Arguments inv_copy_source g%bool_scope
### C.jet_secp_modinv_var_copies.inv_copy_stmt
inv_copy_stmt =
fun g : bool =>
@List.nth Clight.statement
  match g return nat with
  | true => S (S (S (S (S (S (S (S (S (S (S O))))))))))
  | false => S (S (S (S (S (S (S (S (S (S O)))))))))
  end (@fst (list Clight.statement) Clight.statement jet_secp_modinv_var_entry.inv_start_parts) Clight.Sskip
     : forall _ : bool, Clight.statement

Arguments inv_copy_stmt g%bool_scope
### C.jet_secp_modinv_var_copies.inv_copies
inv_copies =
Clight.Ssequence (inv_copy_stmt false) (Clight.Ssequence (inv_copy_stmt true) Clight.Sskip)
     : Clight.statement
### C.jet_secp_modinv_var_copies.inv_copy_local
inv_copy_local =
fun id : AST.ident =>
Clight.Eaddrof (Clight.Evar id jet_secp_modinv_fg_index.fg_s62_type)
  (Ctypesdefs.tptr jet_secp_modinv_fg_index.fg_s62_type)
     : forall _ : AST.ident, Clight.expr

Arguments inv_copy_local id
### C.jet_secp_modinv_var_copies.inv_copy_modulus
inv_copy_modulus =
Clight.Eaddrof
  (Clight.Efield
     (Clight.Ederef
        (Clight.Etempvar jets_secp._modinfo
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._secp256k1_modinv64_modinfo Ctypes.noattr)))
        (Ctypes.Tstruct jets_secp._secp256k1_modinv64_modinfo Ctypes.noattr)) jets_secp._modulus
     jet_secp_modinv_fg_index.fg_s62_type) (Ctypesdefs.tptr jet_secp_modinv_fg_index.fg_s62_type)
     : Clight.expr
### C.jet_secp_modinv_var_copies.inv_copied_prefix
inv_copied_prefix =
jet_secp_statement_prefix.statement_sequence
