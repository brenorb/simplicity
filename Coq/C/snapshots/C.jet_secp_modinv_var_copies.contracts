### C.jet_secp_modinv_var_copies.inv_loop_start_temps
inv_loop_start_temps =
@Maps.PTree.set jet_sx_expr.sx jets_secp._eta (jet_sx_expr.XLc (Integers.Int64.repr (BinNums.Zneg BinNums.xH)))
  (@Maps.PTree.set jet_sx_expr.sx jets_secp._len
