### C.jet_elements_support_sha_read_context_exec.sg_exec_sha256_read_overflow_from_observation
sg_exec_sha256_read_overflow_from_observation
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bc : Values.block) (base : BinNums.Z) (count : Integers.Int64.int)
         (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._sha256_max_counter e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m
                   (jet_elements_support_sha_linkage.sha_symbol_block jets._sha256_max_counter) BinNums.Z0)
                (@Some Values.val
                   (Values.Vlong
                      (Integers.Int64.repr
                         (BinNums.Zpos
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : not (@eq Values.block bc (jet_elements_support_sha_linkage.sha_symbol_block jets._sha256_max_counter)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._compressionCount le)
                (@Some Values.val (Values.Vlong count)))
         (_ : Memory.Mem.valid_access m AST.Mint8unsigned bc
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m
                  jet_read_sha256_overflow.sha256_read_overflow_stmt Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type
                           (Values.Vint
                              (jet_readBit_layout.bit_int (negb (jet_read_sha256_overflow.sha256_read_overflow count))))
                           Ctypesdefs.tint))))
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.store AST.Mint8unsigned m bc
                        (BinInt.Z.add base
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (Values.Vint (jet_readBit_layout.bit_int (jet_read_sha256_overflow.sha256_read_overflow count))))
                     (@Some Memory.Mem.mem mf))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint8unsigned mf bc
                           (BinInt.Z.add base
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                        (@Some Values.val
                           (Values.Vint
                              (jet_readBit_layout.bit_int (jet_read_sha256_overflow.sha256_read_overflow count)))))
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf
                           (jet_elements_support_sha_linkage.sha_symbol_block jets._sha256_max_counter) BinNums.Z0)
                        (@Some Values.val
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))))
