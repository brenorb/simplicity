                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint8unsigned m bc
                   (BinInt.Z.add base
