### C.jet_elements_support_sha_read_context_exec.sg_free_sha256_read_local
sg_free_sha256_read_local
     : forall (m : Memory.Mem.mem) (bl : Values.block)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.free_list m
                  (Clight.blocks_of_env jet_elements_support_sha_linkage.sha_ge
                     (jet_sha256_read_local.sha256_read_env bl))) (@Some Memory.Mem.mem mf))
            (and
               (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                  (_ : not (@eq Values.block b bl)),
                @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
               (and
                  (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                     (_ : not (@eq Values.block b bl)) (_ : Memory.Mem.perm m b ofs kind p),
                   Memory.Mem.perm mf b ofs kind p)
                  (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m)))))
### C.jet_elements_support_sha_read_context_exec.sg_eval_sha256_read_context_from_body
sg_eval_sha256_read_context_from_body
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mb : Memory.Mem.mem) (bl bc : Values.block)
         (cbase : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (le : Clight.temp_env)
         (overflow : bool)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge
                (jet_sha256_read_local.sha256_read_env bl) (jet_sha256_read_local.sha256_read_temps bc cbase bf base)
                ma (Clight.fn_body jets.f_simplicity_read_sha256_context) Events.E0 le mb
                (ClightBigstep.Out_return
                   (@Some (prod Values.val Ctypes.type)
                      (@pair Values.val Ctypes.type (Values.Vint (jet_readBit_layout.bit_int (negb overflow)))
                         Ctypesdefs.tint))))
         (_ : Memory.Mem.range_perm mb bl BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets.f_simplicity_read_sha256_context)
               (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase))
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               (Values.Vint (jet_readBit_layout.bit_int (negb overflow))))
            (and
               (@eq (option Memory.Mem.mem)
                  (Memory.Mem.free_list mb
                     (Clight.blocks_of_env jet_elements_support_sha_linkage.sha_ge
                        (jet_sha256_read_local.sha256_read_env bl))) (@Some Memory.Mem.mem mf))
               (and
                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : not (@eq Values.block b bl)),
                   @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk mb b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                        (p : Memtype.permission) (_ : not (@eq Values.block b bl))
                        (_ : Memory.Mem.perm mb b ofs kind p), Memory.Mem.perm mf b ofs kind p)
                     (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock mb))))))
### C.jet_elements_support_sha_read_context_exec.sg_exec_sha256_read_counter_store
sg_exec_sha256_read_counter_store
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bc : Values.block)
         (base : BinNums.Z) (count len : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._compressionCount le)
                (@Some Values.val (Values.Vlong count)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._t'5 le) (@Some Values.val (Values.Vlong len)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bc
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (Values.Vlong (jet_read_sha256_counter.sha256_read_counter count len)))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m
         (Clight.Sassign
            (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxCounter jets._ctx)
            (Clight.Ebinop Cop.Oadd
               (Clight.Ebinop Cop.Oshl
                  (Clight.Ebinop Cop.Omul (Clight.Etempvar jets._compressionCount Ctypesdefs.tulong)
                     (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tuint)
                     Ctypesdefs.tulong)
                  (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))
                     Ctypesdefs.tint) Ctypesdefs.tulong) (Clight.Etempvar jets._t'5 Ctypesdefs.tulong)
               Ctypesdefs.tulong)) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_elements_support_sha_read_context_exec.sg_exec_sha256_read_overflow_store
