### C.jet_secp_table_coordinate_values.table_fast_scale_value
table_fast_scale_value
     : forall (k : BinNums.Z) (p : list BinNums.Z) (x : BinNums.Z),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_fast_polynomial.fast_polynomial_scale k p) x)
         (BinInt.Z.mul k (jet_secp_polynomial.polynomial_value p x))
### C.jet_secp_table_coordinate_values.table_fast_mul_value
table_fast_mul_value
     : forall (p q : list BinNums.Z) (x : BinNums.Z),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_fast_polynomial.fast_polynomial_mul p q) x)
         (BinInt.Z.mul (jet_secp_polynomial.polynomial_value p x) (jet_secp_polynomial.polynomial_value q x))
### C.jet_secp_table_coordinate_values.table_fast_sub_value
table_fast_sub_value
     : forall (p q : list BinNums.Z) (x : BinNums.Z),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_fast_polynomial.fast_polynomial_sub p q) x)
         (BinInt.Z.sub (jet_secp_polynomial.polynomial_value p x) (jet_secp_polynomial.polynomial_value q x))
### C.jet_secp_table_coordinate_values.table_witness_sq_value
table_witness_sq_value
     : forall (p : list BinNums.Z) (x : BinNums.Z),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_sq p) x)
         (BinInt.Z.mul (jet_secp_polynomial.polynomial_value p x) (jet_secp_polynomial.polynomial_value p x))
### C.jet_secp_table_coordinate_values.table_witness_cube_value
table_witness_cube_value
     : forall (p : list BinNums.Z) (x : BinNums.Z),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_cube p) x)
         (BinInt.Z.mul
            (BinInt.Z.mul (jet_secp_polynomial.polynomial_value p x) (jet_secp_polynomial.polynomial_value p x))
            (jet_secp_polynomial.polynomial_value p x))
### C.jet_secp_table_coordinate_values.table_witness_h_value
table_witness_h_value
     : forall (n : nat) (x : BinNums.Z),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_h n) x)
         (jet_secp_table_scaled_step.table_numeric_h
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_x n) x)
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_d n) x)
            (jet_secp_polynomial.polynomial_value jet_secp_table_coordinates.table_witness_bx x))
### C.jet_secp_table_coordinate_values.table_witness_i_value
table_witness_i_value
     : forall (n : nat) (x : BinNums.Z),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_i n) x)
         (jet_secp_table_scaled_step.table_numeric_i
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_y n) x)
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_d n) x)
            (jet_secp_polynomial.polynomial_value jet_secp_table_coordinates.table_witness_by x))
### C.jet_secp_table_coordinate_values.table_witness_next_x_value
table_witness_next_x_value
     : forall (n : nat) (x : BinNums.Z),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_next_x n) x)
         (jet_secp_table_scaled_step.table_numeric_next_x
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_x n) x)
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_h n) x)
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_i n) x))
### C.jet_secp_table_coordinate_values.table_fast_mul_residue
table_fast_mul_residue
     : forall (p q : list BinNums.Z) (x a b : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_polynomial.polynomial_value p x) a)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_polynomial.polynomial_value q x) b),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_fast_polynomial.fast_polynomial_mul p q) x)
         (BinInt.Z.mul a b)
### C.jet_secp_table_coordinate_values.table_fast_sub_residue
table_fast_sub_residue
     : forall (p q : list BinNums.Z) (x a b : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_polynomial.polynomial_value p x) a)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_polynomial.polynomial_value q x) b),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_fast_polynomial.fast_polynomial_sub p q) x)
         (BinInt.Z.sub a b)
### C.jet_secp_table_coordinate_values.table_fast_scale_residue
table_fast_scale_residue
     : forall (k : BinNums.Z) (p : list BinNums.Z) (x a : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_polynomial.polynomial_value p x) a),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_fast_polynomial.fast_polynomial_scale k p) x)
         (BinInt.Z.mul k a)
### C.jet_secp_table_coordinate_values.table_witness_next_y_value
table_witness_next_y_value
     : forall (n : nat) (x : BinNums.Z),
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_next_y n) x)
         (jet_secp_table_scaled_step.table_numeric_next_y
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_x n) x)
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_y n) x)
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_h n) x)
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_i n) x))
### C.jet_secp_table_coordinate_values.table_polynomial_one_value
table_polynomial_one_value
     : forall x : BinNums.Z,
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value (@cons BinNums.Z (BinNums.Zpos BinNums.xH) (@nil BinNums.Z)) x)
         (BinNums.Zpos BinNums.xH)
### C.jet_secp_table_coordinate_values.table_polynomial_x_value
table_polynomial_x_value
     : forall x : BinNums.Z,
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value
            (@cons BinNums.Z BinNums.Z0 (@cons BinNums.Z (BinNums.Zpos BinNums.xH) (@nil BinNums.Z))) x) x
### C.jet_secp_table_coordinate_values.table_polynomial_xx_value
table_polynomial_xx_value
     : forall x : BinNums.Z,
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value
            (@cons BinNums.Z BinNums.Z0
               (@cons BinNums.Z BinNums.Z0 (@cons BinNums.Z (BinNums.Zpos BinNums.xH) (@nil BinNums.Z)))) x)
         (BinInt.Z.mul x x)
### C.jet_secp_table_coordinate_values.table_witness_s_value
table_witness_s_value
     : forall x : BinNums.Z,
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value jet_secp_table_coordinates.table_witness_s x)
         (jet_secp_table_affine_seed.table_curve_s x)
### C.jet_secp_table_coordinate_values.table_witness_slope_value
table_witness_slope_value
     : forall x : BinNums.Z,
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value jet_secp_table_coordinates.table_witness_slope x)
         (jet_secp_table_affine_seed.table_double_slope x)
### C.jet_secp_table_coordinate_values.table_witness_bx_value
table_witness_bx_value
     : forall x : BinNums.Z,
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value jet_secp_table_coordinates.table_witness_bx x)
         (jet_secp_table_affine_seed.table_double_x x)
### C.jet_secp_table_coordinate_values.table_witness_by_value
table_witness_by_value
     : forall x : BinNums.Z,
       Zdiv.eqm jet_secp_fe_math.feP
         (jet_secp_polynomial.polynomial_value jet_secp_table_coordinates.table_witness_by x)
         (jet_secp_table_affine_seed.table_double_y x)
### C.jet_secp_table_coordinate_values.table_witness_seed_values
table_witness_seed_values
     : forall x : BinNums.Z,
       and
         (Zdiv.eqm jet_secp_fe_math.feP
            (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_x (S O)) x)
            (BinInt.Z.mul x (jet_secp_table_affine_seed.table_curve_s x)))
         (and
            (Zdiv.eqm jet_secp_fe_math.feP
               (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_y (S O)) x)
               (BinInt.Z.mul (jet_secp_table_affine_seed.table_curve_s x) (jet_secp_table_affine_seed.table_curve_s x)))
            (Zdiv.eqm jet_secp_fe_math.feP
               (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_d (S O)) x)
               (BinNums.Zpos BinNums.xH)))
### C.jet_secp_table_coordinate_values.table_numeric_next_x_respects
table_numeric_next_x_respects
     : forall (x h i hh ii : BinNums.Z) (_ : Zdiv.eqm jet_secp_fe_math.feP h hh)
         (_ : Zdiv.eqm jet_secp_fe_math.feP i ii),
       Zdiv.eqm jet_secp_fe_math.feP (jet_secp_table_scaled_step.table_numeric_next_x x h i)
         (jet_secp_table_scaled_step.table_numeric_next_x x hh ii)
### C.jet_secp_table_coordinate_values.table_numeric_next_y_respects
table_numeric_next_y_respects
     : forall (x y h i hh ii : BinNums.Z) (_ : Zdiv.eqm jet_secp_fe_math.feP h hh)
         (_ : Zdiv.eqm jet_secp_fe_math.feP i ii),
       Zdiv.eqm jet_secp_fe_math.feP (jet_secp_table_scaled_step.table_numeric_next_y x y h i)
         (jet_secp_table_scaled_step.table_numeric_next_y x y hh ii)
### C.jet_secp_table_coordinate_values.table_witness_step_values
table_witness_step_values
     : forall (n : nat) (x : BinNums.Z)
         (_ : @eq (prod (prod (prod (list BinNums.Z) (list BinNums.Z)) (list BinNums.Z)) (list BinNums.Z))
                (jet_secp_table_coordinates.table_witness_step n)
                (jet_secp_table_coordinates.table_witness_scaled_next n)),
       let px : BinNums.Z := jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_x n) x in
       let py : BinNums.Z := jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_y n) x in
       let pz : BinNums.Z := jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_d n) x in
       let h : BinNums.Z :=
         jet_secp_table_scaled_step.table_numeric_h px pz
           (jet_secp_polynomial.polynomial_value jet_secp_table_coordinates.table_witness_bx x) in
       let i : BinNums.Z :=
         jet_secp_table_scaled_step.table_numeric_i py pz
           (jet_secp_polynomial.polynomial_value jet_secp_table_coordinates.table_witness_by x) in
       let f : BinNums.Z := jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_f n) x in
       and
         (Zdiv.eqm jet_secp_fe_math.feP (jet_secp_table_scaled_step.table_numeric_next_x px h i)
            (BinInt.Z.mul (BinInt.Z.mul f f)
               (jet_secp_polynomial.polynomial_value (jet_secp_table_coordinates.table_witness_x (Nat.add n (S (S O))))
                  x)))
         (and
            (Zdiv.eqm jet_secp_fe_math.feP (jet_secp_table_scaled_step.table_numeric_next_y px py h i)
               (BinInt.Z.mul (BinInt.Z.mul (BinInt.Z.mul f f) f)
                  (jet_secp_polynomial.polynomial_value
                     (jet_secp_table_coordinates.table_witness_y (Nat.add n (S (S O)))) x)))
            (Zdiv.eqm jet_secp_fe_math.feP (BinInt.Z.mul pz h)
               (BinInt.Z.mul f
                  (jet_secp_polynomial.polynomial_value
                     (jet_secp_table_coordinates.table_witness_d (Nat.add n (S (S O)))) x))))
