### C.jet_secp_root_function.eval_root_function
eval_root_function
     : forall (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (m : Memory.Mem.mem) (br ba : Values.block) (_ : not (@eq Values.block ba br))
         (_ : jet_secp_root_chain_numeric.root_words_match w x)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqrt_var)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               (Values.Vint
                  match jet_secp_root_check.root_check_flag w return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (and
               (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_root_chain_numeric.root_chain_candidate w)))
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf br BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (_ : BinNums.Z) =>
                         and (not (@eq Values.block b ba)) (not (@eq Values.block b br))) m mf)))))
### C.jet_secp_root_function.root_helper_env
root_helper_env =
fun b2 b3 b6 b9 b11 b22 b44 b88 b176 b220 b223 bt : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._t1
  (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x223
     (@pair Values.block Ctypes.type b223 jet_secp_curve_statements.curve_fe_type)
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x220
        (@pair Values.block Ctypes.type b220 jet_secp_curve_statements.curve_fe_type)
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x176
           (@pair Values.block Ctypes.type b176 jet_secp_curve_statements.curve_fe_type)
           (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x88
              (@pair Values.block Ctypes.type b88 jet_secp_curve_statements.curve_fe_type)
              (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x44
                 (@pair Values.block Ctypes.type b44 jet_secp_curve_statements.curve_fe_type)
                 (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x22
                    (@pair Values.block Ctypes.type b22 jet_secp_curve_statements.curve_fe_type)
                    (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x11
                       (@pair Values.block Ctypes.type b11 jet_secp_curve_statements.curve_fe_type)
                       (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x9
                          (@pair Values.block Ctypes.type b9 jet_secp_curve_statements.curve_fe_type)
                          (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x6
                             (@pair Values.block Ctypes.type b6 jet_secp_curve_statements.curve_fe_type)
                             (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x3
                                (@pair Values.block Ctypes.type b3 jet_secp_curve_statements.curve_fe_type)
                                (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._x2
                                   (@pair Values.block Ctypes.type b2 jet_secp_curve_statements.curve_fe_type)
                                   Clight.empty_env)))))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

