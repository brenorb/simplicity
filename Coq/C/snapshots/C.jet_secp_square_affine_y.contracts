### C.jet_secp_square_affine_y.affine_y_square_completes
affine_y_square_completes
     : @eq bool
         match affine_y_square_run return bool with
         | Some r =>
             match r return bool with
             | jet_sx_exec.RDone _ o =>
                 match o return bool with
                 | jet_sx_exec.ONormal => true
                 | jet_sx_exec.OBreak => false
                 | jet_sx_exec.OContinue => false
                 | jet_sx_exec.OReturn _ => false
                 end
             | jet_sx_exec.RIf _ _ _ => false
             end
         | None => false
         end true
### C.jet_secp_square_affine_y.affine_y_square_run_eq
affine_y_square_run_eq
     : @eq (option jet_sx_exec.res) affine_y_square_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone affine_y_square_state jet_sx_exec.ONormal))
### C.jet_secp_square_affine_y.affine_y_square_return
affine_y_square_return
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps affine_y_square_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_square_affine_y.affine_y_square_tail
affine_y_square_tail
     : @eq (list jet_sx_state.region) (@List.tl jet_sx_state.region (jet_sx_eval.sregs affine_y_square_state))
         (@cons jet_sx_state.region affine_y_square_input (@nil jet_sx_state.region))
### C.jet_secp_square_affine_y.affine_y_square_shape
affine_y_square_shape
     : @eq (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
         (jet_sx_state.rshape affine_y_square_out)
         (@pair (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)
            (@pair (list (prod BinNums.Z AST.memory_chunk)) bool
               (@cons (prod BinNums.Z AST.memory_chunk)
                  (@pair BinNums.Z AST.memory_chunk
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     AST.Mint64)
                  (@cons (prod BinNums.Z AST.memory_chunk)
                     (@pair BinNums.Z AST.memory_chunk
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
                        AST.Mint64)
                     (@cons (prod BinNums.Z AST.memory_chunk)
                        (@pair BinNums.Z AST.memory_chunk
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))
                           AST.Mint64)
                        (@cons (prod BinNums.Z AST.memory_chunk)
                           (@pair BinNums.Z AST.memory_chunk
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              AST.Mint64)
                           (@cons (prod BinNums.Z AST.memory_chunk)
                              (@pair BinNums.Z AST.memory_chunk
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                 AST.Mint64) (@nil (prod BinNums.Z AST.memory_chunk))))))) true)
            (@Some BinNums.Z
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_square_affine_y.affine_y_square_defined
affine_y_square_defined
     : @eq bool (jet_secp_multiply_run_run.field_cells_defined (jet_sx_state.rcells affine_y_square_out)) true
### C.jet_secp_square_affine_y.affine_y_square_rebuild
affine_y_square_rebuild
     : @eq jet_sx_state.region affine_y_square_out
         (jet_sx_state.mkreg
            (jet_sx_rep.u64_cells
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
               affine_y_square_limbs) true
            (@Some BinNums.Z
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_square_affine_y.affine_y_square_limb0
affine_y_square_limb0
     : @eq jet_sx_expr.sx (@List.nth jet_sx_expr.sx O affine_y_square_limbs (jet_sx_expr.XLv O))
         (@List.nth jet_sx_expr.sx O jet_secp_square_execution.square_limbs (jet_sx_expr.XLv O))
### C.jet_secp_square_affine_y.affine_y_square_limb1
affine_y_square_limb1
     : @eq jet_sx_expr.sx (@List.nth jet_sx_expr.sx (S O) affine_y_square_limbs (jet_sx_expr.XLv O))
         (@List.nth jet_sx_expr.sx (S O) jet_secp_square_execution.square_limbs (jet_sx_expr.XLv O))
### C.jet_secp_square_affine_y.affine_y_square_limb2
affine_y_square_limb2
     : @eq jet_sx_expr.sx (@List.nth jet_sx_expr.sx (S (S O)) affine_y_square_limbs (jet_sx_expr.XLv O))
         (@List.nth jet_sx_expr.sx (S (S O)) jet_secp_square_execution.square_limbs (jet_sx_expr.XLv O))
### C.jet_secp_square_affine_y.affine_y_square_limb3
affine_y_square_limb3
     : @eq jet_sx_expr.sx (@List.nth jet_sx_expr.sx (S (S (S O))) affine_y_square_limbs (jet_sx_expr.XLv O))
         (@List.nth jet_sx_expr.sx (S (S (S O))) jet_secp_square_execution.square_limbs (jet_sx_expr.XLv O))
### C.jet_secp_square_affine_y.affine_y_square_limb4
affine_y_square_limb4
     : @eq jet_sx_expr.sx (@List.nth jet_sx_expr.sx (S (S (S (S O)))) affine_y_square_limbs (jet_sx_expr.XLv O))
         (@List.nth jet_sx_expr.sx (S (S (S (S O)))) jet_secp_square_execution.square_limbs (jet_sx_expr.XLv O))
### C.jet_secp_square_affine_y.affine_y_square_limbs_equal
affine_y_square_limbs_equal
     : @eq (list jet_sx_expr.sx) affine_y_square_limbs jet_secp_square_execution.square_limbs
### C.jet_secp_square_affine_y.affine_y_square_output
affine_y_square_output
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs affine_y_square_state)
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg
               (jet_sx_rep.u64_cells
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  jet_secp_square_execution.square_limbs) true
               (@Some BinNums.Z
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
            (@cons jet_sx_state.region affine_y_square_input (@nil jet_sx_state.region)))
### C.jet_secp_square_affine_y.eval_square_affine_y_symbolic
eval_square_affine_y_symbolic
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout affine_y_square_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O)
                     (Integers.Ptrofs.repr
                        (BinInt.Z.add (jet_sx_state.bas layout O)
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout (S O))
                        (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_sx_state.rep rho layout
                  (@cons jet_sx_state.region
                     (jet_sx_state.mkreg
                        (jet_sx_rep.u64_cells
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           jet_secp_square_execution.square_limbs) true
                        (@Some BinNums.Z
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                     (@cons jet_sx_state.region affine_y_square_input (@nil jet_sx_state.region))) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape affine_y_square_regs) b ofs)) m mf)))
### C.jet_secp_square_affine_y.affine_y_square_input
affine_y_square_input =
jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 O)) true
  (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
     : jet_sx_state.region
### C.jet_secp_square_affine_y.affine_y_square_regs
affine_y_square_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (@List.map BinNums.Z jet_sx_state.cell
        (fun ofs : BinNums.Z => jet_sx_state.mkcell ofs AST.Mint64 (@None jet_sx_expr.sx))
        (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
           (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
              (@cons BinNums.Z
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))
                 (@cons BinNums.Z
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                    (@cons BinNums.Z
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                       (@nil BinNums.Z))))))) true
     (@Some BinNums.Z
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
  (@cons jet_sx_state.region affine_y_square_input (@nil jet_sx_state.region))
     : list jet_sx_state.region
### C.jet_secp_square_affine_y.affine_y_square_args
affine_y_square_args =
@cons jet_sx_expr.sx
  (jet_sx_expr.XP O (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
  (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx))
     : list jet_sx_expr.sx
### C.jet_secp_square_affine_y.affine_y_square_run
affine_y_square_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_multiply_run_run.field_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_sqr affine_y_square_args affine_y_square_regs (@nil jet_sx_eval.event)
  (S (S (S (S (S O)))))
     : option jet_sx_exec.res
### C.jet_secp_square_affine_y.affine_y_square_state
affine_y_square_state =
match affine_y_square_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_square_affine_y.affine_y_square_out
affine_y_square_out =
@List.hd jet_sx_state.region (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))
  (jet_sx_eval.sregs affine_y_square_state)
     : jet_sx_state.region
### C.jet_secp_square_affine_y.affine_y_square_limbs
affine_y_square_limbs =
@List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_multiply_run_run.field_cell_value
  (jet_sx_state.rcells affine_y_square_out)
     : list jet_sx_expr.sx
