### C.jet_outpoint_exec_shape.op_body
op_body
     : @eq Clight.statement (Clight.fn_body jets_elements.f_simplicity_outpoint_hash)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_elements._src jet_nonce_context_shape.nc_fr)
               (Clight.Etempvar jets_elements._src jet_nonce_context_shape.nc_fr))
            (jet_elements_support_sha_add_n_init.an_init
               (Clight.Ssequence jet_nonce_context_shape.nc_context_read
                  (Clight.Ssequence op_pegin
                     (Clight.Ssequence
                        (op_read
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        (Clight.Ssequence
                           (op_absorb
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                           op_write))))))
### C.jet_outpoint_exec_shape.op_input_bits
op_input_bits
     : @eq nat (Translate.bitSize op_input_type)
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))))
### C.jet_outpoint_exec_shape.op_blocks
op_blocks
     : forall bl bm bb bx : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_linkage.elements_ge (op_env bl bm bb bx))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bm BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bb BinNums.Z0)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))
### C.jet_outpoint_exec_shape.op_entry
op_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 : Memory.Mem.mem') (bl bm bb bx bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bm))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 bb))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m4 bx)),
       Clight.function_entry2 jet_elements_linkage.elements_ge jets_elements.f_simplicity_outpoint_hash
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (op_env bl bm bb bx) (op_temps env bd dbase bs sbase) m4
### C.jet_outpoint_exec_shape.op_input_type
op_input_type =
Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
     : Ty.Ty
### C.jet_outpoint_exec_shape.op_read
op_read =
fun n : BinNums.Z =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._read8s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar)
           (Ctypes.Tcons Ctypesdefs.tulong
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Evar jets_elements._buf
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr n) Ctypesdefs.tint)
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_elements._src jet_nonce_context_shape.nc_fr)
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) (@nil Clight.expr))))
     : forall _ : BinNums.Z, Clight.statement

Arguments op_read n%Z_scope
### C.jet_outpoint_exec_shape.op_absorb
op_absorb =
fun n : BinNums.Z =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._sha256_uchars
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Evar jets_elements._buf
           (Ctypesdefs.tarray Ctypesdefs.tuchar
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
        (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr n) Ctypesdefs.tint) (@nil Clight.expr))))
     : forall _ : BinNums.Z, Clight.statement

Arguments op_absorb n%Z_scope
### C.jet_outpoint_exec_shape.op_skip
op_skip =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._forwardBits
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._src jet_nonce_context_shape.nc_fr)
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Econst_int
           (Integers.Int.repr
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
           Ctypesdefs.tint) (@nil Clight.expr)))
     : Clight.statement
### C.jet_outpoint_exec_shape.op_pegin
op_pegin =
Clight.Ssequence (jet_nonce_context_shape.nc_readbit jets_elements._t'2)
  (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'2 Ctypesdefs.tbool)
     (Clight.Ssequence
        (op_read (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
        (Clight.Ssequence (jet_nonce_context_shape.nc_uchar (BinNums.Zpos BinNums.xH))
           (op_absorb (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     (Clight.Ssequence (jet_nonce_context_shape.nc_uchar BinNums.Z0) op_skip))
     : Clight.statement
### C.jet_outpoint_exec_shape.op_write
op_write =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_elements._t'3)
     (Clight.Evar jets_elements._simplicity_write_sha256_context
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof
              (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
           (@nil Clight.expr))))
  (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_elements._t'3 Ctypesdefs.tbool)))
     : Clight.statement
### C.jet_outpoint_exec_shape.op_env
op_env =
fun bl bm bb bx : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._ctx
  (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._buf
     (@pair Values.block Ctypes.type bb
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._midstate
        (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._src
           (@pair Values.block Ctypes.type bl jet_nonce_context_shape.nc_fr) Clight.empty_env)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments op_env bl bm bb bx
### C.jet_outpoint_exec_shape.op_temps
op_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_elements._env env
  (@Maps.PTree.set Values.val jets_elements._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_elements._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_simplicity_outpoint_hash))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments op_temps env bd dbase%Z_scope bs sbase%Z_scope
