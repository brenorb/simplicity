### C.jet_bitcoin_frame_access.bitcoin_frame_fields_checked
bitcoin_frame_fields_checked
     : match
         @Maps.PTree.get Ctypes.composite jets_bitcoin._frameItem (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge)
         return Prop
       with
       | Some co =>
           and
             (@eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
                (Ctypes.field_offset (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) jets_bitcoin._edge
                   (Ctypes.co_members co))
                (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield BinNums.Z0 Ctypes.Full)))
             (@eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
                (Ctypes.field_offset (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) jets_bitcoin._offset
                   (Ctypes.co_members co))
                (@Errors.OK (prod BinNums.Z Ctypes.bitfield)
                   (@pair BinNums.Z Ctypes.bitfield (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      Ctypes.Full)))
       | None => False
       end
### C.jet_bitcoin_frame_access.eval_bitcoin_frame_edge_at
eval_bitcoin_frame_edge_at
     : forall (m : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (bf : Values.block) (base : BinNums.Z)
         (bw : Values.block) (edge : Integers.Ptrofs.int) (_ : jet_frame_layout.frame_base_valid base)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._frame le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bf base) (@Some Values.val (Values.Vptr bw edge))),
       Clight.eval_expr jet_bitcoin_linkage.bitcoin_ge Clight.empty_env le m
         (Clight.Efield
            (Clight.Ederef
               (Clight.Etempvar jets_bitcoin._frame
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
               (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)) jets_bitcoin._edge
            (Ctypesdefs.tptr Ctypesdefs.tulong)) (Values.Vptr bw edge)
### C.jet_bitcoin_frame_access.eval_bitcoin_frame_offset_lvalue_at
eval_bitcoin_frame_offset_lvalue_at
     : forall (m : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (bf : Values.block) (base : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._frame le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)))),
       Clight.eval_lvalue jet_bitcoin_linkage.bitcoin_ge Clight.empty_env le m
         (Clight.Efield
            (Clight.Ederef
               (Clight.Etempvar jets_bitcoin._frame
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
               (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)) jets_bitcoin._offset Ctypesdefs.tulong) bf
         (Integers.Ptrofs.add (Integers.Ptrofs.repr base)
            (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Ctypes.Full
### C.jet_bitcoin_frame_access.eval_bitcoin_frame_offset_at
eval_bitcoin_frame_offset_at
     : forall (m : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (bf : Values.block) (base : BinNums.Z)
         (n : Integers.Int64.int) (_ : jet_frame_layout.frame_base_valid base)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._frame le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bf
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong n))),
       Clight.eval_expr jet_bitcoin_linkage.bitcoin_ge Clight.empty_env le m
         (Clight.Efield
            (Clight.Ederef
               (Clight.Etempvar jets_bitcoin._frame
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
               (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)) jets_bitcoin._offset Ctypesdefs.tulong)
         (Values.Vlong n)
### C.jet_bitcoin_frame_access.assign_bitcoin_frame_offset_at
assign_bitcoin_frame_offset_at
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (n : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid base)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bf
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (Values.Vlong n)) (@Some Memory.Mem.mem mf)),
       Clight.assign_loc (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) Ctypesdefs.tulong m bf
         (Integers.Ptrofs.add (Integers.Ptrofs.repr base)
            (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Ctypes.Full
         (Values.Vlong n) mf
### C.jet_bitcoin_frame_access.assign_bitcoin_frame_word_at
assign_bitcoin_frame_word_at
     : forall (m mf : Memory.Mem.mem) (bw : Values.block) (ofs : Integers.Ptrofs.int) (w : Integers.Int64.int)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned ofs) (Values.Vlong w))
                (@Some Memory.Mem.mem mf)),
       Clight.assign_loc (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) Ctypesdefs.tulong m bw ofs Ctypes.Full
         (Values.Vlong w) mf
