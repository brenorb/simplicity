     : forall (t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (w a b c : forall _ : nat, Integers.Int64.int) (_ : jet_secp_root_chain_numeric.root_words_match w t)
         (_ : jet_secp_square_columns.square_input_bounds a) (_ : jet_secp_square_columns.square_input_bounds b)
         (_ : jet_secp_square_columns.square_input_bounds c)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_multiply_finish_product.radix_value a)
                (jet_secp_swu_candidates.swu_c_candidate1 (jet_secp_multiply_finish_product.radix_value w)))
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_multiply_finish_product.radix_value b)
                (jet_secp_swu_candidates.swu_c_candidate2 (jet_secp_multiply_finish_product.radix_value w)))
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_multiply_finish_product.radix_value c)
