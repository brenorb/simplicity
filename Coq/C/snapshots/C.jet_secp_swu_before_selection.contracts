### C.jet_secp_swu_before_selection.swu_through_roots_source
swu_through_roots_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_shallue_van_de_woestijne)
         (jet_secp_statement_prefix.statement_sequence swu_through_roots_statements jet_secp_swu_roots.swu_after_roots)
### C.jet_secp_swu_before_selection.swu_nodup_app_apart
