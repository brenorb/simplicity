### C.jet_bitcoin_build_tapbranch_jet.btb_blocks
btb_blocks
     : forall bl ba bb brs brr : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_sha_linkage.sha_ge (btb_env bl ba bb brs brr))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z ba BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z brr BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bb BinNums.Z0)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                        (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z brs BinNums.Z0)
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))
### C.jet_bitcoin_build_tapbranch_jet.btb_entry
btb_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 m5 : Memory.Mem.mem')
         (bl ba bb brs brr bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 ba))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 bb))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m4 brs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m4 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m5 brr)),
       Clight.function_entry2 jet_sha_linkage.sha_ge jets_sha.f_simplicity_bitcoin_build_tapbranch
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (btb_env bl ba bb brs brr) (btb_temps env bd dbase bs sbase) m5
### C.jet_bitcoin_build_tapbranch_jet.btb_copy
btb_copy
     : forall (m mc : Memory.Mem.mem) (bl ba bb brs brr bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge (btb_env bl ba bb brs brr) le m
         (Clight.Sassign (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
### C.jet_bitcoin_build_tapbranch_jet.btb_make_symbol
btb_make_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_sha_linkage.sha_ge)
            jets_sha._simplicity_bitcoin_make_tapbranch)
         (@Some Values.block (jet_sha_linkage.sha_symbol_block jets_sha._simplicity_bitcoin_make_tapbranch))
### C.jet_bitcoin_build_tapbranch_jet.btb_make_funct
btb_make_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_sha_linkage.sha_ge)
            (Values.Vptr (jet_sha_linkage.sha_symbol_block jets_sha._simplicity_bitcoin_make_tapbranch)
               Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function)
            (@Ctypes.Internal Clight.function jets_sha.f_simplicity_bitcoin_make_tapbranch))
### C.jet_bitcoin_build_tapbranch_jet.btb_tag_regs
btb_tag_regs
     : @eq (list Integers.Int.int) (jet_sha_tagged_ctx.tag_regs_of jet_bitcoin_make_tapbranch_exec.tapbranch_tag_ints)
         (jet_sha_ctx8_model.state_regs jet_bitcoin_build_tapbranch_spec.tapbranch_tag_word)
### C.jet_bitcoin_build_tapbranch_jet.btb_prefix_regs
btb_prefix_regs
     : @eq (list Integers.Int.int)
         (jet_sha_tagged_ctx.tagged_prefix jet_bitcoin_make_tapbranch_exec.tapbranch_tag_ints)
         (jet_sha_ctx8_model.state_regs jet_bitcoin_build_tapbranch_spec.tapbranch_prefix)
### C.jet_bitcoin_build_tapbranch_jet.build_tapbranch_regs
build_tapbranch_regs
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Integers.Int.int)
         (jet_bitcoin_make_tapbranch_exec.make_tapbranch_regs (jet_sha_ctx8_model.state_regs a)
            (jet_sha_ctx8_model.state_regs b))
         (jet_sha_ctx8_model.state_regs
            (@jet_bitcoin_build_tapbranch_spec.build_tapbranch_spec Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b)))
### C.jet_bitcoin_build_tapbranch_jet.bitcoin_build_tapbranch_local_spec
bitcoin_build_tapbranch_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       jet_sha_tapdata_jet.sha_jet_local_spec_pre sha_tapbranch_pre jets_sha.f_simplicity_bitcoin_build_tapbranch
         (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (fun ab : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) =>
          @jet_bitcoin_build_tapbranch_spec.build_tapbranch_spec Alg.CoreFunSem ab)
### C.jet_bitcoin_build_tapbranch_jet.btb_env
btb_env =
fun bl ba bb brs brr : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha.__res
  (@pair Values.block Ctypes.type brr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._result
     (@pair Values.block Ctypes.type brs (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._b
        (@pair Values.block Ctypes.type bb (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._a
           (@pair Values.block Ctypes.type ba (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
           (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._src
              (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Clight.empty_env))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block),
       Clight.env

Arguments btb_env bl ba bb brs brr
### C.jet_bitcoin_build_tapbranch_jet.btb_temps
btb_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_sha._env env
  (@Maps.PTree.set Values.val jets_sha._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_sha._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_sha.f_simplicity_bitcoin_build_tapbranch))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments btb_temps env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_bitcoin_build_tapbranch_jet.sha_tapbranch_pre
sha_tapbranch_pre =
fun m : Memory.Mem.mem =>
and (jet_sha_add_n_exec.sha_globals_ok m) (jet_bitcoin_make_tapbranch_exec.sha_tapbranch_tag_ok m)
     : forall _ : Memory.Mem.mem, Prop

Arguments sha_tapbranch_pre m
