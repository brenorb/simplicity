### C.jet_bitcoin_indexed_hash_literal.literal_bitcoin_value_script_hash
literal_bitcoin_value_script_hash =
fun
  (pv : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
          (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
  (ph : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
          (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (alg : jet_bitcoin_full_prim.PF.Algebra) =>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@AC.pair (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) alg pv)
     (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg ph))
  (@AC.case Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@AC.injl (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@AC.unit (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core))
     (@AC.injr
        (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@AC.comp
           (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
           (@AC.pair
              (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@AC.comp
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                    (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))) jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 core
                 (@AC.pair
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                    core
                    (@AC.comp
                       (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                          (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
                       jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                       (@AC.unit
                          (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                             (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core)
                       (@jet_sha_hash_words_literal.literal_sha_hash_ctx_init core))
                    (@AC.take (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O)))) core
                       (@AC.iden (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O)))) core)))
                 (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S (S O))) term))
              (@AC.drop (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_bitcoin_input_hash_literal.literal_bitcoin_assert_iden
                    (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)))
           (@AC.comp
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S (S (S (S O))))) term)
              (@jet_sha_finalize_literal.literal_ctx8_finalize term)))))
     : forall
         (_ : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
         (_ : jet_bitcoin_full_prim.BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (alg : jet_bitcoin_full_prim.PF.Algebra),
       jet_bitcoin_full_prim.PF.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

