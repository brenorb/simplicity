### C.jet_secp_pubkey_load_entry.pubkey_load_ok
pubkey_load_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_secp256k1_pubkey_load) true
### C.jet_secp_pubkey_load_entry.pubkey_load_blocks
pubkey_load_blocks
     : forall bs bx b_y : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (pubkey_load_env bs bx b_y))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bs BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z b_y BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))
### C.jet_secp_pubkey_load_entry.pubkey_load_entry_owned
pubkey_load_entry_owned
     : forall (m : Memory.Mem.mem) (out key : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bs : Values.block =>
             @ex Values.block
               (fun bx : Values.block =>
                @ex Values.block
                  (fun b_y : Values.block =>
                   and
                     (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_pubkey_load
                        (@cons Values.val out (@cons Values.val key (@nil Values.val))) m (pubkey_load_env bs bx b_y)
                        (pubkey_load_temps out key) mi)
                     (and
                        (@List.NoDup Values.block
                           (@cons Values.block bs (@cons Values.block bx (@cons Values.block b_y (@nil Values.block)))))
                        (and
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                            not
                              (@List.In Values.block b
                                 (@cons Values.block bs
                                    (@cons Values.block bx (@cons Values.block b_y (@nil Values.block))))))
                           (and
                              (forall (b : Values.block) (hi : BinNums.Z)
                                 (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                                        (@cons (prod Values.block BinNums.Z)
                                           (@pair Values.block BinNums.Z bs
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                           (@cons (prod Values.block BinNums.Z)
                                              (@pair Values.block BinNums.Z bx
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                              (@cons (prod Values.block BinNums.Z)
                                                 (@pair Values.block BinNums.Z b_y
                                                    (BinNums.Zpos
                                                       (BinNums.xO
                                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                                 (@nil (prod Values.block BinNums.Z)))))),
                               Memory.Mem.range_perm mi b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                              (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                                 (and (jet_clight_internal_permissions.keeps_permissions m mi)
                                    (jet_clight_internal_preserve.readonly_preserved m mi))))))))))
