### C.jet_secp_double_half_literal_numeric.double_half_constant
double_half_constant
     : and
         (and
            (BinInt.Z.le BinNums.Z0
               (BinInt.Z.div (BinInt.Z.add jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                  (BinNums.Zpos (BinNums.xO BinNums.xH))))
            (BinInt.Z.lt
               (BinInt.Z.div (BinInt.Z.add jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))
                  (BinNums.Zpos (BinNums.xO BinNums.xH))) jet_secp_fe_math.feP))
         (@eq BinNums.Z
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
