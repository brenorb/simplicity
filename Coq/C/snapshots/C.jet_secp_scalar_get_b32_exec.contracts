### C.jet_secp_scalar_get_b32_exec.scalar_get_run_eq
scalar_get_run_eq
     : @eq (option jet_sx_exec.res) scalar_get_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone scalar_get_state jet_sx_exec.ONormal))
### C.jet_secp_scalar_get_b32_exec.scalar_get_return
scalar_get_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_get_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_scalar_get_b32_exec.eval_scalar_get_b32_from_initial_regions
eval_scalar_get_b32_from_initial_regions
     : forall (m : Memory.Mem.mem) (layout : jet_sx_state.layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : jet_sx_state.rep rho layout scalar_get_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_get_b32)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout (S O))
                        (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and (jet_sx_state.rep rho layout (jet_sx_eval.sregs scalar_get_state) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape scalar_get_regs) b pos)) m mf)))
### C.jet_secp_scalar_get_b32_exec.scalar_get_regs
scalar_get_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_secp_fe_b32.byte_undef BinNums.Z0
        (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))) true
     (@None BinNums.Z))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (jet_sx_rep.u64_cells BinNums.Z0
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx)))))) false
        (@None BinNums.Z)) (@nil jet_sx_state.region))
     : list jet_sx_state.region
### C.jet_secp_scalar_get_b32_exec.scalar_get_run
scalar_get_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_scalar_get_b32
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
     (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx))) scalar_get_regs
  (@nil jet_sx_eval.event) (S (S (S (S O))))
     : option jet_sx_exec.res
