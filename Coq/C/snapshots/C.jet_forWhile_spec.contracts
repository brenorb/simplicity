                           end) (Ty.Sum Ty.Unit Ty.Unit) k)) A A alg (@Alg.Core.Combinators.iden A alg))) body0))
  end body
     : forall (n : nat) (C B A : Ty.Ty) (alg : Alg.Core.Algebra)
         (_ : Alg.Core.domain alg (Ty.Prod (Ty.Prod C (Word.Word n)) A) (Ty.Sum B A)),
       Alg.Core.domain alg (Ty.Prod C A) (Ty.Sum B A)

Arguments for_while_program n%nat_scope {C B A}%ty_scope {alg} body
### C.jet_forWhile_spec.for_while_run
for_while_run =
fix for_while_run
  (n : nat) (C B A : Ty.Ty)
  (body : forall _ : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word n)) A), option (Ty.tySem (Ty.Sum B A)))
  (context : Ty.tySem C) (state : Ty.tySem A) {struct n} : option (Ty.tySem (Ty.Sum B A)) :=
  match
    n as k
    return
      (forall _ : forall _ : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word k)) A), option (Ty.tySem (Ty.Sum B A)),
       option (Ty.tySem (Ty.Sum B A)))
  with
  | O =>
      fun body0 : forall _ : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word O)) A), option (Ty.tySem (Ty.Sum B A)) =>
      match
        body0
          (@pair (prod (Ty.tySem C) (sum unit unit)) (Ty.tySem A)
             (@pair (Ty.tySem C) (sum unit unit) context (@inl unit unit tt)) state)
        return (option (Ty.tySem (Ty.Sum B A)))
      with
      | Some t =>
          match t return (option (Ty.tySem (Ty.Sum B A))) with
          | inl result =>
              @Some
                (sum
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) B)
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) A))
                (@inl
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) B)
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) A) result)
          | inr next =>
              body0
                (@pair (prod (Ty.tySem C) (sum unit unit))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) A) (@pair (Ty.tySem C) (sum unit unit) context (@inr unit unit tt)) next)
          end
      | None => @None (Ty.tySem (Ty.Sum B A))
      end
  | S k =>
      fun body0 : forall _ : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word (S k))) A), option (Ty.tySem (Ty.Sum B A)) =>
      for_while_run k C B A
        (fun p : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word k)) A) =>
         for_while_run k (Ty.Prod C (Word.Word k)) B A
           (fun q : Ty.tySem (Ty.Prod (Ty.Prod (Ty.Prod C (Word.Word k)) (Word.Word k)) A) =>
            body0
              (@pair
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                        | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                        end) C)
                    (prod
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                           | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                           end) (Word.Word k))
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                           | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                           end) (Word.Word k))))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                     | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                     end) A)
                 (@pair
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                        | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                        end) C)
                    (prod
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                           | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                           end) (Word.Word k))
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                           | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                           end) (Word.Word k)))
                    (@fst
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                           | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                           end) C)
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
