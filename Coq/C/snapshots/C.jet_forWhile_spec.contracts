                           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                           end) (Ty.Sum Ty.Unit Ty.Unit) k)) A)
                 (Ty.Prod C
                    (Ty.Prod
                       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                           match n0 return Ty.Ty with
                           | O => X
                           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                           end) (Ty.Sum Ty.Unit Ty.Unit) k)
                       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                           match n0 return Ty.Ty with
                           | O => X
                           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                           end) (Ty.Sum Ty.Unit Ty.Unit) k))) A alg
                 (@Alg.Core.Combinators.pair
                    (Ty.Prod
                       (Ty.Prod
                          (Ty.Prod C
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) k))
                          ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                              match n0 return Ty.Ty with
                              | O => X
                              | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                              end) (Ty.Sum Ty.Unit Ty.Unit) k)) A) C
                    (Ty.Prod
                       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                           match n0 return Ty.Ty with
                           | O => X
                           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                           end) (Ty.Sum Ty.Unit Ty.Unit) k)
                       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                           match n0 return Ty.Ty with
                           | O => X
                           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                           end) (Ty.Sum Ty.Unit Ty.Unit) k)) alg
                    (@Alg.Core.Combinators.take
                       (Ty.Prod
                          (Ty.Prod C
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) k))
                          ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                              match n0 return Ty.Ty with
                              | O => X
                              | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                              end) (Ty.Sum Ty.Unit Ty.Unit) k)) A C alg
                       (@Alg.Core.Combinators.take
                          (Ty.Prod C
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) k))
                          ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                              match n0 return Ty.Ty with
                              | O => X
                              | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                              end) (Ty.Sum Ty.Unit Ty.Unit) k) C alg
                          (@Alg.Core.Combinators.take C
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) k) C alg (@Alg.Core.Combinators.iden C alg))))
                    (@Alg.Core.Combinators.pair
                       (Ty.Prod
                          (Ty.Prod
                             (Ty.Prod C
                                ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                    match n0 return Ty.Ty with
                                    | O => X
                                    | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                    end) (Ty.Sum Ty.Unit Ty.Unit) k))
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) k)) A)
                       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                           match n0 return Ty.Ty with
                           | O => X
                           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                           end) (Ty.Sum Ty.Unit Ty.Unit) k)
                       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                           match n0 return Ty.Ty with
                           | O => X
                           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                           end) (Ty.Sum Ty.Unit Ty.Unit) k) alg
                       (@Alg.Core.Combinators.take
                          (Ty.Prod
                             (Ty.Prod C
                                ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                    match n0 return Ty.Ty with
                                    | O => X
                                    | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                    end) (Ty.Sum Ty.Unit Ty.Unit) k))
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) k)) A
                          ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                              match n0 return Ty.Ty with
                              | O => X
                              | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                              end) (Ty.Sum Ty.Unit Ty.Unit) k) alg
                          (@Alg.Core.Combinators.take
                             (Ty.Prod C
                                ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                    match n0 return Ty.Ty with
                                    | O => X
                                    | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                    end) (Ty.Sum Ty.Unit Ty.Unit) k))
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) k)
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) k) alg
                             (@Alg.Core.Combinators.drop C
                                ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                    match n0 return Ty.Ty with
                                    | O => X
                                    | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                    end) (Ty.Sum Ty.Unit Ty.Unit) k)
                                ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                    match n0 return Ty.Ty with
                                    | O => X
                                    | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                    end) (Ty.Sum Ty.Unit Ty.Unit) k) alg
                                (@Alg.Core.Combinators.iden
                                   ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                       match n0 return Ty.Ty with
                                       | O => X
                                       | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                       end) (Ty.Sum Ty.Unit Ty.Unit) k) alg))))
                       (@Alg.Core.Combinators.take
                          (Ty.Prod
                             (Ty.Prod C
                                ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                    match n0 return Ty.Ty with
                                    | O => X
                                    | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                    end) (Ty.Sum Ty.Unit Ty.Unit) k))
                             ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                 match n0 return Ty.Ty with
                                 | O => X
                                 | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) k)) A
                          ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
