### C.jet_secp_gej_ge_equiv_flag.equiv_normalized_zero_test
equiv_normalized_zero_test
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (Bit.toBool
            (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
               (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem a)))
         (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem a))
### C.jet_secp_gej_ge_equiv_flag.equiv_finite_nonzero_h_reduction
equiv_finite_nonzero_h_reduction
     : forall (x y z u v : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z)) false)
         (_ : @eq bool
                (BinInt.Z.eqb
                   (BinInt.Z.modulo
                      (jet_secp_multiply_finish_product.radix_value
                         (jet_secp_mixed_finite_return.mixed_h_words (jet_secp_square_spec_bridge.square_reader_rho x)
                            (jet_secp_square_spec_bridge.square_reader_rho z)
                            (jet_secp_square_spec_bridge.square_reader_rho u))) jet_secp_fe_math.feP) BinNums.Z0) false),
       and (@eq bool (jet_secp_gej_ge_equiv_reader.gej_ge_equiv_reader_bit x y z u v) false)
         (@eq bool
            (Bit.toBool
               (@jet_secp_gej_ge_equiv_literal.literal_gej_ge_equiv Alg.CoreFunSem
                  (@pair
                     (prod
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (@pair
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) u v))))
            (BinInt.Z.eqb
               (BinInt.Z.modulo
                  (BinInt.Z.mul
                     (BinInt.Z.mul
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (jet_secp_mixed_dispatch_literal.mixed_literal_h
                              (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
                              (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem z) u))
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem z)))
                     (BinInt.Z.sub jet_secp_fe_math.feP (BinNums.Zpos BinNums.xH))) jet_secp_fe_math.feP) BinNums.Z0))
### C.jet_secp_gej_ge_equiv_flag.equiv_double_body_flag
equiv_double_body_flag
     : forall (x y z : forall _ : nat, Integers.Int64.int)
         (a b c : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value x) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value y) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) c)
                   jet_secp_fe_math.feP)),
       @eq bool (Integers.Int.eq (jet_secp_double_var_owned.double_var_zflag y z) Integers.Int.one)
         (Bit.toBool
            (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem
               (@jet_secp_double_literal.literal_gej_double_body Alg.CoreFunSem
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b) c))))
### C.jet_secp_gej_ge_equiv_flag.equiv_literal_infinity_flag
equiv_literal_infinity_flag
     : @eq bool
         (Bit.toBool
            (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem
               (@jet_secp_literal_infinity.literal_gej_infinity Alg.CoreFunSem tt))) true
### C.jet_secp_gej_ge_equiv_flag.equiv_incoming_infinity
equiv_incoming_infinity
     : forall (x y z u v : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z)) true),
       @eq bool (jet_secp_gej_ge_equiv_reader.gej_ge_equiv_reader_bit x y z u v)
         (Bit.toBool
            (@jet_secp_gej_ge_equiv_literal.literal_gej_ge_equiv Alg.CoreFunSem
               (@pair
                  (prod
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) u v))))
