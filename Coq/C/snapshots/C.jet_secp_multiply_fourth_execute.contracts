### C.jet_secp_multiply_fourth_execute.fourth_typed_run
fourth_typed_run
     : forall (digits written : forall _ : nat, Integers.Int64.int) (c d : prod Integers.Int64.int Integers.Int64.int)
         (t3 t4 : Integers.Int64.int),
       @eq (option jet_sx_exec.res)
         (jet_sx_exec.xstmt (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
            jet_secp_multiply_run_run.field_table
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))
            (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_multiply_checkpoint_prefix.mul_allocated)
            (jet_secp_multiply_next_checkpoint.checkpoint_state digits written c d t3 t4)
            jet_secp_multiply_fourth_state.fourth_statement)
         (@Some jet_sx_exec.res
            (jet_sx_exec.RDone (jet_secp_multiply_fourth_state.fourth_state digits written c d t3 t4)
               jet_sx_exec.ONormal))
### C.jet_secp_multiply_fourth_execute.fourth_atomic_regs_exact
fourth_atomic_regs_exact
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (digits written : forall _ : nat, Integers.Int64.int) (c d : prod Integers.Int64.int Integers.Int64.int)
         (t3 t4 : Integers.Int64.int),
       @eq (list jet_sx_state.region)
         (jet_sx_eval.sregs
            (jet_secp_multiply_checkpoint_atomic.atomic_state rho beta
               (jet_secp_multiply_fourth_state.fourth_state digits written c d t3 t4)))
         (jet_secp_multiply_next_checkpoint.checkpoint_regs digits
            (written_r1 written (jet_secp_multiply_fourth_values.fourth_r1_machine digits c d))
            (jet_secp_multiply_fourth_values.fourth_final_c_machine digits c d)
            (jet_secp_multiply_fourth_values.fourth_final_d_machine digits d))
### C.jet_secp_multiply_fourth_execute.fourth_checkpoint_rep
fourth_checkpoint_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
