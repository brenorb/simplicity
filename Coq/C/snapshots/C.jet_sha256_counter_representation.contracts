### C.jet_sha256_counter_representation.sha256_counter_shift_constant
sha256_counter_shift_constant
     : @eq BinNums.Z
         (Zpower.two_p
            (Integers.Int64.unsigned (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))))
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
### C.jet_sha256_counter_representation.sha256_counter_unsigned
sha256_counter_unsigned
     : forall (count len : Integers.Int64.int)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned count)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned len)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq BinNums.Z (Integers.Int64.unsigned (jet_read_sha256_counter.sha256_read_counter count len))
         (BinInt.Z.add
            (BinInt.Z.mul
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (Integers.Int64.unsigned count)) (Integers.Int64.unsigned len))
### C.jet_sha256_counter_representation.sha256_counter_remainder
sha256_counter_remainder
     : forall (count len : Integers.Int64.int)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned count)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned len)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq Integers.Int64.int
         (Integers.Int64.modu (jet_read_sha256_counter.sha256_read_counter count len)
            (Integers.Int64.repr
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         len
### C.jet_sha256_counter_representation.sha256_counter_quotient
sha256_counter_quotient
     : forall (count len : Integers.Int64.int)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned count)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned len)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq Integers.Int64.int
         (Integers.Int64.shru (jet_read_sha256_counter.sha256_read_counter count len)
            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))) count
### C.jet_sha256_counter_representation.sha256_buffer63_length_range
sha256_buffer63_length_range
     : forall buf : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))),
       and
         (BinInt.Z.le BinNums.Z0
            (BinInt.Z.of_nat
               (@length (Ty.tySem (Word.Word (S (S (S O)))))
                  (jet_buffer_chunks.byte_chunks_values (jet_buffer_input.buffer_byte_chunks (S (S (S (S (S O))))) buf)))))
         (BinInt.Z.lt
            (BinInt.Z.of_nat
               (@length (Ty.tySem (Word.Word (S (S (S O)))))
                  (jet_buffer_chunks.byte_chunks_values (jet_buffer_input.buffer_byte_chunks (S (S (S (S (S O))))) buf))))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
### C.jet_sha256_counter_representation.sha256_counter_buffer63_representation
sha256_counter_buffer63_representation
     : forall (count : Integers.Int64.int)
         (buf : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned count)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))))),
       let len : BinNums.Z :=
         BinInt.Z.of_nat
           (@length (Ty.tySem (Word.Word (S (S (S O)))))
              (jet_buffer_chunks.byte_chunks_values (jet_buffer_input.buffer_byte_chunks (S (S (S (S (S O))))) buf)))
         in
       and
         (@eq BinNums.Z
            (Integers.Int64.unsigned (jet_read_sha256_counter.sha256_read_counter count (Integers.Int64.repr len)))
            (BinInt.Z.add
               (BinInt.Z.mul
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (Integers.Int64.unsigned count)) len))
         (and
            (@eq Integers.Int64.int
               (Integers.Int64.modu (jet_read_sha256_counter.sha256_read_counter count (Integers.Int64.repr len))
                  (Integers.Int64.repr
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (Integers.Int64.repr len))
            (@eq Integers.Int64.int
               (Integers.Int64.shru (jet_read_sha256_counter.sha256_read_counter count (Integers.Int64.repr len))
                  (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))) count))
