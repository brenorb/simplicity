### C.jet_secp_reduce512_fresh_body.reduce512_fresh_checkpoint
reduce512_fresh_checkpoint
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (le : Clight.temp_env)
         (_ : jet_sx_eval.tmatch rho beta
                (jet_sx_eval.stemps jet_secp_reduce512_fresh_runs.reduce512_fresh_first_state) le),
       jet_sx_eval.tmatch rho beta
         (jet_secp_reduce512_typed_stage.reduce512_typed_stage_temps
            (jet_secp_reduce512_checkpoint.first_checkpoint_digits rho)
            (jet_secp_reduce512_checkpoint.first_checkpoint_m6 rho)) le
### C.jet_secp_reduce512_fresh_body.exec_reduce512_fresh_body
exec_reduce512_fresh_body
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta (jet_sx_eval.sregs jet_secp_reduce512_fresh_runs.reduce512_fresh_first) m)
         (_ : jet_sx_eval.tmatch rho beta jet_secp_reduce512_two_stages.reduce512_initial_temps le)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_reduce512_typed_stage.reduce512_allocated) e),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (Clight.fn_body jets_secp.f_secp256k1_scalar_reduce_512) Events.E0 lef mf ClightBigstep.Out_normal)
               (and
                  (jet_sx_state.rep rho beta
                     (jet_sx_eval.sregs
                        (jet_secp_reduce512_final_stage.reduce512_final_state
                           (jet_secp_reduce512_body_numeric.reduce512_body_digits rho)
                           (jet_secp_reduce512_body_numeric.reduce512_body_carry rho))) mf)
                  (and
                     (forall (i : nat) (sy : jet_sx_expr.sx)
                        (_ : @eq (option jet_sx_expr.sx)
                               (@List.nth_error jet_sx_expr.sx
                                  (jet_secp_reduce512_final_stage.reduce512_final_limbs
                                     (jet_secp_reduce512_body_numeric.reduce512_body_digits rho)
                                     (jet_secp_reduce512_body_numeric.reduce512_body_carry rho)) i)
                               (@Some jet_sx_expr.sx sy)),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk beta O)
                           (BinInt.Z.add (jet_sx_state.bas beta O)
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.of_nat i))))
                        (@Some Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta) sy)))
                     (and
                        (@eq BinNums.Z
                           (jet_secp_reduce512_final_atomic.final_output_value
                              (jet_secp_reduce512_body_numeric.reduce512_body_digits rho)
                              (jet_secp_reduce512_body_numeric.reduce512_body_carry rho) rho
                              (jet_sx_state.lay beta))
                           (BinInt.Z.modulo (jet_secp_reduce512_body_numeric.reduce512_input_integer rho)
                              jet_secp_canonical_scalar.canonical_group_order))
                        (and
                           (jet_sx_eval.tmatch rho beta
                              (jet_sx_eval.stemps
                                 (jet_secp_reduce512_final_stage.reduce512_final_state
                                    (jet_secp_reduce512_body_numeric.reduce512_body_digits rho)
                                    (jet_secp_reduce512_body_numeric.reduce512_body_carry rho))) lef)
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (jet_sx_state.foot beta
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape
                                       (jet_sx_eval.sregs jet_secp_reduce512_fresh_runs.reduce512_fresh_first)) b ofs))
                              m mf)))))))
