     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S O)))))))
     (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
     (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))
     (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S O)))))))
        (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
        (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))
        (@Word.zero (S (S (S (S (S (S O))))))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))))
  (@Alg.Core.Combinators.comp
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
     (Word.Word (S (S (S (S (S (S O)))))))
     (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
     (@jet_forWhile_spec.for_while_program (S (S (S (S (S O))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))
        (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg) (@total_fee_body alg))
     (@Alg.Core.Combinators.copair (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))
        (Word.Word (S (S (S (S (S (S O)))))))
        (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
        (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O)))))))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))
        (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O)))))))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))))
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Word.Word (S (S (S (S (S (S O)))))))

Arguments elements_total_fee_spec {alg}
### C.jet_elements_total_fee_spec.canonical_fee_contrib
canonical_fee_contrib =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (o : jet_elements_prim.txOutput) =>
match jet_elements_output_is_fee_spec.canonical_fee_bit o return BinNums.Z with
| true =>
    match
      Bit.toBool
        ((@jet_equality_spec.equality_spec
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))) Alg.CoreFunSem
          :
          Ty.Arrow
            (Ty.Prod
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.Sum Ty.Unit Ty.Unit))
           (@pair
              (Ty.tySem
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (sum
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Ty.Sum Ty.Unit Ty.Unit))
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (jet_elements_asset_jets.encode_asset
                 (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256 (jet_elements_prim.txoAsset o)))
              (@inr
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Ty.Sum Ty.Unit Ty.Unit))
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a))) return BinNums.Z
    with
    | true =>
        match
          @jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (jet_elements_prim.txoAmount o)
          return BinNums.Z
        with
        | jet_elements_prim.Explicit v => Integers.Int64.unsigned v
        | jet_elements_prim.Confidential _ _ => BinNums.Z0
        end
    | false => BinNums.Z0
    end
| false => BinNums.Z0
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : jet_elements_prim.txOutput), BinNums.Z

Arguments canonical_fee_contrib a o
### C.jet_elements_total_fee_spec.canonical_total_fee
canonical_total_fee =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (environment : jet_elements_prim.Elements.env) =>
@List.fold_right BinNums.Z BinNums.Z BinInt.Z.add BinNums.Z0
  (@List.map jet_elements_prim.txOutput BinNums.Z (canonical_fee_contrib a)
     (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment)))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : jet_elements_prim.Elements.env),
       BinNums.Z

Arguments canonical_total_fee a environment
