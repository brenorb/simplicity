       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod B C)))
         (@AC.pair A B C
            (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore
               (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)) s t a
            e)
