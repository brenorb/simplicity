### C.jet_elements_total_fee_spec.pcomp
@pcomp
     : forall (A B C : Ty.Ty)
         (s : Alg.Core.domain
                (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore
                   (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)) A
                B)
         (t : Alg.Core.domain
                (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore
                   (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)) B
                C) (a : Ty.tySem A) (e : jet_elements_prim.Elements.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@AC.comp A B C
            (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore
               (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)) s t a
            e) (@Option.option_bind (Ty.tySem B) (Ty.tySem C) (fun b : Ty.tySem B => t b e) (s a e))
