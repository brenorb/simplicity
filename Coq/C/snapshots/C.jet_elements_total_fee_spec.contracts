             @Option.option_bind (Ty.tySem C) (prod (Ty.tySem B) (Ty.tySem C))
               (fun c : Ty.tySem C => @Some (prod (Ty.tySem B) (Ty.tySem C)) (@pair (Ty.tySem B) (Ty.tySem C) b c))
               (t a e)) (s a e))
