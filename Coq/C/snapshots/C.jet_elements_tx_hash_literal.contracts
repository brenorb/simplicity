### C.jet_elements_tx_hash_literal.elements_tx_hash_of
elements_tx_hash_of =
fun e : jet_elements_prim.Elements.env =>
jet_bitcoin_composite_hash.sha256_bytes_of
  (@app (Ty.tySem (Word.Word (S (S (S O)))))
     (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S O)))
        (@pair (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
           (elements_tx_version_word e) (elements_tx_locktime_word e)))
     (@app (Ty.tySem (Word.Word (S (S (S O)))))
        (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S (S O)))))))
           (@pair
              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.from_hash256 (jet_elements_inputs_hash_program.elements_inputs_hash_of e))
                 (Word.from_hash256 (jet_elements_composite_amounts_hash.elements_outputs_hash_of e)))
              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.from_hash256 (jet_elements_issuances_hash_literal.elements_issuances_hash_of e))
                 (Word.from_hash256
                    (jet_elements_words_hash_program.elements_words_hash_of (S (S (S (S (S O)))))
                       (S (S (S (S (S O)))))
                       (jet_elements_words_hash_program.elements_output_surjection_proofs_words e))))))
        (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))
           (Word.from_hash256 (jet_elements_composite_amounts_hash.elements_input_utxos_hash_of e)))))
     : forall _ : jet_elements_prim.Elements.env, Digest.hash256

Arguments elements_tx_hash_of e
### C.jet_elements_tx_hash_literal.literal_elements_tx_hash
literal_elements_tx_hash =
fun alg : EFP.Algebra =>
let term : Alg.Assertion.Algebra := EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@AC.comp Ty.Unit (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@AC.comp Ty.Unit
