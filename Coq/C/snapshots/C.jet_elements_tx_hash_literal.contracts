### C.jet_elements_tx_hash_literal.elements_tx_hash_spec
elements_tx_hash_spec =
fun alg : EFP.Algebra =>
let term : Alg.Assertion.Algebra := EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@AC.comp Ty.Unit (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@AC.comp Ty.Unit
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
        jet_sha256_ctx8_init_spec.sha256_ctx8_type core
        (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           core
           (@AC.comp Ty.Unit
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type core
              (@AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) core
                 (@jet_sha256_ctx8_init_spec.sha256_ctx8_init_spec core)
                 (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))) core
                    (@EFP.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
                       jet_elements_prim.Elements.Version)
                    (@EFP.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
                       jet_elements_prim.Elements.LockTime))) (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S (S O))) term))
           (@AC.pair Ty.Unit
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              core
              (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_elements_inputs_hash_program.elements_inputs_hash_spec alg)
                 (@jet_elements_composite_amounts_hash.elements_outputs_hash_spec alg))
              (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_elements_issuances_hash_literal.elements_issuances_hash_spec alg)
                 (@jet_elements_words_hash_program.elements_prim_words_hash_spec (S (S (S (S (S O)))))
                    (S (S (S (S (S O))))) jet_elements_prim.Elements.OutputSurjectionProof alg))))
        (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S (S (S (S (S (S O))))))) term))
     (@jet_elements_composite_amounts_hash.elements_input_utxos_hash_spec alg))
  (@AC.comp
     (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
     jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S (S (S (S O))))) term) (@jet_sha_finalize_spec.ctx8_finalize_spec term))
     : forall alg : EFP.Algebra, EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments elements_tx_hash_spec {alg}
