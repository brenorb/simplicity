                       jet_elements_prim.Elements.LockTime)))
              (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S (S O))) term))
           (@AC.pair Ty.Unit
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              core
              (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_elements_inputs_hash_literal.literal_elements_inputs_hash alg)
                 (@jet_elements_composite_hash_literal.literal_elements_outputs_hash alg))
              (@AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_elements_issuances_hash_literal.literal_elements_issuances_hash alg)
