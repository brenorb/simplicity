### C.jet_write_buffer8_empty_run.buffer63_empty_counts_chain
buffer63_empty_counts_chain
     : buffer8_empty_chain buffer63_empty_counts
### C.jet_write_buffer8_empty_run.empty_loop_from_normal_sequence
empty_loop_from_normal_sequence
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (s1 s2 : Clight.statement)
         (lenext : Clight.temp_env) (mn : Memory.Mem.mem) (lef : Clight.temp_env) (mf : Memory.Mem.mem)
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m (Clight.Ssequence s1 s2) Events.E0 lenext mn
                ClightBigstep.Out_normal)
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e lenext mn (Clight.Sloop s1 s2) Events.E0 lef mf
                ClightBigstep.Out_normal),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m (Clight.Sloop s1 s2) Events.E0 lef mf
         ClightBigstep.Out_normal
### C.jet_write_buffer8_empty_run.exec_buffer8_empty_calls
exec_buffer8_empty_calls
     : forall (xs : list BinNums.Z) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bf : Values.block) (base : BinNums.Z) (_ : buffer8_empty_chain xs)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._len le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr (buffer8_empty_index xs)))))
         (_ : buffer8_empty_calls bf base xs m mf),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m
            jet_write_buffer8_empty_exec.buffer8_actual_loop Events.E0 lef mf ClightBigstep.Out_normal)
### C.jet_write_buffer8_empty_run.buffer8_empty_index
buffer8_empty_index =
fun xs : list BinNums.Z => match xs return BinNums.Z with
                           | nil => BinNums.Z0
                           | cons j _ => j
                           end
     : forall _ : list BinNums.Z, BinNums.Z

Arguments buffer8_empty_index xs%list_scope
### C.jet_write_buffer8_empty_run.buffer8_empty_chain
buffer8_empty_chain =
fix buffer8_empty_chain (xs : list BinNums.Z) : Prop :=
  match xs return Prop with
  | nil => True
  | cons j xs0 =>
      and (and (BinInt.Z.lt BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
        (and (@eq BinNums.Z (BinInt.Z.div j (BinNums.Zpos (BinNums.xO BinNums.xH))) (buffer8_empty_index xs0))
           (buffer8_empty_chain xs0))
  end
     : forall _ : list BinNums.Z, Prop

Arguments buffer8_empty_chain xs%list_scope
### C.jet_write_buffer8_empty_run.buffer8_empty_calls
buffer8_empty_calls =
fix buffer8_empty_calls
  (bf : Values.block) (base : BinNums.Z) (xs : list BinNums.Z) (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons j xs0 =>
      @ex Memory.Mem.mem
        (fun mb : Memory.Mem.mem =>
         @ex Memory.Mem.mem
           (fun mi : Memory.Mem.mem =>
            and
              (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_writeBit)
                 (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                    (@cons Values.val (Values.Vint Integers.Int.zero) (@nil Values.val))) Events.E0 mb
                 (Values.Vint Integers.Int.zero))
              (and
                 (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb (@Ctypes.Internal Clight.function jets.f_skipBits)
                    (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                       (@cons Values.val
                          (Values.Vlong
                             (Integers.Int64.repr
                                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) j)))
                          (@nil Values.val))) Events.E0 mi Values.Vundef) (buffer8_empty_calls bf base xs0 mi mf))))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : list BinNums.Z) (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments buffer8_empty_calls bf base%Z_scope xs%list_scope m mf
### C.jet_write_buffer8_empty_run.buffer63_empty_counts
buffer63_empty_counts =
@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
  (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
        (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
           (@cons BinNums.Z (BinNums.Zpos (BinNums.xO BinNums.xH))
              (@cons BinNums.Z (BinNums.Zpos BinNums.xH) (@nil BinNums.Z))))))
     : list BinNums.Z
