### C.jet_secp_scalar_overflow_flags.scalar_overflow_symbolic_return
scalar_overflow_symbolic_return
     : @eq jet_sx_expr.sx jet_secp_scalar_overflow_exec.scalar_overflow_return scalar_yes0
### C.jet_secp_scalar_overflow_flags.machine_bits_or
machine_bits_or
     : forall a b : bool,
       @eq Integers.Int.int (Integers.Int.or (jet_sx_expr.b2i a) (jet_sx_expr.b2i b)) (jet_sx_expr.b2i (orb a b))
### C.jet_secp_scalar_overflow_flags.machine_bits_and_not
machine_bits_and_not
     : forall a b : bool,
       @eq Integers.Int.int (Integers.Int.and (jet_sx_expr.b2i a) (Integers.Int.not (jet_sx_expr.b2i b)))
         (jet_sx_expr.b2i (andb a (negb b)))
### C.jet_secp_scalar_overflow_flags.machine_zero_or_bit
machine_zero_or_bit
     : forall a : bool,
       @eq Integers.Int.int (Integers.Int.or Integers.Int.zero (jet_sx_expr.b2i a)) (jet_sx_expr.b2i a)
### C.jet_secp_scalar_overflow_flags.scalar_overflow_return_flag
scalar_overflow_return_flag
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (jet_sx_expr.den rho layout jet_secp_scalar_overflow_exec.scalar_overflow_return)
         (Values.Vint (jet_sx_expr.b2i (scalar_overflow_bool rho)))
### C.jet_secp_scalar_overflow_flags.scalar_no3
scalar_no3 =
jet_sx_expr.XIb jet_sx_expr.Bor (jet_sx_expr.XIc Integers.Int.zero)
  (jet_sx_expr.XLcmp Integers.Clt Ctypes.Unsigned (jet_sx_expr.XLv (S (S (S O))))
     (jet_sx_expr.XLc (Integers.Int64.repr (BinNums.Zneg BinNums.xH))))
     : jet_sx_expr.sx
### C.jet_secp_scalar_overflow_flags.scalar_no2
scalar_no2 =
jet_sx_expr.XIb jet_sx_expr.Bor scalar_no3
  (jet_sx_expr.XLcmp Integers.Clt Ctypes.Unsigned (jet_sx_expr.XLv (S (S O)))
     (jet_sx_expr.XLc (Integers.Int64.repr (BinNums.Zneg (BinNums.xO BinNums.xH)))))
     : jet_sx_expr.sx
### C.jet_secp_scalar_overflow_flags.scalar_yes2
scalar_yes2 =
jet_sx_expr.XIb jet_sx_expr.Bor (jet_sx_expr.XIc Integers.Int.zero)
  (jet_sx_expr.XIb jet_sx_expr.Band
     (jet_sx_expr.XLcmp Integers.Cgt Ctypes.Unsigned (jet_sx_expr.XLv (S (S O)))
        (jet_sx_expr.XLc (Integers.Int64.repr (BinNums.Zneg (BinNums.xO BinNums.xH))))) (jet_sx_expr.XInot scalar_no2))
     : jet_sx_expr.sx
### C.jet_secp_scalar_overflow_flags.scalar_no1
scalar_no1 =
jet_sx_expr.XIb jet_sx_expr.Bor scalar_no2
  (jet_sx_expr.XLcmp Integers.Clt Ctypes.Unsigned (jet_sx_expr.XLv (S O))
     (jet_sx_expr.XLc
        (Integers.Int64.repr
           (BinNums.Zneg
              (BinNums.xI
                 (BinNums.xO
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
     : jet_sx_expr.sx
### C.jet_secp_scalar_overflow_flags.scalar_yes1
scalar_yes1 =
jet_sx_expr.XIb jet_sx_expr.Bor scalar_yes2
  (jet_sx_expr.XIb jet_sx_expr.Band
     (jet_sx_expr.XLcmp Integers.Cgt Ctypes.Unsigned (jet_sx_expr.XLv (S O))
        (jet_sx_expr.XLc
           (Integers.Int64.repr
              (BinNums.Zneg
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (...))))))))))))))))))))))
     (jet_sx_expr.XInot scalar_no1))
     : jet_sx_expr.sx
### C.jet_secp_scalar_overflow_flags.scalar_yes0
scalar_yes0 =
jet_sx_expr.XIb jet_sx_expr.Bor scalar_yes1
  (jet_sx_expr.XIb jet_sx_expr.Band
     (jet_sx_expr.XLcmp Integers.Cge Ctypes.Unsigned (jet_sx_expr.XLv O)
        (jet_sx_expr.XLc
           (Integers.Int64.repr
              (BinNums.Zneg
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...))))))))))))))))))))))
     (jet_sx_expr.XInot scalar_no1))
     : jet_sx_expr.sx
### C.jet_secp_scalar_overflow_flags.scalar_overflow_bool
scalar_overflow_bool =
fun rho : forall _ : nat, Integers.Int64.int =>
let no3 : bool :=
  orb false (Integers.Int64.cmpu Integers.Clt (rho (S (S (S O)))) (Integers.Int64.repr (BinNums.Zneg BinNums.xH))) in
let no2 : bool :=
  orb no3
    (Integers.Int64.cmpu Integers.Clt (rho (S (S O))) (Integers.Int64.repr (BinNums.Zneg (BinNums.xO BinNums.xH)))) in
let yes2 : bool :=
  orb false
    (andb
       (Integers.Int64.cmpu Integers.Cgt (rho (S (S O))) (Integers.Int64.repr (BinNums.Zneg (BinNums.xO BinNums.xH))))
       (negb no2)) in
let no1 : bool :=
  orb no2
    (Integers.Int64.cmpu Integers.Clt (rho (S O))
       (Integers.Int64.repr
          (BinNums.Zneg
             (BinNums.xI
                (BinNums.xO
                   (BinNums.xI
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (...))))))))))))))))))))
  in
let yes1 : bool :=
  orb yes2
    (andb
       (Integers.Int64.cmpu Integers.Cgt (rho (S O))
          (Integers.Int64.repr
             (BinNums.Zneg
                (BinNums.xI
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI ...))))))))))))))))))
       (negb no1)) in
orb yes1
  (andb
     (Integers.Int64.cmpu Integers.Cge (rho O)
        (Integers.Int64.repr
           (BinNums.Zneg
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (...)))))))))))))))))))
     (negb no1))
     : forall _ : forall _ : nat, Integers.Int64.int, bool

Arguments scalar_overflow_bool rho%function_scope
