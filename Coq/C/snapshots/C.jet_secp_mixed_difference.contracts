### C.jet_secp_mixed_difference.mixed_diff_negate
mixed_diff_negate =
fun i : bool =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_negate jets_secp.f_secp256k1_fe_negate
  (@None AST.ident)
  (@cons Clight.expr
     (jet_secp_curve_statements.curve_local_address
        match i return AST.ident with
        | true => jets_secp._i
        | false => jets_secp._h
        end)
     (@cons Clight.expr
        (jet_secp_curve_statements.curve_local_address
           match i return AST.ident with
           | true => jets_secp._s2
           | false => jets_secp._u1
           end) (@cons Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) (@nil Clight.expr))))
     : forall _ : bool, Clight.statement

Arguments mixed_diff_negate i%bool_scope
### C.jet_secp_mixed_difference.mixed_diff_add
mixed_diff_add =
