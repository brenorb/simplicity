### C.jet_secp_scalar_square512_product.square512_input_zero
square512_input_zero
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (jet_secp_scalar_mul512_low.scalar_mul512_input_value (square512_rho rho) O)
         (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)
### C.jet_secp_scalar_square512_product.square512_input_four
square512_input_four
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (jet_secp_scalar_mul512_low.scalar_mul512_input_value (square512_rho rho) (S (S (S (S O)))))
         (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)
### C.jet_secp_scalar_square512_product.scalar_square512_machine_length
scalar_square512_machine_length
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq nat (@length Integers.Int64.int (scalar_square512_machine_outputs rho)) (S (S (S (S (S (S (S (S O))))))))
### C.jet_secp_scalar_square512_product.scalar_square512_machine_product
scalar_square512_machine_product
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (jet_secp_scalar_mul512_accumulate.column_words_value (scalar_square512_machine_outputs rho))
         (BinInt.Z.mul (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)
            (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O))
### C.jet_secp_scalar_square512_product.scalar_square512_machine_cell
scalar_square512_machine_cell
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (i : nat) (x : Integers.Int64.int)
         (_ : @eq (option Integers.Int64.int)
                (@List.nth_error Integers.Int64.int (scalar_square512_machine_outputs rho) i)
                (@Some Integers.Int64.int x)),
       @ex jet_sx_expr.sx
         (fun sy : jet_sx_expr.sx =>
          and
            (@List.In jet_sx_state.cell
               (jet_sx_state.mkcell
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))
                  AST.Mint64 (@Some jet_sx_expr.sx sy))
               (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_scalar_square512_run.scalar_square512_limbs))
            (@eq Values.val (jet_sx_expr.den rho beta sy) (Values.Vlong x)))
### C.jet_secp_scalar_square512_product.eval_scalar_square512_fresh_product
eval_scalar_square512_fresh_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta jet_secp_scalar_square512_run.scalar_square512_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (forall (i : nat) (x : Integers.Int64.int)
                  (_ : @eq (option Integers.Int64.int)
                         (@List.nth_error Integers.Int64.int (scalar_square512_machine_outputs rho) i)
                         (@Some Integers.Int64.int x)),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk beta O)
                     (BinInt.Z.add (jet_sx_state.bas beta O)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong x)))
               (and
                  (@eq nat (@length Integers.Int64.int (scalar_square512_machine_outputs rho))
                     (S (S (S (S (S (S (S (S O)))))))))
                  (and
                     (@eq BinNums.Z
                        (jet_secp_scalar_mul512_accumulate.column_words_value (scalar_square512_machine_outputs rho))
                        (BinInt.Z.mul (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)
                           (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)))
                     (and (jet_sx_state.rep rho beta jet_secp_scalar_square512_run.scalar_square512_output_regs mf)
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot beta
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape jet_secp_scalar_square512_run.scalar_square512_regs) b ofs)) m
                           mf))))))
### C.jet_secp_scalar_square512_product.square512_rho
square512_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (n : nat) => rho (jet_secp_scalar_square512_run.square512_rename n)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments square512_rho rho%function_scope n%nat_scope
### C.jet_secp_scalar_square512_product.scalar_square512_machine_outputs
scalar_square512_machine_outputs =
fun rho : forall _ : nat, Integers.Int64.int =>
jet_secp_scalar_mul512_machine.scalar_mul512_machine_outputs (square512_rho rho)
     : forall _ : forall _ : nat, Integers.Int64.int, list Integers.Int64.int

Arguments scalar_square512_machine_outputs rho%function_scope
