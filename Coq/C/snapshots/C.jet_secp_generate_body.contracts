### C.jet_secp_generate_body.exec_generate_helper
exec_generate_helper
     : forall (le : Clight.temp_env) (m mf : Memory.Mem.mem) (bl bp bn : Values.block)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult)
                (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._a) Integers.Ptrofs.zero)
                      (@cons Values.val
                         (Values.Vptr jet_secp_generator_zero_global.generator_zero_block Integers.Ptrofs.zero)
                         (@cons Values.val (Values.Vptr bn Integers.Ptrofs.zero) (@nil Values.val))))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_generate_entry.generate_public_env bl bp bn)
         le m generate_helper Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_generate_body.exec_generate_write
exec_generate_write
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bl bp bn bd : Values.block)
         (base : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
