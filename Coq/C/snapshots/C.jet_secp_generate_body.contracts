### C.jet_secp_generate_body.generate_rest
generate_rest =
Clight.Ssequence (jet_secp_scalar_add_body.scalar_add_read_stmt jets_secp._ng__2)
  (Clight.Ssequence generate_helper
     (Clight.Ssequence generate_write
        (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))
