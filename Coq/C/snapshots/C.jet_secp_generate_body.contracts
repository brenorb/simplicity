         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mr
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult)
                (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
