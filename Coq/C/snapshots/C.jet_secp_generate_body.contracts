         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_write_gej) args trace mf result),
       jet_clight_internal_preserve.readonly_preserved m mf
### C.jet_secp_generate_body.generate_helper
generate_helper =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_ecmult jets_secp.f_secp256k1_ecmult
  (@None AST.ident)
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_secp._r (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_secp._a (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_secp._na (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
           (@cons Clight.expr
              (Clight.Eaddrof (Clight.Evar jets_secp._ng__2 (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))) (@nil Clight.expr)))))
     : Clight.statement
### C.jet_secp_generate_body.generate_write
generate_write =
jet_secp_curve_statements.curve_call jets_secp._write_gej jets_secp.f_write_gej (@None AST.ident)
  (@cons Clight.expr
     (Clight.Etempvar jets_secp._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_secp._r (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))) (@nil Clight.expr)))
