### Simplicity.Primitive.Bitcoin.Bitcoin.sem
Bitcoin.sem =
let cast : forall (A : Ty.Ty) (_ : option (Ty.tySem A)), Ty.tySem (Ty.Sum Ty.Unit A) :=
  fun (A : Ty.Ty) (x : option (Ty.tySem A)) =>
  match x return (Ty.tySem (Ty.Sum Ty.Unit A)) with
  | Some a => @inr unit (Ty.tySem A) a
  | None =>
      @inl unit
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A0 B => sum (tySem A0) (tySem B)
            | Ty.Prod A0 B => prod (tySem A0) (tySem B)
            end) A) tt
  end in
let encodeOutpoint :
  forall _ : outpoint,
  Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))) :=
  fun op : outpoint =>
  @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
    (Word.from_hash256 (opHash op))
    (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (opIndex op))
     :
     Ty.tySem (Word.Word (S (S (S (S (S O))))))) in
fun (A B : Ty.Ty) (p : Bitcoin.t A B) (a : Ty.tySem A) (e : Bitcoin.env) =>
let tx : sigTx := Bitcoin.envTx e in
let ix : nat := Bitcoin.envIx e in
let currentInput : forall (A0 : Ty.Ty) (_ : forall _ : sigTxInput, Ty.tySem A0), option (Ty.tySem A0) :=
  fun (A0 : Ty.Ty) (f : forall _ : sigTxInput, Ty.tySem A0) =>
  @option_map sigTxInput (Ty.tySem A0) f (@List.nth_error sigTxInput (sigTxIn tx) ix) in
let atInput :
  forall (A0 : Ty.Ty) (_ : forall _ : sigTxInput, Ty.tySem A0) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
  option (Ty.tySem (Ty.Sum Ty.Unit A0)) :=
  fun (A0 : Ty.Ty) (f : forall _ : sigTxInput, Ty.tySem A0) (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
  @Some (Ty.tySem (Ty.Sum Ty.Unit A0))
    (cast A0
       (@option_map sigTxInput (Ty.tySem A0) f
          (@List.nth_error sigTxInput (sigTxIn tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))))) in
let atOutput :
  forall (A0 : Ty.Ty) (_ : forall _ : txOutput, Ty.tySem A0) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
  option (Ty.tySem (Ty.Sum Ty.Unit A0)) :=
  fun (A0 : Ty.Ty) (f : forall _ : txOutput, Ty.tySem A0) (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
  @Some (Ty.tySem (Ty.Sum Ty.Unit A0))
    (cast A0
       (@option_map txOutput (Ty.tySem A0) f
          (@List.nth_error txOutput (sigTxOut tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))))) in
let outputsHash : Digest.hash256 :=
  let go : forall _ : txOutput, list Integers.Byte.int :=
    fun i : txOutput =>
    @app Integers.Byte.int (putInt64le (txoValue i)) (putHash256 (Digest.byteStringHash (txoScript i))) in
  Digest.byteStringHash (@List.concat Integers.Byte.int (@List.map txOutput (list Integers.Byte.int) go (sigTxOut tx)))
  in
let inputsHash : Digest.hash256 :=
  let go : forall _ : sigTxInput, list Integers.Byte.int :=
    fun i : sigTxInput =>
    @app Integers.Byte.int (putOutpoint (sigTxiPreviousOutpoint i))
      (@app Integers.Byte.int (putInt64le (sigTxiValue i)) (putInt32le (sigTxiSequence i))) in
  Digest.byteStringHash
    (@List.concat Integers.Byte.int (@List.map sigTxInput (list Integers.Byte.int) go (sigTxIn tx))) in
match p in (Bitcoin.prim A0 B0) return (forall _ : Ty.tySem A0, option (Ty.tySem B0)) with
| Bitcoin.Version =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.signed (sigTxVersion tx)))
| Bitcoin.LockTime =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (sigTxLock tx)))
| Bitcoin.InputsHash =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 inputsHash)
| Bitcoin.OutputsHash =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 outputsHash)
| Bitcoin.NumInputs =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (@Zcomplements.Zlength sigTxInput (sigTxIn tx)))
| Bitcoin.TotalInputValue =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (sigTxTotalInValue tx))
| Bitcoin.CurrentPrevOutpoint =>
    fun _ : Ty.tySem Ty.Unit =>
    currentInput (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
      (fun txi : sigTxInput => encodeOutpoint (sigTxiPreviousOutpoint txi))
| Bitcoin.CurrentValue =>
    fun _ : Ty.tySem Ty.Unit =>
    currentInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))
      (fun txi : sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.signed (sigTxiValue txi)))
| Bitcoin.CurrentSequence =>
    fun _ : Ty.tySem Ty.Unit =>
    currentInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))
      (fun txi : sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (sigTxiSequence txi)))
| Bitcoin.CurrentIndex =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (BinInt.Z.of_nat ix))
| Bitcoin.InputPrevOutpoint =>
    atInput (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
      (fun txi : sigTxInput => encodeOutpoint (sigTxiPreviousOutpoint txi))
| Bitcoin.InputValue =>
    atInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))
      (fun txi : sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.signed (sigTxiValue txi)))
| Bitcoin.InputSequence =>
    atInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))
      (fun txi : sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (sigTxiSequence txi)))
| Bitcoin.NumOutputs =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (@Zcomplements.Zlength txOutput (sigTxOut tx)))
| Bitcoin.TotalOutputValue =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (sigTxTotalOutValue tx))
| Bitcoin.OutputValue =>
    atOutput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))
      (fun txout : txOutput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.signed (txoValue txout)))
| Bitcoin.OutputScriptHash =>
    atOutput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txout : txOutput => Word.from_hash256 (Digest.byteStringHash (txoScript txout)))
| Bitcoin.ScriptCMR =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 (Bitcoin.envScriptCMR e))
end a
     : forall (A B : Ty.Ty) (_ : Bitcoin.t A B) (_ : Ty.tySem A) (_ : Bitcoin.env), option (Ty.tySem B)

Arguments Bitcoin.sem {A B}%ty_scope p a e
### Simplicity.Primitive.Bitcoin.outpoint
Record outpoint : Set := Build_outpoint { opHash : Digest.hash256;  opIndex : Integers.Int.int }.

outpoint has primitive projections with eta conversion.
Arguments Build_outpoint opHash opIndex
### Simplicity.Primitive.Bitcoin.sigTxInput
Record sigTxInput : Set := Build_sigTxInput
  { sigTxiPreviousOutpoint : outpoint;
    sigTxiValue : Integers.Int64.int;
    sigTxiSequence : Integers.Int.int;
    sigTxiValue_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) (Integers.Int64.signed sigTxiValue))
                          (BinInt.Z.lt (Integers.Int64.signed sigTxiValue) (BinInt.Z.succ MAX_MONEY)) }.

sigTxInput has primitive projections with eta conversion.
Arguments Build_sigTxInput sigTxiPreviousOutpoint sigTxiValue sigTxiSequence sigTxiValue_bound
### Simplicity.Primitive.Bitcoin.txOutput
Record txOutput : Set := Build_txOutput
  { txoValue : Integers.Int64.int;
    txoScript : script;
    txoValue_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) (Integers.Int64.signed txoValue))
                       (BinInt.Z.lt (Integers.Int64.signed txoValue) (BinInt.Z.succ MAX_MONEY));
    txoScript_bound : BinInt.Z.lt (@Zcomplements.Zlength Integers.Byte.int txoScript) Integers.Int.modulus }.

txOutput has primitive projections with eta conversion.
Arguments Build_txOutput txoValue txoScript txoValue_bound txoScript_bound
### Simplicity.Primitive.Bitcoin.sigTx
Record sigTx : Set := Build_sigTx
  { sigTxVersion : Integers.Int.int;
    sigTxIn : list sigTxInput;
    sigTxOut : list txOutput;
    sigTxLock : lock;
    sigTxInBounds : and (BinInt.Z.lt BinNums.Z0 (@Zcomplements.Zlength sigTxInput sigTxIn))
                      (BinInt.Z.lt (@Zcomplements.Zlength sigTxInput sigTxIn) Integers.Int.modulus);
    sigTxOutBounds : and (BinInt.Z.lt BinNums.Z0 (@Zcomplements.Zlength txOutput sigTxOut))
                       (BinInt.Z.lt (@Zcomplements.Zlength txOutput sigTxOut) Integers.Int.modulus);
    sigTxTotalInValue := List.Z_sum
                           (@List.map sigTxInput BinNums.Z
                              (fun i : sigTxInput => Integers.Int64.signed (sigTxiValue i)) sigTxIn);
    sigTxTotalOutValue := List.Z_sum
                            (@List.map txOutput BinNums.Z (fun i : txOutput => Integers.Int64.signed (txoValue i))
                               sigTxOut);
    sigTxFee := BinInt.Z.sub sigTxTotalOutValue sigTxTotalInValue;
    sigTxTotalInValue_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) sigTxTotalInValue)
                                (BinInt.Z.lt sigTxTotalInValue (BinInt.Z.succ MAX_MONEY));
    sigTxTotalOutValue_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) sigTxTotalOutValue)
                                 (BinInt.Z.lt sigTxTotalOutValue (BinInt.Z.succ MAX_MONEY));
    sigTxFee_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) sigTxFee)
                       (BinInt.Z.lt sigTxFee (BinInt.Z.succ MAX_MONEY)) }.

sigTx has primitive projections with eta conversion.
Arguments Build_sigTx sigTxVersion (sigTxIn sigTxOut)%list_scope sigTxLock sigTxInBounds sigTxOutBounds
  sigTxTotalInValue_bound sigTxTotalOutValue_bound sigTxFee_bound
### Simplicity.Primitive.Bitcoin.sigTxTotalInValue
sigTxTotalInValue =
fun s : sigTx =>
List.Z_sum (@List.map sigTxInput BinNums.Z (fun i : sigTxInput => Integers.Int64.signed (sigTxiValue i)) (sigTxIn s))
     : forall _ : sigTx, BinNums.Z

Arguments sigTxTotalInValue s
### Simplicity.Primitive.Bitcoin.sigTxTotalOutValue
sigTxTotalOutValue =
fun s : sigTx =>
List.Z_sum (@List.map txOutput BinNums.Z (fun i : txOutput => Integers.Int64.signed (txoValue i)) (sigTxOut s))
     : forall _ : sigTx, BinNums.Z

Arguments sigTxTotalOutValue s
### Simplicity.Primitive.Bitcoin.sigTxFee
sigTxFee =
fun s : sigTx =>
BinInt.Z.sub
  (List.Z_sum (@List.map txOutput BinNums.Z (fun i : txOutput => Integers.Int64.signed (txoValue i)) (sigTxOut s)))
  (List.Z_sum
     (@List.map sigTxInput BinNums.Z (fun i : sigTxInput => Integers.Int64.signed (sigTxiValue i)) (sigTxIn s)))
     : forall _ : sigTx, BinNums.Z

Arguments sigTxFee s
### Simplicity.Primitive.Bitcoin.Bitcoin.environment
Record environment : Set := Build_environment
  { envTx : sigTx;
    envIx : nat;
    envScriptCMR : Digest.hash256;
    envIxBounded : lt envIx (@length sigTxInput (sigTxIn envTx)) }.

environment has primitive projections with eta conversion.
Arguments Bitcoin.Build_environment envTx [envIx]%nat_scope envScriptCMR envIxBounded
### Simplicity.Primitive.Bitcoin.putInt64le
putInt64le =
fun x : Integers.Int64.int =>
let z : BinNums.Z := Integers.Int64.unsigned x in
@List.map nat Integers.Byte.int
  (fun i : nat => Integers.Byte.repr (BinInt.Z.div z (Zpower.two_power_nat (Nat.mul i Integers.Byte.wordsize))))
  (List.seq O (S (S (S (S (S (S (S (S O)))))))))
     : forall _ : Integers.Int64.int, list Integers.Byte.int

Arguments putInt64le x
### Simplicity.Primitive.Bitcoin.putInt32le
putInt32le =
fun x : Integers.Int.int =>
let z : BinNums.Z := Integers.Int.unsigned x in
@List.map nat Integers.Byte.int
  (fun i : nat => Integers.Byte.repr (BinInt.Z.div z (Zpower.two_power_nat (Nat.mul i Integers.Byte.wordsize))))
  (List.seq O (S (S (S (S O)))))
     : forall _ : Integers.Int.int, list Integers.Byte.int

Arguments putInt32le x
### Simplicity.Primitive.Bitcoin.putOutpoint
putOutpoint =
fun x : outpoint => @app Integers.Byte.int (putHash256 (opHash x)) (putInt32le (opIndex x))
     : forall _ : outpoint, list Integers.Byte.int

Arguments putOutpoint x
