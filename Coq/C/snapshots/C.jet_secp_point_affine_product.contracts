### C.jet_secp_point_affine_product.eval_point_affine_product_symbolic
eval_point_affine_product_symbolic
     : forall (y : bool) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem) (_ : jet_sx_state.rep rho beta (point_affine_product_regs y) m)
         (_ : @List.Forall jet_sx_eval.event (jet_secp_u128_word_oracle.u128_evok rho)
                jet_secp_field_mul_word_model.fe_mul_log),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O)
                     (Integers.Ptrofs.repr
                        (BinInt.Z.add (jet_sx_state.bas beta O) (jet_secp_curve_square.curve_square_offset y))))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O))
                        (Integers.Ptrofs.repr
                           (BinInt.Z.add (jet_sx_state.bas beta (S O)) (jet_secp_curve_square.curve_square_offset y))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                           (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O))))) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and (jet_sx_state.rep rho beta (point_affine_product_out y) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot beta
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape (point_affine_product_regs y)) b pos)) m mf)))
### C.jet_secp_point_affine_product.point_affine_product_initial
point_affine_product_initial
     : forall (y : bool) (a b : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bo ba bb : Values.block)
         (_ : not (@eq Values.block bo ba)) (_ : not (@eq Values.block bo bb)) (_ : not (@eq Values.block ba bb))
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m ba (jet_secp_curve_square.curve_square_offset y)
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep (jet_secp_point_mul_storage.point_mul_valuation a b)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bo BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                  (@nil (prod Values.block BinNums.Z))))) (point_affine_product_regs y) m
### C.jet_secp_point_affine_product.point_affine_product_fields
point_affine_product_fields
     : forall (y : bool) (a b : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bo ba bb : Values.block)
         (_ : jet_sx_state.rep (jet_secp_point_mul_storage.point_mul_valuation a b)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bo BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))) (point_affine_product_out y) m),
       and
         (jet_secp_fe_nv.fe_at m bo (jet_secp_curve_square.curve_square_offset y)
            (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_mul_storage.point_mul_words a b)))
         (and
            (jet_secp_fe_nv.fe_at m ba (jet_secp_curve_square.curve_square_offset y)
               (jet_secp_multiply_normalize_bridge.words5 a))
            (and (jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
               (and
                  (Memory.Mem.range_perm m bo BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm m ba BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (Memory.Mem.range_perm m bb BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)))))
### C.jet_secp_point_affine_product.point_affine_product_foot
point_affine_product_foot
     : forall (y : bool) (bo ba bb bx : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bo BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z)))))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   (point_affine_product_regs y)) bx pos),
       or
         (and (@eq Values.block bx bo)
            (and (BinInt.Z.le (jet_secp_curve_square.curve_square_offset y) pos)
               (BinInt.Z.lt pos
                  (BinInt.Z.add (jet_secp_curve_square.curve_square_offset y)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
         (or
            (and (@eq Values.block bx ba)
               (and (BinInt.Z.le (jet_secp_curve_square.curve_square_offset y) pos)
                  (BinInt.Z.lt pos
                     (BinInt.Z.add (jet_secp_curve_square.curve_square_offset y)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
            (@eq Values.block bx bb))
### C.jet_secp_point_affine_product.eval_point_affine_product
eval_point_affine_product
     : forall (y : bool) (a b : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bo ba bb : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds a) (_ : jet_secp_square_columns.square_input_bounds b)
         (_ : not (@eq Values.block bo ba)) (_ : not (@eq Values.block bo bb)) (_ : not (@eq Values.block ba bb))
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m ba (jet_secp_curve_square.curve_square_offset y)
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val (Values.Vptr bo (Integers.Ptrofs.repr (jet_secp_curve_square.curve_square_offset y)))
                  (@cons Values.val
                     (Values.Vptr ba (Integers.Ptrofs.repr (jet_secp_curve_square.curve_square_offset y)))
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bo (jet_secp_curve_square.curve_square_offset y)
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_mul_storage.point_mul_words a b)))
               (and
                  (jet_secp_fe_nv.fe_at mf ba (jet_secp_curve_square.curve_square_offset y)
                     (jet_secp_multiply_normalize_bridge.words5 a))
                  (and (jet_secp_fe_nv.fe_at mf bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
                     (and
                        (Memory.Mem.range_perm mf bo BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf ba BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bb BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (@eq BinNums.Z
                                    (BinInt.Z.modulo
                                       (jet_secp_multiply_finish_product.radix_value
                                          (jet_secp_point_mul_storage.point_mul_words a b)) jet_secp_fe_math.feP)
                                    (BinInt.Z.modulo
                                       (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                                          (jet_secp_multiply_finish_product.radix_value b)) jet_secp_fe_math.feP))
                                 (and
                                    (jet_secp_square_columns.square_input_bounds
                                       (jet_secp_point_mul_storage.point_mul_words a b))
                                    (jet_sx_mem.lframe
                                       (fun (bx : Values.block) (pos : BinNums.Z) =>
                                        and
                                          (or (not (@eq Values.block bx bo))
                                             (or (BinInt.Z.lt pos (jet_secp_curve_square.curve_square_offset y))
                                                (BinInt.Z.le
                                                   (BinInt.Z.add (jet_secp_curve_square.curve_square_offset y)
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                                   pos)))
                                          (and (not (@eq Values.block bx bb))
                                             (or (not (@eq Values.block bx ba))
                                                (or (BinInt.Z.lt pos (jet_secp_curve_square.curve_square_offset y))
                                                   (BinInt.Z.le
                                                      (BinInt.Z.add (jet_secp_curve_square.curve_square_offset y)
                                                         (BinNums.Zpos
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))
                                                      pos))))) m mf))))))))))
### C.jet_secp_point_affine_product.point_affine_holes
point_affine_holes =
fun y : bool =>
jet_secp_point_set_bit.point_set_holes
  match y return jet_secp_point_write_run.point_coordinate with
  | true => jet_secp_point_write_run.PointY
  | false => jet_secp_point_write_run.PointX
  end
     : forall _ : bool, list jet_sx_state.cell

Arguments point_affine_holes y%bool_scope
### C.jet_secp_point_affine_product.point_affine_product_regs
point_affine_product_regs =
fun y : bool =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg (point_affine_holes y) true
     (@Some BinNums.Z
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
  (@cons jet_sx_state.region (jet_secp_curve_square.curve_square_input y)
     (@cons jet_sx_state.region
        (jet_secp_local_regions.free_region (jet_secp_fe_nv.fe_reg (jet_secp_fe_nv.vars5 (S (S (S (S (S O)))))))
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
        (@nil jet_sx_state.region)))
     : forall _ : bool, list jet_sx_state.region

Arguments point_affine_product_regs y%bool_scope
### C.jet_secp_point_affine_product.point_affine_product_args
point_affine_product_args =
fun y : bool =>
@cons jet_sx_expr.sx (jet_sx_expr.XP O (jet_secp_curve_square.curve_square_offset y))
  (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) (jet_secp_curve_square.curve_square_offset y))
     (@cons jet_sx_expr.sx (jet_sx_expr.XP (S (S O)) BinNums.Z0) (@nil jet_sx_expr.sx)))
     : forall _ : bool, list jet_sx_expr.sx

Arguments point_affine_product_args y%bool_scope
### C.jet_secp_point_affine_product.point_affine_product_out
point_affine_product_out =
fun y : bool =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells (jet_secp_curve_square.curve_square_offset y) jet_secp_point_mul_run.point_mul_out) true
     (@Some BinNums.Z
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
  (@cons jet_sx_state.region (jet_secp_curve_square.curve_square_input y)
     (@cons jet_sx_state.region
        (jet_secp_local_regions.free_region (jet_secp_fe_nv.fe_reg (jet_secp_fe_nv.vars5 (S (S (S (S (S O)))))))
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
        (@nil jet_sx_state.region)))
     : forall _ : bool, list jet_sx_state.region

