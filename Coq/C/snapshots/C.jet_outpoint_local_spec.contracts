### C.jet_outpoint_local_spec.op_annex_bytes
op_annex_bytes
     : forall a : sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))),
       @eq (list (Ty.tySem (Word.Word (S (S (S O))))))
         match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
         | inl _ =>
             @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_asset_local_context_hashes.byte_zero
               (@nil (Ty.tySem (Word.Word (S (S (S O))))))
         | inr h =>
             @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_asset_local_context_hashes.byte_one
               (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
         end (jet_outpoint_middle_common.op_bytes a)
