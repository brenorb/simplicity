                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bx BinNums.Z0)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z br BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))))))
                           (and (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi md false (@nil BitMachine.Cell))
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block b bx))
                                    (and (not (@eq Values.block b br)) (not (@eq Values.block b bl)))) m0 md))))))))
