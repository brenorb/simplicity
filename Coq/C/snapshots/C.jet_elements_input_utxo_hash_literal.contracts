### C.jet_elements_input_utxo_hash_literal.literal_elements_input_utxo_hash
literal_elements_input_utxo_hash =
fun alg : EFP.Algebra =>
let term : Alg.Assertion.Algebra := EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod
     (Ty.Sum Ty.Unit
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     core (@jet_elements_amount_jets.elements_input_amount_spec alg)
     (@EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg jet_elements_prim.Elements.InputScriptHash))
  (@AC.case Ty.Unit jet_elements_asset_amount_hash_spec.elements_asset_amount_type
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@AC.injl (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@AC.unit (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core))
     (@AC.injr
        (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@AC.comp
           (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
           (@AC.pair
              (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@AC.comp
                 (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                    (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    jet_elements_asset_amount_hash_spec.elements_asset_amount_type)
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                 (@AC.pair
                    (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    jet_elements_asset_amount_hash_spec.elements_asset_amount_type core
                    (@AC.comp
                       (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                          (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
                       jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                       (@AC.unit
                          (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                             (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core)
                       (@jet_sha_hash_words_literal.literal_sha_hash_ctx_init core))
                    (@AC.take jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       jet_elements_asset_amount_hash_spec.elements_asset_amount_type core
                       (@AC.iden jet_elements_asset_amount_hash_spec.elements_asset_amount_type core)))
                 (@jet_elements_amounts_hash_literal.literal_elements_asset_amount_hash term))
              (@AC.drop jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_bitcoin_vh_hash_spec.assert_iden_spec (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)))
           (@AC.comp
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_sha_ctx8_literal.literal_ctx8_addn (S (S (S (S (S O))))) term)
              (@jet_sha_finalize_literal.literal_ctx8_finalize term)))))
     : forall alg : EFP.Algebra,
       EFP.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

