  (BinNums.Zpos
     (BinNums.xI
        (BinNums.xO
           (BinNums.xI
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
