### C.jet_bitcoin_build_tapbranch_spec.build_tapbranch_spec_value
build_tapbranch_spec_value
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@build_tapbranch_spec Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))
         (@SHA256.hashBlock Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))))
               (@SHA256.hashBlock Alg.CoreFunSem
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))) tapbranch_prefix
                     (tapbranch_order a b))) tb_padblock))
### C.jet_bitcoin_build_tapbranch_spec.tapbranch_prefix
tapbranch_prefix =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
  (BinNums.Zpos
     (BinNums.xO
        (BinNums.xI
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))))))))))))))))))
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))
### C.jet_bitcoin_build_tapbranch_spec.tapbranch_tag_word
tapbranch_tag_word =
