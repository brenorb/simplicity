### C.jet_bitcoin_build_tapbranch_spec.tapbranch_tag_bytes
tapbranch_tag_bytes =
@List.map BinNums.Z Integers.Int.int Integers.Int.repr
  (@cons BinNums.Z
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
     (@cons BinNums.Z
        (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
        (@cons BinNums.Z
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
           (@cons BinNums.Z
              (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
              (@cons BinNums.Z
                 (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                 (@cons BinNums.Z
                    (BinNums.Zpos
                       (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                    (@cons BinNums.Z
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                       (@cons BinNums.Z
                          (BinNums.Zpos
                             (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                          (@cons BinNums.Z
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                             (@nil BinNums.Z))))))))))
     : list Integers.Int.int
### C.jet_bitcoin_build_tapbranch_spec.tb_padblock
tb_padblock =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S (S O))))))))))
  (BinInt.Z.add
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos
           (BinNums.xI
              (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
     (BinNums.Zpos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
### C.jet_bitcoin_build_tapbranch_spec.build_tapbranch_spec
build_tapbranch_spec =
fun term : Alg.Core.Algebra =>
@AC.comp (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
  (@AC.pair (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) term
     (@AC.comp (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@AC.pair (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
           (@AC.comp
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
              (@AC.unit
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 term) (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) tapbranch_prefix term))
           (@AC.comp
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              term
              (@AC.pair
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.Sum Ty.Unit Ty.Unit)
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 term (@jet_order_spec.lt_word_spec term (S (S (S (S (S (S (S (S O)))))))))
                 (@AC.iden
                    (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term))
              (@Bit.cond
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 term
                 (@AC.iden
                    (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term)
                 (@AC.pair
                    (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                    (@AC.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                       (@AC.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))
                    (@AC.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                       (@AC.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)))))) (@SHA256.hashBlock term))
     (@AC.comp (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        Ty.Unit (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) term
        (@AC.unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           term) (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) tb_padblock term)))
  (@SHA256.hashBlock term)
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments build_tapbranch_spec {term}
### C.jet_bitcoin_build_tapbranch_spec.tapbranch_order
tapbranch_order =
fun a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
match
  BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
    (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
  return (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))))
with
| true =>
    @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b
| false =>
    @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) b a
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))

Arguments tapbranch_order a b
