### C.jet_bitcoin_build_tapbranch_spec.tapbranch_tag_block_bytes
tapbranch_tag_block_bytes
     : @eq (list BinNums.Z)
         (@List.map Integers.Int.int BinNums.Z Integers.Int.unsigned
            (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
               (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O)))))) tapbranch_tag_block)))
         (@List.map Integers.Int.int BinNums.Z Integers.Int.unsigned
            (@app Integers.Int.int tapbranch_tag_bytes
               (jet_sha_finalize_exec.sha_pad
