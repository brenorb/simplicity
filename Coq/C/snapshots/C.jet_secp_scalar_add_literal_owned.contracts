### C.jet_secp_scalar_add_literal_owned.eval_scalar_add_literal_owned
eval_scalar_add_literal_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_sx_state.rep rho layout jet_secp_scalar_add_run.scalar_add_initial_regs m)
         (_ : @eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem a)))
         (_ : @eq BinNums.Z
                (jet_secp_scalar_overflow_numeric.scalar_limb_value
                   (jet_secp_scalar_add_numeric.scalar_add_second_rho rho))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem b))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk layout (S O))
                           (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val)))) Events.E0 mf
               (Values.Vint
                  (jet_sx_expr.b2i
                     (BinInt.Z.leb jet_secp_canonical_scalar.canonical_group_order
                        (jet_secp_scalar_add_numeric.scalar_add_input_value rho)))))
            (and
               (jet_sx_state.rep
                  (jet_secp_scalar_get_b32_numeric.scalar_limb_rho
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@jet_secp_canonical_scalar_add.canonical_scalar_add Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
                  (@cons (prod Values.block BinNums.Z)
                     (@pair Values.block BinNums.Z (jet_sx_state.blk layout O) (jet_sx_state.bas layout O))
                     (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_writer_run.scalar_writer_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf (jet_sx_state.blk layout O) BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf (jet_sx_state.blk layout (S O)) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (jet_sx_mem.lframe
                        (fun (block : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot layout
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape jet_secp_scalar_add_run.scalar_add_initial_regs) block ofs)) m mf)))))
