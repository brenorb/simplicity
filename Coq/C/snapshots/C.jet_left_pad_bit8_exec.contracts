### C.jet_left_pad_bit8_exec.left_pad_bit8_decode
left_pad_bit8_decode
     : forall x : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit),
       @eq (Ty.tySem (Word.Word (S (S (S O)))))
         (jet_spec.decode_word8
            (Integers.Int64.repr (Integers.Int.unsigned (jet_readBit_layout.bit_int (Bit.toBool x)))))
         (@jet_spec.left_pad_low_1_n Alg.CoreFunSem (S (S (S O))) x)
### C.jet_left_pad_bit8_exec.eval_left_pad_bit8_composes
eval_left_pad_bit8_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc mr me mf : Memory.Mem.mem)
         (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (bit : bool) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc (@Ctypes.Internal Clight.function jets.f_readBit)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint (jet_readBit_layout.bit_int bit)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vint (jet_readBit_layout.bit_int bit)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_left_pad_low_1_8)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_left_pad_bit8_exec.le_left_pad_bit8
le_left_pad_bit8 =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (bit : bool) =>
@Maps.PTree.set Values.val jets._bit (Values.Vint (jet_readBit_layout.bit_int bit))
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vint (jet_readBit_layout.bit_int bit))
     (jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_left_pad_low_1_8 bd dofs bs sofs))
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : bool), Maps.PTree.tree Values.val

Arguments le_left_pad_bit8 env bd dofs bs sofs bit%bool_scope
