### C.jet_entropy_compose_shape.entropy_jet_body_shape
entropy_jet_body_shape
     : @eq Clight.statement (Clight.fn_body jets_elements.f_simplicity_calculate_issuance_entropy) entropy_jet_body
### C.jet_entropy_compose_shape.entropy_helper_symbol
entropy_helper_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            jets_elements._simplicity_generateIssuanceEntropy)
         (@Some Values.block
            (jet_elements_linkage.elements_symbol_block jets_elements._simplicity_generateIssuanceEntropy))
### C.jet_entropy_compose_shape.entropy_helper_funct
entropy_helper_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._simplicity_generateIssuanceEntropy)
               Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function)
            (@Ctypes.Internal Clight.function jets_elements.f_simplicity_generateIssuanceEntropy))
### C.jet_entropy_compose_shape.exec_entropy_helper
exec_entropy_helper
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bo bc bt : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._simplicity_generateIssuanceEntropy e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements.__res e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_entropy_compose_common.calc_mid)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._op e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bo jet_entropy_compose_inputs.entropy_op)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._contract e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_entropy_compose_common.calc_mid)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                (@Ctypes.Internal Clight.function jets_elements.f_simplicity_generateIssuanceEntropy)
                (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bo Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m entropy_helper_statement Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_entropy_compose_shape.entropy_function_composes
entropy_function_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 m5 : Memory.Mem.mem')
         (mcp mtx mi ms mr mt mc me mf : Memory.Mem.mem) (bl bo bc br bt bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (r : Integers.Int64.int)
         (bytes0 bytes1 : list Memdata.memval) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs)) (_ : not (@eq Values.block br bt))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bo))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 bc))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m4 br))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m4 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m5 bt))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m5 bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes0))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m5 bl BinNums.Z0 bytes0) (@Some Memory.Mem.mem mcp))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mcp
                (@Ctypes.Internal Clight.function jets_elements.f_read32s)
                (@cons Values.val (Values.Vptr bo Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mtx
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mtx
                (@Ctypes.Internal Clight.function jets_elements.f_simplicity_read32)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mi
                (Values.Vlong r))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mi bo
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                   (Values.Vlong r)) (@Some Memory.Mem.mem ms))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge ms
                (@Ctypes.Internal Clight.function jets_elements.f_read32s)
                (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mr
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mr
                (@Ctypes.Internal Clight.function jets_elements.f_simplicity_generateIssuanceEntropy)
                (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bo Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mt
                Values.Vundef)
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mt bt BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@Some (list Memdata.memval) bytes1))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mt br BinNums.Z0 bytes1) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mc
                (@Ctypes.Internal Clight.function jets_elements.f_writeHash)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free_list me
                   (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                      (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bo BinNums.Z0)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                      (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                         (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bc BinNums.Z0)
                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                               (@pair (prod Values.block BinNums.Z) BinNums.Z
                                  (@pair Values.block BinNums.Z bt BinNums.Z0)
                                  (BinNums.Zpos
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                  (@pair (prod Values.block BinNums.Z) BinNums.Z
                                     (@pair Values.block BinNums.Z br BinNums.Z0)
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
         (@Ctypes.Internal Clight.function jets_elements.f_simplicity_calculate_issuance_entropy)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_entropy_compose_shape.entropy_helper_type
entropy_helper_type =
Ctypes.Tfunction
  (Ctypes.Tcons jet_entropy_compose_common.calc_mid_ptr
     (Ctypes.Tcons (Ctypesdefs.tptr jet_entropy_compose_inputs.entropy_op)
        (Ctypes.Tcons jet_entropy_compose_common.calc_mid_ptr Ctypes.Tnil))) Ctypesdefs.tvoid
  jet_entropy_compose_common.calc_cc
     : Ctypes.type
### C.jet_entropy_compose_shape.entropy_helper_statement
entropy_helper_statement =
Clight.Scall (@None AST.ident) (Clight.Evar jets_elements._simplicity_generateIssuanceEntropy entropy_helper_type)
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements.__res jet_entropy_compose_common.calc_mid)
        jet_entropy_compose_common.calc_mid_ptr)
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_elements._op jet_entropy_compose_inputs.entropy_op)
           (Ctypesdefs.tptr jet_entropy_compose_inputs.entropy_op))
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_elements._contract jet_entropy_compose_common.calc_mid)
              jet_entropy_compose_common.calc_mid_ptr) (@nil Clight.expr))))
     : Clight.statement
### C.jet_entropy_compose_shape.entropy_jet_body
entropy_jet_body =
Clight.Ssequence jet_entropy_compose_common.calc_copy_src
  (Clight.Ssequence (jet_entropy_compose_inputs.entropy_read_array jet_entropy_compose_inputs.entropy_txid_array)
     (Clight.Ssequence
        (Clight.Ssequence jet_entropy_compose_inputs.entropy_read_index jet_entropy_compose_inputs.entropy_store_index)
        (Clight.Ssequence
           (jet_entropy_compose_inputs.entropy_read_array jet_entropy_compose_inputs.entropy_contract_array)
           (Clight.Ssequence (Clight.Ssequence entropy_helper_statement jet_entropy_compose_common.calc_copy_result)
              (Clight.Ssequence jet_entropy_compose_common.calc_write
                 (Clight.Sreturn
                    (@Some Clight.expr
                       (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint))))))))
     : Clight.statement
