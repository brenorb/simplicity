### C.jet_elements_output_proof_literal.haskell_confidential_proof_view
haskell_confidential_proof_view =
fun (A : Set) (c : jet_elements_prim.confidential (list Integers.Byte.int) A) =>
match c return (list Integers.Byte.int) with
| jet_elements_prim.Explicit _ => @nil Integers.Byte.int
| jet_elements_prim.Confidential _ proof => proof
end
     : forall (A : Set) (_ : jet_elements_prim.confidential (list Integers.Byte.int) A), list Integers.Byte.int

Arguments haskell_confidential_proof_view {A}%type_scope c
