elements_output_proof_digest_literal_spec =
fun proof_of : forall _ : jet_elements_prim.txOutput, list Integers.Byte.int =>
@jet_elements_indexed_literal.elements_indexed_literal_result jet_elements_prim.Elements.environment
  jet_elements_prim.txOutput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (fun e : jet_elements_prim.Elements.environment => jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx e))
  (fun txo : jet_elements_prim.txOutput =>
   jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
     (jet_haskell_hash_word.haskell_integer_hash256 (Digest.hash256_to_bytelist (Digest.byteStringHash (proof_of txo)))))
     : forall (_ : forall _ : jet_elements_prim.txOutput, list Integers.Byte.int)
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.environment),
       option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

