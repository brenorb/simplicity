### C.jet_elements_output_proof_literal.haskell_confidential_proof_view_matches
@haskell_confidential_proof_view_matches
     : forall (A : Set) (c : jet_elements_prim.confidential (list Integers.Byte.int) A),
       @eq (list Integers.Byte.int) (@jet_elements_prim.viewPrf A c) (@haskell_confidential_proof_view A c)
### C.jet_elements_output_proof_literal.elements_output_proof_digest_literal_matches
elements_output_proof_digest_literal_matches
     : forall (proof_of : forall _ : jet_elements_prim.txOutput, list Integers.Byte.int)
         (a : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
         (environment : jet_elements_prim.Elements.environment),
       @eq (option (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            match
              @List.nth_error jet_elements_prim.txOutput
                (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
                (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
              return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            with
            | Some txo =>
                @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.from_hash256 (Digest.byteStringHash (proof_of txo)))
            | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
            end) (elements_output_proof_digest_literal_spec proof_of a environment)
