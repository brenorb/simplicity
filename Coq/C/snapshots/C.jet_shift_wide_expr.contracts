### C.jet_shift_wide_expr.shift_wide_helper_body
shift_wide_helper_body
     : forall (s : jet_wide.wide_size) (right : bool),
       @eq Clight.statement (Clight.fn_body (shift_wide_helper s right))
         (Clight.Ssequence
            (Clight.Ssequence (shift_wide_count_reader s)
               (Clight.Sset jets._amt (Clight.Ecast (Clight.Etempvar jets._t'1 Ctypesdefs.tuchar) Ctypesdefs.tuchar)))
            (Clight.Ssequence
               (Clight.Ssequence (shift_wide_payload_reader s)
                  (Clight.Sset jets._output (Clight.Etempvar jets._t'2 Ctypesdefs.tulong)))
               (Clight.Ssequence (shift_wide_fill_step s)
                  (Clight.Ssequence
                     (Clight.Sifthenelse (shift_wide_count_expr s)
                        (Clight.Sset jets._output (shift_wide_scalar_expr right))
                        (Clight.Sset jets._output
                           (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Ctypesdefs.tulong)))
                     (Clight.Ssequence (shift_wide_fill_step s)
                        (Clight.Scall (@None AST.ident)
                           (Clight.Evar (jet_wide.wide_writer_id s)
                              (Ctypes.Tfunction
                                 (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
                                    (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
                           (@cons Clight.expr
                              (Clight.Etempvar jets._dst
                                 (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
                              (@cons Clight.expr (Clight.Etempvar jets._output Ctypesdefs.tulong) (@nil Clight.expr)))))))))
### C.jet_shift_wide_expr.eval_shift_wide_scalar_expr
eval_shift_wide_scalar_expr
     : forall (right : bool) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (r : Integers.Int64.int) (a : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._output le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._amt le) (@Some Values.val (Values.Vint a))),
       Clight.eval_expr jet_exec.ge0 e le m (shift_wide_scalar_expr right)
         (Values.Vlong (shift_wide_scalar_result right r a))
### C.jet_shift_wide_expr.eval_shift_wide_fill_expr
eval_shift_wide_fill_expr
     : forall (s : jet_wide.wide_size) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (r : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._output le) (@Some Values.val (Values.Vlong r))),
       Clight.eval_expr jet_exec.ge0 e le m (shift_wide_fill_expr s) (Values.Vlong (shift_wide_fill_result s r))
### C.jet_shift_wide_expr.eval_shift_wide_count_expr
eval_shift_wide_count_expr
     : forall (s : jet_wide.wide_size) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (a : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._amt le) (@Some Values.val (Values.Vint a))),
       Clight.eval_expr jet_exec.ge0 e le m (shift_wide_count_expr s)
         (Values.Vint
            match Coqlib.zlt (Integers.Int.unsigned a) (jet_wide.wide_bits s) return Integers.Int.int with
            | left _ => Integers.Int.one
            | right _ => Integers.Int.zero
            end)
### C.jet_shift_wide_expr.shift_wide_helper
shift_wide_helper =
fun (s : jet_wide.wide_size) (right : bool) =>
match s return Clight.function with
| jet_wide.W16 =>
    match right return Clight.function with
    | true => jets.f_right_shift_helper_16
    | false => jets.f_left_shift_helper_16
    end
| jet_wide.W32 =>
    match right return Clight.function with
    | true => jets.f_right_shift_helper_32
    | false => jets.f_left_shift_helper_32
    end
| jet_wide.W64 =>
    match right return Clight.function with
    | true => jets.f_right_shift_helper_64
    | false => jets.f_left_shift_helper_64
    end
end
     : forall (_ : jet_wide.wide_size) (_ : bool), Clight.function

Arguments shift_wide_helper s right%bool_scope
### C.jet_shift_wide_expr.shift_wide_scalar_expr
shift_wide_scalar_expr =
fun right : bool =>
Clight.Ecast
  match right return Clight.expr with
  | true =>
      Clight.Ebinop Cop.Oshr (Clight.Etempvar jets._output Ctypesdefs.tulong)
        (Clight.Etempvar jets._amt Ctypesdefs.tuchar) Ctypesdefs.tulong
  | false =>
      Clight.Ebinop Cop.Oshl
        (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
           (Clight.Etempvar jets._output Ctypesdefs.tulong) Ctypesdefs.tulong)
        (Clight.Etempvar jets._amt Ctypesdefs.tuchar) Ctypesdefs.tulong
  end Ctypesdefs.tulong
     : forall _ : bool, Clight.expr

Arguments shift_wide_scalar_expr right%bool_scope
### C.jet_shift_wide_expr.shift_wide_scalar_result
shift_wide_scalar_result =
fun (right : bool) (r : Integers.Int64.int) (a : Integers.Int.int) =>
match right return Integers.Int64.int with
| true => Integers.Int64.shru r (Integers.Int64.repr (Integers.Int.unsigned a))
| false => Integers.Int64.shl r (Integers.Int64.repr (Integers.Int.unsigned a))
end
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Integers.Int.int), Integers.Int64.int

Arguments shift_wide_scalar_result right%bool_scope r a
### C.jet_shift_wide_expr.shift_wide_fill_constant
shift_wide_fill_constant =
fun s : jet_wide.wide_size =>
match s return Clight.expr with
| jet_wide.W16 =>
    Clight.Econst_int
      (Integers.Int.repr
         (BinNums.Zpos
            (BinNums.xI
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
      Ctypesdefs.tint
| jet_wide.W32 => Clight.Econst_int Integers.Int.mone Ctypesdefs.tuint
| jet_wide.W64 => Clight.Econst_long Integers.Int64.mone Ctypesdefs.tulong
end
     : forall _ : jet_wide.wide_size, Clight.expr

Arguments shift_wide_fill_constant s
### C.jet_shift_wide_expr.shift_wide_fill_mask
shift_wide_fill_mask =
fun s : jet_wide.wide_size =>
match s return Integers.Int64.int with
| jet_wide.W16 =>
    Integers.Int64.repr
      (BinNums.Zpos
         (BinNums.xI
            (BinNums.xI
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))))))
| jet_wide.W32 =>
    Integers.Int64.repr
      (BinNums.Zpos
         (BinNums.xI
            (BinNums.xI
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))))))
| jet_wide.W64 => Integers.Int64.mone
end
     : forall _ : jet_wide.wide_size, Integers.Int64.int

Arguments shift_wide_fill_mask s
### C.jet_shift_wide_expr.shift_wide_fill_expr
shift_wide_fill_expr =
fun s : jet_wide.wide_size =>
Clight.Ebinop Cop.Oxor (shift_wide_fill_constant s) (Clight.Etempvar jets._output Ctypesdefs.tulong) Ctypesdefs.tulong
     : forall _ : jet_wide.wide_size, Clight.expr

Arguments shift_wide_fill_expr s
### C.jet_shift_wide_expr.shift_wide_fill_result
shift_wide_fill_result =
fun (s : jet_wide.wide_size) (r : Integers.Int64.int) => Integers.Int64.xor (shift_wide_fill_mask s) r
     : forall (_ : jet_wide.wide_size) (_ : Integers.Int64.int), Integers.Int64.int

Arguments shift_wide_fill_result s r
### C.jet_shift_wide_expr.shift_wide_count_expr
shift_wide_count_expr =
fun s : jet_wide.wide_size =>
Clight.Ebinop Cop.Olt (Clight.Etempvar jets._amt Ctypesdefs.tuchar)
  (Clight.Econst_int (Integers.Int.repr (jet_wide.wide_bits s)) Ctypesdefs.tint) Ctypesdefs.tint
     : forall _ : jet_wide.wide_size, Clight.expr

Arguments shift_wide_count_expr s
### C.jet_shift_wide_expr.shift_wide_count_reader
shift_wide_count_reader =
fun s : jet_wide.wide_size =>
jet_shift8_expr.shift8_reader
  match s return bool with
  | jet_wide.W16 => true
  | jet_wide.W32 => false
  | jet_wide.W64 => false
  end jets._t'1
     : forall _ : jet_wide.wide_size, Clight.statement

Arguments shift_wide_count_reader s
### C.jet_shift_wide_expr.shift_wide_payload_reader
shift_wide_payload_reader =
fun s : jet_wide.wide_size =>
Clight.Scall (@Some AST.ident jets._t'2)
  (Clight.Evar (jet_wide.wide_reader_id s)
     (Ctypes.Tfunction (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)) Ctypes.Tnil)
        Ctypesdefs.tulong AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._src (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
     (@nil Clight.expr))
     : forall _ : jet_wide.wide_size, Clight.statement

Arguments shift_wide_payload_reader s
### C.jet_shift_wide_expr.shift_wide_fill_step
shift_wide_fill_step =
fun s : jet_wide.wide_size =>
Clight.Sifthenelse (Clight.Etempvar jets._with Ctypesdefs.tbool) (Clight.Sset jets._output (shift_wide_fill_expr s))
  Clight.Sskip
     : forall _ : jet_wide.wide_size, Clight.statement

Arguments shift_wide_fill_step s
