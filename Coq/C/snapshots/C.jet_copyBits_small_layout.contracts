### C.jet_copyBits_small_layout.copy_small_aligned_low
copy_small_aligned_low
     : forall (edge cursor n : BinNums.Z)
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                BinNums.Z0)
         (_ : and (BinInt.Z.lt BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq BinNums.Z
         (BinInt.Z.add edge
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
               (BinInt.Z.div (BinInt.Z.sub cursor n)
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (jet_write_layout.write_word_address edge cursor)
