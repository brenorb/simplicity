### C.jet_secp_zinv_coordinate.exec_zinv_coordinate
exec_zinv_coordinate
     : forall (y : bool) (w a t : forall _ : nat, Integers.Int64.int)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bp ba bc bo bz : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   match y return BinNums.positive with
                   | true => jets_secp._s1
                   | false => jets_secp._u1
                   end e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   match y return BinNums.positive with
                   | true => jets_secp._s2
                   | false => jets_secp._u2
                   end e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bo jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._z12 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bz jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalize_weak e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bp
                   (@cons Values.block ba
                      (@cons Values.block bc (@cons Values.block bo (@cons Values.block bz (@nil Values.block)))))))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (w i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : jet_secp_square_columns.square_input_bounds a) (_ : jet_secp_square_columns.square_input_bounds t)
         (_ : jet_secp_fe_nv.fe_at m bp (jet_secp_curve_square.curve_square_offset y)
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_secp_fe_nv.fe_at m ba (jet_secp_curve_square.curve_square_offset y)
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : jet_secp_fe_nv.fe_at m bz BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 t))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence (zinv_coordinate_statements y) Clight.Sskip) Events.E0 le
               mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bp (jet_secp_curve_square.curve_square_offset y)
                  (jet_secp_multiply_normalize_bridge.words5 w))
               (and
                  (jet_secp_fe_nv.fe_at mf ba (jet_secp_curve_square.curve_square_offset y)
                     (jet_secp_multiply_normalize_bridge.words5 a))
                  (and (jet_secp_fe_nv.fe_at mf bz BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 t))
                     (and
                        (jet_secp_fe_nv.fe_at mf bc BinNums.Z0
                           (jet_secp_multiply_normalize_bridge.words5 (jet_secp_field_weak_loose.weak_loose_words w)))
                        (and
                           (jet_secp_fe_nv.fe_at mf bo BinNums.Z0
                              (jet_secp_multiply_normalize_bridge.words5
                                 (jet_secp_point_mul_storage.point_mul_words a t)))
                           (and
                              (Memory.Mem.range_perm mf bp BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf ba BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bc BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (Memory.Mem.range_perm mf bo BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (Memory.Mem.range_perm mf bz BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (@eq BinNums.Z
                                                (BinInt.Z.modulo
                                                   (jet_secp_multiply_finish_product.radix_value
                                                      (jet_secp_field_weak_loose.weak_loose_words w))
                                                   jet_secp_fe_math.feP)
                                                (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w)
                                                   jet_secp_fe_math.feP))
                                             (and
                                                (jet_secp_field_mul_small.mul_small_input_bounds
                                                   (jet_secp_field_weak_loose.weak_loose_words w))
                                                (and
                                                   (@eq BinNums.Z
                                                      (BinInt.Z.modulo
                                                         (jet_secp_multiply_finish_product.radix_value
                                                            (jet_secp_point_mul_storage.point_mul_words a t))
                                                         jet_secp_fe_math.feP)
                                                      (BinInt.Z.modulo
                                                         (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                                                            (jet_secp_multiply_finish_product.radix_value t))
                                                         jet_secp_fe_math.feP))
                                                   (and
                                                      (jet_secp_square_columns.square_input_bounds
                                                         (jet_secp_point_mul_storage.point_mul_words a t))
                                                      (jet_sx_mem.lframe (zinv_coordinate_frame y bc bo ba bz) m mf))))))))))))))))
### C.jet_secp_zinv_coordinate.zinv_coordinate_statements
zinv_coordinate_statements =
fun y : bool =>
@cons Clight.statement (jet_secp_mixed_copy_weak.mixed_copy_coordinate y)
  (@cons Clight.statement (jet_secp_mixed_copy_weak.mixed_weak_coordinate y)
     (@cons Clight.statement (jet_secp_mixed_affine_product.mixed_affine_call y) (@nil Clight.statement)))
     : forall _ : bool, list Clight.statement

Arguments zinv_coordinate_statements y%bool_scope
### C.jet_secp_zinv_coordinate.zinv_coordinate_frame
zinv_coordinate_frame =
fun (y : bool) (bc bo ba bz bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bc))
  (and (not (@eq Values.block bx bo))
     (and (not (@eq Values.block bx bz))
        (or (not (@eq Values.block bx ba))
           (or (BinInt.Z.lt pos (jet_secp_curve_square.curve_square_offset y))
              (BinInt.Z.le
                 (BinInt.Z.add (jet_secp_curve_square.curve_square_offset y)
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))))
     : forall (_ : bool) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments zinv_coordinate_frame y%bool_scope bc bo ba bz bx pos%Z_scope
