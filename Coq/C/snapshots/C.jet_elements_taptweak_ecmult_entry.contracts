                (Ctypes.type_of_params (Clight.fn_params jets_secp.f_secp256k1_ecmult_strauss_wnaf)) vargs)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ecmult_strauss_wnaf) vargs Events.E0 mf v),
       ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
