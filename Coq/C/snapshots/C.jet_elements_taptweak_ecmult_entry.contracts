elements_taptweak_ecmult_env_bound
     : forall (bx ba bp bs : Values.block) (id : AST.ident)
         (_ : @List.In AST.ident id
                (@List.map (prod AST.ident Ctypes.type) AST.ident (@fst AST.ident Ctypes.type)
