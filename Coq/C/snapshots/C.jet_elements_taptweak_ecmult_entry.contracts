### C.jet_elements_taptweak_ecmult_entry.elements_taptweak_ecmult_entry_and_state
elements_taptweak_ecmult_entry_and_state
     : forall (m : Memory.Mem.mem) (r a na ng : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex Values.block
               (fun bx : Values.block =>
                @ex Values.block
                  (fun ba : Values.block =>
                   @ex Values.block
                     (fun bp : Values.block =>
                      @ex Values.block
                        (fun bs : Values.block =>
                         and
                           (Clight.function_entry2 jet_elements_taptweak_pure.elements_taptweak_ge
                              jets_secp.f_secp256k1_ecmult
                              (@cons Values.val r
                                 (@cons Values.val a (@cons Values.val na (@cons Values.val ng (@nil Values.val))))) m
                              (jet_secp_ecmult_entry.ecmult_env bx ba bp bs)
                              (jet_secp_ecmult_entry.ecmult_temps r a na ng) mi)
                           (and
                              (ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge
                                 (jet_secp_ecmult_entry.ecmult_env bx ba bp bs)
                                 (jet_secp_ecmult_entry.ecmult_temps r a na ng) mi
                                 jet_secp_ecmult_state.ecmult_state_initialize Events.E0
                                 (jet_secp_ecmult_entry.ecmult_temps r a na ng) mf ClightBigstep.Out_normal)
                              (and
                                 (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bs BinNums.Z0)
                                    (@Some Values.val (Values.Vptr bx Integers.Ptrofs.zero)))
                                 (and
                                    (@eq (option Values.val)
                                       (Memory.Mem.load AST.Mptr mf bs
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                       (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
                                    (and
                                       (@eq (option Values.val)
                                          (Memory.Mem.load AST.Mptr mf bs
                                             (BinNums.Zpos
                                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                          (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
                                       (and
                                          (@List.NoDup Values.block
                                             (@cons Values.block bx
                                                (@cons Values.block ba
                                                   (@cons Values.block bp (@cons Values.block bs (@nil Values.block))))))
                                          (and
                                             (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                              not
                                                (@List.In Values.block b
                                                   (@cons Values.block bx
                                                      (@cons Values.block ba
                                                         (@cons Values.block bp
                                                            (@cons Values.block bs (@nil Values.block)))))))
                                             (and
                                                (forall (b : Values.block) (hi : BinNums.Z)
                                                   (_ : @List.In (prod Values.block BinNums.Z)
                                                          (@pair Values.block BinNums.Z b hi)
                                                          (@cons (prod Values.block BinNums.Z)
                                                             (@pair Values.block BinNums.Z bx
                                                                (BinNums.Zpos (BinNums.xO ...)))
                                                             (@cons (prod Values.block BinNums.Z)
                                                                (@pair Values.block BinNums.Z ba (BinNums.Zpos ...))
                                                                (@cons (prod Values.block BinNums.Z)
                                                                   (@pair Values.block BinNums.Z bp ...)
                                                                   (@cons ... ... ...))))),
                                                 Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                                                (Memory.Mem.unchanged_on
                                                   (fun (_ : Values.block) (_ : BinNums.Z) => True) m mf))))))))))))))
