### C.jet_secp_split_multipliers.split_coefficient
split_coefficient =
fun (first : bool) (k : BinNums.Z) =>
BinInt.Z.div
  (BinInt.Z.add (BinInt.Z.mul k (split_multiplier_value first))
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos
           (BinNums.xI
              (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
     (BinNums.Zpos
        (BinNums.xO
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
     : forall (_ : bool) (_ : BinNums.Z), BinNums.Z

