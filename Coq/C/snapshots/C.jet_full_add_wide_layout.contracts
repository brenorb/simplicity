full_add16_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_full_add_16
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S O))))))
         (fun
