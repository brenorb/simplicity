### C.jet_full_add_wide_layout.eval_wide_full_add_layout_matches_spec
eval_wide_full_add_layout_matches_spec
     : forall (env : Values.val) (s : jet_wide.wide_size) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (x y : Ty.tySem (Word.Word (jet_wide.wide_log s))) (cursor rc : BinNums.Z)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (jet_wide.wide_bits s))))))
         (_ : jet_input_layout.frame_input_bit_at m bi edge rc (Bit.toBool c))
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge
                (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) x)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge
                (BinInt.Z.add (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) (jet_wide.wide_bits s)) y)
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.add (BinNums.Zpos BinNums.xH) (jet_wide.wide_bits s))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function (jet_full_add_wide_exec.wide_full_add s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (jet_encoding.frame_output_cells_at mf bw outedge cursor
                  (@Translate.encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (jet_wide.wide_log s)))
                     (@jet_full_add_wide_word.wide_full_add_spec s Alg.CoreFunSem
                        (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                           (prod (Ty.tySem (Word.Word (jet_wide.wide_log s)))
                              (Ty.tySem (Word.Word (jet_wide.wide_log s)))) c
                           (@pair (Ty.tySem (Word.Word (jet_wide.wide_log s)))
                              (Ty.tySem (Word.Word (jet_wide.wide_log s))) x y)))))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.add (BinNums.Zpos BinNums.xH) (jet_wide.wide_bits s))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.add (BinNums.Zpos BinNums.xH) (jet_wide.wide_bits s)))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_full_add_wide_layout.wide_full_add_local_spec
wide_full_add_local_spec
     : forall s : jet_wide.wide_size,
       jet_bitmachine_rep.jet_local_spec (jet_full_add_wide_exec.wide_full_add s)
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
            (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (jet_wide.wide_log s)))
         (fun
            cxy : Ty.tySem
                    (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
                       (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s)))) =>
          @jet_full_add_wide_word.wide_full_add_spec s Alg.CoreFunSem cxy)
