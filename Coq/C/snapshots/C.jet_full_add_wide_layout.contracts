### C.jet_full_add_wide_layout.full_add64_local_spec
full_add64_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_full_add_64
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
