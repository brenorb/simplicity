### C.jet_secp_ge_storage_function.eval_ge_to_storage_owned
eval_ge_to_storage_owned
     : forall (wx wy : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bin bout : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds wx) (_ : jet_secp_square_columns.square_input_bounds wy)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 wx))
         (_ : jet_secp_fe_nv.fe_at m bin
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 wy))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_to_storage)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_affine_storage.affine_storage_readable mf bout BinNums.Z0
                  (jet_secp_ge_storage_body.ge_storage_words wx wy))
               (and
                  (@eq BinNums.Z
                     (jet_secp_storage_numeric.field_storage_value (jet_secp_ge_storage_body.ge_storage_words wx wy))
                     (jet_secp_fe_inv_prefix.fe_inv_value wx))
                  (and
                     (@eq BinNums.Z
                        (jet_secp_storage_numeric.field_storage_value
                           (fun i : nat =>
                            jet_secp_ge_storage_body.ge_storage_words wx wy (Nat.add (S (S (S (S O)))) i)))
                        (jet_secp_fe_inv_prefix.fe_inv_value wy))
                     (and
                        (Memory.Mem.range_perm mf bout BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout))
                              m mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))
