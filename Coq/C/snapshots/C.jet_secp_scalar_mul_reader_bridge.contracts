### C.jet_secp_scalar_mul_reader_bridge.scalar_mul_reader_input_values
scalar_mul_reader_input_values
     : forall (va vb : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 va)
                (BinInt.Z.lt va
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 vb)
                (BinInt.Z.lt vb
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       and (@eq BinNums.Z (jet_secp_scalar_mul512_low.scalar_mul512_input_value (scalar_mul_reader_rho va vb) O) va)
         (@eq BinNums.Z
            (jet_secp_scalar_mul512_low.scalar_mul512_input_value (scalar_mul_reader_rho va vb) (S (S (S (S O))))) vb)
### C.jet_secp_scalar_mul_reader_bridge.scalar_mul_normalized_input_values
scalar_mul_normalized_input_values
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (@eq BinNums.Z (jet_secp_scalar_mul512_low.scalar_mul512_input_value (scalar_mul_normalized_rho a b) O)
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem a)))
         (@eq BinNums.Z
            (jet_secp_scalar_mul512_low.scalar_mul512_input_value (scalar_mul_normalized_rho a b) (S (S (S (S O)))))
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem b)))
### C.jet_secp_scalar_mul_reader_bridge.scalar_mul_initial_rep_from_storage
scalar_mul_initial_rep_from_storage
     : forall (va vb : BinNums.Z) (m : Memory.Mem.mem) (ba bb : Values.block)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of va)))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of vb)))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block ba bb)),
       jet_sx_state.rep (scalar_mul_reader_rho va vb)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) jet_secp_scalar_mul_caller_alloc.scalar_mul_caller_inputs m
### C.jet_secp_scalar_mul_reader_bridge.scalar_mul_reader_rho
scalar_mul_reader_rho =
fun (va vb : BinNums.Z) (n : nat) =>
match PeanoNat.Nat.ltb n (S (S (S (S O)))) return Integers.Int64.int with
| true => jet_secp_scalar_get_b32_numeric.scalar_limb_rho va n
| false => jet_secp_scalar_get_b32_numeric.scalar_limb_rho vb (Nat.sub n (S (S (S (S O)))))
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : nat), Integers.Int64.int

Arguments scalar_mul_reader_rho (va vb)%Z_scope n%nat_scope
### C.jet_secp_scalar_mul_reader_bridge.scalar_mul_normalized_rho
scalar_mul_normalized_rho =
fun a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
scalar_mul_reader_rho
  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
     (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem a))
  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
     (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem b))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : nat), Integers.Int64.int

Arguments scalar_mul_normalized_rho a b n%nat_scope
