### C.jet_secp_scalar_square512_run.scalar_square512_completes
scalar_square512_completes
     : @eq bool
         match scalar_square512_run return bool with
         | Some r =>
             match r return bool with
             | jet_sx_exec.RDone _ o =>
                 match o return bool with
                 | jet_sx_exec.ONormal => true
                 | jet_sx_exec.OBreak => false
                 | jet_sx_exec.OContinue => false
                 | jet_sx_exec.OReturn _ => false
                 end
             | jet_sx_exec.RIf _ _ _ => false
             end
         | None => false
         end true
### C.jet_secp_scalar_square512_run.scalar_square512_run_eq
scalar_square512_run_eq
     : @eq (option jet_sx_exec.res) scalar_square512_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone scalar_square512_state jet_sx_exec.ONormal))
### C.jet_secp_scalar_square512_run.scalar_square512_return
scalar_square512_return
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_square512_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_scalar_square512_run.scalar_square512_log_nil
scalar_square512_log_nil
     : @eq (list jet_sx_eval.event) (jet_sx_eval.slog scalar_square512_state) (@nil jet_sx_eval.event)
### C.jet_secp_scalar_square512_run.scalar_square512_output
scalar_square512_output
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs scalar_square512_state) scalar_square512_output_regs
### C.jet_secp_scalar_square512_run.eval_scalar_square512_fresh
eval_scalar_square512_fresh
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta scalar_square512_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho beta scalar_square512_output_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (jet_sx_state.foot beta
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape scalar_square512_regs) b ofs)) m mf)))
### C.jet_secp_scalar_square512_run.square512_rename
square512_rename = fun n : nat => PeanoNat.Nat.modulo n (S (S (S (S O))))
     : forall _ : nat, nat

Arguments square512_rename n%nat_scope
### C.jet_secp_scalar_square512_run.scalar_square512_regs
scalar_square512_regs =
@cons jet_sx_state.region
  (@List.hd jet_sx_state.region (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))
     jet_secp_scalar_mul512_fresh.scalar_mul512_fresh_regs)
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (jet_sx_rep.u64_cells BinNums.Z0
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx)))))) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@nil jet_sx_state.region))
     : list jet_sx_state.region
### C.jet_secp_scalar_square512_run.scalar_square512_run
scalar_square512_run =
jet_sx_compact.compact_fun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_scalar_mul512_run.scalar_mul512_functions)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_scalar_mul_512
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
     (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0)
        (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx)))) scalar_square512_regs
  (@nil jet_sx_eval.event) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))
     : option jet_sx_exec.res
### C.jet_secp_scalar_square512_run.scalar_square512_state
scalar_square512_state =
match scalar_square512_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_scalar_square512_run.scalar_square512_limbs
scalar_square512_limbs =
@List.map jet_sx_expr.sx jet_sx_expr.sx (jet_sx_rename.sx_rename square512_rename)
  jet_secp_scalar_mul512_run.scalar_mul512_limbs
     : list jet_sx_expr.sx
### C.jet_secp_scalar_square512_run.scalar_square512_output_regs
scalar_square512_output_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 scalar_square512_limbs) true
     (@Some BinNums.Z
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (jet_sx_rep.u64_cells BinNums.Z0
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx)))))) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@nil jet_sx_state.region))
     : list jet_sx_state.region
