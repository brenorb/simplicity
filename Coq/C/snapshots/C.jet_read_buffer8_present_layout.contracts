### C.jet_read_buffer8_present_layout.exec_buffer8_read_present_layout
exec_buffer8_read_present_layout
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
         (bo : Values.block) (output : BinNums.Z) (bl : Values.block) (slot count : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S O))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._read8s e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._buf le)
                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._len le)
                (@Some Values.val (Values.Vptr bl (Integers.Ptrofs.repr slot))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val
                   (Values.Vlong
                      (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))))
         (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))
                Integers.Ptrofs.max_unsigned)
         (_ : and (BinInt.Z.le BinNums.Z0 slot) (BinInt.Z.le slot Integers.Ptrofs.max_unsigned))
         (_ : and (BinInt.Z.le BinNums.Z0 count) (BinInt.Z.le count Integers.Int64.max_unsigned))
         (_ : Memory.Mem.range_perm m bo output
                (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) Memtype.Cur
                Memtype.Writable) (_ : Memory.Mem.valid_access m AST.Mint64 bl slot Memtype.Writable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bl slot)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr count)))) (_ : not (@eq Values.block bf bo))
         (_ : not (@eq Values.block bf bi)) (_ : not (@eq Values.block bo bi)) (_ : not (@eq Values.block bl bf))
         (_ : not (@eq Values.block bl bo)) (_ : jet_frame_layout.frame_base_valid base)
         (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))) Integers.Int64.max_unsigned)
         (_ : jet_frame_layout.frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge cursor
                (@List.concat BitMachine.Cell
                   (@List.map (Ty.tySem (Word.Word (S (S (S O))))) (list BitMachine.Cell)
                      (@Translate.encode (Word.Word (S (S (S O))))) xs))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m jet_read_buffer8_exec.buffer8_read_present Events.E0
               (jet_read_buffer8_exec.buffer8_read_present_temps le bo
                  (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) count) mf
               ClightBigstep.Out_normal)
            (and
               (jet_read8s_layout.uint8_array_at mf bo output
                  (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
                     xs))
               (and
                  (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bl slot)
                     (@Some Values.val
                        (Values.Vlong
                           (Integers.Int64.repr
                              (BinInt.Z.add count (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))))))
                  (and
                     (jet_frame_layout.frame_fields_at mf bf base bi edge
                        (BinInt.Z.add cursor
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))))
                     (and
                        (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                           (_ : or (not (@eq Values.block b bf))
                                  (or
                                     (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                        (BinInt.Z.add base
                                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     (BinInt.Z.le
                                        (BinInt.Z.add base
                                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                        ofs)))
                           (_ : or (not (@eq Values.block b bo))
                                  (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) output)
                                     (BinInt.Z.le
                                        (BinInt.Z.add output
                                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) ofs)))
                           (_ : or (not (@eq Values.block b bl))
                                  (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) slot)
                                     (BinInt.Z.le
                                        (BinInt.Z.add slot
                                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                         @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
