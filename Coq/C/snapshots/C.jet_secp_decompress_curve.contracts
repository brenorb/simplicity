### C.jet_secp_decompress_curve.decompress_root_success_curve
decompress_root_success_curve
     : forall (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_root_chain_numeric.root_words_match w x)
         (_ : @eq bool (jet_secp_root_check.root_check_flag (jet_secp_decompress_numeric.decompress_root_words w)) true),
       @eq bool
         (Bit.toBool
            (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x
                  (jet_secp_rescale_literal.rescale_field_output
                     (jet_secp_root_chain_numeric.root_chain_candidate
                        (jet_secp_decompress_numeric.decompress_root_words w)))))) true
### C.jet_secp_decompress_curve.decompress_negated_y_curve
decompress_negated_y_curve
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (Bit.toBool
            (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x
                  (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem y))))
         (Bit.toBool
            (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y)))
### C.jet_secp_decompress_curve.decompress_normalized_input_match
decompress_normalized_input_match
     : forall (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_root_chain_numeric.root_words_match w x),
       jet_secp_root_chain_numeric.root_words_match w
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
