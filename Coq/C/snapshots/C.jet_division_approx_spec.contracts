         (_ : BinInt.Z.le (jet_predicate_spec.word_modulus (S n))
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (@Word.ToZ.Theory.toZ (Word.WordToZ (S n))
                      (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) b1 b2))))
         (_ : BinInt.Z.lt
                (BinInt.Z.add
                   (BinInt.Z.mul
                      (BinInt.Z.add
                         (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ n) a1) (jet_predicate_spec.word_modulus n))
                         (@Word.ToZ.Theory.toZ (Word.WordToZ n) a2)) (jet_predicate_spec.word_modulus n))
                   (@Word.ToZ.Theory.toZ (Word.WordToZ n) a3))
                (BinInt.Z.mul
                   (@Word.ToZ.Theory.toZ (Word.WordToZ (S n))
                      (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) b1 b2))
                   (jet_predicate_spec.word_modulus n))),
       let z : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S n))) :=
         @jet_division_core_spec.div3n2n_approx_spec n Alg.CoreFunSem rec
           (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) (Ty.tySem (Word.Word n))
              (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a1 a2) b1) in
       and
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) a1 a2))
            (BinInt.Z.add
               (BinInt.Z.add
                  (BinInt.Z.mul
                     (@Word.ToZ.Theory.toZ (Word.WordToZ n)
                        (@fst
                           ((fix tySem (X : Ty.Ty) : Set :=
                               match X return Set with
                               | Ty.Unit => unit
                               | Ty.Sum A B => sum (tySem A) (tySem B)
                               | Ty.Prod A B => prod (tySem A) (tySem B)
                               end)
                              ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                  match n0 return Ty.Ty with
                                  | O => X
                                  | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                  end) (Ty.Sum Ty.Unit Ty.Unit) n))
                           ((fix tySem (X : Ty.Ty) : Set :=
                               match X return Set with
                               | Ty.Unit => unit
                               | Ty.Sum A B => sum (tySem A) (tySem B)
                               | Ty.Prod A B => prod (tySem A) (tySem B)
                               end)
                              ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                                  match n0 return Ty.Ty with
                                  | O => X
                                  | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                                  end) (Ty.Sum Ty.Unit Ty.Unit) n))
                           (@snd (sum unit unit)
                              (prod
