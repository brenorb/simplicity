### C.jet_division_approx_spec.division_normalized_result
division_normalized_result =
fun (n : nat) (rec : Ty.Arrow (Ty.Prod (Word.Word (S n)) (Word.Word n)) (Word.Word (S n))) =>
forall (a : Ty.tySem (Word.Word (S n))) (b : Ty.tySem (Word.Word n))
  (_ : BinInt.Z.le (jet_predicate_spec.word_modulus n)
         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
  (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) a)
         (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ n) b) (jet_predicate_spec.word_modulus n))),
let qr : Ty.tySem (Word.Word (S n)) := rec (@pair (Ty.tySem (Word.Word (S n))) (Ty.tySem (Word.Word n)) a b) in
and
  (@eq BinNums.Z
     (BinInt.Z.add
        (BinInt.Z.mul
           (@Word.ToZ.Theory.toZ (Word.WordToZ n)
              (@fst
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                        match n0 return Ty.Ty with
                        | O => X
                        | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                        end) (Ty.Sum Ty.Unit Ty.Unit) n))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                        match n0 return Ty.Ty with
                        | O => X
                        | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                        end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr)) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b))
        (@Word.ToZ.Theory.toZ (Word.WordToZ n)
           (@snd
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr))) (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) a))
  (and
     (BinInt.Z.le BinNums.Z0
        (@Word.ToZ.Theory.toZ (Word.WordToZ n)
           (@snd
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr)))
     (BinInt.Z.lt
        (@Word.ToZ.Theory.toZ (Word.WordToZ n)
           (@snd
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr)) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
     : forall (n : nat) (_ : Ty.Arrow (Ty.Prod (Word.Word (S n)) (Word.Word n)) (Word.Word (S n))), Prop

Arguments division_normalized_result n%nat_scope rec
