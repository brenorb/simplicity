                                        end) (Ty.Sum Ty.Unit Ty.Unit) n))) z)))
                     (@Word.ToZ.Theory.toZ (Word.WordToZ n) b1))
                  (@Word.ToZ.Theory.toZ (Word.WordToZ n)
                     (@snd
                        ((fix tySem (X : Ty.Ty) : Set :=
