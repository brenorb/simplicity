### C.jet_secp_field_add7.add7_radix_value
add7_radix_value
     : forall (rho : forall _ : nat, Integers.Int64.int)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Int64.unsigned (rho O)) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))
                Integers.Int64.max_unsigned),
       @eq BinNums.Z
         (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (add7_words rho O))
            (Integers.Int64.unsigned (add7_words rho (S O))) (Integers.Int64.unsigned (add7_words rho (S (S O))))
            (Integers.Int64.unsigned (add7_words rho (S (S (S O)))))
            (Integers.Int64.unsigned (add7_words rho (S (S (S (S O)))))))
         (BinInt.Z.add
            (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S O)))
               (Integers.Int64.unsigned (rho (S (S O)))) (Integers.Int64.unsigned (rho (S (S (S O)))))
               (Integers.Int64.unsigned (rho (S (S (S (S O))))))) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))
### C.jet_secp_field_add7.add7_radix
add7_radix
     : forall (rho : forall _ : nat, Integers.Int64.int)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Int64.unsigned (rho O)) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))
                Integers.Int64.max_unsigned),
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (add7_words rho))
         (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value rho)
            (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))
### C.jet_secp_field_add7.eval_field_add7_small
eval_field_add7_small
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_field_add_initial.field_values rho O))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.lt (Integers.Int64.unsigned (rho i))
                match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                | true =>
                    BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
                | false =>
                    BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
                end),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add_int)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf b BinNums.Z0 (jet_secp_field_add_initial.field_values (add7_words rho) O))
               (and
                  (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (add7_words rho))
                     (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value rho)
                        (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
                  (and
                     (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                      BinInt.Z.le (Integers.Int64.unsigned (add7_words rho i))
                        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                     (and
                        (Memory.Mem.range_perm mf b BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe
                           (fun (b' : Values.block) (o : BinNums.Z) =>
                            not
                              (jet_sx_state.foot
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                                    (@nil (prod Values.block BinNums.Z)))
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape add7_regs) b' o)) m mf))))))
### C.jet_secp_field_add7.add7_regs
add7_regs =
@cons jet_sx_state.region
  (jet_secp_local_regions.free_region (jet_secp_fe_nv.fe_reg (jet_secp_fe_nv.vars5 O))
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
  (@nil jet_sx_state.region)
     : list jet_sx_state.region
### C.jet_secp_field_add7.add7_args
add7_args =
@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
  (@cons jet_sx_expr.sx (jet_sx_expr.XI (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
     (@nil jet_sx_expr.sx))
     : list jet_sx_expr.sx
### C.jet_secp_field_add7.add7_run
add7_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_add_int add7_args add7_regs (@nil jet_sx_eval.event) (S (S (S (S (S O)))))
     : option jet_sx_exec.res
### C.jet_secp_field_add7.add7_state
add7_state =
match add7_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_field_add7.add7_out
add7_out =
@cons jet_sx_expr.sx
  (jet_sx_expr.XLb jet_sx_expr.Badd (jet_sx_expr.XLv O)
     (jet_sx_expr.XI2L Ctypes.Signed
        (jet_sx_expr.XI (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))))
  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O))))
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O))))) (@nil jet_sx_expr.sx)))))
     : list jet_sx_expr.sx
### C.jet_secp_field_add7.add7_words
add7_words =
fun (rho : forall _ : nat, Integers.Int64.int) (i : nat) =>
match PeanoNat.Nat.eqb i O return Integers.Int64.int with
| true => Integers.Int64.add (rho O) (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))
| false => rho i
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments add7_words rho%function_scope i%nat_scope
