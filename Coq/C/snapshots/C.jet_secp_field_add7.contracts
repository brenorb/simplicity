### C.jet_secp_field_add7.add7_run_eq
add7_run_eq
     : @eq (option jet_sx_exec.res) add7_run (@Some jet_sx_exec.res (jet_sx_exec.RDone add7_state jet_sx_exec.ONormal))
### C.jet_secp_field_add7.add7_return
add7_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps add7_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_field_add7.add7_output_shape
add7_output_shape
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs add7_state)
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 add7_out) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@nil jet_sx_state.region))
