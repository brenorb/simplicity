### C.jet_elements_asset_jets.asset_cells_explicit
asset_cells_explicit
     : forall xs : list Integers.Int.int,
       @eq (list BitMachine.Cell)
         (jet_elements_asset_helper.asset_cells (Integers.Int.repr (BinNums.Zpos BinNums.xH)) xs)
         (@cons (option bool) (@Some bool true)
            (@cons (option bool) (@None bool) (jet_elements_hash_write.hash_cells xs)))
### C.jet_elements_asset_jets.asset_cells_odd
asset_cells_odd
     : forall xs : list Integers.Int.int,
       @eq (list BitMachine.Cell)
         (jet_elements_asset_helper.asset_cells (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) xs)
         (@cons (option bool) (@Some bool false)
            (@cons (option bool) (@Some bool true) (jet_elements_hash_write.hash_cells xs)))
