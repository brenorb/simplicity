### C.jet_elements_asset_jets.encode_asset_cells
encode_asset_cells
     : forall a : jet_elements_prim.assetWith unit,
       @eq (list BitMachine.Cell)
         (@Translate.encode
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (@inr unit
               (Ty.tySem
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (encode_asset a)))
         (@cons (option bool) (@Some bool true)
            (jet_elements_asset_helper.asset_cells (@conf_prefix Digest.hash256 a) (asset_words a)))
### C.jet_elements_asset_jets.encode_conf_cells
encode_conf_cells
     : forall a : jet_elements_prim.assetWith unit,
       @eq (list BitMachine.Cell)
         (@Translate.encode
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (encode_asset a))
         (jet_elements_asset_helper.asset_cells (@conf_prefix Digest.hash256 a) (asset_words a))
### C.jet_elements_asset_jets.asset_rep_mono
asset_rep_mono
     : forall (m1 m2 : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (a : jet_elements_prim.assetWith unit)
         (_ : asset_rep m1 b ofs a)
         (_ : forall (chunk : AST.memory_chunk) (o : BinNums.Z) (v : Values.val) (_ : BinInt.Z.le ofs o)
                (_ : BinInt.Z.le (BinInt.Z.add o (Memdata.size_chunk chunk))
                       (BinInt.Z.add ofs
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (_ : @eq (option Values.val) (Memory.Mem.load chunk m1 b o) (@Some Values.val v)),
              @eq (option Values.val) (Memory.Mem.load chunk m2 b o) (@Some Values.val v)),
       asset_rep m2 b ofs a
### C.jet_elements_asset_jets.asset_rep_runs
asset_rep_runs
     : forall (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge : BinNums.Z)
         (m' : Memory.Mem.mem) (bin : Values.block) (ofs : BinNums.Z) (a : jet_elements_prim.assetWith unit)
         (cur : BinNums.Z) (_ : asset_rep m' bin ofs a) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_application_sep.out_sep bd dbase bw outedge cur
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                bin ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : jet_output_layout.write_frame_at m' bd dbase bw outedge cur
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun me : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m'
               (@Ctypes.Internal Clight.function jets_elements.f_asset)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs)) (@nil Values.val))) Events.E0 me
               Values.Vundef)
            (jet_elements_effects.write_effect m' me bd dbase bw outedge cur
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xI
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (asset_pcells a)))
### C.jet_elements_asset_jets.elements_input_asset_sem
elements_input_asset_sem
     : forall (environment : jet_elements_prim.Elements.env) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem
               (Ty.Sum Ty.Unit
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
         (@elements_input_asset_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
         (@Some
            (Ty.tySem
               (Ty.Sum Ty.Unit
                  (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) (elements_input_asset_result environment a))
