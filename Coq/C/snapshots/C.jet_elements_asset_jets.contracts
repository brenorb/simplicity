### C.jet_elements_asset_jets.conf_prefix
conf_prefix =
fun (A : Set) (c : jet_elements_prim.confidential unit A) =>
match c return Integers.Int.int with
| jet_elements_prim.Explicit _ => Integers.Int.repr (BinNums.Zpos BinNums.xH)
| jet_elements_prim.Confidential pt _ =>
    match pt return Integers.Int.int with
    | jet_elements_prim.Point odd _ =>
        match odd return Integers.Int.int with
        | true => Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))
        | false => Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))
        end
    end
end
     : forall (A : Set) (_ : jet_elements_prim.confidential unit A), Integers.Int.int

Arguments conf_prefix {A}%type_scope c
### C.jet_elements_asset_jets.asset_words
asset_words =
fun a : jet_elements_prim.assetWith unit =>
Digest.hash256_reg
  match a return Digest.hash256 with
  | jet_elements_prim.Explicit h => h
  | jet_elements_prim.Confidential pt _ => match pt return Digest.hash256 with
                                           | jet_elements_prim.Point _ x => x
                                           end
  end
     : forall _ : jet_elements_prim.assetWith unit, list Integers.Int.int

Arguments asset_words a
### C.jet_elements_asset_jets.asset_rep
asset_rep =
fun (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (a : jet_elements_prim.assetWith unit) =>
and (jet_uint32_array_init.uint32_array_at m b ofs (asset_words a))
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint32 m b
        (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@Some Values.val (Values.Vint (@conf_prefix Digest.hash256 a))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : jet_elements_prim.assetWith unit), Prop

Arguments asset_rep m b ofs%Z_scope a
### C.jet_elements_asset_jets.conf_toBit
conf_toBit =
fun b : bool =>
match b return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) with
| true => @inr unit unit tt
| false => @inl unit unit tt
end
     : forall _ : bool, Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)

Arguments conf_toBit b%bool_scope
### C.jet_elements_asset_jets.encode_asset
encode_asset =
fun a : jet_elements_prim.assetWith unit =>
match
  a
  return
    (Ty.tySem
       (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
          (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| jet_elements_prim.Explicit h =>
    @inr
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Sum Ty.Unit Ty.Unit))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
| jet_elements_prim.Confidential pt _ =>
    match
      pt
      return
        (Ty.tySem
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
    with
    | jet_elements_prim.Point odd x =>
        @inl (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
          (prod
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
          (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (conf_toBit odd) (Word.from_hash256 x))
    end
end
     : forall _ : jet_elements_prim.assetWith unit,
       Ty.tySem
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments encode_asset a
### C.jet_elements_asset_jets.asset_pcells
asset_pcells =
fun a : jet_elements_prim.assetWith unit =>
jet_elements_asset_helper.asset_cells (@conf_prefix Digest.hash256 a) (asset_words a)
     : forall _ : jet_elements_prim.assetWith unit, list BitMachine.Cell

Arguments asset_pcells a
### C.jet_elements_asset_jets.elements_input_asset_spec
elements_input_asset_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
  (Ty.Sum Ty.Unit
     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg jet_elements_prim.Elements.InputAsset
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments elements_input_asset_spec {alg}
### C.jet_elements_asset_jets.elements_input_asset_result
elements_input_asset_result =
fun (environment : jet_elements_prim.Elements.env) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error jet_elements_prim.sigTxInput
    (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return
    (Ty.tySem
       (Ty.Sum Ty.Unit
          (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
with
| Some txi =>
    @inr unit
      (Ty.tySem
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (encode_asset (jet_elements_prim.utxoAsset (jet_elements_prim.sigTxiTxo txi)))
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
end
     : forall (_ : jet_elements_prim.Elements.env) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments elements_input_asset_result environment a
### C.jet_elements_asset_jets.elements_input_asset_pexpr
elements_input_asset_pexpr =
Clight.Eaddrof
  (Clight.Efield
     (Clight.Efield
        (Clight.Ederef
           (Clight.Ebinop Cop.Oadd
              (Clight.Etempvar jets_elements._t'4
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)))
              (Clight.Etempvar jets_elements._i Ctypesdefs.tulong)
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)))
           (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)) jets_elements._txo
        (Ctypes.Tstruct jets_elements._utxo Ctypes.noattr)) jets_elements._asset
     (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr))
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr))
     : Clight.expr
### C.jet_elements_asset_jets.elements_output_asset_spec
elements_output_asset_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
  (Ty.Sum Ty.Unit
     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg jet_elements_prim.Elements.OutputAsset
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments elements_output_asset_spec {alg}
### C.jet_elements_asset_jets.elements_output_asset_result
elements_output_asset_result =
fun (environment : jet_elements_prim.Elements.env) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error jet_elements_prim.txOutput
    (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return
    (Ty.tySem
       (Ty.Sum Ty.Unit
          (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
with
| Some txo =>
    @inr unit
      (Ty.tySem
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (encode_asset
         (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256 (jet_elements_prim.txoAsset txo)))
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
end
     : forall (_ : jet_elements_prim.Elements.env) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments elements_output_asset_result environment a
### C.jet_elements_asset_jets.elements_output_asset_pexpr
elements_output_asset_pexpr =
Clight.Eaddrof
  (Clight.Efield
     (Clight.Ederef
        (Clight.Ebinop Cop.Oadd
           (Clight.Etempvar jets_elements._t'4
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))
           (Clight.Etempvar jets_elements._i Ctypesdefs.tulong)
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))
        (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)) jets_elements._asset
     (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr))
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr))
     : Clight.expr
### C.jet_elements_asset_jets.elements_output_nonce_spec
elements_output_nonce_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
  (Ty.Sum Ty.Unit
     (Ty.Sum Ty.Unit
        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) alg jet_elements_prim.Elements.OutputNonce
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))))

Arguments elements_output_nonce_spec {alg}
### C.jet_elements_asset_jets.nonce_conf
nonce_conf =
fun x : jet_elements_prim.nonce =>
match x return (jet_elements_prim.assetWith unit) with
| inl p =>
    match p return (jet_elements_prim.assetWith unit) with
    | pair odd w => @jet_elements_prim.Confidential unit Digest.hash256 (jet_elements_prim.Point odd w) tt
    end
| inr h => @jet_elements_prim.Explicit unit Digest.hash256 h
end
     : forall _ : jet_elements_prim.nonce, jet_elements_prim.assetWith unit

Arguments nonce_conf x
### C.jet_elements_asset_jets.nonce_prefix
nonce_prefix =
fun n : option jet_elements_prim.nonce =>
match n return Integers.Int.int with
| Some x => @conf_prefix Digest.hash256 (nonce_conf x)
| None => Integers.Int.repr BinNums.Z0
end
     : forall _ : option jet_elements_prim.nonce, Integers.Int.int

Arguments nonce_prefix n
### C.jet_elements_asset_jets.nonce_words
nonce_words =
fun n : option jet_elements_prim.nonce =>
match n return (list Integers.Int.int) with
| Some x => asset_words (nonce_conf x)
| None => @List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S (S O))))))))
end
     : forall _ : option jet_elements_prim.nonce, list Integers.Int.int

Arguments nonce_words n
### C.jet_elements_asset_jets.nonce_rep
nonce_rep =
fun (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (n : option jet_elements_prim.nonce) =>
and
  (forall _ : not (@eq (option jet_elements_prim.nonce) n (@None jet_elements_prim.nonce)),
   jet_uint32_array_init.uint32_array_at m b ofs (nonce_words n))
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint32 m b
        (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@Some Values.val (Values.Vint (nonce_prefix n))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : option jet_elements_prim.nonce), Prop

Arguments nonce_rep m b ofs%Z_scope n
### C.jet_elements_asset_jets.encode_nonce
encode_nonce =
fun n : option jet_elements_prim.nonce =>
match
  n
  return
    (Ty.tySem
       (Ty.Sum Ty.Unit
          (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
with
| Some x =>
    @inr unit
      (Ty.tySem
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (encode_asset (nonce_conf x))
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
end
     : forall _ : option jet_elements_prim.nonce,
       Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments encode_nonce n
### C.jet_elements_asset_jets.elements_output_nonce_result
elements_output_nonce_result =
fun (environment : jet_elements_prim.Elements.env) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error jet_elements_prim.txOutput
    (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return
    (Ty.tySem
       (Ty.Sum Ty.Unit
          (Ty.Sum Ty.Unit
             (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
with
| Some txo =>
    @inr unit
      (Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) (encode_nonce (jet_elements_prim.txoNonce txo))
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) tt
end
     : forall (_ : jet_elements_prim.Elements.env) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))))

Arguments elements_output_nonce_result environment a
