### C.jet_bitcoin_effects.write_effect
write_effect =
fun (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block) (edge cursor count : BinNums.Z)
  (cells : list BitMachine.Cell) =>
and (jet_encoding.frame_output_cells_at mf bw edge cursor cells)
  (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
     (and (jet_frame_layout.frame_fields_at mf bf base bw edge (BinInt.Z.sub cursor count))
        (and
           (jet_output_layout.loads_outside_ranges m mf bf
              (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
              (BinInt.Z.add edge
                 (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                    (BinInt.Z.div (BinInt.Z.sub cursor count)
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
              (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
           (and
              (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                 (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mf b ofs kind p)
              (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : list BitMachine.Cell), Prop

Arguments write_effect m mf bf base%Z_scope bw (edge cursor count)%Z_scope cells%list_scope
