### C.jet_secp_strauss_skip.exec_strauss_check_infinite
exec_strauss_check_infinite
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (value : BinNums.Z) (bk ba : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_scalar_is_zero e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_is_infinity e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._na le)
                (@Some Values.val (Values.Vptr bk Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._np le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : not (@eq BinNums.Z value BinNums.Z0))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.one))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
         jet_secp_generator_preprocess.generator_preprocess_check Events.E0 (strauss_infinite_checked_temps le) m
         ClightBigstep.Out_continue
### C.jet_secp_strauss_skip.strauss_skipped_preserves
strauss_skipped_preserves
     : forall (le : Maps.PTree.tree Values.val) (value : BinNums.Z) (id : AST.ident)
         (_ : not
                (@List.In AST.ident id
                   (@cons AST.ident jets_secp._np
                      (@cons AST.ident jets_secp._t'1
                         (@cons AST.ident jets_secp._t'2 (@cons AST.ident jets_secp._t'3 (@nil AST.ident))))))),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (strauss_skipped_preprocessed_temps le value))
         (@Maps.PTree.get Values.val id le)
### C.jet_secp_strauss_skip.strauss_skipped_np
strauss_skipped_np
     : forall (le : Maps.PTree.tree Values.val) (value : BinNums.Z),
       @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._np (strauss_skipped_preprocessed_temps le value))
         (@Some Values.val (Values.Vlong Integers.Int64.one))
### C.jet_secp_strauss_skip.exec_strauss_skip_loop
exec_strauss_skip_loop
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (lc : Clight.temp_env)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._num le)
                (@Some Values.val (Values.Vlong Integers.Int64.one)))
         (_ : ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e
                (@Maps.PTree.set Values.val jets_secp._np (Values.Vlong Integers.Int64.zero) le) m
                jet_secp_generator_preprocess.generator_preprocess_check Events.E0 lc m ClightBigstep.Out_continue)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._np lc)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._num lc)
                (@Some Values.val (Values.Vlong Integers.Int64.one))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
         jet_secp_generator_preprocess.generator_preprocess_statement Events.E0
         (@Maps.PTree.set Values.val jets_secp._np (Values.Vlong Integers.Int64.one) lc) m ClightBigstep.Out_normal
### C.jet_secp_strauss_skip.exec_strauss_preprocess_skips
exec_strauss_preprocess_skips
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (value : BinNums.Z) (bk ba : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_scalar_is_zero e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_is_infinity e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._na le)
                (@Some Values.val (Values.Vptr bk Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._num le)
                (@Some Values.val (Values.Vlong Integers.Int64.one)))
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value)))
         (_ : or (@eq BinNums.Z value BinNums.Z0)
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint32 m ba
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                   (@Some Values.val (Values.Vint Integers.Int.one)))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
         jet_secp_generator_preprocess.generator_preprocess_statement Events.E0
         (strauss_skipped_preprocessed_temps le value) m ClightBigstep.Out_normal
### C.jet_secp_strauss_skip.strauss_no_points_preserves
strauss_no_points_preserves
     : forall (le : Maps.PTree.tree Values.val) (value : BinNums.Z) (aptr zrptr : Values.val)
         (id : AST.ident)
         (_ : not
                (@List.In AST.ident id
                   (@cons AST.ident jets_secp._np
                      (@cons AST.ident jets_secp._t'1
                         (@cons AST.ident jets_secp._t'2
                            (@cons AST.ident jets_secp._t'3
                               (@cons AST.ident jets_secp._t'32 (@cons AST.ident jets_secp._t'33 (@nil AST.ident))))))))),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (strauss_no_points_temps le value aptr zrptr))
         (@Maps.PTree.get Values.val id le)
### C.jet_secp_strauss_skip.exec_strauss_no_points
exec_strauss_no_points
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (value : BinNums.Z) (bk ba bs bt bx : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_scalar_is_zero e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_is_infinity e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_table_set_globalz e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._na le)
                (@Some Values.val (Values.Vptr bk Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._num le)
                (@Some Values.val (Values.Vlong Integers.Int64.one)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._no le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._state le)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value)))
         (_ : or (@eq BinNums.Z value BinNums.Z0)
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint32 m ba
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                   (@Some Values.val (Values.Vint Integers.Int.one))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr m bs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val (Values.Vptr bt Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bs BinNums.Z0)
                (@Some Values.val (Values.Vptr bx Integers.Ptrofs.zero))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               jet_secp_generator_globalz_call.generator_no_points_phase Events.E0
               (strauss_no_points_temps le value (Values.Vptr bt Integers.Ptrofs.zero)
                  (Values.Vptr bx Integers.Ptrofs.zero)) mf ClightBigstep.Out_normal)
            (and
               (@eq (option Values.val)
                  (@Maps.PTree.get Values.val jets_secp._np
                     (strauss_no_points_temps le value (Values.Vptr bt Integers.Ptrofs.zero)
                        (Values.Vptr bx Integers.Ptrofs.zero))) (@Some Values.val (Values.Vlong Integers.Int64.zero)))
               (and
                  (@eq (option Values.val)
                     (@Maps.PTree.get Values.val jets_secp._no
                        (strauss_no_points_temps le value (Values.Vptr bt Integers.Ptrofs.zero)
                           (Values.Vptr bx Integers.Ptrofs.zero)))
                     (@Some Values.val (Values.Vlong Integers.Int64.zero)))
                  (and
                     (forall (id : AST.ident)
                        (_ : not
                               (@List.In AST.ident id
                                  (@cons AST.ident jets_secp._np
                                     (@cons AST.ident jets_secp._t'1
                                        (@cons AST.ident jets_secp._t'2
                                           (@cons AST.ident jets_secp._t'3
                                              (@cons AST.ident jets_secp._t'32
                                                 (@cons AST.ident jets_secp._t'33 (@nil AST.ident))))))))),
                      @eq (option Values.val)
                        (@Maps.PTree.get Values.val id
                           (strauss_no_points_temps le value (Values.Vptr bt Integers.Ptrofs.zero)
                              (Values.Vptr bx Integers.Ptrofs.zero))) (@Maps.PTree.get Values.val id le))
                     (and (Memory.Mem.unchanged_on (fun (_ : Values.block) (_ : BinNums.Z) => True) m mf)
                        (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mf)
                           (and (jet_clight_internal_permissions.keeps_permissions m mf)
                              (jet_clight_internal_preserve.readonly_preserved m mf))))))))
### C.jet_secp_strauss_skip.strauss_infinite_checked_temps
strauss_infinite_checked_temps =
fun le : Maps.PTree.tree Values.val =>
@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint Integers.Int.one)
  (@Maps.PTree.set Values.val jets_secp._t'3 (Values.Vint Integers.Int.one)
     (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint Integers.Int.zero) le))
     : forall _ : Maps.PTree.tree Values.val, Maps.PTree.tree Values.val

Arguments strauss_infinite_checked_temps le
### C.jet_secp_strauss_skip.strauss_skipped_preprocessed_temps
strauss_skipped_preprocessed_temps =
fun (le : Maps.PTree.tree Values.val) (value : BinNums.Z) =>
match BinInt.Z.eqb value BinNums.Z0 return (Maps.PTree.tree Values.val) with
| true => jet_secp_generator_preprocess.generator_preprocessed_temps le
| false =>
    @Maps.PTree.set Values.val jets_secp._np (Values.Vlong Integers.Int64.one)
      (strauss_infinite_checked_temps (@Maps.PTree.set Values.val jets_secp._np (Values.Vlong Integers.Int64.zero) le))
end
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments strauss_skipped_preprocessed_temps le value%Z_scope
### C.jet_secp_strauss_skip.strauss_no_points_temps
strauss_no_points_temps =
fun (le : Maps.PTree.tree Values.val) (value : BinNums.Z) (aptr zrptr : Values.val) =>
@Maps.PTree.set Values.val jets_secp._np (Values.Vlong Integers.Int64.zero)
  (jet_secp_generator_globalz_call.generator_globalz_call_temps (strauss_skipped_preprocessed_temps le value) aptr
     zrptr)
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z) (_ : Values.val) (_ : Values.val),
       Maps.PTree.tree Values.val

Arguments strauss_no_points_temps le value%Z_scope aptr zrptr
