### C.jet_secp_table_get_control.table_get_index_machine
table_get_index_machine
     : forall (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))),
       and
         (@eq Integers.Int.int
            (Integers.Int.sub
               (Integers.Int.repr
                  (BinInt.Z.add (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) j) (BinNums.Zpos BinNums.xH)))
               Integers.Int.one) (Integers.Int.repr (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) j)))
         (@eq Integers.Int.int
            (Integers.Int.divs (Integers.Int.repr (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) j))
               (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH)))) (Integers.Int.repr j))
