     : Clight.expr
### C.jet_secp_table_get_control.table_get_y_address
table_get_y_address =
Clight.Eaddrof (Clight.Efield table_get_destination jets_secp._y jet_secp_curve_statements.curve_fe_type)
  (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type)
     : Clight.expr
### C.jet_secp_table_get_control.table_get_guard
table_get_guard =
Clight.Ebinop Cop.Ogt (Clight.Etempvar jets_secp._n Ctypesdefs.tint)
  (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Ctypesdefs.tint
     : Clight.expr
### C.jet_secp_table_get_control.table_get_negate
table_get_negate =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_negate jets_secp.f_secp256k1_fe_negate
  (@None AST.ident)
  (@cons Clight.expr table_get_y_address
     (@cons Clight.expr table_get_y_address
        (@cons Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_table_get_control.table_get_choice
table_get_choice =
Clight.Sifthenelse table_get_guard (Clight.Sassign table_get_destination (table_get_source false))
  (Clight.Ssequence (Clight.Sassign table_get_destination (table_get_source true)) table_get_negate)
     : Clight.statement
### C.jet_secp_table_get_control.table_get_temps
table_get_temps =
fun (bd bt : Values.block) (negative : bool) (j : BinNums.Z) =>
@Maps.PTree.set Values.val jets_secp._w
  (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
  (@Maps.PTree.set Values.val jets_secp._n (Values.Vint (Integers.Int.repr (table_get_digit negative j)))
     (@Maps.PTree.set Values.val jets_secp._pre (Values.Vptr bt Integers.Ptrofs.zero)
        (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr bd Integers.Ptrofs.zero)
           (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_ecmult_table_get_ge)))))
     : forall (_ : Values.block) (_ : Values.block) (_ : bool) (_ : BinNums.Z), Maps.PTree.tree Values.val

