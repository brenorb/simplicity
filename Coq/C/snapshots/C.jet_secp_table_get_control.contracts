Arguments table_get_source negative%bool_scope
### C.jet_secp_table_get_control.table_get_destination
table_get_destination =
Clight.Ederef (Clight.Etempvar jets_secp._r (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type))
