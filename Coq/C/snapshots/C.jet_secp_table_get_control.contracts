### C.jet_secp_table_get_control.eval_table_get_address
eval_table_get_address
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bt : Values.block)
         (negative : bool) (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pre le)
                (@Some Values.val (Values.Vptr bt Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._n le)
                (@Some Values.val (Values.Vint (Integers.Int.repr (table_get_digit negative j))))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m (table_get_address negative)
         (Values.Vptr bt
            (Integers.Ptrofs.repr
               (BinInt.Z.mul
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) j)))
### C.jet_secp_table_get_control.eval_table_get_guard
eval_table_get_guard
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (negative : bool)
         (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._n le)
                (@Some Values.val (Values.Vint (Integers.Int.repr (table_get_digit negative j))))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m table_get_guard
         (Values.Vint
            match negative return Integers.Int.int with
            | true => Integers.Int.zero
            | false => Integers.Int.one
            end)
### C.jet_secp_table_get_control.table_get_digit
table_get_digit =
fun (negative : bool) (j : BinNums.Z) =>
match negative return BinNums.Z with
| true => BinInt.Z.opp (BinInt.Z.add (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) j) (BinNums.Zpos BinNums.xH))
| false => BinInt.Z.add (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) j) (BinNums.Zpos BinNums.xH)
end
     : forall (_ : bool) (_ : BinNums.Z), BinNums.Z

Arguments table_get_digit negative%bool_scope j%Z_scope
### C.jet_secp_table_get_control.table_get_magnitude
table_get_magnitude =
fun negative : bool =>
match negative return Clight.expr with
| true => Clight.Eunop Cop.Oneg (Clight.Etempvar jets_secp._n Ctypesdefs.tint) Ctypesdefs.tint
| false => Clight.Etempvar jets_secp._n Ctypesdefs.tint
end
     : forall _ : bool, Clight.expr

Arguments table_get_magnitude negative%bool_scope
### C.jet_secp_table_get_control.table_get_index
table_get_index =
fun negative : bool =>
Clight.Ebinop Cop.Odiv
  (Clight.Ebinop Cop.Osub (table_get_magnitude negative) (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)
     Ctypesdefs.tint) (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))) Ctypesdefs.tint)
  Ctypesdefs.tint
     : forall _ : bool, Clight.expr

Arguments table_get_index negative%bool_scope
### C.jet_secp_table_get_control.table_get_address
table_get_address =
fun negative : bool =>
Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._pre (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type))
  (table_get_index negative) (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type)
     : forall _ : bool, Clight.expr

