### C.jet_secp_scalar_writer_storage.scalar_writer_cells_size
scalar_writer_cells_size
     : @List.Forall jet_sx_state.cell
         (fun c : jet_sx_state.cell =>
          BinInt.Z.le (BinInt.Z.add (jet_sx_state.cofs c) (Memdata.size_chunk (jet_sx_state.cchunk c)))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (jet_sx_rep.u64_cells BinNums.Z0
            (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
               (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
                  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx))))))
### C.jet_secp_scalar_writer_storage.scalar_writer_initial_rep_from_storage
scalar_writer_initial_rep_from_storage
     : forall (value : BinNums.Z) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m b BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep (jet_secp_scalar_get_b32_numeric.scalar_limb_rho value)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_writer_run.scalar_writer_initial_regs m
### C.jet_secp_scalar_writer_storage.scalar_writer_initial_rep_from_reader
scalar_writer_initial_rep_from_reader
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (layout : jet_sx_state.layout) (bi : Values.block) (edge : Integers.Ptrofs.int) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep
                (jet_secp_wrapper_run.read_fe_rho
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) layout
                (jet_secp_scalar_reader_lifecycle.scalar_reader_final_regs bi edge) m),
       jet_sx_state.rep
         (jet_secp_scalar_get_b32_numeric.scalar_limb_rho
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value)))
         (@cons (prod Values.block BinNums.Z)
            (@pair Values.block BinNums.Z (jet_sx_state.blk layout O) (jet_sx_state.bas layout O))
            (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_writer_run.scalar_writer_initial_regs m
