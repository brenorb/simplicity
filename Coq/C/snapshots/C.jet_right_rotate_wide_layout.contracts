     : forall s : jet_left_rotate_wide_exec.byte_rotate_size,
       jet_bitmachine_rep.jet_local_spec (jet_right_rotate_wide_exec.right_rotate_byte_function s)
         (Ty.Prod (Word.Word (S (S (S O))))
            (Word.Word (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s))))
         (Word.Word (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s)))
         (fun
            ax : Ty.tySem
                   (Ty.Prod (Word.Word (S (S (S O))))
                      (Word.Word (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s)))) =>
          @jet_right_rotate_spec.right_rotate_byte_spec s Alg.CoreFunSem ax)
