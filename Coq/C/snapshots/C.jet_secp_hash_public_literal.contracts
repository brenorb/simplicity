### C.jet_secp_hash_public_literal.literal_hash_to_curve_core_value
literal_hash_to_curve_core_value
     : forall key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@literal_hash_to_curve_core Alg.CoreFunSem key)
         match
           andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
             (jet_secp_generator_hash_map.generator_hash_accepted true key)
           return
             (Ty.tySem
                (Ty.Sum Ty.Unit
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | true =>
             @jet_secp_gej_norm_branch.literal_gej_normalize Alg.CoreFunSem
               (@literal_hash_point_sum Alg.CoreFunSem
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@jet_secp_generator_hash_literal.literal_generator_hash false Alg.CoreFunSem key)
                     (@jet_secp_generator_hash_literal.literal_generator_hash true Alg.CoreFunSem key)))
         | false =>
             @inl unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
         end
### C.jet_secp_hash_public_literal.hash_public_finite_literal
hash_public_finite_literal
     : forall (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (sx sy sz : forall _ : nat, Integers.Int64.int) (flag : Integers.Int.int)
         (ox oy : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_hash_public_call.hash_public_value key sx sy sz flag ox oy)
         (_ : @eq Integers.Int.int flag Integers.Int.zero),
       @eq
         (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (jet_secp_rescale_literal.rescale_field_output ox)
            (jet_secp_rescale_literal.rescale_field_output oy))
         (@jet_secp_gej_norm_literal.literal_gej_norm Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (jet_secp_rescale_literal.rescale_field_output sx) (jet_secp_rescale_literal.rescale_field_output sy))
               (jet_secp_rescale_literal.rescale_field_output sz)))
### C.jet_secp_hash_public_literal.hash_public_infinite_literal_zero
hash_public_infinite_literal_zero
     : forall (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (sx sy sz : forall _ : nat, Integers.Int64.int) (flag : Integers.Int.int)
         (ox oy : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_hash_public_call.hash_public_value key sx sy sz flag ox oy)
         (_ : not (@eq Integers.Int.int flag Integers.Int.zero)),
       and
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_rescale_literal.rescale_field_output ox)) BinNums.Z0)
         (@eq BinNums.Z
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_rescale_literal.rescale_field_output oy)) BinNums.Z0)
### C.jet_secp_hash_public_literal.hash_public_core_result
hash_public_core_result
     : forall (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (sx sy sz : forall _ : nat, Integers.Int64.int) (flag : Integers.Int.int)
         (ox oy : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_hash_public_call.hash_public_value key sx sy sz flag ox oy),
       @eq
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@literal_hash_to_curve_core Alg.CoreFunSem key)
         match
           andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
             (jet_secp_generator_hash_map.generator_hash_accepted true key)
           return
             (Ty.tySem
                (Ty.Sum Ty.Unit
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | true =>
             match
               Integers.Int.eq flag Integers.Int.zero
               return
                 (Ty.tySem
                    (Ty.Sum Ty.Unit
                       (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                          (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
             with
             | true =>
                 @inr unit
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (jet_secp_rescale_literal.rescale_field_output ox)
                      (jet_secp_rescale_literal.rescale_field_output oy))
             | false =>
                 @inl unit
                   (prod
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
             end
         | false =>
             @inl unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
         end
### C.jet_secp_hash_public_literal.literal_hash_accept
literal_hash_accept =
fun term : Alg.Core.Algebra =>
@Bit.and (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
  (@Alg.Core.Combinators.comp
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit Ty.Unit) term
     (@Alg.Core.Combinators.pair
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
           (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))
        (@Alg.scribe
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) jet_secp_canonical_normalize.canonical_field_word term))
     (@jet_order_spec.lt_word_spec term (S (S (S (S (S (S (S (S O))))))))))
  (@Alg.Core.Combinators.comp
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit Ty.Unit) term
     (@Alg.Core.Combinators.pair
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
           (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))
        (@Alg.scribe
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) jet_secp_canonical_normalize.canonical_field_word term))
     (@jet_order_spec.lt_word_spec term (S (S (S (S (S (S (S (S O))))))))))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Sum Ty.Unit Ty.Unit)

Arguments literal_hash_accept {term}
### C.jet_secp_hash_public_literal.literal_hash_point_sum
literal_hash_point_sum =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Prod
     (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
  (@Alg.Core.Combinators.pair
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
     (@Alg.Core.Combinators.pair
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
           (@jet_secp_swu_literal.literal_swu term))
        (@Alg.Core.Combinators.comp
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
           (@Alg.Core.Combinators.unit
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              term) (@jet_secp_literal_add_program.literal_fe_one256 term)))
     (@Alg.Core.Combinators.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
        (@jet_secp_swu_literal.literal_swu term))) (@jet_secp_add_literal.literal_gej_ge_add term)
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments literal_hash_point_sum {term}
### C.jet_secp_hash_public_literal.literal_hash_to_curve_core
literal_hash_to_curve_core =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  term
  (@Alg.Core.Combinators.pair (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@jet_secp_generator_hash_literal.literal_generator_hash false term)
     (@jet_secp_generator_hash_literal.literal_generator_hash true term))
  (@Alg.Core.Combinators.comp
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Ty.Sum Ty.Unit
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) term
     (@Alg.Core.Combinators.pair
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.Sum Ty.Unit Ty.Unit)
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
        (@literal_hash_accept term)
        (@Alg.Core.Combinators.iden
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term))
     (@Bit.cond (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.Sum Ty.Unit
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) term
        (@Alg.Core.Combinators.comp
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Prod
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum Ty.Unit
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           term (@literal_hash_point_sum term) (@jet_secp_gej_norm_branch.literal_gej_normalize term))
        (@Alg.Core.Combinators.injl
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           Ty.Unit
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
           (@Alg.Core.Combinators.unit
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              term))))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Ty.Sum Ty.Unit
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments literal_hash_to_curve_core {term}
