### C.jet_secp_hash_public_literal.literal_hash_accept_value
literal_hash_accept_value
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (Bit.toBool
            (@literal_hash_accept Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y)))
         (andb
            (BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
               jet_secp_fe_math.feP)
            (BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
               jet_secp_fe_math.feP))
### C.jet_secp_hash_public_literal.literal_hash_point_sum_value
literal_hash_point_sum_value
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Prod
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_hash_point_sum Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))
         (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
            (@pair
               (prod
                  (Ty.tySem
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair
                  (Ty.tySem
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem x)
                  (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))
