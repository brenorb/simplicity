### C.jet_secp_root_square_loop.root_square_first_source
root_square_first_source
     : @eq Clight.statement
         match Clight.fn_body jets_secp.f_secp256k1_fe_sqrt_var return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s0 =>
             match s0 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s2 =>
                 match s2 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence _ s4 =>
                     match s4 return Clight.statement with
                     | Clight.Sskip => Clight.Sskip
                     | Clight.Sassign _ _ => Clight.Sskip
                     | Clight.Sset _ _ => Clight.Sskip
                     | Clight.Scall _ _ _ => Clight.Sskip
                     | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                     | Clight.Ssequence _ s6 =>
                         match s6 return Clight.statement with
                         | Clight.Sskip => Clight.Sskip
                         | Clight.Sassign _ _ => Clight.Sskip
                         | Clight.Sset _ _ => Clight.Sskip
                         | Clight.Scall _ _ _ => Clight.Sskip
                         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                         | Clight.Ssequence _ s8 =>
                             match s8 return Clight.statement with
                             | Clight.Sskip => Clight.Sskip
                             | Clight.Sassign _ _ => Clight.Sskip
                             | Clight.Sset _ _ => Clight.Sskip
                             | Clight.Scall _ _ _ => Clight.Sskip
                             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                             | Clight.Ssequence _ s10 =>
                                 match s10 return Clight.statement with
                                 | Clight.Sskip => Clight.Sskip
                                 | Clight.Sassign _ _ => Clight.Sskip
                                 | Clight.Sset _ _ => Clight.Sskip
                                 | Clight.Scall _ _ _ => Clight.Sskip
                                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                                 | Clight.Ssequence loop _ => loop
                                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                                 | Clight.Sloop _ _ => Clight.Sskip
                                 | Clight.Sbreak => Clight.Sskip
                                 | Clight.Scontinue => Clight.Sskip
                                 | Clight.Sreturn _ => Clight.Sskip
                                 | Clight.Sswitch _ _ => Clight.Sskip
                                 | Clight.Slabel _ _ => Clight.Sskip
                                 | Clight.Sgoto _ => Clight.Sskip
                                 end
                             | Clight.Sifthenelse _ _ _ => Clight.Sskip
                             | Clight.Sloop _ _ => Clight.Sskip
                             | Clight.Sbreak => Clight.Sskip
                             | Clight.Scontinue => Clight.Sskip
                             | Clight.Sreturn _ => Clight.Sskip
                             | Clight.Sswitch _ _ => Clight.Sskip
                             | Clight.Slabel _ _ => Clight.Sskip
                             | Clight.Sgoto _ => Clight.Sskip
                             end
                         | Clight.Sifthenelse _ _ _ => Clight.Sskip
                         | Clight.Sloop _ _ => Clight.Sskip
                         | Clight.Sbreak => Clight.Sskip
                         | Clight.Scontinue => Clight.Sskip
                         | Clight.Sreturn _ => Clight.Sskip
                         | Clight.Sswitch _ _ => Clight.Sskip
                         | Clight.Slabel _ _ => Clight.Sskip
                         | Clight.Sgoto _ => Clight.Sskip
                         end
                     | Clight.Sifthenelse _ _ _ => Clight.Sskip
                     | Clight.Sloop _ _ => Clight.Sskip
                     | Clight.Sbreak => Clight.Sskip
                     | Clight.Scontinue => Clight.Sskip
                     | Clight.Sreturn _ => Clight.Sskip
                     | Clight.Sswitch _ _ => Clight.Sskip
                     | Clight.Slabel _ _ => Clight.Sskip
                     | Clight.Sgoto _ => Clight.Sskip
                     end
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end (root_square_for jets_secp._x6 (BinNums.Zpos (BinNums.xI BinNums.xH)))
### C.jet_secp_root_square_loop.root_square_all_sources
root_square_all_sources
     : @eq (list Clight.statement)
         (@List.map nat Clight.statement
            (fun n : nat =>
             @List.nth Clight.statement n (root_body_spine (Clight.fn_body jets_secp.f_secp256k1_fe_sqrt_var))
               Clight.Sskip)
            (@cons nat (S (S (S (S (S (S O))))))
               (@cons nat (S (S (S (S (S (S (S (S (S O)))))))))
                  (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
                     (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))
                        (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))
                           (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))
                              (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))
                                 (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))
                                    (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))
                                       (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))
                                          (@cons nat (S (S (S (S (S (S (S (S (S (S (S ...))))))))))) (@nil nat)))))))))))))
         (@cons Clight.statement (root_square_for jets_secp._x6 (BinNums.Zpos (BinNums.xI BinNums.xH)))
            (@cons Clight.statement (root_square_for jets_secp._x9 (BinNums.Zpos (BinNums.xI BinNums.xH)))
               (@cons Clight.statement (root_square_for jets_secp._x11 (BinNums.Zpos (BinNums.xO BinNums.xH)))
                  (@cons Clight.statement
                     (root_square_for jets_secp._x22 (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))
                     (@cons Clight.statement
                        (root_square_for jets_secp._x44
                           (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))
                        (@cons Clight.statement
                           (root_square_for jets_secp._x88
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (@cons Clight.statement
                              (root_square_for jets_secp._x176
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                              (@cons Clight.statement
                                 (root_square_for jets_secp._x220
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (@cons Clight.statement
                                    (root_square_for jets_secp._x223 (BinNums.Zpos (BinNums.xI BinNums.xH)))
                                    (@cons Clight.statement
                                       (root_square_for jets_secp._t1
                                          (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       (@cons Clight.statement
                                          (root_square_for jets_secp._t1
                                             (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))
                                          (@nil Clight.statement))))))))))))
### C.jet_secp_root_square_loop.eval_root_square_guard
eval_root_square_guard
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (limit j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j limit))
         (_ : BinInt.Z.le limit
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._j le)
                (@Some Values.val (Values.Vint (Integers.Int.repr j)))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m (root_square_guard limit)
         (Values.Vint
            match BinInt.Z.ltb j limit return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
### C.jet_secp_root_square_loop.exec_root_square_step
exec_root_square_step
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._j le)
                (@Some Values.val (Values.Vint (Integers.Int.repr j)))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m root_square_step Events.E0
         (@Maps.PTree.set Values.val jets_secp._j
            (Values.Vint (Integers.Int.repr (BinInt.Z.add j (BinNums.Zpos BinNums.xH)))) le) m ClightBigstep.Out_normal
### C.jet_secp_root_square_loop.exec_root_square_owned
exec_root_square_owned
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (id : BinNums.positive) (b : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (root_square_call id) Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf b BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words w)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_secp_square_columns.square_input_bounds (jet_secp_square_numeric.square_words w))
                     (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf)))))
### C.jet_secp_root_square_loop.exec_root_square_loop_owned
exec_root_square_loop_owned
     : forall (n : nat) (id : BinNums.positive) (limit : BinNums.Z)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (b : Values.block) (j : BinNums.Z)
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (w : forall _ : nat, Integers.Int64.int)
         (_ : BinInt.Z.le BinNums.Z0 j) (_ : @eq BinNums.Z (BinInt.Z.add j (BinInt.Z.of_nat n)) limit)
         (_ : BinInt.Z.le limit
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._j le)
                (@Some Values.val (Values.Vint (Integers.Int.repr j))))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (root_square_loop id limit) Events.E0
                  lef mf ClightBigstep.Out_normal)
               (and
                  (jet_secp_fe_nv.fe_at mf b BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (root_square_words n w)))
                  (and
                     (Memory.Mem.range_perm mf b BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and (jet_secp_square_columns.square_input_bounds (root_square_words n w))
                        (and
                           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._j lef)
                              (@Some Values.val (Values.Vint (Integers.Int.repr limit))))
                           (and
                              (forall (k : AST.ident) (_ : not (@eq AST.ident k jets_secp._j)),
                               @eq (option Values.val) (@Maps.PTree.get Values.val k lef)
                                 (@Maps.PTree.get Values.val k le))
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf))))))))
### C.jet_secp_root_square_loop.exec_root_square_for_owned
exec_root_square_for_owned
     : forall (n : nat) (id : BinNums.positive) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (b : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : BinInt.Z.le (BinInt.Z.of_nat n)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (root_square_for id (BinInt.Z.of_nat n)) Events.E0 lef mf ClightBigstep.Out_normal)
               (and
                  (jet_secp_fe_nv.fe_at mf b BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (root_square_words n w)))
                  (and
                     (Memory.Mem.range_perm mf b BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and (jet_secp_square_columns.square_input_bounds (root_square_words n w))
                        (and
                           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._j lef)
                              (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat n)))))
                           (and
                              (forall (k : AST.ident) (_ : not (@eq AST.ident k jets_secp._j)),
                               @eq (option Values.val) (@Maps.PTree.get Values.val k lef)
                                 (@Maps.PTree.get Values.val k le))
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf))))))))
### C.jet_secp_root_square_loop.root_square_guard
root_square_guard =
fun limit : BinNums.Z =>
Clight.Ebinop Cop.Olt (Clight.Etempvar jets_secp._j Ctypesdefs.tint)
  (Clight.Econst_int (Integers.Int.repr limit) Ctypesdefs.tint) Ctypesdefs.tint
     : forall _ : BinNums.Z, Clight.expr

Arguments root_square_guard limit%Z_scope
### C.jet_secp_root_square_loop.root_square_step
root_square_step =
Clight.Sset jets_secp._j
  (Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._j Ctypesdefs.tint)
     (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint)
     : Clight.statement
### C.jet_secp_root_square_loop.root_square_call
root_square_call =
fun id : AST.ident =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_sqr jets_secp.f_secp256k1_fe_sqr
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address id)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address id) (@nil Clight.expr)))
     : forall _ : AST.ident, Clight.statement

Arguments root_square_call id
### C.jet_secp_root_square_loop.root_square_loop
root_square_loop =
fun (id : AST.ident) (limit : BinNums.Z) =>
Clight.Sloop
  (Clight.Ssequence (Clight.Sifthenelse (root_square_guard limit) Clight.Sskip Clight.Sbreak) (root_square_call id))
  root_square_step
     : forall (_ : AST.ident) (_ : BinNums.Z), Clight.statement

Arguments root_square_loop id limit%Z_scope
### C.jet_secp_root_square_loop.root_square_for
root_square_for =
fun (id : AST.ident) (limit : BinNums.Z) =>
Clight.Ssequence (Clight.Sset jets_secp._j (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))
  (root_square_loop id limit)
     : forall (_ : AST.ident) (_ : BinNums.Z), Clight.statement

Arguments root_square_for id limit%Z_scope
### C.jet_secp_root_square_loop.root_body_spine
root_body_spine =
fix root_body_spine (s : Clight.statement) : list Clight.statement :=
  match s return (list Clight.statement) with
  | Clight.Sskip => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Sassign _ _ => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Sset _ _ => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Scall _ _ _ => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Sbuiltin _ _ _ _ => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Ssequence a b => @cons Clight.statement a (root_body_spine b)
  | Clight.Sifthenelse _ _ _ => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Sloop _ _ => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Sbreak => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Scontinue => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Sreturn _ => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Sswitch _ _ => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Slabel _ _ => @cons Clight.statement s (@nil Clight.statement)
  | Clight.Sgoto _ => @cons Clight.statement s (@nil Clight.statement)
  end
     : forall _ : Clight.statement, list Clight.statement

Arguments root_body_spine s
### C.jet_secp_root_square_loop.root_square_words
root_square_words =
fix root_square_words (n : nat) (w : forall _ : nat, Integers.Int64.int) {struct n} :
    forall _ : nat, Integers.Int64.int :=
  match n return (forall _ : nat, Integers.Int64.int) with
  | O => w
  | S k => root_square_words k (jet_secp_square_numeric.square_words w)
  end
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments root_square_words n%nat_scope w%function_scope _%nat_scope
