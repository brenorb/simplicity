                         old source)))) (_ : jet_input_layout.frame_input_bit_at m bi edge (BinInt.Z.add rc j) bit),
       jet_encoding.frame_output_bit_at mf bw outedge (BinInt.Z.sub (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) j)
