                                                      (jet_secp_modinv_de_numeric.de62_matrix_value
                                                         (jet_secp_modinv_var_de.inv_de_rho rho) high)
                                                      (BinInt.Z.mul jet_secp_canonical_scalar.canonical_group_order
                                                         (jet_secp_scalar_de_numeric.scalar_de62_correction_value
                                                            (jet_secp_modinv_var_de.inv_de_rho rho) high))))
                                                (@eq BinNums.Z
                                                   (BinInt.Z.modulo
                                                      (BinInt.Z.sub
                                                         (BinInt.Z.mul
                                                            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                               (BinNums.Zpos (BinNums.xO (...))))
                                                            (jet_secp_modinv_de_numeric.de62_input_value
                                                               (jet_secp_modinv_var_de.inv_de_rho
                                                                  (scalar_inv_iteration_rho len rho)) high))
                                                         (jet_secp_modinv_de_numeric.de62_matrix_value
                                                            (jet_secp_modinv_var_de.inv_de_rho rho) high))
                                                      jet_secp_canonical_scalar.canonical_group_order) BinNums.Z0))
                                             (and
                                                (forall high : bool,
                                                 @eq BinNums.Z
                                                   (jet_secp_modinv_var_fg.inv_fg_active_value
                                                      (scalar_inv_iteration_length len rho)
                                                      (scalar_inv_iteration_rho len rho) high)
                                                   (BinInt.Z.div
