### C.jet_secp_scalar_inverse_iteration.exec_scalar_inv_after_divsteps
exec_scalar_inv_after_divsteps
     : forall (value : BinNums.Z) (len : nat) (rho : forall _ : nat, Integers.Int64.int) (st : divstep.State)
         (beta : jet_sx_state.layout) (e : Clight.env) (le0 : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : and (lt O len) (le len (S (S (S (S (S O)))))))
         (_ : jet_sx_state.rep rho beta
                (jet_secp_modinv_loop_modulus.inv_mod_loop_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) m)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_var_entry.inv_start_alloc) e)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._modinfo le0)
                (@Some Values.val
                   (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le0)
                (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat len)))))
         (_ : jet_secp_scalar_de_ranges.scalar_de62_state_bounds (jet_secp_modinv_var_de.inv_de_rho rho))
         (_ : jet_secp_modinv_var_invariant.inv_state_matches len rho st)
         (_ : jet_secp_modinv_var_invariant.inv_matrix_matches rho st)
         (_ : jet_secp_scalar_de_invariant.scalar_de62_coefficient_link value (jet_secp_modinv_var_de.inv_de_rho rho)
                st)
         (_ : forall (high : bool) (j : nat) (_ : lt j (S (S (S (S (S O)))))),
              BinInt.Z.le
                (BinInt.Z.abs
                   (Integers.Int64.signed
                      (jet_secp_modinv_fg_loop_numeric.fg_array_word (jet_secp_modinv_var_fg.inv_fg_rho len rho) high j)))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex ClightBigstep.outcome
               (fun out : ClightBigstep.outcome =>
                and
                  (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 m
                     jet_secp_modinv_var_tail.inv_after_divsteps Events.E0 lef mf out)
                  (and
                     (jet_sx_state.rep (scalar_inv_iteration_rho len rho) beta
                        (jet_secp_modinv_loop_modulus.inv_mod_loop_regs jet_secp_scalar_normalize62.modinfo_scalar_limb)
                        mf)
