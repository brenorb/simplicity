                                 (jet_secp_modinv_var_de.inv_de_rho (scalar_inv_iteration_rho len rho))
                                 (@fst divstep.State (list divstep.Step)
                                    (divstep.stepN (S (S (S (S (S (S (S (S (S (S (S ...))))))))))) st)))
                              (and
                                 (jet_secp_modinv_var_invariant.inv_state_matches (scalar_inv_iteration_length len rho)
                                    (scalar_inv_iteration_rho len rho)
                                    (@fst divstep.State (list divstep.Step)
                                       (divstep.stepN (S (S (S (S (S (S (S (S (S (S ...)))))))))) st)))
                                 (and
                                    (jet_secp_modinv_var_tail.inv_tail_low_bounds (scalar_inv_iteration_length len rho)
                                       (scalar_inv_iteration_rho len rho))
                                    (and
                                       (forall _ : @eq BinNums.Z (divstep.g st) BinNums.Z0,
                                        and (@eq ClightBigstep.outcome out ClightBigstep.Out_break)
                                          (@eq BinNums.Z
                                             (BinInt.Z.modulo
                                                (jet_secp_modinv_de_numeric.de62_input_value
                                                   (jet_secp_modinv_var_de.inv_de_rho
                                                      (scalar_inv_iteration_rho len rho)) false)
                                                jet_secp_canonical_scalar.canonical_group_order)
                                             (BinInt.Z.modulo
                                                (jet_secp_modinv_de_numeric.de62_input_value
                                                   (jet_secp_modinv_var_de.inv_de_rho rho) false)
                                                jet_secp_canonical_scalar.canonical_group_order)))
                                       (and
                                          (forall _ : jet_secp_modinv_var_ranges.inv_fg_value_capacity len rho,
                                           and
                                             (jet_secp_modinv_var_ranges.inv_fg_limb_bounds
                                                (scalar_inv_iteration_rho len rho))
                                             (jet_secp_modinv_var_ranges.inv_fg_value_capacity
                                                (scalar_inv_iteration_length len rho)
                                                (scalar_inv_iteration_rho len rho)))
                                          (and
                                             (forall high : bool,
                                              and
                                                (@eq BinNums.Z
                                                   (BinInt.Z.mul
                                                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                         (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (...))))))
                                                      (jet_secp_modinv_de_numeric.de62_input_value
