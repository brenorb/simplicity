                                                         (jet_secp_modinv_var_fg.inv_fg_rho len
                                                            (jet_secp_scalar_inverse_updates.scalar_inv_de_next_rho rho))
                                                         high len)
                                                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                         (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (...))))))))
                                                (and
                                                   (iff (@eq ClightBigstep.outcome out ClightBigstep.Out_break)
                                                      (@eq BinNums.Z
                                                         (jet_secp_modinv_var_fg.inv_fg_active_value
                                                            (scalar_inv_iteration_length len rho)
                                                            (scalar_inv_iteration_rho len rho) true) BinNums.Z0))
                                                   (and
