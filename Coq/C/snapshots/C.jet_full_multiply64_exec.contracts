### C.jet_full_multiply64_exec.call_frame_u128_mul
call_frame_u128_mul
     : forall (le : Maps.PTree.tree Values.val) (m mk : Memory.Mem.mem) (bl br : Values.block)
         (a b : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._x le) (@Some Values.val (Values.Vlong a)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._y le) (@Some Values.val (Values.Vlong b)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_secp256k1_u128_mul)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong a) (@cons Values.val (Values.Vlong b) (@nil Values.val)))) Events.E0
                mk Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_multiply64_exec.e_frame_u128 bl br) le m frame_u128_mul_call
         Events.E0 le mk ClightBigstep.Out_normal
### C.jet_full_multiply64_exec.call_frame_u128_accum
call_frame_u128_accum
     : forall (id : BinNums.positive) (le : Maps.PTree.tree Values.val) (m mk : Memory.Mem.mem)
         (bl br : Values.block) (a : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le) (@Some Values.val (Values.Vlong a)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_secp256k1_u128_accum_u64)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong a) (@nil Values.val))) Events.E0 mk Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_multiply64_exec.e_frame_u128 bl br) le m
         (frame_u128_accum_call id) Events.E0 le mk ClightBigstep.Out_normal
### C.jet_full_multiply64_exec.eval_full_multiply64_composes
eval_full_multiply64_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem')
         (mc mr1 mr2 mr3 mr4 mk mz mw me mf : Memory.Mem.mem) (bl br bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval) (a b u v : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block mb br))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mb bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mb bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr1
                (Values.Vlong a))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr1
                (@Ctypes.Internal Clight.function jets.f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong b))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function jets.f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr3
                (Values.Vlong u))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr3
                (@Ctypes.Internal Clight.function jets.f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr4
                (Values.Vlong v))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr4
                (@Ctypes.Internal Clight.function jets.f_secp256k1_u128_mul)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong a) (@cons Values.val (Values.Vlong b) (@nil Values.val)))) Events.E0
                mk Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mk
                (@Ctypes.Internal Clight.function jets.f_secp256k1_u128_accum_u64)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong u) (@nil Values.val))) Events.E0 mz Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mz
                (@Ctypes.Internal Clight.function jets.f_secp256k1_u128_accum_u64)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong v) (@nil Values.val))) Events.E0 mw Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mw (@Ctypes.Internal Clight.function jets.f_write128)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free_list me (Clight.blocks_of_env jet_exec.ge0 (jet_multiply64_exec.e_frame_u128 bl br)))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_full_multiply_64)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_full_multiply64_exec.frame_u128_mul_call
frame_u128_mul_call =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets._secp256k1_u128_mul
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._secp256k1_uint128 Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil))) Ctypesdefs.tvoid
        AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets._r (Ctypes.Tstruct jets._secp256k1_uint128 Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets._secp256k1_uint128 Ctypes.noattr)))
     (@cons Clight.expr (Clight.Etempvar jets._x Ctypesdefs.tulong)
        (@cons Clight.expr (Clight.Etempvar jets._y Ctypesdefs.tulong) (@nil Clight.expr))))
     : Clight.statement
### C.jet_full_multiply64_exec.frame_u128_accum_call
frame_u128_accum_call =
fun id : AST.ident =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets._secp256k1_u128_accum_u64
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._secp256k1_uint128 Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets._r (Ctypes.Tstruct jets._secp256k1_uint128 Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets._secp256k1_uint128 Ctypes.noattr)))
     (@cons Clight.expr (Clight.Etempvar id Ctypesdefs.tulong) (@nil Clight.expr)))
     : forall _ : AST.ident, Clight.statement

Arguments frame_u128_accum_call id
### C.jet_full_multiply64_exec.full_multiply64_temps
full_multiply64_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_full_multiply_64 bd (Integers.Ptrofs.repr dbase) bs
  (Integers.Ptrofs.repr sbase)
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments full_multiply64_temps env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_full_multiply64_exec.full_multiply64_read_temps
full_multiply64_read_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
  (a b u v : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._w (Values.Vlong v)
  (@Maps.PTree.set Values.val jets._t'4 (Values.Vlong v)
     (@Maps.PTree.set Values.val jets._z (Values.Vlong u)
        (@Maps.PTree.set Values.val jets._t'3 (Values.Vlong u)
           (@Maps.PTree.set Values.val jets._y (Values.Vlong b)
              (@Maps.PTree.set Values.val jets._t'2 (Values.Vlong b)
                 (@Maps.PTree.set Values.val jets._x (Values.Vlong a)
                    (@Maps.PTree.set Values.val jets._t'1 (Values.Vlong a)
                       (full_multiply64_temps env bd dbase bs sbase))))))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments full_multiply64_read_temps env bd dbase%Z_scope bs sbase%Z_scope a b u v
