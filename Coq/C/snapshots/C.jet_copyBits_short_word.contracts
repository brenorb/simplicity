### C.jet_copyBits_short_word.copy_short_value
copy_short_value =
fun (ss ds : BinNums.Z) (old source : Integers.Int64.int) =>
match Coqlib.zlt ss ds return Integers.Int64.int with
| left _ => jet_copyBits_helper_exec.copy_left_value ss ds old source
| right _ => jet_copyBits_helper_right.copy_right_value ss ds old source
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments copy_short_value (ss ds)%Z_scope old source
