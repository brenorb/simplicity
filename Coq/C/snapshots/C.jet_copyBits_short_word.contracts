### C.jet_copyBits_short_word.copy_left_value_bits
copy_left_value_bits
     : forall (ss ds : BinNums.Z) (old source : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (and (BinInt.Z.lt ss ds)
                   (BinInt.Z.le ds
                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq bool (Integers.Int64.testbit (jet_copyBits_helper_exec.copy_left_value ss ds old source) i)
         match Coqlib.zlt i (BinInt.Z.sub ds ss) return bool with
         | left _ => false
         | right _ =>
             match Coqlib.zlt i ds return bool with
             | left _ => Integers.Int64.testbit source (BinInt.Z.sub i (BinInt.Z.sub ds ss))
             | right _ => Integers.Int64.testbit old i
             end
         end
### C.jet_copyBits_short_word.copy_right_value_bits
copy_right_value_bits
     : forall (ss ds : BinNums.Z) (old source : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ds)
                (BinInt.Z.le ds
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : and (BinInt.Z.le ds ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq bool (Integers.Int64.testbit (jet_copyBits_helper_right.copy_right_value ss ds old source) i)
         match Coqlib.zlt i ds return bool with
         | left _ => Integers.Int64.testbit source (BinInt.Z.add i (BinInt.Z.sub ss ds))
         | right _ => Integers.Int64.testbit old i
         end
