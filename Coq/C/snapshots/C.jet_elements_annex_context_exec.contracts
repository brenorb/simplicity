### C.jet_elements_annex_context_exec.ah_in_readBit
ah_in_readBit
     : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function jets._readBit jets.f_readBit)
         jet_elements_support_sha_transport.sha_core_helpers
### C.jet_elements_annex_context_exec.ah_cast32
ah_cast32
     : forall m : Memory.Mem.mem,
       @eq (option Values.val)
         (Cop.sem_cast
            (Values.Vint
               (Integers.Int.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            Ctypesdefs.tint Ctypesdefs.tulong m)
         (@Some Values.val
            (Values.Vlong
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
### C.jet_elements_annex_context_exec.ah_cast0
ah_cast0
     : forall m : Memory.Mem.mem,
