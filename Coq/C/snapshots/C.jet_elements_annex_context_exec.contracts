### C.jet_elements_annex_context_exec.ah_len
ah_len
     : forall (n : nat) (k : BinNums.Z) (_ : @eq BinNums.Z (BinInt.Z.of_nat n) k),
       @eq Integers.Int64.int (Integers.Int64.repr (BinInt.Z.of_nat n)) (Integers.Int64.repr k)
### C.jet_elements_annex_context_exec.annex_bytes_length
annex_bytes_length
     : forall a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       @eq BinNums.Z (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (annex_bytes a))) (annex_count a)
### C.jet_elements_annex_context_exec.elements_annex_hash_local_spec
elements_annex_hash_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       jet_nonce_local_common.nonce_sha_partial_local_spec jets_elements.f_simplicity_annex_hash
         (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
            (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) jet_sha256_ctx8_init_spec.sha256_ctx8_type
         (fun
            a : Ty.tySem
                  (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) =>
          @jet_bitcoin_ctx_hash_spec.annex_hash_spec (Alg.AssertionSem Option.option_Monad_Zero) a)
### C.jet_elements_annex_context_exec.ah_env
ah_env =
fun bl bm bb bx : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._ctx
  (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._buf
     (@pair Values.block Ctypes.type bb
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._midstate
        (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._src
           (@pair Values.block Ctypes.type bl jet_nonce_context_shape.nc_fr) Clight.empty_env)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments ah_env bl bm bb bx
### C.jet_elements_annex_context_exec.ah_temps
ah_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_elements._env env
  (@Maps.PTree.set Values.val jets_elements._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_elements._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_simplicity_annex_hash))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments ah_temps env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_elements_annex_context_exec.uchar_ty
uchar_ty =
Ctypes.Tfunction
  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
     (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default
     : Ctypes.type
### C.jet_elements_annex_context_exec.ah_readbit
ah_readbit =
Clight.Scall (@Some AST.ident jets_elements._t'2)
  (Clight.Evar jets_elements._readBit
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Ctypes.Tnil)
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._src jet_nonce_context_shape.nc_fr)
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) (@nil Clight.expr))
     : Clight.statement
### C.jet_elements_annex_context_exec.ah_read8s
ah_read8s =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._read8s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar)
           (Ctypes.Tcons Ctypesdefs.tulong
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Evar jets_elements._buf
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@cons Clight.expr
        (Clight.Econst_int
           (Integers.Int.repr
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
           Ctypesdefs.tint)
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_elements._src jet_nonce_context_shape.nc_fr)
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) (@nil Clight.expr))))
     : Clight.statement
### C.jet_elements_annex_context_exec.ah_uchar
ah_uchar =
fun k : BinNums.Z =>
Clight.Scall (@None AST.ident) (Clight.Evar jets_elements._sha256_uchar uchar_ty)
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
     (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr k) Ctypesdefs.tint) (@nil Clight.expr)))
     : forall _ : BinNums.Z, Clight.statement

Arguments ah_uchar k%Z_scope
### C.jet_elements_annex_context_exec.ah_uchars
ah_uchars =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._sha256_uchars jet_elements_support_sha_finalize_exec.uchars_ty)
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Evar jets_elements._buf
           (Ctypesdefs.tarray Ctypesdefs.tuchar
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        (@cons Clight.expr
           (Clight.Econst_int
              (Integers.Int.repr
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
              Ctypesdefs.tint) (@nil Clight.expr))))
     : Clight.statement
### C.jet_elements_annex_context_exec.ah_mid
ah_mid =
Clight.Ssequence ah_readbit
  (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'2 Ctypesdefs.tbool)
     (Clight.Ssequence ah_read8s (Clight.Ssequence (ah_uchar (BinNums.Zpos BinNums.xH)) ah_uchars))
     (ah_uchar BinNums.Z0))
     : Clight.statement
### C.jet_elements_annex_context_exec.ah_write
ah_write =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_elements._t'3)
     (Clight.Evar jets_elements._simplicity_write_sha256_context
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof
              (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
           (@nil Clight.expr))))
  (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_elements._t'3 Ctypesdefs.tbool)))
     : Clight.statement
### C.jet_elements_annex_context_exec.ah_rest
ah_rest =
Clight.Ssequence jet_nonce_context_shape.nc_context_read (Clight.Ssequence ah_mid ah_write)
     : Clight.statement
### C.jet_elements_annex_context_exec.annex_bytes
annex_bytes =
fun a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl _ =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_zero
      (@nil (Ty.tySem (Word.Word (S (S (S O))))))
| inr h =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_one
      (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
end
     : forall _ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments annex_bytes a
### C.jet_elements_annex_context_exec.annex_count
annex_count =
fun a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos BinNums.xH
| inr _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
end
     : forall _ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))), BinNums.Z

Arguments annex_count a
### C.jet_elements_annex_context_exec.annex_bit
annex_bit =
fun a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
match a return bool with
| inl _ => false
| inr _ => true
end
     : forall _ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))), bool

Arguments annex_bit a
