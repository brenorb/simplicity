### C.jet_elements_entropy_hash_model.hash_buffer_regs
hash_buffer_regs =
fun bs : list Integers.Int.int =>
@snd (list Integers.Int.int) (list Integers.Int.int)
  (jet_elements_support_sha_uchars_prep.absorb_i
     (@fst (list Integers.Int.int) (list Integers.Int.int)
        (jet_elements_support_sha_uchars_prep.absorb_i (@nil Integers.Int.int) jet_sha256_iv_init.sha256_iv_words bs))
     (@snd (list Integers.Int.int) (list Integers.Int.int)
        (jet_elements_support_sha_uchars_prep.absorb_i (@nil Integers.Int.int) jet_sha256_iv_init.sha256_iv_words bs))
     (jet_elements_support_sha_finalize_exec.sha_pad
        (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int bs)))))
     : forall _ : list Integers.Int.int, list Integers.Int.int

Arguments hash_buffer_regs bs%list_scope
