### C.jet_bitcoin_annex_hash_jet.ah_len
ah_len
     : forall (n : nat) (k : BinNums.Z) (_ : @eq BinNums.Z (BinInt.Z.of_nat n) k),
       @eq Integers.Int64.int (Integers.Int64.repr (BinInt.Z.of_nat n)) (Integers.Int64.repr k)
### C.jet_bitcoin_annex_hash_jet.ctx_abs_other
ctx_abs_other
     : forall (m m' : Memory.Mem.mem) (bx bm : Values.block) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool)
         (_ : jet_sha_ctx_abs.ctx_abs m bx bm l regs c ovf)
         (_ : forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                (_ : or (@eq Values.block b bx)
                       (or (@eq Values.block b bm)
                          (or
                             (@eq Values.block b
                                (jet_sha_linkage.sha_symbol_block jets_sha._simplicity_sha256_compression))
                             (@eq Values.block b (jet_sha_linkage.sha_symbol_block jets_sha._sha256_max_counter))))),
              @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
         (_ : forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p),
       jet_sha_ctx_abs.ctx_abs m' bx bm l regs c ovf
### C.jet_bitcoin_annex_hash_jet.ah_counter_two
ah_counter_two
     : forall (r : Integers.Int64.int) (len : BinNums.Z)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned r)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.lt len
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       let c : Integers.Int64.int := jet_read_sha256_counter.sha256_read_counter r (Integers.Int64.repr len) in
       and
         (@eq Integers.Int64.int
            (Integers.Int64.add (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (Integers.Int64.add c
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (@eq bool
            (jet_sha_uchars_exec.uc_overflow
               (jet_sha_uchars_exec.uc_overflow false c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
               (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (jet_sha_uchars_exec.uc_overflow false c
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
### C.jet_bitcoin_annex_hash_jet.annex_bytes_length
annex_bytes_length
     : forall a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       @eq BinNums.Z (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (annex_bytes a))) (annex_count a)
### C.jet_bitcoin_annex_hash_jet.bitcoin_annex_hash_local_spec
bitcoin_annex_hash_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       jet_sha_ctx8_add_jets.sha_jet_partial_local_spec jets_sha.f_simplicity_bitcoin_annex_hash
         (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
            (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) jet_sha256_ctx8_init_spec.sha256_ctx8_type
         (fun
            a : Ty.tySem
                  (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) =>
          @jet_bitcoin_ctx_hash_spec.annex_hash_spec (Alg.AssertionSem Option.option_Monad_Zero) a)
### C.jet_bitcoin_annex_hash_jet.ah_env
ah_env =
fun bl bm bb bx : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._ctx
  (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._buf
     (@pair Values.block Ctypes.type bb
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._midstate
        (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._src
           (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Clight.empty_env)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments ah_env bl bm bb bx
### C.jet_bitcoin_annex_hash_jet.ah_temps
ah_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_sha._env env
  (@Maps.PTree.set Values.val jets_sha._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_sha._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_sha.f_simplicity_bitcoin_annex_hash))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments ah_temps env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_bitcoin_annex_hash_jet.uchar_ty
uchar_ty =
Ctypes.Tfunction
  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
     (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default
     : Ctypes.type
### C.jet_bitcoin_annex_hash_jet.ah_readbit
ah_readbit =
Clight.Scall (@Some AST.ident jets_sha._t'2)
  (Clight.Evar jets_sha._readBit
     (Ctypes.Tfunction (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Ctypes.Tnil)
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))) (@nil Clight.expr))
     : Clight.statement
### C.jet_bitcoin_annex_hash_jet.ah_read8s
ah_read8s =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_sha._read8s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar)
           (Ctypes.Tcons Ctypesdefs.tulong
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Evar jets_sha._buf
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@cons Clight.expr
        (Clight.Econst_int
           (Integers.Int.repr
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
           Ctypesdefs.tint)
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))) (@nil Clight.expr))))
     : Clight.statement
### C.jet_bitcoin_annex_hash_jet.ah_uchar
ah_uchar =
fun k : BinNums.Z =>
Clight.Scall (@None AST.ident) (Clight.Evar jets_sha._sha256_uchar uchar_ty)
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
     (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr k) Ctypesdefs.tint) (@nil Clight.expr)))
     : forall _ : BinNums.Z, Clight.statement

Arguments ah_uchar k%Z_scope
### C.jet_bitcoin_annex_hash_jet.ah_uchars
ah_uchars =
Clight.Scall (@None AST.ident) (Clight.Evar jets_sha._sha256_uchars jet_sha_finalize_exec.uchars_ty)
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Evar jets_sha._buf
           (Ctypesdefs.tarray Ctypesdefs.tuchar
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        (@cons Clight.expr
           (Clight.Econst_int
              (Integers.Int.repr
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
              Ctypesdefs.tint) (@nil Clight.expr))))
     : Clight.statement
### C.jet_bitcoin_annex_hash_jet.ah_mid
ah_mid =
Clight.Ssequence ah_readbit
  (Clight.Sifthenelse (Clight.Etempvar jets_sha._t'2 Ctypesdefs.tbool)
     (Clight.Ssequence ah_read8s (Clight.Ssequence (ah_uchar (BinNums.Zpos BinNums.xH)) ah_uchars))
     (ah_uchar BinNums.Z0))
     : Clight.statement
### C.jet_bitcoin_annex_hash_jet.ah_write
ah_write =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_sha._t'3)
     (Clight.Evar jets_sha._simplicity_write_sha256_context
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_sha._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))) (@nil Clight.expr))))
  (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_sha._t'3 Ctypesdefs.tbool)))
     : Clight.statement
### C.jet_bitcoin_annex_hash_jet.ah_rest
ah_rest = Clight.Ssequence jet_sha_ctx8_finalize_jet.fz_read (Clight.Ssequence ah_mid ah_write)
     : Clight.statement
### C.jet_bitcoin_annex_hash_jet.annex_bytes
annex_bytes =
fun a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl _ =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_zero
      (@nil (Ty.tySem (Word.Word (S (S (S O))))))
| inr h =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_one
      (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
end
     : forall _ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments annex_bytes a
### C.jet_bitcoin_annex_hash_jet.annex_count
annex_count =
fun a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos BinNums.xH
| inr _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
end
     : forall _ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))), BinNums.Z

Arguments annex_count a
### C.jet_bitcoin_annex_hash_jet.annex_bit
annex_bit =
fun a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
match a return bool with
| inl _ => false
| inr _ => true
end
     : forall _ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))), bool

Arguments annex_bit a
