### C.jet_bitcoin_linkage.bitcoin_write32_symbol
bitcoin_write32_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv bitcoin_ge)
            jets_bitcoin._simplicity_write32)
         (@Some Values.block (bitcoin_symbol_block jets_bitcoin._simplicity_write32))
### C.jet_bitcoin_linkage.bitcoin_write32_funct
bitcoin_write32_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv bitcoin_ge)
            (Values.Vptr (bitcoin_symbol_block jets_bitcoin._simplicity_write32) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_bitcoin.f_simplicity_write32))
### C.jet_bitcoin_linkage.bitcoin_write32_body_shared
bitcoin_write32_body_shared
     : @eq Clight.function jets_bitcoin.f_simplicity_write32 jets.f_simplicity_write32
### C.jet_bitcoin_linkage.bitcoin_frame_composite_shared
bitcoin_frame_composite_shared
     : @eq (option Ctypes.composite)
         (@Maps.PTree.get Ctypes.composite jets_bitcoin._frameItem (Clight.genv_cenv bitcoin_ge))
         (@Maps.PTree.get Ctypes.composite jets._frameItem (@Ctypes.prog_comp_env Clight.function jets.prog))
### C.jet_bitcoin_linkage.bitcoin_env_tx_field
bitcoin_env_tx_field
     : match @Maps.PTree.get Ctypes.composite jets_bitcoin._txEnv (Clight.genv_cenv bitcoin_ge) return Prop with
       | Some co =>
           @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
             (Ctypes.field_offset (Clight.genv_cenv bitcoin_ge) jets_bitcoin._tx (Ctypes.co_members co))
             (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield BinNums.Z0 Ctypes.Full))
       | None => False
       end
### C.jet_bitcoin_linkage.bitcoin_tx_version_field
bitcoin_tx_version_field
     : match
         @Maps.PTree.get Ctypes.composite jets_bitcoin._bitcoinTransaction (Clight.genv_cenv bitcoin_ge) return Prop
       with
       | Some co =>
           @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
             (Ctypes.field_offset (Clight.genv_cenv bitcoin_ge) jets_bitcoin._version (Ctypes.co_members co))
             (@Errors.OK (prod BinNums.Z Ctypes.bitfield)
                (@pair BinNums.Z Ctypes.bitfield
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                   Ctypes.Full))
       | None => False
       end
### C.jet_bitcoin_linkage.bitcoin_ge
bitcoin_ge = Clight.globalenv jets_bitcoin.prog
     : Clight.genv
### C.jet_bitcoin_linkage.bitcoin_symbol_block
bitcoin_symbol_block =
fun id : AST.ident =>
match @Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv bitcoin_ge) id return Values.block with
| Some b => b
| None => BinNums.xH
end
     : forall _ : AST.ident, Values.block

Arguments bitcoin_symbol_block id
