### C.jet_secp_modinv_loop_modulus.exec_inv_mod_fg_caller
exec_inv_mod_fg_caller
     : forall (mu : forall _ : nat, Integers.Int64.int) (len : nat) (rho : forall _ : nat, Integers.Int64.int)
         (beta : jet_sx_state.layout) (e : Clight.env) (le0 : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : and (lt O len) (le len (S (S (S (S (S O))))))) (_ : jet_sx_state.rep rho beta (inv_mod_loop_regs mu) m)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_var_entry.inv_start_alloc) e)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le0)
                (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat len)))))
         (_ : jet_secp_modinv_fg_start.fg_input_bounds (jet_secp_modinv_var_fg.inv_fg_rho len rho)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le0 m jet_secp_modinv_var_fg.inv_fg_statement
               Events.E0 le0 mf ClightBigstep.Out_normal)
            (and (jet_sx_state.rep (jet_secp_modinv_var_fg.inv_fg_next_rho len rho) beta (inv_mod_loop_regs mu) mf)
               (and
                  (forall high : bool,
                   @eq BinNums.Z
                     (jet_secp_modinv_fg_body.fg_body_value len (jet_secp_modinv_var_fg.inv_fg_rho len rho) high)
                     (BinInt.Z.div
                        (jet_secp_modinv_fg_body.fg_matrix_value (jet_secp_modinv_var_fg.inv_fg_rho len rho) high len)
                        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (jet_sx_state.foot (jet_secp_modinv_var_fg.inv_fg_layout beta)
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape jet_secp_modinv_fg_prefix.fg_regs) b ofs)) m mf))))
### C.jet_secp_modinv_loop_modulus.inv_mod_loop_regs
inv_mod_loop_regs =
fun mu : forall _ : nat, Integers.Int64.int =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 O)) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (jet_sx_rep.u64_cells BinNums.Z0
           (@List.map Integers.Int64.int jet_sx_expr.sx jet_sx_expr.XLc
              (jet_secp_modinv_entry_modulus.inv_mod_words mu))) false (@None BinNums.Z))
     (@cons jet_sx_state.region
        (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 (S (S (S (S (S O))))))) true
           (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
        (@cons jet_sx_state.region
           (jet_sx_state.mkreg
              (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_fe_nv.vars5 (S (S (S (S (S (S (S (S (S (S O)))))))))))) true
              (@Some BinNums.Z
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
           (@cons jet_sx_state.region
              (jet_sx_state.mkreg
                 (jet_sx_rep.u64_cells BinNums.Z0
                    (jet_secp_fe_nv.vars5 (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))) true
                 (@Some BinNums.Z
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
              (@cons jet_sx_state.region
                 (jet_sx_state.mkreg
                    (jet_sx_rep.u64_cells BinNums.Z0
                       (jet_secp_fe_nv.vars5 (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))) true
                    (@Some BinNums.Z
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                 (@cons jet_sx_state.region
                    (jet_sx_state.mkreg
                       (jet_sx_rep.u64_cells BinNums.Z0
                          (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))
                             (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))
                                (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S (S ...)))))))))))
                                   (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S (S (S ...))))))))))
                                      (@nil jet_sx_expr.sx)))))) true
                       (@Some BinNums.Z
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                    (@nil jet_sx_state.region)))))))
     : forall _ : forall _ : nat, Integers.Int64.int, list jet_sx_state.region

