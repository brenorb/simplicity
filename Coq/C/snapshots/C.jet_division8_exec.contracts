  (bs : Values.block) (sofs : Integers.Ptrofs.int) (r t : Integers.Int.int) =>
@Maps.PTree.set Values.val jets._y
  (Values.Vint (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t))
  (@Maps.PTree.set Values.val jets._t'2 (Values.Vint t) (le_division8_x env remainder bd dofs bs sofs r))
     : forall (_ : Values.val) (_ : bool) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Integers.Int.int) (_ : Integers.Int.int), Maps.PTree.tree Values.val

