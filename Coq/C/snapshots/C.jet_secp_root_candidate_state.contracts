### C.jet_secp_root_candidate_state.root_single_preserves
root_single_preserves
     : forall (e : Clight.env) (m mf : Memory.Mem.mem) (s : Maps.PTree.t (forall _ : nat, Integers.Int64.int))
         (id : AST.ident) (bd : Values.block) (out : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_root_chain_owned.root_locals_separated e) (_ : jet_secp_root_chain_owned.root_locals_owned e m)
         (_ : jet_secp_root_chain_owned.root_values_at e m s)
         (_ : @List.In AST.ident id jet_secp_root_chain_owned.root_private_ids)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bd jet_secp_curve_statements.curve_fe_type)))
         (_ : jet_secp_square_columns.square_input_bounds out)
         (_ : jet_secp_fe_nv.fe_at mf bd BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 out))
         (_ : Memory.Mem.range_perm mf bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m mf),
       and (jet_secp_root_chain_owned.root_locals_owned e mf)
         (jet_secp_root_chain_owned.root_values_at e mf (@Maps.PTree.set (forall _ : nat, Integers.Int64.int) id out s))
### C.jet_secp_root_candidate_state.exec_root_squares_state
exec_root_squares_state
     : forall (n : nat) (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (s : Maps.PTree.t (forall _ : nat, Integers.Int64.int)) (id : BinNums.positive) (bd : Values.block)
         (w : forall _ : nat, Integers.Int64.int)
         (_ : BinInt.Z.le (BinInt.Z.of_nat n)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : jet_secp_root_chain_owned.root_locals_separated e) (_ : jet_secp_root_chain_owned.root_locals_owned e m)
         (_ : jet_secp_root_chain_owned.root_values_at e m s)
         (_ : @eq (option (forall _ : nat, Integers.Int64.int))
                (@Maps.PTree.get (forall _ : nat, Integers.Int64.int) id s)
                (@Some (forall _ : nat, Integers.Int64.int) w))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bd jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (jet_secp_root_square_loop.root_square_for id (BinInt.Z.of_nat n)) Events.E0 lef mf
                  ClightBigstep.Out_normal)
               (and (jet_secp_root_chain_owned.root_locals_owned e mf)
                  (and
                     (jet_secp_root_chain_owned.root_values_at e mf
                        (@Maps.PTree.set (forall _ : nat, Integers.Int64.int) id
                           (jet_secp_root_square_loop.root_square_words n w) s))
                     (and
                        (forall (k : AST.ident) (_ : not (@eq AST.ident k jets_secp._j)),
                         @eq (option Values.val) (@Maps.PTree.get Values.val k lef) (@Maps.PTree.get Values.val k le))
                        (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m mf))))))
### C.jet_secp_root_candidate_state.exec_root_inplace_square_state
exec_root_inplace_square_state
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (s : Maps.PTree.t (forall _ : nat, Integers.Int64.int)) (id : BinNums.positive) (bd : Values.block)
         (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_root_chain_owned.root_locals_separated e)
         (_ : jet_secp_root_chain_owned.root_locals_owned e m) (_ : jet_secp_root_chain_owned.root_values_at e m s)
         (_ : @eq (option (forall _ : nat, Integers.Int64.int))
                (@Maps.PTree.get (forall _ : nat, Integers.Int64.int) id s)
                (@Some (forall _ : nat, Integers.Int64.int) w))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bd jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_root_square_loop.root_square_call id) Events.E0 le mf ClightBigstep.Out_normal)
            (and (jet_secp_root_chain_owned.root_locals_owned e mf)
               (and
                  (jet_secp_root_chain_owned.root_values_at e mf
                     (@Maps.PTree.set (forall _ : nat, Integers.Int64.int) id (jet_secp_square_numeric.square_words w)
                        s))
                  (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m mf))))
### C.jet_secp_root_candidate_state.exec_root_square_out_state
exec_root_square_out_state
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (s : Maps.PTree.t (forall _ : nat, Integers.Int64.int)) (id : BinNums.positive) (bs br : Values.block)
         (dest : Clight.expr) (w : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_root_chain_owned.root_locals_owned e m) (_ : jet_secp_root_chain_owned.root_values_at e m s)
         (_ : @eq (option (forall _ : nat, Integers.Int64.int))
                (@Maps.PTree.get (forall _ : nat, Integers.Int64.int) id s)
                (@Some (forall _ : nat, Integers.Int64.int) w))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_curve_statements.curve_fe_type)))
         (_ : jet_secp_root_chain_owned.root_chain_frame e br BinNums.Z0)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq Ctypes.type (Clight.typeof dest) (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
         (_ : Clight.eval_expr jet_secp_linkage.secp_ge e le m dest (Values.Vptr br Integers.Ptrofs.zero))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (root_square_out_stmt dest id) Events.E0
               le mf ClightBigstep.Out_normal)
            (and (jet_secp_root_chain_owned.root_locals_owned e mf)
               (and (jet_secp_root_chain_owned.root_values_at e mf s)
                  (and
                     (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words w)))
                     (and
                        (Memory.Mem.range_perm mf br BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b br)) (not (@eq Values.block b bs))) m mf))))))
### C.jet_secp_root_candidate_state.root_square_out_stmt
root_square_out_stmt =
fun (dest : Clight.expr) (id : AST.ident) =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_sqr jets_secp.f_secp256k1_fe_sqr
  (@None AST.ident)
  (@cons Clight.expr dest (@cons Clight.expr (jet_secp_curve_statements.curve_local_address id) (@nil Clight.expr)))
     : forall (_ : Clight.expr) (_ : AST.ident), Clight.statement

Arguments root_square_out_stmt dest id
