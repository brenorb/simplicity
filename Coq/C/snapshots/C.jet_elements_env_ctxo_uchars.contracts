### C.jet_elements_env_ctxo_uchars.ctxo_uchars
ctxo_uchars
     : forall (_ : jet_memcpy_model.memcpy_model) (bx bo : Values.block) (obase : BinNums.Z)
         (_ : not (@eq Values.block bo bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bo))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bo))
         (_ : and (BinInt.Z.le BinNums.Z0 obase)
                (BinInt.Z.le
                   (BinInt.Z.add obase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   Integers.Ptrofs.max_unsigned)) (m : Memory.Mem.mem) (ba : Values.block)
         (oa : Integers.Ptrofs.int) (l regs bs : list Integers.Int.int) (c : Integers.Int64.int)
         (ovf : bool) (_ : jet_elements_env_ctxo.ctxo m bx bo obase l regs c ovf) (_ : not (@eq Values.block ba bx))
         (_ : not (@eq Values.block ba bo))
         (_ : BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat (@length Integers.Int.int bs)))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int bs)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i bs Integers.Int.zero)))),
       let vn : Integers.Int64.int := Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int bs)) in
       let ovf' : bool := jet_elements_support_sha_uchars_exec.uc_overflow ovf c vn in
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_sha256_uchars)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr BinNums.Z0))
                  (@cons Values.val (Values.Vptr ba oa) (@cons Values.val (Values.Vlong vn) (@nil Values.val))))
               Events.E0 m' (Values.Vint (jet_readBit_layout.bit_int (negb ovf'))))
            (and
               (jet_elements_env_ctxo.ctxo m' bx bo obase
                  (@fst (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs bs))
                  (@snd (list Integers.Int.int) (list Integers.Int.int)
                     (jet_elements_support_sha_uchars_prep.absorb_i l regs bs)) (Integers.Int64.add c vn) ovf')
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : not (@eq Values.block b bx))
                     (_ : or (not (@eq Values.block b bo))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) obase)
                               (BinInt.Z.le
                                  (BinInt.Z.add obase
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
