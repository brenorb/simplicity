         (m : Memory.Mem.mem) (bx br bl : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd base bw outedge cursor N) (_ : BinInt.Z.le BinNums.Z0 N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc
