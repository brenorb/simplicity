       jet_bitmachine_rep.jet_local_spec (jet_constant.constant_jet s high) Ty.Unit
         (Word.Word (jet_constant.constant_log s))
         (fun a : Ty.tySem Ty.Unit => @jet_constant.constant_spec s high Alg.CoreFunSem a)
