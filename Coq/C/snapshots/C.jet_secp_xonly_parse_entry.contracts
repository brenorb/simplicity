### C.jet_secp_xonly_parse_entry.xonly_parse_ok
xonly_parse_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_secp256k1_xonly_pubkey_parse) true
### C.jet_secp_xonly_parse_entry.xonly_parse_blocks
xonly_parse_blocks
     : forall bp bx : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (xonly_parse_env bp bx))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bp BinNums.Z0)
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
### C.jet_secp_xonly_parse_entry.xonly_parse_entry_owned
xonly_parse_entry_owned
     : forall (m : Memory.Mem.mem) (key input : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bp : Values.block =>
             @ex Values.block
               (fun bx : Values.block =>
                and
                  (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_xonly_pubkey_parse
                     (@cons Values.val key (@cons Values.val input (@nil Values.val))) m (xonly_parse_env bp bx)
                     (xonly_parse_temps key input) mi)
                  (and (@List.NoDup Values.block (@cons Values.block bp (@cons Values.block bx (@nil Values.block))))
                     (and
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                         not
                           (@List.In Values.block b (@cons Values.block bp (@cons Values.block bx (@nil Values.block)))))
                        (and
                           (Memory.Mem.range_perm mi bp BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mi bx BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                                 (and (jet_clight_internal_permissions.keeps_permissions m mi)
                                    (jet_clight_internal_preserve.readonly_preserved m mi))))))))))
