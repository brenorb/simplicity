### C.jet_asset_local_bridges.asset_amount_stream_count
asset_amount_stream_count
     : forall (p : Ty.tySem jet_nonce_context_spec.nonce_conf_type)
         (a : Ty.tySem jet_amount_exec_common.amount_value_type),
       @eq BinNums.Z
         (BinInt.Z.of_nat
            (@length (Ty.tySem (Word.Word (S (S (S O)))))
               (@app (Ty.tySem (Word.Word (S (S (S O))))) (jet_asset_exec_asset.asset_bytes p)
                  (jet_amount_exec_common.amount_bytes a))))
         (BinInt.Z.add (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            (jet_amount_exec_common.amount_count a))
### C.jet_asset_local_bridges.asset_entry_sha
asset_entry_sha
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 : Memory.Mem.mem') (bl bm bb bx bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bm))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 bb))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m4 bx)),
       Clight.function_entry2 jet_elements_support_sha_linkage.sha_ge jets_elements.f_simplicity_asset_amount_hash
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (jet_nonce_context_shape.nc_env bl bm bb bx) (jet_asset_exec_shape.asset_amount_temps env bd dbase bs sbase)
         m4
### C.jet_asset_local_bridges.amount_temps_other
amount_temps_other
     : forall (a : Ty.tySem jet_amount_exec_common.amount_value_type) (le : Maps.PTree.tree Values.val)
         (id : AST.ident) (_ : not (@eq AST.ident id jets_elements._t'4))
         (_ : not (@eq AST.ident id jets_elements._t'5)),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (jet_amount_exec_common.amount_temps a le))
         (@Maps.PTree.get Values.val id le)
### C.jet_asset_local_bridges.asset_temps_other
asset_temps_other
     : forall (p : Ty.tySem jet_nonce_context_spec.nonce_conf_type) (le : Clight.temp_env)
         (id : AST.ident) (_ : not (@eq AST.ident id jets_elements._t'2))
         (_ : not (@eq AST.ident id jets_elements._t'3)),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (jet_nonce_exec_phase.nonce_present_temps p le))
         (@Maps.PTree.get Values.val id le)
