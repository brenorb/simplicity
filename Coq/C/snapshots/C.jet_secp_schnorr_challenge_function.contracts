### C.jet_secp_schnorr_challenge_function.schnorr_challenge_entry_storage
schnorr_challenge_entry_storage
     : forall (m : Memory.Mem.mem) (be ba : Values.block) (oa : Integers.Ptrofs.int) (bm : Values.block)
         (om : Integers.Ptrofs.int) (bp : Values.block) (op : Integers.Ptrofs.int),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bb : Values.block =>
             @ex Values.block
               (fun bs : Values.block =>
                @ex Values.block
                  (fun bc : Values.block =>
                   @ex Values.block
                     (fun br : Values.block =>
                      and
                        (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_schnorrsig_challenge
                           (@cons Values.val (Values.Vptr be Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr ba oa)
                                 (@cons Values.val (Values.Vptr bm om)
                                    (@cons Values.val
                                       (Values.Vlong
                                          (Integers.Int64.repr
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                       (@cons Values.val (Values.Vptr bp op) (@nil Values.val)))))) m
                           (jet_secp_schnorr_challenge_entry.schnorr_challenge_env bb bs bc br)
                           (jet_secp_schnorr_challenge_entry.schnorr_challenge_temps be ba oa bm om bp op) mi)
                        (and
                           (@List.NoDup Values.block
                              (@cons Values.block bb
                                 (@cons Values.block bs
                                    (@cons Values.block bc (@cons Values.block br (@nil Values.block))))))
                           (and
                              (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                               not
                                 (@List.In Values.block b
                                    (@cons Values.block bb
                                       (@cons Values.block bs
                                          (@cons Values.block bc (@cons Values.block br (@nil Values.block)))))))
                              (and
                                 (forall (b : Values.block) (hi : BinNums.Z)
                                    (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                                           (@cons (prod Values.block BinNums.Z)
                                              (@pair Values.block BinNums.Z bb
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                              (@cons (prod Values.block BinNums.Z)
                                                 (@pair Values.block BinNums.Z bs
                                                    (BinNums.Zpos
                                                       (BinNums.xO
                                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                                 (@cons (prod Values.block BinNums.Z)
                                                    (@pair Values.block BinNums.Z bc
                                                       (BinNums.Zpos
                                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))
                                                    (@cons (prod Values.block BinNums.Z)
                                                       (@pair Values.block BinNums.Z br
                                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...))))))
                                                       (@nil (prod Values.block BinNums.Z))))))),
                                  Memory.Mem.range_perm mi b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                                 (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                                    (jet_clight_internal_preserve.readonly_preserved m mi))))))))))
### C.jet_secp_schnorr_challenge_function.schnorr_challenge_free_storage
schnorr_challenge_free_storage
     : forall (m : Memory.Mem.mem) (bb bs bc br : Values.block)
         (_ : @List.NoDup Values.block
                (@cons Values.block bb
                   (@cons Values.block bs (@cons Values.block bc (@cons Values.block br (@nil Values.block))))))
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (@cons (prod Values.block BinNums.Z)
                          (@pair Values.block BinNums.Z bb
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                          (@cons (prod Values.block BinNums.Z)
                             (@pair Values.block BinNums.Z bs
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                             (@cons (prod Values.block BinNums.Z)
                                (@pair Values.block BinNums.Z bc
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                (@cons (prod Values.block BinNums.Z)
                                   (@pair Values.block BinNums.Z br
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                   (@nil (prod Values.block BinNums.Z))))))),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.free_list m
                  (Clight.blocks_of_env jet_secp_linkage.secp_ge
                     (jet_secp_schnorr_challenge_entry.schnorr_challenge_env bb bs bc br)))
               (@Some Memory.Mem.mem mf))
            (and
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (_ : BinNums.Z) =>
                   not
                     (@List.In Values.block b
                        (@cons Values.block bb
                           (@cons Values.block bs (@cons Values.block bc (@cons Values.block br (@nil Values.block)))))))
                  m mf) (jet_clight_internal_preserve.readonly_preserved m mf)))
### C.jet_secp_schnorr_challenge_function.schnorr_scalar_storage
schnorr_scalar_storage
     : forall (m : Memory.Mem.mem) (be : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (_ : Memory.Mem.range_perm m be BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S O))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m be
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vlong (rho i)))),
       jet_secp_scalar_get_b32_storage.scalar_at m be BinNums.Z0
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)))
### C.jet_secp_schnorr_challenge_function.eval_schnorr_challenge_word
eval_schnorr_challenge_word
     : forall (_ : jet_memcpy_model.memcpy_model) (r pk msg : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (m : Memory.Mem.mem) (be ba : Values.block) (oa : Integers.Ptrofs.int) (bm : Values.block)
         (om : Integers.Ptrofs.int) (bp : Values.block) (op : Integers.Ptrofs.int)
         (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : Memory.Mem.range_perm m be BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned op)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned om)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_secp_schnorr_challenge_absorb.schnorr_bytes_at m ba oa
                (jet_secp_schnorr_challenge_hash.schnorr_word_bytes r))
         (_ : jet_secp_schnorr_challenge_absorb.schnorr_bytes_at m bp op
                (jet_secp_schnorr_challenge_hash.schnorr_word_bytes pk))
         (_ : jet_secp_schnorr_challenge_absorb.schnorr_bytes_at m bm om
                (jet_secp_schnorr_challenge_hash.schnorr_word_bytes msg)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_schnorrsig_challenge)
               (@cons Values.val (Values.Vptr be Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba oa)
                     (@cons Values.val (Values.Vptr bm om)
                        (@cons Values.val
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           (@cons Values.val (Values.Vptr bp op) (@nil Values.val)))))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf be BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem
                              (jet_secp_schnorr_challenge_hash.schnorr_challenge_hash_word r pk msg))))))
               (and
                  (Memory.Mem.range_perm mf be BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b be)) m mf)
                     (and (jet_clight_internal_preserve.readonly_preserved m mf)
                        (jet_secp_sha_startup.secp_sha_startup mf))))))
