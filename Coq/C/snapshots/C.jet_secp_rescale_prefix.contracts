### C.jet_secp_rescale_prefix.rescale_prefix_source
rescale_prefix_source
     : @eq Clight.statement
         (jet_secp_statement_prefix.statement_sequence (@List.firstn Clight.statement (S (S O)) rescale_spine)
            rescale_rest) (Clight.fn_body jets_secp.f_secp256k1_gej_rescale)
### C.jet_secp_rescale_prefix.rescale_prefix_completes
rescale_prefix_completes
     : @eq bool
         match rescale_prefix_run return bool with
         | Some r =>
             match r return bool with
             | jet_sx_exec.RDone _ o =>
                 match o return bool with
                 | jet_sx_exec.ONormal => true
                 | jet_sx_exec.OBreak => false
                 | jet_sx_exec.OContinue => false
                 | jet_sx_exec.OReturn _ => false
                 end
             | jet_sx_exec.RIf _ _ _ => false
             end
         | None => false
         end true
### C.jet_secp_rescale_prefix.rescale_prefix_run_eq
rescale_prefix_run_eq
     : @eq (option jet_sx_exec.res) rescale_prefix_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone rescale_prefix_state jet_sx_exec.ONormal))
### C.jet_secp_rescale_prefix.rescale_prefix_regions
rescale_prefix_regions
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs rescale_prefix_state)
         (@cons jet_sx_state.region rescale_point_storage
            (@cons jet_sx_state.region
               (jet_secp_square_separate_layout.separate_input true
                  (@Some BinNums.Z
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
               (@cons jet_sx_state.region rescale_square_reg (@nil jet_sx_state.region))))
### C.jet_secp_rescale_prefix.rescale_square_shape
rescale_square_shape
     : @eq (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
         (jet_sx_state.rshape rescale_square_reg)
         (@pair (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)
            (@pair (list (prod BinNums.Z AST.memory_chunk)) bool
               (@cons (prod BinNums.Z AST.memory_chunk) (@pair BinNums.Z AST.memory_chunk BinNums.Z0 AST.Mint64)
                  (@cons (prod BinNums.Z AST.memory_chunk)
                     (@pair BinNums.Z AST.memory_chunk (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                        AST.Mint64)
                     (@cons (prod BinNums.Z AST.memory_chunk)
                        (@pair BinNums.Z AST.memory_chunk
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) AST.Mint64)
                        (@cons (prod BinNums.Z AST.memory_chunk)
                           (@pair BinNums.Z AST.memory_chunk
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) AST.Mint64)
                           (@cons (prod BinNums.Z AST.memory_chunk)
                              (@pair BinNums.Z AST.memory_chunk
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 AST.Mint64) (@nil (prod BinNums.Z AST.memory_chunk))))))) true)
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
### C.jet_secp_rescale_prefix.rescale_square_defined
rescale_square_defined
     : @eq bool (jet_secp_multiply_run_run.field_cells_defined (jet_sx_state.rcells rescale_square_reg)) true
### C.jet_secp_rescale_prefix.rescale_square_r0
rescale_square_r0
     : @eq jet_sx_expr.sx
         (@List.nth jet_sx_expr.sx O
            (@List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_multiply_run_run.field_cell_value
               (jet_sx_state.rcells rescale_square_reg)) (jet_sx_expr.XLv O)) jet_secp_square_schedule.sq_r0
### C.jet_secp_rescale_prefix.rescale_square_r1
rescale_square_r1
     : @eq jet_sx_expr.sx
         (@List.nth jet_sx_expr.sx (S O)
            (@List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_multiply_run_run.field_cell_value
               (jet_sx_state.rcells rescale_square_reg)) (jet_sx_expr.XLv O)) jet_secp_square_schedule.sq_r1
### C.jet_secp_rescale_prefix.rescale_square_r2
rescale_square_r2
     : @eq jet_sx_expr.sx
         (@List.nth jet_sx_expr.sx (S (S O))
            (@List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_multiply_run_run.field_cell_value
               (jet_sx_state.rcells rescale_square_reg)) (jet_sx_expr.XLv O)) jet_secp_square_schedule.sq_r2
### C.jet_secp_rescale_prefix.rescale_square_r3
rescale_square_r3
     : @eq jet_sx_expr.sx
         (@List.nth jet_sx_expr.sx (S (S (S O)))
            (@List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_multiply_run_run.field_cell_value
               (jet_sx_state.rcells rescale_square_reg)) (jet_sx_expr.XLv O)) jet_secp_square_schedule.sq_r3
### C.jet_secp_rescale_prefix.rescale_square_r4
rescale_square_r4
     : @eq jet_sx_expr.sx
         (@List.nth jet_sx_expr.sx (S (S (S (S O))))
            (@List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_multiply_run_run.field_cell_value
               (jet_sx_state.rcells rescale_square_reg)) (jet_sx_expr.XLv O)) jet_secp_square_schedule.sq_r4
### C.jet_secp_rescale_prefix.rescale_square_values
rescale_square_values
     : @eq (list jet_sx_expr.sx)
         (@List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_multiply_run_run.field_cell_value
            (jet_sx_state.rcells rescale_square_reg)) jet_secp_square_execution.square_limbs
### C.jet_secp_rescale_prefix.rescale_square_rebuild
rescale_square_rebuild
     : @eq jet_sx_state.region rescale_square_reg
         (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_square_execution.square_limbs) true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
### C.jet_secp_rescale_prefix.exec_rescale_through_square
exec_rescale_through_square
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem) (_ : jet_sx_state.rep rho beta rescale_prefix_regs m)
         (_ : jet_sx_eval.tmatch rho beta rescale_prefix_temps le)
         (_ : jet_sx_eval.ematch beta (@snd (list jet_sx_state.region) jet_sx_eval.venv rescale_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m rescale_prefix Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and
                  (jet_sx_state.rep rho beta
                     (@cons jet_sx_state.region rescale_point_storage
                        (@cons jet_sx_state.region
                           (jet_secp_square_separate_layout.separate_input true
                              (@Some BinNums.Z
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@cons jet_sx_state.region
                              (jet_sx_state.mkreg
                                 (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_square_execution.square_limbs) true
                                 (@Some BinNums.Z
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                              (@nil jet_sx_state.region)))) mf)
                  (and (jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps rescale_prefix_state) le')
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape (jet_sx_eval.sregs rescale_prefix_state))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape rescale_prefix_regs))
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot beta
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape rescale_prefix_regs) b ofs)) m mf))))))
### C.jet_secp_rescale_prefix.exec_rescale_square_numeric
exec_rescale_square_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem) (_ : jet_secp_square_columns.square_input_bounds rho)
         (_ : jet_sx_state.rep rho beta rescale_prefix_regs m)
         (_ : jet_sx_eval.tmatch rho beta rescale_prefix_temps le)
         (_ : jet_sx_eval.ematch beta (@snd (list jet_sx_state.region) jet_sx_eval.venv rescale_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m rescale_prefix Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and
                  (jet_secp_fe_nv.fe_at mf (jet_sx_state.blk beta (S (S O))) (jet_sx_state.bas beta (S (S O)))
                     (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words rho)))
                  (and
                     (Memory.Mem.range_perm mf (jet_sx_state.blk beta (S (S O))) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_secp_fe_nv.fe_at mf (jet_sx_state.blk beta (S O)) (jet_sx_state.bas beta (S O))
                           (jet_secp_multiply_normalize_bridge.words5 rho))
                        (and
                           (Memory.Mem.range_perm mf (jet_sx_state.blk beta (S O)) BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf (jet_sx_state.blk beta O) BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (@eq BinNums.Z
                                    (BinInt.Z.modulo
                                       (jet_secp_multiply_finish_product.radix_value
                                          (jet_secp_square_numeric.square_words rho))
                                       jet_secp_multiply_checkpoint_columns.field_prime)
                                    (BinInt.Z.modulo
                                       (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value rho)
                                          (jet_secp_multiply_finish_product.radix_value rho))
                                       jet_secp_multiply_checkpoint_columns.field_prime))
                                 (and
                                    (jet_secp_square_columns.square_input_bounds
                                       (jet_secp_square_numeric.square_words rho))
                                    (and (jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps rescale_prefix_state) le')
                                       (jet_sx_mem.lframe
                                          (fun (b : Values.block) (ofs : BinNums.Z) =>
                                           not
                                             (jet_sx_state.foot beta
                                                (@List.map jet_sx_state.region
                                                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool)
                                                      (option BinNums.Z)) jet_sx_state.rshape rescale_prefix_regs) b
                                                ofs)) m mf)))))))))))
### C.jet_secp_rescale_prefix.rescale_point_storage
rescale_point_storage =
jet_sx_state.mkreg (@nil jet_sx_state.cell) true
  (@Some BinNums.Z
     (BinNums.Zpos
        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     : jet_sx_state.region
### C.jet_secp_rescale_prefix.rescale_prefix_regs
rescale_prefix_regs =
@cons jet_sx_state.region rescale_point_storage
  (@cons jet_sx_state.region
     (jet_secp_square_separate_layout.separate_input true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     (@cons jet_sx_state.region
        (jet_sx_state.mkreg
           (@List.map BinNums.Z jet_sx_state.cell
              (fun ofs : BinNums.Z => jet_sx_state.mkcell ofs AST.Mint64 (@None jet_sx_expr.sx))
              (@cons BinNums.Z BinNums.Z0
                 (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                    (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                       (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))
                          (@cons BinNums.Z
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                             (@nil BinNums.Z))))))) true
           (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
        (@nil jet_sx_state.region)))
     : list jet_sx_state.region
### C.jet_secp_rescale_prefix.rescale_prefix_temps
rescale_prefix_temps =
@Maps.PTree.set jet_sx_expr.sx jets_secp._s (jet_sx_expr.XP (S O) BinNums.Z0)
  (@Maps.PTree.set jet_sx_expr.sx jets_secp._r (jet_sx_expr.XP O BinNums.Z0) (Maps.PTree.empty jet_sx_expr.sx))
     : Maps.PTree.tree jet_sx_expr.sx
### C.jet_secp_rescale_prefix.rescale_allocated
rescale_allocated =
match
  jet_sx_mem.xalloc (jet_sx_mem.std_cells (Clight.genv_cenv jet_secp_linkage.secp_ge))
    (Clight.genv_cenv jet_secp_linkage.secp_ge) (Clight.fn_vars jets_secp.f_secp256k1_gej_rescale)
    (S (S O)) return (prod (list jet_sx_state.region) jet_sx_eval.venv)
with
| Some p => p
| None =>
    @pair (list jet_sx_state.region) (list (prod AST.ident (prod nat Ctypes.type))) (@nil jet_sx_state.region)
      (@nil (prod AST.ident (prod nat Ctypes.type)))
end
     : prod (list jet_sx_state.region) jet_sx_eval.venv
### C.jet_secp_rescale_prefix.rescale_spine
rescale_spine =
@fst (list Clight.statement) Clight.statement
  (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_gej_rescale))
     : list Clight.statement
### C.jet_secp_rescale_prefix.rescale_prefix
rescale_prefix =
jet_secp_statement_prefix.statement_sequence (@List.firstn Clight.statement (S (S O)) rescale_spine) Clight.Sskip
     : Clight.statement
### C.jet_secp_rescale_prefix.rescale_rest
rescale_rest =
jet_secp_statement_prefix.statement_sequence (@List.skipn Clight.statement (S (S O)) rescale_spine)
  (@snd (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_gej_rescale)))
     : Clight.statement
### C.jet_secp_rescale_prefix.rescale_prefix_initial
rescale_prefix_initial =
jet_sx_eval.mkst rescale_prefix_temps rescale_prefix_regs (@nil jet_sx_eval.event) (S (S (S (S (S O)))))
     : jet_sx_eval.sstate
### C.jet_secp_rescale_prefix.rescale_prefix_run
rescale_prefix_run =
jet_sx_exec.xstmt (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_multiply_run_run.field_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  (@snd (list jet_sx_state.region) jet_sx_eval.venv rescale_allocated) rescale_prefix_initial rescale_prefix
     : option jet_sx_exec.res
### C.jet_secp_rescale_prefix.rescale_prefix_state
rescale_prefix_state =
match rescale_prefix_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ => rescale_prefix_initial
    end
| None => rescale_prefix_initial
end
     : jet_sx_eval.sstate
### C.jet_secp_rescale_prefix.rescale_square_reg
rescale_square_reg =
@List.nth jet_sx_state.region (S (S O)) (jet_sx_eval.sregs rescale_prefix_state)
  (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))
     : jet_sx_state.region
