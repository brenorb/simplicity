### C.jet_right_extend_word8_exec.right_extend_word8_fill_from_sequence
right_extend_word8_fill_from_sequence
     : forall (bf : Values.block) (base : BinNums.Z) (bit : bool) (n : nat) (m mf : Memory.Mem.mem)
         (_ : jet_write8_sequence.write8_sequence_run bf base
                (@List.repeat Integers.Int.int (jet_extend_bit8_exec.extend_bit8_arg bit) n) m mf),
       jet_right_extend_word8_loop.right_extend_word8_fill_run bf base bit n m mf
### C.jet_right_extend_word8_exec.right_extend_word8_body_shape
right_extend_word8_body_shape
     : forall s : jet_extend_word8_loop.extend_word8_size,
       @eq Clight.statement (Clight.fn_body (jet_right_extend_word8_loop.right_extend_word8_function s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (jet_binary8_exec.binary8_read jets._t'1)
                  (Clight.Sset jets._input
                     (Clight.Ecast (Clight.Etempvar jets._t'1 Ctypesdefs.tuchar) Ctypesdefs.tuchar)))
               (Clight.Ssequence (Clight.Sset jets._lsb jet_right_extend_word8_loop.right_extend_word8_lsb_expr)
                  (Clight.Ssequence
                     (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write8 Ctypesdefs.tuchar
                        Ctypesdefs.tvoid (Clight.Etempvar jets._input Ctypesdefs.tuchar))
                     (Clight.Ssequence
                        (Clight.Ssequence (Clight.Sset jets._i (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))
                           (jet_right_extend_word8_loop.right_extend_word8_loop s))
                        (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))))))))
### C.jet_right_extend_word8_exec.eval_right_extend_word8_composes
eval_right_extend_word8_composes
     : forall (env : Values.val) (s : jet_extend_word8_loop.extend_word8_size) (m : Memory.Mem.mem)
         (ma : Memory.Mem.mem') (mc mr me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval) (r : Integers.Int.int)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint r))
         (_ : jet_write8_sequence.write8_sequence_run bd dbase
                (jet_right_extend_word_spec.right_extend_word8_output_args s r) mr me)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function (jet_right_extend_word8_loop.right_extend_word8_function s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_right_extend_word8_exec.right_extend_word8_prepared
right_extend_word8_prepared =
fun (le : Maps.PTree.tree Values.val) (r : Integers.Int.int) =>
@Maps.PTree.set Values.val jets._lsb
  (Values.Vint
     (jet_readBit_layout.bit_int
        (jet_right_extend_word8_loop.right_extend_word8_lsb (jet_extend_word8_exec.extend_word8_payload r))))
  (@Maps.PTree.set Values.val jets._input (Values.Vint (jet_extend_word8_exec.extend_word8_payload r))
     (@Maps.PTree.set Values.val jets._t'1 (Values.Vint r) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Integers.Int.int), Maps.PTree.tree Values.val

Arguments right_extend_word8_prepared le r
