fun (k w : nat) (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))) =>
jet_sha_hash_words.hash_words_of k
  (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (BinInt.Z.to_nat (jet_forWhile_seq.wsize w)) xs)
     : forall (k _ : nat) (_ : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))), Digest.hash256

Arguments elements_words_hash_of (k w)%nat_scope xs%list_scope
