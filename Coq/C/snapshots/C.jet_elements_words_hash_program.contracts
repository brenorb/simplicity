### C.jet_elements_words_hash_program.elements_prim_words_hash_spec_sem
elements_prim_words_hash_spec_sem
     : forall (k w : nat)
         (p : jet_elements_prim.Elements.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (xs_of : forall _ : jet_elements_prim.Elements.env, list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
         (_ : forall (i : Ty.tySem (Word.Word w)) (e : jet_elements_prim.Elements.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (@jet_elements_prim.Elements.sem (Word.Word w)
                   (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) p i e)
                (@Some (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (xs_of e)
                       (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x => @inr unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None => @inl unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end))
         (_ : BinInt.Z.lt
                (BinInt.Z.div
                   (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)) (jet_forWhile_seq.wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                jet_sha_ctx8_spec.ctx8_limit) (e : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@elements_prim_words_hash_spec k w p (EFP.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt e)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.from_hash256 (elements_words_hash_of k w (xs_of e))))
### C.jet_elements_words_hash_program.elements_tx_words_hash_jet
elements_tx_words_hash_jet
     : forall (k w : nat)
         (p : jet_elements_prim.Elements.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (xs_of : forall _ : jet_elements_prim.Elements.env,
                  list
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Word.Vector (Word.Word (S (S (S O)))) k))) (f : Clight.function)
         (field : AST.ident) (hdelta : BinNums.Z)
         (_ : forall (i : Ty.tySem (Word.Word w)) (e : jet_elements_prim.Elements.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (@jet_elements_prim.Elements.sem (Word.Word w)
                   (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) p i e)
                (@Some
                   (sum unit
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end) (Word.Vector (Word.Word (S (S (S O)))) k)) (xs_of e)
                       (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return
                       (sum unit
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x =>
                       @inr unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None =>
                       @inl unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end))
         (_ : BinInt.Z.lt
                (BinInt.Z.div
                   (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)) (jet_forWhile_seq.wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                jet_sha_ctx8_spec.ctx8_limit)
         (_ : jet_elements_wrapper.elements_wrapper_shape f
                (jet_elements_wrapper.elements_simple_rest
                   (jet_elements_hash_getters.elements_hash_mid_writeHash jets_elements._tx
                      jets_elements._elementsTransaction field)))
         (_ : jet_elements_field_eval.elements_field_at jets_elements._elementsTransaction field hdelta)
         (_ : and (BinInt.Z.le BinNums.Z0 hdelta)
                (BinInt.Z.le
                   (BinInt.Z.add hdelta
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))),
       jet_application_sep.application_jet_local_spec_sep f jet_elements_linkage.elements_ge
         jet_elements_prim.Elements.env Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@jet_elements_hash_getter_local.hash_getter_rep jet_elements_prim.Elements.env
            (fun e : jet_elements_prim.Elements.env => elements_words_hash_of k w (xs_of e)) BinNums.Z0 hdelta
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
         (fun (a : Ty.tySem Ty.Unit) (e : jet_elements_prim.Elements.env) =>
          @elements_prim_words_hash_spec k w p (EFP.Theory.PrimitivePrimSem Option.option_Monad_Zero) a e)
