### C.jet_elements_composite_amounts_hash.elements_outputs_hash_of
elements_outputs_hash_of =
fun e : jet_elements_prim.Elements.env =>
jet_bitcoin_composite_hash.sha256_bytes_of
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S (S O)))))))
     (@pair
        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.from_hash256 (jet_elements_amounts_hash_program.elements_output_amounts_hash_of e))
           (Word.from_hash256 (jet_elements_nonces_hash_program.elements_output_nonces_hash_of e)))
        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.from_hash256
              (jet_elements_words_hash_program.elements_words_hash_of (S (S (S (S (S O)))))
                 (S (S (S (S (S O))))) (jet_elements_words_hash_program.elements_output_scripts_words e)))
           (Word.from_hash256
              (jet_elements_words_hash_program.elements_words_hash_of (S (S (S (S (S O)))))
                 (S (S (S (S (S O))))) (jet_elements_words_hash_program.elements_output_range_proofs_words e))))))
     : forall _ : jet_elements_prim.Elements.env, Digest.hash256

Arguments elements_outputs_hash_of e
