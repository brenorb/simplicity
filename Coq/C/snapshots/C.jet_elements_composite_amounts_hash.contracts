### C.jet_elements_composite_amounts_hash.elements_fixed_vector_hash_spec
elements_fixed_vector_hash_spec =
fun (k : nat) (alg : jet_elements_words_hash_program.EFP.Algebra)
  (payload : jet_elements_words_hash_program.EFP.domain alg Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) =>
let term : Alg.Assertion.Algebra := jet_elements_words_hash_program.EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit
  (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
     (Word.Vector (Word.Word (S (S (S O)))) k) core (@jet_sha256_ctx8_init_spec.sha256_ctx8_init_spec core) payload)
  (@jet_sha256_ctx8_init_spec.AC.comp
     (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k))
     jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_ctx8_spec.ctx8_addn_spec k term) (@jet_sha_finalize_spec.ctx8_finalize_spec term))
     : forall (k : nat) (alg : jet_elements_words_hash_program.EFP.Algebra)
         (_ : jet_elements_words_hash_program.EFP.domain alg Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)),
       jet_elements_words_hash_program.EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments elements_fixed_vector_hash_spec k%nat_scope {alg} payload
### C.jet_elements_composite_amounts_hash.elements_outputs_hash_spec
elements_outputs_hash_spec =
fun alg : jet_elements_words_hash_program.EFP.Algebra =>
let core : Alg.Core.Algebra :=
  Alg.Assertion.toCore (jet_elements_words_hash_program.EFP.CanonicalStructures.toAssertion alg) in
@elements_fixed_vector_hash_spec (S (S (S (S (S (S (S O))))))) alg
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_elements_amounts_hash_program.elements_output_amounts_hash_spec alg)
        (@jet_elements_nonces_hash_program.elements_output_nonces_hash_spec alg))
     (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_elements_words_hash_program.elements_prim_words_hash_spec (S (S (S (S (S O)))))
           (S (S (S (S (S O))))) jet_elements_prim.Elements.OutputScriptHash alg)
        (@jet_elements_words_hash_program.elements_prim_words_hash_spec (S (S (S (S (S O)))))
           (S (S (S (S (S O))))) jet_elements_prim.Elements.OutputRangeProof alg)))
     : forall alg : jet_elements_words_hash_program.EFP.Algebra,
       jet_elements_words_hash_program.EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

