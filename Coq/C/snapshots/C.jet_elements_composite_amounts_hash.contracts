Arguments elements_input_utxos_hash_spec {alg}
### C.jet_elements_composite_amounts_hash.elements_input_utxos_hash_of
elements_input_utxos_hash_of =
fun e : jet_elements_prim.Elements.env =>
jet_bitcoin_composite_hash.sha256_bytes_of
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O))))))
     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
