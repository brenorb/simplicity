                   jet_secp_wnaf5_signed_array.wnaf5_literal_value (jet_secp_wnaf5_literal.literal_wnaf5_digits state))
                (@List.rev BinNums.Z
                   (@List.map nat BinNums.Z (fun j : nat => BinInt.Z.mul sign (digits (BinInt.Z.of_nat j)))
                      (List.seq O (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       and
         (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add last (BinNums.Zpos BinNums.xH)))
            (BinInt.Z.le (BinInt.Z.add last (BinNums.Zpos BinNums.xH))
