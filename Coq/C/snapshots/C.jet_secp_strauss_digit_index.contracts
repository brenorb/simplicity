### C.jet_secp_strauss_digit_index.strauss_wnaf5_digit_at
strauss_wnaf5_digit_at =
fun (state : Ty.tySem jet_secp_wnaf_literal.literal_wnaf_state) (i : BinNums.Z) =>
@List.nth
