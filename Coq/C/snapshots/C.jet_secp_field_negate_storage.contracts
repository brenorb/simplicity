### C.jet_secp_field_negate_storage.negate_rep_field
negate_rep_field
     : forall (m : Memory.Mem.mem) (b : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (_ : jet_sx_state.rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))) (jet_sx_eval.sregs jet_secp_field_negate.field_negate_state) m),
       and (jet_secp_fe_nv.fe_at m b BinNums.Z0 (negate_values rho))
         (Memory.Mem.range_perm m b BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
### C.jet_secp_field_negate_storage.eval_field_negate_to_field
eval_field_negate_to_field
     : forall (m : Memory.Mem.mem) (b : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (_ : jet_sx_state.rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))) jet_secp_local_regions.local_write_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf b BinNums.Z0 (negate_values rho))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b' : Values.block) (pos : BinNums.Z) =>
                      not
                        (jet_sx_state.foot
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                              (@nil (prod Values.block BinNums.Z)))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape jet_secp_local_regions.local_write_initial_regs) b' pos)) m mf))))
### C.jet_secp_field_negate_storage.negate_values
negate_values =
fun rho : forall _ : nat, Integers.Int64.int =>
@cons Integers.Int64.int (jet_secp_field_negate_values.negate_value rho O)
  (@cons Integers.Int64.int (jet_secp_field_negate_values.negate_value rho (S O))
     (@cons Integers.Int64.int (jet_secp_field_negate_values.negate_value rho (S (S O)))
        (@cons Integers.Int64.int (jet_secp_field_negate_values.negate_value rho (S (S (S O))))
           (@cons Integers.Int64.int (jet_secp_field_negate_values.negate_value rho (S (S (S (S O)))))
              (@nil Integers.Int64.int)))))
     : forall _ : forall _ : nat, Integers.Int64.int, list Integers.Int64.int

Arguments negate_values rho%function_scope
