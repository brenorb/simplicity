### C.jet_secp_decompress_body.decompress_body_value
decompress_body_value =
fun w : forall _ : nat, Integers.Int64.int =>
BinInt.Z.modulo
  (jet_secp_multiply_finish_product.radix_value
     (jet_secp_root_chain_numeric.root_chain_candidate (jet_secp_decompress_numeric.decompress_root_words w)))
  jet_secp_fe_math.feP
     : forall _ : forall _ : nat, Integers.Int64.int, BinNums.Z

Arguments decompress_body_value w%function_scope
### C.jet_secp_decompress_body.decompress_body_y
decompress_body_y =
fun (w : forall _ : nat, Integers.Int64.int) (odd : bool) =>
match
  jet_secp_root_check.root_check_flag (jet_secp_decompress_numeric.decompress_root_words w)
  return (list Integers.Int64.int)
with
| true => jet_secp_decompress_parity.decompress_parity_limbs (decompress_body_value w) odd
| false =>
    jet_secp_multiply_normalize_bridge.words5
      (jet_secp_root_chain_numeric.root_chain_candidate (jet_secp_decompress_numeric.decompress_root_words w))
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : bool), list Integers.Int64.int

Arguments decompress_body_y w%function_scope odd%bool_scope
### C.jet_secp_decompress_body.decompress_body_temps
decompress_body_temps =
fun (le : Maps.PTree.tree Values.val) (w : forall _ : nat, Integers.Int64.int) =>
match
  jet_secp_root_check.root_check_flag (jet_secp_decompress_numeric.decompress_root_words w)
  return (Maps.PTree.tree Values.val)
with
| true =>
    jet_secp_decompress_parity.decompress_parity_temps (jet_secp_decompress_root_test.decompress_root_temps le w)
      (decompress_body_value w)
| false => jet_secp_decompress_root_test.decompress_root_temps le w
end
     : forall (_ : Maps.PTree.tree Values.val) (_ : forall _ : nat, Integers.Int64.int), Maps.PTree.tree Values.val

Arguments decompress_body_temps le w%function_scope
### C.jet_secp_decompress_body.decompress_body_return
decompress_body_return =
fun w : forall _ : nat, Integers.Int64.int =>
match
  jet_secp_root_check.root_check_flag (jet_secp_decompress_numeric.decompress_root_words w) return Integers.Int.int
with
| true => Integers.Int.one
| false => Integers.Int.zero
end
     : forall _ : forall _ : nat, Integers.Int64.int, Integers.Int.int

Arguments decompress_body_return w%function_scope
