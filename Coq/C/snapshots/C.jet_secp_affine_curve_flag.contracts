### C.jet_secp_affine_curve_flag.curve_square_flag_readback
curve_square_flag_readback
     : forall (k : bool) (bout bin : Values.block) (m mf : Memory.Mem.mem) (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.valid_block m bin)
         (_ : jet_sx_mem.lframe
                (fun (b : Values.block) (pos : BinNums.Z) =>
                 not
                   (jet_sx_state.foot
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout BinNums.Z0)
                         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin BinNums.Z0)
                            (@nil (prod Values.block BinNums.Z))))
                      (@List.map jet_sx_state.region
                         (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                         jet_sx_state.rshape (jet_secp_curve_square.curve_square_regs k)) b pos)) m mf),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint32 mf bin
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (Memory.Mem.load AST.Mint32 m bin
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
