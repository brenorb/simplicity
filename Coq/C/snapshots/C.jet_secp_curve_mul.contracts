### C.jet_secp_curve_mul.curve_mul_value_bounds
curve_mul_value_bounds
     : forall (a b : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_field_mul_word_math.field_mul_operand_ok (Integers.Int64.unsigned (a O))
                (Integers.Int64.unsigned (a (S O))) (Integers.Int64.unsigned (a (S (S O))))
                (Integers.Int64.unsigned (a (S (S (S O))))) (Integers.Int64.unsigned (a (S (S (S (S O)))))))
         (_ : jet_secp_field_mul_word_math.field_mul_operand_ok (Integers.Int64.unsigned (b O))
                (Integers.Int64.unsigned (b (S O))) (Integers.Int64.unsigned (b (S (S O))))
                (Integers.Int64.unsigned (b (S (S (S O))))) (Integers.Int64.unsigned (b (S (S (S (S O))))))),
       and
         (@eq BinNums.Z
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value (jet_secp_point_mul_storage.point_mul_words a b))
               jet_secp_fe_math.feP)
            (BinInt.Z.modulo
               (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                  (jet_secp_multiply_finish_product.radix_value b)) jet_secp_fe_math.feP))
         (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
          BinInt.Z.lt (Integers.Int64.unsigned (jet_secp_point_mul_storage.point_mul_words a b i))
            match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
            | true =>
                BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
            | false =>
                BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
            end)
