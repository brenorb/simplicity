### C.jet_secp_affine_storage_frame.affine_storage_foot_bounds
affine_storage_foot_bounds
     : forall (bout bin : Values.block) (sbase : BinNums.Z) (b : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin sbase)
                      (@nil (prod Values.block BinNums.Z))))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   jet_secp_affine_storage.affine_storage_regs) b pos),
       or
         (and (@eq Values.block b bout)
            (and (BinInt.Z.le BinNums.Z0 pos)
               (BinInt.Z.lt pos
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
         (and (@eq Values.block b bin)
            (and (BinInt.Z.le sbase pos)
               (BinInt.Z.lt pos
                  (BinInt.Z.add sbase
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_affine_storage_frame.affine_storage_readonly_frame
affine_storage_readonly_frame
     : forall (w : forall _ : nat, Integers.Int64.int) (m mf : Memory.Mem.mem) (bout bin : Values.block)
         (sbase lo hi : BinNums.Z) (_ : not (@eq Values.block bout bin))
         (_ : jet_secp_affine_storage.affine_storage_readable m bin sbase w)
         (_ : jet_clight_readonly_frame.readonly_region_bounds m bin lo hi)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_from_storage)
                (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr sbase)) (@nil Values.val))) Events.E0 mf
                Values.Vundef) (_ : jet_secp_affine_storage.affine_storage_readable mf bin sbase w)
         (_ : jet_sx_mem.lframe
                (fun (b : Values.block) (pos : BinNums.Z) =>
                 not
                   (jet_sx_state.foot
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bout BinNums.Z0)
                         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bin sbase)
                            (@nil (prod Values.block BinNums.Z))))
                      (@List.map jet_sx_state.region
                         (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                         jet_sx_state.rshape jet_secp_affine_storage.affine_storage_regs) b pos)) m mf),
       and (jet_clight_readonly_frame.readonly_region_bounds mf bin lo hi)
         (jet_sx_mem.lframe
            (fun (b : Values.block) (pos : BinNums.Z) =>
             or (not (@eq Values.block b bout))
               (or (BinInt.Z.lt pos BinNums.Z0)
                  (BinInt.Z.le
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
            m mf)
### C.jet_secp_affine_storage_frame.eval_ge_from_storage_table
eval_ge_from_storage_table
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (sbase lo hi : BinNums.Z) (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_affine_storage.affine_storage_readable m bin sbase w)
         (_ : jet_clight_readonly_frame.readonly_region_bounds m bin lo hi),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_from_storage)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr sbase)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (Memory.Mem.range_perm mf bout BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (forall k : bool,
                   jet_secp_fe_nv.fe_at mf bout
                     match k return BinNums.Z with
                     | true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                     | false => BinNums.Z0
                     end (jet_secp_multiply_normalize_bridge.words5 (jet_secp_affine_storage.affine_storage_coord w k)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bout
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and (jet_secp_affine_storage.affine_storage_readable mf bin sbase w)
                        (and (jet_clight_readonly_frame.readonly_region_bounds mf bin lo hi)
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (pos : BinNums.Z) =>
                               or (not (@eq Values.block b bout))
                                 (or (BinInt.Z.lt pos BinNums.Z0)
                                    (BinInt.Z.le
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                       pos))) m mf)))))))
