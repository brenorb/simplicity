### C.jet_equality1_exec.eq1_expr
eq1_expr =
Clight.Ebinop Cop.Oeq (Clight.Etempvar jets._x Ctypesdefs.tbool) (Clight.Etempvar jets._y Ctypesdefs.tbool)
  Ctypesdefs.tint
     : Clight.expr
### C.jet_equality1_exec.eq1_bit
eq1_bit = Bool.eqb
     : forall (_ : bool) (_ : bool), bool

Arguments eq1_bit (b1 b2)%bool_scope
