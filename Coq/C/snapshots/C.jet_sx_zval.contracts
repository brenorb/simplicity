### C.jet_sx_zval.sh64_sound
sh64_sound
     : forall (o : jet_sx_expr.shop) (a : Integers.Int64.int) (la ha k lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z))
                (zb_sh
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) M64 o
                   la ha k) (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi)))
         (_ : and (BinInt.Z.le la (Integers.Int64.unsigned a)) (BinInt.Z.le (Integers.Int64.unsigned a) ha)),
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (jet_sx_expr.lsh o a k))
            match o return BinNums.Z with
            | jet_sx_expr.Hshl =>
                BinInt.Z.mul (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
            | jet_sx_expr.Hshr =>
                BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
            | jet_sx_expr.Hshru =>
                BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
            end)
         (and
            (BinInt.Z.le lo
               match o return BinNums.Z with
               | jet_sx_expr.Hshl =>
                   BinInt.Z.mul (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | jet_sx_expr.Hshr =>
                   BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | jet_sx_expr.Hshru =>
                   BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               end)
            (BinInt.Z.le
               match o return BinNums.Z with
               | jet_sx_expr.Hshl =>
                   BinInt.Z.mul (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | jet_sx_expr.Hshr =>
                   BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | jet_sx_expr.Hshru =>
                   BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               end hi))
