### C.jet_sx_zval.zb
zb =
fix zb (bnd : forall _ : nat, prod BinNums.Z BinNums.Z) (x : jet_sx_expr.sx) {struct x} :
    option (prod BinNums.Z BinNums.Z) :=
  match x return (option (prod BinNums.Z BinNums.Z)) with
  | jet_sx_expr.XI _ => @None (prod BinNums.Z BinNums.Z)
  | jet_sx_expr.XIc i =>
      @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z (Integers.Int.unsigned i) (Integers.Int.unsigned i))
  | jet_sx_expr.XL _ => @None (prod BinNums.Z BinNums.Z)
  | jet_sx_expr.XLc l =>
      @Some (prod BinNums.Z BinNums.Z)
        (@pair BinNums.Z BinNums.Z (Integers.Int64.unsigned l) (Integers.Int64.unsigned l))
  | jet_sx_expr.XLv n => @Some (prod BinNums.Z BinNums.Z) (bnd n)
  | jet_sx_expr.XV _ => @None (prod BinNums.Z BinNums.Z)
  | jet_sx_expr.XA _ _ => @None (prod BinNums.Z BinNums.Z)
  | jet_sx_expr.XP _ _ => @None (prod BinNums.Z BinNums.Z)
  | jet_sx_expr.XIb o a b =>
      match
        andb (jet_sx_expr.isk jet_sx_expr.KI a) (jet_sx_expr.isk jet_sx_expr.KI b)
        return (option (prod BinNums.Z BinNums.Z))
      with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair lb hb => zb_op M32 o la ha lb hb
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XLb o a b =>
      match
        andb (jet_sx_expr.isk jet_sx_expr.KL a) (jet_sx_expr.isk jet_sx_expr.KL b)
        return (option (prod BinNums.Z BinNums.Z))
      with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair lb hb => zb_op M64 o la ha lb hb
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XIsh o a k =>
      match jet_sx_expr.isk jet_sx_expr.KI a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  zb_sh (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) M32
                    o la ha k
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XLsh o a k =>
      match jet_sx_expr.isk jet_sx_expr.KL a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  zb_sh
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) M64 o
                    la ha k
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XIcmp _ sg a b =>
      match
        andb (jet_sx_expr.isk jet_sx_expr.KI a) (jet_sx_expr.isk jet_sx_expr.KI b)
        return (option (prod BinNums.Z BinNums.Z))
      with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair _ ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair _ hb =>
                          match sg return (option (prod BinNums.Z BinNums.Z)) with
                          | Ctypes.Signed =>
                              match
                                andb
                                  (BinInt.Z.ltb ha
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                  (BinInt.Z.ltb hb
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                return (option (prod BinNums.Z BinNums.Z))
                              with
                              | true =>
                                  @Some (prod BinNums.Z BinNums.Z)
                                    (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                              | false => @None (prod BinNums.Z BinNums.Z)
                              end
                          | Ctypes.Unsigned =>
                              @Some (prod BinNums.Z BinNums.Z)
                                (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                          end
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XLcmp _ sg a b =>
      match
        andb (jet_sx_expr.isk jet_sx_expr.KL a) (jet_sx_expr.isk jet_sx_expr.KL b)
        return (option (prod BinNums.Z BinNums.Z))
      with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair _ ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair _ hb =>
                          match sg return (option (prod BinNums.Z BinNums.Z)) with
                          | Ctypes.Signed =>
                              match
                                andb
                                  (BinInt.Z.ltb ha
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos
                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                  (BinInt.Z.ltb hb
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos
                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                return (option (prod BinNums.Z BinNums.Z))
                              with
                              | true =>
                                  @Some (prod BinNums.Z BinNums.Z)
                                    (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                              | false => @None (prod BinNums.Z BinNums.Z)
                              end
                          | Ctypes.Unsigned =>
                              @Some (prod BinNums.Z BinNums.Z)
                                (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                          end
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XI2L sg a =>
      match jet_sx_expr.isk jet_sx_expr.KI a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match sg return (option (prod BinNums.Z BinNums.Z)) with
                  | Ctypes.Signed =>
                      match
                        BinInt.Z.ltb ha
                          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                             (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                        return (option (prod BinNums.Z BinNums.Z))
                      with
                      | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z la ha)
                      | false => @None (prod BinNums.Z BinNums.Z)
                      end
                  | Ctypes.Unsigned => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z la ha)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XL2I a =>
      match jet_sx_expr.isk jet_sx_expr.KL a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match BinInt.Z.leb ha M32 return (option (prod BinNums.Z BinNums.Z)) with
                  | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z la ha)
                  | false => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 M32)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XIcast sz sg a =>
      match sz return (option (prod BinNums.Z BinNums.Z)) with
