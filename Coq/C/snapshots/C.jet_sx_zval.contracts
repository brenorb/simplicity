### C.jet_sx_zval.truth_zval
truth_zval
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : forall _ : nat, prod Values.block BinNums.Z)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (ρ n)))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (c : jet_sx_expr.sx) (lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z)) (zb bnd c)
                (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi)))
         (_ : @eq bool (jet_sx_expr.isk jet_sx_expr.KI c) true),
       @eq bool (jet_sx_expr.truth ρ β c) (negb (BinInt.Z.eqb (zval (zrho ρ) c) BinNums.Z0))
### C.jet_sx_zval.zval_ext
zval_ext
     : forall (z1 z2 : forall _ : nat, BinNums.Z) (x : jet_sx_expr.sx)
         (_ : forall n : nat, @eq BinNums.Z (z1 n) (z2 n)), @eq BinNums.Z (zval z1 x) (zval z2 x)
### C.jet_sx_zval.b2z
b2z =
fun b : bool => match b return BinNums.Z with
                | true => BinNums.Zpos BinNums.xH
                | false => BinNums.Z0
                end
     : forall _ : bool, BinNums.Z

Arguments b2z b%bool_scope
### C.jet_sx_zval.zcmp
zcmp =
fun (c : Integers.comparison) (a b : BinNums.Z) =>
match c return bool with
| Integers.Ceq => BinInt.Z.eqb a b
| Integers.Cne => negb (BinInt.Z.eqb a b)
| Integers.Clt => BinInt.Z.ltb a b
| Integers.Cle => negb (BinInt.Z.ltb b a)
| Integers.Cgt => BinInt.Z.ltb b a
| Integers.Cge => negb (BinInt.Z.ltb a b)
end
     : forall (_ : Integers.comparison) (_ : BinNums.Z) (_ : BinNums.Z), bool

Arguments zcmp c (a b)%Z_scope
### C.jet_sx_zval.zop
zop =
fun (o : jet_sx_expr.bop) (a b : BinNums.Z) =>
match o return BinNums.Z with
| jet_sx_expr.Badd => BinInt.Z.add a b
| jet_sx_expr.Bsub => BinInt.Z.sub a b
| jet_sx_expr.Bmul => BinInt.Z.mul a b
| jet_sx_expr.Band => BinInt.Z.land a b
| jet_sx_expr.Bor => BinInt.Z.lor a b
| jet_sx_expr.Bxor => BinInt.Z.lxor a b
end
     : forall (_ : jet_sx_expr.bop) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments zop o (a b)%Z_scope
### C.jet_sx_zval.zval
zval =
fix zval (ρ : forall _ : nat, BinNums.Z) (x : jet_sx_expr.sx) {struct x} : BinNums.Z :=
  match x return BinNums.Z with
  | jet_sx_expr.XI i => Integers.Int.unsigned i
  | jet_sx_expr.XIc i => Integers.Int.unsigned i
  | jet_sx_expr.XL l => Integers.Int64.unsigned l
  | jet_sx_expr.XLc l => Integers.Int64.unsigned l
  | jet_sx_expr.XLv n => ρ n
  | jet_sx_expr.XV _ => BinNums.Z0
  | jet_sx_expr.XA _ _ => BinNums.Z0
  | jet_sx_expr.XP _ _ => BinNums.Z0
  | jet_sx_expr.XIb o a b => zop o (zval ρ a) (zval ρ b)
  | jet_sx_expr.XLb o a b => zop o (zval ρ a) (zval ρ b)
  | jet_sx_expr.XIsh o a k =>
      match o return BinNums.Z with
      | jet_sx_expr.Hshl => BinInt.Z.mul (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | jet_sx_expr.Hshr => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | jet_sx_expr.Hshru => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      end
  | jet_sx_expr.XLsh o a k =>
      match o return BinNums.Z with
      | jet_sx_expr.Hshl => BinInt.Z.mul (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | jet_sx_expr.Hshr => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | jet_sx_expr.Hshru => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      end
  | jet_sx_expr.XIcmp c _ a b => b2z (zcmp c (zval ρ a) (zval ρ b))
  | jet_sx_expr.XLcmp c _ a b => b2z (zcmp c (zval ρ a) (zval ρ b))
  | jet_sx_expr.XI2L _ a => zval ρ a
  | jet_sx_expr.XL2I a =>
      BinInt.Z.modulo (zval ρ a)
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  | jet_sx_expr.XIcast sz sg a =>
      match sz return BinNums.Z with
      | Ctypes.I8 =>
          match sg return BinNums.Z with
          | Ctypes.Signed => zval ρ a
          | Ctypes.Unsigned =>
              BinInt.Z.modulo (zval ρ a)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
          end
      | Ctypes.I16 =>
          match sg return BinNums.Z with
          | Ctypes.Signed => zval ρ a
          | Ctypes.Unsigned =>
              BinInt.Z.modulo (zval ρ a)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
          end
      | Ctypes.I32 => zval ρ a
      | Ctypes.IBool => zval ρ a
      end
  | jet_sx_expr.XInz a => b2z (negb (BinInt.Z.eqb (zval ρ a) BinNums.Z0))
  | jet_sx_expr.XLnz a => b2z (negb (BinInt.Z.eqb (zval ρ a) BinNums.Z0))
  | jet_sx_expr.XIz a => b2z (BinInt.Z.eqb (zval ρ a) BinNums.Z0)
  | jet_sx_expr.XLz a => b2z (BinInt.Z.eqb (zval ρ a) BinNums.Z0)
  | jet_sx_expr.XIneg _ => BinNums.Z0
  | jet_sx_expr.XLneg _ => BinNums.Z0
  | jet_sx_expr.XInot _ => BinNums.Z0
  | jet_sx_expr.XLnot _ => BinNums.Z0
  end
     : forall (_ : forall _ : nat, BinNums.Z) (_ : jet_sx_expr.sx), BinNums.Z

Arguments zval ρ%function_scope x
### C.jet_sx_zval.M32
M32 =
BinNums.Zpos
  (BinNums.xI
