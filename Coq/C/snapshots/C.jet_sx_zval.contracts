          | Some _ => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XLnz a =>
      match jet_sx_expr.isk jet_sx_expr.KL a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
