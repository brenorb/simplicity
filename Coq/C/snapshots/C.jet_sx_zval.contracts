### C.jet_sx_zval.b2i_unsigned
b2i_unsigned
     : forall b : bool, @eq BinNums.Z (Integers.Int.unsigned (jet_sx_expr.b2i b)) (b2z b)
### C.jet_sx_zval.b2z_range
b2z_range
     : forall b : bool, and (BinInt.Z.le BinNums.Z0 (b2z b)) (BinInt.Z.le (b2z b) (BinNums.Zpos BinNums.xH))
### C.jet_sx_zval.zgood_KI
zgood_KI
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
