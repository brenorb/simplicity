### C.jet_sx_zval.zb_op
zb_op =
fun (mx : BinNums.Z) (o : jet_sx_expr.bop) (la ha lb hb : BinNums.Z) =>
match o return (option (prod BinNums.Z BinNums.Z)) with
| jet_sx_expr.Badd =>
    match BinInt.Z.leb (BinInt.Z.add ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z (BinInt.Z.add la lb) (BinInt.Z.add ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| jet_sx_expr.Bsub =>
    match BinInt.Z.leb BinNums.Z0 (BinInt.Z.sub la hb) return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z (BinInt.Z.sub la hb) (BinInt.Z.sub ha lb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| jet_sx_expr.Bmul =>
    match BinInt.Z.leb (BinInt.Z.mul ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true =>
        @Some (prod BinNums.Z BinNums.Z)
          (@pair BinNums.Z BinNums.Z (BinInt.Z.mul (BinInt.Z.max BinNums.Z0 la) (BinInt.Z.max BinNums.Z0 lb))
             (BinInt.Z.mul ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| jet_sx_expr.Band => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinInt.Z.min ha hb))
| jet_sx_expr.Bor =>
    match BinInt.Z.leb (orb_hi ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (orb_hi ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| jet_sx_expr.Bxor =>
    match BinInt.Z.leb (orb_hi ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (orb_hi ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
end
     : forall (_ : BinNums.Z) (_ : jet_sx_expr.bop) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       option (prod BinNums.Z BinNums.Z)

Arguments zb_op mx%Z_scope o (la ha lb hb)%Z_scope
### C.jet_sx_zval.zb_sh
zb_sh =
fun (w mx : BinNums.Z) (o : jet_sx_expr.shop) (la ha k : BinNums.Z) =>
match andb (BinInt.Z.leb BinNums.Z0 k) (BinInt.Z.ltb k w) return (option (prod BinNums.Z BinNums.Z)) with
| true =>
    match o return (option (prod BinNums.Z BinNums.Z)) with
    | jet_sx_expr.Hshl =>
        match
          BinInt.Z.leb (BinInt.Z.mul ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)) mx
          return (option (prod BinNums.Z BinNums.Z))
        with
        | true =>
            @Some (prod BinNums.Z BinNums.Z)
              (@pair BinNums.Z BinNums.Z (BinInt.Z.mul la (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
                 (BinInt.Z.mul ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
        | false => @None (prod BinNums.Z BinNums.Z)
        end
    | jet_sx_expr.Hshr =>
        match
          BinInt.Z.ltb ha
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.sub w (BinNums.Zpos BinNums.xH)))
          return (option (prod BinNums.Z BinNums.Z))
        with
        | true =>
            @Some (prod BinNums.Z BinNums.Z)
              (@pair BinNums.Z BinNums.Z (BinInt.Z.div la (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
                 (BinInt.Z.div ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
        | false => @None (prod BinNums.Z BinNums.Z)
        end
    | jet_sx_expr.Hshru =>
        @Some (prod BinNums.Z BinNums.Z)
          (@pair BinNums.Z BinNums.Z (BinInt.Z.div la (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
             (BinInt.Z.div ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
    end
| false => @None (prod BinNums.Z BinNums.Z)
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : jet_sx_expr.shop) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       option (prod BinNums.Z BinNums.Z)

