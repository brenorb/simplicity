       @eq BinNums.Z (Integers.Int.unsigned (jet_sx_expr.ii (jet_sx_expr.den ρ β a))) (zval (zrho ρ) a)
### C.jet_sx_zval.zgood_KL
zgood_KL
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (a : jet_sx_expr.sx) (_ : @eq bool (jet_sx_expr.isk jet_sx_expr.KL a) true) (_ : zgood ρ β a),
       @eq BinNums.Z (Integers.Int64.unsigned (jet_sx_expr.il (jet_sx_expr.den ρ β a))) (zval (zrho ρ) a)
### C.jet_sx_zval.zb_sound
zb_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : forall _ : nat, prod Values.block BinNums.Z)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (ρ n)))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (x : jet_sx_expr.sx) (lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z)) (zb bnd x)
                (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi))),
       and (zgood ρ β x) (and (BinInt.Z.le lo (zval (zrho ρ) x)) (BinInt.Z.le (zval (zrho ρ) x) hi))
### C.jet_sx_zval.den_zval_long
den_zval_long
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : forall _ : nat, prod Values.block BinNums.Z)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (ρ n)))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (x : jet_sx_expr.sx) (lo hi : BinNums.Z)
