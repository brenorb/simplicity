### C.jet_sx_zval.zgood
zgood =
fun (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z) (x : jet_sx_expr.sx) =>
match jet_sx_expr.ktop x return Prop with
| jet_sx_expr.KI => @eq BinNums.Z (Integers.Int.unsigned (jet_sx_expr.ii (jet_sx_expr.den ρ β x))) (zval (zrho ρ) x)
| jet_sx_expr.KL => @eq BinNums.Z (Integers.Int64.unsigned (jet_sx_expr.il (jet_sx_expr.den ρ β x))) (zval (zrho ρ) x)
| jet_sx_expr.KP => True
| jet_sx_expr.KA => True
| jet_sx_expr.KV => True
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z)
         (_ : jet_sx_expr.sx), Prop

Arguments zgood (ρ β)%function_scope x
