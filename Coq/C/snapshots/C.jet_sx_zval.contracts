                           (BinNums.Zpos
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI
                                                                  (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              | false => @None (prod BinNums.Z BinNums.Z)
              end
          end
      | Ctypes.I32 => @None (prod BinNums.Z BinNums.Z)
      | Ctypes.IBool => @None (prod BinNums.Z BinNums.Z)
      end
  | jet_sx_expr.XInz a =>
