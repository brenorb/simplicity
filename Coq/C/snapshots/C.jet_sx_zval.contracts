### C.jet_sx_zval.cmp64_zcmp
cmp64_zcmp
     : forall (c : Integers.comparison) (a b : Integers.Int64.int)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned a)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned b)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       @eq bool (Integers.Int64.cmp c a b) (zcmp c (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
