  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
     (BinInt.Z.add (BinInt.Z.log2 (BinInt.Z.max ha hb)) (BinNums.Zpos BinNums.xH))) (BinNums.Zpos BinNums.xH)
