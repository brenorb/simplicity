         (_ : @eq bool (jet_sx_expr.isk jet_sx_expr.KL x) true),
       and (@eq Values.val (jet_sx_expr.den ρ β x) (Values.Vlong (Integers.Int64.repr (zval (zrho ρ) x))))
         (and (BinInt.Z.le lo (zval (zrho ρ) x)) (BinInt.Z.le (zval (zrho ρ) x) hi))
### C.jet_sx_zval.den_zval_int
den_zval_int
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : forall _ : nat, prod Values.block BinNums.Z)
