### C.jet_sx_zval.land_range
land_range
     : forall (a b n : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.lt a (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) n)))
         (_ : BinInt.Z.le BinNums.Z0 b) (_ : BinInt.Z.le BinNums.Z0 n),
       and (BinInt.Z.le BinNums.Z0 (BinInt.Z.land a b))
         (BinInt.Z.lt (BinInt.Z.land a b) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) n))
### C.jet_sx_zval.lor_range
lor_range
     : forall (a b h : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.le a h))
         (_ : and (BinInt.Z.le BinNums.Z0 b) (BinInt.Z.le b h)),
       and (BinInt.Z.le BinNums.Z0 (BinInt.Z.lor a b))
         (BinInt.Z.le (BinInt.Z.lor a b)
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinInt.Z.add (BinInt.Z.log2 h) (BinNums.Zpos BinNums.xH))) (BinNums.Zpos BinNums.xH)))
### C.jet_sx_zval.lxor_range
lxor_range
     : forall (a b h : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.le a h))
         (_ : and (BinInt.Z.le BinNums.Z0 b) (BinInt.Z.le b h)),
       and (BinInt.Z.le BinNums.Z0 (BinInt.Z.lxor a b))
         (BinInt.Z.le (BinInt.Z.lxor a b)
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinInt.Z.add (BinInt.Z.log2 h) (BinNums.Zpos BinNums.xH))) (BinNums.Zpos BinNums.xH)))
### C.jet_sx_zval.op64_sound
op64_sound
     : forall (o : jet_sx_expr.bop) (a b : Integers.Int64.int) (la ha lb hb lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z)) (zb_op M64 o la ha lb hb)
                (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi)))
         (_ : and (BinInt.Z.le la (Integers.Int64.unsigned a)) (BinInt.Z.le (Integers.Int64.unsigned a) ha))
         (_ : and (BinInt.Z.le lb (Integers.Int64.unsigned b)) (BinInt.Z.le (Integers.Int64.unsigned b) hb)),
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (jet_sx_expr.lop o a b))
            (zop o (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
         (and (BinInt.Z.le lo (zop o (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
            (BinInt.Z.le (zop o (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)) hi))
