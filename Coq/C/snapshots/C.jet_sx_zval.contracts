         (_ : and (BinInt.Z.le la (Integers.Int.unsigned a)) (BinInt.Z.le (Integers.Int.unsigned a) ha))
         (_ : and (BinInt.Z.le lb (Integers.Int.unsigned b)) (BinInt.Z.le (Integers.Int.unsigned b) hb)),
