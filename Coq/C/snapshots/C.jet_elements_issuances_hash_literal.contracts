### C.jet_elements_issuances_hash_literal.elements_issuances_hash_spec
elements_issuances_hash_spec =
fun alg : jet_elements_blinding_entropy_literal.EFP.Algebra =>
let core : Alg.Core.Algebra :=
  Alg.Assertion.toCore (jet_elements_blinding_entropy_literal.EFP.CanonicalStructures.toAssertion alg) in
@jet_elements_composite_amounts_hash.elements_fixed_vector_hash_spec (S (S (S (S (S (S (S O))))))) alg
  (@jet_elements_issuance_proofs_hash_literal.AC.pair Ty.Unit
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_elements_issuance_proofs_hash_literal.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_elements_issuance_amounts_hash_program.elements_issuance_asset_amounts_hash_spec alg)
        (@jet_elements_issuance_amounts_hash_program.elements_issuance_token_amounts_hash_spec alg))
     (@jet_elements_issuance_proofs_hash_literal.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_elements_issuance_proofs_hash_program.elements_issuance_range_proofs_hash_spec alg)
        (@jet_elements_blinding_entropy_canonical.literal_issuance_blinding_entropy_hash_spec alg)))
     : forall alg : jet_elements_blinding_entropy_literal.EFP.Algebra,
       jet_elements_blinding_entropy_literal.EFP.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments elements_issuances_hash_spec {alg}
### C.jet_elements_issuances_hash_literal.elements_issuances_hash_of
elements_issuances_hash_of =
fun e : jet_elements_prim.Elements.env =>
jet_bitcoin_composite_hash.sha256_bytes_of
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S (S O)))))))
     (@pair
        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.from_hash256 (jet_elements_issuance_amounts_hash_program.elements_issuance_asset_amounts_hash_of e))
           (Word.from_hash256 (jet_elements_issuance_amounts_hash_program.elements_issuance_token_amounts_hash_of e)))
        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.from_hash256 (jet_elements_issuance_proofs_hash_program.elements_issuance_range_proofs_hash_of e))
           (Word.from_hash256 (jet_elements_blinding_entropy_hash_program.elements_issuance_blinding_entropy_hash_of e)))))
     : forall _ : jet_elements_prim.Elements.env, Digest.hash256

Arguments elements_issuances_hash_of e
