### C.jet_secp_initialized_partial_contract.partial_frame_observations
partial_frame_observations
     : forall (B : Ty.Ty) (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (mf : Memory.Mem.mem) (result : option (Ty.tySem B))
         (_ : jet_frame_inv.finv m bd base bw edge cursor N bi mf
                match result return bool with
                | Some _ => true
                | None => false
                end
                match result return (list BitMachine.Cell) with
                | Some value => @Translate.encode B value
                | None => @nil BitMachine.Cell
                end)
         (_ : jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (jet_secp_frame.extA m bd bw bi b)) m mf),
       and
         match result return Prop with
         | Some value =>
             and (jet_encoding.frame_output_cells_at mf bw edge cursor (@Translate.encode B value))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (jet_frame_layout.frame_fields_at mf bd base bw edge
                     (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B)))))
         | None => True
         end
         (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
            (_ : or (not (@eq Values.block b bd))
                   (or
                      (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                         (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.le
                         (BinInt.Z.add base
                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
            (_ : or (not (@eq Values.block b bw))
                   (or
                      (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                         (BinInt.Z.add edge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B)))
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                      (BinInt.Z.le
                         (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
          @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
### C.jet_secp_initialized_partial_contract.secp_jet_initialized_partial_local_spec
secp_jet_initialized_partial_local_spec =
fun (Ready : forall _ : Memory.Mem.mem, Prop) (f : Clight.function) (A B : Ty.Ty)
  (spec : forall _ : Ty.tySem A, option (Ty.tySem B)) =>
forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block)
  (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor rc : BinNums.Z) (a : Ty.tySem A)
  (_ : Ready m) (_ : jet_frame_layout.frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc) (_ : BinInt.Z.le BinNums.Z0 rc)
  (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (Translate.bitSize A))) Integers.Int64.max_unsigned)
  (_ : jet_encoding.frame_input_cells_at m bi edge rc (@Translate.encode A a))
  (_ : jet_output_layout.write_frame_at m bd base bw outedge cursor (BinInt.Z.of_nat (Translate.bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m (@Ctypes.Internal Clight.function f)
        (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
           (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
        Events.E0 mf (@jet_partial.jet_partial_return (Ty.tySem B) (spec a)))
     (and
        match spec a return Prop with
        | Some value =>
            and (jet_encoding.frame_output_cells_at mf bw outedge cursor (@Translate.encode B value))
              (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                 (jet_frame_layout.frame_fields_at mf bd base bw outedge
                    (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B)))))
        | None => True
        end
        (and
           (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
              (_ : or (not (@eq Values.block b bd))
                     (or
                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (BinInt.Z.le
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
              (_ : or (not (@eq Values.block b bw))
                     (or
                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                           (BinInt.Z.add outedge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B)))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                        (BinInt.Z.le
                           (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
            @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
           (Ready mf))))
     : forall (_ : forall _ : Memory.Mem.mem, Prop) (_ : Clight.function) (A B : Ty.Ty)
         (_ : forall _ : Ty.tySem A, option (Ty.tySem B)), Prop

Arguments secp_jet_initialized_partial_local_spec Ready%function_scope f (A B)%ty_scope spec%function_scope
