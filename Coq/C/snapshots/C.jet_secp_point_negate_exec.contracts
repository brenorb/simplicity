### C.jet_secp_point_negate_exec.point_negate_run_eq
point_negate_run_eq
     : forall k : jet_secp_point_write_run.point_coordinate,
       @eq (option jet_sx_exec.res) (point_negate_run k)
         (@Some jet_sx_exec.res (jet_sx_exec.RDone (point_negate_state k) jet_sx_exec.ONormal))
### C.jet_secp_point_negate_exec.point_negate_return
point_negate_return
     : forall k : jet_secp_point_write_run.point_coordinate,
       @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps (point_negate_state k)))
         (@None jet_sx_expr.sx)
### C.jet_secp_point_negate_exec.point_negate_log_nil
point_negate_log_nil
     : forall k : jet_secp_point_write_run.point_coordinate,
       @eq bool (jet_sx_pure.leaves_log_nil (jet_sx_exec.RDone (point_negate_state k) jet_sx_exec.ONormal)) true
### C.jet_secp_point_negate_exec.eval_point_negate_from_owned_region
eval_point_negate_from_owned_region
     : forall (k : jet_secp_point_write_run.point_coordinate) (m : Memory.Mem.mem) (layout : jet_sx_state.layout)
         (rho : forall _ : nat, Integers.Int64.int)
         (_ : jet_sx_state.rep rho layout (jet_secp_point_write_run.point_write_initial_regs k) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O)
                     (Integers.Ptrofs.repr
                        (BinInt.Z.add (jet_sx_state.bas layout O) (jet_secp_point_write_run.point_coordinate_offset k))))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout O)
                        (Integers.Ptrofs.repr
                           (BinInt.Z.add (jet_sx_state.bas layout O)
                              (jet_secp_point_write_run.point_coordinate_offset k))))
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho layout (jet_sx_eval.sregs (point_negate_state k)) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape (jet_secp_point_write_run.point_write_initial_regs k)) b pos)) m mf)))
