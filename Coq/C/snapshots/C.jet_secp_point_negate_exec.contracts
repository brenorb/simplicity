point_negate_args =
fun k : jet_secp_point_write_run.point_coordinate =>
@cons jet_sx_expr.sx (jet_sx_expr.XP O (jet_secp_point_write_run.point_coordinate_offset k))
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O (jet_secp_point_write_run.point_coordinate_offset k))
     (@cons jet_sx_expr.sx (jet_sx_expr.XIc Integers.Int.one) (@nil jet_sx_expr.sx)))
     : forall _ : jet_secp_point_write_run.point_coordinate, list jet_sx_expr.sx

Arguments point_negate_args k
### C.jet_secp_point_negate_exec.point_negate_run
point_negate_run =
fun k : jet_secp_point_write_run.point_coordinate =>
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_negate (point_negate_args k) (jet_secp_point_write_run.point_write_initial_regs k)
  (@nil jet_sx_eval.event) (S (S (S (S (S (S O))))))
     : forall _ : jet_secp_point_write_run.point_coordinate, option jet_sx_exec.res

Arguments point_negate_run k
