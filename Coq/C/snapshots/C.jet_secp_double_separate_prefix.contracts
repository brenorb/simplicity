### C.jet_secp_double_separate_prefix.double_separate_prefix
double_separate_prefix =
jet_secp_statement_prefix.statement_sequence
  (@List.firstn Clight.statement (S (S (S (S (S O)))))
     (@fst (list Clight.statement) Clight.statement
        (jet_secp_statement_prefix.split_statement_last jet_secp_double_statements.double_arithmetic_body)))
  Clight.Sskip
     : Clight.statement
