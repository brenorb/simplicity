                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
### C.jet_elements_support_sha_ctxi.ctxi_init
ctxi_init
     : forall (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (m : Memory.Mem.mem) (br : Values.block) (_ : not (@eq Values.block br bm))
         (_ : not (@eq Values.block br bx))
         (_ : Memory.Mem.valid_block m
                (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression))
         (_ : Memory.Mem.valid_block m
                (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) br))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   br))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bm BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_elements_support_sha_block_local.sha_dispatch_ok m)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter) BinNums.Z0)
                (@Some Values.val (Values.Vlong jet_elements_support_sha_uchars_exec.sha_max_counter))),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mx : Memory.Mem.mem =>
             @ex (list Memdata.memval)
               (fun bytes : list Memdata.memval =>
                and
                  (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
                     (@Ctypes.Internal Clight.function jets.f_sha256_init)
                     (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bm (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val)))
                     Events.E0 mi Values.Vundef)
                  (and
                     (@eq (option (list Memdata.memval))
                        (Memory.Mem.loadbytes mi br BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some (list Memdata.memval) bytes))
                     (and
                        (@eq (option Memory.Mem.mem) (Memory.Mem.storebytes mi bx BinNums.Z0 bytes)
                           (@Some Memory.Mem.mem mx))
                        (and
                           (ctxi mx bx bm (@nil Integers.Int.int) jet_sha256_iv_init.sha256_iv_words
                              Integers.Int64.zero false)
                           (and
                              (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                 (_ : Memory.Mem.valid_block m b) (_ : not (@eq Values.block b br))
                                 (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
                               @eq (option Values.val) (Memory.Mem.load ch mx b ofs) (Memory.Mem.load ch m b ofs))
                              (and
                                 (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs k p),
                                  Memory.Mem.perm mx b ofs k p)
                                 (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                  Memory.Mem.valid_block mx b)))))))))
### C.jet_elements_support_sha_ctxi.ctxi
ctxi =
fun (m : Memory.Mem.mem) (bx bm : Values.block) (l regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool)
=>
and
  (@eq (option Values.val) (Memory.Mem.load AST.Mptr m bx BinNums.Z0)
     (@Some Values.val (Values.Vptr bm (Integers.Ptrofs.repr BinNums.Z0))))
  (and
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m bx
           (BinInt.Z.add BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (@Some Values.val (Values.Vlong c)))
     (and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint8unsigned m bx
              (BinInt.Z.add BinNums.Z0
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
           (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int ovf))))
        (and
           (forall (i : nat) (_ : lt i (@length Integers.Int.int l)),
            @eq (option Values.val)
              (Memory.Mem.load AST.Mint8unsigned m bx
                 (BinInt.Z.add
                    (BinInt.Z.add BinNums.Z0
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                    (BinInt.Z.of_nat i)))
              (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i l Integers.Int.zero))))
           (and
              (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
               @eq (option Values.val)
                 (Memory.Mem.load AST.Mint32 m bm
                    (BinInt.Z.add BinNums.Z0
                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                 (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
              (and
                 (@eq BinNums.Z
                    (BinInt.Z.modulo (Integers.Int64.unsigned c)
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                    (BinInt.Z.of_nat (@length Integers.Int.int l)))
                 (and (lt (@length Integers.Int.int l) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))
                    (and (@eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
                       (and
                          (Memory.Mem.range_perm m bx BinNums.Z0
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                             Memtype.Cur Memtype.Freeable)
                          (and
                             (Memory.Mem.range_perm m bm BinNums.Z0
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                Memtype.Cur Memtype.Freeable)
                             (and (jet_elements_support_sha_block_local.sha_dispatch_ok m)
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint64 m
                                      (jet_elements_support_sha_linkage.sha_symbol_block
                                         jets_elements._sha256_max_counter) BinNums.Z0)
                                   (@Some Values.val
                                      (Values.Vlong jet_elements_support_sha_uchars_exec.sha_max_counter)))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : list Integers.Int.int)
         (_ : list Integers.Int.int) (_ : Integers.Int64.int) (_ : bool), Prop

Arguments ctxi m bx bm (l regs)%list_scope c ovf%bool_scope
