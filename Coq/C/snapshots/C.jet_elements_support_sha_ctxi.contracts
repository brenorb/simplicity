                   bm)) (_ : jet_memcpy_model.memcpy_model) (m : Memory.Mem.mem) (l regs : list Integers.Int.int)
         (c : Integers.Int64.int) (ovf : bool) (_ : ctxi m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_sha256_finalize)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val)) Events.E0 m'
               (Values.Vint (jet_readBit_layout.bit_int (negb ovf))))
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 m' bm
                     (BinInt.Z.add BinNums.Z0
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                  (@Some Values.val
                     (Values.Vint
                        (@List.nth Integers.Int.int i
                           (@snd (list Integers.Int.int) (list Integers.Int.int)
                              (jet_elements_support_sha_uchars_prep.absorb_i l regs
                                 (jet_elements_support_sha_finalize_exec.sha_pad c))) Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
