### C.jet_elements_lbtc_asset_local.lbtc_asset_le_integer
lbtc_asset_le_integer =
BinNums.Zpos
  (BinNums.xI
     (BinNums.xO
        (BinNums.xI
           (BinNums.xI
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (...)))))))))))))))))))))))
     : BinNums.Z
### C.jet_elements_lbtc_asset_local.lbtc_asset_bytes
lbtc_asset_bytes =
@List.map nat Integers.Byte.int
  (fun i : nat =>
   Integers.Byte.repr
     (BinInt.Z.div lbtc_asset_le_integer
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))))
  (List.seq O (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
     : list Integers.Byte.int
### C.jet_elements_lbtc_asset_local.haskell_word64_be_bytes
haskell_word64_be_bytes =
fun w : BinNums.Z =>
@List.map nat Integers.Byte.int
  (fun i : nat =>
   Integers.Byte.repr
     (BinInt.Z.div w
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
              (BinInt.Z.sub (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))) (BinInt.Z.of_nat i))))))
  (List.seq O (S (S (S (S (S (S (S (S O)))))))))
     : forall _ : BinNums.Z, list Integers.Byte.int

Arguments haskell_word64_be_bytes w%Z_scope
### C.jet_elements_lbtc_asset_local.haskell_word256_be_bytes
haskell_word256_be_bytes =
fun w : jet_haskell_hash_word.haskell_word256 =>
@List.concat Integers.Byte.int
  (@List.map BinNums.Z (list Integers.Byte.int) haskell_word64_be_bytes
     (@cons BinNums.Z (jet_haskell_hash_word.hw3 w)
        (@cons BinNums.Z (jet_haskell_hash_word.hw2 w)
           (@cons BinNums.Z (jet_haskell_hash_word.hw1 w)
              (@cons BinNums.Z (jet_haskell_hash_word.hw0 w) (@nil BinNums.Z))))))
     : forall _ : jet_haskell_hash_word.haskell_word256, list Integers.Byte.int

Arguments haskell_word256_be_bytes w
