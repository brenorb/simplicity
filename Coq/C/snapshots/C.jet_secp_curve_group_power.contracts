               (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
               (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
               (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
               jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory) point
            jet_secp_curve_group.secp_curve_group (BinNums.Zpos k))
### C.jet_secp_curve_group_power.secp_group_generator_nonzero
secp_group_generator_nonzero
     : not
         (@eq jet_secp_curve_group_sign.secp_group_point secp_group_generator
            jet_secp_curve_group_sign.secp_group_infinity)
