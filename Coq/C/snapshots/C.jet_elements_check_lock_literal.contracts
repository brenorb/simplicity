### C.jet_elements_check_lock_literal.elements_check_lock_literal_program
elements_check_lock_literal_program =
fun (height : bool) (alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra) =>
@jet_elements_current_spec.elements_assert_spec alg (Word.Word (S (S (S (S (S O)))))) Ty.Unit
  (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O))))))
     (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) (Ty.Sum Ty.Unit Ty.Unit)
     (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
     (@Alg.Core.Combinators.pair (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
        (Word.Word (S (S (S (S (S O))))))
        (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
        (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S O))))))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))
        (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O)))))) Ty.Unit (Word.Word (S (S (S (S (S O))))))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
           (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S O))))))
              (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))
           (@jet_elements_lock_literal.elements_lock_literal_program height alg)))
     (@jet_order_spec.le_word_spec (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
        (S (S (S (S (S O)))))))
     : forall (_ : bool) (alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra),
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S O)))))) Ty.Unit

Arguments elements_check_lock_literal_program height%bool_scope {alg}
