### C.jet_write_sha256_context_exec.call_ctx8_buffer
call_ctx8_buffer
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bf : Values.block)
         (base : BinNums.Z) (bc : Values.block) (cbase : BinNums.Z) (counter : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._t'4 le)
                (@Some Values.val (Values.Vlong counter)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_simplicity_write_buffer8)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vptr bc
                         (Integers.Ptrofs.add (Integers.Ptrofs.repr cbase)
                            (Integers.Ptrofs.repr
                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (@cons Values.val
                         (Values.Vlong
                            (Integers.Int64.modu counter
                               (Integers.Int64.repr
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                         (@cons Values.val
                            (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                            (@nil Values.val))))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m
         jet_write_sha256_context_empty_exec.ctx8_buffer_call Events.E0 le mf ClightBigstep.Out_normal
### C.jet_write_sha256_context_exec.eval_write_sha256_context_composes
eval_write_sha256_context_composes
     : forall (m mb mc mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bc : Values.block)
         (cbase : BinNums.Z) (bi : Values.block) (input : BinNums.Z) (counter : Integers.Int64.int)
         (overflow : bool) (_ : BinInt.Z.le BinNums.Z0 cbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bc
                   (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong counter)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mb bc
                   (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong counter)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr mc bc cbase)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned mf bc
                   (BinInt.Z.add cbase
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int overflow))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_simplicity_write_buffer8)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vptr bc
                         (Integers.Ptrofs.add (Integers.Ptrofs.repr cbase)
                            (Integers.Ptrofs.repr
                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (@cons Values.val
                         (Values.Vlong
                            (Integers.Int64.modu counter
                               (Integers.Int64.repr
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                         (@cons Values.val
                            (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                            (@nil Values.val))))) Events.E0 mb Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb
                (@Ctypes.Internal Clight.function jets.f_simplicity_write64)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.shru counter
                            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))))
                      (@nil Values.val))) Events.E0 mc Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc (@Ctypes.Internal Clight.function jets.f_write32s)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
                      (@cons Values.val
                         (Values.Vlong
                            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                         (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_write_sha256_context)
         (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
            (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase)) (@nil Values.val))) Events.E0 mf
         (Values.Vint (jet_readBit_layout.bit_int (negb overflow)))
