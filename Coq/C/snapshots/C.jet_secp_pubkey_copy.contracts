### C.jet_secp_pubkey_copy.pubkey_storage_size
pubkey_storage_size
     : @eq BinNums.Z (Ctypes.sizeof (Clight.genv_cenv jet_secp_linkage.secp_ge) pubkey_storage_type)
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
### C.jet_secp_pubkey_copy.pubkey_copy_source
pubkey_copy_source
     : @eq Clight.statement
         match Clight.fn_body jets_secp.f_secp256k1_pubkey_load return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence s _ =>
             match s return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ _ => Clight.Sskip
             | Clight.Sifthenelse _ s1 _ =>
                 match s1 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence copy _ => copy
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end pubkey_copy_stmt
### C.jet_secp_pubkey_copy.pubkey_data_members
pubkey_data_members
     : @eq (option Ctypes.members)
         match
           @Maps.PTree.get Ctypes.composite jets_secp.__2078 (Clight.genv_cenv jet_secp_linkage.secp_ge)
           return (option Ctypes.members)
         with
         | Some co => @Some Ctypes.members (Ctypes.co_members co)
         | None => @None Ctypes.members
         end
         (@Some (list Ctypes.member)
            (@cons Ctypes.member
               (Ctypes.Member_plain jets_secp._data
                  (Ctypesdefs.tarray Ctypesdefs.tuchar
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (@nil Ctypes.member)))
### C.jet_secp_pubkey_copy.pubkey_data_layout
pubkey_data_layout
     : @ex Ctypes.composite
         (fun co : Ctypes.composite =>
          and
            (@eq (option Ctypes.composite)
               (@Maps.PTree.get Ctypes.composite jets_secp.__2078 (Clight.genv_cenv jet_secp_linkage.secp_ge))
               (@Some Ctypes.composite co))
            (@eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
               (Ctypes.field_offset (Clight.genv_cenv jet_secp_linkage.secp_ge) jets_secp._data (Ctypes.co_members co))
               (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield BinNums.Z0 Ctypes.Full))))
### C.jet_secp_pubkey_copy.eval_pubkey_data
eval_pubkey_data
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bs : Values.block)
         (base : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pubkey le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr base)))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m pubkey_opaque_data (Values.Vptr bs (Integers.Ptrofs.repr base))
### C.jet_secp_pubkey_copy.exec_pubkey_copy
exec_pubkey_copy
     : forall (_ : jet_memcpy_model.memcpy_model) (w : forall _ : nat, Integers.Int64.int)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bs : Values.block) (base : BinNums.Z) (bd : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._s e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bd pubkey_storage_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._memcpy e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pubkey le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr base)))) (_ : not (@eq Values.block bd bs))
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_affine_storage.affine_storage_readable m bs base w),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m pubkey_copy_stmt Events.E0 le mf
               ClightBigstep.Out_normal)
            (and (jet_secp_affine_storage.affine_storage_readable mf bd BinNums.Z0 w)
               (and
                  (Memory.Mem.range_perm mf bd BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m mf)
                     (jet_clight_internal_preserve.readonly_preserved m mf)))))
