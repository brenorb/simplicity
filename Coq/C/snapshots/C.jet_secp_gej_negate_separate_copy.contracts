### C.jet_secp_gej_negate_separate_copy.exec_gej_negate_separate_field
exec_gej_negate_separate_field
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bs bd : Values.block)
         (fid : AST.ident) (delta : BinNums.Z) (w : forall _ : nat, Integers.Int64.int)
         (_ : @List.In (prod AST.ident BinNums.Z) (@pair AST.ident BinNums.Z fid delta)
                (@cons (prod AST.ident BinNums.Z) (@pair AST.ident BinNums.Z jets_secp._x BinNums.Z0)
                   (@cons (prod AST.ident BinNums.Z)
                      (@pair AST.ident BinNums.Z jets_secp._y
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                      (@cons (prod AST.ident BinNums.Z)
                         (@pair AST.ident BinNums.Z jets_secp._z
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                         (@nil (prod AST.ident BinNums.Z)))))) (_ : not (@eq Values.block bs bd))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bd Integers.Ptrofs.zero)))
         (_ : jet_secp_fe_nv.fe_at m bs delta (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m
               (jet_secp_gej_negate_fields.gej_negate_field_copy_stmt fid) Events.E0 le mf ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf bd delta (jet_secp_multiply_normalize_bridge.words5 w))
               (and
                  (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
                   iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p))
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block b bd))
                        (or (BinInt.Z.lt pos delta)
                           (BinInt.Z.le
                              (BinInt.Z.add delta
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                     m mf))))
