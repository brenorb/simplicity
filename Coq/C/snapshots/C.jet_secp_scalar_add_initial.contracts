### C.jet_secp_scalar_add_initial.scalar_add_vars_nth
scalar_add_vars_nth
     : forall (start i : nat) (x : jet_sx_expr.sx)
         (_ : @eq (option jet_sx_expr.sx) (@List.nth_error jet_sx_expr.sx (scalar_add_vars start) i)
                (@Some jet_sx_expr.sx x)),
       and (lt i (S (S (S (S O))))) (@eq jet_sx_expr.sx x (jet_sx_expr.XLv (Nat.add start i)))
### C.jet_secp_scalar_add_initial.scalar_add_region_from_values
scalar_add_region_from_values
     : forall (rho : forall _ : nat, Integers.Int64.int) (start : nat) (layout : jet_sx_state.layout)
         (m : Memory.Mem.mem) (r : nat) (_ : @eq BinNums.Z (jet_sx_state.bas layout r) BinNums.Z0)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m (jet_sx_state.blk layout r) (jet_sx_state.bas layout r)
                (scalar_add_values rho start))
         (_ : Memory.Mem.range_perm m (jet_sx_state.blk layout r) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.region_ok rho layout m r
         (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (scalar_add_vars start)) true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
### C.jet_secp_scalar_add_initial.scalar_add_initial_from_owned_scalars
scalar_add_initial_from_owned_scalars
     : forall (m : Memory.Mem.mem) (a b : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (_ : not (@eq Values.block a b))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m a BinNums.Z0 (scalar_add_values rho O))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m b BinNums.Z0 (scalar_add_values rho (S (S (S (S O))))))
         (_ : Memory.Mem.range_perm m a BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep rho
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z a BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) jet_secp_scalar_add_run.scalar_add_initial_regs m
### C.jet_secp_scalar_add_initial.scalar_add_vars
scalar_add_vars =
fun start : nat =>
@cons jet_sx_expr.sx (jet_sx_expr.XLv start)
  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (Nat.add start (S O)))
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (Nat.add start (S (S O))))
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (Nat.add start (S (S (S O))))) (@nil jet_sx_expr.sx))))
     : forall _ : nat, list jet_sx_expr.sx

Arguments scalar_add_vars start%nat_scope
### C.jet_secp_scalar_add_initial.scalar_add_values
scalar_add_values =
fun (rho : forall _ : nat, Integers.Int64.int) (start : nat) =>
@cons Integers.Int64.int (rho start)
  (@cons Integers.Int64.int (rho (Nat.add start (S O)))
     (@cons Integers.Int64.int (rho (Nat.add start (S (S O))))
        (@cons Integers.Int64.int (rho (Nat.add start (S (S (S O))))) (@nil Integers.Int64.int))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), list Integers.Int64.int

Arguments scalar_add_values rho%function_scope start%nat_scope
