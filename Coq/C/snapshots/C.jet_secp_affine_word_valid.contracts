### C.jet_secp_affine_word_valid.secp_affine_curve_of_literal
secp_affine_curve_of_literal
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))) true),
       @eq (GZnZ.znz jet_secp_fe_math.feP)
         (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
            (jet_secp_field_word_group.secp_field_word y) (S (S O)))
         (GZnZ.add jet_secp_fe_math.feP
            (GZnZ.add jet_secp_fe_math.feP
               (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                  (GZnZ.mul jet_secp_fe_math.feP) (jet_secp_field_word_group.secp_field_word x)
                  (S (S (S O))))
               (GZnZ.mul jet_secp_fe_math.feP (GZnZ.zero jet_secp_fe_math.feP)
                  (jet_secp_field_word_group.secp_field_word x))) jet_secp_curve_group.secp_group_seven)
### C.jet_secp_affine_word_valid.secp_affine_literal_represented
secp_affine_literal_represented
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))) true),
       @ex jet_secp_curve_group_sign.secp_group_point
         (fun p : jet_secp_curve_group_sign.secp_group_point =>
          jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) p)
### C.jet_secp_affine_word_valid.secp_jacobian_word_rep_unique
secp_jacobian_word_rep_unique
     : forall (c : jet_secp_curve_group.secp_group_field)
         (point : Ty.tySem
                    (Ty.Prod
                       (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                          (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (p q : jet_secp_curve_group_sign.secp_group_point)
         (_ : jet_secp_jacobian_word_group.secp_jacobian_word_rep c point p)
         (_ : jet_secp_jacobian_word_group.secp_jacobian_word_rep c point q),
       @eq jet_secp_curve_group_sign.secp_group_point p q
### C.jet_secp_affine_word_valid.secp_affine_word_rep_finite
secp_affine_word_rep_finite
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
                (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) p),
       not (@eq jet_secp_curve_group_sign.secp_group_point p jet_secp_curve_group_sign.secp_group_infinity)
### C.jet_secp_affine_word_valid.secp_field_word_equal_normalized
secp_field_word_equal_normalized
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq jet_secp_curve_group.secp_group_field (jet_secp_field_word_group.secp_field_word x)
                (jet_secp_field_word_group.secp_field_word y)),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem y)
### C.jet_secp_affine_word_valid.secp_decompress_curve
secp_decompress_curve
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (ap : Ty.tySem
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (_ : @eq
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
                   (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      odd x))
                (@inr unit
                   (Ty.tySem
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))) ap)),
       @eq bool (Bit.toBool (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem ap)) true
### C.jet_secp_affine_word_valid.secp_decompress_represented
secp_decompress_represented
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
                   (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      odd x))
                (@inr unit
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay))),
       @ex jet_secp_curve_group_sign.secp_group_point
         (fun p : jet_secp_curve_group_sign.secp_group_point =>
          and
            (jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay) p)
            (not (@eq jet_secp_curve_group_sign.secp_group_point p jet_secp_curve_group_sign.secp_group_infinity)))
### C.jet_secp_affine_word_valid.secp_affine_word_rep_coordinates
secp_affine_word_rep_coordinates
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
                (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) p),
       and
         (@eq jet_secp_curve_group.secp_group_field (secp_group_point_x p)
            (jet_secp_field_word_group.secp_field_word x))
         (@eq jet_secp_curve_group.secp_group_field (secp_group_point_y p)
            (jet_secp_field_word_group.secp_field_word y))
### C.jet_secp_affine_word_valid.secp_affine_word_same_point
secp_affine_word_same_point
     : forall (x y u v : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
                (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) p)
         (_ : jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
                (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) u v) p),
       and
         (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
            (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem u))
         (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem y)
            (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem v))
