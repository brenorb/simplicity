### C.jet_secp_modinfo_scalar_global.scalar_inv_entry_with_modinfo
scalar_inv_entry_with_modinfo
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bd bx : Values.block)
         (_ : modinfo_scalar_state m)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bx BinNums.Z0
                (jet_secp_scalar_add_initial.scalar_add_values w O))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Values.block
         (fun bs : Values.block =>
          @ex Memory.Mem.mem
            (fun mi : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mp : Memory.Mem.mem =>
                and
                  (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_scalar_inverse_var
                     (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero) (@nil Values.val))) m
                     (jet_secp_scalar_inverse_caller.scalar_inv_env bs)
                     (jet_secp_scalar_inverse_caller.scalar_inv_temps bd bx) mi)
                  (and
                     (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
                        (jet_secp_scalar_inverse_caller.scalar_inv_env bs)
                        (jet_secp_scalar_inverse_caller.scalar_inv_temps bd bx) mi
                        jet_secp_scalar_inverse_caller.scalar_inv_pack Events.E0
                        (jet_secp_scalar_inverse_caller.scalar_inv_temps bd bx) mp ClightBigstep.Out_normal)
                     (and
                        (Clight.eval_exprlist jet_secp_linkage.secp_ge
                           (jet_secp_scalar_inverse_caller.scalar_inv_env bs)
                           (jet_secp_scalar_inverse_caller.scalar_inv_temps bd bx) mp
                           (@cons Clight.expr jet_secp_scalar_inverse_caller.scalar_inv_s_address
                              (@cons Clight.expr jet_secp_scalar_inverse_caller.scalar_inv_modinfo_address
                                 (@nil Clight.expr)))
                           (Ctypes.type_of_params (Clight.fn_params jets_secp.f_secp256k1_modinv64_var))
                           (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                              (@cons Values.val
                                 (Values.Vptr jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block
                                    Integers.Ptrofs.zero) (@nil Values.val))))
                        (and (modinfo_scalar_global_rep mp)
                           (and
                              (jet_secp_fe_nv.fe_at mp bs BinNums.Z0
                                 (jet_secp_multiply_normalize_bridge.words5
                                    (jet_secp_scalar_signed62.scalar62_words true w)))
                              (and
                                 (jet_secp_signed62_numeric.signed62_normalized
                                    (jet_secp_scalar_signed62.scalar62_words true w))
                                 (and
                                    (@eq BinNums.Z
                                       (jet_secp_signed62_numeric.signed62_unsigned_value
                                          (jet_secp_scalar_signed62.scalar62_words true w))
                                       (jet_secp_scalar_overflow_numeric.scalar_limb_value w))
                                    (and
                                       (jet_secp_scalar_get_b32_storage.scalar_at mp bx BinNums.Z0
                                          (jet_secp_scalar_add_initial.scalar_add_values w O))
                                       (and
                                          (Memory.Mem.range_perm mp bs BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (Memory.Mem.range_perm mp bx BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                Memtype.Cur Memtype.Freeable)
                                             (and
                                                (Memory.Mem.range_perm mp bd BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (and (not (@eq Values.block bs bx))
                                                   (and (not (@eq Values.block bd bs))
                                                      (and (not (Memory.Mem.valid_block m bs))
                                                         (jet_sx_mem.lframe
                                                            (fun (b : Values.block) (_ : BinNums.Z) =>
                                                             and (not (@eq Values.block b bs))
                                                               (not (@eq Values.block b bx))) m mp)))))))))))))))))
### C.jet_secp_modinfo_scalar_global.modinfo_scalar_words
modinfo_scalar_words =
@cons Integers.Int64.int
  (Integers.Int64.repr
     (BinNums.Zpos
        (BinNums.xI
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (...)))))))))))))))))))))))
  (@cons Integers.Int64.int
     (Integers.Int64.repr
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (...))))))))))))))))))))))
     (@cons Integers.Int64.int
        (Integers.Int64.repr (BinNums.Zneg (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
        (@cons Integers.Int64.int Integers.Int64.zero
           (@cons Integers.Int64.int
              (Integers.Int64.repr
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
              (@cons Integers.Int64.int
                 (Integers.Int64.repr
                    (BinNums.Zpos
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI (...))))))))))))))))))
                 (@nil Integers.Int64.int))))))
     : list Integers.Int64.int
### C.jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep
modinfo_scalar_global_rep =
fun m : Memory.Mem.mem =>
and (Memory.Mem.valid_block m jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block)
  (and
     (Memory.Mem.range_perm m jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block BinNums.Z0
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))) Memtype.Cur
        Memtype.Readable)
     (forall (i : nat) (w : Integers.Int64.int)
        (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int modinfo_scalar_words i)
               (@Some Integers.Int64.int w)),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong w))))
     : forall _ : Memory.Mem.mem, Prop

Arguments modinfo_scalar_global_rep m
### C.jet_secp_modinfo_scalar_global.modinfo_scalar_state
modinfo_scalar_state =
fun m : Memory.Mem.mem =>
and (modinfo_scalar_global_rep m)
  (forall ofs : BinNums.Z,
   not (Memory.Mem.perm m jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block ofs Memtype.Max Memtype.Writable))
     : forall _ : Memory.Mem.mem, Prop

Arguments modinfo_scalar_state m
