                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO
                                                                     (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))))))))))))))))
               (BinInt.Z.mul
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                  (Integers.Int64.signed
                     (Integers.Int64.repr (BinNums.Zneg (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
            (BinInt.Z.mul
