### C.jet_secp_reduce512_fresh_runs.reduce512_forget_destination
reduce512_forget_destination =
fun regs : list jet_sx_state.region =>
match regs return (list jet_sx_state.region) with
| nil => @nil jet_sx_state.region
| cons h t => @cons jet_sx_state.region (jet_sx_forget_cells.forget_region h) t
end
     : forall _ : list jet_sx_state.region, list jet_sx_state.region

