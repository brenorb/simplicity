         (and
            (@eq (option jet_sx_expr.sx)
               (@Maps.PTree.get jet_sx_expr.sx jets_secp._l (jet_sx_eval.stemps reduce512_fresh_first_state))
               (@Some jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0)))
            (and
               (@eq (option jet_sx_expr.sx)
                  (@Maps.PTree.get jet_sx_expr.sx jets_secp._m0 (jet_sx_eval.stemps reduce512_fresh_first_state))
                  (@Some jet_sx_expr.sx
                     (jet_secp_scalar_mul512_symbolic.sc_lo jet_secp_reduce512_first_symbolic.first_sy0)))
               (and
