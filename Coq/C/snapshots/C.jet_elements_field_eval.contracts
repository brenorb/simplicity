         (b : Values.block) (ofs : Integers.Ptrofs.int) (v : Values.val)
         (_ : @eq Ctypes.type (Clight.typeof a) (Ctypes.Tstruct sid Ctypes.noattr))
         (_ : elements_field_at sid field delta) (_ : @eq Ctypes.mode (Ctypes.access_mode ty) (Ctypes.By_value chunk))
