         (v : Values.val) (_ : and (BinInt.Z.le BinNums.Z0 base) (BinInt.Z.le base Integers.Ptrofs.max_unsigned))
         (_ : @eq (option Values.val) (Memory.Mem.load chunk m b base) (@Some Values.val v)),
       @eq (option Values.val) (Memory.Mem.loadv chunk m (Values.Vptr b (Integers.Ptrofs.repr base)))
         (@Some Values.val v)
