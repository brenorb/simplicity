### C.jet_elements_field_eval.elements_field_at
elements_field_at =
fun (sid field : AST.ident) (delta : BinNums.Z) =>
match @Maps.PTree.get Ctypes.composite sid (Clight.genv_cenv jet_elements_linkage.elements_ge) return Prop with
| Some co =>
    @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
      (Ctypes.field_offset (Clight.genv_cenv jet_elements_linkage.elements_ge) field (Ctypes.co_members co))
      (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield delta Ctypes.Full))
| None => False
end
     : forall (_ : AST.ident) (_ : AST.ident) (_ : BinNums.Z), Prop

Arguments elements_field_at sid field delta%Z_scope
### C.jet_elements_field_eval.elements_struct
elements_struct =
fun (t : Ctypes.type) (sid : AST.ident) => @eq Ctypes.type t (Ctypes.Tstruct sid Ctypes.noattr)
     : forall (_ : Ctypes.type) (_ : AST.ident), Prop

Arguments elements_struct t sid
