### C.jet_secp_point_negate_owned.point_negate_cell_present
point_negate_cell_present
     : forall (k : jet_secp_point_write_run.point_coordinate) (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @List.In jet_sx_state.cell
         (jet_sx_state.mkcell
            (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat n)))
            AST.Mint64 (@Some jet_sx_expr.sx (jet_secp_field_negate_values.negate_limb_expr n)))
         (jet_sx_state.rcells
            (@List.hd jet_sx_state.region (jet_sx_state.mkreg (@nil jet_sx_state.cell) true (@None BinNums.Z))
               (jet_sx_eval.sregs (jet_secp_point_negate_exec.point_negate_state k))))
### C.jet_secp_point_negate_owned.point_negate_rep_loads
point_negate_rep_loads
     : forall (k : jet_secp_point_write_run.point_coordinate) (m : Memory.Mem.mem) (layout : jet_sx_state.layout)
         (rho : forall _ : nat, Integers.Int64.int)
         (_ : jet_sx_state.rep rho layout (jet_sx_eval.sregs (jet_secp_point_negate_exec.point_negate_state k)) m)
         (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk layout O)
            (BinInt.Z.add (jet_sx_state.bas layout O)
               (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat n)))))
         (@Some Values.val (Values.Vlong (jet_secp_field_negate_values.negate_value rho n)))
### C.jet_secp_point_negate_owned.eval_point_negate_reader_owned
eval_point_negate_reader_owned
     : forall (k : jet_secp_point_write_run.point_coordinate) (m : Memory.Mem.mem) (b : Values.block)
         (value : BinNums.Z)
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset k)
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val
                  (Values.Vptr b (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                  (@cons Values.val
                     (Values.Vptr b (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b (jet_secp_point_write_run.point_coordinate_offset k)
                  (jet_secp_field_negate_storage.negate_values
                     (jet_secp_write_fe_numeric.write_fe_rho value BinNums.Z0)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (bx : Values.block) (pos : BinNums.Z) =>
                      not
                        (jet_sx_state.foot
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                              (@nil (prod Values.block BinNums.Z)))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape (jet_secp_point_write_run.point_write_initial_regs k)) bx pos)) m mf))))
