               (jet_secp_statement_prefix.statement_sequence gej_add_preparation_statements Clight.Sskip) Events.E0 le
               mf ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf pa BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf pa
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (jet_secp_fe_nv.fe_at mf pa
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5 z))
                     (and (jet_secp_fe_nv.fe_at mf pb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
                        (and
                           (jet_secp_fe_nv.fe_at mf pb
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 v))
                           (and
                              (jet_secp_fe_nv.fe_at mf pb
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (jet_secp_multiply_normalize_bridge.words5 w))
                              (and
                                 (jet_secp_fe_nv.fe_at mf pu BinNums.Z0
                                    (jet_secp_multiply_normalize_bridge.words5
                                       (jet_secp_point_mul_storage.point_mul_words x b)))
                                 (and
                                    (jet_secp_fe_nv.fe_at mf pv BinNums.Z0
                                       (jet_secp_multiply_normalize_bridge.words5
                                          (jet_secp_point_mul_storage.point_mul_words u a)))
                                    (and
                                       (jet_secp_fe_nv.fe_at mf ps BinNums.Z0
                                          (jet_secp_multiply_normalize_bridge.words5
                                             (jet_secp_point_mul_storage.point_mul_words
                                                (jet_secp_point_mul_storage.point_mul_words y b) w)))
                                       (and
                                          (jet_secp_fe_nv.fe_at mf pt BinNums.Z0
