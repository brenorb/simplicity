                                                                        (and ... ...))))))))))))))))))))))
### C.jet_secp_gej_add_preparation.gej_add_preparation_statements
gej_add_preparation_statements =
@cons Clight.statement
  (jet_secp_gej_fresh_product.gej_fresh_product_stmt false jets_secp._u1 jets_secp._a jets_secp._z22)
  (@cons Clight.statement
     (jet_secp_gej_fresh_product.gej_fresh_product_stmt false jets_secp._u2 jets_secp._b jets_secp._z12)
     (@cons Clight.statement (jet_secp_gej_add_s_calls.gej_add_s_first false)
        (@cons Clight.statement (jet_secp_gej_add_s_calls.gej_add_s_second false)
           (@cons Clight.statement (jet_secp_gej_add_s_calls.gej_add_s_first true)
              (@cons Clight.statement (jet_secp_gej_add_s_calls.gej_add_s_second true) (@nil Clight.statement))))))
     : list Clight.statement
### C.jet_secp_gej_add_preparation.gej_add_preparation_frame
gej_add_preparation_frame =
fun (pa pb pu pv ps pt p12 p22 b : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block b pu))
  (and (not (@eq Values.block b pv))
     (and (not (@eq Values.block b ps))
        (and (not (@eq Values.block b pt))
           (and (not (@eq Values.block b p12))
              (and (not (@eq Values.block b p22))
                 (and
                    (or (not (@eq Values.block b pa))
                       (or (BinInt.Z.lt pos BinNums.Z0)
                          (BinInt.Z.le
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                             pos)))
                    (or (not (@eq Values.block b pb))
                       (or (BinInt.Z.lt pos BinNums.Z0)
                          (BinInt.Z.le
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                             pos)))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments gej_add_preparation_frame pa pb pu pv ps pt p12 p22 b pos%Z_scope
