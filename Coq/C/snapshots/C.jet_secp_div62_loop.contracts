### C.jet_secp_div62_loop.eval_div62_from_count_calls
eval_div62_from_count_calls
     : forall (m : Memory.Mem.mem)
         (_ : forall (x : Integers.Int64.int) (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 m
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (st : divstep.State) (precision : BinNums.Z) (f0 g0 : Integers.Int64.int) (b : Values.block)
         (_ : and
                (BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                   precision)
                (BinInt.Z.le precision
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and
                (BinInt.Z.le
                   (BinNums.Zneg
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                   (divstep.eta st))
                (BinInt.Z.lt (divstep.eta st)
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : Zdiv.eqm (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) precision) (Integers.Int64.unsigned f0)
                (divstep.f st))
         (_ : Zdiv.eqm (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) precision) (Integers.Int64.unsigned g0)
                (divstep.g st))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_divsteps_62_var)
               (@cons Values.val (Values.Vlong (Integers.Int64.repr (divstep.eta st)))
                  (@cons Values.val (Values.Vlong f0)
                     (@cons Values.val (Values.Vlong g0)
                        (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val))))) Events.E0 mf
               (Values.Vlong
                  (Integers.Int64.repr
                     (divstep.eta
                        (@fst divstep.State (list divstep.Step)
                           (divstep.stepN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))) st))))))
            (and
               (forall (j : nat) (_ : lt j (S (S (S (S O))))),
                @ex Integers.Int64.int
                  (fun w : Integers.Int64.int =>
                   and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf b
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat j))) (@Some Values.val (Values.Vlong w)))
                     (@eq BinNums.Z (Integers.Int64.signed w)
                        (jet_secp_div62_exit.div62_matrix_field
                           (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))) st) j))))
               (and
                  (forall (j : nat) (_ : lt j (S (S (S (S O))))),
                   @eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf b
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat j)))
                     (@Some Values.val (Values.Vlong (jet_secp_div62_exit.div62_exit_words st j))))
                  (and
                     (@eq BinNums.Z
                        (Integers.Int64.signed
                           (Integers.Int64.repr
                              (divstep.eta
                                 (@fst divstep.State (list divstep.Step)
                                    (divstep.stepN (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))) st)))))
                        (divstep.eta
                           (@fst divstep.State (list divstep.Step)
                              (divstep.stepN (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))) st))))
                     (and
                        (Memory.Mem.range_perm mf b BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b))
                              m mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))
### C.jet_secp_div62_loop.div62_count_call
div62_count_call =
Clight.Scall (@Some AST.ident jets_secp._t'1)
  (Clight.Evar jets_secp._secp256k1_ctz64_var
     (Ctypes.Tfunction (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil) Ctypesdefs.tint AST.cc_default))
  (@cons Clight.expr jet_secp_div62_consume.div62_sentinel_expr (@nil Clight.expr))
     : Clight.statement
### C.jet_secp_div62_loop.div62_counted_temps
div62_counted_temps =
fun (le : Maps.PTree.tree Values.val) (z : BinNums.Z) =>
@Maps.PTree.set Values.val jets_secp._zeros (Values.Vint (Integers.Int.repr z))
  (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint (Integers.Int.repr z)) le)
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments div62_counted_temps le z%Z_scope
