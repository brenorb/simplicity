### C.jet_secp_div62_loop.exec_div62_count_call
exec_div62_count_call
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (g : Integers.Int64.int)
         (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i
                   (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._g le) (@Some Values.val (Values.Vlong g)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong (jet_secp_div62_consume.div62_sentinel_word g i)) (@nil Values.val))
                Events.E0 m (Values.Vint (Integers.Int.repr (jet_secp_div62_consume.div62_sentinel_count g i)))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m
         (Clight.Ssequence div62_count_call jet_secp_div62_count.div62_copy_count) Events.E0
         (div62_counted_temps le (jet_secp_div62_consume.div62_sentinel_count g i)) m ClightBigstep.Out_normal
### C.jet_secp_div62_loop.exec_div62_body_invariant
exec_div62_body_invariant
     : forall (m : Memory.Mem.mem)
         (_ : forall (x : Integers.Int64.int) (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 m
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (le : Clight.temp_env) (start : divstep.State) (precision : BinNums.Z) (n : nat) (pending : BinNums.Z)
         (b : Values.block)
         (_ : and
                (BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                   precision)
                (BinInt.Z.le precision
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and
                (BinInt.Z.le
                   (BinNums.Zneg
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                   (divstep.eta start))
                (BinInt.Z.lt (divstep.eta start)
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : jet_secp_div62_invariant.div62_loop_invariant start precision n pending b le),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex ClightBigstep.outcome
            (fun out : ClightBigstep.outcome =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m
                  jet_secp_div62_count.div62_loop_body Events.E0 lef m out)
               (or
                  (and (@eq ClightBigstep.outcome out ClightBigstep.Out_break)
                     (jet_secp_div62_invariant.div62_loop_invariant start precision
                        (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))) BinNums.Z0 b lef))
                  (and (@eq ClightBigstep.outcome out ClightBigstep.Out_normal)
                     (@ex nat
                        (fun n2 : nat =>
                         @ex BinNums.Z
                           (fun p2 : BinNums.Z =>
                            and (lt n n2) (jet_secp_div62_invariant.div62_loop_invariant start precision n2 p2 b lef))))))))
### C.jet_secp_div62_loop.exec_div62_loop_fuel
exec_div62_loop_fuel
     : forall (m : Memory.Mem.mem)
