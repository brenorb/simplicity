Arguments scalar_inv_batch_length len%nat_scope st rho%function_scope
### C.jet_secp_scalar_inverse_batch.scalar_inv_batch_frame
scalar_inv_batch_frame =
fun (beta : jet_sx_state.layout) (b : Values.block) (ofs : BinNums.Z) =>
and (not (@eq Values.block b (jet_sx_state.blk beta (S (S (S (S (S (S O)))))))))
  (and
     (not
        (jet_sx_state.foot (jet_secp_modinv_var_de.inv_de_layout beta)
           (@List.map jet_sx_state.region
              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
              jet_secp_scalar_de_exec.scalar_de62_regs) b ofs))
     (and
        (not
           (jet_sx_state.foot (jet_secp_modinv_var_fg.inv_fg_layout beta)
              (@List.map jet_sx_state.region
                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                 jet_secp_modinv_fg_prefix.fg_regs) b ofs))
        (and (not (@eq Values.block b (jet_sx_state.blk beta (S (S (S (S O)))))))
           (not (@eq Values.block b (jet_sx_state.blk beta (S (S (S (S (S O)))))))))))
     : forall (_ : jet_sx_state.layout) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments scalar_inv_batch_frame beta b ofs%Z_scope
