     : forall n : nat,
       @Alg.Core.Parametric (Ty.Prod (Word.Word n) (Word.Word n))
         (Ty.Sum (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
         (@jet_secp_eea_literal.literal_bezout n)
### C.jet_secp_eea_parametric.literal_inverse_body_parametric
literal_inverse_body_parametric
     : forall (W : Ty.Ty) (p : Ty.tySem W) (t1 t2 : Alg.Core.Algebra) (R : Alg.Core.Parametric.Rel t1 t2)
         (b1 : Alg.Core.domain t1 (Ty.Prod W W) (Ty.Sum (Ty.Prod W W) (Ty.Prod W W)))
         (b2 : Alg.Core.domain t2 (Ty.Prod W W) (Ty.Sum (Ty.Prod W W) (Ty.Prod W W))) (neg1 : Alg.Core.domain t1 W W)
         (neg2 : Alg.Core.domain t2 W W)
         (_ : @Alg.Core.Parametric.rel t1 t2 R (Ty.Prod W W) (Ty.Sum (Ty.Prod W W) (Ty.Prod W W)) b1 b2)
         (_ : @Alg.Core.Parametric.rel t1 t2 R W W neg1 neg2),
       @Alg.Core.Parametric.rel t1 t2 R W W (@jet_secp_invert_literal.literal_inverse_body W t1 p b1 neg1)
         (@jet_secp_invert_literal.literal_inverse_body W t2 p b2 neg2)
### C.jet_secp_eea_parametric.literal_fe_invert_parametric
literal_fe_invert_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@jet_secp_invert_literal.literal_fe_invert)
