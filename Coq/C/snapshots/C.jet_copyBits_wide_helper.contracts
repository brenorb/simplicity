                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
### C.jet_copyBits_wide_helper.eval_copyBits_wide_layout
eval_copyBits_wide_layout
     : forall (_ : jet_memcpy_model.memcpy_model) (m : Memory.Mem.mem) (bd : Values.block)
         (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (bw : Values.block) (outedge cursor n : BinNums.Z) (cells : list BitMachine.Cell)
         (_ : jet_frame_layout.frame_base_valid sbase) (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : jet_output_layout.write_frame_at m bd base bw outedge cursor n)
         (_ : @eq BinNums.Z n (BinInt.Z.of_nat (@length BitMachine.Cell cells)))
         (_ : and
                (BinInt.Z.lt
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : jet_context_separated.jet_copy_buffers_separated bd bi bw edge outedge cursor rc n)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc cells),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function jets.f_simplicity_copyBits)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and (jet_encoding.frame_output_cells_at mf bw outedge cursor cells)
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and (jet_frame_layout.frame_fields_at mf bd base bw outedge (BinInt.Z.sub cursor n))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bd
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add outedge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div (BinInt.Z.sub cursor n)
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
### C.jet_copyBits_wide_helper.wide_prefix_post
wide_prefix_post =
fun (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block) (outedge cursor n : BinNums.Z)
=>
let ds : BinNums.Z :=
  BinInt.Z.modulo cursor
    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) in
let k0 : BinNums.Z :=
  BinInt.Z.div rc
    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) in
let cq : BinNums.Z :=
  BinInt.Z.div cursor
    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) in
let C : BinNums.Z := BinInt.Z.add (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) rc in
let dA : BinNums.Z := BinInt.Z.sub cq (BinNums.Zpos BinNums.xH) in
let wwa : BinNums.Z := jet_write_layout.write_word_address outedge cursor in
fun (le1 : Clight.temp_env) (m1 : Memory.Mem.mem) (so1 do1 : Integers.Ptrofs.int) (k1 ss1 : BinNums.Z) =>
and (@eq (option Values.val) (@Maps.PTree.get Values.val jets._src_ptr le1) (@Some Values.val (Values.Vptr bi so1)))
  (and (@eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le1) (@Some Values.val (Values.Vptr bw do1)))
     (and
        (@eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le1)
           (@Some Values.val (Values.Vlong (Integers.Int64.repr ss1))))
        (and
           (@eq (option Values.val) (@Maps.PTree.get Values.val jets._n le1)
              (@Some Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub n ds)))))
           (and
              (@eq BinNums.Z (Integers.Ptrofs.unsigned so1)
                 (BinInt.Z.sub edge
                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                       (BinInt.Z.add (BinNums.Zpos BinNums.xH) k1))))
              (and
                 (@eq BinNums.Z (Integers.Ptrofs.unsigned do1)
                    (BinInt.Z.add outedge
                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) dA)))
                 (and
                    (and (BinInt.Z.le BinNums.Z0 ss1)
                       (BinInt.Z.le ss1
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                    (and (BinInt.Z.le k0 k1)
                       (and
                          (@eq BinNums.Z (BinInt.Z.add rc ds)
                             (BinInt.Z.sub
                                (BinInt.Z.add
                                   (BinInt.Z.mul
                                      (BinNums.Zpos
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))) k1)
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                ss1))
                          (and (jet_copyBits_wide_sem.copied m m1 bi edge bw outedge C (BinInt.Z.sub cursor ds) cursor)
                             (and
                                (forall (old : Integers.Int64.int)
                                   (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw wwa)
                                          (@Some Values.val (Values.Vlong old))),
                                 @ex Integers.Int64.int
                                   (fun W : Integers.Int64.int =>
                                    and
                                      (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m1 bw wwa)
                                         (@Some Values.val (Values.Vlong W)))
                                      (forall (i : BinNums.Z)
                                         (_ : and (BinInt.Z.le (jet_write_layout.write_word_shift cursor) i)
                                                (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO ...)))),
                                       @eq bool (Integers.Int64.testbit W i) (Integers.Int64.testbit old i))))
                                (and
                                   (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                      (_ : or (not (@eq Values.block b bw))
                                             (or
                                                (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                   (BinInt.Z.add outedge
                                                      (BinInt.Z.mul (BinNums.Zpos ...) (BinInt.Z.add dA ...))))
                                                (BinInt.Z.le (BinInt.Z.add wwa (BinNums.Zpos (BinNums.xO ...))) ofs))),
                                    @eq (option Values.val) (Memory.Mem.load chunk m1 b ofs)
                                      (Memory.Mem.load chunk m b ofs))
                                   (and
                                      (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                         (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                       Memory.Mem.perm m1 b ofs kind p)
                                      (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                       Memory.Mem.valid_block m1 b)))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Values.block)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Clight.temp_env) (_ : Memory.Mem.mem)
         (_ : Integers.Ptrofs.int) (_ : Integers.Ptrofs.int) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments wide_prefix_post m bi (edge rc)%Z_scope bw (outedge cursor n)%Z_scope le1 m1 so1 do1 (k1 ss1)%Z_scope
