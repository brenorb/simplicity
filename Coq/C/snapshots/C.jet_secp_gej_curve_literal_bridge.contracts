### C.jet_secp_gej_curve_literal_bridge.gej_curve_reader_polynomial
gej_curve_reader_polynomial
     : forall x z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.mul
                  (BinInt.Z.mul
                     (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x))
                     (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x)))
                  (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x)))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))
                  (BinInt.Z.mul
                     (BinInt.Z.mul
                        (BinInt.Z.mul
                           (BinInt.Z.mul
                              (BinInt.Z.mul
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_square_spec_bridge.square_reader_rho z))
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_square_spec_bridge.square_reader_rho z)))
                              (jet_secp_multiply_finish_product.radix_value
                                 (jet_secp_square_spec_bridge.square_reader_rho z)))
                           (jet_secp_multiply_finish_product.radix_value
                              (jet_secp_square_spec_bridge.square_reader_rho z)))
                        (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho z)))
                     (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho z)))))
            jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.mul
                  (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))
                  (BinInt.Z.mul
                     (BinInt.Z.mul
                        (BinInt.Z.mul
                           (BinInt.Z.mul
                              (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z)
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z))
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z))
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z))
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z))
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z)))) jet_secp_fe_math.feP)
### C.jet_secp_gej_curve_literal_bridge.gej_curve_result_matches_literal
gej_curve_result_matches_literal
     : forall x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq Integers.Int.int
         (jet_secp_gej_curve_function.gej_curve_result (jet_secp_square_spec_bridge.square_reader_rho x)
            (jet_secp_square_spec_bridge.square_reader_rho y) (jet_secp_square_spec_bridge.square_reader_rho z))
         (jet_readBit_layout.bit_int
            (Bit.toBool
               (@jet_secp_curve_literal.literal_gej_is_on_curve Alg.CoreFunSem
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))))
### C.jet_secp_gej_curve_literal_bridge.eval_gej_curve_literal
eval_gej_curve_literal
     : forall (x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba : Values.block)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_point_three_reads.point_canonical_limbs x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_point_three_reads.point_canonical_limbs y))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_point_three_reads.point_canonical_limbs z))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_gej_is_valid_var)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  (jet_readBit_layout.bit_int
                     (Bit.toBool
                        (@jet_secp_curve_literal.literal_gej_is_on_curve Alg.CoreFunSem
                           (@pair
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))))))
            (and
               (Memory.Mem.range_perm mf ba BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  Memtype.Cur Memtype.Freeable)
               (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b ba)) m mf)))
