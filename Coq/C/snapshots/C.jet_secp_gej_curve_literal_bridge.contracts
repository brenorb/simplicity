### C.jet_secp_gej_curve_literal_bridge.curve_residue_mul
curve_residue_mul
     : forall (a b c d : BinNums.Z)
         (_ : @eq BinNums.Z (BinInt.Z.modulo a jet_secp_fe_math.feP) (BinInt.Z.modulo b jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo c jet_secp_fe_math.feP) (BinInt.Z.modulo d jet_secp_fe_math.feP)),
       @eq BinNums.Z (BinInt.Z.modulo (BinInt.Z.mul a c) jet_secp_fe_math.feP)
         (BinInt.Z.modulo (BinInt.Z.mul b d) jet_secp_fe_math.feP)
### C.jet_secp_gej_curve_literal_bridge.gej_curve_reader_cube_residue
gej_curve_reader_cube_residue
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (BinInt.Z.mul
                  (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x))
                  (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x)))
               (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x)))
            jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)) jet_secp_fe_math.feP)
