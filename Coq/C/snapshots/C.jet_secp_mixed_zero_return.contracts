### C.jet_secp_mixed_zero_return.mixed_zero_words
mixed_zero_words =
fun i w : forall _ : nat, Integers.Int64.int =>
match
  BinInt.Z.eqb (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value i) jet_secp_fe_math.feP) BinNums.Z0
  return (forall _ : nat, Integers.Int64.int)
with
| true => w
| false => fun _ : nat => Integers.Int64.zero
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments mixed_zero_words (i w)%function_scope _%nat_scope
### C.jet_secp_mixed_zero_return.mixed_zero_flag
mixed_zero_flag =
fun i y z : forall _ : nat, Integers.Int64.int =>
match
  BinInt.Z.eqb (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value i) jet_secp_fe_math.feP) BinNums.Z0
  return Integers.Int.int
with
| true => jet_secp_double_var_owned.double_var_zflag y z
| false => Integers.Int.one
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int), Integers.Int.int

Arguments mixed_zero_flag (i y z)%function_scope
