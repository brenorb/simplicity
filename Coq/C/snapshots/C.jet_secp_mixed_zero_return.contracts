  (@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint Integers.Int.one) le)
     : forall (_ : Maps.PTree.tree Values.val) (_ : forall _ : nat, Integers.Int64.int), Maps.PTree.tree Values.val

Arguments mixed_zero_return_temps le i%function_scope
