i128_shift62_final =
fun (le : Maps.PTree.tree Values.val) (lo hi : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vlong hi)
  (@Maps.PTree.set Values.val jets_secp._t'3 (Values.Vlong lo)
     (@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vlong hi) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments i128_shift62_final le lo hi
### C.jet_secp_i128_shift62.i128_shift62_lhs
i128_shift62_lhs =
Clight.Ebinop Cop.Oshl
  (Clight.Ebinop Cop.Omul (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tuint)
     (Clight.Etempvar jets_secp._t'2 Ctypesdefs.tulong) Ctypesdefs.tulong)
  (Clight.Ebinop Cop.Osub
     (Clight.Econst_int
        (Integers.Int.repr
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        Ctypesdefs.tint) (Clight.Etempvar jets_secp._n Ctypesdefs.tuint) Ctypesdefs.tuint) Ctypesdefs.tulong
     : Clight.expr
### C.jet_secp_i128_shift62.i128_shift62_rhs
i128_shift62_rhs =
Clight.Ebinop Cop.Oshr (Clight.Etempvar jets_secp._t'3 Ctypesdefs.tulong)
  (Clight.Etempvar jets_secp._n Ctypesdefs.tuint) Ctypesdefs.tulong
