### C.jet_secp_i128_shift62.i128_shift62_storage
i128_shift62_storage
     : forall (m : Memory.Mem.mem) (b : Values.block) (lo hi : Integers.Int64.int)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (@eq (option Memory.Mem.mem)
                  (Memory.Mem.store AST.Mint64 m b BinNums.Z0 (Values.Vlong (i128_shift62_low lo hi)))
                  (@Some Memory.Mem.mem m1))
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.store AST.Mint64 m1 b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                        (Values.Vlong (i128_shift62_high hi))) (@Some Memory.Mem.mem mf))
                  (and
                     (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf b BinNums.Z0)
                        (@Some Values.val (Values.Vlong (i128_shift62_low lo hi))))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint64 mf b
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (@Some Values.val (Values.Vlong (i128_shift62_high hi))))
                        (and
                           (forall (bb : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m bb ofs k p),
                            Memory.Mem.perm mf bb ofs k p)
                           (jet_sx_mem.lframe
                              (fun (bb : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (and (@eq Values.block bb b)
                                    (and (BinInt.Z.le BinNums.Z0 ofs)
                                       (BinInt.Z.lt ofs
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                              m mf)))))))
### C.jet_secp_i128_shift62.eval_i128_shift62_from_storage
eval_i128_shift62_from_storage
     : forall (m : Memory.Mem.mem) (b : Values.block) (lo hi : Integers.Int64.int)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Writable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m b BinNums.Z0) (@Some Values.val (Values.Vlong lo)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val (Values.Vlong hi))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_i128_rshift)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vint
                        (Integers.Int.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf b BinNums.Z0)
                  (@Some Values.val (Values.Vlong (i128_shift62_low lo hi))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val (Values.Vlong (i128_shift62_high hi))))
                  (and
                     (forall (bb : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                        (p : Memtype.permission) (_ : Memory.Mem.perm m bb ofs k p), Memory.Mem.perm mf bb ofs k p)
                     (jet_sx_mem.lframe
                        (fun (bb : Values.block) (ofs : BinNums.Z) =>
                         not
                           (and (@eq Values.block bb b)
                              (and (BinInt.Z.le BinNums.Z0 ofs)
                                 (BinInt.Z.lt ofs
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) m
                        mf)))))
### C.jet_secp_i128_shift62.i128_shift62_low
i128_shift62_low =
fun lo hi : Integers.Int64.int =>
Integers.Int64.or
  (Integers.Int64.shl (Integers.Int64.mul Integers.Int64.one hi)
     (Integers.Int64.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
  (Integers.Int64.shru lo
     (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments i128_shift62_low lo hi
### C.jet_secp_i128_shift62.i128_shift62_high
i128_shift62_high =
fun hi : Integers.Int64.int =>
Integers.Int64.shr hi
  (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
     : forall _ : Integers.Int64.int, Integers.Int64.int

Arguments i128_shift62_high hi
