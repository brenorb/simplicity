     (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
  (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr b Integers.Ptrofs.zero)
     (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_i128_rshift)))
     : forall _ : Values.block, Maps.PTree.tree Values.val

Arguments i128_shift62_temps b
