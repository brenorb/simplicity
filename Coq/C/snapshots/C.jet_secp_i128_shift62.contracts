### C.jet_secp_i128_shift62.i128_shift62_branch
i128_shift62_branch =
Clight.Ssequence
  (Clight.Ssequence (Clight.Sset jets_secp._t'2 (jet_secp_u128_shift64_expr.u128_field jets_secp._hi))
     (Clight.Ssequence (Clight.Sset jets_secp._t'3 (jet_secp_u128_shift64_expr.u128_field jets_secp._lo))
        (Clight.Sassign (jet_secp_u128_shift64_expr.u128_field jets_secp._lo)
           (Clight.Ebinop Cop.Oor i128_shift62_lhs i128_shift62_rhs Ctypesdefs.tulong))))
  (Clight.Ssequence (Clight.Sset jets_secp._t'1 (jet_secp_u128_shift64_expr.u128_field jets_secp._hi))
     (Clight.Sassign (jet_secp_u128_shift64_expr.u128_field jets_secp._hi)
        (Clight.Ecast
           (Clight.Ebinop Cop.Oshr (Clight.Ecast (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tulong) Ctypesdefs.tlong)
              (Clight.Etempvar jets_secp._n Ctypesdefs.tuint) Ctypesdefs.tlong) Ctypesdefs.tulong)))
     : Clight.statement
### C.jet_secp_i128_shift62.i128_shift62_other
i128_shift62_other =
match Clight.fn_body jets_secp.f_secp256k1_i128_rshift return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ _ => Clight.Sskip
    | Clight.Sifthenelse _ yes _ => yes
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
