### C.jet_read4_word.read4_narrow_bits
read4_narrow_bits
     : forall (w : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq bool (Integers.Int.testbit (jet_read4_crossing_layout.read4_narrow w) i)
         match Coqlib.zlt i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) return bool with
         | left _ => Integers.Int64.testbit w i
         | right _ => false
         end
### C.jet_read4_word.read4_result_bits
read4_result_bits
     : forall (w : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq bool (Integers.Int.testbit (jet_read4_layout.read4_result w) i)
         match Coqlib.zlt i (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) return bool with
         | left _ => Integers.Int64.testbit w i
         | right _ => false
         end
### C.jet_read4_word.read4_crossing_shift_unsigned
read4_crossing_shift_unsigned
     : forall (k : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) k) (BinInt.Z.le k (BinNums.Zpos (BinNums.xI BinNums.xH)))),
       @eq BinNums.Z
         (Integers.Int.unsigned
            (Integers.Int64.loword
               (Integers.Int64.repr (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) k))))
         (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) k)
### C.jet_read4_word.read4_crossing_result_bits
read4_crossing_result_bits
     : forall (k : BinNums.Z) (high low : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) k) (BinInt.Z.le k (BinNums.Zpos (BinNums.xI BinNums.xH))))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq bool (Integers.Int.testbit (jet_read4_crossing_layout.read4_crossing_result k high low) i)
         match Coqlib.zlt i (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) return bool with
         | left _ =>
             match Coqlib.zlt i (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) k) return bool with
             | left _ =>
                 Integers.Int64.testbit low
                   (BinInt.Z.add i
                      (BinInt.Z.add
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))) k))
             | right _ =>
                 Integers.Int64.testbit high
                   (BinInt.Z.sub i (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) k))
             end
         | right _ => false
         end
