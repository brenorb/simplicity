### C.jet_secp_multiply_shift_numeric.two_limb_division
two_limb_division
     : forall (M D S H L : BinNums.Z) (_ : BinInt.Z.lt BinNums.Z0 D) (_ : BinInt.Z.lt BinNums.Z0 S)
         (_ : @eq BinNums.Z M (BinInt.Z.mul D S)) (_ : and (BinInt.Z.le BinNums.Z0 H) (BinInt.Z.lt H M))
         (_ : and (BinInt.Z.le BinNums.Z0 L) (BinInt.Z.lt L M)),
       @eq BinNums.Z
         (BinInt.Z.add (BinInt.Z.mul (BinInt.Z.div H D) M)
            (BinInt.Z.modulo (BinInt.Z.add (BinInt.Z.mul H S) (BinInt.Z.div L D)) M))
         (BinInt.Z.div (BinInt.Z.add (BinInt.Z.mul H M) L) D)
### C.jet_secp_multiply_shift_numeric.shru52_unsigned
shru52_unsigned
     : forall value : Integers.Int64.int,
       @eq BinNums.Z
         (Integers.Int64.unsigned
            (Integers.Int64.shru value
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))
         (BinInt.Z.div (Integers.Int64.unsigned value)
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
### C.jet_secp_multiply_shift_numeric.shift52_low_unsigned
shift52_low_unsigned
     : forall lo hi : Integers.Int64.int,
       @eq BinNums.Z (Integers.Int64.unsigned (jet_secp_multiply_shift_shift.shift52_low lo hi))
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.mul (Integers.Int64.unsigned hi)
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
               (BinInt.Z.div (Integers.Int64.unsigned lo)
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))))
            Integers.Int64.modulus)
### C.jet_secp_multiply_shift_numeric.shift52_numeric
shift52_numeric
     : forall lo hi : Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.add
            (BinInt.Z.mul (Integers.Int64.unsigned (jet_secp_multiply_shift_shift.shift52_high hi))
               Integers.Int64.modulus) (Integers.Int64.unsigned (jet_secp_multiply_shift_shift.shift52_low lo hi)))
         (BinInt.Z.div
            (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned hi) Integers.Int64.modulus)
               (Integers.Int64.unsigned lo))
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
### C.jet_secp_multiply_shift_numeric.eval_u128_shift52_exact
eval_u128_shift52_exact
     : forall (m : Memory.Mem.mem) (b : Values.block) (lo hi : Integers.Int64.int)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Writable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m b BinNums.Z0) (@Some Values.val (Values.Vlong lo)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val (Values.Vlong hi))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_u128_rshift)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vint
                        (Integers.Int.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf b BinNums.Z0)
                  (@Some Values.val (Values.Vlong (jet_secp_multiply_shift_shift.shift52_low lo hi))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val (Values.Vlong (jet_secp_multiply_shift_shift.shift52_high hi))))
                  (and
                     (@eq BinNums.Z
                        (BinInt.Z.add
                           (BinInt.Z.mul (Integers.Int64.unsigned (jet_secp_multiply_shift_shift.shift52_high hi))
                              Integers.Int64.modulus)
                           (Integers.Int64.unsigned (jet_secp_multiply_shift_shift.shift52_low lo hi)))
                        (BinInt.Z.div
                           (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned hi) Integers.Int64.modulus)
                              (Integers.Int64.unsigned lo))
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))
                     (and
                        (forall (bb : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m bb ofs k p), Memory.Mem.perm mf bb ofs k p)
                        (jet_sx_mem.lframe
                           (fun (bb : Values.block) (ofs : BinNums.Z) =>
                            not
                              (and (@eq Values.block bb b)
                                 (and (BinInt.Z.le BinNums.Z0 ofs)
                                    (BinInt.Z.lt ofs
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                           m mf))))))
