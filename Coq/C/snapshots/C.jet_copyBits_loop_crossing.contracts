### C.jet_copyBits_loop_crossing.copy_loop_after_short_shape
copy_loop_after_short_shape
     : @eq Clight.statement jet_copyBits_loop_exec.copy_loop_after_short
         (Clight.Ssequence copy_loop_join
            (Clight.Ssequence
               (Clight.Sifthenelse
                  (Clight.Ebinop Cop.Ole (Clight.Etempvar jets._n Ctypesdefs.tulong)
                     jet_frame_constants.generated_uword_bits Ctypesdefs.tint) (Clight.Sreturn (@None Clight.expr))
                  Clight.Sskip) copy_loop_after_full))
### C.jet_copyBits_loop_crossing.exec_copy_loop_join
exec_copy_loop_join
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bi : Values.block)
         (src_ofs : Integers.Ptrofs.int) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int)
         (ss : BinNums.Z) (source next : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_ptr le)
                (@Some Values.val (Values.Vptr bi src_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le)
                (@Some Values.val (Values.Vptr bw dst_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs))
                (@Some Values.val (Values.Vlong (jet_copyBits_loop_exec.copy_loop_value ss source))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (Integers.Ptrofs.unsigned
                      (Integers.Ptrofs.sub src_ofs
                         (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vlong next)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (copy_loop_join_value ss source next))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m copy_loop_join Events.E0
         (copy_loop_join_env le ss source next) mf ClightBigstep.Out_normal
### C.jet_copyBits_loop_crossing.exec_copy_loop_full
exec_copy_loop_full
     : forall (le : Maps.PTree.tree Values.val) (m mi mf : Memory.Mem.mem) (bi : Values.block)
         (src_ofs : Integers.Ptrofs.int) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int)
         (ss n : BinNums.Z) (source next : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : and (BinInt.Z.lt ss n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_ptr le)
                (@Some Values.val (Values.Vptr bi src_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le)
                (@Some Values.val (Values.Vptr bw dst_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr n))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bi (Integers.Ptrofs.unsigned src_ofs))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (jet_copyBits_loop_exec.copy_loop_value ss source))) (@Some Memory.Mem.mem mi))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mi bi
                   (Integers.Ptrofs.unsigned
                      (Integers.Ptrofs.sub src_ofs
                         (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vlong next)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mi bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (copy_loop_join_value ss source next))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m jet_copyBits_loop_exec.copy_loop Events.E0
         (copy_loop_join_env (jet_copyBits_loop_exec.copy_loop_env le ss source) ss source next) mf
         (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type)))
### C.jet_copyBits_loop_crossing.exec_copy_choice_from_loop
exec_copy_choice_from_loop
     : forall (le : Maps.PTree.tree Values.val) (le' : Clight.temp_env) (m mf : Memory.Mem.mem)
         (ss : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m jet_copyBits_loop_exec.copy_loop
