### C.jet_divmod128_entry.divmod128_entry
divmod128_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb mc md : Memory.Mem.mem') (bl bqh bql br bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block mb bqh))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mb BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block mc bql))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mc BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block md br)),
       Clight.function_entry2 jet_exec.ge0 jets.f_simplicity_div_mod_128_64
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (divmod128_env bl bqh bql br) (divmod128_temps env bd dbase bs sbase) md
### C.jet_divmod128_entry.exec_divmod128_source_copy
exec_divmod128_source_copy
     : forall (m mc : Memory.Mem.mem) (bl bqh bql br bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (divmod128_env bl bqh bql br) le m
         (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
            (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
### C.jet_divmod128_entry.call_divmod128_read
call_divmod128_read
     : forall (s : jet_wide.wide_size) (result : AST.ident) (le : Clight.temp_env) (m mr : Memory.Mem.mem)
         (bl bqh bql br : Values.block) (w : Integers.Int64.int)
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
