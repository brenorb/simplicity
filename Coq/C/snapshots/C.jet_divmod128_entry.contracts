### C.jet_divmod128_entry.call_divmod128_helper
call_divmod128_helper
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (idq idah idal : BinNums.positive) (bq br : Values.block)
         (ah al b : Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._div_mod_96_64 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) idq e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bq Ctypesdefs.tulong)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) jets._r e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type br Ctypesdefs.tulong)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val idah le) (@Some Values.val (Values.Vlong ah)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val idal le) (@Some Values.val (Values.Vlong al)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._b le) (@Some Values.val (Values.Vlong b)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_div_mod_96_64)
                (@cons Values.val (Values.Vptr bq Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vlong ah)
                         (@cons Values.val (Values.Vlong al) (@cons Values.val (Values.Vlong b) (@nil Values.val))))))
                Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m (divmod128_helper_call idq idah idal) Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_divmod128_entry.eval_divmod128_local
eval_divmod128_local
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (id : BinNums.positive) (bb : Values.block) (w : Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bb Ctypesdefs.tulong)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bb BinNums.Z0) (@Some Values.val (Values.Vlong w))),
       Clight.eval_expr jet_exec.ge0 e le m (Clight.Evar id Ctypesdefs.tulong) (Values.Vlong w)
### C.jet_divmod128_entry.divmod128_env
divmod128_env =
fun bl bqh bql br : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets._r (@pair Values.block Ctypes.type br Ctypesdefs.tulong)
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets._ql (@pair Values.block Ctypes.type bql Ctypesdefs.tulong)
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets._qh (@pair Values.block Ctypes.type bqh Ctypesdefs.tulong)
        (jet_one8.e_one8 bl)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block),
       Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments divmod128_env bl bqh bql br
### C.jet_divmod128_entry.divmod128_temps
divmod128_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_div_mod_128_64 bd (Integers.Ptrofs.repr dbase) bs
  (Integers.Ptrofs.repr sbase)
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments divmod128_temps env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_divmod128_entry.divmod128_helper_call
divmod128_helper_call =
fun idq idah idal : AST.ident =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets._div_mod_96_64
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tulong)
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tulong)
              (Ctypes.Tcons Ctypesdefs.tulong
                 (Ctypes.Tcons Ctypesdefs.tulong (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil))))) Ctypesdefs.tvoid
        AST.cc_default))
  (@cons Clight.expr (Clight.Eaddrof (Clight.Evar idq Ctypesdefs.tulong) (Ctypesdefs.tptr Ctypesdefs.tulong))
     (@cons Clight.expr (Clight.Eaddrof (Clight.Evar jets._r Ctypesdefs.tulong) (Ctypesdefs.tptr Ctypesdefs.tulong))
        (@cons Clight.expr (Clight.Etempvar idah Ctypesdefs.tulong)
           (@cons Clight.expr (Clight.Etempvar idal Ctypesdefs.tulong)
              (@cons Clight.expr (Clight.Etempvar jets._b Ctypesdefs.tulong) (@nil Clight.expr))))))
     : forall (_ : AST.ident) (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments divmod128_helper_call idq idah idal
