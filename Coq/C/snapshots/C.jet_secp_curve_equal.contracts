### C.jet_secp_curve_equal.curve_equal_bounds
curve_equal_bounds =
fun n : nat =>
@pair BinNums.Z BinNums.Z BinNums.Z0
  match
    orb (PeanoNat.Nat.eqb n (S (S (S (S (S O)))))) (PeanoNat.Nat.eqb n (S (S (S (S (S (S (S (S (S (S O)))))))))))
    return BinNums.Z
  with
  | true =>
      BinNums.Zpos
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
  | false =>
      BinNums.Zpos
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
  end
     : forall _ : nat, prod BinNums.Z BinNums.Z

Arguments curve_equal_bounds n%nat_scope
### C.jet_secp_curve_equal.curve_equal_diff
curve_equal_diff =
fun (rho : forall _ : nat, BinNums.Z) (n : nat) =>
BinInt.Z.add
  (BinInt.Z.sub
     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
        (jet_secp_field_negate_values.negate_mask (Nat.sub n (S O)))) (rho n)) (rho (Nat.add n (S (S (S (S (S O)))))))
     : forall (_ : forall _ : nat, BinNums.Z) (_ : nat), BinNums.Z

Arguments curve_equal_diff rho%function_scope n%nat_scope
