     (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx))) curve_equal_regs
  (@nil jet_sx_eval.event) (S (S (S (S (S (S (S (S (S (S (S O)))))))))))
