### C.jet_secp_curve_equal.curve_equal_run_eq
curve_equal_run_eq
     : @eq (option jet_sx_exec.res) curve_equal_run
         (@Some jet_sx_exec.res
            (jet_sx_exec.RIf curve_equal_cond (jet_sx_exec.RDone curve_equal_early jet_sx_exec.ONormal)
               (jet_sx_exec.RDone curve_equal_late jet_sx_exec.ONormal)))
### C.jet_secp_curve_equal.curve_equal_logs
curve_equal_logs
     : @eq bool
         (jet_sx_pure.leaves_log_nil
            (jet_sx_exec.RIf curve_equal_cond (jet_sx_exec.RDone curve_equal_early jet_sx_exec.ONormal)
               (jet_sx_exec.RDone curve_equal_late jet_sx_exec.ONormal))) true
### C.jet_secp_curve_equal.curve_equal_early_ret
curve_equal_early_ret
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps curve_equal_early))
         (@Some jet_sx_expr.sx (jet_sx_expr.XIc Integers.Int.zero))
### C.jet_secp_curve_equal.curve_equal_late_ret
curve_equal_late_ret
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps curve_equal_late))
         (@Some jet_sx_expr.sx curve_equal_ret)
### C.jet_secp_curve_equal.curve_equal_regions
curve_equal_regions
     : and (@eq (list jet_sx_state.region) (jet_sx_eval.sregs curve_equal_early) curve_equal_regs)
         (@eq (list jet_sx_state.region) (jet_sx_eval.sregs curve_equal_late) curve_equal_regs)
### C.jet_secp_curve_equal.eval_curve_equal_symbolic
eval_curve_equal_symbolic
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout curve_equal_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_equal_var)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout (S O))
                        (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val))) Events.E0 mf
               match jet_sx_expr.truth rho (jet_sx_state.lay layout) curve_equal_cond return Values.val with
               | true => Values.Vint Integers.Int.zero
               | false => jet_sx_expr.den rho (jet_sx_state.lay layout) curve_equal_ret
               end)
            (and (jet_sx_state.rep rho layout curve_equal_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (o : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape curve_equal_regs) b o)) m mf)))
### C.jet_secp_curve_equal.curve_equal_checked
curve_equal_checked
     : and
         (@eq (option (prod BinNums.Z BinNums.Z)) (jet_sx_zval.zb curve_equal_bounds curve_equal_ret)
            (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))))
         (and (@eq bool (jet_sx_expr.isk jet_sx_expr.KI curve_equal_ret) true)
            (and
               (@eq (option (prod BinNums.Z BinNums.Z)) (jet_sx_zval.zb curve_equal_bounds curve_equal_cond)
                  (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))))
               (@eq bool (jet_sx_expr.isk jet_sx_expr.KI curve_equal_cond) true)))
### C.jet_secp_curve_equal.curve_equal_cond_zval
curve_equal_cond_zval
     : forall rho : forall _ : nat, BinNums.Z,
       @eq BinNums.Z (jet_sx_zval.zval rho curve_equal_cond)
         (jet_sx_zval.b2z
            (jet_secp_curve_zero.curve_zero_fast (curve_equal_diff rho (S O))
               (curve_equal_diff rho (S (S (S (S (S O))))))))
### C.jet_secp_curve_equal.curve_equal_ret_zval
curve_equal_ret_zval
     : forall rho : forall _ : nat, BinNums.Z,
       @eq BinNums.Z (jet_sx_zval.zval rho curve_equal_ret)
         match
           jet_secp_curve_weak.curve_weak_math (curve_equal_diff rho (S O)) (curve_equal_diff rho (S (S O)))
             (curve_equal_diff rho (S (S (S O)))) (curve_equal_diff rho (S (S (S (S O)))))
             (curve_equal_diff rho (S (S (S (S (S O)))))) return BinNums.Z
         with
         | pair p e =>
             match p return BinNums.Z with
             | pair p0 d =>
                 match p0 return BinNums.Z with
                 | pair p1 c =>
                     match p1 return BinNums.Z with
                     | pair a b => jet_sx_zval.b2z (jet_secp_curve_zero_math.curve_zero_test a b c d e)
                     end
                 end
             end
         end
### C.jet_secp_curve_equal.curve_equal_diff_bounds
curve_equal_diff_bounds
     : forall (rho : forall _ : nat, BinNums.Z)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (curve_equal_bounds n)) (rho n))
                (BinInt.Z.le (rho n) (@snd BinNums.Z BinNums.Z (curve_equal_bounds n)))) (n : nat)
         (_ : and (le (S O) n) (le n (S (S (S (S (S O))))))),
       and (BinInt.Z.le BinNums.Z0 (curve_equal_diff rho n))
         (BinInt.Z.le (curve_equal_diff rho n)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
### C.jet_secp_curve_equal.curve_equal_diff_value
curve_equal_diff_value
     : forall rho : forall _ : nat, BinNums.Z,
       @eq BinNums.Z
         (jet_secp_fe_math.fe_val (curve_equal_diff rho (S O)) (curve_equal_diff rho (S (S O)))
            (curve_equal_diff rho (S (S (S O)))) (curve_equal_diff rho (S (S (S (S O)))))
            (curve_equal_diff rho (S (S (S (S (S O)))))))
         (BinInt.Z.add
            (BinInt.Z.sub (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) jet_secp_fe_math.feP)
               (jet_secp_fe_math.fe_val (rho (S O)) (rho (S (S O))) (rho (S (S (S O)))) (rho (S (S (S (S O)))))
                  (rho (S (S (S (S (S O))))))))
            (jet_secp_fe_math.fe_val (rho (S (S (S (S (S (S O))))))) (rho (S (S (S (S (S (S (S O))))))))
               (rho (S (S (S (S (S (S (S (S O))))))))) (rho (S (S (S (S (S (S (S (S (S O))))))))))
               (rho (S (S (S (S (S (S (S (S (S (S O)))))))))))))
### C.jet_secp_curve_equal.curve_mod_equal
curve_mod_equal
     : forall a b : BinNums.Z,
       @eq bool
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (BinInt.Z.add
                  (BinInt.Z.sub (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) jet_secp_fe_math.feP)
                     a) b) jet_secp_fe_math.feP) BinNums.Z0)
         (BinInt.Z.eqb (BinInt.Z.modulo a jet_secp_fe_math.feP) (BinInt.Z.modulo b jet_secp_fe_math.feP))
### C.jet_secp_curve_equal.eval_curve_equal_numeric
eval_curve_equal_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout curve_equal_regs m)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (curve_equal_bounds n)) (Integers.Int64.unsigned (rho n)))
                (BinInt.Z.le (Integers.Int64.unsigned (rho n)) (@snd BinNums.Z BinNums.Z (curve_equal_bounds n)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_equal_var)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout (S O))
                        (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val))) Events.E0 mf
               (Values.Vint
                  match
                    BinInt.Z.eqb
                      (BinInt.Z.modulo
                         (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho (S O)))
                            (Integers.Int64.unsigned (rho (S (S O)))) (Integers.Int64.unsigned (rho (S (S (S O)))))
                            (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S O)))))))) jet_secp_fe_math.feP)
                      (BinInt.Z.modulo
                         (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho (S (S (S (S (S (S O))))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S O)))))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S (S O))))))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S (S (S O)))))))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S (S (S (S O)))))))))))))
                         jet_secp_fe_math.feP) return Integers.Int.int
                  with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (and (jet_sx_state.rep rho layout curve_equal_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (o : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape curve_equal_regs) b o)) m mf)))
### C.jet_secp_curve_equal.curve_equal_regs
curve_equal_regs =
@cons jet_sx_state.region
  (jet_secp_local_regions.free_region (jet_secp_fe_nv.fe_reg (jet_secp_fe_nv.vars5 (S O)))
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
  (@cons jet_sx_state.region
