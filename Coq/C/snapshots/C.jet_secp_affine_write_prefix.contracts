                   (@nil (prod Values.block BinNums.Z)))),
       @ex Memory.Mem.mem
         (fun mx : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                  (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                     (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val))) Events.E0
                  mx Values.Vundef)
               (and
