### C.jet_secp_hash_public_call.eval_hash_public_original
eval_hash_public_original
     : forall (_ : jet_memcpy_model.memcpy_model) (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (v_env : Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
         (bi : Values.block) (edge rc : BinNums.Z)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_secp_sha_startup.secp_sha_startup m0) (_ : jet_secp_swu_startup.swu_startup m0)
         (_ : forall prefix : bool, jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix m0)
         (_ : jet_output_layout.write_frame_at m0 bd base bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m0 bs sbase bi edge rc)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) key)) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun sx : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun sy : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun sz : forall _ : nat, Integers.Int64.int =>
                   @ex Integers.Int.int
                     (fun sumflag : Integers.Int.int =>
                      @ex (forall _ : nat, Integers.Int64.int)
                        (fun ox : forall _ : nat, Integers.Int64.int =>
                         @ex (forall _ : nat, Integers.Int64.int)
                           (fun oy : forall _ : nat, Integers.Int64.int =>
                            and
                              (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m0
                                 (@Ctypes.Internal Clight.function jets_secp.f_simplicity_hash_to_curve)
                                 (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                                    (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                                       (@cons Values.val v_env (@nil Values.val)))) Events.E0 mf
                                 (Values.Vint
                                    (jet_secp_field_cmov.cmov_int
                                       (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                                          (jet_secp_generator_hash_map.generator_hash_accepted true key)))))
                              (and (hash_public_value key sx sy sz sumflag ox oy)
                                 (and
                                    (jet_frame_inv.finv m0 bd base bw outedge cursor N bi mf
                                       (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                                          (jet_secp_generator_hash_map.generator_hash_accepted true key))
                                       match
                                         andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                                           (jet_secp_generator_hash_map.generator_hash_accepted true key)
                                         return (list BitMachine.Cell)
                                       with
                                       | true =>
                                           @Translate.encode
                                             (Ty.Prod (Word.Word (S (S (S (S (S (...)))))))
                                                (Word.Word (S (S (S (S (S (...))))))))
                                             (@pair (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                (jet_secp_rescale_literal.rescale_field_output ox)
                                                (jet_secp_rescale_literal.rescale_field_output oy))
                                       | false => @nil BitMachine.Cell
                                       end)
                                    (and
                                       (jet_sx_mem.lframe
                                          (fun (b : Values.block) (_ : BinNums.Z) =>
                                           not (jet_secp_frame.extA m0 bd bw bi b)) m0 mf)
                                       (jet_clight_internal_preserve.readonly_preserved m0 mf)))))))))))
### C.jet_secp_hash_public_call.hash_public_value
hash_public_value =
fun (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (sx sy sz : forall _ : nat, Integers.Int64.int)
  (sumflag : Integers.Int.int) (ox oy : forall _ : nat, Integers.Int64.int) =>
and (jet_secp_square_columns.square_input_bounds sx)
  (and (jet_secp_square_columns.square_input_bounds sy)
     (and (jet_secp_square_columns.square_input_bounds sz)
        (and
           (@eq Integers.Int.int sumflag
              (jet_readBit_layout.bit_int
                 (Bit.toBool
                    (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
                       (jet_secp_rescale_literal.rescale_field_output sz)))))
           (and
              (forall (_ : @eq bool (jet_secp_generator_hash_map.generator_hash_accepted false key) true)
                 (_ : @eq bool (jet_secp_generator_hash_map.generator_hash_accepted true key) true),
               @eq
                 (prod
                    (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (@pair
                    (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (jet_secp_rescale_literal.rescale_field_output sx)
                       (jet_secp_rescale_literal.rescale_field_output sy))
                    (jet_secp_rescale_literal.rescale_field_output sz))
                 (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
                    (@pair
                       (prod
                          (Ty.tySem
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                       (Ty.tySem
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                             (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                       (@pair
                          (Ty.tySem
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                          (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem
                             (@jet_secp_generator_hash_literal.literal_generator_hash false Alg.CoreFunSem key))
                          (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))
                       (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem
                          (@jet_secp_generator_hash_literal.literal_generator_hash true Alg.CoreFunSem key)))))
              (and (jet_secp_square_columns.square_input_bounds ox)
                 (and (jet_secp_square_columns.square_input_bounds oy)
                    (and
                       (forall _ : @eq Integers.Int.int sumflag Integers.Int.zero,
                        @ex (forall _ : nat, Integers.Int64.int)
                          (fun zi : forall _ : nat, Integers.Int64.int =>
                           and
                             (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value zi)
                                (jet_secp_invert_literal.literal_invert_numeric
                                   (jet_secp_fe_inv_prefix.fe_inv_value sz)))
                             (and
                                (@eq (forall _ : nat, Integers.Int64.int) ox
                                   (jet_secp_point_mul_storage.point_mul_words sx
                                      (jet_secp_square_numeric.square_words zi)))
                                (@eq (forall _ : nat, Integers.Int64.int) oy
                                   (jet_secp_point_mul_storage.point_mul_words sy
                                      (jet_secp_point_mul_storage.point_mul_words zi
                                         (jet_secp_square_numeric.square_words zi)))))))
                       (forall _ : not (@eq Integers.Int.int sumflag Integers.Int.zero),
                        and
                          (@eq (forall _ : nat, Integers.Int64.int) ox
                             jet_secp_generator_affine_roundtrip.generator_infinite_words)
                          (@eq (forall _ : nat, Integers.Int64.int) oy
                             jet_secp_generator_affine_roundtrip.generator_infinite_words)))))))))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : Integers.Int.int) (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments hash_public_value key (sx sy sz)%function_scope sumflag (ox oy)%function_scope
