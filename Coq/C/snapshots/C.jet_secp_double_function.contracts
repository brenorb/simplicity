### C.jet_secp_double_function.double_function_ok
double_function_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_secp256k1_gej_double) true
### C.jet_secp_double_function.double_function_entry
double_function_entry
     : forall (m : Memory.Mem.mem) (ml ms mi : Memory.Mem.mem') (ba bl bs bt : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block ml bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ml BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block ms bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ms BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mi bt)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_gej_double
         (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) m
         (jet_secp_double_statements.double_helper_env bl bs bt) (double_entry_temps ba) mi
### C.jet_secp_double_function.double_function_blocks
double_function_blocks
     : forall bl bs bt : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (jet_secp_double_statements.double_helper_env bl bs bt))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bs BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bt BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))
### C.jet_secp_double_function.eval_double_function
eval_double_function
     : forall (x y z : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba : Values.block)
         (flag : Integers.Int.int) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds y) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag)))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_double)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf ba BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_double_all_calls.double_output_x_words x y)))
               (and
                  (jet_secp_fe_nv.fe_at mf ba
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 (jet_secp_double_all_calls.double_output_y_words x y)))
                  (and
                     (jet_secp_fe_nv.fe_at mf ba
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_double_all_calls.double_output_z_words y z)))
                     (and
                        (Memory.Mem.range_perm mf ba BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_secp_square_columns.square_input_bounds
                              (jet_secp_double_all_calls.double_output_x_words x y))
                           (and
                              (jet_secp_square_columns.square_input_bounds
                                 (jet_secp_double_all_calls.double_output_y_words x y))
                              (and
                                 (jet_secp_square_columns.square_input_bounds
                                    (jet_secp_double_all_calls.double_output_z_words y z))
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b ba)) m mf)))))))))
### C.jet_secp_double_function.double_entry_temps
double_entry_temps =
fun ba : Values.block =>
@Maps.PTree.set Values.val jets_secp._a (Values.Vptr ba Integers.Ptrofs.zero)
  (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr ba Integers.Ptrofs.zero)
     (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_gej_double)))
     : forall _ : Values.block, Maps.PTree.tree Values.val

Arguments double_entry_temps ba
