### C.jet_secp_scalar_negate_numeric.scalar_negate_output_value
scalar_negate_output_value =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) =>
let limb : forall _ : nat, BinNums.Z :=
  fun i : nat =>
  Integers.Int64.unsigned
    (jet_sx_expr.il
       (jet_sx_expr.den rho layout
          (@List.nth jet_sx_expr.sx i jet_secp_scalar_negate_exec.scalar_negate_limbs
             (jet_sx_expr.XLc Integers.Int64.zero)))) in
