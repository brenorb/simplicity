### C.jet_secp_scalar_negate_numeric.scalar_negate_raw_weighted_value
scalar_negate_raw_weighted_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (scalar_negate_raw_value rho layout)
         (BinInt.Z.modulo
            (BinInt.Z.sub jet_secp_canonical_scalar.canonical_group_order
               (jet_secp_scalar_overflow_numeric.scalar_limb_value rho))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
### C.jet_secp_scalar_negate_numeric.scalar_negate_masked_weighted_value
scalar_negate_masked_weighted_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (scalar_negate_output_value rho layout)
         match BinInt.Z.eqb (jet_secp_scalar_overflow_numeric.scalar_limb_value rho) BinNums.Z0 return BinNums.Z with
         | true => BinNums.Z0
         | false => scalar_negate_raw_value rho layout
         end
### C.jet_secp_scalar_negate_numeric.scalar_negate_normalized_value
scalar_negate_normalized_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 (jet_secp_scalar_overflow_numeric.scalar_limb_value rho))
                (BinInt.Z.lt (jet_secp_scalar_overflow_numeric.scalar_limb_value rho)
                   jet_secp_canonical_scalar.canonical_group_order)),
       @eq BinNums.Z (scalar_negate_output_value rho layout)
         (BinInt.Z.modulo (BinInt.Z.opp (jet_secp_scalar_overflow_numeric.scalar_limb_value rho))
            jet_secp_canonical_scalar.canonical_group_order)
