                  (Values.Vlong
                     (Integers.Int64.repr (BinInt.Z.of_nat (@length jet_elements_fee_lookup_table.fee_entry entries))))
                  (@nil Values.val)))) Events.E0 m (Values.Vlong Integers.Int64.zero)
### C.jet_elements_fee_lookup_sorted.fee_lookup_sorted
fee_lookup_sorted =
fun entries : list jet_elements_fee_lookup_table.fee_entry =>
forall (i j : nat) (x y : jet_elements_fee_lookup_table.fee_entry) (_ : lt i j)
  (_ : @eq (option jet_elements_fee_lookup_table.fee_entry)
         (@List.nth_error jet_elements_fee_lookup_table.fee_entry entries i)
         (@Some jet_elements_fee_lookup_table.fee_entry x))
  (_ : @eq (option jet_elements_fee_lookup_table.fee_entry)
         (@List.nth_error jet_elements_fee_lookup_table.fee_entry entries j)
         (@Some jet_elements_fee_lookup_table.fee_entry y)),
@eq comparison
  (jet_memcmp_model.bytes_cmp (jet_elements_fee_lookup_table.fee_entry_key x)
     (jet_elements_fee_lookup_table.fee_entry_key y)) Lt
     : forall _ : list jet_elements_fee_lookup_table.fee_entry, Prop

Arguments fee_lookup_sorted entries%list_scope
### C.jet_elements_fee_lookup_sorted.fee_lookup_find
fee_lookup_find =
fix fee_lookup_find
  (key : list Integers.Int.int) (entries : list jet_elements_fee_lookup_table.fee_entry) {struct entries} :
    option Integers.Int64.int :=
  match entries return (option Integers.Int64.int) with
  | nil => @None Integers.Int64.int
  | cons x xs =>
      match
        @List.list_eq_dec Integers.Int.int Integers.Int.eq_dec key (jet_elements_fee_lookup_table.fee_entry_key x)
        return (option Integers.Int64.int)
      with
      | left _ => @Some Integers.Int64.int (jet_elements_fee_lookup_table.fee_entry_amount x)
      | right _ => fee_lookup_find key xs
      end
  end
     : forall (_ : list Integers.Int.int) (_ : list jet_elements_fee_lookup_table.fee_entry), option Integers.Int64.int

Arguments fee_lookup_find (key entries)%list_scope
### C.jet_elements_fee_lookup_sorted.fee_lookup_value
fee_lookup_value =
fun (key : list Integers.Int.int) (entries : list jet_elements_fee_lookup_table.fee_entry) =>
match fee_lookup_find key entries return Integers.Int64.int with
| Some value => value
| None => Integers.Int64.zero
end
     : forall (_ : list Integers.Int.int) (_ : list jet_elements_fee_lookup_table.fee_entry), Integers.Int64.int

Arguments fee_lookup_value (key entries)%list_scope
