fee_lookup_find_absent
     : forall (key : list Integers.Int.int) (entries : list jet_elements_fee_lookup_table.fee_entry)
         (_ : @List.Forall jet_elements_fee_lookup_table.fee_entry
                (fun x : jet_elements_fee_lookup_table.fee_entry =>
                 not (@eq (list Integers.Int.int) key (jet_elements_fee_lookup_table.fee_entry_key x))) entries),
       @eq (option Integers.Int64.int) (fee_lookup_find key entries) (@None Integers.Int64.int)
