### C.jet_elements_fee_lookup_sorted.fee_lookup_pivot_order
fee_lookup_pivot_order
     : forall (entries : list jet_elements_fee_lookup_table.fee_entry) (j : nat)
         (x : jet_elements_fee_lookup_table.fee_entry) (_ : fee_lookup_sorted entries)
         (_ : @eq (option jet_elements_fee_lookup_table.fee_entry)
                (@List.nth_error jet_elements_fee_lookup_table.fee_entry entries j)
                (@Some jet_elements_fee_lookup_table.fee_entry x)),
       and
         (@List.Forall jet_elements_fee_lookup_table.fee_entry
            (fun y : jet_elements_fee_lookup_table.fee_entry =>
             @eq comparison
               (jet_memcmp_model.bytes_cmp (jet_elements_fee_lookup_table.fee_entry_key y)
                  (jet_elements_fee_lookup_table.fee_entry_key x)) Lt)
            (@List.firstn jet_elements_fee_lookup_table.fee_entry j entries))
         (@List.Forall jet_elements_fee_lookup_table.fee_entry
            (fun y : jet_elements_fee_lookup_table.fee_entry =>
             @eq comparison
               (jet_memcmp_model.bytes_cmp (jet_elements_fee_lookup_table.fee_entry_key x)
                  (jet_elements_fee_lookup_table.fee_entry_key y)) Lt)
            (@List.skipn jet_elements_fee_lookup_table.fee_entry (S j) entries))
### C.jet_elements_fee_lookup_sorted.fee_lookup_partition
fee_lookup_partition
     : forall (key : list Integers.Int.int) (entries : list jet_elements_fee_lookup_table.fee_entry)
         (j : nat) (x : jet_elements_fee_lookup_table.fee_entry)
         (_ : @eq (option jet_elements_fee_lookup_table.fee_entry)
                (@List.nth_error jet_elements_fee_lookup_table.fee_entry entries j)
                (@Some jet_elements_fee_lookup_table.fee_entry x)) (_ : fee_lookup_sorted entries)
         (_ : @List.Forall jet_elements_fee_lookup_table.fee_entry
                (fun y : jet_elements_fee_lookup_table.fee_entry =>
                 @eq nat (@length Integers.Int.int (jet_elements_fee_lookup_table.fee_entry_key y))
                   (@length Integers.Int.int key)) entries),
       @eq Integers.Int64.int (fee_lookup_value key entries)
         match
           jet_memcmp_model.bytes_cmp key (jet_elements_fee_lookup_table.fee_entry_key x) return Integers.Int64.int
         with
         | Eq => jet_elements_fee_lookup_table.fee_entry_amount x
         | Lt => fee_lookup_value key (@List.firstn jet_elements_fee_lookup_table.fee_entry j entries)
         | Gt => fee_lookup_value key (@List.skipn jet_elements_fee_lookup_table.fee_entry (S j) entries)
         end
### C.jet_elements_fee_lookup_sorted.fee_lookup_answer_sorted
fee_lookup_answer_sorted
     : forall (fuel : nat) (key : list Integers.Int.int) (entries : list jet_elements_fee_lookup_table.fee_entry)
         (_ : le (@length jet_elements_fee_lookup_table.fee_entry entries) fuel) (_ : fee_lookup_sorted entries)
         (_ : @List.Forall jet_elements_fee_lookup_table.fee_entry
                (fun y : jet_elements_fee_lookup_table.fee_entry =>
                 @eq nat (@length Integers.Int.int (jet_elements_fee_lookup_table.fee_entry_key y))
                   (@length Integers.Int.int key)) entries),
       @eq Integers.Int64.int (jet_elements_fee_lookup_loop.fee_lookup_answer fuel key entries)
         (fee_lookup_value key entries)
