### C.jet_elements_fee_lookup_sorted.fee_lookup_find_app
fee_lookup_find_app
     : forall (key : list Integers.Int.int) (xs ys : list jet_elements_fee_lookup_table.fee_entry),
       @eq (option Integers.Int64.int) (fee_lookup_find key (@app jet_elements_fee_lookup_table.fee_entry xs ys))
         match fee_lookup_find key xs return (option Integers.Int64.int) with
         | Some value => @Some Integers.Int64.int value
         | None => fee_lookup_find key ys
         end
