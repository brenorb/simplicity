eval_fee_lookup_sorted
     : forall (_ : jet_memcmp_model.memcmp_model) (m : Memory.Mem.mem) (keyval tableval : Values.val)
         (key : list Integers.Int.int) (entries : list jet_elements_fee_lookup_table.fee_entry)
         (_ : jet_elements_fee_lookup_table.fee_lookup_storage m keyval tableval key entries)
         (_ : fee_lookup_sorted entries),
       ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
         (@Ctypes.Internal Clight.function jets_elements.f_lookup_fee)
         (@cons Values.val keyval
            (@cons Values.val tableval
               (@cons Values.val
                  (Values.Vlong
                     (Integers.Int64.repr (BinInt.Z.of_nat (@length jet_elements_fee_lookup_table.fee_entry entries))))
                  (@nil Values.val)))) Events.E0 m (Values.Vlong (fee_lookup_value key entries))
