### C.jet_elements_fee_lookup_sorted.fee_split_at
@fee_split_at
     : forall (A : Type) (j : nat) (entries : list A) (x : A)
         (_ : @eq (option A) (@List.nth_error A entries j) (@Some A x)),
       @eq (list A) entries (@app A (@List.firstn A j entries) (@cons A x (@List.skipn A (S j) entries)))
