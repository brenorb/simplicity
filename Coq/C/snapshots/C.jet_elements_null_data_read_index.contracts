### C.jet_elements_null_data_read_index.elements_null_data_selected_private
elements_null_data_selected_private =
fun (m : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (edge cur : BinNums.Z)
  (be : Values.block) (ebase : BinNums.Z) (bt : Values.block) (txbase : BinNums.Z) (bout : Values.block)
  (outbase : BinNums.Z) (i j : Integers.Int64.int)
  (parsed : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int))) (unused_hash : Digest.hash256) =>
forall (d : jet_elements_prim.txNullDatumF (list Integers.Byte.int))
  (_ : @eq (option (jet_elements_prim.txNullDatumF (list Integers.Byte.int)))
         (@List.nth_error (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) parsed
            (BinInt.Z.to_nat (Integers.Int64.unsigned j)))
         (@Some (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) d)),
@ex Values.block
  (fun bop : Values.block =>
   @ex BinNums.Z
     (fun opbase : BinNums.Z =>
      and (not (@eq Values.block bl bop))
        (and
           (jet_elements_null_data_small.elements_null_data_path_valid m be ebase bt txbase bout outbase bop opbase i j
              (jet_elements_null_data_opcode.elements_datum_code
                 (@jet_elements_prim.mapNullDatum (list Integers.Byte.int) Digest.hash256 Digest.byteStringHash d)))
           (and
              (@List.Forall (prod (prod Values.block BinNums.Z) BinNums.Z)
                 (fun pat : prod (prod Values.block BinNums.Z) BinNums.Z =>
                  match pat return Prop with
                  | pair y hi =>
                      match y return Prop with
                      | pair b lo =>
                          jet_application_sep.out_sep bd dbase bw edge cur
                            (BinNums.Zpos
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xI
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                            b lo hi
                      end
                  end)
                 (jet_elements_null_data_loads.elements_null_data_path_footprint be ebase bt txbase bout outbase bop
                    opbase i j))
              match
                jet_elements_null_data_opcode.elements_datum_push
                  (@jet_elements_prim.mapNullDatum (list Integers.Byte.int) Digest.hash256 Digest.byteStringHash d)
                return Prop
              with
              | true =>
                  and
                    (jet_uint32_array_init.uint32_array_at m bop
                       (BinInt.Z.add opbase
                          (BinInt.Z.mul
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
                             (Integers.Int64.unsigned j)))
                       (Digest.hash256_reg
                          (jet_elements_null_data_opcode.elements_datum_hash
                             (@jet_elements_prim.mapNullDatum (list Integers.Byte.int) Digest.hash256
                                Digest.byteStringHash d) unused_hash)))
                    (jet_application_sep.out_sep bd dbase bw edge cur
                       (BinNums.Zpos
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                       bop
                       (BinInt.Z.add opbase
                          (BinInt.Z.mul
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
                             (Integers.Int64.unsigned j)))
                       (BinInt.Z.add
                          (BinInt.Z.add opbase
                             (BinInt.Z.mul
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
                                (Integers.Int64.unsigned j)))
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
              | false => True
              end))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block)
         (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
         (_ : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int))) (_ : Digest.hash256), Prop

