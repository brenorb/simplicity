### C.jet_elements_null_data_read_index.write_effect_private
write_effect_private =
fun (bl : Values.block) (m mf : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
  (edge cur count : BinNums.Z) (cells : list BitMachine.Cell) =>
and (jet_encoding.frame_output_cells_at mf bw edge cur cells)
  (and (jet_output_layout.write_prefix_at m mf bw edge cur)
     (and (jet_frame_layout.frame_fields_at mf bd dbase bw edge (BinInt.Z.sub cur count))
        (and
           (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : not (@eq Values.block b bl))
              (_ : or (not (@eq Values.block b bd))
                     (or
                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                           (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (BinInt.Z.le
                           (BinInt.Z.add dbase
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
              (_ : or (not (@eq Values.block b bw))
                     (or
                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div (BinInt.Z.sub cur count)
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                        (BinInt.Z.le
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cur)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
            @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
           (and
              (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                 (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mf b ofs kind p)
              (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
     : forall (_ : Values.block) (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block)
         (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : list BitMachine.Cell), Prop

