### C.jet_elements_null_data_read_index.elements_find_index_read_arm
elements_find_index_read_arm =
fix elements_find_index_read_arm (s : Clight.statement) : option Clight.statement :=
  match s return (option Clight.statement) with
  | Clight.Sskip => @None Clight.statement
  | Clight.Sassign _ _ => @None Clight.statement
  | Clight.Sset _ _ => @None Clight.statement
  | Clight.Scall _ _ _ => @None Clight.statement
  | Clight.Sbuiltin _ _ _ _ => @None Clight.statement
  | Clight.Ssequence a b =>
      match a return (option Clight.statement) with
      | Clight.Sskip =>
          jet_elements_null_data_small.elements_stmt_first (elements_find_index_read_arm a)
            (elements_find_index_read_arm b)
      | Clight.Sassign _ _ =>
          jet_elements_null_data_small.elements_stmt_first (elements_find_index_read_arm a)
            (elements_find_index_read_arm b)
      | Clight.Sset _ _ =>
          jet_elements_null_data_small.elements_stmt_first (elements_find_index_read_arm a)
            (elements_find_index_read_arm b)
      | Clight.Scall _ _ _ =>
          jet_elements_null_data_small.elements_stmt_first (elements_find_index_read_arm a)
            (elements_find_index_read_arm b)
      | Clight.Sbuiltin _ _ _ _ =>
          jet_elements_null_data_small.elements_stmt_first (elements_find_index_read_arm a)
            (elements_find_index_read_arm b)
      | Clight.Ssequence s0 _ =>
          match s0 return (option Clight.statement) with
          | Clight.Sskip =>
              jet_elements_null_data_small.elements_stmt_first (elements_find_index_read_arm a)
