### C.jet_parse_sequence_writer.eval_parse_sequence_writer
eval_parse_sequence_writer
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (r : Integers.Int64.int)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))),
       @ex Memory.Mem.mem
         (fun mb : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_writeBit)
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                     (@cons Values.val
                        (Values.Vint
                           match jet_parse_sequence_spec.parse_sequence_enabled r return Integers.Int.int with
                           | true => Integers.Int.one
                           | false => Integers.Int.zero
                           end) (@nil Values.val))) Events.E0 mb
                  (Values.Vint
                     match jet_parse_sequence_spec.parse_sequence_enabled r return Integers.Int.int with
                     | true => Integers.Int.one
                     | false => Integers.Int.zero
                     end))
               (and (jet_parse_sequence_exec.parse_sequence_branch_calls mb mf bf (Integers.Ptrofs.repr base) r)
                  (and
                     (jet_encoding.frame_output_cells_at mf bw edge cursor
                        (@Translate.encode
                           (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
                           match
                             jet_parse_sequence_spec.parse_sequence_enabled r
                             return
                               (Ty.tySem
                                  (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))))
                           with
                           | true =>
                               @inr unit
                                 (sum (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
                                    (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16))))
                                 match
                                   jet_parse_sequence_spec.parse_sequence_tag r
                                   return
                                     (sum (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
                                        (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16))))
                                 with
                                 | true =>
                                     @inr (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
                                       (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
                                       (jet_wide_spec.decode_wide jet_wide.W16
                                          (Integers.Int64.zero_ext
                                             (BinNums.Zpos
                                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                             (jet_parse_sequence_spec.parse_sequence_payload r)))
                                 | false =>
                                     @inl (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
                                       (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
                                       (jet_wide_spec.decode_wide jet_wide.W16
                                          (Integers.Int64.zero_ext
                                             (BinNums.Zpos
                                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                             (jet_parse_sequence_spec.parse_sequence_payload r)))
                                 end
                           | false =>
                               @inl unit
                                 (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))) tt
                           end))
                     (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                        (and
                           (jet_frame_layout.frame_fields_at mf bf base bw edge
                              (BinInt.Z.sub cursor
                                 (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                           (and
                              (jet_output_layout.loads_outside_ranges m mf bf
                                 (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 (BinInt.Z.add base
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                                 (BinInt.Z.add edge
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       (BinInt.Z.div
                                          (BinInt.Z.sub cursor
                                             (BinNums.Zpos
                                                (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                 (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              (and
                                 (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                  Memory.Mem.perm mf b ofs kind p)
                                 (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                  Memory.Mem.valid_block mf b)))))))))
