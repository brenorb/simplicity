### C.jet_secp_scalar_negate_run.scalar_negate_run_eq
scalar_negate_run_eq
     : @eq (option jet_sx_exec.res) scalar_negate_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone scalar_negate_state jet_sx_exec.ONormal))
### C.jet_secp_scalar_negate_run.scalar_negate_return
scalar_negate_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_negate_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_scalar_negate_run.scalar_negate_output_shape
scalar_negate_output_shape
     : @ex (list jet_sx_expr.sx)
         (fun limbs : list jet_sx_expr.sx =>
          and (@eq nat (@length jet_sx_expr.sx limbs) (S (S (S (S O)))))
            (@eq (list jet_sx_state.region) (jet_sx_eval.sregs scalar_negate_state)
               (@cons jet_sx_state.region
                  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 limbs) true
                     (@Some BinNums.Z
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (@nil jet_sx_state.region))))
### C.jet_secp_scalar_negate_run.scalar_negate_output_owned
scalar_negate_output_owned
     : and (@eq nat (@length jet_sx_state.region (jet_sx_eval.sregs scalar_negate_state)) (S O))
         (@eq (option BinNums.Z)
            (jet_sx_state.rfree
               (@List.nth jet_sx_state.region O (jet_sx_eval.sregs scalar_negate_state)
                  (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))))
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
### C.jet_secp_scalar_negate_run.scalar_negate_run
scalar_negate_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
