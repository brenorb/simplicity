### C.jet_secp_curve_group_lambda_certificate.secp_group_lambda_coordinates
secp_group_lambda_coordinates
     : let p : jet_secp_curve_group_certificate.secp_group_projective := secp_lambda_projective in
       and
         (not
            (@eq BinNums.Z
               (GZnZ.val jet_secp_fe_math.feP
                  (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
