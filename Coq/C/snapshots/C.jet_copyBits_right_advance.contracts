### C.jet_copyBits_right_advance.copy_right_after_return_shape
copy_right_after_return_shape
     : @eq Clight.statement jet_copyBits_helper_right.copy_right_after_return
         (Clight.Ssequence
            (Clight.Sset jets._n
               (Clight.Ebinop Cop.Osub (Clight.Etempvar jets._n Ctypesdefs.tulong)
                  (Clight.Etempvar jets._dst_shift Ctypesdefs.tulong) Ctypesdefs.tulong))
            (Clight.Ssequence
               (Clight.Sset jets._src_shift
                  (Clight.Ebinop Cop.Osub (Clight.Etempvar jets._src_shift Ctypesdefs.tulong)
                     (Clight.Etempvar jets._dst_shift Ctypesdefs.tulong) Ctypesdefs.tulong))
               (Clight.Sset jets._dst_ptr
                  (Clight.Ebinop Cop.Osub (Clight.Etempvar jets._dst_ptr (Ctypesdefs.tptr Ctypesdefs.tulong))
                     (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tulong)))))
### C.jet_copyBits_right_advance.exec_copy_right_advance
exec_copy_right_advance
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bw : Values.block)
         (dst_ofs : Integers.Ptrofs.int) (ss ds n : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ds)
                (BinInt.Z.le ds
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : and (BinInt.Z.le ds ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and (BinInt.Z.lt ds n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le)
                (@Some Values.val (Values.Vptr bw dst_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr n)))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m
         jet_copyBits_helper_right.copy_right_after_return Events.E0 (copy_right_advance_env le bw dst_ofs ss ds n) m
         ClightBigstep.Out_normal
### C.jet_copyBits_right_advance.exec_copy_right_continue
exec_copy_right_continue
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bi : Values.block)
         (src_ofs : Integers.Ptrofs.int) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int)
         (ss ds n : BinNums.Z) (old source : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ds)
                (BinInt.Z.le ds
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : and (BinInt.Z.le ds ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and (BinInt.Z.lt ds n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_ptr le)
                (@Some Values.val (Values.Vptr bi src_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le)
                (@Some Values.val (Values.Vptr bw dst_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr n))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bi (Integers.Ptrofs.unsigned src_ofs))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs))
                (@Some Values.val (Values.Vlong (jet_word_bits.clear_low ds old))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (jet_copyBits_helper_right.copy_right_value ss ds old source)))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m jet_copyBits_helper_exec.copy_partial_right
         Events.E0
         (copy_right_advance_env (jet_copyBits_helper_right.copy_right_env le ss ds old source) bw dst_ofs ss ds n) mf
         ClightBigstep.Out_normal
### C.jet_copyBits_right_advance.copy_right_advance_env
copy_right_advance_env =
fun (le : Maps.PTree.tree Values.val) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int) (ss ds n : BinNums.Z) =>
@Maps.PTree.set Values.val jets._dst_ptr
  (Values.Vptr bw
     (Integers.Ptrofs.sub dst_ofs
        (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  (@Maps.PTree.set Values.val jets._src_shift (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub ss ds)))
     (@Maps.PTree.set Values.val jets._n (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub n ds))) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments copy_right_advance_env le bw dst_ofs (ss ds n)%Z_scope
