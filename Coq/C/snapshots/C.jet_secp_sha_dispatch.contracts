### C.jet_secp_sha_dispatch.secp_sha_dispatch_symbol
secp_sha_dispatch_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            jets_secp._simplicity_sha256_compression)
         (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._simplicity_sha256_compression))
### C.jet_secp_sha_dispatch.secp_sha_compression_funct
secp_sha_compression_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._sha256_compression_portable)
               Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function)
            (@Ctypes.Internal Clight.function jets_secp.f_sha256_compression_portable))
### C.jet_secp_sha_dispatch.secp_sha_fill_checked
secp_sha_fill_checked
     : @eq bool
         (jet_transport.stmt_okb jet_sha_linkage.sha_ge jet_secp_linkage.secp_ge
            (@List.map (prod AST.ident Clight.function) AST.ident (@fst AST.ident Clight.function)
               jet_secp_sha_pure_transport.secp_sha_pure_helpers)
            (@cons AST.ident jets_sha.___compound (@nil AST.ident))
            (jet_sha_compress_uchar.be_fill (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))) true
### C.jet_secp_sha_dispatch.secp_sha_fill_closed
secp_sha_fill_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_sha_pure_transport.secp_sha_pure_helpers
            (jet_sha_compress_uchar.be_fill (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))) true
### C.jet_secp_sha_dispatch.secp_sha_cu_dom
secp_sha_cu_dom
     : forall bk : Values.block,
       jet_transport.edom (jet_sha_compress_uchar.cu_env bk)
         (@cons (prod AST.ident Ctypes.type)
            (@pair AST.ident Ctypes.type jets_sha.___compound
               (Ctypesdefs.tarray Ctypesdefs.tuint
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (@nil (prod AST.ident Ctypes.type)))
### C.jet_secp_sha_dispatch.secp_sha_fill_transport
secp_sha_fill_transport
     : forall (bk : Values.block) (le : Clight.temp_env) (m : Memory.Mem.mem) (trace : Events.trace)
         (lef : Clight.temp_env) (mf : Memory.Mem.mem) (out : ClightBigstep.outcome)
         (_ : ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge (jet_sha_compress_uchar.cu_env bk) le m
                (jet_sha_compress_uchar.be_fill (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))) trace
                lef mf out),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_sha_compress_uchar.cu_env bk) le m
         (jet_sha_compress_uchar.be_fill (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))) trace lef mf
         out
### C.jet_secp_sha_dispatch.secp_sha_cu_entry
secp_sha_cu_entry
     : forall (m : Memory.Mem.mem) (m1 : Memory.Mem.mem') (bk bs : Values.block) (os : Integers.Ptrofs.int)
         (bc : Values.block) (oc : Integers.Ptrofs.int)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m1 bk)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_sha256_compression_uchar
         (@cons Values.val (Values.Vptr bs os) (@cons Values.val (Values.Vptr bc oc) (@nil Values.val))) m
         (jet_sha_compress_uchar.cu_env bk) (jet_sha_compress_uchar.cu_temps bs os bc oc) m1
### C.jet_secp_sha_dispatch.secp_sha_cu_blocks
secp_sha_cu_blocks
     : forall bk : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (jet_sha_compress_uchar.cu_env bk))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bk BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
### C.jet_secp_sha_dispatch.eval_secp_sha_compression_uchar
eval_secp_sha_compression_uchar
     : forall (m : Memory.Mem.mem) (bs : Values.block) (os : Integers.Ptrofs.int) (bc : Values.block)
         (oc : Integers.Ptrofs.int) (regs bytes : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq nat (@length Integers.Int.int bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned) (_ : secp_sha_dispatch_ok m)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
              and
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint32 m bs
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                   (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
                (Memory.Mem.valid_access m AST.Mint32 bs
                   (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                   Memtype.Writable))
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oc) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i bytes Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_sha256_compression_uchar)
               (@cons Values.val (Values.Vptr bs os) (@cons Values.val (Values.Vptr bc oc) (@nil Values.val)))
               Events.E0 mf Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 mf bs
                     (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                  (@Some Values.val
                     (Values.Vint
                        (@List.nth Integers.Int.int i (SHA256.hash_block regs (jet_sha_ctx8_model.be_words bytes))
                           Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : or (not (@eq Values.block b bs))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) (Integers.Ptrofs.unsigned os))
                               (BinInt.Z.le
                                  (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm mf b ofs k p)
                     (and (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
### C.jet_secp_sha_dispatch.secp_sha_dispatch_ok
secp_sha_dispatch_ok =
fun m : Memory.Mem.mem =>
@eq (option Values.val)
  (Memory.Mem.load AST.Mptr m (jet_secp_linkage.secp_symbol_block jets_secp._simplicity_sha256_compression) BinNums.Z0)
  (@Some Values.val
     (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._sha256_compression_portable) Integers.Ptrofs.zero))
     : forall _ : Memory.Mem.mem, Prop

Arguments secp_sha_dispatch_ok m
