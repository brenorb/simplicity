         (digits : forall _ : BinNums.Z, BinNums.Z) (P : forall (_ : Values.block) (_ : BinNums.Z), Prop)
         (_ : jet_secp_wnaf_loop.wnaf_array_state m b base len w sign bit last digits) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall (pos : BinNums.Z)
                (_ : and (BinInt.Z.le base pos)
                       (BinInt.Z.lt pos
                          (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) len)))),
              P b pos), jet_secp_wnaf_loop.wnaf_array_state mf b base len w sign bit last digits
