### C.jet_full_increment_wide_word.full_increment_word_spec_zero
full_increment_word_spec_zero
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)))
         (@jet_increment_spec.full_increment_word_spec Alg.CoreFunSem n
            (@pair (sum unit unit) (Ty.tySem (Word.Word n)) (@inl unit unit tt) x))
         (@pair (sum unit unit) (Ty.tySem (Word.Word n)) (@inl unit unit tt) x)
### C.jet_full_increment_wide_word.wide_full_increment_values_denote_input
wide_full_increment_values_denote_input
     : forall (s : jet_wide.wide_size) (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (x : Ty.tySem (Word.Word (jet_wide.wide_log s))) (r : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) x)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (jet_wide.wide_log s))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (jet_wide.wide_log s)))
            match wide_full_increment_carry s (Bit.toBool c) r return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (jet_wide_spec.decode_wide s
               (Integers.Int64.zero_ext (jet_wide.wide_bits s) (wide_full_increment_payload (Bit.toBool c) r))))
         (@jet_increment_spec.full_increment_word_spec Alg.CoreFunSem (jet_wide.wide_log s)
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (jet_wide.wide_log s))) c x))
### C.jet_full_increment_wide_word.wide_full_increment_max
wide_full_increment_max =
fun s : jet_wide.wide_size =>
match s return BinNums.Z with
| jet_wide.W16 =>
    BinNums.Zpos
      (BinNums.xI
         (BinNums.xI
            (BinNums.xI
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))
| jet_wide.W32 =>
    BinNums.Zpos
      (BinNums.xI
         (BinNums.xI
            (BinNums.xI
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))))))
| jet_wide.W64 => Integers.Int64.max_unsigned
end
     : forall _ : jet_wide.wide_size, BinNums.Z

Arguments wide_full_increment_max s
### C.jet_full_increment_wide_word.wide_full_increment_carry
wide_full_increment_carry =
fun (s : jet_wide.wide_size) (cin : bool) (r : Integers.Int64.int) =>
Integers.Int64.ltu
  (Integers.Int64.sub (Integers.Int64.repr (wide_full_increment_max s)) (jet_readBit_layout.bit_long cin)) r
     : forall (_ : jet_wide.wide_size) (_ : bool) (_ : Integers.Int64.int), bool

Arguments wide_full_increment_carry s cin%bool_scope r
### C.jet_full_increment_wide_word.wide_full_increment_payload
wide_full_increment_payload =
fun (cin : bool) (r : Integers.Int64.int) => Integers.Int64.add r (jet_readBit_layout.bit_long cin)
     : forall (_ : bool) (_ : Integers.Int64.int), Integers.Int64.int

Arguments wide_full_increment_payload cin%bool_scope r
