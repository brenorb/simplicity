### C.jet_full_shift_cells.encode_full_left_shift1
encode_full_left_shift1
     : forall (X : Ty.Ty) (n : nat) (v : Ty.tySem (Word.Vector X n)) (x : Ty.tySem X),
       @eq (list BitMachine.Cell)
         (@Translate.encode (Ty.Prod X (Word.Vector X n))
            (@Word.full_left_shift1 X n Alg.CoreFunSem (@pair (Ty.tySem (Word.Vector X n)) (Ty.tySem X) v x)))
         (@Translate.encode (Ty.Prod (Word.Vector X n) X) (@pair (Ty.tySem (Word.Vector X n)) (Ty.tySem X) v x))
### C.jet_full_shift_cells.encode_full_right_shift1
encode_full_right_shift1
     : forall (X : Ty.Ty) (n : nat) (x : Ty.tySem X) (v : Ty.tySem (Word.Vector X n)),
       @eq (list BitMachine.Cell)
         (@Translate.encode (Ty.Prod (Word.Vector X n) X)
            (@Word.full_right_shift1 X n Alg.CoreFunSem (@pair (Ty.tySem X) (Ty.tySem (Word.Vector X n)) x v)))
         (@Translate.encode (Ty.Prod X (Word.Vector X n)) (@pair (Ty.tySem X) (Ty.tySem (Word.Vector X n)) x v))
