### C.jet_bitcoin_totals_canonical.bitcoin_total_input_value_spec
bitcoin_total_input_value_spec =
fun alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra =>
@jet_bitcoin_totals_spec.total_program (Bitcoin.PrimitiveBitcoin.Primitive.CanonicalStructures.toCore alg)
  (@Bitcoin.PrimitiveBitcoin.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) alg Bitcoin.Bitcoin.InputValue)
     : forall alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra,
       Bitcoin.PrimitiveBitcoin.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))

Arguments bitcoin_total_input_value_spec {alg}
