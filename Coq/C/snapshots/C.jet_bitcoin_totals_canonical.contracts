### C.jet_bitcoin_totals_canonical.total_list_op
@total_list_op
     : forall (X : Type) (xs : list X) (f : forall _ : X, BinNums.Z) (w : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))))
         (@Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
            match
              @option_map X (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                (fun x : X => jet_bitcoin_totals_spec.fw6 (f x))
                (@List.nth_error X xs (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) w)))
              return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
            with
            | Some b => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) b
            | None =>
                @inl unit
                  (prod
                     (prod
                        (prod
                           (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                              (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                           (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                              (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                        (prod
                           (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                              (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                           (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                              (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))))
                     (prod
                        (prod
                           (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                              (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                           (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                              (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                        (prod
                           (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                              (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                           (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                              (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))))
                  tt
            end)
         (@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
            match
              @List.nth_error BinNums.Z (@List.map X BinNums.Z f xs)
                (BinInt.Z.to_nat (jet_forWhile_seq.wz (S (S (S (S (S O))))) w))
              return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
            with
            | Some v => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (jet_bitcoin_totals_spec.fw6 v)
            | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) tt
            end)
