### C.jet_secp_field_add_numeric.field_add_values_sum
field_add_values_sum
     : forall (rho : forall _ : nat, Integers.Int64.int)
         (_ : forall (n : nat) (_ : lt n (S (S (S (S (S O)))))),
              and
                (BinInt.Z.le (Integers.Int64.unsigned (rho (S n)))
                   (BinInt.Z.sub
                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                      (BinNums.Zpos BinNums.xH)))
                (BinInt.Z.le (Integers.Int64.unsigned (rho (Nat.add (S (S (S (S (S (S O)))))) n)))
                   (BinInt.Z.sub
                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                      (BinNums.Zpos BinNums.xH)))),
       @eq BinNums.Z
         (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (jet_secp_field_add_values.add_value rho O))
            (Integers.Int64.unsigned (jet_secp_field_add_values.add_value rho (S O)))
            (Integers.Int64.unsigned (jet_secp_field_add_values.add_value rho (S (S O))))
            (Integers.Int64.unsigned (jet_secp_field_add_values.add_value rho (S (S (S O)))))
            (Integers.Int64.unsigned (jet_secp_field_add_values.add_value rho (S (S (S (S O)))))))
         (BinInt.Z.add (field_input_value rho (S O)) (field_input_value rho (S (S (S (S (S (S O))))))))
### C.jet_secp_field_add_numeric.field_input_value
field_input_value =
fun (rho : forall _ : nat, Integers.Int64.int) (start : nat) =>
jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho start)) (Integers.Int64.unsigned (rho (Nat.add start (S O))))
  (Integers.Int64.unsigned (rho (Nat.add start (S (S O)))))
  (Integers.Int64.unsigned (rho (Nat.add start (S (S (S O))))))
  (Integers.Int64.unsigned (rho (Nat.add start (S (S (S (S O)))))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), BinNums.Z

Arguments field_input_value rho%function_scope start%nat_scope
