### C.jet_secp_scalar_add_separate_run.scalar_add_separate_run_eq
scalar_add_separate_run_eq
     : @eq (option jet_sx_exec.res) scalar_add_separate_run (@Some jet_sx_exec.res scalar_add_separate_result)
### C.jet_secp_scalar_add_separate_run.scalar_add_separate_output
scalar_add_separate_output
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs scalar_add_separate_state)
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 jet_secp_scalar_add_exec.scalar_add_limbs) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            jet_secp_scalar_add_run.scalar_add_initial_regs)
### C.jet_secp_scalar_add_separate_run.scalar_add_separate_return
scalar_add_separate_return
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_add_separate_state))
         (@Some jet_sx_expr.sx jet_secp_scalar_add_run.scalar_add_return_sx)
### C.jet_secp_scalar_add_separate_run.scalar_add_separate_selected
scalar_add_separate_selected
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (prod jet_sx_eval.sstate jet_sx_exec.xout) (jet_sx_exec.rsel rho beta scalar_add_separate_result)
         (@pair jet_sx_eval.sstate jet_sx_exec.xout scalar_add_separate_state jet_sx_exec.ONormal)
### C.jet_secp_scalar_add_separate_run.eval_scalar_add_separate_regions
eval_scalar_add_separate_regions
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta scalar_add_separate_initial m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                           (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O))))) (@nil Values.val)))) Events.E0 mf
               (Values.Vint
                  (jet_sx_expr.ii
                     (jet_sx_expr.den rho (jet_sx_state.lay beta) jet_secp_scalar_add_run.scalar_add_return_sx))))
            (and (jet_sx_state.rep rho beta (jet_sx_eval.sregs scalar_add_separate_state) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (jet_sx_state.foot beta
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape scalar_add_separate_initial) b ofs)) m mf)))
### C.jet_secp_scalar_add_separate_run.scalar_add_separate_cells
scalar_add_separate_cells =
@List.map jet_sx_state.cell jet_sx_state.cell
  (fun c : jet_sx_state.cell =>
   jet_sx_state.mkcell (jet_sx_state.cofs c) (jet_sx_state.cchunk c) (@None jet_sx_expr.sx))
  (jet_sx_rep.u64_cells BinNums.Z0
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx))))))
     : list jet_sx_state.cell
### C.jet_secp_scalar_add_separate_run.scalar_add_separate_initial
scalar_add_separate_initial =
@cons jet_sx_state.region
  (jet_sx_state.mkreg scalar_add_separate_cells true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
  jet_secp_scalar_add_run.scalar_add_initial_regs
     : list jet_sx_state.region
### C.jet_secp_scalar_add_separate_run.scalar_add_separate_run
scalar_add_separate_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_shift64_executor.secp_shift64_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_scalar_add
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
     (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0)
        (@cons jet_sx_expr.sx (jet_sx_expr.XP (S (S O)) BinNums.Z0) (@nil jet_sx_expr.sx))))
  scalar_add_separate_initial (@nil jet_sx_eval.event) (S (S (S (S (S (S (S (S O))))))))
     : option jet_sx_exec.res
