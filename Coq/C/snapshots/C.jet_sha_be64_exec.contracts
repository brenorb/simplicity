### C.jet_sha_be64_exec.wbe_assign
wbe_assign
     : forall (bp : Values.block) (op : Integers.Ptrofs.int) (x : Integers.Int64.int) (m m' : Memory.Mem.mem)
         (i : BinNums.Z) (rhs : Clight.expr) (v : Values.val) (w : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.le i (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned op)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Integers.Ptrofs.max_unsigned)
         (_ : Clight.eval_expr jet_sha_linkage.sha_ge Clight.empty_env (wbe_le bp op x) m rhs v)
         (_ : @eq (option Values.val) (Cop.sem_cast v (Clight.typeof rhs) Ctypesdefs.tuchar m)
                (@Some Values.val (Values.Vint w)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint8unsigned m bp (BinInt.Z.add (Integers.Ptrofs.unsigned op) i) (Values.Vint w))
                (@Some Memory.Mem.mem m')),
       ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge Clight.empty_env (wbe_le bp op x) m
         (Clight.Sassign (wbe_lhs i) rhs) Events.E0 (wbe_le bp op x) m' ClightBigstep.Out_normal
### C.jet_sha_be64_exec.zero_ext8_idem
zero_ext8_idem
     : forall x : Integers.Int.int,
       @eq Integers.Int.int
         (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
            (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) x))
         (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) x)
### C.jet_sha_be64_exec.eval_sha_WriteBE64
eval_sha_WriteBE64
     : forall (m : Memory.Mem.mem) (bp : Values.block) (op : Integers.Ptrofs.int) (x : Integers.Int64.int)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned op)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bp (Integers.Ptrofs.unsigned op)
                (BinInt.Z.add (Integers.Ptrofs.unsigned op)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_sha.f_WriteBE64)
               (@cons Values.val (Values.Vptr bp op) (@cons Values.val (Values.Vlong x) (@nil Values.val))) Events.E0
               m' Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint8unsigned m' bp
                     (BinInt.Z.add (Integers.Ptrofs.unsigned op) (BinInt.Z.of_nat i)))
                  (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i (c_be64_bytes x) Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : or (not (@eq Values.block b bp))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) (Integers.Ptrofs.unsigned op))
                               (BinInt.Z.le
                                  (BinInt.Z.add (Integers.Ptrofs.unsigned op)
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
