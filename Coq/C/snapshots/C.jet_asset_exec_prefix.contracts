### C.jet_asset_exec_prefix.tagged_prefix
tagged_prefix =
fun (itag iparity : AST.ident) (z0 z1 : BinNums.Z) =>
Clight.Ssequence (jet_nonce_context_shape.nc_readbit itag)
  (Clight.Sifthenelse (Clight.Etempvar itag Ctypesdefs.tbool)
     (Clight.Ssequence jet_nonce_context_shape.nc_forward (jet_nonce_context_shape.nc_uchar (BinNums.Zpos BinNums.xH)))
     (Clight.Ssequence (jet_nonce_context_shape.nc_readbit iparity)
        (Clight.Sifthenelse (Clight.Etempvar iparity Ctypesdefs.tbool) (jet_nonce_context_shape.nc_uchar z1)
           (jet_nonce_context_shape.nc_uchar z0))))
     : forall (_ : AST.ident) (_ : AST.ident) (_ : BinNums.Z) (_ : BinNums.Z), Clight.statement

Arguments tagged_prefix itag iparity (z0 z1)%Z_scope
