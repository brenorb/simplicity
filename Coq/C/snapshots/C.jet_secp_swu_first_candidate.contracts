### C.jet_secp_swu_first_candidate.swu_first_source
swu_first_source
     : @eq Clight.statement jet_secp_swu_joint_inverse.swu_after_joint_inverse
         (jet_secp_statement_prefix.statement_sequence swu_first_statements swu_after_first_candidate)
### C.jet_secp_swu_first_candidate.exec_swu_first_multiply_call
exec_swu_first_multiply_call
     : forall (inv : bool) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (ba br : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   match inv return BinNums.positive with
                   | true => jets_secp._jinv
                   | false => jets_secp._x3d
                   end e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (swu_first_multiply inv) Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_first_candidate.exec_swu_first_add_call
exec_swu_first_add_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (ba : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._d e)
                (@None (prod Values.block Ctypes.type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr (jet_secp_swu_startup.swu_constant_block true) Integers.Ptrofs.zero)
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_first_add_d Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_first_candidate.exec_swu_first_candidate
exec_swu_first_candidate
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (ba bx bj : Values.block) (a xd inv : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._d e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._jinv e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bj jet_secp_curve_statements.curve_fe_type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block ba (@cons Values.block bx (@cons Values.block bj (@nil Values.block)))))
         (_ : jet_secp_swu_startup.swu_startup m) (_ : jet_secp_square_columns.square_input_bounds a)
         (_ : jet_secp_square_columns.square_input_bounds xd) (_ : jet_secp_square_columns.square_input_bounds inv)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : jet_secp_fe_nv.fe_at m bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 xd))
         (_ : jet_secp_fe_nv.fe_at m bj BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bj BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_first_prefix Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf ba BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (swu_first_words a xd inv)))
               (and (jet_secp_fe_nv.fe_at mf bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 xd))
                  (and (jet_secp_fe_nv.fe_at mf bj BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                     (and
                        (Memory.Mem.range_perm mf ba BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bx BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bj BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_secp_field_sum_bounds.field_scaled_bounds (BinNums.Zpos (BinNums.xO BinNums.xH))
                                    (swu_first_words a xd inv))
                                 (and (jet_secp_square_columns.square_input_bounds (swu_first_words a xd inv))
                                    (and
                                       (Zdiv.eqm jet_secp_fe_math.feP
                                          (jet_secp_multiply_finish_product.radix_value (swu_first_words a xd inv))
                                          (BinInt.Z.add
                                             (BinInt.Z.mul
                                                (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                                                   (jet_secp_multiply_finish_product.radix_value xd))
                                                (jet_secp_multiply_finish_product.radix_value inv))
                                             jet_secp_swu_candidates.swu_d_constant))
                                       (and (jet_secp_swu_startup.swu_startup mf)
                                          (and
                                             (jet_sx_mem.lframe
                                                (fun (b : Values.block) (_ : BinNums.Z) =>
                                                 and (not (@eq Values.block b ba))
                                                   (and (not (@eq Values.block b bx)) (not (@eq Values.block b bj)))) m
                                                mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))))))))
### C.jet_secp_swu_first_candidate.swu_setup_x3d_square
swu_setup_x3d_square
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds w),
       and
         (jet_secp_square_columns.square_input_bounds
            (jet_secp_swu_joint_setup.swu_setup_x3d (jet_secp_square_numeric.square_words w)))
         (Zdiv.eqm jet_secp_fe_math.feP
            (jet_secp_multiply_finish_product.radix_value
               (jet_secp_swu_joint_setup.swu_setup_x3d (jet_secp_square_numeric.square_words w)))
            (BinInt.Z.mul
               (BinInt.Z.mul (BinNums.Zneg (BinNums.xI BinNums.xH)) (jet_secp_multiply_finish_product.radix_value w))
               (jet_secp_multiply_finish_product.radix_value w)))
### C.jet_secp_swu_first_candidate.swu_first_spec_match
swu_first_spec_match
     : forall (t : BinNums.Z) (a xd inv : forall _ : nat, Integers.Int64.int) (value : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_multiply_finish_product.radix_value a)
                (BinInt.Z.mul (BinInt.Z.mul jet_secp_swu_candidates.swu_negc_constant t) t))
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_multiply_finish_product.radix_value xd)
                (BinInt.Z.mul (BinInt.Z.mul (BinNums.Zneg (BinNums.xI BinNums.xH)) t) t))
         (_ : @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value inv)
                (jet_secp_swu_candidates.swu_joint_inverse t))
         (_ : Zdiv.eqm jet_secp_fe_math.feP value
                (BinInt.Z.add
                   (BinInt.Z.mul
                      (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                         (jet_secp_multiply_finish_product.radix_value xd))
                      (jet_secp_multiply_finish_product.radix_value inv)) jet_secp_swu_candidates.swu_d_constant)),
       Zdiv.eqm jet_secp_fe_math.feP value (jet_secp_swu_candidates.swu_c_candidate1 t)
### C.jet_secp_swu_first_candidate.swu_through_first_source
swu_through_first_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_shallue_van_de_woestijne)
         (jet_secp_statement_prefix.statement_sequence swu_through_first_statements swu_after_first_candidate)
### C.jet_secp_swu_first_candidate.exec_swu_through_first
exec_swu_through_first
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bt bw ba bx bj : Values.block)
         (w : forall _ : nat, Integers.Int64.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_clight_internal_frame.plain_env e)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._negc e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_inv_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._d e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._wd e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bw jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._jinv e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bj jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t le)
                (@Some Values.val (Values.Vptr bt Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bt
                   (@cons Values.block bw
                      (@cons Values.block ba (@cons Values.block bx (@cons Values.block bj (@nil Values.block)))))))
         (_ : jet_secp_swu_startup.swu_startup m) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : @List.Forall Values.block
                (fun b : Values.block =>
                 Memory.Mem.range_perm m b BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   Memtype.Cur Memtype.Freeable)
                (@cons Values.block bt
                   (@cons Values.block bw
                      (@cons Values.block ba (@cons Values.block bx (@cons Values.block bj (@nil Values.block))))))),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun inv : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_through_first Events.E0 le mf
                  ClightBigstep.Out_normal)
               (and (jet_secp_fe_nv.fe_at mf bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and
                     (jet_secp_fe_nv.fe_at mf bw BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_swu_joint_setup.swu_setup_wd (jet_secp_square_numeric.square_words w))))
                     (and
                        (jet_secp_fe_nv.fe_at mf ba BinNums.Z0
                           (jet_secp_multiply_normalize_bridge.words5
                              (swu_first_words (jet_secp_swu_initial.swu_initial_a w)
                                 (jet_secp_swu_joint_setup.swu_setup_x3d (jet_secp_square_numeric.square_words w)) inv)))
                        (and
                           (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                              (jet_secp_multiply_normalize_bridge.words5
                                 (jet_secp_swu_joint_setup.swu_setup_x3d (jet_secp_square_numeric.square_words w))))
                           (and (jet_secp_fe_nv.fe_at mf bj BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                              (and
                                 (@List.Forall Values.block
                                    (fun b : Values.block =>
                                     Memory.Mem.range_perm mf b BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (@cons Values.block bt
                                       (@cons Values.block bw
                                          (@cons Values.block ba
                                             (@cons Values.block bx (@cons Values.block bj (@nil Values.block)))))))
                                 (and (jet_secp_square_columns.square_input_bounds inv)
                                    (and
                                       (jet_secp_field_sum_bounds.field_scaled_bounds
                                          (BinNums.Zpos (BinNums.xO BinNums.xH))
                                          (swu_first_words (jet_secp_swu_initial.swu_initial_a w)
                                             (jet_secp_swu_joint_setup.swu_setup_x3d
                                                (jet_secp_square_numeric.square_words w)) inv))
                                       (and
                                          (jet_secp_square_columns.square_input_bounds
                                             (swu_first_words (jet_secp_swu_initial.swu_initial_a w)
                                                (jet_secp_swu_joint_setup.swu_setup_x3d
                                                   (jet_secp_square_numeric.square_words w)) inv))
                                          (and
                                             (Zdiv.eqm jet_secp_fe_math.feP
                                                (jet_secp_multiply_finish_product.radix_value
                                                   (swu_first_words (jet_secp_swu_initial.swu_initial_a w)
                                                      (jet_secp_swu_joint_setup.swu_setup_x3d
                                                         (jet_secp_square_numeric.square_words w)) inv))
                                                (jet_secp_swu_candidates.swu_c_candidate1
                                                   (jet_secp_multiply_finish_product.radix_value w)))
                                             (and
                                                (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value inv)
                                                   (jet_secp_swu_candidates.swu_joint_inverse
                                                      (jet_secp_multiply_finish_product.radix_value w)))
                                                (and (jet_secp_swu_startup.swu_startup mf)
                                                   (and
                                                      (jet_sx_mem.lframe
                                                         (fun (b : Values.block) (_ : BinNums.Z) =>
                                                          not
                                                            (@List.In Values.block b
                                                               (@cons Values.block bt
                                                                  (@cons Values.block bw (@cons Values.block ba ...)))))
                                                         m mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))))))))))))
### C.jet_secp_swu_first_candidate.swu_first_multiply
swu_first_multiply =
fun inv : bool =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x1)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x1)
        (@cons Clight.expr
           (jet_secp_curve_statements.curve_local_address
              match inv return AST.ident with
              | true => jets_secp._jinv
              | false => jets_secp._x3d
              end) (@nil Clight.expr))))
     : forall _ : bool, Clight.statement

Arguments swu_first_multiply inv%bool_scope
### C.jet_secp_swu_first_candidate.swu_first_add_d
swu_first_add_d =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_add jets_secp.f_secp256k1_fe_add
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x1)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._d) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_swu_first_candidate.swu_first_statements
swu_first_statements =
@cons Clight.statement (swu_first_multiply false)
  (@cons Clight.statement (swu_first_multiply true) (@cons Clight.statement swu_first_add_d (@nil Clight.statement)))
     : list Clight.statement
### C.jet_secp_swu_first_candidate.swu_first_prefix
swu_first_prefix =
jet_secp_statement_prefix.statement_sequence swu_first_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_swu_first_candidate.swu_after_first_candidate
swu_after_first_candidate =
match jet_secp_swu_joint_inverse.swu_after_joint_inverse return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ rest => rest
