### C.jet_divmod128_initial.divmod128_local_permissions_preserved
divmod128_local_permissions_preserved
     : forall (m mf : Memory.Mem.mem) (bl bqh bql br : Values.block)
         (_ : forall (bb : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m bb ofs kind p), Memory.Mem.perm mf bb ofs kind p)
         (_ : jet_divmod128_allocate.divmod128_local_permissions m bl bqh bql br),
       jet_divmod128_allocate.divmod128_local_permissions mf bl bqh bql br
### C.jet_divmod128_initial.eval_divmod128_initial
eval_divmod128_initial
     : forall (m : Memory.Mem.mem) (bs : Values.block) (sbase : BinNums.Z) (bi : Values.block)
         (edge rc : BinNums.Z) (xh : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (xm xl : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (y : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
         (_ : @jet_input_layout.frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge rc xh)
         (_ : @jet_input_layout.frame_input_word_at (S (S (S (S (S O))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) xm)
         (_ : @jet_input_layout.frame_input_word_at (S (S (S (S (S O))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))) xl)
         (_ : @jet_input_layout.frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) y),
       @ex Memory.Mem.mem'
         (fun ma : Memory.Mem.mem' =>
          @ex Memory.Mem.mem'
            (fun mb : Memory.Mem.mem' =>
             @ex Memory.Mem.mem'
               (fun mc : Memory.Mem.mem' =>
                @ex Memory.Mem.mem'
                  (fun md : Memory.Mem.mem' =>
                   @ex Memory.Mem.mem
                     (fun mcopy : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun mr1 : Memory.Mem.mem =>
                         @ex Memory.Mem.mem
                           (fun mr2 : Memory.Mem.mem =>
                            @ex Memory.Mem.mem
                              (fun mr3 : Memory.Mem.mem =>
                               @ex Memory.Mem.mem
                                 (fun mr4 : Memory.Mem.mem =>
                                  @ex Values.block
                                    (fun bl : Values.block =>
                                     @ex Values.block
                                       (fun bqh : Values.block =>
                                        @ex Values.block
                                          (fun bql : Values.block =>
                                           @ex Values.block
                                             (fun br : Values.block =>
                                              @ex (list Memdata.memval)
                                                (fun bytes : list Memdata.memval =>
                                                 @ex Integers.Int64.int (fun ... => @ex Integers.Int64.int ...)))))))))))))))
