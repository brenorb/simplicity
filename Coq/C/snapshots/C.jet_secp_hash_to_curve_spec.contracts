### C.jet_secp_hash_to_curve_spec.literal_hash_to_curve_parametric
literal_hash_to_curve_parametric
     : @Alg.Assertion.Parametric (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@literal_hash_to_curve)
### C.jet_secp_hash_to_curve_spec.literal_hash_to_curve_option
literal_hash_to_curve_option
     : forall key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@literal_hash_to_curve (Alg.AssertionSem Option.option_Monad_Zero) key)
         match
           @jet_secp_hash_public_literal.literal_hash_to_curve_core Alg.CoreFunSem key
           return
             (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                (Ty.tySem
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | inl _ =>
             @None
               (Ty.tySem
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         | inr p =>
             @Some
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) p
         end
### C.jet_secp_hash_to_curve_spec.hash_public_assertion_result
hash_public_assertion_result
     : forall (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (sx sy sz : forall _ : nat, Integers.Int64.int) (flag : Integers.Int.int)
         (ox oy : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_hash_public_call.hash_public_value key sx sy sz flag ox oy),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@literal_hash_to_curve (Alg.AssertionSem Option.option_Monad_Zero) key)
         match
           andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
             (jet_secp_generator_hash_map.generator_hash_accepted true key)
           return
             (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                (Ty.tySem
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | true =>
             match
               Integers.Int.eq flag Integers.Int.zero
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                    (Ty.tySem
                       (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                          (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
             with
             | true =>
                 @Some
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (jet_secp_rescale_literal.rescale_field_output ox)
                      (jet_secp_rescale_literal.rescale_field_output oy))
             | false =>
                 @None
                   (Ty.tySem
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
             end
         | false =>
             @None
               (Ty.tySem
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         end
### C.jet_secp_hash_to_curve_spec.literal_hash_to_curve
literal_hash_to_curve =
fun term : Alg.Assertion.Algebra =>
@AC.comp (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (Ty.Prod
     (Ty.Sum Ty.Unit
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit)
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Alg.Assertion.toCore term)
  (@AC.pair (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Sum Ty.Unit
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
     (Alg.Assertion.toCore term) (@jet_secp_hash_public_literal.literal_hash_to_curve_core (Alg.Assertion.toCore term))
     (@AC.unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Alg.Assertion.toCore term)))
  (@Alg.Assertion.Combinators.assertr Ty.Unit
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) Ty.Unit
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
     jet_assertion_spec.assertion_cmr_fail0
     (@AC.take (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Alg.Assertion.toCore term)
        (@AC.iden (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Alg.Assertion.toCore term))))
     : forall term : Alg.Assertion.Algebra,
       Alg.Assertion.domain term (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments literal_hash_to_curve {term}
