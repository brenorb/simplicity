### C.jet_secp_div62_exit.div62_matrix_field_bound
div62_matrix_field_bound
     : forall (start : divstep.State) (j : nat) (_ : lt j (S (S (S (S O))))),
       and
         (BinInt.Z.le
            (BinInt.Z.opp
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
            (div62_matrix_field
               (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))
                  start) j))
         (BinInt.Z.le
            (div62_matrix_field
               (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))
                  start) j)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
### C.jet_secp_div62_exit.div62_matrix_field_signed
div62_matrix_field_signed
     : forall (start : divstep.State) (j : nat) (_ : lt j (S (S (S (S O))))),
       @eq BinNums.Z
         (Integers.Int64.signed
            (Integers.Int64.repr
               (div62_matrix_field
                  (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))
                     start) j)))
         (div62_matrix_field
            (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))
               start) j)
### C.jet_secp_div62_exit.div62_exit_words_field
div62_exit_words_field
     : forall (start : divstep.State) (j : nat) (_ : lt j (S (S (S (S O))))),
       @eq Integers.Int64.int (div62_exit_words start j)
         (Integers.Int64.repr
            (div62_matrix_field
               (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))
                  start) j))
### C.jet_secp_div62_exit.exec_div62_exit
exec_div62_exit
     : forall (le : Clight.temp_env) (m : Memory.Mem.mem) (start : divstep.State) (precision : BinNums.Z)
         (b : Values.block)
         (_ : and
                (BinInt.Z.le
                   (BinNums.Zneg
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                   (divstep.eta start))
                (BinInt.Z.lt (divstep.eta start)
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : jet_secp_div62_invariant.div62_loop_invariant start precision
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))) BinNums.Z0 b
                le)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m
                  jet_secp_div62_finish.div62_finish Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (divstep.eta
                                    (@fst divstep.State (list divstep.Step)
                                       (divstep.stepN (S (S (S (S (S (S (S (S (S (S (...))))))))))) start)))))
                           Ctypesdefs.tlong))))
               (and
                  (forall (j : nat) (_ : lt j (S (S (S (S O))))),
                   @ex Integers.Int64.int
                     (fun w : Integers.Int64.int =>
                      and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint64 mf b
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.of_nat j))) (@Some Values.val (Values.Vlong w)))
                        (@eq BinNums.Z (Integers.Int64.signed w)
                           (div62_matrix_field
                              (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))) start) j))))
                  (and
                     (@eq BinNums.Z
                        (Integers.Int64.signed
                           (Integers.Int64.repr
                              (divstep.eta
                                 (@fst divstep.State (list divstep.Step)
                                    (divstep.stepN (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))) start)))))
                        (divstep.eta
                           (@fst divstep.State (list divstep.Step)
                              (divstep.stepN (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))) start))))
                     (and
                        (Memory.Mem.range_perm mf b BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m
                           mf))))))
### C.jet_secp_div62_exit.div62_matrix_field
div62_matrix_field =
fun (matrix : divstep.Trans.M2x2) (j : nat) =>
@List.nth BinNums.Z j
  (@cons BinNums.Z (divstep.Trans.u matrix)
     (@cons BinNums.Z (divstep.Trans.v matrix)
        (@cons BinNums.Z (divstep.Trans.q matrix) (@cons BinNums.Z (divstep.Trans.r matrix) (@nil BinNums.Z)))))
  BinNums.Z0
     : forall (_ : divstep.Trans.M2x2) (_ : nat), BinNums.Z

Arguments div62_matrix_field matrix j%nat_scope
### C.jet_secp_div62_exit.div62_exit_words
div62_exit_words =
fun (start : divstep.State) (j : nat) =>
@List.nth Integers.Int64.int j
  (@cons Integers.Int64.int
     (Integers.Int64.repr
        (divstep.Trans.u
           (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))) start)))
     (@cons Integers.Int64.int
        (Integers.Int64.repr
           (divstep.Trans.v
              (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))) start)))
        (@cons Integers.Int64.int
           (Integers.Int64.repr
              (divstep.Trans.q
                 (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))) start)))
           (@cons Integers.Int64.int
              (Integers.Int64.repr
                 (divstep.Trans.r
                    (divstep.Trans.transN (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))) start)))
              (@cons Integers.Int64.int
                 (Integers.Int64.repr
                    (divstep.eta
                       (@fst divstep.State (list divstep.Step)
                          (divstep.stepN (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))) start))))
                 (@nil Integers.Int64.int)))))) Integers.Int64.zero
     : forall (_ : divstep.State) (_ : nat), Integers.Int64.int

Arguments div62_exit_words start j%nat_scope
