                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O))
                        (Integers.Ptrofs.repr
                           (BinInt.Z.add (jet_sx_state.bas beta (S O)) (jet_secp_curve_square.curve_square_offset y))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                           (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O))))) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and (jet_sx_state.rep rho beta (affine_gej_product_out y size) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot beta
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape (affine_gej_product_regs y size)) b pos)) m mf)))
