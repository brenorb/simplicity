### C.jet_secp_xonly_parse_start.xonly_parse_start_source
xonly_parse_start_source
     : @eq Clight.statement
         (jet_secp_statement_prefix.statement_sequence xonly_parse_start_statements
            (jet_secp_root_chain_owned.root_drop_statements (S (S (S O)))
               (Clight.fn_body jets_secp.f_secp256k1_xonly_pubkey_parse)))
         (Clight.fn_body jets_secp.f_secp256k1_xonly_pubkey_parse)
### C.jet_secp_xonly_parse_start.xonly_keeps_weak_pointer
xonly_keeps_weak_pointer
     : forall (m mf : Memory.Mem.mem) (b : Values.block) (o : BinNums.Z)
         (_ : jet_clight_internal_permissions.keeps_permissions m mf)
         (_ : @eq bool (Memory.Mem.weak_valid_pointer m b o) true),
       @eq bool (Memory.Mem.weak_valid_pointer mf b o) true
### C.jet_secp_xonly_parse_start.exec_xonly_parse_clear
exec_xonly_parse_clear
     : forall (_ : jet_memset_model.memset_model) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bout : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._memset e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pubkey le)
                (@Some Values.val (Values.Vptr bout Integers.Ptrofs.zero)))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mz : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m xonly_parse_clear Events.E0 le mz
               ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mz bout BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and (jet_clight_internal_permissions.keeps_permissions m mz)
                  (and
                     (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m mz)
                     (jet_clight_internal_preserve.readonly_preserved m mz)))))
### C.jet_secp_xonly_parse_start.exec_xonly_parse_start
exec_xonly_parse_start
     : forall (_ : jet_memset_model.memset_model) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bout bin : Values.block) (o : Integers.Ptrofs.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._memset e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pubkey le)
                (@Some Values.val (Values.Vptr bout Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._input32 le)
                (@Some Values.val (Values.Vptr bin o)))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : @eq bool (Memory.Mem.weak_valid_pointer m bin (Integers.Ptrofs.unsigned o)) true),
       @ex Memory.Mem.mem
         (fun mz : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence xonly_parse_start_statements Clight.Sskip) Events.E0 le mz
               ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mz bout BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and (jet_clight_internal_permissions.keeps_permissions m mz)
                  (and
                     (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m mz)
                     (jet_clight_internal_preserve.readonly_preserved m mz)))))
