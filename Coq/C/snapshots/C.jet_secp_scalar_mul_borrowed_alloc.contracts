### C.jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs_valid
scalar_mul_borrowed_inputs_valid
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta scalar_mul_borrowed_inputs m) (b : Values.block)
         (_ : @List.In Values.block b
                (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) beta)),
       Memory.Mem.valid_block m b
### C.jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_stack_rotate
scalar_mul_borrowed_stack_rotate
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : list (prod Values.block BinNums.Z))
         (m : Memory.Mem.mem) (bl : Values.block)
         (_ : jet_sx_state.rep rho
                (@app (prod Values.block BinNums.Z) beta
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@app jet_sx_state.region scalar_mul_borrowed_inputs
                   (@cons jet_sx_state.region
                      (jet_sx_state.mkreg jet_secp_scalar_mul_caller_alloc.scalar_mul_stack_cells true
                         (@Some BinNums.Z
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                      (@nil jet_sx_state.region))) m)
         (_ : @eq nat (@length (prod Values.block BinNums.Z) beta) (S (S O))),
       jet_sx_state.rep rho (jet_secp_scalar_mul_caller_alloc.scalar_mul_stack_layout beta bl)
         jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_regs m
### C.jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_allocates
scalar_mul_borrowed_allocates
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (ma : Memory.Mem.mem') (bl : Values.block) (_ : jet_sx_state.rep rho beta scalar_mul_borrowed_inputs m)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block ma bl)),
       jet_sx_state.rep rho (jet_secp_scalar_mul_caller_alloc.scalar_mul_stack_layout beta bl)
         jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_regs ma
### C.jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs
scalar_mul_borrowed_inputs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells BinNums.Z0
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx)))))) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (jet_sx_rep.u64_cells BinNums.Z0
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O)))))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S O))))))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S O)))))))) (@nil jet_sx_expr.sx))))))
        false (@None BinNums.Z)) (@nil jet_sx_state.region))
     : list jet_sx_state.region
