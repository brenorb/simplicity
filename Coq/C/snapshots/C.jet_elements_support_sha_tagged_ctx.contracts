### C.jet_elements_support_sha_tagged_ctx.be_words_be_bytes_app
be_words_be_bytes_app
     : forall a b : list Integers.Int.int,
       @eq (list Integers.Int.int)
         (jet_sha_ctx8_model.be_words
            (@app Integers.Int.int (jet_elements_support_sha_be32_write.be_bytes a)
               (jet_elements_support_sha_be32_write.be_bytes b))) (@app Integers.Int.int a b)
### C.jet_elements_support_sha_tagged_ctx.tag_regs_of_length
tag_regs_of_length
     : forall (tb : list Integers.Int.int)
         (_ : lt (@length Integers.Int.int tb)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq nat (@length Integers.Int.int (tag_regs_of tb)) (S (S (S (S (S (S (S (S O))))))))
### C.jet_elements_support_sha_tagged_ctx.tagged_ctx_mem
tagged_ctx_mem
     : forall (_ : jet_memcpy_model.memcpy_model) (m : Memory.Mem.mem) (bR2 bC bT bR1 bC1 bRes TAG : Values.block)
         (tb : list Integers.Int.int)
         (_ : @List.NoDup Values.block
                (@cons Values.block bR2
                   (@cons Values.block bC
                      (@cons Values.block bT
                         (@cons Values.block bR1 (@cons Values.block bC1 (@cons Values.block bRes (@nil Values.block))))))))
         (_ : Memory.Mem.valid_block m
                (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression))
         (_ : Memory.Mem.valid_block m
                (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter))
         (_ : Memory.Mem.valid_block m TAG)
         (_ : not
                (@List.In Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)
                   (@cons Values.block bR2
                      (@cons Values.block bC
                         (@cons Values.block bT
                            (@cons Values.block bR1
                               (@cons Values.block bC1 (@cons Values.block bRes (@nil Values.block)))))))))
         (_ : not
                (@List.In Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   (@cons Values.block bR2
                      (@cons Values.block bC
                         (@cons Values.block bT
                            (@cons Values.block bR1
                               (@cons Values.block bC1 (@cons Values.block bRes (@nil Values.block)))))))))
         (_ : not
                (@List.In Values.block TAG
                   (@cons Values.block bR2
                      (@cons Values.block bC
                         (@cons Values.block bT
                            (@cons Values.block bR1
                               (@cons Values.block bC1 (@cons Values.block bRes (@nil Values.block)))))))))
         (_ : Memory.Mem.valid_block m bT)
         (_ : Memory.Mem.range_perm m bR2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bC BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bT BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bR1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bC1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bRes BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_elements_support_sha_block_local.sha_dispatch_ok m)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter) BinNums.Z0)
                (@Some Values.val (Values.Vlong jet_elements_support_sha_uchars_exec.sha_max_counter)))
         (_ : lt (@length Integers.Int.int tb)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int tb)),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m TAG (BinInt.Z.of_nat i))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i tb Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun mi1 : Memory.Mem.mem =>
          @ex (list Memdata.memval)
            (fun bytes1 : list Memdata.memval =>
             @ex Memory.Mem.mem
               (fun m1 : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun m2 : Memory.Mem.mem =>
                   @ex Memory.Mem.mem
                     (fun m3 : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun mi2 : Memory.Mem.mem =>
                         @ex (list Memdata.memval)
                           (fun bytes2 : list Memdata.memval =>
                            @ex Memory.Mem.mem
                              (fun m4 : Memory.Mem.mem =>
                               @ex Memory.Mem.mem
                                 (fun m5 : Memory.Mem.mem =>
                                  @ex Memory.Mem.mem
                                    (fun m6 : Memory.Mem.mem =>
                                     and
                                       (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
                                          (@Ctypes.Internal Clight.function jets.f_sha256_init)
                                          (@cons Values.val (Values.Vptr bR2 Integers.Ptrofs.zero)
                                             (@cons Values.val (Values.Vptr bT (Integers.Ptrofs.repr BinNums.Z0))
                                                (@nil Values.val))) Events.E0 mi1 Values.Vundef)
                                       (and
                                          (@eq (option (list Memdata.memval))
                                             (Memory.Mem.loadbytes mi1 bR2 BinNums.Z0
                                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...))))))
                                             (@Some (list Memdata.memval) bytes1))
                                          (and
                                             (@eq (option Memory.Mem.mem)
                                                (Memory.Mem.storebytes mi1 bC BinNums.Z0 bytes1)
                                                (@Some Memory.Mem.mem m1))
                                             (and
                                                (ClightBigstep.Clight2.eval_funcall
                                                   jet_elements_support_sha_linkage.sha_ge m1
                                                   (@Ctypes.Internal Clight.function jets_elements.f_sha256_uchars)
                                                   (@cons Values.val (Values.Vptr bC (Integers.Ptrofs.repr BinNums.Z0))
                                                      (@cons Values.val (Values.Vptr TAG Integers.Ptrofs.zero)
                                                         (@cons Values.val (...) (...)))) Events.E0 m2
                                                   (Values.Vint (jet_readBit_layout.bit_int (negb (...)))))
                                                (and
                                                   (ClightBigstep.Clight2.eval_funcall
                                                      jet_elements_support_sha_linkage.sha_ge m2
                                                      (@Ctypes.Internal Clight.function jets_elements.f_sha256_finalize)
                                                      (@cons Values.val (Values.Vptr bC (...)) (@nil Values.val))
                                                      Events.E0 m3 (Values.Vint (jet_readBit_layout.bit_int (...))))
                                                   (and
                                                      (ClightBigstep.Clight2.eval_funcall
                                                         jet_elements_support_sha_linkage.sha_ge m3
                                                         (@Ctypes.Internal Clight.function jets.f_sha256_init)
                                                         (@cons Values.val (...) (...)) Events.E0 mi2 Values.Vundef)
                                                      (and (@eq (...) (...) (...)) (and (...) (...))))))))))))))))))
### C.jet_elements_support_sha_tagged_ctx.tag_regs_of
tag_regs_of =
fun tb : list Integers.Int.int =>
@snd (list Integers.Int.int) (list Integers.Int.int)
  (jet_elements_support_sha_uchars_prep.absorb_i tb jet_sha256_iv_init.sha256_iv_words
     (jet_elements_support_sha_finalize_exec.sha_pad
        (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int tb)))))
     : forall _ : list Integers.Int.int, list Integers.Int.int

Arguments tag_regs_of tb%list_scope
### C.jet_elements_support_sha_tagged_ctx.tagged_prefix
tagged_prefix =
fun tb : list Integers.Int.int =>
SHA256.hash_block jet_sha256_iv_init.sha256_iv_words (@app Integers.Int.int (tag_regs_of tb) (tag_regs_of tb))
     : forall _ : list Integers.Int.int, list Integers.Int.int

Arguments tagged_prefix tb%list_scope
