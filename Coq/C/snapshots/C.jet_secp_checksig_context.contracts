### C.jet_secp_checksig_context.checksig_context_source
checksig_context_source
     : @eq Clight.statement
         match
           jet_secp_root_chain_owned.root_drop_statements (S (S (S O)))
             (Clight.fn_body jets_secp.f_simplicity_check_sig_verify) return Clight.statement
         with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence s _ =>
             match s return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence setup _ => setup
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end checksig_context_setup
### C.jet_secp_checksig_context.checksig_tagged_symbols
checksig_tagged_symbols
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
               jets_secp._sha256_tagged_init)
            (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._sha256_tagged_init)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
               (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._sha256_tagged_init) Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_sha256_tagged_init)))
### C.jet_secp_checksig_context.eval_checksig_output
eval_checksig_output
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bs : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._output e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr)))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m checksig_output_expr (Values.Vptr bs Integers.Ptrofs.zero)
### C.jet_secp_checksig_context.exec_checksig_tag_call
exec_checksig_tag_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (br bs : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp.__res e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets_secp._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._output e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._signatureIV e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_tagged_init e)
                (@None (prod Values.block Ctypes.type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_sha256_tagged_init)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr jet_secp_checksig_tag.checksig_tag_block Integers.Ptrofs.zero)
                         (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m checksig_tag_call Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_checksig_context.exec_checksig_context_setup
exec_checksig_context_setup
     : forall (_ : jet_memcpy_model.memcpy_model) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (bc br bs : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets_secp._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp.__res e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets_secp._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._output e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._signatureIV e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_tagged_init e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bc (@cons Values.block br (@cons Values.block bs (@nil Values.block)))))
         (_ : jet_secp_checksig_tag.checksig_startup m)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m checksig_context_setup Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                  (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val
                        (Values.Vlong
                           (Integers.Int64.repr
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint8unsigned mf bc
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                           (jet_sha_ctx8_model.state_regs jet_secp_checksig_tag.checksig_iv_word))
                        (and
                           (Memory.Mem.range_perm mf bc BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf br BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bs BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block b bc))
                                          (and (not (@eq Values.block b br)) (not (@eq Values.block b bs)))) m mf)
                                    (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                       (jet_secp_checksig_tag.checksig_startup mf)))))))))))
