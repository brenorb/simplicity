### C.jet_elements_tap_getters_literal.haskell_encode_pubkey_matches
haskell_encode_pubkey_matches
     : forall h : Digest.hash256,
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (haskell_encode_pubkey h) (Word.from_hash256 h)
### C.jet_elements_tap_getters_literal.elements_internal_key_literal_matches
elements_internal_key_literal_matches
     : forall (a : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@jet_elements_hash_field_jets.elements_internal_key_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment) (elements_internal_key_literal_spec a environment)
### C.jet_elements_tap_getters_literal.nth_error_is_list_to_maybe_drop
@nth_error_is_list_to_maybe_drop
     : forall (A : Type) (xs : list A) (n : nat),
       @eq (option A) (@List.nth_error A xs n) (@List.hd_error A (@List.skipn A n xs))
### C.jet_elements_tap_getters_literal.word_indexed_digest_literal_matches
word_indexed_digest_literal_matches
     : forall (depth : nat) (values : list Digest.hash256) (a : Ty.tySem (Word.ToZ.obj (Word.WordToZ depth))),
       @eq (option (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            match
              @List.nth_error Digest.hash256 values (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ depth) a))
              return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            with
            | Some h => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
            | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
            end) (word_indexed_digest_literal depth values a)
### C.jet_elements_tap_getters_literal.tappath_literal_index_range
tappath_literal_index_range
     : forall a : Ty.tySem (Word.Word (S (S (S O)))),
       and (BinInt.Z.le BinNums.Z0 (jet_elements_sequence_literal.haskell_from_word (S (S (S O))) a))
         (BinInt.Z.lt (jet_elements_sequence_literal.haskell_from_word (S (S (S O))) a)
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
