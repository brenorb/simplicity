### C.jet_elements_tap_getters_literal.haskell_encode_pubkey
haskell_encode_pubkey =
fun h : Digest.hash256 =>
jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
  (jet_haskell_hash_word.haskell_word256_integer
     (jet_haskell_hash_word.haskell_be256_run (Digest.hash256_to_bytelist h)
        (jet_haskell_hash_word.haskell_word256_from_integer BinNums.Z0)))
     : forall _ : Digest.hash256, Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments haskell_encode_pubkey h
### C.jet_elements_tap_getters_literal.elements_internal_key_literal_spec
elements_internal_key_literal_spec =
fun (_ : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env) =>
@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (haskell_encode_pubkey (jet_elements_prim.tapInternalKey (jet_elements_prim.Elements.envTap environment)))
     : forall (_ : Ty.tySem Ty.Unit) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments elements_internal_key_literal_spec _ environment
### C.jet_elements_tap_getters_literal.word_indexed_digest_literal
word_indexed_digest_literal =
fun (depth : nat) (values : list Digest.hash256) (a : Ty.tySem (Word.Word depth)) =>
@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  match
    @List.hd_error Digest.hash256
      (@List.skipn Digest.hash256 (BinInt.Z.to_nat (jet_elements_sequence_literal.haskell_from_word depth a)) values)
    return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  with
  | Some h =>
      @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
           (jet_haskell_hash_word.haskell_integer_hash256 (Digest.hash256_to_bytelist h)))
  | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
  end
     : forall (depth : nat) (_ : list Digest.hash256) (_ : Ty.tySem (Word.Word depth)),
       option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments word_indexed_digest_literal depth%nat_scope values%list_scope a
### C.jet_elements_tap_getters_literal.elements_tappath_literal_spec
elements_tappath_literal_spec =
fun (a : Ty.tySem (Word.Word (S (S (S O))))) (environment : jet_elements_prim.Elements.env) =>
word_indexed_digest_literal (S (S (S O))) (jet_elements_prim.tappath (jet_elements_prim.Elements.envTap environment)) a
     : forall (_ : Ty.tySem (Word.Word (S (S (S O))))) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments elements_tappath_literal_spec a environment
