elements_tappath_literal_matches
     : forall (a : Ty.tySem (Word.Word (S (S (S O))))) (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@jet_elements_tappath_local.elements_tappath_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment) (elements_tappath_literal_spec a environment)
