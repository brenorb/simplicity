### C.jet_elements_lock_literal.elements_parse_lock_literal_matches
@elements_parse_lock_literal_matches
     : forall alg : Alg.Core.Algebra,
       @eq
         (Alg.Core.domain alg (Word.Word (S (S (S (S (S O))))))
            (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))))
         (@elements_parse_lock_literal alg) (@jet_timelock_spec.parse_lock_spec alg)
### C.jet_elements_lock_literal.elements_lock_literal_program_matches
elements_lock_literal_program_matches
     : forall (height : bool) (alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra),
       @eq (jet_elements_prim.PrimitiveElements.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S O)))))))
         (@elements_lock_literal_program height alg)
         (@jet_elements_lock_spec.lock_program height
            (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
            (@jet_elements_is_final_spec.elements_tx_is_final_spec alg)
            (@jet_elements_lock_spec.elements_lock_time_prim alg))
### C.jet_elements_lock_literal.elements_tx_lock_height_literal_local_spec
elements_tx_lock_height_literal_local_spec
     : jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_tx_lock_height
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
         jet_elements_lock_local.elements_lock_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env) =>
          @elements_lock_literal_program true
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
### C.jet_elements_lock_literal.elements_tx_lock_time_literal_local_spec
elements_tx_lock_time_literal_local_spec
     : jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_tx_lock_time
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
         jet_elements_lock_local.elements_lock_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env) =>
          @elements_lock_literal_program false
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
### C.jet_elements_lock_literal.elements_parse_lock_literal
elements_parse_lock_literal =
fun alg : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
  (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) alg
  (@Alg.Core.Combinators.pair (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit Ty.Unit)
     (Word.Word (S (S (S (S (S O)))))) alg
     (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O))))))
        (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) (Ty.Sum Ty.Unit Ty.Unit) alg
        (@Alg.Core.Combinators.pair (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
           (Word.Word (S (S (S (S (S O)))))) alg (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S O)))))) alg)
           (@Alg.scribe (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
              (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S O)))))
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO ...))))))))))))))))))
              alg)) (@jet_order_spec.lt_word_spec alg (S (S (S (S (S O)))))))
     (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S O)))))) alg))
  (@Bit.cond (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) alg
     (@Alg.Core.Combinators.injl (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
        (Word.Word (S (S (S (S (S O)))))) alg (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S O)))))) alg))
     (@Alg.Core.Combinators.injr (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
        (Word.Word (S (S (S (S (S O)))))) alg (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S O)))))) alg)))
     : forall alg : Alg.Core.Algebra,
       Alg.Core.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))

Arguments elements_parse_lock_literal {alg}
### C.jet_elements_lock_literal.elements_lock_literal_tail
elements_lock_literal_tail =
fun (height : bool) (alg : Alg.Core.Algebra) =>
@Bit.cond (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))) alg
  (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O)))))) Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
     (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S O)))))) alg) (@Word.zero (S (S (S (S (S O))))) alg))
  (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S O)))))) alg
     (@elements_parse_lock_literal alg)
     match
       height
       return
         (Alg.Core.domain alg (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))
            (Word.Word (S (S (S (S (S O)))))))
     with
     | true =>
         @Alg.Core.Combinators.copair (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
           (Word.Word (S (S (S (S (S O)))))) alg (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S O)))))) alg)
           (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O)))))) Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
              (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S O)))))) alg) (@Word.zero (S (S (S (S (S O))))) alg))
     | false =>
         @Alg.Core.Combinators.copair (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
           (Word.Word (S (S (S (S (S O)))))) alg
           (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O)))))) Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
              (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S O)))))) alg) (@Word.zero (S (S (S (S (S O))))) alg))
           (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S O)))))) alg)
     end)
     : forall (_ : bool) (alg : Alg.Core.Algebra),
       Alg.Core.domain alg (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
         (Word.Word (S (S (S (S (S O))))))

Arguments elements_lock_literal_tail height%bool_scope {alg}
### C.jet_elements_lock_literal.elements_lock_literal_program
elements_lock_literal_program =
fun (height : bool) (alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra) =>
@Alg.Core.Combinators.comp Ty.Unit (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
  (Word.Word (S (S (S (S (S O)))))) (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
  (@Alg.Core.Combinators.pair Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O))))))
     (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
     (@jet_elements_is_final_spec.elements_tx_is_final_spec alg)
     (@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
        jet_elements_prim.Elements.LockTime))
  (@elements_lock_literal_tail height (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg))
     : forall (_ : bool) (alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra),
       jet_elements_prim.PrimitiveElements.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))

Arguments elements_lock_literal_program height%bool_scope {alg}
