         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bo))
         (_ : and (BinInt.Z.le BinNums.Z0 obase)
                (BinInt.Z.le
                   (BinInt.Z.add obase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   Integers.Ptrofs.max_unsigned)) (_ : jet_memcpy_model.memcpy_model) (m : Memory.Mem.mem)
         (bt : Values.block) (ot : Integers.Ptrofs.int) (l regs regsH : list Integers.Int.int)
         (c : Integers.Int64.int) (ovf : bool) (_ : ctxo m bx bo obase l regs c ovf)
         (_ : @eq nat (@length Integers.Int.int regsH) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned ot)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bt
                   (BinInt.Z.add (Integers.Ptrofs.unsigned ot)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j regsH Integers.Int.zero)))),
       let vn : Integers.Int64.int :=
         Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
