### C.jet_secp_x_equiv_literal_bridge.x_equiv_reader_product_residue
x_equiv_reader_product_residue
     : forall q z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (BinInt.Z.mul
                  (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho z))
                  (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho z)))
               (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho q)))
            jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z)
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) q)) jet_secp_fe_math.feP)
### C.jet_secp_x_equiv_literal_bridge.x_equiv_guarded_result_literal
x_equiv_guarded_result_literal
     : forall q x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq Integers.Int.int
         match Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z) return Integers.Int.int with
         | true => Integers.Int.zero
         | false =>
             jet_secp_x_equiv_function.x_equiv_result (jet_secp_square_spec_bridge.square_reader_rho q)
               (jet_secp_square_spec_bridge.square_reader_rho x) (jet_secp_square_spec_bridge.square_reader_rho z)
         end
         (jet_readBit_layout.bit_int
            (Bit.toBool
               (@jet_secp_x_equiv_literal.literal_gej_x_equiv Alg.CoreFunSem
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (prod
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) q
                     (@pair
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)))))
