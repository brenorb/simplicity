### C.jet_amount_exec_common.amount_explicit_encoding
amount_explicit_encoding
     : forall
         v : prod
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  (let rec : Ty.Ty :=
                     let rec : Ty.Ty :=
                       let rec : Ty.Ty :=
                         let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                         Ty.Prod rec rec in
                       Ty.Prod rec rec in
                     Ty.Prod rec rec in
                   Ty.Prod rec rec))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  (let rec : Ty.Ty :=
                     let rec : Ty.Ty :=
                       let rec : Ty.Ty :=
                         let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                         Ty.Prod rec rec in
                       Ty.Prod rec rec in
                     Ty.Prod rec rec in
                   Ty.Prod rec rec)),
       @eq (list BitMachine.Cell)
         (@Translate.encode amount_value_type
            (@inr
               (prod (sum unit unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     (let rec : Ty.Ty :=
                        let rec : Ty.Ty :=
                          let rec : Ty.Ty :=
                            let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                            Ty.Prod rec rec in
                          Ty.Prod rec rec in
                        Ty.Prod rec rec in
                      Ty.Prod rec rec))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     (let rec : Ty.Ty :=
                        let rec : Ty.Ty :=
                          let rec : Ty.Ty :=
                            let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                            Ty.Prod rec rec in
                          Ty.Prod rec rec in
                        Ty.Prod rec rec in
                      Ty.Prod rec rec))) v))
         (@cons (option bool) (@Some bool true)
            (@app (option bool)
               (@List.repeat (option bool) (@None bool)
                  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))
               (@Translate.encode (Word.Word (S (S (S (S (S (S O))))))) v)))
