                                    (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                    (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                                 (prod
                                    (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                    (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                              (prod
                                 (prod
                                    (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                    (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                                 (prod
                                    (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                    (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))))))
                  match odd return (sum unit unit) with
                  | true => @inr unit unit tt
                  | false => @inl unit unit tt
                  end h)))
         (@cons (option bool) (@Some bool false)
            (@cons (option bool) (@Some bool odd) (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h)))
### C.jet_amount_exec_common.amount_prefix_machine
amount_prefix_machine
     : and
         (@eq Integers.Int.int
            (jet_read8s_layout.word8_array_value
               (jet_nonce_context_spec.nonce_byte (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (@eq Integers.Int.int
            (jet_read8s_layout.word8_array_value
               (jet_nonce_context_spec.nonce_byte (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
            (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
### C.jet_amount_exec_common.amount_bytes_length
amount_bytes_length
     : forall a : Ty.tySem amount_value_type,
       @eq BinNums.Z (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (amount_bytes a))) (amount_count a)
### C.jet_amount_exec_common.amount_counter_one_then_8
amount_counter_one_then_8
     : forall c : Integers.Int64.int,
       @eq Integers.Int64.int
         (Integers.Int64.add (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
### C.jet_amount_exec_common.amount_skip_exec
amount_skip_exec
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bl bi : Values.block) (edge rc : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._src e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bl jet_nonce_context_shape.nc_fr)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._forwardBits e)
                (@None (prod Values.block Ctypes.type))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m jet_asset_exec_shape.amount_skip
               Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                  (BinInt.Z.add rc
                     (BinNums.Zpos
                        (BinNums.xI
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
               (jet_nonce_exec_effects.nonce_effects m mf (@cons Values.block bl (@nil Values.block)))))
### C.jet_amount_exec_common.amount_value_type
amount_value_type =
Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S O)))))))
     : Ty.Ty
### C.jet_amount_exec_common.amount_bytes
amount_bytes =
fun a : Ty.tySem amount_value_type =>
match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl t =>
    match t return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
    | pair odd h =>
        @cons (Ty.tySem (Word.Word (S (S (S O)))))
          (jet_nonce_context_spec.nonce_byte
             match odd return BinNums.Z with
             | inl _ => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))
             | inr _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))
             end) (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
    end
| inr v =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) (jet_nonce_context_spec.nonce_byte (BinNums.Zpos BinNums.xH))
      (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S O))) v)
end
     : forall _ : Ty.tySem amount_value_type, list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments amount_bytes a
### C.jet_amount_exec_common.amount_count
amount_count =
fun a : Ty.tySem amount_value_type =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
| inr _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))
end
     : forall _ : Ty.tySem amount_value_type, BinNums.Z

Arguments amount_count a
### C.jet_amount_exec_common.amount_payload_count
amount_payload_count =
fun a : Ty.tySem amount_value_type =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
| inr _ => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))
end
     : forall _ : Ty.tySem amount_value_type, BinNums.Z

Arguments amount_payload_count a
### C.jet_amount_exec_common.amount_overflow
amount_overflow =
fun (ovf : bool) (c : Integers.Int64.int) (a : Ty.tySem amount_value_type) =>
jet_elements_support_sha_uchars_exec.uc_overflow
  (jet_elements_support_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
  (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH))) (Integers.Int64.repr (amount_payload_count a))
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Ty.tySem amount_value_type), bool

Arguments amount_overflow ovf%bool_scope c a
### C.jet_amount_exec_common.amount_temps
amount_temps =
fun (a : Ty.tySem amount_value_type) (le : Maps.PTree.tree Values.val) =>
match a return (Maps.PTree.tree Values.val) with
| inl t =>
    match t return (Maps.PTree.tree Values.val) with
    | pair odd _ =>
        @Maps.PTree.set Values.val jets_elements._t'4
          (Values.Vint (jet_readBit_layout.bit_int match odd return bool with
                                                   | inl _ => false
                                                   | inr _ => true
                                                   end))
          (@Maps.PTree.set Values.val jets_elements._t'5 (Values.Vint Integers.Int.zero) le)
    end
| inr _ => @Maps.PTree.set Values.val jets_elements._t'5 (Values.Vint Integers.Int.one) le
end
     : forall (_ : Ty.tySem amount_value_type) (_ : Maps.PTree.tree Values.val), Maps.PTree.tree Values.val

Arguments amount_temps a le
