### C.jet_u128_accum_layout.u128_accum_symbol
u128_accum_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            jets._secp256k1_u128_accum_u64)
         (@Some Values.block (jet_exec.jet_symbol_block jets._secp256k1_u128_accum_u64))
### C.jet_u128_accum_layout.u128_accum_funct
u128_accum_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._secp256k1_u128_accum_u64) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_secp256k1_u128_accum_u64))
### C.jet_u128_accum_layout.eval_u128_accum_hi_expr
eval_u128_accum_hi_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (hi lo a : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._t'1 le) (@Some Values.val (Values.Vlong hi)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._t'2 le)
                (@Some Values.val (Values.Vlong (jet_u128_accum_value.u128_accum_lo lo a))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._a le) (@Some Values.val (Values.Vlong a))),
       Clight.eval_expr jet_exec.ge0 e le m u128_accum_hi_expr
         (Values.Vlong (jet_u128_accum_value.u128_accum_hi hi lo a))
### C.jet_u128_accum_layout.eval_u128_accum_layout
eval_u128_accum_layout
     : forall (m : Memory.Mem.mem) (br : Values.block) (base : BinNums.Z) (hi lo a : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid base)
         (_ : Memory.Mem.valid_access m AST.Mint64 br base Memtype.Writable)
         (_ : Memory.Mem.valid_access m AST.Mint64 br
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m br base) (@Some Values.val (Values.Vlong lo)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m br
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong hi))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function jets.f_secp256k1_u128_accum_u64)
               (@cons Values.val (Values.Vptr br (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vlong a) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf br base)
                  (@Some Values.val (Values.Vlong (jet_u128_accum_value.u128_accum_lo lo a))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf br
                        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val (Values.Vlong (jet_u128_accum_value.u128_accum_hi hi lo a))))
                  (and
                     (forall (chunk : AST.memory_chunk) (bb : Values.block) (addr : BinNums.Z)
                        (_ : or (not (@eq Values.block bb br))
                               (or (BinInt.Z.le (BinInt.Z.add addr (Memdata.size_chunk chunk)) base)
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     addr))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf bb addr) (Memory.Mem.load chunk m bb addr))
                     (and
                        (forall (bb : Values.block) (addr : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m bb addr kind p),
                         Memory.Mem.perm mf bb addr kind p)
                        (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m)))))))
### C.jet_u128_accum_layout.u128_accum_temps
u128_accum_temps =
fun (br : Values.block) (base : BinNums.Z) (a : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._a (Values.Vlong a)
  (@Maps.PTree.set Values.val jets._r (Values.Vptr br (Integers.Ptrofs.repr base))
     (Clight.create_undef_temps (Clight.fn_temps jets.f_secp256k1_u128_accum_u64)))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments u128_accum_temps br base%Z_scope a
### C.jet_u128_accum_layout.u128_accum_hi_expr
u128_accum_hi_expr =
Clight.Ebinop Cop.Oadd (Clight.Etempvar jets._t'1 Ctypesdefs.tulong)
  (Clight.Ebinop Cop.Olt (Clight.Etempvar jets._t'2 Ctypesdefs.tulong) (Clight.Etempvar jets._a Ctypesdefs.tulong)
     Ctypesdefs.tint) Ctypesdefs.tulong
     : Clight.expr
