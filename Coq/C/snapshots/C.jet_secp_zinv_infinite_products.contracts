### C.jet_secp_zinv_infinite_products.zinv_infinite_products_source
zinv_infinite_products_source
     : @eq Clight.statement zinv_infinite_after_flag
         (jet_secp_statement_prefix.statement_sequence zinv_infinite_product_statements zinv_infinite_after_products)
### C.jet_secp_zinv_infinite_products.exec_zinv_infinite_products
exec_zinv_infinite_products
     : forall (u v inv : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bp ba bb b2 b3 : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._bzinv le)
                (@Some Values.val (Values.Vptr bb Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._bzinv2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b2 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._bzinv3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b3 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bp
                   (@cons Values.block ba
                      (@cons Values.block bb (@cons Values.block b2 (@cons Values.block b3 (@nil Values.block)))))))
         (_ : jet_secp_square_columns.square_input_bounds u) (_ : jet_secp_square_columns.square_input_bounds v)
         (_ : jet_secp_square_columns.square_input_bounds inv)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 v))
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b3 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence zinv_infinite_product_statements Clight.Sskip) Events.E0
               le mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bp BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5
                     (jet_secp_point_mul_storage.point_mul_words u (jet_secp_square_numeric.square_words inv))))
               (and
                  (jet_secp_fe_nv.fe_at mf bp
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5
                        (jet_secp_point_mul_storage.point_mul_words v (zinv_inverse_cube inv))))
                  (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
                     (and
                        (jet_secp_fe_nv.fe_at mf ba
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           (jet_secp_multiply_normalize_bridge.words5 v))
                        (and (jet_secp_fe_nv.fe_at mf bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                           (and
                              (jet_secp_fe_nv.fe_at mf b2 BinNums.Z0
                                 (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words inv)))
                              (and
                                 (jet_secp_fe_nv.fe_at mf b3 BinNums.Z0
                                    (jet_secp_multiply_normalize_bridge.words5 (zinv_inverse_cube inv)))
                                 (and
                                    (Memory.Mem.range_perm mf bp BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (Memory.Mem.range_perm mf ba BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (Memory.Mem.range_perm mf bb BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (Memory.Mem.range_perm mf b2 BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                Memtype.Cur Memtype.Freeable)
                                             (and
                                                (Memory.Mem.range_perm mf b3 BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (and
                                                   (jet_secp_square_columns.square_input_bounds
                                                      (jet_secp_point_mul_storage.point_mul_words u
                                                         (jet_secp_square_numeric.square_words inv)))
                                                   (and
                                                      (jet_secp_square_columns.square_input_bounds
                                                         (jet_secp_point_mul_storage.point_mul_words v
                                                            (zinv_inverse_cube inv)))
                                                      (jet_sx_mem.lframe (zinv_infinite_products_frame bp ba bb b2 b3)
                                                         m mf))))))))))))))))
### C.jet_secp_zinv_infinite_products.zinv_infinite_branch
zinv_infinite_branch =
match jet_secp_zinv_finite.zinv_a_head return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ _ => Clight.Sskip
    | Clight.Sifthenelse _ branch _ => branch
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_zinv_infinite_products.zinv_infinite_after_flag
zinv_infinite_after_flag =
match zinv_infinite_branch return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ rest => rest
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_zinv_infinite_products.zinv_inverse_square_call
zinv_inverse_square_call =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_sqr jets_secp.f_secp256k1_fe_sqr
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._bzinv2)
     (@cons Clight.expr (Clight.Etempvar jets_secp._bzinv (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_zinv_infinite_products.zinv_inverse_cube_call
zinv_inverse_cube_call =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._bzinv3)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._bzinv2)
        (@cons Clight.expr (Clight.Etempvar jets_secp._bzinv (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
           (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_zinv_infinite_products.zinv_infinite_coordinate_call
zinv_infinite_coordinate_call =
fun y : bool =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr
     (jet_secp_double_statements.double_point_address jets_secp._r
        match y return AST.ident with
        | true => jets_secp._y
        | false => jets_secp._x
        end)
     (@cons Clight.expr
        (Clight.Eaddrof
           (jet_secp_mixed_finite_start.mixed_b_field
              match y return AST.ident with
              | true => jets_secp._y
              | false => jets_secp._x
              end jet_secp_curve_statements.curve_fe_type) (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
        (@cons Clight.expr
           (jet_secp_curve_statements.curve_local_address
              match y return AST.ident with
              | true => jets_secp._bzinv3
              | false => jets_secp._bzinv2
              end) (@nil Clight.expr))))
     : forall _ : bool, Clight.statement

Arguments zinv_infinite_coordinate_call y%bool_scope
### C.jet_secp_zinv_infinite_products.zinv_infinite_product_statements
zinv_infinite_product_statements =
@cons Clight.statement zinv_inverse_square_call
  (@cons Clight.statement zinv_inverse_cube_call
     (@cons Clight.statement (zinv_infinite_coordinate_call false)
        (@cons Clight.statement (zinv_infinite_coordinate_call true) (@nil Clight.statement))))
     : list Clight.statement
### C.jet_secp_zinv_infinite_products.zinv_infinite_after_products
zinv_infinite_after_products =
jet_secp_zinv_shared_preparation.zinv_statement_drop (S (S (S (S O)))) zinv_infinite_after_flag
     : Clight.statement
### C.jet_secp_zinv_infinite_products.zinv_inverse_cube
zinv_inverse_cube =
fun inv : forall _ : nat, Integers.Int64.int =>
jet_secp_point_mul_storage.point_mul_words (jet_secp_square_numeric.square_words inv) inv
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments zinv_inverse_cube inv%function_scope i%nat_scope
### C.jet_secp_zinv_infinite_products.zinv_infinite_products_frame
zinv_infinite_products_frame =
fun (bp ba bb b2 b3 bx : Values.block) (pos : BinNums.Z) =>
and
  (or (not (@eq Values.block bx bp))
     (or (BinInt.Z.lt pos BinNums.Z0)
        (BinInt.Z.le
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
  (and
     (or (not (@eq Values.block bx ba))
        (or (BinInt.Z.lt pos BinNums.Z0)
           (BinInt.Z.le
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
              pos)))
     (and (not (@eq Values.block bx bb)) (and (not (@eq Values.block bx b2)) (not (@eq Values.block bx b3)))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments zinv_infinite_products_frame bp ba bb b2 b3 bx pos%Z_scope
