### C.jet_predicate8_layout.all8_local_spec
all8_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_all_8 (Word.Word (S (S (S O))))
         (Ty.Sum Ty.Unit Ty.Unit)
