### C.jet_elements_total_fee_compare.fromZ64_unsigned_repr
fromZ64_unsigned_repr
     : forall z : BinNums.Z,
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
            (Integers.Int64.unsigned (Integers.Int64.repr z))) (jet_bitcoin_totals_spec.fw6 z)
### C.jet_elements_total_fee_compare.elements_total_fee_c_contract
elements_total_fee_c_contract
     : forall _ : jet_memcmp_model.memcmp_model,
       jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_total_fee
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Word.Word (S (S (S (S (S (S O))))))) total_fee_env_rep
         (fun (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (environment : jet_elements_prim.Elements.env) =>
          @Some (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
            (jet_bitcoin_totals_spec.fw6 (processed_total_fee a environment)))
### C.jet_elements_total_fee_compare.fee_contrib_agree
fee_contrib_agree
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (o : jet_elements_prim.txOutput)
         (_ : not (jet_elements_output_is_fee_compare.fee_digest_collision o)),
       @eq BinNums.Z (processed_fee_contrib a o) (jet_elements_total_fee_spec.canonical_fee_contrib a o)
### C.jet_elements_total_fee_compare.total_fee_results_agree_everywhere_iff
total_fee_results_agree_everywhere_iff
     : iff
         (forall (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (environment : jet_elements_prim.Elements.env),
          @eq (option (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
            (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
               (jet_bitcoin_totals_spec.fw6 (processed_total_fee a environment)))
            (@jet_elements_total_fee_spec.elements_total_fee_spec
               (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
               environment)) jet_elements_output_is_fee_compare.empty_script_digest_unique
### C.jet_elements_total_fee_compare.elements_total_fee_canonical_comparison
elements_total_fee_canonical_comparison
     : forall _ : jet_memcmp_model.memcmp_model,
       and
         (jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_total_fee
            jet_elements_linkage.elements_ge jet_elements_prim.Elements.env
            (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S O))))))) total_fee_env_rep
            (fun (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (environment : jet_elements_prim.Elements.env) =>
             @Some (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
               (jet_bitcoin_totals_spec.fw6 (processed_total_fee a environment))))
         (iff
            (forall (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (environment : jet_elements_prim.Elements.env),
             @eq (option (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
               (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                  (jet_bitcoin_totals_spec.fw6 (processed_total_fee a environment)))
               (@jet_elements_total_fee_spec.elements_total_fee_spec
                  (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
                  environment)) jet_elements_output_is_fee_compare.empty_script_digest_unique)
### C.jet_elements_total_fee_compare.elements_total_fee_local_spec_if_digest_unique
elements_total_fee_local_spec_if_digest_unique
     : forall (_ : jet_memcmp_model.memcmp_model) (_ : jet_elements_output_is_fee_compare.empty_script_digest_unique),
       jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_total_fee
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Word.Word (S (S (S (S (S (S O))))))) total_fee_env_rep
         (fun (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (environment : jet_elements_prim.Elements.env) =>
          @jet_elements_total_fee_spec.elements_total_fee_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
### C.jet_elements_total_fee_compare.processed_fee_contrib
processed_fee_contrib =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (o : jet_elements_prim.txOutput) =>
match jet_elements_fee_flag_caller.processed_fee_bit o return BinNums.Z with
| true =>
    match
      Bit.toBool
        ((@jet_equality_spec.equality_spec
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))) Alg.CoreFunSem
          :
          Ty.Arrow
            (Ty.Prod
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.Sum Ty.Unit Ty.Unit))
           (@pair
              (Ty.tySem
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (sum
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Ty.Sum Ty.Unit Ty.Unit))
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (jet_elements_asset_jets.encode_asset
                 (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256 (jet_elements_prim.txoAsset o)))
              (@inr
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Ty.Sum Ty.Unit Ty.Unit))
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a))) return BinNums.Z
    with
    | true =>
        match
          @jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (jet_elements_prim.txoAmount o)
          return BinNums.Z
        with
        | jet_elements_prim.Explicit v => Integers.Int64.unsigned v
        | jet_elements_prim.Confidential _ _ => BinNums.Z0
        end
    | false => BinNums.Z0
    end
| false => BinNums.Z0
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : jet_elements_prim.txOutput), BinNums.Z

Arguments processed_fee_contrib a o
### C.jet_elements_total_fee_compare.processed_total_fee
processed_total_fee =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (environment : jet_elements_prim.Elements.env) =>
@List.fold_right BinNums.Z BinNums.Z BinInt.Z.add BinNums.Z0
  (@List.map jet_elements_prim.txOutput BinNums.Z (processed_fee_contrib a)
     (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment)))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : jet_elements_prim.Elements.env),
       BinNums.Z

Arguments processed_total_fee a environment
### C.jet_elements_total_fee_compare.total_fee_env_rep
total_fee_env_rep =
fun (m : Memory.Mem.mem) (envv : Values.val) (environment : jet_elements_prim.Elements.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
and
  (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
  (@ex Values.block
     (fun be : Values.block =>
      @ex BinNums.Z
        (fun ebase : BinNums.Z =>
         @ex Values.block
           (fun bt : Values.block =>
            @ex BinNums.Z
              (fun txbase : BinNums.Z =>
               @ex Values.val
                 (fun tableval : Values.val =>
                  @ex (list jet_elements_fee_lookup_table.fee_entry)
                    (fun entries : list jet_elements_fee_lookup_table.fee_entry =>
                     and (@eq Values.val envv (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                       (and (BinInt.Z.le BinNums.Z0 ebase)
                          (and
                             (BinInt.Z.le
                                (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                Integers.Ptrofs.max_unsigned)
                             (and (BinInt.Z.le BinNums.Z0 txbase)
                                (and
                                   (BinInt.Z.le
                                      (BinInt.Z.add txbase
                                         (BinNums.Zpos
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))
                                      Integers.Ptrofs.max_unsigned)
                                   (and
                                      (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                         (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                                      (and
                                         (@eq (option Values.val)
                                            (Memory.Mem.load AST.Mptr m bt
                                               (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))))
                                            (@Some Values.val tableval))
                                         (and
                                            (@eq (option Values.val)
                                               (Memory.Mem.load AST.Mint64 m bt
                                                  (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO ...))))
                                               (@Some Values.val
                                                  (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat ...)))))
                                            (and (not (@eq Values.val tableval Values.Vundef))
                                               (and
                                                  (jet_elements_total_fee_read.total_fee_table_storage m tableval
                                                     entries)
                                                  (and (jet_elements_fee_lookup_sorted.fee_lookup_sorted entries)
                                                     (forall a : ..., @eq Integers.Int64.int (...) (...)))))))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments total_fee_env_rep m envv environment fp%list_scope
