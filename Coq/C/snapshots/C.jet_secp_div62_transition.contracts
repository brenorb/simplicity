         (BinInt.Z.modulo
            (BinInt.Z.mul (modinv.modInv (BinInt.Z.opp a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)) b)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
         (BinInt.Z.modulo
            (BinInt.Z.mul (modinv.modInv (BinInt.Z.opp F) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)) G)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
