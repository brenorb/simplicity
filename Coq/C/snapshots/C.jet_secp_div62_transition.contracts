               (div62_pending_matrix lef
                  (divstep.Trans.mul (divstep.Trans.transN (BinInt.Z.to_nat (div62_branch_width st i)) st) matrix)
                  (div62_branch_width st i))
               (and
                  (div62_pending_fg lef
                     (@fst divstep.State (list divstep.Step)
                        (divstep.stepN (BinInt.Z.to_nat (div62_branch_width st i)) st))
                     (BinInt.Z.sub precision (div62_branch_width st i)) (div62_branch_width st i))
                  (and
                     (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._eta lef)
                        (@Some Values.val
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (BinInt.Z.add
                                    (divstep.eta
                                       (@fst divstep.State (list divstep.Step)
                                          (divstep.stepN (BinInt.Z.to_nat (div62_branch_width st i)) st)))
                                    (div62_branch_width st i))))))
                     (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i lef)
                        (@Some Values.val (Values.Vint (Integers.Int.repr i))))))))
### C.jet_secp_div62_transition.div62_continuation_w
div62_continuation_w =
fun (neg : bool) (eta i a b : BinNums.Z) =>
Integers.Int.unsigned
  (jet_secp_div62_cancel.div62_w_word neg
     match neg return Integers.Int64.int with
     | true => Integers.Int64.repr b
     | false => Integers.Int64.repr a
     end
     match neg return Integers.Int64.int with
     | true => Integers.Int64.neg (Integers.Int64.repr a)
     | false => Integers.Int64.repr b
     end
     (jet_secp_div62_limit.div62_mask neg match neg return BinNums.Z with
                                          | true => BinInt.Z.opp eta
                                          | false => eta
                                          end i))
     : forall (_ : bool) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments div62_continuation_w neg%bool_scope (eta i a b)%Z_scope
### C.jet_secp_div62_transition.div62_continuation_matrix
div62_continuation_matrix =
fun (neg : bool) (eta i a b : BinNums.Z) =>
let k : BinNums.Z :=
  jet_secp_div62_numeric.div62_cancel_bits neg
    match neg return BinNums.Z with
    | true => BinInt.Z.opp eta
    | false => eta
    end i in
let w : BinNums.Z := div62_continuation_w neg eta i a b in
match neg return divstep.Trans.M2x2 with
| true =>
    divstep.Trans.Build_M2x2 BinNums.Z0 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      (BinNums.Zneg BinNums.xH) w
| false =>
    divstep.Trans.Build_M2x2 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k) BinNums.Z0 w
      (BinNums.Zpos BinNums.xH)
end
     : forall (_ : bool) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), divstep.Trans.M2x2

Arguments div62_continuation_matrix neg%bool_scope (eta i a b)%Z_scope
### C.jet_secp_div62_transition.div62_pending_matrix
div62_pending_matrix =
fun (le : Clight.temp_env) (matrix : divstep.Trans.M2x2) (pending : BinNums.Z) =>
@ex BinNums.Z
  (fun u : BinNums.Z =>
   @ex BinNums.Z
     (fun v : BinNums.Z =>
      and
        (@eq BinNums.Z (divstep.Trans.u matrix)
           (BinInt.Z.mul u (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) pending)))
        (and
           (@eq BinNums.Z (divstep.Trans.v matrix)
              (BinInt.Z.mul v (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) pending)))
           (and
              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._u le)
                 (@Some Values.val (Values.Vlong (Integers.Int64.repr u))))
              (and
                 (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._v le)
                    (@Some Values.val (Values.Vlong (Integers.Int64.repr v))))
                 (and
                    (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._q le)
                       (@Some Values.val (Values.Vlong (Integers.Int64.repr (divstep.Trans.q matrix)))))
                    (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                       (@Some Values.val (Values.Vlong (Integers.Int64.repr (divstep.Trans.r matrix)))))))))))
     : forall (_ : Clight.temp_env) (_ : divstep.Trans.M2x2) (_ : BinNums.Z), Prop

Arguments div62_pending_matrix le matrix pending%Z_scope
### C.jet_secp_div62_transition.div62_sign
div62_sign =
fun eta : BinNums.Z => match Coqlib.zlt eta BinNums.Z0 return bool with
                       | left _ => true
                       | right _ => false
                       end
     : forall _ : BinNums.Z, bool

Arguments div62_sign eta%Z_scope
### C.jet_secp_div62_transition.div62_branch_width
div62_branch_width =
fun (st : divstep.State) (i : BinNums.Z) =>
jet_secp_div62_numeric.div62_cancel_bits (div62_sign (divstep.eta st))
  match div62_sign (divstep.eta st) return BinNums.Z with
  | true => BinInt.Z.opp (divstep.eta st)
  | false => divstep.eta st
  end i
     : forall (_ : divstep.State) (_ : BinNums.Z), BinNums.Z

Arguments div62_branch_width st i%Z_scope
### C.jet_secp_div62_transition.div62_pending_fg
div62_pending_fg =
fun (le : Clight.temp_env) (st : divstep.State) (precision pending : BinNums.Z) =>
@ex BinNums.Z
  (fun a : BinNums.Z =>
   @ex BinNums.Z
     (fun b : BinNums.Z =>
      and (Zdiv.eqm (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) precision) a (divstep.f st))
        (and (Zdiv.eqm (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) precision) b (divstep.g st))
           (and
              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._f le)
                 (@Some Values.val (Values.Vlong (Integers.Int64.repr a))))
              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._g le)
                 (@Some Values.val
                    (Values.Vlong
                       (Integers.Int64.repr
                          (BinInt.Z.mul b (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) pending))))))))))
     : forall (_ : Clight.temp_env) (_ : divstep.State) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments div62_pending_fg le st (precision pending)%Z_scope
