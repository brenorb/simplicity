### C.jet_secp_div62_transition.div62_fg_transition
div62_fg_transition
     : forall (st : divstep.State) (k w : BinNums.Z) (neg : bool) (_ : BinInt.Z.le BinNums.Z0 k)
         (_ : @eq divstep.Trans.M2x2 (divstep.Trans.transN (BinInt.Z.to_nat k) st)
