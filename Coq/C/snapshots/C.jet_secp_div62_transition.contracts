         (@eq BinNums.Z
            (BinInt.Z.mul (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               (divstep.g (@fst divstep.State (list divstep.Step) (divstep.stepN (BinInt.Z.to_nat k) st))))
