                 (Clight.Etempvar jets_secp._r (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
                 (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)) fid (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
