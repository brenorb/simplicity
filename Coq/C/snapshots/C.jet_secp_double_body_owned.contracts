### C.jet_secp_double_body_owned.exec_double_arithmetic_owned
exec_double_arithmetic_owned
     : forall (le : Maps.PTree.tree Values.val) (x y z : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (ba bs bl bt : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : not (@eq Values.block ba bs))
         (_ : not (@eq Values.block ba bl)) (_ : not (@eq Values.block ba bt)) (_ : not (@eq Values.block bs bl))
         (_ : not (@eq Values.block bs bt)) (_ : not (@eq Values.block bl bt))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
               (jet_secp_double_statements.double_helper_env bl bs bt) le m
               jet_secp_double_statements.double_arithmetic_body Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf ba BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_double_all_calls.double_output_x_words x y)))
               (and
                  (jet_secp_fe_nv.fe_at mf ba
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 (jet_secp_double_all_calls.double_output_y_words x y)))
                  (and
                     (jet_secp_fe_nv.fe_at mf ba
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_double_all_calls.double_output_z_words y z)))
                     (and
                        (Memory.Mem.range_perm mf ba BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bs BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bl BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bt BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_secp_square_columns.square_input_bounds
                                       (jet_secp_double_all_calls.double_output_x_words x y))
                                    (and
                                       (jet_secp_square_columns.square_input_bounds
                                          (jet_secp_double_all_calls.double_output_y_words x y))
                                       (and
                                          (jet_secp_square_columns.square_input_bounds
                                             (jet_secp_double_all_calls.double_output_z_words y z))
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (pos : BinNums.Z) =>
                                              and (jet_secp_double_prefix.double_work_frame ba bs bl b pos)
                                                (not (@eq Values.block b bt))) m mf))))))))))))
