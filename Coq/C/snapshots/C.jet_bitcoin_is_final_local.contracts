### C.jet_bitcoin_is_final_local.bool_int
bool_int =
fun b : bool => match b return Integers.Int.int with
                | true => Integers.Int.one
                | false => Integers.Int.zero
                end
     : forall _ : bool, Integers.Int.int

Arguments bool_int b%bool_scope
### C.jet_bitcoin_is_final_local.bitcoin_tx_is_final_mid
bitcoin_tx_is_final_mid =
Clight.Ssequence (jet_bitcoin_fee_local.bitcoin_env_tx_set jets_bitcoin._t'1)
  (Clight.Ssequence
     (Clight.Sset jets_bitcoin._t'2
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_bitcoin._t'1
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
              (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) jets_bitcoin._isFinal Ctypesdefs.tbool))
     (Clight.Scall (@None AST.ident)
        (Clight.Evar jets_bitcoin._writeBit
           (Ctypes.Tfunction
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
                 (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
        (@cons Clight.expr
           (Clight.Etempvar jets_bitcoin._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
           (@cons Clight.expr (Clight.Etempvar jets_bitcoin._t'2 Ctypesdefs.tbool) (@nil Clight.expr)))))
     : Clight.statement
### C.jet_bitcoin_is_final_local.bitcoin_tx_is_final_env_rep
bitcoin_tx_is_final_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
              (and (BinInt.Z.le BinNums.Z0 ebase)
                 (and
                    (BinInt.Z.le
                       (BinInt.Z.add ebase
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                       Integers.Ptrofs.max_unsigned)
                    (and (BinInt.Z.le BinNums.Z0 tbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add tbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                             (and
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint8unsigned m bt
                                      (BinInt.Z.add tbase
                                         (BinNums.Zpos
                                            (BinNums.xO
                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))))
                                   (@Some Values.val
                                      (Values.Vint
                                         (bool_int
                                            (@List.forallb Bitcoin.sigTxInput jet_bitcoin_is_final_spec.sequence_final
                                               (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx environment)))))))
                                (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                   (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                      (@pair (prod Values.block BinNums.Z) BinNums.Z
                                         (@pair Values.block BinNums.Z be ebase)
                                         (BinInt.Z.add ebase
                                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                      (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                         (@pair (prod Values.block BinNums.Z) BinNums.Z
                                            (@pair Values.block BinNums.Z bt
                                               (BinInt.Z.add tbase
                                                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                            (BinInt.Z.add tbase
                                               (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))
                                         (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments bitcoin_tx_is_final_env_rep m env environment fp%list_scope
