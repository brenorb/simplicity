let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod
     (Ty.Sum Ty.Unit
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     core (@jet_elements_amount_jets.elements_input_amount_spec alg)
     (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg jet_elements_prim.Elements.InputScriptHash))
  (@jet_sha256_ctx8_init_spec.AC.case Ty.Unit jet_elements_asset_amount_hash_spec.elements_asset_amount_type
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_sha256_ctx8_init_spec.AC.injl
        (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_sha256_ctx8_init_spec.AC.unit
           (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core))
     (@jet_sha256_ctx8_init_spec.AC.injr
        (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_sha256_ctx8_init_spec.AC.comp
           (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
           (@jet_sha256_ctx8_init_spec.AC.pair
              (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_sha256_ctx8_init_spec.AC.comp
                 (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                    (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    jet_elements_asset_amount_hash_spec.elements_asset_amount_type)
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                 (@jet_sha256_ctx8_init_spec.AC.pair
                    (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    jet_elements_asset_amount_hash_spec.elements_asset_amount_type core
                    (@jet_sha256_ctx8_init_spec.AC.comp
                       (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                          (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
                       jet_sha256_ctx8_init_spec.sha256_ctx8_type core
                       (@jet_sha256_ctx8_init_spec.AC.unit
                          (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                             (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core)
                       (@jet_sha256_ctx8_init_spec.sha256_ctx8_init_spec core))
                    (@jet_sha256_ctx8_init_spec.AC.take jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       jet_elements_asset_amount_hash_spec.elements_asset_amount_type core
                       (@jet_sha256_ctx8_init_spec.AC.iden
                          jet_elements_asset_amount_hash_spec.elements_asset_amount_type core)))
                 (@jet_elements_asset_amount_hash_spec.elements_asset_amount_hash_spec term))
              (@jet_sha256_ctx8_init_spec.AC.drop jet_elements_asset_amount_hash_spec.elements_asset_amount_type
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@jet_bitcoin_vh_hash_spec.assert_iden_spec (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)))
           (@jet_sha256_ctx8_init_spec.AC.comp
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S (S (S (S O))))) term)
              (@jet_sha_finalize_spec.ctx8_finalize_spec term)))))
     : forall alg : jet_elements_words_hash_program.EFP.Algebra,
       jet_elements_words_hash_program.EFP.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments elements_input_utxo_hash_spec {alg}
### C.jet_elements_input_utxo_hash_spec.elements_input_utxo_bytes
elements_input_utxo_bytes =
fun (v : Ty.tySem jet_elements_asset_amount_hash_spec.elements_asset_amount_type)
  (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
@app (Ty.tySem (Word.Word (S (S (S O))))) (jet_elements_asset_amount_hash_spec.elements_asset_amount_bytes v)
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
     : forall (_ : Ty.tySem jet_elements_asset_amount_hash_spec.elements_asset_amount_type)
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments elements_input_utxo_bytes v h
### C.jet_elements_input_utxo_hash_spec.elements_input_utxo_hash_result
elements_input_utxo_hash_result =
fun (e : jet_elements_prim.Elements.env) (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error jet_elements_prim.sigTxInput (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))
  return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| Some txi =>
    @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Word.from_hash256
         (jet_bitcoin_composite_hash.sha256_bytes_of
            (elements_input_utxo_bytes
               (@pair
                  (Ty.tySem
                     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem
                     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Word.Word (S (S (S (S (S (S O)))))))))
                  (jet_elements_asset_jets.encode_asset (jet_elements_prim.utxoAsset (jet_elements_prim.sigTxiTxo txi)))
                  (jet_elements_amount_jets.encode_amount
                     (jet_elements_prim.utxoAmount (jet_elements_prim.sigTxiTxo txi))))
               (Word.from_hash256 (Digest.byteStringHash (jet_elements_input_hash_jets.utxo_script_bytes txi))))))
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
end
     : forall (_ : jet_elements_prim.Elements.env) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments elements_input_utxo_hash_result e i
