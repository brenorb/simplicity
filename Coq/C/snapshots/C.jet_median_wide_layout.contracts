         (fun
            xyz : Ty.tySem
                    (Ty.Prod (Word.Word (S (S (S (S O)))))
                       (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))) =>
          @jet_median_spec.median_word_spec (S (S (S (S O)))) Alg.CoreFunSem xyz)
