                       (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))) =>
          @jet_median_spec.median_word_spec (S (S (S (S (S O))))) Alg.CoreFunSem xyz)
### C.jet_median_wide_layout.median64_local_spec
median64_local_spec
     : jet_bitmachine_rep.jet_local_spec jets.f_simplicity_median_64
         (Ty.Prod (Word.Word (S (S (S (S (S (S O)))))))
            (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))))
