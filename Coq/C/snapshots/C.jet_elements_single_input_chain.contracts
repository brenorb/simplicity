### C.jet_elements_single_input_chain.eih_optional_length
eih_optional_length
     : forall h : option Digest.hash256,
       or (@eq nat (@length Integers.Int.int (jet_elements_single_input_payload.eih_optional_bytes h)) (S O))
         (@eq nat (@length Integers.Int.int (jet_elements_single_input_payload.eih_optional_bytes h))
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
### C.jet_elements_single_input_chain.eval_eih_payload
eval_eih_payload
     : forall (_ : jet_memcpy_model.memcpy_model) (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (m : Memory.Mem.mem) (bin : Values.block) (ofs : BinNums.Z) (pg : option Digest.hash256)
         (op : jet_elements_prim.outpoint) (sq : Integers.Int.int) (ax : option Digest.hash256)
         (_ : jet_elements_support_sha_ctxi.ctxi m bx bm (@nil Integers.Int.int) jet_sha256_iv_init.sha256_iv_words
                Integers.Int64.zero false) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bin bx)) (_ : not (@eq Values.block bin bm))
         (_ : forall (h : Digest.hash256) (_ : @eq (option Digest.hash256) pg (@Some Digest.hash256 h)),
              jet_uint32_array_init.uint32_array_at m bin
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (Digest.hash256_reg h))
         (_ : jet_uint32_array_init.uint32_array_at m bin
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))
                (Digest.hash256_reg (jet_elements_prim.opHash op)))
         (_ : forall (h : Digest.hash256) (_ : @eq (option Digest.hash256) ax (@Some Digest.hash256 h)),
              jet_uint32_array_init.uint32_array_at m bin ofs (Digest.hash256_reg h)),
       @ex Memory.Mem.mem
         (fun mP : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mH : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mI : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun mS : Memory.Mem.mem =>
                   @ex Memory.Mem.mem
                     (fun mA : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun mf : Memory.Mem.mem =>
                         @ex Values.val
                           (fun vI : Values.val =>
                            @ex Values.val
                              (fun vS : Values.val =>
                               @ex Values.val
                                 (fun vF : Values.val =>
                                  and
                                    (jet_elements_single_input_payload.eih_optional_calls bx bin
                                       (BinInt.Z.add ofs
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                       pg m mP)
                                    (and
                                       (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge mP
                                          (@Ctypes.Internal Clight.function jets_elements.f_sha256_hash)
                                          (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                             (@cons Values.val
                                                (Values.Vptr bin
                                                   (Integers.Ptrofs.repr
                                                      (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO ...)))))
                                                (@nil Values.val))) Events.E0 mH Values.Vundef)
                                       (and
                                          (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge
                                             mH (@Ctypes.Internal Clight.function jets_elements.f_sha256_u32be)
                                             (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                                (@cons Values.val
                                                   (Values.Vlong
                                                      (Integers.Int64.repr
                                                         (Integers.Int.unsigned (jet_elements_prim.opIndex op))))
                                                   (@nil Values.val))) Events.E0 mI vI)
                                          (and
                                             (ClightBigstep.Clight2.eval_funcall
                                                jet_elements_support_sha_linkage.sha_ge mI
                                                (@Ctypes.Internal Clight.function jets_elements.f_sha256_u32be)
                                                (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                                   (@cons Values.val
                                                      (Values.Vlong (Integers.Int64.repr (Integers.Int.unsigned sq)))
                                                      (@nil Values.val))) Events.E0 mS vS)
                                             (and
                                                (jet_elements_single_input_payload.eih_optional_calls bx bin ofs ax mS
                                                   mA)
                                                (and
                                                   (ClightBigstep.Clight2.eval_funcall
                                                      jet_elements_support_sha_linkage.sha_ge mA
                                                      (@Ctypes.Internal Clight.function jets_elements.f_sha256_finalize)
                                                      (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                                         (@nil Values.val)) Events.E0 mf vF)
                                                   (and
                                                      (forall (ch : AST.memory_chunk) (b : Values.block)
                                                         (o : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                                                         (_ : not (...)) (_ : not (...)),
                                                       @eq (option Values.val) (Memory.Mem.load ch mH b o)
                                                         (Memory.Mem.load ch m b o))
                                                      (and
                                                         (forall (ch : AST.memory_chunk) (b : Values.block)
                                                            (o : BinNums.Z) (_ : ...) (_ : ...)
                                                            (_ : ...), @eq (...) (...) (...))
                                                         (and (..., ...) (and ... ...))))))))))))))))))
### C.jet_elements_single_input_chain.eih_hash_of
eih_hash_of =
fun (pg : option Digest.hash256) (op : jet_elements_prim.outpoint) (sq : Integers.Int.int) (ax : option Digest.hash256)
=>
jet_bitcoin_composite_hash.sha256_bytes_of
  (jet_elements_single_input_hash_spec.elements_single_input_bytes
     match pg return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) with
     | Some h => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
     | None =>
         @inl unit
           (prod
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
     end
     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
        (Word.from_hash256 (jet_elements_prim.opHash op))
        (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
           (Integers.Int.unsigned (jet_elements_prim.opIndex op))))
     (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned sq))
     match ax return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) with
     | Some h => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
     | None =>
         @inl unit
           (prod
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
     end)
     : forall (_ : option Digest.hash256) (_ : jet_elements_prim.outpoint) (_ : Integers.Int.int)
         (_ : option Digest.hash256), Digest.hash256

Arguments eih_hash_of pg op sq ax
