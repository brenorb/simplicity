### C.jet_secp_fe_invert_rest.field_invert_rest_eq
field_invert_rest_eq
     : @eq Clight.statement field_invert_rest
         (Clight.Ssequence jet_secp_public_body.secp_public_read_stmt
            (Clight.Ssequence field_invert_inplace_stmt
               (Clight.Ssequence jet_secp_public_body.secp_public_write_stmt
                  (Clight.Sreturn
                     (@Some Clight.expr
                        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint))))))
### C.jet_secp_fe_invert_rest.field_invert_inplace_source
field_invert_inplace_source
     : @eq Clight.statement field_invert_inplace_stmt
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_inv_var jets_secp.f_secp256k1_fe_inv_var
            (@None AST.ident)
            (@cons Clight.expr
               (Clight.Eaddrof (Clight.Evar jets_secp._a jet_secp_public_body.secp_field_type)
                  (Ctypesdefs.tptr jet_secp_public_body.secp_field_type))
               (@cons Clight.expr
                  (Clight.Eaddrof (Clight.Evar jets_secp._a jet_secp_public_body.secp_field_type)
                     (Ctypesdefs.tptr jet_secp_public_body.secp_field_type)) (@nil Clight.expr))))
### C.jet_secp_fe_invert_rest.exec_public_field_invert
exec_public_field_invert
     : forall (le : Clight.temp_env) (m mf : Memory.Mem.mem) (bl ba : Values.block)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_inv_var)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_public_copy.secp_public_env bl ba) le m
         field_invert_inplace_stmt Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_fe_invert_rest.exec_field_invert_rest
exec_field_invert_rest
     : forall (le : Maps.PTree.tree Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bw : Values.block) (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bl : Values.block)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value)))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : not (@eq Values.block ba bl))
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : jet_secp_frame.invA m0 bd dbase bw outedge cursor N bi rc false (@nil BitMachine.Cell)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (jet_secp_wrapper_run.read_fe_rho
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                (@nil jet_sx_eval.event) m) (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_public_copy.secp_public_env bl ba) le m
               field_invert_rest Events.E0 le mf
               (ClightBigstep.Out_return
                  (@Some (prod Values.val Ctypes.type)
                     (@pair Values.val Ctypes.type (Values.Vint Integers.Int.one) Ctypesdefs.tint))))
            (and
               (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi mf true
                  (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                     (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem value)))
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bl BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                        Memtype.Freeable)
                     (and (jet_sx_mem.lframe (jet_secp_public_body.secp_locals_outside m0 bd bw bi ba bl) m mf)
                        (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                           (jet_clight_internal_preserve.readonly_preserved m mf)))))))
### C.jet_secp_fe_invert_rest.field_invert_inplace_stmt
field_invert_inplace_stmt =
match Clight.fn_body jets_secp.f_simplicity_fe_invert return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence invert _ => invert
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_fe_invert_rest.field_invert_rest
field_invert_rest =
match Clight.fn_body jets_secp.f_simplicity_fe_invert return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ rest => rest
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
