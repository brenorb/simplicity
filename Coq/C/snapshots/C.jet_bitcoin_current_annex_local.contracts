                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase)))) (_ : BinInt.Z.le BinNums.Z0 txbase)
         (_ : BinInt.Z.le (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add txbase BinNums.Z0))
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase)))),
