### C.jet_bitcoin_current_annex_local.eval_tx_input_expr
eval_tx_input_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (t : BinNums.positive)
         (bt : Values.block) (txbase : BinNums.Z) (bin : Values.block) (inbase : BinNums.Z)
