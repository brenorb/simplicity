### C.jet_secp_ge_set_xy_indexed.eval_ge_set_xy_indexed
eval_ge_set_xy_indexed
     : forall (x y : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bd : Values.block)
         (base : BinNums.Z) (bp : Values.block) (_ : not (@eq Values.block bd bp)) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m bd base
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_xy)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vptr bp
                           (Integers.Ptrofs.repr
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf bd base (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf bd
                     (BinInt.Z.add base
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bd
                           (BinInt.Z.add base
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (Memory.Mem.range_perm mf bd base
                           (BinInt.Z.add base
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind)
                              (p : Memtype.permission),
                            iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p))
                           (and
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (pos : BinNums.Z) =>
                                  or (not (@eq Values.block b bd))
                                    (or (BinInt.Z.lt pos base)
                                       (BinInt.Z.le
                                          (BinInt.Z.add base
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                          pos))) m mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))))
### C.jet_secp_ge_set_xy_indexed.ge_set_xy_indexed_temps
ge_set_xy_indexed_temps =
fun (bd : Values.block) (base : BinNums.Z) (bp : Values.block) =>
@Maps.PTree.set Values.val jets_secp._y
  (Values.Vptr bp
     (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
  (@Maps.PTree.set Values.val jets_secp._x (Values.Vptr bp Integers.Ptrofs.zero)
     (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr bd (Integers.Ptrofs.repr base))
        (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_ge_set_xy))))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block), Maps.PTree.tree Values.val

Arguments ge_set_xy_indexed_temps bd base%Z_scope bp
