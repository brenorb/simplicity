### C.jet_full_increment8_exec.full_increment8_carry_expr
full_increment8_carry_expr =
Clight.Ebinop Cop.Olt
  (Clight.Ebinop Cop.Osub
     (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
        (Clight.Econst_int
           (Integers.Int.repr
              (BinNums.Zpos
                 (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
           Ctypesdefs.tint) Ctypesdefs.tuint) (Clight.Etempvar jets._z Ctypesdefs.tbool) Ctypesdefs.tuint)
  (Clight.Etempvar jets._x Ctypesdefs.tuchar) Ctypesdefs.tint
     : Clight.expr
### C.jet_full_increment8_exec.full_increment8_sum_expr
full_increment8_sum_expr =
Clight.Ecast
  (Clight.Ebinop Cop.Oadd
     (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
        (Clight.Etempvar jets._x Ctypesdefs.tuchar) Ctypesdefs.tuint) (Clight.Etempvar jets._z Ctypesdefs.tbool)
     Ctypesdefs.tuint) Ctypesdefs.tuchar
     : Clight.expr
