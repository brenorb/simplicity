                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bi BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z baz BinNums.Z0)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                        (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bv BinNums.Z0)
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                           (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bu BinNums.Z0)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                              (@pair (prod Values.block BinNums.Z) BinNums.Z
                                 (@pair Values.block BinNums.Z b2 BinNums.Z0)
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
