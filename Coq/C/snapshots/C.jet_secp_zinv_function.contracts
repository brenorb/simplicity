### C.jet_secp_zinv_function.eval_zinv_function_finite
eval_zinv_function_finite
     : forall (x y z u v inv : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bp ba bb : Values.block)
         (_ : @List.NoDup Values.block
                (@cons Values.block bp (@cons Values.block ba (@cons Values.block bb (@nil Values.block)))))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : jet_secp_square_columns.square_input_bounds u)
         (_ : jet_secp_square_columns.square_input_bounds v) (_ : jet_secp_square_columns.square_input_bounds inv)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 v))
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_add_zinv_var)
               (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bp BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_zinv_finite.zinv_finite_x x y z u v inv)))
               (and
                  (jet_secp_fe_nv.fe_at mf bp
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 (jet_secp_zinv_finite.zinv_finite_y x y z u v inv)))
                  (and
                     (jet_secp_fe_nv.fe_at mf bp
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_zinv_finite.zinv_finite_z x y z u v inv)))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf bp
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                           (@Some Values.val (Values.Vint (jet_secp_zinv_finite.zinv_finite_flag x y z u v inv))))
                        (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
                           (and
                              (jet_secp_fe_nv.fe_at mf ba
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 (jet_secp_multiply_normalize_bridge.words5 v))
                              (and
                                 (jet_secp_fe_nv.fe_at mf bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                                 (and
                                    (Memory.Mem.range_perm mf bp BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (Memory.Mem.range_perm mf ba BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (Memory.Mem.range_perm mf bb BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (jet_secp_square_columns.square_input_bounds
                                                (jet_secp_zinv_finite.zinv_finite_x x y z u v inv))
                                             (and
                                                (jet_secp_square_columns.square_input_bounds
                                                   (jet_secp_zinv_finite.zinv_finite_y x y z u v inv))
                                                (and
                                                   (jet_secp_square_columns.square_input_bounds
                                                      (jet_secp_zinv_finite.zinv_finite_z x y z u v inv))
                                                   (jet_sx_mem.lframe
                                                      (fun (b : Values.block) (_ : BinNums.Z) =>
                                                       and (not (@eq Values.block b bp))
                                                         (and (not (@eq Values.block b ba))
                                                            (not (@eq Values.block b bb)))) m mf)))))))))))))))
### C.jet_secp_zinv_function.zinv_helper_env
zinv_helper_env =
fun baz bz bu bv bs bt bh bi b2 b3 bk binv2 binv3 : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._bzinv3
  (@pair Values.block Ctypes.type binv3 jet_secp_curve_statements.curve_fe_type)
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._bzinv2
     (@pair Values.block Ctypes.type binv2 jet_secp_curve_statements.curve_fe_type)
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._t
        (@pair Values.block Ctypes.type bk jet_secp_curve_statements.curve_fe_type)
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._h3
           (@pair Values.block Ctypes.type b3 jet_secp_curve_statements.curve_fe_type)
           (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._h2
              (@pair Values.block Ctypes.type b2 jet_secp_curve_statements.curve_fe_type)
              (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._i
                 (@pair Values.block Ctypes.type bi jet_secp_curve_statements.curve_fe_type)
                 (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._h
                    (@pair Values.block Ctypes.type bh jet_secp_curve_statements.curve_fe_type)
                    (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._s2
                       (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)
                       (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._s1
                          (@pair Values.block Ctypes.type bs jet_secp_curve_statements.curve_fe_type)
                          (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._u2
                             (@pair Values.block Ctypes.type bv jet_secp_curve_statements.curve_fe_type)
                             (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._u1
                                (@pair Values.block Ctypes.type bu jet_secp_curve_statements.curve_fe_type)
                                (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._z12
                                   (@pair Values.block Ctypes.type bz jet_secp_curve_statements.curve_fe_type)
                                   (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._az
                                      (@pair Values.block Ctypes.type baz jet_secp_curve_statements.curve_fe_type)
                                      Clight.empty_env))))))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments zinv_helper_env baz bz bu bv bs bt bh bi b2 b3 bk binv2 binv3
### C.jet_secp_zinv_function.zinv_entry_temps
zinv_entry_temps =
fun bp ba bb : Values.block =>
@Maps.PTree.set Values.val jets_secp._bzinv (Values.Vptr bb Integers.Ptrofs.zero)
  (@Maps.PTree.set Values.val jets_secp._b (Values.Vptr ba Integers.Ptrofs.zero)
     (@Maps.PTree.set Values.val jets_secp._a (Values.Vptr bp Integers.Ptrofs.zero)
        (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr bp Integers.Ptrofs.zero)
           (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_gej_add_zinv_var)))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block), Maps.PTree.tree Values.val

Arguments zinv_entry_temps bp ba bb
