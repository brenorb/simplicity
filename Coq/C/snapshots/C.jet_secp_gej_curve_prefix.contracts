### C.jet_secp_gej_curve_prefix.gej_curve_frame
gej_curve_frame =
fun (ba b_y bx bz b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b ba))
  (and (not (@eq Values.block b b_y)) (and (not (@eq Values.block b bx)) (not (@eq Values.block b bz))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments gej_curve_frame ba b_y bx bz b _%Z_scope
### C.jet_secp_gej_curve_prefix.gej_curve_input_readback
gej_curve_input_readback =
fun (m mf : Memory.Mem.mem) (ba : Values.block) (x y z : forall _ : nat, Integers.Int64.int) =>
and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
  (and
     (jet_secp_fe_nv.fe_at mf ba
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
        (jet_secp_multiply_normalize_bridge.words5 y))
     (and
        (jet_secp_fe_nv.fe_at mf ba
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
           (jet_secp_multiply_normalize_bridge.words5 z))
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint32 mf ba
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
           (Memory.Mem.load AST.Mint32 m ba
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments gej_curve_input_readback m mf ba (x y z)%function_scope
