### C.jet_secp_gej_curve_prefix.gej_curve_prefix_calls
gej_curve_prefix_calls
     : forall (x y z : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba b_y bx bz : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : not (@eq Values.block ba b_y))
         (_ : not (@eq Values.block ba bx)) (_ : not (@eq Values.block ba bz)) (_ : not (@eq Values.block b_y bx))
         (_ : not (@eq Values.block b_y bz)) (_ : not (@eq Values.block bx bz))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b_y BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m2 : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun m3 : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun m4 : Memory.Mem.mem =>
                   @ex Memory.Mem.mem
                     (fun mf : Memory.Mem.mem =>
                      and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                           (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                           (@cons Values.val (Values.Vptr b_y Integers.Ptrofs.zero)
                              (@cons Values.val
                                 (Values.Vptr ba
                                    (Integers.Ptrofs.repr
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                 (@nil Values.val))) Events.E0 m1 Values.Vundef)
                        (and
                           (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m1
                              (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                              (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0
                              m2 Values.Vundef)
                           (and
                              (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m2
                                 (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                                 (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                       (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))))
                                 Events.E0 m3 Values.Vundef)
                              (and
                                 (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m3
                                    (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                                    (@cons Values.val (Values.Vptr bz Integers.Ptrofs.zero)
                                       (@cons Values.val
                                          (Values.Vptr ba
                                             (Integers.Ptrofs.repr
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                                          (@nil Values.val))) Events.E0 m4 Values.Vundef)
                                 (and
                                    (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m4
                                       (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                                       (@cons Values.val (Values.Vptr bz Integers.Ptrofs.zero)
                                          (@cons Values.val (Values.Vptr bz Integers.Ptrofs.zero)
                                             (@cons Values.val
                                                (Values.Vptr ba
                                                   (Integers.Ptrofs.repr
                                                      (BinNums.Zpos
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))
                                                (@nil Values.val)))) Events.E0 mf Values.Vundef)
                                    (and
                                       (jet_secp_fe_nv.fe_at mf b_y BinNums.Z0
                                          (jet_secp_multiply_normalize_bridge.words5
                                             (jet_secp_square_numeric.square_words y)))
                                       (and
                                          (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                                             (jet_secp_multiply_normalize_bridge.words5
                                                (jet_secp_point_mul_storage.point_mul_words
                                                   (jet_secp_square_numeric.square_words x) x)))
                                          (and
                                             (jet_secp_fe_nv.fe_at mf bz BinNums.Z0
                                                (jet_secp_multiply_normalize_bridge.words5
                                                   (jet_secp_point_mul_storage.point_mul_words
                                                      (jet_secp_square_numeric.square_words z) z)))
                                             (and
                                                (Memory.Mem.range_perm mf ba BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (and
                                                   (Memory.Mem.range_perm mf b_y BinNums.Z0
                                                      (BinNums.Zpos
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))
                                                      Memtype.Cur Memtype.Freeable)
                                                   (and
                                                      (Memory.Mem.range_perm mf bx BinNums.Z0
                                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))
                                                         Memtype.Cur Memtype.Freeable)
                                                      (and
                                                         (Memory.Mem.range_perm mf bz BinNums.Z0
                                                            (BinNums.Zpos (BinNums.xO (BinNums.xO ...))) Memtype.Cur
                                                            Memtype.Freeable)
                                                         (and
                                                            (@eq BinNums.Z
                                                               (BinInt.Z.modulo
                                                                  (jet_secp_multiply_finish_product.radix_value ...)
                                                                  jet_secp_fe_math.feP)
                                                               (BinInt.Z.modulo (BinInt.Z.mul ... ...)
                                                                  jet_secp_fe_math.feP))
                                                            (and
                                                               (@eq BinNums.Z
                                                                  (BinInt.Z.modulo ... jet_secp_fe_math.feP)
                                                                  (BinInt.Z.modulo ... jet_secp_fe_math.feP))
                                                               (and (@eq BinNums.Z ... ...) (and ... ...))))))))))))))))))))
### C.jet_secp_gej_curve_prefix.gej_curve_frame
gej_curve_frame =
fun (ba b_y bx bz b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b ba))
  (and (not (@eq Values.block b b_y)) (and (not (@eq Values.block b bx)) (not (@eq Values.block b bz))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments gej_curve_frame ba b_y bx bz b _%Z_scope
