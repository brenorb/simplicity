### C.jet_secp_swu_roots.swu_roots_source
swu_roots_source
     : @eq Clight.statement jet_secp_swu_cubics.swu_after_cubics
         (jet_secp_statement_prefix.statement_sequence swu_roots_statements swu_after_roots)
### C.jet_secp_swu_roots.swu_root_closed
swu_root_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers
            (Clight.fn_body jets_secp.f_secp256k1_fe_sqrt_var)) true
### C.jet_secp_swu_roots.exec_swu_root_call
exec_swu_root_call
     : forall (result : option AST.ident) (r a : BinNums.positive)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env) (m mf : Memory.Mem.mem)
         (br ba : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqrt_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) r e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) a e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqrt_var)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                (swu_root_value w)),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (swu_root_call result r a) Events.E0
         (Clight.set_opttemp result (swu_root_value w) le) mf ClightBigstep.Out_normal
### C.jet_secp_swu_roots.exec_swu_root_step
exec_swu_root_step
     : forall (save : option (prod AST.ident AST.ident)) (r a : BinNums.positive)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (br ba : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqrt_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) r e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) a e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : not (@eq Values.block ba br)) (_ : jet_secp_root_chain_numeric.root_words_match w x)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (swu_root_step save r a) Events.E0
               (swu_root_temps save w le) mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_root_chain_numeric.root_chain_candidate w)))
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf br BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_secp_square_columns.square_input_bounds
                           (jet_secp_root_chain_numeric.root_chain_candidate w))
                        (and
                           (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (jet_secp_rescale_literal.rescale_field_output
                                 (jet_secp_root_chain_numeric.root_chain_candidate w))
                              (jet_secp_root_chain_numeric.literal_root_candidate x))
                           (and
                              (@eq bool (jet_secp_root_check.root_check_flag w)
                                 (Bit.toBool (jet_secp_root_check.literal_root_check x)))
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b ba)) (not (@eq Values.block b br))) m mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
### C.jet_secp_swu_roots.swu_roots_temps_alpha
swu_roots_temps_alpha
     : forall (a b : forall _ : nat, Integers.Int64.int) (le : Maps.PTree.tree Values.val),
       @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._alphaquad (swu_roots_temps a b le))
         (@Some Values.val (swu_root_value a))
### C.jet_secp_swu_roots.swu_roots_temps_beta
swu_roots_temps_beta
     : forall (a b : forall _ : nat, Integers.Int64.int) (le : Maps.PTree.tree Values.val),
       @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._betaquad (swu_roots_temps a b le))
         (@Some Values.val (swu_root_value b))
### C.jet_secp_swu_roots.swu_roots_temps_other
swu_roots_temps_other
     : forall (a b : forall _ : nat, Integers.Int64.int) (le : Maps.PTree.tree Values.val)
         (id : AST.ident) (_ : not (@eq AST.ident id jets_secp._alphaquad)) (_ : not (@eq AST.ident id jets_secp._t'1))
         (_ : not (@eq AST.ident id jets_secp._betaquad)) (_ : not (@eq AST.ident id jets_secp._t'2)),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (swu_roots_temps a b le))
         (@Maps.PTree.get Values.val id le)
### C.jet_secp_swu_roots.exec_swu_roots
exec_swu_roots
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bA bB bC by1 by2 by3 : Values.block) (a b c : forall _ : nat, Integers.Int64.int)
         (x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqrt_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._alphain e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bA jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._betain e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bB jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._gammain e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bC jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._y1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type by1 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._y2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type by2 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._y3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type by3 jet_secp_curve_statements.curve_fe_type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bA
                   (@cons Values.block bB
                      (@cons Values.block bC
                         (@cons Values.block by1 (@cons Values.block by2 (@cons Values.block by3 (@nil Values.block))))))))
         (_ : jet_secp_root_chain_numeric.root_words_match a x) (_ : jet_secp_root_chain_numeric.root_words_match b y)
         (_ : jet_secp_root_chain_numeric.root_words_match c z)
         (_ : jet_secp_fe_nv.fe_at m bA BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : jet_secp_fe_nv.fe_at m bB BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : jet_secp_fe_nv.fe_at m bC BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 c))
         (_ : @List.Forall Values.block
                (fun bi : Values.block =>
                 Memory.Mem.range_perm m bi BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   Memtype.Cur Memtype.Freeable)
                (@cons Values.block bA
                   (@cons Values.block bB
                      (@cons Values.block bC
                         (@cons Values.block by1 (@cons Values.block by2 (@cons Values.block by3 (@nil Values.block)))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_roots_prefix Events.E0
               (swu_roots_temps a b le) mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf by1 BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_root_chain_numeric.root_chain_candidate a)))
               (and
                  (jet_secp_fe_nv.fe_at mf by2 BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (jet_secp_root_chain_numeric.root_chain_candidate b)))
                  (and
                     (jet_secp_fe_nv.fe_at mf by3 BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_root_chain_numeric.root_chain_candidate c)))
                     (and
                        (@List.Forall Values.block
                           (fun bi : Values.block =>
                            Memory.Mem.range_perm mf bi BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (@cons Values.block bA
                              (@cons Values.block bB
                                 (@cons Values.block bC
                                    (@cons Values.block by1
                                       (@cons Values.block by2 (@cons Values.block by3 (@nil Values.block))))))))
                        (and
                           (@List.Forall (forall _ : nat, Integers.Int64.int)
                              jet_secp_square_columns.square_input_bounds
                              (@cons (forall _ : nat, Integers.Int64.int)
                                 (jet_secp_root_chain_numeric.root_chain_candidate a)
                                 (@cons (forall _ : nat, Integers.Int64.int)
                                    (jet_secp_root_chain_numeric.root_chain_candidate b)
                                    (@cons (forall _ : nat, Integers.Int64.int)
                                       (jet_secp_root_chain_numeric.root_chain_candidate c)
                                       (@nil (forall _ : nat, Integers.Int64.int))))))
                           (and
                              (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (jet_secp_rescale_literal.rescale_field_output
                                    (jet_secp_root_chain_numeric.root_chain_candidate a))
                                 (jet_secp_root_chain_numeric.literal_root_candidate x))
                              (and
                                 (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (jet_secp_rescale_literal.rescale_field_output
                                       (jet_secp_root_chain_numeric.root_chain_candidate b))
                                    (jet_secp_root_chain_numeric.literal_root_candidate y))
                                 (and
                                    (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (jet_secp_rescale_literal.rescale_field_output
                                          (jet_secp_root_chain_numeric.root_chain_candidate c))
                                       (jet_secp_root_chain_numeric.literal_root_candidate z))
                                    (and
                                       (@eq bool (jet_secp_root_check.root_check_flag a)
                                          (Bit.toBool (jet_secp_root_check.literal_root_check x)))
                                       (and
                                          (@eq bool (jet_secp_root_check.root_check_flag b)
                                             (Bit.toBool (jet_secp_root_check.literal_root_check y)))
                                          (and
                                             (@eq bool (jet_secp_root_check.root_check_flag c)
                                                (Bit.toBool (jet_secp_root_check.literal_root_check z)))
                                             (and
                                                (jet_sx_mem.lframe
                                                   (fun (bi : Values.block) (_ : BinNums.Z) =>
                                                    not
                                                      (@List.In Values.block bi
                                                         (@cons Values.block bA
                                                            (@cons Values.block bB
                                                               (@cons Values.block bC
                                                                  (@cons Values.block by1
                                                                     (@cons Values.block by2 (...)))))))) m mf)
                                                (jet_clight_internal_preserve.readonly_preserved m mf))))))))))))))
### C.jet_secp_swu_roots.swu_root_call
swu_root_call =
fun (result : option AST.ident) (r a : AST.ident) =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_sqrt_var jets_secp.f_secp256k1_fe_sqrt_var result
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address r)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address a) (@nil Clight.expr)))
     : forall (_ : option AST.ident) (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments swu_root_call result r a
### C.jet_secp_swu_roots.swu_root_step
swu_root_step =
fun (save : option (prod AST.ident AST.ident)) (r a : AST.ident) =>
match save return Clight.statement with
| Some p =>
    match p return Clight.statement with
    | pair tmp flag =>
        Clight.Ssequence (swu_root_call (@Some AST.ident tmp) r a)
          (Clight.Sset flag (Clight.Etempvar tmp Ctypesdefs.tint))
    end
| None => swu_root_call (@None AST.ident) r a
end
     : forall (_ : option (prod AST.ident AST.ident)) (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments swu_root_step save r a
### C.jet_secp_swu_roots.swu_root_value
swu_root_value =
fun w : forall _ : nat, Integers.Int64.int =>
Values.Vint
  match jet_secp_root_check.root_check_flag w return Integers.Int.int with
  | true => Integers.Int.one
  | false => Integers.Int.zero
  end
     : forall _ : forall _ : nat, Integers.Int64.int, Values.val

Arguments swu_root_value w%function_scope
### C.jet_secp_swu_roots.swu_root_temps
swu_root_temps =
fun (save : option (prod AST.ident AST.ident)) (w : forall _ : nat, Integers.Int64.int)
  (le : Maps.PTree.tree Values.val) =>
match save return (Maps.PTree.tree Values.val) with
| Some p =>
    match p return (Maps.PTree.tree Values.val) with
    | pair tmp flag =>
        @Maps.PTree.set Values.val flag (swu_root_value w) (@Maps.PTree.set Values.val tmp (swu_root_value w) le)
    end
| None => le
end
     : forall (_ : option (prod AST.ident AST.ident)) (_ : forall _ : nat, Integers.Int64.int)
         (_ : Maps.PTree.tree Values.val), Maps.PTree.tree Values.val

Arguments swu_root_temps save w%function_scope le
### C.jet_secp_swu_roots.swu_roots_statements
swu_roots_statements =
@cons Clight.statement
  (swu_root_step (@Some (prod AST.ident AST.ident) (@pair AST.ident AST.ident jets_secp._t'1 jets_secp._alphaquad))
     jets_secp._y1 jets_secp._alphain)
  (@cons Clight.statement
     (swu_root_step (@Some (prod AST.ident AST.ident) (@pair AST.ident AST.ident jets_secp._t'2 jets_secp._betaquad))
        jets_secp._y2 jets_secp._betain)
     (@cons Clight.statement (swu_root_step (@None (prod AST.ident AST.ident)) jets_secp._y3 jets_secp._gammain)
        (@nil Clight.statement)))
     : list Clight.statement
### C.jet_secp_swu_roots.swu_roots_prefix
swu_roots_prefix =
jet_secp_statement_prefix.statement_sequence swu_roots_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_swu_roots.swu_after_roots
swu_after_roots =
match jet_secp_swu_cubics.swu_after_cubics return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ rest => rest
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_swu_roots.swu_roots_temps
swu_roots_temps =
fun (a b : forall _ : nat, Integers.Int64.int) (le : Maps.PTree.tree Values.val) =>
swu_root_temps (@Some (prod AST.ident AST.ident) (@pair AST.ident AST.ident jets_secp._t'2 jets_secp._betaquad)) b
  (swu_root_temps (@Some (prod AST.ident AST.ident) (@pair AST.ident AST.ident jets_secp._t'1 jets_secp._alphaquad)) a
     le)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : Maps.PTree.tree Values.val), Maps.PTree.tree Values.val

Arguments swu_roots_temps (a b)%function_scope le
