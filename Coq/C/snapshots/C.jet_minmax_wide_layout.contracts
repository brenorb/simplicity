         (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s)))
         (Word.Word (jet_wide.wide_log s))
         (fun xy : Ty.tySem (Ty.Prod (Word.Word (jet_wide.wide_log s)) (Word.Word (jet_wide.wide_log s))) =>
          @jet_minmax_spec.minmax_word_spec (jet_wide.wide_log s) maximum Alg.CoreFunSem xy)
