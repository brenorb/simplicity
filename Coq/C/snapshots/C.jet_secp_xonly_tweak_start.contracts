### C.jet_secp_xonly_tweak_start.exec_xonly_tweak_clear
exec_xonly_tweak_clear
     : forall (_ : jet_memset_model.memset_model) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bout : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._memset e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._output_pubkey le)
                (@Some Values.val (Values.Vptr bout Integers.Ptrofs.zero)))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mz : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               jet_secp_xonly_tweak_entry.xonly_tweak_clear Events.E0 le mz ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mz bout BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and (jet_clight_internal_permissions.keeps_permissions m mz)
                  (and
                     (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m mz)
                     (jet_clight_internal_preserve.readonly_preserved m mz)))))
### C.jet_secp_xonly_tweak_start.exec_xonly_tweak_start
exec_xonly_tweak_start
     : forall (_ : jet_memset_model.memset_model) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bout bin bb : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._memset e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._output_pubkey le)
                (@Some Values.val (Values.Vptr bout Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._internal_pubkey le)
                (@Some Values.val (Values.Vptr bin Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._tweak32 le)
                (@Some Values.val (Values.Vptr bb Integers.Ptrofs.zero)))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : @eq bool (Memory.Mem.weak_valid_pointer m bin BinNums.Z0) true)
         (_ : @eq bool (Memory.Mem.weak_valid_pointer m bb BinNums.Z0) true),
       @ex Memory.Mem.mem
         (fun mz : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence jet_secp_xonly_tweak_entry.xonly_tweak_start_statements
                  Clight.Sskip) Events.E0 le mz ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mz bout BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  Memtype.Cur Memtype.Freeable)
               (and (jet_clight_internal_permissions.keeps_permissions m mz)
                  (and
                     (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m mz)
                     (jet_clight_internal_preserve.readonly_preserved m mz)))))
