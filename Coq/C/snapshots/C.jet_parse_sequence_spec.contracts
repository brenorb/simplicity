                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))
              (Ty.Prod
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))
              (Ty.Prod
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))) term
              (@SC.iden
                 (Ty.Prod
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))) term)))))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))

Arguments parse_sequence_spec {term}
### C.jet_parse_sequence_spec.parse_sequence_enabled
parse_sequence_enabled =
fun r : Integers.Int64.int =>
Integers.Int64.ltu r
  (Integers.Int64.shl Integers.Int64.one
     (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
     : forall _ : Integers.Int64.int, bool

Arguments parse_sequence_enabled r
### C.jet_parse_sequence_spec.parse_sequence_tag
parse_sequence_tag =
fun r : Integers.Int64.int =>
negb
  (Integers.Int64.eq
     (Integers.Int64.and r
        (Integers.Int64.shl Integers.Int64.one
           (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
     Integers.Int64.zero)
     : forall _ : Integers.Int64.int, bool

Arguments parse_sequence_tag r
### C.jet_parse_sequence_spec.parse_sequence_payload
parse_sequence_payload =
fun r : Integers.Int64.int =>
Integers.Int64.and r
  (Integers.Int64.repr
     (BinNums.Zpos
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
     : forall _ : Integers.Int64.int, Integers.Int64.int

Arguments parse_sequence_payload r
