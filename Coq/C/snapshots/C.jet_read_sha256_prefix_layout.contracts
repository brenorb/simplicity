### C.jet_read_sha256_prefix_layout.read_sha256_prefix_layout
read_sha256_prefix_layout
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bi : Values.block)
         (edge cursor : BinNums.Z) (bc : Values.block) (cbase : BinNums.Z) (bl : Values.block)
         (buf : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
         (count : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (state : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : BinInt.Z.le BinNums.Z0 cbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bc
                (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Writable)
         (_ : Memory.Mem.valid_access m AST.Mint64 bc
                (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl BinNums.Z0 Memtype.Writable) (_ : not (@eq Values.block bf bc))
         (_ : not (@eq Values.block bf bi)) (_ : not (@eq Values.block bc bi)) (_ : not (@eq Values.block bl bf))
         (_ : not (@eq Values.block bl bc)) (_ : not (@eq Values.block bl bi))
         (_ : jet_frame_layout.frame_base_valid base) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge cursor
                (@app BitMachine.Cell
                   (@Translate.encode
                      (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) buf)
                   (@app BitMachine.Cell (@Translate.encode (Word.Word (S (S (S (S (S (S O))))))) count)
                      (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) state)))),
       @ex Memory.Mem.mem
         (fun mb : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mc : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun md : Memory.Mem.mem =>
                @ex Integers.Int64.int
                  (fun r : Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                        (@Ctypes.Internal Clight.function jets.f_simplicity_read_buffer8)
                        (@cons Values.val
                           (Values.Vptr bc
                              (Integers.Ptrofs.repr
                                 (BinInt.Z.add cbase
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                                 (@cons Values.val
                                    (Values.Vint
                                       (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                                    (@nil Values.val))))) Events.E0 mb Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb
                           (@Ctypes.Internal Clight.function jets.f_simplicity_read64)
                           (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0
                           mc (Values.Vlong r))
                        (and
                           (@eq BinNums.Z (Integers.Int64.unsigned r)
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count))
                           (and
                              (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mc bl BinNums.Z0)
                                 (@Some Values.val
                                    (Values.Vlong
                                       (Integers.Int64.repr
                                          (BinInt.Z.of_nat
                                             (@length (Ty.tySem (Word.Word (S (S (S O)))))
                                                (jet_buffer_chunks.byte_chunks_values
                                                   (jet_buffer_input.buffer_byte_chunks (S (S (S (S (S O))))) buf))))))))
                              (and
                                 (@eq (option Memory.Mem.mem)
                                    (Memory.Mem.store AST.Mint64 mc bc
                                       (BinInt.Z.add cbase
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                       (Values.Vlong
                                          (jet_read_sha256_counter.sha256_read_counter r
                                             (Integers.Int64.repr
                                                (BinInt.Z.of_nat
                                                   (@length (Ty.tySem (Word.Word (S (S (S O)))))
                                                      (jet_buffer_chunks.byte_chunks_values
                                                         (jet_buffer_input.buffer_byte_chunks (S (S (S (...)))) buf))))))))
                                    (@Some Memory.Mem.mem md))
                                 (and
                                    (jet_read8s_layout.uint8_array_at md bc
                                       (BinInt.Z.add cbase
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int
                                          jet_read8s_layout.word8_array_value
                                          (jet_buffer_chunks.byte_chunks_values
                                             (jet_buffer_input.buffer_byte_chunks (S (S (S (S (S O))))) buf))))
                                    (and
                                       (jet_frame_layout.frame_fields_at md bf base bi edge
                                          (BinInt.Z.add cursor
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (...)))))))))))
                                       (and
                                          (jet_encoding.frame_input_cells_at md bi edge
                                             (BinInt.Z.add cursor
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))
                                             (@Translate.encode (Word.Word (S (S (S (S (S (S (...)))))))) state))
                                          (and
                                             (forall (chunk : AST.memory_chunk) (b : Values.block)
                                                (ofs : BinNums.Z)
                                                (_ : or (not (@eq Values.block b bf))
                                                       (or
                                                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                             (BinInt.Z.add base
                                                                (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))))
                                                          (BinInt.Z.le
                                                             (BinInt.Z.add base
                                                                (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))) ofs)))
                                                (_ : or (not (@eq Values.block b bc))
                                                       (or
                                                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                             (BinInt.Z.add cbase
                                                                (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))))
                                                          (BinInt.Z.le
                                                             (BinInt.Z.add cbase
                                                                (BinNums.Zpos (BinNums.xI (BinNums.xI ...)))) ofs)))
                                                (_ : or (not (@eq Values.block b bl))
                                                       (or
                                                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                             BinNums.Z0)
                                                          (BinInt.Z.le
                                                             (BinNums.Zpos
                                                                (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) ofs))),
                                              @eq (option Values.val) (Memory.Mem.load chunk md b ofs)
                                                (Memory.Mem.load chunk m b ofs))
                                             (and
                                                (forall (b : Values.block) (ofs : BinNums.Z)
                                                   (kind : Memtype.perm_kind) (p : Memtype.permission)
                                                   (_ : Memory.Mem.perm m b ofs kind p),
                                                 Memory.Mem.perm md b ofs kind p)
                                                (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                                 Memory.Mem.valid_block md b))))))))))))))
