### C.jet_tapdata_literal.literal_tapdata_one64_matches
literal_tapdata_one64_matches
     : forall term : Alg.Core.Algebra,
       @eq (Alg.Core.domain term Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) (@literal_tapdata_one64 term)
         (@jet_sha_tapdata_spec.one64_spec term)
### C.jet_tapdata_literal.literal_tapdata_init_matches
literal_tapdata_init_matches
     : forall term : Alg.Core.Algebra,
       @eq (Alg.Core.domain term Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type) (@literal_tapdata_init term)
         (@jet_sha_tapdata_spec.tapdata_init_spec term)
### C.jet_tapdata_literal.literal_tapdata_one64
literal_tapdata_one64 =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector (Word.Word O) (S (S (S (S (S (S O))))))) term
  (@Bit.true Ty.Unit term) (@jet_core_pad_spec.left_pad_low_spec term O (S (S (S (S (S (S O)))))))
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))

Arguments literal_tapdata_one64 {term}
### C.jet_tapdata_literal.literal_tapdata_init
literal_tapdata_init =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.pair Ty.Unit (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
  (@jet_buffer_empty_spec.buffer_empty_spec (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) Ty.Unit term)
  (@Alg.Core.Combinators.pair Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term (@literal_tapdata_one64 term)
     (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) jet_tapdata_host_recipe.tap_host_prefix term))
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type

Arguments literal_tapdata_init {term}
