### C.jet_secp_field_zero_readonly.field_zero_memory
field_zero_memory
     : forall (m mf : Memory.Mem.mem) (args : list Values.val) (v : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_zero) args Events.E0 mf v),
       @eq Memory.Mem.mem mf m
### C.jet_secp_field_zero_readonly.eval_field_zero_readonly
eval_field_zero_readonly
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
         (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_zero)
         (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 m
         (Values.Vint
            match Integers.Int64.eq (field_words_or w) Integers.Int64.zero return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
### C.jet_secp_field_zero_readonly.field_words_or_zero
field_words_or_zero
     : forall (w : forall _ : nat, Integers.Int64.int)
         (_ : @eq bool (Integers.Int64.eq (field_words_or w) Integers.Int64.zero) true),
       @eq BinNums.Z (jet_secp_multiply_finish_product.radix_value w) BinNums.Z0
### C.jet_secp_field_zero_readonly.eval_field_nonzero_readonly
eval_field_nonzero_readonly
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value w) BinNums.Z0)),
       ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
         (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_zero)
         (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 m
         (Values.Vint Integers.Int.zero)
