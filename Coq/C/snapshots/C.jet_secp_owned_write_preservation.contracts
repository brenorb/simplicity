### C.jet_secp_owned_write_preservation.owned_write_preserves_field
owned_write_preserves_field
     : forall (size : BinNums.Z) (m mf m0 : Memory.Mem.mem) (bd bw bi b : Values.block)
         (k j : jet_secp_point_write_run.point_coordinate) (limbs : list Integers.Int64.int)
         (_ : not (@eq jet_secp_point_write_run.point_coordinate k j))
         (_ : BinInt.Z.le
                (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset j)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : @eq nat (@length Integers.Int64.int limbs) (S (S (S (S (S O))))))
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset j) limbs)
         (_ : Memory.Mem.range_perm mf b BinNums.Z0 size Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : jet_sx_mem.lframe
                (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))) (jet_secp_owned_write_run.owned_write_initial_regs size k)
                   m) m mf), jet_secp_fe_nv.fe_at mf b (jet_secp_point_write_run.point_coordinate_offset j) limbs
### C.jet_secp_owned_write_preservation.owned_write_outside_owner
owned_write_outside_owner
     : forall (size : BinNums.Z) (m mf m0 : Memory.Mem.mem) (bd bw bi b : Values.block)
         (k : jet_secp_point_write_run.point_coordinate)
         (_ : jet_sx_mem.lframe
                (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))) (jet_secp_owned_write_run.owned_write_initial_regs size k)
                   m) m mf),
       jet_sx_mem.lframe
         (fun (bx : Values.block) (_ : BinNums.Z) =>
          and (not (@eq Values.block bx b)) (not (jet_secp_frame.extA m0 bd bw bi bx))) m mf
