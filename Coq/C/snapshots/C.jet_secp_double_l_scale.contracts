### C.jet_secp_double_l_scale.eval_double_l_scale
eval_double_l_scale
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_field_mul_small.mul_small_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mm : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul_int)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))))
                        (@nil Values.val))) Events.E0 mm Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mm
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_half)
                     (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
                     Values.Vundef)
                  (and
                     (jet_secp_fe_nv.fe_at mf b BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (double_l_words w)))
                     (and
                        (Memory.Mem.range_perm mf b BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and (jet_secp_square_columns.square_input_bounds (double_l_words w))
                           (and
                              (@eq BinNums.Z
                                 (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                                    (jet_secp_multiply_finish_product.radix_value (double_l_words w)))
                                 (BinInt.Z.add
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH))
                                       (jet_secp_multiply_finish_product.radix_value w))
                                    (BinInt.Z.mul
                                       (jet_secp_field_half_numeric.half_parity
                                          (jet_secp_field_mul_small.mul_small_words
                                             (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) w))
                                       jet_secp_fe_math.feP)))
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf))))))))
### C.jet_secp_double_l_scale.double_l_words
double_l_words =
fun w : forall _ : nat, Integers.Int64.int =>
jet_secp_field_half.half_words
  (jet_secp_field_mul_small.mul_small_words (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) w)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments double_l_words w%function_scope i%nat_scope
