### C.jet_secp_field_read_preservation.field_at_lframe
field_at_lframe
     : forall (m mf : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (xs : list Integers.Int64.int)
         (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (_ : jet_secp_fe_nv.fe_at m b ofs xs)
         (_ : jet_sx_mem.lframe P m mf) (_ : forall pos : BinNums.Z, P b pos), jet_secp_fe_nv.fe_at mf b ofs xs
### C.jet_secp_field_read_preservation.field_freeable_lframe
field_freeable_lframe
     : forall (m mf : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (xs : list Integers.Int64.int)
         (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (_ : jet_secp_fe_nv.fe_at m b ofs xs)
         (_ : Memory.Mem.range_perm m b ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_sx_mem.lframe P m mf) (_ : forall pos : BinNums.Z, P b pos),
       Memory.Mem.range_perm mf b ofs
         (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
         Memtype.Cur Memtype.Freeable
### C.jet_secp_field_read_preservation.field_preserved_across_other_read
field_preserved_across_other_read
     : forall (m mf m0 : Memory.Mem.mem) (bd bw bi ba bb bl : Values.block) (edge : BinNums.Z)
         (xs : list Integers.Int64.int) (_ : not (@eq Values.block ba bb)) (_ : not (@eq Values.block ba bl))
         (_ : not (jet_secp_frame.extA m0 bd bw bi ba)) (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 xs)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_sx_mem.lframe
                (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))
                   (jet_secp_local_regions.local_read_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mf),
       and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 xs)
         (Memory.Mem.range_perm mf ba BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
