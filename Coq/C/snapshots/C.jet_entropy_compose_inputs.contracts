### C.jet_entropy_compose_inputs.entropy_local_txid
entropy_local_txid
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bo : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._op e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bo entropy_op))),
       Clight.eval_expr jet_elements_linkage.elements_ge e le m entropy_txid_array
         (Values.Vptr bo Integers.Ptrofs.zero)
### C.jet_entropy_compose_inputs.entropy_read_symbol
entropy_read_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            jets_elements._read32s)
         (@Some Values.block (jet_elements_linkage.elements_symbol_block jets_elements._read32s))
### C.jet_entropy_compose_inputs.entropy_read_funct
entropy_read_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._read32s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_elements.f_read32s))
### C.jet_entropy_compose_inputs.exec_entropy_read_array
exec_entropy_read_array
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bl bx : Values.block) (arg : Clight.expr)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._read32s e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._src e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bl jet_entropy_compose_common.calc_fr)))
         (_ : @eq Ctypes.type (Clight.typeof arg)
                (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : Clight.eval_expr jet_elements_linkage.elements_ge e le m arg (Values.Vptr bx Integers.Ptrofs.zero))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                (@Ctypes.Internal Clight.function jets_elements.f_read32s)
                (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m (entropy_read_array arg) Events.E0 le mf
         ClightBigstep.Out_normal
