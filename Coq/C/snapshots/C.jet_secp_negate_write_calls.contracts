### C.jet_secp_negate_write_calls.eval_negate_write_calls
eval_negate_write_calls
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list BitMachine.Cell)
         (m : Memory.Mem.mem) (b : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw edge cursor N)
         (_ : jet_sx_state.rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))) jet_secp_local_regions.local_write_initial_regs m)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : jet_secp_frame.invA m0 bd dbase bw edge cursor N bi rc w0 outs0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                rho (@nil jet_sx_eval.event) m)
         (_ : jet_secp_fe_math.fe_limbs_ok (Integers.Int64.unsigned (rho (S O)))
                (Integers.Int64.unsigned (rho (S (S O)))) (Integers.Int64.unsigned (rho (S (S (S O)))))
                (Integers.Int64.unsigned (rho (S (S (S (S O)))))) (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))))
         (_ : @eq BinNums.Z
                (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho (S O)))
                   (Integers.Int64.unsigned (rho (S (S O)))) (Integers.Int64.unsigned (rho (S (S (S O)))))
                   (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                   (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                jet_secp_fe_math.feP),
       @ex Memory.Mem.mem
         (fun mn : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mn
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mn
                     (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                        (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                     Values.Vundef)
                  (and
                     (jet_frame_inv.finv m0 bd dbase bw edge cursor N bi mf true
                        (@app BitMachine.Cell outs0
                           (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                              (@jet_secp_canonical_negate.canonical_fe_negate Alg.CoreFunSem x))))
                     (and
                        (Memory.Mem.range_perm mf b BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe
                           (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                                 (@nil (prod Values.block BinNums.Z))) jet_secp_local_regions.local_write_initial_regs
                              m) m mf))))))
