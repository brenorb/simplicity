### C.jet_secp_schnorr_verify_entry.schnorr_verify_entry_ok
schnorr_verify_entry_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_secp256k1_schnorrsig_verify) true
### C.jet_secp_schnorr_verify_entry.schnorr_verify_entry
schnorr_verify_entry
     : forall (m : Memory.Mem.mem) (sig msg key : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bp : Values.block =>
             @ex Values.block
               (fun bk : Values.block =>
                @ex Values.block
                  (fun ba : Values.block =>
                   @ex Values.block
                     (fun bng : Values.block =>
                      @ex Values.block
                        (fun br : Values.block =>
                         @ex Values.block
                           (fun bx : Values.block =>
                            @ex Values.block
                              (fun bpk : Values.block =>
                               @ex Values.block
                                 (fun bbuf : Values.block =>
                                  @ex Values.block
                                    (fun bf : Values.block =>
                                     and
                                       (Clight.function_entry2 jet_secp_linkage.secp_ge
                                          jets_secp.f_secp256k1_schnorrsig_verify
                                          (@cons Values.val sig
                                             (@cons Values.val msg
                                                (@cons Values.val
                                                   (Values.Vlong (Integers.Int64.repr (BinNums.Zpos (...))))
                                                   (@cons Values.val key (@nil Values.val))))) m
                                          (schnorr_verify_env bp bk ba bng br bx bpk bbuf bf)
                                          (schnorr_verify_temps sig msg key) mi)
                                       (and
                                          (@List.NoDup Values.block
                                             (schnorr_verify_locals bp bk ba bng br bx bpk bbuf bf))
                                          (and
                                             (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                              not
                                                (@List.In Values.block b
                                                   (schnorr_verify_locals bp bk ba bng br bx bpk bbuf bf)))
                                             (and
                                                (forall (b : Values.block) (hi : BinNums.Z)
                                                   (_ : @List.In (prod Values.block BinNums.Z)
                                                          (@pair Values.block BinNums.Z b hi)
                                                          (schnorr_verify_storage bp bk ba bng br bx bpk bbuf bf)),
                                                 Memory.Mem.range_perm mi b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                                                (and
                                                   (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True)
                                                      m mi)
                                                   (and (jet_clight_internal_permissions.keeps_permissions m mi)
                                                      (jet_clight_internal_preserve.readonly_preserved m mi))))))))))))))))
### C.jet_secp_schnorr_verify_entry.schnorr_verify_blocks
schnorr_verify_blocks
     : forall bp bk ba bng br bx bpk bbuf bf : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (schnorr_verify_env bp bk ba bng br bx bpk bbuf bf))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bf BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bng BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bk BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bpk BinNums.Z0)
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                        (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z ba BinNums.Z0)
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                        (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                           (@pair (prod Values.block BinNums.Z) BinNums.Z
                              (@pair Values.block BinNums.Z bbuf BinNums.Z0)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                           (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                              (@pair (prod Values.block BinNums.Z) BinNums.Z
                                 (@pair Values.block BinNums.Z br BinNums.Z0)
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                              (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                 (@pair (prod Values.block BinNums.Z) BinNums.Z
                                    (@pair Values.block BinNums.Z bx BinNums.Z0)
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                    (@pair (prod Values.block BinNums.Z) BinNums.Z
                                       (@pair Values.block BinNums.Z bp BinNums.Z0)
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                    (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))))))
