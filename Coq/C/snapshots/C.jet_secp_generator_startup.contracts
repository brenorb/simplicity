### C.jet_secp_generator_startup.generator_startup_initializes
generator_startup_initializes
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       generator_startup m
### C.jet_secp_generator_startup.generator_startup_exists
generator_startup_exists
     : @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                  (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m))
            (generator_startup m))
### C.jet_secp_generator_startup.generator_startup_separate
generator_startup_separate
     : forall (m : Memory.Mem.mem) (b : Values.block) (size : BinNums.Z) (_ : generator_startup m)
         (_ : BinInt.Z.lt BinNums.Z0 size) (_ : Memory.Mem.range_perm m b BinNums.Z0 size Memtype.Cur Memtype.Freeable),
       and (not (@eq Values.block b jet_secp_generator_zero_global.generator_zero_block))
         (forall h : bool, not (@eq Values.block b (jet_secp_generator_globals.generator_table_block h)))
### C.jet_secp_generator_startup.generator_startup_lframe
generator_startup_lframe
     : forall (m mf : Memory.Mem.mem) (P : forall (_ : Values.block) (_ : BinNums.Z), Prop)
         (_ : generator_startup m) (_ : jet_clight_forward.mem_forward m mf) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall pos : BinNums.Z, P jet_secp_generator_zero_global.generator_zero_block pos)
         (_ : forall (h : bool) (pos : BinNums.Z), P (jet_secp_generator_globals.generator_table_block h) pos),
       generator_startup mf
### C.jet_secp_generator_startup.generator_startup_readonly
generator_startup_readonly
     : forall (m mf : Memory.Mem.mem) (_ : generator_startup m)
         (_ : jet_clight_internal_preserve.readonly_preserved m mf), generator_startup mf
### C.jet_secp_generator_startup.generator_startup_call
generator_startup_call
     : forall (m mf : Memory.Mem.mem) (fd : Clight.fundef) (args : list Values.val) (trace : Events.trace)
         (result : Values.val) (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (_ : generator_startup m)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m fd args trace mf result)
         (_ : jet_sx_mem.lframe P m mf)
         (_ : forall pos : BinNums.Z, P jet_secp_generator_zero_global.generator_zero_block pos)
         (_ : forall (h : bool) (pos : BinNums.Z), P (jet_secp_generator_globals.generator_table_block h) pos),
       generator_startup mf
### C.jet_secp_generator_startup.generator_startup
generator_startup =
fun m : Memory.Mem.mem =>
and (jet_secp_generator_zero_global.generator_zero_global_state m)
  (forall h : bool, jet_secp_generator_globals.generator_table_state h m)
     : forall _ : Memory.Mem.mem, Prop

Arguments generator_startup m
