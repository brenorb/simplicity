         (@elements_tx_lock_time_spec)
### C.jet_elements_lock_spec.elements_lock_program_value
elements_lock_program_value
     : forall (height : bool) (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (@lock_program height
            (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore
               (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))
            (@jet_elements_is_final_spec.elements_tx_is_final_spec
               (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))
            (@elements_lock_time_prim
               (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)) tt
            environment)
         (@Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (elements_lock_value height environment)))
### C.jet_elements_lock_spec.lock_zero
lock_zero =
fun (A : Ty.Ty) (alg : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp A Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg (@Alg.Core.Combinators.unit A alg)
  (@Word.zero (S (S (S (S (S O))))) alg)
     : forall (A : Ty.Ty) (alg : Alg.Core.Algebra), Alg.Core.domain alg A (Word.Word (S (S (S (S (S O))))))

Arguments lock_zero {A}%ty_scope {alg}
### C.jet_elements_lock_spec.lock_tail
lock_tail =
fun (height : bool) (alg : Alg.Core.Algebra) =>
@Bit.cond (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))) alg
  (@lock_zero (Word.Word (S (S (S (S (S O)))))) alg)
  (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S O)))))) alg
     (@jet_timelock_spec.parse_lock_spec alg)
     match
       height
       return
         (Alg.Core.domain alg (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))
            (Word.Word (S (S (S (S (S O)))))))
     with
     | true =>
         @Alg.Core.Combinators.copair (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
           (Word.Word (S (S (S (S (S O)))))) alg (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S O)))))) alg)
           (@lock_zero (Word.Word (S (S (S (S (S O)))))) alg)
     | false =>
         @Alg.Core.Combinators.copair (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
           (Word.Word (S (S (S (S (S O)))))) alg (@lock_zero (Word.Word (S (S (S (S (S O)))))) alg)
           (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S O)))))) alg)
     end)
     : forall (_ : bool) (alg : Alg.Core.Algebra),
       Alg.Core.domain alg (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
         (Word.Word (S (S (S (S (S O))))))

Arguments lock_tail height%bool_scope {alg}
### C.jet_elements_lock_spec.lock_program
lock_program =
fun (height : bool) (alg : Alg.Core.Algebra) (isfinal : Alg.Core.domain alg Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))
  (locktime : Alg.Core.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))) =>
@Alg.Core.Combinators.comp Ty.Unit (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
  (Word.Word (S (S (S (S (S O)))))) alg
  (@Alg.Core.Combinators.pair Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))) alg isfinal locktime)
  (@lock_tail height alg)
     : forall (_ : bool) (alg : Alg.Core.Algebra) (_ : Alg.Core.domain alg Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))
         (_ : Alg.Core.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))),
       Alg.Core.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))

Arguments lock_program height%bool_scope {alg} isfinal locktime
### C.jet_elements_lock_spec.lock_value
lock_value =
fun (height final : bool) (z : BinNums.Z) =>
match final return BinNums.Z with
| true => BinNums.Z0
| false =>
    match
      BinInt.Z.ltb z
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO ...)))))))))))))))))))
      return BinNums.Z
    with
    | true => match height return BinNums.Z with
              | true => z
              | false => BinNums.Z0
              end
    | false => match height return BinNums.Z with
               | true => BinNums.Z0
               | false => z
               end
    end
end
     : forall (_ : bool) (_ : bool) (_ : BinNums.Z), BinNums.Z

Arguments lock_value (height final)%bool_scope z%Z_scope
### C.jet_elements_lock_spec.elements_lock_time_prim
elements_lock_time_prim =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
  jet_elements_prim.Elements.LockTime
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))

Arguments elements_lock_time_prim {alg}
### C.jet_elements_lock_spec.elements_tx_lock_height_spec
elements_tx_lock_height_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@lock_program true (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
  (@jet_elements_is_final_spec.elements_tx_is_final_spec alg) (@elements_lock_time_prim alg)
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))

Arguments elements_tx_lock_height_spec {alg}
### C.jet_elements_lock_spec.elements_tx_lock_time_spec
elements_tx_lock_time_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@lock_program false (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
  (@jet_elements_is_final_spec.elements_tx_is_final_spec alg) (@elements_lock_time_prim alg)
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))

Arguments elements_tx_lock_time_spec {alg}
### C.jet_elements_lock_spec.elements_lock_value
elements_lock_value =
fun (height : bool) (environment : jet_elements_prim.Elements.env) =>
lock_value height
  (@List.forallb jet_elements_prim.sigTxInput jet_elements_is_final_spec.sequence_final
     (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment)))
  (Integers.Int.unsigned (jet_elements_prim.sigTxLock (jet_elements_prim.Elements.envTx environment)))
     : forall (_ : bool) (_ : jet_elements_prim.Elements.env), BinNums.Z

Arguments elements_lock_value height%bool_scope environment
