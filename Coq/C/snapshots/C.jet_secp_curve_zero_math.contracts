### C.jet_secp_curve_zero_math.curve_zero_test
curve_zero_test =
fun a b c d e : BinNums.Z =>
orb (BinInt.Z.eqb (BinInt.Z.lor (BinInt.Z.lor (BinInt.Z.lor (BinInt.Z.lor a b) c) d) e) BinNums.Z0)
  (BinInt.Z.eqb
     (BinInt.Z.land
        (BinInt.Z.land
           (BinInt.Z.land
              (BinInt.Z.land
                 (BinInt.Z.lxor a
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))))
                 b) c) d)
        (BinInt.Z.lxor e
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
