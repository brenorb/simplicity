### C.jet_secp_scalar_reader_lifecycle.scalar_reader_local_lookup
scalar_reader_local_lookup
     : forall (id : AST.ident) (r : nat) (ty : Ctypes.type)
         (_ : @eq (option (prod nat Ctypes.type))
                (jet_sx_eval.vlookup jet_secp_scalar_reader_run.scalar_reader_venv id)
                (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty))),
       and (@eq AST.ident id jets_secp._buf)
         (and (@eq nat r (S (S O)))
            (@eq Ctypes.type ty
               (Ctypesdefs.tarray Ctypesdefs.tuchar
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_scalar_reader_lifecycle.free_scalar_reader_buffer
free_scalar_reader_buffer
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (e : Clight.env) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout
                (jet_sx_eval.sregs (jet_secp_scalar_reader_set.scalar_reader_set_state bi edge)) m)
         (_ : jet_sx_eval.ematch layout jet_secp_scalar_reader_run.scalar_reader_venv e),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem) (Memory.Mem.free_list m (Clight.blocks_of_env jet_secp_linkage.secp_ge e))
               (@Some Memory.Mem.mem mf))
            (Memory.Mem.unchanged_on
               (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b (jet_sx_state.blk layout (S (S O)))))
               m mf))
