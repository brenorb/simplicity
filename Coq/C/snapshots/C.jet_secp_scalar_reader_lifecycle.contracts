### C.jet_secp_scalar_reader_lifecycle.scalar_reader_final_cursor
scalar_reader_final_cursor
     : forall (bits : list bool) (rc : BinNums.Z) (layout : jet_sx_state.layout) (bi : Values.block)
         (edge : BinNums.Z) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep (jet_secp_wrapper_run.read_fe_rho bits rc) layout
                (scalar_reader_final_regs bi (Integers.Ptrofs.repr edge)) m),
       jet_frame_layout.frame_fields_at m (jet_sx_state.blk layout (S O)) (jet_sx_state.bas layout (S O)) bi edge
         (BinInt.Z.add rc
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_scalar_reader_lifecycle.eval_scalar_reader_numeric_owned
eval_scalar_reader_numeric_owned
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list BitMachine.Cell) (cap : BinNums.Z)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : jet_sx_state.layout)
         (_ : jet_sx_state.rep (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) layout
                (jet_secp_scalar_reader_run.scalar_reader_initial_regs bi (Integers.Ptrofs.repr edge)) m)
         (_ : jet_sx_exec.xsep (jet_secp_scalar_reader_lifecycle.value_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_reader_lifecycle.value_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) (@nil jet_sx_eval.event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_read_scalar)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout (S O))
                        (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk layout O)
                     (BinInt.Z.add (jet_sx_state.bas layout O)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i))))
                  (@Some Values.val
                     (Values.Vlong
                        (jet_secp_scalar_reader_value.scalar_reader_limb
                           (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) (jet_sx_state.lay layout) i))))
               (and
                  (@eq BinNums.Z
                     (jet_secp_scalar_overflow_numeric.scalar_limb_value
                        (jet_secp_scalar_reader_value.scalar_reader_limb
                           (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) (jet_sx_state.lay layout)))
                     (BinInt.Z.modulo
                        (jet_secp_fe_math.be_val
                           (jet_secp_input_bytes.input_bytes
                              (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))) ibits))
                        jet_secp_canonical_scalar.canonical_group_order))
                  (and
                     (jet_frame_layout.frame_fields_at mf (jet_sx_state.blk layout (S O))
                        (jet_sx_state.bas layout (S O)) bi edge
                        (BinInt.Z.add rc
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (and
                        (jet_sx_state.rep (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) layout
                           (scalar_reader_final_regs bi (Integers.Ptrofs.repr edge)) mf)
                        (and
                           (jet_secp_scalar_reader_lifecycle.value_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                              (jet_secp_scalar_reader_lifecycle.value_rho rc ibits)
                              (jet_secp_scalar_reader_run.scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                           (jet_sx_mem.lframe
                              (jet_sx_exec.frame (jet_secp_scalar_reader_lifecycle.value_ext m0 bd bw bi) layout
                                 (jet_secp_scalar_reader_run.scalar_reader_initial_regs bi (Integers.Ptrofs.repr edge))
                                 m) m mf)))))))
