### C.jet_secp_swu_selected_literal.swu_literal_negate_canonical
swu_literal_negate_canonical
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem x)) jet_secp_fe_math.feP)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem x))
### C.jet_secp_swu_selected_literal.swu_literal_candidates_canonical
swu_literal_candidates_canonical
     : forall t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       match @jet_secp_swu_literal.literal_swu_candidates Alg.CoreFunSem t return Prop with
       | pair x1 x3 =>
           and
             (@eq BinNums.Z
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x1)
                   jet_secp_fe_math.feP) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x1))
             (@eq BinNums.Z
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x3)
                   jet_secp_fe_math.feP) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x3))
       end
### C.jet_secp_swu_selected_literal.swu_field_output_matches
swu_field_output_matches
