     : forall s : jet_wide.wide_size,
       jet_bit_word_layout.bit_word_writer_contract (jet_wide.wide_writer s)
         (fun b : bool => Values.Vlong (jet_pad_bit_spec.extend_bit_long s b)) (Word.Word (jet_wide.wide_log s))
         (@jet_pad_bit_spec.left_extend_bit_spec (jet_wide.wide_log s) Alg.CoreFunSem)
