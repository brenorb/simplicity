### C.jet_secp_owned_write_field.owned_write_initial_rep
owned_write_initial_rep
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (t0 t1 t2 t3 t4 : Integers.Int64.int)
         (rc : BinNums.Z) (m : Memory.Mem.mem) (b : Values.block)
         (_ : BinInt.Z.le
                (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset k)
                (@cons Integers.Int64.int t0
                   (@cons Integers.Int64.int t1
                      (@cons Integers.Int64.int t2
                         (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int)))))))
         (_ : Memory.Mem.range_perm m b BinNums.Z0 size Memtype.Cur Memtype.Freeable),
       jet_sx_state.rep (jet_secp_write_fe_wide_values.wide_fe_rho t0 t1 t2 t3 t4 rc)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@nil (prod Values.block BinNums.Z))) (jet_secp_owned_write_run.owned_write_initial_regs size k) m
### C.jet_secp_owned_write_field.eval_owned_bounded_field_write
eval_owned_bounded_field_write
     : forall (size : BinNums.Z) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bw : Values.block) (edge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z)
         (f : jet_secp_point_write_field.point_field) (w0 : bool) (outs0 : list BitMachine.Cell)
         (k : jet_secp_point_write_run.point_coordinate) (m : Memory.Mem.mem) (b : Values.block)
         (_ : BinInt.Z.le
                (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw edge cursor N)
         (_ : jet_secp_point_write_field.point_field_bounds f)
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset k)
                (jet_secp_point_write_field.point_field_limbs f))
         (_ : Memory.Mem.range_perm m b BinNums.Z0 size Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : jet_secp_frame.invA m0 bd dbase bw edge cursor N bi rc w0 outs0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (jet_secp_point_write_field.point_field_rho f rc) (@nil jet_sx_eval.event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val
                     (Values.Vptr b (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_frame_inv.finv m0 bd dbase bw edge cursor N bi mf true
                  (@app BitMachine.Cell outs0
                     (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (jet_secp_point_write_field.point_field_output f))))
               (and (Memory.Mem.range_perm mf b BinNums.Z0 size Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                           (@nil (prod Values.block BinNums.Z)))
                        (jet_secp_owned_write_run.owned_write_initial_regs size k) m) m mf))))
