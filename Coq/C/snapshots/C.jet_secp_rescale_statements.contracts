### C.jet_secp_rescale_statements.rescale_coordinate_id
rescale_coordinate_id =
fun k : jet_secp_point_write_run.point_coordinate =>
match k return AST.ident with
| jet_secp_point_write_run.PointX => jets_secp._x
| jet_secp_point_write_run.PointY => jets_secp._y
| jet_secp_point_write_run.PointZ => jets_secp._z
end
     : forall _ : jet_secp_point_write_run.point_coordinate, AST.ident

Arguments rescale_coordinate_id k
### C.jet_secp_rescale_statements.rescale_coordinate_address
rescale_coordinate_address =
fun k : jet_secp_point_write_run.point_coordinate =>
Clight.Eaddrof
  (Clight.Efield
     (Clight.Ederef (Clight.Etempvar jets_secp._r (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
        (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)) (rescale_coordinate_id k)
     (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)) (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
     : forall _ : jet_secp_point_write_run.point_coordinate, Clight.expr

Arguments rescale_coordinate_address k
### C.jet_secp_rescale_statements.rescale_factor_address
rescale_factor_address =
fun squared : bool =>
match squared return Clight.expr with
| true =>
    Clight.Eaddrof (Clight.Evar jets_secp._zz (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
      (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
| false => Clight.Etempvar jets_secp._s (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
end
     : forall _ : bool, Clight.expr

Arguments rescale_factor_address squared%bool_scope
### C.jet_secp_rescale_statements.rescale_multiply_statement
rescale_multiply_statement =
fun (k : jet_secp_point_write_run.point_coordinate) (squared : bool) =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_secp._secp256k1_fe_mul
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr (rescale_coordinate_address k)
     (@cons Clight.expr (rescale_coordinate_address k)
        (@cons Clight.expr (rescale_factor_address squared) (@nil Clight.expr))))
     : forall (_ : jet_secp_point_write_run.point_coordinate) (_ : bool), Clight.statement

Arguments rescale_multiply_statement k squared%bool_scope
