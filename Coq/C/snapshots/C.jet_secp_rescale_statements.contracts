### C.jet_secp_rescale_statements.rescale_rest_source
rescale_rest_source
     : @eq Clight.statement jet_secp_rescale_prefix.rescale_rest
         (Clight.Ssequence (rescale_multiply_statement jet_secp_point_write_run.PointX true)
            (Clight.Ssequence (rescale_multiply_statement jet_secp_point_write_run.PointY true)
               (Clight.Ssequence (rescale_multiply_statement jet_secp_point_write_run.PointY false)
                  (rescale_multiply_statement jet_secp_point_write_run.PointZ false))))
### C.jet_secp_rescale_statements.rescale_coordinate_layout
rescale_coordinate_layout
     : forall k : jet_secp_point_write_run.point_coordinate,
       @ex Ctypes.composite
         (fun co : Ctypes.composite =>
          and
            (@eq (option Ctypes.composite)
               (@Maps.PTree.get Ctypes.composite jets_secp.__6123 (Clight.genv_cenv jet_secp_linkage.secp_ge))
               (@Some Ctypes.composite co))
            (@eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
               (Ctypes.field_offset (Clight.genv_cenv jet_secp_linkage.secp_ge) (rescale_coordinate_id k)
                  (Ctypes.co_members co))
               (@Errors.OK (prod BinNums.Z Ctypes.bitfield)
                  (@pair BinNums.Z Ctypes.bitfield (jet_secp_point_write_run.point_coordinate_offset k) Ctypes.Full))))
### C.jet_secp_rescale_statements.rescale_zero_address
rescale_zero_address
     : forall k : jet_secp_point_write_run.point_coordinate,
       @eq Integers.Ptrofs.int
         (Integers.Ptrofs.add Integers.Ptrofs.zero
            (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
         (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k))
### C.jet_secp_rescale_statements.rescale_multiply_symbol
rescale_multiply_symbol
     : @ex Values.block
         (fun b : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                  jets_secp._secp256k1_fe_mul) (@Some Values.block b))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge) b)
               (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul))))
### C.jet_secp_rescale_statements.eval_rescale_coordinate
eval_rescale_coordinate
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bp : Values.block)
         (k : jet_secp_point_write_run.point_coordinate)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m (rescale_coordinate_address k)
         (Values.Vptr bp (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
### C.jet_secp_rescale_statements.eval_rescale_factor
eval_rescale_factor
     : forall (squared : bool) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bs bz : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._s le)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._zz e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bz (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m (rescale_factor_address squared)
         (Values.Vptr match squared return Values.block with
                      | true => bz
                      | false => bs
                      end Integers.Ptrofs.zero)
### C.jet_secp_rescale_statements.exec_rescale_multiply_from_call
exec_rescale_multiply_from_call
     : forall (k : jet_secp_point_write_run.point_coordinate) (squared : bool)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bp bs bz : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._s le)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._zz e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bz (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                (@cons Values.val
                   (Values.Vptr bp (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                   (@cons Values.val
                      (Values.Vptr bp (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                      (@cons Values.val
                         (Values.Vptr match squared return Values.block with
                                      | true => bz
                                      | false => bs
                                      end Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (rescale_multiply_statement k squared) Events.E0
         le mf ClightBigstep.Out_normal
