### C.jet_secp_curve_zero.curve_b2z_and
curve_b2z_and
     : forall a b : bool,
       @eq BinNums.Z (BinInt.Z.land (jet_sx_zval.b2z a) (jet_sx_zval.b2z b)) (jet_sx_zval.b2z (andb a b))
### C.jet_secp_curve_zero.curve_b2z_or
curve_b2z_or
     : forall a b : bool,
       @eq BinNums.Z (BinInt.Z.lor (jet_sx_zval.b2z a) (jet_sx_zval.b2z b)) (jet_sx_zval.b2z (orb a b))
### C.jet_secp_curve_zero.curve_zero_cond_zval
curve_zero_cond_zval
     : forall rho : forall _ : nat, BinNums.Z,
       @eq BinNums.Z (jet_sx_zval.zval rho curve_zero_cond)
         (jet_sx_zval.b2z (curve_zero_fast (rho (S O)) (rho (S (S (S (S (S O))))))))
### C.jet_secp_curve_zero.curve_zero_ret_zval
curve_zero_ret_zval
     : forall rho : forall _ : nat, BinNums.Z,
       @eq BinNums.Z (jet_sx_zval.zval rho curve_zero_ret)
         match
           jet_secp_curve_weak.curve_weak_math (rho (S O)) (rho (S (S O))) (rho (S (S (S O))))
             (rho (S (S (S (S O))))) (rho (S (S (S (S (S O)))))) return BinNums.Z
         with
         | pair p e =>
             match p return BinNums.Z with
             | pair p0 d =>
                 match p0 return BinNums.Z with
                 | pair p1 c =>
                     match p1 return BinNums.Z with
                     | pair a b => jet_sx_zval.b2z (jet_secp_curve_zero_math.curve_zero_test a b c d e)
                     end
                 end
             end
         end
### C.jet_secp_curve_zero.curve_zero_math_numeric
curve_zero_math_numeric
     : forall (t0 t1 t2 t3 t4 : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 t0)
                (BinInt.Z.le t0
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t1)
                (BinInt.Z.le t1
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t2)
                (BinInt.Z.le t2
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t3)
                (BinInt.Z.le t3
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t4)
                (BinInt.Z.le t4
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))),
       @eq bool
         match curve_zero_fast t0 t4 return bool with
         | true => false
         | false =>
             match jet_secp_curve_weak.curve_weak_math t0 t1 t2 t3 t4 return bool with
             | pair p e =>
                 match p return bool with
                 | pair p0 d =>
                     match p0 return bool with
                     | pair p1 c =>
                         match p1 return bool with
                         | pair a b => jet_secp_curve_zero_math.curve_zero_test a b c d e
                         end
                     end
                 end
             end
         end (BinInt.Z.eqb (BinInt.Z.modulo (jet_secp_fe_math.fe_val t0 t1 t2 t3 t4) jet_secp_fe_math.feP) BinNums.Z0)
### C.jet_secp_curve_zero.curve_b2z_truth
curve_b2z_truth
     : forall b : bool, @eq bool (negb (BinInt.Z.eqb (jet_sx_zval.b2z b) BinNums.Z0)) b
### C.jet_secp_curve_zero.eval_curve_zero_numeric
eval_curve_zero_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout jet_secp_local_regions.local_write_initial_regs m)
         (_ : forall (n : nat) (_ : and (le (S O) n) (le n (S (S (S (S (S O))))))),
              BinInt.Z.le (Integers.Int64.unsigned (rho n))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalizes_to_zero_var)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  match
                    BinInt.Z.eqb
                      (BinInt.Z.modulo
                         (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho (S O)))
                            (Integers.Int64.unsigned (rho (S (S O)))) (Integers.Int64.unsigned (rho (S (S (S O)))))
                            (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                            (Integers.Int64.unsigned (rho (S (S (S (S (S O)))))))) jet_secp_fe_math.feP) BinNums.Z0
                    return Integers.Int.int
                  with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (and (jet_sx_state.rep rho layout jet_secp_local_regions.local_write_initial_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (o : BinNums.Z) =>
                   not
                     (jet_sx_state.foot layout
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape jet_secp_local_regions.local_write_initial_regs) b o)) m mf)))
