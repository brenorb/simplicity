         (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0 (scalar62_size to62) Memtype.Cur Memtype.Freeable)
         (_ : scalar62_storage (negb to62) w m bin)
