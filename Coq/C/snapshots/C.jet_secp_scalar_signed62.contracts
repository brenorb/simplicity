### C.jet_secp_scalar_signed62.scalar_to62_tree
scalar_to62_tree =
@Some jet_sx_exec.res
  (jet_sx_exec.RDone
     (jet_sx_eval.mkst (@Maps.PTree.Empty jet_sx_expr.sx)
        (@cons jet_sx_state.region
           (jet_sx_state.mkreg
              (@cons jet_sx_state.cell
                 (jet_sx_state.mkcell BinNums.Z0 AST.Mint64
                    (@Some jet_sx_expr.sx
                       (jet_sx_expr.XLb jet_sx_expr.Band (jet_sx_expr.XLv O)
                          (jet_sx_expr.XLsh jet_sx_expr.Hshru
                             (jet_sx_expr.XLc
                                (Integers.Int64.mkint
                                   (BinNums.Zpos
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))))
                                   (Integers.Int64.Z_mod_modulus_range' (BinNums.Zneg BinNums.xH))))
                             (BinNums.Zpos (BinNums.xO BinNums.xH))))))
