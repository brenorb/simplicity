### C.jet_secp_scalar_signed62.scalar62_state
scalar62_state =
fun to62 : bool =>
match
  match to62 return (option jet_sx_exec.res) with
  | true => scalar_to62_tree
  | false => scalar_from62_tree
  end return jet_sx_eval.sstate
with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : forall _ : bool, jet_sx_eval.sstate

Arguments scalar62_state to62%bool_scope
### C.jet_secp_scalar_signed62.scalar62_out_regs
scalar62_out_regs =
fun to62 : bool =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (scalar62_exprs to62)) true
     (@Some BinNums.Z (scalar62_size to62)))
  (@cons jet_sx_state.region
     (jet_secp_local_regions.free_region
        (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (scalar62_vars (negb to62))) true (@None BinNums.Z))
        (scalar62_size (negb to62))) (@nil jet_sx_state.region))
     : forall _ : bool, list jet_sx_state.region

Arguments scalar62_out_regs to62%bool_scope
