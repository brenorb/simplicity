### C.jet_secp_scalar_signed62.scalar62_words
scalar62_words =
fun (to62 : bool) (w : forall _ : nat, Integers.Int64.int) (i : nat) =>
@List.nth Integers.Int64.int i
  match to62 return (list Integers.Int64.int) with
  | true =>
      @cons Integers.Int64.int
        (Integers.Int64.and (w O)
           (Integers.Int64.repr
              (BinInt.Z.sub
                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                    (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                 (BinNums.Zpos BinNums.xH))))
        (@cons Integers.Int64.int
           (Integers.Int64.and
              (Integers.Int64.or
                 (Integers.Int64.shru (w O)
                    (Integers.Int64.repr
                       (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                 (Integers.Int64.shl (w (S O)) (Integers.Int64.repr (BinNums.Zpos (BinNums.xO BinNums.xH)))))
              (Integers.Int64.repr
                 (BinInt.Z.sub
                    (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                       (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                    (BinNums.Zpos BinNums.xH))))
           (@cons Integers.Int64.int
              (Integers.Int64.and
                 (Integers.Int64.or
                    (Integers.Int64.shru (w (S O))
                       (Integers.Int64.repr
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                    (Integers.Int64.shl (w (S (S O)))
                       (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))))
                 (Integers.Int64.repr
                    (BinInt.Z.sub
                       (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                          (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                       (BinNums.Zpos BinNums.xH))))
              (@cons Integers.Int64.int
                 (Integers.Int64.and
                    (Integers.Int64.or
                       (Integers.Int64.shru (w (S (S O)))
                          (Integers.Int64.repr
                             (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))))
                       (Integers.Int64.shl (w (S (S (S O))))
                          (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))))
                    (Integers.Int64.repr
                       (BinInt.Z.sub
                          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                             (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                          (BinNums.Zpos BinNums.xH))))
                 (@cons Integers.Int64.int
                    (Integers.Int64.shru (w (S (S (S O))))
                       (Integers.Int64.repr
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))))
                    (@nil Integers.Int64.int)))))
  | false =>
      @cons Integers.Int64.int
        (Integers.Int64.or (w O)
           (Integers.Int64.shl (w (S O))
              (Integers.Int64.repr
                 (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
        (@cons Integers.Int64.int
           (Integers.Int64.or
              (Integers.Int64.shru (w (S O)) (Integers.Int64.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
              (Integers.Int64.shl (w (S (S O)))
                 (Integers.Int64.repr
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
           (@cons Integers.Int64.int
              (Integers.Int64.or
                 (Integers.Int64.shru (w (S (S O)))
                    (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))
                 (Integers.Int64.shl (w (S (S (S O))))
                    (Integers.Int64.repr
                       (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
              (@cons Integers.Int64.int
                 (Integers.Int64.or
                    (Integers.Int64.shru (w (S (S (S O))))
                       (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH)))))
                    (Integers.Int64.shl (w (S (S (S (S O)))))
                       (Integers.Int64.repr
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                 (@nil Integers.Int64.int))))
  end Integers.Int64.zero
     : forall (_ : bool) (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

