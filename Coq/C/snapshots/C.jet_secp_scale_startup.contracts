### C.jet_secp_scale_startup.scale_startup
scale_startup =
fun m : Memory.Mem.mem =>
and (jet_secp_strauss_zero_generator.strauss_zero_global_state m)
  (and (jet_secp_split_constants.split_constants_ready m) (jet_secp_beta_global.beta_initialized m))
     : forall _ : Memory.Mem.mem, Prop

Arguments scale_startup m
### C.jet_secp_scale_startup.scale_startup_blocks
scale_startup_blocks =
@cons Values.block jet_secp_strauss_zero_generator.strauss_zero_block
  jet_secp_strauss_scale_function.strauss_readonly_blocks
     : list Values.block
### C.jet_secp_scale_startup.scale_startup_at
scale_startup_at =
fun (bng : Values.block) (m : Memory.Mem.mem) =>
and (jet_secp_strauss_zero_generator.zero_scalar_state bng m)
  (and (jet_secp_split_constants.split_constants_ready m) (jet_secp_beta_global.beta_initialized m))
     : forall (_ : Values.block) (_ : Memory.Mem.mem), Prop

Arguments scale_startup_at bng m
### C.jet_secp_scale_startup.scale_startup_blocks_at
scale_startup_blocks_at =
fun bng : Values.block => @cons Values.block bng jet_secp_strauss_scale_function.strauss_readonly_blocks
     : forall _ : Values.block, list Values.block

Arguments scale_startup_blocks_at bng
