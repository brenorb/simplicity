Arguments owned_write_tree size%Z_scope k bd base
### C.jet_secp_owned_write_run.owned_write_result
owned_write_result =
fun (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bd : Values.block) (base : Integers.Ptrofs.int)
=>
match owned_write_tree size k bd base return jet_sx_exec.res with
| Some rr => rr
| None =>
    jet_sx_exec.RDone
      (jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O)
      jet_sx_exec.ONormal
end
     : forall (_ : BinNums.Z) (_ : jet_secp_point_write_run.point_coordinate) (_ : Values.block)
         (_ : Integers.Ptrofs.int), jet_sx_exec.res

Arguments owned_write_result size%Z_scope k bd base
### C.jet_secp_owned_write_run.owned_write_storage_shape
owned_write_storage_shape =
fun (size : BinNums.Z) (state : jet_sx_eval.sstate) =>
and (@eq nat (@length jet_sx_state.region (jet_sx_eval.sregs state)) (S O))
  (@eq (option BinNums.Z)
     (jet_sx_state.rfree
        (@List.nth jet_sx_state.region O (jet_sx_eval.sregs state)
           (jet_sx_state.mkreg (@nil jet_sx_state.cell) true (@None BinNums.Z)))) (@Some BinNums.Z size))
     : forall (_ : BinNums.Z) (_ : jet_sx_eval.sstate), Prop

Arguments owned_write_storage_shape size%Z_scope state
