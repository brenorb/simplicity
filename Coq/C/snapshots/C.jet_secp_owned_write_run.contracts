### C.jet_secp_owned_write_run.owned_write_tree_nonempty
owned_write_tree_nonempty
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bd : Values.block)
         (base : Integers.Ptrofs.int),
       @eq bool match owned_write_tree size k bd base return bool with
                | Some _ => true
                | None => false
                end true
### C.jet_secp_owned_write_run.owned_write_run_eq
owned_write_run_eq
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bd : Values.block)
         (base : Integers.Ptrofs.int),
       @eq (option jet_sx_exec.res) (owned_write_run size k bd base)
         (@Some jet_sx_exec.res (owned_write_result size k bd base))
### C.jet_secp_owned_write_run.owned_write_selected_return
owned_write_selected_return
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bd : Values.block)
         (base : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH
            (jet_sx_eval.stemps
               (@fst jet_sx_eval.sstate jet_sx_exec.xout
                  (jet_sx_exec.rsel rho layout (owned_write_result size k bd base))))) (@None jet_sx_expr.sx)
### C.jet_secp_owned_write_run.owned_write_selected_log
owned_write_selected_log
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bd : Values.block)
         (base : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list jet_sx_eval.event)
         (jet_sx_eval.slog
            (@fst jet_sx_eval.sstate jet_sx_exec.xout (jet_sx_exec.rsel rho layout (owned_write_result size k bd base))))
         (jet_sx_eval.slog
            (@fst jet_sx_eval.sstate jet_sx_exec.xout
               (jet_sx_exec.rsel rho layout (jet_secp_write_fe_wrapper.write_fe_result bd base))))
### C.jet_secp_owned_write_run.owned_write_leaf_storage
owned_write_leaf_storage
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bd : Values.block)
         (base : Integers.Ptrofs.int),
       jet_secp_local_regions.all_leaf_property (owned_write_storage_shape size) (owned_write_result size k bd base)
### C.jet_secp_owned_write_run.owned_write_selected_storage
owned_write_selected_storage
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bd : Values.block)
         (base : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       owned_write_storage_shape size
         (@fst jet_sx_eval.sstate jet_sx_exec.xout (jet_sx_exec.rsel rho layout (owned_write_result size k bd base)))
### C.jet_secp_owned_write_run.owned_write_field_storage_size
owned_write_field_storage_size
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate)
         (_ : BinInt.Z.le
                (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size),
       @List.Forall jet_sx_state.cell
         (fun c : jet_sx_state.cell =>
          BinInt.Z.le (BinInt.Z.add (jet_sx_state.cofs c) (Memdata.size_chunk (jet_sx_state.cchunk c))) size)
         (jet_sx_state.rcells
            (@List.hd jet_sx_state.region (jet_sx_state.mkreg (@nil jet_sx_state.cell) true (@None BinNums.Z))
               (owned_write_initial_regs size k)))
### C.jet_secp_owned_write_run.owned_write_initial_regs
owned_write_initial_regs =
fun (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) =>
jet_secp_owned_field_slice.owned_field_slice (jet_secp_point_write_run.point_coordinate_offset k) size
     : forall (_ : BinNums.Z) (_ : jet_secp_point_write_run.point_coordinate), list jet_sx_state.region

