### C.jet_secp_owned_write_run.owned_write_run
owned_write_run =
fun (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bd : Values.block) (base : Integers.Ptrofs.int)
=>
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_write_fe_wrapper.write_fe_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))) jets_secp.f_write_fe
  (@cons jet_sx_expr.sx (jet_sx_expr.XA bd base)
     (@cons jet_sx_expr.sx (jet_sx_expr.XP O (jet_secp_point_write_run.point_coordinate_offset k))
        (@nil jet_sx_expr.sx))) (owned_write_initial_regs size k) (@nil jet_sx_eval.event)
  (S (S (S (S (S (S O))))))
     : forall (_ : BinNums.Z) (_ : jet_secp_point_write_run.point_coordinate) (_ : Values.block)
         (_ : Integers.Ptrofs.int), option jet_sx_exec.res

