### C.jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_block
elements_taptweak_modinfo_fe_block =
jet_elements_taptweak_globals.elements_taptweak_symbol_block jets_secp._secp256k1_const_modinfo_fe
     : Values.block
### C.jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_global_rep
elements_taptweak_modinfo_fe_global_rep =
fun m : Memory.Mem.mem =>
and (Memory.Mem.valid_block m elements_taptweak_modinfo_fe_block)
  (and
     (Memory.Mem.range_perm m elements_taptweak_modinfo_fe_block BinNums.Z0
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))) Memtype.Cur
        Memtype.Readable)
     (forall (i : nat) (w : Integers.Int64.int)
        (_ : @eq (option Integers.Int64.int)
               (@List.nth_error Integers.Int64.int jet_secp_modinfo_fe_global.modinfo_fe_words i)
               (@Some Integers.Int64.int w)),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m elements_taptweak_modinfo_fe_block
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong w))))
     : forall _ : Memory.Mem.mem, Prop

Arguments elements_taptweak_modinfo_fe_global_rep m
### C.jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_state
elements_taptweak_modinfo_fe_state =
fun m : Memory.Mem.mem =>
and (elements_taptweak_modinfo_fe_global_rep m)
  (forall ofs : BinNums.Z, not (Memory.Mem.perm m elements_taptweak_modinfo_fe_block ofs Memtype.Max Memtype.Writable))
     : forall _ : Memory.Mem.mem, Prop

Arguments elements_taptweak_modinfo_fe_state m
