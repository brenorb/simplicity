### C.jet_secp_modinv_copies_modulus.exec_inv_mod_copy
exec_inv_mod_copy
     : forall (mu rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem) (g : bool)
         (_ : jet_sx_state.rep rho beta (inv_mod_copy_regs mu g) m)
         (_ : jet_sx_eval.tmatch rho beta jet_secp_modinv_var_entry.inv_start_temps le)
         (_ : jet_sx_eval.ematch beta
                (@snd (list jet_sx_state.region) jet_sx_eval.venv jet_secp_modinv_var_entry.inv_start_alloc) e)
         (_ : @eq BinNums.Z (jet_sx_state.bas beta (jet_secp_modinv_var_copies.inv_copy_source g)) BinNums.Z0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_modinv_var_copies.inv_copy_stmt g) Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (jet_sx_state.rep rho beta
                  match g return (list jet_sx_state.region) with
                  | true => inv_mod_fg_regs mu
                  | false => inv_mod_f_regs mu
                  end mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (_ : BinNums.Z) =>
                   not (@eq Values.block b (jet_sx_state.blk beta (jet_secp_modinv_var_copies.inv_copy_target g)))) m
