### C.jet_literal_division_add.literal_div3n2n_loop2_spec
literal_div3n2n_loop2_spec =
fun (n : nat) (term : Alg.Core.Algebra) =>
let dec : Alg.Core.domain term (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) :=
  @jet_subtract_spec.decrement_word_spec term n in
let add2w :
  Alg.Core.domain term (Ty.Prod (Word.Word (S n)) (Word.Word (S n)))
    (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S n))) := @jet_canonical_add_adapter.canonical_add_word (S n) term in
@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (S n)) (Ty.Prod (Word.Word n) (Word.Word (S n))))
  (Word.Word n) (Word.Word (S n)) term
  (@Alg.Core.Combinators.drop (Word.Word (S n)) (Ty.Prod (Word.Word n) (Word.Word (S n))) (Word.Word n) term
     (@Alg.Core.Combinators.take (Word.Word n) (Word.Word (S n)) (Word.Word n) term
        (@Alg.Core.Combinators.comp (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))
           (Word.Word n) term dec
           (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) (Word.Word n) term
              (@Alg.Core.Combinators.iden (Word.Word n) term)))))
  (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (S n)) (Ty.Prod (Word.Word n) (Word.Word (S n))))
     (Ty.Prod (Word.Word (S n)) (Word.Word (S n))) (Word.Word (S n)) term
     (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (S n)) (Ty.Prod (Word.Word n) (Word.Word (S n))))
        (Word.Word (S n)) (Word.Word (S n)) term
        (@Alg.Core.Combinators.take (Word.Word (S n)) (Ty.Prod (Word.Word n) (Word.Word (S n)))
           (Word.Word (S n)) term (@Alg.Core.Combinators.iden (Word.Word (S n)) term))
        (@Alg.Core.Combinators.drop (Word.Word (S n)) (Ty.Prod (Word.Word n) (Word.Word (S n)))
           (Word.Word (S n)) term
           (@Alg.Core.Combinators.drop (Word.Word n) (Word.Word (S n)) (Word.Word (S n)) term
              (@Alg.Core.Combinators.iden (Word.Word (S n)) term))))
     (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (S n)) (Word.Word (S n)))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S n))) (Word.Word (S n)) term add2w
        (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S n)) (Word.Word (S n)) term
           (@Alg.Core.Combinators.iden (Word.Word (S n)) term))))
     : forall (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word (S n)) (Ty.Prod (Word.Word n) (Word.Word (S n))))
         (Ty.Prod (Word.Word n) (Word.Word (S n)))

