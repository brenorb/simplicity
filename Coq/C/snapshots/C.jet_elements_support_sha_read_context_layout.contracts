### C.jet_elements_support_sha_read_context_layout.sg_eval_read_sha256_context_allocated_layout
sg_eval_read_sha256_context_allocated_layout
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bf : Values.block) (base : BinNums.Z)
         (bi : Values.block) (edge cursor : BinNums.Z) (bc : Values.block) (cbase : BinNums.Z)
         (bl bo : Values.block) (output : BinNums.Z)
         (buf : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
         (count : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (state : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block ma bl)) (_ : BinInt.Z.le BinNums.Z0 cbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm ma bc
                (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Writable)
         (_ : Memory.Mem.valid_access ma AST.Mint64 bc
                (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : Memory.Mem.valid_access ma AST.Mint8unsigned bc
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Memtype.Writable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr ma bc cbase)
                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr output)))) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le
                (BinInt.Z.add output
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) output)
         (_ : Memory.Mem.range_perm ma bo output
                (BinInt.Z.add output
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable) (_ : not (@eq Values.block bf bc)) (_ : not (@eq Values.block bf bi))
         (_ : not (@eq Values.block bc bi)) (_ : not (@eq Values.block bl bf)) (_ : not (@eq Values.block bl bc))
         (_ : not (@eq Values.block bl bi)) (_ : not (@eq Values.block bo bf)) (_ : not (@eq Values.block bo bi))
         (_ : not (@eq Values.block bo bc)) (_ : not (@eq Values.block bl bo))
         (_ : not (@eq Values.block bf (jet_elements_support_sha_linkage.sha_symbol_block jets._sha256_max_counter)))
         (_ : not (@eq Values.block bc (jet_elements_support_sha_linkage.sha_symbol_block jets._sha256_max_counter)))
         (_ : not (@eq Values.block bl (jet_elements_support_sha_linkage.sha_symbol_block jets._sha256_max_counter)))
         (_ : not (@eq Values.block bo (jet_elements_support_sha_linkage.sha_symbol_block jets._sha256_max_counter)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 ma
                   (jet_elements_support_sha_linkage.sha_symbol_block jets._sha256_max_counter) BinNums.Z0)
                (@Some Values.val
                   (Values.Vlong
                      (Integers.Int64.repr
                         (BinNums.Zpos
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : jet_frame_layout.frame_base_valid base) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at ma bf base bi edge cursor)
         (_ : Memory.Mem.valid_access ma AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at ma bi edge cursor
                (@app BitMachine.Cell
                   (@Translate.encode
                      (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) buf)
                   (@app BitMachine.Cell (@Translate.encode (Word.Word (S (S (S (S (S (S O))))))) count)
                      (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) state)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Integers.Int64.int
            (fun r : Integers.Int64.int =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
                  (@Ctypes.Internal Clight.function jets.f_simplicity_read_sha256_context)
                  (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase))
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
                  (Values.Vint (jet_readBit_layout.bit_int (negb (jet_read_sha256_overflow.sha256_read_overflow r)))))
               (and
                  (@eq BinNums.Z (Integers.Int64.unsigned r)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count))
                  (and
                     (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc cbase)
                        (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))))
                     (and
                        (jet_read8s_layout.uint8_array_at mf bc
                           (BinInt.Z.add cbase
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int
                              jet_read8s_layout.word8_array_value
                              (jet_buffer_chunks.byte_chunks_values
                                 (jet_buffer_input.buffer_byte_chunks (S (S (S (S (S O))))) buf))))
                        (and
                           (jet_uint32_array_init.uint32_array_at mf bo output
                              (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int
                                 jet_read32s_layout.word32_array_value
                                 (jet_word32_chunks.word32_chunks (S (S (S O))) state)))
                           (and
                              (@eq (option Values.val)
                                 (Memory.Mem.load AST.Mint64 mf bc
                                    (BinInt.Z.add cbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (@Some Values.val
                                    (Values.Vlong
                                       (jet_read_sha256_counter.sha256_read_counter r
                                          (Integers.Int64.repr
                                             (BinInt.Z.of_nat
                                                (@length (Ty.tySem (Word.Word (S (S (S O)))))
                                                   (jet_buffer_chunks.byte_chunks_values
                                                      (jet_buffer_input.buffer_byte_chunks (S (S (S (S (S O))))) buf)))))))))
                              (and
                                 (@eq (option Values.val)
                                    (Memory.Mem.load AST.Mint8unsigned mf bc
                                       (BinInt.Z.add cbase
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                                    (@Some Values.val
                                       (Values.Vint
                                          (jet_readBit_layout.bit_int (jet_read_sha256_overflow.sha256_read_overflow r)))))
                                 (and
                                    (jet_frame_layout.frame_fields_at mf bf base bi edge
                                       (BinInt.Z.add cursor
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                                    (and
                                       (@eq (option Values.val)
                                          (Memory.Mem.load AST.Mint64 mf
                                             (jet_elements_support_sha_linkage.sha_symbol_block
                                                jets._sha256_max_counter) BinNums.Z0)
                                          (@Some Values.val
                                             (Values.Vlong
                                                (Integers.Int64.repr
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))
                                       (and
                                          (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                             (p : Memtype.permission) (_ : not (@eq Values.block b bl))
                                             (_ : Memory.Mem.perm ma b ofs kind p), Memory.Mem.perm mf b ofs kind p)
                                          (and
                                             (forall (chunk : AST.memory_chunk) (b : Values.block)
                                                (ofs : BinNums.Z) (_ : not (@eq Values.block b bl))
                                                (_ : or (not (@eq Values.block b bf))
                                                       (or
                                                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                             (BinInt.Z.add base
                                                                (BinNums.Zpos
                                                                   (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                          (BinInt.Z.le
                                                             (BinInt.Z.add base
                                                                (BinNums.Zpos
                                                                   (BinNums.xO (BinNums.xO (BinNums.xO ...))))) ofs)))
                                                (_ : or (not (@eq Values.block b bc))
                                                       (or
                                                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                             (BinInt.Z.add cbase
                                                                (BinNums.Zpos
                                                                   (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                          (BinInt.Z.le
                                                             (BinInt.Z.add cbase
                                                                (BinNums.Zpos
                                                                   (BinNums.xI (BinNums.xO (BinNums.xO ...))))) ofs)))
                                                (_ : or (not (@eq Values.block b bo))
                                                       (or
                                                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                             output)
                                                          (BinInt.Z.le
                                                             (BinInt.Z.add output
                                                                (BinNums.Zpos
                                                                   (BinNums.xO (BinNums.xO (BinNums.xO ...))))) ofs))),
                                              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                                (Memory.Mem.load chunk ma b ofs))
                                             (forall (b : Values.block) (_ : Memory.Mem.valid_block ma b),
                                              Memory.Mem.valid_block mf b)))))))))))))
