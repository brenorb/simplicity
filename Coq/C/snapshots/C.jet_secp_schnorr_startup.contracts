### C.jet_secp_schnorr_startup.schnorr_startup_initial
schnorr_startup_initial
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       schnorr_startup m
### C.jet_secp_schnorr_startup.schnorr_startup_exists
schnorr_startup_exists
     : @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                  (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m))
            (schnorr_startup m))
### C.jet_secp_schnorr_startup.secp_sha_startup_framed_forward
secp_sha_startup_framed_forward
     : forall (m mf : Memory.Mem.mem) (P : forall (_ : Values.block) (_ : BinNums.Z), Prop)
         (_ : jet_secp_sha_startup.secp_sha_startup m) (_ : jet_clight_forward.mem_forward m mf)
         (_ : jet_sx_mem.lframe P m mf)
         (_ : forall ofs : BinNums.Z,
              and (P jet_secp_sha_startup.secp_sha_dispatch_block ofs)
                (P jet_secp_sha_startup.secp_sha_counter_block ofs)), jet_secp_sha_startup.secp_sha_startup mf
### C.jet_secp_schnorr_startup.schnorr_startup_framed
schnorr_startup_framed
     : forall (m mf : Memory.Mem.mem) (_ : schnorr_startup m) (_ : jet_clight_forward.mem_forward m mf)
         (_ : jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mf), schnorr_startup mf
### C.jet_secp_schnorr_startup.schnorr_owned_slots_exclude
schnorr_owned_slots_exclude
     : forall (m : Memory.Mem.mem) (slots : list (prod Values.block BinNums.Z)) (global : Values.block)
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi) slots),
              and (BinInt.Z.lt BinNums.Z0 hi) (Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable))
         (_ : forall pos : BinNums.Z, not (Memory.Mem.perm m global pos Memtype.Max Memtype.Freeable)),
       not
         (@List.In Values.block global
            (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) slots))
### C.jet_secp_schnorr_startup.schnorr_startup_owned_forward
schnorr_startup_owned_forward
     : forall (m mf : Memory.Mem.mem) (slots : list (prod Values.block BinNums.Z)) (_ : schnorr_startup m)
         (_ : jet_clight_forward.mem_forward m mf)
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi) slots),
              and (BinInt.Z.lt BinNums.Z0 hi) (Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable))
         (_ : jet_sx_mem.lframe
                (fun (b : Values.block) (_ : BinNums.Z) =>
                 not
                   (@List.In Values.block b
                      (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) slots))) m mf),
       schnorr_startup mf
