         (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) m
         (jet_secp_gej_affine_arithmetic.affine_local_env b2 b3) (affine_entry_temps br bp) mi
### C.jet_secp_gej_affine_entry.exec_affine_finite_flag
exec_affine_finite_flag
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bp b2 b3 : Values.block)
