### C.jet_secp_gej_affine_entry.affine_helper_entry
affine_helper_entry
     : forall (m : Memory.Mem.mem) (m1 mi : Memory.Mem.mem') (b2 b3 br bp : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m1 b2))
