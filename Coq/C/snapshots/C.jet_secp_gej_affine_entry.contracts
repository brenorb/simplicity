### C.jet_secp_gej_affine_entry.affine_entry_to_inverse_core
affine_entry_to_inverse_core
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bp br : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : jet_secp_modinfo_fe_global.modinfo_fe_global_rep m)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Values.block
         (fun b2 : Values.block =>
          @ex Values.block
            (fun b3 : Values.block =>
             @ex Memory.Mem.mem
               (fun ma : Memory.Mem.mem =>
                @ex Values.block
                  (fun bt : Values.block =>
                   @ex Values.block
                     (fun bs : Values.block =>
                      @ex Memory.Mem.mem
                        (fun mi : Memory.Mem.mem =>
                         @ex Memory.Mem.mem
                           (fun mf : Memory.Mem.mem =>
                            and
                              (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_ge_set_gej_var
                                 (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) m
                                 (jet_secp_gej_affine_arithmetic.affine_local_env b2 b3) (affine_entry_temps br bp) ma)
                              (and
                                 (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
                                    (jet_secp_gej_affine_arithmetic.affine_local_env b2 b3)
                                    (affine_entry_temps br bp) ma affine_flag_statement Events.E0
                                    (affine_finite_temps br bp) ma ClightBigstep.Out_normal)
                                 (and
                                    (Clight.eval_exprlist jet_secp_linkage.secp_ge
                                       (jet_secp_gej_affine_arithmetic.affine_local_env b2 b3)
                                       (affine_finite_temps br bp) ma
                                       (@cons Clight.expr
                                          (jet_secp_gej_affine_arithmetic.affine_point_address jets_secp._z)
                                          (@cons Clight.expr
                                             (jet_secp_gej_affine_arithmetic.affine_point_address jets_secp._z)
                                             (@nil Clight.expr)))
                                       (Ctypes.type_of_params (Clight.fn_params jets_secp.f_secp256k1_fe_inv_var))
                                       (@cons Values.val
                                          (Values.Vptr bp
                                             (Integers.Ptrofs.repr
                                                (BinNums.Zpos
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...))))))))
                                          (@cons Values.val
                                             (Values.Vptr bp
                                                (Integers.Ptrofs.repr
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))
                                             (@nil Values.val))))
                                    (and
                                       (Clight.function_entry2 jet_secp_linkage.secp_ge
                                          jets_secp.f_secp256k1_fe_inv_var
                                          (@cons Values.val
                                             (Values.Vptr bp
                                                (Integers.Ptrofs.repr
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))
                                             (@cons Values.val
                                                (Values.Vptr bp
                                                   (Integers.Ptrofs.repr
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                                (@nil Values.val))) ma (jet_secp_fe_inv_statements.fe_inv_env bt bs)
                                          (jet_secp_fe_inv_prefix.fe_inv_slice_temps bp
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                             bp
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                          mi)
                                       (and
                                          (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
                                             (jet_secp_fe_inv_statements.fe_inv_env bt bs)
                                             (jet_secp_fe_inv_prefix.fe_inv_slice_temps bp
                                                (BinNums.Zpos
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...))))))
                                                bp
                                                (BinNums.Zpos
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))
                                             mi jet_secp_fe_inv_prefix.fe_inv_prefix Events.E0
                                             (jet_secp_fe_inv_prefix.fe_inv_slice_temps bp
                                                (BinNums.Zpos
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...))))))
                                                bp
                                                (BinNums.Zpos
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))
                                             mf ClightBigstep.Out_normal)
                                          (and
                                             (jet_sx_state.rep (jet_secp_fe_inv_prefix.fe_inv_packed_words w)
                                                (@cons (prod Values.block BinNums.Z)
                                                   (@pair Values.block BinNums.Z bs BinNums.Z0)
                                                   (@cons (prod Values.block BinNums.Z)
                                                      (@pair Values.block BinNums.Z
                                                         jet_secp_modinfo_fe_global.modinfo_fe_block BinNums.Z0)
                                                      (@nil (prod Values.block BinNums.Z))))
                                                jet_secp_modinv_var_entry.inv_start_regs mf)
                                             (and
                                                (jet_secp_fe_nv.fe_at mf bs BinNums.Z0
                                                   (jet_secp_multiply_normalize_bridge.words5
                                                      (jet_secp_fe_inv_prefix.fe_inv_packed_words w)))
                                                (and
                                                   (jet_secp_fe_nv.fe_at mf bp
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))
                                                      (jet_secp_multiply_normalize_bridge.words5 w))
                                                   (and
                                                      (Memory.Mem.range_perm mf bp BinNums.Z0
                                                         (BinNums.Zpos (BinNums.xO (BinNums.xO ...))) Memtype.Cur
                                                         Memtype.Freeable)
                                                      (and
                                                         (Memory.Mem.range_perm mf br BinNums.Z0
                                                            (BinNums.Zpos (BinNums.xO ...)) Memtype.Cur
                                                            Memtype.Freeable)
                                                         (and
                                                            (Memory.Mem.range_perm mf b2 BinNums.Z0
                                                               (BinNums.Zpos ...) Memtype.Cur Memtype.Freeable)
                                                            (and
                                                               (Memory.Mem.range_perm mf b3 BinNums.Z0 ... Memtype.Cur
                                                                  Memtype.Freeable) (and ... ...)))))))))))))))))))
### C.jet_secp_gej_affine_entry.affine_entry_temps
affine_entry_temps =
fun br bp : Values.block =>
@Maps.PTree.set Values.val jets_secp._a (Values.Vptr bp Integers.Ptrofs.zero)
  (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr br Integers.Ptrofs.zero)
     (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_ge_set_gej_var)))
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree Values.val

Arguments affine_entry_temps br bp
### C.jet_secp_gej_affine_entry.affine_finite_temps
affine_finite_temps =
fun br bp : Values.block =>
@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint Integers.Int.zero) (affine_entry_temps br bp)
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree Values.val

Arguments affine_finite_temps br bp
### C.jet_secp_gej_affine_entry.affine_flag_statement
affine_flag_statement =
match Clight.fn_body jets_secp.f_secp256k1_ge_set_gej_var return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence flag _ => flag
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_gej_affine_entry.affine_inverse_statement
affine_inverse_statement =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_inv_var jets_secp.f_secp256k1_fe_inv_var
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_gej_affine_arithmetic.affine_point_address jets_secp._z)
     (@cons Clight.expr (jet_secp_gej_affine_arithmetic.affine_point_address jets_secp._z) (@nil Clight.expr)))
     : Clight.statement
