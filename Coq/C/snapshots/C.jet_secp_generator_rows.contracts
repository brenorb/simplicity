### C.jet_secp_generator_rows.generator_row_signed_numeric
generator_row_signed_numeric =
fun (row : list AST.init_data) (neg : bool) =>
match generator_row_numeric row return (prod BinNums.Z BinNums.Z) with
| pair x y =>
    @pair BinNums.Z BinNums.Z x
      match neg return BinNums.Z with
      | true => BinInt.Z.modulo (BinInt.Z.sub jet_secp_fe_math.feP y) jet_secp_fe_math.feP
      | false => y
      end
end
     : forall (_ : list AST.init_data) (_ : bool), prod BinNums.Z BinNums.Z

