### C.jet_secp_generator_rows.generator_chunks8
generator_chunks8 =
fix generator_chunks8 (A : Type) (ds : list A) {struct ds} : list (list A) :=
  match ds return (list (list A)) with
  | nil => @nil (list A)
  | cons a l =>
      match l return (list (list A)) with
      | nil => @nil (list A)
      | cons b l0 =>
          match l0 return (list (list A)) with
          | nil => @nil (list A)
          | cons c l1 =>
              match l1 return (list (list A)) with
              | nil => @nil (list A)
              | cons d l2 =>
                  match l2 return (list (list A)) with
                  | nil => @nil (list A)
                  | cons e l3 =>
                      match l3 return (list (list A)) with
                      | nil => @nil (list A)
                      | cons f l4 =>
                          match l4 return (list (list A)) with
                          | nil => @nil (list A)
                          | cons g l5 =>
                              match l5 return (list (list A)) with
                              | nil => @nil (list A)
                              | cons h tail =>
                                  @cons (list A)
                                    (@cons A a
                                       (@cons A b
                                          (@cons A c
                                             (@cons A d (@cons A e (@cons A f (@cons A g (@cons A h (@nil A)))))))))
                                    (generator_chunks8 A tail)
                              end
                          end
                      end
                  end
              end
          end
      end
  end
     : forall (A : Type) (_ : list A), list (list A)

Arguments generator_chunks8 {A}%type_scope ds%list_scope
