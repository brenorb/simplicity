    (fun row : list AST.init_data => generator_row_signed_numeric row neg) (generator_table_rows high) in
match neg return (list (prod BinNums.Z BinNums.Z)) with
| true => @List.rev (prod BinNums.Z BinNums.Z) rows
| false => rows
end
     : forall (_ : bool) (_ : bool), list (prod BinNums.Z BinNums.Z)

