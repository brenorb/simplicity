### C.jet_secp_x_equiv_literal.literal_x_equiv_step
literal_x_equiv_step
     : forall q x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (Bit.toBool
            (@literal_gej_x_equiv Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (prod
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) q
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))))
         (andb (negb (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem z)))
            (Bit.toBool
               (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
                  (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem x)
                        (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem z) q)))))))
### C.jet_secp_x_equiv_literal.x_equiv_mod_neg_add
x_equiv_mod_neg_add
     : forall a b : BinNums.Z,
       @eq bool
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (BinInt.Z.add (BinInt.Z.modulo (BinInt.Z.sub jet_secp_fe_math.feP a) jet_secp_fe_math.feP)
                  (BinInt.Z.modulo b jet_secp_fe_math.feP)) jet_secp_fe_math.feP) BinNums.Z0)
         (BinInt.Z.eqb (BinInt.Z.modulo a jet_secp_fe_math.feP) (BinInt.Z.modulo b jet_secp_fe_math.feP))
### C.jet_secp_x_equiv_literal.literal_x_equiv_numeric
literal_x_equiv_numeric
     : forall q x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (Bit.toBool
            (@literal_gej_x_equiv Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (prod
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) q
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))))
         (andb
            (negb
               (BinInt.Z.eqb
                  (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z)
                     jet_secp_fe_math.feP) BinNums.Z0))
            (BinInt.Z.eqb
               (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                  jet_secp_fe_math.feP)
               (BinInt.Z.modulo
                  (BinInt.Z.mul
                     (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z)
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z))
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) q)) jet_secp_fe_math.feP)))
### C.jet_secp_x_equiv_literal.literal_gej_x_equiv_parametric
literal_gej_x_equiv_parametric
     : @Alg.Core.Parametric
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
