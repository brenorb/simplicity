                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add tbase BinNums.Z0))
                (@Some Values.val (Values.Vlong Integers.Int64.zero))),
       not (jet_bitcoin_tappath_local.bitcoin_tappath_env_rep m (Values.Vptr be (Integers.Ptrofs.repr ebase)) e fp)
