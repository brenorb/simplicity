### C.jet_secp_sha_bytestring48.secp_sha48_padded_words
secp_sha48_padded_words
     : forall (message : list Integers.Byte.int)
         (_ : @eq nat (@length Integers.Byte.int message)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq (list Integers.Int.int)
         (jet_sha_ctx8_model.be_words
            (@app Integers.Int.int
               (@List.map Integers.Byte.int Integers.Int.int jet_entropy_streaming_byte_blocks.byte_int message)
               (jet_sha_finalize_exec.sha_pad
                  (Integers.Int64.repr
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
         (SHA256.generate_and_pad message)
### C.jet_secp_sha_bytestring48.secp_sha48_bytestring
secp_sha48_bytestring
     : forall (message : list Integers.Byte.int)
         (_ : @eq nat (@length Integers.Byte.int message)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq SHA256.registers
         (SHA256.hash_block jet_sha256_iv_init.sha256_iv_words
            (jet_sha_ctx8_model.be_words
               (@app Integers.Int.int
                  (@List.map Integers.Byte.int Integers.Int.int jet_entropy_streaming_byte_blocks.byte_int message)
                  (jet_sha_finalize_exec.sha_pad
                     (Integers.Int64.repr
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
         (Digest.hash256_reg (Digest.byteStringHash message))
