### C.jet_sha256_ctx8_init_exec.eval_sha256_ctx8_init_composes
eval_sha256_ctx8_init_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb mc md : Memory.Mem.mem') (ms mi mx me mf : Memory.Mem.mem)
         (bl bi bc br bf : Values.block) (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (srcbytes ctxbytes : list Memdata.memval) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs)) (_ : not (@eq Values.block bc br))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb bi))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mb BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block mc bc))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mc BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block md br))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes md bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) srcbytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes md bl BinNums.Z0 srcbytes) (@Some Memory.Mem.mem ms))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 ms (@Ctypes.Internal Clight.function jets.f_sha256_init)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bi Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mi
                Values.Vundef)
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mi br BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some (list Memdata.memval) ctxbytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mi bc BinNums.Z0 ctxbytes) (@Some Memory.Mem.mem mx))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mx
                (@Ctypes.Internal Clight.function jets.f_simplicity_write_sha256_context)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 me
                (Values.Vint Integers.Int.one))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free_list me (Clight.blocks_of_env jet_exec.ge0 (ctx_init_env bl bi bc br)))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_sha_256_ctx_8_init)
         (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_sha256_ctx8_init_exec.ctx_init_env
ctx_init_env =
fun bl bi bc br : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets.__res
  (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets._ctx
     (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))
     (jet_sha256_iv_exec.sha256_iv_jet_env bl bi))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block),
       Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments ctx_init_env bl bi bc br
### C.jet_sha256_ctx8_init_exec.ctx_init_temps
ctx_init_temps =
fun (env : Values.val) (bf : Values.block) (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_sha_256_ctx_8_init bf (Integers.Ptrofs.repr base) bs
  (Integers.Ptrofs.repr sbase)
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments ctx_init_temps env bf base%Z_scope bs sbase%Z_scope
