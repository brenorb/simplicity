### C.jet_sha256_ctx8_init_exec.ctx_init_entry
ctx_init_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb mc md : Memory.Mem.mem') (bl bi bc br bf : Values.block)
         (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb bi))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mb BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block mc bc))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mc BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block md br)),
       Clight.function_entry2 jet_exec.ge0 jets.f_simplicity_sha_256_ctx_8_init
         (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (ctx_init_env bl bi bc br) (ctx_init_temps env bf base bs sbase) md
### C.jet_sha256_ctx8_init_exec.ctx_init_sha_symbol
ctx_init_sha_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._sha256_init)
         (@Some Values.block (jet_exec.jet_symbol_block jets._sha256_init))
### C.jet_sha256_ctx8_init_exec.ctx_init_sha_funct
ctx_init_sha_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._sha256_init) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_sha256_init))
