### C.jet_secp_curve_body.exec_curve_finite_body
exec_curve_finite_body
     : forall (le : Maps.PTree.tree Values.val) (x y : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (ba b_y2 bx : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero))) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds y) (_ : not (@eq Values.block ba b_y2))
         (_ : not (@eq Values.block ba bx)) (_ : not (@eq Values.block b_y2 bx))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b_y2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
               (jet_secp_curve_statements.curve_helper_env b_y2 bx) le m
               (Clight.fn_body jets_secp.f_secp256k1_ge_is_valid_var) Events.E0 (curve_body_temps le x y) mf
               (ClightBigstep.Out_return
                  (@Some (prod Values.val Ctypes.type)
                     (@pair Values.val Ctypes.type (Values.Vint (curve_result x y)) Ctypesdefs.tint))))
            (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf ba
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (Memory.Mem.range_perm mf ba BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf b_y2 BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bx BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (_ : BinNums.Z) =>
                               and (not (@eq Values.block b ba))
                                 (and (not (@eq Values.block b b_y2)) (not (@eq Values.block b bx)))) m mf)))))))
### C.jet_secp_curve_body.curve_result
curve_result =
fun x y : forall _ : nat, Integers.Int64.int =>
match
  BinInt.Z.eqb
    (BinInt.Z.modulo
       (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value y) (jet_secp_multiply_finish_product.radix_value y))
       jet_secp_fe_math.feP)
    (BinInt.Z.modulo
       (BinInt.Z.add
          (BinInt.Z.mul
             (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value x)
                (jet_secp_multiply_finish_product.radix_value x)) (jet_secp_multiply_finish_product.radix_value x))
          (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) jet_secp_fe_math.feP) return Integers.Int.int
with
| true => Integers.Int.one
| false => Integers.Int.zero
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int), Integers.Int.int

Arguments curve_result (x y)%function_scope
### C.jet_secp_curve_body.curve_body_temps
curve_body_temps =
fun (le : Maps.PTree.tree Values.val) (x y : forall _ : nat, Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint (curve_result x y))
  (@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint Integers.Int.zero) le)
     : forall (_ : Maps.PTree.tree Values.val) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int), Maps.PTree.tree Values.val

Arguments curve_body_temps le (x y)%function_scope
