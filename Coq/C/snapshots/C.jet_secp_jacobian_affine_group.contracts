### C.jet_secp_jacobian_affine_group.secp_jacobian_affine_curve
secp_jacobian_affine_curve
     : forall (x y z : jet_secp_curve_group.secp_group_field) (_ : jet_secp_jacobian_group.secp_jacobian_curve x y z)
         (_ : not (@eq jet_secp_curve_group.secp_group_field z (GZnZ.zero jet_secp_fe_math.feP))),
       @eq (GZnZ.znz jet_secp_fe_math.feP)
         (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
            (GZnZ.div jet_secp_fe_math.feP y (GZnZ.mul jet_secp_fe_math.feP (GZnZ.mul jet_secp_fe_math.feP z z) z))
            (S (S O)))
         (GZnZ.add jet_secp_fe_math.feP
            (GZnZ.add jet_secp_fe_math.feP
               (@SMain.pow (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                  (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP x (GZnZ.mul jet_secp_fe_math.feP z z))
                  (S (S (S O))))
               (GZnZ.mul jet_secp_fe_math.feP (GZnZ.zero jet_secp_fe_math.feP)
                  (GZnZ.div jet_secp_fe_math.feP x (GZnZ.mul jet_secp_fe_math.feP z z))))
            jet_secp_curve_group.secp_group_seven)
### C.jet_secp_jacobian_affine_group.secp_jacobian_affine_value
secp_jacobian_affine_value
     : forall (x y z : jet_secp_curve_group.secp_group_field)
         (Curve : jet_secp_jacobian_group.secp_jacobian_curve x y z)
         (Nonzero : not (@eq jet_secp_curve_group.secp_group_field z (GZnZ.zero jet_secp_fe_math.feP))),
       @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (jet_secp_jacobian_group.secp_jacobian_group_value x y z Curve)
         (@SMain.curve_elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
            jet_secp_curve_group.secp_group_seven (GZnZ.div jet_secp_fe_math.feP x (GZnZ.mul jet_secp_fe_math.feP z z))
            (GZnZ.div jet_secp_fe_math.feP y (GZnZ.mul jet_secp_fe_math.feP (GZnZ.mul jet_secp_fe_math.feP z z) z))
            (secp_jacobian_affine_curve x y z Curve Nonzero))
