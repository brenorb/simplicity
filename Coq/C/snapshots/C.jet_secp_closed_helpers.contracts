### C.jet_secp_closed_helpers.secp_closed_helpers
secp_closed_helpers =
@List.filter (prod BinNums.positive Clight.function)
  (fun it : prod BinNums.positive Clight.function =>
   @List.existsb BinNums.positive (BinPos.Pos.eqb (@fst BinNums.positive Clight.function it)) secp_closed_ids)
  jet_secp_fns.secp_pure
     : list (prod BinNums.positive Clight.function)
