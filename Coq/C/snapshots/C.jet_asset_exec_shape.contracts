### C.jet_asset_exec_shape.asset_amount_body
asset_amount_body
     : @eq Clight.statement (Clight.fn_body jets_elements.f_simplicity_asset_amount_hash)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_elements._src jet_nonce_context_shape.nc_fr)
               (Clight.Etempvar jets_elements._src jet_nonce_context_shape.nc_fr))
            (jet_elements_support_sha_add_n_init.an_init
               (Clight.Ssequence jet_nonce_context_shape.nc_context_read
                  (Clight.Ssequence asset_prefix
                     (Clight.Ssequence jet_nonce_context_shape.nc_readbytes
                        (Clight.Ssequence jet_nonce_context_shape.nc_uchars
                           (Clight.Ssequence amount_phase asset_amount_write)))))))
### C.jet_asset_exec_shape.asset_amount_input_bits
asset_amount_input_bits
     : @eq nat (Translate.bitSize asset_amount_input_type)
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))))
### C.jet_asset_exec_shape.asset_amount_entry
asset_amount_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 : Memory.Mem.mem') (bl bm bb bx bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bm))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 bb))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m4 bx)),
       Clight.function_entry2 jet_elements_linkage.elements_ge jets_elements.f_simplicity_asset_amount_hash
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (jet_nonce_context_shape.nc_env bl bm bb bx) (asset_amount_temps env bd dbase bs sbase) m4
### C.jet_asset_exec_shape.asset_amount_input_type
asset_amount_input_type =
Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
  (Ty.Prod jet_nonce_context_spec.nonce_conf_type
     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S O)))))))))
     : Ty.Ty
### C.jet_asset_exec_shape.asset_prefix
asset_prefix =
jet_asset_exec_prefix.tagged_prefix jets_elements._t'3 jets_elements._t'2
  (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))
  (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))
     : Clight.statement
### C.jet_asset_exec_shape.amount_read8
amount_read8 =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._read8s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar)
           (Ctypes.Tcons Ctypesdefs.tulong
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Evar jets_elements._buf
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@cons Clight.expr
        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
           Ctypesdefs.tint)
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_elements._src jet_nonce_context_shape.nc_fr)
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) (@nil Clight.expr))))
     : Clight.statement
### C.jet_asset_exec_shape.amount_absorb8
amount_absorb8 =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._sha256_uchars
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Evar jets_elements._buf
           (Ctypesdefs.tarray Ctypesdefs.tuchar
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        (@cons Clight.expr
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              Ctypesdefs.tint) (@nil Clight.expr))))
     : Clight.statement
### C.jet_asset_exec_shape.amount_skip
amount_skip =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._forwardBits
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_elements._src jet_nonce_context_shape.nc_fr)
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Ebinop Cop.Osub
           (Clight.Econst_int
              (Integers.Int.repr
                 (BinNums.Zpos
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
              Ctypesdefs.tint)
           (Clight.Econst_int
              (Integers.Int.repr
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
              Ctypesdefs.tint) Ctypesdefs.tint) (@nil Clight.expr)))
     : Clight.statement
### C.jet_asset_exec_shape.amount_phase
amount_phase =
Clight.Ssequence (jet_nonce_context_shape.nc_readbit jets_elements._t'5)
  (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'5 Ctypesdefs.tbool)
     (Clight.Ssequence (jet_nonce_context_shape.nc_uchar (BinNums.Zpos BinNums.xH))
        (Clight.Ssequence amount_skip (Clight.Ssequence amount_read8 amount_absorb8)))
     (Clight.Ssequence
        (Clight.Ssequence (jet_nonce_context_shape.nc_readbit jets_elements._t'4)
           (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'4 Ctypesdefs.tbool)
              (jet_nonce_context_shape.nc_uchar (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))
              (jet_nonce_context_shape.nc_uchar (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
        (Clight.Ssequence jet_nonce_context_shape.nc_readbytes jet_nonce_context_shape.nc_uchars)))
     : Clight.statement
### C.jet_asset_exec_shape.asset_amount_write
asset_amount_write =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_elements._t'6)
     (Clight.Evar jets_elements._simplicity_write_sha256_context
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof
              (Clight.Evar jets_elements._ctx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr)))
           (@nil Clight.expr))))
  (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_elements._t'6 Ctypesdefs.tbool)))
     : Clight.statement
### C.jet_asset_exec_shape.asset_phase
asset_phase =
Clight.Ssequence asset_prefix (Clight.Ssequence jet_nonce_context_shape.nc_readbytes jet_nonce_context_shape.nc_uchars)
     : Clight.statement
### C.jet_asset_exec_shape.asset_amount_temps
asset_amount_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_elements._env env
  (@Maps.PTree.set Values.val jets_elements._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_elements._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_simplicity_asset_amount_hash))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments asset_amount_temps env bd dbase%Z_scope bs sbase%Z_scope
