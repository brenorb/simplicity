### C.jet_secp_field_negate_magnitude.negate_mag_run
negate_mag_run
     : forall c : Integers.Int.int,
       @eq (option jet_sx_exec.res)
         (jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
            (jet_sx_pure.int_table jet_secp_fns.secp_pure)
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))
            jets_secp.f_secp256k1_fe_negate (negate_mag_args c) negate_mag_regs (@nil jet_sx_eval.event)
            (S (S (S (S (S O)))))) (@Some jet_sx_exec.res (jet_sx_exec.RDone (negate_mag_state c) jet_sx_exec.ONormal))
### C.jet_secp_field_negate_magnitude.negate_mag_output
negate_mag_output
     : forall c : Integers.Int.int,
       @eq (list jet_sx_state.region) (jet_sx_eval.sregs (negate_mag_state c))
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (negate_mag_out c)) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@nil jet_sx_state.region))
### C.jet_secp_field_negate_magnitude.negate_mag_return
negate_mag_return
     : forall c : Integers.Int.int,
       @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps (negate_mag_state c)))
         (@None jet_sx_expr.sx)
### C.jet_secp_field_negate_magnitude.negate_mag_output_den
negate_mag_output_den
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den w (jet_sx_state.lay beta)) (negate_mag_out c))
         (@List.map Integers.Int64.int Values.val Values.Vlong
            (jet_secp_multiply_normalize_bridge.words5 (negate_mag_words c w)))
### C.jet_secp_field_negate_magnitude.negate_mag_constant
negate_mag_constant
     : forall (c : Integers.Int.int) (i : nat)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.signed c))
                (BinInt.Z.le (Integers.Int.signed c) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))),
       @eq Integers.Int64.int (negate_mag_machine_constant c i)
         (Integers.Int64.repr
            (BinInt.Z.mul
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinInt.Z.add (Integers.Int.signed c) (BinNums.Zpos BinNums.xH)))
               (jet_secp_field_negate_values.negate_mask i)))
### C.jet_secp_field_negate_magnitude.negate_mag_unsigned
negate_mag_unsigned
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (i : nat)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.signed c))
                (BinInt.Z.le (Integers.Int.signed c) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
         (_ : lt i (S (S (S (S (S O))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned (w i))
                (BinInt.Z.mul
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinInt.Z.add (Integers.Int.signed c) (BinNums.Zpos BinNums.xH)))
                   (jet_secp_field_negate_values.negate_mask i))),
       @eq BinNums.Z (Integers.Int64.unsigned (negate_mag_words c w i))
         (BinInt.Z.sub
            (BinInt.Z.mul
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinInt.Z.add (Integers.Int.signed c) (BinNums.Zpos BinNums.xH)))
               (jet_secp_field_negate_values.negate_mask i)) (Integers.Int64.unsigned (w i)))
### C.jet_secp_field_negate_magnitude.negate_mag_numeric
negate_mag_numeric
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.signed c))
                (BinInt.Z.le (Integers.Int.signed c) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
         (_ : negate_mag_input_bounds c w),
       and
         (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (negate_mag_words c w))
            (BinInt.Z.sub
               (BinInt.Z.mul
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinInt.Z.add (Integers.Int.signed c) (BinNums.Zpos BinNums.xH))) jet_secp_fe_math.feP)
               (jet_secp_multiply_finish_product.radix_value w)))
         (jet_secp_square_columns.square_input_bounds (negate_mag_words c w))
### C.jet_secp_field_negate_magnitude.negate_mag_scaled_input
negate_mag_scaled_input
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.signed c))
                (BinInt.Z.le (Integers.Int.signed c) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
         (_ : jet_secp_field_mul_small.mul_small_input_bounds w),
       negate_mag_input_bounds c (jet_secp_field_mul_small.mul_small_words c w)
### C.jet_secp_field_negate_magnitude.eval_negate_mag_symbolic
eval_negate_mag_symbolic
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem) (_ : jet_sx_state.rep w beta negate_mag_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                     (@cons Values.val (Values.Vint c) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_sx_state.rep w beta
                  (@cons jet_sx_state.region
                     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (negate_mag_out c)) true
                        (@Some BinNums.Z
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@nil jet_sx_state.region)) mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot beta
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape negate_mag_regs) b pos)) m mf)))
### C.jet_secp_field_negate_magnitude.negate_mag_result
negate_mag_result
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep w beta
                (@cons jet_sx_state.region
                   (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (negate_mag_out c)) true
                      (@Some BinNums.Z
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                   (@nil jet_sx_state.region)) m),
       and
         (jet_secp_fe_nv.fe_at m (jet_sx_state.blk beta O) (jet_sx_state.bas beta O)
            (jet_secp_multiply_normalize_bridge.words5 (negate_mag_words c w)))
         (Memory.Mem.range_perm m (jet_sx_state.blk beta O) BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
### C.jet_secp_field_negate_magnitude.eval_negate_mag_from_storage
eval_negate_mag_from_storage
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem)
         (b : Values.block) (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vint c) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (negate_mag_words c w)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf))))
### C.jet_secp_field_negate_magnitude.eval_negate_mag_bounded
eval_negate_mag_bounded
     : forall (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem)
         (b : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.signed c))
                (BinInt.Z.le (Integers.Int.signed c) (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
         (_ : negate_mag_input_bounds c w)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vint c) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (negate_mag_words c w)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (negate_mag_words c w))
                        (BinInt.Z.sub
                           (BinInt.Z.mul
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                                 (BinInt.Z.add (Integers.Int.signed c) (BinNums.Zpos BinNums.xH))) jet_secp_fe_math.feP)
                           (jet_secp_multiply_finish_product.radix_value w)))
                     (and (jet_secp_square_columns.square_input_bounds (negate_mag_words c w))
                        (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m
                           mf))))))
### C.jet_secp_field_negate_magnitude.negate_mag_regs
negate_mag_regs = jet_secp_field_mul_small.mul_small_regs
     : list jet_sx_state.region
### C.jet_secp_field_negate_magnitude.negate_mag_args
negate_mag_args =
fun c : Integers.Int.int =>
@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0) (@cons jet_sx_expr.sx (jet_sx_expr.XI c) (@nil jet_sx_expr.sx)))
     : forall _ : Integers.Int.int, list jet_sx_expr.sx

Arguments negate_mag_args c
### C.jet_secp_field_negate_magnitude.negate_mag_state
negate_mag_state =
fun c : Integers.Int.int =>
match
  jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
    (jet_sx_pure.int_table jet_secp_fns.secp_pure)
    (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))) jets_secp.f_secp256k1_fe_negate
    (negate_mag_args c) negate_mag_regs (@nil jet_sx_eval.event) (S (S (S (S (S O))))) return jet_sx_eval.sstate
with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : forall _ : Integers.Int.int, jet_sx_eval.sstate

Arguments negate_mag_state c
### C.jet_secp_field_negate_magnitude.negate_mag_expr
negate_mag_expr =
fun (c : Integers.Int.int) (i : nat) =>
jet_sx_expr.XLb jet_sx_expr.Bsub
  (jet_sx_expr.XLb jet_sx_expr.Bmul
     (jet_sx_expr.XLb jet_sx_expr.Bmul
        (jet_sx_expr.XLc (Integers.Int64.repr (jet_secp_field_negate_values.negate_mask i)))
        (jet_sx_expr.XI2L Ctypes.Signed (jet_sx_expr.XIc (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))))
     (jet_sx_expr.XI2L Ctypes.Signed
        (jet_sx_expr.XIb jet_sx_expr.Badd (jet_sx_expr.XI c) (jet_sx_expr.XIc Integers.Int.one))))
  (jet_sx_expr.XLv i)
     : forall (_ : Integers.Int.int) (_ : nat), jet_sx_expr.sx

Arguments negate_mag_expr c i%nat_scope
### C.jet_secp_field_negate_magnitude.negate_mag_out
negate_mag_out =
fun c : Integers.Int.int =>
@List.map nat jet_sx_expr.sx (negate_mag_expr c)
  (@cons nat O
     (@cons nat (S O) (@cons nat (S (S O)) (@cons nat (S (S (S O))) (@cons nat (S (S (S (S O)))) (@nil nat))))))
     : forall _ : Integers.Int.int, list jet_sx_expr.sx

Arguments negate_mag_out c
### C.jet_secp_field_negate_magnitude.negate_mag_machine_constant
negate_mag_machine_constant =
fun (c : Integers.Int.int) (i : nat) =>
Integers.Int64.mul
  (Integers.Int64.mul (Integers.Int64.repr (jet_secp_field_negate_values.negate_mask i))
     (Integers.Int64.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
  (Integers.Int64.repr (Integers.Int.signed (Integers.Int.add c Integers.Int.one)))
     : forall (_ : Integers.Int.int) (_ : nat), Integers.Int64.int

Arguments negate_mag_machine_constant c i%nat_scope
### C.jet_secp_field_negate_magnitude.negate_mag_words
negate_mag_words =
fun (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) (i : nat) =>
Integers.Int64.sub (negate_mag_machine_constant c i) (w i)
     : forall (_ : Integers.Int.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments negate_mag_words c w%function_scope i%nat_scope
### C.jet_secp_field_negate_magnitude.negate_mag_input_bounds
negate_mag_input_bounds =
fun (c : Integers.Int.int) (w : forall _ : nat, Integers.Int64.int) =>
forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
BinInt.Z.le (Integers.Int64.unsigned (w i))
  (BinInt.Z.mul
     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinInt.Z.add (Integers.Int.signed c) (BinNums.Zpos BinNums.xH))) (jet_secp_field_negate_values.negate_mask i))
     : forall (_ : Integers.Int.int) (_ : forall _ : nat, Integers.Int64.int), Prop

Arguments negate_mag_input_bounds c w%function_scope
