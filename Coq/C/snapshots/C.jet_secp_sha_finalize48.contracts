         (jet_sha_finalize_exec.pad_bytes
            (Integers.Int64.repr
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))
         secp_sha_pad48
### C.jet_secp_sha_finalize48.secp_sha_pad48_checked
secp_sha_pad48_checked
     : @eq bool
         (jet_transport.stmt_okb jet_sha_linkage.sha_ge jet_secp_linkage.secp_ge
            (@List.map (prod AST.ident Clight.function) AST.ident (@fst AST.ident Clight.function)
               jet_secp_sha_pure_transport.secp_sha_pure_helpers)
            (@cons AST.ident jets_sha.___compound (@nil AST.ident))
            (jet_sha_finalize_exec.cf_fill
               (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))) true
### C.jet_secp_sha_finalize48.secp_sha_pad48_closed
secp_sha_pad48_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_sha_pure_transport.secp_sha_pure_helpers
            (jet_sha_finalize_exec.cf_fill
               (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))) true
### C.jet_secp_sha_finalize48.secp_sha_finalize_u64_symbol
secp_sha_finalize_u64_symbol
