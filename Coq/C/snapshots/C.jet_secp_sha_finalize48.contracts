### C.jet_secp_sha_finalize48.secp_sha_fin_dom
secp_sha_fin_dom
     : forall bk : Values.block,
       jet_transport.edom (jet_sha_finalize_exec.fin_env bk)
         (@cons (prod AST.ident Ctypes.type)
            (@pair AST.ident Ctypes.type jets_sha.___compound
               (Ctypesdefs.tarray Ctypesdefs.tuchar
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
            (@nil (prod AST.ident Ctypes.type)))
### C.jet_secp_sha_finalize48.secp_sha_pad48_transport
secp_sha_pad48_transport
     : forall (bk : Values.block) (le : Clight.temp_env) (m mf : Memory.Mem.mem)
         (_ : ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge (jet_sha_finalize_exec.fin_env bk) le m
                (jet_sha_finalize_exec.cf_fill
                   (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))) Events.E0 le
                mf ClightBigstep.Out_normal),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_sha_finalize_exec.fin_env bk) le m
         (jet_sha_finalize_exec.cf_fill
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))) Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_sha_finalize48.secp_sha_finalize48_entry
secp_sha_finalize48_entry
     : forall (m : Memory.Mem.mem) (mi : Memory.Mem.mem') (bk bc : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block mi bk)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_sha256_finalize
         (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero) (@nil Values.val)) m
         (jet_sha_finalize_exec.fin_env bk) (jet_sha_finalize_exec.fin_temps bc BinNums.Z0) mi
### C.jet_secp_sha_finalize48.secp_sha_finalize48_blocks
secp_sha_finalize48_blocks
     : forall bk : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (jet_sha_finalize_exec.fin_env bk))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bk BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
### C.jet_secp_sha_finalize48.eval_secp_sha_finalize48
eval_secp_sha_finalize48
     : forall (_ : jet_memcpy_model.memcpy_model) (l regs : list Integers.Int.int) (m : Memory.Mem.mem)
         (bc bs : Values.block)
         (_ : @eq nat (@length Integers.Int.int l)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : not (@eq Values.block bc bs)) (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bc BinNums.Z0)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : jet_uint32_array_init.uint32_array_at m bs BinNums.Z0 regs)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val
                   (Values.Vlong
                      (Integers.Int64.repr
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinInt.Z.add (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i l Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_sha256_finalize)
               (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
               (Values.Vint Integers.Int.one))
            (and
               (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                  (SHA256.hash_block regs
                     (jet_sha_ctx8_model.be_words
                        (@app Integers.Int.int l
                           (jet_sha_finalize_exec.sha_pad
                              (Integers.Int64.repr
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
               (and
                  (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                     (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf bc
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (@Some Values.val
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint8unsigned mf bc
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@Some Values.val (Values.Vint Integers.Int.zero)))
                        (and
                           (Memory.Mem.range_perm mf bc BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bs BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bc)) (not (@eq Values.block b bs))) m mf)
                                 (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                    (jet_secp_sha_startup.secp_sha_startup mf))))))))))
### C.jet_secp_sha_finalize48.secp_sha_pad48
secp_sha_pad48 =
