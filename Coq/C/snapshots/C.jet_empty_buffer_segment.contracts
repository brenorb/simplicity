### C.jet_empty_buffer_segment.write_frame_at_after_padding
write_frame_at_after_padding
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor n count : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 n) (_ : BinInt.Z.le BinNums.Z0 count)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor (BinInt.Z.add n count))
         (_ : jet_frame_layout.frame_fields_at mf bf base bw edge (BinInt.Z.sub cursor n))
         (_ : forall (chunk : AST.memory_chunk) (bb : Values.block) (ofs : BinNums.Z)
                (_ : or (not (@eq Values.block bb bf))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                          (BinInt.Z.le
                             (BinInt.Z.add base
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs))),
              @eq (option Values.val) (Memory.Mem.load chunk mf bb ofs) (Memory.Mem.load chunk m bb ofs))
         (_ : forall (bb : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m bb ofs kind p), Memory.Mem.perm mf bb ofs kind p),
       jet_output_layout.write_frame_at mf bf base bw edge (BinInt.Z.sub cursor n) count
### C.jet_empty_buffer_segment.eval_empty_buffer_segment
eval_empty_buffer_segment
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (count : nat) (tail : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 tail)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinInt.Z.add (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinInt.Z.of_nat count)) tail)),
       @ex Memory.Mem.mem
         (fun mb : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_writeBit)
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                     (@cons Values.val (Values.Vint Integers.Int.zero) (@nil Values.val))) Events.E0 mb
                  (Values.Vint Integers.Int.zero))
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb
                     (@Ctypes.Internal Clight.function jets.f_skipBits)
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                        (@cons Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat count)))
                           (@nil Values.val))) Events.E0 mf Values.Vundef)
                  (and
                     (jet_encoding.frame_output_cells_at mf bw edge cursor
                        (@cons (option bool) (@Some bool false) (@List.repeat (option bool) (@None bool) count)))
                     (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                        (and
                           (jet_output_layout.write_frame_at mf bf base bw edge
                              (BinInt.Z.sub cursor (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinInt.Z.of_nat count)))
                              tail)
                           (and
                              (jet_output_layout.loads_outside_ranges m mf bf
                                 (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 (BinInt.Z.add base
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                                 (BinInt.Z.add edge
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       (BinInt.Z.div
                                          (BinInt.Z.sub cursor
                                             (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinInt.Z.of_nat count)))
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                 (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              (and
                                 (forall (bb : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.perm m bb ofs kind p),
                                  Memory.Mem.perm mf bb ofs kind p)
                                 (forall (bb : Values.block) (_ : Memory.Mem.valid_block m bb),
                                  Memory.Mem.valid_block mf bb)))))))))
