### C.jet_secp_generator_sha_start.generator_sha_start_source
generator_sha_start_source
     : forall second : bool,
       @eq Clight.statement (generator_sha_start second)
         (Clight.Ssequence (generator_sha_start_call second) (generator_sha_copy second))
### C.jet_secp_generator_sha_start.generator_sha_state_members
generator_sha_state_members
     : @eq (option Ctypes.members)
         (@Coqlib.option_map Ctypes.composite Ctypes.members Ctypes.co_members
            (@Maps.PTree.get Ctypes.composite jets_secp._sha256_midstate (Clight.genv_cenv jet_secp_linkage.secp_ge)))
         (@Some (list Ctypes.member)
            (@cons Ctypes.member
               (Ctypes.Member_plain jets_secp._s
                  (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (@nil Ctypes.member)))
### C.jet_secp_generator_sha_start.generator_sha_state_layout
generator_sha_state_layout
     : @ex Ctypes.composite
         (fun co : Ctypes.composite =>
          and
            (@eq (option Ctypes.composite)
               (@Maps.PTree.get Ctypes.composite jets_secp._sha256_midstate (Clight.genv_cenv jet_secp_linkage.secp_ge))
               (@Some Ctypes.composite co))
            (@eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
               (Ctypes.field_offset (Clight.genv_cenv jet_secp_linkage.secp_ge) jets_secp._s (Ctypes.co_members co))
               (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield BinNums.Z0 Ctypes.Full))))
### C.jet_secp_generator_sha_start.eval_generator_sha_state
eval_generator_sha_state
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bs : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_buf e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bs generator_sha_state_type))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m
         (Clight.Efield (Clight.Evar jets_secp._sha256_buf generator_sha_state_type) jets_secp._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr bs Integers.Ptrofs.zero)
### C.jet_secp_generator_sha_start.exec_generator_sha_start_owned
exec_generator_sha_start_owned
     : forall (second : bool) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (br bc bs : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_init e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) (generator_sha_result_id second) e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type br generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) (generator_sha_context_id second) e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bc generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_buf e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bs generator_sha_state_type)))
         (_ : not (@eq Values.block br bs)) (_ : not (@eq Values.block bc bs)) (_ : not (@eq Values.block br bc))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (generator_sha_start second) Events.E0 le
               mf ClightBigstep.Out_normal)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                  (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val (Values.Vlong Integers.Int64.zero)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint8unsigned mf bc
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0 jet_sha256_iv_init.sha256_iv_words)
                        (and
                           (Memory.Mem.range_perm mf br BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bc BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bs BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block b br))
                                          (and (not (@eq Values.block b bc)) (not (@eq Values.block b bs)))) m mf)
                                    (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
### C.jet_secp_generator_sha_start.generator_sha_ctx_type
generator_sha_ctx_type = Ctypes.Tstruct jets_secp._sha256_context Ctypes.noattr
     : Ctypes.type
### C.jet_secp_generator_sha_start.generator_sha_state_type
generator_sha_state_type = Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr
     : Ctypes.type
### C.jet_secp_generator_sha_start.generator_sha_result_id
generator_sha_result_id =
fun second : bool => match second return AST.ident with
                     | true => jets_secp.__res
                     | false => jets_secp.__res__1
                     end
     : forall _ : bool, AST.ident

Arguments generator_sha_result_id second%bool_scope
### C.jet_secp_generator_sha_start.generator_sha_context_id
generator_sha_context_id =
fun second : bool =>
match second return AST.ident with
| true => jets_secp._sha256_ctx__1
| false => jets_secp._sha256_ctx
end
     : forall _ : bool, AST.ident

Arguments generator_sha_context_id second%bool_scope
### C.jet_secp_generator_sha_start.generator_sha_start_call
generator_sha_start_call =
fun second : bool =>
Clight.Scall (@None AST.ident) (Clight.Evar jets_secp._sha256_init (Clight.type_of_function jets_secp.f_sha256_init))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar (generator_sha_result_id second) generator_sha_ctx_type)
        (Ctypesdefs.tptr generator_sha_ctx_type))
     (@cons Clight.expr
        (Clight.Efield (Clight.Evar jets_secp._sha256_buf generator_sha_state_type) jets_secp._s
           (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (@nil Clight.expr)))
     : forall _ : bool, Clight.statement

Arguments generator_sha_start_call second%bool_scope
### C.jet_secp_generator_sha_start.generator_sha_copy
generator_sha_copy =
fun second : bool =>
Clight.Sassign (Clight.Evar (generator_sha_context_id second) generator_sha_ctx_type)
  (Clight.Evar (generator_sha_result_id second) generator_sha_ctx_type)
     : forall _ : bool, Clight.statement

Arguments generator_sha_copy second%bool_scope
### C.jet_secp_generator_sha_start.generator_sha_start
generator_sha_start =
fun second : bool =>
match
  @List.nth Clight.statement
    match second return nat with
    | true => S (S (S (S (S (S (S (S (S (S (S O))))))))))
    | false => S (S (S (S (S (S (S O))))))
    end
    (@fst (list Clight.statement) Clight.statement
       (jet_secp_statement_prefix.split_statement_last
          (Clight.fn_body jets_secp.f_secp256k1_generator_generate_internal))) Clight.Sskip
  return Clight.statement
with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence start _ => start
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : forall _ : bool, Clight.statement

Arguments generator_sha_start second%bool_scope
