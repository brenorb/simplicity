### C.jet_secp_beta_slice.beta_slice_literal
beta_slice_literal
     : forall (a : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds a),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
