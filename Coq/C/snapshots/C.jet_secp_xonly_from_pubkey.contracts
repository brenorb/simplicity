xonly_from_body_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_xonly_pubkey_from_pubkey)
         (jet_secp_statement_prefix.statement_sequence xonly_from_start xonly_from_tail)
### C.jet_secp_xonly_from_pubkey.affine_storage_small_bounds
affine_storage_small_bounds
     : forall (w : forall _ : nat, Integers.Int64.int) (k : bool),
       jet_secp_field_mul_small.mul_small_input_bounds (jet_secp_affine_storage.affine_storage_coord w k)
### C.jet_secp_xonly_from_pubkey.eval_xonly_pubkey_from_pubkey_null
eval_xonly_pubkey_from_pubkey_null
     : forall (_ : jet_memcpy_model.memcpy_model) (w : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bout bin : Values.block) (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_affine_storage.affine_storage_readable m bin BinNums.Z0 w)
         (_ : @eq bool (jet_secp_pubkey_load_body.pubkey_storage_accept w) true),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_xonly_pubkey_from_pubkey)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vlong Integers.Int64.zero)
                     (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               (Values.Vint Integers.Int.one))
            (and
               (jet_secp_xonly_tweak_function.xonly_tweak_saved_result
                  (@Some
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (xonly_from_value w)) mf bout)
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bin BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m
                           mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))
