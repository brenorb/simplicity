### C.jet_secp_root_chain_numeric.root_words_match
root_words_match =
fun (w : forall _ : nat, Integers.Int64.int) (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
and (jet_secp_square_columns.square_input_bounds w)
  (@eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)
     (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a) jet_secp_fe_math.feP))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       Prop

Arguments root_words_match w%function_scope a
### C.jet_secp_root_chain_numeric.root_chain_window
root_chain_window =
fun w : forall _ : nat, Integers.Int64.int =>
let x2 : forall _ : nat, Integers.Int64.int :=
  jet_secp_field_pair_multiply.field_pair_product (jet_secp_square_numeric.square_words w) w in
let x3 : forall _ : nat, Integers.Int64.int :=
  jet_secp_field_pair_multiply.field_pair_product (jet_secp_square_numeric.square_words x2) w in
let x6 : forall _ : nat, Integers.Int64.int := jet_secp_root_stage.root_stage_words (S (S (S O))) x3 x3 in
let x9 : forall _ : nat, Integers.Int64.int := jet_secp_root_stage.root_stage_words (S (S (S O))) x6 x3 in
let x11 : forall _ : nat, Integers.Int64.int := jet_secp_root_stage.root_stage_words (S (S O)) x9 x2 in
let x22 : forall _ : nat, Integers.Int64.int :=
  jet_secp_root_stage.root_stage_words (S (S (S (S (S (S (S (S (S (S (S O))))))))))) x11 x11 in
let x44 : forall _ : nat, Integers.Int64.int :=
  jet_secp_root_stage.root_stage_words (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))) x22
    x22 in
let x88 : forall _ : nat, Integers.Int64.int :=
  jet_secp_root_stage.root_stage_words (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))) x44
    x44 in
let x176 : forall _ : nat, Integers.Int64.int :=
  jet_secp_root_stage.root_stage_words (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))) x88 x88
  in
let x220 : forall _ : nat, Integers.Int64.int :=
  jet_secp_root_stage.root_stage_words (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))) x176 x44
  in
let x223 : forall _ : nat, Integers.Int64.int := jet_secp_root_stage.root_stage_words (S (S (S O))) x220 x3 in
@pair (forall _ : nat, Integers.Int64.int) (forall _ : nat, Integers.Int64.int) x2
  (jet_secp_root_stage.root_stage_words (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))) x223 x22)
