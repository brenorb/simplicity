### C.jet_secp_root_chain_numeric.root_square_match
root_square_match
     : forall (w : forall _ : nat, Integers.Int64.int) (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : root_words_match w a),
       root_words_match (jet_secp_square_numeric.square_words w)
         (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem a)
### C.jet_secp_root_chain_numeric.root_squares_match
root_squares_match
     : forall (n : nat) (w : forall _ : nat, Integers.Int64.int)
         (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : root_words_match w a),
       root_words_match (jet_secp_root_square_loop.root_square_words n w)
         (@jet_secp_root_literal.literal_fe_squares n Alg.CoreFunSem a)
### C.jet_secp_root_chain_numeric.root_pair_match
root_pair_match
     : forall (w v : forall _ : nat, Integers.Int64.int) (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : root_words_match w a) (_ : root_words_match v b),
       root_words_match (jet_secp_field_pair_multiply.field_pair_product w v)
         (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) b a))
### C.jet_secp_root_chain_numeric.root_stage_match
root_stage_match
     : forall (n : nat) (w v : forall _ : nat, Integers.Int64.int)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : root_words_match w a)
         (_ : root_words_match v b),
       root_words_match (jet_secp_root_stage.root_stage_words n w v)
         (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) b
               (@jet_secp_root_literal.literal_fe_squares n Alg.CoreFunSem a)))
### C.jet_secp_root_chain_numeric.root_squares_two
root_squares_two
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_root_literal.literal_fe_squares (S (S O)) Alg.CoreFunSem a)
         (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem
            (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem a))
### C.jet_secp_root_chain_numeric.root_squares_three
root_squares_three
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_root_literal.literal_fe_squares (S (S (S O))) Alg.CoreFunSem a)
         (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem
            (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem
               (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem a)))
### C.jet_secp_root_chain_numeric.root_chain_final_x2
root_chain_final_x2
     : forall w2 w3 : forall _ : nat, Integers.Int64.int,
       @eq (option (forall _ : nat, Integers.Int64.int))
         (@Maps.PTree.get (forall _ : nat, Integers.Int64.int) jets_secp._x2
            (jet_secp_root_chain_owned.root_chain_final w2 w3)) (@Some (forall _ : nat, Integers.Int64.int) w2)
### C.jet_secp_root_chain_numeric.root_chain_final_t1
root_chain_final_t1
     : forall w : forall _ : nat, Integers.Int64.int,
       let w2 : forall _ : nat, Integers.Int64.int :=
         jet_secp_field_pair_multiply.field_pair_product (jet_secp_square_numeric.square_words w) w in
       let w3 : forall _ : nat, Integers.Int64.int :=
         jet_secp_field_pair_multiply.field_pair_product (jet_secp_square_numeric.square_words w2) w in
       @eq (option (forall _ : nat, Integers.Int64.int))
         (@Maps.PTree.get (forall _ : nat, Integers.Int64.int) jets_secp._t1
            (jet_secp_root_chain_owned.root_chain_final w2 w3))
         (@Some (forall _ : nat, Integers.Int64.int)
            (@snd (forall _ : nat, Integers.Int64.int) (forall _ : nat, Integers.Int64.int) (root_chain_window w)))
