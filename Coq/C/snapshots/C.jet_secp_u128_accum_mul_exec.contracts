  (jet_sx_expr.XLb jet_sx_expr.Badd jet_secp_umul128_exec.umul128_hi
     (jet_sx_expr.XI2L Ctypes.Signed
        (jet_sx_expr.XLcmp Integers.Clt Ctypes.Unsigned accum_mul_lo jet_secp_umul128_exec.umul128_lo)))
     : jet_sx_expr.sx
