### C.jet_nonce_exec_payload.nonce_readbytes_link
nonce_readbytes_link
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
               jets_elements._read8s)
            (@Some Values.block (jet_elements_linkage.elements_symbol_block jets_elements._read8s)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
               (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._read8s) Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_elements.f_read8s)))
### C.jet_nonce_exec_payload.nonce_uchars_link
