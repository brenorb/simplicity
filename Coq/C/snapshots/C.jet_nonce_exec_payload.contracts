### C.jet_nonce_exec_payload.nonce_payload_exec
nonce_payload_exec
     : forall (_ : jet_memcpy_model.memcpy_model) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (bl bm bb bx bi : Values.block) (edge rc : BinNums.Z)
         (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : not (@eq Values.block bl bx))
         (_ : not (@eq Values.block bl bm))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bb bx)) (_ : not (@eq Values.block bb bm))
         (_ : not
                (@eq Values.block bb
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bb
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bl bb)) (_ : not (@eq Values.block bl bi)) (_ : not (@eq Values.block bb bi))
         (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h))
         (_ : jet_elements_support_sha_ctx_abs.ctx_abs m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
               (jet_nonce_context_shape.nc_env bl bm bb bx) le m
               (Clight.Ssequence jet_nonce_context_shape.nc_readbytes jet_nonce_context_shape.nc_uchars) Events.E0 le
               mf ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                  (BinInt.Z.add rc
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
               (and
                  (jet_elements_support_sha_ctx_abs.ctx_abs mf bx bm
                     (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                        (jet_sha_ctx8_model.absorb l regs
                           (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)))
                     (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                        (jet_sha_ctx8_model.absorb l regs
                           (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)))
                     (Integers.Int64.add c
                        (Integers.Int64.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (jet_elements_support_sha_uchars_exec.uc_overflow ovf c
                        (Integers.Int64.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (jet_nonce_exec_effects.nonce_effects m mf
                     (@cons Values.block bl
                        (@cons Values.block bb (@cons Values.block bx (@cons Values.block bm (@nil Values.block)))))))))
