### C.jet_secp_scalar_public_setup.scalar_prepare_public_locals
scalar_prepare_public_locals
     : forall (le : Maps.PTree.tree Values.val) (m0 : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (bl ba : Values.block) (mb : Memory.Mem.mem') (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
         (bi : Values.block) (edge rc : BinNums.Z) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m0 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba))
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le (BinNums.Zpos BinNums.xH) N) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m0 bs sbase bi edge rc)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)))),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
               (jet_secp_scalar_public_entry.scalar_public_env bl ba) le mb
               (Clight.Sassign (Clight.Evar jets_secp._src jet_secp_public_body.secp_frame_type)
                  (Clight.Etempvar jets_secp._src jet_secp_public_body.secp_frame_type)) Events.E0 le mc
               ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mc ba BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mc bl BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                     Memtype.Freeable)
                  (and (jet_frame_layout.frame_fields_at mc bl BinNums.Z0 bi edge rc)
                     (and (not (@eq Values.block ba bl))
                        (and
                           (jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                    (@nil (prod Values.block BinNums.Z)))))
                           (and
                              (jet_secp_frame.invA m0 bd dbase bw outedge cursor N bi rc false
                                 (@nil BitMachine.Cell) (BinNums.Zpos BinNums.xH)
                                 (jet_secp_wrapper_run.read_fe_rho
                                    (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value)
                                    rc) (@nil jet_sx_eval.event) mc)
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b ba)) (not (@eq Values.block b bl))) m0 mc)
                                 (and (not (Memory.Mem.valid_block m0 ba)) (not (Memory.Mem.valid_block m0 bl)))))))))))
