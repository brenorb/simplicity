### C.jet_secp_scalar_public_setup.scalar_alloc_lframe
scalar_alloc_lframe
     : forall (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (bl ba : Values.block) (mb : Memory.Mem.mem')
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)), jet_sx_mem.lframe P m mb
### C.jet_secp_scalar_public_setup.scalar_alloc_fresh
scalar_alloc_fresh
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bl ba : Values.block) (mb : Memory.Mem.mem')
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)),
       and (not (Memory.Mem.valid_block m bl)) (and (not (Memory.Mem.valid_block m ba)) (not (@eq Values.block ba bl)))
### C.jet_secp_scalar_public_setup.scalar_alloc_freeable
scalar_alloc_freeable
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bl ba : Values.block) (mb : Memory.Mem.mem')
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)),
       and
         (Memory.Mem.range_perm mb bl BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur Memtype.Freeable)
         (Memory.Mem.range_perm mb ba BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
### C.jet_secp_scalar_public_setup.scalar_alloc_source_fields
