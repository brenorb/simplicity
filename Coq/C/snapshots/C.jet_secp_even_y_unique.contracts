### C.jet_secp_even_y_unique.secp_field_negate_odd
secp_field_negate_odd
     : forall (y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : and (BinInt.Z.lt BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                   jet_secp_fe_math.feP)),
       @eq bool
         (Bit.toBool
            (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem
               (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem y)))
         (negb (Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem y)))
### C.jet_secp_even_y_unique.secp_normalize_bounded_word
secp_normalize_bounded_word
     : forall (y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                   jet_secp_fe_math.feP)),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem y) y
### C.jet_secp_even_y_unique.secp_even_y_unique
secp_even_y_unique
     : forall (x y v : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))) true)
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x v))) true)
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                   jet_secp_fe_math.feP))
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) v))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) v)
                   jet_secp_fe_math.feP))
         (_ : @eq bool (Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem y)) false)
         (_ : @eq bool (Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem v)) false),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) y v
