### C.jet_secp_wnaf_control.wnaf_loop_fields
wnaf_loop_fields =
fun (le : Maps.PTree.tree Values.val) (bit len w carry sign : BinNums.Z) (b : Values.block) (base last : BinNums.Z) =>
and
  (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._bit le)
     (@Some Values.val (Values.Vint (Integers.Int.repr bit))))
  (and
     (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le)
        (@Some Values.val (Values.Vint (Integers.Int.repr len))))
     (and
        (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._w le)
           (@Some Values.val (Values.Vint (Integers.Int.repr w))))
        (and
           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._carry le)
              (@Some Values.val (Values.Vint (Integers.Int.repr carry))))
           (and
              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._sign le)
                 (@Some Values.val (Values.Vint (Integers.Int.repr sign))))
              (and
                 (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._wnaf le)
                    (@Some Values.val (Values.Vptr b (Integers.Ptrofs.repr base))))
                 (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._last_set_bit le)
                    (@Some Values.val (Values.Vint (Integers.Int.repr last)))))))))
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z)
