### C.jet_secp_wnaf_control.exec_wnaf_loop_body_step
exec_wnaf_loop_body_step
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (n bit len w carry sign : BinNums.Z)
         (b : Values.block) (base : BinNums.Z) (bs : Values.block) (last : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.lt n
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 bit) (BinInt.Z.lt bit len))
         (_ : BinInt.Z.le len
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : and (BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) w)
                (BinInt.Z.le w (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
         (_ : and (BinInt.Z.le (BinNums.Zneg BinNums.xH) last) (BinInt.Z.lt last bit))
         (_ : or (@eq BinNums.Z carry BinNums.Z0) (@eq BinNums.Z carry (BinNums.Zpos BinNums.xH)))
         (_ : or (@eq BinNums.Z sign (BinNums.Zpos BinNums.xH)) (@eq BinNums.Z sign (BinNums.Zneg BinNums.xH)))
         (_ : wnaf_loop_fields le bit len w carry sign b base last)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bs BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n))) (_ : not (@eq Values.block b bs))
         (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) bit))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.valid_access m AST.Mint32 b
                (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) bit))
                Memtype.Writable),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex BinNums.Z
               (fun bit' : BinNums.Z =>
                @ex BinNums.Z
                  (fun carry' : BinNums.Z =>
                   @ex BinNums.Z
                     (fun digit : BinNums.Z =>
                      @ex BinNums.Z
                        (fun last' : BinNums.Z =>
                         @ex ClightBigstep.outcome
                           (fun out : ClightBigstep.outcome =>
                            and
                              (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
                                 (jet_secp_wnaf_digit.wnaf_env bs) le m jet_secp_wnaf_digit.wnaf_loop_body Events.E0
                                 le' mf out)
                              (and (wnaf_loop_fields le' bit' len w carry' sign b base last')
                                 (and (and (BinInt.Z.lt bit bit') (BinInt.Z.le bit' len))
                                    (and (and (BinInt.Z.le (BinNums.Zneg BinNums.xH) last') (BinInt.Z.lt last' bit'))
                                       (and
                                          (or (@eq BinNums.Z carry' BinNums.Z0)
                                             (@eq BinNums.Z carry' (BinNums.Zpos BinNums.xH)))
                                          (and
                                             (jet_secp_scalar_get_b32_storage.scalar_at mf bs BinNums.Z0
                                                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                                                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n)))
                                             (and
                                                (or (@eq ClightBigstep.outcome out ClightBigstep.Out_normal)
                                                   (@eq ClightBigstep.outcome out ClightBigstep.Out_continue))
                                                (and
                                                   (@eq BinNums.Z
                                                      (BinInt.Z.add
                                                         (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos ...) bit)) carry)
                                                      (BinInt.Z.add digit
                                                         (BinInt.Z.mul
                                                            (BinInt.Z.pow (BinNums.Zpos ...) (BinInt.Z.sub bit' bit))
                                                            (BinInt.Z.add (BinInt.Z.div n ...) carry'))))
                                                   (or
                                                      (and (@eq BinNums.Z digit BinNums.Z0)
                                                         (and (@eq Memory.Mem.mem mf m) (@eq BinNums.Z last' last)))
                                                      (and
                                                         (@eq BinNums.Z (BinInt.Z.modulo digit (BinNums.Zpos ...))
                                                            (BinNums.Zpos BinNums.xH))
                                                         (and (and (BinInt.Z.lt ... digit) (BinInt.Z.lt digit ...))
                                                            (and (@eq ... ... ...) (@eq BinNums.Z last' bit)))))))))))))))))))
### C.jet_secp_wnaf_control.wnaf_dispatch
wnaf_dispatch =
@List.nth Clight.statement O jet_secp_wnaf_digit.wnaf_loop_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_wnaf_control.wnaf_bit_call
wnaf_bit_call =
match wnaf_dispatch return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence call _ => call
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_wnaf_control.wnaf_bit_if
wnaf_bit_if =
match wnaf_dispatch return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ branch => branch
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_wnaf_control.wnaf_now_set
wnaf_now_set =
@List.nth Clight.statement (S O) jet_secp_wnaf_digit.wnaf_loop_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_wnaf_control.wnaf_now_clamp
wnaf_now_clamp =
@List.nth Clight.statement (S (S O)) jet_secp_wnaf_digit.wnaf_loop_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_wnaf_control.wnaf_window_select
wnaf_window_select = Clight.Ssequence wnaf_now_set wnaf_now_clamp
     : Clight.statement
### C.jet_secp_wnaf_control.wnaf_nonzero_body
wnaf_nonzero_body =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement (S O) jet_secp_wnaf_digit.wnaf_loop_statements)
  (@snd (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last jet_secp_wnaf_digit.wnaf_loop_body))
     : Clight.statement
### C.jet_secp_wnaf_control.wnaf_select_temps
wnaf_select_temps =
fun (le : Maps.PTree.tree Values.val) (bit len w : BinNums.Z) =>
let lw : Maps.PTree.tree Values.val := @Maps.PTree.set Values.val jets_secp._now (Values.Vint (Integers.Int.repr w)) le
  in
match Coqlib.zlt (BinInt.Z.sub len bit) w return (Maps.PTree.tree Values.val) with
| left _ => @Maps.PTree.set Values.val jets_secp._now (Values.Vint (Integers.Int.repr (BinInt.Z.sub len bit))) lw
| right _ => lw
end
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       Maps.PTree.tree Values.val

