                     base bit)
                  (and
                     (or
                        (@eq BinNums.Z
                           (jet_secp_wnaf_digit.wnaf_carry
                              (jet_secp_wnaf_digit.wnaf_word n bit (BinInt.Z.min w (BinInt.Z.sub len bit)) carry) w)
                           BinNums.Z0)
                        (@eq BinNums.Z
                           (jet_secp_wnaf_digit.wnaf_carry
                              (jet_secp_wnaf_digit.wnaf_word n bit (BinInt.Z.min w (BinInt.Z.sub len bit)) carry) w)
