### C.jet_secp_wnaf_control.wnaf_nonzero_temps
wnaf_nonzero_temps =
fun (le : Maps.PTree.tree Values.val) (n bit len w carry : BinNums.Z) =>
let width : BinNums.Z := BinInt.Z.min w (BinInt.Z.sub len bit) in
wnaf_after_temps
  (jet_secp_wnaf_digit.wnaf_digit_final
     (@Maps.PTree.set Values.val jets_secp._t'3
        (Values.Vint
           (Integers.Int.repr
              (BinInt.Z.modulo (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit))
                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) width)))) (wnaf_select_temps le bit len w))
     (jet_secp_wnaf_digit.wnaf_word n bit width carry) w) bit width
