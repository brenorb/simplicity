### C.jet_secp_wnaf_control.wnaf_after_temps
wnaf_after_temps =
fun (le : Maps.PTree.tree Values.val) (bit width : BinNums.Z) =>
@Maps.PTree.set Values.val jets_secp._bit (Values.Vint (Integers.Int.repr (BinInt.Z.add bit width)))
  (@Maps.PTree.set Values.val jets_secp._last_set_bit (Values.Vint (Integers.Int.repr bit)) le)
