                     (and
                        (and
                           (BinInt.Z.lt
                              (BinInt.Z.opp
                                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                    (BinInt.Z.sub w (BinNums.Zpos BinNums.xH))))
                              (jet_secp_wnaf_digit.wnaf_digit
                                 (jet_secp_wnaf_digit.wnaf_word n bit (BinInt.Z.min w (BinInt.Z.sub len bit)) carry) w))
