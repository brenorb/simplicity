### C.jet_secp_scalar_inverse_var.eval_scalar_inverse_var
eval_scalar_inverse_var
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bd bx : Values.block)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_secp_modinfo_scalar_global.modinfo_scalar_state m)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bx BinNums.Z0
                (jet_secp_scalar_add_initial.scalar_add_values w O))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : and (BinInt.Z.le BinNums.Z0 (jet_secp_scalar_overflow_numeric.scalar_limb_value w))
                (BinInt.Z.lt (jet_secp_scalar_overflow_numeric.scalar_limb_value w)
                   jet_secp_canonical_scalar.canonical_group_order)),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun result : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_inverse_var)
                  (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                  Values.Vundef)
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf bd BinNums.Z0
                     (jet_secp_scalar_add_initial.scalar_add_values result O))
                  (and
                     (@eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value result)
                        (jet_secp_scalar_invert_literal.literal_scalar_invert_numeric
                           (jet_secp_scalar_overflow_numeric.scalar_limb_value w)))
                     (and
                        (forall (input : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (_ : @eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value w)
                                  (BinInt.Z.modulo
                                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) input)
                                     jet_secp_canonical_scalar.canonical_group_order)),
                         @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
                           (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                              (jet_secp_scalar_overflow_numeric.scalar_limb_value result))
                           (@jet_secp_scalar_invert_literal.literal_scalar_invert Alg.CoreFunSem input))
                        (and
                           (Memory.Mem.range_perm mf bd BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and (jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep mf)
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bd))
                                       (and (not (@eq Values.block b bx))
                                          (not
                                             (@eq Values.block b
                                                jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block)))) m mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
