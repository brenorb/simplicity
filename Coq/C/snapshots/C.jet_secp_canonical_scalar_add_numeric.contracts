### C.jet_secp_canonical_scalar_add_numeric.canonical_scalar_add_numeric
canonical_scalar_add_numeric
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_canonical_scalar_add.canonical_scalar_add Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b)))
         (BinInt.Z.modulo
            (BinInt.Z.add (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b))
            jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_canonical_scalar_add_numeric.canonical_scalar_add_normalize_value
canonical_scalar_add_normalize_value
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem a))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem b)))
            jet_secp_canonical_scalar.canonical_group_order)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_canonical_scalar_add.canonical_scalar_add Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b)))
### C.jet_secp_canonical_scalar_add_numeric.canonical_scalar_add_normalized_inputs_range
canonical_scalar_add_normalized_inputs_range
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (BinInt.Z.le BinNums.Z0
            (BinInt.Z.add
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem a))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem b))))
         (BinInt.Z.lt
            (BinInt.Z.add
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem a))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem b)))
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) jet_secp_canonical_scalar.canonical_group_order))
