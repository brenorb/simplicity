### C.jet_secp_affine_weak_loads.affine_weak_cells0_match_point
affine_weak_cells0_match_point
     : forall k : jet_secp_affine_weak_exec.affine_coordinate,
       @eq (list jet_sx_state.cell) (jet_secp_fe_nv.cells0 (jet_secp_affine_weak_exec.affine_weak_state k))
         (jet_secp_fe_nv.cells0
            (jet_secp_point_weak_exec.point_weak_state (jet_secp_affine_weak_exec.affine_point_coordinate k)))
### C.jet_secp_affine_weak_loads.affine_weak_rep_preserved_loads
affine_weak_rep_preserved_loads
     : forall (k : jet_secp_affine_weak_exec.affine_coordinate) (m : Memory.Mem.mem) (layout : jet_sx_state.layout)
         (rho : forall _ : nat, Integers.Int64.int)
         (_ : forall n : nat,
              and
                (BinInt.Z.le (@fst BinNums.Z BinNums.Z (jet_secp_point_weak_values.point_weak_bounds n))
                   (Integers.Int64.unsigned (rho n)))
                (BinInt.Z.le (Integers.Int64.unsigned (rho n))
                   (@snd BinNums.Z BinNums.Z (jet_secp_point_weak_values.point_weak_bounds n))))
         (_ : jet_sx_state.rep rho layout (jet_sx_eval.sregs (jet_secp_affine_weak_exec.affine_weak_state k)) m)
         (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk layout O)
            (BinInt.Z.add (jet_sx_state.bas layout O)
               (BinInt.Z.add (jet_secp_affine_weak_exec.affine_coordinate_offset k)
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat n)))))
         (@Some Values.val (Values.Vlong (rho (S n))))
