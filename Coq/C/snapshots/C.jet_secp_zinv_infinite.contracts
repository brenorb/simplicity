| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_zinv_infinite.zinv_infinite_temps
zinv_infinite_temps =
fun (le : Maps.PTree.tree Values.val) (aflag flag : Integers.Int.int) =>
@Maps.PTree.set Values.val jets_secp._t'5 (Values.Vint flag)
  (@Maps.PTree.set Values.val jets_secp._t'6 (Values.Vint flag)
     (@Maps.PTree.set Values.val jets_secp._t'4 (Values.Vint aflag) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Integers.Int.int) (_ : Integers.Int.int),
       Maps.PTree.tree Values.val

