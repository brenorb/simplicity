### C.jet_secp_hashgen_outer.eval_hashgen_generate
eval_hashgen_generate
     : forall (_ : jet_memcpy_model.memcpy_model) (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (m : Memory.Mem.mem) (bg ba : Values.block) (oa : Integers.Ptrofs.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : not (@eq Values.block ba bg))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : jet_secp_swu_startup.swu_startup m)
         (_ : forall prefix : bool, jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix m)
         (_ : Memory.Mem.range_perm m bg BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat i)))
                (@Some Values.val
                   (Values.Vint
                      (@List.nth Integers.Int.int i
                         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int
                            jet_read8s_layout.word8_array_value
                            (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) key))
                         Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun sx : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun sy : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun sz : forall _ : nat, Integers.Int64.int =>
                   @ex Integers.Int.int
                     (fun sumflag : Integers.Int.int =>
                      @ex (forall _ : nat, Integers.Int64.int)
                        (fun ox : forall _ : nat, Integers.Int64.int =>
                         @ex (forall _ : nat, Integers.Int64.int)
                           (fun oy : forall _ : nat, Integers.Int64.int =>
                            and
                              (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                                 (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_generate)
                                 (@cons Values.val (Values.Vptr bg Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr ba oa) (@nil Values.val))) Events.E0 mf
                                 (Values.Vint
                                    (jet_secp_field_cmov.cmov_int
                                       (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                                          (jet_secp_generator_hash_map.generator_hash_accepted true key)))))
                              (and (jet_secp_hashgen_function.hashgen_result key mf bg sx sy sz sumflag ox oy)
                                 (and
                                    (Memory.Mem.range_perm mf bg BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (forall (i : nat) (_ : lt i (S (S (S (S (S (S (...)))))))),
                                        @eq (option Values.val)
                                          (Memory.Mem.load AST.Mint8unsigned mf ba
                                             (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat i)))
                                          (@Some Values.val
                                             (Values.Vint
                                                (@List.nth Integers.Int.int i
                                                   (@List.map (Ty.tySem (Word.Word (S (...)))) Integers.Int.int
                                                      jet_read8s_layout.word8_array_value
                                                      (jet_buffer_input.vector_values (Word.Word (S (...)))
                                                         (S (S (...))) key)) Integers.Int.zero))))
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bg)) m
                                             mf)
                                          (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                             (and (jet_secp_sha_startup.secp_sha_startup mf)
                                                (and (jet_secp_swu_startup.swu_startup mf)
                                                   (forall prefix : bool,
                                                    jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix mf)))))))))))))))
### C.jet_secp_hashgen_outer.hashgen_nonnull_check
hashgen_nonnull_check =
fun (id : AST.ident) (ty : Ctypes.type) =>
Clight.Sloop
  (Clight.Sifthenelse
     (Clight.Eunop Cop.Onotbool
        (Clight.Ebinop Cop.One (Clight.Etempvar id (Ctypesdefs.tptr ty))
           (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tvoid))
           Ctypesdefs.tint) Ctypesdefs.tint)
     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))) Clight.Sskip)
  Clight.Sbreak
     : forall (_ : AST.ident) (_ : Ctypes.type), Clight.statement

Arguments hashgen_nonnull_check id ty
### C.jet_secp_hashgen_outer.hashgen_outer_temps
