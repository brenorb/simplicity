fun (bg ba : Values.block) (oa : Integers.Ptrofs.int) =>
@Maps.PTree.set Values.val jets_secp._key32 (Values.Vptr ba oa)
  (@Maps.PTree.set Values.val jets_secp._gen (Values.Vptr bg Integers.Ptrofs.zero)
     (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_generator_generate)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Integers.Ptrofs.int), Maps.PTree.tree Values.val

Arguments hashgen_outer_temps bg ba oa
### C.jet_secp_hashgen_outer.hashgen_outer_call
hashgen_outer_call =
Clight.Scall (@Some AST.ident jets_secp._t'1)
  (Clight.Evar jets_secp._secp256k1_generator_generate_internal
     (Clight.type_of_function jets_secp.f_secp256k1_generator_generate_internal))
  (@cons Clight.expr (Clight.Etempvar jets_secp._gen (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6563 Ctypes.noattr)))
     (@cons Clight.expr (Clight.Etempvar jets_secp._key32 (Ctypesdefs.tptr Ctypesdefs.tuchar))
        (@cons Clight.expr
           (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tvoid))
           (@nil Clight.expr))))
     : Clight.statement
