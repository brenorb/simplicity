           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)) Ctypes.Tnil)
           Ctypesdefs.tulong AST.cc_default))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_bitcoin._src (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))) (@nil Clight.expr)))
  (Clight.Sset jets_bitcoin._i (Clight.Etempvar jets_bitcoin._t'1 Ctypesdefs.tulong))
     : Clight.statement
### C.jet_bitcoin_annex_local.writeBit_type
writeBit_type =
