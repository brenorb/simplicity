Clight.Ederef
  (Clight.Ebinop Cop.Oadd (Clight.Etempvar t (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._sigInput Ctypes.noattr)))
     (Clight.Etempvar jets_bitcoin._i Ctypesdefs.tulong)
     (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._sigInput Ctypes.noattr)))
  (Ctypes.Tstruct jets_bitcoin._sigInput Ctypes.noattr)
