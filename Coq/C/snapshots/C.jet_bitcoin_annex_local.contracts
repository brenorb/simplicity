### C.jet_bitcoin_annex_local.eval_annex_hasAnnex
eval_annex_hasAnnex
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (t : BinNums.positive)
         (bin : Values.block) (inbase : BinNums.Z) (r : Integers.Int64.int) (v : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val t le)
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._i le)
                (@Some Values.val (Values.Vlong r))) (_ : BinInt.Z.le BinNums.Z0 inbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add
                   (BinInt.Z.add inbase
                      (BinInt.Z.mul
                         (BinNums.Zpos
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                         (Integers.Int64.unsigned r)))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bin
                   (BinInt.Z.add
                      (BinInt.Z.add inbase
                         (BinInt.Z.mul
                            (BinNums.Zpos
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                            (Integers.Int64.unsigned r)))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                (@Some Values.val (Values.Vint v))),
       Clight.eval_expr jet_bitcoin_linkage.bitcoin_ge e le m
         (Clight.Efield (annex_elem t) jets_bitcoin._hasAnnex Ctypesdefs.tbool) (Values.Vint v)
