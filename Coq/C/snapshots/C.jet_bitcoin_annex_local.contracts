  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
     (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default
     : Ctypes.type
### C.jet_bitcoin_annex_local.annex_cond
annex_cond =
Clight.Ssequence (Clight.Sset jets_bitcoin._t'9 jet_bitcoin_current_exec.bitcoin_env_tx_expr)
  (Clight.Ssequence
     (Clight.Sset jets_bitcoin._t'10
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_bitcoin._t'9
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
              (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) jets_bitcoin._numInputs
           Ctypesdefs.tulong))
     (Clight.Scall (@Some AST.ident jets_bitcoin._t'3) (Clight.Evar jets_bitcoin._writeBit writeBit_type)
        (@cons Clight.expr
           (Clight.Etempvar jets_bitcoin._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
           (@cons Clight.expr
              (Clight.Ebinop Cop.Olt (Clight.Etempvar jets_bitcoin._i Ctypesdefs.tulong)
                 (Clight.Etempvar jets_bitcoin._t'10 Ctypesdefs.tulong) Ctypesdefs.tint) (@nil Clight.expr)))))
     : Clight.statement
### C.jet_bitcoin_annex_local.annex_elem
