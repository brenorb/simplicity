         jet_bitcoin_linkage.bitcoin_ge jet_bitcoin_ext_prim.ext_environment (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         bitcoin_input_annex_hash_env_rep
         (fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_bitcoin_ext_prim.ext_environment) =>
          @bitcoin_input_annex_hash_spec
            (jet_bitcoin_ext_prim.PrimitiveBitcoinExt.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
### C.jet_bitcoin_annex_local.bit_int
bit_int =
fun b : bool => match b return Integers.Int.int with
                | true => Integers.Int.one
                | false => Integers.Int.zero
                end
     : forall _ : bool, Integers.Int.int

Arguments bit_int b%bool_scope
### C.jet_bitcoin_annex_local.is_some
is_some =
fun (A : Type) (o : option A) => match o return bool with
                                 | Some _ => true
                                 | None => false
                                 end
     : forall (A : Type) (_ : option A), bool

Arguments is_some {A}%type_scope o
