### C.jet_secp_jacobian_group.secp_jacobian_projective_irrelevance
secp_jacobian_projective_irrelevance
     : forall (x y z : jet_secp_curve_group.secp_group_field) (C1 C2 : secp_jacobian_curve x y z),
       @eq jet_secp_curve_group_certificate.secp_group_projective (secp_jacobian_projective x y z C1)
         (secp_jacobian_projective x y z C2)
### C.jet_secp_jacobian_group.secp_projective_zero_iff
secp_projective_zero_iff
     : forall p : jet_secp_curve_group_certificate.secp_group_projective,
       iff
         (@eq
            (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
               (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
            (@SMain.pe2e (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
               (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
               (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
               (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
               jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory p)
            jet_secp_curve_group_sign.secp_group_infinity)
         (@eq (GZnZ.znz jet_secp_fe_math.feP)
            (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
               (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven p)
            (GZnZ.zero jet_secp_fe_math.feP))
### C.jet_secp_jacobian_group.secp_jacobian_group_infinity_iff
secp_jacobian_group_infinity_iff
     : forall (x y z : jet_secp_curve_group.secp_group_field) (Curve : secp_jacobian_curve x y z),
       iff
         (@eq
            (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
               (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
            (secp_jacobian_group_value x y z Curve) jet_secp_curve_group_sign.secp_group_infinity)
         (@eq jet_secp_curve_group.secp_group_field z (GZnZ.zero jet_secp_fe_math.feP))
### C.jet_secp_jacobian_group.secp_field_ratio_cross
secp_field_ratio_cross
     : forall (x1 y1 x2 y2 : jet_secp_curve_group.secp_group_field)
         (_ : not (@eq jet_secp_curve_group.secp_group_field y1 (GZnZ.zero jet_secp_fe_math.feP)))
         (_ : not (@eq jet_secp_curve_group.secp_group_field y2 (GZnZ.zero jet_secp_fe_math.feP)))
         (_ : @eq (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP x1 y2)
                (GZnZ.mul jet_secp_fe_math.feP x2 y1)),
       @eq (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP x1 y1) (GZnZ.div jet_secp_fe_math.feP x2 y2)
### C.jet_secp_jacobian_group.secp_projective_group_equal
secp_projective_group_equal
     : forall (p q : jet_secp_curve_group_certificate.secp_group_projective)
         (_ : iff
                (@eq (GZnZ.znz jet_secp_fe_math.feP)
                   (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven p) (GZnZ.zero jet_secp_fe_math.feP))
                (@eq (GZnZ.znz jet_secp_fe_math.feP)
                   (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven q) (GZnZ.zero jet_secp_fe_math.feP)))
         (_ : @eq (GZnZ.znz jet_secp_fe_math.feP)
                (GZnZ.mul jet_secp_fe_math.feP
                   (@SMain.x (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven p)
                   (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven q))
                (GZnZ.mul jet_secp_fe_math.feP
                   (@SMain.x (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven q)
                   (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven p)))
         (_ : @eq (GZnZ.znz jet_secp_fe_math.feP)
                (GZnZ.mul jet_secp_fe_math.feP
                   (@SMain.y (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven p)
                   (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven q))
                (GZnZ.mul jet_secp_fe_math.feP
                   (@SMain.y (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven q)
                   (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven p))),
       @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (@SMain.pe2e (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.sub jet_secp_fe_math.feP)
            (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP)
            (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
            jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory p)
         (@SMain.pe2e (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.sub jet_secp_fe_math.feP)
            (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP)
            (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
            jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory q)
### C.jet_secp_jacobian_group.secp_jacobian_curve_rescale
secp_jacobian_curve_rescale
     : forall (x y z : jet_secp_curve_group.secp_group_field) (_ : secp_jacobian_curve x y z)
         (s : jet_secp_curve_group.secp_group_field),
       secp_jacobian_curve (GZnZ.mul jet_secp_fe_math.feP x (GZnZ.mul jet_secp_fe_math.feP s s))
         (GZnZ.mul jet_secp_fe_math.feP y (GZnZ.mul jet_secp_fe_math.feP (GZnZ.mul jet_secp_fe_math.feP s s) s))
         (GZnZ.mul jet_secp_fe_math.feP z s)
### C.jet_secp_jacobian_group.secp_jacobian_group_rescale
secp_jacobian_group_rescale
     : forall (x y z : jet_secp_curve_group.secp_group_field) (Curve : secp_jacobian_curve x y z)
         (s : jet_secp_curve_group.secp_group_field)
         (_ : not (@eq jet_secp_curve_group.secp_group_field s (GZnZ.zero jet_secp_fe_math.feP))),
       @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (secp_jacobian_group_value (GZnZ.mul jet_secp_fe_math.feP x (GZnZ.mul jet_secp_fe_math.feP s s))
            (GZnZ.mul jet_secp_fe_math.feP y (GZnZ.mul jet_secp_fe_math.feP (GZnZ.mul jet_secp_fe_math.feP s s) s))
            (GZnZ.mul jet_secp_fe_math.feP z s) (secp_jacobian_curve_rescale x y z Curve s))
         (secp_jacobian_group_value x y z Curve)
### C.jet_secp_jacobian_group.secp_jacobian_curve_negate
secp_jacobian_curve_negate
     : forall (x y z : jet_secp_curve_group.secp_group_field) (_ : secp_jacobian_curve x y z),
       secp_jacobian_curve x (GZnZ.opp jet_secp_fe_math.feP y) z
### C.jet_secp_jacobian_group.secp_jacobian_group_negate
secp_jacobian_group_negate
     : forall (x y z : jet_secp_curve_group.secp_group_field) (Curve : secp_jacobian_curve x y z),
       @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (secp_jacobian_group_value x (GZnZ.opp jet_secp_fe_math.feP y) z (secp_jacobian_curve_negate x y z Curve))
         (@SMain.opp (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.sub jet_secp_fe_math.feP)
            (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP)
            (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
            jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory
            (secp_jacobian_group_value x y z Curve))
