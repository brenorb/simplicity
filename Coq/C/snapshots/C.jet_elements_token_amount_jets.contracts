### C.jet_elements_token_amount_jets.issuance_token_rep_runs
issuance_token_rep_runs
     : forall (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge : BinNums.Z)
         (m : Memory.Mem.mem) (bin : Values.block) (ofs : BinNums.Z) (x : jet_elements_prim.sigTxInput)
         (cur : BinNums.Z) (_ : issuance_token_rep m bin ofs x) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_application_sep.out_sep bd dbase bw outedge cur
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                bin ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cur
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun me : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_issuanceTokenAmt)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs)) (@nil Values.val))) Events.E0 me
               Values.Vundef)
            (jet_elements_effects.write_effect m me bd dbase bw outedge cur
               (BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (issuance_token_pcells x)))
