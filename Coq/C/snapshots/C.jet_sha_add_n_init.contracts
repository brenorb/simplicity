### C.jet_sha_add_n_init.an_body
an_body
     : @eq Clight.statement (Clight.fn_body jets_sha.f_sha_256_ctx_8_add_n)
         (Clight.Ssequence an_assert (an_init an_rest))
### C.jet_sha_add_n_init.eval_local_ctx_field_lvalue
eval_local_ctx_field_lvalue
     : forall (k : jet_sha_uchars_prep.ctx_slot) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (bx : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))),
       Clight.eval_lvalue jet_sha_linkage.sha_ge e le m
         (Clight.Efield (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
            (jet_sha_uchars_prep.ctx_field k) (jet_sha_uchars_prep.ctx_field_type k)) bx
         (Integers.Ptrofs.add Integers.Ptrofs.zero (Integers.Ptrofs.repr (jet_sha_uchars_prep.ctx_offset k)))
         Ctypes.Full
### C.jet_sha_add_n_init.local_ctx_offset
local_ctx_offset
     : forall k : jet_sha_uchars_prep.ctx_slot,
       @eq BinNums.Z
         (Integers.Ptrofs.unsigned
            (Integers.Ptrofs.add Integers.Ptrofs.zero (Integers.Ptrofs.repr (jet_sha_uchars_prep.ctx_offset k))))
         (jet_sha_uchars_prep.ctx_offset k)
### C.jet_sha_add_n_init.eval_local_midstate_s
eval_local_midstate_s
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bm : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._midstate e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)))),
       Clight.eval_expr jet_sha_linkage.sha_ge e le m
         (Clight.Efield (Clight.Evar jets_sha._midstate (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
            jets_sha._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr bm Integers.Ptrofs.zero)
### C.jet_sha_add_n_init.an_assert_exec
an_assert_exec
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem),
       ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge e le m an_assert Events.E0 le m ClightBigstep.Out_normal
### C.jet_sha_add_n_init.init_frame_store
init_frame_store
     : forall (ch : AST.memory_chunk) (bx : Values.block) (lo : BinNums.Z) (m : Memory.Mem.mem)
         (ofs : BinNums.Z) (v : Values.val) (m1 : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.store ch m bx ofs v) (@Some Memory.Mem.mem m1))
         (_ : BinInt.Z.le lo ofs), init_frame bx lo m m1
### C.jet_sha_add_n_init.init_frame_trans
init_frame_trans
     : forall (bx : Values.block) (lo lo' : BinNums.Z) (m1 m2 m3 : Memory.Mem.mem) (_ : BinInt.Z.le lo lo')
         (_ : init_frame bx lo' m1 m2) (_ : init_frame bx lo m2 m3), init_frame bx lo m1 m3
### C.jet_sha_add_n_init.an_blk_init_exec
an_blk_init_exec
     : forall (e : Clight.env) (bx : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))))
         (n k : nat) (le0 : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : le (Nat.add k n)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          and
            (forall (rest : Clight.statement) (t : Events.trace) (le' : Clight.temp_env) (m' : Memory.Mem.mem)
               (out : ClightBigstep.outcome)
               (_ : ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge e le0 m1 rest t le' m' out),
             ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge e le0 m (an_blk_init n k rest) t le' m' out)
            (init_frame bx (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) m m1))
### C.jet_sha_add_n_init.an_init_exec
an_init_exec
     : forall (e : Clight.env) (bx bm : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._midstate e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))))
         (le : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          and
            (forall (rest : Clight.statement) (t : Events.trace) (le' : Clight.temp_env) (m' : Memory.Mem.mem)
               (out : ClightBigstep.outcome)
               (_ : ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge e le m1 rest t le' m' out),
             ClightBigstep.Clight2.exec_stmt jet_sha_linkage.sha_ge e le m (an_init rest) t le' m' out)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr m1 bx BinNums.Z0)
                  (@Some Values.val (Values.Vptr bm Integers.Ptrofs.zero))) (init_frame bx BinNums.Z0 m m1)))
### C.jet_sha_add_n_init.an_assert
an_assert =
match Clight.fn_body jets_sha.f_sha_256_ctx_8_add_n return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence s _ => s
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_sha_add_n_init.an_out_assign
an_out_assign =
Clight.Sassign
  (Clight.Efield (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)) jets_sha._output
     (Ctypesdefs.tptr Ctypesdefs.tuint))
  (Clight.Efield (Clight.Evar jets_sha._midstate (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)) jets_sha._s
     (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     : Clight.statement
### C.jet_sha_add_n_init.an_cnt_assign
an_cnt_assign =
Clight.Sassign
  (Clight.Efield (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)) jets_sha._counter
     Ctypesdefs.tulong) (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint)
     : Clight.statement
### C.jet_sha_add_n_init.an_blk_assign
an_blk_assign =
fun k : nat =>
Clight.Sassign
  (Clight.Ederef
     (Clight.Ebinop Cop.Oadd
        (Clight.Efield (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
           jets_sha._block
           (Ctypesdefs.tarray Ctypesdefs.tuchar
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        (Clight.Econst_int (Integers.Int.repr (BinInt.Z.of_nat k)) Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tuchar))
     Ctypesdefs.tuchar) (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint)
     : forall _ : nat, Clight.statement

Arguments an_blk_assign k%nat_scope
### C.jet_sha_add_n_init.an_blk_init
an_blk_init =
fix an_blk_init (n k : nat) (rest : Clight.statement) {struct n} : Clight.statement :=
  match n return Clight.statement with
  | O => rest
  | S n' => Clight.Ssequence (an_blk_assign k) (an_blk_init n' (S k) rest)
  end
     : forall (_ : nat) (_ : nat) (_ : Clight.statement), Clight.statement

Arguments an_blk_init (n k)%nat_scope rest
### C.jet_sha_add_n_init.an_ovf_assign
an_ovf_assign =
Clight.Sassign
  (Clight.Efield (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)) jets_sha._overflow
     Ctypesdefs.tbool) (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint)
     : Clight.statement
### C.jet_sha_add_n_init.an_read
an_read =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_sha._t'3)
     (Clight.Evar jets_sha._simplicity_read_sha256_context
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Etempvar jets_sha._src (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
           (@nil Clight.expr))))
  (Clight.Sifthenelse (Clight.Eunop Cop.Onotbool (Clight.Etempvar jets_sha._t'3 Ctypesdefs.tbool) Ctypesdefs.tint)
     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint)))
     Clight.Sskip)
     : Clight.statement
### C.jet_sha_add_n_init.an_read8s
an_read8s =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_sha._read8s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar)
           (Ctypes.Tcons Ctypesdefs.tulong
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Evar jets_sha._buf
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
     (@cons Clight.expr (Clight.Etempvar jets_sha._n Ctypesdefs.tulong)
        (@cons Clight.expr
           (Clight.Etempvar jets_sha._src (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
           (@nil Clight.expr))))
     : Clight.statement
### C.jet_sha_add_n_init.an_uchars
an_uchars =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_sha._sha256_uchars
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Evar jets_sha._buf
           (Ctypesdefs.tarray Ctypesdefs.tuchar
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
        (@cons Clight.expr (Clight.Etempvar jets_sha._n Ctypesdefs.tulong) (@nil Clight.expr))))
     : Clight.statement
### C.jet_sha_add_n_init.an_write
an_write =
Clight.Ssequence
  (Clight.Scall (@Some AST.ident jets_sha._t'4)
     (Clight.Evar jets_sha._simplicity_write_sha256_context
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)) Ctypes.Tnil))
           Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_sha._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))) (@nil Clight.expr))))
  (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_sha._t'4 Ctypesdefs.tbool)))
     : Clight.statement
### C.jet_sha_add_n_init.an_rest
an_rest =
Clight.Ssequence an_read (Clight.Ssequence an_read8s (Clight.Ssequence an_uchars an_write))
     : Clight.statement
### C.jet_sha_add_n_init.an_init
an_init =
fun rest : Clight.statement =>
Clight.Ssequence an_out_assign
  (Clight.Ssequence an_cnt_assign
     (an_blk_init (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))) O
        (Clight.Ssequence an_ovf_assign rest)))
     : forall _ : Clight.statement, Clight.statement

Arguments an_init rest
### C.jet_sha_add_n_init.init_frame
init_frame =
fun (bx : Values.block) (lo : BinNums.Z) (m m1 : Memory.Mem.mem) =>
and
  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
     (_ : or (not (@eq Values.block b bx)) (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) lo)),
   @eq (option Values.val) (Memory.Mem.load ch m1 b ofs) (Memory.Mem.load ch m b ofs))
  (and
     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
        (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m1 b ofs k p)
     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m1 b))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments init_frame bx lo%Z_scope m m1
