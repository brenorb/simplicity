### C.jet_secp_generator_save_initial.generator_save_field_region
generator_save_field_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat) (offset : BinNums.Z) (start : nat) (_ : @eq BinNums.Z (jet_sx_state.bas beta r) BinNums.Z0)
         (_ : BinInt.Z.le
                (BinInt.Z.add offset
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : jet_secp_fe_nv.fe_at m (jet_sx_state.blk beta r) offset
                (jet_secp_field_add_initial.field_values rho start))
         (_ : Memory.Mem.range_perm m (jet_sx_state.blk beta r) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       jet_sx_state.region_ok rho beta m r
         (jet_sx_state.mkreg (jet_sx_rep.u64_cells offset (jet_secp_fe_nv.vars5 start)) true
            (@Some BinNums.Z
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_generator_save_initial.generator_save_flag_region
