### C.jet_secp_curve_literal_bridge.curve_reader_square_residue
curve_reader_square_residue
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x))
               (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x)))
            jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)) jet_secp_fe_math.feP)
### C.jet_secp_curve_literal_bridge.curve_reader_cube_residue
curve_reader_cube_residue
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.mul
                  (BinInt.Z.mul
                     (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x))
                     (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x)))
                  (jet_secp_multiply_finish_product.radix_value (jet_secp_square_spec_bridge.square_reader_rho x)))
               (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) jet_secp_fe_math.feP)
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.mul
                  (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
               (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) jet_secp_fe_math.feP)
### C.jet_secp_curve_literal_bridge.curve_result_matches_literal
curve_result_matches_literal
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq Integers.Int.int
         (jet_secp_curve_body.curve_result (jet_secp_square_spec_bridge.square_reader_rho x)
            (jet_secp_square_spec_bridge.square_reader_rho y))
         (jet_readBit_layout.bit_int
            (Bit.toBool
               (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))))
### C.jet_secp_curve_literal_bridge.eval_curve_finite_literal
eval_curve_finite_literal
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba : Values.block)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_point_three_reads.point_canonical_limbs x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_point_three_reads.point_canonical_limbs y))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_is_valid_var)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  (jet_readBit_layout.bit_int
                     (Bit.toBool
                        (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))))))
            (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_point_three_reads.point_canonical_limbs x))
               (and
                  (jet_secp_fe_nv.fe_at mf ba
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_point_three_reads.point_canonical_limbs y))
                  (and
                     (Memory.Mem.range_perm mf ba BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b ba)) m mf)))))
