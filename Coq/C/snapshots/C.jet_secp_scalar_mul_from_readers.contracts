### C.jet_secp_scalar_mul_from_readers.eval_scalar_mul_from_normalized_scalars
eval_scalar_mul_from_normalized_scalars
     : forall (m : Memory.Mem.mem) (ba bb : Values.block)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : not (@eq Values.block ba bb))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem a)))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem b)))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_sx_state.rep
                  (jet_secp_scalar_get_b32_numeric.scalar_limb_rho
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@jet_secp_canonical_scalar_negate.canonical_scalar_multiply Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
                  (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                     (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_writer_run.scalar_writer_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bb BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (jet_sx_mem.lframe
                        (fun (block : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot
                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                                    (@nil (prod Values.block BinNums.Z))))
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape jet_secp_scalar_mul_caller_alloc.scalar_mul_caller_inputs) block
                              ofs)) m mf)))))
