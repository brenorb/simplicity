### C.jet_elements_issuance_calc_literal.literal_issuance_iv
literal_issuance_iv =
fun core : Alg.Core.Algebra =>
@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
     (BinNums.Zpos
        (BinNums.xI
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))))
  core
     : forall core : Alg.Core.Algebra, Alg.Core.domain core Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments literal_issuance_iv {core}
