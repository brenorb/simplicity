### C.jet_elements_issuance_calc_literal.literal_issuance_iv_matches
literal_issuance_iv_matches
     : forall core : Alg.Core.Algebra,
       @eq (Alg.Core.domain core Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@literal_issuance_iv core)
         (@jet_sha256_iv_init.sha256_iv_spec core)
### C.jet_elements_issuance_calc_literal.literal_issuance_op_hash_matches
literal_issuance_op_hash_matches
     : forall core : Alg.Core.Algebra,
       @eq
         (Alg.Core.domain core
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
            (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@literal_issuance_op_hash core)
         (@jet_elements_issuance_calc_spec.issuance_op_hash_spec core)
### C.jet_elements_issuance_calc_literal.literal_calculate_issuance_entropy_matches
