     : AST.signature
### C.jet_ctz_model.ctz_model_for
ctz_model_for =
fun sem : Events.extcall_sem =>
forall (ge : Globalenvs.Senv.t) (m : Memory.Mem.mem) (x : Integers.Int64.int)
  (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
sem ge (@cons Values.val (Values.Vlong x) (@nil Values.val)) m Events.E0
  (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))) m
     : forall _ : Events.extcall_sem, Prop

Arguments ctz_model_for sem
