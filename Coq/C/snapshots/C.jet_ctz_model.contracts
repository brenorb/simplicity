### C.jet_ctz_model.Z_ctz_pos_spec
Z_ctz_pos_spec
     : forall p : BinNums.positive,
       @ex BinNums.Z
         (fun q : BinNums.Z =>
          and
            (@eq BinNums.Z (BinNums.Zpos p)
               (BinInt.Z.mul (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (extraMath.Z_ctz (BinNums.Zpos p)))
                  (BinInt.Z.add (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) q) (BinNums.Zpos BinNums.xH))))
            (BinInt.Z.le BinNums.Z0 q))
### C.jet_ctz_model.Z_ctz_bound
Z_ctz_bound
     : forall (x : BinNums.Z)
         (_ : and (BinInt.Z.lt BinNums.Z0 x)
                (BinInt.Z.lt x
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       and (BinInt.Z.le BinNums.Z0 (extraMath.Z_ctz x))
         (BinInt.Z.lt (extraMath.Z_ctz x)
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
### C.jet_ctz_model.ctz_sig
ctz_sig =
