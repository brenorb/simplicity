### C.jet_secp_gej_odd_entry.gej_odd_temps_match
gej_odd_temps_match
     : forall (envv : Values.val) (bd : Values.block) (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z),
       @eq (Maps.PTree.tree Values.val) (gej_odd_temps envv bd base bs sbase)
         (jet_secp_gej_norm_infinity.gej_norm_temps envv bd base bs sbase)
### C.jet_secp_gej_odd_entry.gej_odd_entry_from_normalize
gej_odd_entry_from_normalize
     : forall (envv : Values.val) (m mc : Memory.Mem.mem) (bl bp br bd : Values.block) (base : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z)
         (_ : Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_simplicity_gej_normalize
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                      (@cons Values.val envv (@nil Values.val)))) m (jet_secp_gej_norm_branch.gej_norm_env bl bp br)
                (jet_secp_gej_norm_infinity.gej_norm_temps envv bd base bs sbase) mc),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_simplicity_gej_y_is_odd
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val envv (@nil Values.val))))
         m (gej_odd_env bl bp br) (gej_odd_temps envv bd base bs sbase) mc
### C.jet_secp_gej_odd_entry.gej_odd_copy_from_normalize
gej_odd_copy_from_normalize
     : forall (le : Clight.temp_env) (mc md : Memory.Mem.mem) (bl bp br : Values.block)
         (_ : ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_gej_norm_branch.gej_norm_env bl bp br)
                le mc
                (Clight.Sassign (Clight.Evar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))
                   (Clight.Etempvar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))) Events.E0 le
                md ClightBigstep.Out_normal),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (gej_odd_env bl bp br) le mc
         (Clight.Sassign (Clight.Evar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))) Events.E0 le md
         ClightBigstep.Out_normal
### C.jet_secp_gej_odd_entry.gej_odd_blocks
gej_odd_blocks
     : forall bl bp br : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (gej_odd_env bl bp br))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bp BinNums.Z0)
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z br BinNums.Z0)
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))
### C.jet_secp_gej_odd_entry.gej_odd_env
gej_odd_env =
fun bl bp br : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._b
  (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets_secp.__6121 Ctypes.noattr))
  (jet_secp_gej_public_entry.gej_public_env bl bp)
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments gej_odd_env bl bp br
### C.jet_secp_gej_odd_entry.gej_odd_temps
gej_odd_temps =
fun (envv : Values.val) (bd : Values.block) (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_secp._env envv
  (@Maps.PTree.set Values.val jets_secp._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_secp._dst (Values.Vptr bd (Integers.Ptrofs.repr base))
        (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_simplicity_gej_y_is_odd))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z),
       Maps.PTree.tree Values.val

Arguments gej_odd_temps envv bd base%Z_scope bs sbase%Z_scope
