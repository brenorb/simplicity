### C.jet_secp_ge_set_xy_separate.eval_ge_set_xy_separate
eval_ge_set_xy_separate
     : forall (x y : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bd bx by0 : Values.block)
         (_ : not (@eq Values.block bd bx)) (_ : not (@eq Values.block bd by0))
         (_ : jet_secp_fe_nv.fe_at m bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m by0 BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_xy)
               (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr by0 Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf bd BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf bd
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bd
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (Memory.Mem.range_perm mf bd BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind)
                              (p : Memtype.permission),
                            iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p))
                           (and
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bd)) m mf)
                              (jet_clight_internal_preserve.readonly_preserved m mf))))))))
