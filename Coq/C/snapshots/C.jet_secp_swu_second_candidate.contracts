### C.jet_secp_swu_second_candidate.swu_second_source
swu_second_source
     : @eq Clight.statement jet_secp_swu_first_candidate.swu_after_first_candidate
         (jet_secp_statement_prefix.statement_sequence swu_second_statements swu_after_second_candidate)
### C.jet_secp_swu_second_candidate.swu_second_closed
swu_second_closed
     : @eq bool (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers swu_second_prefix)
         true
### C.jet_secp_swu_second_candidate.swu_second_add_bound
swu_second_add_bound
     : forall (a : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_field_sum_bounds.field_scaled_bounds (BinNums.Zpos (BinNums.xO BinNums.xH)) a),
       and
         (jet_secp_field_negate_magnitude.negate_mag_input_bounds
            (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH)))
            (jet_secp_field_add_int.add_int_words (Integers.Int.repr (BinNums.Zpos BinNums.xH)) a))
         (@eq BinNums.Z
            (jet_secp_multiply_finish_product.radix_value
               (jet_secp_field_add_int.add_int_words (Integers.Int.repr (BinNums.Zpos BinNums.xH)) a))
            (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value a) (BinNums.Zpos BinNums.xH)))
### C.jet_secp_swu_second_candidate.exec_swu_second_add_call
exec_swu_second_add_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (b : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add_int)
                (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos BinNums.xH))) (@nil Values.val)))
                Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_second_add Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_second_candidate.exec_swu_second_negate_call
exec_swu_second_negate_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (b : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
                (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))))
                         (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_second_negate Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_second_candidate.exec_swu_second_candidate
exec_swu_second_candidate
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (ba bb : Values.block)
         (a : forall _ : nat, Integers.Int64.int) (_ : jet_clight_internal_frame.plain_env e)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb jet_secp_curve_statements.curve_fe_type)))
         (_ : not (@eq Values.block ba bb)) (_ : jet_secp_swu_startup.swu_startup m)
         (_ : jet_secp_field_sum_bounds.field_scaled_bounds (BinNums.Zpos (BinNums.xO BinNums.xH)) a)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_second_prefix Events.E0 le mf
               ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
               (and
                  (jet_secp_fe_nv.fe_at mf bb BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (swu_second_words a)))
                  (and
                     (Memory.Mem.range_perm mf bb BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (swu_second_words a))
                           (BinInt.Z.sub
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 jet_secp_fe_math.feP)
                              (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value a) (BinNums.Zpos BinNums.xH))))
                        (and (jet_secp_square_columns.square_input_bounds (swu_second_words a))
                           (and (jet_secp_swu_startup.swu_startup mf)
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bb)) m mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
### C.jet_secp_swu_second_candidate.swu_second_spec_match
swu_second_spec_match
     : forall (a : forall _ : nat, Integers.Int64.int) (t value : BinNums.Z)
         (_ : Zdiv.eqm jet_secp_fe_math.feP (jet_secp_multiply_finish_product.radix_value a)
                (jet_secp_swu_candidates.swu_c_candidate1 t))
         (_ : @eq BinNums.Z value
                (BinInt.Z.sub
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) jet_secp_fe_math.feP)
                   (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value a) (BinNums.Zpos BinNums.xH)))),
       Zdiv.eqm jet_secp_fe_math.feP value (jet_secp_swu_candidates.swu_c_candidate2 t)
### C.jet_secp_swu_second_candidate.swu_through_second_source
swu_through_second_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_shallue_van_de_woestijne)
         (jet_secp_statement_prefix.statement_sequence swu_through_second_statements swu_after_second_candidate)
### C.jet_secp_swu_second_candidate.exec_swu_through_second
exec_swu_through_second
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (bt bw ba bx bj bb : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_clight_internal_frame.plain_env e)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._negc e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_inv_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._d e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._wd e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bw jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type ba jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._jinv e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bj jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t le)
                (@Some Values.val (Values.Vptr bt Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bt
                   (@cons Values.block bw
                      (@cons Values.block ba
                         (@cons Values.block bx (@cons Values.block bj (@cons Values.block bb (@nil Values.block))))))))
         (_ : jet_secp_swu_startup.swu_startup m) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : @List.Forall Values.block
                (fun b : Values.block =>
                 Memory.Mem.range_perm m b BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   Memtype.Cur Memtype.Freeable)
                (@cons Values.block bt
                   (@cons Values.block bw
                      (@cons Values.block ba
                         (@cons Values.block bx (@cons Values.block bj (@cons Values.block bb (@nil Values.block)))))))),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun inv : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_through_second Events.E0 le mf
                  ClightBigstep.Out_normal)
               (and (jet_secp_fe_nv.fe_at mf bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and
                     (jet_secp_fe_nv.fe_at mf bw BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_swu_joint_setup.swu_setup_wd (jet_secp_square_numeric.square_words w))))
                     (and
                        (jet_secp_fe_nv.fe_at mf ba BinNums.Z0
                           (jet_secp_multiply_normalize_bridge.words5 (swu_input_first_words w inv)))
                        (and
                           (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                              (jet_secp_multiply_normalize_bridge.words5
                                 (jet_secp_swu_joint_setup.swu_setup_x3d (jet_secp_square_numeric.square_words w))))
                           (and (jet_secp_fe_nv.fe_at mf bj BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 inv))
                              (and
                                 (jet_secp_fe_nv.fe_at mf bb BinNums.Z0
                                    (jet_secp_multiply_normalize_bridge.words5
                                       (swu_second_words (swu_input_first_words w inv))))
                                 (and
                                    (@List.Forall Values.block
                                       (fun b : Values.block =>
                                        Memory.Mem.range_perm mf b BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (@cons Values.block bt
                                          (@cons Values.block bw
                                             (@cons Values.block ba
                                                (@cons Values.block bx
                                                   (@cons Values.block bj (@cons Values.block bb (@nil Values.block))))))))
                                    (and (jet_secp_square_columns.square_input_bounds inv)
                                       (and
                                          (jet_secp_field_sum_bounds.field_scaled_bounds
                                             (BinNums.Zpos (BinNums.xO BinNums.xH)) (swu_input_first_words w inv))
                                          (and
                                             (jet_secp_square_columns.square_input_bounds (swu_input_first_words w inv))
                                             (and
                                                (jet_secp_square_columns.square_input_bounds
                                                   (swu_second_words (swu_input_first_words w inv)))
                                                (and
                                                   (Zdiv.eqm jet_secp_fe_math.feP
                                                      (jet_secp_multiply_finish_product.radix_value
                                                         (swu_input_first_words w inv))
                                                      (jet_secp_swu_candidates.swu_c_candidate1
                                                         (jet_secp_multiply_finish_product.radix_value w)))
                                                   (and
                                                      (Zdiv.eqm jet_secp_fe_math.feP
                                                         (jet_secp_multiply_finish_product.radix_value
                                                            (swu_second_words (swu_input_first_words w inv)))
                                                         (jet_secp_swu_candidates.swu_c_candidate2
                                                            (jet_secp_multiply_finish_product.radix_value w)))
                                                      (and
                                                         (@eq BinNums.Z
                                                            (jet_secp_multiply_finish_product.radix_value inv)
                                                            (jet_secp_swu_candidates.swu_joint_inverse
                                                               (jet_secp_multiply_finish_product.radix_value w)))
                                                         (and (jet_secp_swu_startup.swu_startup mf)
                                                            (and
                                                               (jet_sx_mem.lframe
                                                                  (fun (b : Values.block) (_ : BinNums.Z) =>
                                                                   not (@List.In Values.block b ...)) m mf)
                                                               (jet_clight_internal_preserve.readonly_preserved m mf)))))))))))))))))))
### C.jet_secp_swu_second_candidate.swu_second_copy
swu_second_copy =
Clight.Sassign (Clight.Evar jets_secp._x2 jet_secp_curve_statements.curve_fe_type)
  (Clight.Evar jets_secp._x1 jet_secp_curve_statements.curve_fe_type)
     : Clight.statement
### C.jet_secp_swu_second_candidate.swu_second_add
swu_second_add =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_add_int jets_secp.f_secp256k1_fe_add_int
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x2)
     (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_swu_second_candidate.swu_second_negate
swu_second_negate =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_negate jets_secp.f_secp256k1_fe_negate
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x2)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x2)
        (@cons Clight.expr
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) Ctypesdefs.tint)
           (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_swu_second_candidate.swu_second_statements
swu_second_statements =
@cons Clight.statement swu_second_copy
  (@cons Clight.statement swu_second_add (@cons Clight.statement swu_second_negate (@nil Clight.statement)))
     : list Clight.statement
### C.jet_secp_swu_second_candidate.swu_second_prefix
swu_second_prefix =
jet_secp_statement_prefix.statement_sequence swu_second_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_swu_second_candidate.swu_after_second_candidate
swu_after_second_candidate =
match jet_secp_swu_first_candidate.swu_after_first_candidate return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ rest => rest
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_swu_second_candidate.swu_second_words
swu_second_words =
fun a : forall _ : nat, Integers.Int64.int =>
jet_secp_field_negate_magnitude.negate_mag_words (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH)))
  (jet_secp_field_add_int.add_int_words (Integers.Int.repr (BinNums.Zpos BinNums.xH)) a)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments swu_second_words a%function_scope i%nat_scope
### C.jet_secp_swu_second_candidate.swu_input_first_words
swu_input_first_words =
fun w inv : forall _ : nat, Integers.Int64.int =>
jet_secp_swu_first_candidate.swu_first_words (jet_secp_swu_initial.swu_initial_a w)
  (jet_secp_swu_joint_setup.swu_setup_x3d (jet_secp_square_numeric.square_words w)) inv
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments swu_input_first_words (w inv)%function_scope i%nat_scope
### C.jet_secp_swu_second_candidate.swu_through_second_statements
swu_through_second_statements =
@app Clight.statement jet_secp_swu_first_candidate.swu_through_first_statements swu_second_statements
     : list Clight.statement
### C.jet_secp_swu_second_candidate.swu_through_second
