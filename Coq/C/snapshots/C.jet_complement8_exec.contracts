### C.jet_complement8_exec.complement8_payload
complement8_payload =
fun r : Integers.Int.int =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
  (Integers.Int.not (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r))
     : forall _ : Integers.Int.int, Integers.Int.int

Arguments complement8_payload r
