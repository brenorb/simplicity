### C.jet_secp_eckey_tweak_entry.eckey_tweak_body_source
eckey_tweak_body_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_eckey_pubkey_tweak_add)
         (Clight.Ssequence eckey_tweak_set_ge
            (Clight.Ssequence eckey_tweak_set_one (Clight.Ssequence eckey_tweak_mult eckey_tweak_finish)))
### C.jet_secp_eckey_tweak_entry.eckey_tweak_entry_ok
eckey_tweak_entry_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_secp256k1_eckey_pubkey_tweak_add) true
### C.jet_secp_eckey_tweak_entry.eckey_tweak_entry
eckey_tweak_entry
     : forall (m : Memory.Mem.mem) (bk bt : Values.block),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bp : Values.block =>
             @ex Values.block
               (fun bo : Values.block =>
                and
                  (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_eckey_pubkey_tweak_add
                     (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val))) m
                     (eckey_tweak_env bp bo) (eckey_tweak_temps bk bt) mi)
                  (and (not (@eq Values.block bp bo))
                     (and
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                         and (not (@eq Values.block b bp)) (not (@eq Values.block b bo)))
                        (and
                           (Memory.Mem.range_perm mi bp BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mi bo BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                                 (and (jet_clight_internal_permissions.keeps_permissions m mi)
                                    (jet_clight_internal_preserve.readonly_preserved m mi))))))))))
### C.jet_secp_eckey_tweak_entry.eckey_tweak_blocks
eckey_tweak_blocks
     : forall bp bo : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (eckey_tweak_env bp bo))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bo BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bp BinNums.Z0)
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
### C.jet_secp_eckey_tweak_entry.eckey_tweak_free
eckey_tweak_free
     : forall (m : Memory.Mem.mem) (bp bo : Values.block) (_ : not (@eq Values.block bp bo))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.free_list m (Clight.blocks_of_env jet_secp_linkage.secp_ge (eckey_tweak_env bp bo)))
               (@Some Memory.Mem.mem mf))
            (and
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (_ : BinNums.Z) =>
                   and (not (@eq Values.block b bp)) (not (@eq Values.block b bo))) m mf)
               (jet_clight_internal_preserve.readonly_preserved m mf)))
