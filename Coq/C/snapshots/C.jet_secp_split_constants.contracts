### C.jet_secp_split_constants.split_basis_count
split_basis_count
     : forall first : bool, @eq nat (@length Integers.Int64.int (split_basis_words first)) (S (S (S (S O))))
### C.jet_secp_split_constants.split_basis_value_checked
split_basis_value_checked
     : forall first : bool,
       @eq BinNums.Z (jet_secp_scalar_mul512_accumulate.column_words_value (split_basis_words first))
         (split_basis_value first)
### C.jet_secp_split_constants.split_basis_bounds
split_basis_bounds
     : forall first : bool,
       and (BinInt.Z.le BinNums.Z0 (split_basis_value first))
         (BinInt.Z.lt (split_basis_value first) jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_constants.split_lambda_bounds
split_lambda_bounds
     : and (BinInt.Z.le BinNums.Z0 jet_secp_scalar_lambda_global.canonical_lambda_value)
         (BinInt.Z.lt jet_secp_scalar_lambda_global.canonical_lambda_value
            jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_constants.split_constants_initializes
split_constants_initializes
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
