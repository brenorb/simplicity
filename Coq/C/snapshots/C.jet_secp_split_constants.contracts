split_lambda_product_bounds
     : forall k : BinNums.Z,
       and (BinInt.Z.le BinNums.Z0 (split_lambda_product k))
         (BinInt.Z.lt (split_lambda_product k) jet_secp_canonical_scalar.canonical_group_order)
