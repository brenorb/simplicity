split_negated_bounds
     : forall k : BinNums.Z,
       and (BinInt.Z.le BinNums.Z0 (split_negated_value k))
         (BinInt.Z.lt (split_negated_value k) jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_constants.split_first_bounds
split_first_bounds
     : forall k : BinNums.Z,
       and (BinInt.Z.le BinNums.Z0 (split_first_value k))
         (BinInt.Z.lt (split_first_value k) jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_constants.split_basis_id
split_basis_id =
fun first : bool => match first return AST.ident with
                    | true => jets_secp._minus_b1
                    | false => jets_secp._minus_b2
                    end
     : forall _ : bool, AST.ident

Arguments split_basis_id first%bool_scope
### C.jet_secp_split_constants.split_basis_var
split_basis_var =
fun first : bool =>
match first return (AST.globvar Ctypes.type) with
| true => jets_secp.v_minus_b1
| false => jets_secp.v_minus_b2
end
     : forall _ : bool, AST.globvar Ctypes.type

Arguments split_basis_var first%bool_scope
### C.jet_secp_split_constants.split_basis_block
split_basis_block =
fun first : bool => jet_secp_linkage.secp_symbol_block (split_basis_id first)
     : forall _ : bool, Values.block

Arguments split_basis_block first%bool_scope
### C.jet_secp_split_constants.split_basis_words
split_basis_words =
fun first : bool =>
match first return (list Integers.Int64.int) with
| true =>
    @cons Integers.Int64.int
      (Integers.Int64.repr
         (BinNums.Zpos
            (BinNums.xI
               (BinNums.xI
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xI
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))))))
      (@cons Integers.Int64.int
         (Integers.Int64.repr
            (BinNums.Zneg
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO ...))))))))))))))))))))
         (@cons Integers.Int64.int Integers.Int64.zero
            (@cons Integers.Int64.int Integers.Int64.zero (@nil Integers.Int64.int))))
| false =>
    @cons Integers.Int64.int
      (Integers.Int64.repr
         (BinNums.Zneg
            (BinNums.xO
               (BinNums.xO
                  (BinNums.xI
                     (BinNums.xO
                        (BinNums.xI
                           (BinNums.xO
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI ...)))))))))))))))))))))
      (@cons Integers.Int64.int
         (Integers.Int64.repr
            (BinNums.Zneg
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xI
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xO
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))
         (@cons Integers.Int64.int (Integers.Int64.repr (BinNums.Zneg (BinNums.xO BinNums.xH)))
            (@cons Integers.Int64.int (Integers.Int64.repr (BinNums.Zneg BinNums.xH)) (@nil Integers.Int64.int))))
end
     : forall _ : bool, list Integers.Int64.int

Arguments split_basis_words first%bool_scope
### C.jet_secp_split_constants.split_basis_value
split_basis_value =
fun first : bool =>
match first return BinNums.Z with
| true =>
    BinNums.Zpos
      (BinNums.xI
         (BinNums.xI
            (BinNums.xO
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))))))
| false =>
    BinInt.Z.sub jet_secp_canonical_scalar.canonical_group_order
      (BinNums.Zpos
         (BinNums.xI
            (BinNums.xO
               (BinNums.xI
                  (BinNums.xO
                     (BinNums.xI
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xO
                                          (BinNums.xI
                                             (BinNums.xO
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO ...)))))))))))))))))))))
end
     : forall _ : bool, BinNums.Z

Arguments split_basis_value first%bool_scope
### C.jet_secp_split_constants.split_basis_state
split_basis_state =
fun first : bool => jet_secp_scalar_constant.scalar_constant_state (split_basis_block first) (split_basis_words first)
     : forall (_ : bool) (_ : Memory.Mem.mem), Prop

Arguments split_basis_state first%bool_scope m
### C.jet_secp_split_constants.split_constants_ready
split_constants_ready =
fun m : Memory.Mem.mem =>
and (jet_secp_split_multipliers.split_multipliers_ready m)
  (and (forall first : bool, split_basis_state first m)
     (jet_secp_scalar_constant.scalar_constant_state jet_secp_scalar_lambda_global.scalar_lambda_block
        jet_secp_scalar_lambda_global.scalar_lambda_words m))
     : forall _ : Memory.Mem.mem, Prop

Arguments split_constants_ready m
### C.jet_secp_split_constants.split_product
split_product =
fun (first : bool) (k : BinNums.Z) =>
BinInt.Z.modulo (BinInt.Z.mul (jet_secp_split_multipliers.split_coefficient first k) (split_basis_value first))
  jet_secp_canonical_scalar.canonical_group_order
     : forall (_ : bool) (_ : BinNums.Z), BinNums.Z

Arguments split_product first%bool_scope k%Z_scope
### C.jet_secp_split_constants.split_second_value
split_second_value =
fun k : BinNums.Z =>
BinInt.Z.modulo (BinInt.Z.add (split_product true k) (split_product false k))
  jet_secp_canonical_scalar.canonical_group_order
     : forall _ : BinNums.Z, BinNums.Z

Arguments split_second_value k%Z_scope
### C.jet_secp_split_constants.split_lambda_product
split_lambda_product =
fun k : BinNums.Z =>
BinInt.Z.modulo (BinInt.Z.mul (split_second_value k) jet_secp_scalar_lambda_global.canonical_lambda_value)
  jet_secp_canonical_scalar.canonical_group_order
     : forall _ : BinNums.Z, BinNums.Z

Arguments split_lambda_product k%Z_scope
### C.jet_secp_split_constants.split_negated_value
split_negated_value =
fun k : BinNums.Z =>
BinInt.Z.modulo (BinInt.Z.opp (split_lambda_product k)) jet_secp_canonical_scalar.canonical_group_order
     : forall _ : BinNums.Z, BinNums.Z

Arguments split_negated_value k%Z_scope
### C.jet_secp_split_constants.split_first_value
split_first_value =
fun k : BinNums.Z =>
BinInt.Z.modulo (BinInt.Z.add (split_negated_value k) k) jet_secp_canonical_scalar.canonical_group_order
     : forall _ : BinNums.Z, BinNums.Z

Arguments split_first_value k%Z_scope
