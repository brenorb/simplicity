            (split_constants_ready m))
### C.jet_secp_split_constants.split_constants_readonly
split_constants_readonly
     : forall (m mf : Memory.Mem.mem) (_ : split_constants_ready m)
         (_ : jet_clight_internal_preserve.readonly_preserved m mf), split_constants_ready mf
### C.jet_secp_split_constants.split_basis_storage
split_basis_storage
     : forall (first : bool) (m : Memory.Mem.mem) (_ : split_constants_ready m),
       jet_secp_scalar_get_b32_storage.scalar_at m (split_basis_block first) BinNums.Z0
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of (split_basis_value first)))
### C.jet_secp_split_constants.split_lambda_storage
split_lambda_storage
     : forall (m : Memory.Mem.mem) (_ : split_constants_ready m),
       jet_secp_scalar_get_b32_storage.scalar_at m jet_secp_scalar_lambda_global.scalar_lambda_block BinNums.Z0
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of jet_secp_scalar_lambda_global.canonical_lambda_value))
### C.jet_secp_split_constants.split_basis_separate
split_basis_separate
     : forall (first : bool) (m : Memory.Mem.mem) (b : Values.block) (_ : split_constants_ready m)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable), not (@eq Values.block b (split_basis_block first))
### C.jet_secp_split_constants.split_lambda_separate
split_lambda_separate
     : forall (m : Memory.Mem.mem) (b : Values.block) (_ : split_constants_ready m)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable), not (@eq Values.block b jet_secp_scalar_lambda_global.scalar_lambda_block)
### C.jet_secp_split_constants.split_mod_bound
split_mod_bound
     : forall value : BinNums.Z,
       and (BinInt.Z.le BinNums.Z0 (BinInt.Z.modulo value jet_secp_canonical_scalar.canonical_group_order))
         (BinInt.Z.lt (BinInt.Z.modulo value jet_secp_canonical_scalar.canonical_group_order)
            jet_secp_canonical_scalar.canonical_group_order)
### C.jet_secp_split_constants.split_product_bounds
split_product_bounds
     : forall (first : bool) (k : BinNums.Z),
       and (BinInt.Z.le BinNums.Z0 (split_product first k))
         (BinInt.Z.lt (split_product first k) jet_secp_canonical_scalar.canonical_group_order)
