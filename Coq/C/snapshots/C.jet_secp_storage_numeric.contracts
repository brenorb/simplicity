### C.jet_secp_storage_numeric.field_storage_value
field_storage_value =
fun w : forall _ : nat, Integers.Int64.int =>
BinInt.Z.add
  (BinInt.Z.add
     (BinInt.Z.add (Integers.Int64.unsigned (w O))
        (BinInt.Z.mul
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
           (Integers.Int64.unsigned (w (S O)))))
     (BinInt.Z.mul
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        (Integers.Int64.unsigned (w (S (S O))))))
  (BinInt.Z.mul
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))
     (Integers.Int64.unsigned (w (S (S (S O))))))
     : forall _ : forall _ : nat, Integers.Int64.int, BinNums.Z

