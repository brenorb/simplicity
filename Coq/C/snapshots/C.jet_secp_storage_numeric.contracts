### C.jet_secp_storage_numeric.storage_unpack_value
storage_unpack_value =
fun (w : forall _ : nat, Integers.Int64.int) (i : nat) =>
@List.nth BinNums.Z i
  (@cons BinNums.Z
     (BinInt.Z.modulo (Integers.Int64.unsigned (w O))
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
