               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.sub width shift)))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) shift))
### C.jet_secp_storage_numeric.storage_join_unsigned
