### C.jet_secp_storage_numeric.storage_masked_shift_unsigned
storage_masked_shift_unsigned
     : forall (x : Integers.Int64.int) (shift width : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 shift) (BinInt.Z.le shift width))
         (_ : BinInt.Z.lt width
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq BinNums.Z
         (Integers.Int64.unsigned
            (Integers.Int64.and (Integers.Int64.shl x (Integers.Int64.repr shift))
               (Integers.Int64.repr
                  (BinInt.Z.sub (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) width) (BinNums.Zpos BinNums.xH)))))
