### C.jet_secp_curve_tail.curve_tail_calls
curve_tail_calls
     : forall (a b : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba bb : Values.block)
         (_ : not (@eq Values.block ba bb))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.lt (Integers.Int64.unsigned (a i))
                match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                | true =>
                    BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
                | false =>
                    BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
                end)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.lt (Integers.Int64.unsigned (b i))
                match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                | true =>
                    BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
                | false =>
                    BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))
                end) (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m2 : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add_int)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                        (@cons Values.val
                           (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
                           (@nil Values.val))) Events.E0 m1 Values.Vundef)
                  (and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m1
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_weak)
                        (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 m2
                        Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m2
                           (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_equal_var)
                           (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                           (Values.Vint
                              match
                                BinInt.Z.eqb
                                  (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value a)
                                     jet_secp_fe_math.feP)
                                  (BinInt.Z.modulo
                                     (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value b)
                                        (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) jet_secp_fe_math.feP)
                                return Integers.Int.int
                              with
                              | true => Integers.Int.one
                              | false => Integers.Int.zero
                              end))
                        (and
                           (Memory.Mem.range_perm mf ba BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bb BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block bx ba)) (not (@eq Values.block bx bb))) m mf))))))))
