### C.jet_secp_double_y_tail.double_y_tail_frame
double_y_tail_frame =
fun (bp bt bl bs b : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block b bt))
  (and (not (@eq Values.block b bl))
     (and (not (@eq Values.block b bs))
        (or (not (@eq Values.block b bp))
           (or
              (BinInt.Z.lt pos
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
              (BinInt.Z.le
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                 pos)))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

