### C.jet_secp_decompress_output.decompress_input_limbs
decompress_input_limbs
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int) (jet_secp_point_write_field.point_field_limbs (decompress_input_field w))
         (jet_secp_multiply_normalize_bridge.words5 w)
### C.jet_secp_decompress_output.decompress_parity_field_limbs
decompress_parity_field_limbs
     : forall (value : BinNums.Z) (odd : bool),
       @eq (list Integers.Int64.int) (jet_secp_point_write_field.point_field_limbs (decompress_parity_field value odd))
         (jet_secp_decompress_parity.decompress_parity_limbs value odd)
### C.jet_secp_decompress_output.decompress_y_field_limbs
decompress_y_field_limbs
     : forall (w : forall _ : nat, Integers.Int64.int) (odd : bool),
       @eq (list Integers.Int64.int) (jet_secp_point_write_field.point_field_limbs (decompress_y_field w odd))
         (jet_secp_decompress_body.decompress_body_y w odd)
### C.jet_secp_decompress_output.decompress_input_field_output
decompress_input_field_output
     : forall w : forall _ : nat, Integers.Int64.int,
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_point_write_field.point_field_output (decompress_input_field w))
         (jet_secp_rescale_literal.rescale_field_output w)
### C.jet_secp_decompress_output.decompress_normalize_fixed
decompress_normalize_fixed
     : forall (y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                jet_secp_fe_math.feP),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem y) y
### C.jet_secp_decompress_output.decompress_parity_field_output
decompress_parity_field_output
     : forall (y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (odd : bool)
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                jet_secp_fe_math.feP),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_point_write_field.point_field_output
            (decompress_parity_field (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y) odd))
         match
           xorb (Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem y)) odd
           return (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         with
         | true => @jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem y
         | false => y
         end
### C.jet_secp_decompress_output.decompress_input_matches
decompress_input_matches
     : forall (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_root_chain_numeric.root_words_match w x),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_point_write_field.point_field_output (decompress_input_field w))
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
