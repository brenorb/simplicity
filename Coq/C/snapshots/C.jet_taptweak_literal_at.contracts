### C.jet_taptweak_literal_at.literal_taptweak_matches_output_at
literal_taptweak_matches_output_at
     : forall iv pk h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_taptweak_at iv (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk h))
         (jet_secp_taptweak_finish.taptweak_output (tagged_taptweak_hash_word iv pk h) pk)
### C.jet_taptweak_literal_at.tagged_taptweak_hash_word
tagged_taptweak_hash_word =
fun iv pk h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
@SHA256.hashBlock Alg.CoreFunSem
  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))))
     (@SHA256.hashBlock Alg.CoreFunSem
        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) iv
           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) pk h))) jet_secp_taptweak_hash.taptweak_pad_word)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments tagged_taptweak_hash_word iv pk h
