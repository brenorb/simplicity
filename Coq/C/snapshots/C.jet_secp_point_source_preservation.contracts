### C.jet_secp_point_source_preservation.point_lframe_preserves_source
point_lframe_preserves_source
     : forall (m mf : Memory.Mem.mem) (ba bl bi : Values.block) (edge rc : BinNums.Z)
         (_ : not (@eq Values.block ba bl)) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b ba)) m mf),
       and (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge rc)
         (Memory.Mem.range_perm mf bl BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur Memtype.Freeable)
### C.jet_secp_point_source_preservation.point_read_outside_foot
point_read_outside_foot
     : forall (ba bl : Values.block) (k : jet_secp_point_write_run.point_coordinate) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (b : Values.block) (pos : BinNums.Z) (_ : not (@eq Values.block b ba))
         (_ : not (@eq Values.block b bl)),
       not
         (jet_sx_state.foot
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                  (@nil (prod Values.block BinNums.Z))))
            (@List.map jet_sx_state.region
               (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
               (jet_secp_point_read_run.point_read_initial_regs k bi edge)) b pos)
### C.jet_secp_point_source_preservation.point_lframe_preserves_inv
point_lframe_preserves_inv
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N cap : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (w0 : bool)
         (outs : list BitMachine.Cell) (rho : forall _ : nat, Integers.Int64.int) (log : list jet_sx_eval.event)
         (m mf : Memory.Mem.mem) (ba bl : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : jet_secp_frame.invA m0 bd dbase bw outedge cursor N bi rc w0 outs cap rho log m)
         (_ : jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b ba)) m mf),
       jet_secp_frame.invA m0 bd dbase bw outedge cursor N bi rc w0 outs cap rho log mf
