                                       (BinInt.Z.add rc
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                                    (and
                                       (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi mr false
                                          (@nil BitMachine.Cell))
                                       (jet_sx_mem.lframe
                                          (pair_locals_outside (jet_secp_frame.extA m0 bd bw bi) ba bb bl) m mr)))))))))))
### C.jet_secp_multiply_input_pair.pair_locals_outside
pair_locals_outside =
fun (ext : forall _ : Values.block, Prop) (ba bb bl b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b ba)) (and (not (@eq Values.block b bb)) (and (not (@eq Values.block b bl)) (not (ext b))))
     : forall (_ : forall _ : Values.block, Prop) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments pair_locals_outside ext%function_scope ba bb bl b _%Z_scope
