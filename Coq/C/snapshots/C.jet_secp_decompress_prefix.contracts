### C.jet_secp_decompress_prefix.exec_decompress_copy_owned
exec_decompress_copy_owned
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bx br : Values.block)
         (w : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._x le)
                (@Some Values.val (Values.Vptr bx Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero))) (_ : not (@eq Values.block bx br))
         (_ : jet_secp_fe_nv.fe_at m bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               jet_secp_decompress_statements.decompress_copy_stmt Events.E0 le mf ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
               (and
                  (Memory.Mem.range_perm mf br BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
                      iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p))
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (pos : BinNums.Z) =>
                         or (not (@eq Values.block b br))
                           (or (BinInt.Z.lt pos BinNums.Z0)
                              (BinInt.Z.le
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) pos)))
                        m mf)))))
### C.jet_secp_decompress_prefix.exec_decompress_finite_owned
exec_decompress_finite_owned
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (br : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               jet_secp_decompress_statements.decompress_finite_stmt Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 mf br
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@Some Values.val (Values.Vint Integers.Int.zero)))
               (and
                  (Memory.Mem.range_perm mf br BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block b br))
                        (or
                           (BinInt.Z.lt pos
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (BinInt.Z.le
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                     m mf))))
