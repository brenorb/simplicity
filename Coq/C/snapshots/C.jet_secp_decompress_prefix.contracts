exec_decompress_prefix_owned
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bx br b2 b3 : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._x le)
                (@Some Values.val (Values.Vptr bx Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b2 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b3 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bx
                   (@cons Values.block br (@cons Values.block b2 (@cons Values.block b3 (@nil Values.block))))))
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
