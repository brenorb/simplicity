### C.jet_secp_decompress_prefix.decompress_prefix_frame
decompress_prefix_frame =
fun (bx br b2 b3 b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b bx))
  (and (not (@eq Values.block b br)) (and (not (@eq Values.block b b2)) (not (@eq Values.block b b3))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments decompress_prefix_frame bx br b2 b3 b _%Z_scope
