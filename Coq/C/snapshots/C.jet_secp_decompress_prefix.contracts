                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b3 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence jet_secp_decompress_statements.decompress_prefix
                  Clight.Sskip) Events.E0 le mf ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
               (and (jet_secp_fe_nv.fe_at mf br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
