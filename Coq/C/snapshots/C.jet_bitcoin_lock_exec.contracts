### C.jet_bitcoin_lock_exec.f_lockHeight_shape
f_lockHeight_shape
     : @eq Clight.function jets_bitcoin.f_lockHeight (lock_fn lock_height_cmp)
### C.jet_bitcoin_lock_exec.f_lockTime_shape
f_lockTime_shape
     : @eq Clight.function jets_bitcoin.f_lockTime (lock_fn lock_time_cmp)
### C.jet_bitcoin_lock_exec.bitcoin_tx_lockTime
bitcoin_tx_lockTime
     : jet_bitcoin_field_eval.bitcoin_field_at jets_bitcoin._bitcoinTransaction jets_bitcoin._lockTime
         (BinNums.Zpos
            (BinNums.xO
               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
### C.jet_bitcoin_lock_exec.eval_lock_fn
eval_lock_fn
     : forall (cmp : Clight.expr) (m : Memory.Mem.mem) (bt : Values.block) (tbase : BinNums.Z)
         (b c : bool) (lt : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 tbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add tbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bt
                   (BinInt.Z.add tbase
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                (@Some Values.val (Values.Vint (jet_bitcoin_is_final_local.bool_int b))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bt
                   (BinInt.Z.add tbase
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                (@Some Values.val (Values.Vlong lt)))
         (_ : forall (le : Maps.PTree.tree Values.val)
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._t'5 le)
                       (@Some Values.val (Values.Vlong lt))),
              Clight.eval_expr jet_bitcoin_linkage.bitcoin_ge Clight.empty_env le m (Clight.Ecast cmp Ctypesdefs.tbool)
                (Values.Vint (jet_bitcoin_is_final_local.bool_int c))),
       ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge m
         (@Ctypes.Internal Clight.function (lock_fn cmp))
         (@cons Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase)) (@nil Values.val)) Events.E0 m
         (Values.Vlong (lock_result b c lt))
### C.jet_bitcoin_lock_exec.lock_fn
lock_fn =
fun cmp : Clight.expr =>
Clight.mkfunction Ctypesdefs.tulong AST.cc_default
  (@cons (prod AST.ident Ctypes.type)
     (@pair AST.ident Ctypes.type jets_bitcoin._tx
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
     (@nil (prod AST.ident Ctypes.type))) (@nil (prod AST.ident Ctypes.type))
  (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_bitcoin._t'2 Ctypesdefs.tulong)
     (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_bitcoin._t'1 Ctypesdefs.tint)
        (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_bitcoin._t'5 Ctypesdefs.tulong)
           (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_bitcoin._t'4 Ctypesdefs.tbool)
              (@cons (prod AST.ident Ctypes.type) (@pair AST.ident Ctypes.type jets_bitcoin._t'3 Ctypesdefs.tulong)
                 (@nil (prod AST.ident Ctypes.type)))))))
  (Clight.Ssequence
     (Clight.Ssequence
        (Clight.Ssequence
           (Clight.Sset jets_bitcoin._t'4
              (Clight.Efield
                 (Clight.Ederef
                    (Clight.Etempvar jets_bitcoin._tx
                       (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
                    (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) jets_bitcoin._isFinal
                 Ctypesdefs.tbool))
           (Clight.Sifthenelse
              (Clight.Eunop Cop.Onotbool (Clight.Etempvar jets_bitcoin._t'4 Ctypesdefs.tbool) Ctypesdefs.tint)
              (Clight.Ssequence
                 (Clight.Sset jets_bitcoin._t'5
                    (Clight.Efield
                       (Clight.Ederef
                          (Clight.Etempvar jets_bitcoin._tx
                             (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
                          (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) jets_bitcoin._lockTime
                       Ctypesdefs.tulong)) (Clight.Sset jets_bitcoin._t'1 (Clight.Ecast cmp Ctypesdefs.tbool)))
              (Clight.Sset jets_bitcoin._t'1 (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint))))
        (Clight.Sifthenelse (Clight.Etempvar jets_bitcoin._t'1 Ctypesdefs.tint)
           (Clight.Ssequence
              (Clight.Sset jets_bitcoin._t'3
                 (Clight.Efield
                    (Clight.Ederef
                       (Clight.Etempvar jets_bitcoin._tx
                          (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
                       (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) jets_bitcoin._lockTime
                    Ctypesdefs.tulong))
              (Clight.Sset jets_bitcoin._t'2
                 (Clight.Ecast (Clight.Etempvar jets_bitcoin._t'3 Ctypesdefs.tulong) Ctypesdefs.tulong)))
           (Clight.Sset jets_bitcoin._t'2
              (Clight.Ecast (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint) Ctypesdefs.tulong))))
     (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_bitcoin._t'2 Ctypesdefs.tulong))))
     : forall _ : Clight.expr, Clight.function

Arguments lock_fn cmp
### C.jet_bitcoin_lock_exec.lock_height_cmp
lock_height_cmp =
Clight.Ebinop Cop.Olt (Clight.Etempvar jets_bitcoin._t'5 Ctypesdefs.tulong)
  (Clight.Econst_int
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (...))))))))))))))))))))))
     Ctypesdefs.tuint) Ctypesdefs.tint
     : Clight.expr
### C.jet_bitcoin_lock_exec.lock_time_cmp
lock_time_cmp =
Clight.Ebinop Cop.Ole
  (Clight.Econst_int
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (...))))))))))))))))))))))
     Ctypesdefs.tuint) (Clight.Etempvar jets_bitcoin._t'5 Ctypesdefs.tulong) Ctypesdefs.tint
     : Clight.expr
### C.jet_bitcoin_lock_exec.lock_result
lock_result =
fun (b c : bool) (lt : Integers.Int64.int) =>
match andb (negb b) c return Integers.Int64.int with
| true => lt
| false => Integers.Int64.zero
end
     : forall (_ : bool) (_ : bool) (_ : Integers.Int64.int), Integers.Int64.int

Arguments lock_result (b c)%bool_scope lt
