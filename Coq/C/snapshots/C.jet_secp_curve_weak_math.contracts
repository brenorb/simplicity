### C.jet_secp_curve_weak_math.eval_curve_weak_numeric
eval_curve_weak_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_field_add_initial.field_values rho (S O)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (n : nat) (_ : and (le (S O) n) (le n (S (S (S (S (S O))))))),
              BinInt.Z.le (Integers.Int64.unsigned (rho n))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex BinNums.Z
            (fun r0 : BinNums.Z =>
             @ex BinNums.Z
               (fun r1 : BinNums.Z =>
                @ex BinNums.Z
                  (fun r2 : BinNums.Z =>
                   @ex BinNums.Z
                     (fun r3 : BinNums.Z =>
                      @ex BinNums.Z
                        (fun r4 : BinNums.Z =>
                         and
                           (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                              (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_weak)
                              (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
                              Values.Vundef)
                           (and
                              (jet_secp_fe_nv.fe_at mf b BinNums.Z0
                                 (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                                    (@cons BinNums.Z r0
                                       (@cons BinNums.Z r1
                                          (@cons BinNums.Z r2
                                             (@cons BinNums.Z r3 (@cons BinNums.Z r4 (@nil BinNums.Z))))))))
                              (and
                                 (@eq BinNums.Z
                                    (BinInt.Z.modulo (jet_secp_fe_math.fe_val r0 r1 r2 r3 r4) jet_secp_fe_math.feP)
                                    (BinInt.Z.modulo
                                       (jet_secp_fe_math.fe_val (Integers.Int64.unsigned (rho (S O)))
                                          (Integers.Int64.unsigned (rho (S (S O))))
                                          (Integers.Int64.unsigned (rho (S (S (S O)))))
                                          (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                                          (Integers.Int64.unsigned (rho (S (S (S (S (S O)))))))) jet_secp_fe_math.feP))
                                 (and
                                    (and
                                       (and (BinInt.Z.le BinNums.Z0 r0)
                                          (BinInt.Z.le r0
                                             (BinNums.Zpos
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))
                                       (and
                                          (and (BinInt.Z.le BinNums.Z0 r1)
                                             (BinInt.Z.le r1
                                                (BinNums.Zpos
                                                   (BinNums.xI
                                                      (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))
                                          (and
                                             (and (BinInt.Z.le BinNums.Z0 r2)
                                                (BinInt.Z.le r2
                                                   (BinNums.Zpos
                                                      (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))
                                             (and
                                                (and (BinInt.Z.le BinNums.Z0 r3)
                                                   (BinInt.Z.le r3
                                                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))
                                                (and (BinInt.Z.le BinNums.Z0 r4)
                                                   (BinInt.Z.le r4
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))
                                    (and
                                       (Memory.Mem.range_perm mf b BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (jet_sx_mem.lframe
                                          (fun (b' : Values.block) (o : BinNums.Z) =>
                                           not
                                             (jet_sx_state.foot
                                                (@cons (prod Values.block BinNums.Z)
                                                   (@pair Values.block BinNums.Z b BinNums.Z0)
                                                   (@nil (prod Values.block BinNums.Z)))
                                                (@List.map jet_sx_state.region
                                                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool)
                                                      (option BinNums.Z)) jet_sx_state.rshape
                                                   jet_secp_local_regions.local_write_initial_regs) b' o)) m mf)))))))))))
