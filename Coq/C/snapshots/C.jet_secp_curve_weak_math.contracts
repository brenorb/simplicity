### C.jet_secp_curve_weak_math.curve_weak_math_spec
curve_weak_math_spec
     : forall (t0 t1 t2 t3 t4 : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 t0)
                (BinInt.Z.le t0
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t1)
                (BinInt.Z.le t1
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t2)
                (BinInt.Z.le t2
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t3)
                (BinInt.Z.le t3
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t4)
                (BinInt.Z.le t4
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))),
       match jet_secp_curve_weak.curve_weak_math t0 t1 t2 t3 t4 return Prop with
       | pair p r4 =>
           match p return Prop with
           | pair p0 r3 =>
               match p0 return Prop with
               | pair p1 r2 =>
                   match p1 return Prop with
                   | pair r0 r1 =>
                       and
                         (@eq BinNums.Z (BinInt.Z.modulo (jet_secp_fe_math.fe_val r0 r1 r2 r3 r4) jet_secp_fe_math.feP)
                            (BinInt.Z.modulo (jet_secp_fe_math.fe_val t0 t1 t2 t3 t4) jet_secp_fe_math.feP))
                         (and
                            (and (BinInt.Z.le BinNums.Z0 r0)
                               (BinInt.Z.le r0
                                  (BinNums.Zpos
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI
                                                                (BinNums.xI
                                                                   (BinNums.xI
                                                                      (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))))))))))
                            (and
                               (and (BinInt.Z.le BinNums.Z0 r1)
                                  (BinInt.Z.le r1
                                     (BinNums.Zpos
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI
                                                                (BinNums.xI
                                                                   (BinNums.xI
                                                                      (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))
                               (and
                                  (and (BinInt.Z.le BinNums.Z0 r2)
                                     (BinInt.Z.le r2
                                        (BinNums.Zpos
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI
                                                                (BinNums.xI
                                                                   (BinNums.xI
                                                                      (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))))))))
                                  (and
                                     (and (BinInt.Z.le BinNums.Z0 r3)
                                        (BinInt.Z.le r3
                                           (BinNums.Zpos
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI
                                                                (BinNums.xI
                                                                   (BinNums.xI
                                                                      (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))
                                     (and (BinInt.Z.le BinNums.Z0 r4)
                                        (BinInt.Z.le r4
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xI (BinNums.xO (BinNums.xO (...)))))))))))))))))))
                   end
