     : forall (z : BinNums.Z)
         (_ : and
                (BinInt.Z.lt
                   (BinInt.Z.opp
                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinNums.Zpos
