split_low_positive
     : forall (hi lo : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 hi)
                (BinInt.Z.lt hi
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
