### C.jet_secp_split_pack_numeric.literal_split_top_cases
literal_split_top_cases
     : forall word : Ty.tySem (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S (S O))))))))),
       or
         (and
            (@eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
               (@Word.leftmost (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S (S O)))))))) Alg.CoreFunSem word)
               (@inl unit unit tt))
            (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) word)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xI
                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
         (and
            (@eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
               (@Word.leftmost (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S (S O)))))))) Alg.CoreFunSem word)
               (@inr unit unit tt))
            (BinInt.Z.le
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xI
                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) word)))
