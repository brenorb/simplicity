                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                   z)
                (BinInt.Z.lt z
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @eq BinNums.Z (BinInt.Z.modulo z jet_secp_canonical_scalar.canonical_group_order)
         match BinInt.Z.ltb z BinNums.Z0 return BinNums.Z with
         | true => BinInt.Z.add jet_secp_canonical_scalar.canonical_group_order z
         | false => z
         end
