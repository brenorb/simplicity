### C.jet_sha256_max_counter.sha256_max_counter_symbol
sha256_max_counter_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            jets._sha256_max_counter) (@Some Values.block (jet_exec.jet_symbol_block jets._sha256_max_counter))
### C.jet_sha256_max_counter.sha256_max_counter_var_info
sha256_max_counter_var_info
     : @eq (option (AST.globvar Ctypes.type))
         (@Globalenvs.Genv.find_var_info (Ctypes.fundef Clight.function) Ctypes.type
            (@Globalenvs.Genv.globalenv (Ctypes.fundef Clight.function) Ctypes.type
               (@Ctypes.program_of_program Clight.function jets.prog))
            (jet_exec.jet_symbol_block jets._sha256_max_counter))
         (@Some (AST.globvar Ctypes.type) jets.v_sha256_max_counter)
### C.jet_sha256_max_counter.sha256_max_counter_threshold
sha256_max_counter_threshold
     : @eq Integers.Int64.int
         (Integers.Int64.shru
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO
                                                                     (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))))
            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH)))))
         (Integers.Int64.repr
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO
                                                                     (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))))))))))
### C.jet_sha256_max_counter.sha256_max_counter_initialized
sha256_max_counter_initialized
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets.prog)) (@Some Memory.Mem.mem m)),
       sha256_max_counter_at m
### C.jet_sha256_max_counter.sha256_max_counter_valid_block
sha256_max_counter_valid_block
     : forall (m : Memory.Mem.mem) (_ : sha256_max_counter_at m),
       Memory.Mem.valid_block m (jet_exec.jet_symbol_block jets._sha256_max_counter)
### C.jet_sha256_max_counter.sha256_max_counter_alloc
sha256_max_counter_alloc
     : forall (m : Memory.Mem.mem) (mf : Memory.Mem.mem') (lo hi : BinNums.Z) (fresh : Values.block)
         (_ : sha256_max_counter_at m)
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m lo hi)
                (@pair Memory.Mem.mem' Values.block mf fresh)),
       and (sha256_max_counter_at mf)
         (not (@eq Values.block fresh (jet_exec.jet_symbol_block jets._sha256_max_counter)))
### C.jet_sha256_max_counter.sha256_max_counter_free
sha256_max_counter_free
     : forall (m mf : Memory.Mem.mem) (b : Values.block) (lo hi : BinNums.Z) (_ : sha256_max_counter_at m)
         (_ : not (@eq Values.block b (jet_exec.jet_symbol_block jets._sha256_max_counter)))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.free m b lo hi) (@Some Memory.Mem.mem mf)),
       sha256_max_counter_at mf
### C.jet_sha256_max_counter.sha256_max_counter_writable_other
sha256_max_counter_writable_other
     : forall (m : Memory.Mem.mem) (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
         (_ : sha256_max_counter_at m) (_ : Memory.Mem.valid_access m chunk b ofs Memtype.Writable),
       not (@eq Values.block b (jet_exec.jet_symbol_block jets._sha256_max_counter))
### C.jet_sha256_max_counter.sha256_max_counter_store
sha256_max_counter_store
     : forall (m mf : Memory.Mem.mem) (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
         (v : Values.val) (_ : sha256_max_counter_at m)
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.store chunk m b ofs v) (@Some Memory.Mem.mem mf)),
       sha256_max_counter_at mf
### C.jet_sha256_max_counter.eval_sha256_max_counter
eval_sha256_max_counter
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._sha256_max_counter e)
                (@None (prod Values.block Ctypes.type))) (_ : sha256_max_counter_at m),
       Clight.eval_expr jet_exec.ge0 e le m
         (Clight.Evar jets._sha256_max_counter (Ctypes.Tlong Ctypes.Unsigned Ctypes.noattr))
         (Values.Vlong
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
### C.jet_sha256_max_counter.sha256_max_counter_at
sha256_max_counter_at =
fun m : Memory.Mem.mem =>
and
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint64 m (jet_exec.jet_symbol_block jets._sha256_max_counter) BinNums.Z0)
     (@Some Values.val
        (Values.Vlong
           (Integers.Int64.repr
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))))
  (forall ofs : BinNums.Z,
   not (Memory.Mem.perm m (jet_exec.jet_symbol_block jets._sha256_max_counter) ofs Memtype.Cur Memtype.Writable))
     : forall _ : Memory.Mem.mem, Prop

Arguments sha256_max_counter_at m
