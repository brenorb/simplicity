### C.jet_secp_norm_group.secp_field_word_invert_product
secp_field_word_invert_product
     : forall (z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : not
                (@eq jet_secp_curve_group.secp_group_field (jet_secp_field_word_group.secp_field_word z)
                   (GZnZ.zero jet_secp_fe_math.feP))),
       @eq (GZnZ.znz jet_secp_fe_math.feP)
         (GZnZ.mul jet_secp_fe_math.feP (jet_secp_field_word_group.secp_field_word z)
            (jet_secp_field_word_group.secp_field_word (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem z)))
         (GZnZ.one jet_secp_fe_math.feP)
### C.jet_secp_norm_group.secp_field_word_inverse_nonzero
secp_field_word_inverse_nonzero
     : forall (z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : not
                (@eq jet_secp_curve_group.secp_group_field (jet_secp_field_word_group.secp_field_word z)
                   (GZnZ.zero jet_secp_fe_math.feP))),
       not
         (@eq jet_secp_curve_group.secp_group_field
            (jet_secp_field_word_group.secp_field_word (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem z))
            (GZnZ.zero jet_secp_fe_math.feP))
### C.jet_secp_norm_group.secp_literal_gej_norm_group
secp_literal_gej_norm_group
     : forall (x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : not
                (@eq jet_secp_curve_group.secp_group_field (jet_secp_field_word_group.secp_field_word z)
                   (GZnZ.zero jet_secp_fe_math.feP)))
         (_ : jet_secp_jacobian_word_group.secp_jacobian_word_rep (GZnZ.one jet_secp_fe_math.feP)
                (@pair
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z) p),
       jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
         (@jet_secp_gej_norm_literal.literal_gej_norm Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)) p
