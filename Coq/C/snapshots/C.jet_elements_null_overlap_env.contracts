### C.jet_elements_null_overlap_env.overlap_output_fields
overlap_output_fields =
fun (m : Memory.Mem.mem) (b : Values.block) (o : BinNums.Z) (_ : unit) =>
and
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mptr m b
        (BinInt.Z.add o
           (BinNums.Zpos
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))))))
     (@Some Values.val (Values.Vptr b (Integers.Ptrofs.repr o))))
  (and
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m b
           (BinInt.Z.add o
              (BinNums.Zpos
                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))))))
        (@Some Values.val (Values.Vlong Integers.Int64.one)))
     (and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint8unsigned m b
              (BinInt.Z.add o
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
           (@Some Values.val (Values.Vint Integers.Int.one)))
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint32 m b
              (BinInt.Z.add o
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
           (@Some Values.val
              (Values.Vint (jet_elements_null_data_opcode.elements_datum_code (@jet_elements_prim.OP1 Digest.hash256)))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : unit), Prop

Arguments overlap_output_fields m b o%Z_scope _
