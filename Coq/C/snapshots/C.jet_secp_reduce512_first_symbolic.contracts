jet_secp_reduce512_wide.wide_sumadd (rho (S (S (S (S (S O))))))
  (jet_secp_reduce512_wide.wide_muladd (rho (S (S (S (S (S (S O))))))) jet_secp_reduce512_symbolic.wide_C1
     (jet_secp_reduce512_wide.wide_muladd (rho (S (S (S (S (S (S (S O)))))))) jet_secp_reduce512_symbolic.wide_C0
        (jet_secp_reduce512_wide.wide_sumadd (rho (S (S (S O)))) (jet_secp_reduce512_wide.wide_extract (first_ma2 rho)))))
