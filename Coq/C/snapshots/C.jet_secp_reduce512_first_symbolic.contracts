  (jet_secp_reduce512_wide.wide_muladd (rho (S (S (S (S (S O)))))) jet_secp_reduce512_symbolic.wide_C0
     (jet_secp_reduce512_wide.wide_sumadd_fast (rho (S O)) (jet_secp_reduce512_wide.wide_extract_fast (first_ma0 rho))))
     : forall _ : forall _ : nat, Integers.Int64.int, jet_secp_reduce512_wide.wide_column

Arguments first_ma1 rho%function_scope
### C.jet_secp_reduce512_first_symbolic.first_ma2
first_ma2 =
