Arguments first_ma3 rho%function_scope
### C.jet_secp_reduce512_first_symbolic.first_ma4
first_ma4 =
fun rho : forall _ : nat, Integers.Int64.int =>
jet_secp_reduce512_wide.wide_sumadd (rho (S (S (S (S (S (S O)))))))
  (jet_secp_reduce512_wide.wide_muladd (rho (S (S (S (S (S (S (S O)))))))) jet_secp_reduce512_symbolic.wide_C1
