### C.jet_secp_reduce512_first_symbolic.first_machine_outputs
first_machine_outputs =
fun rho : forall _ : nat, Integers.Int64.int =>
@cons Integers.Int64.int (jet_secp_reduce512_wide.wlo (first_ma0 rho))
  (@cons Integers.Int64.int (jet_secp_reduce512_wide.wlo (first_ma1 rho))
     (@cons Integers.Int64.int (jet_secp_reduce512_wide.wlo (first_ma2 rho))
        (@cons Integers.Int64.int (jet_secp_reduce512_wide.wlo (first_ma3 rho))
           (@cons Integers.Int64.int (jet_secp_reduce512_wide.wlo (first_ma4 rho))
              (@cons Integers.Int64.int (jet_secp_reduce512_wide.wlo (first_ma5 rho))
                 (@cons Integers.Int64.int
                    (Integers.Int64.repr
                       (Integers.Int.unsigned (Integers.Int64.loword (jet_secp_reduce512_wide.whi (first_ma5 rho)))))
                    (@nil Integers.Int64.int)))))))
     : forall _ : forall _ : nat, Integers.Int64.int, list Integers.Int64.int

Arguments first_machine_outputs rho%function_scope
