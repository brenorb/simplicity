### C.jet_secp_reduce512_first_symbolic.first_symbolic_source
first_symbolic_source
     : @eq (list jet_sx_expr.sx) jet_secp_reduce512_first_run.reduce512_first_limbs first_symbolic_outputs
### C.jet_secp_reduce512_first_symbolic.first_columns_rep
first_columns_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       and (jet_secp_reduce512_symbolic.wide_rep rho beta first_sy0 (first_ma0 rho))
         (and (jet_secp_reduce512_symbolic.wide_rep rho beta first_sy1 (first_ma1 rho))
            (and (jet_secp_reduce512_symbolic.wide_rep rho beta first_sy2 (first_ma2 rho))
               (and (jet_secp_reduce512_symbolic.wide_rep rho beta first_sy3 (first_ma3 rho))
                  (and (jet_secp_reduce512_symbolic.wide_rep rho beta first_sy4 (first_ma4 rho))
                     (jet_secp_reduce512_symbolic.wide_rep rho beta first_sy5 (first_ma5 rho))))))
### C.jet_secp_reduce512_first_symbolic.first_outputs_machine
first_outputs_machine
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho beta)
            jet_secp_reduce512_first_run.reduce512_first_limbs)
         (@List.map Integers.Int64.int Values.val Values.Vlong (first_machine_outputs rho))
### C.jet_secp_reduce512_first_symbolic.first_sy0
first_sy0 =
jet_secp_reduce512_symbolic.wide_symbolic_muladd_fast (jet_sx_expr.XLv (S (S (S (S O)))))
  jet_secp_reduce512_symbolic.wide_symbolic_C0
  (jet_secp_reduce512_symbolic.wide_symbolic_from_word (jet_sx_expr.XLv O))
     : jet_secp_scalar_mul512_symbolic.symbolic_column
### C.jet_secp_reduce512_first_symbolic.first_sy1
first_sy1 =
jet_secp_reduce512_symbolic.wide_symbolic_muladd (jet_sx_expr.XLv (S (S (S (S O)))))
  jet_secp_reduce512_symbolic.wide_symbolic_C1
  (jet_secp_reduce512_symbolic.wide_symbolic_muladd (jet_sx_expr.XLv (S (S (S (S (S O))))))
     jet_secp_reduce512_symbolic.wide_symbolic_C0
     (jet_secp_reduce512_symbolic.wide_symbolic_sumadd_fast (jet_sx_expr.XLv (S O))
        (jet_secp_reduce512_symbolic.wide_symbolic_extract_fast first_sy0)))
     : jet_secp_scalar_mul512_symbolic.symbolic_column
### C.jet_secp_reduce512_first_symbolic.first_sy2
first_sy2 =
jet_secp_reduce512_symbolic.wide_symbolic_sumadd (jet_sx_expr.XLv (S (S (S (S O)))))
  (jet_secp_reduce512_symbolic.wide_symbolic_muladd (jet_sx_expr.XLv (S (S (S (S (S O))))))
     jet_secp_reduce512_symbolic.wide_symbolic_C1
     (jet_secp_reduce512_symbolic.wide_symbolic_muladd (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
        jet_secp_reduce512_symbolic.wide_symbolic_C0
        (jet_secp_reduce512_symbolic.wide_symbolic_sumadd (jet_sx_expr.XLv (S (S O)))
           (jet_secp_reduce512_symbolic.wide_symbolic_extract first_sy1))))
     : jet_secp_scalar_mul512_symbolic.symbolic_column
### C.jet_secp_reduce512_first_symbolic.first_sy3
first_sy3 =
jet_secp_reduce512_symbolic.wide_symbolic_sumadd (jet_sx_expr.XLv (S (S (S (S (S O))))))
  (jet_secp_reduce512_symbolic.wide_symbolic_muladd (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
     jet_secp_reduce512_symbolic.wide_symbolic_C1
     (jet_secp_reduce512_symbolic.wide_symbolic_muladd (jet_sx_expr.XLv (S (S (S (S (S (S (S O))))))))
        jet_secp_reduce512_symbolic.wide_symbolic_C0
        (jet_secp_reduce512_symbolic.wide_symbolic_sumadd (jet_sx_expr.XLv (S (S (S O))))
           (jet_secp_reduce512_symbolic.wide_symbolic_extract first_sy2))))
     : jet_secp_scalar_mul512_symbolic.symbolic_column
### C.jet_secp_reduce512_first_symbolic.first_sy4
first_sy4 =
jet_secp_reduce512_symbolic.wide_symbolic_sumadd (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
  (jet_secp_reduce512_symbolic.wide_symbolic_muladd (jet_sx_expr.XLv (S (S (S (S (S (S (S O))))))))
     jet_secp_reduce512_symbolic.wide_symbolic_C1 (jet_secp_reduce512_symbolic.wide_symbolic_extract first_sy3))
     : jet_secp_scalar_mul512_symbolic.symbolic_column
### C.jet_secp_reduce512_first_symbolic.first_sy5
first_sy5 =
jet_secp_reduce512_symbolic.wide_symbolic_sumadd_fast (jet_sx_expr.XLv (S (S (S (S (S (S (S O))))))))
  (jet_secp_reduce512_symbolic.wide_symbolic_extract first_sy4)
     : jet_secp_scalar_mul512_symbolic.symbolic_column
### C.jet_secp_reduce512_first_symbolic.first_symbolic_outputs
first_symbolic_outputs =
@cons jet_sx_expr.sx (jet_secp_scalar_mul512_symbolic.sc_lo first_sy0)
  (@cons jet_sx_expr.sx (jet_secp_scalar_mul512_symbolic.sc_lo first_sy1)
     (@cons jet_sx_expr.sx (jet_secp_scalar_mul512_symbolic.sc_lo first_sy2)
        (@cons jet_sx_expr.sx (jet_secp_scalar_mul512_symbolic.sc_lo first_sy3)
           (@cons jet_sx_expr.sx (jet_secp_scalar_mul512_symbolic.sc_lo first_sy4)
              (@cons jet_sx_expr.sx (jet_secp_scalar_mul512_symbolic.sc_lo first_sy5)
                 (@cons jet_sx_expr.sx
                    (jet_sx_expr.XI2L Ctypes.Unsigned
                       (jet_sx_expr.XL2I (jet_secp_scalar_mul512_symbolic.sc_hi first_sy5)))
                    (@nil jet_sx_expr.sx)))))))
     : list jet_sx_expr.sx
### C.jet_secp_reduce512_first_symbolic.first_ma0
first_ma0 =
fun rho : forall _ : nat, Integers.Int64.int =>
jet_secp_reduce512_wide.wide_muladd_fast (rho (S (S (S (S O))))) jet_secp_reduce512_symbolic.wide_C0
  (jet_secp_reduce512_wide.wide_from_word (rho O))
     : forall _ : forall _ : nat, Integers.Int64.int, jet_secp_reduce512_wide.wide_column

Arguments first_ma0 rho%function_scope
### C.jet_secp_reduce512_first_symbolic.first_ma1
first_ma1 =
fun rho : forall _ : nat, Integers.Int64.int =>
