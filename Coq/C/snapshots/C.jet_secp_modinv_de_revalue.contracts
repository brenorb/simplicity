de62_revalue_matrix
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.region_ok rho beta m (S (S O))
                (@List.nth jet_sx_state.region (S (S O)) jet_secp_modinv_de_exec.de62_regs
                   (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z)))),
       jet_sx_state.region_ok (de62_next_rho rho) beta m (S (S O))
         (@List.nth jet_sx_state.region (S (S O)) jet_secp_modinv_de_exec.de62_regs
