### C.jet_secp_modinv_de_revalue.de62_next_limbs_den
de62_next_limbs_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (high : bool),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den (de62_next_rho rho) beta)
            (@List.map nat jet_sx_expr.sx jet_sx_expr.XLv
               (List.seq match high return nat with
                         | true => S (S (S (S (S O))))
                         | false => O
                         end (S (S (S (S (S O))))))))
