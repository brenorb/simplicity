### C.jet_secp_modinv_de_revalue.de62_rep_four
de62_rep_four
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : list (prod Values.block BinNums.Z))
         (m : Memory.Mem.mem) (a b c d : jet_sx_state.region)
         (_ : @eq nat (@length (prod Values.block BinNums.Z) beta) (S (S (S (S O)))))
         (_ : jet_sx_state.rsep beta
                (@cons jet_sx_state.region a
                   (@cons jet_sx_state.region b
                      (@cons jet_sx_state.region c (@cons jet_sx_state.region d (@nil jet_sx_state.region))))))
         (_ : jet_sx_state.region_ok rho beta m O a) (_ : jet_sx_state.region_ok rho beta m (S O) b)
         (_ : jet_sx_state.region_ok rho beta m (S (S O)) c) (_ : jet_sx_state.region_ok rho beta m (S (S (S O))) d),
       jet_sx_state.rep rho beta
         (@cons jet_sx_state.region a
            (@cons jet_sx_state.region b
               (@cons jet_sx_state.region c (@cons jet_sx_state.region d (@nil jet_sx_state.region))))) m
### C.jet_secp_modinv_de_revalue.de62_revalue_result
de62_revalue_result
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta de62_result_regs m),
       jet_sx_state.rep (de62_next_rho rho) beta jet_secp_modinv_de_exec.de62_regs m
### C.jet_secp_modinv_de_revalue.de62_revalue
de62_revalue
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta (jet_sx_eval.sregs jet_secp_modinv_de_exec.de62_state) m),
       jet_sx_state.rep (de62_next_rho rho) beta jet_secp_modinv_de_exec.de62_regs m
### C.jet_secp_modinv_de_revalue.eval_de_step
eval_de_step
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta jet_secp_modinv_de_exec.de62_regs m)
         (_ : forall high : bool, jet_secp_modinv_de_correction_numeric.de62_row_bound rho high)
         (_ : jet_secp_modinv_de_numeric.de62_state_bounds rho),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_update_de_62)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                           (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O)))))
                        (@cons Values.val
                           (Values.Vptr (jet_sx_state.blk beta (S (S (S O))))
                              (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S (S O))))))
                           (@nil Values.val))))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep (de62_next_rho rho) beta jet_secp_modinv_de_exec.de62_regs mf)
               (and (jet_secp_modinv_de_numeric.de62_state_bounds (de62_next_rho rho))
                  (and
                     (forall high : bool,
                      and
                        (@eq BinNums.Z
                           (BinInt.Z.mul
                              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                              (jet_secp_modinv_de_numeric.de62_input_value (de62_next_rho rho) high))
                           (BinInt.Z.add (jet_secp_modinv_de_numeric.de62_matrix_value rho high)
                              (BinInt.Z.mul jet_secp_fe_math.feP
                                 (jet_secp_modinv_de_correction_numeric.de62_correction_value rho high))))
                        (@eq BinNums.Z
                           (BinInt.Z.modulo
                              (BinInt.Z.sub
                                 (BinInt.Z.mul
                                    (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                    (jet_secp_modinv_de_numeric.de62_input_value (de62_next_rho rho) high))
                                 (jet_secp_modinv_de_numeric.de62_matrix_value rho high)) jet_secp_fe_math.feP)
                           BinNums.Z0))
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot beta
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape jet_secp_modinv_de_exec.de62_regs) b ofs)) m mf)))))
### C.jet_secp_modinv_de_revalue.de62_next_rho
de62_next_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (n : nat) =>
match PeanoNat.Nat.ltb n (S (S (S (S (S (S (S (S (S (S O)))))))))) return Integers.Int64.int with
| true =>
    jet_secp_modinv_de_recurrence_words.de62_recurrence_word rho (PeanoNat.Nat.leb (S (S (S (S (S O))))) n)
      (PeanoNat.Nat.modulo n (S (S (S (S (S O))))))
| false => rho n
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments de62_next_rho rho%function_scope n%nat_scope
### C.jet_secp_modinv_de_revalue.de62_result_regs
de62_result_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_modinv_de_exec.de62_limbs false)) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_modinv_de_exec.de62_limbs true)) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     (@cons jet_sx_state.region
        (@List.nth jet_sx_state.region (S (S O)) jet_secp_modinv_de_exec.de62_regs
           (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z)))
        (@cons jet_sx_state.region
           (@List.nth jet_sx_state.region (S (S (S O))) jet_secp_modinv_de_exec.de62_regs
              (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))) (@nil jet_sx_state.region))))
     : list jet_sx_state.region
