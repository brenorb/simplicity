de62_call_shape
     : @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
         (@List.map jet_sx_state.region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
            jet_sx_state.rshape (jet_sx_eval.sregs jet_secp_modinv_de_exec.de62_state))
         (@List.map jet_sx_state.region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
            jet_sx_state.rshape jet_secp_modinv_de_exec.de62_regs)
### C.jet_secp_modinv_de_revalue.de62_revalue_array
de62_revalue_array
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (high : bool)
         (_ : jet_sx_state.region_ok rho beta m match high return nat with
                                                | true => S O
                                                | false => O
                                                end
                (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 (jet_secp_modinv_de_exec.de62_limbs high)) true
                   (@Some BinNums.Z
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))),
       jet_sx_state.region_ok (de62_next_rho rho) beta m match high return nat with
                                                         | true => S O
                                                         | false => O
                                                         end
         (jet_sx_state.mkreg
            (jet_sx_rep.u64_cells BinNums.Z0
               (@List.map nat jet_sx_expr.sx jet_sx_expr.XLv
                  (List.seq match high return nat with
                            | true => S (S (S (S (S O))))
                            | false => O
                            end (S (S (S (S (S O)))))))) true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
### C.jet_secp_modinv_de_revalue.de62_result_regs_eq
de62_result_regs_eq
