### C.jet_elements_null_data_literal.haskell_encode_null_datum_matches
haskell_encode_null_datum_matches
     : forall (d : jet_elements_prim.txNullDatumF Digest.hash256) (unused_hash : Digest.hash256),
       @eq
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))
         (jet_elements_null_data_opcode.elements_datum_value d unused_hash) (haskell_encode_null_datum d)
### C.jet_elements_null_data_literal.elements_output_null_datum_literal_matches
elements_output_null_datum_literal_matches
     : forall (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))))
         (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem
               (Ty.Sum Ty.Unit
                  (Ty.Sum Ty.Unit
                     (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))))
         (@jet_elements_null_data_layout.elements_output_null_datum_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment) (elements_output_null_datum_literal_spec a environment)
