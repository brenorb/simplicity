                            | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                            end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))) a)))
         (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment)))
    return
      (sum unit
         (sum unit
            (Ty.tySem
               (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))))
  with
  | Some txo =>
      match
        jet_elements_prim.txNullData (jet_elements_prim.txoScript txo)
        return
          (sum unit
             (sum unit
                (Ty.tySem
                   (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))))
      with
      | Some parsed =>
          @inr unit
            (sum unit
               (Ty.tySem
                  (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))
            match
              @List.hd_error (jet_elements_prim.txNullDatumF (list Integers.Byte.int))
                (@List.skipn (jet_elements_prim.txNullDatumF (list Integers.Byte.int))
                   (BinInt.Z.to_nat
                      (jet_elements_sequence_literal.haskell_from_word (S (S (S (S (S O)))))
                         (@snd
                            (prod
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end)
                                  ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                                      match n return Ty.Ty with
                                      | O => X
                                      | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                                      end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end)
                                  ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                                      match n return Ty.Ty with
                                      | O => X
                                      | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                                      end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O)))))))
                            (prod
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end)
                                  ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                                      match n return Ty.Ty with
                                      | O => X
                                      | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                                      end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end)
                                  ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                                      match n return Ty.Ty with
                                      | O => X
                                      | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                                      end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))) a))) parsed)
              return
                (sum unit
                   (Ty.tySem
                      (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))
            with
            | Some d =>
                @inr unit
                  (Ty.tySem
                     (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))
                  (haskell_encode_null_datum
                     (@jet_elements_prim.mapNullDatum (list Integers.Byte.int) Digest.hash256 Digest.byteStringHash d))
            | None =>
                @inl unit
                  (Ty.tySem
                     (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))) tt
            end
      | None =>
          @inl unit
            (sum unit
               (Ty.tySem
                  (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))) tt
      end
  | None =>
      @inl unit
        (sum unit
           (Ty.tySem
              (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))) tt
  end
     : forall (_ : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))))
         (_ : jet_elements_prim.Elements.env),
       option
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Sum Ty.Unit
                  (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))))

Arguments elements_output_null_datum_literal_spec a environment
