### C.jet_secp_negate_input_bridge.canonical_normalized_field_range
canonical_normalized_field_range
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (BinInt.Z.le BinNums.Z0
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)))
         (BinInt.Z.lt
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x))
            jet_secp_canonical_normalize.canonical_field_order)
### C.jet_secp_negate_input_bridge.canonical_fe_negate_normalized_input
canonical_fe_negate_normalized_input
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_canonical_negate.canonical_fe_negate Alg.CoreFunSem
            (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x))
         (@jet_secp_canonical_negate.canonical_fe_negate Alg.CoreFunSem x)
