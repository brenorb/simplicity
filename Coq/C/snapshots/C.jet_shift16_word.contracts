### C.jet_shift16_word.shift16_machine_denotes
shift16_machine_denotes
     : forall (right : bool) (amount : Ty.tySem (Word.Word (S (S O))))
         (x : Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16))),
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16)))
         (jet_shift16_layout_machine.shift16_machine_value right amount x)
         (@jet_shift16_spec.shift16_plain_spec right Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S O)))) (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W16))) amount x))
