### C.jet_secp_mixed_ex_local.gej_ge_add_ex_mismatch_domain
gej_ge_add_ex_mismatch_domain
     : forall ax ay az bx byword : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       iff
         (gej_ge_add_ex_ratio_mismatch
            (@pair
               (prod
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay) az)
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) bx byword)))
         (and
            (@eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
               (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay) az))
               (@inl unit unit tt))
            (and
               (@eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                  (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
                     (jet_secp_mixed_dispatch_literal.mixed_literal_h ax az bx)) (@inr unit unit tt))
               (and
                  (@eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                     (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
                        (jet_secp_mixed_dispatch_literal.mixed_literal_i ay az byword)) (@inr unit unit tt))
                  (BinInt.Z.le jet_secp_fe_math.feP
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ay)))))
