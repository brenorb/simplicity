### C.jet_secp_mixed_ex_local.encode_output_cells
encode_output_cells
     : forall r x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list BitMachine.Cell)
         (@Translate.encode
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
               (Ty.Prod
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (prod
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) r
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z)))
         (@app BitMachine.Cell (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) r)
            (@app BitMachine.Cell
               (@app BitMachine.Cell (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) x)
                  (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) y))
               (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) z)))
