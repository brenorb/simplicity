### C.jet_secp_point_verify_literal.literal_point_check_parametric
literal_point_check_parametric
     : @Alg.Core.Parametric literal_point_verify_args (Ty.Sum Ty.Unit Ty.Unit) (@literal_point_check)
### C.jet_secp_point_verify_literal.literal_point_verify_parametric
literal_point_verify_parametric
     : @Alg.Assertion.Parametric literal_point_verify_args Ty.Unit (@literal_point_verify)
### C.jet_secp_point_verify_literal.literal_point_check_value
literal_point_check_value
     : forall (na ng : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (a b : Ty.tySem literal_compressed_point),
       @eq (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (@literal_point_check Alg.CoreFunSem
            (@pair
               (prod
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem literal_compressed_point))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.tySem literal_compressed_point)
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem literal_compressed_point))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem literal_compressed_point)
                     na a) ng) b))
         match
           @jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem b return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         with
         | inl _ => @inl unit unit tt
         | inr bp =>
             match
               @jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem a
               return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
             with
             | inl _ => @inl unit unit tt
             | inr ap =>
                 @jet_secp_linear_verify_literal.literal_linear_check Alg.CoreFunSem
                   (@pair
                      (prod
                         (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                            (prod
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                      (prod
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                      (@pair
                         (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                            (prod
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                            (prod
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                               ((fix tySem (X : Ty.Ty) : Set :=
                                   match X return Set with
                                   | Ty.Unit => unit
                                   | Ty.Sum A B => sum (tySem A) (tySem B)
                                   | Ty.Prod A B => prod (tySem A) (tySem B)
                                   end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) na ap) ng) bp)
             end
         end
### C.jet_secp_point_verify_literal.literal_point_verify_option
literal_point_verify_option
     : forall input : Ty.tySem literal_point_verify_args,
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem Ty.Unit))
         (@literal_point_verify (Alg.AssertionSem Option.option_Monad_Zero) input)
         match
           Bit.toBool (@literal_point_check Alg.CoreFunSem input)
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem Ty.Unit))
         with
         | true => @Some unit tt
         | false => @None (Ty.tySem Ty.Unit)
         end
