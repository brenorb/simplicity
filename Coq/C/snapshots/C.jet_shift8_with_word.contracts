### C.jet_shift8_with_word.shift8_with_payload_repr
shift8_with_payload_repr
     : forall (right fill : bool) (amount : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S O)))))
         (x : Ty.tySem (Word.Word (S (S (S O))))) (r a : Integers.Int.int)
         (_ : @eq BinNums.Z (Integers.Int.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x))
         (_ : @eq BinNums.Z (Integers.Int.unsigned a) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S O))) amount)),
       @eq Integers.Int.int (jet_shift8_helper_exec.shift8_payload right fill r a)
         (Integers.Int.repr
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O))))
               (@jet_shift8_with_spec.shift8_with_spec right Alg.CoreFunSem
                  (@pair (sum unit unit)
                     (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S O))))) (Ty.tySem (Word.Word (S (S (S O))))))
                     (Bit.fromBool fill)
                     (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))
                        amount x)))))
