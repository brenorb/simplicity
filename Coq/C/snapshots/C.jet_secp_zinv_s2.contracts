### C.jet_secp_zinv_s2.zinv_s2_az_source
zinv_s2_az_source
     : @eq Clight.statement jet_secp_zinv_shared_preparation.zinv_after_shared_preparation
         (Clight.Ssequence zinv_s2_az_statement zinv_after_s2_az)
### C.jet_secp_zinv_s2.exec_zinv_s2_az_from_owned
exec_zinv_s2_az_from_owned
     : forall (a z : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (bs bz : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._s2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._az e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bz jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds a)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : not (@eq Values.block bs bz))
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : jet_secp_fe_nv.fe_at m bz BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m zinv_s2_az_statement Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bs BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_field_pair_multiply.field_pair_product a z)))
               (and (jet_secp_fe_nv.fe_at mf bz BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 z))
                  (and
                     (Memory.Mem.range_perm mf bs BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bz BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_field_pair_multiply.field_pair_product a z)) jet_secp_fe_math.feP)
                              (BinInt.Z.modulo
                                 (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                                    (jet_secp_multiply_finish_product.radix_value z)) jet_secp_fe_math.feP))
                           (and
                              (jet_secp_field_mul_small.mul_small_input_bounds
                                 (jet_secp_field_pair_multiply.field_pair_product a z))
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block bx bs)) (not (@eq Values.block bx bz))) m mf))))))))
### C.jet_secp_zinv_s2.zinv_s2_az_statement
zinv_s2_az_statement =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._s2)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._s2)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._az) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_zinv_s2.zinv_after_s2_az
zinv_after_s2_az =
jet_secp_zinv_shared_preparation.zinv_statement_drop (S O)
  jet_secp_zinv_shared_preparation.zinv_after_shared_preparation
     : Clight.statement
