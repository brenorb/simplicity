### C.jet_elements_taptweak_beta.elements_taptweak_beta_block
elements_taptweak_beta_block =
jet_elements_taptweak_globals.elements_taptweak_symbol_block jets_secp._secp256k1_const_beta
     : Values.block
### C.jet_elements_taptweak_beta.elements_taptweak_beta_global_rep
elements_taptweak_beta_global_rep =
fun m : Memory.Mem.mem =>
and (Memory.Mem.valid_block m elements_taptweak_beta_block)
  (and
     (Memory.Mem.range_perm m elements_taptweak_beta_block BinNums.Z0
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
        Memtype.Readable)
     (forall (i : nat) (w : Integers.Int64.int)
        (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int jet_secp_beta_global.beta_words i)
               (@Some Integers.Int64.int w)),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m elements_taptweak_beta_block
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong w))))
     : forall _ : Memory.Mem.mem, Prop

Arguments elements_taptweak_beta_global_rep m
### C.jet_elements_taptweak_beta.elements_taptweak_beta_readonly_bounds
elements_taptweak_beta_readonly_bounds =
fun m : Memory.Mem.mem =>
forall (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
iff (Memory.Mem.perm m elements_taptweak_beta_block ofs k p)
  (and
     (and (BinInt.Z.le BinNums.Z0 ofs)
        (BinInt.Z.lt ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     (Memtype.perm_order Memtype.Readable p))
     : forall _ : Memory.Mem.mem, Prop

Arguments elements_taptweak_beta_readonly_bounds m
### C.jet_elements_taptweak_beta.elements_taptweak_beta_initialized
elements_taptweak_beta_initialized =
fun m : Memory.Mem.mem => and (elements_taptweak_beta_global_rep m) (elements_taptweak_beta_readonly_bounds m)
     : forall _ : Memory.Mem.mem, Prop

Arguments elements_taptweak_beta_initialized m
