### C.jet_sha_steps.shx_writeBit_step
shx_writeBit_step
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (bit : bool)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor (BinNums.Zpos BinNums.xH)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets.f_writeBit)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val
                     (Values.Vint
                        match bit return Integers.Int.int with
                        | true => Integers.Int.one
                        | false => Integers.Int.zero
                        end) (@nil Values.val))) Events.E0 mf
               (Values.Vint
                  match bit return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (jet_bitcoin_effects.write_effect m mf bf base bw edge cursor (BinNums.Zpos BinNums.xH)
               (@cons (option bool) (@Some bool bit) (@nil (option bool)))))
### C.jet_sha_steps.shx_skipBits_step
shx_skipBits_step
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (n : nat)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor (BinInt.Z.of_nat n)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets.f_skipBits)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat n))) (@nil Values.val)))
               Events.E0 mf Values.Vundef)
            (jet_bitcoin_effects.write_effect m mf bf base bw edge cursor (BinInt.Z.of_nat n)
               (@List.repeat (option bool) (@None bool) n)))
### C.jet_sha_steps.wide_writer_helper
wide_writer_helper
     : forall s : jet_wide.wide_size,
       @ex AST.ident
         (fun id : AST.ident =>
          @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id (jet_wide.wide_writer s))
            jet_sha_transport.sha_core_helpers)
### C.jet_sha_steps.shx_write_wide_step
shx_write_wide_step
     : forall (s : jet_wide.wide_size) (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z)
         (bw : Values.block) (edge cursor : BinNums.Z) (x : Integers.Int64.int)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor (jet_wide.wide_bits s)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vlong x) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (jet_bitcoin_effects.write_effect m mf bf base bw edge cursor (jet_wide.wide_bits s)
               (@Translate.encode (Word.Word (jet_wide.wide_log s))
                  (jet_wide_spec.decode_wide s (Integers.Int64.zero_ext (jet_wide.wide_bits s) x)))))
### C.jet_sha_steps.wide_reader_helper
wide_reader_helper
     : forall s : jet_wide.wide_size,
       @ex AST.ident
         (fun id : AST.ident =>
          @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id (jet_wide.wide_reader s))
            jet_sha_transport.sha_core_helpers)
### C.jet_sha_steps.shx_read_wide_step
shx_read_wide_step
     : forall (s : jet_wide.wide_size) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc : Memory.Mem.mem)
         (bl bs : Values.block) (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (x : Ty.tySem (Word.Word (jet_wide.wide_log s))) (bytes : list Memdata.memval)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (jet_wide.wide_bits s))))
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge rc x)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          @ex Integers.Int64.int
            (fun r : Integers.Int64.int =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge mc
                  (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                  (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val)) Events.E0 mr
                  (Values.Vlong r))
               (and
                  (@eq BinNums.Z (Integers.Int64.unsigned r)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) x))
                  (and
                     (jet_frame_layout.frame_fields_at mr bl BinNums.Z0 bi edge
                        (BinInt.Z.add rc (jet_wide.wide_bits s)))
                     (and
                        (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                           (_ : not (@eq Values.block b bl)),
                         @eq (option Values.val) (Memory.Mem.load chunk mr b ofs) (Memory.Mem.load chunk mc b ofs))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm mc b ofs kind p),
                            Memory.Mem.perm mr b ofs kind p)
                           (and
                              (forall (b : Values.block) (_ : Memory.Mem.valid_block mc b), Memory.Mem.valid_block mr b)
                              (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                 (v : Values.val)
                                 (_ : @eq (option Values.val) (Memory.Mem.load chunk m b ofs) (@Some Values.val v)),
                               @eq (option Values.val) (Memory.Mem.load chunk mr b ofs) (@Some Values.val v)))))))))
