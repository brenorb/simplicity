### C.jet_elements_taptweak_set_b32.eval_elements_taptweak_set_b32_owned
eval_elements_taptweak_set_b32_owned
     : forall (bytes : list BinNums.Z) (m : Memory.Mem.mem) (bt bb : Values.block)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (_ : not (@eq Values.block bt bb))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bb (BinInt.Z.of_nat i))
                (@Some Values.val (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i bytes BinNums.Z0))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_set_b32)
               (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               (Values.Vint
                  (Integers.Int.repr
                     (jet_sx_zval.b2z (BinInt.Z.ltb (jet_secp_fe_math.be_val bytes) jet_secp_fe_math.feP)))))
            (and
               (jet_secp_fe_nv.fe_at mf bt BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_fe_math.fe_limbs_of (jet_secp_fe_math.be_val bytes))))
               (and
                  (Memory.Mem.range_perm mf bt BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bb BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))),
                         @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned mf bb (BinInt.Z.of_nat i))
                           (@Some Values.val (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i bytes BinNums.Z0)))))
                        (and
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (_ : BinNums.Z) =>
                               and (not (@eq Values.block b bt)) (not (@eq Values.block b bb))) m mf)
                           (jet_clight_internal_preserve.readonly_preserved m mf)))))))
### C.jet_elements_taptweak_set_b32.eval_elements_taptweak_xonly_field_read
eval_elements_taptweak_xonly_field_read
     : forall (pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bx bin : Values.block) (_ : not (@eq Values.block bx bin))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bin BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes pk))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_set_b32)
               (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               (Values.Vint (jet_secp_xonly_parse_field.xonly_strict_flag pk)))
            (and
               (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_swu_raw_input.swu_raw_words pk)))
               (and
                  (Memory.Mem.range_perm mf bx BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bin BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bx)) (not (@eq Values.block b bin))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
