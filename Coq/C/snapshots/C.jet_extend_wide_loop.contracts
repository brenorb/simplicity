### C.jet_extend_wide_loop.extend_wide_loop_shape
extend_wide_loop_shape
     : forall s : extend_wide_size,
       @eq Clight.statement
         match Clight.fn_body (extend_wide_function s) return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s1 =>
             match s1 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s3 =>
                 match s3 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence _ s5 =>
                     match s5 return Clight.statement with
                     | Clight.Sskip => Clight.Sskip
                     | Clight.Sassign _ _ => Clight.Sskip
                     | Clight.Sset _ _ => Clight.Sskip
                     | Clight.Scall _ _ _ => Clight.Sskip
                     | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                     | Clight.Ssequence s6 _ =>
                         match s6 return Clight.statement with
                         | Clight.Sskip => Clight.Sskip
                         | Clight.Sassign _ _ => Clight.Sskip
                         | Clight.Sset _ _ => Clight.Sskip
                         | Clight.Scall _ _ _ => Clight.Sskip
                         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                         | Clight.Ssequence _ loop => loop
                         | Clight.Sifthenelse _ _ _ => Clight.Sskip
                         | Clight.Sloop _ _ => Clight.Sskip
                         | Clight.Sbreak => Clight.Sskip
                         | Clight.Scontinue => Clight.Sskip
                         | Clight.Sreturn _ => Clight.Sskip
                         | Clight.Sswitch _ _ => Clight.Sskip
                         | Clight.Slabel _ _ => Clight.Sskip
                         | Clight.Sgoto _ => Clight.Sskip
                         end
                     | Clight.Sifthenelse _ _ _ => Clight.Sskip
                     | Clight.Sloop _ _ => Clight.Sskip
                     | Clight.Sbreak => Clight.Sskip
                     | Clight.Scontinue => Clight.Sskip
                     | Clight.Sreturn _ => Clight.Sskip
                     | Clight.Sswitch _ _ => Clight.Sskip
                     | Clight.Slabel _ _ => Clight.Sskip
                     | Clight.Sgoto _ => Clight.Sskip
                     end
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end (extend_wide_loop s)
### C.jet_extend_wide_loop.eval_extend_wide_limit
eval_extend_wide_limit
     : forall (s : extend_wide_size) (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem),
       Clight.eval_expr jet_exec.ge0 e le m (extend_wide_limit s)
         (Values.Vint (Integers.Int.repr (extend_wide_count s)))
### C.jet_extend_wide_loop.eval_extend_wide_guard
eval_extend_wide_guard
     : forall (s : extend_wide_size) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i)))),
       Clight.eval_expr jet_exec.ge0 e le m (extend_wide_guard s)
         (Values.Vint (jet_readBit_layout.bit_int (BinInt.Z.ltb i (extend_wide_count s))))
### C.jet_extend_wide_loop.exec_extend_wide_fill
exec_extend_wide_fill
     : forall (s : extend_wide_size) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bit : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._msb le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer (extend_wide_input s)))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vlong (jet_pad_bit_spec.extend_bit_long (extend_wide_input s) bit))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (extend_wide_fill s) Events.E0
         (@Maps.PTree.set Values.val jets._t'2 (jet_extend_bit_wide_exec.extend_bit_raw (extend_wide_input s) bit) le)
         mf ClightBigstep.Out_normal
### C.jet_extend_wide_loop.exec_extend_wide_loop
exec_extend_wide_loop
     : forall (s : extend_wide_size) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bit : bool) (i : BinNums.Z)
         (n : nat) (_ : BinInt.Z.le BinNums.Z0 i)
         (_ : @eq BinNums.Z (BinInt.Z.add i (BinInt.Z.of_nat n)) (extend_wide_count s))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._msb le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : extend_wide_fill_run s bd base bit n m mf),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (extend_wide_loop s) Events.E0 lef
               mf ClightBigstep.Out_normal)
            (forall (id : AST.ident) (_ : not (@eq AST.ident id jets._i)) (_ : not (@eq AST.ident id jets._t'2)),
             @eq (option Values.val) (@Maps.PTree.get Values.val id lef) (@Maps.PTree.get Values.val id le)))
### C.jet_extend_wide_loop.extend_wide_size
Inductive extend_wide_size : Set :=
    E16to32 : extend_wide_size | E16to64 : extend_wide_size | E32to64 : extend_wide_size.
### C.jet_extend_wide_loop.extend_wide_input
extend_wide_input =
fun s : extend_wide_size =>
match s return jet_wide.wide_size with
| E16to32 => jet_wide.W16
| E16to64 => jet_wide.W16
| E32to64 => jet_wide.W32
end
     : forall _ : extend_wide_size, jet_wide.wide_size

Arguments extend_wide_input s
### C.jet_extend_wide_loop.extend_wide_output
extend_wide_output =
fun s : extend_wide_size =>
match s return jet_wide.wide_size with
| E16to32 => jet_wide.W32
| E16to64 => jet_wide.W64
| E32to64 => jet_wide.W64
end
     : forall _ : extend_wide_size, jet_wide.wide_size

Arguments extend_wide_output s
### C.jet_extend_wide_loop.extend_wide_bits
extend_wide_bits =
fun s : extend_wide_size => jet_wide.wide_bits (extend_wide_output s)
     : forall _ : extend_wide_size, BinNums.Z

Arguments extend_wide_bits s
### C.jet_extend_wide_loop.extend_wide_count
extend_wide_count =
fun s : extend_wide_size =>
match s return BinNums.Z with
| E16to32 => BinNums.Zpos BinNums.xH
| E16to64 => BinNums.Zpos (BinNums.xI BinNums.xH)
| E32to64 => BinNums.Zpos BinNums.xH
end
     : forall _ : extend_wide_size, BinNums.Z

Arguments extend_wide_count s
### C.jet_extend_wide_loop.extend_wide_function
extend_wide_function =
fun s : extend_wide_size =>
match s return Clight.function with
| E16to32 => jets.f_simplicity_left_extend_16_32
| E16to64 => jets.f_simplicity_left_extend_16_64
| E32to64 => jets.f_simplicity_left_extend_32_64
end
     : forall _ : extend_wide_size, Clight.function

Arguments extend_wide_function s
### C.jet_extend_wide_loop.extend_wide_limit
extend_wide_limit =
fun s : extend_wide_size =>
Clight.Ebinop Cop.Osub
  (Clight.Ebinop Cop.Odiv (Clight.Econst_int (Integers.Int.repr (extend_wide_bits s)) Ctypesdefs.tint)
     (Clight.Econst_int (Integers.Int.repr (jet_wide.wide_bits (extend_wide_input s))) Ctypesdefs.tint) Ctypesdefs.tint)
  (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint
     : forall _ : extend_wide_size, Clight.expr

Arguments extend_wide_limit s
### C.jet_extend_wide_loop.extend_wide_guard
extend_wide_guard =
fun s : extend_wide_size => Clight.Ebinop Cop.Olt jet_eq256_loop.eq256_index (extend_wide_limit s) Ctypesdefs.tint
     : forall _ : extend_wide_size, Clight.expr

Arguments extend_wide_guard s
### C.jet_extend_wide_loop.extend_wide_choose
extend_wide_choose =
fun s : extend_wide_size =>
Clight.Sifthenelse (Clight.Etempvar jets._msb Ctypesdefs.tbool)
  (Clight.Sset jets._t'2 (jet_extend_bit_wide_exec.extend_bit_choice_expr (extend_wide_input s) true))
  (Clight.Sset jets._t'2 (jet_extend_bit_wide_exec.extend_bit_choice_expr (extend_wide_input s) false))
     : forall _ : extend_wide_size, Clight.statement

Arguments extend_wide_choose s
### C.jet_extend_wide_loop.extend_wide_fill
extend_wide_fill =
fun s : extend_wide_size =>
Clight.Ssequence (extend_wide_choose s)
  (jet_arith8_layout_exec.frame_writer_call (jet_wide.wide_writer_id (extend_wide_input s)) Ctypesdefs.tulong
     Ctypesdefs.tvoid (Clight.Etempvar jets._t'2 (jet_extend_bit_wide_exec.extend_bit_type (extend_wide_input s))))
     : forall _ : extend_wide_size, Clight.statement

Arguments extend_wide_fill s
### C.jet_extend_wide_loop.extend_wide_loop
extend_wide_loop =
fun s : extend_wide_size =>
Clight.Sloop
  (Clight.Ssequence (Clight.Sifthenelse (extend_wide_guard s) Clight.Sskip Clight.Sbreak) (extend_wide_fill s))
  jet_eq256_loop.eq256_loop_step
     : forall _ : extend_wide_size, Clight.statement

Arguments extend_wide_loop s
### C.jet_extend_wide_loop.extend_wide_fill_run
extend_wide_fill_run =
fix extend_wide_fill_run
  (s : extend_wide_size) (bd : Values.block) (base : BinNums.Z) (bit : bool) (n : nat) (m mf : Memory.Mem.mem) {struct
   n} : Prop :=
  match n return Prop with
  | O => @eq Memory.Mem.mem m mf
  | S n0 =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         and
           (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
              (@Ctypes.Internal Clight.function (jet_wide.wide_writer (extend_wide_input s)))
              (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                 (@cons Values.val (Values.Vlong (jet_pad_bit_spec.extend_bit_long (extend_wide_input s) bit))
                    (@nil Values.val))) Events.E0 mi Values.Vundef) (extend_wide_fill_run s bd base bit n0 mi mf))
  end
     : forall (_ : extend_wide_size) (_ : Values.block) (_ : BinNums.Z) (_ : bool) (_ : nat)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments extend_wide_fill_run s bd base%Z_scope bit%bool_scope n%nat_scope m mf
