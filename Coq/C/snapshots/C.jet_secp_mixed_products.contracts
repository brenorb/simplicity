### C.jet_secp_mixed_products.mixed_products_source
mixed_products_source
     : @eq Clight.statement jet_secp_mixed_nonzero_start.mixed_after_h_square
         (jet_secp_statement_prefix.statement_sequence mixed_product_statements mixed_after_products)
### C.jet_secp_mixed_products.exec_mixed_products
exec_mixed_products
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (b2 b3 bt bh bu : Values.block) (q h u : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._h2 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b2 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._h3 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b3 jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._h e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bh jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._u1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bu jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block b2
                   (@cons Values.block b3
                      (@cons Values.block bt (@cons Values.block bh (@cons Values.block bu (@nil Values.block)))))))
         (_ : jet_secp_field_mul_small.mul_small_input_bounds q) (_ : jet_secp_square_columns.square_input_bounds h)
         (_ : jet_secp_square_columns.square_input_bounds u)
         (_ : jet_secp_fe_nv.fe_at m b2 BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 q))
         (_ : jet_secp_fe_nv.fe_at m bh BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 h))
         (_ : jet_secp_fe_nv.fe_at m bu BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
         (_ : Memory.Mem.range_perm m b2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b3 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bh BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bu BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (jet_secp_statement_prefix.statement_sequence mixed_product_statements Clight.Sskip) Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf b2 BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_field_negate_separate.negate_sep_words q)))
               (and
                  (jet_secp_fe_nv.fe_at mf b3 BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5
                        (jet_secp_point_mul_storage.point_mul_words (jet_secp_field_negate_separate.negate_sep_words q)
                           h)))
                  (and
                     (jet_secp_fe_nv.fe_at mf bt BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_point_mul_storage.point_mul_words u
                              (jet_secp_field_negate_separate.negate_sep_words q))))
                     (and (jet_secp_fe_nv.fe_at mf bh BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 h))
                        (and (jet_secp_fe_nv.fe_at mf bu BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 u))
                           (and
                              (Memory.Mem.range_perm mf b2 BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf b3 BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bt BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (Memory.Mem.range_perm mf bh BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (Memory.Mem.range_perm mf bu BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (@eq BinNums.Z
                                                (jet_secp_multiply_finish_product.radix_value
                                                   (jet_secp_field_negate_separate.negate_sep_words q))
                                                (BinInt.Z.sub
                                                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                                      jet_secp_fe_math.feP)
                                                   (jet_secp_multiply_finish_product.radix_value q)))
                                             (and
                                                (jet_secp_square_columns.square_input_bounds
                                                   (jet_secp_field_negate_separate.negate_sep_words q))
                                                (and
                                                   (@eq BinNums.Z
                                                      (BinInt.Z.modulo
                                                         (jet_secp_multiply_finish_product.radix_value
                                                            (jet_secp_point_mul_storage.point_mul_words
                                                               (jet_secp_field_negate_separate.negate_sep_words q) h))
                                                         jet_secp_fe_math.feP)
                                                      (BinInt.Z.modulo
                                                         (BinInt.Z.mul
                                                            (jet_secp_multiply_finish_product.radix_value
                                                               (jet_secp_field_negate_separate.negate_sep_words q))
                                                            (jet_secp_multiply_finish_product.radix_value h))
                                                         jet_secp_fe_math.feP))
                                                   (and
                                                      (@eq BinNums.Z
                                                         (BinInt.Z.modulo
                                                            (jet_secp_multiply_finish_product.radix_value
                                                               (jet_secp_point_mul_storage.point_mul_words u
                                                                  (jet_secp_field_negate_separate.negate_sep_words q)))
                                                            jet_secp_fe_math.feP)
                                                         (BinInt.Z.modulo
                                                            (BinInt.Z.mul
                                                               (jet_secp_multiply_finish_product.radix_value u)
                                                               (jet_secp_multiply_finish_product.radix_value
                                                                  (jet_secp_field_negate_separate.negate_sep_words q)))
                                                            jet_secp_fe_math.feP))
                                                      (and
                                                         (jet_secp_field_mul_small.mul_small_input_bounds
                                                            (jet_secp_point_mul_storage.point_mul_words
                                                               (jet_secp_field_negate_separate.negate_sep_words q) h))
                                                         (and
                                                            (jet_secp_field_mul_small.mul_small_input_bounds
                                                               (jet_secp_point_mul_storage.point_mul_words u
                                                                  (jet_secp_field_negate_separate.negate_sep_words q)))
                                                            (jet_sx_mem.lframe (mixed_product_frame b2 b3 bt bh bu) m
                                                               mf))))))))))))))))))
### C.jet_secp_mixed_products.mixed_h2_negate
mixed_h2_negate =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_negate jets_secp.f_secp256k1_fe_negate
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h2)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h2)
        (@cons Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_mixed_products.mixed_h3_mul
mixed_h3_mul =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h3)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h2)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_mixed_products.mixed_t_mul
mixed_t_mul =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._t)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._u1)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h2) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_mixed_products.mixed_product_statements
mixed_product_statements =
@cons Clight.statement mixed_h2_negate
  (@cons Clight.statement mixed_h3_mul (@cons Clight.statement mixed_t_mul (@nil Clight.statement)))
     : list Clight.statement
### C.jet_secp_mixed_products.mixed_after_products
mixed_after_products =
match jet_secp_mixed_nonzero_start.mixed_after_h_square return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ rest => rest
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_mixed_products.mixed_product_frame
mixed_product_frame =
fun (b2 b3 bt bh bu bx : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block bx b2))
  (and (not (@eq Values.block bx b3))
     (and (not (@eq Values.block bx bt)) (and (not (@eq Values.block bx bh)) (not (@eq Values.block bx bu)))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments mixed_product_frame b2 b3 bt bh bu bx _%Z_scope
