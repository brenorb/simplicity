  (Clight.Evar jets_secp._read_fe
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr)) Ctypes.Tnil))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Eaddrof
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_secp._r (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
              (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)) fid (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr))
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5467 Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Etempvar jets_secp._src (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr)))
        (@nil Clight.expr)))
     : forall _ : AST.ident, Clight.statement

