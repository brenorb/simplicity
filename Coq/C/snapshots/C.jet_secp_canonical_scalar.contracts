### C.jet_secp_canonical_scalar.canonical_scalar_normalize_numeric
canonical_scalar_normalize_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_normalize Alg.CoreFunSem x))
         (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
            canonical_group_order)
### C.jet_secp_canonical_scalar.canonical_group_order
canonical_group_order =
BinNums.Zpos
  (BinNums.xI
     (BinNums.xO
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xI
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
     : BinNums.Z
