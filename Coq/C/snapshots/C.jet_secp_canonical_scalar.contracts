### C.jet_secp_canonical_scalar.canonical_group_order_range
canonical_group_order_range
     : and
         (and (BinInt.Z.lt BinNums.Z0 canonical_group_order)
            (BinInt.Z.lt canonical_group_order (jet_predicate_spec.word_modulus (S (S (S (S (S (S (S (S O)))))))))))
         (BinInt.Z.lt (jet_predicate_spec.word_modulus (S (S (S (S (S (S (S (S O)))))))))
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))
### C.jet_secp_canonical_scalar.canonical_group_word_value
canonical_group_word_value
     : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) canonical_group_word)
         canonical_group_order
