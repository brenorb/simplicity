### C.jet_shift64_spec.shift64_plain_spec
shift64_plain_spec =
fun (right : bool) (term : Alg.Core.Algebra) =>
@jet_shift_spec.shift_word_spec (S (S (S O))) (S (S (S (S (S (S O)))))) right term
     : forall (_ : bool) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S (S (S (S O))))))))
         (Word.Word (S (S (S (S (S (S O)))))))

Arguments shift64_plain_spec right%bool_scope {term}
