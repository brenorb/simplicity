### C.jet_secp_gej_norm_literal.literal_gej_norm_step
literal_gej_norm_step
     : forall x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@literal_gej_norm Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z))
         (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x
                  (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem
                     (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem z))))
            (@jet_secp_negate_literal_contract.literal_fe_multiply Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) y
                  (@jet_secp_rescale_literal.literal_fe_cube Alg.CoreFunSem
                     (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem z)))))
### C.jet_secp_gej_norm_literal.literal_gej_norm_numeric
literal_gej_norm_numeric
     : forall x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       match
         @literal_gej_norm Alg.CoreFunSem
           (@pair
              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z) return Prop
       with
       | pair rx ry =>
           @eq (prod BinNums.Z BinNums.Z)
             (@pair BinNums.Z BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) rx)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ry))
             (literal_gej_norm_numeric_value (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) z))
       end
