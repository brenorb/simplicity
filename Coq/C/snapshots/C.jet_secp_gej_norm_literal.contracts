### C.jet_secp_gej_norm_literal.literal_gej_norm
literal_gej_norm =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp
  (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
  (@Alg.Core.Combinators.pair
     (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Alg.Core.Combinators.take
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
        (@Alg.Core.Combinators.iden
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term))
     (@Alg.Core.Combinators.drop
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@jet_secp_invert_literal.literal_fe_invert term))) (@jet_secp_rescale_literal.literal_gej_zinv term)
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments literal_gej_norm {term}
### C.jet_secp_gej_norm_literal.literal_gej_norm_numeric_value
literal_gej_norm_numeric_value =
fun x y z : BinNums.Z =>
let iz : BinNums.Z := jet_secp_invert_literal.literal_invert_numeric z in
@pair BinNums.Z BinNums.Z (BinInt.Z.modulo (BinInt.Z.mul (BinInt.Z.mul x iz) iz) jet_secp_fe_math.feP)
  (BinInt.Z.modulo (BinInt.Z.mul (BinInt.Z.mul (BinInt.Z.mul y iz) iz) iz) jet_secp_fe_math.feP)
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), prod BinNums.Z BinNums.Z

Arguments literal_gej_norm_numeric_value (x y z)%Z_scope
