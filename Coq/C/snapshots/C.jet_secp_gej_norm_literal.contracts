### C.jet_secp_gej_norm_literal.literal_gej_norm_numeric_one
literal_gej_norm_numeric_one
     : forall x y : BinNums.Z,
       @eq (prod BinNums.Z BinNums.Z) (literal_gej_norm_numeric_value x y (BinNums.Zpos BinNums.xH))
         (@pair BinNums.Z BinNums.Z (BinInt.Z.modulo x jet_secp_fe_math.feP) (BinInt.Z.modulo y jet_secp_fe_math.feP))
