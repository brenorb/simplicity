literal_wnaf_run_add
     : forall (n m : nat) (state : Ty.tySem literal_wnaf_state),
       @eq (prod (Ty.tySem literal_wnaf_state) (list (Ty.tySem literal_wnaf_digit)))
         (literal_wnaf_run (Nat.add n m) state)
         match
           literal_wnaf_run n state return (prod (Ty.tySem literal_wnaf_state) (list (Ty.tySem literal_wnaf_digit)))
         with
         | pair middle first =>
             match
               literal_wnaf_run m middle
               return (prod (Ty.tySem literal_wnaf_state) (list (Ty.tySem literal_wnaf_digit)))
             with
             | pair final last =>
                 @pair (Ty.tySem literal_wnaf_state) (list (Ty.tySem literal_wnaf_digit)) final
                   (@app (Ty.tySem literal_wnaf_digit) last first)
             end
         end
