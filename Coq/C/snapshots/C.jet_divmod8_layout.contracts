### C.jet_divmod8_layout.divmod8_context_guarantees
divmod8_context_guarantees =
@jet_guarantees.jet_context_guarantees (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))
  jets.f_simplicity_div_mod_8 (@jet_division_core_spec.div_mod_word_spec (S (S (S O))))
  (jet_division_core_spec.div_mod_word_spec_parametric (S (S (S O)))) divmod8_local_spec
  (ZifyClasses.rew_iff_rev (le (S O) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))))
     (BinInt.Z.le (BinNums.Zpos BinNums.xH)
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
        (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH))
        (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
        (@eq_refl BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     (let __arith :
        BinInt.Z.le (BinNums.Zpos BinNums.xH)
          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) :=
        let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
        let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
        let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
          @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
            (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
               RingMicromega.OpLe
               (@EnvRing.PEc BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            tt in
        ZMicromega.ZTautoChecker_sound __ff __wit
          (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
          (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
      __arith)
   <:
   le (S O) (Translate.bitSize (Word.Word (S (S (S (S O)))))))
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : jet_bitmachine_rep.bm_layout) (ctx : BitMachine.Context)
         (a : Ty.tySem (Word.Word (S (S (S (S O)))))),
       let s0 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState (@Translate.encode (Word.Word (S (S (S (S O))))) a)
              (BitMachine.newWriteFrame (Translate.bitSize (Word.Word (S (S (S (S O)))))))) in
       let s1 : BitMachine.RunState :=
         BitMachine.fillContext ctx
           (BitMachine.Build_LocalState (@Translate.encode (Word.Word (S (S (S (S O))))) a)
              (BitMachine.fullWriteFrame
                 (@Translate.encode (Word.Word (S (S (S (S O)))))
                    (@jet_division_core_spec.div_mod_word_spec (S (S (S O))) Alg.CoreFunSem a)))) in
       forall (_ : jet_bitmachine_rep.bm_rep m L s0) (_ : jet_bitmachine_rep.bm_separated L s0)
         (_ : jet_bitmachine_rep.active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (jet_clight_determinism.silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function jets.f_simplicity_div_mod_8) (jet_bitmachine_rep.jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (jet_bitmachine_rep.bm_rep mf L s1)
               (BitMachine.runProgram
                  (@jet_division_core_spec.div_mod_word_spec (S (S (S O))) Translate.Naive.translate)
                  (BitMachine.Running s0) (BitMachine.Running s1))))

