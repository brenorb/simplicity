### C.jet_secp_mixed_nonzero_start.mixed_clear_flag
mixed_clear_flag =
Clight.Sassign (jet_secp_double_statements.double_point_field jets_secp._r jets_secp._infinity Ctypesdefs.tint)
  (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
     : Clight.statement
### C.jet_secp_mixed_nonzero_start.mixed_null_ratio
mixed_null_ratio =
Clight.Sifthenelse jet_secp_double_var_statements.double_var_null_test
  (Clight.Sassign
     (Clight.Ederef (Clight.Etempvar jets_secp._rzr (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
        jet_secp_curve_statements.curve_fe_type) (Clight.Evar jets_secp._h jet_secp_curve_statements.curve_fe_type))
  Clight.Sskip
     : Clight.statement
### C.jet_secp_mixed_nonzero_start.mixed_z_mul
mixed_z_mul =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._r jets_secp._z)
     (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._a jets_secp._z)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_mixed_nonzero_start.mixed_h_square
mixed_h_square =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_sqr jets_secp.f_secp256k1_fe_sqr
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h2)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_mixed_nonzero_start.mixed_nonzero_start_statements
mixed_nonzero_start_statements =
@cons Clight.statement mixed_clear_flag
  (@cons Clight.statement mixed_null_ratio
     (@cons Clight.statement mixed_z_mul (@cons Clight.statement mixed_h_square (@nil Clight.statement))))
     : list Clight.statement
### C.jet_secp_mixed_nonzero_start.mixed_after_h_square
mixed_after_h_square =
match jet_secp_mixed_zero.mixed_after_zero return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ s4 =>
            match s4 return Clight.statement with
            | Clight.Sskip => Clight.Sskip
            | Clight.Sassign _ _ => Clight.Sskip
            | Clight.Sset _ _ => Clight.Sskip
            | Clight.Scall _ _ _ => Clight.Sskip
            | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
            | Clight.Ssequence _ rest => rest
            | Clight.Sifthenelse _ _ _ => Clight.Sskip
            | Clight.Sloop _ _ => Clight.Sskip
            | Clight.Sbreak => Clight.Sskip
            | Clight.Scontinue => Clight.Sskip
            | Clight.Sreturn _ => Clight.Sskip
            | Clight.Sswitch _ _ => Clight.Sskip
            | Clight.Slabel _ _ => Clight.Sskip
            | Clight.Sgoto _ => Clight.Sskip
            end
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_mixed_nonzero_start.mixed_nonzero_start_frame
mixed_nonzero_start_frame =
fun (bp bh b2 bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bh))
  (and (not (@eq Values.block bx b2))
     (or (not (@eq Values.block bx bp))
        (or
           (BinInt.Z.lt pos
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
           (BinInt.Z.le
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
              pos))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments mixed_nonzero_start_frame bp bh b2 bx pos%Z_scope
### C.jet_secp_mixed_nonzero_start.mixed_nonzero_prefix_statements
mixed_nonzero_prefix_statements =
@cons Clight.statement jet_secp_mixed_zero.mixed_zero_head mixed_nonzero_start_statements
     : list Clight.statement
