### C.jet_secp_mixed_body_ratio_slice.mixed_mode_slice_ratio_words
mixed_mode_slice_ratio_words =
fun (loose : bool) (flag : Integers.Int.int) (x y z u v : forall _ : nat, Integers.Int64.int) =>
match Integers.Int.eq flag Integers.Int.zero return (forall _ : nat, Integers.Int64.int) with
| true => jet_secp_mixed_finite_ratio_slice.mixed_mode_finite_ratio_words loose x y z u v
| false => jet_secp_point_set_bit.point_set_bit_words false
end
     : forall (_ : bool) (_ : Integers.Int.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : nat), Integers.Int64.int

