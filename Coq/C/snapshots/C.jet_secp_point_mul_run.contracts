                    (jet_sx_exec.FInt jets_secp.f_secp256k1_u128_to_u64)) (@nil (prod AST.ident jet_sx_exec.fentry)))))))
     : list (prod AST.ident jet_sx_exec.fentry)
### C.jet_secp_point_mul_run.point_mul_regs
point_mul_regs =
fun k : jet_secp_point_write_run.point_coordinate =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells (jet_secp_point_write_run.point_coordinate_offset k) (jet_secp_fe_nv.vars5 O)) true
     (@Some BinNums.Z
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
  (@cons jet_sx_state.region
     (jet_secp_local_regions.free_region (jet_secp_fe_nv.fe_reg (jet_secp_fe_nv.vars5 (S (S (S (S (S O)))))))
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
     (@nil jet_sx_state.region))
