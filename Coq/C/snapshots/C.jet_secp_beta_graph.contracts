### C.jet_secp_beta_graph.beta_internal_table_correct
beta_internal_table_correct
     : jet_clight_internal_frame.internal_table_ok jet_secp_linkage.secp_ge beta_internal_table
### C.jet_secp_beta_graph.beta_public_allowed
beta_public_allowed
     : jet_clight_internal_frame.allowed_call beta_internal_table
         (@Ctypes.Internal Clight.function jets_secp.f_simplicity_fe_multiply_beta)
### C.jet_secp_beta_graph.beta_reader_allowed
beta_reader_allowed
     : jet_clight_internal_frame.allowed_call beta_internal_table
         (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
### C.jet_secp_beta_graph.beta_writer_allowed
beta_writer_allowed
     : jet_clight_internal_frame.allowed_call beta_internal_table
         (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
### C.jet_secp_beta_graph.beta_graph_call_preserves
beta_graph_call_preserves
     : forall (m : Memory.Mem.mem) (f : Clight.fundef) (args : list Values.val) (t : Events.trace)
         (mf : Memory.Mem.mem) (result : Values.val) (_ : jet_clight_internal_frame.allowed_call beta_internal_table f)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m f args t mf result),
       jet_clight_internal_preserve.readonly_preserved m mf
### C.jet_secp_beta_graph.beta_internal_table
beta_internal_table =
@cons (prod AST.ident Clight.function) (@pair AST.ident Clight.function jets_secp._LSBclear jets_secp.f_LSBclear)
  (@cons (prod AST.ident Clight.function) (@pair AST.ident Clight.function jets_secp._LSBkeep jets_secp.f_LSBkeep)
     (@cons (prod AST.ident Clight.function) (@pair AST.ident Clight.function jets_secp._read8s jets_secp.f_read8s)
        (@cons (prod AST.ident Clight.function)
           (@pair AST.ident Clight.function jets_secp._read_fe jets_secp.f_read_fe)
           (@cons (prod AST.ident Clight.function)
              (@pair AST.ident Clight.function jets_secp._secp256k1_fe_get_b32 jets_secp.f_secp256k1_fe_get_b32)
              (@cons (prod AST.ident Clight.function)
                 (@pair AST.ident Clight.function jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul)
                 (@cons (prod AST.ident Clight.function)
                    (@pair AST.ident Clight.function jets_secp._secp256k1_fe_mul_inner
                       jets_secp.f_secp256k1_fe_mul_inner)
                    (@cons (prod AST.ident Clight.function)
                       (@pair AST.ident Clight.function jets_secp._secp256k1_fe_normalize_var
                          jets_secp.f_secp256k1_fe_normalize_var)
                       (@cons (prod AST.ident Clight.function)
                          (@pair AST.ident Clight.function jets_secp._secp256k1_fe_set_b32
                             jets_secp.f_secp256k1_fe_set_b32)
                          (@cons (prod AST.ident Clight.function)
                             (@pair AST.ident Clight.function jets_secp._secp256k1_u128_accum_mul
                                jets_secp.f_secp256k1_u128_accum_mul)
                             (@cons (prod AST.ident Clight.function)
                                (@pair AST.ident Clight.function jets_secp._secp256k1_u128_accum_u64
                                   jets_secp.f_secp256k1_u128_accum_u64)
                                (@cons (prod AST.ident Clight.function)
                                   (@pair AST.ident Clight.function jets_secp._secp256k1_u128_mul
                                      jets_secp.f_secp256k1_u128_mul)
                                   (@cons (prod AST.ident Clight.function)
                                      (@pair AST.ident Clight.function jets_secp._secp256k1_u128_rshift
                                         jets_secp.f_secp256k1_u128_rshift)
                                      (@cons (prod AST.ident Clight.function)
                                         (@pair AST.ident Clight.function jets_secp._secp256k1_u128_to_u64
                                            jets_secp.f_secp256k1_u128_to_u64)
                                         (@cons (prod AST.ident Clight.function)
                                            (@pair AST.ident Clight.function jets_secp._secp256k1_umul128
                                               jets_secp.f_secp256k1_umul128)
                                            (@cons (prod AST.ident Clight.function)
                                               (@pair AST.ident Clight.function jets_secp._simplicity_fe_multiply_beta
                                                  jets_secp.f_simplicity_fe_multiply_beta)
                                               (@cons (prod AST.ident Clight.function)
                                                  (@pair AST.ident Clight.function jets_secp._simplicity_read8
                                                     jets_secp.f_simplicity_read8)
                                                  (@cons (prod AST.ident Clight.function)
                                                     (@pair AST.ident Clight.function jets_secp._simplicity_write8
                                                        jets_secp.f_simplicity_write8)
                                                     (@cons (prod AST.ident Clight.function)
                                                        (@pair AST.ident Clight.function jets_secp._write8s
                                                           jets_secp.f_write8s)
                                                        (@cons (prod AST.ident Clight.function)
                                                           (@pair AST.ident Clight.function jets_secp._write_fe
                                                              jets_secp.f_write_fe)
                                                           (@nil (prod AST.ident Clight.function)))))))))))))))))))))
     : list (prod AST.ident Clight.function)
