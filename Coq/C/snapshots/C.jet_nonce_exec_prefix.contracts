### C.jet_nonce_exec_prefix.nonce_cells_head
nonce_cells_head
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (bit : bool) (cells : list (option bool))
         (_ : jet_encoding.frame_input_cells_at m bi edge rc (@cons (option bool) (@Some bool bit) cells)),
       jet_input_layout.frame_input_bit_at m bi edge rc bit
### C.jet_nonce_exec_prefix.nonce_cells_tail
nonce_cells_tail
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (cell : BitMachine.Cell)
         (cells : list BitMachine.Cell)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc (@cons BitMachine.Cell cell cells)),
       jet_encoding.frame_input_cells_at m bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) cells
### C.jet_nonce_exec_prefix.nonce_read_cell
nonce_read_cell
     : forall (bl bm bb bx bi : Values.block) (_ : not (@eq Values.block bl bx)) (_ : not (@eq Values.block bl bm))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bi bl)) (le : Clight.temp_env) (m : Memory.Mem.mem) (edge rc : BinNums.Z)
         (bit : bool) (cells : list (option bool)) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (id : AST.ident)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))))
         (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc (@cons (option bool) (@Some bool bit) cells))
         (_ : jet_elements_support_sha_ctx_abs.ctx_abs m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
               (jet_nonce_context_shape.nc_env bl bm bb bx) le m (jet_nonce_context_shape.nc_readbit id) Events.E0
               (@Maps.PTree.set Values.val id (Values.Vint (jet_readBit_layout.bit_int bit)) le) mf
               ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)))
               (and (jet_encoding.frame_input_cells_at mf bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) cells)
                  (and (jet_elements_support_sha_ctx_abs.ctx_abs mf bx bm l regs c ovf)
                     (jet_nonce_exec_effects.nonce_effects m mf (@cons Values.block bl (@nil Values.block)))))))
### C.jet_nonce_exec_prefix.nonce_explicit_prefix
nonce_explicit_prefix
     : forall (_ : jet_memcpy_model.memcpy_model) (bl bm bb bx bi : Values.block) (_ : not (@eq Values.block bl bx))
         (_ : not (@eq Values.block bl bm))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression)))
         (_ : not
                (@eq Values.block bl
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)))
         (_ : not (@eq Values.block bi bl)) (_ : not (@eq Values.block bi bx)) (_ : not (@eq Values.block bi bm))
         (_ : not (@eq Values.block bm bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bx))
         (_ : not
                (@eq Values.block
                   (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_compression) bm))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bx))
         (_ : not
                (@eq Values.block (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._sha256_max_counter)
                   bm)) (le : Clight.temp_env) (m : Memory.Mem.mem) (edge rc : BinNums.Z)
         (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xI
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode jet_nonce_context_spec.nonce_conf_type
                   (@inr
                      (prod (sum unit unit)
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) h)))
         (_ : jet_elements_support_sha_ctx_abs.ctx_abs m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
               (jet_nonce_context_shape.nc_env bl bm bb bx) le m jet_nonce_context_shape.nc_prefix Events.E0
               (@Maps.PTree.set Values.val jets_elements._t'3 (Values.Vint Integers.Int.one) le) mf
               ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                  (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO BinNums.xH))))
               (and
                  (jet_encoding.frame_input_cells_at mf bi edge
                     (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO BinNums.xH)))
                     (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h))
                  (and
                     (jet_elements_support_sha_ctx_abs.ctx_abs mf bx bm
                        (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                           (jet_sha_ctx8_model.absorb l regs
                              (@cons (Ty.tySem (Word.Word (S (S (S O)))))
                                 (jet_nonce_context_spec.nonce_byte (BinNums.Zpos BinNums.xH))
                                 (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
                        (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                           (jet_sha_ctx8_model.absorb l regs
                              (@cons (Ty.tySem (Word.Word (S (S (S O)))))
                                 (jet_nonce_context_spec.nonce_byte (BinNums.Zpos BinNums.xH))
                                 (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
                        (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
                        (jet_elements_support_sha_uchars_exec.uc_overflow ovf c
                           (Integers.Int64.repr (BinNums.Zpos BinNums.xH))))
                     (jet_nonce_exec_effects.nonce_effects m mf
                        (@cons Values.block bl (@cons Values.block bx (@cons Values.block bm (@nil Values.block)))))))))
