### C.jet_bitcoin_totals_local.bitcoin_tx64_mid
bitcoin_tx64_mid =
fun field : AST.ident =>
Clight.Ssequence (jet_bitcoin_hash_getters.bitcoin_env_ptr_stmt jets_bitcoin._tx jets_bitcoin._bitcoinTransaction)
  (Clight.Ssequence
     (Clight.Sset jets_bitcoin._t'2
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_bitcoin._t'1
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
              (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) field Ctypesdefs.tulong))
     (Clight.Scall (@None AST.ident)
        (Clight.Evar jets_bitcoin._simplicity_write64
           (Ctypes.Tfunction
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
                 (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
        (@cons Clight.expr
           (Clight.Etempvar jets_bitcoin._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
           (@cons Clight.expr (Clight.Etempvar jets_bitcoin._t'2 Ctypesdefs.tulong) (@nil Clight.expr)))))
     : forall _ : AST.ident, Clight.statement

