### C.jet_bitcoin_totals_local.bitcoin_tx64_env_rep
bitcoin_tx64_env_rep =
fun (delta : BinNums.Z) (total : forall _ : Bitcoin.Bitcoin.env, BinNums.Z) (m : Memory.Mem.mem)
  (env : Values.val) (environment : Bitcoin.Bitcoin.env) (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun value : Integers.Int64.int =>
               and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                 (and (BinInt.Z.le BinNums.Z0 ebase)
                    (and
                       (BinInt.Z.le
                          (BinInt.Z.add ebase
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                          Integers.Ptrofs.max_unsigned)
                       (and (BinInt.Z.le BinNums.Z0 tbase)
                          (and
                             (BinInt.Z.le
                                (BinInt.Z.add tbase
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...))))))))))
                                Integers.Ptrofs.max_unsigned)
                             (and
                                (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                   (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                                (and
                                   (@eq (option Values.val)
                                      (Memory.Mem.load AST.Mint64 m bt (BinInt.Z.add tbase delta))
                                      (@Some Values.val (Values.Vlong value)))
                                   (and (@eq BinNums.Z (Integers.Int64.unsigned value) (total environment))
                                      (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                            (@pair (prod Values.block BinNums.Z) BinNums.Z
                                               (@pair Values.block BinNums.Z be ebase)
                                               (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (...))))))
                                            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                               (@pair (prod Values.block BinNums.Z) BinNums.Z
                                                  (@pair Values.block BinNums.Z bt (BinInt.Z.add tbase delta))
                                                  (BinInt.Z.add (BinInt.Z.add tbase delta)
                                                     (BinNums.Zpos (BinNums.xO (...)))))
                                               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))))))))))))
     : forall (_ : BinNums.Z) (_ : forall _ : Bitcoin.Bitcoin.env, BinNums.Z) (_ : Memory.Mem.mem)
         (_ : Values.val) (_ : Bitcoin.Bitcoin.env) (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

