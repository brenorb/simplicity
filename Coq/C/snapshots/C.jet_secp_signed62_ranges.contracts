### C.jet_secp_signed62_ranges.s62_radix_power_succ
s62_radix_power_succ
     : forall n : nat,
       @eq BinNums.Z
         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
               (BinInt.Z.of_nat (S n))))
         (BinInt.Z.mul
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                  (BinInt.Z.of_nat n))))
### C.jet_secp_signed62_ranges.s62_value_window
s62_value_window
     : forall (n : nat) (w : forall _ : nat, BinNums.Z)
         (_ : forall (i : nat) (_ : lt i n),
              and (BinInt.Z.le BinNums.Z0 (w i))
                (BinInt.Z.lt (w i)
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))),
       and
         (BinInt.Z.le
            (BinInt.Z.mul
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinInt.Z.mul
                     (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                     (BinInt.Z.of_nat n))) (w n)) (jet_secp_modinv_normalize62_words.norm62_value_z n w))
         (BinInt.Z.lt (jet_secp_modinv_normalize62_words.norm62_value_z n w)
            (BinInt.Z.mul
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinInt.Z.mul
                     (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                     (BinInt.Z.of_nat n))) (BinInt.Z.add (w n) (BinNums.Zpos BinNums.xH))))
### C.jet_secp_signed62_ranges.s62_value_top_bound
s62_value_top_bound
     : forall (n : nat) (w : forall _ : nat, BinNums.Z)
         (_ : forall (i : nat) (_ : lt i n),
              and (BinInt.Z.le BinNums.Z0 (w i))
                (BinInt.Z.lt (w i)
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : BinInt.Z.le (BinInt.Z.abs (jet_secp_modinv_normalize62_words.norm62_value_z n w))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinInt.Z.mul
                      (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                      (BinInt.Z.of_nat (S n))))),
       BinInt.Z.le (BinInt.Z.abs (w n))
         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
            (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
### C.jet_secp_signed62_ranges.s62_unit_top_capacity
s62_unit_top_capacity
     : forall (n : nat) (w : forall _ : nat, BinNums.Z)
         (_ : forall (i : nat) (_ : lt i n),
              and (BinInt.Z.le BinNums.Z0 (w i))
                (BinInt.Z.lt (w i)
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : or (@eq BinNums.Z (w n) BinNums.Z0) (@eq BinNums.Z (w n) (BinNums.Zneg BinNums.xH))),
       BinInt.Z.le (BinInt.Z.abs (jet_secp_modinv_normalize62_words.norm62_value_z n w))
         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
               (BinInt.Z.of_nat n)))
### C.jet_secp_signed62_ranges.s62_value_mod_low
s62_value_mod_low
     : forall (n : nat) (w : forall _ : nat, BinNums.Z),
       @eq BinNums.Z
         (BinInt.Z.modulo (jet_secp_modinv_normalize62_words.norm62_value_z n w)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (BinInt.Z.modulo (w O)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
