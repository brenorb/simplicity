### C.jet_secp_modinv_fg_index.fg_array_layout
fg_array_layout
     : @ex Ctypes.composite
         (fun co : Ctypes.composite =>
          and
            (@eq (option Ctypes.composite)
               (@Maps.PTree.get Ctypes.composite jets_secp._secp256k1_modinv64_signed62
                  (Clight.genv_cenv jet_secp_linkage.secp_ge)) (@Some Ctypes.composite co))
            (@eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
               (Ctypes.field_offset (Clight.genv_cenv jet_secp_linkage.secp_ge) jets_secp._v (Ctypes.co_members co))
               (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield BinNums.Z0 Ctypes.Full))))
### C.jet_secp_modinv_fg_index.fg_for_source
fg_for_source
     : @eq Clight.statement fg_for
         (Clight.Ssequence (Clight.Sset jets_secp._i (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)) fg_loop)
### C.jet_secp_modinv_fg_index.fg_loop_source
fg_loop_source
     : @eq Clight.statement fg_loop
         (Clight.Sloop (Clight.Ssequence (Clight.Sifthenelse fg_guard Clight.Sskip Clight.Sbreak) fg_work) fg_step)
### C.jet_secp_modinv_fg_index.eval_fg_guard
eval_fg_guard
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (i len : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.le i len))
         (_ : BinInt.Z.le len (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le)
                (@Some Values.val (Values.Vint (Integers.Int.repr len)))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m fg_guard
         (Values.Vint
            match BinInt.Z.ltb i len return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
### C.jet_secp_modinv_fg_index.exec_fg_step
exec_fg_step
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i)))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m fg_step Events.E0
         (@Maps.PTree.set Values.val jets_secp._i
            (Values.Vint (Integers.Int.repr (BinInt.Z.add i (BinNums.Zpos BinNums.xH)))) le) m ClightBigstep.Out_normal
### C.jet_secp_modinv_fg_index.exec_fg_loop_exit
exec_fg_loop_exit
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (len : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 len) (BinInt.Z.le len (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr len))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._len le)
                (@Some Values.val (Values.Vint (Integers.Int.repr len)))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m fg_loop Events.E0 le m ClightBigstep.Out_normal
### C.jet_secp_modinv_fg_index.eval_fg_array
eval_fg_array
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (id : BinNums.positive)
         (b : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m (fg_array id) (Values.Vptr b Integers.Ptrofs.zero)
### C.jet_secp_modinv_fg_index.eval_fg_index
eval_fg_index
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (id : BinNums.positive)
         (b : Values.block) (ix : Clight.expr) (k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 k) (BinInt.Z.lt k (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
         (_ : @eq Ctypes.type (Clight.typeof ix) Ctypesdefs.tint)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : Clight.eval_expr jet_secp_linkage.secp_ge e le m ix (Values.Vint (Integers.Int.repr k))),
       Clight.eval_lvalue jet_secp_linkage.secp_ge e le m (fg_index id ix) b
         (Integers.Ptrofs.repr (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) k))
         Ctypes.Full
### C.jet_secp_modinv_fg_index.eval_fg_previous
eval_fg_previous
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) i)
                (BinInt.Z.le i (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i)))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m
         (Clight.Ebinop Cop.Osub (Clight.Etempvar jets_secp._i Ctypesdefs.tint)
            (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint)
         (Values.Vint (Integers.Int.repr (BinInt.Z.sub i (BinNums.Zpos BinNums.xH))))
### C.jet_secp_modinv_fg_index.eval_fg_index_load
eval_fg_index_load
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (id : BinNums.positive)
         (b : Values.block) (ix : Clight.expr) (k : BinNums.Z) (value : Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 k) (BinInt.Z.lt k (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
         (_ : @eq Ctypes.type (Clight.typeof ix) Ctypesdefs.tint)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : Clight.eval_expr jet_secp_linkage.secp_ge e le m ix (Values.Vint (Integers.Int.repr k)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) k))
                (@Some Values.val (Values.Vlong value))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m (fg_index id ix) (Values.Vlong value)
### C.jet_secp_modinv_fg_index.exec_fg_index_store
exec_fg_index_store
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (id : BinNums.positive)
         (b : Values.block) (ix : Clight.expr) (k : BinNums.Z) (src : Clight.expr) (value : Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 k) (BinInt.Z.lt k (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
         (_ : @eq Ctypes.type (Clight.typeof ix) Ctypesdefs.tint)
         (_ : @eq Ctypes.type (Clight.typeof src) Ctypesdefs.tulong)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : Clight.eval_expr jet_secp_linkage.secp_ge e le m ix (Values.Vint (Integers.Int.repr k)))
         (_ : Clight.eval_expr jet_secp_linkage.secp_ge e le m src (Values.Vlong value))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m b
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) k)
                   (Values.Vlong value)) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (Clight.Sassign (fg_index id ix) src) Events.E0
         le mf ClightBigstep.Out_normal
### C.jet_secp_modinv_fg_index.fg_s62_type
fg_s62_type = Ctypes.Tstruct jets_secp._secp256k1_modinv64_signed62 Ctypes.noattr
     : Ctypes.type
### C.jet_secp_modinv_fg_index.fg_array
fg_array =
fun id : AST.ident =>
Clight.Efield (Clight.Ederef (Clight.Etempvar id (Ctypesdefs.tptr fg_s62_type)) fg_s62_type) jets_secp._v
  (Ctypesdefs.tarray Ctypesdefs.tlong (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))))
     : forall _ : AST.ident, Clight.expr

Arguments fg_array id
### C.jet_secp_modinv_fg_index.fg_index
fg_index =
fun (id : AST.ident) (ix : Clight.expr) =>
Clight.Ederef (Clight.Ebinop Cop.Oadd (fg_array id) ix (Ctypesdefs.tptr Ctypesdefs.tlong)) Ctypesdefs.tlong
     : forall (_ : AST.ident) (_ : Clight.expr), Clight.expr

Arguments fg_index id ix
### C.jet_secp_modinv_fg_index.fg_for
fg_for =
match jet_secp_modinv_fg_prefix.fg_rest return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence s _ => s
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_modinv_fg_index.fg_loop
fg_loop =
match fg_for return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s => s
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_modinv_fg_index.fg_work
fg_work =
match fg_loop return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop s0 _ =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s => s
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_modinv_fg_index.fg_guard
fg_guard =
Clight.Ebinop Cop.Olt (Clight.Etempvar jets_secp._i Ctypesdefs.tint) (Clight.Etempvar jets_secp._len Ctypesdefs.tint)
  Ctypesdefs.tint
     : Clight.expr
### C.jet_secp_modinv_fg_index.fg_step
fg_step =
Clight.Sset jets_secp._i
  (Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._i Ctypesdefs.tint)
     (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint)
     : Clight.statement
