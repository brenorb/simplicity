### C.jet_secp_root_suffix.root_candidate_suffix_source
root_candidate_suffix_source
     : @eq Clight.statement jet_secp_root_chain_owned.root_after_chain
         (jet_secp_statement_prefix.statement_sequence root_candidate_statements jet_secp_root_check.root_final_check)
### C.jet_secp_root_suffix.exec_root_candidate_suffix
exec_root_candidate_suffix
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (ba br : Values.block)
         (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_root_chain_owned.root_locals_separated e) (_ : jet_secp_root_chain_owned.root_locals_owned e m)
         (_ : jet_secp_root_chain_owned.root_values_at e m
                (jet_secp_root_chain_owned.root_chain_final (jet_secp_root_prefix.root_initial_x2 w)
                   (jet_secp_root_prefix.root_initial_x3 w)))
         (_ : jet_secp_root_chain_owned.root_chain_frame e ba BinNums.Z0)
         (_ : jet_secp_root_chain_owned.root_chain_frame e br BinNums.Z0) (_ : not (@eq Values.block ba br))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_equal_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : jet_secp_root_chain_numeric.root_words_match w x)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  jet_secp_root_chain_owned.root_after_chain Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type
                           (Values.Vint
                              match jet_secp_root_check.root_check_flag w return Integers.Int.int with
                              | true => Integers.Int.one
                              | false => Integers.Int.zero
                              end) Ctypesdefs.tint))))
               (and (jet_secp_root_chain_owned.root_locals_owned e mf)
                  (and
                     (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_root_chain_numeric.root_chain_candidate w)))
                     (and
                        (Memory.Mem.range_perm mf ba BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf br BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable) (jet_sx_mem.lframe (root_suffix_frame e ba br) m mf)))))))
### C.jet_secp_root_suffix.root_precheck_sequence
root_precheck_sequence
     : forall last : Clight.statement,
       @eq Clight.statement (jet_secp_statement_prefix.statement_sequence root_precheck_statements last)
         (jet_secp_statement_prefix.statement_sequence jet_secp_root_prefix.root_start_statements
            (jet_secp_root_chain_owned.root_chain_body jet_secp_root_chain_owned.root_chain_steps last))
### C.jet_secp_root_suffix.exec_root_complete_body
exec_root_complete_body
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (ba br : Values.block)
         (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_root_chain_owned.root_locals_separated e) (_ : jet_secp_root_chain_owned.root_locals_owned e m)
         (_ : jet_secp_root_chain_owned.root_chain_frame e ba BinNums.Z0)
         (_ : jet_secp_root_chain_owned.root_chain_frame e br BinNums.Z0) (_ : not (@eq Values.block ba br))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_equal_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : jet_secp_root_chain_numeric.root_words_match w x)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (Clight.fn_body jets_secp.f_secp256k1_fe_sqrt_var) Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type
                           (Values.Vint
                              match jet_secp_root_check.root_check_flag w return Integers.Int.int with
                              | true => Integers.Int.one
                              | false => Integers.Int.zero
                              end) Ctypesdefs.tint))))
               (and (jet_secp_root_chain_owned.root_locals_owned e mf)
                  (and
                     (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_root_chain_numeric.root_chain_candidate w)))
                     (and
                        (Memory.Mem.range_perm mf ba BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf br BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable) (jet_sx_mem.lframe (root_suffix_frame e ba br) m mf)))))))
### C.jet_secp_root_suffix.root_result_argument
root_result_argument =
Clight.Etempvar jets_secp._r (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type)
     : Clight.expr
### C.jet_secp_root_suffix.root_candidate_statements
root_candidate_statements =
@cons Clight.statement
  (jet_secp_root_square_loop.root_square_for jets_secp._t1 (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))
  (@cons Clight.statement
     (jet_secp_root_call_state.root_multiply_stmt jets_secp._t1
        (jet_secp_curve_statements.curve_local_address jets_secp._x2))
     (@cons Clight.statement (jet_secp_root_square_loop.root_square_call jets_secp._t1)
        (@cons Clight.statement (jet_secp_root_candidate_state.root_square_out_stmt root_result_argument jets_secp._t1)
           (@cons Clight.statement (jet_secp_root_call_state.root_square_stmt jets_secp._t1 root_result_argument)
              (@nil Clight.statement)))))
     : list Clight.statement
### C.jet_secp_root_suffix.root_suffix_frame
root_suffix_frame =
fun (e : Clight.env) (ba br b : Values.block) (pos : BinNums.Z) =>
and (jet_secp_root_chain_owned.root_chain_frame e b pos)
  (and (not (@eq Values.block b ba)) (not (@eq Values.block b br)))
     : forall (_ : Clight.env) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments root_suffix_frame e ba br b pos%Z_scope
### C.jet_secp_root_suffix.root_chain_statements
root_chain_statements =
@List.flat_map (prod (prod (prod nat AST.ident) AST.ident) AST.ident) Clight.statement
  (fun pat : prod (prod (prod nat AST.ident) AST.ident) AST.ident =>
   match pat return (list Clight.statement) with
   | pair y r =>
       match y return (list Clight.statement) with
       | pair y0 s =>
           match y0 return (list Clight.statement) with
           | pair n d =>
               @cons Clight.statement (jet_secp_root_stage.root_stage_copy d s)
                 (@cons Clight.statement (jet_secp_root_square_loop.root_square_for d (BinInt.Z.of_nat n))
                    (@cons Clight.statement (jet_secp_root_stage.root_stage_mul d r) (@nil Clight.statement)))
           end
       end
   end) jet_secp_root_chain_owned.root_chain_steps
     : list Clight.statement
### C.jet_secp_root_suffix.root_precheck_statements
root_precheck_statements =
@app Clight.statement jet_secp_root_prefix.root_start_statements root_chain_statements
     : list Clight.statement
