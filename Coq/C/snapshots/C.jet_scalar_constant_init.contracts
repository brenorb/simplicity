### C.jet_scalar_constant_init.scalar_constant_initializes_at
scalar_constant_initializes_at
     : forall (p : Clight.program) (gv : AST.globvar Ctypes.type) (b : Values.block) (words : list Integers.Int64.int)
         (m : Memory.Mem.mem)
         (_ : @eq (option (AST.globvar Ctypes.type))
                (@Globalenvs.Genv.find_var_info (Ctypes.fundef Clight.function) Ctypes.type
                   (@Globalenvs.Genv.globalenv (Ctypes.fundef Clight.function) Ctypes.type
                      (@Ctypes.program_of_program Clight.function p)) b) (@Some (AST.globvar Ctypes.type) gv))
         (_ : @eq nat (@length Integers.Int64.int words) (S (S (S (S O)))))
         (_ : @eq (list AST.init_data) (@AST.gvar_init Ctypes.type gv)
                (@List.map Integers.Int64.int AST.init_data AST.Init_int64 words))
         (_ : @eq bool (@AST.gvar_readonly Ctypes.type gv) true)
         (_ : @eq bool (@AST.gvar_volatile Ctypes.type gv) false)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function p)) (@Some Memory.Mem.mem m)),
       jet_secp_scalar_constant.scalar_constant_state b words m
