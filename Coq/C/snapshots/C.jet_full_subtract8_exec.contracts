### C.jet_full_subtract8_exec.full_subtract8_diff_expr
full_subtract8_diff_expr =
Clight.Ebinop Cop.Osub
  (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
     (Clight.Etempvar jets._x Ctypesdefs.tuchar) Ctypesdefs.tuint) (Clight.Etempvar jets._y Ctypesdefs.tuchar)
  Ctypesdefs.tuint
     : Clight.expr
### C.jet_full_subtract8_exec.full_subtract8_first_borrow_expr
full_subtract8_first_borrow_expr =
Clight.Ebinop Cop.Olt
  (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
     (Clight.Etempvar jets._x Ctypesdefs.tuchar) Ctypesdefs.tuint)
  (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
     (Clight.Etempvar jets._y Ctypesdefs.tuchar) Ctypesdefs.tuint) Ctypesdefs.tint
     : Clight.expr
### C.jet_full_subtract8_exec.full_subtract8_second_borrow_expr
full_subtract8_second_borrow_expr =
Clight.Ebinop Cop.Olt full_subtract8_diff_expr
  (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
     (Clight.Etempvar jets._z Ctypesdefs.tbool) Ctypesdefs.tuint) Ctypesdefs.tint
     : Clight.expr
### C.jet_full_subtract8_exec.full_subtract8_payload_expr
full_subtract8_payload_expr =
Clight.Ecast
  (Clight.Ebinop Cop.Osub full_subtract8_diff_expr (Clight.Etempvar jets._z Ctypesdefs.tbool) Ctypesdefs.tuint)
  Ctypesdefs.tuchar
     : Clight.expr
### C.jet_full_subtract8_exec.full_subtract8_choose
full_subtract8_choose =
Clight.Sifthenelse full_subtract8_first_borrow_expr
  (Clight.Sset jets._t'4 (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))
  (Clight.Sset jets._t'4 (Clight.Ecast full_subtract8_second_borrow_expr Ctypesdefs.tbool))
     : Clight.statement
