### C.jet_elements_wrapper.elements_wrapper_layout
elements_wrapper_layout
     : forall (f : Clight.function) (rest : Clight.statement) (cells : list BitMachine.Cell)
         (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bw : Values.block) (edge cursor count : BinNums.Z) (bytes : list Memdata.memval)
         (_ : elements_wrapper_shape f rest) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes)) (_ : BinInt.Z.lt BinNums.Z0 count)
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cursor count)
         (_ : elements_wrapper_mid f rest cells env m bd dbase bs sbase bw edge cursor count bytes),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m (@Ctypes.Internal Clight.function f)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and (jet_encoding.frame_output_cells_at mf bw edge cursor cells)
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and (jet_frame_layout.frame_fields_at mf bd dbase bw edge (BinInt.Z.sub cursor count))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add edge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor count)
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_elements_wrapper.elements_wrapper_layout_simple
elements_wrapper_layout_simple
     : forall (f : Clight.function) (mid : Clight.statement) (cells : list BitMachine.Cell)
         (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bw : Values.block) (edge cursor count : BinNums.Z) (bytes : list Memdata.memval)
         (_ : elements_wrapper_shape f (elements_simple_rest mid)) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes)) (_ : BinInt.Z.lt BinNums.Z0 count)
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cursor count)
         (_ : forall (ma : Memory.Mem.mem') (mc : Memory.Mem.mem) (bl : Values.block)
                (_ : @eq (prod Memory.Mem.mem' Values.block)
                       (Memory.Mem.alloc m BinNums.Z0
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                       (@pair Memory.Mem.mem' Values.block ma bl))
                (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes)
                       (@Some Memory.Mem.mem mc))
                (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                       (v : Values.val)
                       (_ : @eq (option Values.val) (Memory.Mem.load chunk m b ofs) (@Some Values.val v)),
                     @eq (option Values.val) (Memory.Mem.load chunk mc b ofs) (@Some Values.val v))
                (_ : forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                       (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mc b ofs kind p)
                (_ : jet_output_layout.write_frame_at mc bd dbase bw edge cursor count),
              @ex Clight.temp_env
                (fun le1 : Clight.temp_env =>
                 @ex Memory.Mem.mem
                   (fun me : Memory.Mem.mem =>
                    and
                      (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
                         (jet_elements_version_exec.elements_version_locals bl)
                         (elements_wrapper_temps f env bd dbase bs sbase) mc mid Events.E0 le1 me
                         ClightBigstep.Out_normal)
                      (and (jet_encoding.frame_output_cells_at me bw edge cursor cells)
                         (and (jet_output_layout.write_prefix_at mc me bw edge cursor)
                            (and (jet_frame_layout.frame_fields_at me bd dbase bw edge (BinInt.Z.sub cursor count))
                               (and
                                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                     (_ : not (@eq Values.block b bl))
                                     (_ : or (not (@eq Values.block b bd))
                                            (or
                                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                  (BinInt.Z.add dbase
                                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                               (BinInt.Z.le
                                                  (BinInt.Z.add dbase
                                                     (BinNums.Zpos
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                  ofs)))
                                     (_ : or (not (@eq Values.block b bw))
                                            (or
                                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                  (BinInt.Z.add edge
                                                     (BinInt.Z.mul
                                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                                        (BinInt.Z.div (BinInt.Z.sub cursor count)
                                                           (BinNums.Zpos
                                                              (BinNums.xO
                                                                 (BinNums.xO
                                                                    (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))
                                               (BinInt.Z.le
                                                  (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                                  ofs))),
                                   @eq (option Values.val) (Memory.Mem.load chunk me b ofs)
                                     (Memory.Mem.load chunk mc b ofs))
                                  (and
                                     (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                        (p : Memtype.permission) (_ : Memory.Mem.perm mc b ofs kind p),
                                      Memory.Mem.perm me b ofs kind p)
                                     (forall (b : Values.block) (_ : Memory.Mem.valid_block mc b),
                                      Memory.Mem.valid_block me b))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m (@Ctypes.Internal Clight.function f)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and (jet_encoding.frame_output_cells_at mf bw edge cursor cells)
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and (jet_frame_layout.frame_fields_at mf bd dbase bw edge (BinInt.Z.sub cursor count))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add edge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor count)
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_elements_wrapper.elements_copy_stmt
elements_copy_stmt =
Clight.Sassign (Clight.Evar jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
  (Clight.Etempvar jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
     : Clight.statement
### C.jet_elements_wrapper.elements_simple_rest
elements_simple_rest =
fun mid : Clight.statement =>
Clight.Ssequence mid
  (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)))
     : forall _ : Clight.statement, Clight.statement

Arguments elements_simple_rest mid
### C.jet_elements_wrapper.elements_wrapper_body
elements_wrapper_body =
fun rest : Clight.statement => Clight.Ssequence elements_copy_stmt rest
     : forall _ : Clight.statement, Clight.statement

Arguments elements_wrapper_body rest
### C.jet_elements_wrapper.elements_returned_one
elements_returned_one =
ClightBigstep.Out_return
  (@Some (prod Values.val Ctypes.type) (@pair Values.val Ctypes.type (Values.Vint Integers.Int.one) Ctypesdefs.tint))
     : ClightBigstep.outcome
### C.jet_elements_wrapper.elements_wrapper_params
elements_wrapper_params =
@cons (prod AST.ident Ctypes.type)
  (@pair AST.ident Ctypes.type jets_elements._dst
     (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
  (@cons (prod AST.ident Ctypes.type)
     (@pair AST.ident Ctypes.type jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
     (@cons (prod AST.ident Ctypes.type)
        (@pair AST.ident Ctypes.type jets_elements._env
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr))) (@nil (prod AST.ident Ctypes.type))))
     : list (prod AST.ident Ctypes.type)
### C.jet_elements_wrapper.elements_wrapper_temps
elements_wrapper_temps =
fun (f : Clight.function) (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
  (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_elements._env env
  (@Maps.PTree.set Values.val jets_elements._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_elements._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps f))))
     : forall (_ : Clight.function) (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block)
         (_ : BinNums.Z), Clight.temp_env

Arguments elements_wrapper_temps f env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_elements_wrapper.elements_wrapper_shape
elements_wrapper_shape =
fun (f : Clight.function) (rest : Clight.statement) =>
and (@eq Ctypes.type (Clight.fn_return f) Ctypesdefs.tbool)
  (and
     (@eq (list (prod AST.ident Ctypes.type)) (Clight.fn_vars f)
        (@cons (prod AST.ident Ctypes.type)
           (@pair AST.ident Ctypes.type jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
           (@nil (prod AST.ident Ctypes.type))))
     (and (@eq (list (prod AST.ident Ctypes.type)) (Clight.fn_params f) elements_wrapper_params)
        (and (@eq Clight.statement (Clight.fn_body f) (elements_wrapper_body rest))
           (@Coqlib.list_disjoint AST.ident
              (@cons AST.ident jets_elements._dst
                 (@cons AST.ident jets_elements._src (@cons AST.ident jets_elements._env (@nil AST.ident))))
              (@List.map (prod AST.ident Ctypes.type) AST.ident (@fst AST.ident Ctypes.type) (Clight.fn_temps f))))))
     : forall (_ : Clight.function) (_ : Clight.statement), Prop

Arguments elements_wrapper_shape f rest
### C.jet_elements_wrapper.elements_wrapper_mid
elements_wrapper_mid =
fun (f : Clight.function) (rest : Clight.statement) (cells : list BitMachine.Cell) (env : Values.val)
  (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
  (bw : Values.block) (edge cursor count : BinNums.Z) (bytes : list Memdata.memval) =>
forall (ma : Memory.Mem.mem') (mc : Memory.Mem.mem) (bl : Values.block)
  (_ : @eq (prod Memory.Mem.mem' Values.block)
         (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (@pair Memory.Mem.mem' Values.block ma bl))
  (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
  (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (v : Values.val)
         (_ : @eq (option Values.val) (Memory.Mem.load chunk m b ofs) (@Some Values.val v)),
       @eq (option Values.val) (Memory.Mem.load chunk mc b ofs) (@Some Values.val v))
  (_ : forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
         (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mc b ofs kind p)
  (_ : jet_output_layout.write_frame_at mc bd dbase bw edge cursor count),
@ex Clight.temp_env
  (fun le1 : Clight.temp_env =>
   @ex Memory.Mem.mem
     (fun me : Memory.Mem.mem =>
      and
        (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
           (jet_elements_version_exec.elements_version_locals bl) (elements_wrapper_temps f env bd dbase bs sbase) mc
           rest Events.E0 le1 me elements_returned_one)
        (and (jet_encoding.frame_output_cells_at me bw edge cursor cells)
           (and (jet_output_layout.write_prefix_at mc me bw edge cursor)
              (and (jet_frame_layout.frame_fields_at me bd dbase bw edge (BinInt.Z.sub cursor count))
                 (and
                    (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                       (_ : not (@eq Values.block b bl))
                       (_ : or (not (@eq Values.block b bd))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    ofs)))
                       (_ : or (not (@eq Values.block b bw))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add edge
                                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                          (BinInt.Z.div (BinInt.Z.sub cursor count)
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                     @eq (option Values.val) (Memory.Mem.load chunk me b ofs) (Memory.Mem.load chunk mc b ofs))
                    (and
                       (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                          (p : Memtype.permission) (_ : Memory.Mem.perm mc b ofs kind p),
                        Memory.Mem.perm me b ofs kind p)
                       (forall (b : Values.block) (_ : Memory.Mem.valid_block mc b), Memory.Mem.valid_block me b))))))))
     : forall (_ : Clight.function) (_ : Clight.statement) (_ : list BitMachine.Cell) (_ : Values.val)
         (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : list Memdata.memval), Prop

Arguments elements_wrapper_mid f rest cells%list_scope env m bd dbase%Z_scope bs sbase%Z_scope
  bw (edge cursor count)%Z_scope bytes%list_scope
