            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_elements_wrapper.frame_output_cells_load_preserved
frame_output_cells_load_preserved
     : forall (m mf : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (cells : list BitMachine.Cell)
