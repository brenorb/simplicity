### C.jet_secp_point_mul_storage.point_mul_valuation_first
point_mul_valuation_first
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int) (jet_secp_multiply_normalize_bridge.words5 (point_mul_valuation a b))
         (jet_secp_multiply_normalize_bridge.words5 a)
### C.jet_secp_point_mul_storage.point_mul_valuation_second
point_mul_valuation_second
     : forall a b : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int)
         (jet_secp_field_add_initial.field_values (point_mul_valuation a b) (S (S (S (S (S O))))))
         (jet_secp_multiply_normalize_bridge.words5 b)
### C.jet_secp_point_mul_storage.point_mul_output_den
point_mul_output_den
     : forall (a b : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout),
       @eq (list Values.val)
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den (point_mul_valuation a b) (jet_sx_state.lay beta))
            jet_secp_point_mul_run.point_mul_out)
         (@List.map Integers.Int64.int Values.val Values.Vlong
            (jet_secp_multiply_normalize_bridge.words5 (point_mul_words a b)))
### C.jet_secp_point_mul_storage.owned_field_slice_region
owned_field_slice_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat) (ofs size : BinNums.Z) (_ : @eq BinNums.Z (jet_sx_state.bas beta r) BinNums.Z0)
         (_ : BinInt.Z.lt BinNums.Z0 size)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : jet_secp_fe_nv.fe_at m (jet_sx_state.blk beta r) ofs (jet_secp_multiply_normalize_bridge.words5 rho))
         (_ : Memory.Mem.range_perm m (jet_sx_state.blk beta r) BinNums.Z0 size Memtype.Cur Memtype.Freeable),
       jet_sx_state.region_ok rho beta m r
         (jet_sx_state.mkreg (jet_sx_rep.u64_cells ofs (jet_secp_fe_nv.vars5 O)) true (@Some BinNums.Z size))
### C.jet_secp_point_mul_storage.point_mul_initial_from_storage
point_mul_initial_from_storage
     : forall (k : jet_secp_point_write_run.point_coordinate) (a b : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bp bs : Values.block) (_ : not (@eq Values.block bp bs))
         (_ : jet_secp_fe_nv.fe_at m bp (jet_secp_point_write_run.point_coordinate_offset k)
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep (point_mul_valuation a b)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) (jet_secp_point_mul_run.point_mul_regs k) m
### C.jet_secp_point_mul_storage.point_mul_result_fields
point_mul_result_fields
     : forall (k : jet_secp_point_write_run.point_coordinate) (a b : forall _ : nat, Integers.Int64.int)
         (m mf : Memory.Mem.mem) (bp bs : Values.block)
         (_ : jet_secp_fe_nv.fe_at m bp (jet_secp_point_write_run.point_coordinate_offset k)
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : jet_sx_state.rep (point_mul_valuation a b)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))) (jet_secp_point_mul_run.point_mul_out_regs k) mf),
       and
         (jet_secp_fe_nv.fe_at mf bp (jet_secp_point_write_run.point_coordinate_offset k)
            (jet_secp_multiply_normalize_bridge.words5 (point_mul_words a b)))
         (and
            (Memory.Mem.range_perm mf bp BinNums.Z0
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
               Memtype.Cur Memtype.Freeable)
            (and (jet_secp_fe_nv.fe_at mf bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
               (Memory.Mem.range_perm mf bs BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)))
### C.jet_secp_point_mul_storage.eval_point_mul_from_storage
eval_point_mul_from_storage
     : forall (k : jet_secp_point_write_run.point_coordinate) (a b : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bp bs : Values.block) (_ : not (@eq Values.block bp bs))
         (_ : jet_secp_fe_nv.fe_at m bp (jet_secp_point_write_run.point_coordinate_offset k)
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val
                  (Values.Vptr bp (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                  (@cons Values.val
                     (Values.Vptr bp (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                     (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bp (jet_secp_point_write_run.point_coordinate_offset k)
                  (jet_secp_multiply_normalize_bridge.words5 (point_mul_words a b)))
               (and
                  (Memory.Mem.range_perm mf bp BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (and (jet_secp_fe_nv.fe_at mf bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
                     (and
                        (Memory.Mem.range_perm mf bs BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe
                           (fun (bx : Values.block) (pos : BinNums.Z) =>
                            not
                              (jet_sx_state.foot
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))))
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape (jet_secp_point_mul_run.point_mul_regs k)) bx pos)) m mf))))))
### C.jet_secp_point_mul_storage.point_mul_valuation
point_mul_valuation =
fun a b : forall _ : nat, Integers.Int64.int =>
jet_secp_field_mul_word_model.fm_rho (a O) (a (S O)) (a (S (S O))) (a (S (S (S O)))) (a (S (S (S (S O)))))
  (b O) (b (S O)) (b (S (S O))) (b (S (S (S O)))) (b (S (S (S (S O)))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments point_mul_valuation (a b)%function_scope n%nat_scope
### C.jet_secp_point_mul_storage.point_mul_words
point_mul_words =
fun (a b : forall _ : nat, Integers.Int64.int) (i : nat) =>
@List.nth Integers.Int64.int i
  (@cons Integers.Int64.int
     (jet_secp_field_mul_word_model.fm_t0 (a O) (a (S O)) (a (S (S O))) (a (S (S (S O)))) (a (S (S (S (S O)))))
        (b O) (b (S O)) (b (S (S O))) (b (S (S (S O)))) (b (S (S (S (S O))))))
     (@cons Integers.Int64.int
        (jet_secp_field_mul_word_model.fm_t1 (a O) (a (S O)) (a (S (S O))) (a (S (S (S O))))
           (a (S (S (S (S O))))) (b O) (b (S O)) (b (S (S O))) (b (S (S (S O)))) (b (S (S (S (S O))))))
        (@cons Integers.Int64.int
           (jet_secp_field_mul_word_model.fm_t2 (a O) (a (S O)) (a (S (S O))) (a (S (S (S O))))
              (a (S (S (S (S O))))) (b O) (b (S O)) (b (S (S O))) (b (S (S (S O)))) (b (S (S (S (S O))))))
           (@cons Integers.Int64.int
              (jet_secp_field_mul_word_model.fm_t3 (a O) (a (S O)) (a (S (S O))) (a (S (S (S O))))
                 (a (S (S (S (S O))))) (b O) (b (S O)) (b (S (S O))) (b (S (S (S O)))) (b (S (S (S (S O))))))
              (@cons Integers.Int64.int
                 (jet_secp_field_mul_word_model.fm_t4 (a O) (a (S O)) (a (S (S O))) (a (S (S (S O))))
                    (a (S (S (S (S O))))) (b O) (b (S O)) (b (S (S O))) (b (S (S (S O)))) (b (S (S (S (S O))))))
                 (@nil Integers.Int64.int)))))) Integers.Int64.zero
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments point_mul_words (a b)%function_scope i%nat_scope
