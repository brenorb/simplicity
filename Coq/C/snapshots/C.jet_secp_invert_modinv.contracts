### C.jet_secp_invert_modinv.eea_finished_inverse
eea_finished_inverse
     : forall (p z : BinNums.Z)
         (s : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z))
         (_ : BinInt.Z.lt (BinNums.Zpos BinNums.xH) p) (_ : jet_secp_eea_coefficients.eea_coefficients p z s)
         (_ : @eq BinNums.Z (jet_secp_eea_remainders.eea_remainder_gcd s) (BinNums.Zpos BinNums.xH))
         (_ : @eq bool (jet_secp_eea_fast.eea_finished s) true),
       and (and (BinInt.Z.le BinNums.Z0 (eea_selected_inverse p s)) (BinInt.Z.lt (eea_selected_inverse p s) p))
         (@eq BinNums.Z (BinInt.Z.modulo (BinInt.Z.mul (eea_selected_inverse p s) z) p) (BinNums.Zpos BinNums.xH))
### C.jet_secp_invert_modinv.eea_run_inverse
eea_run_inverse
     : forall (modulus : BinNums.Z) (bits : nat) (p z : BinNums.Z) (_ : BinInt.Z.lt (BinNums.Zpos BinNums.xH) p)
         (_ : and (BinInt.Z.lt BinNums.Z0 z) (BinInt.Z.lt z modulus)) (_ : BinInt.Z.lt p modulus)
         (_ : BinInt.Z.lt p (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat bits)))
         (_ : @eq BinNums.Z (BinInt.Z.gcd p z) (BinNums.Zpos BinNums.xH)),
       let result : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z) :=
         jet_secp_eea_numeric.eea_run_numeric modulus (Nat.mul (S (S O)) bits)
           (@pair (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)
              (@pair (prod BinNums.Z BinNums.Z) BinNums.Z
                 (@pair BinNums.Z BinNums.Z (BinNums.Zpos BinNums.xH) BinNums.Z0) p)
              (@pair (prod BinNums.Z BinNums.Z) BinNums.Z
                 (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH)) z)) in
       and
         (and (BinInt.Z.le BinNums.Z0 (eea_selected_inverse p result)) (BinInt.Z.lt (eea_selected_inverse p result) p))
         (@eq BinNums.Z (BinInt.Z.modulo (BinInt.Z.mul (eea_selected_inverse p result) z) p) (BinNums.Zpos BinNums.xH))
### C.jet_secp_invert_modinv.field_gcd_nonmultiple
field_gcd_nonmultiple
     : forall (z : BinNums.Z)
         (_ : and (BinInt.Z.lt BinNums.Z0 z)
                (BinInt.Z.lt z (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) jet_secp_fe_math.feP)))
         (_ : not (@eq BinNums.Z z jet_secp_fe_math.feP)),
       @eq BinNums.Z (BinInt.Z.gcd jet_secp_fe_math.feP z) (BinNums.Zpos BinNums.xH)
### C.jet_secp_invert_modinv.literal_invert_numeric_inverse
literal_invert_numeric_inverse
     : forall (z : BinNums.Z)
         (_ : and (BinInt.Z.lt BinNums.Z0 z)
                (BinInt.Z.lt z
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : not (@eq BinNums.Z z jet_secp_fe_math.feP)),
       and
         (and (BinInt.Z.le BinNums.Z0 (jet_secp_invert_literal.literal_invert_numeric z))
            (BinInt.Z.lt (jet_secp_invert_literal.literal_invert_numeric z) jet_secp_fe_math.feP))
         (@eq BinNums.Z
            (BinInt.Z.modulo (BinInt.Z.mul (jet_secp_invert_literal.literal_invert_numeric z) z) jet_secp_fe_math.feP)
            (BinNums.Zpos BinNums.xH))
### C.jet_secp_invert_modinv.literal_invert_numeric_field_order
literal_invert_numeric_field_order
     : @eq BinNums.Z (jet_secp_invert_literal.literal_invert_numeric jet_secp_fe_math.feP) BinNums.Z0
### C.jet_secp_invert_modinv.literal_invert_numeric_modInv
literal_invert_numeric_modInv
     : forall (z : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 z)
                (BinInt.Z.lt z
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq BinNums.Z (jet_secp_invert_literal.literal_invert_numeric z) (modinv.modInv z jet_secp_fe_math.feP)
### C.jet_secp_invert_modinv.literal_fe_invert_modInv
literal_fe_invert_modInv
     : forall word : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem word)
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (modinv.modInv (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) word)
               jet_secp_fe_math.feP))
### C.jet_secp_invert_modinv.eea_selected_inverse
eea_selected_inverse =
fun (p : BinNums.Z) (s : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z))
=>
match jet_secp_eea_numeric.eea_bezout_numeric s return BinNums.Z with
| inl p0 => match p0 return BinNums.Z with
            | pair _ b => BinInt.Z.modulo (BinInt.Z.sub p b) p
            end
| inr p0 => match p0 return BinNums.Z with
            | pair _ e => e
            end
end
     : forall (_ : BinNums.Z)
         (_ : prod (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)), BinNums.Z

Arguments eea_selected_inverse p%Z_scope s
