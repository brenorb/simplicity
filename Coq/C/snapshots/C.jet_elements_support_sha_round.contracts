### C.jet_elements_support_sha_round.eval_sha_Round
eval_sha_Round
     : forall (m : Memory.Mem.mem) (a b c : Integers.Int.int) (bd : Values.block) (od : Integers.Ptrofs.int)
         (e f g : Integers.Int.int) (bh : Values.block) (oh : Integers.Ptrofs.int) (k d h : Integers.Int.int)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint32 m bd (Integers.Ptrofs.unsigned od))
                (@Some Values.val (Values.Vint d)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint32 m bh (Integers.Ptrofs.unsigned oh))
                (@Some Values.val (Values.Vint h)))
         (_ : Memory.Mem.valid_access m AST.Mint32 bd (Integers.Ptrofs.unsigned od) Memtype.Writable)
         (_ : Memory.Mem.valid_access m AST.Mint32 bh (Integers.Ptrofs.unsigned oh) Memtype.Writable),
       @ex Memory.Mem.mem
         (fun md : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m' : Memory.Mem.mem =>
             and
               (@eq (option Memory.Mem.mem)
                  (Memory.Mem.store AST.Mint32 m bd (Integers.Ptrofs.unsigned od)
                     (Values.Vint (Integers.Int.add d (c_T1 h e f g k)))) (@Some Memory.Mem.mem md))
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.store AST.Mint32 md bh (Integers.Ptrofs.unsigned oh)
                        (Values.Vint (Integers.Int.add (c_T1 h e f g k) (c_T2 a b c)))) (@Some Memory.Mem.mem m'))
                  (ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
                     (@Ctypes.Internal Clight.function jets_elements.f_Round)
                     (@cons Values.val (Values.Vint a)
                        (@cons Values.val (Values.Vint b)
                           (@cons Values.val (Values.Vint c)
                              (@cons Values.val (Values.Vptr bd od)
                                 (@cons Values.val (Values.Vint e)
                                    (@cons Values.val (Values.Vint f)
                                       (@cons Values.val (Values.Vint g)
                                          (@cons Values.val (Values.Vptr bh oh)
                                             (@cons Values.val (Values.Vint k) (@nil Values.val)))))))))) Events.E0 m'
                     Values.Vundef))))
### C.jet_elements_support_sha_round.c_T1
c_T1 =
fun h e f g k : Integers.Int.int =>
Integers.Int.add
  (Integers.Int.add (Integers.Int.add h (jet_elements_support_sha_linkage.c_Sigma1 e))
     (jet_elements_support_sha_linkage.c_Ch e f g)) k
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int)
         (_ : Integers.Int.int), Integers.Int.int

Arguments c_T1 h e f g k
### C.jet_elements_support_sha_round.c_T2
c_T2 =
fun a b c : Integers.Int.int =>
Integers.Int.add (jet_elements_support_sha_linkage.c_Sigma0 a) (jet_elements_support_sha_linkage.c_Maj a b c)
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments c_T2 a b c
### C.jet_elements_support_sha_round.round_le
round_le =
fun (a b c : Integers.Int.int) (bd : Values.block) (od : Integers.Ptrofs.int) (e f g : Integers.Int.int)
  (bh : Values.block) (oh : Integers.Ptrofs.int) (k : Integers.Int.int) =>
@Maps.PTree.set Values.val jets_elements._k (Values.Vint k)
  (@Maps.PTree.set Values.val jets_elements._h (Values.Vptr bh oh)
     (@Maps.PTree.set Values.val jets_elements._g (Values.Vint g)
        (@Maps.PTree.set Values.val jets_elements._f (Values.Vint f)
           (@Maps.PTree.set Values.val jets_elements._e (Values.Vint e)
              (@Maps.PTree.set Values.val jets_elements._d (Values.Vptr bd od)
                 (@Maps.PTree.set Values.val jets_elements._c (Values.Vint c)
                    (@Maps.PTree.set Values.val jets_elements._b (Values.Vint b)
                       (@Maps.PTree.set Values.val jets_elements._a (Values.Vint a)
                          (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_Round))))))))))
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int)
         (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Int.int), Clight.temp_env

Arguments round_le a b c bd od e f g bh oh k
