### C.jet_secp_reduce512_first_run.reduce512_first_source
reduce512_first_source
     : @eq Clight.statement (jet_secp_statement_prefix.statement_sequence reduce512_first_spine reduce512_first_suffix)
         (Clight.fn_body jets_secp.f_secp256k1_scalar_reduce_512)
### C.jet_secp_reduce512_first_run.reduce512_first_boundary
reduce512_first_boundary
     : and
         (@eq bool (statement_ends_set jets_secp._m6 (@List.last Clight.statement reduce512_first_spine Clight.Sskip))
            true)
         (and (lt O reduce512_first_count) (lt reduce512_first_count (@length Clight.statement reduce512_spine)))
### C.jet_secp_reduce512_first_run.reduce512_first_completes
reduce512_first_completes
     : @eq bool
         match reduce512_first_run return bool with
         | Some r =>
             match r return bool with
             | jet_sx_exec.RDone _ o =>
                 match o return bool with
                 | jet_sx_exec.ONormal => true
                 | jet_sx_exec.OBreak => false
                 | jet_sx_exec.OContinue => false
                 | jet_sx_exec.OReturn _ => false
                 end
             | jet_sx_exec.RIf _ _ _ => false
             end
         | None => false
         end true
### C.jet_secp_reduce512_first_run.reduce512_first_run_eq
reduce512_first_run_eq
     : @eq (option jet_sx_exec.res) reduce512_first_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone reduce512_first_state jet_sx_exec.ONormal))
### C.jet_secp_reduce512_first_run.reduce512_first_temps_present
reduce512_first_temps_present
     : @eq bool
         (@List.forallb BinNums.positive
            (fun id : BinNums.positive =>
             match @Maps.PTree.get jet_sx_expr.sx id (jet_sx_eval.stemps reduce512_first_state) return bool with
             | Some _ => true
             | None => false
             end)
            (@cons AST.ident jets_secp._m0
               (@cons AST.ident jets_secp._m1
                  (@cons AST.ident jets_secp._m2
                     (@cons AST.ident jets_secp._m3
                        (@cons AST.ident jets_secp._m4
                           (@cons AST.ident jets_secp._m5 (@cons AST.ident jets_secp._m6 (@nil AST.ident))))))))) true
### C.jet_secp_reduce512_first_run.reduce512_first_limb_kinds
reduce512_first_limb_kinds
     : @eq bool (@List.forallb jet_sx_expr.sx (jet_sx_expr.isk jet_sx_expr.KL) reduce512_first_limbs) true
### C.jet_secp_reduce512_first_run.statement_ends_set
statement_ends_set =
fix statement_ends_set (id : AST.ident) (s : Clight.statement) {struct s} : bool :=
  match s return bool with
  | Clight.Sskip => false
  | Clight.Sassign _ _ => false
  | Clight.Sset x _ => BinPos.Pos.eqb x id
  | Clight.Scall _ _ _ => false
  | Clight.Sbuiltin _ _ _ _ => false
  | Clight.Ssequence _ tail => statement_ends_set id tail
  | Clight.Sifthenelse _ _ _ => false
  | Clight.Sloop _ _ => false
  | Clight.Sbreak => false
  | Clight.Scontinue => false
  | Clight.Sreturn _ => false
  | Clight.Sswitch _ _ => false
  | Clight.Slabel _ _ => false
  | Clight.Sgoto _ => false
  end
     : forall (_ : AST.ident) (_ : Clight.statement), bool

Arguments statement_ends_set id s
### C.jet_secp_reduce512_first_run.spine_cut_after
spine_cut_after =
fix spine_cut_after (id : AST.ident) (ss : list Clight.statement) {struct ss} : nat :=
  match ss return nat with
  | nil => O
  | cons h t => match statement_ends_set id h return nat with
                | true => S O
                | false => S (spine_cut_after id t)
                end
  end
     : forall (_ : AST.ident) (_ : list Clight.statement), nat

Arguments spine_cut_after id ss%list_scope
### C.jet_secp_reduce512_first_run.reduce512_spine
reduce512_spine =
@fst (list Clight.statement) Clight.statement
  (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_scalar_reduce_512))
     : list Clight.statement
### C.jet_secp_reduce512_first_run.reduce512_last
reduce512_last =
@snd (list Clight.statement) Clight.statement
  (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_scalar_reduce_512))
     : Clight.statement
### C.jet_secp_reduce512_first_run.reduce512_first_count
reduce512_first_count = spine_cut_after jets_secp._m6 reduce512_spine
     : nat
### C.jet_secp_reduce512_first_run.reduce512_first_spine
reduce512_first_spine = @List.firstn Clight.statement reduce512_first_count reduce512_spine
     : list Clight.statement
### C.jet_secp_reduce512_first_run.reduce512_first_prefix
reduce512_first_prefix =
jet_secp_statement_prefix.statement_sequence reduce512_first_spine Clight.Sskip
     : Clight.statement
### C.jet_secp_reduce512_first_run.reduce512_first_suffix
reduce512_first_suffix =
jet_secp_statement_prefix.statement_sequence (@List.skipn Clight.statement reduce512_first_count reduce512_spine)
  reduce512_last
     : Clight.statement
### C.jet_secp_reduce512_first_run.reduce512_first_run
reduce512_first_run =
match
  jet_sx_mem.xalloc (jet_sx_mem.std_cells (Clight.genv_cenv jet_secp_linkage.secp_ge))
    (Clight.genv_cenv jet_secp_linkage.secp_ge) (Clight.fn_vars jets_secp.f_secp256k1_scalar_reduce_512)
    (S (S O)) return (option jet_sx_exec.res)
with
| Some p =>
    match p return (option jet_sx_exec.res) with
    | pair locals ve =>
        match
          jet_sx_mem.xbind (Clight.fn_params jets_secp.f_secp256k1_scalar_reduce_512)
            (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
               (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx)))
            (Maps.PTree.empty jet_sx_expr.sx) return (option jet_sx_exec.res)
        with
        | Some ts =>
            jet_sx_compact.compact_stmt (Clight.genv_cenv jet_secp_linkage.secp_ge)
              (@nil (prod AST.ident (prod nat Ctypes.type))) jet_secp_shift64_executor.secp_shift64_table
              (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))) ve
              (jet_sx_eval.mkst ts
                 (@app jet_sx_state.region jet_secp_scalar_reduce512_run.scalar_reduce512_initial_regs locals)
                 (@nil jet_sx_eval.event) (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))) reduce512_first_prefix
        | None => @None jet_sx_exec.res
        end
    end
| None => @None jet_sx_exec.res
end
     : option jet_sx_exec.res
### C.jet_secp_reduce512_first_run.reduce512_first_state
reduce512_first_state =
match reduce512_first_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_reduce512_first_run.reduce512_first_temp
reduce512_first_temp =
fun id : AST.ident =>
match @Maps.PTree.get jet_sx_expr.sx id (jet_sx_eval.stemps reduce512_first_state) return jet_sx_expr.sx with
| Some x => x
| None => jet_sx_expr.XV Values.Vundef
end
     : forall _ : AST.ident, jet_sx_expr.sx

Arguments reduce512_first_temp id
### C.jet_secp_reduce512_first_run.reduce512_first_limbs
reduce512_first_limbs =
@cons jet_sx_expr.sx (reduce512_first_temp jets_secp._m0)
  (@cons jet_sx_expr.sx (reduce512_first_temp jets_secp._m1)
     (@cons jet_sx_expr.sx (reduce512_first_temp jets_secp._m2)
        (@cons jet_sx_expr.sx (reduce512_first_temp jets_secp._m3)
           (@cons jet_sx_expr.sx (reduce512_first_temp jets_secp._m4)
              (@cons jet_sx_expr.sx (reduce512_first_temp jets_secp._m5)
                 (@cons jet_sx_expr.sx (jet_sx_expr.XI2L Ctypes.Unsigned (reduce512_first_temp jets_secp._m6))
                    (@nil jet_sx_expr.sx)))))))
     : list jet_sx_expr.sx
