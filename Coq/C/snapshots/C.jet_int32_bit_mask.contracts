### C.jet_int32_bit_mask.int32_single_bit_mask
int32_single_bit_mask
     : forall (r : Integers.Int.int) (k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.lt k
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq Integers.Int.int
         (Integers.Int.and r (Integers.Int.repr (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
         match Integers.Int.testbit r k return Integers.Int.int with
         | true => Integers.Int.repr (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
         | false => Integers.Int.zero
         end
### C.jet_int32_bit_mask.int32_single_bit_mask_nonzero
int32_single_bit_mask_nonzero
     : forall (r : Integers.Int.int) (k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.lt k
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq bool
         (negb
            (Integers.Int.eq
               (Integers.Int.and r (Integers.Int.repr (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
               Integers.Int.zero)) (Integers.Int.testbit r k)
