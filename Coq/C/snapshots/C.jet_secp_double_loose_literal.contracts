### C.jet_secp_double_loose_literal.double_loose_outputs_literal
double_loose_outputs_literal
     : forall (x y z : forall _ : nat, Integers.Int64.int)
         (ax ay az : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value x) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ax)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value y) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ay)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) az)
                   jet_secp_fe_math.feP)),
       let flag : Integers.Int.int :=
         jet_readBit_layout.bit_int (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem az)) in
       @eq
         (prod
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@pair
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (jet_secp_rescale_literal.rescale_field_output (jet_secp_double_var_owned.double_var_x_words flag x y))
               (jet_secp_rescale_literal.rescale_field_output (jet_secp_double_var_owned.double_var_y_words flag x y)))
            (jet_secp_rescale_literal.rescale_field_output (jet_secp_double_var_owned.double_var_z_words flag y z)))
         (@jet_secp_double_literal.literal_gej_double Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay) az))
### C.jet_secp_double_loose_literal.double_var_output_flag_consistent
double_var_output_flag_consistent
     : forall (flag : Integers.Int.int) (y z : forall _ : nat, Integers.Int64.int),
       @eq Integers.Int.int (jet_secp_double_var_owned.double_var_output_flag flag y z)
         (jet_readBit_layout.bit_int
            (Bit.toBool
               (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
                  (jet_secp_rescale_literal.rescale_field_output
                     (jet_secp_double_var_owned.double_var_z_words flag y z)))))
### C.jet_secp_double_loose_literal.eval_double_var_loose_literal
eval_double_var_loose_literal
     : forall (x y z : forall _ : nat, Integers.Int64.int)
         (ax ay az : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bp : Values.block) (_ : jet_secp_square_columns.square_input_bounds x)
         (_ : jet_secp_square_columns.square_input_bounds y) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value x) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ax)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value y) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ay)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) az)
                   jet_secp_fe_math.feP))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val
                   (Values.Vint
                      (jet_readBit_layout.bit_int
                         (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem az))))))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun ox : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun oy : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun oz : forall _ : nat, Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_double_var)
                        (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val)))) Events.E0 mf
                        Values.Vundef)
                     (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 ox))
                        (and
                           (jet_secp_fe_nv.fe_at mf bp
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 oy))
                           (and
                              (jet_secp_fe_nv.fe_at mf bp
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (jet_secp_multiply_normalize_bridge.words5 oz))
                              (and
                                 (@eq (option Values.val)
                                    (Memory.Mem.load AST.Mint32 mf bp
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                    (@Some Values.val
                                       (Values.Vint
                                          (jet_readBit_layout.bit_int
                                             (Bit.toBool
                                                (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
                                                   (jet_secp_rescale_literal.rescale_field_output oz)))))))
                                 (and
                                    (Memory.Mem.range_perm mf bp BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and (jet_secp_square_columns.square_input_bounds ox)
                                       (and (jet_secp_square_columns.square_input_bounds oy)
                                          (and (jet_secp_square_columns.square_input_bounds oz)
                                             (and
                                                (@eq
                                                   (prod
                                                      (prod (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...)))))))
                                                   (@pair
                                                      (prod (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (@pair (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...)))))
                                                         (jet_secp_rescale_literal.rescale_field_output ox)
                                                         (jet_secp_rescale_literal.rescale_field_output oy))
                                                      (jet_secp_rescale_literal.rescale_field_output oz))
                                                   (@jet_secp_double_literal.literal_gej_double Alg.CoreFunSem
                                                      (@pair
                                                         (prod (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...)))))
                                                         (@pair (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))) ax ay) az)))
                                                (jet_sx_mem.lframe
                                                   (fun (b : Values.block) (_ : BinNums.Z) =>
                                                    not (@eq Values.block b bp)) m mf))))))))))))))
