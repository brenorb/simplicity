### C.jet_left_rotate_wide_exec.wide_rotate_helper_symbol
wide_rotate_helper_symbol
     : forall s : jet_wide.wide_size,
       @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (wide_rotate_helper_id s)) (@Some Values.block (jet_exec.jet_symbol_block (wide_rotate_helper_id s)))
### C.jet_left_rotate_wide_exec.wide_rotate_helper_funct
wide_rotate_helper_funct
     : forall s : jet_wide.wide_size,
       @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block (wide_rotate_helper_id s)) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function)
            (@Ctypes.Internal Clight.function (jet_rotate_wide_helper.wide_rotate_helper s)))
### C.jet_left_rotate_wide_exec.exec_rotate_scalar_call
exec_rotate_scalar_call
     : forall (s : jet_wide.wide_size) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (r : Integers.Int64.int) (a : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a) (jet_wide.wide_bits s)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._input le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._amt le) (@Some Values.val (Values.Vint a))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (rotate_scalar_call s) Events.E0
         (@Maps.PTree.set Values.val jets._t'3 (Values.Vlong (jet_rotate_wide_helper.wide_rotate_result s r a)) le) m
         ClightBigstep.Out_normal
### C.jet_left_rotate_wide_exec.left_rotate_byte_body
left_rotate_byte_body
     : forall s : byte_rotate_size,
       @eq Clight.statement (Clight.fn_body (left_rotate_byte_function s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (jet_binary8_exec.binary8_read jets._t'1)
                  (Clight.Sset jets._amt
                     (jet_rotate_count_exec.wide_rotate_amount_expr (byte_rotate_width s)
                        (Clight.Etempvar jets._t'1 Ctypesdefs.tuchar))))
               (Clight.Ssequence
                  (Clight.Ssequence (jet_binary_wide_exec.wide_binary_read (byte_rotate_width s) jets._t'2)
                     (Clight.Sset jets._input (Clight.Etempvar jets._t'2 Ctypesdefs.tulong)))
                  (Clight.Ssequence
                     (Clight.Ssequence (rotate_scalar_call (byte_rotate_width s))
                        (jet_arith8_layout_exec.frame_writer_call (jet_wide.wide_writer_id (byte_rotate_width s))
                           Ctypesdefs.tulong Ctypesdefs.tvoid (Clight.Etempvar jets._t'3 Ctypesdefs.tulong)))
                     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))))
### C.jet_left_rotate_wide_exec.eval_left_rotate_byte_composes
eval_left_rotate_byte_composes
     : forall (env : Values.val) (s : byte_rotate_size) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (mc mr mr2 me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bytes : list Memdata.memval) (a : Integers.Int.int) (r : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader (byte_rotate_width s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer (byte_rotate_width s)))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (left_rotate_byte_payload s r a)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function (left_rotate_byte_function s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_left_rotate_wide_exec.byte_rotate_size
Inductive byte_rotate_size : Set :=  R32 : byte_rotate_size | R64 : byte_rotate_size.
### C.jet_left_rotate_wide_exec.byte_rotate_width
byte_rotate_width =
fun s : byte_rotate_size => match s return jet_wide.wide_size with
                            | R32 => jet_wide.W32
                            | R64 => jet_wide.W64
                            end
     : forall _ : byte_rotate_size, jet_wide.wide_size

Arguments byte_rotate_width s
### C.jet_left_rotate_wide_exec.left_rotate_byte_function
left_rotate_byte_function =
fun s : byte_rotate_size =>
match s return Clight.function with
| R32 => jets.f_simplicity_left_rotate_32
| R64 => jets.f_simplicity_left_rotate_64
end
     : forall _ : byte_rotate_size, Clight.function

Arguments left_rotate_byte_function s
### C.jet_left_rotate_wide_exec.wide_rotate_helper_id
wide_rotate_helper_id =
fun s : jet_wide.wide_size =>
match s return AST.ident with
| jet_wide.W16 => jets._rotate_16
| jet_wide.W32 => jets._rotate_32
| jet_wide.W64 => jets._rotate_64
end
     : forall _ : jet_wide.wide_size, AST.ident

Arguments wide_rotate_helper_id s
### C.jet_left_rotate_wide_exec.left_rotate_byte_payload
left_rotate_byte_payload =
fun (s : byte_rotate_size) (r : Integers.Int64.int) (a : Integers.Int.int) =>
jet_rotate_wide_helper.wide_rotate_result (byte_rotate_width s) r
  (jet_rotate_count_exec.wide_rotate_amount (byte_rotate_width s) a)
     : forall (_ : byte_rotate_size) (_ : Integers.Int64.int) (_ : Integers.Int.int), Integers.Int64.int

Arguments left_rotate_byte_payload s r a
### C.jet_left_rotate_wide_exec.rotate_scalar_call
rotate_scalar_call =
fun s : jet_wide.wide_size =>
Clight.Scall (@Some AST.ident jets._t'3)
  (Clight.Evar (wide_rotate_helper_id s)
     (Ctypes.Tfunction (Ctypes.Tcons Ctypesdefs.tulong (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tulong
        AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._input Ctypesdefs.tulong)
     (@cons Clight.expr (Clight.Etempvar jets._amt Ctypesdefs.tuchar) (@nil Clight.expr)))
     : forall _ : jet_wide.wide_size, Clight.statement

Arguments rotate_scalar_call s
