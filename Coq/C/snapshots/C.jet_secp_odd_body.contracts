### C.jet_secp_odd_body.secp_fe_odd_body
secp_fe_odd_body
     : @eq Clight.statement (Clight.fn_body jets_secp.f_simplicity_fe_is_odd)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_secp._src jet_secp_public_body.secp_frame_type)
               (Clight.Etempvar jets_secp._src jet_secp_public_body.secp_frame_type)) secp_fe_odd_rest)
### C.jet_secp_odd_body.secp_odd_helper_symbols
secp_odd_helper_symbols
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
               jets_secp._secp256k1_fe_is_odd)
            (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_fe_is_odd)))
         (and
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                  (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_fe_is_odd) Integers.Ptrofs.zero))
               (@Some (Ctypes.fundef Clight.function)
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd)))
            (and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                     jets_secp._writeBit) (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._writeBit)))
               (@eq (option Clight.fundef)
                  (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                     (Values.Vptr (jet_secp_linkage.secp_symbol_block jets_secp._writeBit) Integers.Ptrofs.zero))
                  (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_writeBit)))))
### C.jet_secp_odd_body.exec_secp_public_odd
exec_secp_public_odd
     : forall (le : Clight.temp_env) (m mf : Memory.Mem.mem) (bl ba : Values.block) (bit : bool)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_odd)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
                (Values.Vint (jet_readBit_layout.bit_int bit))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_public_copy.secp_public_env bl ba) le m
         secp_public_odd_stmt Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint (jet_readBit_layout.bit_int bit)) le) mf
         ClightBigstep.Out_normal
### C.jet_secp_odd_body.exec_secp_public_bit_write
exec_secp_public_bit_write
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bl ba bd : Values.block)
         (dbase : BinNums.Z) (bit : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t'1 le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets.f_writeBit)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vint (jet_readBit_layout.bit_int bit)) (@nil Values.val))) Events.E0 mf
                (Values.Vint (jet_readBit_layout.bit_int bit))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_public_copy.secp_public_env bl ba) le m
         secp_public_bit_write_stmt Events.E0 le mf ClightBigstep.Out_normal
