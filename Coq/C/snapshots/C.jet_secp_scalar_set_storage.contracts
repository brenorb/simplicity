### C.jet_secp_scalar_set_storage.scalar_set_storage_regions
scalar_set_storage_regions
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs jet_secp_scalar_set_b32_exec.scalar_set_state)
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg (jet_secp_fe_nv.cells0 jet_secp_scalar_set_b32_exec.scalar_set_state) true
               (@None BinNums.Z))
            (@cons jet_sx_state.region
               (jet_sx_state.mkreg
                  (jet_secp_fe_b32.byte_cells BinNums.Z0
                     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))) O) false
                  (@None BinNums.Z)) (@nil jet_sx_state.region)))
### C.jet_secp_scalar_set_storage.scalar_set_storage_loads
scalar_set_storage_loads
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout (jet_sx_eval.sregs jet_secp_scalar_set_b32_exec.scalar_set_state) m)
         (i : nat) (_ : lt i (S (S (S (S O))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk layout O)
            (BinInt.Z.add (jet_sx_state.bas layout O)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))
         (@Some Values.val (Values.Vlong (jet_secp_scalar_set_shape.scalar_set_limb rho (jet_sx_state.lay layout) i)))
### C.jet_secp_scalar_set_storage.scalar_set_storage_initial
scalar_set_storage_initial
     : forall (bytes : list BinNums.Z) (b bb : Values.block) (ofs : BinNums.Z) (m : Memory.Mem.mem)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun z : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 z)
                   (BinInt.Z.le z
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (_ : not (@eq Values.block b bb)) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Readable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bb (BinInt.Z.add ofs (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i bytes BinNums.Z0))))),
       jet_sx_state.rep (jet_secp_b32_exec.byte_rho bytes)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb ofs)
               (@nil (prod Values.block BinNums.Z)))) jet_secp_scalar_set_b32_exec.scalar_set_initial_regs m
### C.jet_secp_scalar_set_storage.scalar_set_storage_allowed
scalar_set_storage_allowed
     : jet_clight_internal_frame.allowed_call jet_secp_closed_helpers.secp_closed_helpers
         (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_set_b32)
### C.jet_secp_scalar_set_storage.scalar_set_storage_foot_outside
scalar_set_storage_foot_outside
     : forall (b bb : Values.block) (ofs : BinNums.Z) (block : Values.block) (pos : BinNums.Z)
         (_ : and (not (@eq Values.block block b)) (not (@eq Values.block block bb))),
       not
         (jet_sx_state.foot
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb ofs)
                  (@nil (prod Values.block BinNums.Z))))
            (@List.map jet_sx_state.region
               (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
               jet_secp_scalar_set_b32_exec.scalar_set_initial_regs) block pos)
### C.jet_secp_scalar_set_storage.eval_scalar_set_b32_storage
eval_scalar_set_b32_storage
     : forall (bytes : list BinNums.Z) (b bb : Values.block) (ofs : BinNums.Z) (m : Memory.Mem.mem)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun z : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 z)
                   (BinInt.Z.le z
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (_ : not (@eq Values.block b bb)) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Readable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bb (BinInt.Z.add ofs (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i bytes BinNums.Z0))))),
       let limbs : forall _ : nat, Integers.Int64.int :=
         jet_secp_scalar_set_shape.scalar_set_limb (jet_secp_b32_exec.byte_rho bytes)
           (jet_sx_state.lay
              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb ofs)
                    (@nil (prod Values.block BinNums.Z))))) in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_set_b32)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bb (Integers.Ptrofs.repr ofs))
                     (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf b
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                  (@Some Values.val (Values.Vlong (limbs i))))
               (and
                  (@eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value limbs)
                     (BinInt.Z.modulo (jet_secp_fe_math.be_val bytes) jet_secp_canonical_scalar.canonical_group_order))
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and
                        (jet_sx_mem.lframe
                           (fun (block : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block block b)) (not (@eq Values.block block bb))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
