### C.jet_write_buffer8_empty_exec.buffer8_actual_loop_shape
buffer8_actual_loop_shape
     : @eq Clight.statement buffer8_actual_loop
         (Clight.Sloop
            (Clight.Ssequence (Clight.Sifthenelse buffer8_guard_expr Clight.Sskip Clight.Sbreak)
               (Clight.Ssequence buffer8_tag_call
                  (Clight.Sifthenelse (Clight.Etempvar jets._t'2 Ctypesdefs.tbool) buffer8_present_branch
                     buffer8_skip_call)))
            (Clight.Sset jets._i
               (Clight.Ebinop Cop.Odiv (Clight.Etempvar jets._i Ctypesdefs.tulong)
                  (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))) Ctypesdefs.tint)
                  Ctypesdefs.tulong)))
### C.jet_write_buffer8_empty_exec.buffer8_writeBit_symbol
buffer8_writeBit_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._writeBit)
         (@Some Values.block (jet_exec.jet_symbol_block jets._writeBit))
### C.jet_write_buffer8_empty_exec.buffer8_writeBit_funct
buffer8_writeBit_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._writeBit) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_writeBit))
### C.jet_write_buffer8_empty_exec.buffer8_skipBits_symbol
buffer8_skipBits_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0) jets._skipBits)
         (@Some Values.block (jet_exec.jet_symbol_block jets._skipBits))
### C.jet_write_buffer8_empty_exec.buffer8_skipBits_funct
buffer8_skipBits_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_exec.ge0)
            (Values.Vptr (jet_exec.jet_symbol_block jets._skipBits) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_skipBits))
### C.jet_write_buffer8_empty_exec.eval_buffer8_guard
eval_buffer8_guard
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j)))),
       Clight.eval_expr jet_exec.ge0 e le m buffer8_guard_expr
         (Values.Vint
            match BinInt.Z.ltb BinNums.Z0 j return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
### C.jet_write_buffer8_empty_exec.exec_buffer8_disabled_assert
exec_buffer8_disabled_assert
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (assertion : Clight.statement),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m
         (Clight.Sloop
            (Clight.Sifthenelse
               (Clight.Eunop Cop.Onotbool (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint)
               assertion Clight.Sskip) Clight.Sbreak) Events.E0 le m ClightBigstep.Out_normal
### C.jet_write_buffer8_empty_exec.eval_buffer8_empty_tag
eval_buffer8_empty_tag
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : and (BinInt.Z.lt BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._len le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero))),
       Clight.eval_expr jet_exec.ge0 e le m buffer8_tag_expr (Values.Vint Integers.Int.zero)
### C.jet_write_buffer8_empty_exec.eval_buffer8_skip_expr
eval_buffer8_skip_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j)))),
       Clight.eval_expr jet_exec.ge0 e le m buffer8_skip_expr
         (Values.Vlong
            (Integers.Int64.repr (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) j)))
### C.jet_write_buffer8_empty_exec.exec_buffer8_empty_iteration
exec_buffer8_empty_iteration
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mb mf : Memory.Mem.mem) (bf : Values.block) (base j : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._writeBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets._skipBits e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._len le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.lt BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_writeBit)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vint Integers.Int.zero) (@nil Values.val))) Events.E0 mb
                (Values.Vint Integers.Int.zero))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb (@Ctypes.Internal Clight.function jets.f_skipBits)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) j)))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m (Clight.Ssequence buffer8_loop_body buffer8_loop_update)
         Events.E0
         (@Maps.PTree.set Values.val jets._i
            (Values.Vlong (Integers.Int64.repr (BinInt.Z.div j (BinNums.Zpos (BinNums.xO BinNums.xH)))))
            (@Maps.PTree.set Values.val jets._t'2 (Values.Vint Integers.Int.zero) le)) mf ClightBigstep.Out_normal
### C.jet_write_buffer8_empty_exec.exec_buffer8_empty_stop
exec_buffer8_empty_stop
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m buffer8_actual_loop Events.E0 le m ClightBigstep.Out_normal
### C.jet_write_buffer8_empty_exec.buffer8_actual_loop
buffer8_actual_loop =
match Clight.fn_body jets.f_simplicity_write_buffer8 return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ loop => loop
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_write_buffer8_empty_exec.buffer8_loop_body
buffer8_loop_body =
match buffer8_actual_loop return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop body _ => body
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_write_buffer8_empty_exec.buffer8_loop_update
buffer8_loop_update =
match buffer8_actual_loop return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ update => update
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_write_buffer8_empty_exec.buffer8_present_branch
buffer8_present_branch =
match buffer8_loop_body return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ _ => Clight.Sskip
        | Clight.Sifthenelse _ yes _ => yes
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_write_buffer8_empty_exec.buffer8_guard_expr
buffer8_guard_expr =
Clight.Ebinop Cop.Olt (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) (Clight.Etempvar jets._i Ctypesdefs.tulong)
  Ctypesdefs.tint
     : Clight.expr
### C.jet_write_buffer8_empty_exec.buffer8_tag_expr
buffer8_tag_expr =
Clight.Ebinop Cop.Ole (Clight.Etempvar jets._i Ctypesdefs.tulong) (Clight.Etempvar jets._len Ctypesdefs.tulong)
  Ctypesdefs.tint
     : Clight.expr
### C.jet_write_buffer8_empty_exec.buffer8_skip_expr
buffer8_skip_expr =
Clight.Ebinop Cop.Omul (Clight.Etempvar jets._i Ctypesdefs.tulong)
  (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     Ctypesdefs.tint) Ctypesdefs.tulong
     : Clight.expr
### C.jet_write_buffer8_empty_exec.buffer8_tag_call
buffer8_tag_call =
Clight.Scall (@Some AST.ident jets._t'2)
  (Clight.Evar jets._writeBit
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
     (@cons Clight.expr buffer8_tag_expr (@nil Clight.expr)))
     : Clight.statement
### C.jet_write_buffer8_empty_exec.buffer8_skip_call
buffer8_skip_call =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets._skipBits
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
     (@cons Clight.expr buffer8_skip_expr (@nil Clight.expr)))
     : Clight.statement
