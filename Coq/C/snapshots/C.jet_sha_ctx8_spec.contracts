### C.jet_sha_ctx8_spec.ctx8_add1_model
ctx8_add1_model =
fun (c : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (x : Ty.tySem (Word.Word (S (S (S O))))) =>
match c return (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)) with
| pair buf t =>
    match t return (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)) with
    | pair count h =>
        match
          @buffer_snoc_spec (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) Alg.CoreFunSem
            (@pair
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     ((fix buffer_type (X : Ty.Ty) (depth : nat) {struct depth} : Ty.Ty :=
                         match depth return Ty.Ty with
                         | O => Ty.Sum Ty.Unit X
                         | S d => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)
                         end) (Word.Word (S (S (S O)))) (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S O))))) buf x)
