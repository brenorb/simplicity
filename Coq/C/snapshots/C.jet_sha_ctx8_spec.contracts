ctx8_add_list =
fix ctx8_add_list
  (c : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (l : list (Ty.tySem (Word.Word (S (S (S O)))))) {struct l} :
    option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) :=
  match l return (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)) with
  | nil => @Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) c
  | cons x l0 =>
      match ctx8_add1_model c x return (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)) with
      | Some c' => ctx8_add_list c' l0
      | None => @None (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
      end
  end
     : forall (_ : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (_ : list (Ty.tySem (Word.Word (S (S (S O)))))),
       option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)

