### C.jet_sha_ctx8_spec.ctx8_addn_spec
ctx8_addn_spec =
fix ctx8_addn_spec (n : nat) (term : Alg.Assertion.Algebra) {struct n} :
    Alg.Assertion.domain term
      (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n))
      jet_sha256_ctx8_init_spec.sha256_ctx8_type :=
  match
    n as n0
    return
      (Alg.Assertion.domain term
         (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0))
         jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  with
  | O => @ctx8_add1_spec term
  | S n0 =>
      @jet_sha256_count_assertion.AC.comp
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)))
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0))
        jet_sha256_ctx8_init_spec.sha256_ctx8_type (Alg.Assertion.toCore term)
        (@jet_sha256_count_assertion.AC.pair
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
              (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)))
           jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0)
           (Alg.Assertion.toCore term)
           (@jet_sha256_count_assertion.AC.comp
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)))
              (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0))
              jet_sha256_ctx8_init_spec.sha256_ctx8_type (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.pair
                 (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)))
                 jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0)
                 (Alg.Assertion.toCore term)
                 (@jet_sha256_count_assertion.AC.take jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0))
                    jet_sha256_ctx8_init_spec.sha256_ctx8_type (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.iden jet_sha256_ctx8_init_spec.sha256_ctx8_type
                       (Alg.Assertion.toCore term)))
                 (@jet_sha256_count_assertion.AC.drop jet_sha256_ctx8_init_spec.sha256_ctx8_type
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0))
                    (Word.Vector (Word.Word (S (S (S O)))) n0) (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.take (Word.Vector (Word.Word (S (S (S O)))) n0)
                       (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)
                       (Alg.Assertion.toCore term)
                       (@jet_sha256_count_assertion.AC.iden (Word.Vector (Word.Word (S (S (S O)))) n0)
                          (Alg.Assertion.toCore term))))) (ctx8_addn_spec n0 term))
           (@jet_sha256_count_assertion.AC.drop jet_sha256_ctx8_init_spec.sha256_ctx8_type
              (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0))
              (Word.Vector (Word.Word (S (S (S O)))) n0) (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.drop (Word.Vector (Word.Word (S (S (S O)))) n0)
                 (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)
                 (Alg.Assertion.toCore term)
                 (@jet_sha256_count_assertion.AC.iden (Word.Vector (Word.Word (S (S (S O)))) n0)
                    (Alg.Assertion.toCore term))))) (ctx8_addn_spec n0 term)
  end
     : forall (n : nat) (term : Alg.Assertion.Algebra),
       Alg.Assertion.domain term
         (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n))
         jet_sha256_ctx8_init_spec.sha256_ctx8_type

