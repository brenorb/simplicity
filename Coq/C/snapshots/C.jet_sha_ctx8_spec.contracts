### C.jet_sha_ctx8_spec.buffer_list_empty
buffer_list_empty
     : forall (X : Ty.Ty) (depth : nat),
       @eq (list (Ty.tySem X)) (buffer_list X depth (jet_buffer_empty_spec.buffer_empty_value X depth))
         (@nil (Ty.tySem X))
### C.jet_sha_ctx8_spec.buffer_snoc_spec_parametric
buffer_snoc_spec_parametric
     : forall (X : Ty.Ty) (depth : nat),
       @Alg.Core.Parametric (Ty.Prod (jet_buffer_empty_spec.buffer_type X depth) X)
         (Ty.Sum (Word.Vector X (S depth)) (jet_buffer_empty_spec.buffer_type X depth)) (@buffer_snoc_spec X depth)
### C.jet_sha_ctx8_spec.buffer_snoc_value
buffer_snoc_value
     : forall (X : Ty.Ty) (depth : nat) (b : Ty.tySem (jet_buffer_empty_spec.buffer_type X depth)) (x : Ty.tySem X),
       match
         @buffer_snoc_spec X depth Alg.CoreFunSem
           (@pair (Ty.tySem (jet_buffer_empty_spec.buffer_type X depth)) (Ty.tySem X) b x)
         return Prop
       with
       | inl v =>
           @eq (list (Ty.tySem X)) (jet_buffer_input.vector_values X (S depth) v)
             (@app (Ty.tySem X) (buffer_list X depth b) (@cons (Ty.tySem X) x (@nil (Ty.tySem X))))
       | inr b' =>
           @eq (list (Ty.tySem X)) (buffer_list X depth b')
             (@app (Ty.tySem X) (buffer_list X depth b) (@cons (Ty.tySem X) x (@nil (Ty.tySem X))))
       end
### C.jet_sha_ctx8_spec.opt_core
@opt_core
     : forall (A B : Ty.Ty) (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg A B)
         (_ : @Alg.Core.Parametric A B t) (a : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem B))
         (t (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) a)
         (@Some (Ty.tySem B) (t Alg.CoreFunSem a))
### C.jet_sha_ctx8_spec.opt_comp
@opt_comp
     : forall (A B C : Ty.Ty) (s : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) A B)
         (t : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) B C) (a : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@jet_sha256_count_assertion.AC.comp A B C (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero))
            s t a)
         match s a return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C)) with
         | Some b => t b
         | None => @None (Ty.tySem C)
         end
### C.jet_sha_ctx8_spec.opt_pair
@opt_pair
     : forall (A B C : Ty.Ty) (s : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) A B)
         (t : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) A C) (a : Ty.tySem A),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod B C)))
         (@jet_sha256_count_assertion.AC.pair A B C (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero))
            s t a)
         match
           s a
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod B C)))
         with
         | Some b =>
             match
               t a
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod B C)))
             with
             | Some c => @Some (prod (Ty.tySem B) (Ty.tySem C)) (@pair (Ty.tySem B) (Ty.tySem C) b c)
             | None => @None (Ty.tySem (Ty.Prod B C))
             end
         | None => @None (Ty.tySem (Ty.Prod B C))
         end
### C.jet_sha_ctx8_spec.opt_case
@opt_case
     : forall (A B C D : Ty.Ty) (s : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) (Ty.Prod A C) D)
         (t : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) (Ty.Prod B C) D)
         (p : Ty.tySem (Ty.Prod (Ty.Sum A B) C)),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem D))
         (@jet_sha256_count_assertion.AC.case A B C D
            (Alg.Assertion.toCore (Alg.AssertionSem Option.option_Monad_Zero)) s t p)
         match
           @fst
             (sum
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) A)
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) B))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                 | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                 end) C) p
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem D))
         with
         | inl a =>
             s
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) A)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C) a
                  (@snd
                     (sum
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) A)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) B))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                         | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                         end) C) p))
         | inr b =>
             t
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) C) b
                  (@snd
                     (sum
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) A)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                            end) B))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                         | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                         end) C) p))
         end
