### C.jet_sha_ctx8_spec.opt_assertl_l
@opt_assertl_l
     : forall (A B C D : Ty.Ty) (s : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) (Ty.Prod A C) D)
         (h : Digest.hash256)
         (a : (fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                 | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                 end) A)
         (c : (fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                 | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                 end) C),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem D))
         (@Alg.Assertion.Combinators.assertl A B C D (Alg.AssertionSem Option.option_Monad_Zero) s h
            (@pair
               (sum
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) A)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) C)
               (@inl
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) A)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                      | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                      end) B) a) c))
         (s
            (@pair
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) A)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) C) a c))
### C.jet_sha_ctx8_spec.opt_assertl_r
@opt_assertl_r
     : forall (A B C D : Ty.Ty) (s : Alg.Assertion.domain (Alg.AssertionSem Option.option_Monad_Zero) (Ty.Prod A C) D)
         (h : Digest.hash256) (b : Ty.tySem B)
