### C.jet_sha_ctx8_spec.word64_range
word64_range
     : forall y : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))),
       and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) y))
         (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) y)
            (BinNums.Zpos
