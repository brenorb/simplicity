### C.jet_sha_ctx8_spec.ctx8_add1_option
ctx8_add1_option
     : forall
         (c : prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (S (S (S (S (S (S O))))))))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (x : prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (@ctx8_add1_spec (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                  (prod
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S O))))))))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
               (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))) c x))
         (ctx8_add1_model c x)
### C.jet_sha_ctx8_spec.ctx8_add1_full_parametric
ctx8_add1_full_parametric
     : @Alg.Assertion.Parametric (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) ctx8_tail)
         jet_sha256_ctx8_init_spec.sha256_ctx8_type (@ctx8_add1_full)
### C.jet_sha_ctx8_spec.ctx8_add1_spec_parametric
ctx8_add1_spec_parametric
     : @Alg.Assertion.Parametric (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S O)))))
         jet_sha256_ctx8_init_spec.sha256_ctx8_type (@ctx8_add1_spec)
### C.jet_sha_ctx8_spec.ctx8_addn_spec_parametric
ctx8_addn_spec_parametric
     : forall n : nat,
       @Alg.Assertion.Parametric
         (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n))
         jet_sha256_ctx8_init_spec.sha256_ctx8_type (@ctx8_addn_spec n)
### C.jet_sha_ctx8_spec.ctx8_add_list_app
ctx8_add_list_app
     : forall (c : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (l1 l2 : list (Ty.tySem (Word.Word (S (S (S O)))))),
       @eq (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (ctx8_add_list c (@app (Ty.tySem (Word.Word (S (S (S O))))) l1 l2))
         match ctx8_add_list c l1 return (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)) with
         | Some c' => ctx8_add_list c' l2
         | None => @None (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         end
### C.jet_sha_ctx8_spec.ctx8_addn_option
ctx8_addn_option
     : forall (n : nat) (c : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (v : Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) n)),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (@ctx8_addn_spec n (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
               (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) n)) c v))
         (ctx8_add_list c (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) n v))
### C.jet_sha_ctx8_spec.buffer_list
buffer_list =
fix buffer_list (X : Ty.Ty) (depth : nat) {struct depth} :
    forall _ : Ty.tySem (jet_buffer_empty_spec.buffer_type X depth), list (Ty.tySem X) :=
  match
    depth as depth0 return (forall _ : Ty.tySem (jet_buffer_empty_spec.buffer_type X depth0), list (Ty.tySem X))
  with
  | O =>
      fun x : Ty.tySem (jet_buffer_empty_spec.buffer_type X O) =>
      match x return (list (Ty.tySem X)) with
      | inl _ => @nil (Ty.tySem X)
      | inr y =>
          @cons
            ((fix tySem (X0 : Ty.Ty) : Set :=
                match X0 return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end) X) y
            (@nil
               ((fix tySem (X0 : Ty.Ty) : Set :=
                   match X0 return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) X))
      end
  | S d =>
      fun x : Ty.tySem (jet_buffer_empty_spec.buffer_type X (S d)) =>
      @app (Ty.tySem X)
        match
          @fst
            (sum
               ((fix tySem (X0 : Ty.Ty) : Set :=
                   match X0 return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) Ty.Unit)
               ((fix tySem (X0 : Ty.Ty) : Set :=
                   match X0 return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Vector X (S d))))
            ((fix tySem (X0 : Ty.Ty) : Set :=
                match X0 return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end)
               ((fix buffer_type (X0 : Ty.Ty) (depth0 : nat) {struct depth0} : Ty.Ty :=
                   match depth0 return Ty.Ty with
                   | O => Ty.Sum Ty.Unit X0
                   | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X0 (S d0))) (buffer_type X0 d0)
                   end) X d)) x return (list (Ty.tySem X))
        with
        | inl _ => @nil (Ty.tySem X)
        | inr v => jet_buffer_input.vector_values X (S d) v
        end
        (buffer_list X d
           (@snd
              (sum
                 ((fix tySem (X0 : Ty.Ty) : Set :=
                     match X0 return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) Ty.Unit)
                 ((fix tySem (X0 : Ty.Ty) : Set :=
                     match X0 return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Word.Vector X (S d))))
              ((fix tySem (X0 : Ty.Ty) : Set :=
                  match X0 return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix buffer_type (X0 : Ty.Ty) (depth0 : nat) {struct depth0} : Ty.Ty :=
                     match depth0 return Ty.Ty with
                     | O => Ty.Sum Ty.Unit X0
                     | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X0 (S d0))) (buffer_type X0 d0)
                     end) X d)) x))
  end
     : forall (X : Ty.Ty) (depth : nat) (_ : Ty.tySem (jet_buffer_empty_spec.buffer_type X depth)), list (Ty.tySem X)

Arguments buffer_list X%ty_scope depth%nat_scope _
### C.jet_sha_ctx8_spec.buffer_snoc_spec
buffer_snoc_spec =
fix buffer_snoc_spec (X : Ty.Ty) (depth : nat) (term : Alg.Core.Algebra) {struct depth} :
    Alg.Core.domain term (Ty.Prod (jet_buffer_empty_spec.buffer_type X depth) X)
      (Ty.Sum (Word.Vector X (S depth)) (jet_buffer_empty_spec.buffer_type X depth)) :=
  match
    depth as depth0
    return
      (Alg.Core.domain term (Ty.Prod (jet_buffer_empty_spec.buffer_type X depth0) X)
         (Ty.Sum (Word.Vector X (S depth0)) (jet_buffer_empty_spec.buffer_type X depth0)))
  with
  | O =>
      @jet_sha256_count_assertion.AC.case Ty.Unit X X (Ty.Sum (Ty.Prod X X) (Ty.Sum Ty.Unit X)) term
        (@jet_sha256_count_assertion.AC.injr (Ty.Prod Ty.Unit X) (Ty.Prod X X) (Ty.Sum Ty.Unit X) term
           (@jet_sha256_count_assertion.AC.injr (Ty.Prod Ty.Unit X) Ty.Unit X term
              (@jet_sha256_count_assertion.AC.drop Ty.Unit X X term (@jet_sha256_count_assertion.AC.iden X term))))
        (@jet_sha256_count_assertion.AC.injl (Ty.Prod X X) (Ty.Prod X X) (Ty.Sum Ty.Unit X) term
           (@jet_sha256_count_assertion.AC.iden (Ty.Prod X X) term))
  | S d =>
      @jet_sha256_count_assertion.AC.comp
        (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (jet_buffer_empty_spec.buffer_type X d)) X)
        (Ty.Prod (Ty.Sum (Word.Vector X (S d)) (jet_buffer_empty_spec.buffer_type X d))
           (Ty.Sum Ty.Unit (Word.Vector X (S d))))
        (Ty.Sum (Ty.Prod (Word.Vector X (S d)) (Word.Vector X (S d)))
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (jet_buffer_empty_spec.buffer_type X d))) term
        (@jet_sha256_count_assertion.AC.pair
           (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (jet_buffer_empty_spec.buffer_type X d)) X)
           (Ty.Sum (Word.Vector X (S d)) (jet_buffer_empty_spec.buffer_type X d))
           (Ty.Sum Ty.Unit (Word.Vector X (S d))) term
           (@jet_sha256_count_assertion.AC.comp
              (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (jet_buffer_empty_spec.buffer_type X d)) X)
              (Ty.Prod (jet_buffer_empty_spec.buffer_type X d) X)
              (Ty.Sum (Word.Vector X (S d)) (jet_buffer_empty_spec.buffer_type X d)) term
              (@jet_sha256_count_assertion.AC.pair
                 (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (jet_buffer_empty_spec.buffer_type X d)) X)
                 (jet_buffer_empty_spec.buffer_type X d) X term
                 (@jet_sha256_count_assertion.AC.take
                    (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (jet_buffer_empty_spec.buffer_type X d)) X
                    (jet_buffer_empty_spec.buffer_type X d) term
                    (@jet_sha256_count_assertion.AC.drop (Ty.Sum Ty.Unit (Word.Vector X (S d)))
                       (jet_buffer_empty_spec.buffer_type X d) (jet_buffer_empty_spec.buffer_type X d) term
                       (@jet_sha256_count_assertion.AC.iden (jet_buffer_empty_spec.buffer_type X d) term)))
                 (@jet_sha256_count_assertion.AC.drop
                    (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (jet_buffer_empty_spec.buffer_type X d)) X X term
                    (@jet_sha256_count_assertion.AC.iden X term))) (buffer_snoc_spec X d term))
