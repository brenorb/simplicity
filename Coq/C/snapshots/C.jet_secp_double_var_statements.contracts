### C.jet_secp_double_var_statements.double_var_source
double_var_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_gej_double_var)
         (Clight.Ssequence double_var_head double_var_tail)
### C.jet_secp_double_var_statements.eval_double_var_null_test
eval_double_var_null_test
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._rzr le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m double_var_null_test (Values.Vint Integers.Int.zero)
### C.jet_secp_double_var_statements.exec_double_var_head_finite
exec_double_var_head_finite
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (ba : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m double_var_head Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint Integers.Int.zero) le) m ClightBigstep.Out_normal
### C.jet_secp_double_var_statements.exec_double_var_tail_from_calls
exec_double_var_tail_from_calls
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m md mz mf : Memory.Mem.mem) (ba : Values.block) (flag : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._rzr le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_double e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalizes_to_zero_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_double)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 md
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge md
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalizes_to_zero_var)
                (@cons Values.val
                   (Values.Vptr ba
                      (Integers.Ptrofs.repr
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                   (@nil Values.val)) Events.E0 mz (Values.Vint flag))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint32 mz ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                   (Values.Vint flag)) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m double_var_tail Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint flag) le) mf ClightBigstep.Out_normal
### C.jet_secp_double_var_statements.exec_double_var_head_infinite
exec_double_var_head_infinite
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (ba : Values.block) (flag : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._rzr le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_set_infinity e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag))) (_ : not (@eq Integers.Int.int flag Integers.Int.zero))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_set_infinity)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m double_var_head Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint flag) le) mf
         (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type)))
### C.jet_secp_double_var_statements.double_var_null_test
double_var_null_test =
Clight.Ebinop Cop.One (Clight.Etempvar jets_secp._rzr (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
  (Clight.Ecast (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tvoid))
  Ctypesdefs.tint
     : Clight.expr
### C.jet_secp_double_var_statements.double_var_head
double_var_head =
match Clight.fn_body jets_secp.f_secp256k1_gej_double_var return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence h _ => h
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_double_var_statements.double_var_tail
double_var_tail =
match Clight.fn_body jets_secp.f_secp256k1_gej_double_var return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ t => t
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
