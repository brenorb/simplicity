### C.jet_write64_then32s_layout.eval_write64_then32s_layout
eval_write64_then32s_layout
     : forall (m : Memory.Mem.mem) (bi : Values.block) (input : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z) (x : Integers.Int64.int)
         (xs : list Integers.Int.int) (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le
                (BinInt.Z.add input
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.of_nat (@length Integers.Int.int xs)))) Integers.Ptrofs.max_unsigned)
         (_ : not (@eq Values.block bi bf)) (_ : not (@eq Values.block bi bw))
         (_ : jet_uint32_array_init.uint32_array_at m bi input xs)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinInt.Z.add
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   (BinInt.Z.mul
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.of_nat (@length Integers.Int.int xs))))),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                  (@Ctypes.Internal Clight.function jets.f_simplicity_write64)
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                     (@cons Values.val (Values.Vlong x) (@nil Values.val))) Events.E0 mi Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mi
                     (@Ctypes.Internal Clight.function jets.f_write32s)
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                        (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
                           (@cons Values.val
                              (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int xs))))
                              (@nil Values.val)))) Events.E0 mf Values.Vundef)
                  (and
                     (jet_encoding.frame_output_cells_at mf bw edge cursor
                        (@app BitMachine.Cell
                           (@Translate.encode (Word.Word (jet_wide.wide_log jet_wide.W64))
                              (jet_wide_spec.decode_wide jet_wide.W64
                                 (Integers.Int64.zero_ext
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                    x))) (jet_write32s_layout.uint32_word_cells xs)))
                     (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                        (and
                           (jet_frame_layout.frame_fields_at mf bf base bw edge
                              (BinInt.Z.sub cursor
                                 (BinInt.Z.add
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                    (BinInt.Z.mul
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       (BinInt.Z.of_nat (@length Integers.Int.int xs))))))
                           (and
                              (jet_output_layout.loads_outside_ranges m mi bf
                                 (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 (BinInt.Z.add base
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                                 (jet_output_slice.slice_write_low
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                    edge cursor)
                                 (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              (and
                                 (jet_output_layout.loads_outside_ranges m mf bf
                                    (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                    (BinInt.Z.add base
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    bw
                                    (BinInt.Z.add edge
                                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                          (BinInt.Z.div
                                             (BinInt.Z.sub cursor
                                                (BinInt.Z.add
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                                   (BinInt.Z.mul
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                      (BinInt.Z.of_nat (@length Integers.Int.int xs)))))
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                    (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (and
                                    (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                       (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                     Memory.Mem.perm mf b ofs kind p)
                                    (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                     Memory.Mem.valid_block mf b))))))))))
