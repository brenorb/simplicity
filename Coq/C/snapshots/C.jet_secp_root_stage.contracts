### C.jet_secp_root_stage.root_stage_sources
root_stage_sources
     : @eq (list (list Clight.statement))
         (@List.map nat (list Clight.statement)
            (fun n : nat =>
             @List.firstn Clight.statement (S (S (S O)))
               (@List.skipn Clight.statement n
                  (jet_secp_root_square_loop.root_body_spine (Clight.fn_body jets_secp.f_secp256k1_fe_sqrt_var))))
            (@cons nat (S (S (S (S (S O)))))
               (@cons nat (S (S (S (S (S (S (S (S O))))))))
                  (@cons nat (S (S (S (S (S (S (S (S (S (S (S O)))))))))))
                     (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))
                        (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))))
                           (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))
                              (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))
                                 (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))
                                    (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))
                                       (@cons nat (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))) (@nil nat))))))))))))
         (@List.map Clight.statement (list Clight.statement) jet_secp_root_square_loop.root_body_spine
            (@cons Clight.statement (root_stage (S (S (S O))) jets_secp._x6 jets_secp._x3 jets_secp._x3)
               (@cons Clight.statement (root_stage (S (S (S O))) jets_secp._x9 jets_secp._x6 jets_secp._x3)
                  (@cons Clight.statement (root_stage (S (S O)) jets_secp._x11 jets_secp._x9 jets_secp._x2)
                     (@cons Clight.statement
                        (root_stage (S (S (S (S (S (S (S (S (S (S (S O))))))))))) jets_secp._x22 jets_secp._x11
                           jets_secp._x11)
                        (@cons Clight.statement
                           (root_stage (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))
                              jets_secp._x44 jets_secp._x22 jets_secp._x22)
                           (@cons Clight.statement
                              (root_stage (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))
                                 jets_secp._x88 jets_secp._x44 jets_secp._x44)
                              (@cons Clight.statement
                                 (root_stage (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))
                                    jets_secp._x176 jets_secp._x88 jets_secp._x88)
                                 (@cons Clight.statement
                                    (root_stage (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))) jets_secp._x220
                                       jets_secp._x176 jets_secp._x44)
                                    (@cons Clight.statement
                                       (root_stage (S (S (S O))) jets_secp._x223 jets_secp._x220 jets_secp._x3)
                                       (@cons Clight.statement
                                          (root_stage (S (S (S (S (S (S (S (S (S (S (S ...))))))))))) jets_secp._t1
                                             jets_secp._x223 jets_secp._x22) (@nil Clight.statement))))))))))))
### C.jet_secp_root_stage.root_field_words_unique
root_field_words_unique
     : forall (m : Memory.Mem.mem) (b : Values.block) (w v : forall _ : nat, Integers.Int64.int)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 v)),
       @eq (list Integers.Int64.int) (jet_secp_multiply_normalize_bridge.words5 w)
         (jet_secp_multiply_normalize_bridge.words5 v)
### C.jet_secp_root_stage.exec_root_stage_owned
exec_root_stage_owned
     : forall (n : nat) (dst src rhs : BinNums.positive) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (bd bs bv : Values.block)
         (w v : forall _ : nat, Integers.Int64.int)
         (_ : BinInt.Z.le (BinInt.Z.of_nat n)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) dst e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bd jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) src e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) rhs e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bv jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bd bs))
         (_ : not (@eq Values.block bd bv)) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_square_columns.square_input_bounds v)
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : jet_secp_fe_nv.fe_at m bv BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 v))
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bv BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (root_stage n dst src rhs) Events.E0
                  lef mf ClightBigstep.Out_normal)
               (and
                  (jet_secp_fe_nv.fe_at mf bd BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5 (root_stage_words n w v)))
                  (and (jet_secp_fe_nv.fe_at mf bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                     (and (jet_secp_fe_nv.fe_at mf bv BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 v))
                        (and
                           (Memory.Mem.range_perm mf bd BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bs BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bv BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and (jet_secp_square_columns.square_input_bounds (root_stage_words n w v))
                                    (and
                                       (@eq BinNums.Z
                                          (BinInt.Z.modulo
                                             (jet_secp_multiply_finish_product.radix_value (root_stage_words n w v))
                                             jet_secp_multiply_checkpoint_columns.field_prime)
                                          (BinInt.Z.modulo
                                             (BinInt.Z.mul
                                                (jet_secp_multiply_finish_product.radix_value
                                                   (jet_secp_root_square_loop.root_square_words n w))
                                                (jet_secp_multiply_finish_product.radix_value v))
                                             jet_secp_multiply_checkpoint_columns.field_prime))
                                       (and
                                          (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._j lef)
                                             (@Some Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat n)))))
                                          (and
                                             (forall (k : AST.ident) (_ : not (@eq AST.ident k jets_secp._j)),
                                              @eq (option Values.val) (@Maps.PTree.get Values.val k lef)
                                                (@Maps.PTree.get Values.val k le))
                                             (jet_sx_mem.lframe
                                                (fun (b : Values.block) (_ : BinNums.Z) =>
                                                 and (not (@eq Values.block b bd)) (not (@eq Values.block b bv))) m mf)))))))))))))
### C.jet_secp_root_stage.root_stage_copy
root_stage_copy =
fun dst src : AST.ident =>
Clight.Sassign (Clight.Evar dst jet_secp_curve_statements.curve_fe_type)
  (Clight.Evar src jet_secp_curve_statements.curve_fe_type)
     : forall (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments root_stage_copy dst src
### C.jet_secp_root_stage.root_stage_mul
root_stage_mul =
fun dst rhs : AST.ident =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address dst)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address dst)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address rhs) (@nil Clight.expr))))
     : forall (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments root_stage_mul dst rhs
### C.jet_secp_root_stage.root_stage
root_stage =
fun (n : nat) (dst src rhs : AST.ident) =>
Clight.Ssequence (root_stage_copy dst src)
  (Clight.Ssequence (jet_secp_root_square_loop.root_square_for dst (BinInt.Z.of_nat n)) (root_stage_mul dst rhs))
     : forall (_ : nat) (_ : AST.ident) (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments root_stage n%nat_scope dst src rhs
### C.jet_secp_root_stage.root_stage_words
root_stage_words =
fun (n : nat) (w v : forall _ : nat, Integers.Int64.int) =>
jet_secp_field_pair_multiply.field_pair_product (jet_secp_root_square_loop.root_square_words n w) v
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int) (_ : nat),
       Integers.Int64.int

Arguments root_stage_words n%nat_scope (w v)%function_scope n%nat_scope
