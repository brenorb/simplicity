### C.jet_secp_scalar_shift384_suffix.shift384_suffix_source
shift384_suffix_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_scalar_mul_shift_var)
         (Clight.Ssequence (Clight.Sloop Clight.Sskip Clight.Sbreak)
            (Clight.Ssequence jet_secp_scalar_shift384_control.shift384_product_statement shift384_suffix))
### C.jet_secp_scalar_shift384_suffix.exec_shift384_suffix
exec_shift384_suffix
     : forall (w : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (br bl : Values.block)
         (_ : not (@eq Values.block br bl))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._l e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bl
                      (Ctypesdefs.tarray Ctypesdefs.tulong
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_scalar_cadd_bit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._shift le)
                (@Some Values.val
                   (Values.Vint
                      (Integers.Int.repr
                         (BinNums.Zpos
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))))
         (_ : jet_secp_scalar_shift384_stores.shift384_product w bl m)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m shift384_suffix Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf br BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                           (BinInt.Z.div
                              (BinInt.Z.add (jet_secp_scalar_shift384_numeric.shift384_product_value w)
                                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                    (BinNums.Zpos
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
                              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))))
                  (and (jet_secp_scalar_shift384_stores.shift384_product w bl mf)
                     (and
                        (Memory.Mem.range_perm mf br BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and (jet_clight_internal_permissions.keeps_permissions m mf)
                           (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b br)) m
                              mf)))))))
### C.jet_secp_scalar_shift384_suffix.shift384_suffix
shift384_suffix =
jet_secp_statement_prefix.statement_sequence
  (@List.firstn Clight.statement (S (S (S O)))
     (@List.skipn Clight.statement (S (S O))
        (@fst (list Clight.statement) Clight.statement jet_secp_scalar_shift384_control.shift384_parts)))
  (jet_secp_statement_prefix.statement_sequence
     (@List.map nat Clight.statement jet_secp_scalar_shift384_control.shift384_copy_statement
        (List.seq O (S (S (S (S O))))))
     (Clight.Ssequence jet_secp_scalar_shift384_control.shift384_round_load
        jet_secp_scalar_shift384_control.shift384_round_call))
     : Clight.statement
