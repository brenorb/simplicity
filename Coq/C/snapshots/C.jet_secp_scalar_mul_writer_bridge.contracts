### C.jet_secp_scalar_mul_writer_bridge.four_words_decompose
four_words_decompose
     : forall (xs : list Integers.Int64.int) (_ : @eq nat (@length Integers.Int64.int xs) (S (S (S (S O))))),
       @eq (list Integers.Int64.int) xs
         (@cons Integers.Int64.int (@List.nth Integers.Int64.int O xs Integers.Int64.zero)
            (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S O) xs Integers.Int64.zero)
               (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S O)) xs Integers.Int64.zero)
                  (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S (S O))) xs Integers.Int64.zero)
                     (@nil Integers.Int64.int)))))
### C.jet_secp_scalar_mul_writer_bridge.four_words_scalar_limbs
four_words_scalar_limbs
     : forall (xs : list Integers.Int64.int) (_ : @eq nat (@length Integers.Int64.int xs) (S (S (S (S O))))),
       @eq (list Integers.Int64.int)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of (jet_secp_scalar_mul512_accumulate.column_words_value xs)))
         xs
### C.jet_secp_scalar_mul_writer_bridge.four_words_scalar_at
four_words_scalar_at
     : forall (m : Memory.Mem.mem) (b : Values.block) (xs : list Integers.Int64.int)
         (_ : @eq nat (@length Integers.Int64.int xs) (S (S (S (S O)))))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat) (w : Integers.Int64.int)
                (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int xs i)
                       (@Some Integers.Int64.int w)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vlong w))),
       jet_secp_scalar_get_b32_storage.scalar_at m b BinNums.Z0
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (jet_secp_scalar_get_b32_numeric.scalar_limbs_of (jet_secp_scalar_mul512_accumulate.column_words_value xs)))
### C.jet_secp_scalar_mul_writer_bridge.scalar_mul_output_owned
scalar_mul_output_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep (jet_secp_product_reduce_bridge.product_reduce_rho rho)
                (@cons (prod Values.block BinNums.Z) (jet_sx_state.lay beta O) (@nil (prod Values.block BinNums.Z)))
                (jet_secp_scalar_mul_caller_function.scalar_mul_caller_output rho) m),
       and (@eq BinNums.Z (jet_sx_state.bas beta O) BinNums.Z0)
         (Memory.Mem.range_perm m (jet_sx_state.blk beta O) BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
### C.jet_secp_scalar_mul_writer_bridge.scalar_writer_initial_rep_from_mul
scalar_writer_initial_rep_from_mul
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep (jet_secp_product_reduce_bridge.product_reduce_rho rho)
                (@cons (prod Values.block BinNums.Z) (jet_sx_state.lay beta O) (@nil (prod Values.block BinNums.Z)))
                (jet_secp_scalar_mul_caller_function.scalar_mul_caller_output rho) m)
         (_ : forall (i : nat) (w : Integers.Int64.int)
                (_ : @eq (option Integers.Int64.int)
                       (@List.nth_error Integers.Int64.int
                          (jet_secp_scalar_mul_caller_observed.scalar_mul_caller_words rho) i)
                       (@Some Integers.Int64.int w)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk beta O)
                   (BinInt.Z.add (jet_sx_state.bas beta O)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong w))),
       jet_sx_state.rep
         (jet_secp_scalar_get_b32_numeric.scalar_limb_rho
            (jet_secp_scalar_mul512_accumulate.column_words_value
               (jet_secp_scalar_mul_caller_observed.scalar_mul_caller_words rho)))
         (@cons (prod Values.block BinNums.Z)
            (@pair Values.block BinNums.Z (jet_sx_state.blk beta O) (jet_sx_state.bas beta O))
            (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_writer_run.scalar_writer_initial_regs m
