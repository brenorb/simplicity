### C.jet_bitcoin_count_bridge.bitcoin_transaction_num_inputs_spec_length
bitcoin_transaction_num_inputs_spec_length
     : forall environment : Bitcoin.Bitcoin.env,
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (@jet_bitcoin_count_canonical.bitcoin_transaction_num_inputs_spec
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt environment)
         (@Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
               (BinInt.Z.of_nat (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx environment))))))
