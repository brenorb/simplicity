### C.jet_bitcoin_tapleaf_hash_spec.tapleaf_hash_spec
tapleaf_hash_spec =
fun alg : jet_bitcoin_full_prim.PF.Algebra =>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit
  (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))) jet_sha256_ctx8_init_spec.sha256_ctx8_type
        core
        (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) core (@ctx8_init_tag_spec tapleaf_prefix core)
           (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))) core
              (@jet_bitcoin_full_prim.PF.Combinators.prim Ty.Unit (Word.Word (S (S (S O)))) alg
                 (@jet_bitcoin_full_prim.BitcoinFull.Ext Ty.Unit (Word.Word (S (S (S O))))
                    jet_bitcoin_ext_prim.BitcoinExt.TapleafVersion))
              (@Alg.scribe Ty.Unit (Word.Word (S (S (S O)))) byte32 core)))
        (@jet_sha_ctx8_spec.ctx8_addn_spec (S O) term))
     (@jet_bitcoin_full_prim.PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) alg
        (@jet_bitcoin_full_prim.BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           Bitcoin.Bitcoin.ScriptCMR)))
  (@jet_sha256_ctx8_init_spec.AC.comp
     (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
     jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S (S (S (S O))))) term) (@jet_sha_finalize_spec.ctx8_finalize_spec term))
     : forall alg : jet_bitcoin_full_prim.PF.Algebra,
       jet_bitcoin_full_prim.PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments tapleaf_hash_spec {alg}
### C.jet_bitcoin_tapleaf_hash_spec.tapleaf_bytes
tapleaf_bytes =
fun e : jet_bitcoin_ext_prim.ext_environment =>
@app (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S O))))))
  (@cons (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S O))))))
     (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O)))) (jet_bitcoin_ext_prim.extTapleafVersion e))
     (@cons (Ty.tySem (Word.Word (S (S (S O))))) byte32 (@nil (Ty.tySem (Word.Word (S (S (S O))))))))
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))
     (Word.from_hash256 (Bitcoin.Bitcoin.envScriptCMR (jet_bitcoin_ext_prim.extBase e))))
     : forall _ : jet_bitcoin_ext_prim.ext_environment, list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments tapleaf_bytes e
### C.jet_bitcoin_tapleaf_hash_spec.tapleaf_hash_of
tapleaf_hash_of =
fun e : jet_bitcoin_ext_prim.ext_environment =>
jet_sha_hash_closed.mk_hash256
  (jet_sha_hash_closed.sha_stream (@nil (Ty.tySem (Word.Word (S (S (S O))))))
     (jet_sha_ctx8_model.state_regs tapleaf_prefix) (BinNums.Zpos BinNums.xH) (tapleaf_bytes e))
     : forall _ : jet_bitcoin_ext_prim.ext_environment, Digest.hash256

Arguments tapleaf_hash_of e
