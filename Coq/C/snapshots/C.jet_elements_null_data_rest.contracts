         (be : Values.block) (ebase : BinNums.Z) (bt : Values.block) (txbase : BinNums.Z) (bout : Values.block)
         (outbase : BinNums.Z) (count : Integers.Int64.int) (flag : bool)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._simplicity_read32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._src e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._writeBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._skipBits e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._writeHash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase))))
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi inedge rc)
         (_ : @jet_input_layout.frame_input_word_at (S (S (S (S (S O))))) m bi inedge rc iw)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable) (_ : not (@eq Values.block bl bi)) (_ : not (@eq Values.block bl bd))
         (_ : not (@eq Values.block bl bw)) (_ : not (@eq Values.block bl be)) (_ : not (@eq Values.block bl bt))
         (_ : not (@eq Values.block bl bout))
         (_ : jet_elements_null_data_output_guard.elements_null_data_output_rep m be ebase bt txbase bout outbase
                (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) iw)) count flag)
         (_ : forall
                _ : @eq bool
                      (andb
                         (Integers.Int64.ltu
                            (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) iw)) count)
                         flag) true,
              elements_null_data_rest_payload m bl bd dbase bw edge cur bi inedge rc be ebase bt txbase bout outbase
                (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) iw)) jw parsed
                unused_hash)
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cur
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xO
                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m elements_null_data_rest
                  Events.E0 le' mf jet_elements_wrapper.elements_returned_one)
               (jet_elements_null_data_read_index.write_effect_private bl m mf bd dbase bw edge cur
                  (BinNums.Zpos
                     (BinNums.xI
                        (BinNums.xO
                           (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (@Translate.encode
                     (Ty.Sum Ty.Unit
                        (Ty.Sum Ty.Unit
                           (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))
                     (jet_elements_null_data_guard_compose.elements_null_data_guard_value parsed unused_hash
