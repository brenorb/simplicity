### C.jet_elements_null_data_rest.elements_null_data_rest_payload
elements_null_data_rest_payload =
fun (m : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (edge cur : BinNums.Z)
  (bi : Values.block) (inedge rc : BinNums.Z) (be : Values.block) (ebase : BinNums.Z) (bt : Values.block)
  (txbase : BinNums.Z) (bout : Values.block) (outbase : BinNums.Z) (i : Integers.Int64.int)
  (jw : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
  (parsed : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int))) (unused_hash : Digest.hash256) =>
and
  (@jet_input_layout.frame_input_word_at (S (S (S (S (S O))))) m bi inedge
     (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) jw)
  (and
     (forall (k : BinNums.Z)
        (_ : and (BinInt.Z.le BinNums.Z0 k)
               (BinInt.Z.lt k
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
      jet_application_sep.out_sep bd dbase bw edge cur
        (BinNums.Zpos
           (BinNums.xI
              (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        bi
        (BinInt.Z.sub inedge
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
              (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                 (BinInt.Z.div
                    (BinInt.Z.add
                       (BinInt.Z.add rc
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) k)
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
        (BinInt.Z.add
           (BinInt.Z.sub inedge
              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                 (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                    (BinInt.Z.div
                       (BinInt.Z.add
                          (BinInt.Z.add rc
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                          k)
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (and
        (BinInt.Z.le (BinInt.Z.of_nat (@length (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) parsed))
           Integers.Int64.max_unsigned)
        (and
           (jet_elements_null_data_index.elements_null_data_count_path m be ebase bt txbase bout outbase i
              (Integers.Int64.repr
                 (BinInt.Z.of_nat (@length (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) parsed))))
           (and
              (@List.Forall (prod (prod Values.block BinNums.Z) BinNums.Z)
                 (fun pat : prod (prod Values.block BinNums.Z) BinNums.Z =>
                  match pat return Prop with
                  | pair y hi =>
                      match y return Prop with
                      | pair b lo =>
                          jet_application_sep.out_sep bd dbase bw edge cur
                            (BinNums.Zpos
                               (BinNums.xI
                                  (BinNums.xO
                                     (BinNums.xI
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                            b lo hi
                      end
                  end)
                 (jet_elements_null_data_guard_compose.elements_null_data_count_footprint be ebase bt txbase bout
                    outbase i))
              (jet_elements_null_data_guard_compose.elements_null_data_selected_footprint m bl bd dbase bw edge cur
                 (BinNums.Zpos
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                 be ebase bt txbase bout outbase i
                 (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) jw)) parsed
                 unused_hash)))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block)
         (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (_ : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int))) (_ : Digest.hash256), Prop

Arguments elements_null_data_rest_payload m bl bd dbase%Z_scope bw (edge cur)%Z_scope bi (inedge rc)%Z_scope
  be ebase%Z_scope bt txbase%Z_scope bout outbase%Z_scope i jw parsed%list_scope unused_hash
