### C.jet_parse_lock_exec.eval_parse_lock_tag
eval_parse_lock_tag
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._nLockTime le)
                (@Some Values.val (Values.Vlong r))),
       Clight.eval_expr jet_exec.ge0 e le m parse_lock_tag_expr
         (Values.Vint
            match jet_timelock_spec.parse_lock_tag r return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
### C.jet_parse_lock_exec.cast_parse_lock_tag
cast_parse_lock_tag
     : forall (m : Memory.Mem.mem) (r : Integers.Int64.int),
       @eq (option Values.val)
         (Cop.sem_cast
            (Values.Vint
               match jet_timelock_spec.parse_lock_tag r return Integers.Int.int with
               | true => Integers.Int.one
               | false => Integers.Int.zero
               end) (Clight.typeof parse_lock_tag_expr) Ctypesdefs.tbool m)
         (@Some Values.val
            (Values.Vint
               match jet_timelock_spec.parse_lock_tag r return Integers.Int.int with
               | true => Integers.Int.one
               | false => Integers.Int.zero
               end))
### C.jet_parse_lock_exec.eval_parse_lock_composes
eval_parse_lock_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc mr mb me mf : Memory.Mem.mem)
         (bl bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (r : Integers.Int64.int) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_read32)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr (@Ctypes.Internal Clight.function jets.f_writeBit)
                (@cons Values.val (Values.Vptr bd dofs)
                   (@cons Values.val
                      (Values.Vint
                         match jet_timelock_spec.parse_lock_tag r return Integers.Int.int with
                         | true => Integers.Int.one
                         | false => Integers.Int.zero
                         end) (@nil Values.val))) Events.E0 mb
                (Values.Vint
                   match jet_timelock_spec.parse_lock_tag r return Integers.Int.int with
                   | true => Integers.Int.one
                   | false => Integers.Int.zero
                   end))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer jet_wide.W32))
                (@cons Values.val (Values.Vptr bd dofs) (@cons Values.val (Values.Vlong r) (@nil Values.val)))
                Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_parse_lock)
         (@cons Values.val (Values.Vptr bd dofs)
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_parse_lock_exec.parse_lock_tag_expr
parse_lock_tag_expr =
Clight.Ebinop Cop.Ole
  (Clight.Econst_int
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (...))))))))))))))))))))))
     Ctypesdefs.tuint) (Clight.Etempvar jets._nLockTime Ctypesdefs.tulong) Ctypesdefs.tint
     : Clight.expr
### C.jet_parse_lock_exec.le_parse_lock_x
le_parse_lock_x =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._nLockTime (Values.Vlong r)
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vlong r)
     (jet_arith8_layout_exec.le_arith8_layout env jets.f_simplicity_parse_lock bd dofs bs sofs))
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments le_parse_lock_x env bd dofs bs sofs r
