### C.jet_secp_generator_pair_general.generator_pair_closed
generator_pair_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers
            (Clight.Ssequence (jet_secp_generator_digit_control.generator_digit_dispatch false)
               (jet_secp_generator_digit_control.generator_digit_dispatch true))) true
### C.jet_secp_generator_pair_general.generator_pair_effects
generator_pair_effects
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (trace : Events.trace)
         (lef : Clight.temp_env) (mf : Memory.Mem.mem) (out : ClightBigstep.outcome)
         (_ : ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                (Clight.Ssequence (jet_secp_generator_digit_control.generator_digit_dispatch false)
                   (jet_secp_generator_digit_control.generator_digit_dispatch true)) trace lef mf out)
         (_ : jet_clight_internal_frame.plain_env e),
       and (jet_clight_internal_permissions.keeps_permissions m mf)
         (jet_clight_internal_preserve.readonly_preserved m mf)
### C.jet_secp_generator_pair_general.generator_tables_readonly
generator_tables_readonly
     : forall (m mf : Memory.Mem.mem) (_ : forall h : bool, jet_secp_generator_globals.generator_table_state h m)
         (_ : jet_clight_internal_preserve.readonly_preserved m mf) (h : bool),
       jet_secp_generator_globals.generator_table_state h mf
### C.jet_secp_generator_pair_general.generator_digit_action_scaled
generator_digit_action_scaled =
fun (high : bool) (s : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (digit : Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)
  (point : Ty.tySem jet_secp_generate_literal.literal_generator_jacobian) =>
match digit return (Ty.tySem jet_secp_generate_literal.literal_generator_jacobian) with
| inl _ => point
| inr word =>
    @jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
      (@pair (Ty.tySem jet_secp_generate_literal.literal_generator_jacobian)
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         point
         (@jet_secp_rescale_literal.literal_gej_zinv Alg.CoreFunSem
            (@pair (Ty.tySem jet_secp_generate_literal.literal_generator_point)
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@jet_secp_generate_literal.literal_generate_small high Alg.CoreFunSem word) s)))
end
     : forall (_ : bool) (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)
         (_ : Ty.tySem jet_secp_generate_literal.literal_generator_jacobian),
       Ty.tySem jet_secp_generate_literal.literal_generator_jacobian

Arguments generator_digit_action_scaled high%bool_scope s digit point
