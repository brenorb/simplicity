### C.jet_secp_field_negate.field_negate_run_eq
field_negate_run_eq
     : @eq (option jet_sx_exec.res) field_negate_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone field_negate_state jet_sx_exec.ONormal))
### C.jet_secp_field_negate.field_negate_return
field_negate_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps field_negate_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_field_negate.eval_field_negate_from_owned_region
eval_field_negate_from_owned_region
     : forall (m : Memory.Mem.mem) (layout : jet_sx_state.layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : jet_sx_state.rep rho layout jet_secp_local_regions.local_write_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho layout (jet_sx_eval.sregs field_negate_state) mf)
               (and
                  (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                     (@List.map jet_sx_state.region
                        (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        jet_sx_state.rshape (jet_sx_eval.sregs field_negate_state))
                     (@List.map jet_sx_state.region
                        (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        jet_sx_state.rshape jet_secp_local_regions.local_write_initial_regs))
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      not
                        (jet_sx_state.foot layout
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape jet_secp_local_regions.local_write_initial_regs) b pos)) m mf))))
### C.jet_secp_field_negate.field_negate_args
field_negate_args =
@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
     (@cons jet_sx_expr.sx (jet_sx_expr.XIc Integers.Int.one) (@nil jet_sx_expr.sx)))
     : list jet_sx_expr.sx
### C.jet_secp_field_negate.field_negate_run
field_negate_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_negate field_negate_args jet_secp_local_regions.local_write_initial_regs
  (@nil jet_sx_eval.event) (S (S (S (S (S (S O))))))
     : option jet_sx_exec.res
