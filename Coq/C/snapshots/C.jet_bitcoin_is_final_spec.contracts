                 (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (environment : E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)))
         (@final_program (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad)) op tt environment)
         (@Option.option_bind (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)) (sum unit unit)
