### C.jet_bitcoin_is_final_spec.lead_le
@lead_le
     : forall (X : Type) (f : forall _ : X, bool) (xs : list X), le (@lead X f xs) (@length X xs)
### C.jet_bitcoin_is_final_spec.lead_before
@lead_before
     : forall (X : Type) (f : forall _ : X, bool) (xs : list X) (i : nat) (_ : lt i (@lead X f xs)),
       @ex X (fun x : X => and (@eq (option X) (@List.nth_error X xs i) (@Some X x)) (@eq bool (f x) true))
### C.jet_bitcoin_is_final_spec.lead_at
@lead_at
     : forall (X : Type) (f : forall _ : X, bool) (xs : list X),
       match @List.nth_error X xs (@lead X f xs) return Prop with
       | Some x => and (@eq bool (f x) false) (@eq bool (@List.forallb X f xs) false)
       | None => @eq bool (@List.forallb X f xs) true
       end
### C.jet_bitcoin_is_final_spec.final_run_list
@final_run_list
     : forall (X : Type) (xs : list X) (enc : forall _ : X, Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (f : forall _ : X, bool)
         (op : forall _ : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
               option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.lt (BinInt.Z.of_nat (@length X xs)) (jet_forWhile_seq.wsize (S (S (S (S (S O)))))))
         (_ : forall x : X,
              @eq bool
                (jet_predicate_spec.predicate_numeric (S (S (S (S (S O))))) true
                   (jet_forWhile_seq.wz (S (S (S (S (S O))))) (enc x))) (f x))
         (_ : forall w : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))) (op w)
                (@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                   match
                     @List.nth_error X xs (BinInt.Z.to_nat (jet_forWhile_seq.wz (S (S (S (S (S O))))) w))
                     return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                   with
                   | Some x => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (enc x)
                   | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))) tt
                   end)),
       @eq (option (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)))
         (@jet_forWhile_spec.for_while_run (S (S (S (S (S O))))) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit
            (final_step op) tt tt)
         (@Some (sum (sum unit unit) unit) (@inl (sum unit unit) unit (Bit.fromBool (@List.forallb X f xs))))
### C.jet_bitcoin_is_final_spec.bitcoin_tx_is_final_spec_parametric
bitcoin_tx_is_final_spec_parametric
