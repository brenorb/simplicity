### C.jet_bitcoin_is_final_spec.sequence_final_numeric
sequence_final_numeric
     : forall txi : Bitcoin.sigTxInput,
       @eq bool
         (jet_predicate_spec.predicate_numeric (S (S (S (S (S O))))) true
            (jet_forWhile_seq.wz (S (S (S (S (S O)))))
               (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
                  (Integers.Int.unsigned (Bitcoin.sigTxiSequence txi))))) (sequence_final txi)
### C.jet_bitcoin_is_final_spec.final_list_op
final_list_op
     : forall (xs : list Bitcoin.sigTxInput) (w : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))))
         (@Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
            match
              @option_map Bitcoin.sigTxInput (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
                (fun txi : Bitcoin.sigTxInput =>
                 @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
                   (Integers.Int.unsigned (Bitcoin.sigTxiSequence txi)))
                (@List.nth_error Bitcoin.sigTxInput xs
                   (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) w)))
              return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
            with
            | Some b => @inr unit (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))) b
            | None =>
                @inl unit
                  (prod
                     (prod
                        (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                           (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                        (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                           (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                     (prod
                        (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                           (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                        (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                           (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))) tt
            end)
         (@Some (sum unit (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))))
            match
              @List.nth_error Bitcoin.sigTxInput xs (BinInt.Z.to_nat (jet_forWhile_seq.wz (S (S (S (S (S O))))) w))
              return (sum unit (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))))
            with
            | Some x =>
                @inr unit (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
                  (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
                     (Integers.Int.unsigned (Bitcoin.sigTxiSequence x)))
            | None => @inl unit (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))) tt
            end)
### C.jet_bitcoin_is_final_spec.bitcoin_tx_is_final_spec_value
bitcoin_tx_is_final_spec_value
     : forall environment : Bitcoin.Bitcoin.env,
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)))
         (@bitcoin_tx_is_final_spec
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt environment)
         (@Some (sum unit unit)
