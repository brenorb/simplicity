               (@List.forallb Bitcoin.sigTxInput sequence_final (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx environment)))))
### C.jet_bitcoin_is_final_spec.final_tail
final_tail =
fun alg : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit Ty.Unit)
  (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) alg (@jet_predicate_spec.predicate_spec (S (S (S (S (S O))))) true alg)
  (@Alg.Core.Combinators.copair Ty.Unit Ty.Unit (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) alg
     (@Alg.Core.Combinators.injl Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit alg (@Bit.false Ty.Unit alg))
     (@Alg.Core.Combinators.injr Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit alg (@Alg.Core.Combinators.unit Ty.Unit alg)))
     : forall alg : Alg.Core.Algebra,
       Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)

Arguments final_tail {alg}
### C.jet_bitcoin_is_final_spec.final_body
final_body =
fun (alg : Alg.Core.Algebra)
  (op : Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))) =>
@Alg.Core.Combinators.comp (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit)
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) alg
  (@Alg.Core.Combinators.take (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg
     (@Alg.Core.Combinators.drop Ty.Unit (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg op))
  (@Alg.Core.Combinators.copair Ty.Unit (Word.Word (S (S (S (S (S O)))))) (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) alg
     (@Alg.Core.Combinators.injl Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit alg (@Bit.true Ty.Unit alg))
     (@final_tail alg))
     : forall (alg : Alg.Core.Algebra)
         (_ : Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))),
       Alg.Core.domain alg (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit)
         (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)

Arguments final_body {alg} op
### C.jet_bitcoin_is_final_spec.final_program
final_program =
fun (alg : Alg.Core.Algebra)
  (op : Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))) =>
@Alg.Core.Combinators.comp Ty.Unit (Ty.Prod Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit) alg
  (@Alg.Core.Combinators.pair Ty.Unit Ty.Unit Ty.Unit alg (@Alg.Core.Combinators.unit Ty.Unit alg)
     (@Alg.Core.Combinators.unit Ty.Unit alg))
  (@Alg.Core.Combinators.comp (Ty.Prod Ty.Unit Ty.Unit) (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)
     (Ty.Sum Ty.Unit Ty.Unit) alg
     (@jet_forWhile_spec.for_while_program (S (S (S (S (S O))))) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit alg
        (@final_body alg op))
     (@Alg.Core.Combinators.copair (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) alg
        (@Alg.Core.Combinators.iden (Ty.Sum Ty.Unit Ty.Unit) alg) (@Bit.true Ty.Unit alg)))
     : forall (alg : Alg.Core.Algebra)
         (_ : Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))),
       Alg.Core.domain alg Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)

Arguments final_program {alg} op
### C.jet_bitcoin_is_final_spec.final_step
final_step =
fun
  (op : forall _ : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
        option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))))
  (p : Ty.tySem (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit)) =>
match
  op
    (@snd unit
       (prod
          ((fix tySem (X : Ty.Ty) : Set :=
              match X return Set with
              | Ty.Unit => unit
              | Ty.Sum A B => sum (tySem A) (tySem B)
              | Ty.Prod A B => prod (tySem A) (tySem B)
              end)
             ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                 match n return Ty.Ty with
                 | O => X
                 | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                 end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
          ((fix tySem (X : Ty.Ty) : Set :=
              match X return Set with
              | Ty.Unit => unit
              | Ty.Sum A B => sum (tySem A) (tySem B)
              | Ty.Prod A B => prod (tySem A) (tySem B)
              end)
             ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                 match n return Ty.Ty with
                 | O => X
                 | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                 end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O)))))))
       (@fst
          (prod
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) Ty.Unit)
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Word (S (S (S (S (S O)))))))) unit p))
  return (option (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)))
with
| Some t =>
    match t return (option (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit))) with
    | inl _ => @Some (sum (sum unit unit) unit) (@inl (sum unit unit) unit (@inr unit unit tt))
    | inr v =>
        @Some (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit))
          ((@final_tail Alg.CoreFunSem
            :
            Ty.Arrow (Word.Word (S (S (S (S (S O)))))) (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)) v)
    end
| None => @None (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit))
end
     : forall
         (_ : forall _ : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
              option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))))
         (_ : Ty.tySem (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit)),
       option (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit))

Arguments final_step op%function_scope p
### C.jet_bitcoin_is_final_spec.lead
lead =
fix lead (X : Type) (f : forall _ : X, bool) (xs : list X) {struct xs} : nat :=
  match xs return nat with
  | nil => O
  | cons x t => match f x return nat with
                | true => S (lead X f t)
                | false => O
                end
  end
     : forall (X : Type) (_ : forall _ : X, bool) (_ : list X), nat

Arguments lead {X}%type_scope f%function_scope xs%list_scope
### C.jet_bitcoin_is_final_spec.sequence_final
sequence_final =
fun txi : Bitcoin.sigTxInput =>
BinInt.Z.eqb (Integers.Int.unsigned (Bitcoin.sigTxiSequence txi))
  (BinNums.Zpos
     (BinNums.xI
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))))
     : forall _ : Bitcoin.sigTxInput, bool

Arguments sequence_final txi
### C.jet_bitcoin_is_final_spec.bitcoin_tx_is_final_spec
bitcoin_tx_is_final_spec =
fun alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra =>
@final_program (Bitcoin.PrimitiveBitcoin.Primitive.CanonicalStructures.toCore alg)
  (@Bitcoin.PrimitiveBitcoin.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg Bitcoin.Bitcoin.InputSequence)
     : forall alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra,
       Bitcoin.PrimitiveBitcoin.Primitive.domain alg Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)

Arguments bitcoin_tx_is_final_spec {alg}
