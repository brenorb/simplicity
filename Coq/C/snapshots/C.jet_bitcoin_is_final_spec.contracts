### C.jet_bitcoin_is_final_spec.final_tail_value
final_tail_value
     : forall v : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
       @eq (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)) (@final_tail Alg.CoreFunSem v)
         match
           jet_predicate_spec.predicate_numeric (S (S (S (S (S O))))) true
             (jet_forWhile_seq.wz (S (S (S (S (S O))))) v) return (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit))
