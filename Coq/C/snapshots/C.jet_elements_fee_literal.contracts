              (Word.Word (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit)
     (@jet_elements_amount_jets.elements_output_amount_spec alg) (@elements_output_fee_hash_eq alg))
  (@jet_elements_prim_sem.elements_core
     (Ty.Prod
        (Ty.Sum Ty.Unit
           (Ty.Prod
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))
