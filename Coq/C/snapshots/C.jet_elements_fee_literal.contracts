### C.jet_elements_fee_literal.elements_output_fee_hash_eq
elements_output_fee_hash_eq =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_current_spec.elements_comp alg (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.Sum Ty.Unit Ty.Unit)
  (@jet_elements_prim_sem.elements_pair alg (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (@jet_elements_prim.PrimitiveElements.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg jet_elements_prim.Elements.OutputScriptHash)
     (@jet_elements_prim_sem.elements_core (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (fun core : Alg.Core.Algebra =>
         @Alg.scribe (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) fee_empty_hash_word) core) alg))
  (@jet_elements_prim_sem.elements_core
     (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.Sum Ty.Unit Ty.Unit)
     (fun core : Alg.Core.Algebra =>
      @jet_equality_spec.equality_spec (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core) alg)
     : forall alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra,
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit Ty.Unit)

Arguments elements_output_fee_hash_eq {alg}
### C.jet_elements_fee_literal.elements_output_fee_spec
elements_output_fee_spec =
fun alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra =>
@jet_elements_current_spec.elements_comp alg (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod
     (Ty.Sum Ty.Unit
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
