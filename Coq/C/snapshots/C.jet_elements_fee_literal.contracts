### C.jet_elements_fee_literal.elements_fee_hash_eq_reader
elements_fee_hash_eq_reader
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)))
         (@elements_output_fee_hash_eq
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
         (@Some (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
            (@jet_equality_spec.equality_spec (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               Alg.CoreFunSem
               (@pair (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  match
                    @List.nth_error jet_elements_prim.txOutput
                      (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
                      (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
                    return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  with
                  | Some o =>
                      @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Word.from_hash256 (Digest.byteStringHash (jet_elements_prim.txoScript o)))
                  | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
                  end (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) fee_empty_hash_word))))
### C.jet_elements_fee_literal.elements_output_fee_sem
elements_output_fee_sem
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))))
         (@elements_output_fee_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment) (@Some (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))) (fee_spec_result a environment))
