### C.jet_elements_fee_literal.fee_spec_bit
fee_spec_bit =
fun o : jet_elements_prim.txOutput =>
match jet_elements_prim.txoAmount o return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) with
| jet_elements_prim.Explicit _ =>
    match jet_elements_prim.txoAsset o return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) with
    | jet_elements_prim.Explicit _ => fee_script_hash_test o
    | jet_elements_prim.Confidential _ _ => @inl unit unit tt
    end
| jet_elements_prim.Confidential _ _ => @inl unit unit tt
end
     : forall _ : jet_elements_prim.txOutput, Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)

Arguments fee_spec_bit o
### C.jet_elements_fee_literal.fee_spec_result
fee_spec_result =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
match
  @List.nth_error jet_elements_prim.txOutput
    (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
with
| Some o => @inr unit (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (fee_spec_bit o)
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)) tt
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))

Arguments fee_spec_result a environment
