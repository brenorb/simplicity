### C.jet_elements_fee_literal.elements_fee_tail_value
elements_fee_tail_value
     : forall (asset : jet_elements_prim.assetWith unit) (amount : jet_elements_prim.amountWith unit)
         (b : sum unit unit),
       @eq (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
         (@elements_fee_tail Alg.CoreFunSem
            (@pair
               (sum unit
                  (prod
                     (Ty.tySem
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S O))))))))))) (sum unit unit)
               (@inr unit
                  (prod
                     (Ty.tySem
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S O))))))))))
                  (@pair
                     (Ty.tySem
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (Ty.tySem
                        (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Word.Word (S (S (S (S (S (S O))))))))) (jet_elements_asset_jets.encode_asset asset)
                     (jet_elements_amount_jets.encode_amount amount))) b))
         (@inr unit (sum unit unit)
            match amount return (sum unit unit) with
            | jet_elements_prim.Explicit _ =>
                match asset return (sum unit unit) with
                | jet_elements_prim.Explicit _ => b
                | jet_elements_prim.Confidential _ _ => @inl unit unit tt
                end
            | jet_elements_prim.Confidential _ _ => @inl unit unit tt
            end)
