### C.jet_secp_zinv_flag.zinv_finite_flag_consistent
zinv_finite_flag_consistent
     : forall (x y z u v inv : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_square_columns.square_input_bounds (jet_secp_zinv_differences.zinv_h_words x z u inv))
         (_ : not
                (@eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                   BinNums.Z0)),
       @eq Integers.Int.int (jet_secp_zinv_finite.zinv_finite_flag x y z u v inv)
         (jet_readBit_layout.bit_int
            (BinInt.Z.eqb
               (BinInt.Z.modulo
                  (jet_secp_multiply_finish_product.radix_value (jet_secp_zinv_finite.zinv_finite_z x y z u v inv))
                  jet_secp_fe_math.feP) BinNums.Z0))
