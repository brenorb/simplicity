                                             (prod (sum unit unit) (sum unit unit))))
                                       (prod
                                          (prod (prod (sum unit unit) (sum unit unit))
                                             (prod (sum unit unit) (sum unit unit)))
                                          (prod (prod (sum unit unit) (sum unit unit))
                                             (prod (sum unit unit) (sum unit unit))))))))) d)))))
