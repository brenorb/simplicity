### C.jet_secp_scalar_mul_separate_support.scalar_mul_separate_temps
scalar_mul_separate_temps =
fun (beta : jet_sx_state.layout) (br : Values.block) =>
@Maps.PTree.set Values.val jets_secp._b
  (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
  (@Maps.PTree.set Values.val jets_secp._a
     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
     (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr br Integers.Ptrofs.zero) (Maps.PTree.empty Values.val)))
     : forall (_ : jet_sx_state.layout) (_ : Values.block), Maps.PTree.tree Values.val

Arguments scalar_mul_separate_temps beta br
