| pair p z =>
    match p return (prod (prod BinNums.Z BinNums.Z) BinNums.Z) with
    | pair x y => jet_secp_generator_point_numeric.literal_double_numeric x y z
    end
end
     : forall _ : prod (prod BinNums.Z BinNums.Z) BinNums.Z, prod (prod BinNums.Z BinNums.Z) BinNums.Z

