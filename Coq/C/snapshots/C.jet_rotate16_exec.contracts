### C.jet_rotate16_exec.exec_rotate16_scalar_call
exec_rotate16_scalar_call
     : forall (right : bool) (bl : Values.block) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (r : Integers.Int64.int) (a : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a) (jet_wide.wide_bits jet_wide.W16)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._input le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._amt le) (@Some Values.val (Values.Vint a))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (rotate16_scalar_call right) Events.E0
         (@Maps.PTree.set Values.val jets._t'3 (Values.Vlong (rotate16_scalar_value right r a)) le) m
         ClightBigstep.Out_normal
### C.jet_rotate16_exec.rotate16_body
rotate16_body
     : forall right : bool,
       @eq Clight.statement (Clight.fn_body (rotate16_function right))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (jet_read4_call.nibble_read jets._t'1)
                  (Clight.Sset jets._amt
                     (jet_rotate_count_exec.wide_rotate_amount_expr jet_wide.W16
                        (Clight.Etempvar jets._t'1 Ctypesdefs.tuchar))))
               (Clight.Ssequence
                  (Clight.Ssequence (jet_binary_wide_exec.wide_binary_read jet_wide.W16 jets._t'2)
                     (Clight.Sset jets._input (Clight.Etempvar jets._t'2 Ctypesdefs.tulong)))
                  (Clight.Ssequence
                     (Clight.Ssequence (rotate16_scalar_call right)
                        (jet_arith8_layout_exec.frame_writer_call (jet_wide.wide_writer_id jet_wide.W16)
                           Ctypesdefs.tulong Ctypesdefs.tvoid (Clight.Etempvar jets._t'3 Ctypesdefs.tulong)))
                     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))))
### C.jet_rotate16_exec.eval_rotate16_composes
eval_rotate16_composes
     : forall (env : Values.val) (right : bool) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (mc mr mr2 me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bytes : list Memdata.memval) (a : Integers.Int.int) (r : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_read4)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader jet_wide.W16))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer jet_wide.W16))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (rotate16_payload right r a)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function (rotate16_function right))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_rotate16_exec.rotate16_function
rotate16_function =
fun right : bool =>
match right return Clight.function with
| true => jets.f_simplicity_right_rotate_16
| false => jets.f_simplicity_left_rotate_16
end
     : forall _ : bool, Clight.function

Arguments rotate16_function right%bool_scope
### C.jet_rotate16_exec.rotate16_scalar_value
rotate16_scalar_value =
fun (right : bool) (r : Integers.Int64.int) (a : Integers.Int.int) =>
match right return Integers.Int64.int with
| true =>
    jet_rotate_wide_helper.wide_rotate_result jet_wide.W16 r
      (jet_rotate_count_exec.wide_rotate_reverse_amount jet_wide.W16 a)
| false => jet_rotate_wide_helper.wide_rotate_result jet_wide.W16 r a
end
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Integers.Int.int), Integers.Int64.int

Arguments rotate16_scalar_value right%bool_scope r a
### C.jet_rotate16_exec.rotate16_payload
rotate16_payload =
fun (right : bool) (r : Integers.Int64.int) (a : Integers.Int.int) =>
rotate16_scalar_value right r (jet_rotate_count_exec.wide_rotate_amount jet_wide.W16 a)
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Integers.Int.int), Integers.Int64.int

Arguments rotate16_payload right%bool_scope r a
### C.jet_rotate16_exec.rotate16_scalar_call
rotate16_scalar_call =
fun right : bool =>
match right return Clight.statement with
| true => jet_right_rotate_wide_exec.right_rotate_scalar_call jet_wide.W16
| false => jet_left_rotate_wide_exec.rotate_scalar_call jet_wide.W16
end
     : forall _ : bool, Clight.statement

Arguments rotate16_scalar_call right%bool_scope
