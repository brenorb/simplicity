### C.jet_secp_taptweak_parse.taptweak_parse_source
taptweak_parse_source
     : @eq Clight.statement
         (jet_secp_root_chain_owned.root_drop_statements (S (S (S (S (S (S O))))))
            (Clight.fn_body jets_secp.f_simplicity_generic_taptweak))
         (Clight.Ssequence taptweak_parse_guard
            (jet_secp_root_chain_owned.root_drop_statements (S (S (S (S (S (S (S O)))))))
               (Clight.fn_body jets_secp.f_simplicity_generic_taptweak)))
### C.jet_secp_taptweak_parse.exec_taptweak_parse
exec_taptweak_parse
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_memset_model.memset_model)
         (pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (bkey bb : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._input_pubkey e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bkey (Ctypes.Tstruct jets_secp.__6478 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._buf e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_xonly_pubkey_parse e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bkey bb))
         (_ : Memory.Mem.range_perm m bkey BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes pk))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m taptweak_parse_guard Events.E0
               (@Maps.PTree.set Values.val jets_secp._t'1
                  (Values.Vint (jet_secp_xonly_parse_field.xonly_parse_result pk)) le) mf
               (jet_secp_bip0340_public_parse.bip0340_parse_outcome pk))
            (and (jet_secp_xonly_parse_field.xonly_parsed_result pk mf bkey)
               (and
                  (Memory.Mem.range_perm mf bkey BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bb BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bkey)) (not (@eq Values.block b bb))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
