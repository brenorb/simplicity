### C.jet_secp_scalar_reduce512_run.scalar_reduce512_run
scalar_reduce512_run =
jet_sx_compact.compact_fun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_shift64_executor.secp_shift64_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_scalar_reduce_512
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
     (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx))) scalar_reduce512_initial_regs
  (@nil jet_sx_eval.event) (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
     : option jet_sx_exec.res
### C.jet_secp_scalar_reduce512_run.scalar_reduce512_state
scalar_reduce512_state =
match scalar_reduce512_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_scalar_reduce512_run.scalar_reduce512_limbs
scalar_reduce512_limbs =
@List.map jet_sx_state.cell jet_sx_expr.sx jet_secp_frame.cell_sx
  (jet_sx_state.rcells
     (@List.hd jet_sx_state.region (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))
        (jet_sx_eval.sregs scalar_reduce512_state)))
     : list jet_sx_expr.sx
