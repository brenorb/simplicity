                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                   (Values.Vint flag)) (@Some Memory.Mem.mem mi)),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m set_ge_flag_stmt Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint flag) le) mi ClightBigstep.Out_normal
### C.jet_secp_gej_set_ge_owned.exec_set_ge_tail
exec_set_ge_tail
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (br : Values.block)
         (flag : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m br
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_set_int)
                (@cons Values.val
                   (Values.Vptr br
                      (Integers.Ptrofs.repr
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                   (@cons Values.val
                      (Values.Vint
                         match Integers.Int.eq flag Integers.Int.zero return Integers.Int.int with
