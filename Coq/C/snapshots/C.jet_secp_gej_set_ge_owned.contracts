                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                         (@nil (prod AST.ident BinNums.Z))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero))),
       Clight.eval_lvalue jet_secp_linkage.secp_ge Clight.empty_env le m
         (jet_secp_double_statements.double_point_field jets_secp._r fid jet_secp_curve_statements.curve_fe_type) br
         (Integers.Ptrofs.repr delta) Ctypes.Full
### C.jet_secp_gej_set_ge_owned.exec_set_ge_flag
exec_set_ge_flag
     : forall (le : Maps.PTree.tree Values.val) (m mi : Memory.Mem.mem) (ba br : Values.block)
