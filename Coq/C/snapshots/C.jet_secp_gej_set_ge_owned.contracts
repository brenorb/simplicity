         (set_ge_entry_temps br ba) m
### C.jet_secp_gej_set_ge_owned.eval_gej_set_ge_owned
eval_gej_set_ge_owned
     : forall (m : Memory.Mem.mem) (br ba : Values.block) (x y : forall _ : nat, Integers.Int64.int)
         (flag : Integers.Int.int) (_ : not (@eq Values.block br ba))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_set_ge)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and (jet_secp_fe_nv.fe_at mf br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf br
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (jet_secp_fe_nv.fe_at mf br
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5
                           (jet_secp_point_set_bit.point_set_bit_words (Integers.Int.eq flag Integers.Int.zero))))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf br
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                           (@Some Values.val (Values.Vint flag)))
                        (and
                           (Memory.Mem.range_perm mf br BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              Memtype.Cur Memtype.Freeable)
                           (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b br)) m
                              mf)))))))
### C.jet_secp_gej_set_ge_owned.set_ge_flag_stmt
set_ge_flag_stmt =
match Clight.fn_body jets_secp.f_secp256k1_gej_set_ge return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence h _ => h
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_gej_set_ge_owned.set_ge_copy_stmt
set_ge_copy_stmt =
fun fid : AST.ident =>
Clight.Sassign (jet_secp_double_statements.double_point_field jets_secp._r fid jet_secp_curve_statements.curve_fe_type)
  (jet_secp_curve_statements.curve_affine_field fid jet_secp_curve_statements.curve_fe_type)
     : forall _ : AST.ident, Clight.statement

Arguments set_ge_copy_stmt fid
### C.jet_secp_gej_set_ge_owned.set_ge_tail_stmt
set_ge_tail_stmt =
Clight.Ssequence
  (Clight.Sset jets_secp._t'1
     (jet_secp_double_statements.double_point_field jets_secp._r jets_secp._infinity Ctypesdefs.tint))
  (jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_set_int jets_secp.f_secp256k1_fe_set_int
     (@None AST.ident)
     (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._r jets_secp._z)
        (@cons Clight.expr (Clight.Eunop Cop.Onotbool (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tint) Ctypesdefs.tint)
           (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_gej_set_ge_owned.set_ge_entry_temps
set_ge_entry_temps =
fun br ba : Values.block =>
@Maps.PTree.set Values.val jets_secp._a (Values.Vptr ba Integers.Ptrofs.zero)
  (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr br Integers.Ptrofs.zero)
     (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_gej_set_ge)))
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree Values.val

Arguments set_ge_entry_temps br ba
