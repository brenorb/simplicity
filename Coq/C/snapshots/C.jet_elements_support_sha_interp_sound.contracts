                      (Integers.Ptrofs.unsigned os)))) (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
       @ex Values.block
         (fun b : Values.block => @eq (option Values.block) (@List.nth_error Values.block lb i) (@Some Values.block b))
