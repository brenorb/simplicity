### C.jet_elements_support_sha_interp_sound.local_store_R
local_store_R
     : forall (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int) (bc : Values.block)
         (oc : Integers.Ptrofs.int) (_ : @eq nat (@length Values.block lb) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @List.NoDup Values.block lb) (_ : not (@List.In Values.block bs lb))
         (_ : not (@List.In Values.block bc lb))
         (_ : or (not (@eq Values.block bs bc))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (Integers.Ptrofs.unsigned oc))
