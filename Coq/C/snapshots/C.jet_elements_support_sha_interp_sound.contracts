         (fun x : AST.ident =>
          and (@eq Clight.expr e (Clight.Eaddrof (Clight.Evar x Ctypesdefs.tuint) (Ctypesdefs.tptr Ctypesdefs.tuint)))
            (@eq (option nat) (jet_elements_support_sha_interp.index_of x jet_elements_support_sha_interp.lids)
               (@Some nat i)))
### C.jet_elements_support_sha_interp_sound.arr_ofs
arr_ofs
     : forall (base : Integers.Ptrofs.int) (i : Integers.Int.int) (k : nat)
         (_ : @eq nat k (BinInt.Z.to_nat (Integers.Int.unsigned i)))
         (_ : lt k (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add
                   (BinInt.Z.add (Integers.Ptrofs.unsigned base)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat k)))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))) Integers.Ptrofs.max_unsigned),
       @eq BinNums.Z
         (Integers.Ptrofs.unsigned
            (Integers.Ptrofs.add base
               (Integers.Ptrofs.mul (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                  (Integers.Ptrofs.of_ints i))))
         (BinInt.Z.add (Integers.Ptrofs.unsigned base)
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat k)))
