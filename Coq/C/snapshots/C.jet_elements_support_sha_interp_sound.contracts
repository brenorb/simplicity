### C.jet_elements_support_sha_interp_sound.sha_R
sha_R =
fun (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int) (bc : Values.block)
  (oc : Integers.Ptrofs.int) =>
let so : BinNums.Z := Integers.Ptrofs.unsigned os in
let co : BinNums.Z := Integers.Ptrofs.unsigned oc in
fun (st : jet_elements_support_sha_interp.cst) (le0 : Clight.temp_env) (m : Memory.Mem.mem) =>
and
  (@eq nat (@length Integers.Int.int (jet_elements_support_sha_interp.wv st))
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))))
  (and (@eq nat (@length Integers.Int.int (jet_elements_support_sha_interp.lv st)) (S (S (S (S (S (S (S (S O)))))))))
     (and
        (@eq nat (@length Integers.Int.int (jet_elements_support_sha_interp.sarr st)) (S (S (S (S (S (S (S (S O)))))))))
        (and
           (@eq nat (@length Integers.Int.int (jet_elements_support_sha_interp.chunk st))
              (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))))
           (and
              (le (jet_elements_support_sha_interp.wdef st)
                 (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))
              (and (le (jet_elements_support_sha_interp.ldef st) (S (S (S (S (S (S (S (S O)))))))))
                 (and
                    (forall (i : nat) (x : AST.ident) (_ : lt i (jet_elements_support_sha_interp.wdef st))
                       (_ : @eq (option AST.ident) (@List.nth_error AST.ident jet_elements_support_sha_interp.wids i)
                              (@Some AST.ident x)),
                     @eq (option Values.val) (@Maps.PTree.get Values.val x le0)
                       (@Some Values.val
                          (Values.Vint
                             (@List.nth Integers.Int.int i (jet_elements_support_sha_interp.wv st) Integers.Int.zero))))
                    (and
                       (forall (t : AST.ident) (v : Integers.Int.int)
                          (_ : @eq (option Integers.Int.int)
                                 (jet_elements_support_sha_interp.alookup (jet_elements_support_sha_interp.scratch st)
                                    t) (@Some Integers.Int.int v)),
                        and
                          (@eq (option Values.val) (@Maps.PTree.get Values.val t le0)
                             (@Some Values.val (Values.Vint v)))
                          (and
                             (@eq (option nat)
                                (jet_elements_support_sha_interp.index_of t jet_elements_support_sha_interp.wids)
                                (@None nat))
                             (and (not (@eq AST.ident t jets_elements._s)) (not (@eq AST.ident t jets_elements._chunk)))))
                       (and
                          (@eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._s le0)
                             (@Some Values.val (Values.Vptr bs os)))
                          (and
                             (@eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._chunk le0)
                                (@Some Values.val (Values.Vptr bc oc)))
                             (and
                                (forall (i : nat) (b : Values.block)
                                   (_ : @eq (option Values.block) (@List.nth_error Values.block lb i)
                                          (@Some Values.block b)),
                                 and (Memory.Mem.valid_access m AST.Mint32 b BinNums.Z0 Memtype.Writable)
                                   (forall _ : lt i (jet_elements_support_sha_interp.ldef st),
                                    @eq (option Values.val) (Memory.Mem.load AST.Mint32 m b BinNums.Z0)
                                      (@Some Values.val
                                         (Values.Vint
                                            (@List.nth Integers.Int.int i (jet_elements_support_sha_interp.lv st)
                                               Integers.Int.zero)))))
                                (and
                                   (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S ...)))))))),
                                    and
                                      (@eq (option Values.val)
                                         (Memory.Mem.load AST.Mint32 m bs
                                            (BinInt.Z.add so
                                               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                                  (BinInt.Z.of_nat i))))
                                         (@Some Values.val
                                            (Values.Vint
                                               (@List.nth Integers.Int.int i (jet_elements_support_sha_interp.sarr st)
                                                  Integers.Int.zero))))
                                      (Memory.Mem.valid_access m AST.Mint32 bs
                                         (BinInt.Z.add so
                                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                               (BinInt.Z.of_nat i))) Memtype.Writable))
                                   (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S ...)))))))),
                                    @eq (option Values.val)
                                      (Memory.Mem.load AST.Mint32 m bc
                                         (BinInt.Z.add co
                                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                               (BinInt.Z.of_nat i))))
                                      (@Some Values.val
                                         (Values.Vint
                                            (@List.nth Integers.Int.int i (jet_elements_support_sha_interp.chunk st)
                                               Integers.Int.zero)))))))))))))))
     : forall (_ : list Values.block) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : jet_elements_support_sha_interp.cst) (_ : Clight.temp_env)
         (_ : Memory.Mem.mem), Prop

Arguments sha_R lb%list_scope bs os bc oc st le m
### C.jet_elements_support_sha_interp_sound.sha_F
sha_F =
fun (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int) =>
let so : BinNums.Z := Integers.Ptrofs.unsigned os in
fun m m' : Memory.Mem.mem =>
and
  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : not (@List.In Values.block b lb))
     (_ : or (not (@eq Values.block b bs))
            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) so)
               (BinInt.Z.le
                  (BinInt.Z.add so
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) ofs))),
   @eq (option Values.val) (Memory.Mem.load chunk m' b ofs) (Memory.Mem.load chunk m b ofs))
  (and
     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
        (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b))
     : forall (_ : list Values.block) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Memory.Mem.mem)
         (_ : Memory.Mem.mem), Prop

Arguments sha_F lb%list_scope bs os m m'
