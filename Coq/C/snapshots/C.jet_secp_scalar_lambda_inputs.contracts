### C.jet_secp_scalar_lambda_inputs.scalar_lambda_inputs_from_storage
scalar_lambda_inputs_from_storage
     : forall (va : BinNums.Z) (m : Memory.Mem.mem) (ba : Values.block)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of va)))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block ba jet_secp_scalar_lambda_global.scalar_lambda_block))
         (_ : jet_secp_scalar_lambda_global.scalar_lambda_global_rep m),
       jet_sx_state.rep
         (jet_secp_scalar_lambda_region.scalar_lambda_mixed_rho (jet_secp_scalar_get_b32_numeric.scalar_limb_rho va))
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
            (@cons (prod Values.block BinNums.Z)
               (@pair Values.block BinNums.Z jet_secp_scalar_lambda_global.scalar_lambda_block BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_inputs m
### C.jet_secp_scalar_lambda_inputs.scalar_lambda_mixed_normalized_value
scalar_lambda_mixed_normalized_value
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (jet_secp_scalar_mul512_low.scalar_mul512_input_value
            (jet_secp_scalar_lambda_region.scalar_lambda_mixed_rho
               (jet_secp_scalar_get_b32_numeric.scalar_limb_rho
                  (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                     (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value)))) O)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))
### C.jet_secp_scalar_lambda_inputs.scalar_lambda_mixed_global_value
scalar_lambda_mixed_global_value
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (jet_secp_scalar_mul512_low.scalar_mul512_input_value
            (jet_secp_scalar_lambda_region.scalar_lambda_mixed_rho rho) (S (S (S (S O)))))
         jet_secp_scalar_lambda_global.canonical_lambda_value
### C.jet_secp_scalar_lambda_inputs.scalar_lambda_global_from_region
scalar_lambda_global_from_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (ba : Values.block) (m : Memory.Mem.mem)
         (_ : jet_sx_state.region_ok (jet_secp_scalar_lambda_region.scalar_lambda_mixed_rho rho)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z)
                      (@pair Values.block BinNums.Z jet_secp_scalar_lambda_global.scalar_lambda_block BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))) m (S O)
                jet_secp_scalar_mul_borrowed_function.scalar_mul_borrowed_rhs),
       jet_secp_scalar_lambda_global.scalar_lambda_global_rep m
