### C.jet_secp_multiply_finish_product.radix_value
radix_value =
fun words : forall _ : nat, Integers.Int64.int =>
BinInt.Z.add
  (BinInt.Z.add
     (BinInt.Z.add
        (BinInt.Z.add (Integers.Int64.unsigned (words O))
           (BinInt.Z.mul jet_secp_multiply_checkpoint_columns.radix (Integers.Int64.unsigned (words (S O)))))
        (BinInt.Z.mul (BinInt.Z.pow jet_secp_multiply_checkpoint_columns.radix (BinNums.Zpos (BinNums.xO BinNums.xH)))
           (Integers.Int64.unsigned (words (S (S O))))))
     (BinInt.Z.mul (BinInt.Z.pow jet_secp_multiply_checkpoint_columns.radix (BinNums.Zpos (BinNums.xI BinNums.xH)))
        (Integers.Int64.unsigned (words (S (S (S O)))))))
  (BinInt.Z.mul
     (BinInt.Z.pow jet_secp_multiply_checkpoint_columns.radix (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
     (Integers.Int64.unsigned (words (S (S (S (S O)))))))
     : forall _ : forall _ : nat, Integers.Int64.int, BinNums.Z

Arguments radix_value words%function_scope
