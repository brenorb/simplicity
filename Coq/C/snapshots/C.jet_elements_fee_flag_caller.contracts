### C.jet_elements_fee_flag_caller.elements_output_fee_flag_contract
elements_output_fee_flag_contract
     : jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_output_is_fee
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))
         (@jet_elements_indexed_ptr.indexed_ptr_rep jet_elements_prim.Elements.environment jet_elements_prim.txOutput
            (fun e : jet_elements_prim.Elements.environment =>
             jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx e)) processed_fee_rep
            (BinNums.Zpos
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
            BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
         (fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
          @Some (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))) (processed_fee_result a environment))
### C.jet_elements_fee_flag_caller.processed_fee_empty
processed_fee_empty =
fun o : jet_elements_prim.txOutput =>
match jet_elements_prim.txoScript o return bool with
| nil => true
| cons _ _ => false
end
     : forall _ : jet_elements_prim.txOutput, bool

Arguments processed_fee_empty o
### C.jet_elements_fee_flag_caller.processed_fee_bit
processed_fee_bit =
fun o : jet_elements_prim.txOutput =>
jet_elements_fee_flag_exec.fee_classifier (processed_fee_empty o)
  (@jet_elements_asset_jets.conf_prefix Digest.hash256
     (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256 (jet_elements_prim.txoAsset o)))
  (@jet_elements_asset_jets.conf_prefix Integers.Int64.int
     (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (jet_elements_prim.txoAmount o)))
     : forall _ : jet_elements_prim.txOutput, bool

Arguments processed_fee_bit o
### C.jet_elements_fee_flag_caller.processed_fee_rep
processed_fee_rep =
fun (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (o : jet_elements_prim.txOutput) =>
and
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint8unsigned m b
        (BinInt.Z.add ofs
           (BinNums.Zpos
              (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
     (@Some Values.val (Values.Vint (jet_elements_fee_flag_exec.fee_bool_int (processed_fee_empty o)))))
  (and
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint32 m b
           (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        (@Some Values.val
           (Values.Vint
              (@jet_elements_asset_jets.conf_prefix Digest.hash256
                 (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256 (jet_elements_prim.txoAsset o))))))
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint32 m b
           (BinInt.Z.add ofs
              (BinNums.Zpos
                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
        (@Some Values.val
           (Values.Vint
              (@jet_elements_asset_jets.conf_prefix Integers.Int64.int
                 (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int
                    (jet_elements_prim.txoAmount o)))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : jet_elements_prim.txOutput), Prop

Arguments processed_fee_rep m b ofs%Z_scope o
### C.jet_elements_fee_flag_caller.processed_fee_pcells
processed_fee_pcells =
fun o : jet_elements_prim.txOutput => @cons (option bool) (@Some bool (processed_fee_bit o)) (@nil (option bool))
     : forall _ : jet_elements_prim.txOutput, list BitMachine.Cell

Arguments processed_fee_pcells o
### C.jet_elements_fee_flag_caller.processed_fee_pointer
processed_fee_pointer =
Clight.Ebinop Cop.Oadd
  (Clight.Etempvar jets_elements._t'5 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))
  (Clight.Etempvar jets_elements._i Ctypesdefs.tulong)
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr))
     : Clight.expr
### C.jet_elements_fee_flag_caller.processed_fee_setup_call
processed_fee_setup_call =
Clight.Ssequence
  (Clight.Sset jets_elements._t'4
     (Clight.Efield
        (Clight.Ederef
           (Clight.Etempvar jets_elements._env (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)))
           (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr)) jets_elements._tx
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr))))
  (Clight.Ssequence
     (Clight.Sset jets_elements._t'5
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_elements._t'4
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr)))
              (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr)) jets_elements._output
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr))))
     (Clight.Scall (@Some AST.ident jets_elements._t'2)
        (Clight.Evar jets_elements._isFee
           (Ctypes.Tfunction
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)) Ctypes.Tnil)
              Ctypesdefs.tbool AST.cc_default)) (@cons Clight.expr processed_fee_pointer (@nil Clight.expr))))
     : Clight.statement
### C.jet_elements_fee_flag_caller.processed_fee_then
processed_fee_then =
Clight.Ssequence processed_fee_setup_call
  (Clight.Scall (@None AST.ident)
     (Clight.Evar jets_elements._writeBit
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
        (@cons Clight.expr (Clight.Etempvar jets_elements._t'2 Ctypesdefs.tbool) (@nil Clight.expr))))
     : Clight.statement
### C.jet_elements_fee_flag_caller.processed_fee_result
processed_fee_result =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
match
  @List.nth_error jet_elements_prim.txOutput
    (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit)))
with
| Some o =>
    @inr unit (sum unit unit)
      match processed_fee_bit o return (sum unit unit) with
      | true => @inr unit unit tt
      | false => @inl unit unit tt
      end
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) Ty.Unit)) tt
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit Ty.Unit))

Arguments processed_fee_result a environment
