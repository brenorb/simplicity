         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._i le)
                (@Some Values.val (Values.Vlong r))) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add
                   (BinInt.Z.add base
                      (BinInt.Z.mul
                         (BinNums.Zpos
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                         (Integers.Int64.unsigned r)))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                Integers.Ptrofs.max_unsigned),
       Clight.eval_expr jet_elements_linkage.elements_ge e le m processed_fee_pointer
         (Values.Vptr b
            (Integers.Ptrofs.repr
               (BinInt.Z.add base
                  (BinInt.Z.mul
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                     (Integers.Int64.unsigned r)))))
### C.jet_elements_fee_flag_caller.exec_processed_fee_then
exec_processed_fee_then
     : forall (bl : Values.block) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (o : jet_elements_prim.txOutput) (be : Values.block) (ebase : BinNums.Z) (bt : Values.block)
         (txbase : BinNums.Z) (bin : Values.block) (inbase : BinNums.Z) (r : Integers.Int64.int)
         (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (edge cur : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._i le)
                (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase)))) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le
                (BinInt.Z.add ebase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 txbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add txbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 inbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add
                   (BinInt.Z.add inbase
                      (BinInt.Z.mul
                         (BinNums.Zpos
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                         (Integers.Int64.unsigned r)))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m be (BinInt.Z.add ebase BinNums.Z0))
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr m bt
                   (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
         (_ : processed_fee_rep m bin
                (BinInt.Z.add inbase
                   (BinInt.Z.mul
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                      (Integers.Int64.unsigned r))) o)
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cur (BinNums.Zpos BinNums.xH)),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
                  (jet_elements_version_exec.elements_version_locals bl) le m processed_fee_then Events.E0 lef mf
                  ClightBigstep.Out_normal)
               (jet_elements_effects.write_effect m mf bd dbase bw edge cur (BinNums.Zpos BinNums.xH)
                  (processed_fee_pcells o))))
