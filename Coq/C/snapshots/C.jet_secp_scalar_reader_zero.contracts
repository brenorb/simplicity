### C.jet_secp_scalar_reader_zero.scalar_reader_zero_value
scalar_reader_zero_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (jet_secp_scalar_zero_numeric.scalar_value (scalar_reader_zero_rho rho layout))
         (jet_secp_scalar_overflow_numeric.scalar_limb_value
            (jet_secp_scalar_reader_value.scalar_reader_limb rho layout))
### C.jet_secp_scalar_reader_zero.scalar_reader_zero_rep
scalar_reader_zero_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout (jet_secp_scalar_reader_lifecycle.scalar_reader_final_regs bi edge) m),
       jet_sx_state.rep (scalar_reader_zero_rho rho (jet_sx_state.lay layout))
         (@cons (prod Values.block BinNums.Z)
            (@pair Values.block BinNums.Z (jet_sx_state.blk layout O) (jet_sx_state.bas layout O))
            (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_zero_exec.scalar_initial_regs m
### C.jet_secp_scalar_reader_zero.scalar_reader_zero_canonical_value
scalar_reader_zero_canonical_value
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z
         (jet_secp_scalar_zero_numeric.scalar_value
            (scalar_reader_zero_rho
               (jet_secp_wrapper_run.read_fe_rho
                  (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) layout))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))
### C.jet_secp_scalar_reader_zero.eval_scalar_zero_after_reader
eval_scalar_zero_after_reader
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (m : Memory.Mem.mem) (layout : jet_sx_state.layout) (bi : Values.block) (edge : Integers.Ptrofs.int)
         (_ : jet_sx_state.rep
                (jet_secp_wrapper_run.read_fe_rho
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) layout
                (jet_secp_scalar_reader_lifecycle.scalar_reader_final_regs bi edge) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_is_zero)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  (jet_readBit_layout.bit_int
                     (Bit.toBool (@jet_secp_canonical_scalar_zero.canonical_scalar_is_zero Alg.CoreFunSem value)))))
            (and
               (jet_sx_state.rep
                  (scalar_reader_zero_rho
                     (jet_secp_wrapper_run.read_fe_rho
                        (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                     (jet_sx_state.lay layout))
                  (@cons (prod Values.block BinNums.Z)
                     (@pair Values.block BinNums.Z (jet_sx_state.blk layout O) (jet_sx_state.bas layout O))
                     (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_zero_exec.scalar_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf (jet_sx_state.blk layout O) (jet_sx_state.bas layout O)
                     (BinInt.Z.add (jet_sx_state.bas layout O)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      not
                        (jet_sx_state.foot
                           (@cons (prod Values.block BinNums.Z)
                              (@pair Values.block BinNums.Z (jet_sx_state.blk layout O) (jet_sx_state.bas layout O))
                              (@nil (prod Values.block BinNums.Z)))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape jet_secp_scalar_zero_exec.scalar_initial_regs) b pos)) m mf))))
### C.jet_secp_scalar_reader_zero.scalar_reader_zero_rho
scalar_reader_zero_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) (n : nat) =>
match n return Integers.Int64.int with
| O => Integers.Int64.zero
| S n0 =>
    match n0 return Integers.Int64.int with
    | O => jet_secp_scalar_reader_value.scalar_reader_limb rho layout O
    | S n1 =>
        match n1 return Integers.Int64.int with
        | O => jet_secp_scalar_reader_value.scalar_reader_limb rho layout (S O)
        | S n2 =>
            match n2 return Integers.Int64.int with
            | O => jet_secp_scalar_reader_value.scalar_reader_limb rho layout (S (S O))
            | S n3 =>
                match n3 return Integers.Int64.int with
                | O => jet_secp_scalar_reader_value.scalar_reader_limb rho layout (S (S (S O)))
                | S _ => Integers.Int64.zero
                end
            end
        end
    end
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : nat),
       Integers.Int64.int

Arguments scalar_reader_zero_rho (rho layout)%function_scope n%nat_scope
