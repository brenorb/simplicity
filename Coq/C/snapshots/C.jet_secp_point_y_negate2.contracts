### C.jet_secp_point_y_negate2.eval_point_y_negate2
eval_point_y_negate2
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bp : Values.block)
         (_ : jet_secp_field_sum_bounds.field_scaled_bounds (BinNums.Zpos (BinNums.xO BinNums.xH)) w)
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val
                  (Values.Vptr bp
                     (Integers.Ptrofs.repr
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                  (@cons Values.val
                     (Values.Vptr bp
                        (Integers.Ptrofs.repr
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@cons Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bp
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (jet_secp_multiply_normalize_bridge.words5 (point_y_neg2_words w)))
               (and
                  (Memory.Mem.range_perm mf bp BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (point_y_neg2_words w))
                        (BinInt.Z.sub
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))) jet_secp_fe_math.feP)
                           (jet_secp_multiply_finish_product.radix_value w)))
                     (and (jet_secp_square_columns.square_input_bounds (point_y_neg2_words w))
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (pos : BinNums.Z) =>
                            or (not (@eq Values.block b bp))
                              (or
                                 (BinInt.Z.lt pos
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (BinInt.Z.le
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    pos))) m mf))))))
