### C.jet_secp_point_y_negate2.point_y_neg2_words
point_y_neg2_words =
fun (w : forall _ : nat, Integers.Int64.int) (i : nat) =>
Integers.Int64.sub
  (Integers.Int64.repr
     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))) (jet_secp_field_negate_values.negate_mask i)))
  (w i)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

