### C.jet_secp_point_y_negate2.point_y_neg2_out
point_y_neg2_out =
@List.map nat jet_sx_expr.sx point_y_neg2_expr
  (@cons nat O
     (@cons nat (S O) (@cons nat (S (S O)) (@cons nat (S (S (S O))) (@cons nat (S (S (S (S O)))) (@nil nat))))))
