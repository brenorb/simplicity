                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                     (@cons Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))
