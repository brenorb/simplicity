### C.jet_secp_point_y_negate2.point_y_neg2_args
point_y_neg2_args =
@cons jet_sx_expr.sx
  (jet_sx_expr.XP O (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
  (@cons jet_sx_expr.sx
