### C.jet_secp_modinv_var_entry.exec_inv_initializers
exec_inv_initializers
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (e : Clight.env)
         (le : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta (jet_sx_eval.sregs inv_start_state) m)
         (_ : jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps inv_start_state) le)
         (_ : jet_sx_eval.ematch beta (@snd (list jet_sx_state.region) jet_sx_eval.venv inv_start_alloc) e),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m inv_initializers Events.E0 lef mf
                  ClightBigstep.Out_normal)
               (and (jet_sx_state.rep rho beta (jet_sx_eval.sregs inv_init_state) mf)
                  (and (jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps inv_init_state) lef)
                     (and
                        (forall (high : bool) (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                         @eq (option Values.val)
                           (Memory.Mem.load AST.Mint64 mf
                              (jet_sx_state.blk beta
                                 match high return nat with
                                 | true => S (S (S O))
                                 | false => S (S O)
                                 end)
                              (BinInt.Z.add
                                 (jet_sx_state.bas beta
                                    match high return nat with
                                    | true => S (S (S O))
                                    | false => S (S O)
                                    end)
                                 (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                    (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong (inv_init_word high i))))
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot beta
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape (jet_sx_eval.sregs inv_start_state)) b ofs)) m mf))))))
### C.jet_secp_modinv_var_entry.inv_entry_and_initializers
inv_entry_and_initializers
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta inv_start_regs m),
       @ex (list (prod Values.block BinNums.Z))
         (fun betaN : list (prod Values.block BinNums.Z) =>
          @ex Clight.env
            (fun e : Clight.env =>
             @ex Clight.temp_env
               (fun le : Clight.temp_env =>
                @ex Memory.Mem.mem
                  (fun mi : Memory.Mem.mem =>
                   @ex Clight.temp_env
                     (fun lef : Clight.temp_env =>
                      @ex Memory.Mem.mem
                        (fun mf : Memory.Mem.mem =>
                         and
                           (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_modinv64_var
                              (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta))
                                 inv_start_args) m e le mi)
                           (and
                              (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le mi inv_initializers
                                 Events.E0 lef mf ClightBigstep.Out_normal)
                              (and
                                 (jet_sx_state.rep rho (@app (prod Values.block BinNums.Z) beta betaN)
                                    (jet_sx_eval.sregs inv_init_state) mf)
                                 (and
                                    (jet_sx_eval.tmatch rho (@app (prod Values.block BinNums.Z) beta betaN)
                                       (jet_sx_eval.stemps inv_init_state) lef)
                                    (and
                                       (jet_sx_eval.ematch (@app (prod Values.block BinNums.Z) beta betaN)
                                          (@snd (list jet_sx_state.region) jet_sx_eval.venv inv_start_alloc) e)
                                       (and
                                          (forall later : forall _ : nat, Integers.Int64.int,
                                           and
                                             (jet_secp_modinv_de_numeric.de62_state_bounds (inv_initial_de_rho later))
                                             (forall (high : bool) (i : nat) (_ : lt i (S (S (S (S (...)))))),
                                              @eq (option Values.val)
                                                (Memory.Mem.load AST.Mint64 mf
                                                   (jet_sx_state.blk (@app (prod Values.block BinNums.Z) beta betaN)
                                                      match high return nat with
                                                      | true => S (S (S O))
                                                      | false => S (S O)
                                                      end)
                                                   (BinInt.Z.add
                                                      (jet_sx_state.bas (@app (prod Values.block BinNums.Z) beta betaN)
                                                         match high return nat with
                                                         | true => S (S ...)
                                                         | false => S (S O)
                                                         end)
                                                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (...)))
                                                         (BinInt.Z.of_nat i))))
                                                (@Some Values.val
                                                   (Values.Vlong
                                                      (jet_secp_modinv_de_numeric.de62_array
                                                         (inv_initial_de_rho later) high i)))))
                                          (and
                                             (@List.Forall (prod Values.block BinNums.Z)
                                                (fun p : prod Values.block BinNums.Z =>
                                                 not (Memory.Mem.valid_block m (@fst Values.block BinNums.Z p))) betaN)
                                             (jet_sx_mem.lframe
                                                (fun (b : Values.block) (ofs : BinNums.Z) =>
                                                 not
                                                   (jet_sx_state.foot (@app (prod Values.block BinNums.Z) beta betaN)
                                                      (@List.map jet_sx_state.region
                                                         (prod (prod (list ...) bool) (option BinNums.Z))
                                                         jet_sx_state.rshape (jet_sx_eval.sregs inv_start_state)) b ofs))
                                                m mf)))))))))))))
