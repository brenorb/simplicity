                       (Ctypes.mk_attr false (@None BinNums.N)))))
              (@cons (prod AST.ident (prod nat Ctypes.type))
                 (@pair AST.ident (prod nat Ctypes.type)
                    (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))
                    (@pair nat Ctypes.type (S (S (S (S (S (S O))))))
                       (Ctypes.Tstruct
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))
                          (Ctypes.mk_attr false (@None BinNums.N))))) (@nil (prod AST.ident (prod nat Ctypes.type))))))))
     : prod (list jet_sx_state.region) jet_sx_eval.venv
### C.jet_secp_modinv_var_entry.inv_start_temps
inv_start_temps =
@Maps.PTree.set jet_sx_expr.sx jets_secp._modinfo (jet_sx_expr.XP (S O) BinNums.Z0)
  (@Maps.PTree.set jet_sx_expr.sx jets_secp._x (jet_sx_expr.XP O BinNums.Z0) (Maps.PTree.empty jet_sx_expr.sx))
     : Maps.PTree.tree jet_sx_expr.sx
### C.jet_secp_modinv_var_entry.inv_start_state
inv_start_state =
jet_sx_eval.mkst inv_start_temps
  (@app jet_sx_state.region inv_start_regs (@fst (list jet_sx_state.region) jet_sx_eval.venv inv_start_alloc))
  (@nil jet_sx_eval.event) (S (S (S (S (S O)))))
     : jet_sx_eval.sstate
### C.jet_secp_modinv_var_entry.inv_start_parts
inv_start_parts =
jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_modinv64_var)
     : prod (list Clight.statement) Clight.statement
### C.jet_secp_modinv_var_entry.inv_initializers
inv_initializers =
jet_secp_statement_prefix.statement_sequence
  (@List.firstn Clight.statement (S (S (S (S (S (S (S (S (S (S O))))))))))
     (@fst (list Clight.statement) Clight.statement inv_start_parts)) Clight.Sskip
     : Clight.statement
### C.jet_secp_modinv_var_entry.inv_after_initializers
inv_after_initializers =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement (S (S (S (S (S (S (S (S (S (S O))))))))))
     (@fst (list Clight.statement) Clight.statement inv_start_parts))
  (@snd (list Clight.statement) Clight.statement inv_start_parts)
     : Clight.statement
### C.jet_secp_modinv_var_entry.inv_init_run
inv_init_run =
jet_sx_exec.xstmt (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (@nil (prod AST.ident jet_sx_exec.fentry))
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  (@snd (list jet_sx_state.region) jet_sx_eval.venv inv_start_alloc) inv_start_state inv_initializers
     : option jet_sx_exec.res
### C.jet_secp_modinv_var_entry.inv_init_state
inv_init_state =
match inv_init_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ => inv_start_state
    end
| None => inv_start_state
end
     : jet_sx_eval.sstate
### C.jet_secp_modinv_var_entry.inv_init_word
inv_init_word =
fun (high : bool) (i : nat) =>
match andb high (PeanoNat.Nat.eqb i O) return Integers.Int64.int with
| true => Integers.Int64.one
| false => Integers.Int64.zero
end
     : forall (_ : bool) (_ : nat), Integers.Int64.int

Arguments inv_init_word high%bool_scope i%nat_scope
### C.jet_secp_modinv_var_entry.inv_init_sx
inv_init_sx =
fun (high : bool) (i : nat) =>
jet_sx_expr.XI2L Ctypes.Signed
  (jet_sx_expr.XIc
     match andb high (PeanoNat.Nat.eqb i O) return Integers.Int.int with
     | true => Integers.Int.one
     | false => Integers.Int.zero
     end)
     : forall (_ : bool) (_ : nat), jet_sx_expr.sx

Arguments inv_init_sx high%bool_scope i%nat_scope
### C.jet_secp_modinv_var_entry.inv_initial_de_rho
inv_initial_de_rho =
fun (later : forall _ : nat, Integers.Int64.int) (n : nat) =>
match PeanoNat.Nat.ltb n (S (S (S (S (S (S (S (S (S (S O)))))))))) return Integers.Int64.int with
| true =>
    match PeanoNat.Nat.eqb n (S (S (S (S (S O))))) return Integers.Int64.int with
    | true => Integers.Int64.one
    | false => Integers.Int64.zero
    end
| false => later n
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments inv_initial_de_rho later%function_scope n%nat_scope
