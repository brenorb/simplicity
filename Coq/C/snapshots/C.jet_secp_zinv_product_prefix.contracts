### C.jet_secp_zinv_product_prefix.zinv_tight_square
zinv_tight_square
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_field_mul_small.mul_small_input_bounds w),
       jet_secp_square_columns.square_input_bounds w
### C.jet_secp_zinv_product_prefix.exec_zinv_first_products
exec_zinv_first_products
     : forall (a b : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bo bz ba bb : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._bzinv le)
                (@Some Values.val (Values.Vptr bb Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._az e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bo jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._z12 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bz jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_sqr e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bo
                   (@cons Values.block bz (@cons Values.block ba (@cons Values.block bb (@nil Values.block))))))
         (_ : jet_secp_square_columns.square_input_bounds a) (_ : jet_secp_square_columns.square_input_bounds b)
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bz BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m zinv_first_products Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bo BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_mul_storage.point_mul_words a b)))
               (and
                  (jet_secp_fe_nv.fe_at mf bz BinNums.Z0
                     (jet_secp_multiply_normalize_bridge.words5
                        (jet_secp_square_numeric.square_words (jet_secp_point_mul_storage.point_mul_words a b))))
                  (and
                     (jet_secp_fe_nv.fe_at mf ba
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (jet_secp_multiply_normalize_bridge.words5 a))
                     (and (jet_secp_fe_nv.fe_at mf bb BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 b))
                        (and
                           (Memory.Mem.range_perm mf bo BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bz BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf ba BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bb BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (@eq BinNums.Z
                                          (BinInt.Z.modulo
                                             (jet_secp_multiply_finish_product.radix_value
                                                (jet_secp_point_mul_storage.point_mul_words a b)) jet_secp_fe_math.feP)
                                          (BinInt.Z.modulo
                                             (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value a)
                                                (jet_secp_multiply_finish_product.radix_value b)) jet_secp_fe_math.feP))
                                       (and
                                          (@eq BinNums.Z
                                             (BinInt.Z.modulo
                                                (jet_secp_multiply_finish_product.radix_value
                                                   (jet_secp_square_numeric.square_words
                                                      (jet_secp_point_mul_storage.point_mul_words a b)))
                                                jet_secp_fe_math.feP)
                                             (BinInt.Z.modulo
                                                (BinInt.Z.mul
                                                   (jet_secp_multiply_finish_product.radix_value
                                                      (jet_secp_point_mul_storage.point_mul_words a b))
                                                   (jet_secp_multiply_finish_product.radix_value
                                                      (jet_secp_point_mul_storage.point_mul_words a b)))
                                                jet_secp_fe_math.feP))
                                          (and
                                             (jet_secp_field_mul_small.mul_small_input_bounds
                                                (jet_secp_point_mul_storage.point_mul_words a b))
                                             (and
                                                (jet_secp_field_mul_small.mul_small_input_bounds
                                                   (jet_secp_square_numeric.square_words
                                                      (jet_secp_point_mul_storage.point_mul_words a b)))
                                                (jet_sx_mem.lframe (zinv_product_frame bo bz ba bb) m mf))))))))))))))
### C.jet_secp_zinv_product_prefix.zinv_first_products
zinv_first_products =
jet_secp_statement_prefix.statement_sequence
  (@cons Clight.statement jet_secp_zinv_initial_products.zinv_az_statement
     (@cons Clight.statement jet_secp_zinv_initial_products.zinv_z12_statement (@nil Clight.statement))) Clight.Sskip
     : Clight.statement
### C.jet_secp_zinv_product_prefix.zinv_product_frame
zinv_product_frame =
fun (bo bz ba bb bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bo))
  (and (not (@eq Values.block bx bz))
     (and
        (or (not (@eq Values.block bx ba))
           (or
              (BinInt.Z.lt pos
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
              (BinInt.Z.le
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                 pos))) (not (@eq Values.block bx bb))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments zinv_product_frame bo bz ba bb bx pos%Z_scope
