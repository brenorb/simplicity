### C.jet_secp_modinfo_fe_global.modinfo_fe_words_count
modinfo_fe_words_count
     : @eq nat (@length Integers.Int64.int modinfo_fe_words) (S (S (S (S (S (S O))))))
### C.jet_secp_modinfo_fe_global.modinfo_fe_modulus_value
modinfo_fe_modulus_value
     : @eq BinNums.Z
         (BinInt.Z.add
            (Integers.Int64.signed
               (Integers.Int64.repr
                  (BinNums.Zneg
                     (BinNums.xI
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xO
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO
                                                                     (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))))
            (BinInt.Z.mul
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
               (Integers.Int64.signed
                  (Integers.Int64.repr
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))
         jet_secp_fe_math.feP
### C.jet_secp_modinfo_fe_global.modinfo_fe_inverse62
modinfo_fe_inverse62
     : @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (BinNums.Zneg
                  (BinNums.xI
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xI
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO
                                                                     (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))))))))
               (BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xI
                                                               (BinNums.xI
                                                                  (BinNums.xO
                                                                     (BinNums.xI (BinNums.xO (BinNums.xI ...))))))))))))))))))))))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (BinNums.Zpos BinNums.xH)
