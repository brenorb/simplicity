### C.jet_secp_modinfo_fe_global.modinfo_fe_global_initializes
modinfo_fe_global_initializes
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       modinfo_fe_global_rep m
### C.jet_secp_modinfo_fe_global.modinfo_fe_global_readonly_initial
modinfo_fe_global_readonly_initial
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m))
         (ofs : BinNums.Z), not (Memory.Mem.perm m modinfo_fe_block ofs Memtype.Max Memtype.Writable)
### C.jet_secp_modinfo_fe_global.modinfo_fe_global_unchanged
modinfo_fe_global_unchanged
     : forall (m m' : Memory.Mem.mem)
         (_ : Memory.Mem.unchanged_on (fun (b : Values.block) (_ : BinNums.Z) => @eq Values.block b modinfo_fe_block) m
                m') (_ : modinfo_fe_global_rep m), modinfo_fe_global_rep m'
### C.jet_secp_modinfo_fe_global.modinfo_fe_global_lframe
modinfo_fe_global_lframe
     : forall (m mf : Memory.Mem.mem) (P : forall (_ : Values.block) (_ : BinNums.Z), Prop)
         (_ : modinfo_fe_global_rep m) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall pos : BinNums.Z, P modinfo_fe_block pos), modinfo_fe_global_rep mf
### C.jet_secp_modinfo_fe_global.modinfo_fe_words
modinfo_fe_words =
@cons Integers.Int64.int
  (Integers.Int64.repr
     (BinNums.Zneg
        (BinNums.xI
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xI
                       (BinNums.xO
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
  (@cons Integers.Int64.int Integers.Int64.zero
     (@cons Integers.Int64.int Integers.Int64.zero
        (@cons Integers.Int64.int Integers.Int64.zero
           (@cons Integers.Int64.int
              (Integers.Int64.repr
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
              (@cons Integers.Int64.int
                 (Integers.Int64.repr
                    (BinNums.Zpos
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI (...))))))))))))))))))
                 (@nil Integers.Int64.int))))))
     : list Integers.Int64.int
### C.jet_secp_modinfo_fe_global.modinfo_fe_block
modinfo_fe_block = jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_const_modinfo_fe
     : Values.block
### C.jet_secp_modinfo_fe_global.modinfo_fe_global_rep
modinfo_fe_global_rep =
fun m : Memory.Mem.mem =>
and (Memory.Mem.valid_block m modinfo_fe_block)
  (and
     (Memory.Mem.range_perm m modinfo_fe_block BinNums.Z0
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))) Memtype.Cur
        Memtype.Readable)
     (forall (i : nat) (w : Integers.Int64.int)
        (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int modinfo_fe_words i)
               (@Some Integers.Int64.int w)),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m modinfo_fe_block
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong w))))
     : forall _ : Memory.Mem.mem, Prop

Arguments modinfo_fe_global_rep m
