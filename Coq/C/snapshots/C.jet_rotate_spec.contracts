### C.jet_rotate_spec.word8_reverse_items_spec
@word8_reverse_items_spec
     : forall term : Alg.Core.Algebra,
       @eq (list (Alg.Core.domain term (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))) (Ty.Sum Ty.Unit Ty.Unit)))
         (@List.rev
            (Alg.Core.domain term (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))) (Ty.Sum Ty.Unit Ty.Unit))
            (@vector_items_spec (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))) term))
         (@List.map nat (Alg.Core.domain term (Word.Word (S (S (S O)))) (Ty.Sum Ty.Unit Ty.Unit))
            (fun i : nat => @jet_word_bit_spec.word_bit_spec (S (S (S O))) i term)
            (List.seq O (S (S (S (S (S (S (S (S O))))))))))
### C.jet_rotate_spec.left_rotate_control_step_parametric
left_rotate_control_step_parametric
     : forall (m : nat) (X : Ty.Ty) (n i : nat),
       @Alg.Core.Parametric (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Prod (Word.Word m) (Word.Vector X n))
         (@left_rotate_control_step m X n i)
### C.jet_rotate_spec.left_rotate_controls_spec_parametric
left_rotate_controls_spec_parametric
     : forall (m : nat) (X : Ty.Ty) (n : nat) (indices : list nat),
       @Alg.Core.Parametric (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Vector X n)
         (@left_rotate_controls_spec m X n indices)
### C.jet_rotate_spec.left_rotate_word_spec_parametric
left_rotate_word_spec_parametric
     : forall m n : nat,
       @Alg.Core.Parametric (Ty.Prod (Word.Word m) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n) (@left_rotate_word_spec m n)
### C.jet_rotate_spec.left_rotate_byte_spec_parametric
left_rotate_byte_spec_parametric
     : forall s : jet_left_rotate_wide_exec.byte_rotate_size,
       @Alg.Core.Parametric
         (Ty.Prod (Word.Word (S (S (S O))))
            (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s))))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s)))
         (@left_rotate_byte_spec s)
### C.jet_rotate_spec.vector_items_spec
vector_items_spec =
fix vector_items_spec (X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra) {struct n} :
    list (Alg.Core.domain term (Word.Vector X n) X) :=
  match n as n0 return (list (Alg.Core.domain term (Word.Vector X n0) X)) with
  | O =>
      @cons (Alg.Core.domain term (Word.Vector X O) (Word.Vector X O)) (@VC.iden (Word.Vector X O) term)
        (@nil (Alg.Core.domain term (Word.Vector X O) (Word.Vector X O)))
  | S n0 =>
      @app (Alg.Core.domain term (Ty.Prod (Word.Vector X n0) (Word.Vector X n0)) X)
        (@List.map (Alg.Core.domain term (Word.Vector X n0) X)
           (Alg.Core.domain term (Ty.Prod (Word.Vector X n0) (Word.Vector X n0)) X)
           (@VC.take (Word.Vector X n0) (Word.Vector X n0) X term) (vector_items_spec X n0 term))
        (@List.map (Alg.Core.domain term (Word.Vector X n0) X)
           (Alg.Core.domain term (Ty.Prod (Word.Vector X n0) (Word.Vector X n0)) X)
           (@VC.drop (Word.Vector X n0) (Word.Vector X n0) X term) (vector_items_spec X n0 term))
  end
     : forall (X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra), list (Alg.Core.domain term (Word.Vector X n) X)

Arguments vector_items_spec X%ty_scope n%nat_scope {term}
### C.jet_rotate_spec.left_rotate_control_step
left_rotate_control_step =
fun (m : nat) (X : Ty.Ty) (n i : nat) (term : Alg.Core.Algebra) =>
@VC.pair (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Word m) (Word.Vector X n) term
  (@VC.take (Word.Word m) (Word.Vector X n) (Word.Word m) term (@VC.iden (Word.Word m) term))
  (@VC.comp (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector X n))
     (Word.Vector X n) term
     (@VC.pair (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector X n) term
        (@VC.take (Word.Word m) (Word.Vector X n) (Ty.Sum Ty.Unit Ty.Unit) term
           (@jet_word_bit_spec.word_bit_spec m i term))
        (@VC.drop (Word.Word m) (Word.Vector X n) (Word.Vector X n) term (@VC.iden (Word.Vector X n) term)))
     (@Bit.cond (Word.Vector X n) (Word.Vector X n) term (@Word.left_rotate1 X n term)
        (@VC.iden (Word.Vector X n) term)))
     : forall (m : nat) (X : Ty.Ty) (n _ : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Prod (Word.Word m) (Word.Vector X n))

Arguments left_rotate_control_step m%nat_scope X%ty_scope (n i)%nat_scope {term}
### C.jet_rotate_spec.left_rotate_controls_spec
left_rotate_controls_spec =
fix left_rotate_controls_spec
  (m : nat) (X : Ty.Ty) (n : nat) (indices : list nat) (term : Alg.Core.Algebra) {struct n} :
    Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Vector X n) :=
  match n as n0 return (Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n0)) (Word.Vector X n0)) with
  | O =>
      match indices return (Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X O)) (Word.Vector X O)) with
      | nil => @VC.drop (Word.Word m) (Word.Vector X O) (Word.Vector X O) term (@VC.iden (Word.Vector X O) term)
      | cons i _ =>
          @VC.comp (Ty.Prod (Word.Word m) (Word.Vector X O)) (Ty.Prod (Word.Word m) (Word.Vector X O))
            (Word.Vector X O) term (@left_rotate_control_step m X O i term)
            (@VC.drop (Word.Word m) (Word.Vector X O) (Word.Vector X O) term (@VC.iden (Word.Vector X O) term))
      end
  | S n0 =>
      match
        indices return (Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X (S n0))) (Word.Vector X (S n0)))
      with
      | nil =>
          @VC.drop (Word.Word m) (Word.Vector X (S n0)) (Word.Vector X (S n0)) term
            (@VC.iden (Word.Vector X (S n0)) term)
      | cons i rest =>
          @VC.comp (Ty.Prod (Word.Word m) (Word.Vector X (S n0))) (Ty.Prod (Word.Word m) (Word.Vector X (S n0)))
            (Word.Vector X (S n0)) term (@left_rotate_control_step m X (S n0) i term)
            (@eq_rect Ty.Ty (Word.Vector (Ty.Prod X X) n0)
               (fun V : Ty.Ty => Alg.Core.domain term (Ty.Prod (Word.Word m) V) V)
               (left_rotate_controls_spec m (Ty.Prod X X) n0 rest term) (Word.Vector X (S n0))
               (@eq_sym Ty.Ty (Word.Vector X (S n0)) (Word.Vector (Ty.Prod X X) n0) (@Word.VectorPromote X n0)))
      end
  end
     : forall (m : nat) (X : Ty.Ty) (n : nat) (_ : list nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Vector X n)

Arguments left_rotate_controls_spec m%nat_scope X%ty_scope n%nat_scope indices%list_scope {term}
### C.jet_rotate_spec.left_rotate_word_spec
left_rotate_word_spec =
fun (m n : nat) (term : Alg.Core.Algebra) =>
@left_rotate_controls_spec m (Ty.Sum Ty.Unit Ty.Unit) n (List.seq O (PeanoNat.Nat.pow (S (S O)) m)) term
     : forall (m n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n)

Arguments left_rotate_word_spec (m n)%nat_scope {term}
### C.jet_rotate_spec.left_rotate_byte_spec
left_rotate_byte_spec =
fun (s : jet_left_rotate_wide_exec.byte_rotate_size) (term : Alg.Core.Algebra) =>
@left_rotate_word_spec (S (S (S O))) (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s)) term
     : forall (s : jet_left_rotate_wide_exec.byte_rotate_size) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod (Word.Word (S (S (S O))))
            (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s))))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (jet_wide.wide_log (jet_left_rotate_wide_exec.byte_rotate_width s)))

Arguments left_rotate_byte_spec s {term}
