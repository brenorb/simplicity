### C.jet_elements_effects.write_effect_nil
write_effect_nil
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (_ : jet_frame_layout.frame_fields_at m bf base bw edge cursor)
         (_ : @ex Integers.Int64.int
                (fun old : Integers.Int64.int =>
                 @eq (option Values.val)
                   (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
                   (@Some Values.val (Values.Vlong old)))),
       write_effect m m bf base bw edge cursor BinNums.Z0 (@nil BitMachine.Cell)
### C.jet_elements_effects.write_effect_seq
write_effect_seq
     : forall (m m1 m2 : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor n1 n2 : BinNums.Z) (cells1 cells2 : list BitMachine.Cell)
         (_ : @eq BinNums.Z (BinInt.Z.of_nat (@length BitMachine.Cell cells1)) n1) (_ : BinInt.Z.le BinNums.Z0 n2)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor (BinInt.Z.add n1 n2))
         (_ : write_effect m m1 bf base bw edge cursor n1 cells1)
         (_ : write_effect m1 m2 bf base bw edge (BinInt.Z.sub cursor n1) n2 cells2),
       write_effect m m2 bf base bw edge cursor (BinInt.Z.add n1 n2) (@app BitMachine.Cell cells1 cells2)
### C.jet_elements_effects.write_frame_at_after_effect
write_frame_at_after_effect
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor n count : BinNums.Z) (cells : list BitMachine.Cell)
         (_ : @eq BinNums.Z (BinInt.Z.of_nat (@length BitMachine.Cell cells)) n) (_ : BinInt.Z.le BinNums.Z0 count)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor (BinInt.Z.add n count))
         (_ : write_effect m mf bf base bw edge cursor n cells),
       jet_output_layout.write_frame_at mf bf base bw edge (BinInt.Z.sub cursor n) count
### C.jet_elements_effects.write_effect_lift
write_effect_lift
     : forall (m1 m2 mf : Memory.Mem.mem) (bl bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor n : BinNums.Z) (cells : list BitMachine.Cell) (_ : not (@eq Values.block bl bf))
         (_ : not (@eq Values.block bl bw))
         (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : not (@eq Values.block b bl)),
              @eq (option Values.val) (Memory.Mem.load chunk m2 b ofs) (Memory.Mem.load chunk m1 b ofs))
         (_ : forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m1 b ofs kind p), Memory.Mem.perm m2 b ofs kind p)
         (_ : forall (b : Values.block) (_ : Memory.Mem.valid_block m1 b), Memory.Mem.valid_block m2 b)
         (_ : write_effect m2 mf bf base bw edge cursor n cells),
       and (jet_encoding.frame_output_cells_at mf bw edge cursor cells)
         (and (jet_output_layout.write_prefix_at m1 mf bw edge cursor)
            (and (jet_frame_layout.frame_fields_at mf bf base bw edge (BinInt.Z.sub cursor n))
               (and
                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : not (@eq Values.block b bl))
                     (_ : or (not (@eq Values.block b bf))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add base
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                     (_ : or (not (@eq Values.block b bw))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add edge
                                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                        (BinInt.Z.div (BinInt.Z.sub cursor n)
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                   @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m1 b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                        (p : Memtype.permission) (_ : Memory.Mem.perm m1 b ofs kind p), Memory.Mem.perm mf b ofs kind p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m1 b), Memory.Mem.valid_block mf b)))))
### C.jet_elements_effects.write_effect
write_effect =
fun (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block) (edge cursor count : BinNums.Z)
  (cells : list BitMachine.Cell) =>
and (jet_encoding.frame_output_cells_at mf bw edge cursor cells)
  (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
     (and (jet_frame_layout.frame_fields_at mf bf base bw edge (BinInt.Z.sub cursor count))
        (and
           (jet_output_layout.loads_outside_ranges m mf bf
              (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
              (BinInt.Z.add edge
                 (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                    (BinInt.Z.div (BinInt.Z.sub cursor count)
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
              (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
           (and
              (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                 (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mf b ofs kind p)
              (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : list BitMachine.Cell), Prop

Arguments write_effect m mf bf base%Z_scope bw (edge cursor count)%Z_scope cells%list_scope
