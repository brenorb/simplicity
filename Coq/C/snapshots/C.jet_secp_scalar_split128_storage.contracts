### C.jet_secp_scalar_split128_storage.scalar_split128_empty_region
scalar_split128_empty_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (r : nat) (_ : @eq BinNums.Z (jet_sx_state.bas beta r) BinNums.Z0)
         (_ : Memory.Mem.range_perm m (jet_sx_state.blk beta r) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable), jet_sx_state.region_ok rho beta m r jet_secp_scalar_split128.scalar_split128_empty
### C.jet_secp_scalar_split128_storage.scalar_split128_initial_storage
scalar_split128_initial_storage
     : forall (value : BinNums.Z) (m : Memory.Mem.mem) (b0 b1 bs : Values.block) (base : BinNums.Z)
         (_ : not (@eq Values.block b0 b1)) (_ : not (@eq Values.block b0 bs)) (_ : not (@eq Values.block b1 bs))
         (_ : Memory.Mem.range_perm m b0 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bs base
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of value))),
       jet_sx_state.rep (jet_secp_scalar_get_b32_numeric.scalar_limb_rho value)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b0 BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b1 BinNums.Z0)
               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs base)
                  (@nil (prod Values.block BinNums.Z))))) (jet_secp_scalar_split128.scalar_split128_regs false) m
### C.jet_secp_scalar_split128_storage.eval_scalar_split128_from_normalized_storage
eval_scalar_split128_from_normalized_storage
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (b0 b1 bs : Values.block) (base : BinNums.Z) (_ : not (@eq Values.block b0 b1))
         (_ : not (@eq Values.block b0 bs)) (_ : not (@eq Values.block b1 bs))
         (_ : Memory.Mem.range_perm m b0 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bs base
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_split_128)
               (@cons Values.val (Values.Vptr b0 Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr b1 Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr base)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf b0 BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                           (jet_secp_scalar_split128_literal.literal_split128_low value)))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf b1 BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                              (jet_secp_scalar_split128_literal.literal_split128_high value)))))
                  (and
                     (Memory.Mem.range_perm mf b0 BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf b1 BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (pos : BinNums.Z) =>
                            not
                              (jet_sx_state.foot
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b0 BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b1 BinNums.Z0)
                                       (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs base)
                                          (@nil (prod Values.block BinNums.Z)))))
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape (jet_secp_scalar_split128.scalar_split128_regs false)) b pos))
                           m mf))))))
### C.jet_secp_scalar_split128_storage.scalar_split128_rep_after_reader
scalar_split128_rep_after_reader
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (readerbeta : jet_sx_state.layout) (bi : Values.block) (edge : Integers.Ptrofs.int)
         (m : Memory.Mem.mem) (b0 b1 : Values.block)
         (_ : jet_sx_state.rep
                (jet_secp_wrapper_run.read_fe_rho
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) readerbeta
                (jet_secp_scalar_reader_lifecycle.scalar_reader_final_regs bi edge) m)
         (_ : not (@eq Values.block b0 b1)) (_ : not (@eq Values.block b0 (jet_sx_state.blk readerbeta O)))
         (_ : not (@eq Values.block b1 (jet_sx_state.blk readerbeta O)))
         (_ : Memory.Mem.range_perm m b0 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep
         (jet_secp_scalar_get_b32_numeric.scalar_limb_rho
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value)))
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b0 BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b1 BinNums.Z0)
               (@cons (prod Values.block BinNums.Z)
                  (@pair Values.block BinNums.Z (jet_sx_state.blk readerbeta O) (jet_sx_state.bas readerbeta O))
                  (@nil (prod Values.block BinNums.Z))))) (jet_secp_scalar_split128.scalar_split128_regs false) m
