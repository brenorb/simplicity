### C.jet_entropy_compose_writer.calc_write32s_symbol
calc_write32s_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            jets_elements._write32s)
         (@Some Values.block (jet_elements_linkage.elements_symbol_block jets_elements._write32s))
### C.jet_entropy_compose_writer.calc_write32s_funct
calc_write32s_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._write32s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets.f_write32s))
### C.jet_entropy_compose_writer.calc_mid_arg
calc_mid_arg
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (b : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._h le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero))),
       Clight.eval_expr jet_elements_linkage.elements_ge e le m
         (Clight.Efield
            (Clight.Ederef
               (Clight.Etempvar jets_elements._h
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
               (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) jets_elements._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr b Integers.Ptrofs.zero)
### C.jet_entropy_compose_writer.calc_writehash_wrap
calc_writehash_wrap
     : forall (m mf : Memory.Mem.mem) (br bd : Values.block) (dbase : BinNums.Z)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                (@Ctypes.Internal Clight.function jets.f_write32s)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                      (@cons Values.val
                         (Values.Vlong
                            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                         (@nil Values.val)))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
         (@Ctypes.Internal Clight.function jets_elements.f_writeHash)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf Values.Vundef
### C.jet_entropy_compose_writer.calc_writehash_from_frame
calc_writehash_from_frame
     : forall (m : Memory.Mem.mem) (br bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : not (@eq Values.block br bd)) (_ : not (@eq Values.block br bw))
         (_ : jet_uint32_array_init.uint32_array_at m br BinNums.Z0 (Digest.hash256_reg (Word.to_hash256 h)))
         (_ : jet_output_layout.write_frame_at m bd dbase bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_writeHash)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_encoding.frame_output_cells_at mf bw edge cursor
                  (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw edge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bd
                           (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add dbase
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm mf b ofs k p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
