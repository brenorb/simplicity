### C.jet_elements_taptweak_output_prefix.elements_taptweak_prefix_hash_linked
elements_taptweak_prefix_hash_linked
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
               (Clight.genv_genv jet_elements_taptweak_pure.elements_taptweak_ge) jets_secp._sha256_hash)
            (@Some Values.block (jet_elements_taptweak_globals.elements_taptweak_symbol_block jets_secp._sha256_hash)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
               (Clight.genv_genv jet_elements_taptweak_pure.elements_taptweak_ge)
               (Values.Vptr (jet_elements_taptweak_globals.elements_taptweak_symbol_block jets_secp._sha256_hash)
                  Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_sha256_hash)))
### C.jet_elements_taptweak_output_prefix.exec_elements_taptweak_prefix_hash
exec_elements_taptweak_prefix_hash
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bc bt : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_hash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ctx__1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._taptweakTag e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_sha256_hash)
                (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
         jet_secp_taptweak_prefix.taptweak_prefix_hash Events.E0 le mf ClightBigstep.Out_normal
### C.jet_elements_taptweak_output_prefix.exec_elements_taptweak_output_prefix
exec_elements_taptweak_output_prefix
     : forall (_ : jet_memcpy_model.memcpy_model) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (br bc bs bt : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_init e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_hash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp.__res e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type br jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ctx__1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._output_hash e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._taptweakTag e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : @List.NoDup Values.block
                (@cons Values.block br
                   (@cons Values.block bc (@cons Values.block bs (@cons Values.block bt (@nil Values.block))))))
         (_ : jet_elements_taptweak_runtime_ready.elements_taptweak_runtime_ready m)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_uint32_array_init.uint32_array_at m bt BinNums.Z0
                (Digest.hash256_reg jet_elements_taptweak_tag.elements_taptweak_tag_digest)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
               jet_secp_taptweak_prefix.taptweak_output_prefix Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                  (Digest.hash256_reg jet_elements_taptweak_tag.elements_taptweak_tag_iv))
               (and
                  (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                     (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf bc
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (@Some Values.val
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint8unsigned mf bc
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@Some Values.val (Values.Vint Integers.Int.zero)))
                        (and
                           (Memory.Mem.range_perm mf br BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bc BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bs BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bt BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (jet_uint32_array_init.uint32_array_at mf bt BinNums.Z0
                                          (Digest.hash256_reg jet_elements_taptweak_tag.elements_taptweak_tag_digest))
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) =>
                                              and (not (@eq Values.block b br))
                                                (and (not (@eq Values.block b bc)) (not (@eq Values.block b bs)))) m mf)
                                          (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                             (jet_elements_taptweak_runtime_ready.elements_taptweak_runtime_ready mf)))))))))))))
