### C.jet_secp_generator_digest_mapping.exec_generator_digest_set
exec_generator_digest_set
     : forall (second : bool) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bt bb : Values.block) (flag : bool)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._b32 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_set_b32)
                (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                (Values.Vint (jet_secp_field_cmov.cmov_int flag))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (generator_digest_set_call second) Events.E0
         (@Maps.PTree.set Values.val (generator_digest_slot second) (Values.Vint (jet_secp_field_cmov.cmov_int flag))
            le) mf ClightBigstep.Out_normal
### C.jet_secp_generator_digest_mapping.exec_generator_digest_update
exec_generator_digest_update
     : forall (second prior : bool) (bytes : list BinNums.Z) (e : Clight.env) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem)
