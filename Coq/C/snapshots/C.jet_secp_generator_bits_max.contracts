### C.jet_secp_generator_bits_max.generator_bits_max_source
generator_bits_max_source
     : @eq Clight.statement generator_bits_max
         (Clight.Ssequence (generator_raise_bits false) (generator_raise_bits true))
### C.jet_secp_generator_bits_max.eval_generator_raise_guard
eval_generator_raise_guard
     : forall (high : bool) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (current candidate : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 current)
                (BinInt.Z.le current
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 candidate)
                (BinInt.Z.le candidate
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._bits le)
                (@Some Values.val (Values.Vint (Integers.Int.repr current))))
         (_ : @eq (option Values.val)
                (@Maps.PTree.get Values.val
                   match high return BinNums.positive with
                   | true => jets_secp._bits_ng_128
                   | false => jets_secp._bits_ng_1
                   end le) (@Some Values.val (Values.Vint (Integers.Int.repr candidate)))),
       Clight.eval_expr jet_secp_linkage.secp_ge e le m
         (Clight.Ebinop Cop.Ogt
            (Clight.Etempvar
               match high return AST.ident with
               | true => jets_secp._bits_ng_128
               | false => jets_secp._bits_ng_1
               end Ctypesdefs.tint) (Clight.Etempvar jets_secp._bits Ctypesdefs.tint) Ctypesdefs.tint)
         (Values.Vint
            match BinInt.Z.ltb current candidate return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
### C.jet_secp_generator_bits_max.exec_generator_raise_bits
exec_generator_raise_bits
     : forall (high : bool) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (current candidate : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 current)
                (BinInt.Z.le current
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 candidate)
