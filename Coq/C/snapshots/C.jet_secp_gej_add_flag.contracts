### C.jet_secp_gej_add_flag.gej_add_finite_flag_consistent
gej_add_finite_flag_consistent
     : forall (x y z u v w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_square_columns.square_input_bounds (jet_secp_gej_add_finite_difference.gej_add_h_words x z u w))
         (_ : not
                (@eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                   BinNums.Z0))
         (_ : not
                (@eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)
                   BinNums.Z0)),
       @eq bool (Integers.Int.eq (jet_secp_gej_add_finite_body.gej_add_finite_flag x y z u v w) Integers.Int.one)
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value
                  (jet_secp_gej_add_finite_body.gej_add_finite_z_words x y z u v w)) jet_secp_fe_math.feP) BinNums.Z0)
### C.jet_secp_gej_add_flag.gej_add_finite_flag_bit
gej_add_finite_flag_bit
     : forall x y z u v w : forall _ : nat, Integers.Int64.int,
       @eq Integers.Int.int (jet_secp_gej_add_finite_body.gej_add_finite_flag x y z u v w)
         (jet_readBit_layout.bit_int
            (Integers.Int.eq (jet_secp_gej_add_finite_body.gej_add_finite_flag x y z u v w) Integers.Int.one))
### C.jet_secp_gej_add_flag.gej_add_finite_flag_matches_literal
gej_add_finite_flag_matches_literal
     : forall (mx my mz mu mv mw : forall _ : nat, Integers.Int64.int)
         (ax ay az bx byword bz : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_square_columns.square_input_bounds mx) (_ : jet_secp_square_columns.square_input_bounds my)
         (_ : jet_secp_square_columns.square_input_bounds mz) (_ : jet_secp_square_columns.square_input_bounds mu)
         (_ : jet_secp_square_columns.square_input_bounds mv) (_ : jet_secp_square_columns.square_input_bounds mw)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value mx) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ax)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value my) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) ay)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value mz) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) az)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value mu) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) bx)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value mv) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) byword)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value mw) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) bz)
                   jet_secp_fe_math.feP))
         (_ : @eq bool (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem az)) false)
         (_ : @eq bool (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem bz)) false),
       @eq bool (Integers.Int.eq (jet_secp_gej_add_finite_body.gej_add_finite_flag mx my mz mu mv mw) Integers.Int.one)
         (Bit.toBool
            (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem
               (@jet_secp_add_literal.literal_gej_add Alg.CoreFunSem
                  (@pair
                     (prod
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (prod
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (@pair
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay) az)
                     (@pair
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) bx byword) bz)))))
