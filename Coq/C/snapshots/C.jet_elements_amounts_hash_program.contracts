           (Word.Word (S (S (S (S (S (S O)))))))))
     (jet_elements_asset_jets.encode_asset
        (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256 (jet_elements_prim.txoAsset txo)))
     (jet_elements_amount_jets.encode_amount
        (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (jet_elements_prim.txoAmount txo))))
