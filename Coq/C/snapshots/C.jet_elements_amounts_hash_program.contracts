  (pa : jet_elements_prim.Elements.t (Word.Word (S (S (S (S (S O))))))
          (Ty.Sum Ty.Unit jet_elements_asset_amount_hash_spec.elements_asset_hash_type))
  (alg : jet_elements_words_hash_program.EFP.Algebra) =>
let term : Alg.Assertion.Algebra := jet_elements_words_hash_program.EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha_hash_elems_reader.hash_elems_spec jet_elements_asset_amount_hash_spec.elements_asset_amount_type
  (fun term0 : Alg.Assertion.Algebra => @jet_elements_asset_amount_hash_spec.elements_asset_amount_hash_spec term0)
  (S (S (S (S (S O))))) term
  (@jet_buffer_empty_spec.AC.drop Ty.Unit (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit
        (Ty.Prod jet_elements_asset_amount_hash_spec.elements_asset_hash_type
           jet_elements_asset_amount_hash_spec.elements_amount_hash_type)) core
     (@jet_elements_amount_jets.elements_amount_pair_spec alg (Word.Word (S (S (S (S (S O))))))
