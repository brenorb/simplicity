        jet_elements_asset_amount_hash_spec.elements_asset_hash_type
        (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit jet_elements_asset_amount_hash_spec.elements_amount_hash_type) alg pm)
        (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit jet_elements_asset_amount_hash_spec.elements_asset_hash_type) alg pa)))
     : forall
         (_ : jet_elements_prim.Elements.t (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit jet_elements_asset_amount_hash_spec.elements_amount_hash_type))
         (_ : jet_elements_prim.Elements.t (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit jet_elements_asset_amount_hash_spec.elements_asset_hash_type))
         (alg : jet_elements_words_hash_program.EFP.Algebra),
