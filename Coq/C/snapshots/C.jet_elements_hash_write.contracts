### C.jet_elements_hash_write.hash_cells_length
hash_cells_length
     : forall xs : list Integers.Int.int,
       @eq nat (@length BitMachine.Cell (hash_cells xs))
         (Nat.mul (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))
            (@length Integers.Int.int xs))
### C.jet_elements_hash_write.hash_cells_length_Z
hash_cells_length_Z
     : forall (xs : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int xs) (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z (BinInt.Z.of_nat (@length BitMachine.Cell (hash_cells xs)))
         (BinNums.Zpos
            (BinNums.xO
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
### C.jet_elements_hash_write.out_sep_words
out_sep_words
     : forall (bf : Values.block) (base : BinNums.Z) (bw : Values.block) (edge cursor count : BinNums.Z)
         (b : Values.block) (lo : BinNums.Z) (n j : nat) (_ : lt j n)
         (_ : jet_application_sep.out_sep bf base bw edge cursor count b lo
                (BinInt.Z.add lo (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat n)))),
       jet_application_sep.out_sep bf base bw edge cursor count b
         (BinInt.Z.add lo (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j)))
         (BinInt.Z.add
            (BinInt.Z.add lo (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j)))
            (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
### C.jet_elements_hash_write.eval_elements_write_hash_array
eval_elements_write_hash_array
     : forall (m : Memory.Mem.mem) (bi : Values.block) (input : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z) (xs : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int xs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le
                (BinInt.Z.add input
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_application_sep.out_sep bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) bi
                input
                (BinInt.Z.add input
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : jet_uint32_array_init.uint32_array_at m bi input xs)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_write32s)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
                     (@cons Values.val
                        (Values.Vlong
                           (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (jet_elements_effects.write_effect m mf bf base bw edge cursor
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (hash_cells xs)))
### C.jet_elements_hash_write.hash_cells
hash_cells =
fun xs : list Integers.Int.int => jet_elements_write32s_layout.uint32_word_cells xs
     : forall _ : list Integers.Int.int, list BitMachine.Cell

Arguments hash_cells xs%list_scope
