### C.jet_elements_hash_write.elements_write32s_symbol
elements_write32s_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            jets_elements._write32s)
         (@Some Values.block (jet_elements_linkage.elements_symbol_block jets_elements._write32s))
### C.jet_elements_hash_write.elements_write32s_funct
elements_write32s_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv jet_elements_linkage.elements_ge)
            (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._write32s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_elements.f_write32s))
