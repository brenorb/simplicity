### C.jet_elements_input_hash_jets.elements_input_script_sig_hash_result
elements_input_script_sig_hash_result =
fun (environment : jet_elements_prim.Elements.env) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error jet_elements_prim.sigTxInput
    (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| Some txo =>
    @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Word.from_hash256 (Digest.byteStringHash (jet_elements_prim.sigTxiScriptSig txo)))
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
end
     : forall (_ : jet_elements_prim.Elements.env) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments elements_input_script_sig_hash_result environment a
