### C.jet_elements_input_hash_jets.issuance_asset_proof_bytes
issuance_asset_proof_bytes =
fun txi : jet_elements_prim.sigTxInput =>
match jet_elements_prim.sigTxiIssuance txi return (list Integers.Byte.int) with
| Some i =>
    @jet_elements_prim.viewPrf Integers.Int64.int
      match i return (jet_elements_prim.confidential (list Integers.Byte.int) Integers.Int64.int) with
      | inl new => jet_elements_prim.newIssuanceAmount new
      | inr re => jet_elements_prim.reissuanceAmount re
      end
| None => @nil Integers.Byte.int
end
     : forall _ : jet_elements_prim.sigTxInput, list Integers.Byte.int

Arguments issuance_asset_proof_bytes txi
### C.jet_elements_input_hash_jets.issuance_token_proof_bytes
issuance_token_proof_bytes =
fun txi : jet_elements_prim.sigTxInput =>
match jet_elements_prim.sigTxiIssuance txi return (list Integers.Byte.int) with
| Some i =>
    @jet_elements_prim.viewPrf Integers.Int64.int
      match i return (jet_elements_prim.confidential (list Integers.Byte.int) Integers.Int64.int) with
      | inl new => jet_elements_prim.newIssuanceTokenAmount new
      | inr _ => @jet_elements_prim.Explicit (list Integers.Byte.int) Integers.Int64.int Integers.Int64.zero
      end
| None => @nil Integers.Byte.int
end
     : forall _ : jet_elements_prim.sigTxInput, list Integers.Byte.int

Arguments issuance_token_proof_bytes txi
