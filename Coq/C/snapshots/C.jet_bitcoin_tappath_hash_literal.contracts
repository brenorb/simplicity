### C.jet_bitcoin_tappath_hash_literal.literal_bitcoin_tappath_hash_matches
literal_bitcoin_tappath_hash_matches
     : forall alg : jet_bitcoin_full_prim.PF.Algebra,
       @eq (jet_bitcoin_full_prim.PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@literal_bitcoin_tappath_hash alg)
         (@jet_bitcoin_words_hash.prim_words_hash_spec (S (S (S (S (S O))))) (S (S (S O)))
            (@jet_bitcoin_full_prim.BitcoinFull.Ext (Word.Word (S (S (S O))))
               (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) jet_bitcoin_ext_prim.BitcoinExt.Tappath)
            alg)
### C.jet_bitcoin_tappath_hash_literal.bitcoin_tappath_hash_literal_local_spec
bitcoin_tappath_hash_literal_local_spec
     : jet_application_sep.application_jet_local_spec_sep jets_bitcoin.f_simplicity_bitcoin_tappath_hash
         jet_bitcoin_linkage.bitcoin_ge jet_bitcoin_ext_prim.ext_environment Ty.Unit
         (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@jet_bitcoin_hash_getter_local.hash_getter_rep jet_bitcoin_ext_prim.ext_environment
            (fun e : jet_bitcoin_ext_prim.ext_environment =>
             jet_bitcoin_words_hash.words_hash_of (S (S (S (S (S O))))) (S (S (S O)))
               (jet_bitcoin_words_hash.tappath_of e)) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
            (BinNums.Zpos
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_bitcoin_ext_prim.ext_environment) =>
          @literal_bitcoin_tappath_hash
            (jet_bitcoin_full_prim.PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
### C.jet_bitcoin_tappath_hash_literal.literal_bitcoin_tappath_hash
literal_bitcoin_tappath_hash =
fun alg : jet_bitcoin_full_prim.PF.Algebra =>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
@jet_sha_hash_words_literal.literal_sha_hash_words (S (S (S (S (S O))))) (S (S (S O))) term Ty.Unit
  (@Alg.Core.Combinators.drop Ty.Unit (Word.Word (S (S (S O))))
     (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) (Alg.Assertion.toCore term)
     (@jet_bitcoin_full_prim.PF.Combinators.prim (Word.Word (S (S (S O))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg
        (@jet_bitcoin_full_prim.BitcoinFull.Ext (Word.Word (S (S (S O))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) jet_bitcoin_ext_prim.BitcoinExt.Tappath)))
     : forall alg : jet_bitcoin_full_prim.PF.Algebra,
       jet_bitcoin_full_prim.PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments literal_bitcoin_tappath_hash {alg}
