### C.jet_sha256_init_layout.eval_sha256_init_layout
eval_sha256_init_layout
     : forall (m : Memory.Mem.mem) (br bi : Values.block) (input : BinNums.Z) (_ : not (@eq Values.block br bi))
         (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le
                (BinInt.Z.add input
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) input)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable)
         (_ : Memory.Mem.range_perm m bi input
                (BinInt.Z.add input
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_sha256_init)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf br BinNums.Z0)
                  (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf br (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val (Values.Vlong Integers.Int64.zero)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint8unsigned mf br
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and (jet_uint32_array_init.uint32_array_at mf bi input jet_sha256_iv_init.sha256_iv_words)
                        (and
                           (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                              (_ : Memory.Mem.valid_block m b)
                              (_ : or (not (@eq Values.block b br))
                                     (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) BinNums.Z0)
                                        (BinInt.Z.le
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                           ofs)))
                              (_ : or (not (@eq Values.block b bi))
                                     (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) input)
                                        (BinInt.Z.le
                                           (BinInt.Z.add input
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                           ofs))),
                            @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                           (and
                              (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                 (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                               Memory.Mem.perm mf b ofs kind p)
                              (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))))
