### C.jet_sha_finalize_literal_word.literal_sha_left_shift64_matches
literal_sha_left_shift64_matches
     : forall (term : Alg.Core.Algebra) (amount : BinNums.Z)
         (_ : @List.In BinNums.Z amount
                (@cons BinNums.Z (BinNums.Zpos (BinNums.xI BinNums.xH))
                   (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))) (@nil BinNums.Z)))),
       @eq (Alg.Core.domain term (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (@literal_sha_left_shift64 amount term) (@Word.shift_const (S (S (S (S (S (S O)))))) term amount)
### C.jet_sha_finalize_literal_word.literal_sha_add64_matches
literal_sha_add64_matches
     : forall term : Alg.Core.Algebra,
       @eq
         (Alg.Core.domain term (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
            (Word.Word (S (S (S (S (S (S O)))))))) (@literal_sha_add64 term)
         (@Alg.Core.Combinators.comp
            (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
            (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))
            (Word.Word (S (S (S (S (S (S O))))))) term (@Word.adder (S (S (S (S (S (S O)))))) term)
            (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))
               (Word.Word (S (S (S (S (S (S O))))))) term
               (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) term)))
### C.jet_sha_finalize_literal_word.sha_haskell_left_shift_list
sha_haskell_left_shift_list =
fix sha_haskell_left_shift_list
  (X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra) (t : Alg.Core.domain term Ty.Unit X) (amount : BinNums.Z) {struct n} :
    list (Alg.Core.domain term (Word.Vector X n) (Word.Vector X n)) :=
  match n as n0 return (list (Alg.Core.domain term (Word.Vector X n0) (Word.Vector X n0))) with
  | O => @nil (Alg.Core.domain term (Word.Vector X O) (Word.Vector X O))
  | S k =>
      match BinInt.Z.even amount return (list (Alg.Core.domain term (Word.Vector X (S k)) (Word.Vector X (S k)))) with
      | true =>
          @eq_rect Ty.Ty (Word.Vector (Ty.Prod X X) k) (fun T : Ty.Ty => list (Alg.Core.domain term T T))
            (sha_haskell_left_shift_list (Ty.Prod X X) k term (@Alg.Core.Combinators.pair Ty.Unit X X term t t)
               (BinInt.Z.div amount (BinNums.Zpos (BinNums.xO BinNums.xH)))) (Word.Vector X (S k))
            (@eq_sym Ty.Ty (Word.Vector X (S k)) (Word.Vector (Ty.Prod X X) k) (@Word.VectorPromote X k))
      | false =>
          @cons (Alg.Core.domain term (Word.Vector X (S k)) (Word.Vector X (S k))) (@Word.left_shift1 X (S k) term t)
            (@eq_rect Ty.Ty (Word.Vector (Ty.Prod X X) k) (fun T : Ty.Ty => list (Alg.Core.domain term T T))
               (sha_haskell_left_shift_list (Ty.Prod X X) k term (@Alg.Core.Combinators.pair Ty.Unit X X term t t)
                  (BinInt.Z.div (BinInt.Z.sub amount (BinNums.Zpos BinNums.xH)) (BinNums.Zpos (BinNums.xO BinNums.xH))))
               (Word.Vector X (S k))
               (@eq_sym Ty.Ty (Word.Vector X (S k)) (Word.Vector (Ty.Prod X X) k) (@Word.VectorPromote X k)))
      end
  end
     : forall (X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra) (_ : Alg.Core.domain term Ty.Unit X) (_ : BinNums.Z),
       list (Alg.Core.domain term (Word.Vector X n) (Word.Vector X n))

Arguments sha_haskell_left_shift_list {X}%ty_scope {n}%nat_scope {term} t amount%Z_scope
### C.jet_sha_finalize_literal_word.literal_sha_left_shift64
literal_sha_left_shift64 =
fun (amount : BinNums.Z) (term : Alg.Core.Algebra) =>
match
  BinInt.Z.leb (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
    amount return (Alg.Core.domain term (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
with
| true =>
    @Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S O))))))) Ty.Unit
      (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O))))))) term
      (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S (S O))))))) term)
      (@Word.fill Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O)))))) term (@Bit.false Ty.Unit term))
| false =>
    @Word.foldr_comp (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O))))))) term
      (@sha_haskell_left_shift_list (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O)))))) term
         (@Bit.false Ty.Unit term) amount)
end
     : forall (_ : BinNums.Z) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))

Arguments literal_sha_left_shift64 amount%Z_scope {term}
### C.jet_sha_finalize_literal_word.literal_sha_add64
literal_sha_add64 =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))) term
  (@jet_canonical_add_adapter.canonical_add_word (S (S (S (S (S (S O)))))) term)
  (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))
     (Word.Word (S (S (S (S (S (S O))))))) term (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) term))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Word.Word (S (S (S (S (S (S O)))))))

Arguments literal_sha_add64 {term}
