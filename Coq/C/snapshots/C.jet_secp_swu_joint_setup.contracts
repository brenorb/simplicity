### C.jet_secp_swu_joint_setup.swu_joint_setup_source
swu_joint_setup_source
     : @eq Clight.statement jet_secp_swu_initial.swu_after_initial
         (jet_secp_statement_prefix.statement_sequence swu_joint_setup_statements swu_after_joint_setup)
### C.jet_secp_swu_joint_setup.swu_joint_setup_closed
swu_joint_setup_closed
     : @eq bool (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers swu_joint_setup)
         true
### C.jet_secp_swu_joint_setup.exec_swu_copy_x3d
exec_swu_copy_x3d
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bwd bx : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._wd e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bwd jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : not (@eq Values.block bwd bx))
         (_ : jet_secp_fe_nv.fe_at m bwd BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_copy_x3d Events.E0 le mf
               ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
               (and
                  (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
                   iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p))
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block b bx))
                        (or (BinInt.Z.lt pos BinNums.Z0)
                           (BinInt.Z.le
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              pos))) m mf))))
### C.jet_secp_swu_joint_setup.exec_swu_scale_call
exec_swu_scale_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bx : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul_int)
                (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_scale_x3d Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_secp_swu_joint_setup.exec_swu_negate_call
exec_swu_negate_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bx : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
