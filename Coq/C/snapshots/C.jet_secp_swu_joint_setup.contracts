### C.jet_secp_swu_joint_setup.exec_swu_joint_setup
exec_swu_joint_setup
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (bwd bx : Values.block)
         (w : forall _ : nat, Integers.Int64.int) (_ : jet_clight_internal_frame.plain_env e)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_mul_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_add_int e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._wd e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bwd jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x3d e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : not (@eq Values.block bwd bx)) (_ : jet_secp_swu_startup.swu_startup m)
         (_ : jet_secp_field_mul_small.mul_small_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m bwd BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bwd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m swu_joint_setup Events.E0 le mf
               ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf bwd BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (swu_setup_wd w)))
               (and
                  (jet_secp_fe_nv.fe_at mf bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 (swu_setup_x3d w)))
                  (and
                     (Memory.Mem.range_perm mf bwd BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bx BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (swu_setup_wd w))
                              (BinInt.Z.add (jet_secp_multiply_finish_product.radix_value w)
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (and
                              (@eq BinNums.Z (jet_secp_multiply_finish_product.radix_value (swu_setup_x3d w))
                                 (BinInt.Z.sub
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       jet_secp_fe_math.feP)
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH))
                                       (jet_secp_multiply_finish_product.radix_value w))))
                              (and (jet_secp_square_columns.square_input_bounds (swu_setup_wd w))
                                 (and (jet_secp_square_columns.square_input_bounds (swu_setup_x3d w))
                                    (and (jet_secp_swu_startup.swu_startup mf)
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) =>
                                              and (not (@eq Values.block b bwd)) (not (@eq Values.block b bx))) m mf)
                                          (jet_clight_internal_preserve.readonly_preserved m mf))))))))))))
### C.jet_secp_swu_joint_setup.swu_copy_x3d
swu_copy_x3d =
Clight.Sassign (Clight.Evar jets_secp._x3d jet_secp_curve_statements.curve_fe_type)
  (Clight.Evar jets_secp._wd jet_secp_curve_statements.curve_fe_type)
     : Clight.statement
### C.jet_secp_swu_joint_setup.swu_scale_x3d
swu_scale_x3d =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul_int jets_secp.f_secp256k1_fe_mul_int
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x3d)
     (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) Ctypesdefs.tint)
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_swu_joint_setup.swu_negate_x3d
swu_negate_x3d =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_negate jets_secp.f_secp256k1_fe_negate
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x3d)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._x3d)
        (@cons Clight.expr
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) Ctypesdefs.tint)
           (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_swu_joint_setup.swu_add8_wd
swu_add8_wd =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_add_int jets_secp.f_secp256k1_fe_add_int
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._wd)
     (@cons Clight.expr
        (Clight.Ebinop Cop.Oadd
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))) Ctypesdefs.tint)
           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint) Ctypesdefs.tint)
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_swu_joint_setup.swu_joint_setup_statements
swu_joint_setup_statements =
@cons Clight.statement swu_copy_x3d
  (@cons Clight.statement swu_scale_x3d
     (@cons Clight.statement swu_negate_x3d (@cons Clight.statement swu_add8_wd (@nil Clight.statement))))
     : list Clight.statement
### C.jet_secp_swu_joint_setup.swu_joint_setup
swu_joint_setup =
jet_secp_statement_prefix.statement_sequence swu_joint_setup_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_swu_joint_setup.swu_after_joint_setup
swu_after_joint_setup =
match jet_secp_swu_initial.swu_after_initial return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ s4 =>
            match s4 return Clight.statement with
            | Clight.Sskip => Clight.Sskip
            | Clight.Sassign _ _ => Clight.Sskip
            | Clight.Sset _ _ => Clight.Sskip
            | Clight.Scall _ _ _ => Clight.Sskip
            | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
            | Clight.Ssequence _ rest => rest
            | Clight.Sifthenelse _ _ _ => Clight.Sskip
            | Clight.Sloop _ _ => Clight.Sskip
            | Clight.Sbreak => Clight.Sskip
            | Clight.Scontinue => Clight.Sskip
            | Clight.Sreturn _ => Clight.Sskip
            | Clight.Sswitch _ _ => Clight.Sskip
            | Clight.Slabel _ _ => Clight.Sskip
            | Clight.Sgoto _ => Clight.Sskip
            end
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_swu_joint_setup.swu_setup_x3d
swu_setup_x3d =
fun w : forall _ : nat, Integers.Int64.int =>
jet_secp_field_negate_magnitude.negate_mag_words (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH)))
  (jet_secp_field_mul_small.mul_small_words (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) w)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments swu_setup_x3d w%function_scope i%nat_scope
### C.jet_secp_swu_joint_setup.swu_setup_wd
swu_setup_wd =
fun w : forall _ : nat, Integers.Int64.int =>
jet_secp_field_add_int.add_int_words
  (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) w
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments swu_setup_wd w%function_scope i%nat_scope
