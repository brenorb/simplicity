### C.jet_full_add_wide_exec.wide_full_add
wide_full_add =
fun s : jet_wide.wide_size =>
match s return Clight.function with
| jet_wide.W16 => jets.f_simplicity_full_add_16
| jet_wide.W32 => jets.f_simplicity_full_add_32
| jet_wide.W64 => jets.f_simplicity_full_add_64
end
     : forall _ : jet_wide.wide_size, Clight.function

Arguments wide_full_add s
### C.jet_full_add_wide_exec.wide_full_add_sum_raw_expr
wide_full_add_sum_raw_expr =
Clight.Ebinop Cop.Oadd
  (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
     (Clight.Etempvar jets._x Ctypesdefs.tulong) Ctypesdefs.tulong) (Clight.Etempvar jets._y Ctypesdefs.tulong)
  Ctypesdefs.tulong
     : Clight.expr
### C.jet_full_add_wide_exec.wide_full_add_first_carry_expr
wide_full_add_first_carry_expr =
fun s : jet_wide.wide_size =>
Clight.Ebinop Cop.Olt
  (Clight.Ebinop Cop.Osub
     (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
        (jet_full_increment_wide_exec.wide_full_increment_limit_expr s)
        (jet_full_increment_wide_exec.wide_full_increment_limit_type s)) (Clight.Etempvar jets._y Ctypesdefs.tulong)
     Ctypesdefs.tulong) (Clight.Etempvar jets._x Ctypesdefs.tulong) Ctypesdefs.tint
     : forall _ : jet_wide.wide_size, Clight.expr

Arguments wide_full_add_first_carry_expr s
### C.jet_full_add_wide_exec.wide_full_add_second_carry_expr
wide_full_add_second_carry_expr =
fun s : jet_wide.wide_size =>
Clight.Ebinop Cop.Olt (jet_full_increment_wide_exec.wide_full_increment_sub_expr s) wide_full_add_sum_raw_expr
  Ctypesdefs.tint
     : forall _ : jet_wide.wide_size, Clight.expr

Arguments wide_full_add_second_carry_expr s
### C.jet_full_add_wide_exec.wide_full_add_sum_expr
wide_full_add_sum_expr =
Clight.Ecast
  (Clight.Ebinop Cop.Oadd wide_full_add_sum_raw_expr (Clight.Etempvar jets._z Ctypesdefs.tbool) Ctypesdefs.tulong)
  Ctypesdefs.tulong
     : Clight.expr
### C.jet_full_add_wide_exec.wide_full_add_choose
wide_full_add_choose =
fun s : jet_wide.wide_size =>
Clight.Sifthenelse (wide_full_add_first_carry_expr s)
  (Clight.Sset jets._t'4 (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))
  (Clight.Sset jets._t'4 (Clight.Ecast (wide_full_add_second_carry_expr s) Ctypesdefs.tbool))
     : forall _ : jet_wide.wide_size, Clight.statement

Arguments wide_full_add_choose s
