### C.jet_sha256_init_fields_layout.sha256_init_body_shape
sha256_init_body_shape
     : @eq Clight.statement (Clight.fn_body jets.f_sha256_init)
         (Clight.Ssequence
            (Clight.Scall (@None AST.ident)
               (Clight.Evar jets._sha256_iv
                  (Ctypes.Tfunction (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint) Ctypes.Tnil) Ctypesdefs.tvoid
                     AST.cc_default))
               (@cons Clight.expr (Clight.Etempvar jets._output (Ctypesdefs.tptr Ctypesdefs.tuint)) (@nil Clight.expr)))
            (Clight.Ssequence
               (Clight.Ssequence sha_ctx_fields_stmt
                  (Clight.Sassign
                     (Clight.Ederef
                        (Clight.Etempvar jets.__res
                           (Ctypesdefs.tptr (Ctypes.Tstruct jets._sha256_context Ctypes.noattr)))
                        (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))
                     (Clight.Evar jets.___compound (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))))
               (Clight.Sreturn (@None Clight.expr))))
### C.jet_sha256_init_fields_layout.exec_sha_ctx_output_store
exec_sha_ctx_output_store
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bc bi : Values.block) (input : Integers.Ptrofs.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets.___compound e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._output le)
                (@Some Values.val (Values.Vptr bi input)))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.store AST.Mptr m bc BinNums.Z0 (Values.Vptr bi input))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m sha_ctx_output_stmt Events.E0 le mf ClightBigstep.Out_normal
### C.jet_sha256_init_fields_layout.exec_sha_ctx_counter_store
exec_sha_ctx_counter_store
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bc : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets.___compound e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                   (Values.Vlong Integers.Int64.zero)) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m sha_ctx_counter_stmt Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_sha256_init_fields_layout.exec_sha_ctx_overflow_store
exec_sha_ctx_overflow_store
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bc : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets.___compound e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint8unsigned m bc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                   (Values.Vint Integers.Int.zero)) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m sha_ctx_overflow_stmt Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_sha256_init_fields_layout.exec_sha_ctx_fields_layout
exec_sha_ctx_fields_layout
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bc bi : Values.block) (input : Integers.Ptrofs.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets.___compound e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._output le)
                (@Some Values.val (Values.Vptr bi input)))
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m sha_ctx_fields_stmt Events.E0 le mf
               ClightBigstep.Out_normal)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                  (@Some Values.val (Values.Vptr bi input)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                     (@Some Values.val (Values.Vlong Integers.Int64.zero)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint8unsigned mf bc
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                           (_ : or (not (@eq Values.block b bc))
                                  (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) BinNums.Z0)
                                     (BinInt.Z.le
                                        (BinNums.Zpos
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) ofs))),
                         @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
### C.jet_sha256_init_fields_layout.sha_ctx_output_stmt
sha_ctx_output_stmt =
Clight.Sassign (jet_sha256_init_zero_exec.sha_ctx_local_field jet_sha256_context_fields.CtxOutput)
  (Clight.Etempvar jets._output (Ctypesdefs.tptr Ctypesdefs.tuint))
     : Clight.statement
### C.jet_sha256_init_fields_layout.sha_ctx_counter_stmt
sha_ctx_counter_stmt =
Clight.Sassign (jet_sha256_init_zero_exec.sha_ctx_local_field jet_sha256_context_fields.CtxCounter)
  (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
     : Clight.statement
### C.jet_sha256_init_fields_layout.sha_ctx_overflow_stmt
sha_ctx_overflow_stmt =
Clight.Sassign (jet_sha256_init_zero_exec.sha_ctx_local_field jet_sha256_context_fields.CtxOverflow)
  (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
     : Clight.statement
### C.jet_sha256_init_fields_layout.sha_ctx_fields_stmt
sha_ctx_fields_stmt =
Clight.Ssequence
  (jet_sha256_init_zero_exec.sha_ctx_zero_prefix (Clight.Ssequence sha_ctx_output_stmt sha_ctx_counter_stmt)
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))) sha_ctx_overflow_stmt
     : Clight.statement
