### C.jet_secp_root_check.literal_root_check_numeric
literal_root_check_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool (Bit.toBool (literal_root_check x))
         (BinInt.Z.eqb
            (BinInt.Z.modulo
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem
                     (jet_secp_root_chain_numeric.literal_root_candidate x))) jet_secp_fe_math.feP)
            (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
               jet_secp_fe_math.feP))
### C.jet_secp_root_check.root_check_flag_matches
root_check_flag_matches
     : forall (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_root_chain_numeric.root_words_match w x),
       @eq bool (root_check_flag w) (Bit.toBool (literal_root_check x))
