### C.jet_secp_root_check.root_final_check_source
root_final_check_source
     : @eq Clight.statement
         (jet_secp_root_chain_owned.root_drop_statements
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
            (Clight.fn_body jets_secp.f_secp256k1_fe_sqrt_var)) root_final_check
### C.jet_secp_root_check.exec_root_final_check
exec_root_final_check
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bt ba : Values.block) (w : forall _ : nat, Integers.Int64.int)
         (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_root_chain_numeric.root_words_match w x) (_ : not (@eq Values.block bt ba))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._t1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_equal_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : jet_secp_fe_nv.fe_at m bt BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5
                   (jet_secp_square_numeric.square_words (jet_secp_root_chain_numeric.root_chain_candidate w))))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m root_final_check Events.E0
               (@Maps.PTree.set Values.val jets_secp._t'1
                  (Values.Vint
                     match root_check_flag w return Integers.Int.int with
                     | true => Integers.Int.one
                     | false => Integers.Int.zero
                     end) le) mf
               (ClightBigstep.Out_return
                  (@Some (prod Values.val Ctypes.type)
                     (@pair Values.val Ctypes.type
                        (Values.Vint
                           match root_check_flag w return Integers.Int.int with
                           | true => Integers.Int.one
                           | false => Integers.Int.zero
                           end) Ctypesdefs.tint))))
            (and
               (Memory.Mem.range_perm mf bt BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) =>
                      and (not (@eq Values.block b bt)) (not (@eq Values.block b ba))) m mf))))
### C.jet_secp_root_check.root_check_flag
root_check_flag =
fun w : forall _ : nat, Integers.Int64.int =>
BinInt.Z.eqb
  (BinInt.Z.modulo
     (jet_secp_multiply_finish_product.radix_value
        (jet_secp_square_numeric.square_words (jet_secp_root_chain_numeric.root_chain_candidate w)))
     jet_secp_fe_math.feP) (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)
     : forall _ : forall _ : nat, Integers.Int64.int, bool

Arguments root_check_flag w%function_scope
### C.jet_secp_root_check.literal_root_check
literal_root_check =
fun x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
  (@jet_secp_literal_add_program.literal_fe_add Alg.CoreFunSem
     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (@jet_secp_negate_literal_contract.literal_fe_negate Alg.CoreFunSem x)
        (@jet_secp_square_execution.literal_fe_square Alg.CoreFunSem
           (jet_secp_root_chain_numeric.literal_root_candidate x))))
     : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))), Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)

Arguments literal_root_check x
### C.jet_secp_root_check.root_final_equal
root_final_equal =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_equal_var jets_secp.f_secp256k1_fe_equal_var
  (@Some AST.ident jets_secp._t'1)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._t1)
     (@cons Clight.expr (Clight.Etempvar jets_secp._a (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_root_check.root_final_check
root_final_check =
Clight.Ssequence root_final_equal (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tint)))
     : Clight.statement
