### C.jet_secp_modinv_var_free.inv_local_size
inv_local_size =
fun r : nat =>
match PeanoNat.Nat.eqb r (S (S (S (S (S (S O)))))) return BinNums.Z with
| true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
| false => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
end
     : forall _ : nat, BinNums.Z

Arguments inv_local_size r%nat_scope
### C.jet_secp_modinv_var_free.inv_local_id
inv_local_id =
fun r : nat =>
match r return AST.ident with
| O => jets_secp._t
| S n =>
    match n return AST.ident with
    | O => jets_secp._t
    | S n0 =>
        match n0 return AST.ident with
        | O => jets_secp._d
        | S n1 =>
            match n1 return AST.ident with
            | O => jets_secp._e
            | S n2 =>
                match n2 return AST.ident with
                | O => jets_secp._f
                | S n3 => match n3 return AST.ident with
                          | O => jets_secp._g
                          | S _ => jets_secp._t
                          end
                end
            end
        end
    end
end
     : forall _ : nat, AST.ident

Arguments inv_local_id r%nat_scope
### C.jet_secp_modinv_var_free.inv_free_outside
inv_free_outside =
fun (beta : jet_sx_state.layout) (b : Values.block) =>
forall (r : nat) (_ : and (le (S (S O)) r) (lt r (S (S (S (S (S (S (S O))))))))),
not (@eq Values.block b (jet_sx_state.blk beta r))
     : forall (_ : jet_sx_state.layout) (_ : Values.block), Prop

Arguments inv_free_outside beta b
