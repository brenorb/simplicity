### C.jet_secp_mixed_copy_weak_loose.exec_mixed_copy_weak_loose
exec_mixed_copy_weak_loose
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (ba bu : Values.block) (y : bool) (w : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   match y return BinNums.positive with
                   | true => jets_secp._s1
                   | false => jets_secp._u1
                   end e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bu jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalize_weak e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block ba bu))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (w i))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : jet_secp_fe_nv.fe_at m ba
                match y return BinNums.Z with
                | true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                | false => BinNums.Z0
                end (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bu BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (jet_secp_mixed_copy_weak.mixed_copy_coordinate y) Events.E0 le mc ClightBigstep.Out_normal)
               (and
                  (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le mc
                     (jet_secp_mixed_copy_weak.mixed_weak_coordinate y) Events.E0 le mf ClightBigstep.Out_normal)
                  (and
                     (jet_secp_fe_nv.fe_at mf bu BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (jet_secp_field_weak_loose.weak_loose_words w)))
                     (and
                        (Memory.Mem.range_perm mf bu BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_secp_fe_nv.fe_at mf ba
                              match y return BinNums.Z with
                              | true =>
                                  BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                              | false => BinNums.Z0
                              end (jet_secp_multiply_normalize_bridge.words5 w))
                           (and
                              (Memory.Mem.range_perm mf ba BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (@eq BinNums.Z
                                    (BinInt.Z.modulo
                                       (jet_secp_multiply_finish_product.radix_value
                                          (jet_secp_field_weak_loose.weak_loose_words w)) jet_secp_fe_math.feP)
                                    (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w)
                                       jet_secp_fe_math.feP))
                                 (and
                                    (jet_secp_field_mul_small.mul_small_input_bounds
                                       (jet_secp_field_weak_loose.weak_loose_words w))
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bu)) m mf))))))))))
