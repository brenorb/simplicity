### C.jet_secp_symbolic_substitution.zval_sx_subst
zval_sx_subst
     : forall (sigma : forall _ : nat, jet_sx_expr.sx) (rho : forall _ : nat, BinNums.Z) (x : jet_sx_expr.sx),
       @eq BinNums.Z (jet_sx_zval.zval rho (sx_subst sigma x))
         (jet_sx_zval.zval (fun n : nat => jet_sx_zval.zval rho (sigma n)) x)
### C.jet_secp_symbolic_substitution.zcells_cell_subst
zcells_cell_subst
     : forall (sigma : forall _ : nat, jet_sx_expr.sx) (rho : forall _ : nat, BinNums.Z)
         (cells : list jet_sx_state.cell),
       @eq (list BinNums.Z)
         (jet_sx_zrep.zcells rho (@List.map jet_sx_state.cell jet_sx_state.cell (cell_subst sigma) cells))
         (jet_sx_zrep.zcells (fun n : nat => jet_sx_zval.zval rho (sigma n)) cells)
