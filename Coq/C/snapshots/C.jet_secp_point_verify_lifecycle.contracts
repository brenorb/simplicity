### C.jet_secp_point_verify_lifecycle.point_verify_guard_route_bool
point_verify_guard_route_bool
     : forall a b c : bool,
       @eq bool (andb a (andb b c)) match andb a b return bool with
                                    | true => c
                                    | false => false
                                    end
### C.jet_secp_point_verify_lifecycle.eval_point_verify_initialized
eval_point_verify_initialized
     : forall (_ : jet_memset_model.memset_model) (v_env : Values.val) (m0 : Memory.Mem.mem)
         (bd : Values.block) (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (inedge rc : BinNums.Z)
         (raw ng ax bxword : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (ay bybit : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (_ : jet_secp_linear_startup.linear_startup m0)
         (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m0 bs sbase bi inedge rc)
         (_ : jet_encoding.frame_input_cells_at m0 bi inedge rc
                (@List.map bool (option bool) (@Some bool)
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) raw)))
         (_ : jet_encoding.frame_input_cells_at m0 bi inedge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                (@Translate.encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      ay ax)))
         (_ : jet_encoding.frame_input_cells_at m0 bi inedge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                (@List.map bool (option bool) (@Some bool)
                   (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) ng)))
         (_ : jet_encoding.frame_input_cells_at m0 bi inedge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                (@Translate.encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      bybit bxword))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xI
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                Integers.Int64.max_unsigned),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m0
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_point_verify_1)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val v_env (@nil Values.val)))) Events.E0 mf
               (Values.Vint
                  (jet_readBit_layout.bit_int
                     (Bit.toBool
                        (@jet_secp_point_verify_literal.literal_point_check Alg.CoreFunSem
                           (@pair
                              (prod
                                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                              (@pair
                                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) raw
                                    (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ay ax)) ng)
                              (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) bybit bxword)))))))
            (and
               (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf
                  (Bit.toBool
                     (@jet_secp_point_verify_literal.literal_point_check Alg.CoreFunSem
                        (@pair
                           (prod
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                           (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                           (@pair
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) raw
                                 (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ay ax)) ng)
                           (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) bybit bxword))))
                  (@nil BitMachine.Cell))
               (and
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) => not (jet_secp_frame.extA m0 bd bw bi b)) m0 mf)
                  (jet_secp_linear_startup.linear_startup mf))))
