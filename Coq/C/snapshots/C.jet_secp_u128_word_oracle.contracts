### C.jet_secp_u128_word_oracle.add64_carry_value
add64_carry_value
     : forall L H X : Integers.Int64.int,
       let lo : Integers.Int64.int := Integers.Int64.add L X in
       let hi : Integers.Int64.int :=
         Integers.Int64.add H
           (Integers.Int64.repr
              (Integers.Int.signed
                 match Integers.Int64.ltu lo X return Integers.Int.int with
                 | true => Integers.Int.one
                 | false => Integers.Int.zero
                 end)) in
       @eq BinNums.Z
         (BinInt.Z.add
            (BinInt.Z.mul (Integers.Int64.unsigned hi)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
            (Integers.Int64.unsigned lo))
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.add
                  (BinInt.Z.mul (Integers.Int64.unsigned H)
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (Integers.Int64.unsigned L)) (Integers.Int64.unsigned X))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
