                    end
                end
            | false =>
                match PeanoNat.Nat.eqb tag tSHR64 return (option BinNums.Z) with
                | true =>
                    match vs return (option BinNums.Z) with
                    | nil => @None BinNums.Z
                    | cons l l0 =>
