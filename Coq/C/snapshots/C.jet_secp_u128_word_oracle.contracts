### C.jet_secp_u128_word_oracle.mk_mul
mk_mul =
fun (xs : list jet_sx_expr.sx) (_ : list jet_sx_state.region) =>
match xs return (option (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))) with
| nil => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
| cons s l =>
    match s return (option (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))) with
    | jet_sx_expr.XI _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XIc _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XL _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XLc _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XLv _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XV _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XA _ _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XP r d =>
        match d return (option (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))) with
        | BinNums.Z0 =>
            match l return (option (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))) with
            | nil => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
            | cons X l0 =>
