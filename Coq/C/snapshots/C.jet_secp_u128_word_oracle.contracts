                | nil => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
                | cons Y l1 =>
                    match
                      l1 return (option (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx)))
                    with
                    | nil =>
                        match
                          andb (jet_sx_expr.isk jet_sx_expr.KL X) (jet_sx_expr.isk jet_sx_expr.KL Y)
                          return (option (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx)))
                        with
                        | true =>
                            @Some (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
