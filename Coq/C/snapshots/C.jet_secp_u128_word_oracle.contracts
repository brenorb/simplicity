                                       (jet_sx_expr.XLc Integers.Int64.zero)))
                                 (@cons jet_sx_expr.sx X (@cons jet_sx_expr.sx Y (@nil jet_sx_expr.sx))))
                        | false => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
                        end
