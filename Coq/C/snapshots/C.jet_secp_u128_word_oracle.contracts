### C.jet_secp_u128_word_oracle.tSHR64
tSHR64 = S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
     : nat
### C.jet_secp_u128_word_oracle.u128_sem
u128_sem =
fun (tag : nat) (vs : list BinNums.Z) =>
match PeanoNat.Nat.eqb tag tMUL return (option BinNums.Z) with
| true =>
    match vs return (option BinNums.Z) with
    | nil => @None BinNums.Z
    | cons x l =>
        match l return (option BinNums.Z) with
        | nil => @None BinNums.Z
        | cons y l0 =>
            match l0 return (option BinNums.Z) with
            | nil => @Some BinNums.Z (BinInt.Z.mul x y)
            | cons _ _ => @None BinNums.Z
            end
        end
    end
| false =>
    match PeanoNat.Nat.eqb tag tACC return (option BinNums.Z) with
    | true =>
        match vs return (option BinNums.Z) with
        | nil => @None BinNums.Z
        | cons l l0 =>
            match l0 return (option BinNums.Z) with
            | nil => @None BinNums.Z
            | cons h l1 =>
                match l1 return (option BinNums.Z) with
                | nil => @None BinNums.Z
                | cons x l2 =>
                    match l2 return (option BinNums.Z) with
                    | nil => @None BinNums.Z
                    | cons y l3 =>
                        match l3 return (option BinNums.Z) with
                        | nil =>
                            @Some BinNums.Z
                              (BinInt.Z.modulo
                                 (BinInt.Z.add
                                    (BinInt.Z.add
                                       (BinInt.Z.mul h
                                          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                       l) (BinInt.Z.mul x y))
                                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                        | cons _ _ => @None BinNums.Z
                        end
                    end
                end
            end
        end
    | false =>
        match PeanoNat.Nat.eqb tag tADD return (option BinNums.Z) with
        | true =>
            match vs return (option BinNums.Z) with
            | nil => @None BinNums.Z
            | cons l l0 =>
                match l0 return (option BinNums.Z) with
                | nil => @None BinNums.Z
                | cons h l1 =>
                    match l1 return (option BinNums.Z) with
                    | nil => @None BinNums.Z
                    | cons x l2 =>
                        match l2 return (option BinNums.Z) with
                        | nil =>
                            @Some BinNums.Z
                              (BinInt.Z.modulo
                                 (BinInt.Z.add
                                    (BinInt.Z.add
                                       (BinInt.Z.mul h
                                          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                       l) x)
                                 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                        | cons _ _ => @None BinNums.Z
                        end
                    end
                end
            end
        | false =>
            match PeanoNat.Nat.eqb tag tSHR52 return (option BinNums.Z) with
            | true =>
                match vs return (option BinNums.Z) with
                | nil => @None BinNums.Z
                | cons l l0 =>
                    match l0 return (option BinNums.Z) with
                    | nil => @None BinNums.Z
                    | cons h l1 =>
                        match l1 return (option BinNums.Z) with
                        | nil =>
                            @Some BinNums.Z
                              (BinInt.Z.div
                                 (BinInt.Z.add
                                    (BinInt.Z.mul h
                                       (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                          (BinNums.Zpos
