### C.jet_secp_u128_word_oracle.uns_range
uns_range
     : forall x : Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned x))
         (BinInt.Z.lt (Integers.Int64.unsigned x)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_u128_word_oracle.two_word_split
two_word_split
     : forall (v : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 v)
                (BinInt.Z.lt v
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       and
         (and
            (BinInt.Z.le BinNums.Z0
               (BinInt.Z.modulo v
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
            (BinInt.Z.lt
               (BinInt.Z.modulo v
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (and
            (BinInt.Z.le BinNums.Z0
               (BinInt.Z.div v
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
            (BinInt.Z.lt
               (BinInt.Z.div v
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_u128_word_oracle.mk_mul_inv
mk_mul_inv
     : forall (xs : list jet_sx_expr.sx) (regs : list jet_sx_state.region) (r : nat)
         (sigma : forall _ : nat, jet_sx_expr.sx) (eargs : list jet_sx_expr.sx)
         (_ : @eq (option (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx)))
                (mk_mul xs regs)
                (@Some (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
                   (@pair (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx)
                      (@pair nat (forall _ : nat, jet_sx_expr.sx) r sigma) eargs))),
       @ex jet_sx_expr.sx
         (fun X : jet_sx_expr.sx =>
          @ex jet_sx_expr.sx
            (fun Y : jet_sx_expr.sx =>
             and
               (@eq (list jet_sx_expr.sx) eargs (@cons jet_sx_expr.sx X (@cons jet_sx_expr.sx Y (@nil jet_sx_expr.sx))))
               (and
                  (@eq (forall _ : nat, jet_sx_expr.sx) sigma
                     (sigma4 X Y (jet_sx_expr.XLc Integers.Int64.zero) (jet_sx_expr.XLc Integers.Int64.zero)))
                  (and (@eq bool (jet_sx_expr.isk jet_sx_expr.KL X) true)
                     (@eq bool (jet_sx_expr.isk jet_sx_expr.KL Y) true)))))
