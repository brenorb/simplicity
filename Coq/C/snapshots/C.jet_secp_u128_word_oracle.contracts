### C.jet_secp_u128_word_oracle.u128_inner_pure
u128_inner_pure
     : forall (fd : Clight.function) (xs : list jet_sx_expr.sx) (regs : list jet_sx_state.region)
         (st : jet_sx_eval.sstate) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem)
         (_ : @eq (option jet_sx_exec.res) (u128_inner fd xs regs)
                (@Some jet_sx_exec.res (jet_sx_exec.RDone st jet_sx_exec.ONormal)))
         (_ : @eq (list jet_sx_eval.event) (jet_sx_eval.slog st) (@nil jet_sx_eval.event))
         (_ : jet_sx_state.rep rho beta regs m),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          @ex Values.val
            (fun vres : Values.val =>
             and
               (ClightBigstep.eval_funcall Clight.function_entry2 jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function fd)
                  (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho (jet_sx_state.lay beta)) xs) Events.E0 m'
                  vres)
               (and (jet_sx_state.rep rho beta (jet_sx_eval.sregs st) m')
                  (and
                     match @Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps st) return Prop with
                     | Some x => @eq Values.val vres (jet_sx_expr.den rho (jet_sx_state.lay beta) x)
                     | None => @eq Values.val vres Values.Vundef
                     end
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape (jet_sx_eval.sregs st))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape regs))
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (o : BinNums.Z) =>
                            not
                              (jet_sx_state.foot beta
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape regs) b o)) m m'))))))
