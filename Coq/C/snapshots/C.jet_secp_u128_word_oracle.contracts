                   (@pair (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx)
                      (@pair nat (forall _ : nat, jet_sx_expr.sx) r sigma) eargs))),
       @ex jet_sx_expr.sx
         (fun X : jet_sx_expr.sx =>
          @ex jet_sx_expr.sx
            (fun Y : jet_sx_expr.sx =>
             @ex jet_sx_expr.sx
               (fun L : jet_sx_expr.sx =>
                @ex jet_sx_expr.sx
