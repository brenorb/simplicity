                     (and (@eq (forall _ : nat, jet_sx_expr.sx) sigma (sigma4 X Y L H))
                        (and (@eq bool (jet_sx_expr.isk jet_sx_expr.KL X) true)
                           (and (@eq bool (jet_sx_expr.isk jet_sx_expr.KL Y) true)
                              (and (@eq bool (jet_sx_expr.isk jet_sx_expr.KL L) true)
                                 (@eq bool (jet_sx_expr.isk jet_sx_expr.KL H) true)))))))))
