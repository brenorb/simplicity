        | BinNums.Zneg _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
        end
    | jet_sx_expr.XIb _ _ _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XLb _ _ _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XIsh _ _ _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XLsh _ _ _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
    | jet_sx_expr.XIcmp _ _ _ _ => @None (prod (prod nat (forall _ : nat, jet_sx_expr.sx)) (list jet_sx_expr.sx))
