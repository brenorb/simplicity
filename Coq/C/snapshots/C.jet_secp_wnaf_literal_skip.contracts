         (BinInt.Z.div (BinInt.Z.add (BinInt.Z.div n (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) bit)) carry)
            (BinNums.Zpos (BinNums.xO BinNums.xH)))
         (BinInt.Z.add
            (BinInt.Z.div n
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.add bit (BinNums.Zpos BinNums.xH))))
            carry)
