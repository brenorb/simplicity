### C.jet_secp_affine_negate_call.exec_affine_negate_body_output
exec_affine_negate_body_output
     : forall (le0 : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (b : Values.block) (value : BinNums.Z)
         (xlimbs : list Integers.Int64.int) (flag : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le0)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le0)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : le (@length Integers.Int64.int xlimbs) (S (S (S (S (S O))))))
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 xlimbs)
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m b
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le0 m
               (Clight.fn_body jets_secp.f_secp256k1_ge_neg) Events.E0 le0 mf ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf b BinNums.Z0 xlimbs)
               (and
                  (jet_secp_fe_nv.fe_at mf b
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_field_negate_storage.negate_values
                        (jet_secp_write_fe_numeric.write_fe_rho value BinNums.Z0)))
                  (and
                     (Memory.Mem.range_perm mf b BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf b
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@Some Values.val (Values.Vint flag)))
                        (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m
                           mf))))))
### C.jet_secp_affine_negate_call.affine_negate_helper_entry
affine_negate_helper_entry
     : forall (m : Memory.Mem.mem) (b : Values.block),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_ge_neg
         (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val))) m Clight.empty_env
         (affine_negate_helper_temps b) m
### C.jet_secp_affine_negate_call.affine_negate_helper_temp_r
affine_negate_helper_temp_r
     : forall b : Values.block,
