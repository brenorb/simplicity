### C.jet_secp_affine_negate_call.eval_affine_negate_point_output
eval_affine_negate_point_output
     : forall (m : Memory.Mem.mem) (b : Values.block) (value : BinNums.Z) (xlimbs : list Integers.Int64.int)
         (flag : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
