### C.jet_secp_gej_add_nonzero_tail.gej_add_nonzero_tail_frame
gej_add_nonzero_tail_frame =
fun (pa pb bh b2 b3 bt bu bi bs bx : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block bx pa))
  (and (not (@eq Values.block bx pb))
     (and (not (@eq Values.block bx bh))
        (and (not (@eq Values.block bx b2))
           (and (not (@eq Values.block bx b3))
              (and (not (@eq Values.block bx bt))
                 (and (not (@eq Values.block bx bu))
                    (and (not (@eq Values.block bx bi)) (not (@eq Values.block bx bs)))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

