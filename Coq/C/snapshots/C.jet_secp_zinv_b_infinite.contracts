### C.jet_secp_zinv_b_infinite.zinv_b_infinite_source
zinv_b_infinite_source
     : @eq Clight.statement jet_secp_zinv_finite.zinv_b_head
         (Clight.Ssequence
            (Clight.Sset jets_secp._t'3 (jet_secp_mixed_finite_start.mixed_b_field jets_secp._infinity Ctypesdefs.tint))
            (Clight.Sifthenelse (Clight.Etempvar jets_secp._t'3 Ctypesdefs.tint)
               (Clight.Ssequence jet_secp_gej_add_infinite.gej_add_copy_a (Clight.Sreturn (@None Clight.expr)))
               Clight.Sskip))
### C.jet_secp_zinv_b_infinite.exec_zinv_b_infinite
exec_zinv_b_infinite
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bp ba : Values.block)
         (flag : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag))) (_ : not (@eq Integers.Int.int flag Integers.Int.zero))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               (Clight.fn_body jets_secp.f_secp256k1_gej_add_zinv_var) Events.E0
               (@Maps.PTree.set Values.val jets_secp._t'3 (Values.Vint flag)
                  (@Maps.PTree.set Values.val jets_secp._t'4 (Values.Vint Integers.Int.zero) le)) mf
               (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type))))
            (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mf))
