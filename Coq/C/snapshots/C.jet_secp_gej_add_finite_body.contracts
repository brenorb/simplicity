### C.jet_secp_gej_add_finite_body.gej_add_finite_x_words
gej_add_finite_x_words =
fun x y z u v w : forall _ : nat, Integers.Int64.int =>
match
  BinInt.Z.eqb
    (BinInt.Z.modulo
       (jet_secp_multiply_finish_product.radix_value (jet_secp_gej_add_finite_difference.gej_add_h_words x z u w))
       jet_secp_fe_math.feP) BinNums.Z0 return (forall _ : nat, Integers.Int64.int)
with
| true =>
    jet_secp_mixed_zero_return.mixed_zero_words (jet_secp_gej_add_finite_difference.gej_add_i_words y z v w)
      (jet_secp_double_all_calls.double_output_x_words x y)
| false =>
    jet_secp_mixed_nonzero_tail.mixed_nonzero_x_words (jet_secp_gej_add_finite_difference.gej_add_h_words x z u w)
      (jet_secp_gej_add_finite_difference.gej_add_i_words y z v w)
      (jet_secp_gej_add_finite_difference.gej_add_u1_words x w)
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : nat), Integers.Int64.int

