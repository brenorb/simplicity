### C.jet_secp_gej_add_finite_body.gej_add_finite_out
gej_add_finite_out =
fun x z u w : forall _ : nat, Integers.Int64.int =>
match
  BinInt.Z.eqb
    (BinInt.Z.modulo
       (jet_secp_multiply_finish_product.radix_value (jet_secp_gej_add_finite_difference.gej_add_h_words x z u w))
