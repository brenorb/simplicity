      (jet_secp_gej_add_finite_difference.gej_add_i_words y z v w)
| false =>
    @Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint Integers.Int.zero)
      (jet_secp_gej_add_finite_prepare.gej_add_finite_prepare_temps le)
end
     : forall (_ : Maps.PTree.tree Values.val) (_ : forall _ : nat, Integers.Int64.int)
