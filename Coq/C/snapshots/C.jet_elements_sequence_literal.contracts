### C.jet_elements_sequence_literal.haskell_from_word_acc_matches
haskell_from_word_acc_matches
     : forall (n : nat) (i : BinNums.Z) (a : Ty.tySem (Word.Word n)),
       @eq BinNums.Z (haskell_from_word_acc n i a)
         (BinInt.Z.add (BinInt.Z.mul i (jet_predicate_spec.word_modulus n)) (@Word.ToZ.Theory.toZ (Word.WordToZ n) a))
### C.jet_elements_sequence_literal.haskell_from_word_matches
haskell_from_word_matches
     : forall (n : nat) (a : Ty.tySem (Word.Word n)),
       @eq BinNums.Z (haskell_from_word n a) (@Word.ToZ.Theory.toZ (Word.WordToZ n) a)
### C.jet_elements_sequence_literal.elements_input_sequence_literal_matches
elements_input_sequence_literal_matches
     : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))))
         (@jet_elements_indexed_scalar_jets.elements_input_sequence_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment) (elements_input_sequence_literal_spec a environment)
### C.jet_elements_sequence_literal.application_jet_local_spec_sep_pointwise
application_jet_local_spec_sep_pointwise
     : forall (f : Clight.function) (ge : Clight.genv) (E : Set) (A B : Ty.Ty)
         (rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E)
                  (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
         (spec1 spec2 : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B))
         (_ : forall (a : Ty.tySem A) (e : E), @eq (option (Ty.tySem B)) (spec1 a e) (spec2 a e))
         (_ : jet_application_sep.application_jet_local_spec_sep f ge E A B rep spec1),
       jet_application_sep.application_jet_local_spec_sep f ge E A B rep spec2
### C.jet_elements_sequence_literal.elements_input_sequence_literal_local_spec
elements_input_sequence_literal_local_spec
     : jet_application_sep.application_jet_local_spec_sep jets_elements.f_simplicity_input_sequence
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
         (@jet_elements_indexed_scalar.indexed_scalar_rep jet_elements_prim.sigTxInput
            (fun e : jet_elements_prim.Elements.env => jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx e))
            (fun txi : jet_elements_prim.sigTxInput => Integers.Int.unsigned (jet_elements_prim.sigTxiSequence txi))
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
            (BinNums.Zpos
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
            BinNums.Z0
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
         elements_input_sequence_literal_spec
### C.jet_elements_sequence_literal.haskell_from_word_acc
haskell_from_word_acc =
fix haskell_from_word_acc (n : nat) : forall (_ : BinNums.Z) (_ : Ty.tySem (Word.Word n)), BinNums.Z :=
  match n as k return (forall (_ : BinNums.Z) (_ : Ty.tySem (Word.Word k)), BinNums.Z) with
  | O =>
      fun (i : BinNums.Z) (w : Ty.tySem (Word.Word O)) =>
      match w return BinNums.Z with
      | inl _ => BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) i
      | inr _ => BinInt.Z.add (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) i) (BinNums.Zpos BinNums.xH)
      end
  | S k =>
      fun (i : BinNums.Z) (w : Ty.tySem (Word.Word (S k))) =>
      match w return BinNums.Z with
      | pair hi lo => haskell_from_word_acc k (haskell_from_word_acc k i hi) lo
      end
  end
     : forall (n : nat) (_ : BinNums.Z) (_ : Ty.tySem (Word.Word n)), BinNums.Z

Arguments haskell_from_word_acc n%nat_scope _%Z_scope _
### C.jet_elements_sequence_literal.haskell_from_word
haskell_from_word =
fun (n : nat) (a : Ty.tySem (Word.Word n)) => haskell_from_word_acc n BinNums.Z0 a
     : forall (n : nat) (_ : Ty.tySem (Word.Word n)), BinNums.Z

Arguments haskell_from_word n%nat_scope a
### C.jet_elements_sequence_literal.elements_input_sequence_literal_spec
elements_input_sequence_literal_spec =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
  match
    @List.nth_error jet_elements_prim.sigTxInput
      (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment))
      (BinInt.Z.to_nat (haskell_from_word (S (S (S (S (S O))))) a))
    return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
  with
  | Some txi =>
      @inr unit (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
        (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S O)))))
           (Integers.Int.unsigned (jet_elements_prim.sigTxiSequence txi)))
  | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))) tt
  end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))

Arguments elements_input_sequence_literal_spec a environment
