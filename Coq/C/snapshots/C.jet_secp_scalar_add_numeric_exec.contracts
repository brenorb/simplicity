### C.jet_secp_scalar_add_numeric_exec.eval_scalar_add_mod_group_owned
eval_scalar_add_mod_group_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho layout jet_secp_scalar_add_run.scalar_add_initial_regs m)
         (_ : and (BinInt.Z.le BinNums.Z0 (jet_secp_scalar_add_numeric.scalar_add_input_value rho))
                (BinInt.Z.lt (jet_secp_scalar_add_numeric.scalar_add_input_value rho)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) jet_secp_canonical_scalar.canonical_group_order))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk layout O) (Integers.Ptrofs.repr (jet_sx_state.bas layout O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk layout (S O))
                           (Integers.Ptrofs.repr (jet_sx_state.bas layout (S O)))) (@nil Values.val)))) Events.E0 mf
               (Values.Vint
                  (jet_sx_expr.b2i
                     (BinInt.Z.leb jet_secp_canonical_scalar.canonical_group_order
                        (jet_secp_scalar_add_numeric.scalar_add_input_value rho)))))
            (and (jet_sx_state.rep rho layout (jet_sx_eval.sregs jet_secp_scalar_add_run.scalar_add_state) mf)
               (and
                  (and (@eq BinNums.Z (jet_sx_state.bas layout O) BinNums.Z0)
                     (Memory.Mem.range_perm mf (jet_sx_state.blk layout O) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable))
                  (and
                     (and (@eq BinNums.Z (jet_sx_state.bas layout (S O)) BinNums.Z0)
                        (Memory.Mem.range_perm mf (jet_sx_state.blk layout (S O)) BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable))
                     (and
                        (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                         @eq (option Values.val)
                           (Memory.Mem.load AST.Mint64 mf (jet_sx_state.blk layout O)
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.of_nat i)))
                           (@Some Values.val
                              (Values.Vlong
                                 (jet_secp_scalar_add_reduced.scalar_add_limb rho (jet_sx_state.lay layout) i))))
                        (and
                           (@eq BinNums.Z
                              (jet_secp_scalar_add_reduced.scalar_add_output_value rho (jet_sx_state.lay layout))
                              (BinInt.Z.modulo (jet_secp_scalar_add_numeric.scalar_add_input_value rho)
                                 jet_secp_canonical_scalar.canonical_group_order))
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (jet_sx_state.foot layout
                                    (@List.map jet_sx_state.region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       jet_sx_state.rshape jet_secp_scalar_add_run.scalar_add_initial_regs) b ofs)) m
                              mf)))))))
