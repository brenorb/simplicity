### C.jet_secp_table_get_negate.exec_table_get_negate
exec_table_get_negate
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (y : forall _ : nat, Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bd Integers.Ptrofs.zero)))
         (_ : jet_secp_fe_nv.fe_at m bd
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m
               jet_secp_table_get_control.table_get_negate Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf bd
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_field_negate_separate.negate_sep_words y)))
               (and
                  (Memory.Mem.range_perm mf bd BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block b bd))
                        (or
                           (BinInt.Z.lt pos
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (BinInt.Z.le
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                     m mf))))
