### C.jet_elements_taptweak_beta_step.elements_taptweak_beta_aux_frame
elements_taptweak_beta_aux_frame =
fun (bt bx : Values.block) (i : BinNums.Z) (b : Values.block) (pos : BinNums.Z) =>
and
  (or (not (@eq Values.block b bx))
     (or
        (BinInt.Z.lt pos
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) i))
        (BinInt.Z.le
           (BinInt.Z.add
              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                 i) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
  (and
     (or (not (@eq Values.block b bt))
        (or
           (BinInt.Z.lt pos
              (BinInt.Z.mul
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                 i))
           (BinInt.Z.le
              (BinInt.Z.add
                 (BinInt.Z.mul
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) i)
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
     (or (not (@eq Values.block b jet_elements_taptweak_beta.elements_taptweak_beta_block))
        (or (BinInt.Z.lt pos BinNums.Z0)
           (BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) pos))))
     : forall (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments elements_taptweak_beta_aux_frame bt bx i%Z_scope b pos%Z_scope
