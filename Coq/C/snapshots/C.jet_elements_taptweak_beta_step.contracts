         (_ : not (@eq Values.block bt bx))
         (_ : not (@eq Values.block bt jet_elements_taptweak_beta.elements_taptweak_beta_block))
         (_ : not (@eq Values.block bx jet_elements_taptweak_beta.elements_taptweak_beta_block))
