### C.jet_extend_word8_loop.extend_word8_loop_shape
extend_word8_loop_shape
     : forall s : extend_word8_size,
       @eq Clight.statement
         match Clight.fn_body (extend_word8_function s) return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s1 =>
             match s1 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s3 =>
                 match s3 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence _ s5 =>
                     match s5 return Clight.statement with
                     | Clight.Sskip => Clight.Sskip
                     | Clight.Sassign _ _ => Clight.Sskip
                     | Clight.Sset _ _ => Clight.Sskip
                     | Clight.Scall _ _ _ => Clight.Sskip
                     | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                     | Clight.Ssequence s6 _ =>
                         match s6 return Clight.statement with
                         | Clight.Sskip => Clight.Sskip
                         | Clight.Sassign _ _ => Clight.Sskip
                         | Clight.Sset _ _ => Clight.Sskip
                         | Clight.Scall _ _ _ => Clight.Sskip
                         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                         | Clight.Ssequence _ loop => loop
                         | Clight.Sifthenelse _ _ _ => Clight.Sskip
                         | Clight.Sloop _ _ => Clight.Sskip
                         | Clight.Sbreak => Clight.Sskip
                         | Clight.Scontinue => Clight.Sskip
                         | Clight.Sreturn _ => Clight.Sskip
                         | Clight.Sswitch _ _ => Clight.Sskip
                         | Clight.Slabel _ _ => Clight.Sskip
                         | Clight.Sgoto _ => Clight.Sskip
                         end
                     | Clight.Sifthenelse _ _ _ => Clight.Sskip
                     | Clight.Sloop _ _ => Clight.Sskip
                     | Clight.Sbreak => Clight.Sskip
                     | Clight.Scontinue => Clight.Sskip
                     | Clight.Sreturn _ => Clight.Sskip
                     | Clight.Sswitch _ _ => Clight.Sskip
                     | Clight.Slabel _ _ => Clight.Sskip
                     | Clight.Sgoto _ => Clight.Sskip
                     end
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end (extend_word8_loop s)
### C.jet_extend_word8_loop.eval_extend_word8_limit
eval_extend_word8_limit
     : forall (s : extend_word8_size) (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem),
       Clight.eval_expr jet_exec.ge0 e le m (extend_word8_limit s)
         (Values.Vint (Integers.Int.repr (extend_word8_count s)))
### C.jet_extend_word8_loop.eval_extend_word8_guard
eval_extend_word8_guard
     : forall (s : extend_word8_size) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i)))),
       Clight.eval_expr jet_exec.ge0 e le m (extend_word8_guard s)
         (Values.Vint (jet_readBit_layout.bit_int (BinInt.Z.ltb i (extend_word8_count s))))
### C.jet_extend_word8_loop.exec_extend_word8_fill
exec_extend_word8_fill
     : forall (bl : Values.block) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bd : Values.block) (base : BinNums.Z) (bit : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._msb le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vint (jet_extend_bit8_exec.extend_bit8_arg bit)) (@nil Values.val)))
                Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m extend_word8_fill Events.E0
         (@Maps.PTree.set Values.val jets._t'2 (Values.Vint (jet_extend_bit8_exec.extend_bit8_arg bit)) le) mf
         ClightBigstep.Out_normal
### C.jet_extend_word8_loop.exec_extend_word8_loop
exec_extend_word8_loop
     : forall (s : extend_word8_size) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bit : bool) (i : BinNums.Z)
         (n : nat) (_ : BinInt.Z.le BinNums.Z0 i)
         (_ : @eq BinNums.Z (BinInt.Z.add i (BinInt.Z.of_nat n)) (extend_word8_count s))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._msb le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : extend_word8_fill_run bd base bit n m mf),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (extend_word8_loop s) Events.E0 lef
               mf ClightBigstep.Out_normal)
            (forall (id : AST.ident) (_ : not (@eq AST.ident id jets._i)) (_ : not (@eq AST.ident id jets._t'2)),
             @eq (option Values.val) (@Maps.PTree.get Values.val id lef) (@Maps.PTree.get Values.val id le)))
### C.jet_extend_word8_loop.extend_word8_size
Inductive extend_word8_size : Set :=
    E8to16 : extend_word8_size | E8to32 : extend_word8_size | E8to64 : extend_word8_size.
### C.jet_extend_word8_loop.extend_word8_bits
extend_word8_bits =
fun s : extend_word8_size =>
match s return BinNums.Z with
| E8to16 => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
| E8to32 => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
| E8to64 => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
end
     : forall _ : extend_word8_size, BinNums.Z

Arguments extend_word8_bits s
### C.jet_extend_word8_loop.extend_word8_count
extend_word8_count =
fun s : extend_word8_size =>
match s return BinNums.Z with
| E8to16 => BinNums.Zpos BinNums.xH
| E8to32 => BinNums.Zpos (BinNums.xI BinNums.xH)
| E8to64 => BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))
end
     : forall _ : extend_word8_size, BinNums.Z

Arguments extend_word8_count s
### C.jet_extend_word8_loop.extend_word8_function
extend_word8_function =
fun s : extend_word8_size =>
match s return Clight.function with
| E8to16 => jets.f_simplicity_left_extend_8_16
| E8to32 => jets.f_simplicity_left_extend_8_32
| E8to64 => jets.f_simplicity_left_extend_8_64
end
     : forall _ : extend_word8_size, Clight.function

Arguments extend_word8_function s
### C.jet_extend_word8_loop.extend_word8_limit
extend_word8_limit =
fun s : extend_word8_size =>
Clight.Ebinop Cop.Osub
  (Clight.Ebinop Cop.Odiv (Clight.Econst_int (Integers.Int.repr (extend_word8_bits s)) Ctypesdefs.tint)
     (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
        Ctypesdefs.tint) Ctypesdefs.tint) (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint
     : forall _ : extend_word8_size, Clight.expr

Arguments extend_word8_limit s
### C.jet_extend_word8_loop.extend_word8_guard
extend_word8_guard =
fun s : extend_word8_size => Clight.Ebinop Cop.Olt jet_eq256_loop.eq256_index (extend_word8_limit s) Ctypesdefs.tint
     : forall _ : extend_word8_size, Clight.expr

Arguments extend_word8_guard s
### C.jet_extend_word8_loop.extend_word8_choose
extend_word8_choose =
Clight.Sifthenelse (Clight.Etempvar jets._msb Ctypesdefs.tbool)
  (Clight.Sset jets._t'2 (jet_extend_bit8_exec.extend_bit8_choice_expr true))
  (Clight.Sset jets._t'2 (jet_extend_bit8_exec.extend_bit8_choice_expr false))
     : Clight.statement
### C.jet_extend_word8_loop.extend_word8_fill
extend_word8_fill =
Clight.Ssequence extend_word8_choose
  (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write8 Ctypesdefs.tuchar Ctypesdefs.tvoid
     (Clight.Etempvar jets._t'2 Ctypesdefs.tint))
     : Clight.statement
### C.jet_extend_word8_loop.extend_word8_loop
extend_word8_loop =
fun s : extend_word8_size =>
Clight.Sloop
  (Clight.Ssequence (Clight.Sifthenelse (extend_word8_guard s) Clight.Sskip Clight.Sbreak) extend_word8_fill)
  jet_eq256_loop.eq256_loop_step
     : forall _ : extend_word8_size, Clight.statement

Arguments extend_word8_loop s
### C.jet_extend_word8_loop.extend_word8_fill_run
extend_word8_fill_run =
fix extend_word8_fill_run
  (bd : Values.block) (base : BinNums.Z) (bit : bool) (n : nat) (m mf : Memory.Mem.mem) {struct n} : Prop :=
  match n return Prop with
  | O => @eq Memory.Mem.mem m mf
  | S n0 =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         and
           (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
              (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
              (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                 (@cons Values.val (Values.Vint (jet_extend_bit8_exec.extend_bit8_arg bit)) (@nil Values.val)))
              Events.E0 mi Values.Vundef) (extend_word8_fill_run bd base bit n0 mi mf))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : bool) (_ : nat) (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments extend_word8_fill_run bd base%Z_scope bit%bool_scope n%nat_scope m mf
