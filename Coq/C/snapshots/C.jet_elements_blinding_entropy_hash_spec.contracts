### C.jet_elements_blinding_entropy_hash_spec.blinding_entropy_bytes
blinding_entropy_bytes =
fun v : Ty.tySem jet_elements_blinding_entropy_spec.blinding_entropy_value_type =>
match v return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl _ =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_zero
      (@nil (Ty.tySem (Word.Word (S (S (S O))))))
| inr p =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_ctx_hash_spec.byte_one
      (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O)))))) p)
end
     : forall _ : Ty.tySem jet_elements_blinding_entropy_spec.blinding_entropy_value_type,
       list (Ty.tySem (Word.Word (S (S (S O)))))

