### C.jet_elements_indexed_scalar.encode_indexed_inr
encode_indexed_inr
     : forall (s : jet_wide.wide_size) (w : Ty.tySem (Word.Word (jet_wide.wide_log s))),
       @eq (list BitMachine.Cell)
         (@Translate.encode (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s)))
            (@inr unit (Ty.tySem (Word.Word (jet_wide.wide_log s))) w))
         (@cons (option bool) (@Some bool true) (@Translate.encode (Word.Word (jet_wide.wide_log s)) w))
### C.jet_elements_indexed_scalar.encode_indexed_inl
encode_indexed_inl
     : forall s : jet_wide.wide_size,
       @eq (list BitMachine.Cell)
         (@Translate.encode (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s)))
            (@inl unit
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Word (jet_wide.wide_log s))) tt))
         (@cons (option bool) (@Some bool false)
            (@List.repeat (option bool) (@None bool) (BinInt.Z.to_nat (jet_wide.wide_bits s))))
### C.jet_elements_indexed_scalar.wide_bits_succ_frame
wide_bits_succ_frame
     : forall s : jet_wide.wide_size,
       @eq BinNums.Z (BinInt.Z.add (BinNums.Zpos BinNums.xH) (jet_wide.wide_bits s))
         (BinInt.Z.of_nat (Translate.bitSize (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s)))))
### C.jet_elements_indexed_scalar.toZ32_eq
toZ32_eq
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
       @eq BinNums.Z (toZ32 a) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a)
### C.jet_elements_indexed_scalar.elements_cast_const
elements_cast_const
     : forall (nb : BinNums.Z) (m : Memory.Mem.mem)
         (_ : and (BinInt.Z.le BinNums.Z0 nb)
                (BinInt.Z.le nb
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq (option Values.val) (Cop.sem_cast (Values.Vint (Integers.Int.repr nb)) Ctypesdefs.tint Ctypesdefs.tulong m)
         (@Some Values.val (Values.Vlong (Integers.Int64.repr nb)))
### C.jet_elements_indexed_scalar.elements_indexed_scalar_mid
@elements_indexed_scalar_mid
     : forall (A : Type) (s : jet_wide.wide_size) (elems : list A) (valz : forall _ : A, BinNums.Z)
         (specv : forall _ : A, Ty.tySem (Word.Word (jet_wide.wide_log s)))
         (tp cp t3 t4 t5 countfield arrfield sid wid : AST.ident) (cdelta adelta sz voff : BinNums.Z)
         (ve : Clight.expr) (wf f : Clight.function)
         (_ : and (not (@eq AST.ident tp jets_elements._env))
                (and (not (@eq AST.ident tp jets_elements._dst))
                   (and (not (@eq AST.ident tp jets_elements._i))
                      (and (not (@eq AST.ident tp jets_elements._t'1))
                         (and (not (@eq AST.ident tp jets_elements._t'2)) (not (@eq AST.ident tp cp)))))))
         (_ : and (not (@eq AST.ident cp jets_elements._env))
                (and (not (@eq AST.ident cp jets_elements._dst))
                   (and (not (@eq AST.ident cp jets_elements._i))
                      (and (not (@eq AST.ident cp jets_elements._t'1)) (not (@eq AST.ident cp jets_elements._t'2))))))
         (_ : not (@eq AST.ident t3 jets_elements._i)) (_ : not (@eq AST.ident t3 jets_elements._dst))
         (_ : not (@eq AST.ident t4 jets_elements._i)) (_ : not (@eq AST.ident t4 jets_elements._dst))
         (_ : not (@eq AST.ident t5 jets_elements._dst))
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function wid wf)
                jet_elements_transport.elements_core_helpers)
         (_ : @eq Ctypes.type (Clight.type_of_fundef (@Ctypes.Internal Clight.function wf))
                (Ctypes.Tfunction
                   (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                      (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
         (_ : forall bl : Values.block,
              @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) wid
                   (jet_elements_version_exec.elements_version_locals bl)) (@None (prod Values.block Ctypes.type)))
         (_ : @eq Clight.function wf (jet_wide.wide_writer s))
         (_ : jet_elements_field_eval.elements_field_at jets_elements._elementsTransaction countfield cdelta)
         (_ : jet_elements_field_eval.elements_field_at jets_elements._elementsTransaction arrfield adelta)
         (_ : and (BinInt.Z.le BinNums.Z0 cdelta)
                (BinInt.Z.le (BinInt.Z.add cdelta (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 adelta)
                (BinInt.Z.le (BinInt.Z.add adelta (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.lt BinNums.Z0 sz)
                (BinInt.Z.le sz
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 voff)
                (BinInt.Z.le (BinInt.Z.add voff (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) sz))
         (_ : forall x : A,
              @eq (Ty.tySem (Word.Word (jet_wide.wide_log s)))
                (jet_wide_spec.decode_wide s
                   (Integers.Int64.zero_ext (jet_wide.wide_bits s) (Integers.Int64.repr (valz x))))
                (specv x))
         (_ : forall (e : Clight.env) (le' : Maps.PTree.tree Values.val) (m' : Memory.Mem.mem)
                (bin : Values.block) (inbase : BinNums.Z) (r v : Integers.Int64.int)
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val t4 le')
                       (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._i le')
                       (@Some Values.val (Values.Vlong r))) (_ : BinInt.Z.le BinNums.Z0 inbase)
                (_ : BinInt.Z.le
                       (BinInt.Z.add
                          (BinInt.Z.add (BinInt.Z.add inbase (BinInt.Z.mul sz (Integers.Int64.unsigned r))) voff)
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                       Integers.Ptrofs.max_unsigned)
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m' bin
                          (BinInt.Z.add (BinInt.Z.add inbase (BinInt.Z.mul sz (Integers.Int64.unsigned r))) voff))
                       (@Some Values.val (Values.Vlong v))),
              Clight.eval_expr jet_elements_linkage.elements_ge e le' m' ve (Values.Vlong v))
         (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (be : Values.block) (ebase : BinNums.Z)
         (bt : Values.block) (txbase : BinNums.Z) (bin : Values.block) (inbase : BinNums.Z)
         (nI : Integers.Int64.int) (bytes : list Memdata.memval) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le
                (BinInt.Z.add ebase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 txbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add txbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 inbase)
         (_ : BinInt.Z.le (BinInt.Z.add inbase (BinInt.Z.mul sz (BinInt.Z.of_nat (@length A elems))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m be (BinInt.Z.add ebase BinNums.Z0))
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add txbase adelta))
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (BinInt.Z.add txbase cdelta))
                (@Some Values.val (Values.Vlong nI)))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned nI) (BinInt.Z.of_nat (@length A elems)))
         (_ : forall (j : nat) (x : A) (_ : @eq (option A) (@List.nth_error A elems j) (@Some A x)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bin
                   (BinInt.Z.add (BinInt.Z.add inbase (BinInt.Z.mul sz (BinInt.Z.of_nat j))) voff))
                (@Some Values.val (Values.Vlong (Integers.Int64.repr (valz x)))))
         (_ : jet_application_sep.out_sep bd dbase bw outedge cursor
                (BinInt.Z.add (BinNums.Zpos BinNums.xH) (jet_wide.wide_bits s)) be ebase
                (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : jet_application_sep.out_sep bd dbase bw outedge cursor
                (BinInt.Z.add (BinNums.Zpos BinNums.xH) (jet_wide.wide_bits s)) bt (BinInt.Z.add txbase adelta)
                (BinInt.Z.add (BinInt.Z.add txbase adelta)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : jet_application_sep.out_sep bd dbase bw outedge cursor
                (BinInt.Z.add (BinNums.Zpos BinNums.xH) (jet_wide.wide_bits s)) bin inbase
                (BinInt.Z.add inbase (BinInt.Z.mul sz (BinInt.Z.of_nat (@length A elems)))))
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge read_cursor)
         (_ : and (BinInt.Z.le BinNums.Z0 read_cursor)
                (BinInt.Z.le read_cursor
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @jet_input_layout.frame_input_word_at (S (S (S (S (S O))))) m bi edge read_cursor a)
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.add (BinNums.Zpos BinNums.xH) (jet_wide.wide_bits s)))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes)),
       jet_elements_wrapper.elements_wrapper_mid f
         (jet_elements_indexed_exec.elements_indexed_rest tp cp countfield
            (jet_elements_indexed_then.elements_indexed_then t3 t4 t5 arrfield sid ve wid)
            (elements_skip_stmt (jet_wide.wide_bits s)))
         (@Translate.encode (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s)))
            (@indexed_scalar_result A s elems specv a)) (Values.Vptr be (Integers.Ptrofs.repr ebase)) m bd dbase bs
         sbase bw outedge cursor (BinInt.Z.add (BinNums.Zpos BinNums.xH) (jet_wide.wide_bits s)) bytes
### C.jet_elements_indexed_scalar.elements_indexed_scalar_local
@elements_indexed_scalar_local
     : forall (A : Type) (s : jet_wide.wide_size) (elems_of : forall _ : jet_elements_prim.Elements.env, list A)
         (valz : forall _ : A, BinNums.Z) (specv : forall _ : A, Ty.tySem (Word.Word (jet_wide.wide_log s)))
         (tp cp t3 t4 t5 countfield arrfield sid wid : AST.ident) (cdelta adelta sz voff : BinNums.Z)
         (ve : Clight.expr) (wf f : Clight.function)
         (_ : and (not (@eq AST.ident tp jets_elements._env))
                (and (not (@eq AST.ident tp jets_elements._dst))
                   (and (not (@eq AST.ident tp jets_elements._i))
                      (and (not (@eq AST.ident tp jets_elements._t'1))
                         (and (not (@eq AST.ident tp jets_elements._t'2)) (not (@eq AST.ident tp cp)))))))
         (_ : and (not (@eq AST.ident cp jets_elements._env))
                (and (not (@eq AST.ident cp jets_elements._dst))
                   (and (not (@eq AST.ident cp jets_elements._i))
                      (and (not (@eq AST.ident cp jets_elements._t'1)) (not (@eq AST.ident cp jets_elements._t'2))))))
         (_ : not (@eq AST.ident t3 jets_elements._i)) (_ : not (@eq AST.ident t3 jets_elements._dst))
         (_ : not (@eq AST.ident t4 jets_elements._i)) (_ : not (@eq AST.ident t4 jets_elements._dst))
         (_ : not (@eq AST.ident t5 jets_elements._dst))
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function wid wf)
                jet_elements_transport.elements_core_helpers)
         (_ : @eq Ctypes.type (Clight.type_of_fundef (@Ctypes.Internal Clight.function wf))
                (Ctypes.Tfunction
                   (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                      (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
         (_ : forall bl : Values.block,
              @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) wid
                   (jet_elements_version_exec.elements_version_locals bl)) (@None (prod Values.block Ctypes.type)))
         (_ : @eq Clight.function wf (jet_wide.wide_writer s))
         (_ : jet_elements_field_eval.elements_field_at jets_elements._elementsTransaction countfield cdelta)
         (_ : jet_elements_field_eval.elements_field_at jets_elements._elementsTransaction arrfield adelta)
         (_ : and (BinInt.Z.le BinNums.Z0 cdelta)
                (BinInt.Z.le (BinInt.Z.add cdelta (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 adelta)
                (BinInt.Z.le (BinInt.Z.add adelta (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.lt BinNums.Z0 sz)
                (BinInt.Z.le sz
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 voff)
                (BinInt.Z.le (BinInt.Z.add voff (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) sz))
         (_ : forall x : A,
              @eq (Ty.tySem (Word.Word (jet_wide.wide_log s)))
                (jet_wide_spec.decode_wide s
                   (Integers.Int64.zero_ext (jet_wide.wide_bits s) (Integers.Int64.repr (valz x))))
                (specv x))
         (_ : forall (e : Clight.env) (le' : Maps.PTree.tree Values.val) (m' : Memory.Mem.mem)
                (bin : Values.block) (inbase : BinNums.Z) (r v : Integers.Int64.int)
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val t4 le')
                       (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._i le')
                       (@Some Values.val (Values.Vlong r))) (_ : BinInt.Z.le BinNums.Z0 inbase)
                (_ : BinInt.Z.le
                       (BinInt.Z.add
                          (BinInt.Z.add (BinInt.Z.add inbase (BinInt.Z.mul sz (Integers.Int64.unsigned r))) voff)
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                       Integers.Ptrofs.max_unsigned)
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m' bin
                          (BinInt.Z.add (BinInt.Z.add inbase (BinInt.Z.mul sz (Integers.Int64.unsigned r))) voff))
                       (@Some Values.val (Values.Vlong v))),
              Clight.eval_expr jet_elements_linkage.elements_ge e le' m' ve (Values.Vlong v))
         (_ : jet_elements_wrapper.elements_wrapper_shape f
                (jet_elements_indexed_exec.elements_indexed_rest tp cp countfield
                   (jet_elements_indexed_then.elements_indexed_then t3 t4 t5 arrfield sid ve wid)
                   (elements_skip_stmt (jet_wide.wide_bits s))))
         (spec : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
                 option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s)))))
         (_ : forall (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s))))) (spec a environment)
                (@Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s))))
                   (@indexed_scalar_result A s (elems_of environment) specv a))),
       jet_application_sep.application_jet_local_spec_sep f jet_elements_linkage.elements_ge
         jet_elements_prim.Elements.env (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s))) (@indexed_scalar_rep A elems_of valz sz voff adelta cdelta)
         spec
### C.jet_elements_indexed_scalar.elements_skip_stmt
elements_skip_stmt =
fun nbits : BinNums.Z =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._skipBits
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
     (@cons Clight.expr (Clight.Econst_int (Integers.Int.repr nbits) Ctypesdefs.tint) (@nil Clight.expr)))
     : forall _ : BinNums.Z, Clight.statement

Arguments elements_skip_stmt nbits%Z_scope
### C.jet_elements_indexed_scalar.indexed_scalar_result
indexed_scalar_result =
fun (A : Type) (s : jet_wide.wide_size) (elems : list A)
  (specv : forall _ : A, Ty.tySem (Word.Word (jet_wide.wide_log s))) (a : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
=>
match
  @List.nth_error A elems (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s))))
with
| Some x => @inr unit (Ty.tySem (Word.Word (jet_wide.wide_log s))) (specv x)
| None =>
    @inl unit
      ((fix tySem (X : Ty.Ty) : Set :=
          match X return Set with
          | Ty.Unit => unit
          | Ty.Sum A0 B => sum (tySem A0) (tySem B)
          | Ty.Prod A0 B => prod (tySem A0) (tySem B)
          end) (Word.Word (jet_wide.wide_log s))) tt
end
     : forall (A : Type) (s : jet_wide.wide_size) (_ : list A)
         (_ : forall _ : A, Ty.tySem (Word.Word (jet_wide.wide_log s)))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))), Ty.tySem (Ty.Sum Ty.Unit (Word.Word (jet_wide.wide_log s)))

Arguments indexed_scalar_result {A}%type_scope s elems%list_scope specv%function_scope a
### C.jet_elements_indexed_scalar.toZ32
toZ32 =
fun a : Ty.tySem (Word.Word (S (S (S (S (S O)))))) => @Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a
     : forall _ : Ty.tySem (Word.Word (S (S (S (S (S O)))))), BinNums.Z

Arguments toZ32 a
### C.jet_elements_indexed_scalar.indexed_scalar_rep
indexed_scalar_rep =
fun (A : Type) (elems_of : forall _ : jet_elements_prim.Elements.env, list A) (valz : forall _ : A, BinNums.Z)
  (sz voff adelta cdelta : BinNums.Z) (m : Memory.Mem.mem) (env : Values.val)
  (environment : jet_elements_prim.Elements.env) (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Values.block
              (fun bin : Values.block =>
               @ex BinNums.Z
                 (fun inbase : BinNums.Z =>
                  @ex Integers.Int64.int
                    (fun nI : Integers.Int64.int =>
                     and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                       (and (BinInt.Z.le BinNums.Z0 ebase)
                          (and
                             (BinInt.Z.le
                                (BinInt.Z.add ebase
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                Integers.Ptrofs.max_unsigned)
                             (and (BinInt.Z.le BinNums.Z0 txbase)
                                (and
                                   (BinInt.Z.le
                                      (BinInt.Z.add txbase
                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))
                                      Integers.Ptrofs.max_unsigned)
                                   (and (BinInt.Z.le BinNums.Z0 inbase)
                                      (and
                                         (BinInt.Z.le
                                            (BinInt.Z.add inbase (BinInt.Z.mul sz (BinInt.Z.of_nat (@length A (...)))))
                                            Integers.Ptrofs.max_unsigned)
                                         (and
                                            (@eq (option Values.val)
                                               (Memory.Mem.load AST.Mptr m be (BinInt.Z.add ebase BinNums.Z0))
                                               (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                                            (and
                                               (@eq (option Values.val)
                                                  (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add txbase adelta))
                                                  (@Some Values.val (Values.Vptr bin (...))))
                                               (and
                                                  (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (...))
                                                     (@Some Values.val (...)))
                                                  (and (@eq BinNums.Z (...) (...)) (and (...) (...)))))))))))))))))))
     : forall (A : Type) (_ : forall _ : jet_elements_prim.Elements.env, list A) (_ : forall _ : A, BinNums.Z)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Memory.Mem.mem)
         (_ : Values.val) (_ : jet_elements_prim.Elements.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

