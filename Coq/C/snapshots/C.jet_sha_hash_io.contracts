### C.jet_sha_hash_io.hio_cast8
hio_cast8
     : forall m : Memory.Mem.mem,
       @eq (option Values.val)
         (Cop.sem_cast
            (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            Ctypesdefs.tint Ctypesdefs.tulong m)
         (@Some Values.val
            (Values.Vlong (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
### C.jet_sha_hash_io.eval_sha_midstate_array
eval_sha_midstate_array
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (x : BinNums.positive)
         (b : Values.block) (hbase : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val x le)
                (@Some Values.val (Values.Vptr b (Integers.Ptrofs.repr hbase)))),
       Clight.eval_expr jet_sha_linkage.sha_ge e le m
         (Clight.Efield
            (Clight.Ederef
               (Clight.Etempvar x (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)))
               (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)) jets_sha._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr b (Integers.Ptrofs.repr hbase))
### C.jet_sha_hash_io.eval_sha_readHash
eval_sha_readHash
     : forall (m : Memory.Mem.mem) (bo : Values.block) (output : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (_ : @eq nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le
                (BinInt.Z.add output
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) output)
         (_ : Memory.Mem.range_perm m bo output
                (BinInt.Z.add output
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable) (_ : not (@eq Values.block bf bo)) (_ : not (@eq Values.block bf bi))
         (_ : not (@eq Values.block bo bi)) (_ : jet_frame_layout.frame_base_valid base)
         (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : forall (i : nat) (x : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
                (_ : @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                       (@List.nth_error (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs i)
                       (@Some (Ty.tySem (Word.Word (S (S (S (S (S O))))))) x)),
              @jet_input_layout.frame_input_word_at (S (S (S (S (S O))))) m bi edge
                (BinInt.Z.add cursor
                   (BinInt.Z.mul
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.of_nat i))) x),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_sha.f_readHash)
               (@cons Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_uint32_array_init.uint32_array_at mf bo output
                  (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int
                     jet_read32s_layout.word32_array_value xs))
               (and
                  (jet_frame_layout.frame_fields_at mf bf base bi edge
                     (BinInt.Z.add cursor
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bo))
                               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) output)
                                  (BinInt.Z.le
                                     (BinInt.Z.add output
                                        (BinNums.Zpos
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                     ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
### C.jet_sha_hash_io.eval_sha_writeHash
eval_sha_writeHash
     : forall (m : Memory.Mem.mem) (bh : Values.block) (hbase : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z) (xs : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int xs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le BinNums.Z0 hbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add hbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bh bf)) (_ : not (@eq Values.block bh bw))
         (_ : jet_uint32_array_init.uint32_array_at m bh hbase xs)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_sha_linkage.sha_ge m
               (@Ctypes.Internal Clight.function jets_sha.f_writeHash)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bh (Integers.Ptrofs.repr hbase)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and (jet_encoding.frame_output_cells_at mf bw edge cursor (jet_write32s_layout.uint32_word_cells xs))
               (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bf base bw edge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bf
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
