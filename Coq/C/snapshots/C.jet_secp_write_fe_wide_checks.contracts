### C.jet_secp_write_fe_wide_checks.wide_write_condition_checked
wide_write_condition_checked
     : forall (bd : Values.block) (base : Integers.Ptrofs.int),
       and
         (@eq (option (prod BinNums.Z BinNums.Z))
            (jet_sx_zval.zb wide_write_bounds (jet_secp_write_fe_numeric.write_fe_condition bd base))
            (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))))
         (@eq bool (jet_sx_expr.isk jet_sx_expr.KI (jet_secp_write_fe_numeric.write_fe_condition bd base)) true)
### C.jet_secp_write_fe_wide_checks.wide_write_true_bytes_checked
wide_write_true_bytes_checked
     : forall (bd : Values.block) (base : Integers.Ptrofs.int),
       @List.Forall jet_sx_expr.sx
         (fun x : jet_sx_expr.sx =>
          and
            (@eq (option (prod BinNums.Z BinNums.Z)) (jet_sx_zval.zb wide_write_bounds x)
               (@Some (prod BinNums.Z BinNums.Z)
                  (@pair BinNums.Z BinNums.Z BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xI
                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
            (@eq bool (jet_sx_expr.isk jet_sx_expr.KI x) true)) (jet_secp_write_fe_numeric.write_fe_true_bytes bd base)
### C.jet_secp_write_fe_wide_checks.wide_write_false_bytes_checked
wide_write_false_bytes_checked
     : forall (bd : Values.block) (base : Integers.Ptrofs.int),
       @List.Forall jet_sx_expr.sx
         (fun x : jet_sx_expr.sx =>
          and
            (@eq (option (prod BinNums.Z BinNums.Z)) (jet_sx_zval.zb wide_write_bounds x)
               (@Some (prod BinNums.Z BinNums.Z)
                  (@pair BinNums.Z BinNums.Z BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xI
                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
            (@eq bool (jet_sx_expr.isk jet_sx_expr.KI x) true))
         (jet_secp_write_fe_numeric.write_fe_false_bytes bd base)
### C.jet_secp_write_fe_wide_checks.wide_write_bounds
wide_write_bounds =
fun n : nat =>
match n return (prod BinNums.Z BinNums.Z) with
| O => @pair BinNums.Z BinNums.Z BinNums.Z0 Integers.Int64.max_unsigned
| S _ =>
    @pair BinNums.Z BinNums.Z BinNums.Z0
      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
end
     : forall _ : nat, prod BinNums.Z BinNums.Z

Arguments wide_write_bounds n%nat_scope
