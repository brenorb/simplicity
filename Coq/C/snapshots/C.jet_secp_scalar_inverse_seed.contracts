### C.jet_secp_scalar_inverse_seed.scalar_inv_start_words
scalar_inv_start_words
     : @eq (list Integers.Int64.int)
         (jet_secp_modinv_entry_modulus.inv_mod_words jet_secp_scalar_normalize62.modinfo_scalar_limb)
         jet_secp_modinfo_scalar_global.modinfo_scalar_words
### C.jet_secp_scalar_inverse_seed.scalar_inv_start_rep
scalar_inv_start_rep
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bs : Values.block)
         (_ : not (@eq Values.block bs jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block))
         (_ : jet_secp_fe_nv.fe_at m bs BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep m),
       jet_sx_state.rep w
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs BinNums.Z0)
            (@cons (prod Values.block BinNums.Z)
               (@pair Values.block BinNums.Z jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block BinNums.Z0)
               (@nil (prod Values.block BinNums.Z))))
         (jet_secp_modinv_entry_modulus.inv_mod_start_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) m
