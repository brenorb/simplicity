### C.jet_secp_scalar_inverse_seed.scalar_inv_seed_zero
scalar_inv_seed_zero
     : forall later : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.modulo
            (jet_secp_modinv_de_numeric.de62_input_value (jet_secp_modinv_var_entry.inv_initial_de_rho later) false)
            jet_secp_canonical_scalar.canonical_group_order) BinNums.Z0
### C.jet_secp_scalar_inverse_seed.scalar_inv_seed_values
scalar_inv_seed_values
     : forall (w : forall _ : nat, Integers.Int64.int) (_ : jet_secp_signed62_numeric.signed62_normalized w),
       and
         (@eq BinNums.Z
            (jet_secp_modinv_normalize62_words.norm62_value_z (S (S (S (S O))))
               (fun i : nat => Integers.Int64.signed (jet_secp_scalar_normalize62.modinfo_scalar_limb i)))
            (divstep.f (scalar_inv_seed_state w)))
         (and
            (@eq BinNums.Z
               (jet_secp_modinv_normalize62_words.norm62_value_z (S (S (S (S O))))
                  (fun i : nat => Integers.Int64.signed (w i))) (divstep.g (scalar_inv_seed_state w)))
            (and (@eq BinNums.Z (divstep.delta (scalar_inv_seed_state w)) (BinNums.Zpos BinNums.xH))
               (and (@eq BinNums.Z (divstep.eta (scalar_inv_seed_state w)) (BinNums.Zneg BinNums.xH))
                  (and
                     (BinInt.Z.le (BinInt.Z.abs (divstep.f (scalar_inv_seed_state w)))
                        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (BinInt.Z.le (BinInt.Z.abs (divstep.g (scalar_inv_seed_state w)))
                        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))
### C.jet_secp_scalar_inverse_seed.scalar_inv_ready_loads
scalar_inv_ready_loads
     : forall (w : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep w beta
                (jet_secp_modinv_copies_modulus.inv_mod_fg_regs jet_secp_scalar_normalize62.modinfo_scalar_limb) m),
       and
         (forall (high : bool) (i : nat) (_ : lt i (S (S (S (S (S O)))))),
          @eq (option Values.val)
            (Memory.Mem.load AST.Mint64 m
               (jet_sx_state.blk beta match high return nat with
                                      | true => S (S (S O))
                                      | false => S (S O)
                                      end)
               (BinInt.Z.add
                  (jet_sx_state.bas beta match high return nat with
                                         | true => S (S (S O))
                                         | false => S (S O)
                                         end)
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))
            (@Some Values.val (Values.Vlong (jet_secp_modinv_var_entry.inv_init_word high i))))
         (forall (high : bool) (i : nat) (_ : lt i (S (S (S (S (S O)))))),
          @eq (option Values.val)
            (Memory.Mem.load AST.Mint64 m
               (jet_sx_state.blk beta
                  match high return nat with
                  | true => S (S (S (S (S O))))
                  | false => S (S (S (S O)))
                  end)
               (BinInt.Z.add
                  (jet_sx_state.bas beta
                     match high return nat with
                     | true => S (S (S (S (S O))))
                     | false => S (S (S (S O)))
                     end)
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))
            (@Some Values.val
               (Values.Vlong
                  match high return Integers.Int64.int with
                  | true => w i
                  | false => jet_secp_scalar_normalize62.modinfo_scalar_limb i
                  end)))
### C.jet_secp_scalar_inverse_seed.scalar_inv_entry_establishes_seed
scalar_inv_entry_establishes_seed
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bd bx : Values.block)
         (_ : jet_secp_modinfo_scalar_global.modinfo_scalar_state m)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bx BinNums.Z0
                (jet_secp_scalar_add_initial.scalar_add_values w O))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bd BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Values.block
         (fun bs : Values.block =>
          @ex Memory.Mem.mem
            (fun mi : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mp : Memory.Mem.mem =>
                @ex (list (prod Values.block BinNums.Z))
                  (fun betaN : list (prod Values.block BinNums.Z) =>
                   @ex Clight.env
                     (fun e : Clight.env =>
                      @ex Clight.temp_env
                        (fun le : Clight.temp_env =>
                         @ex Memory.Mem.mem
                           (fun mc : Memory.Mem.mem =>
                            @ex Clight.temp_env
                              (fun lef : Clight.temp_env =>
                               @ex Memory.Mem.mem
                                 (fun mf : Memory.Mem.mem =>
                                  and
                                    (Clight.function_entry2 jet_secp_linkage.secp_ge
                                       jets_secp.f_secp256k1_scalar_inverse_var
                                       (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                                          (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero) (@nil Values.val))) m
                                       (jet_secp_scalar_inverse_caller.scalar_inv_env bs)
                                       (jet_secp_scalar_inverse_caller.scalar_inv_temps bd bx) mi)
                                    (and
                                       (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge
                                          (jet_secp_scalar_inverse_caller.scalar_inv_env bs)
                                          (jet_secp_scalar_inverse_caller.scalar_inv_temps bd bx) mi
                                          jet_secp_scalar_inverse_caller.scalar_inv_pack Events.E0
                                          (jet_secp_scalar_inverse_caller.scalar_inv_temps bd bx) mp
                                          ClightBigstep.Out_normal)
                                       (and
                                          (Clight.function_entry2 jet_secp_linkage.secp_ge
                                             jets_secp.f_secp256k1_modinv64_var
                                             (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                                                (@cons Values.val
                                                   (Values.Vptr jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block
                                                      Integers.Ptrofs.zero) (@nil Values.val))) mp e le mc)
                                          (and
                                             (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le mc
                                                jet_secp_modinv_var_copies.inv_ready_prefix Events.E0 lef mf
                                                ClightBigstep.Out_normal)
                                             (and
                                                (jet_sx_state.rep (jet_secp_scalar_signed62.scalar62_words true w)
                                                   (@app (prod Values.block BinNums.Z)
                                                      (@cons (prod Values.block BinNums.Z)
                                                         (@pair Values.block BinNums.Z bs BinNums.Z0)
                                                         (@cons (prod Values.block BinNums.Z)
                                                            (@pair Values.block BinNums.Z
                                                               jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block
                                                               BinNums.Z0) (@nil ...))) betaN)
                                                   (jet_secp_modinv_copies_modulus.inv_mod_fg_regs
                                                      jet_secp_scalar_normalize62.modinfo_scalar_limb) mf)
                                                (and
                                                   (jet_sx_eval.ematch
                                                      (@app (prod Values.block BinNums.Z)
                                                         (@cons (prod Values.block BinNums.Z)
                                                            (@pair Values.block BinNums.Z bs BinNums.Z0)
                                                            (@cons ... ... ...)) betaN)
                                                      (@snd (list jet_sx_state.region) jet_sx_eval.venv
                                                         jet_secp_modinv_var_entry.inv_start_alloc) e)
                                                   (and
                                                      (jet_sx_eval.tmatch
                                                         (jet_secp_scalar_signed62.scalar62_words true w)
                                                         (@app (prod Values.block BinNums.Z) (@cons ... ... ...) betaN)
                                                         jet_secp_modinv_var_copies.inv_loop_start_temps lef)
                                                      (and
                                                         (@eq (option Values.val)
                                                            (@Maps.PTree.get Values.val jets_secp._len lef)
                                                            (@Some Values.val ...))
                                                         (and (@eq ... ... ...) (and ... ...))))))))))))))))))
### C.jet_secp_scalar_inverse_seed.scalar_inv_seed_state
scalar_inv_seed_state =
fun w : forall _ : nat, Integers.Int64.int =>
divstep.init jet_secp_canonical_scalar.canonical_group_order (jet_secp_signed62_numeric.signed62_unsigned_value w)
  jet_secp_scalar_inverse_result.scalar_inv_modulus_odd
     : forall _ : forall _ : nat, Integers.Int64.int, divstep.State

Arguments scalar_inv_seed_state w%function_scope
