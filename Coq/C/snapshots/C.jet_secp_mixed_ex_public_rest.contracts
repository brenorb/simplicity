               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_clear)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf Values.Vundef)
            (and
               (Memory.Mem.range_perm mf br BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b br)) m mf)))
