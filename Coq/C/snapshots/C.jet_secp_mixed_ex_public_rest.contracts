### C.jet_secp_mixed_ex_public_rest.mixed_ex_public_outside
mixed_ex_public_outside =
fun (m0 : Memory.Mem.mem) (bd bw bi bp ba bl br b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b bp))
  (and (not (@eq Values.block b ba))
     (and (not (@eq Values.block b bl)) (and (not (@eq Values.block b br)) (not (jet_secp_frame.extA m0 bd bw bi b)))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments mixed_ex_public_outside m0 bd bw bi bp ba bl br b _%Z_scope
### C.jet_secp_mixed_ex_public_rest.mixed_ex_equal_output
mixed_ex_equal_output =
fun x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
@app BitMachine.Cell
  (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (jet_secp_rescale_literal.rescale_field_output (jet_secp_square_spec_bridge.square_reader_rho y)))
  (@app BitMachine.Cell
     (@app BitMachine.Cell
        (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (jet_secp_rescale_literal.rescale_field_output
              (jet_secp_double_all_calls.double_output_x_words (jet_secp_square_spec_bridge.square_reader_rho x)
                 (jet_secp_square_spec_bridge.square_reader_rho y))))
        (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (jet_secp_rescale_literal.rescale_field_output
              (jet_secp_double_all_calls.double_output_y_words (jet_secp_square_spec_bridge.square_reader_rho x)
                 (jet_secp_square_spec_bridge.square_reader_rho y)))))
     (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (jet_secp_rescale_literal.rescale_field_output
           (jet_secp_double_all_calls.double_output_z_words (jet_secp_square_spec_bridge.square_reader_rho y)
              (jet_secp_square_spec_bridge.square_reader_rho z)))))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), list BitMachine.Cell

Arguments mixed_ex_equal_output x y z
