### C.jet_entropy_frame_entry.entropy_frame_header
entropy_frame_header
     : and
         (@eq (list (prod AST.ident Ctypes.type))
            (Clight.fn_vars jets_elements.f_simplicity_calculate_issuance_entropy) entropy_frame_vars)
         (and
            (@eq (list (prod AST.ident Ctypes.type))
               (Clight.fn_params jets_elements.f_simplicity_calculate_issuance_entropy) entropy_frame_params)
            (and
               (@eq (list (prod AST.ident Ctypes.type))
                  (Clight.fn_temps jets_elements.f_simplicity_calculate_issuance_entropy)
                  (@cons (prod AST.ident Ctypes.type)
                     (@pair AST.ident Ctypes.type jets_elements._t'1 Ctypesdefs.tulong)
                     (@nil (prod AST.ident Ctypes.type))))
               (and
                  (@eq Ctypes.type (Clight.fn_return jets_elements.f_simplicity_calculate_issuance_entropy)
                     Ctypesdefs.tbool)
                  (@eq AST.calling_convention
                     (Clight.fn_callconv jets_elements.f_simplicity_calculate_issuance_entropy) AST.cc_default))))
### C.jet_entropy_frame_entry.entropy_frame_size
entropy_frame_size
     : @eq BinNums.Z
         (Ctypes.sizeof (Clight.genv_cenv jet_elements_linkage.elements_ge)
            (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
### C.jet_entropy_frame_entry.entropy_midstate_size
entropy_midstate_size
     : @eq BinNums.Z
         (Ctypes.sizeof (Clight.genv_cenv jet_elements_linkage.elements_ge)
            (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
### C.jet_entropy_frame_entry.entropy_outpoint_size
entropy_outpoint_size
     : @eq BinNums.Z
         (Ctypes.sizeof (Clight.genv_cenv jet_elements_linkage.elements_ge)
            (Ctypes.Tstruct jets_elements._outpoint Ctypes.noattr))
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
### C.jet_entropy_frame_entry.entropy_frame_entry
entropy_frame_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 m5 : Memory.Mem.mem')
         (bl bo bc br bt bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bo))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 bc))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m4 br))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m4 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m5 bt)),
       Clight.function_entry2 jet_elements_linkage.elements_ge jets_elements.f_simplicity_calculate_issuance_entropy
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (entropy_frame_env bl bo bc br bt) (entropy_frame_temps env bd dbase bs sbase) m5
### C.jet_entropy_frame_entry.entropy_env_blocks
entropy_env_blocks
     : forall bl bo bc br bt : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_linkage.elements_ge (entropy_frame_env bl bo bc br bt))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bo BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bc BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bt BinNums.Z0)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                        (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z br BinNums.Z0)
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))
### C.jet_entropy_frame_entry.entropy_frame_vars
entropy_frame_vars =
@cons (prod AST.ident Ctypes.type)
  (@pair AST.ident Ctypes.type jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
  (@cons (prod AST.ident Ctypes.type)
     (@pair AST.ident Ctypes.type jets_elements._op (Ctypes.Tstruct jets_elements._outpoint Ctypes.noattr))
     (@cons (prod AST.ident Ctypes.type)
        (@pair AST.ident Ctypes.type jets_elements._contract
           (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
        (@cons (prod AST.ident Ctypes.type)
           (@pair AST.ident Ctypes.type jets_elements._result
              (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
           (@cons (prod AST.ident Ctypes.type)
              (@pair AST.ident Ctypes.type jets_elements.__res
                 (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) (@nil (prod AST.ident Ctypes.type))))))
     : list (prod AST.ident Ctypes.type)
### C.jet_entropy_frame_entry.entropy_frame_params
entropy_frame_params =
@cons (prod AST.ident Ctypes.type)
  (@pair AST.ident Ctypes.type jets_elements._dst
     (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
  (@cons (prod AST.ident Ctypes.type)
     (@pair AST.ident Ctypes.type jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
     (@cons (prod AST.ident Ctypes.type)
        (@pair AST.ident Ctypes.type jets_elements._env
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._txEnv Ctypes.noattr))) (@nil (prod AST.ident Ctypes.type))))
     : list (prod AST.ident Ctypes.type)
### C.jet_entropy_frame_entry.entropy_frame_env
entropy_frame_env =
fun bl bo bc br bt : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements.__res
  (@pair Values.block Ctypes.type bt (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._result
     (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._contract
        (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._op
           (@pair Values.block Ctypes.type bo (Ctypes.Tstruct jets_elements._outpoint Ctypes.noattr))
           (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._src
              (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              Clight.empty_env))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block),
       Clight.env

Arguments entropy_frame_env bl bo bc br bt
### C.jet_entropy_frame_entry.entropy_frame_temps
entropy_frame_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_elements._env env
  (@Maps.PTree.set Values.val jets_elements._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_elements._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (@Maps.PTree.set Values.val jets_elements._t'1 Values.Vundef (Maps.PTree.empty Values.val))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments entropy_frame_temps env bd dbase%Z_scope bs sbase%Z_scope
