### C.jet_increment64_wide_word.increment64_values_denote_input
increment64_values_denote_input
     : forall (r : Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) x)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W64))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W64)))
            match increment64_carry r return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end (jet_wide_spec.decode_wide jet_wide.W64 (increment64_payload r))) (increment64_spec_value x)
### C.jet_increment64_wide_word.increment64_spec
increment64_spec =
fun term : Alg.Core.Algebra => @jet_increment_spec.increment_word_spec term (S (S (S (S (S (S O))))))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S (S (S (S O)))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))

Arguments increment64_spec {term}
### C.jet_increment64_wide_word.increment64_spec_value
increment64_spec_value =
@increment64_spec Alg.CoreFunSem
     : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))),
       Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))
### C.jet_increment64_wide_word.increment64_carry
increment64_carry =
fun r : Integers.Int64.int =>
Integers.Int64.ltu (Integers.Int64.repr (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))) r
     : forall _ : Integers.Int64.int, bool

Arguments increment64_carry r
### C.jet_increment64_wide_word.increment64_payload
increment64_payload =
fun r : Integers.Int64.int => Integers.Int64.add r Integers.Int64.one
     : forall _ : Integers.Int64.int, Integers.Int64.int

Arguments increment64_payload r
