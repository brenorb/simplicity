### C.jet_elements_single_issuance_blinding.eis_blinding_bytes
eis_blinding_bytes =
fun (isnew : bool) (q ent : Digest.hash256) =>
match isnew return (list Integers.Int.int) with
| true =>
    @app Integers.Int.int
      (@List.repeat Integers.Int.int Integers.Int.zero
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
      (jet_elements_support_sha_be32_write.be_bytes (Digest.hash256_reg q))
| false =>
    @app Integers.Int.int (jet_elements_support_sha_be32_write.be_bytes (Digest.hash256_reg q))
      (jet_elements_support_sha_be32_write.be_bytes (Digest.hash256_reg ent))
end
     : forall (_ : bool) (_ : Digest.hash256) (_ : Digest.hash256), list Integers.Int.int

Arguments eis_blinding_bytes isnew%bool_scope q ent
### C.jet_elements_single_issuance_blinding.eis_blinding_pair
eis_blinding_pair =
fun (isnew : bool) (q ent : Digest.hash256) =>
match
  isnew
  return
    (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| true =>
    @pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))))
      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) BinNums.Z0)
      (Word.from_hash256 q)
| false =>
    @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 q) (Word.from_hash256 ent)
end
     : forall (_ : bool) (_ : Digest.hash256) (_ : Digest.hash256),
       Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments eis_blinding_pair isnew%bool_scope q ent
