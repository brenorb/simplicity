### C.jet_secp_generator_main.exec_generator_main_stage
exec_generator_main_stage
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (bp bng bt bz b0 b128 bw0 bw128 bj bn bl : Values.block),
       let e : Maps.PTree.tree (prod Values.block Ctypes.type) :=
         jet_secp_generator_entry.generator_local_env bt bz b0 b128 bw0 bw128 bj bn bl in
       forall
         (_ : @List.NoDup Values.block
                (@cons Values.block bp
                   (@cons Values.block bt
                      (@cons Values.block bz
                         (@cons Values.block b0
                            (@cons Values.block b128
                               (@cons Values.block bw0
                                  (@cons Values.block bw128
                                     (@cons Values.block bj
                                        (@cons Values.block bn
                                           (@cons Values.block bl (@cons Values.block bng (@nil Values.block)))))))))))))
         (_ : forall h : bool, jet_secp_generator_globals.generator_table_state h m)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._ng le)
                (@Some Values.val (Values.Vptr bng Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._no le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._bits le)
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bng BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem value)))))
         (_ : jet_secp_fe_nv.fe_at m bz BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_set_bit.point_set_bit_words true)))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bng BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (jet_secp_generator_entry.generator_local_storage bt bz b0 b128 bw0 bw128 bj bn bl)),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
         (_ : forall (high : bool) (ma : Memory.Mem.mem) (mi : Memory.Mem.mem') (bs : Values.block)
                (_ : @eq (prod Memory.Mem.mem' Values.block)
                       (Memory.Mem.alloc ma BinNums.Z0
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                       (@pair Memory.Mem.mem' Values.block mi bs))
                (_ : Memory.Mem.range_perm ma match high return Values.block with
                                              | true => bw128
                                              | false => bw0
                                              end BinNums.Z0
                       (BinNums.Zpos
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                       Memtype.Cur Memtype.Freeable),
              @ex Memory.Mem.mem
                (fun mz : Memory.Mem.mem =>
                 let b : Values.block := match high return Values.block with
                                         | true => bw128
                                         | false => bw0
                                         end in
                 let ba : Values.block := match high return Values.block with
                                          | true => b128
                                          | false => b0
                                          end in
                 and
                   (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_wnaf_digit.wnaf_env bs)
                      (jet_secp_wnaf_entry15.wnaf_before_temps
                         (jet_secp_wnaf_entry15.wnaf_entry15_temps b BinNums.Z0 (Values.Vptr ba Integers.Ptrofs.zero)))
                      mi jet_secp_wnaf_entry15.wnaf_memset_call Events.E0
                      (jet_secp_wnaf_entry15.wnaf_before_temps
                         (jet_secp_wnaf_entry15.wnaf_entry15_temps b BinNums.Z0 (Values.Vptr ba Integers.Ptrofs.zero)))
                      mz ClightBigstep.Out_normal)
                   (and
                      (forall (i : BinNums.Z)
                         (_ : and (BinInt.Z.le BinNums.Z0 i)
                                (BinInt.Z.lt i
                                   (BinNums.Zpos
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
                       @eq (option Values.val)
                         (Memory.Mem.load AST.Mint32 mz b
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
                         (@Some Values.val (Values.Vint Integers.Int.zero)))
                      (jet_secp_wnaf_loop.wnaf_memory_effect b mi mz)))),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun ox : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun oy : forall _ : nat, Integers.Int64.int =>
                   @ex (forall _ : nat, Integers.Int64.int)
                     (fun oz : forall _ : nat, Integers.Int64.int =>
                      and
                        (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m generator_main_stage Events.E0
                           lef mf ClightBigstep.Out_normal)
                        (and
                           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r lef)
                              (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
                           (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 ox))
                              (and
                                 (jet_secp_fe_nv.fe_at mf bp
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    (jet_secp_multiply_normalize_bridge.words5 oy))
                                 (and
                                    (jet_secp_fe_nv.fe_at mf bp
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                       (jet_secp_multiply_normalize_bridge.words5 oz))
                                    (and
                                       (@eq (option Values.val)
                                          (Memory.Mem.load AST.Mint32 mf bp
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                          (@Some Values.val
                                             (Values.Vint
                                                (jet_readBit_layout.bit_int
                                                   (Bit.toBool
                                                      (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem
                                                         (jet_secp_rescale_literal.rescale_field_output oz)))))))
                                       (and
                                          (Memory.Mem.range_perm mf bp BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (Memory.Mem.range_perm mf bng BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                Memtype.Cur Memtype.Freeable)
                                             (and
                                                (forall (b : Values.block) (hi : BinNums.Z)
                                                   (_ : @List.In (prod Values.block BinNums.Z)
                                                          (@pair Values.block BinNums.Z b hi)
                                                          (jet_secp_generator_entry.generator_local_storage bt bz b0
                                                             b128 bw0 bw128 bj bn bl)),
                                                 Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                                                (and (jet_secp_square_columns.square_input_bounds ox)
                                                   (and (jet_secp_square_columns.square_input_bounds oy)
                                                      (and (jet_secp_square_columns.square_input_bounds oz)
                                                         (and
                                                            (@eq (prod ... ...) (@pair ... ... ... ...)
                                                               (@jet_secp_generate_program.literal_generate
                                                                  Alg.CoreFunSem value))
                                                            (jet_sx_mem.lframe (... => ...) m mf))))))))))))))))))
