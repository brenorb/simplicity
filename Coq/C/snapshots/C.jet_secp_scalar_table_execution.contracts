                                                (jet_secp_fe_nv.fe_at mf bp
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...))))))
                                                   (jet_secp_multiply_normalize_bridge.words5 z))
                                                (and
                                                   (@eq (option Values.val)
                                                      (Memory.Mem.load AST.Mint32 mf bp
                                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...)))))
                                                      (@Some Values.val (Values.Vint Integers.Int.zero)))
                                                   (and
                                                      (Memory.Mem.range_perm mf br BinNums.Z0
                                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))
                                                         Memtype.Cur Memtype.Freeable)
                                                      (and
                                                         (Memory.Mem.range_perm mf bp BinNums.Z0
                                                            (BinNums.Zpos (BinNums.xO (BinNums.xO ...))) Memtype.Cur
                                                            Memtype.Freeable)
                                                         (and
                                                            (Memory.Mem.range_perm mf bz BinNums.Z0
                                                               (BinNums.Zpos (BinNums.xO ...)) Memtype.Cur
                                                               Memtype.Freeable)
                                                            (and
                                                               (Memory.Mem.range_perm mf bo BinNums.Z0
                                                                  (BinNums.Zpos ...) Memtype.Cur Memtype.Freeable)
                                                               (and
                                                                  (jet_clight_internal_permissions.keeps_permissions m
                                                                     mf) (and ... ...))))))))))))))))))))
