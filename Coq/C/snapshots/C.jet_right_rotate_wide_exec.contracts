### C.jet_right_rotate_wide_exec.exec_right_rotate_scalar_call
exec_right_rotate_scalar_call
     : forall (s : jet_wide.wide_size) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (r : Integers.Int64.int) (a : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a) (jet_wide.wide_bits s)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._input le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._amt le) (@Some Values.val (Values.Vint a))),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (right_rotate_scalar_call s) Events.E0
         (@Maps.PTree.set Values.val jets._t'3
            (Values.Vlong
               (jet_rotate_wide_helper.wide_rotate_result s r (jet_rotate_count_exec.wide_rotate_reverse_amount s a)))
            le) m ClightBigstep.Out_normal
### C.jet_right_rotate_wide_exec.right_rotate_byte_body
right_rotate_byte_body
     : forall s : jet_left_rotate_wide_exec.byte_rotate_size,
       @eq Clight.statement (Clight.fn_body (right_rotate_byte_function s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (jet_binary8_exec.binary8_read jets._t'1)
                  (Clight.Sset jets._amt
                     (jet_rotate_count_exec.wide_rotate_amount_expr (jet_left_rotate_wide_exec.byte_rotate_width s)
                        (Clight.Etempvar jets._t'1 Ctypesdefs.tuchar))))
               (Clight.Ssequence
                  (Clight.Ssequence
                     (jet_binary_wide_exec.wide_binary_read (jet_left_rotate_wide_exec.byte_rotate_width s) jets._t'2)
                     (Clight.Sset jets._input (Clight.Etempvar jets._t'2 Ctypesdefs.tulong)))
                  (Clight.Ssequence
                     (Clight.Ssequence (right_rotate_scalar_call (jet_left_rotate_wide_exec.byte_rotate_width s))
                        (jet_arith8_layout_exec.frame_writer_call
                           (jet_wide.wide_writer_id (jet_left_rotate_wide_exec.byte_rotate_width s)) Ctypesdefs.tulong
                           Ctypesdefs.tvoid (Clight.Etempvar jets._t'3 Ctypesdefs.tulong)))
                     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))))
### C.jet_right_rotate_wide_exec.eval_right_rotate_byte_composes
eval_right_rotate_byte_composes
     : forall (env : Values.val) (s : jet_left_rotate_wide_exec.byte_rotate_size) (m : Memory.Mem.mem)
         (ma : Memory.Mem.mem') (mc mr mr2 me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval) (a : Integers.Int.int)
         (r : Integers.Int64.int) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_read8)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function
                   (jet_wide.wide_reader (jet_left_rotate_wide_exec.byte_rotate_width s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function
                   (jet_wide.wide_writer (jet_left_rotate_wide_exec.byte_rotate_width s)))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (right_rotate_byte_payload s r a)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function (right_rotate_byte_function s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_right_rotate_wide_exec.right_rotate_byte_function
right_rotate_byte_function =
fun s : jet_left_rotate_wide_exec.byte_rotate_size =>
match s return Clight.function with
| jet_left_rotate_wide_exec.R32 => jets.f_simplicity_right_rotate_32
| jet_left_rotate_wide_exec.R64 => jets.f_simplicity_right_rotate_64
end
     : forall _ : jet_left_rotate_wide_exec.byte_rotate_size, Clight.function

Arguments right_rotate_byte_function s
### C.jet_right_rotate_wide_exec.right_rotate_byte_payload
right_rotate_byte_payload =
fun (s : jet_left_rotate_wide_exec.byte_rotate_size) (r : Integers.Int64.int) (a : Integers.Int.int) =>
jet_rotate_wide_helper.wide_rotate_result (jet_left_rotate_wide_exec.byte_rotate_width s) r
  (jet_rotate_count_exec.wide_rotate_reverse_amount (jet_left_rotate_wide_exec.byte_rotate_width s)
     (jet_rotate_count_exec.wide_rotate_amount (jet_left_rotate_wide_exec.byte_rotate_width s) a))
     : forall (_ : jet_left_rotate_wide_exec.byte_rotate_size) (_ : Integers.Int64.int) (_ : Integers.Int.int),
       Integers.Int64.int

Arguments right_rotate_byte_payload s r a
### C.jet_right_rotate_wide_exec.right_rotate_scalar_call
right_rotate_scalar_call =
fun s : jet_wide.wide_size =>
Clight.Scall (@Some AST.ident jets._t'3)
  (Clight.Evar (jet_left_rotate_wide_exec.wide_rotate_helper_id s)
     (Ctypes.Tfunction (Ctypes.Tcons Ctypesdefs.tulong (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tulong
        AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._input Ctypesdefs.tulong)
     (@cons Clight.expr (jet_rotate_count_exec.wide_rotate_reverse_amount_expr s) (@nil Clight.expr)))
     : forall _ : jet_wide.wide_size, Clight.statement

Arguments right_rotate_scalar_call s
