### C.jet_secp_split_rounding_calls.split_coefficient_call_source
split_coefficient_call_source
     : forall first : bool,
       @eq Clight.statement (split_coefficient_statement first)
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_scalar_mul_shift_var
            jets_secp.f_secp256k1_scalar_mul_shift_var (@None AST.ident)
            (@cons Clight.expr
               (Clight.Eaddrof (Clight.Evar (split_local_id first) (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
               (@cons Clight.expr
                  (Clight.Etempvar jets_secp._k (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
                  (@cons Clight.expr
                     (Clight.Eaddrof
                        (Clight.Evar (jet_secp_split_multipliers.split_multiplier_id first)
                           (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
                        (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
                     (@cons Clight.expr
                        (Clight.Econst_int
                           (Integers.Int.repr
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
                           Ctypesdefs.tint) (@nil Clight.expr))))))
### C.jet_secp_split_rounding_calls.exec_split_coefficient_call
exec_split_coefficient_call
     : forall (first : bool) (bc1 bc2 : Values.block) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bk : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._k le)
                (@Some Values.val (Values.Vptr bk Integers.Ptrofs.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_shift_var)
                (@cons Values.val
                   (Values.Vptr match first return Values.block with
                                | true => bc1
                                | false => bc2
                                end Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero)
                      (@cons Values.val
                         (Values.Vptr (jet_secp_split_multipliers.split_multiplier_block first) Integers.Ptrofs.zero)
                         (@cons Values.val
                            (Values.Vint
                               (Integers.Int.repr
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                            (@nil Values.val))))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (split_local_env bc1 bc2) le m
         (split_coefficient_statement first) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_split_rounding_calls.exec_split_initial_noops
exec_split_initial_noops
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
         (jet_secp_statement_prefix.statement_sequence
            (@List.firstn Clight.statement (S (S (S O))) (@fst (list Clight.statement) Clight.statement split_parts))
            Clight.Sskip) Events.E0 le m ClightBigstep.Out_normal
### C.jet_secp_split_rounding_calls.exec_split_rounding_prefix
exec_split_rounding_prefix
     : forall (k : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bk bc1 bc2 : Values.block) (_ : jet_secp_split_multipliers.split_multipliers_ready m)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._k le)
                (@Some Values.val (Values.Vptr bk Integers.Ptrofs.zero)))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))))
         (_ : Memory.Mem.range_perm m bk BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bc1 bc2)) (_ : not (@eq Values.block bc1 bk))
         (_ : not (@eq Values.block bc2 bk)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (split_local_env bc1 bc2) le m
               split_rounding_prefix Events.E0 le mf ClightBigstep.Out_normal)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf bc1 BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                           (@jet_secp_split_round_literal.literal_split_coefficient true Alg.CoreFunSem k)))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf bc2 BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                              (@jet_secp_split_round_literal.literal_split_coefficient false Alg.CoreFunSem k)))))
                  (and
                     (jet_secp_scalar_get_b32_storage.scalar_at mf bk BinNums.Z0
                        (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                           (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))))
                     (and
                        (Memory.Mem.range_perm mf bc1 BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bc2 BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bk BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_secp_split_multipliers.split_multipliers_ready mf)
                                 (and (jet_clight_internal_permissions.keeps_permissions m mf)
                                    (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                       (jet_sx_mem.lframe (split_rounding_frame bk bc1 bc2) m mf)))))))))))
### C.jet_secp_split_rounding_calls.split_local_id
split_local_id =
fun first : bool => match first return AST.ident with
                    | true => jets_secp._c1
                    | false => jets_secp._c2
                    end
     : forall _ : bool, AST.ident

Arguments split_local_id first%bool_scope
### C.jet_secp_split_rounding_calls.split_local_env
split_local_env =
fun bc1 bc2 : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._c2
  (@pair Values.block Ctypes.type bc2 (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._c1
     (@pair Values.block Ctypes.type bc1 (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)) Clight.empty_env)
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments split_local_env bc1 bc2
### C.jet_secp_split_rounding_calls.split_parts
split_parts =
jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_scalar_split_lambda)
     : prod (list Clight.statement) Clight.statement
### C.jet_secp_split_rounding_calls.split_coefficient_statement
split_coefficient_statement =
fun first : bool =>
@List.nth Clight.statement match first return nat with
                           | true => S (S (S O))
                           | false => S (S (S (S O)))
                           end (@fst (list Clight.statement) Clight.statement split_parts) Clight.Sskip
     : forall _ : bool, Clight.statement

Arguments split_coefficient_statement first%bool_scope
### C.jet_secp_split_rounding_calls.split_rounding_prefix
split_rounding_prefix =
jet_secp_statement_prefix.statement_sequence
  (@List.firstn Clight.statement (S (S (S (S (S O))))) (@fst (list Clight.statement) Clight.statement split_parts))
  Clight.Sskip
     : Clight.statement
### C.jet_secp_split_rounding_calls.split_rounding_frame
split_rounding_frame =
fun (bk bc1 bc2 b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b bc1))
  (and (not (@eq Values.block b bc2))
     (and (not (@eq Values.block b bk))
        (and (not (@eq Values.block b (jet_secp_split_multipliers.split_multiplier_block true)))
           (not (@eq Values.block b (jet_secp_split_multipliers.split_multiplier_block false))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments split_rounding_frame bk bc1 bc2 b _%Z_scope
