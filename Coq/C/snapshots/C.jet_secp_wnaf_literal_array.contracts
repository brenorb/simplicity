### C.jet_secp_wnaf_literal_array.wnaf_slice_app
wnaf_slice_app
     : forall (left right : nat) (digits : forall _ : BinNums.Z, BinNums.Z) (start : BinNums.Z),
       @eq (list BinNums.Z) (wnaf_slice (Nat.add left right) digits start)
         (@app BinNums.Z (wnaf_slice left digits start)
            (wnaf_slice right digits (BinInt.Z.add start (BinInt.Z.of_nat left))))
### C.jet_secp_wnaf_literal_array.wnaf_slice_ext
wnaf_slice_ext
     : forall (count : nat) (a b : forall _ : BinNums.Z, BinNums.Z) (start : BinNums.Z)
         (_ : forall (i : BinNums.Z)
                (_ : and (BinInt.Z.le start i) (BinInt.Z.lt i (BinInt.Z.add start (BinInt.Z.of_nat count)))),
              @eq BinNums.Z (a i) (b i)), @eq (list BinNums.Z) (wnaf_slice count a start) (wnaf_slice count b start)
### C.jet_secp_wnaf_literal_array.wnaf_slice_constant
wnaf_slice_constant
     : forall (count : nat) (digits : forall _ : BinNums.Z, BinNums.Z) (start value : BinNums.Z)
         (_ : forall (i : BinNums.Z)
                (_ : and (BinInt.Z.le start i) (BinInt.Z.lt i (BinInt.Z.add start (BinInt.Z.of_nat count)))),
              @eq BinNums.Z (digits i) value),
       @eq (list BinNums.Z) (wnaf_slice count digits start) (@List.repeat BinNums.Z value count)
### C.jet_secp_wnaf_literal_array.wnaf_slice_update
wnaf_slice_update
     : forall (count : nat) (digits : forall _ : BinNums.Z, BinNums.Z) (start value : BinNums.Z)
         (_ : forall (i : BinNums.Z)
                (_ : and (BinInt.Z.le start i) (BinInt.Z.lt i (BinInt.Z.add start (BinInt.Z.of_nat (S count))))),
              @eq BinNums.Z (digits i) BinNums.Z0),
       @eq (list BinNums.Z) (wnaf_slice (S count) (jet_secp_wnaf_loop.wnaf_update digits start value) start)
         (@cons BinNums.Z value (@List.repeat BinNums.Z BinNums.Z0 count))
### C.jet_secp_wnaf_literal_array.wnaf_slice_seq
wnaf_slice_seq
     : forall (count : nat) (digits : forall _ : BinNums.Z, BinNums.Z) (start : BinNums.Z),
       @eq (list BinNums.Z) (wnaf_slice count digits start)
         (@List.map nat BinNums.Z (fun i : nat => digits (BinInt.Z.add start (BinInt.Z.of_nat i))) (List.seq O count))
