### C.jet_secp_wnaf_literal_array.wnaf_literal_run_join
wnaf_literal_run_join
     : forall (left right : nat) (state next : Ty.tySem jet_secp_wnaf_literal.literal_wnaf_state)
         (segment : list (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit))
         (_ : @eq
                (prod (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_state)
                   (list (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)))
                (jet_secp_wnaf_literal.literal_wnaf_run left state)
                (@pair (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_state)
                   (list (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit)) next segment)),
       @eq (list BinNums.Z)
         (@List.map (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit) BinNums.Z wnaf_literal_value
            (@snd (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_state)
               (list (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit))
               (jet_secp_wnaf_literal.literal_wnaf_run (Nat.add left right) state)))
         (@app BinNums.Z
            (@List.map (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit) BinNums.Z wnaf_literal_value
               (@snd (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_state)
                  (list (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit))
                  (jet_secp_wnaf_literal.literal_wnaf_run right next)))
            (@List.map (Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit) BinNums.Z wnaf_literal_value segment))
### C.jet_secp_wnaf_literal_array.wnaf_literal_value
wnaf_literal_value =
fun digit : Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit =>
match digit return BinNums.Z with
| inl _ => BinNums.Z0
| inr word => jet_secp_wnaf_literal_mask.literal_wnaf_signed16 word
end
     : forall _ : Ty.tySem jet_secp_wnaf_literal.literal_wnaf_digit, BinNums.Z

Arguments wnaf_literal_value digit
### C.jet_secp_wnaf_literal_array.wnaf_slice
wnaf_slice =
fix wnaf_slice (count : nat) (digits : forall _ : BinNums.Z, BinNums.Z) (start : BinNums.Z) {struct count} :
    list BinNums.Z :=
  match count return (list BinNums.Z) with
  | O => @nil BinNums.Z
  | S count0 =>
      @cons BinNums.Z (digits start) (wnaf_slice count0 digits (BinInt.Z.add start (BinNums.Zpos BinNums.xH)))
  end
     : forall (_ : nat) (_ : forall _ : BinNums.Z, BinNums.Z) (_ : BinNums.Z), list BinNums.Z

Arguments wnaf_slice count%nat_scope digits%function_scope start%Z_scope
