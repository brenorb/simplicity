### C.jet_secp_mixed_infinite_literal.mixed_reader_output
mixed_reader_output
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_rescale_literal.rescale_field_output (jet_secp_square_spec_bridge.square_reader_rho x))
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
### C.jet_secp_mixed_infinite_literal.mixed_one_bounds
mixed_one_bounds
     : jet_secp_square_columns.square_input_bounds (jet_secp_point_set_bit.point_set_bit_words true)
### C.jet_secp_mixed_infinite_literal.mixed_one_output
mixed_one_output
     : @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_rescale_literal.rescale_field_output (jet_secp_point_set_bit.point_set_bit_words true))
         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem
            (@jet_secp_literal_add_program.literal_fe_one256 Alg.CoreFunSem tt))
### C.jet_secp_mixed_infinite_literal.mixed_infinite_body_literal
mixed_infinite_body_literal
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (ba bb : Values.block)
         (ax ay az bx byword : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr ba Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._b le)
                (@Some Values.val (Values.Vptr bb Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._rzr le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_set_ge e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block ba bb))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val
                   (Values.Vint
                      (jet_readBit_layout.bit_int
                         (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem az))))))
         (_ : @eq bool (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem az)) true)
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho bx)))
         (_ : jet_secp_fe_nv.fe_at m bb
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho byword)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bb
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun x : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun y : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun z : forall _ : nat, Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                        (Clight.fn_body jets_secp.f_secp256k1_gej_add_ge_var) Events.E0
                        (@Maps.PTree.set Values.val jets_secp._t'4 (Values.Vint Integers.Int.one) le) mf
                        (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type))))
                     (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                        (and
                           (jet_secp_fe_nv.fe_at mf ba
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 y))
                           (and
                              (jet_secp_fe_nv.fe_at mf ba
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (jet_secp_multiply_normalize_bridge.words5 z))
                              (and (jet_secp_square_columns.square_input_bounds x)
                                 (and (jet_secp_square_columns.square_input_bounds y)
                                    (and (jet_secp_square_columns.square_input_bounds z)
                                       (and
                                          (@eq
                                             (prod
                                                (prod (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...))))))))
                                                (Ty.tySem (Word.Word (S (S (S (S (S (...)))))))))
                                             (@pair
                                                (prod (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...))))))))
                                                (Ty.tySem (Word.Word (S (S (S (S (S (...))))))))
                                                (@pair (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (jet_secp_rescale_literal.rescale_field_output x)
                                                   (jet_secp_rescale_literal.rescale_field_output y))
                                                (jet_secp_rescale_literal.rescale_field_output z))
                                             (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
                                                (@pair
                                                   (prod
                                                      (prod (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...)))))))
                                                   (prod (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...)))))))
                                                   (@pair
                                                      (prod (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (@pair (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))) ax ay) az)
                                                   (@pair (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...)))))) bx byword))))
                                          (and
                                             (@eq (option Values.val)
                                                (Memory.Mem.load AST.Mint32 mf ba
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (...))))))))
                                                (@Some Values.val (Values.Vint Integers.Int.zero)))
                                             (and
                                                (Memory.Mem.range_perm mf ba BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (jet_sx_mem.lframe
                                                   (fun (b : Values.block) (_ : BinNums.Z) =>
                                                    not (@eq Values.block b ba)) m mf))))))))))))))
