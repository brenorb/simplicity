### C.jet_bit_word_layout.eval_bit_word_jet_layout
eval_bit_word_jet_layout
     : forall (env : Values.val) (f writer : Clight.function) (arg : forall _ : bool, Values.val)
         (B : Ty.Ty) (spec : forall _ : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit), Ty.tySem B) (m : Memory.Mem.mem)
         (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (x : Ty.tySem (Word.Word O)) (cursor rc : BinNums.Z)
         (_ : bit_word_writer_contract writer arg B spec) (_ : bit_word_jet_composer f writer arg)
         (_ : BinInt.Z.lt BinNums.Z0 (BinInt.Z.of_nat (Translate.bitSize B)))
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))))
         (_ : jet_input_layout.frame_input_bit_at m bi edge rc (Bit.toBool x))
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (Translate.bitSize B))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function f)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and (jet_encoding.frame_output_cells_at mf bw outedge cursor (@Translate.encode B (spec x)))
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and
                     (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B)))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
### C.jet_bit_word_layout.bit_word_jet_local_spec
bit_word_jet_local_spec
     : forall (f writer : Clight.function) (arg : forall _ : bool, Values.val) (B : Ty.Ty)
         (spec : forall _ : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit), Ty.tySem B)
         (_ : bit_word_writer_contract writer arg B spec) (_ : bit_word_jet_composer f writer arg)
         (_ : BinInt.Z.lt BinNums.Z0 (BinInt.Z.of_nat (Translate.bitSize B))),
       jet_bitmachine_rep.jet_local_spec f (Word.Word O) B spec
### C.jet_bit_word_layout.bit_word_writer_contract
bit_word_writer_contract =
fun (writer : Clight.function) (arg : forall _ : bool, Values.val) (B : Ty.Ty)
  (spec : forall _ : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit), Ty.tySem B) =>
forall (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z)
  (x : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
  (_ : jet_output_layout.write_frame_at m bd dbase bw edge cursor (BinInt.Z.of_nat (Translate.bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function writer)
        (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
           (@cons Values.val (arg (Bit.toBool x)) (@nil Values.val))) Events.E0 mf Values.Vundef)
     (and (jet_encoding.frame_output_cells_at mf bw edge cursor (@Translate.encode B (spec x)))
        (and (jet_output_layout.write_prefix_at m mf bw edge cursor)
           (and
              (jet_frame_layout.frame_fields_at mf bd dbase bw edge
                 (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B))))
              (and
                 (jet_output_layout.loads_outside_ranges m mf bd
                    (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                    (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                    bw
                    (BinInt.Z.add edge
                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                          (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B)))
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                    (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                 (and
                    (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                       (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mf b ofs kind p)
                    (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
     : forall (_ : Clight.function) (_ : forall _ : bool, Values.val) (B : Ty.Ty)
         (_ : forall _ : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit), Ty.tySem B), Prop

Arguments bit_word_writer_contract writer arg%function_scope B spec%function_scope
### C.jet_bit_word_layout.bit_word_jet_composer
bit_word_jet_composer =
fun (f writer : Clight.function) (arg : forall _ : bool, Values.val) =>
forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc mr me mf : Memory.Mem.mem)
  (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
  (bit : bool) (_ : jet_frame_layout.frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : not (@eq Values.block bl bs))
  (_ : @eq (prod Memory.Mem.mem' Values.block)
         (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (@pair Memory.Mem.mem' Values.block ma bl))
  (_ : @eq (option (list Memdata.memval))
         (Memory.Mem.loadbytes ma bs sbase
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (@Some (list Memdata.memval) bytes))
  (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
  (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc (@Ctypes.Internal Clight.function jets.f_readBit)
         (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
         (Values.Vint (jet_readBit_layout.bit_int bit)))
  (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr (@Ctypes.Internal Clight.function writer)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase)) (@cons Values.val (arg bit) (@nil Values.val)))
         Events.E0 me Values.Vundef)
  (_ : @eq (option Memory.Mem.mem)
         (Memory.Mem.free me bl BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (@Some Memory.Mem.mem mf)),
ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function f)
  (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
     (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
  Events.E0 mf (Values.Vint Integers.Int.one)
     : forall (_ : Clight.function) (_ : Clight.function) (_ : forall _ : bool, Values.val), Prop

Arguments bit_word_jet_composer f writer arg%function_scope
