### C.jet_secp_owned_read_initial.owned_read_initial_rep_from_storage
owned_read_initial_rep_from_storage
     : forall (size : BinNums.Z) (k : jet_secp_point_write_run.point_coordinate) (bits : list bool)
         (rc : BinNums.Z) (m : Memory.Mem.mem) (ba bl bi : Values.block) (edge : BinNums.Z)
         (_ : BinInt.Z.le
                (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0 size Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : not (@eq Values.block ba bl)),
       jet_sx_state.rep (jet_secp_wrapper_run.read_fe_rho bits rc)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
               (@nil (prod Values.block BinNums.Z))))
         (jet_secp_owned_read_run.owned_read_initial_regs size k bi (Integers.Ptrofs.repr edge)) m
