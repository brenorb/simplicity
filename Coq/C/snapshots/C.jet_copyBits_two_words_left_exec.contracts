  (jet_copyBits_partial_crossing.copy_partial_cross_env le bi src_ofs ss ds n old source next) bw dst_ofs
  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  (BinInt.Z.sub ds ss) (BinInt.Z.sub n ss)
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

