### C.jet_secp_fe_invert_writer.literal_fe_invert_normalized_input
literal_fe_invert_normalized_input
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem
            (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem value))
         (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem value)
### C.jet_secp_fe_invert_writer.literal_invert_numeric_reduced
literal_invert_numeric_reduced
     : forall (z : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 z)
                (BinInt.Z.lt z
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq BinNums.Z (BinInt.Z.modulo (jet_secp_invert_literal.literal_invert_numeric z) jet_secp_fe_math.feP)
         (jet_secp_invert_literal.literal_invert_numeric z)
### C.jet_secp_fe_invert_writer.fe_inverse_writer_from_reader
fe_inverse_writer_from_reader
     : forall (m : Memory.Mem.mem) (ba : Values.block) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem value)))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex (forall _ : nat, Integers.Int64.int)
         (fun result : forall _ : nat, Integers.Int64.int =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_inv_var)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                  Values.Vundef)
               (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 result))
                  (and (jet_secp_square_columns.square_input_bounds result)
                     (and
                        (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (jet_secp_write_fe_wide_exec.wide_fe_output (result O) (result (S O))
                              (result (S (S O))) (result (S (S (S O)))) (result (S (S (S (S O))))))
                           (@jet_secp_invert_literal.literal_fe_invert Alg.CoreFunSem value))
                        (and
                           (Memory.Mem.range_perm mf ba BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                              (and
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b ba)) m mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
