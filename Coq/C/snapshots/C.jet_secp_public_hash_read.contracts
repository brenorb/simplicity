### C.jet_secp_public_hash_read.secp_read32_preserved
secp_read32_preserved
     : forall (m : Memory.Mem.mem) (args : list Values.val) (t : Events.trace) (mf : Memory.Mem.mem)
         (result : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets.f_read32s) args t mf result),
       jet_clight_internal_preserve.readonly_preserved m mf
### C.jet_secp_public_hash_read.eval_secp_public_hash_read
eval_secp_public_hash_read
     : forall (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bo bf bi : Values.block) (edge cursor : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : not (@eq Values.block bo bf)) (_ : not (@eq Values.block bf bi))
         (_ : not (@eq Values.block bo bi))
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_frame_layout.frame_fields_at m bf BinNums.Z0 bi edge cursor)
         (_ : jet_encoding.frame_input_cells_at m bi edge cursor
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets.f_read32s)
               (@cons Values.val (Values.Vptr bo Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vlong
                        (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@cons Values.val (Values.Vptr bf Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and (jet_uint32_array_init.uint32_array_at mf bo BinNums.Z0 (jet_sha_ctx8_model.state_regs h))
               (and
                  (jet_frame_layout.frame_fields_at mf bf BinNums.Z0 bi edge
                     (BinInt.Z.add cursor
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bf)) (not (@eq Values.block b bo))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
