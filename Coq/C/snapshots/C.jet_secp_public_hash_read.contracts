### C.jet_secp_public_hash_read.exec_secp_local_hash_read
exec_secp_local_hash_read
     : forall (sid : BinNums.positive) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bo bf : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._read32s e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) sid e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bo jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bf Integers.Ptrofs.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets.f_read32s)
                (@cons Values.val (Values.Vptr bo Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (@cons Values.val (Values.Vptr bf Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (secp_local_hash_read sid) Events.E0 le mf
         ClightBigstep.Out_normal
