### C.jet_secp_signed62_storage.eval_fe_to_signed62_value
eval_fe_to_signed62_value
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : jet_secp_fe_math.fe_limbs_ok (Integers.Int64.unsigned (w O)) (Integers.Int64.unsigned (w (S O)))
                (Integers.Int64.unsigned (w (S (S O)))) (Integers.Int64.unsigned (w (S (S (S O)))))
                (Integers.Int64.unsigned (w (S (S (S (S O))))))) (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_to_signed62)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_signed62_repack.fe_repack_words true w)))
               (and (jet_secp_fe_nv.fe_at mf bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and
                     (Memory.Mem.range_perm mf bout BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bin BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_secp_signed62_numeric.signed62_normalized
                              (jet_secp_signed62_repack.fe_repack_words true w))
                           (and
                              (@eq BinNums.Z
                                 (jet_secp_signed62_numeric.signed62_unsigned_value
                                    (jet_secp_signed62_repack.fe_repack_words true w))
                                 (jet_secp_multiply_finish_product.radix_value w))
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block b bout)) (not (@eq Values.block b bin))) m mf))))))))
### C.jet_secp_signed62_storage.eval_fe_from_signed62_value
eval_fe_from_signed62_value
     : forall (w : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (bout bin : Values.block)
         (_ : jet_secp_signed62_numeric.signed62_normalized w) (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_from_signed62)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bout BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_signed62_repack.fe_repack_words false w)))
               (and (jet_secp_fe_nv.fe_at mf bin BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
                  (and
                     (Memory.Mem.range_perm mf bout BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bin BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (jet_secp_fe_math.fe_limbs_ok
                              (Integers.Int64.unsigned (jet_secp_signed62_repack.fe_repack_words false w O))
                              (Integers.Int64.unsigned (jet_secp_signed62_repack.fe_repack_words false w (S O)))
                              (Integers.Int64.unsigned (jet_secp_signed62_repack.fe_repack_words false w (S (S O))))
                              (Integers.Int64.unsigned (jet_secp_signed62_repack.fe_repack_words false w (S (S (S O)))))
                              (Integers.Int64.unsigned
                                 (jet_secp_signed62_repack.fe_repack_words false w (S (S (S (S O)))))))
                           (and
                              (@eq BinNums.Z
                                 (jet_secp_multiply_finish_product.radix_value
                                    (jet_secp_signed62_repack.fe_repack_words false w))
                                 (jet_secp_signed62_numeric.signed62_unsigned_value w))
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block b bout)) (not (@eq Values.block b bin))) m mf))))))))
