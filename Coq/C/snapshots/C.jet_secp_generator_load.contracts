### C.jet_secp_generator_load.generator_load_state
generator_load_state =
match generator_load_tree return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ =>
        jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_generator_load.generator_field_exprs
generator_field_exprs =
@List.map jet_sx_state.cell jet_sx_expr.sx
  (fun c : jet_sx_state.cell =>
   match jet_sx_state.cval c return jet_sx_expr.sx with
   | Some x => x
   | None => jet_sx_expr.XL Integers.Int64.zero
   end) (jet_secp_fe_nv.cells0 jet_secp_fe_b32.sb_leaf)
     : list jet_sx_expr.sx
### C.jet_secp_generator_load.generator_load_cells
generator_load_cells =
@app jet_sx_state.cell (jet_sx_rep.u64_cells BinNums.Z0 generator_field_exprs)
  (@app jet_sx_state.cell
     (jet_sx_rep.u64_cells (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
        (@List.map jet_sx_expr.sx jet_sx_expr.sx
           (jet_sx_rename.sx_rename
              (fun n : nat => Nat.add n (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))
           generator_field_exprs))
     (@cons jet_sx_state.cell
        (jet_sx_state.mkcell
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
           AST.Mint32 (@Some jet_sx_expr.sx (jet_sx_expr.XIc Integers.Int.zero))) (@nil jet_sx_state.cell)))
     : list jet_sx_state.cell
