### C.jet_secp_generator_load.generator_load_run_eq
generator_load_run_eq
     : @eq (option jet_sx_exec.res) generator_load_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone generator_load_state jet_sx_exec.ONormal))
### C.jet_secp_generator_load.generator_load_return
generator_load_return
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps generator_load_state))
         (@None jet_sx_expr.sx)
### C.jet_secp_generator_load.generator_load_shape
generator_load_shape
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs generator_load_state) generator_load_out_regs
### C.jet_secp_generator_load.generator_field_length
generator_field_length
     : @eq nat (@length jet_sx_expr.sx generator_field_exprs) (S (S (S (S (S O)))))
### C.jet_secp_generator_load.eval_generator_load_symbolic
eval_generator_load_symbolic
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta generator_load_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_generator_load)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (jet_sx_state.rep rho beta generator_load_out_regs mf)
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (jet_sx_state.foot beta
                        (@List.map jet_sx_state.region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                           jet_sx_state.rshape generator_load_regs) b pos)) m mf)))
### C.jet_secp_generator_load.generator_load_source
generator_load_source =
jet_sx_state.mkreg
  (jet_secp_fe_b32.byte_cells BinNums.Z0
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))) O) true
  (@Some BinNums.Z
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     : jet_sx_state.region
### C.jet_secp_generator_load.generator_load_regs
generator_load_regs =
@cons jet_sx_state.region jet_secp_affine_storage.affine_storage_undef
  (@cons jet_sx_state.region generator_load_source (@nil jet_sx_state.region))
     : list jet_sx_state.region
### C.jet_secp_generator_load.generator_load_args
generator_load_args =
@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
  (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx))
     : list jet_sx_expr.sx
### C.jet_secp_generator_load.generator_load_run
generator_load_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_generator_load generator_load_args generator_load_regs (@nil jet_sx_eval.event)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
     : option jet_sx_exec.res
