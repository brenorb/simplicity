### C.jet_secp_curve_group_certificate.secp_group_projective_power_correct
secp_group_projective_power_correct
     : forall (point : secp_group_projective) (k : BinNums.positive),
       @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (@SMain.pe2e (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.sub jet_secp_fe_math.feP)
            (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP)
            (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
            jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory
            (secp_group_projective_power point k))
         (jet_secp_curve_group_power.secp_group_power_pos
            (@SMain.pe2e (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
               (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
               (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
               (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
               jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory point) k)
### C.jet_secp_curve_group_certificate.secp_group_generator_projective_value
secp_group_generator_projective_value
     : @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (@SMain.pe2e (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.sub jet_secp_fe_math.feP)
            (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP)
            (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
            jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory
            secp_group_generator_projective) jet_secp_curve_group_power.secp_group_generator
### C.jet_secp_curve_group_certificate.secp_group_projective_zero_infinity
secp_group_projective_zero_infinity
     : forall (point : secp_group_projective)
         (_ : @eq BinNums.Z
                (GZnZ.val jet_secp_fe_math.feP
                   (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                      (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                      jet_secp_curve_group.secp_group_seven point)) BinNums.Z0),
       @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (@SMain.pe2e (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
            (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.sub jet_secp_fe_math.feP)
            (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP) (GZnZ.div jet_secp_fe_math.feP)
            (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
            jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory point)
         jet_secp_curve_group_sign.secp_group_infinity
### C.jet_secp_curve_group_certificate.secp_generator_order_z
secp_generator_order_z
     : @eq BinNums.Z
         (GZnZ.val jet_secp_fe_math.feP
            (@SMain.z (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
               (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
               (secp_group_projective_power secp_group_generator_projective
                  (BinInt.Z.to_pos jet_secp_canonical_scalar.canonical_group_order)))) BinNums.Z0
### C.jet_secp_curve_group_certificate.secp_generator_order_multiple
secp_generator_order_multiple
     : @eq jet_secp_curve_group_sign.secp_group_point
         (@EGroup.gpow jet_secp_curve_group_sign.secp_group_point
            (@SMain.add (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
               (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
               (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
               (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven
               jet_secp_curve_group.secp_group_zero_test jet_secp_curve_group.secp_group_theory)
            jet_secp_curve_group_power.secp_group_generator jet_secp_curve_group.secp_curve_group
            jet_secp_canonical_scalar.canonical_group_order) jet_secp_curve_group_sign.secp_group_infinity
