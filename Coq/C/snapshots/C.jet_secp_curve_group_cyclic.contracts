### C.jet_secp_curve_group_cyclic.secp_generator_powers_order
secp_generator_powers_order
     : @eq BinNums.Z
         (BinInt.Z.of_nat
            (@length
               (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                  (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                  jet_secp_curve_group.secp_group_seven) secp_generator_powers))
         jet_secp_canonical_scalar.canonical_group_order
### C.jet_secp_curve_group_cyclic.secp_generator_powers_nodup
secp_generator_powers_nodup
     : @List.NoDup
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         secp_generator_powers
### C.jet_secp_curve_group_cyclic.secp_generator_powers_incl
secp_generator_powers_incl
     : @List.incl
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         secp_generator_powers jet_secp_curve_group_odd.secp_group_points
### C.jet_secp_curve_group_cyclic.secp_generator_powers_complete
secp_generator_powers_complete
     : forall
         point : @SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP)
                   (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                   jet_secp_curve_group.secp_group_seven,
       @List.In
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         point secp_generator_powers
### C.jet_secp_curve_group_cyclic.secp_group_generator_spans
secp_group_generator_spans
     : forall point : jet_secp_curve_group_sign.secp_group_point,
       @ex BinNums.Z
         (fun k : BinNums.Z =>
          and (and (BinInt.Z.le BinNums.Z0 k) (BinInt.Z.lt k jet_secp_canonical_scalar.canonical_group_order))
            (@eq jet_secp_curve_group_sign.secp_group_point point
               (@EGroup.gpow jet_secp_curve_group_sign.secp_group_point
                  (@SMain.add (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                     (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                     (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
                     (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                     jet_secp_curve_group.secp_group_seven jet_secp_curve_group.secp_group_zero_test
                     jet_secp_curve_group.secp_group_theory) jet_secp_curve_group_power.secp_group_generator
                  jet_secp_curve_group.secp_curve_group k)))
