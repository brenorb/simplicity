### C.jet_rotate8_bits.rotate8_result_bits
rotate8_result_bits
     : forall (x : Ty.tySem (Word.Word (S (S (S O))))) (r a : Integers.Int.int) (j : BinNums.Z)
         (_ : @eq BinNums.Z (Integers.Int.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))),
       @eq bool (Integers.Int.testbit (jet_rotate8_helper.rotate8_result r a) j)
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x)
            (BinInt.Z.modulo (BinInt.Z.sub j (Integers.Int.unsigned a))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
