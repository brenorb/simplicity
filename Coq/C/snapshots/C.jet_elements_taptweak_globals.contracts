### C.jet_elements_taptweak_globals.elements_taptweak_sha_dispatch_info
elements_taptweak_sha_dispatch_info
     : @eq (option (AST.globvar Ctypes.type))
         (@Globalenvs.Genv.find_var_info (Ctypes.fundef Clight.function) Ctypes.type
            (@Globalenvs.Genv.globalenv (Ctypes.fundef Clight.function) Ctypes.type
               (@Ctypes.program_of_program Clight.function
                  jet_elements_taptweak_program.elements_taptweak_linked_program)) elements_taptweak_sha_dispatch_block)
         (@Some (AST.globvar Ctypes.type) jets_secp.v_simplicity_sha256_compression)
### C.jet_elements_taptweak_globals.elements_taptweak_sha_counter_info
elements_taptweak_sha_counter_info
     : @eq (option (AST.globvar Ctypes.type))
         (@Globalenvs.Genv.find_var_info (Ctypes.fundef Clight.function) Ctypes.type
            (@Globalenvs.Genv.globalenv (Ctypes.fundef Clight.function) Ctypes.type
               (@Ctypes.program_of_program Clight.function
                  jet_elements_taptweak_program.elements_taptweak_linked_program)) elements_taptweak_sha_counter_block)
         (@Some (AST.globvar Ctypes.type) jets_secp.v_sha256_max_counter)
### C.jet_elements_taptweak_globals.elements_taptweak_sha_compression_symbol
elements_taptweak_sha_compression_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol (Ctypes.fundef Clight.function) Ctypes.type
            (@Globalenvs.Genv.globalenv (Ctypes.fundef Clight.function) Ctypes.type
               (@Ctypes.program_of_program Clight.function
                  jet_elements_taptweak_program.elements_taptweak_linked_program))
            jets_secp._sha256_compression_portable) (@Some Values.block elements_taptweak_sha_compression_block)
### C.jet_elements_taptweak_globals.elements_taptweak_sha_startup_initial
elements_taptweak_sha_startup_initial
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function
                      jet_elements_taptweak_program.elements_taptweak_linked_program)) (@Some Memory.Mem.mem m)),
       elements_taptweak_sha_startup m
### C.jet_elements_taptweak_globals.elements_taptweak_sha_startup_exists
elements_taptweak_sha_startup_exists
     : @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                  (@Ctypes.program_of_program Clight.function
                     jet_elements_taptweak_program.elements_taptweak_linked_program)) (@Some Memory.Mem.mem m))
            (elements_taptweak_sha_startup m))
### C.jet_elements_taptweak_globals.elements_taptweak_sha_startup_separate
elements_taptweak_sha_startup_separate
     : forall (m : Memory.Mem.mem) (b : Values.block) (size : BinNums.Z)
         (_ : jet_sha_global_state.sha_global_state_at elements_taptweak_sha_dispatch_block
                elements_taptweak_sha_compression_block elements_taptweak_sha_counter_block m)
         (_ : BinInt.Z.lt BinNums.Z0 size) (_ : Memory.Mem.range_perm m b BinNums.Z0 size Memtype.Cur Memtype.Freeable),
       and (not (@eq Values.block b elements_taptweak_sha_dispatch_block))
         (not (@eq Values.block b elements_taptweak_sha_counter_block))
### C.jet_elements_taptweak_globals.elements_taptweak_sha_startup_preserved
elements_taptweak_sha_startup_preserved
     : forall (m mf : Memory.Mem.mem) (P : forall (_ : Values.block) (_ : BinNums.Z), Prop)
         (_ : jet_sha_global_state.sha_global_state_at elements_taptweak_sha_dispatch_block
                elements_taptweak_sha_compression_block elements_taptweak_sha_counter_block m)
         (_ : jet_clight_internal_preserve.readonly_preserved m mf) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall ofs : BinNums.Z, P elements_taptweak_sha_dispatch_block ofs),
       jet_sha_global_state.sha_global_state_at elements_taptweak_sha_dispatch_block
         elements_taptweak_sha_compression_block elements_taptweak_sha_counter_block mf
