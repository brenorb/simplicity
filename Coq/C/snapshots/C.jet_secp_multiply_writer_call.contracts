                        (@cons Values.val
                           (Values.Vptr (jet_sx_state.blk beta (S O))
                              (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O)))) (@nil Values.val)))) Events.E0 mm
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mm
                     (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                        (@cons Values.val (Values.Vptr (jet_sx_state.blk beta O) Integers.Ptrofs.zero)
                           (@nil Values.val))) Events.E0 mf Values.Vundef)
                  (and
