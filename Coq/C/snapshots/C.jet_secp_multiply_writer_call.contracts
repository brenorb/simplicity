### C.jet_secp_multiply_writer_call.eval_original_field_mul_then_write
eval_original_field_mul_then_write
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list BitMachine.Cell)
         (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw edge cursor N)
         (_ : jet_secp_multiply_first_arithmetic.field_input_bounds rho)
