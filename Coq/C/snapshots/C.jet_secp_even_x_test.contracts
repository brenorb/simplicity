### C.jet_secp_even_x_test.secp_affine_even_x_decompress
secp_affine_even_x_decompress
     : forall (x y r : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))) true)
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
                   jet_secp_fe_math.feP))
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)
                   jet_secp_fe_math.feP))
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r)
                   jet_secp_fe_math.feP)),
       iff
         (and (@eq bool (Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem y)) false)
            (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x r))
         (@eq
            (Ty.tySem
               (Ty.Sum Ty.Unit
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
            (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
               (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@inl unit unit tt) r))
            (@inr unit
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y)))
### C.jet_secp_even_x_test.secp_even_x_test_group
secp_even_x_test_group
     : forall (x y z r : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : jet_secp_jacobian_word_group.secp_jacobian_word_rep (GZnZ.one jet_secp_fe_math.feP)
                (@pair
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z) p)
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) r)
                   jet_secp_fe_math.feP)),
       iff
         (@eq bool
            (secp_even_x_test
               (@pair
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z) r) true)
         (@ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun rx : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
             @ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (fun ry : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
