### C.jet_secp_point_read_preservation.point_read_foot_bounds
point_read_foot_bounds
     : forall (k : jet_secp_point_write_run.point_coordinate) (b bl bi : Values.block) (edge : Integers.Ptrofs.int)
         (bx : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   (jet_secp_point_read_run.point_read_initial_regs k bi edge)) bx pos),
       or (@eq Values.block bx bl)
         (and (@eq Values.block bx b)
            (and (BinInt.Z.le (jet_secp_point_write_run.point_coordinate_offset k) pos)
               (BinInt.Z.lt pos
                  (BinInt.Z.add (jet_secp_point_write_run.point_coordinate_offset k)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_point_read_preservation.point_read_preserves_field
point_read_preserves_field
     : forall (m mf m0 : Memory.Mem.mem) (bd bw bi b bl : Values.block) (edge : BinNums.Z)
         (k j : jet_secp_point_write_run.point_coordinate) (xs : list Integers.Int64.int)
         (_ : not (@eq jet_secp_point_write_run.point_coordinate k j)) (_ : not (@eq Values.block b bl))
         (_ : le (@length Integers.Int64.int xs) (S (S (S (S (S O))))))
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset j) xs)
         (_ : Memory.Mem.range_perm mf b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : jet_sx_mem.lframe
                (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))
                   (jet_secp_point_read_run.point_read_initial_regs k bi (Integers.Ptrofs.repr edge)) m) m mf),
       jet_secp_fe_nv.fe_at mf b (jet_secp_point_write_run.point_coordinate_offset j) xs
