### C.jet_shift_wide_with_exec.exec_shift_wide_with_helper_call
exec_shift_wide_with_helper_call
     : forall (s : jet_wide.wide_size) (right fill : bool) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bl bd : Values.block) (dofs : Integers.Ptrofs.int) (a : Integers.Int.int)
         (r : Integers.Int64.int) (mr mr2 : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst le)
                (@Some Values.val (Values.Vptr bd dofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._with le)
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int fill))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                (@Ctypes.Internal Clight.function
                   (jet_shift8_helper_exec.shift8_reader_function
                      match s return bool with
                      | jet_wide.W16 => true
                      | jet_wide.W32 => false
                      | jet_wide.W64 => false
                      end)) (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
                (@cons Values.val (Values.Vptr bd dofs)
                   (@cons Values.val (Values.Vlong (jet_shift_wide_helper_exec.shift_wide_payload s right fill r a))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_one8.e_one8 bl) le m (shift_wide_with_helper_call s right)
         Events.E0 le mf ClightBigstep.Out_normal
### C.jet_shift_wide_with_exec.shift_wide_with_body
shift_wide_with_body
     : forall (s : jet_wide.wide_size) (right : bool),
       @eq Clight.statement (Clight.fn_body (shift_wide_with_function s right))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence jet_complement1_exec.bit_jet_read
                  (Clight.Sset jets._with (Clight.Ecast (Clight.Etempvar jets._t'1 Ctypesdefs.tbool) Ctypesdefs.tbool)))
               (Clight.Ssequence (shift_wide_with_helper_call s right)
                  (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))))))
### C.jet_shift_wide_with_exec.eval_shift_wide_with_composes
eval_shift_wide_with_composes
     : forall (env : Values.val) (s : jet_wide.wide_size) (right fill : bool) (m : Memory.Mem.mem)
         (ma : Memory.Mem.mem') (mc mb mr mr2 me mf : Memory.Mem.mem) (bl bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (a : Integers.Int.int) (r : Integers.Int64.int) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc (@Ctypes.Internal Clight.function jets.f_readBit)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mb
                (Values.Vint (jet_readBit_layout.bit_int fill)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mb
                (@Ctypes.Internal Clight.function
                   (jet_shift8_helper_exec.shift8_reader_function
                      match s return bool with
                      | jet_wide.W16 => true
                      | jet_wide.W32 => false
                      | jet_wide.W64 => false
                      end)) (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function (jet_wide.wide_writer s))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (jet_shift_wide_helper_exec.shift_wide_payload s right fill r a))
                      (@nil Values.val))) Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function (shift_wide_with_function s right))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_shift_wide_with_exec.shift_wide_with_function
shift_wide_with_function =
fun (s : jet_wide.wide_size) (right : bool) =>
match s return Clight.function with
| jet_wide.W16 =>
    match right return Clight.function with
    | true => jets.f_simplicity_right_shift_with_16
    | false => jets.f_simplicity_left_shift_with_16
    end
| jet_wide.W32 =>
    match right return Clight.function with
    | true => jets.f_simplicity_right_shift_with_32
    | false => jets.f_simplicity_left_shift_with_32
    end
| jet_wide.W64 =>
    match right return Clight.function with
    | true => jets.f_simplicity_right_shift_with_64
    | false => jets.f_simplicity_left_shift_with_64
    end
end
     : forall (_ : jet_wide.wide_size) (_ : bool), Clight.function

Arguments shift_wide_with_function s right%bool_scope
### C.jet_shift_wide_with_exec.shift_wide_with_helper_call
shift_wide_with_helper_call =
fun (s : jet_wide.wide_size) (right : bool) =>
Clight.Scall (@None AST.ident)
  (Clight.Evar (jet_shift_wide_exec.shift_wide_helper_id s right)
     (Ctypes.Tfunction
        (Ctypes.Tcons Ctypesdefs.tbool
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets._with Ctypesdefs.tbool)
     (@cons Clight.expr (Clight.Etempvar jets._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets._frameItem Ctypes.noattr))) (@nil Clight.expr))))
     : forall (_ : jet_wide.wide_size) (_ : bool), Clight.statement

Arguments shift_wide_with_helper_call s right%bool_scope
### C.jet_shift_wide_with_exec.le_shift_wide_with
le_shift_wide_with =
fun (env : Values.val) (s : jet_wide.wide_size) (right : bool) (bd : Values.block) (dofs : Integers.Ptrofs.int)
  (bs : Values.block) (sofs : Integers.Ptrofs.int) (fill : bool) =>
@Maps.PTree.set Values.val jets._with (Values.Vint (jet_readBit_layout.bit_int fill))
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vint (jet_readBit_layout.bit_int fill))
     (jet_arith8_layout_exec.le_arith8_layout env (shift_wide_with_function s right) bd dofs bs sofs))
     : forall (_ : Values.val) (_ : jet_wide.wide_size) (_ : bool) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : bool), Maps.PTree.tree Values.val

Arguments le_shift_wide_with env s right%bool_scope bd dofs bs sofs fill%bool_scope
