### C.jet_elements_fee_lookup_compare.exec_fee_lookup_compare
exec_fee_lookup_compare
     : forall (_ : jet_memcmp_model.memcmp_model) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (len : BinNums.Z) (bt : Values.block) (base : BinNums.Z) (bk : Values.block) (keybase : BinNums.Z)
         (bp : Values.block) (ofs : BinNums.Z) (key candidate : list Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._len le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr len))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._feeOutputs le)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._assetid le)
                (@Some Values.val (Values.Vptr bk (Integers.Ptrofs.repr keybase))))
         (_ : and (BinInt.Z.le BinNums.Z0 len) (BinInt.Z.le len Integers.Int64.max_unsigned))
         (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.div len (BinNums.Zpos (BinNums.xO BinNums.xH))))) Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le BinNums.Z0 keybase)
         (_ : BinInt.Z.le
                (BinInt.Z.add keybase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (BinInt.Z.add Integers.Ptrofs.max_unsigned (BinNums.Zpos BinNums.xH))) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (BinInt.Z.add Integers.Ptrofs.max_unsigned (BinNums.Zpos BinNums.xH)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr m bt
                   (BinInt.Z.add base
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.div len (BinNums.Zpos (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vptr bp (Integers.Ptrofs.repr ofs))))
         (_ : @eq nat (@length Integers.Int.int key)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length Integers.Int.int candidate)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : jet_memcmp_model.bytes_at m bk keybase key) (_ : jet_memcmp_model.bytes_at m bp ofs candidate),
       @ex Integers.Int.int
         (fun cmp : Integers.Int.int =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge Clight.empty_env le m fee_lookup_compare
               Events.E0 (fee_lookup_compared bp ofs cmp le) m ClightBigstep.Out_normal)
            (jet_memcmp_model.memcmp_sign (jet_memcmp_model.bytes_cmp key candidate) cmp))
### C.jet_elements_fee_lookup_compare.fee_lookup_half
fee_lookup_half =
Clight.Ebinop Cop.Odiv (Clight.Etempvar jets_elements._len Ctypesdefs.tulong)
  (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))) Ctypesdefs.tint) Ctypesdefs.tulong
     : Clight.expr
### C.jet_elements_fee_lookup_compare.fee_lookup_mid
fee_lookup_mid =
Clight.Ederef
  (Clight.Ebinop Cop.Oadd
     (Clight.Etempvar jets_elements._feeOutputs
        (Ctypesdefs.tptr (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))) fee_lookup_half
     (Ctypesdefs.tptr (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr))))
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr))
     : Clight.expr
### C.jet_elements_fee_lookup_compare.fee_lookup_key
fee_lookup_key =
Clight.Efield
  (Clight.Ederef
     (Clight.Etempvar jets_elements._assetid
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)))
     (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) jets_elements._s
  (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     : Clight.expr
### C.jet_elements_fee_lookup_compare.fee_lookup_candidate
fee_lookup_candidate =
Clight.Efield
  (Clight.Efield
     (Clight.Efield
        (Clight.Ederef
           (Clight.Etempvar jets_elements._t'4
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)))
           (Ctypes.Tstruct jets_elements._sigOutput Ctypes.noattr)) jets_elements._asset
        (Ctypes.Tstruct jets_elements._confidential Ctypes.noattr)) jets_elements._data
     (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr)) jets_elements._s
  (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     : Clight.expr
### C.jet_elements_fee_lookup_compare.fee_lookup_memcmp
fee_lookup_memcmp =
Clight.Scall (@Some AST.ident jets_elements._t'1)
  (Clight.Evar jets_elements._memcmp
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tvoid)
           (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tvoid) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
        Ctypesdefs.tint AST.cc_default))
  (@cons Clight.expr fee_lookup_key
     (@cons Clight.expr fee_lookup_candidate
        (@cons Clight.expr
           (Clight.Esizeof
              (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              Ctypesdefs.tulong) (@nil Clight.expr))))
     : Clight.statement
### C.jet_elements_fee_lookup_compare.fee_lookup_compare
fee_lookup_compare =
Clight.Ssequence (Clight.Ssequence (Clight.Sset jets_elements._t'4 fee_lookup_mid) fee_lookup_memcmp)
  (Clight.Sset jets_elements._cmp (Clight.Etempvar jets_elements._t'1 Ctypesdefs.tint))
     : Clight.statement
### C.jet_elements_fee_lookup_compare.fee_lookup_work
fee_lookup_work =
match Clight.fn_body jets_elements.f_lookup_fee return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence s0 _ =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ _ => Clight.Sskip
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop s2 _ =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ s => s
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_elements_fee_lookup_compare.fee_lookup_after_compare
fee_lookup_after_compare =
match fee_lookup_work return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s => s
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_elements_fee_lookup_compare.fee_lookup_compared
fee_lookup_compared =
fun (bp : Values.block) (ofs : BinNums.Z) (cmp : Integers.Int.int) (le : Maps.PTree.tree Values.val) =>
@Maps.PTree.set Values.val jets_elements._cmp (Values.Vint cmp)
  (@Maps.PTree.set Values.val jets_elements._t'1 (Values.Vint cmp)
     (@Maps.PTree.set Values.val jets_elements._t'4 (Values.Vptr bp (Integers.Ptrofs.repr ofs)) le))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int.int) (_ : Maps.PTree.tree Values.val),
       Maps.PTree.tree Values.val

Arguments fee_lookup_compared bp ofs%Z_scope cmp le
