### C.jet_secp_scalar_mul_literal_both_owned.eval_scalar_mul_literal_both_owned
eval_scalar_mul_literal_both_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_sx_state.rep rho beta jet_secp_scalar_mul_caller_alloc.scalar_mul_caller_inputs m)
         (_ : @eq BinNums.Z (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho O)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem a)))
         (_ : @eq BinNums.Z (jet_secp_scalar_mul512_low.scalar_mul512_input_value rho (S (S (S (S O)))))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem b))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_sx_state.rep
                  (jet_secp_scalar_get_b32_numeric.scalar_limb_rho
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@jet_secp_canonical_scalar_negate.canonical_scalar_multiply Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
                  (@cons (prod Values.block BinNums.Z)
                     (@pair Values.block BinNums.Z (jet_sx_state.blk beta O) (jet_sx_state.bas beta O))
                     (@nil (prod Values.block BinNums.Z))) jet_secp_scalar_writer_run.scalar_writer_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf (jet_sx_state.blk beta O) BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf (jet_sx_state.blk beta (S O)) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (jet_sx_mem.lframe
                        (fun (block : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot beta
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape jet_secp_scalar_mul_caller_alloc.scalar_mul_caller_inputs) block
                              ofs)) m mf)))))
