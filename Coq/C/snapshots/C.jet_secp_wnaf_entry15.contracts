### C.jet_secp_wnaf_entry15.wnaf_memset_args
wnaf_memset_args =
match wnaf_memset_call return (list Clight.expr) with
| Clight.Sskip => @nil Clight.expr
| Clight.Sassign _ _ => @nil Clight.expr
| Clight.Sset _ _ => @nil Clight.expr
| Clight.Scall _ _ args => args
| Clight.Sbuiltin _ _ _ _ => @nil Clight.expr
| Clight.Ssequence _ _ => @nil Clight.expr
| Clight.Sifthenelse _ _ _ => @nil Clight.expr
| Clight.Sloop _ _ => @nil Clight.expr
| Clight.Sbreak => @nil Clight.expr
| Clight.Scontinue => @nil Clight.expr
| Clight.Sreturn _ => @nil Clight.expr
| Clight.Sswitch _ _ => @nil Clight.expr
| Clight.Slabel _ _ => @nil Clight.expr
| Clight.Sgoto _ => @nil Clight.expr
end
     : list Clight.expr
### C.jet_secp_wnaf_entry15.wnaf_at_memset
wnaf_at_memset = Clight.Ssequence wnaf_memset_call jet_secp_wnaf_prepare.wnaf_post_memset
