         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
         (@jet_bitcoin_indexed_scalar.indexed_scalar_rep Bitcoin.sigTxInput
            (fun e : Bitcoin.Bitcoin.env => Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx e))
            (fun txi : Bitcoin.sigTxInput => Integers.Int.unsigned (Bitcoin.sigTxiSequence txi))
            (BinNums.Zpos
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (BinNums.Zpos
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
            BinNums.Z0
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))))))
         (fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : Bitcoin.Bitcoin.env) =>
