### C.jet_secp_double_separate_middle.double_separate_middle_frame
double_separate_middle_frame =
fun (br ba bs bl bt b : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block b bs))
  (and (not (@eq Values.block b bl))
     (and (not (@eq Values.block b bt))
        (and
           (or (not (@eq Values.block b ba))
              (or (BinInt.Z.lt pos BinNums.Z0)
                 (BinInt.Z.le
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) pos)))
           (or (not (@eq Values.block b br))
              (or (BinInt.Z.lt pos BinNums.Z0)
                 (BinInt.Z.le
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) pos))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments double_separate_middle_frame br ba bs bl bt b pos%Z_scope
