### C.jet_elements_pegin_literal.elements_input_pegin_literal_spec
elements_input_pegin_literal_spec =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
@Some (sum unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
  match
    @List.nth_error jet_elements_prim.sigTxInput
      (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment))
      (BinInt.Z.to_nat (jet_elements_sequence_literal.haskell_from_word (S (S (S (S (S O))))) a))
    return (sum unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
  with
  | Some txi =>
      @inr unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        match
          jet_elements_prim.sigTxiPegin txi return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        with
        | Some h =>
            @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S (S (S (S O))))))))
                 (jet_haskell_hash_word.haskell_integer_hash256 (Digest.hash256_to_bytelist h)))
        | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
        end
  | None => @inl unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
  end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))

Arguments elements_input_pegin_literal_spec a environment
