### C.jet_secp_scalar_invert_literal.literal_scalar_invert_numeric
literal_scalar_invert_numeric =
fun x : BinNums.Z =>
jet_secp_invert_modinv.eea_selected_inverse jet_secp_canonical_scalar.canonical_group_order
  (jet_secp_eea_numeric.eea_run_numeric
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
     (@pair (prod (prod BinNums.Z BinNums.Z) BinNums.Z) (prod (prod BinNums.Z BinNums.Z) BinNums.Z)
        (@pair (prod BinNums.Z BinNums.Z) BinNums.Z (@pair BinNums.Z BinNums.Z (BinNums.Zpos BinNums.xH) BinNums.Z0)
           jet_secp_canonical_scalar.canonical_group_order)
        (@pair (prod BinNums.Z BinNums.Z) BinNums.Z (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH)) x)))
     : forall _ : BinNums.Z, BinNums.Z

Arguments literal_scalar_invert_numeric x%Z_scope
