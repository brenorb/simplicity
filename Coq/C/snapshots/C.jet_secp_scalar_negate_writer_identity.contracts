### C.jet_secp_scalar_negate_writer_identity.scalar_negate_normalize_identity
scalar_negate_normalize_identity
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem
            (@jet_secp_canonical_scalar_negate.canonical_scalar_negate Alg.CoreFunSem value))
         (@jet_secp_canonical_scalar_negate.canonical_scalar_negate Alg.CoreFunSem value)
