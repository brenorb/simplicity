### C.jet_secp_canonical_normalize.canonical_fe_normalize_numeric
canonical_fe_normalize_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_fe_normalize Alg.CoreFunSem x))
         (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
            canonical_field_order)
### C.jet_secp_canonical_normalize.canonical_fe_normalize_limb_bridge
canonical_fe_normalize_limb_bridge
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (z0 z1 z2 z3 z4 : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 z0)
                (BinInt.Z.le z0
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 z1)
                (BinInt.Z.le z1
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 z2)
                (BinInt.Z.le z2
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 z3)
                (BinInt.Z.le z3
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 z4)
                (BinInt.Z.le z4
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : @eq BinNums.Z (jet_secp_fe_math.fe_val z0 z1 z2 z3 z4)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)),
       @eq (list BinNums.Z) (jet_secp_fe_nv.nvz_list z0 z1 z2 z3 z4)
         (jet_secp_fe_math.fe_limbs_of
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@canonical_fe_normalize Alg.CoreFunSem x)))
### C.jet_secp_canonical_normalize.eval_fe_normalize_var_against_canonical_program
eval_fe_normalize_var_against_canonical_program
     : forall (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (t0 t1 t2 t3 t4 : Integers.Int64.int)
         (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_fe_nv.fe_at m b ofs
                (@cons Integers.Int64.int t0
                   (@cons Integers.Int64.int t1
                      (@cons Integers.Int64.int t2
                         (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int)))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t0)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t1)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t2)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t3)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t4)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : @eq BinNums.Z
                (jet_secp_fe_math.fe_val (Integers.Int64.unsigned t0) (Integers.Int64.unsigned t1)
                   (Integers.Int64.unsigned t2) (Integers.Int64.unsigned t3) (Integers.Int64.unsigned t4))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr ofs)) (@nil Values.val)) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b ofs
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_fe_math.fe_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_fe_normalize Alg.CoreFunSem x)))))
               (jet_sx_mem.lframe
                  (fun (other : Values.block) (pos : BinNums.Z) =>
                   not
                     (and (@eq Values.block other b)
                        (and (BinInt.Z.le ofs pos)
                           (BinInt.Z.lt pos
                              (BinInt.Z.add ofs
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))) m
                  mf)))
### C.jet_secp_canonical_normalize.canonical_fe_normalize_idempotent
canonical_fe_normalize_idempotent
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@canonical_fe_normalize Alg.CoreFunSem (@canonical_fe_normalize Alg.CoreFunSem x))
         (@canonical_fe_normalize Alg.CoreFunSem x)
### C.jet_secp_canonical_normalize.canonical_field_order
canonical_field_order =
BinNums.Zpos
  (BinNums.xI
     (BinNums.xI
        (BinNums.xI
           (BinNums.xI
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
     : BinNums.Z
### C.jet_secp_canonical_normalize.canonical_field_word
canonical_field_word =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) canonical_field_order
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))
