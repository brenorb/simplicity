canonical_fe_normalize =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
  (@Alg.Core.Combinators.pair (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
        (@Alg.Core.Combinators.pair (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
           (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)
           (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O))))))))) Ty.Unit
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
              (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)
              (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) canonical_field_word term)))
        (@jet_subtract_spec.subtract_word_spec term (S (S (S (S (S (S (S (S O))))))))))
     (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))
  (@Alg.Core.Combinators.comp
     (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Alg.Core.Combinators.pair
        (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.Sum Ty.Unit Ty.Unit)
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
        (@Alg.Core.Combinators.take (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Ty.Sum Ty.Unit Ty.Unit) term
           (@Alg.Core.Combinators.take (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Ty.Sum Ty.Unit Ty.Unit) term (@Alg.Core.Combinators.iden (Ty.Sum Ty.Unit Ty.Unit) term)))
        (@Alg.Core.Combinators.pair
           (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
           (@Alg.Core.Combinators.take (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
              (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                 (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)))
           (@Alg.Core.Combinators.drop (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
              (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))))
     (@Bit.cond (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.drop (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
           (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))
        (@Alg.Core.Combinators.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
           (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments canonical_fe_normalize {term}
