### C.jet_copyBits_two_words_right_short_cells.eval_copyBits_two_right_short_layout
eval_copyBits_two_right_short_layout
     : forall (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (cells : list BitMachine.Cell) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : jet_output_layout.write_frame_at m bd base bw outedge cursor n)
         (_ : @eq BinNums.Z n (BinInt.Z.of_nat (@length BitMachine.Cell cells)))
         (_ : BinInt.Z.lt BinNums.Z0
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and
                (BinInt.Z.lt
                   (BinInt.Z.modulo cursor
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) n)
                (BinInt.Z.le n
                   (BinInt.Z.sub
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (BinInt.Z.modulo rc
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : jet_context_separated.jet_copy_buffers_separated bd bi bw edge outedge cursor rc n)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc cells),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
               (@Ctypes.Internal Clight.function jets.f_simplicity_copyBits)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and (jet_encoding.frame_output_cells_at mf bw outedge cursor cells)
               (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                  (and (jet_frame_layout.frame_fields_at mf bd base bw outedge (BinInt.Z.sub cursor n))
                     (and
                        (jet_output_layout.loads_outside_ranges m mf bd
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.sub (jet_write_layout.write_word_address outedge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
