            (Clight.fn_vars jets_secp.f_secp256k1_scalar_split_lambda)) true
### C.jet_elements_taptweak_split_entry.elements_taptweak_split_function_entry
elements_taptweak_split_function_entry
     : forall (v1 v2 : Values.val) (bk : Values.block) (m : Memory.Mem.mem) (ma mi : Memory.Mem.mem')
         (bc1 bc2 : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block ma bc1))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mi bc2)),
