         (jet_secp_split_rounding_calls.split_local_env bc1 bc2)
         (jet_secp_split_rounding_entry.split_entry_temps v1 v2 bk) mi
### C.jet_elements_taptweak_split_entry.elements_taptweak_split_entry_rounding
elements_taptweak_split_entry_rounding
     : forall (k : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (v1 v2 : Values.val)
         (bk : Values.block) (m : Memory.Mem.mem)
         (_ : jet_elements_taptweak_split_constants.elements_taptweak_multipliers_ready m)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))))
         (_ : Memory.Mem.range_perm m bk BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Values.block
         (fun bc1 : Values.block =>
          @ex Values.block
            (fun bc2 : Values.block =>
             @ex Memory.Mem.mem
               (fun mi : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun mf : Memory.Mem.mem =>
                   and
                     (Clight.function_entry2 jet_elements_taptweak_pure.elements_taptweak_ge
                        jets_secp.f_secp256k1_scalar_split_lambda
                        (@cons Values.val v1
                           (@cons Values.val v2
                              (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero) (@nil Values.val)))) m
                        (jet_secp_split_rounding_calls.split_local_env bc1 bc2)
                        (jet_secp_split_rounding_entry.split_entry_temps v1 v2 bk) mi)
                     (and
                        (ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge
                           (jet_secp_split_rounding_calls.split_local_env bc1 bc2)
                           (jet_secp_split_rounding_entry.split_entry_temps v1 v2 bk) mi
                           jet_secp_split_rounding_calls.split_rounding_prefix Events.E0
                           (jet_secp_split_rounding_entry.split_entry_temps v1 v2 bk) mf ClightBigstep.Out_normal)
                        (and
                           (jet_secp_scalar_get_b32_storage.scalar_at mf bc1 BinNums.Z0
                              (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                                 (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                                    (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                                       (@jet_secp_split_round_literal.literal_split_coefficient true Alg.CoreFunSem k)))))
                           (and
                              (jet_secp_scalar_get_b32_storage.scalar_at mf bc2 BinNums.Z0
                                 (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                                    (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                                       (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O))))))))
                                          (@jet_secp_split_round_literal.literal_split_coefficient false Alg.CoreFunSem
                                             k)))))
                              (and
                                 (jet_secp_scalar_get_b32_storage.scalar_at mf bk BinNums.Z0
                                    (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                                       (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                                          (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (...))))))))) k))))
                                 (and
                                    (Memory.Mem.range_perm mf bc1 BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (Memory.Mem.range_perm mf bc2 BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (Memory.Mem.range_perm mf bk BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (jet_elements_taptweak_split_constants.elements_taptweak_multipliers_ready
                                                mf)
                                             (and (not (@eq Values.block bc1 bc2))
                                                (and (not (@eq Values.block bc1 bk))
                                                   (and (not (@eq Values.block bc2 bk))
                                                      (and (not (Memory.Mem.valid_block m bc1))
                                                         (and (not (Memory.Mem.valid_block m bc2))
                                                            (and
                                                               (jet_clight_internal_permissions.keeps_permissions m mf)
                                                               (and
                                                                  (jet_clight_internal_preserve.readonly_preserved m mf)
                                                                  (jet_sx_mem.lframe (...) m mf))))))))))))))))))))
### C.jet_elements_taptweak_split_entry.elements_taptweak_split_entry_frame
elements_taptweak_split_entry_frame =
fun (bk b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b bk))
  (and (not (@eq Values.block b (jet_elements_taptweak_split_constants.elements_taptweak_multiplier_block true)))
     (not (@eq Values.block b (jet_elements_taptweak_split_constants.elements_taptweak_multiplier_block false))))
     : forall (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments elements_taptweak_split_entry_frame bk b _%Z_scope
