### C.jet_secp_point_weak_owned.point_weak_reader_bounds
point_weak_reader_bounds
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (n : nat),
       and
         (BinInt.Z.le (@fst BinNums.Z BinNums.Z (jet_secp_point_weak_values.point_weak_bounds n))
            (Integers.Int64.unsigned (jet_secp_write_fe_numeric.write_fe_rho value BinNums.Z0 n)))
         (BinInt.Z.le (Integers.Int64.unsigned (jet_secp_write_fe_numeric.write_fe_rho value BinNums.Z0 n))
            (@snd BinNums.Z BinNums.Z (jet_secp_point_weak_values.point_weak_bounds n)))
### C.jet_secp_point_weak_owned.eval_point_weak_reader_owned
eval_point_weak_reader_owned
     : forall (k : jet_secp_point_write_run.point_coordinate) (m : Memory.Mem.mem) (b : Values.block)
         (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset k)
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_weak)
               (@cons Values.val
                  (Values.Vptr b (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                  (@nil Values.val)) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf b (jet_secp_point_write_run.point_coordinate_offset k)
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (bx : Values.block) (pos : BinNums.Z) =>
                      not
                        (jet_sx_state.foot
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                              (@nil (prod Values.block BinNums.Z)))
                           (@List.map jet_sx_state.region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                              jet_sx_state.rshape (jet_secp_point_write_run.point_write_initial_regs k)) bx pos)) m mf))))
