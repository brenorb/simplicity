### C.jet_divmod_representation.div_mod_word_representation
div_mod_word_representation
     : forall (n : nat) (x y : Ty.tySem (Word.Word n)),
       @eq (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ n))) (Ty.tySem (Word.ToZ.obj (Word.WordToZ n))))
         (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ n))) (Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ n)
               (jet_division_value.division_numeric false (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)
                  (@Word.ToZ.Theory.toZ (Word.WordToZ n) y)))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ n)
               (jet_division_value.division_numeric true (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)
                  (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))))
         (@jet_division_core_spec.div_mod_word_spec n Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y))
