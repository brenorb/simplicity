### C.jet_secp_split_function.split_function_blocks
split_function_blocks
     : forall bc1 bc2 : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (jet_secp_split_rounding_calls.split_local_env bc1 bc2))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bc2 BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bc1 BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
### C.jet_secp_split_function.split_function_closed
split_function_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers
            (Clight.fn_body jets_secp.f_secp256k1_scalar_split_lambda)) true
### C.jet_secp_split_function.eval_scalar_split_lambda
eval_scalar_split_lambda
     : forall (k : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bk br1 br2 : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))
                (BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k)
                   jet_secp_canonical_scalar.canonical_group_order))
         (_ : jet_secp_split_constants.split_constants_ready m)
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bk BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))))
         (_ : Memory.Mem.range_perm m bk BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br1 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : @List.NoDup Values.block
                (@cons Values.block bk (@cons Values.block br1 (@cons Values.block br2 (@nil Values.block))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_split_lambda)
               (@cons Values.val (Values.Vptr br1 Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr br2 Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mf br1 BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                        (jet_secp_split_constants.split_first_value
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k)))))
               (and
                  (jet_secp_scalar_get_b32_storage.scalar_at mf br2 BinNums.Z0
                     (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                        (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                           (jet_secp_split_constants.split_second_value
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k)))))
                  (and
                     (jet_secp_scalar_get_b32_storage.scalar_at mf bk BinNums.Z0
                        (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                           (jet_secp_scalar_get_b32_numeric.scalar_limbs_of
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) k))))
                     (and
                        (Memory.Mem.range_perm mf br1 BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf br2 BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bk BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_secp_split_constants.split_constants_ready mf)
                                 (and (jet_clight_internal_permissions.keeps_permissions m mf)
                                    (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                       (jet_sx_mem.lframe (split_function_frame bk br1 br2) m mf)))))))))))
### C.jet_secp_split_function.split_function_frame
split_function_frame =
fun (bk br1 br2 b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b bk))
  (and (not (@eq Values.block b br1))
     (and (not (@eq Values.block b br2))
        (and (not (@eq Values.block b (jet_secp_split_multipliers.split_multiplier_block true)))
           (and (not (@eq Values.block b (jet_secp_split_multipliers.split_multiplier_block false)))
              (and (not (@eq Values.block b (jet_secp_split_constants.split_basis_block true)))
                 (and (not (@eq Values.block b (jet_secp_split_constants.split_basis_block false)))
                    (not (@eq Values.block b jet_secp_scalar_lambda_global.scalar_lambda_block))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments split_function_frame bk br1 br2 b _%Z_scope
