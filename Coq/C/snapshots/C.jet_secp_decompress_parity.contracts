### C.jet_secp_decompress_parity.exec_decompress_parity_owned
exec_decompress_parity_owned
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (b : Values.block) (value : BinNums.Z) (odd : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._odd le)
                (@Some Values.val
                   (Values.Vint
                      match odd return Integers.Int.int with
                      | true => Integers.Int.one
                      | false => Integers.Int.zero
                      end)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_is_odd e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               jet_secp_decompress_statements.decompress_odd_test Events.E0 (decompress_parity_temps le value) mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf b
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (decompress_parity_limbs value odd))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (bx : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block bx b))
                        (or
                           (BinInt.Z.lt pos
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (BinInt.Z.le
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                     m mf))))
### C.jet_secp_decompress_parity.decompress_rest_source
decompress_rest_source
     : @eq Clight.statement jet_secp_decompress_statements.decompress_rest
         (Clight.Ssequence jet_secp_decompress_statements.decompress_root_test decompress_success_tail)
### C.jet_secp_decompress_parity.exec_decompress_success_tail
exec_decompress_success_tail
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (b : Values.block) (w : forall _ : nat, Integers.Int64.int) (odd : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._odd le)
                (@Some Values.val
                   (Values.Vint
                      match odd return Integers.Int.int with
                      | true => Integers.Int.one
                      | false => Integers.Int.zero
                      end)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalize_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_is_odd e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_negate e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m decompress_success_tail Events.E0
               (decompress_parity_temps le
                  (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)) mf
               (ClightBigstep.Out_return
                  (@Some (prod Values.val Ctypes.type)
                     (@pair Values.val Ctypes.type (Values.Vint Integers.Int.one) Ctypesdefs.tint))))
            (and
               (jet_secp_fe_nv.fe_at mf b
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  (decompress_parity_limbs
                     (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP) odd))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (bx : Values.block) (pos : BinNums.Z) =>
                      or (not (@eq Values.block bx b))
                        (or
                           (BinInt.Z.lt pos
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           (BinInt.Z.le
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos)))
                     m mf))))
### C.jet_secp_decompress_parity.decompress_parity_temps
decompress_parity_temps =
fun (le : Maps.PTree.tree Values.val) (value : BinNums.Z) =>
@Maps.PTree.set Values.val jets_secp._t'2
  (Values.Vint (Integers.Int.repr (BinInt.Z.b2z (BinInt.Z.testbit value BinNums.Z0)))) le
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments decompress_parity_temps le value%Z_scope
### C.jet_secp_decompress_parity.decompress_parity_limbs
decompress_parity_limbs =
fun (value : BinNums.Z) (odd : bool) =>
match xorb (BinInt.Z.testbit value BinNums.Z0) odd return (list Integers.Int64.int) with
| true => jet_secp_field_negate_storage.negate_values (jet_secp_write_fe_numeric.write_fe_rho value BinNums.Z0)
| false => @List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)
end
     : forall (_ : BinNums.Z) (_ : bool), list Integers.Int64.int

Arguments decompress_parity_limbs value%Z_scope odd%bool_scope
### C.jet_secp_decompress_parity.decompress_success_tail
decompress_success_tail =
Clight.Ssequence jet_secp_decompress_statements.decompress_normalize_stmt
  (Clight.Ssequence jet_secp_decompress_statements.decompress_odd_test
     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))))
     : Clight.statement
