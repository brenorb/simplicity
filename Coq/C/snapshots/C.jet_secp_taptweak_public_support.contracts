### C.jet_secp_taptweak_public_support.taptweak_public_ok
taptweak_public_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_simplicity_bitcoin_build_taptweak) true
### C.jet_secp_taptweak_public_support.taptweak_generic_symbol
taptweak_generic_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            jets_secp._simplicity_generic_taptweak)
         (@Some Values.block (jet_secp_linkage.secp_symbol_block jets_secp._simplicity_generic_taptweak))
### C.jet_secp_taptweak_public_support.taptweak_generic_function
taptweak_generic_function
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
            (jet_secp_linkage.secp_symbol_block jets_secp._simplicity_generic_taptweak))
         (@Some (Ctypes.fundef Clight.function)
            (@Ctypes.Internal Clight.function jets_secp.f_simplicity_generic_taptweak))
### C.jet_secp_taptweak_public_support.taptweak_public_entry
taptweak_public_entry
     : forall (m : Memory.Mem.mem) (vd vs ve : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bf : Values.block =>
             and
               (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_simplicity_bitcoin_build_taptweak
                  (@cons Values.val vd (@cons Values.val vs (@cons Values.val ve (@nil Values.val)))) m
                  (taptweak_public_env bf) (taptweak_public_temps vd vs ve) mi)
               (and (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), not (@eq Values.block b bf))
                  (and
                     (Memory.Mem.range_perm mi bf BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                        Memtype.Freeable)
                     (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                        (and (jet_clight_internal_permissions.keeps_permissions m mi)
                           (jet_clight_internal_preserve.readonly_preserved m mi)))))))
### C.jet_secp_taptweak_public_support.taptweak_public_source
taptweak_public_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_simplicity_bitcoin_build_taptweak)
         (Clight.Ssequence taptweak_public_copy
            (Clight.Ssequence taptweak_public_call
               (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tbool)))))
### C.jet_secp_taptweak_public_support.exec_taptweak_public_call
exec_taptweak_public_call
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bf bd : Values.block)
         (base : BinNums.Z) (result : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_simplicity_generic_taptweak)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vptr bf Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr jet_secp_taptweak_tag.taptweak_tag_block Integers.Ptrofs.zero)
                         (@cons Values.val
                            (Values.Vlong
                               (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                            (@nil Values.val))))) Events.E0 mf (Values.Vint (jet_readBit_layout.bit_int result))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (taptweak_public_env bf) le m taptweak_public_call
         Events.E0 (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint (jet_readBit_layout.bit_int result)) le) mf
         ClightBigstep.Out_normal
### C.jet_secp_taptweak_public_support.taptweak_public_copy_from_fields
taptweak_public_copy_from_fields
     : forall (m : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (bf bs : Values.block)
         (sbase : BinNums.Z) (bin : Values.block) (edge rc : BinNums.Z) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bf bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : jet_frame_layout.frame_fields_at m bs sbase bin edge rc)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (taptweak_public_env bf) le m
               taptweak_public_copy Events.E0 le mc ClightBigstep.Out_normal)
            (and (jet_frame_layout.frame_fields_at mc bf BinNums.Z0 bin edge rc)
               (and
                  (Memory.Mem.range_perm mc bf BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                     Memtype.Freeable)
                  (and (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bf)) m mc)
                     (jet_clight_internal_preserve.readonly_preserved m mc)))))
### C.jet_secp_taptweak_public_support.taptweak_public_blocks
taptweak_public_blocks
     : forall bf : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (taptweak_public_env bf))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bf BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
### C.jet_secp_taptweak_public_support.taptweak_public_free
taptweak_public_free
     : forall (m : Memory.Mem.mem) (bf : Values.block)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.free_list m (Clight.blocks_of_env jet_secp_linkage.secp_ge (taptweak_public_env bf)))
               (@Some Memory.Mem.mem mf))
            (and (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bf)) m mf)
               (jet_clight_internal_preserve.readonly_preserved m mf)))
