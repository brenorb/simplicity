                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))))))))))))
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (negate_mask n)))
               (BinInt.Z.le (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (negate_mask n))
                  Integers.Int64.max_unsigned)))
### C.jet_secp_field_negate_values.negate_value_unsigned
negate_value_unsigned
     : forall (rho : forall _ : nat, Integers.Int64.int) (n : nat) (_ : lt n (S (S (S (S (S O))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned (rho (S n)))
                match PeanoNat.Nat.eqb n (S (S (S (S O)))) return BinNums.Z with
                | true =>
                    BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
