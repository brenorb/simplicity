                                                                (BinNums.xI
                                                                   (BinNums.xI
                                                                      (BinNums.xI
                                                                         (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))
                | false =>
                    BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
