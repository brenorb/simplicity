                                                                         (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))
                end),
       @eq BinNums.Z (Integers.Int64.unsigned (negate_value rho n))
         (BinInt.Z.sub (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (negate_mask n))
            (Integers.Int64.unsigned (rho (S n))))
### C.jet_secp_field_negate_values.negate_mask
negate_mask =
fun n : nat =>
match n return BinNums.Z with
| O =>
    BinNums.Zpos
      (BinNums.xI
         (BinNums.xI
            (BinNums.xI
               (BinNums.xI
                  (BinNums.xO
                     (BinNums.xI
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))))))
| S n0 =>
    match n0 return BinNums.Z with
    | O =>
        BinNums.Zpos
          (BinNums.xI
             (BinNums.xI
                (BinNums.xI
                   (BinNums.xI
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))
    | S n1 =>
        match n1 return BinNums.Z with
        | O =>
            BinNums.Zpos
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI
                                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))))
        | S n2 =>
            match n2 return BinNums.Z with
            | O =>
                BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))
            | S n3 =>
                match n3 return BinNums.Z with
                | O =>
                    BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))
                | S _ =>
                    BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))
                end
            end
        end
    end
end
     : forall _ : nat, BinNums.Z

Arguments negate_mask n%nat_scope
### C.jet_secp_field_negate_values.negate_limb_expr
negate_limb_expr =
fun n : nat =>
jet_sx_expr.XLb jet_sx_expr.Bsub
  (jet_sx_expr.XLb jet_sx_expr.Bmul
     (jet_sx_expr.XLb jet_sx_expr.Bmul (jet_sx_expr.XLc (Integers.Int64.repr (negate_mask n)))
        (jet_sx_expr.XI2L Ctypes.Signed (jet_sx_expr.XIc (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))))
     (jet_sx_expr.XI2L Ctypes.Signed
        (jet_sx_expr.XIb jet_sx_expr.Badd (jet_sx_expr.XIc Integers.Int.one) (jet_sx_expr.XIc Integers.Int.one))))
  (jet_sx_expr.XLv (S n))
     : forall _ : nat, jet_sx_expr.sx

Arguments negate_limb_expr n%nat_scope
### C.jet_secp_field_negate_values.negate_value
negate_value =
fun (rho : forall _ : nat, Integers.Int64.int) (n : nat) =>
Integers.Int64.sub
  (Integers.Int64.repr (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (negate_mask n)))
  (rho (S n))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments negate_value rho%function_scope n%nat_scope
