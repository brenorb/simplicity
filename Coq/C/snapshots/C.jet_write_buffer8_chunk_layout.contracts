### C.jet_write_buffer8_chunk_layout.buffer8_write_chunk_buf
buffer8_write_chunk_buf
     : forall (le : Maps.PTree.tree Values.val) (bi : Values.block) (input len : BinNums.Z)
         (c : prod nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))))
         (_ : match @snd nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c return Prop with
              | Some xs =>
                  @eq nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)
                    (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c)
              | None => True
              end)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._buf le)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input)))),
       @eq (option Values.val) (@Maps.PTree.get Values.val jets._buf (buffer8_write_chunk_temps le bi input len c))
         (@Some Values.val
            (Values.Vptr bi
               (Integers.Ptrofs.repr
                  (BinInt.Z.add input
                     (BinInt.Z.of_nat
                        (@length (Ty.tySem (Word.Word (S (S (S O))))) (jet_buffer_chunks.byte_chunk_values c)))))))
