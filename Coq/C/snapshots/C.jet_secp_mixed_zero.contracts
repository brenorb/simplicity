### C.jet_secp_mixed_zero.mixed_zero_source
mixed_zero_source
     : @eq Clight.statement jet_secp_mixed_difference.mixed_after_difference
         (Clight.Ssequence
            (Clight.Ssequence (mixed_zero_call false)
               (Clight.Sifthenelse (Clight.Etempvar jets_secp._t'2 Ctypesdefs.tint) mixed_zero_branch Clight.Sskip))
            mixed_after_zero)
### C.jet_secp_mixed_zero.mixed_i_zero_source
mixed_i_zero_source
     : @eq Clight.statement mixed_zero_branch
         (Clight.Ssequence (Clight.Ssequence (mixed_zero_call true) mixed_i_zero_branch)
            (Clight.Sreturn (@None Clight.expr)))
### C.jet_secp_mixed_zero.exec_mixed_zero_call
exec_mixed_zero_call
     : forall (i : bool) (w : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (b : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type)
                   match i return BinNums.positive with
                   | true => jets_secp._i
                   | false => jets_secp._h
                   end e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type b jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalizes_to_zero_var e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (mixed_zero_call i) Events.E0
               (@Maps.PTree.set Values.val
                  match i return BinNums.positive with
                  | true => jets_secp._t'1
                  | false => jets_secp._t'2
                  end (Values.Vint (jet_secp_field_zero_owned.field_zero_result w)) le) mf ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf b BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf))))
### C.jet_secp_mixed_zero.exec_mixed_nonzero_guard
exec_mixed_nonzero_guard
     : forall (h : forall _ : nat, Integers.Int64.int) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (bh : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._h e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bh jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalizes_to_zero_var e)
                (@None (prod Values.block Ctypes.type))) (_ : jet_secp_square_columns.square_input_bounds h)
         (_ : not
                (@eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value h) jet_secp_fe_math.feP)
                   BinNums.Z0))
         (_ : jet_secp_fe_nv.fe_at m bh BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 h))
         (_ : Memory.Mem.range_perm m bh BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m mixed_zero_head Events.E0
               (@Maps.PTree.set Values.val jets_secp._t'2 (Values.Vint Integers.Int.zero) le) mf
               ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf bh BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 h))
               (and
                  (Memory.Mem.range_perm mf bh BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx bh)) m mf))))
### C.jet_secp_mixed_zero.mixed_zero_call
mixed_zero_call =
fun i : bool =>
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_normalizes_to_zero_var
  jets_secp.f_secp256k1_fe_normalizes_to_zero_var
  (@Some AST.ident match i return AST.ident with
                   | true => jets_secp._t'1
                   | false => jets_secp._t'2
                   end)
  (@cons Clight.expr
     (jet_secp_curve_statements.curve_local_address
        match i return AST.ident with
        | true => jets_secp._i
        | false => jets_secp._h
        end) (@nil Clight.expr))
     : forall _ : bool, Clight.statement

Arguments mixed_zero_call i%bool_scope
### C.jet_secp_mixed_zero.mixed_zero_head
mixed_zero_head =
match jet_secp_mixed_difference.mixed_after_difference return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence head _ => head
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_mixed_zero.mixed_after_zero
mixed_after_zero =
match jet_secp_mixed_difference.mixed_after_difference return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ rest => rest
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_mixed_zero.mixed_zero_branch
mixed_zero_branch =
match mixed_zero_head return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ _ => Clight.Sskip
    | Clight.Sifthenelse _ branch _ => branch
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_mixed_zero.mixed_i_zero_branch
mixed_i_zero_branch =
match mixed_zero_branch return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence s _ =>
    match s return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ branch => branch
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
