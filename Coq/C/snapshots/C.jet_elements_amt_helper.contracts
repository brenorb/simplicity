### C.jet_elements_amt_helper.eval_elements_amt_layout
eval_elements_amt_layout
     : forall (m : Memory.Mem.mem) (ba : Values.block) (abase : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z) (xs : list Integers.Int.int)
         (v : Integers.Int64.int) (pfx : Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int xs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le BinNums.Z0 abase)
         (_ : BinInt.Z.le
                (BinInt.Z.add abase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : jet_application_sep.out_sep bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) ba
                abase
                (BinInt.Z.add abase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
         (_ : forall _ : @eq bool (Integers.Int.eq (Integers.Int.repr (BinNums.Zpos BinNums.xH)) pfx) true,
              @eq (option Values.val) (Memory.Mem.load AST.Mint64 m ba abase) (@Some Values.val (Values.Vlong v)))
         (_ : forall _ : @eq bool (Integers.Int.eq (Integers.Int.repr (BinNums.Zpos BinNums.xH)) pfx) false,
              jet_uint32_array_init.uint32_array_at m ba abase xs)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.add abase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint pfx)))
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
               (@Ctypes.Internal Clight.function jets_elements.f_amt)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr ba (Integers.Ptrofs.repr abase)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (jet_elements_effects.write_effect m mf bf base bw edge cursor
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xI
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (amt_cells pfx xs v)))
### C.jet_elements_amt_helper._anon_union
_anon_union =
BinNums.xI
  (BinNums.xI
     (BinNums.xI
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xO
                                                  (BinNums.xI
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
     : AST.ident
### C.jet_elements_amt_helper.elements_union_field_at
elements_union_field_at =
fun (uid field : AST.ident) (delta : BinNums.Z) =>
match @Maps.PTree.get Ctypes.composite uid (Clight.genv_cenv jet_elements_linkage.elements_ge) return Prop with
| Some co =>
    @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
      (Ctypes.union_field_offset (Clight.genv_cenv jet_elements_linkage.elements_ge) field (Ctypes.co_members co))
      (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield delta Ctypes.Full))
| None => False
end
     : forall (_ : AST.ident) (_ : AST.ident) (_ : BinNums.Z), Prop

Arguments elements_union_field_at uid field delta%Z_scope
### C.jet_elements_amt_helper.amt_cells
amt_cells =
fun (pfx : Integers.Int.int) (xs : list Integers.Int.int) (v : Integers.Int64.int) =>
match Integers.Int.eq (Integers.Int.repr (BinNums.Zpos BinNums.xH)) pfx return (list BitMachine.Cell) with
| true =>
    @app (option bool) (@cons (option bool) (@Some bool true) (@nil (option bool)))
      (@app (option bool)
         (@List.repeat (option bool) (@None bool)
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))
         (@Translate.encode (Word.Word (jet_wide.wide_log jet_wide.W64))
            (jet_wide_spec.decode_wide jet_wide.W64 (Integers.Int64.zero_ext (jet_wide.wide_bits jet_wide.W64) v))))
| false =>
    @app (option bool) (@cons (option bool) (@Some bool false) (@nil (option bool)))
      (@app (option bool)
         (@cons (option bool)
            (@Some bool (Integers.Int.eq (Integers.Int.repr (BinNums.Zpos (BinNums.xI BinNums.xH))) pfx))
            (@nil (option bool))) (jet_elements_hash_write.hash_cells xs))
end
     : forall (_ : Integers.Int.int) (_ : list Integers.Int.int) (_ : Integers.Int64.int), list BitMachine.Cell

Arguments amt_cells pfx xs%list_scope v
