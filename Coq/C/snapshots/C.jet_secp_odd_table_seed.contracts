                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (Memory.Mem.range_perm mf bp BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (Memory.Mem.range_perm mf bd BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                                Memtype.Cur Memtype.Freeable)
                                             (and
                                                (Memory.Mem.range_perm mf bz BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...))))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (and (jet_clight_internal_permissions.keeps_permissions m mf)
                                                   (and (jet_sx_mem.lframe (odd_table_seed_frame ba bz) m mf)
                                                      (jet_clight_internal_preserve.readonly_preserved m mf))))))))))))))))
### C.jet_secp_odd_table_seed.odd_table_seed_statements
odd_table_seed_statements =
@List.firstn Clight.statement (S (S (S O)))
  (@List.skipn Clight.statement (S (S (S (S O))))
     (@fst (list Clight.statement) Clight.statement
        (jet_secp_statement_prefix.split_statement_last
           (Clight.fn_body jets_secp.f_secp256k1_ecmult_odd_multiples_table))))
     : list Clight.statement
### C.jet_secp_odd_table_seed.odd_table_seed
odd_table_seed =
jet_secp_statement_prefix.statement_sequence odd_table_seed_statements
  (Clight.Sset jets_secp._i (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))
     : Clight.statement
### C.jet_secp_odd_table_seed.odd_table_seed_fields
odd_table_seed_fields =
jet_secp_statement_prefix.statement_sequence odd_table_seed_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_odd_table_seed.odd_table_first_ratio
odd_table_first_ratio =
Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._zr (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
  (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type)
     : Clight.expr
### C.jet_secp_odd_table_seed.odd_table_seed_state
odd_table_seed_state =
fun x y z ratio : forall _ : nat, Integers.Int64.int =>
jet_secp_odd_table_loop.Build_odd_table_state (fun _ : nat => x) (fun _ : nat => y) (fun _ : nat => ratio) x y z
  Integers.Int.zero
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int),
       jet_secp_odd_table_loop.odd_table_state

Arguments odd_table_seed_state (x y z ratio)%function_scope
### C.jet_secp_odd_table_seed.odd_table_seed_frame
odd_table_seed_frame =
fun (ba bz b : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block b ba))
  (or (not (@eq Values.block b bz))
     (or (BinInt.Z.lt pos BinNums.Z0)
        (BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) pos)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments odd_table_seed_frame ba bz b pos%Z_scope
