### C.jet_secp_odd_table_seed.exec_odd_table_seed
exec_odd_table_seed
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (x y z ratio : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba br bp bd bz : Values.block)
         (_ : @List.NoDup Values.block
                (@cons Values.block ba
                   (@cons Values.block br
                      (@cons Values.block bp (@cons Values.block bd (@cons Values.block bz (@nil Values.block)))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ai e)
