### C.jet_full_multiply_wide_exec.wide_full_multiply_body
wide_full_multiply_body
     : forall s : jet_multiply_wide_exec.multiply_wide_size,
       @eq Clight.statement (Clight.fn_body (wide_full_multiply s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr))
               (Clight.Etempvar jets._src (Ctypes.Tstruct jets._frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence
                  (jet_binary_wide_exec.wide_binary_read (jet_multiply_wide_exec.multiply_input_size s) jets._t'1)
                  (Clight.Sset jets._x (Clight.Etempvar jets._t'1 Ctypesdefs.tulong)))
               (Clight.Ssequence
                  (Clight.Ssequence
                     (jet_binary_wide_exec.wide_binary_read (jet_multiply_wide_exec.multiply_input_size s) jets._t'2)
                     (Clight.Sset jets._y (Clight.Etempvar jets._t'2 Ctypesdefs.tulong)))
                  (Clight.Ssequence
                     (Clight.Ssequence
                        (jet_binary_wide_exec.wide_binary_read (jet_multiply_wide_exec.multiply_input_size s) jets._t'3)
                        (Clight.Sset jets._z (Clight.Etempvar jets._t'3 Ctypesdefs.tulong)))
                     (Clight.Ssequence
                        (Clight.Ssequence
                           (jet_binary_wide_exec.wide_binary_read (jet_multiply_wide_exec.multiply_input_size s)
                              jets._t'4) (Clight.Sset jets._w (Clight.Etempvar jets._t'4 Ctypesdefs.tulong)))
                        (Clight.Ssequence
                           (jet_arith8_layout_exec.frame_writer_call
                              (jet_wide.wide_writer_id (jet_multiply_wide_exec.multiply_output_size s))
                              Ctypesdefs.tulong Ctypesdefs.tvoid full_multiply_expr)
                           (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))))))
### C.jet_full_multiply_wide_exec.eval_full_multiply_expr
eval_full_multiply_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r t u v : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._x le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._y le) (@Some Values.val (Values.Vlong t)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._z le) (@Some Values.val (Values.Vlong u)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._w le) (@Some Values.val (Values.Vlong v))),
       Clight.eval_expr jet_exec.ge0 e le m full_multiply_expr (Values.Vlong (full_multiply_value r t u v))
### C.jet_full_multiply_wide_exec.eval_wide_full_multiply_composes
eval_wide_full_multiply_composes
     : forall (env : Values.val) (s : jet_multiply_wide_exec.multiply_wide_size) (m : Memory.Mem.mem)
         (ma : Memory.Mem.mem') (mc mr mr2 mr3 mr4 me mf : Memory.Mem.mem) (bl bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (r t u v : Integers.Int64.int) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mc
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader (jet_multiply_wide_exec.multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader (jet_multiply_wide_exec.multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong t))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader (jet_multiply_wide_exec.multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr3
                (Values.Vlong u))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr3
                (@Ctypes.Internal Clight.function (jet_wide.wide_reader (jet_multiply_wide_exec.multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr4
                (Values.Vlong v))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr4
                (@Ctypes.Internal Clight.function
                   (jet_wide.wide_writer (jet_multiply_wide_exec.multiply_output_size s)))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (full_multiply_value r t u v)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function (wide_full_multiply s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_full_multiply_wide_exec.full_multiply_value
full_multiply_value =
fun r t u v : Integers.Int64.int => Integers.Int64.add (Integers.Int64.add (Integers.Int64.mul r t) u) v
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       Integers.Int64.int

Arguments full_multiply_value r t u v
### C.jet_full_multiply_wide_exec.full_multiply_expr
full_multiply_expr =
Clight.Ebinop Cop.Oadd
  (Clight.Ebinop Cop.Oadd
     (Clight.Ebinop Cop.Omul (Clight.Etempvar jets._x Ctypesdefs.tulong) (Clight.Etempvar jets._y Ctypesdefs.tulong)
        Ctypesdefs.tulong) (Clight.Etempvar jets._z Ctypesdefs.tulong) Ctypesdefs.tulong)
  (Clight.Etempvar jets._w Ctypesdefs.tulong) Ctypesdefs.tulong
     : Clight.expr
### C.jet_full_multiply_wide_exec.wide_full_multiply
wide_full_multiply =
fun s : jet_multiply_wide_exec.multiply_wide_size =>
match s return Clight.function with
| jet_multiply_wide_exec.M16 => jets.f_simplicity_full_multiply_16
| jet_multiply_wide_exec.M32 => jets.f_simplicity_full_multiply_32
end
     : forall _ : jet_multiply_wide_exec.multiply_wide_size, Clight.function

Arguments wide_full_multiply s
### C.jet_full_multiply_wide_exec.wide_full_multiply_spec
wide_full_multiply_spec =
fun (s : jet_multiply_wide_exec.multiply_wide_size) (term : Alg.Core.Algebra) =>
match
  s as s0
  return
    (Alg.Core.domain term
       (Ty.Prod
          (Ty.Prod (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s0)))
             (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s0))))
          (Ty.Prod (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s0)))
             (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s0)))))
       (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_output_size s0))))
with
| jet_multiply_wide_exec.M16 => @Word.fullMultiplier (S (S (S (S O)))) term
| jet_multiply_wide_exec.M32 => @Word.fullMultiplier (S (S (S (S (S O))))) term
end
     : forall (s : jet_multiply_wide_exec.multiply_wide_size) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod
            (Ty.Prod (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))
               (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s))))
            (Ty.Prod (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))
               (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_input_size s)))))
         (Word.Word (jet_wide.wide_log (jet_multiply_wide_exec.multiply_output_size s)))

Arguments wide_full_multiply_spec s {term}
### C.jet_full_multiply_wide_exec.le_wide_full_multiply_x
le_wide_full_multiply_x =
fun (env : Values.val) (s : jet_multiply_wide_exec.multiply_wide_size) (bd : Values.block)
  (dofs : Integers.Ptrofs.int) (bs : Values.block) (sofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._x (Values.Vlong r)
  (@Maps.PTree.set Values.val jets._t'1 (Values.Vlong r)
     (jet_arith8_layout_exec.le_arith8_layout env (wide_full_multiply s) bd dofs bs sofs))
     : forall (_ : Values.val) (_ : jet_multiply_wide_exec.multiply_wide_size) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments le_wide_full_multiply_x env s bd dofs bs sofs r
