### C.jet_sx_zrep.zreg_load
zreg_load
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : jet_sx_state.layout)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (ρ n)))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (m : Memory.Mem.mem) (r : nat) (w : bool) (cs : list jet_sx_state.cell) (ofs : BinNums.Z)
         (_ : @eq bool (zreg_okb bnd ofs cs) true)
         (_ : @List.Forall jet_sx_state.cell (jet_sx_state.cell_ok ρ β m r w) cs),
       and
         (forall (i : nat) (z : BinNums.Z)
            (_ : @eq (option BinNums.Z) (@List.nth_error BinNums.Z (zcells (jet_sx_zval.zrho ρ) cs) i)
                   (@Some BinNums.Z z)),
          @eq (option Values.val)
            (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk β r)
               (BinInt.Z.add (jet_sx_state.bas β r)
                  (BinInt.Z.add ofs
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))))
            (@Some Values.val (Values.Vlong (Integers.Int64.repr z))))
         (Memory.Mem.range_perm m (jet_sx_state.blk β r) (BinInt.Z.add (jet_sx_state.bas β r) ofs)
            (BinInt.Z.add (BinInt.Z.add (jet_sx_state.bas β r) ofs)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                  (BinInt.Z.of_nat (@length jet_sx_state.cell cs)))) Memtype.Cur
            match w return Memtype.permission with
            | true => Memtype.Writable
            | false => Memtype.Readable
            end)
### C.jet_sx_zrep.zreg_okb
zreg_okb =
fix zreg_okb
  (bnd : forall _ : nat, prod BinNums.Z BinNums.Z) (ofs : BinNums.Z) (cs : list jet_sx_state.cell) {struct cs} :
    bool :=
  match cs return bool with
  | nil => true
  | cons c t =>
      andb
        (andb
           (andb (BinInt.Z.eqb (jet_sx_state.cofs c) ofs) (jet_sx_state.chunk_eqb (jet_sx_state.cchunk c) AST.Mint64))
           match jet_sx_state.cval c return bool with
           | Some x =>
               andb (jet_sx_expr.isk jet_sx_expr.KL x)
                 match jet_sx_zval.zb bnd x return bool with
                 | Some _ => true
                 | None => false
                 end
           | None => false
           end) (zreg_okb bnd (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) t)
  end
     : forall (_ : forall _ : nat, prod BinNums.Z BinNums.Z) (_ : BinNums.Z) (_ : list jet_sx_state.cell), bool

Arguments zreg_okb bnd%function_scope ofs%Z_scope cs%list_scope
### C.jet_sx_zrep.zcells
zcells =
fun (zρ : forall _ : nat, BinNums.Z) (cs : list jet_sx_state.cell) =>
@List.map jet_sx_state.cell BinNums.Z
  (fun c : jet_sx_state.cell =>
   match jet_sx_state.cval c return BinNums.Z with
   | Some x => jet_sx_zval.zval zρ x
   | None => BinNums.Z0
   end) cs
     : forall (_ : forall _ : nat, BinNums.Z) (_ : list jet_sx_state.cell), list BinNums.Z

Arguments zcells zρ%function_scope cs%list_scope
