### C.jet_sha256_init_zero_exec.eval_sha_ctx_local_field
eval_sha_ctx_local_field
     : forall (k : jet_sha256_context_fields.sha256_context_slot) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Clight.temp_env) (m : Memory.Mem.mem) (bc : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets.___compound e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets._sha256_context Ctypes.noattr)))),
       Clight.eval_lvalue jet_exec.ge0 e le m (sha_ctx_local_field k) bc
         (Integers.Ptrofs.repr (jet_sha256_context_fields.sha256_context_offset k)) Ctypes.Full
### C.jet_sha256_init_zero_exec.exec_sha_ctx_zero_store
exec_sha_ctx_zero_store
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bc : Values.block) (i : nat)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets.___compound e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))))
         (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint8unsigned m bc
                   (BinInt.Z.add (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.of_nat i)) (Values.Vint Integers.Int.zero)) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m (sha_ctx_zero_stmt i) Events.E0 le mf
         ClightBigstep.Out_normal
### C.jet_sha256_init_zero_exec.exec_sha_ctx_zero_prefix
exec_sha_ctx_zero_prefix
     : forall (prefix : Clight.statement) (n : nat) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le0 : Clight.temp_env) (m mp : Memory.Mem.mem) (bc : Values.block)
         (_ : le n (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets.___compound e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))))
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le0 m prefix Events.E0 le0 mp ClightBigstep.Out_normal)
         (_ : Memory.Mem.range_perm mp bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le0 m (sha_ctx_zero_prefix prefix n) Events.E0 le0 mf
               ClightBigstep.Out_normal)
            (and
               (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                  (_ : or (not (@eq Values.block b bc))
                         (or
                            (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                            (BinInt.Z.le
                               (BinInt.Z.add
                                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                  (BinInt.Z.of_nat n)) ofs))),
                @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk mp b ofs))
               (and
                  (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                     (_ : Memory.Mem.perm mp b ofs kind p), Memory.Mem.perm mf b ofs kind p)
                  (forall (b : Values.block) (_ : Memory.Mem.valid_block mp b), Memory.Mem.valid_block mf b))))
### C.jet_sha256_init_zero_exec.sha_ctx_local_field
sha_ctx_local_field =
fun k : jet_sha256_context_fields.sha256_context_slot =>
Clight.Efield (Clight.Evar jets.___compound (Ctypes.Tstruct jets._sha256_context Ctypes.noattr))
  (jet_sha256_context_fields.sha256_context_field k) (jet_sha256_context_fields.sha256_context_field_type k)
     : forall _ : jet_sha256_context_fields.sha256_context_slot, Clight.expr

Arguments sha_ctx_local_field k
### C.jet_sha256_init_zero_exec.sha_ctx_zero_stmt
sha_ctx_zero_stmt =
fun i : nat =>
Clight.Sassign
  (Clight.Ederef
     (Clight.Ebinop Cop.Oadd (sha_ctx_local_field jet_sha256_context_fields.CtxBlock)
        (Clight.Econst_int (Integers.Int.repr (BinInt.Z.of_nat i)) Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tuchar))
     Ctypesdefs.tuchar) (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
     : forall _ : nat, Clight.statement

Arguments sha_ctx_zero_stmt i%nat_scope
### C.jet_sha256_init_zero_exec.sha_ctx_zero_prefix
sha_ctx_zero_prefix =
fix sha_ctx_zero_prefix (prefix : Clight.statement) (n : nat) {struct n} : Clight.statement :=
  match n return Clight.statement with
  | O => prefix
  | S n0 => Clight.Ssequence (sha_ctx_zero_prefix prefix n0) (sha_ctx_zero_stmt n0)
  end
     : forall (_ : Clight.statement) (_ : nat), Clight.statement

Arguments sha_ctx_zero_prefix prefix n%nat_scope
