### C.jet_secp_split_half_numeric.split_half_of_balance
split_half_of_balance
     : forall (sg : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (hi lo : Ty.tySem (Word.Word (S (S (S (S (S (S (S O)))))))))
         (delta : BinNums.Z)
         (_ : and
                (BinInt.Z.lt
                   (BinInt.Z.opp
                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinNums.Zpos
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                   delta)
                (BinInt.Z.lt delta
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : @eq BinNums.Z
                (BinInt.Z.sub
                   (BinInt.Z.add
                      (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) hi)
                         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                            (BinNums.Zpos
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) lo))
                   (BinInt.Z.mul
                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinNums.Zpos
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                      (@Word.ToZ.Theory.toZ Word.BitToZ sg))) delta),
       @eq BinNums.Z
         (split_half_signed
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))) sg lo))
         delta
