### C.jet_secp_scalar_add_run.scalar_add_run_eq
scalar_add_run_eq
     : @eq (option jet_sx_exec.res) scalar_add_run (@Some jet_sx_exec.res scalar_add_result)
### C.jet_secp_scalar_add_run.scalar_add_selected
scalar_add_selected
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (prod jet_sx_eval.sstate jet_sx_exec.xout) (jet_sx_exec.rsel rho beta scalar_add_result)
         (@pair jet_sx_eval.sstate jet_sx_exec.xout scalar_add_state jet_sx_exec.ONormal)
### C.jet_secp_scalar_add_run.scalar_add_return
scalar_add_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_add_state))
         (@Some jet_sx_expr.sx scalar_add_return_sx)
### C.jet_secp_scalar_add_run.scalar_add_output_shape
scalar_add_output_shape
     : @ex (list jet_sx_expr.sx)
         (fun limbs : list jet_sx_expr.sx =>
          and (@eq nat (@length jet_sx_expr.sx limbs) (S (S (S (S O)))))
            (@eq (list jet_sx_state.region) (jet_sx_eval.sregs scalar_add_state)
               (@cons jet_sx_state.region
                  (jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 limbs) true
                     (@Some BinNums.Z
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (@cons jet_sx_state.region
                     (jet_sx_state.mkreg
                        (jet_sx_rep.u64_cells BinNums.Z0
                           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O)))))
                              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S O))))))
                                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
                                    (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S O))))))))
                                       (@nil jet_sx_expr.sx)))))) true
                        (@Some BinNums.Z
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (@nil jet_sx_state.region)))))
### C.jet_secp_scalar_add_run.scalar_add_caller_owned
scalar_add_caller_owned
     : and (@eq nat (@length jet_sx_state.region (jet_sx_eval.sregs scalar_add_state)) (S (S O)))
         (and
            (@eq (option BinNums.Z)
               (jet_sx_state.rfree
                  (@List.nth jet_sx_state.region O (jet_sx_eval.sregs scalar_add_state)
                     (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))))
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@eq (option BinNums.Z)
               (jet_sx_state.rfree
                  (@List.nth jet_sx_state.region (S O) (jet_sx_eval.sregs scalar_add_state)
                     (jet_sx_state.mkreg (@nil jet_sx_state.cell) false (@None BinNums.Z))))
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_scalar_add_run.scalar_add_initial_regs
scalar_add_initial_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells BinNums.Z0
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx)))))) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (jet_sx_rep.u64_cells BinNums.Z0
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S O)))))
              (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S O))))))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S O)))))))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S (S (S (S (S O)))))))) (@nil jet_sx_expr.sx))))))
        true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (@nil jet_sx_state.region))
     : list jet_sx_state.region
### C.jet_secp_scalar_add_run.scalar_add_run
scalar_add_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  jet_secp_shift64_executor.secp_shift64_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_scalar_add
  (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
     (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
        (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0) (@nil jet_sx_expr.sx)))) scalar_add_initial_regs
  (@nil jet_sx_eval.event) (S (S (S (S (S (S (S (S O))))))))
     : option jet_sx_exec.res
