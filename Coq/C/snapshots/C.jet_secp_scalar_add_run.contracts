### C.jet_secp_scalar_add_run.scalar_add_state
scalar_add_state =
match scalar_add_tree return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone state _ => state
    | jet_sx_exec.RIf _ a _ =>
        match a return jet_sx_eval.sstate with
        | jet_sx_exec.RDone state _ => state
        | jet_sx_exec.RIf _ _ _ =>
            jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
        end
    end
| None => jet_sx_eval.mkst (Maps.PTree.empty jet_sx_expr.sx) (@nil jet_sx_state.region) (@nil jet_sx_eval.event) O
end
     : jet_sx_eval.sstate
### C.jet_secp_scalar_add_run.scalar_add_condition
scalar_add_condition =
match scalar_add_tree return jet_sx_expr.sx with
| Some r =>
    match r return jet_sx_expr.sx with
    | jet_sx_exec.RDone _ _ => jet_sx_expr.XIc Integers.Int.zero
    | jet_sx_exec.RIf c _ _ => c
    end
| None => jet_sx_expr.XIc Integers.Int.zero
end
     : jet_sx_expr.sx
### C.jet_secp_scalar_add_run.scalar_add_result
scalar_add_result =
jet_sx_exec.RIf scalar_add_condition (jet_sx_exec.RDone scalar_add_state jet_sx_exec.ONormal)
  (jet_sx_exec.RDone scalar_add_state jet_sx_exec.ONormal)
     : jet_sx_exec.res
### C.jet_secp_scalar_add_run.scalar_add_return_sx
scalar_add_return_sx =
match @Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps scalar_add_state) return jet_sx_expr.sx with
| Some x => x
| None => jet_sx_expr.XV Values.Vundef
end
     : jet_sx_expr.sx
