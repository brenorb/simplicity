  (Clight.Ssequence (ih_uchar (BinNums.Zpos BinNums.xH))
     (ih_hash
        (Clight.Eaddrof
           (Clight.Efield
              (Clight.Ederef
                 (Clight.Etempvar jets_sha._input (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)))
                 (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)) jets_sha._annexHash
