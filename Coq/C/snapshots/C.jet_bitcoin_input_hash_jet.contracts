           (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))))) (ih_uchar BinNums.Z0)
     : Clight.statement
### C.jet_bitcoin_input_hash_jet.ih_then
ih_then =
Clight.Ssequence
  (Clight.Ssequence
     (Clight.Sset jets_sha._t'6
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_sha._env (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._txEnv Ctypes.noattr)))
              (Ctypes.Tstruct jets_sha._txEnv Ctypes.noattr)) jets_sha._tx
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._bitcoinTransaction Ctypes.noattr))))
     (Clight.Ssequence
        (Clight.Sset jets_sha._t'7
           (Clight.Efield
              (Clight.Ederef
                 (Clight.Etempvar jets_sha._t'6
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._bitcoinTransaction Ctypes.noattr)))
                 (Ctypes.Tstruct jets_sha._bitcoinTransaction Ctypes.noattr)) jets_sha._input
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr))))
        (Clight.Sset jets_sha._input
           (Clight.Ebinop Cop.Oadd
              (Clight.Etempvar jets_sha._t'7 (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)))
              (Clight.Etempvar jets_sha._i Ctypesdefs.tulong)
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr))))))
  (Clight.Ssequence
     (Clight.Ssequence
        (Clight.Scall (@None AST.ident) (Clight.Evar jets_sha._sha256_init jet_sha_tapdata_jet.init_ty)
           (@cons Clight.expr
              (Clight.Eaddrof (Clight.Evar jets_sha.__res (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
              (@cons Clight.expr
                 (Clight.Efield
                    (Clight.Evar jets_sha._midstate (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
                    jets_sha._s
                    (Ctypesdefs.tarray Ctypesdefs.tuint
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) (@nil Clight.expr))))
        (Clight.Sassign (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
           (Clight.Evar jets_sha.__res (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))))
     (Clight.Ssequence
        (ih_hash
           (Clight.Eaddrof
              (Clight.Efield
                 (Clight.Efield
                    (Clight.Ederef
                       (Clight.Etempvar jets_sha._input
                          (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)))
                       (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)) jets_sha._prevOutpoint
                    (Ctypes.Tstruct jets_sha._outpoint Ctypes.noattr)) jets_sha._txid
                 (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))))
        (Clight.Ssequence
           (Clight.Ssequence
              (Clight.Sset jets_sha._t'5
                 (Clight.Efield
                    (Clight.Efield
                       (Clight.Ederef
                          (Clight.Etempvar jets_sha._input
                             (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)))
                          (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)) jets_sha._prevOutpoint
                       (Ctypes.Tstruct jets_sha._outpoint Ctypes.noattr)) jets_sha._ix Ctypesdefs.tulong))
              (ih_u32 jets_sha._t'5))
           (Clight.Ssequence
              (Clight.Ssequence
                 (Clight.Sset jets_sha._t'4
                    (Clight.Efield
                       (Clight.Ederef
                          (Clight.Etempvar jets_sha._input
                             (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)))
                          (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)) jets_sha._sequence Ctypesdefs.tulong))
                 (ih_u32 jets_sha._t'4))
              (Clight.Ssequence
                 (Clight.Ssequence
                    (Clight.Sset jets_sha._t'3
                       (Clight.Efield
                          (Clight.Ederef
                             (Clight.Etempvar jets_sha._input
                                (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)))
                             (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)) jets_sha._hasAnnex Ctypesdefs.tbool))
                    ih_annex)
                 (Clight.Ssequence
                    (Clight.Scall (@None AST.ident)
                       (Clight.Evar jets_sha._sha256_finalize
                          (Ctypes.Tfunction
                             (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                                Ctypes.Tnil) Ctypesdefs.tbool AST.cc_default))
                       (@cons Clight.expr
                          (Clight.Eaddrof
                             (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                             (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
                          (@nil Clight.expr)))
                    (Clight.Scall (@None AST.ident)
                       (Clight.Evar jets_sha._writeHash
                          (Ctypes.Tfunction
                             (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
                                (Ctypes.Tcons
                                   (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
                                   Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
                       (@cons Clight.expr
                          (Clight.Etempvar jets_sha._dst
                             (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
                          (@cons Clight.expr
                             (Clight.Eaddrof
                                (Clight.Evar jets_sha._midstate
                                   (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
                                (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)))
                             (@nil Clight.expr))))))))))
     : Clight.statement
### C.jet_bitcoin_input_hash_jet.ih_else
ih_else =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_sha._skipBits
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Etempvar jets_sha._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Econst_int
           (Integers.Int.repr
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
           Ctypesdefs.tint) (@nil Clight.expr)))
     : Clight.statement
### C.jet_bitcoin_input_hash_jet.ih_has
ih_has =
fun ax : option Digest.hash256 => match ax return bool with
                                  | Some _ => true
                                  | None => false
                                  end
     : forall _ : option Digest.hash256, bool

Arguments ih_has ax
### C.jet_bitcoin_input_hash_jet.ih_annex_value
ih_annex_value =
fun ax : option Digest.hash256 =>
match ax return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) with
| Some h => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
end
     : forall _ : option Digest.hash256, Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments ih_annex_value ax
### C.jet_bitcoin_input_hash_jet.ih_cbytes
ih_cbytes =
fun (txid : Digest.hash256) (ix seq : Integers.Int.int) (ax : option Digest.hash256) =>
match ax return (list Integers.Int.int) with
| Some h =>
    @app Integers.Int.int
      (@app Integers.Int.int
         (@app Integers.Int.int
            (@app Integers.Int.int (jet_sha_be32_write.be_bytes (Digest.hash256_reg txid))
               (jet_sha_be32_write.c_be32_bytes (Integers.Int64.repr (Integers.Int.unsigned ix))))
            (jet_sha_be32_write.c_be32_bytes (Integers.Int64.repr (Integers.Int.unsigned seq))))
         (@cons Integers.Int.int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) (@nil Integers.Int.int)))
      (jet_sha_be32_write.be_bytes (Digest.hash256_reg h))
| None =>
    @app Integers.Int.int
      (@app Integers.Int.int
         (@app Integers.Int.int (jet_sha_be32_write.be_bytes (Digest.hash256_reg txid))
            (jet_sha_be32_write.c_be32_bytes (Integers.Int64.repr (Integers.Int.unsigned ix))))
         (jet_sha_be32_write.c_be32_bytes (Integers.Int64.repr (Integers.Int.unsigned seq))))
      (@cons Integers.Int.int (Integers.Int.repr BinNums.Z0) (@nil Integers.Int.int))
end
     : forall (_ : Digest.hash256) (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : option Digest.hash256),
       list Integers.Int.int

Arguments ih_cbytes txid ix seq ax
### C.jet_bitcoin_input_hash_jet.ih_elem_rep
ih_elem_rep =
fun (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (txi : Bitcoin.sigTxInput) (ax : option Digest.hash256)
=>
and
  (jet_uint32_array_init.uint32_array_at m b
     (BinInt.Z.add base
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (Digest.hash256_reg (Bitcoin.opHash (Bitcoin.sigTxiPreviousOutpoint txi))))
  (and
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m b
           (BinInt.Z.add base
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))
        (@Some Values.val
           (Values.Vlong
              (Integers.Int64.repr (Integers.Int.unsigned (Bitcoin.opIndex (Bitcoin.sigTxiPreviousOutpoint txi)))))))
     (and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint64 m b
              (BinInt.Z.add base
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
           (@Some Values.val (Values.Vlong (Integers.Int64.repr (Integers.Int.unsigned (Bitcoin.sigTxiSequence txi))))))
        (and
           (@eq (option Values.val)
              (Memory.Mem.load AST.Mint8unsigned m b
                 (BinInt.Z.add base
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
              (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int (ih_has ax)))))
           (forall (h : Digest.hash256) (_ : @eq (option Digest.hash256) ax (@Some Digest.hash256 h)),
            jet_uint32_array_init.uint32_array_at m b (BinInt.Z.add base BinNums.Z0) (Digest.hash256_reg h)))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Bitcoin.sigTxInput)
         (_ : option Digest.hash256), Prop

Arguments ih_elem_rep m b base%Z_scope txi ax
### C.jet_bitcoin_input_hash_jet.input_hash_rep
input_hash_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (e : jet_bitcoin_ext_prim.ext_environment)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Values.block
              (fun bin : Values.block =>
               @ex BinNums.Z
                 (fun inbase : BinNums.Z =>
                  @ex Integers.Int64.int
                    (fun nI : Integers.Int64.int =>
                     and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                       (and (BinInt.Z.le BinNums.Z0 ebase)
                          (and
                             (BinInt.Z.le
                                (BinInt.Z.add ebase
                                   (BinNums.Zpos
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                Integers.Ptrofs.max_unsigned)
                             (and (BinInt.Z.le BinNums.Z0 txbase)
                                (and
                                   (BinInt.Z.le
                                      (BinInt.Z.add txbase
                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))
                                      Integers.Ptrofs.max_unsigned)
                                   (and (BinInt.Z.le BinNums.Z0 inbase)
                                      (and
                                         (BinInt.Z.le
                                            (BinInt.Z.add inbase
                                               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (...)))
                                                  (BinInt.Z.of_nat (@length Bitcoin.sigTxInput (...)))))
                                            Integers.Ptrofs.max_unsigned)
                                         (and
                                            (@eq (option Values.val)
                                               (Memory.Mem.load AST.Mptr m be (BinInt.Z.add ebase BinNums.Z0))
                                               (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                                            (and
                                               (@eq (option Values.val)
                                                  (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add txbase BinNums.Z0))
                                                  (@Some Values.val (Values.Vptr bin (...))))
                                               (and
                                                  (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (...))
                                                     (@Some Values.val (...)))
                                                  (and (@eq BinNums.Z (...) (...)) (and (...) (...)))))))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_bitcoin_ext_prim.ext_environment)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments input_hash_rep m env e fp%list_scope
