### C.jet_secp_multiply_next_checkpoint.third_atomic_regs_exact
third_atomic_regs_exact
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (digits : forall _ : nat, Integers.Int64.int) (c d : prod Integers.Int64.int Integers.Int64.int)
