            (jet_secp_multiply_checkpoint_atomic.atomic_state rho beta
               (jet_secp_multiply_third_state.third_state digits c d t3 t4 tx)))
         (checkpoint_regs digits (written_r0 digits (jet_secp_multiply_third_values.third_r0_machine digits d tx))
            (jet_secp_multiply_third_values.third_final_c_machine digits d tx)
            (jet_secp_multiply_third_values.third_final_d_machine digits d))
### C.jet_secp_multiply_next_checkpoint.third_live_lookup
third_live_lookup
     : forall (digits : forall _ : nat, Integers.Int64.int) (c d : prod Integers.Int64.int Integers.Int64.int)
         (t3 t4 tx : Integers.Int64.int) (id : AST.ident) (x : jet_sx_expr.sx)
