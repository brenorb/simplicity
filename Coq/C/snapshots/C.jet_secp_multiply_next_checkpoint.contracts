                  (@cons jet_sx_expr.sx (jet_secp_multiply_third_state.third_r0_sy digits d tx)
                     (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S O)))
                        (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S O))))
                           (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S (S O)))))
                              (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S (S (S O)))))) (@nil jet_sx_expr.sx)))))))
               true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons jet_sx_state.region
               (jet_sx_state.mkreg
                  (jet_sx_rep.u64_cells BinNums.Z0
                     (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S (S (S (S O)))))))
                        (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S (S (S (S (S O))))))))
                           (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S (S (S (S (S (S O)))))))))
                              (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S (S (S (S (S (S (S O))))))))))
                                 (@cons jet_sx_expr.sx (jet_sx_expr.XL (digits (S (S (S (S (S (S (S (S (S O)))))))))))
                                    (@nil jet_sx_expr.sx))))))) true
                  (@Some BinNums.Z
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
               (@cons jet_sx_state.region
                  (jet_sx_state.mkreg
                     (jet_sx_rep.u64_cells BinNums.Z0
                        (@cons jet_sx_expr.sx
                           (@fst jet_sx_expr.sx jet_sx_expr.sx
                              (jet_secp_multiply_third_state.third_final_c_sy digits d tx))
                           (@cons jet_sx_expr.sx
                              (@snd jet_sx_expr.sx jet_sx_expr.sx
                                 (jet_secp_multiply_third_state.third_final_c_sy digits d tx))
                              (@nil jet_sx_expr.sx)))) true
                     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (@cons jet_sx_state.region
                     (jet_sx_state.mkreg
                        (jet_sx_rep.u64_cells BinNums.Z0
                           (@cons jet_sx_expr.sx
                              (@fst jet_sx_expr.sx jet_sx_expr.sx
                                 (jet_secp_multiply_third_state.third_final_d_sy digits d))
                              (@cons jet_sx_expr.sx
                                 (@snd jet_sx_expr.sx jet_sx_expr.sx
                                    (jet_secp_multiply_third_state.third_final_d_sy digits d))
                                 (@nil jet_sx_expr.sx)))) true
                        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
