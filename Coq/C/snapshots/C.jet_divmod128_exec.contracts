                (Memory.Mem.alloc mb BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block mc bql))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mc BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@pair Memory.Mem.mem' Values.block md br))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes md bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes md bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mcopy))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mcopy
                (@Ctypes.Internal Clight.function jets.f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr1
                (Values.Vlong ah))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr1
                (@Ctypes.Internal Clight.function jets.f_simplicity_read32)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong am))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                (@Ctypes.Internal Clight.function jets.f_simplicity_read32)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr3
                (Values.Vlong al))
         (_ : ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr3
                (@Ctypes.Internal Clight.function jets.f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr4
                (Values.Vlong b))
         (_ : ClightBigstep.Clight2.exec_stmt jet_exec.ge0 (jet_divmod128_entry.divmod128_env bl bqh bql br)
                (@Maps.PTree.set Values.val jets._t'5
                   (Values.Vint (jet_readBit_layout.bit_int (jet_divmod128_spec.divmod128_guard ah b)))
                   (divmod128_read_env (jet_divmod128_entry.divmod128_temps env bd dbase bs sbase) ah am al b)) mr4
                divmod128_branch_stmt Events.E0 lef me ClightBigstep.Out_normal)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free_list me
                   (Clight.blocks_of_env jet_exec.ge0 (jet_divmod128_entry.divmod128_env bl bqh bql br)))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
         (@Ctypes.Internal Clight.function jets.f_simplicity_div_mod_128_64)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
