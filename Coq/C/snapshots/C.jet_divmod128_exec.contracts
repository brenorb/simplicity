### C.jet_divmod128_exec.divmod128_valid_stmt
divmod128_valid_stmt =
Clight.Ssequence (jet_divmod128_entry.divmod128_helper_call jets._qh jets._ah jets._am)
  (Clight.Ssequence divmod128_valid_debug
     (Clight.Ssequence
        (Clight.Ssequence (Clight.Sset jets._t'9 (Clight.Evar jets._r Ctypesdefs.tulong))
           (jet_divmod128_entry.divmod128_helper_call jets._ql jets._t'9 jets._al))
        (Clight.Ssequence
           (Clight.Ssequence (Clight.Sset jets._t'8 (Clight.Evar jets._qh Ctypesdefs.tulong))
              (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write32 Ctypesdefs.tulong Ctypesdefs.tvoid
                 (Clight.Etempvar jets._t'8 Ctypesdefs.tulong)))
           (Clight.Ssequence
              (Clight.Ssequence (Clight.Sset jets._t'7 (Clight.Evar jets._ql Ctypesdefs.tulong))
                 (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write32 Ctypesdefs.tulong Ctypesdefs.tvoid
                    (Clight.Etempvar jets._t'7 Ctypesdefs.tulong)))
              (Clight.Ssequence (Clight.Sset jets._t'6 (Clight.Evar jets._r Ctypesdefs.tulong))
                 (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write64 Ctypesdefs.tulong Ctypesdefs.tvoid
                    (Clight.Etempvar jets._t'6 Ctypesdefs.tulong)))))))
     : Clight.statement
### C.jet_divmod128_exec.divmod128_invalid_expr
divmod128_invalid_expr =
Clight.Ecast (Clight.Eunop Cop.Oneg (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint)
  Ctypesdefs.tulong
     : Clight.expr
### C.jet_divmod128_exec.divmod128_invalid_stmt
divmod128_invalid_stmt =
Clight.Ssequence
  (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write64 Ctypesdefs.tulong Ctypesdefs.tvoid
     divmod128_invalid_expr)
  (jet_arith8_layout_exec.frame_writer_call jets._simplicity_write64 Ctypesdefs.tulong Ctypesdefs.tvoid
     divmod128_invalid_expr)
     : Clight.statement
### C.jet_divmod128_exec.divmod128_branch_stmt
divmod128_branch_stmt =
Clight.Sifthenelse (Clight.Etempvar jets._t'5 Ctypesdefs.tint) divmod128_valid_stmt divmod128_invalid_stmt
     : Clight.statement
### C.jet_divmod128_exec.divmod128_valid_env
divmod128_valid_env =
fun (le : Maps.PTree.tree Values.val) (r1 qh ql rf : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._t'6 (Values.Vlong rf)
  (@Maps.PTree.set Values.val jets._t'7 (Values.Vlong ql)
     (@Maps.PTree.set Values.val jets._t'8 (Values.Vlong qh)
        (@Maps.PTree.set Values.val jets._t'9 (Values.Vlong r1) le)))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments divmod128_valid_env le r1 qh ql rf
### C.jet_divmod128_exec.divmod128_read_set
