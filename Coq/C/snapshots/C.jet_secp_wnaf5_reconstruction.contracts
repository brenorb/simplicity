### C.jet_secp_wnaf5_reconstruction.secp_wnaf5_small_digit
secp_wnaf5_small_digit
     : forall (q : BinNums.Z)
         (_ : and (BinInt.Z.lt (BinNums.Zneg (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) q)
                (BinInt.Z.lt q (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))),
       @eq BinNums.Z
         (jet_secp_wnaf_digit.wnaf_digit
            (BinInt.Z.modulo q
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))) q
### C.jet_secp_wnaf5_reconstruction.secp_wnaf5_next_bound
