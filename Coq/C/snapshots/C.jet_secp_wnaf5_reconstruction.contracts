               (prod (sum unit unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S O))))))))))
               (sum unit
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S O))))) (@jet_secp_wnaf5_literal.literal_wnaf5_step Alg.CoreFunSem state)))
         (secp_wnaf5_next (secp_wnaf5_state_value state))
