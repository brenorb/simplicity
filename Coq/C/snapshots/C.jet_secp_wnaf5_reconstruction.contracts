     : forall (k : nat) (q : BinNums.Z)
         (_ : and
                (BinInt.Z.le
                   (BinInt.Z.opp (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat (S k)))) q)
                (BinInt.Z.le q (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat (S k))))),
       and
         (BinInt.Z.le (BinInt.Z.opp (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat k)))
            (secp_wnaf5_next q))
         (BinInt.Z.le (secp_wnaf5_next q) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat k)))
