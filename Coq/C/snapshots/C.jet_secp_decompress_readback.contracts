### C.jet_secp_decompress_readback.decompress_y_words_limbs
decompress_y_words_limbs
     : forall (w : forall _ : nat, Integers.Int64.int) (odd : bool),
       @eq (list Integers.Int64.int) (jet_secp_multiply_normalize_bridge.words5 (decompress_y_words w odd))
         (jet_secp_decompress_body.decompress_body_y w odd)
### C.jet_secp_decompress_readback.decompress_y_words_output
decompress_y_words_output
     : forall (w : forall _ : nat, Integers.Int64.int) (odd : bool),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (jet_secp_rescale_literal.rescale_field_output (decompress_y_words w odd))
         (jet_secp_point_write_field.point_field_output (jet_secp_decompress_output.decompress_y_field w odd))
### C.jet_secp_decompress_readback.decompress_y_words_bounds
decompress_y_words_bounds
     : forall (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (odd : bool) (_ : jet_secp_root_chain_numeric.root_words_match w x),
       jet_secp_square_columns.square_input_bounds (decompress_y_words w odd)
### C.jet_secp_decompress_readback.decompress_literal_point_curve
decompress_literal_point_curve
     : forall (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (ap : prod
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (_ : jet_secp_root_chain_numeric.root_words_match w x)
         (_ : @eq
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
                   (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      odd x))
                (@inr unit
                   (prod
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) ap)),
       @eq bool (Bit.toBool (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem ap)) true
### C.jet_secp_decompress_readback.decompress_retained_literal
decompress_retained_literal
     : forall (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (_ : jet_secp_root_chain_numeric.root_words_match w x),
       @eq
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) odd x))
         match
           jet_secp_root_check.root_check_flag (jet_secp_decompress_numeric.decompress_root_words w)
           return
             (Ty.tySem
                (Ty.Sum Ty.Unit
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | true =>
             @inr unit
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (jet_secp_rescale_literal.rescale_field_output w)
                  (jet_secp_rescale_literal.rescale_field_output (decompress_y_words w (Bit.toBool odd))))
         | false =>
             @inl unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
         end
### C.jet_secp_decompress_readback.eval_decompress_retained
eval_decompress_retained
     : forall (w : forall _ : nat, Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (odd : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (m : Memory.Mem.mem) (bx br : Values.block)
         (_ : not (@eq Values.block bx br)) (_ : jet_secp_root_chain_numeric.root_words_match w x)
         (_ : jet_secp_fe_nv.fe_at m bx BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_xo_var)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                     (@cons Values.val
                        (Values.Vint
                           match Bit.toBool odd return Integers.Int.int with
                           | true => Integers.Int.one
                           | false => Integers.Int.zero
                           end) (@nil Values.val)))) Events.E0 mf
               (Values.Vint (jet_secp_decompress_body.decompress_body_return w)))
            (and (jet_secp_fe_nv.fe_at mf br BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 w))
               (and
                  (jet_secp_fe_nv.fe_at mf br
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 (decompress_y_words w (Bit.toBool odd))))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf br
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and (jet_secp_square_columns.square_input_bounds (decompress_y_words w (Bit.toBool odd)))
                        (and
                           (@eq
                              (Ty.tySem
                                 (Ty.Sum Ty.Unit
                                    (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                       (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                              (@jet_secp_decompress_literal.literal_decompress Alg.CoreFunSem
                                 (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) odd x))
                              match
                                jet_secp_root_check.root_check_flag
                                  (jet_secp_decompress_numeric.decompress_root_words w)
                                return
                                  (Ty.tySem
                                     (Ty.Sum Ty.Unit
                                        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                           (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                              with
                              | true =>
                                  @inr unit
                                    (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                    (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (jet_secp_rescale_literal.rescale_field_output w)
                                       (jet_secp_rescale_literal.rescale_field_output
                                          (decompress_y_words w (Bit.toBool odd))))
                              | false =>
                                  @inl unit
                                    (prod
                                       ((fix tySem (X : Ty.Ty) : Set :=
                                           match X return Set with
                                           | Ty.Unit => unit
                                           | Ty.Sum A B => sum (tySem A) (tySem B)
                                           | Ty.Prod A B => prod (tySem A) (tySem B)
                                           end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       ((fix tySem (X : Ty.Ty) : Set :=
                                           match X return Set with
                                           | Ty.Unit => unit
                                           | Ty.Sum A B => sum (tySem A) (tySem B)
                                           | Ty.Prod A B => prod (tySem A) (tySem B)
                                           end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
                              end)
                           (and
                              (forall
                                 _ : @eq bool
                                       (jet_secp_root_check.root_check_flag
                                          (jet_secp_decompress_numeric.decompress_root_words w)) true,
                               @eq bool
                                 (Bit.toBool
                                    (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                                       (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                          (jet_secp_rescale_literal.rescale_field_output w)
                                          (jet_secp_rescale_literal.rescale_field_output
                                             (decompress_y_words w (Bit.toBool odd)))))) true)
                              (and
                                 (Memory.Mem.range_perm mf bx BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf br BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (jet_sx_mem.lframe
                                       (fun (b : Values.block) (_ : BinNums.Z) =>
                                        and (not (@eq Values.block b bx)) (not (@eq Values.block b br))) m mf))))))))))
### C.jet_secp_decompress_readback.decompress_readback_closed
decompress_readback_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_closed_helpers.secp_closed_helpers
            (Clight.fn_body jets_secp.f_secp256k1_ge_set_xo_var)) true
### C.jet_secp_decompress_readback.decompress_call_readonly
decompress_call_readonly
     : forall (m mf : Memory.Mem.mem) (args : list Values.val) (v : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_xo_var) args Events.E0 mf v),
       jet_clight_internal_preserve.readonly_preserved m mf
