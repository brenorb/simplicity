### C.jet_secp_div62_cancel.div62_updates_source
div62_updates_source
     : @eq Clight.statement div62_cancel_updates
         (Clight.Ssequence
            (Clight.Sset jets_secp._g
               (Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._g Ctypesdefs.tulong)
                  (Clight.Ebinop Cop.Omul (Clight.Etempvar jets_secp._f Ctypesdefs.tulong)
                     (Clight.Etempvar jets_secp._w Ctypesdefs.tuint) Ctypesdefs.tulong) Ctypesdefs.tulong))
            (Clight.Ssequence
               (Clight.Sset jets_secp._q
                  (Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._q Ctypesdefs.tulong)
                     (Clight.Ebinop Cop.Omul (Clight.Etempvar jets_secp._u Ctypesdefs.tulong)
                        (Clight.Etempvar jets_secp._w Ctypesdefs.tuint) Ctypesdefs.tulong) Ctypesdefs.tulong))
               (Clight.Ssequence
                  (Clight.Sset jets_secp._r
                     (Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._r Ctypesdefs.tulong)
                        (Clight.Ebinop Cop.Omul (Clight.Etempvar jets_secp._v Ctypesdefs.tulong)
                           (Clight.Etempvar jets_secp._w Ctypesdefs.tuint) Ctypesdefs.tulong) Ctypesdefs.tulong))
                  (Clight.Sloop Clight.Sskip Clight.Sbreak))))
### C.jet_secp_div62_cancel.exec_div62_noop
exec_div62_noop
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (Clight.Sloop Clight.Sskip Clight.Sbreak)
         Events.E0 le m ClightBigstep.Out_normal
### C.jet_secp_div62_cancel.div62_w6_source
div62_w6_source
     : @eq Clight.statement (div62_w_statement true)
         (Clight.Sset jets_secp._w
            (Clight.Ecast
               (Clight.Ebinop Cop.Oand
                  (Clight.Ebinop Cop.Omul
                     (Clight.Ebinop Cop.Omul (Clight.Etempvar jets_secp._f Ctypesdefs.tulong)
                        (Clight.Etempvar jets_secp._g Ctypesdefs.tulong) Ctypesdefs.tulong)
                     (Clight.Ebinop Cop.Osub
                        (Clight.Ebinop Cop.Omul (Clight.Etempvar jets_secp._f Ctypesdefs.tulong)
                           (Clight.Etempvar jets_secp._f Ctypesdefs.tulong) Ctypesdefs.tulong)
                        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))) Ctypesdefs.tint)
                        Ctypesdefs.tulong) Ctypesdefs.tulong) (Clight.Etempvar jets_secp._m Ctypesdefs.tulong)
                  Ctypesdefs.tulong) Ctypesdefs.tuint))
### C.jet_secp_div62_cancel.div62_w4_source
div62_w4_source
     : @eq Clight.statement (div62_w_statement false)
         (Clight.Ssequence
            (Clight.Sset jets_secp._w
               (Clight.Ecast
                  (Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._f Ctypesdefs.tulong)
                     (Clight.Ebinop Cop.Oshl
                        (Clight.Ebinop Cop.Oand
                           (Clight.Ebinop Cop.Oadd (Clight.Etempvar jets_secp._f Ctypesdefs.tulong)
                              (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
                              Ctypesdefs.tulong)
                           (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                              Ctypesdefs.tint) Ctypesdefs.tulong)
                        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
                        Ctypesdefs.tulong) Ctypesdefs.tulong) Ctypesdefs.tuint))
            (Clight.Sset jets_secp._w
               (Clight.Ecast
                  (Clight.Ebinop Cop.Oand
                     (Clight.Ebinop Cop.Omul
                        (Clight.Eunop Cop.Oneg (Clight.Etempvar jets_secp._w Ctypesdefs.tuint) Ctypesdefs.tuint)
                        (Clight.Etempvar jets_secp._g Ctypesdefs.tulong) Ctypesdefs.tulong)
                     (Clight.Etempvar jets_secp._m Ctypesdefs.tulong) Ctypesdefs.tulong) Ctypesdefs.tuint)))
### C.jet_secp_div62_cancel.exec_div62_w
exec_div62_w
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (neg : bool)
         (f g mask : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._f le) (@Some Values.val (Values.Vlong f)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._g le) (@Some Values.val (Values.Vlong g)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._m le)
                (@Some Values.val (Values.Vlong mask))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (div62_w_statement neg) Events.E0
         (@Maps.PTree.set Values.val jets_secp._w (Values.Vint (div62_w_word neg f g mask)) le) m
         ClightBigstep.Out_normal
### C.jet_secp_div62_cancel.exec_div62_updates
exec_div62_updates
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (f g u v q r : Integers.Int64.int) (w : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._f le) (@Some Values.val (Values.Vlong f)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._g le) (@Some Values.val (Values.Vlong g)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._u le) (@Some Values.val (Values.Vlong u)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._v le) (@Some Values.val (Values.Vlong v)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._q le) (@Some Values.val (Values.Vlong q)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._w le) (@Some Values.val (Values.Vint w))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m div62_cancel_updates Events.E0
         (@Maps.PTree.set Values.val jets_secp._r
            (Values.Vlong (Integers.Int64.add r (Integers.Int64.mul v (Integers.Int64.repr (Integers.Int.unsigned w)))))
            (@Maps.PTree.set Values.val jets_secp._q
               (Values.Vlong
                  (Integers.Int64.add q (Integers.Int64.mul u (Integers.Int64.repr (Integers.Int.unsigned w)))))
               (@Maps.PTree.set Values.val jets_secp._g
                  (Values.Vlong
                     (Integers.Int64.add g (Integers.Int64.mul f (Integers.Int64.repr (Integers.Int.unsigned w))))) le)))
         m ClightBigstep.Out_normal
### C.jet_secp_div62_cancel.div62_cancel_source
div62_cancel_source
     : forall neg : bool,
       @eq Clight.statement (div62_cancel_statement neg)
         match neg return Clight.statement with
         | true => Clight.Ssequence (div62_w_statement true) div62_cancel_updates
         | false =>
             match div62_w_statement false return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence a b => Clight.Ssequence a (Clight.Ssequence b div62_cancel_updates)
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         end
### C.jet_secp_div62_cancel.exec_div62_cancel
exec_div62_cancel
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (neg : bool)
         (f g u v q r mask : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._f le) (@Some Values.val (Values.Vlong f)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._g le) (@Some Values.val (Values.Vlong g)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._u le) (@Some Values.val (Values.Vlong u)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._v le) (@Some Values.val (Values.Vlong v)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._q le) (@Some Values.val (Values.Vlong q)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._m le)
                (@Some Values.val (Values.Vlong mask))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m (div62_cancel_statement neg) Events.E0
         (div62_cancel_temps le neg f g u v q r mask) m ClightBigstep.Out_normal
### C.jet_secp_div62_cancel.div62_cancel_temps_outside
div62_cancel_temps_outside
     : forall (le : Maps.PTree.tree Values.val) (neg : bool) (f g u v q r mask : Integers.Int64.int)
         (id : AST.ident)
         (_ : not
                (@List.In AST.ident id
                   (@cons AST.ident jets_secp._w
                      (@cons AST.ident jets_secp._g
                         (@cons AST.ident jets_secp._q (@cons AST.ident jets_secp._r (@nil AST.ident))))))),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (div62_cancel_temps le neg f g u v q r mask))
         (@Maps.PTree.get Values.val id le)
### C.jet_secp_div62_cancel.div62_cont_parts
div62_cont_parts =
jet_secp_statement_prefix.split_statement_last jet_secp_div62_count.div62_after_count_prefix
     : prod (list Clight.statement) Clight.statement
### C.jet_secp_div62_cancel.div62_eta_branch
div62_eta_branch =
@List.nth Clight.statement (S (S (S (S (S O))))) (@fst (list Clight.statement) Clight.statement div62_cont_parts)
  Clight.Sskip
     : Clight.statement
### C.jet_secp_div62_cancel.div62_eta_body
div62_eta_body =
fun neg : bool =>
match div62_eta_branch return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ a b => match neg return Clight.statement with
                              | true => a
                              | false => b
                              end
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : forall _ : bool, Clight.statement

Arguments div62_eta_body neg%bool_scope
### C.jet_secp_div62_cancel.div62_eta_parts
div62_eta_parts =
fun neg : bool => jet_secp_statement_prefix.split_statement_last (div62_eta_body neg)
     : forall _ : bool, prod (list Clight.statement) Clight.statement

Arguments div62_eta_parts neg%bool_scope
### C.jet_secp_div62_cancel.div62_cancel_updates
div62_cancel_updates =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement (S (S (S (S (S (S O))))))
     (@fst (list Clight.statement) Clight.statement div62_cont_parts))
  (@snd (list Clight.statement) Clight.statement div62_cont_parts)
     : Clight.statement
### C.jet_secp_div62_cancel.div62_w_statement
div62_w_statement =
fun neg : bool =>
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement
     match neg return nat with
     | true => S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
     | false => S (S (S O))
     end (@fst (list Clight.statement) Clight.statement (div62_eta_parts neg)))
  (@snd (list Clight.statement) Clight.statement (div62_eta_parts neg))
     : forall _ : bool, Clight.statement

Arguments div62_w_statement neg%bool_scope
### C.jet_secp_div62_cancel.div62_cancel_statement
div62_cancel_statement =
fun neg : bool =>
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement
     match neg return nat with
     | true => S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))
     | false => S (S (S O))
     end (@fst (list Clight.statement) Clight.statement (div62_eta_parts neg)))
  (Clight.Ssequence (@snd (list Clight.statement) Clight.statement (div62_eta_parts neg)) div62_cancel_updates)
     : forall _ : bool, Clight.statement

Arguments div62_cancel_statement neg%bool_scope
### C.jet_secp_div62_cancel.div62_w6
div62_w6 =
fun f g mask : Integers.Int64.int =>
Integers.Int64.loword
  (Integers.Int64.and
     (Integers.Int64.mul (Integers.Int64.mul f g)
        (Integers.Int64.sub (Integers.Int64.mul f f) (Integers.Int64.repr (BinNums.Zpos (BinNums.xO BinNums.xH)))))
     mask)
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int.int

Arguments div62_w6 f g mask
### C.jet_secp_div62_cancel.div62_w4_first
div62_w4_first =
fun f : Integers.Int64.int =>
Integers.Int64.loword
  (Integers.Int64.add f
     (Integers.Int64.shl
        (Integers.Int64.and (Integers.Int64.add f Integers.Int64.one)
           (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))) Integers.Int64.one))
     : forall _ : Integers.Int64.int, Integers.Int.int

Arguments div62_w4_first f
### C.jet_secp_div62_cancel.div62_w4
div62_w4 =
fun f g mask : Integers.Int64.int =>
Integers.Int64.loword
  (Integers.Int64.and
     (Integers.Int64.mul (Integers.Int64.repr (Integers.Int.unsigned (Integers.Int.neg (div62_w4_first f)))) g) mask)
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int.int

Arguments div62_w4 f g mask
### C.jet_secp_div62_cancel.div62_w_word
div62_w_word =
fun (neg : bool) (f g mask : Integers.Int64.int) =>
match neg return Integers.Int.int with
| true => div62_w6 f g mask
| false => div62_w4 f g mask
end
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int.int

Arguments div62_w_word neg%bool_scope f g mask
### C.jet_secp_div62_cancel.div62_w_long
div62_w_long =
fun (neg : bool) (f g mask : Integers.Int64.int) =>
Integers.Int64.repr (Integers.Int.unsigned (div62_w_word neg f g mask))
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments div62_w_long neg%bool_scope f g mask
### C.jet_secp_div62_cancel.div62_cancel_temps
div62_cancel_temps =
fun (le : Maps.PTree.tree Values.val) (neg : bool) (f g u v q r mask : Integers.Int64.int) =>
let w : Integers.Int64.int := div62_w_long neg f g mask in
@Maps.PTree.set Values.val jets_secp._r (Values.Vlong (Integers.Int64.add r (Integers.Int64.mul v w)))
  (@Maps.PTree.set Values.val jets_secp._q (Values.Vlong (Integers.Int64.add q (Integers.Int64.mul u w)))
     (@Maps.PTree.set Values.val jets_secp._g (Values.Vlong (Integers.Int64.add g (Integers.Int64.mul f w)))
        (@Maps.PTree.set Values.val jets_secp._w (Values.Vint (div62_w_word neg f g mask)) le)))
     : forall (_ : Maps.PTree.tree Values.val) (_ : bool) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments div62_cancel_temps le neg%bool_scope f g u v q r mask
