### C.jet_elements_taptweak_frame_read.eval_elements_taptweak_public_byte_read
eval_elements_taptweak_public_byte_read
     : forall (xs : list (Ty.tySem (Word.Word (S (S (S O)))))) (m : Memory.Mem.mem) (bo bf bi : Values.block)
         (edge cursor : BinNums.Z)
         (_ : BinInt.Z.le (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))) Integers.Int64.max_unsigned)
         (_ : not (@eq Values.block bo bf)) (_ : not (@eq Values.block bf bi)) (_ : not (@eq Values.block bo bi))
         (_ : Memory.Mem.range_perm m bo BinNums.Z0 (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_frame_layout.frame_fields_at m bf BinNums.Z0 bi edge cursor)
         (_ : jet_encoding.frame_input_cells_at m bi edge cursor
                (@List.concat BitMachine.Cell
                   (@List.map (Ty.tySem (Word.Word (S (S (S O))))) (list BitMachine.Cell)
                      (@Translate.encode (Word.Word (S (S (S O))))) xs))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets.f_read8s)
               (@cons Values.val (Values.Vptr bo Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vlong
                        (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))
                     (@cons Values.val (Values.Vptr bf Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_read8s_layout.uint8_array_at mf bo BinNums.Z0
                  (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
                     xs))
               (and
                  (jet_frame_layout.frame_fields_at mf bf BinNums.Z0 bi edge
                     (BinInt.Z.add cursor
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))))
                  (and (jet_clight_internal_permissions.keeps_permissions m mf)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bf)) (not (@eq Values.block b bo))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
