                   @eq (option Values.val) (Memory.Mem.load chunk mi bb ofs) (Memory.Mem.load chunk m bb ofs))
                  (and
                     (forall (bb : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
