literal_split_high_parametric
     : @Alg.Core.Parametric Ty.Unit (Word.Word (S (S (S (S (S (S (S O)))))))) (@literal_split_high)
### C.jet_secp_split_literal.literal_split_product_parametric
literal_split_product_parametric
     : forall first : bool,
       @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@literal_split_product first)
### C.jet_secp_split_literal.literal_split_second_parametric
literal_split_second_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O))))))))) literal_split_half (@literal_split_second)
### C.jet_secp_split_literal.literal_split_signed_scalar_parametric
literal_split_signed_scalar_parametric
     : @Alg.Core.Parametric literal_split_half (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@literal_split_signed_scalar)
### C.jet_secp_split_literal.literal_split_pack_half_parametric
literal_split_pack_half_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O))))))))) literal_split_half (@literal_split_pack_half)
### C.jet_secp_split_literal.literal_split_first_parametric
literal_split_first_parametric
     : @Alg.Core.Parametric (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) literal_split_half)
         literal_split_half (@literal_split_first)
### C.jet_secp_split_literal.literal_scalar_split_lambda_parametric
literal_scalar_split_lambda_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Ty.Prod literal_split_half literal_split_half) (@literal_scalar_split_lambda)
### C.jet_secp_split_literal.literal_scalar_split_lambda_step
literal_scalar_split_lambda_step
     : forall k : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Ty.Prod literal_split_half literal_split_half)) (@literal_scalar_split_lambda Alg.CoreFunSem k)
         (let normalized : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
            @jet_secp_canonical_scalar.canonical_scalar_normalize Alg.CoreFunSem k in
          let second : Ty.tySem literal_split_half := @literal_split_second Alg.CoreFunSem normalized in
          @pair (Ty.tySem literal_split_half) (Ty.tySem literal_split_half)
            (@literal_split_first Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem literal_split_half) normalized
                  second)) second)
### C.jet_secp_split_literal.literal_split_half
literal_split_half = Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S O))))))))
     : Ty.Ty
### C.jet_secp_split_literal.literal_split_basis_value
literal_split_basis_value =
fun first : bool =>
match first return BinNums.Z with
| true => jet_secp_split_constants.split_basis_value true
| false => jet_secp_split_signed_bounds.split_lattice_b2
end
     : forall _ : bool, BinNums.Z

Arguments literal_split_basis_value first%bool_scope
### C.jet_secp_split_literal.literal_split_basis_word
literal_split_basis_word =
fun first : bool =>
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S O)))))))) (literal_split_basis_value first)
     : forall _ : bool, Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S O)))))))))

Arguments literal_split_basis_word first%bool_scope
### C.jet_secp_split_literal.literal_split_high
literal_split_high =
fun term : Alg.Core.Algebra =>
@Word.fill Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))) term (@Bit.true Ty.Unit term)
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit (Word.Word (S (S (S (S (S (S (S O))))))))

Arguments literal_split_high {term}
