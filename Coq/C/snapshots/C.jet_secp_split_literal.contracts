           (@Alg.Core.Combinators.comp literal_split_half
              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
              (@Alg.Core.Combinators.pair literal_split_half (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) term (@literal_split_signed_scalar term)
                 (@Alg.Core.Combinators.comp literal_split_half Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
