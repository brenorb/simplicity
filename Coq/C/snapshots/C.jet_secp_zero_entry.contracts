### C.jet_secp_zero_entry.function_entry2_same_declarations
function_entry2_same_declarations
     : forall (ge : Clight.genv) (f g : Clight.function) (args : list Values.val) (m : Memory.Mem.mem)
         (e : Clight.env) (le : Clight.temp_env) (mf : Memory.Mem.mem)
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_vars f) (Clight.fn_vars g))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_params f) (Clight.fn_params g))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_temps f) (Clight.fn_temps g))
         (_ : Clight.function_entry2 ge f args m e le mf), Clight.function_entry2 ge g args m e le mf
### C.jet_secp_zero_entry.secp_fe_zero_entry
secp_fe_zero_entry
     : forall (v_env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem') (bl ba bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_simplicity_fe_is_zero
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val v_env (@nil Values.val))))
         m (jet_secp_public_copy.secp_public_env bl ba)
         (jet_secp_predicate_entry.secp_odd_temps v_env bd dbase bs sbase) mb
