### C.jet_elements_output_hash_spec.elements_output_hash_spec
elements_output_hash_spec =
fun alg : jet_elements_words_hash_program.EFP.Algebra =>
let term : Alg.Assertion.Algebra := jet_elements_words_hash_program.EFP.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_buffer_empty_spec.AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod
     (Ty.Sum Ty.Unit
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O))))))))))
     (Ty.Prod
        (Ty.Sum Ty.Unit
           (Ty.Sum Ty.Unit
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit
        (Ty.Prod
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O))))))))))
     (Ty.Prod
        (Ty.Sum Ty.Unit
           (Ty.Sum Ty.Unit
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
     (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
     (@jet_elements_amount_jets.elements_output_amount_spec alg)
     (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit
           (Ty.Sum Ty.Unit
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
        (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit
              (Ty.Sum Ty.Unit
                 (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) alg jet_elements_prim.Elements.OutputNonce)
        (@jet_buffer_empty_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
           (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg
              jet_elements_prim.Elements.OutputScriptHash)
           (@jet_elements_words_hash_program.EFP.Combinators.prim (Word.Word (S (S (S (S (S O))))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg
              jet_elements_prim.Elements.OutputRangeProof))))
  (@jet_buffer_empty_spec.AC.case Ty.Unit jet_elements_asset_amount_hash_spec.elements_asset_amount_type
     elements_output_hash_tail_type (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Alg.Assertion.toCore term)
