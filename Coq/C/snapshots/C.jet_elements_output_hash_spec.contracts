Arguments elements_output_hash_spec {alg}
### C.jet_elements_output_hash_spec.elements_output_hash_bytes
elements_output_hash_bytes =
fun (a : Ty.tySem jet_elements_asset_amount_hash_spec.elements_asset_amount_type)
  (n : Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type)
  (s r : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
@app (Ty.tySem (Word.Word (S (S (S O)))))
  (@app (Ty.tySem (Word.Word (S (S (S O)))))
     (@app (Ty.tySem (Word.Word (S (S (S O))))) (jet_elements_asset_amount_hash_spec.elements_asset_amount_bytes a)
        (jet_elements_nonce_hash_spec.elements_nonce_bytes n))
     (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) s))
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) r)
     : forall (_ : Ty.tySem jet_elements_asset_amount_hash_spec.elements_asset_amount_type)
         (_ : Ty.tySem jet_elements_nonce_hash_spec.elements_nonce_type)
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments elements_output_hash_bytes a n s r
### C.jet_elements_output_hash_spec.elements_output_hash_result
elements_output_hash_result =
fun (e : jet_elements_prim.Elements.env) (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error jet_elements_prim.txOutput (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx e))
    (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))
  return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
with
| Some txo =>
    @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Word.from_hash256
         (jet_bitcoin_composite_hash.sha256_bytes_of
            (elements_output_hash_bytes
               (@pair
                  (Ty.tySem
                     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem
                     (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Word.Word (S (S (S (S (S (S O)))))))))
                  (jet_elements_asset_jets.encode_asset
                     (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256
                        (jet_elements_prim.txoAsset txo)))
                  (jet_elements_amount_jets.encode_amount
                     (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int
                        (jet_elements_prim.txoAmount txo))))
               (jet_elements_asset_jets.encode_nonce (jet_elements_prim.txoNonce txo))
               (Word.from_hash256 (Digest.byteStringHash (jet_elements_prim.txoScript txo)))
               (Word.from_hash256
                  (Digest.byteStringHash
                     (@jet_elements_prim.viewPrf Integers.Int64.int (jet_elements_prim.txoAmount txo)))))))
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
end
     : forall (_ : jet_elements_prim.Elements.env) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments elements_output_hash_result e i
