### C.jet_elements_total_fee_numeric.fee_literal_amount
fee_literal_amount =
fun (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (o : jet_elements_prim.txOutput) =>
match jet_elements_prim.txoAsset o return Integers.Int64.int with
| jet_elements_prim.Explicit asset =>
    match jet_elements_prim.txoAmount o return Integers.Int64.int with
    | jet_elements_prim.Explicit v =>
        match
          andb (Bit.toBool (jet_elements_fee_literal.fee_script_hash_test o))
            (Bit.toBool
               (@jet_equality_spec.equality_spec (Word.Word (S (S (S (S (S (S (S (S O))))))))) Alg.CoreFunSem
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) key (Word.from_hash256 asset))))
          return Integers.Int64.int
        with
        | true => v
        | false => Integers.Int64.zero
        end
    | jet_elements_prim.Confidential _ _ => Integers.Int64.zero
    end
| jet_elements_prim.Confidential _ _ => Integers.Int64.zero
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : jet_elements_prim.txOutput),
       Integers.Int64.int

Arguments fee_literal_amount key o
### C.jet_elements_total_fee_numeric.fee_literal_sum
fee_literal_sum =
fun (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (environment : jet_elements_prim.Elements.env) =>
@List.fold_left Integers.Int64.int jet_elements_prim.txOutput
  (fun (total : Integers.Int64.int) (o : jet_elements_prim.txOutput) =>
   Integers.Int64.add total (fee_literal_amount key o))
  (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment)) Integers.Int64.zero
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : jet_elements_prim.Elements.env),
       Integers.Int64.int

Arguments fee_literal_sum key environment
