### C.jet_secp_modinv_fg_call.fg_call_storage
fg_call_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (len : nat)
         (m : Memory.Mem.mem) (_ : and (lt O len) (le len (S (S (S (S (S O)))))))
         (_ : jet_sx_state.rep rho beta (fg_call_out len) m) (high : bool) (j : nat) (_ : lt j len),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m
            (jet_sx_state.blk beta match high return nat with
                                   | true => S O
