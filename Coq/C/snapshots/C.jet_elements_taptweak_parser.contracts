### C.jet_elements_taptweak_parser.elements_taptweak_parser_vars_checked
elements_taptweak_parser_vars_checked
     : @eq bool
         (jet_transport.vars_okb jet_secp_linkage.secp_ge jet_elements_taptweak_pure.elements_taptweak_ge
            (Clight.fn_vars jets_secp.f_secp256k1_xonly_pubkey_parse)) true
### C.jet_elements_taptweak_parser.elements_taptweak_parser_sizes
elements_taptweak_parser_sizes
     : and
         (@eq BinNums.Z
            (Ctypes.sizeof (Clight.genv_cenv jet_elements_taptweak_pure.elements_taptweak_ge)
               jet_secp_curve_statements.curve_fe_type)
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
         (@eq BinNums.Z
            (Ctypes.sizeof (Clight.genv_cenv jet_elements_taptweak_pure.elements_taptweak_ge)
               jet_secp_curve_statements.curve_ge_type)
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
### C.jet_elements_taptweak_parser.elements_taptweak_parser_blocks
elements_taptweak_parser_blocks
     : forall bp bx : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_taptweak_pure.elements_taptweak_ge
            (jet_secp_xonly_parse_entry.xonly_parse_env bp bx))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bp BinNums.Z0)
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
### C.jet_elements_taptweak_parser.elements_taptweak_parser_entry_owned
elements_taptweak_parser_entry_owned
     : forall (m : Memory.Mem.mem) (key input : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bp : Values.block =>
             @ex Values.block
               (fun bx : Values.block =>
                and
                  (Clight.function_entry2 jet_elements_taptweak_pure.elements_taptweak_ge
                     jets_secp.f_secp256k1_xonly_pubkey_parse
                     (@cons Values.val key (@cons Values.val input (@nil Values.val))) m
                     (jet_secp_xonly_parse_entry.xonly_parse_env bp bx)
                     (jet_secp_xonly_parse_entry.xonly_parse_temps key input) mi)
                  (and (@List.NoDup Values.block (@cons Values.block bp (@cons Values.block bx (@nil Values.block))))
                     (and
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                         not
                           (@List.In Values.block b (@cons Values.block bp (@cons Values.block bx (@nil Values.block)))))
                        (and
                           (Memory.Mem.range_perm mi bp BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mi bx BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                                 (and (jet_clight_internal_permissions.keeps_permissions m mi)
                                    (jet_clight_internal_preserve.readonly_preserved m mi))))))))))
### C.jet_elements_taptweak_parser.exec_elements_taptweak_parser_body
exec_elements_taptweak_parser_body
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_memset_model.memset_model)
         (pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bp bx bout bin : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._pk e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp jet_secp_curve_statements.curve_ge_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._x e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx jet_secp_curve_statements.curve_fe_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._memset e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_set_b32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_set_xo_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_is_in_correct_subgroup e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_xonly_pubkey_save e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._pubkey le)
                (@Some Values.val (Values.Vptr bout Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._input32 le)
                (@Some Values.val (Values.Vptr bin Integers.Ptrofs.zero)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bp
                   (@cons Values.block bx (@cons Values.block bout (@cons Values.block bin (@nil Values.block))))))
         (_ : forall (b : Values.block) (hi : BinNums.Z)
                (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                       (@cons (prod Values.block BinNums.Z)
                          (@pair Values.block BinNums.Z bp
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                          (@cons (prod Values.block BinNums.Z)
                             (@pair Values.block BinNums.Z bx
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                             (@cons (prod Values.block BinNums.Z)
                                (@pair Values.block BinNums.Z bout
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                (@cons (prod Values.block BinNums.Z)
                                   (@pair Values.block BinNums.Z bin
                                      (BinNums.Zpos
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                   (@nil (prod Values.block BinNums.Z))))))),
              Memory.Mem.range_perm m b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bin BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes pk))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
                  (Clight.fn_body jets_secp.f_secp256k1_xonly_pubkey_parse) Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type (Values.Vint (jet_secp_xonly_parse_field.xonly_parse_result pk))
                           Ctypesdefs.tint))))
               (and (jet_secp_xonly_parse_field.xonly_parsed_result pk mf bout)
                  (and
                     (forall (b : Values.block) (hi : BinNums.Z)
                        (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                               (@cons (prod Values.block BinNums.Z)
                                  (@pair Values.block BinNums.Z bp
                                     (BinNums.Zpos
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                  (@cons (prod Values.block BinNums.Z)
                                     (@pair Values.block BinNums.Z bx
                                        (BinNums.Zpos
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                     (@cons (prod Values.block BinNums.Z)
                                        (@pair Values.block BinNums.Z bout
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                        (@cons (prod Values.block BinNums.Z)
                                           (@pair Values.block BinNums.Z bin
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                           (@nil (prod Values.block BinNums.Z))))))),
                      Memory.Mem.range_perm mf b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bp))
                              (and (not (@eq Values.block b bx))
                                 (and (not (@eq Values.block b bout)) (not (@eq Values.block b bin))))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
### C.jet_elements_taptweak_parser.eval_elements_taptweak_xonly_pubkey_parse_owned
eval_elements_taptweak_xonly_pubkey_parse_owned
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_memset_model.memset_model)
         (pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bout bin : Values.block) (_ : not (@eq Values.block bout bin))
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bin BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_read8s_layout.uint8_array_at m bin BinNums.Z0
                (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
                   (jet_secp_xonly_parse_field.xonly_input_bytes pk))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_xonly_pubkey_parse)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               (Values.Vint (jet_secp_xonly_parse_field.xonly_parse_result pk)))
            (and (jet_secp_xonly_parse_field.xonly_parsed_result pk mf bout)
               (and
                  (Memory.Mem.range_perm mf bout BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bin BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bout)) (not (@eq Values.block b bin))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
