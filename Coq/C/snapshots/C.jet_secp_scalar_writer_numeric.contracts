fun (bd : Values.block) (base : Integers.Ptrofs.int) =>
@List.hd jet_sx_eval.event (jet_sx_eval.mkev jet_secp_frame.tWR8 (S (S (S (S O)))) O (@nil jet_sx_expr.sx))
  (jet_sx_eval.slog
     (@fst jet_sx_eval.sstate jet_sx_exec.xout
        (jet_sx_exec.rsel (fun _ : nat => Integers.Int64.zero) jet_secp_frame.β0
           (jet_secp_scalar_writer_run.scalar_writer_result bd base))))
     : forall (_ : Values.block) (_ : Integers.Ptrofs.int), jet_sx_eval.event

Arguments scalar_writer_event bd base
