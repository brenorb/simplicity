### C.jet_outpoint_middle_common.op_none_encoding
op_none_encoding
     : @eq (list BitMachine.Cell)
         (@Translate.encode op_pegin_type
            (@inl unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     (let rec : Ty.Ty :=
                        let rec : Ty.Ty :=
                          let rec : Ty.Ty :=
                            let rec : Ty.Ty :=
                              let rec : Ty.Ty :=
                                let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                                Ty.Prod rec rec in
                              Ty.Prod rec rec in
                            Ty.Prod rec rec in
                          Ty.Prod rec rec in
                        Ty.Prod rec rec in
                      Ty.Prod rec rec))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     (let rec : Ty.Ty :=
                        let rec : Ty.Ty :=
                          let rec : Ty.Ty :=
                            let rec : Ty.Ty :=
                              let rec : Ty.Ty :=
                                let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                                Ty.Prod rec rec in
                              Ty.Prod rec rec in
                            Ty.Prod rec rec in
                          Ty.Prod rec rec in
                        Ty.Prod rec rec in
                      Ty.Prod rec rec))) tt))
         (@cons (option bool) (@Some bool false)
            (@List.repeat (option bool) (@None bool)
               (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))))
### C.jet_outpoint_middle_common.op_some_encoding
op_some_encoding
     : forall
         h : prod
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  (let rec : Ty.Ty :=
                     let rec : Ty.Ty :=
                       let rec : Ty.Ty :=
                         let rec : Ty.Ty :=
                           let rec : Ty.Ty :=
                             let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                             Ty.Prod rec rec in
                           Ty.Prod rec rec in
                         Ty.Prod rec rec in
                       Ty.Prod rec rec in
                     Ty.Prod rec rec in
                   Ty.Prod rec rec))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  (let rec : Ty.Ty :=
                     let rec : Ty.Ty :=
                       let rec : Ty.Ty :=
                         let rec : Ty.Ty :=
                           let rec : Ty.Ty :=
                             let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                             Ty.Prod rec rec in
                           Ty.Prod rec rec in
                         Ty.Prod rec rec in
                       Ty.Prod rec rec in
                     Ty.Prod rec rec in
                   Ty.Prod rec rec)),
       @eq (list BitMachine.Cell)
         (@Translate.encode op_pegin_type
            (@inr unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     (let rec : Ty.Ty :=
                        let rec : Ty.Ty :=
                          let rec : Ty.Ty :=
                            let rec : Ty.Ty :=
                              let rec : Ty.Ty :=
                                let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                                Ty.Prod rec rec in
                              Ty.Prod rec rec in
                            Ty.Prod rec rec in
                          Ty.Prod rec rec in
                        Ty.Prod rec rec in
                      Ty.Prod rec rec))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     (let rec : Ty.Ty :=
                        let rec : Ty.Ty :=
                          let rec : Ty.Ty :=
                            let rec : Ty.Ty :=
                              let rec : Ty.Ty :=
                                let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                                Ty.Prod rec rec in
                              Ty.Prod rec rec in
                            Ty.Prod rec rec in
                          Ty.Prod rec rec in
                        Ty.Prod rec rec in
                      Ty.Prod rec rec))) h))
         (@cons (option bool) (@Some bool true) (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) h))
### C.jet_outpoint_middle_common.op_bytes_length
op_bytes_length
     : forall a : Ty.tySem op_pegin_type,
       @eq BinNums.Z (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (op_bytes a))) (op_count a)
### C.jet_outpoint_middle_common.op_outpoint_bytes_length
op_outpoint_bytes_length
     : forall (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (ix : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq BinNums.Z (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (op_outpoint_bytes h ix)))
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
### C.jet_outpoint_middle_common.op_outpoint_encoding
op_outpoint_encoding
     : forall (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (ix : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq (list BitMachine.Cell)
         (@List.concat BitMachine.Cell
            (@List.map (Ty.tySem (Word.Word (S (S (S O))))) (list BitMachine.Cell)
               (@Translate.encode (Word.Word (S (S (S O))))) (op_outpoint_bytes h ix)))
         (@Translate.encode (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S O))))))) h ix))
### C.jet_outpoint_middle_common.op_full_bytes_length
op_full_bytes_length
     : forall (a : Ty.tySem op_pegin_type) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (ix : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq BinNums.Z (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (op_full_bytes a h ix)))
         (op_total_count a)
### C.jet_outpoint_middle_common.op_counter_one_then_32
op_counter_one_then_32
     : forall c : Integers.Int64.int,
       @eq Integers.Int64.int
         (Integers.Int64.add (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
            (Integers.Int64.repr
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (Integers.Int64.add c
            (Integers.Int64.repr
               (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
### C.jet_outpoint_middle_common.op_seq_normal_inv
op_seq_normal_inv
     : forall (ge : Clight.genv) (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (a b : Clight.statement) (le' : Clight.temp_env) (mf : Memory.Mem.mem)
         (_ : ClightBigstep.Clight2.exec_stmt ge e le m (Clight.Ssequence a b) Events.E0 le' mf
                ClightBigstep.Out_normal),
       @ex Clight.temp_env
         (fun le1 : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun m1 : Memory.Mem.mem =>
             and (ClightBigstep.Clight2.exec_stmt ge e le m a Events.E0 le1 m1 ClightBigstep.Out_normal)
               (ClightBigstep.Clight2.exec_stmt ge e le1 m1 b Events.E0 le' mf ClightBigstep.Out_normal)))
### C.jet_outpoint_middle_common.op_pegin_type
op_pegin_type = Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     : Ty.Ty
### C.jet_outpoint_middle_common.op_bytes
op_bytes =
fun a : Ty.tySem op_pegin_type =>
match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl _ =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) (jet_nonce_context_spec.nonce_byte BinNums.Z0)
      (@nil (Ty.tySem (Word.Word (S (S (S O))))))
| inr h =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) (jet_nonce_context_spec.nonce_byte (BinNums.Zpos BinNums.xH))
      (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
end
     : forall _ : Ty.tySem op_pegin_type, list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments op_bytes a
### C.jet_outpoint_middle_common.op_count
op_count =
fun a : Ty.tySem op_pegin_type =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos BinNums.xH
| inr _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
end
     : forall _ : Ty.tySem op_pegin_type, BinNums.Z

Arguments op_count a
### C.jet_outpoint_middle_common.op_bit
op_bit =
fun a : Ty.tySem op_pegin_type => match a return bool with
                                  | inl _ => false
                                  | inr _ => true
                                  end
     : forall _ : Ty.tySem op_pegin_type, bool

Arguments op_bit a
### C.jet_outpoint_middle_common.op_overflow
op_overflow =
fun (ovf : bool) (c : Integers.Int64.int) (a : Ty.tySem op_pegin_type) =>
match a return bool with
| inl _ => jet_elements_support_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH))
| inr _ =>
    jet_elements_support_sha_uchars_exec.uc_overflow
      (jet_elements_support_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
      (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
      (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
end
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Ty.tySem op_pegin_type), bool

Arguments op_overflow ovf%bool_scope c a
### C.jet_outpoint_middle_common.op_outpoint_bytes
op_outpoint_bytes =
fun (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (ix : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
@app (Ty.tySem (Word.Word (S (S (S O)))))
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
  (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S O)) ix)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))), list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments op_outpoint_bytes h ix
### C.jet_outpoint_middle_common.op_full_bytes
op_full_bytes =
fun (a : Ty.tySem op_pegin_type) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (ix : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
@app (Ty.tySem (Word.Word (S (S (S O))))) (op_bytes a) (op_outpoint_bytes h ix)
     : forall (_ : Ty.tySem op_pegin_type) (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))), list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments op_full_bytes a h ix
### C.jet_outpoint_middle_common.op_total_count
op_total_count =
fun a : Ty.tySem op_pegin_type =>
BinInt.Z.add (op_count a) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
     : forall _ : Ty.tySem op_pegin_type, BinNums.Z

Arguments op_total_count a
### C.jet_outpoint_middle_common.op_middle
op_middle =
Clight.Ssequence jet_outpoint_exec_shape.op_pegin
  (Clight.Ssequence
     (jet_outpoint_exec_shape.op_read
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
     (jet_outpoint_exec_shape.op_absorb
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
     : Clight.statement
