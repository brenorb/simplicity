### C.jet_output_cells_step.output_cells_last_word
output_cells_last_word
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (cells : list BitMachine.Cell)
         (_ : lt O (@length BitMachine.Cell cells)) (_ : jet_encoding.frame_output_cells_at m bw edge cursor cells),
       @ex Integers.Int64.int
         (fun w : Integers.Int64.int =>
          @eq (option Values.val)
            (Memory.Mem.load AST.Mint64 m bw
               (BinInt.Z.add edge
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                     (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (@length BitMachine.Cell cells)))
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
            (@Some Values.val (Values.Vlong w)))
### C.jet_output_cells_step.write_frame_at_after_cells
write_frame_at_after_cells
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (cells : list BitMachine.Cell) (tail : BinNums.Z)
         (_ : lt O (@length BitMachine.Cell cells)) (_ : BinInt.Z.le BinNums.Z0 tail)
         (_ : jet_output_layout.write_frame_at m bf base bw edge cursor
                (BinInt.Z.add (BinInt.Z.of_nat (@length BitMachine.Cell cells)) tail))
         (_ : jet_frame_layout.frame_fields_at mf bf base bw edge
                (BinInt.Z.sub cursor (BinInt.Z.of_nat (@length BitMachine.Cell cells))))
         (_ : jet_encoding.frame_output_cells_at mf bw edge cursor cells)
         (_ : jet_output_layout.loads_outside_ranges m mf bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                (BinInt.Z.add edge
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (@length BitMachine.Cell cells)))
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mf b ofs kind p),
       jet_output_layout.write_frame_at mf bf base bw edge
         (BinInt.Z.sub cursor (BinInt.Z.of_nat (@length BitMachine.Cell cells))) tail
