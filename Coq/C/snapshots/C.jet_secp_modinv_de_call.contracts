### C.jet_secp_modinv_de_call.eval_de_transition
eval_de_transition
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta jet_secp_modinv_de_exec.de62_regs m)
         (_ : forall high : bool, jet_secp_modinv_de_correction_numeric.de62_row_bound rho high)
         (_ : jet_secp_modinv_de_numeric.de62_state_bounds rho),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_update_de_62)
               (@cons Values.val
                  (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                           (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O)))))
                        (@cons Values.val
                           (Values.Vptr (jet_sx_state.blk beta (S (S (S O))))
                              (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S (S O))))))
                           (@nil Values.val))))) Events.E0 mf Values.Vundef)
            (and
               (forall (high : bool) (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf
                     (jet_sx_state.blk beta match high return nat with
                                            | true => S O
                                            | false => O
                                            end)
                     (BinInt.Z.add (jet_sx_state.bas beta match high return nat with
                                                          | true => S O
                                                          | false => O
                                                          end)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i))))
                  (@Some Values.val
                     (Values.Vlong (jet_secp_modinv_de_recurrence_words.de62_recurrence_word rho high i))))
               (and
                  (forall high : bool,
                   and
                     (@eq BinNums.Z
                        (BinInt.Z.mul
                           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                              (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                           (jet_secp_modinv_de_numeric.de62_output_value rho high))
                        (BinInt.Z.add (jet_secp_modinv_de_numeric.de62_matrix_value rho high)
                           (BinInt.Z.mul jet_secp_fe_math.feP
                              (jet_secp_modinv_de_correction_numeric.de62_correction_value rho high))))
                     (and
                        (@eq BinNums.Z (jet_secp_modinv_de_numeric.de62_output_value rho high)
                           (BinInt.Z.div
                              (BinInt.Z.add (jet_secp_modinv_de_numeric.de62_matrix_value rho high)
                                 (BinInt.Z.mul jet_secp_fe_math.feP
                                    (jet_secp_modinv_de_correction_numeric.de62_correction_value rho high)))
                              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.modulo
                                 (BinInt.Z.sub
                                    (BinInt.Z.mul
                                       (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                       (jet_secp_modinv_de_numeric.de62_output_value rho high))
                                    (jet_secp_modinv_de_numeric.de62_matrix_value rho high)) jet_secp_fe_math.feP)
                              BinNums.Z0)
                           (and
                              (jet_secp_modinv_normalize62_numeric.norm62_limb_bounds
                                 (jet_secp_modinv_de_recurrence_words.de62_recurrence_word rho high))
                              (and
                                 (BinInt.Z.lt
                                    (BinInt.Z.mul (BinNums.Zneg (BinNums.xO BinNums.xH)) jet_secp_fe_math.feP)
                                    (jet_secp_modinv_de_numeric.de62_output_value rho high))
                                 (BinInt.Z.lt (jet_secp_modinv_de_numeric.de62_output_value rho high)
                                    jet_secp_fe_math.feP))))))
                  (and (jet_sx_state.rep rho beta (jet_sx_eval.sregs jet_secp_modinv_de_exec.de62_state) mf)
                     (jet_sx_mem.lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (jet_sx_state.foot beta
                              (@List.map jet_sx_state.region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                 jet_sx_state.rshape jet_secp_modinv_de_exec.de62_regs) b ofs)) m mf)))))
