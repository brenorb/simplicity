### C.jet_secp_generate_small_group.secp_generator_positive_nonzero
secp_generator_positive_nonzero
     : forall (k : BinNums.Z)
         (_ : and (BinInt.Z.lt BinNums.Z0 k) (BinInt.Z.lt k jet_secp_canonical_scalar.canonical_group_order)),
       not
         (@eq jet_secp_curve_group_sign.secp_group_point
            (@EGroup.gpow jet_secp_curve_group_sign.secp_group_point
               (@SMain.add (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                  (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                  (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
                  (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                  jet_secp_curve_group.secp_group_seven jet_secp_curve_group.secp_group_zero_test
                  jet_secp_curve_group.secp_group_theory) jet_secp_curve_group_power.secp_group_generator
               jet_secp_curve_group.secp_curve_group k) jet_secp_curve_group_sign.secp_group_infinity)
### C.jet_secp_generate_small_group.secp_generator_signed_nonzero
secp_generator_signed_nonzero
     : forall (k : BinNums.Z)
         (_ : and (BinInt.Z.lt BinNums.Z0 (BinInt.Z.abs k))
                (BinInt.Z.lt (BinInt.Z.abs k) jet_secp_canonical_scalar.canonical_group_order)),
       not
         (@eq
            (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
               (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
            (jet_secp_lookup5_group.secp_group_signed_power jet_secp_curve_group_power.secp_group_generator k)
            jet_secp_curve_group_sign.secp_group_infinity)
### C.jet_secp_generate_small_group.secp_generator_signed_word_bounds
secp_generator_signed_word_bounds
     : forall (n : nat) (word : Ty.tySem (Word.Word n)),
       and
         (BinInt.Z.le (BinInt.Z.opp (jet_secp_generate_group.secp_generator_modulus n))
            (jet_secp_generate_group.secp_generator_signed_word n word))
         (BinInt.Z.lt (jet_secp_generate_group.secp_generator_signed_word n word)
            (jet_secp_generate_group.secp_generator_modulus n))
### C.jet_secp_generate_small_group.secp_generator_base_signed_action
secp_generator_base_signed_action
     : forall (second : bool) (k : BinNums.Z),
       @eq
         (@SMain.elt (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP)
            (GZnZ.mul jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP) jet_secp_curve_group.secp_group_seven)
         (jet_secp_lookup5_group.secp_group_signed_power
            (@EGroup.gpow jet_secp_curve_group_sign.secp_group_point
               (@SMain.add (GZnZ.znz jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                  (GZnZ.one jet_secp_fe_math.feP) (GZnZ.add jet_secp_fe_math.feP) (GZnZ.mul jet_secp_fe_math.feP)
                  (GZnZ.sub jet_secp_fe_math.feP) (GZnZ.opp jet_secp_fe_math.feP) (GZnZ.inv jet_secp_fe_math.feP)
                  (GZnZ.div jet_secp_fe_math.feP) (GZnZ.zero jet_secp_fe_math.feP)
                  jet_secp_curve_group.secp_group_seven jet_secp_curve_group.secp_group_zero_test
                  jet_secp_curve_group.secp_group_theory) jet_secp_curve_group_power.secp_group_generator
               jet_secp_curve_group.secp_curve_group
               match second return BinNums.Z with
               | true =>
                   BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
               | false => BinNums.Zpos BinNums.xH
               end) k)
         (jet_secp_lookup5_group.secp_group_signed_power jet_secp_curve_group_power.secp_group_generator
            (BinInt.Z.mul
               match second return BinNums.Z with
               | true =>
                   BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
               | false => BinNums.Zpos BinNums.xH
               end k))
### C.jet_secp_generate_small_group.secp_word_rep_finite_z
secp_word_rep_finite_z
     : forall (c : jet_secp_curve_group.secp_group_field)
         (x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : jet_secp_jacobian_word_group.secp_jacobian_word_rep c
                (@pair
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y) z) p)
         (_ : not (@eq jet_secp_curve_group_sign.secp_group_point p jet_secp_curve_group_sign.secp_group_infinity)),
       not
         (@eq jet_secp_curve_group.secp_group_field (jet_secp_field_word_group.secp_field_word z)
            (GZnZ.zero jet_secp_fe_math.feP))
### C.jet_secp_generate_small_group.secp_literal_generate_small_group
secp_literal_generate_small_group
     : forall (second : bool) (word : Ty.tySem (Word.Word (S (S (S (S O))))))
         (_ : not
                (@eq BinNums.Z (jet_secp_generate_group.secp_generator_signed_word (S (S (S (S O)))) word) BinNums.Z0)),
       jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
         (@jet_secp_generate_literal.literal_generate_small second Alg.CoreFunSem word)
         (jet_secp_lookup5_group.secp_group_signed_power jet_secp_curve_group_power.secp_group_generator
            (BinInt.Z.mul
               match second return BinNums.Z with
               | true =>
                   BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
               | false => BinNums.Zpos BinNums.xH
               end (jet_secp_generate_group.secp_generator_signed_word (S (S (S (S O)))) word)))
