### C.jet_bitcoin_build_tapleaf_spec.build_tapleaf_block_bytes
build_tapleaf_block_bytes
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list (Ty.tySem (Word.Word (S (S (S O))))))
         (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O))))))
            (@build_tapleaf_block Alg.CoreFunSem a))
         (@app (Ty.tySem (Word.Word (S (S (S O)))))
            (@cons (Ty.tySem (Word.Word (S (S (S O))))) tl_version
               (@cons (Ty.tySem (Word.Word (S (S (S O))))) jet_bitcoin_tapleaf_hash_spec.byte32
                  (@nil (Ty.tySem (Word.Word (S (S (S O))))))))
            (@app (Ty.tySem (Word.Word (S (S (S O)))))
               (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) a) tl_pad))
### C.jet_bitcoin_build_tapleaf_spec.build_tapleaf_spec_value
build_tapleaf_spec_value
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@build_tapleaf_spec Alg.CoreFunSem a)
         (@SHA256.hashBlock Alg.CoreFunSem
