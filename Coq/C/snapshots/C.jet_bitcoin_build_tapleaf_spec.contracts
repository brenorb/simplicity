### C.jet_bitcoin_build_tapleaf_spec.be_bytes_word
be_bytes_word
     : forall w : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
       @eq (list Integers.Int.int)
         (jet_sha_be32_write.c_be32_bytes
            (Integers.Int64.repr (Integers.Int.unsigned (jet_read32s_layout.word32_array_value w))))
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
            (jet_sha_ctx8_model.word_bytes w))
### C.jet_bitcoin_build_tapleaf_spec.be_bytes_words
be_bytes_words
     : forall ws : list (Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq (list Integers.Int.int)
         (jet_sha_be32_write.be_bytes
            (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int
               jet_read32s_layout.word32_array_value ws))
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
            (@List.flat_map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S O)))))
               jet_sha_ctx8_model.word_bytes ws))
### C.jet_bitcoin_build_tapleaf_spec.be_bytes_state_regs
be_bytes_state_regs
     : forall h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Integers.Int.int) (jet_sha_be32_write.be_bytes (jet_sha_ctx8_model.state_regs h))
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
            (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h))
### C.jet_bitcoin_build_tapleaf_spec.build_tapleaf_spec_parametric
build_tapleaf_spec_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
