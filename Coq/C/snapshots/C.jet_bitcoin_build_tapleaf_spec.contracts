### C.jet_bitcoin_build_tapleaf_spec.tl_version
tl_version =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O))))
  (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
     : Ty.tySem (Word.Word (S (S (S O))))
### C.jet_bitcoin_build_tapleaf_spec.tl_w8000
tl_w8000 =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S O)))))
  (BinNums.Zpos
     (BinNums.xO
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
