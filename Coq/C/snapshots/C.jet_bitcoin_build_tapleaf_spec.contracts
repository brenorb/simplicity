     : Ty.tySem (Word.Word (S (S (S (S (S (S (S O))))))))
### C.jet_bitcoin_build_tapleaf_spec.build_tapleaf_block
build_tapleaf_block =
fun term : Alg.Core.Algebra =>
@AC.comp (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
  (Ty.Prod (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
     (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))))
  (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
     (Ty.Prod
        (Ty.Prod
           (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
              (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
        (Word.Word (S (S (S (S (S (S (S O)))))))))) term
  (@AC.pair (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
     (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
     (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) term
     (@AC.comp (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) Ty.Unit
        (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) term
        (@AC.unit (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) term)
        (@AC.pair Ty.Unit (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))) term
           (@Alg.scribe Ty.Unit (Word.Word (S (S (S O)))) tl_version term)
           (@Alg.scribe Ty.Unit (Word.Word (S (S (S O)))) jet_bitcoin_tapleaf_hash_spec.byte32 term)))
     (@AC.iden (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) term))
  (@AC.comp (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))))
     (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
     (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
        (Ty.Prod
           (Ty.Prod
              (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
                 (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
           (Word.Word (S (S (S (S (S (S (S O)))))))))) term
     (@Word.full_right_shift1 (Word.Word (S (S (S (S O))))) (S (S (S (S O)))) term)
     (@AC.pair (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
        (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
        (Ty.Prod
           (Ty.Prod
              (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
                 (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
           (Word.Word (S (S (S (S (S (S (S O))))))))) term
        (@AC.take (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))
           (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) term
           (@AC.iden (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) term))
        (@AC.pair (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
           (Ty.Prod
              (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
                 (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
           (Word.Word (S (S (S (S (S (S (S O)))))))) term
           (@AC.pair
              (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
              (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
                 (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))) term
              (@AC.pair
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
                 (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
                 (Word.Word (S (S (S (S (S O)))))) term
                 (@AC.pair
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
                       (Word.Word (S (S (S (S O)))))) (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))) term
                    (@AC.drop (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
                       (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))) term
                       (@AC.iden (Word.Word (S (S (S (S O))))) term))
                    (@AC.comp
                       (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
                          (Word.Word (S (S (S (S O)))))) Ty.Unit (Word.Word (S (S (S (S O))))) term
                       (@AC.unit
                          (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
                             (Word.Word (S (S (S (S O)))))) term)
                       (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S O))))) tl_w8000 term)))
                 (@AC.comp
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
                       (Word.Word (S (S (S (S O)))))) Ty.Unit (Word.Word (S (S (S (S (S O)))))) term
                    (@AC.unit
                       (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
                          (Word.Word (S (S (S (S O)))))) term) (@Word.zero (S (S (S (S (S O))))) term)))
              (@AC.comp
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
                 Ty.Unit (Word.Word (S (S (S (S (S (S O))))))) term
                 (@AC.unit
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O)))))
                       (Word.Word (S (S (S (S O)))))) term) (@Word.zero (S (S (S (S (S (S O)))))) term)))
           (@AC.comp
              (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
              Ty.Unit (Word.Word (S (S (S (S (S (S (S O)))))))) term
              (@AC.unit
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S (S O))))) (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
                 term) (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S O)))))))) tl_len term)))))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Word.Word (S (S (S (S (S (S (S (S (S O))))))))))

Arguments build_tapleaf_block {term}
### C.jet_bitcoin_build_tapleaf_spec.build_tapleaf_spec
build_tapleaf_spec =
fun term : Alg.Core.Algebra =>
@AC.comp (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
  (@AC.pair (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) term
     (@AC.comp (Word.Word (S (S (S (S (S (S (S (S O))))))))) Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@AC.unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)
        (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) jet_bitcoin_tapleaf_hash_spec.tapleaf_prefix
           term)) (@build_tapleaf_block term)) (@SHA256.hashBlock term)
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments build_tapleaf_spec {term}
### C.jet_bitcoin_build_tapleaf_spec.tl_pad
tl_pad =
@List.map BinNums.Z (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S O))))))
  (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O)))))
  (@app BinNums.Z
     (@cons BinNums.Z
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        (@nil BinNums.Z))
     (@app BinNums.Z
        (@List.repeat BinNums.Z BinNums.Z0
           (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))
        (@cons BinNums.Z (BinNums.Zpos (BinNums.xI BinNums.xH))
           (@cons BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
              (@nil BinNums.Z)))))
     : list (Ty.tySem (Word.Word (S (S (S O)))))
