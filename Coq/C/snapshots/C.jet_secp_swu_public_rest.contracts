         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_write_ge) args Events.E0 mf Values.Vundef),
       jet_clight_internal_preserve.readonly_preserved m mf
### C.jet_secp_swu_public_rest.swu_output_encoding
swu_output_encoding
     : forall (x y : forall _ : nat, Integers.Int64.int)
         (result : Ty.tySem
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (_ : @eq
                (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (jet_secp_rescale_literal.rescale_field_output x) (jet_secp_rescale_literal.rescale_field_output y))
                result),
       @eq (list BitMachine.Cell)
         (@app BitMachine.Cell
            (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_rescale_literal.rescale_field_output x))
            (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
               (jet_secp_rescale_literal.rescale_field_output y)))
         (@Translate.encode
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            result)
### C.jet_secp_swu_public_rest.swu_literal_writer
swu_literal_writer
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (m : Memory.Mem.mem)
         (bp : Values.block) (x y : forall _ : nat, Integers.Int64.int)
         (result : Ty.tySem
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N) (_ : jet_frame_inv.finv m0 bd base bw edge cursor N bi m false (@nil BitMachine.Cell))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : @eq
                (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (jet_secp_rescale_literal.rescale_field_output x) (jet_secp_rescale_literal.rescale_field_output y))
                result),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_write_ge)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                  (@Translate.encode
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))) result))
               (and
                  (Memory.Mem.range_perm mf bp BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (jet_sx_mem.lframe
                     (fun (b : Values.block) (_ : BinNums.Z) =>
                      and (not (@eq Values.block b bp)) (not (jet_secp_frame.extA m0 bd bw bi b))) m mf))))
### C.jet_secp_swu_public_rest.eval_swu_map_write
eval_swu_map_write
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z)
         (t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (bt bp bl : Values.block)
         (_ : forall (mc : Memory.Mem.mem) (x : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned x) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong x) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))))
         (_ : jet_secp_swu_startup.swu_startup m) (_ : jet_output_layout.write_frame_at m0 bd base bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N)
         (_ : jet_secp_fe_nv.fe_at m bt BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho t)))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block bt bl)) (_ : not (@eq Values.block bp bl))
         (_ : not (@eq Values.block bt bp))
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bt BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))))
         (_ : jet_frame_inv.finv m0 bd base bw outedge cursor N bi m false (@nil BitMachine.Cell)),
       @ex Memory.Mem.mem
         (fun mn : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_shallue_van_de_woestijne)
                  (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mn
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mn
                     (@Ctypes.Internal Clight.function jets_secp.f_write_ge)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                        (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                     Values.Vundef)
                  (and
                     (jet_frame_inv.finv m0 bd base bw outedge cursor N bi mf true
                        (@Translate.encode
                           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                              (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem t)))
                     (and
                        (Memory.Mem.range_perm mf bt BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bp BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bl BinNums.Z0
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (jet_sx_mem.lframe
                                    (jet_secp_rescale_public_reads.rescale_locals_outside m0 bd bw bi bt bp bl) m mf)
                                 (and (jet_secp_swu_startup.swu_startup mf)
                                    (jet_clight_internal_preserve.readonly_preserved m mf))))))))))
