### C.jet_secp_swu_public_rest.swu_writer_closed
swu_writer_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_field_io_preserve.field_io_helpers
            (Clight.fn_body jets_secp.f_write_ge)) true
### C.jet_secp_swu_public_rest.swu_writer_readonly
swu_writer_readonly
