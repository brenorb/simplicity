### C.jet_secp_ge_zinv_factor.eval_ge_zinv_factor_square
eval_ge_zinv_factor_square
     : forall (point : bool) (zi : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem)
         (bo bf : Values.block) (_ : jet_secp_square_columns.square_input_bounds zi) (_ : not (@eq Values.block bo bf))
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bf (ge_zinv_factor_offset point) (jet_secp_multiply_normalize_bridge.words5 zi))
         (_ : Memory.Mem.range_perm m bf BinNums.Z0 (ge_zinv_factor_size point) Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
               (@cons Values.val (Values.Vptr bo Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr (ge_zinv_factor_offset point)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bo BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words zi)))
               (and
                  (Memory.Mem.range_perm mf bo BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (jet_secp_fe_nv.fe_at mf bf (ge_zinv_factor_offset point)
                        (jet_secp_multiply_normalize_bridge.words5 zi))
                     (and
                        (Memory.Mem.range_perm mf bf BinNums.Z0 (ge_zinv_factor_size point) Memtype.Cur
                           Memtype.Freeable)
                        (and (jet_secp_square_columns.square_input_bounds (jet_secp_square_numeric.square_words zi))
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (_ : BinNums.Z) =>
                               and (not (@eq Values.block b bo)) (not (@eq Values.block b bf))) m mf)))))))
### C.jet_secp_ge_zinv_factor.eval_ge_zinv_factor_cube
eval_ge_zinv_factor_cube
     : forall (point : bool) (a zi : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem)
         (bo ba bf : Values.block) (_ : jet_secp_square_columns.square_input_bounds a)
         (_ : jet_secp_square_columns.square_input_bounds zi) (_ : not (@eq Values.block bo ba))
         (_ : not (@eq Values.block bo bf)) (_ : not (@eq Values.block ba bf))
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bf (ge_zinv_factor_offset point) (jet_secp_multiply_normalize_bridge.words5 zi))
         (_ : Memory.Mem.range_perm m bf BinNums.Z0 (ge_zinv_factor_size point) Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val (Values.Vptr bo Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr (ge_zinv_factor_offset point)))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf bo BinNums.Z0
                  (jet_secp_multiply_normalize_bridge.words5 (jet_secp_point_mul_storage.point_mul_words a zi)))
               (and (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 a))
                  (and
                     (jet_secp_fe_nv.fe_at mf bf (ge_zinv_factor_offset point)
                        (jet_secp_multiply_normalize_bridge.words5 zi))
                     (and
                        (Memory.Mem.range_perm mf bo BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf ba BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bf BinNums.Z0 (ge_zinv_factor_size point) Memtype.Cur
                                 Memtype.Freeable)
                              (and
                                 (jet_secp_square_columns.square_input_bounds
                                    (jet_secp_point_mul_storage.point_mul_words a zi))
                                 (jet_sx_mem.lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b bo))
                                       (and (not (@eq Values.block b ba)) (not (@eq Values.block b bf)))) m mf)))))))))
### C.jet_secp_ge_zinv_factor.ge_zinv_factor_offset
ge_zinv_factor_offset =
fun point : bool =>
match point return BinNums.Z with
| true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
| false => BinNums.Z0
end
     : forall _ : bool, BinNums.Z

Arguments ge_zinv_factor_offset point%bool_scope
### C.jet_secp_ge_zinv_factor.ge_zinv_factor_size
ge_zinv_factor_size =
fun point : bool =>
match point return BinNums.Z with
| true =>
    BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
| false => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
end
     : forall _ : bool, BinNums.Z

Arguments ge_zinv_factor_size point%bool_scope
