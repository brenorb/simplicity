### C.jet_secp_mixed_y_tail.mixed_y_words
mixed_y_words =
fun t i g s : forall _ : nat, Integers.Int64.int =>
jet_secp_field_add_scaled.field_sum_words (jet_secp_point_mul_storage.point_mul_words t i)
  (jet_secp_field_pair_multiply.field_pair_product g s)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
         (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
