### C.jet_secp_mixed_y_tail.mixed_y_mul
mixed_y_mul =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._r jets_secp._y)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._t)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._i) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_mixed_y_tail.mixed_h3_s_mul
mixed_h3_s_mul =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h3)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h3)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._s1) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_mixed_y_tail.mixed_y_add
mixed_y_add =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_add jets_secp.f_secp256k1_fe_add
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._r jets_secp._y)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h3) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_mixed_y_tail.mixed_y_prefix
mixed_y_prefix =
@cons Clight.statement mixed_y_mul (@cons Clight.statement mixed_h3_s_mul (@nil Clight.statement))
     : list Clight.statement
### C.jet_secp_mixed_y_tail.mixed_y_frame
mixed_y_frame =
fun (bp bt bi bg bs bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bt))
  (and (not (@eq Values.block bx bi))
     (and (not (@eq Values.block bx bg))
        (and (not (@eq Values.block bx bs))
           (or (not (@eq Values.block bx bp))
              (or
                 (BinInt.Z.lt pos
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                 (BinInt.Z.le
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments mixed_y_frame bp bt bi bg bs bx pos%Z_scope
### C.jet_secp_mixed_y_tail.mixed_xy_frame
mixed_xy_frame =
fun (bp bi bg bt bs bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bi))
  (and (not (@eq Values.block bx bg))
     (and (not (@eq Values.block bx bt))
        (and (not (@eq Values.block bx bs))
           (or (not (@eq Values.block bx bp))
              (or (BinInt.Z.lt pos BinNums.Z0)
                 (BinInt.Z.le
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) pos))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments mixed_xy_frame bp bi bg bt bs bx pos%Z_scope
