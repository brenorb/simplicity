### C.jet_secp_point_three_general_writes.eval_point_three_general_writes
eval_point_three_general_writes
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (m : Memory.Mem.mem)
         (b : Values.block) (fx fy fz : jet_secp_point_write_field.point_field)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
                N) (_ : jet_frame_inv.finv m0 bd dbase bw edge cursor N bi m false (@nil BitMachine.Cell))
         (_ : jet_secp_point_write_field.point_field_bounds fx) (_ : jet_secp_point_write_field.point_field_bounds fy)
         (_ : jet_secp_point_write_field.point_field_bounds fz)
         (_ : jet_secp_fe_nv.fe_at m b BinNums.Z0 (jet_secp_point_write_field.point_field_limbs fx))
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_point_write_field.point_field_limbs fy))
         (_ : jet_secp_fe_nv.fe_at m b
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_point_write_field.point_field_limbs fz))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z)))),
       @ex Memory.Mem.mem
         (fun mx : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun my : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                     (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                        (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val)))
                     Events.E0 mx Values.Vundef)
                  (and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mx
                        (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                        (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                           (@cons Values.val
                              (Values.Vptr b
                                 (Integers.Ptrofs.repr
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                              (@nil Values.val))) Events.E0 my Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge my
                           (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                           (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                              (@cons Values.val
                                 (Values.Vptr b
                                    (Integers.Ptrofs.repr
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                                 (@nil Values.val))) Events.E0 mf Values.Vundef)
                        (and
                           (jet_frame_inv.finv m0 bd dbase bw edge cursor N bi mf true
                              (@app BitMachine.Cell
                                 (@app BitMachine.Cell
                                    (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                       (jet_secp_point_write_field.point_field_output fx))
                                    (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                       (jet_secp_point_write_field.point_field_output fy)))
                                 (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                    (jet_secp_point_write_field.point_field_output fz))))
                           (and
                              (Memory.Mem.range_perm mf b BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block bx b)) (not (jet_secp_frame.extA m0 bd bw bi bx))) m mf))))))))
