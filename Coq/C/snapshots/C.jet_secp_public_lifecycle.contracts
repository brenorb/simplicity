                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                 (jet_secp_wrapper_run.read_fe_rho
                                    (@jet_input_layout.frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value)
                                    rc) (@nil jet_sx_eval.event) mc)
                              (and
                                 (jet_sx_mem.lframe
