          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_public_copy.secp_public_env bl ba)
               (jet_secp_public_copy.secp_public_temps v_env bd dbase bs sbase) mb
               (Clight.Sassign (Clight.Evar jets_secp._src jet_secp_public_body.secp_frame_type)
                  (Clight.Etempvar jets_secp._src jet_secp_public_body.secp_frame_type)) Events.E0
               (jet_secp_public_copy.secp_public_temps v_env bd dbase bs sbase) mc ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mc ba BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mc bl BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                     Memtype.Freeable)
                  (and (jet_frame_layout.frame_fields_at mc bl BinNums.Z0 bi edge rc)
                     (and (not (@eq Values.block ba bl))
                        (and
                           (jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
