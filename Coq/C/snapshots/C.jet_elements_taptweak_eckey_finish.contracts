### C.jet_elements_taptweak_eckey_finish.elements_taptweak_affine_helper_linked
elements_taptweak_affine_helper_linked
     : @ex Values.block
         (fun b : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
                  (Clight.genv_genv jet_elements_taptweak_pure.elements_taptweak_ge)
                  jets_secp._secp256k1_ge_set_gej_var) (@Some Values.block b))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type
                  (Clight.genv_genv jet_elements_taptweak_pure.elements_taptweak_ge) b)
               (@Some (Ctypes.fundef Clight.function)
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_gej_var))))
### C.jet_elements_taptweak_eckey_finish.exec_elements_taptweak_eckey_guard
exec_elements_taptweak_eckey_guard
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bp : Values.block) (infinite : bool)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._pt e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_is_infinity e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int infinite)))),
       ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
         jet_secp_eckey_tweak_entry.eckey_tweak_guard Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint (jet_readBit_layout.bit_int infinite)) le) m
         match infinite return ClightBigstep.outcome with
         | true =>
             ClightBigstep.Out_return
               (@Some (prod Values.val Ctypes.type)
                  (@pair Values.val Ctypes.type (Values.Vint Integers.Int.zero) Ctypesdefs.tint))
         | false => ClightBigstep.Out_normal
         end
### C.jet_elements_taptweak_eckey_finish.exec_elements_taptweak_eckey_affine
exec_elements_taptweak_eckey_affine
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bp bk : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._pt e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._key le)
                (@Some Values.val (Values.Vptr bk Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_set_gej_var e)
                (@None (prod Values.block Ctypes.type)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_gej_var)
                (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
         jet_secp_eckey_tweak_entry.eckey_tweak_affine Events.E0 le mf ClightBigstep.Out_normal
### C.jet_elements_taptweak_eckey_finish.exec_elements_taptweak_eckey_finish
exec_elements_taptweak_eckey_finish
     : forall (_ : jet_ctz_model.ctz_model) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bp bk : Values.block)
         (x y z : forall _ : nat, Integers.Int64.int) (infinite : bool)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._pt e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bp (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._key le)
                (@Some Values.val (Values.Vptr bk Integers.Ptrofs.zero)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_is_infinity e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_ge_set_gej_var e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bp bk))
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 z))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int infinite))))
         (_ : jet_elements_taptweak_modinfo.elements_taptweak_modinfo_fe_state m)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bk BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
               jet_secp_eckey_tweak_entry.eckey_tweak_finish Events.E0
               (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint (jet_readBit_layout.bit_int infinite)) le) mf
               (ClightBigstep.Out_return
                  (@Some (prod Values.val Ctypes.type)
                     (@pair Values.val Ctypes.type (Values.Vint (jet_readBit_layout.bit_int (negb infinite)))
                        Ctypesdefs.tint))))
            (and (jet_secp_eckey_tweak_finish.eckey_tweak_affine_result infinite x y z mf bk)
               (and
                  (Memory.Mem.range_perm mf bp BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bk BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block b bp)) (not (@eq Values.block b bk))) m mf)
                        (jet_clight_internal_preserve.readonly_preserved m mf))))))
