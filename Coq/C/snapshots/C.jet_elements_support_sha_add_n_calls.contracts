### C.jet_elements_support_sha_add_n_calls.an_env
an_env =
fun bm bb bx : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._ctx
  (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._buf
     (@pair Values.block Ctypes.type bb
        (Ctypesdefs.tarray Ctypesdefs.tuchar
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_elements._midstate
        (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
        Clight.empty_env))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments an_env bm bb bx
### C.jet_elements_support_sha_add_n_calls.an_temps
an_temps =
fun (bd : Values.block) (dbase : BinNums.Z) (bsf : Values.block) (sbase : BinNums.Z) (vn : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_elements._n (Values.Vlong vn)
  (@Maps.PTree.set Values.val jets_elements._src (Values.Vptr bsf (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_elements._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_elements.f_sha_256_ctx_8_add_n))))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int),
       Clight.temp_env

Arguments an_temps bd dbase%Z_scope bsf sbase%Z_scope vn
