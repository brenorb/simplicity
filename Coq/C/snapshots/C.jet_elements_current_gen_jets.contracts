        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))
     (jet_elements_prim.utxoAmount (jet_elements_prim.sigTxiTxo txi)))
