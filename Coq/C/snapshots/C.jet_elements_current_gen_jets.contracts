### C.jet_elements_current_gen_jets.cur_elem
cur_elem =
fun t ip : AST.ident =>
Clight.Ederef
  (Clight.Ebinop Cop.Oadd (Clight.Etempvar t (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)))
     (Clight.Etempvar ip Ctypesdefs.tulong) (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)))
  (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)
     : forall (_ : AST.ident) (_ : AST.ident), Clight.expr

Arguments cur_elem t ip
### C.jet_elements_current_gen_jets.flag_hash_pexpr
flag_hash_pexpr =
fun hashfield : AST.ident =>
Clight.Eaddrof
  (Clight.Efield (cur_elem jets_elements._t'3 jets_elements._t'4) hashfield
     (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr))
     : forall _ : AST.ident, Clight.expr

Arguments flag_hash_pexpr hashfield
### C.jet_elements_current_gen_jets.flag_hash_body
flag_hash_body =
fun flagfield hashfield : AST.ident =>
Clight.Ssequence
  (jet_elements_current_gen.elements_current_load3 jets_elements._t'5 jets_elements._t'6 jets_elements._t'7
     jets_elements._input jets_elements._sigInput
     (Clight.Ssequence
        (Clight.Sset jets_elements._t'8
           (Clight.Efield (cur_elem jets_elements._t'6 jets_elements._t'7) flagfield Ctypesdefs.tbool))
        (Clight.Scall (@Some AST.ident jets_elements._t'1)
           (Clight.Evar jets_elements._writeBit
              (Ctypes.Tfunction
                 (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
                    (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
           (@cons Clight.expr
              (Clight.Etempvar jets_elements._dst
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
              (@cons Clight.expr (Clight.Etempvar jets_elements._t'8 Ctypesdefs.tbool) (@nil Clight.expr))))))
  (Clight.Sifthenelse (Clight.Etempvar jets_elements._t'1 Ctypesdefs.tbool)
     (jet_elements_current_gen.elements_current_load3 jets_elements._t'2 jets_elements._t'3 jets_elements._t'4
        jets_elements._input jets_elements._sigInput
        (jet_elements_current_gen.elements_ptr_call jets_elements._writeHash
           (Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr) (flag_hash_pexpr hashfield)))
     (jet_elements_indexed_scalar.elements_skip_stmt
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
     : forall (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments flag_hash_body flagfield hashfield
### C.jet_elements_current_gen_jets.flag_hash_tail
flag_hash_tail =
fun flagfield hashfield : AST.ident =>
Clight.Ssequence (flag_hash_body flagfield hashfield) jet_elements_current_gen.elements_return_one
     : forall (_ : AST.ident) (_ : AST.ident), Clight.statement

Arguments flag_hash_tail flagfield hashfield
### C.jet_elements_current_gen_jets.flag_bit
flag_bit =
fun b : bool => match b return Integers.Int.int with
                | true => Integers.Int.one
                | false => Integers.Int.zero
                end
     : forall _ : bool, Integers.Int.int

Arguments flag_bit b%bool_scope
### C.jet_elements_current_gen_jets.flag_hash_rep
flag_hash_rep =
fun (g : forall _ : jet_elements_prim.sigTxInput, option Digest.hash256) (foff hoff : BinNums.Z)
  (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (txi : jet_elements_prim.sigTxInput) =>
and
  (@eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m b (BinInt.Z.add ofs foff))
     (@Some Values.val (Values.Vint (flag_bit (@jet_elements_issuance_jets.opt_is_some Digest.hash256 (g txi))))))
  (forall (h : Digest.hash256) (_ : @eq (option Digest.hash256) (g txi) (@Some Digest.hash256 h)),
   jet_elements_hash_elem.hash_elem_rep m b (BinInt.Z.add ofs hoff) h)
     : forall (_ : forall _ : jet_elements_prim.sigTxInput, option Digest.hash256) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : jet_elements_prim.sigTxInput),
       Prop

Arguments flag_hash_rep g%function_scope (foff hoff)%Z_scope m b ofs%Z_scope txi
### C.jet_elements_current_gen_jets.flag_hash_cells
flag_hash_cells =
fun (g : forall _ : jet_elements_prim.sigTxInput, option Digest.hash256) (txi : jet_elements_prim.sigTxInput) =>
match g txi return (list BitMachine.Cell) with
| Some h =>
    @app (option bool) (@cons (option bool) (@Some bool true) (@nil (option bool)))
      (jet_elements_hash_write.hash_cells (Digest.hash256_reg h))
| None =>
    @app (option bool) (@cons (option bool) (@Some bool false) (@nil (option bool)))
      (@List.repeat (option bool) (@None bool)
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
end
     : forall (_ : forall _ : jet_elements_prim.sigTxInput, option Digest.hash256) (_ : jet_elements_prim.sigTxInput),
       list BitMachine.Cell

Arguments flag_hash_cells g%function_scope txi
