           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
     (jet_elements_prim.utxoAsset (jet_elements_prim.sigTxiTxo txi)))
