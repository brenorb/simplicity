                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI ...))))))))))
                                       (@conj
                                          (BinInt.Z.lt (BinNums.Zneg BinNums.xH)
                                             (BinNums.Zpos
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))
                                          (BinInt.Z.lt
