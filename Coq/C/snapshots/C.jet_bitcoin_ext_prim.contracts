                                                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))
                                                Integers.Int.modulus)))) (@nil Integers.Int.int)))))))))))
end
     : forall (A B : Ty.Ty) (_ : BitcoinExt.t A B), Digest.hash256

Arguments BitcoinExt.tag {A B}%ty_scope p
### C.jet_bitcoin_ext_prim.BitcoinExt.sem
BitcoinExt.sem =
fun (A B : Ty.Ty) (p : BitcoinExt.t A B) (a : Ty.tySem A) (e : BitcoinExt.env) =>
let cast : forall (C : Ty.Ty) (_ : option (Ty.tySem C)), Ty.tySem (Ty.Sum Ty.Unit C) :=
  fun (C : Ty.Ty) (x : option (Ty.tySem C)) =>
  match x return (Ty.tySem (Ty.Sum Ty.Unit C)) with
  | Some c => @inr unit (Ty.tySem C) c
  | None =>
      @inl unit
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
            | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
            end) C) tt
  end in
match p in (BitcoinExt.prim A0 B0) return (forall _ : Ty.tySem A0, option (Ty.tySem B0)) with
| BitcoinExt.CurrentIndex =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
         (BinInt.Z.of_nat (Bitcoin.Bitcoin.envIx (extBase e))))
| BitcoinExt.InputScriptHash =>
    fun i : Ty.tySem (Word.Word (S (S (S (S (S O)))))) =>
    @Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun h : Digest.hash256 => Word.from_hash256 h)
            (@List.nth_error Digest.hash256 (extInScriptHash e)
               (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i)))))
| BitcoinExt.InputAnnexHash =>
    fun i : Ty.tySem (Word.Word (S (S (S (S (S O)))))) =>
    @Some (sum unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
      match
        @List.nth_error (option Digest.hash256) (extInAnnexHash e)
          (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))
        return (sum unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
      with
      | Some o =>
          match o return (sum unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) with
          | Some h =>
              @inr unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                (@inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h))
          | None =>
              @inr unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                (@inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt)
          end
      | None => @inl unit (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
      end
| BitcoinExt.InputScriptSigHash =>
    fun i : Ty.tySem (Word.Word (S (S (S (S (S O)))))) =>
    @Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun h : Digest.hash256 => Word.from_hash256 h)
            (@List.nth_error Digest.hash256 (extInScriptSigHash e)
               (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i)))))
| BitcoinExt.TapleafVersion =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S O))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O)))) (extTapleafVersion e))
| BitcoinExt.Tappath =>
    fun i : Ty.tySem (Word.Word (S (S (S O)))) =>
    @Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun h : Digest.hash256 => Word.from_hash256 h)
            (@List.nth_error Digest.hash256 (extTappath e)
               (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) i)))))
| BitcoinExt.InternalKey =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 (extInternalKey e))
| BitcoinExt.TransactionId =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 (extTxid e))
end a
     : forall (A B : Ty.Ty) (_ : BitcoinExt.t A B) (_ : Ty.tySem A) (_ : BitcoinExt.env), option (Ty.tySem B)

Arguments BitcoinExt.sem {A B}%ty_scope p a e
