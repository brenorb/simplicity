                                 (BinInt.Z.compare (BinNums.Zneg BinNums.xH)
                                    (BinNums.Zpos
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI ...)))))))))))))
                              (@eq_refl comparison
                                 (BinInt.Z.compare
                                    (BinNums.Zpos
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI ...)))))))))))
                                    Integers.Int.modulus))))
                        (@cons Integers.Int.int
                           (Integers.Int.mkint
                              (BinNums.Zpos
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))
                              (@conj
                                 (BinInt.Z.lt (BinNums.Zneg BinNums.xH)
                                    (BinNums.Zpos
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO ...))))))))))))
                                 (BinInt.Z.lt
                                    (BinNums.Zpos
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO ...)))))))))))
                                    Integers.Int.modulus)
                                 (@eq_refl comparison
                                    (BinInt.Z.compare (BinNums.Zneg BinNums.xH)
                                       (BinNums.Zpos
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xI
                                                         (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI ...))))))))))))
                                 (@eq_refl comparison
                                    (BinInt.Z.compare
                                       (BinNums.Zpos
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xI
                                                         (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI ...))))))))))
                                       Integers.Int.modulus))))
                           (@cons Integers.Int.int
                              (Integers.Int.mkint
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))
                                 (@conj
                                    (BinInt.Z.lt (BinNums.Zneg BinNums.xH)
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO ...)))))))))))
                                    (BinInt.Z.lt
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO ...))))))))))
                                       Integers.Int.modulus)
                                    (@eq_refl comparison
                                       (BinInt.Z.compare (BinNums.Zneg BinNums.xH)
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI ...)))))))))))
                                    (@eq_refl comparison
                                       (BinInt.Z.compare
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI ...)))))))))
                                          Integers.Int.modulus))))
                              (@cons Integers.Int.int
                                 (Integers.Int.mkint
                                    (BinNums.Zpos
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI ...)))))))))))
                                    (@conj
                                       (BinInt.Z.lt (BinNums.Zneg BinNums.xH)
                                          (BinNums.Zpos
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))
                                       (BinInt.Z.lt
                                          (BinNums.Zpos
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))
                                          Integers.Int.modulus)
                                       (@eq_refl comparison
                                          (BinInt.Z.compare (BinNums.Zneg BinNums.xH)
                                             (BinNums.Zpos
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xI
                                                         (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO ...))))))))))
                                       (@eq_refl comparison
                                          (BinInt.Z.compare
                                             (BinNums.Zpos
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xI
                                                         (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO ...))))))))
                                             Integers.Int.modulus))))
                                 (@cons Integers.Int.int
                                    (Integers.Int.mkint
                                       (BinNums.Zpos
                                          (BinNums.xI
