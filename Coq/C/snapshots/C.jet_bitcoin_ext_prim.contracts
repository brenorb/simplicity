### C.jet_bitcoin_ext_prim.BitcoinExt.tag_def
BitcoinExt.tag_def =
fun (A B : Ty.Ty) (p : BitcoinExt.t A B) =>
let nm : String.string := @BitcoinExt.name A B p in
(fun p0 : BitcoinExt.t A B =>
 match
   p0 as p1 in (BitcoinExt.prim t t0) return (let nm0 : String.string := @BitcoinExt.name t t0 p1 in Digest.hash256)
 with
 | BitcoinExt.CurrentIndex =>
     let nm0 : String.string := @BitcoinExt.name Ty.Unit (Word.Word (S (S (S (S (S O)))))) BitcoinExt.CurrentIndex in
     MerkleRoot.tag
       (@app String.string (Primitive.primitivePrefix BitcoinExt.primName)
          (@cons String.string nm0 (@nil String.string)))
 | BitcoinExt.InputScriptHash =>
     let nm0 : String.string :=
       @BitcoinExt.name (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) BitcoinExt.InputScriptHash in
     MerkleRoot.tag
       (@app String.string (Primitive.primitivePrefix BitcoinExt.primName)
          (@cons String.string nm0 (@nil String.string)))
 | BitcoinExt.InputAnnexHash =>
     let nm0 : String.string :=
       @BitcoinExt.name (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) BitcoinExt.InputAnnexHash in
     MerkleRoot.tag
       (@app String.string (Primitive.primitivePrefix BitcoinExt.primName)
          (@cons String.string nm0 (@nil String.string)))
 | BitcoinExt.InputScriptSigHash =>
     let nm0 : String.string :=
       @BitcoinExt.name (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) BitcoinExt.InputScriptSigHash in
     MerkleRoot.tag
       (@app String.string (Primitive.primitivePrefix BitcoinExt.primName)
          (@cons String.string nm0 (@nil String.string)))
 | BitcoinExt.TapleafVersion =>
     let nm0 : String.string := @BitcoinExt.name Ty.Unit (Word.Word (S (S (S O)))) BitcoinExt.TapleafVersion in
     MerkleRoot.tag
       (@app String.string (Primitive.primitivePrefix BitcoinExt.primName)
          (@cons String.string nm0 (@nil String.string)))
 | BitcoinExt.Tappath =>
     let nm0 : String.string :=
       @BitcoinExt.name (Word.Word (S (S (S O)))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         BitcoinExt.Tappath in
     MerkleRoot.tag
       (@app String.string (Primitive.primitivePrefix BitcoinExt.primName)
          (@cons String.string nm0 (@nil String.string)))
 | BitcoinExt.InternalKey =>
     let nm0 : String.string :=
       @BitcoinExt.name Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) BitcoinExt.InternalKey in
     MerkleRoot.tag
       (@app String.string (Primitive.primitivePrefix BitcoinExt.primName)
          (@cons String.string nm0 (@nil String.string)))
 | BitcoinExt.TransactionId =>
     let nm0 : String.string :=
       @BitcoinExt.name Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) BitcoinExt.TransactionId in
     MerkleRoot.tag
       (@app String.string (Primitive.primitivePrefix BitcoinExt.primName)
          (@cons String.string nm0 (@nil String.string)))
 end) p
     : forall (A B : Ty.Ty) (_ : BitcoinExt.t A B), Digest.hash256

Arguments BitcoinExt.tag_def {A B}%ty_scope p
### C.jet_bitcoin_ext_prim.BitcoinExt.tag
BitcoinExt.tag =
fun (A B : Ty.Ty) (p : BitcoinExt.t A B) =>
match p in (BitcoinExt.prim H H0) return Digest.hash256 with
| BitcoinExt.CurrentIndex =>
    Digest.Hash256
      (@cons Integers.Int.int
         (Integers.Int.mkint
            (BinNums.Zpos
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xO
                        (BinNums.xI
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI ...)))))))))))))))))))
            (@conj
               (BinInt.Z.lt (BinNums.Zneg BinNums.xH)
                  (BinNums.Zpos
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xO
                              (BinNums.xI
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))
               (BinInt.Z.lt
                  (BinNums.Zpos
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xO
                              (BinNums.xI
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))
                  Integers.Int.modulus)
               (@eq_refl comparison
                  (BinInt.Z.compare (BinNums.Zneg BinNums.xH)
                     (BinNums.Zpos
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))
               (@eq_refl comparison
                  (BinInt.Z.compare
                     (BinNums.Zpos
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))
                     Integers.Int.modulus))))
         (@cons Integers.Int.int
            (Integers.Int.mkint
               (BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xI
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xO
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO ...))))))))))))))))))
               (@conj
                  (BinInt.Z.lt (BinNums.Zneg BinNums.xH)
                     (BinNums.Zpos
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xO
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xI
                                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO ...)))))))))))))))))
                  (BinInt.Z.lt
