### C.jet_bitcoin_ext_prim.bitcoin_ext_tag_def_canonical
@bitcoin_ext_tag_def_canonical
     : forall (A B : Ty.Ty) (p : BitcoinExt.t A B),
       @eq Digest.hash256 (@BitcoinExt.tag_def A B p)
         (MerkleRoot.tag
            (@app String.string
               (Primitive.primitivePrefix
                  (String.String (Ascii.Ascii false true false false false false true false)
                     (String.String (Ascii.Ascii true false false true false true true false)
                        (String.String (Ascii.Ascii false false true false true true true false)
                           (String.String (Ascii.Ascii true true false false false true true false)
                              (String.String (Ascii.Ascii true true true true false true true false)
                                 (String.String (Ascii.Ascii true false false true false true true false)
                                    (String.String (Ascii.Ascii false true true true false true true false)
                                       String.EmptyString))))))))
               (@cons String.string (@BitcoinExt.name A B p) (@nil String.string))))
### C.jet_bitcoin_ext_prim.bitcoin_ext_current_index_tag
bitcoin_ext_current_index_tag
     : @eq Digest.hash256 (@BitcoinExt.tag Ty.Unit (Word.Word (S (S (S (S (S O)))))) BitcoinExt.CurrentIndex)
         (@Bitcoin.Bitcoin.tag Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.CurrentIndex)
### C.jet_bitcoin_ext_prim.bitcoin_ext_current_index_sem
bitcoin_ext_current_index_sem
     : forall (e : ext_environment) (a : Ty.tySem Ty.Unit),
       @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (@BitcoinExt.sem Ty.Unit (Word.Word (S (S (S (S (S O)))))) BitcoinExt.CurrentIndex a e)
         (@Bitcoin.Bitcoin.sem Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.CurrentIndex a (extBase e))
### C.jet_bitcoin_ext_prim.ext_environment
Variant ext_environment : Set :=
    Build_ext_environment : forall (extBase : Bitcoin.Bitcoin.environment) (extInScriptHash : list Digest.hash256)
                              (extInAnnexHash : list (option Digest.hash256))
                              (extInScriptSigHash : list Digest.hash256) (extTapleafVersion : BinNums.Z)
                              (extTappath : list Digest.hash256) (_ : Digest.hash256) (_ : Digest.hash256)
                              (_ : @eq nat (@length Digest.hash256 extInScriptHash)
                                     (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx extBase))))
                              (_ : @eq nat (@length (option Digest.hash256) extInAnnexHash)
                                     (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx extBase))))
                              (_ : @eq nat (@length Digest.hash256 extInScriptSigHash)
                                     (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx extBase))))
                              (_ : and (BinInt.Z.le BinNums.Z0 extTapleafVersion)
                                     (BinInt.Z.lt extTapleafVersion
                                        (BinNums.Zpos
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                              (_ : le (@length Digest.hash256 extTappath)
                                     (S
                                        (S
                                           (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))),
                            ext_environment.

Arguments Build_ext_environment extBase (extInScriptHash extInAnnexHash extInScriptSigHash)%list_scope
  extTapleafVersion%Z_scope extTappath%list_scope extInternalKey extTxid extInScriptHash_len
  extInAnnexHash_len extInScriptSigHash_len extTapleafVersion_range extTappath_len
