### C.jet_secp_pubkey_load_function.eval_pubkey_load
eval_pubkey_load
     : forall (_ : jet_memcpy_model.memcpy_model) (w : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bin : Values.block) (base : BinNums.Z) (bout : Values.block)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_affine_storage.affine_storage_readable m bin base w),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_pubkey_load)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               (Values.Vint (jet_readBit_layout.bit_int (jet_secp_pubkey_load_body.pubkey_storage_accept w))))
            (and
               (forall k : bool,
                jet_secp_fe_nv.fe_at mf bout
                  match k return BinNums.Z with
                  | true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                  | false => BinNums.Z0
                  end (jet_secp_multiply_normalize_bridge.words5 (jet_secp_affine_storage.affine_storage_coord w k)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint32 mf bout
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@Some Values.val (Values.Vint Integers.Int.zero)))
                  (and
                     (Memory.Mem.range_perm mf bout BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m
                           mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))
### C.jet_secp_pubkey_load_function.xonly_pubkey_load_entry
xonly_pubkey_load_entry
     : forall (m : Memory.Mem.mem) (out key : Values.val),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_xonly_pubkey_load
         (@cons Values.val out (@cons Values.val key (@nil Values.val))) m Clight.empty_env
         (jet_secp_pubkey_load_entry.pubkey_load_temps out key) m
### C.jet_secp_pubkey_load_function.eval_xonly_pubkey_load
eval_xonly_pubkey_load
     : forall (_ : jet_memcpy_model.memcpy_model) (w : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bin : Values.block) (base : BinNums.Z) (bout : Values.block)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_affine_storage.affine_storage_readable m bin base w),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_xonly_pubkey_load)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               (Values.Vint (jet_readBit_layout.bit_int (jet_secp_pubkey_load_body.pubkey_storage_accept w))))
            (and
               (forall k : bool,
                jet_secp_fe_nv.fe_at mf bout
                  match k return BinNums.Z with
                  | true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                  | false => BinNums.Z0
                  end (jet_secp_multiply_normalize_bridge.words5 (jet_secp_affine_storage.affine_storage_coord w k)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint32 mf bout
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@Some Values.val (Values.Vint Integers.Int.zero)))
                  (and
                     (Memory.Mem.range_perm mf bout BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m
                           mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))
