### C.jet_secp_scalar_set_flag.scalar_flag_run_eq
scalar_flag_run_eq
     : @eq (option jet_sx_exec.res) scalar_flag_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone scalar_flag_state jet_sx_exec.ONormal))
### C.jet_secp_scalar_set_flag.scalar_flag_output_shape
scalar_flag_output_shape
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs scalar_flag_state)
         (@app jet_sx_state.region (jet_sx_eval.sregs jet_secp_scalar_set_b32_exec.scalar_set_state)
            (@cons jet_sx_state.region scalar_flag_region (@nil jet_sx_state.region)))
### C.jet_secp_scalar_set_flag.scalar_flag_pointer
scalar_flag_pointer
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx jets_secp._overflow (jet_sx_eval.stemps scalar_flag_state))
         (@Some jet_sx_expr.sx (jet_sx_expr.XP (S (S O)) BinNums.Z0))
### C.jet_secp_scalar_set_flag.scalar_flag_over
scalar_flag_over
     : @eq (option jet_sx_expr.sx)
         (@Maps.PTree.get jet_sx_expr.sx jets_secp._over (jet_sx_eval.stemps scalar_flag_state))
         (@Some jet_sx_expr.sx jet_secp_scalar_set_shape.scalar_set_flag)
### C.jet_secp_scalar_set_flag.scalar_flag_tmatch
scalar_flag_tmatch
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout),
       jet_sx_eval.tmatch rho layout scalar_flag_temps (scalar_flag_concrete_temps rho layout)
### C.jet_secp_scalar_set_flag.scalar_flag_entry
scalar_flag_entry
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : jet_sx_state.layout) (m : Memory.Mem.mem),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_scalar_set_b32
         (@List.map jet_sx_expr.sx Values.val (jet_sx_expr.den rho (jet_sx_state.lay layout))
            (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0)
               (@cons jet_sx_expr.sx (jet_sx_expr.XP (S O) BinNums.Z0)
                  (@cons jet_sx_expr.sx (jet_sx_expr.XP (S (S O)) BinNums.Z0) (@nil jet_sx_expr.sx))))) m
         Clight.empty_env (scalar_flag_concrete_temps rho layout) m
### C.jet_secp_scalar_set_flag.scalar_flag_initial_storage
scalar_flag_initial_storage
     : forall (bytes : list BinNums.Z) (b bb : Values.block) (ofs : BinNums.Z) (bf : Values.block)
         (m : Memory.Mem.mem)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun z : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 z)
                   (BinInt.Z.le z
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (_ : not (@eq Values.block b bb)) (_ : not (@eq Values.block bf b))
         (_ : not (@eq Values.block bf bb)) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Readable)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bb (BinInt.Z.add ofs (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i bytes BinNums.Z0))))),
       jet_sx_state.rep (jet_secp_b32_exec.byte_rho bytes)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb ofs)
               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bf BinNums.Z0)
                  (@nil (prod Values.block BinNums.Z))))) scalar_flag_regs m
### C.jet_secp_scalar_set_flag.scalar_flag_foot_outside
scalar_flag_foot_outside
     : forall (b bb : Values.block) (ofs : BinNums.Z) (bf block : Values.block) (pos : BinNums.Z)
         (_ : and (not (@eq Values.block block b))
                (and (not (@eq Values.block block bb)) (not (@eq Values.block block bf)))),
       not
         (jet_sx_state.foot
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb ofs)
                  (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bf BinNums.Z0)
                     (@nil (prod Values.block BinNums.Z)))))
            (@List.map jet_sx_state.region
               (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
               scalar_flag_regs) block pos)
### C.jet_secp_scalar_set_flag.eval_scalar_set_b32_flag_storage
eval_scalar_set_b32_flag_storage
     : forall (bytes : list BinNums.Z) (b bb : Values.block) (ofs : BinNums.Z) (bf : Values.block)
         (m : Memory.Mem.mem)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun z : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 z)
                   (BinInt.Z.le z
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (_ : not (@eq Values.block b bb)) (_ : not (@eq Values.block bf b))
         (_ : not (@eq Values.block bf bb)) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Readable)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bb (BinInt.Z.add ofs (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i bytes BinNums.Z0))))),
       let limbs : forall _ : nat, Integers.Int64.int :=
         jet_secp_scalar_set_shape.scalar_set_limb (jet_secp_b32_exec.byte_rho bytes)
           (jet_sx_state.lay
              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb ofs)
                    (@nil (prod Values.block BinNums.Z))))) in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_set_b32)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bb (Integers.Ptrofs.repr ofs))
                     (@cons Values.val (Values.Vptr bf Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf b
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                  (@Some Values.val (Values.Vlong (limbs i))))
               (and
                  (@eq (option Values.val) (Memory.Mem.load AST.Mint32 mf bf BinNums.Z0)
                     (@Some Values.val
                        (Values.Vint
                           (jet_sx_expr.b2i
                              (BinInt.Z.leb jet_secp_canonical_scalar.canonical_group_order
                                 (jet_secp_fe_math.be_val bytes))))))
                  (and
                     (@eq BinNums.Z (jet_secp_scalar_overflow_numeric.scalar_limb_value limbs)
                        (BinInt.Z.modulo (jet_secp_fe_math.be_val bytes)
                           jet_secp_canonical_scalar.canonical_group_order))
                     (and (jet_clight_internal_permissions.keeps_permissions m mf)
                        (and
                           (jet_sx_mem.lframe
                              (fun (block : Values.block) (_ : BinNums.Z) =>
                               and (not (@eq Values.block block b))
                                 (and (not (@eq Values.block block bb)) (not (@eq Values.block block bf)))) m mf)
                           (jet_clight_internal_preserve.readonly_preserved m mf)))))))
