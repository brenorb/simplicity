### C.jet_secp_beta_from_reader.eval_beta_from_reader_storage
eval_beta_from_reader_storage
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba : Values.block)
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of (jet_secp_multiply_input_input.normalized_value x))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_secp_beta_global.beta_initialized m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr jet_secp_beta_global.beta_block Integers.Ptrofs.zero)
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (jet_sx_state.rep (jet_secp_beta_inputs.beta_input_rho x)
                  (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                     (@cons (prod Values.block BinNums.Z)
                        (@pair Values.block BinNums.Z jet_secp_beta_global.beta_block BinNums.Z0)
                        (@nil (prod Values.block BinNums.Z))))
                  (jet_secp_multiply_borrowed_call.borrowed_output_regs (jet_secp_beta_inputs.beta_input_rho x)) mf)
               (and
                  (jet_secp_multiply_finish_execute.output_words
                     (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                        (@cons (prod Values.block BinNums.Z)
                           (@pair Values.block BinNums.Z jet_secp_beta_global.beta_block BinNums.Z0)
                           (@nil (prod Values.block BinNums.Z))))
                     (jet_secp_multiply_finish_execute.original_finish_words (jet_secp_beta_inputs.beta_input_rho x))
                     mf)
                  (and
                     (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (jet_secp_write_fe_wide_exec.wide_fe_output
                           (jet_secp_multiply_finish_execute.original_finish_words
                              (jet_secp_beta_inputs.beta_input_rho x) O)
                           (jet_secp_multiply_finish_execute.original_finish_words
                              (jet_secp_beta_inputs.beta_input_rho x) (S O))
                           (jet_secp_multiply_finish_execute.original_finish_words
                              (jet_secp_beta_inputs.beta_input_rho x) (S (S O)))
                           (jet_secp_multiply_finish_execute.original_finish_words
                              (jet_secp_beta_inputs.beta_input_rho x) (S (S (S O))))
                           (jet_secp_multiply_finish_execute.original_finish_words
                              (jet_secp_beta_inputs.beta_input_rho x) (S (S (S (S O))))))
                        (@jet_secp_beta_spec.literal_fe_multiply_beta Alg.CoreFunSem x))
                     (and
                        (forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
                         and
                           (BinInt.Z.le BinNums.Z0
                              (Integers.Int64.unsigned
                                 (jet_secp_multiply_finish_execute.original_finish_words
                                    (jet_secp_beta_inputs.beta_input_rho x) i)))
                           (BinInt.Z.lt
                              (Integers.Int64.unsigned
                                 (jet_secp_multiply_finish_execute.original_finish_words
                                    (jet_secp_beta_inputs.beta_input_rho x) i))
                              match PeanoNat.Nat.eqb i (S (S (S (S O)))) return BinNums.Z with
                              | true =>
                                  BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))
                              | false =>
                                  BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))
                              end))
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z)
                                       (@pair Values.block BinNums.Z jet_secp_beta_global.beta_block BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))))
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape jet_secp_multiply_borrowed_call.borrowed_mul_regs) b ofs)) m mf))))))
