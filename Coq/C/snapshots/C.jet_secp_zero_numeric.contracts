### C.jet_secp_zero_numeric.int64_or_zero_iff
int64_or_zero_iff
     : forall x y : Integers.Int64.int,
       iff (@eq Integers.Int64.int (Integers.Int64.or x y) Integers.Int64.zero)
         (and (@eq Integers.Int64.int x Integers.Int64.zero) (@eq Integers.Int64.int y Integers.Int64.zero))
### C.jet_secp_zero_numeric.int64_or_zero_bool
int64_or_zero_bool
     : forall x y : Integers.Int64.int,
       @eq bool (Integers.Int64.eq (Integers.Int64.or x y) Integers.Int64.zero)
         (andb (Integers.Int64.eq x Integers.Int64.zero) (Integers.Int64.eq y Integers.Int64.zero))
### C.jet_secp_zero_numeric.int64_repr_zero_bool
int64_repr_zero_bool
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value) (BinInt.Z.le value Integers.Int64.max_unsigned)),
       @eq bool (Integers.Int64.eq (Integers.Int64.repr value) Integers.Int64.zero) (BinInt.Z.eqb value BinNums.Z0)
### C.jet_secp_zero_numeric.field_or_canonical_zero
field_or_canonical_zero
     : forall (value rc : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq bool
         (Integers.Int64.eq (jet_secp_field_zero.field_or_value (jet_secp_write_fe_numeric.write_fe_rho value rc))
            Integers.Int64.zero) (BinInt.Z.eqb value BinNums.Z0)
