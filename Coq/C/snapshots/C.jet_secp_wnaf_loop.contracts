            (@Some (prod Values.val Ctypes.type)
               (@pair Values.val Ctypes.type
                  (Values.Vint (Integers.Int.repr (BinInt.Z.add last (BinNums.Zpos BinNums.xH)))) Ctypesdefs.tint)))
### C.jet_secp_wnaf_loop.wnaf_weighted_zero
wnaf_weighted_zero
     : forall count : nat, @eq BinNums.Z (wnaf_weighted (fun _ : BinNums.Z => BinNums.Z0) count) BinNums.Z0
### C.jet_secp_wnaf_loop.wnaf_array_zero
wnaf_array_zero
     : forall (m : Memory.Mem.mem) (b : Values.block) (base len w sign : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 len)
         (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
              Memory.Mem.valid_access m AST.Mint32 b
                (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
                Memtype.Writable)
         (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m b
                   (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       wnaf_array_state m b base len w sign BinNums.Z0 (BinNums.Zneg BinNums.xH) (fun _ : BinNums.Z => BinNums.Z0)
### C.jet_secp_wnaf_loop.exec_wnaf_loop_zero
exec_wnaf_loop_zero
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (n len w sign : BinNums.Z)
         (b : Values.block) (base : BinNums.Z) (bs : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.lt n
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.le len
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : and (BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) w)
                (BinInt.Z.le w (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
         (_ : or (@eq BinNums.Z sign (BinNums.Zpos BinNums.xH)) (@eq BinNums.Z sign (BinNums.Zneg BinNums.xH)))
         (_ : jet_secp_wnaf_control.wnaf_loop_fields le BinNums.Z0 len w BinNums.Z0 sign b base
                (BinNums.Zneg BinNums.xH))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bs BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n))) (_ : not (@eq Values.block b bs))
         (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) len))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
              Memory.Mem.valid_access m AST.Mint32 b
                (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
                Memtype.Writable)
         (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m b
                   (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex BinNums.Z
               (fun carry : BinNums.Z =>
                @ex BinNums.Z
                  (fun last : BinNums.Z =>
                   @ex (forall _ : BinNums.Z, BinNums.Z)
                     (fun digits : forall _ : BinNums.Z, BinNums.Z =>
                      and
                        (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_wnaf_digit.wnaf_env bs) le
                           m wnaf_loop_return Events.E0 lef mf
                           (ClightBigstep.Out_return
                              (@Some (prod Values.val Ctypes.type)
                                 (@pair Values.val Ctypes.type
                                    (Values.Vint (Integers.Int.repr (BinInt.Z.add last (BinNums.Zpos BinNums.xH))))
                                    Ctypesdefs.tint))))
                        (and (jet_secp_wnaf_control.wnaf_loop_fields lef len len w carry sign b base last)
                           (and (or (@eq BinNums.Z carry BinNums.Z0) (@eq BinNums.Z carry (BinNums.Zpos BinNums.xH)))
                              (and
                                 (jet_secp_scalar_get_b32_storage.scalar_at mf bs BinNums.Z0
                                    (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                                       (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n)))
                                 (and (wnaf_array_state mf b base len w sign len last digits)
                                    (and
                                       (@eq BinNums.Z
                                          (BinInt.Z.add (wnaf_weighted digits (BinInt.Z.to_nat len))
                                             (BinInt.Z.mul (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) len)
                                                (BinInt.Z.add
                                                   (BinInt.Z.div n
                                                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) len)) carry)))
                                          n)
                                       (and
                                          (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add last (BinNums.Zpos BinNums.xH)))
                                             (BinInt.Z.le (BinInt.Z.add last (BinNums.Zpos BinNums.xH)) len))
                                          (and (wnaf_memory_effect b m mf)
                                             (forall
                                                _ : BinInt.Z.lt n
                                                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                         (BinInt.Z.sub len (BinNums.Zpos BinNums.xH))),
                                              and (@eq BinNums.Z carry BinNums.Z0)
                                                (@eq BinNums.Z (wnaf_weighted digits (BinInt.Z.to_nat len)) n))))))))))))))
### C.jet_secp_wnaf_loop.wnaf_update
wnaf_update =
fun (digits : forall _ : BinNums.Z, BinNums.Z) (bit digit i : BinNums.Z) =>
match Coqlib.zeq i bit return BinNums.Z with
| left _ => digit
| right _ => digits i
end
     : forall (_ : forall _ : BinNums.Z, BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments wnaf_update digits%function_scope (bit digit i)%Z_scope
### C.jet_secp_wnaf_loop.wnaf_weighted
wnaf_weighted =
fix wnaf_weighted (digits : forall _ : BinNums.Z, BinNums.Z) (count : nat) {struct count} : BinNums.Z :=
  match count return BinNums.Z with
  | O => BinNums.Z0
  | S k =>
      BinInt.Z.add (wnaf_weighted digits k)
        (BinInt.Z.mul (digits (BinInt.Z.of_nat k))
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat k)))
  end
     : forall (_ : forall _ : BinNums.Z, BinNums.Z) (_ : nat), BinNums.Z

Arguments wnaf_weighted digits%function_scope count%nat_scope
### C.jet_secp_wnaf_loop.wnaf_small_digit
wnaf_small_digit =
fun w digit : BinNums.Z =>
or (@eq BinNums.Z digit BinNums.Z0)
  (and (@eq BinNums.Z (BinInt.Z.modulo digit (BinNums.Zpos (BinNums.xO BinNums.xH))) (BinNums.Zpos BinNums.xH))
     (and
        (BinInt.Z.lt
           (BinInt.Z.opp
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.sub w (BinNums.Zpos BinNums.xH)))) digit)
        (BinInt.Z.lt digit
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.sub w (BinNums.Zpos BinNums.xH))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments wnaf_small_digit (w digit)%Z_scope
### C.jet_secp_wnaf_loop.wnaf_last
wnaf_last =
fun (digits : forall _ : BinNums.Z, BinNums.Z) (bit last : BinNums.Z) =>
and (and (BinInt.Z.le (BinNums.Zneg BinNums.xH) last) (BinInt.Z.lt last bit))
  (and
     (forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i bit))
        (_ : not (@eq BinNums.Z (digits i) BinNums.Z0)), BinInt.Z.le i last)
     (or (@eq BinNums.Z last (BinNums.Zneg BinNums.xH)) (not (@eq BinNums.Z (digits last) BinNums.Z0))))
     : forall (_ : forall _ : BinNums.Z, BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments wnaf_last digits%function_scope (bit last)%Z_scope
### C.jet_secp_wnaf_loop.wnaf_array_state
Variant
wnaf_array_state (m : Memory.Mem.mem) (b : Values.block) (base len w sign bit last : BinNums.Z)
(digits : forall _ : BinNums.Z, BinNums.Z) : Prop :=
    Build_wnaf_array_state : forall
                               (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
                                    Memory.Mem.valid_access m AST.Mint32 b
                                      (BinInt.Z.add base
                                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
                                      Memtype.Writable)
                               (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
                                    @eq (option Values.val)
                                      (Memory.Mem.load AST.Mint32 m b
                                         (BinInt.Z.add base
                                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                                      (@Some Values.val
                                         (Values.Vint (Integers.Int.repr (BinInt.Z.mul sign (digits i))))))
                               (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le bit i) (BinInt.Z.lt i len)),
                                    @eq BinNums.Z (digits i) BinNums.Z0)
                               (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
                                    wnaf_small_digit w (digits i)) (_ : wnaf_last digits bit last),
                             wnaf_array_state m b base len w sign bit last digits.

Arguments wnaf_array_state m b (base len w sign bit last)%Z_scope digits%function_scope
Arguments Build_wnaf_array_state m b (base len w sign bit last)%Z_scope
  (digits wnaf_array_access wnaf_array_load wnaf_array_suffix wnaf_array_digits)%function_scope
  wnaf_array_last
### C.jet_secp_wnaf_loop.wnaf_memory_effect
wnaf_memory_effect =
fun (b : Values.block) (m mf : Memory.Mem.mem') =>
and (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m))
  (and
     (forall (bx : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
      iff (Memory.Mem.perm m bx pos k p) (Memory.Mem.perm mf bx pos k p))
     (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf))
     : forall (_ : Values.block) (_ : Memory.Mem.mem') (_ : Memory.Mem.mem'), Prop

Arguments wnaf_memory_effect b m mf
### C.jet_secp_wnaf_loop.wnaf_loop_return
wnaf_loop_return =
Clight.Ssequence jet_secp_wnaf_digit.wnaf_loop
  (@snd (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_ecmult_wnaf)))
     : Clight.statement
