### C.jet_elements_confidential_wrap.sha_confidential_symbol
sha_confidential_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
            (Clight.genv_genv jet_elements_support_sha_linkage.sha_ge) jets_elements._simplicity_sha256_confidential)
         (@Some Values.block
            (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_confidential))
### C.jet_elements_confidential_wrap.sha_confidential_funct
sha_confidential_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
            (Clight.genv_genv jet_elements_support_sha_linkage.sha_ge)
            (Values.Vptr
               (jet_elements_support_sha_linkage.sha_symbol_block jets_elements._simplicity_sha256_confidential)
               Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function)
            (@Ctypes.Internal Clight.function jets_elements.f_simplicity_sha256_confidential))
### C.jet_elements_confidential_wrap.eval_confAsset_call
eval_confAsset_call
     : forall (m m' : Memory.Mem.mem) (vctx vconf : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
                (@Ctypes.Internal Clight.function jets_elements.f_simplicity_sha256_confidential)
                (@cons Values.val
                   (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   (@cons Values.val
                      (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))
                      (@cons Values.val vctx (@cons Values.val vconf (@nil Values.val))))) Events.E0 m' Values.Vundef)
         (_ : @ex Values.block
                (fun b : Values.block =>
                 @ex Integers.Ptrofs.int (fun o : Integers.Ptrofs.int => @eq Values.val vctx (Values.Vptr b o))))
         (_ : @ex Values.block
                (fun b : Values.block =>
                 @ex Integers.Ptrofs.int (fun o : Integers.Ptrofs.int => @eq Values.val vconf (Values.Vptr b o)))),
       ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
         (@Ctypes.Internal Clight.function jets_elements.f_simplicity_sha256_confAsset)
         (@cons Values.val vctx (@cons Values.val vconf (@nil Values.val))) Events.E0 m' Values.Vundef
