              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                   (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
                (add (Alg.AssertionSem Option.option_Monad_Zero)
                   (@pair
                      (prod
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) X) c x)) (jet_sha_ctx8_spec.ctx8_add_list c (bytes_of x))) (w : nat)
         (array : Alg.Assertion.domain (jet_sha_hash_words_reader.hash_reader_alg E) (Ty.Prod Ty.Unit (Word.Word w))
                    (Ty.Sum Ty.Unit X)) (e : E) (xs : list (Ty.tySem X)) (N : BinNums.Z)
         (_ : forall
                i : (fix tySem (X0 : Ty.Ty) : Set :=
                       match X0 return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word w),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum Ty.Unit X)))
                (array
                   (@pair unit
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word w)) tt i) e)
                (@Some (sum unit (Ty.tySem X))
                   match
                     @List.nth_error (Ty.tySem X) xs (BinInt.Z.to_nat (jet_forWhile_seq.wz w i))
                     return (sum unit (Ty.tySem X))
                   with
                   | Some x => @inr unit (Ty.tySem X) x
                   | None => @inl unit (Ty.tySem X) tt
                   end))
         (_ : forall x : Ty.tySem X,
              BinInt.Z.le (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (bytes_of x))) N)
         (_ : BinInt.Z.le BinNums.Z0 N)
         (_ : BinInt.Z.lt
                (BinInt.Z.div (BinInt.Z.mul N (jet_forWhile_seq.wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                jet_sha_ctx8_spec.ctx8_limit),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@hash_elems_spec X add w (jet_sha_hash_words_reader.hash_reader_alg E) array tt e)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.from_hash256 (jet_bitcoin_tx_hash.elems_hash_of X bytes_of w xs)))
### C.jet_sha_hash_elems_reader.hash_elems_spec
hash_elems_spec =
fun (X : Ty.Ty)
  (add : forall term : Alg.Assertion.Algebra,
         Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
           jet_sha256_ctx8_init_spec.sha256_ctx8_type) (w : nat) (term : Alg.Assertion.Algebra)
  (array : Alg.Assertion.domain term (Ty.Prod Ty.Unit (Word.Word w)) (Ty.Sum Ty.Unit X)) =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.unit Ty.Unit core) (@jet_sha256_ctx8_init_spec.sha256_ctx8_init_spec core))
  (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type)
     (Ty.Sum jet_sha256_ctx8_init_spec.sha256_ctx8_type jet_sha256_ctx8_init_spec.sha256_ctx8_type)
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_hash_loop_gen.gen_loop_run X add w term Ty.Unit array)
     (@jet_sha256_ctx8_init_spec.AC.copair jet_sha256_ctx8_init_spec.sha256_ctx8_type
        jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_sha_finalize_spec.ctx8_finalize_spec term) (@jet_sha_finalize_spec.ctx8_finalize_spec term)))
     : forall (X : Ty.Ty)
         (_ : forall term : Alg.Assertion.Algebra,
              Alg.Assertion.domain term (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type) (w : nat) (term : Alg.Assertion.Algebra)
         (_ : Alg.Assertion.domain term (Ty.Prod Ty.Unit (Word.Word w)) (Ty.Sum Ty.Unit X)),
       Alg.Assertion.domain term Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments hash_elems_spec X%ty_scope add%function_scope w%nat_scope {term} array
