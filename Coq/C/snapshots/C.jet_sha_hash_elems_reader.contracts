### C.jet_sha_hash_elems_reader.hash_elems_spec_parametric
hash_elems_spec_parametric
     : forall (X : Ty.Ty)
         (add : forall alg : Alg.Assertion.Algebra,
                Alg.Assertion.domain alg (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                  jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : @Alg.Assertion.Parametric (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type X)
                jet_sha256_ctx8_init_spec.sha256_ctx8_type add) (w : nat) (alg1 alg2 : Alg.Assertion.Algebra)
         (R : Alg.Assertion.Parametric.Rel alg1 alg2)
         (a1 : Alg.Assertion.domain alg1 (Ty.Prod Ty.Unit (Word.Word w)) (Ty.Sum Ty.Unit X))
         (a2 : Alg.Assertion.domain alg2 (Ty.Prod Ty.Unit (Word.Word w)) (Ty.Sum Ty.Unit X))
         (_ : @Alg.Assertion.Parametric.rel alg1 alg2 R (Ty.Prod Ty.Unit (Word.Word w)) (Ty.Sum Ty.Unit X) a1 a2),
       @Alg.Assertion.Parametric.rel alg1 alg2 R Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@hash_elems_spec X add w alg1 a1) (@hash_elems_spec X add w alg2 a2)
### C.jet_sha_hash_elems_reader.hr_copair
hr_copair
     : forall (E : Type) (A B C : Ty.Ty) (s : Alg.Assertion.domain (jet_sha_hash_words_reader.hash_reader_alg E) A C)
         (t : Alg.Assertion.domain (jet_sha_hash_words_reader.hash_reader_alg E) B C) (x : Ty.tySem (Ty.Sum A B))
         (e : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C))
         (@jet_sha256_ctx8_init_spec.AC.copair A B C
            (Alg.Assertion.toCore (jet_sha_hash_words_reader.hash_reader_alg E)) s t x e)
         match x return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem C)) with
         | inl a => s a e
         | inr b => t b e
         end
