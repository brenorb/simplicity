### C.jet_copyBits_helper_exec.copy_eval_field_lvalue
copy_eval_field_lvalue
     : forall (id : BinNums.positive) (field : AST.ident) (ty : Ctypes.type) (e : Clight.env)
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : or (and (@eq AST.ident field jets._edge) (@eq Ctypes.type ty (Ctypesdefs.tptr Ctypesdefs.tulong)))
                (and (@eq AST.ident field jets._offset) (@eq Ctypes.type ty Ctypesdefs.tulong))),
