### C.jet_copyBits_helper_exec.copy_clear_env
copy_clear_env =
fun (le : Maps.PTree.tree Values.val) (ds : BinNums.Z) (old : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._t'1 (Values.Vlong (jet_word_bits.clear_low ds old))
  (@Maps.PTree.set Values.val jets._t'12 (Values.Vlong old) le)
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments copy_clear_env le ds%Z_scope old
### C.jet_copyBits_helper_exec.copy_left_env
copy_left_env =
fun (le : Maps.PTree.tree Values.val) (ss ds : BinNums.Z) (old source : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets._t'10 (Values.Vlong (jet_word_bits.clear_low ds old))
  (@Maps.PTree.set Values.val jets._t'2 (Values.Vlong (Integers.Int64.zero_ext ss source))
     (@Maps.PTree.set Values.val jets._t'11 (Values.Vlong source) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments copy_left_env le (ss ds)%Z_scope old source
### C.jet_copyBits_helper_exec.copy_left_value
copy_left_value =
fun (ss ds : BinNums.Z) (old source : Integers.Int64.int) =>
Integers.Int64.or (jet_word_bits.clear_low ds old)
  (Integers.Int64.shl (Integers.Int64.zero_ext ss source) (Integers.Int64.repr (BinInt.Z.sub ds ss)))
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int64.int

Arguments copy_left_value (ss ds)%Z_scope old source
