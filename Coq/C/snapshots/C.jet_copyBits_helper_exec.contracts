                     (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf bw (jet_write_layout.write_word_address outedge cursor))
                  (@Some Values.val (Values.Vlong payload)))
               (and (jet_frame_layout.frame_fields_at mf bd base bw outedge cursor)
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
