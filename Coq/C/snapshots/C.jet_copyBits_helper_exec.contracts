### C.jet_copyBits_helper_exec.exec_copy_clear
exec_copy_clear
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bw : Values.block)
         (ofs : Integers.Ptrofs.int) (ds : BinNums.Z) (old : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ds)
                (BinInt.Z.le ds
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le)
                (@Some Values.val (Values.Vptr bw ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (Integers.Ptrofs.unsigned ofs))
                (@Some Values.val (Values.Vlong old)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned ofs)
                   (Values.Vlong (jet_word_bits.clear_low ds old))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m copy_clear_stmt Events.E0
         (copy_clear_env le ds old) mf ClightBigstep.Out_normal
### C.jet_copyBits_helper_exec.exec_copy_left_fill
exec_copy_left_fill
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bi : Values.block)
         (src_ofs : Integers.Ptrofs.int) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int)
         (ss ds : BinNums.Z) (old source : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (and (BinInt.Z.lt ss ds)
                   (BinInt.Z.le ds
                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_ptr le)
                (@Some Values.val (Values.Vptr bi src_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le)
                (@Some Values.val (Values.Vptr bw dst_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bi (Integers.Ptrofs.unsigned src_ofs))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs))
                (@Some Values.val (Values.Vlong (jet_word_bits.clear_low ds old))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (copy_left_value ss ds old source))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m copy_left_fill Events.E0
         (copy_left_env le ss ds old source) mf ClightBigstep.Out_normal
### C.jet_copyBits_helper_exec.exec_copy_tail_short_left
exec_copy_tail_short_left
     : forall (le : Maps.PTree.tree Values.val) (m mc mf : Memory.Mem.mem) (bi : Values.block)
         (src_ofs : Integers.Ptrofs.int) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int)
         (ss ds n : BinNums.Z) (old source : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (and (BinInt.Z.lt ss ds)
                   (BinInt.Z.le ds
                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.lt BinNums.Z0 n) (BinInt.Z.le n ss))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_ptr le)
                (@Some Values.val (Values.Vptr bi src_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_ptr le)
                (@Some Values.val (Values.Vptr bw dst_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr n))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs))
                (@Some Values.val (Values.Vlong old)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (jet_word_bits.clear_low ds old))) (@Some Memory.Mem.mem mc))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 mc bi (Integers.Ptrofs.unsigned src_ofs))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mc bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (copy_left_value ss ds old source))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m copy_helper_tail Events.E0
         (copy_left_env (copy_clear_env le ds old) ss ds old source) mf
         (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type)))
### C.jet_copyBits_helper_exec.eval_copy_helper_partial_from_tail
eval_copy_helper_partial_from_tail
     : forall (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (old source payload : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid sbase) (_ : jet_frame_layout.frame_base_valid base)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : jet_frame_layout.frame_fields_at m bd base bw outedge cursor)
         (_ : and (BinInt.Z.le BinNums.Z0 rc) (BinInt.Z.le rc Integers.Int64.max_unsigned))
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) cursor) (BinInt.Z.le cursor Integers.Int64.max_unsigned))
         (_ : and
                (BinInt.Z.le
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                         (BinInt.Z.div rc
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                   edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned)) (_ : BinInt.Z.le BinNums.Z0 outedge)
         (_ : BinInt.Z.le (jet_write_layout.write_word_address outedge cursor) Integers.Ptrofs.max_unsigned)
         (_ : or (not (@eq Values.block bd bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) base)
                   (BinInt.Z.le
                      (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (jet_write_layout.write_word_address outedge cursor))))
         (_ : or (not (@eq Values.block bi bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add
                         (BinInt.Z.sub edge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                  (BinInt.Z.div rc
                                     (BinNums.Zpos
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (jet_write_layout.write_word_address outedge cursor))
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.sub edge
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                               (BinInt.Z.div rc
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                            (BinInt.Z.div rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address outedge cursor))
                (@Some Values.val (Values.Vlong old)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bw (jet_write_layout.write_word_address outedge cursor)
                Memtype.Writable)
         (_ : forall (mc mf : Memory.Mem.mem)
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 mc bi
                          (BinInt.Z.sub edge
                             (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                   (BinInt.Z.div rc
                                      (BinNums.Zpos
                                         (BinNums.xO
