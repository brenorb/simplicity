         (Integers.Ptrofs.add (Integers.Ptrofs.repr base)
            (Integers.Ptrofs.repr
               match BinPos.Pos.eqb field jets._edge return BinNums.Z with
               | true => BinNums.Z0
               | false => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))
               end)) Ctypes.Full
