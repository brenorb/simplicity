### C.jet_frame_inv.fext_bd
fext_bd
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N), fext m0 bd bw bi bd
### C.jet_frame_inv.load_valid
load_valid
     : forall (m : Memory.Mem.mem) (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
         (v : Values.val) (_ : @eq (option Values.val) (Memory.Mem.load chunk m b ofs) (@Some Values.val v)),
       Memory.Mem.valid_block m b
### C.jet_frame_inv.finv_init
finv_init
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N),
       finv m0 bd dbase bw outedge cursor N bi m0 false (@nil BitMachine.Cell)
### C.jet_frame_inv.output_cells_transfer
output_cells_transfer
     : forall (bw : Values.block) (outedge cursor : BinNums.Z) (m m' : Memory.Mem.mem) (cells : list BitMachine.Cell)
         (_ : forall (_ : not (@eq (list BitMachine.Cell) cells (@nil BitMachine.Cell))) (ofs : BinNums.Z),
              @eq (option Values.val) (Memory.Mem.load AST.Mint64 m' bw ofs) (Memory.Mem.load AST.Mint64 m bw ofs))
         (_ : jet_encoding.frame_output_cells_at m bw outedge cursor cells),
       jet_encoding.frame_output_cells_at m' bw outedge cursor cells
### C.jet_frame_inv.bw_valid
bw_valid
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.lt BinNums.Z0 N), Memory.Mem.valid_block m0 bw
### C.jet_frame_inv.finv_stable
finv_stable
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N) (m m' : Memory.Mem.mem)
         (w : bool) (outs : list BitMachine.Cell) (_ : finv m0 bd dbase bw outedge cursor N bi m w outs)
         (_ : eqext m0 bd bw bi m m'), finv m0 bd dbase bw outedge cursor N bi m' w outs
### C.jet_frame_inv.finv_input
finv_input
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (m : Memory.Mem.mem) (outs : list BitMachine.Cell)
         (edge rc : BinNums.Z) (inp : list BitMachine.Cell) (_ : finv m0 bd dbase bw outedge cursor N bi m false outs)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc inp), jet_encoding.frame_input_cells_at m bi edge rc inp
### C.jet_frame_inv.write_frame_at_le
write_frame_at_le
     : forall (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge cursor : BinNums.Z)
         (m : Memory.Mem.mem) (count count' : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 count') (BinInt.Z.le count' count))
         (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor count),
       jet_output_layout.write_frame_at m bd dbase bw outedge cursor count'
### C.jet_frame_inv.finv_wframe
finv_wframe
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N) (m : Memory.Mem.mem)
         (w : bool) (outs : list BitMachine.Cell) (_ : finv m0 bd dbase bw outedge cursor N bi m w outs),
       jet_output_layout.write_frame_at m bd dbase bw outedge
         (BinInt.Z.sub cursor (BinInt.Z.of_nat (@length BitMachine.Cell outs)))
         (BinInt.Z.sub N (BinInt.Z.of_nat (@length BitMachine.Cell outs)))
### C.jet_frame_inv.finv_write
finv_write
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N) (m m' : Memory.Mem.mem)
         (w : bool) (outs : list BitMachine.Cell) (n2 : BinNums.Z) (cells2 : list BitMachine.Cell)
         (_ : finv m0 bd dbase bw outedge cursor N bi m w outs)
         (_ : @eq BinNums.Z (BinInt.Z.of_nat (@length BitMachine.Cell cells2)) n2)
         (_ : BinInt.Z.le (BinInt.Z.add (BinInt.Z.of_nat (@length BitMachine.Cell outs)) n2) N)
         (_ : jet_bitcoin_effects.write_effect m m' bd dbase bw outedge
                (BinInt.Z.sub cursor (BinInt.Z.of_nat (@length BitMachine.Cell outs))) n2 cells2),
       finv m0 bd dbase bw outedge cursor N bi m' true (@app BitMachine.Cell outs cells2)
### C.jet_frame_inv.fext
fext =
fun (m0 : Memory.Mem.mem) (bd bw bi b : Values.block) =>
and (or (@eq Values.block b bd) (or (@eq Values.block b bw) (@eq Values.block b bi))) (Memory.Mem.valid_block m0 b)
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Prop

Arguments fext m0 bd bw bi b
### C.jet_frame_inv.eqext
eqext =
fun (m0 : Memory.Mem.mem) (bd bw bi : Values.block) (m m' : Memory.Mem.mem) =>
jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => fext m0 bd bw bi b) m m'
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments eqext m0 bd bw bi m m'
### C.jet_frame_inv.weffE
weffE =
fun (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge cursor : BinNums.Z)
  (bi : Values.block) (m : Memory.Mem.mem) (n : BinNums.Z) (cells : list BitMachine.Cell) =>
and (jet_encoding.frame_output_cells_at m bw outedge cursor cells)
  (and (jet_output_layout.write_prefix_at m0 m bw outedge cursor)
     (and (jet_frame_layout.frame_fields_at m bd dbase bw outedge (BinInt.Z.sub cursor n))
        (and
           (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : fext m0 bd bw bi b)
              (_ : or (not (@eq Values.block b bd))
                     (or
                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                           (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (BinInt.Z.le
                           (BinInt.Z.add dbase
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
              (_ : or (not (@eq Values.block b bw))
                     (or
                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                           (BinInt.Z.add outedge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div (BinInt.Z.sub cursor n)
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                        (BinInt.Z.le
                           (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
            @eq (option Values.val) (Memory.Mem.load chunk m b ofs) (Memory.Mem.load chunk m0 b ofs))
           (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
              (_ : fext m0 bd bw bi b) (_ : Memory.Mem.perm m0 b ofs k p), Memory.Mem.perm m b ofs k p))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : Values.block) (_ : Memory.Mem.mem) (_ : BinNums.Z) (_ : list BitMachine.Cell), Prop

Arguments weffE m0 bd dbase%Z_scope bw (outedge cursor)%Z_scope bi m n%Z_scope cells%list_scope
### C.jet_frame_inv.finv
finv =
fun (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
  (bi : Values.block) (m : Memory.Mem.mem) (w : bool) (outs : list BitMachine.Cell) =>
and (forall (b : Values.block) (_ : fext m0 bd bw bi b), Memory.Mem.valid_block m b)
  (and (jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
     (and (BinInt.Z.le (BinInt.Z.of_nat (@length BitMachine.Cell outs)) N)
        (and (weffE m0 bd dbase bw outedge cursor bi m (BinInt.Z.of_nat (@length BitMachine.Cell outs)) outs)
           (forall _ : @eq bool w false,
            and (@eq (list BitMachine.Cell) outs (@nil BitMachine.Cell)) (eqext m0 bd bw bi m0 m)))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : Values.block) (_ : Memory.Mem.mem) (_ : bool)
         (_ : list BitMachine.Cell), Prop

Arguments finv m0 bd dbase%Z_scope bw (outedge cursor N)%Z_scope bi m w%bool_scope outs%list_scope
