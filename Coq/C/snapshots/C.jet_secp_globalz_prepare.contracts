### C.jet_secp_globalz_prepare.globalz_prepare_source
globalz_prepare_source
     : @eq Clight.statement jet_secp_globalz_indexed_call.globalz_indexed_loop_body
         (Clight.Ssequence
            match jet_secp_globalz_indexed_call.globalz_indexed_loop_body return Clight.statement with
            | Clight.Sskip => Clight.Sskip
            | Clight.Sassign _ _ => Clight.Sskip
            | Clight.Sset _ _ => Clight.Sskip
            | Clight.Scall _ _ _ => Clight.Sskip
            | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
            | Clight.Ssequence s _ => s
            | Clight.Sifthenelse _ _ _ => Clight.Sskip
            | Clight.Sloop _ _ => Clight.Sskip
            | Clight.Sbreak => Clight.Sskip
            | Clight.Scontinue => Clight.Sskip
            | Clight.Sreturn _ => Clight.Sskip
            | Clight.Sswitch _ _ => Clight.Sskip
            | Clight.Slabel _ _ => Clight.Sskip
            | Clight.Sgoto _ => Clight.Sskip
            end
            (Clight.Ssequence globalz_decrement
               (jet_secp_statement_prefix.statement_sequence globalz_prepare_statements
                  jet_secp_globalz_indexed_call.globalz_indexed_scale_statement)))
### C.jet_secp_globalz_prepare.exec_globalz_prepare
exec_globalz_prepare
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (x y : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (br bt : Values.block)
         (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : not (@eq Values.block br bt))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._tmpa e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr i))))
         (_ : jet_secp_fe_nv.fe_at m br
                (BinInt.Z.add
                   (BinInt.Z.mul
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) i)
                   BinNums.Z0) (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m br
                (BinInt.Z.add
                   (BinInt.Z.mul
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))) i)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m globalz_prepare Events.E0 le mf
               ClightBigstep.Out_normal)
            (and (jet_secp_fe_nv.fe_at mf bt BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
               (and
                  (jet_secp_fe_nv.fe_at mf bt
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (jet_secp_multiply_normalize_bridge.words5 y))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf bt
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
                         iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p))
                        (and
                           (jet_sx_mem.lframe
                              (fun (b : Values.block) (pos : BinNums.Z) =>
                               or (not (@eq Values.block b bt))
                                 (or (BinInt.Z.lt pos BinNums.Z0)
                                    (BinInt.Z.le
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                       pos))) m mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))
### C.jet_secp_globalz_prepare.globalz_tmp_field
globalz_tmp_field =
fun (fid : AST.ident) (ty : Ctypes.type) =>
Clight.Efield (Clight.Evar jets_secp._tmpa (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)) fid ty
     : forall (_ : AST.ident) (_ : Ctypes.type), Clight.expr

Arguments globalz_tmp_field fid ty
### C.jet_secp_globalz_prepare.globalz_table_field
globalz_table_field =
fun (fid : AST.ident) (ty : Ctypes.type) =>
Clight.Efield
  (Clight.Ederef jet_secp_globalz_indexed_call.globalz_indexed_entry_address jet_secp_curve_statements.curve_ge_type)
  fid ty
     : forall (_ : AST.ident) (_ : Ctypes.type), Clight.expr

Arguments globalz_table_field fid ty
### C.jet_secp_globalz_prepare.globalz_copy_statement
globalz_copy_statement =
fun y : bool =>
Clight.Sassign
  (globalz_tmp_field match y return AST.ident with
                     | true => jets_secp._y
                     | false => jets_secp._x
                     end jet_secp_curve_statements.curve_fe_type)
  (globalz_table_field match y return AST.ident with
                       | true => jets_secp._y
                       | false => jets_secp._x
                       end jet_secp_curve_statements.curve_fe_type)
     : forall _ : bool, Clight.statement

Arguments globalz_copy_statement y%bool_scope
### C.jet_secp_globalz_prepare.globalz_finite_statement
globalz_finite_statement =
Clight.Sassign (globalz_tmp_field jets_secp._infinity Ctypesdefs.tint)
  (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
     : Clight.statement
### C.jet_secp_globalz_prepare.globalz_prepare_statements
globalz_prepare_statements =
@cons Clight.statement (globalz_copy_statement false)
  (@cons Clight.statement (globalz_copy_statement true)
     (@cons Clight.statement globalz_finite_statement (@nil Clight.statement)))
     : list Clight.statement
### C.jet_secp_globalz_prepare.globalz_prepare
globalz_prepare =
jet_secp_statement_prefix.statement_sequence globalz_prepare_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_globalz_prepare.globalz_decrement
globalz_decrement =
Clight.Sset jets_secp._i
  (Clight.Ebinop Cop.Osub (Clight.Etempvar jets_secp._i Ctypesdefs.tulong)
     (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tulong)
     : Clight.statement
