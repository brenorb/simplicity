### C.jet_nonce_local_common.nonce_source_copy
nonce_source_copy
     : forall (m mc : Memory.Mem.mem) (bl bm bb bx bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge
         (jet_nonce_context_shape.nc_env bl bm bb bx) le m
         (Clight.Sassign (Clight.Evar jets_elements._src jet_nonce_context_shape.nc_fr)
            (Clight.Etempvar jets_elements._src jet_nonce_context_shape.nc_fr)) Events.E0 le mc
         ClightBigstep.Out_normal
### C.jet_nonce_local_common.nonce_counter_overflow_two
nonce_counter_overflow_two
     : forall (r : Integers.Int64.int) (len : BinNums.Z)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned r)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.lt len
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       let c : Integers.Int64.int := jet_read_sha256_counter.sha256_read_counter r (Integers.Int64.repr len) in
       and
         (@eq Integers.Int64.int
            (Integers.Int64.add (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (Integers.Int64.add c
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (@eq bool
            (jet_elements_support_sha_uchars_exec.uc_overflow
               (jet_elements_support_sha_uchars_exec.uc_overflow false c
                  (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
               (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (jet_elements_support_sha_uchars_exec.uc_overflow false c
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
### C.jet_nonce_local_common.nonce_entry_sha
nonce_entry_sha
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 : Memory.Mem.mem') (bl bm bb bx bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bm))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 bb))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m4 bx)),
       Clight.function_entry2 jet_elements_support_sha_linkage.sha_ge jets_elements.f_simplicity_nonce_hash
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (jet_nonce_context_shape.nc_env bl bm bb bx) (jet_nonce_context_shape.nc_temps env bd dbase bs sbase) m4
### C.jet_nonce_local_common.nonce_blocks_sha
nonce_blocks_sha
     : forall bl bm bb bx : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_support_sha_linkage.sha_ge (jet_nonce_context_shape.nc_env bl bm bb bx))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bm BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bb BinNums.Z0)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))
### C.jet_nonce_local_common.nonce_stream_count
