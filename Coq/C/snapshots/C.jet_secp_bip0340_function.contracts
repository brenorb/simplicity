### C.jet_secp_bip0340_function.bip0340_exec_two_then_last
bip0340_exec_two_then_last
     : forall (ge : Clight.genv) (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (a b last : Clight.statement) (li : Clight.temp_env) (mi : Memory.Mem.mem) (lef : Clight.temp_env)
         (mf : Memory.Mem.mem) (out : ClightBigstep.outcome)
         (_ : ClightBigstep.Clight2.exec_stmt ge e le m (Clight.Ssequence a b) Events.E0 li mi ClightBigstep.Out_normal)
         (_ : ClightBigstep.Clight2.exec_stmt ge e li mi last Events.E0 lef mf out),
       ClightBigstep.Clight2.exec_stmt ge e le m (Clight.Ssequence a (Clight.Ssequence b last)) Events.E0 lef mf out
### C.jet_secp_bip0340_function.bip0340_source_fields_framed
bip0340_source_fields_framed
     : forall (m mf : Memory.Mem.mem) (bl bi : Values.block) (edge rc : BinNums.Z)
         (P : forall (_ : Values.block) (_ : BinNums.Z), Prop)
         (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : jet_sx_mem.lframe P m mf)
         (_ : forall pos : BinNums.Z, P bl pos), jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge rc
### C.jet_secp_bip0340_function.bip0340_old_frame
bip0340_old_frame
     : forall (m0 m mf : Memory.Mem.mem) (locals : list Values.block)
         (_ : forall (b : Values.block) (_ : Memory.Mem.valid_block m0 b), not (@List.In Values.block b locals))
         (_ : jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m0 m)
         (_ : jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@List.In Values.block b locals)) m mf),
       jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m0 mf
### C.jet_secp_bip0340_function.bip0340_parse_zero_outcome
bip0340_parse_zero_outcome
     : forall (pk : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq Integers.Int.int (jet_secp_xonly_parse_field.xonly_parse_result pk) Integers.Int.zero),
       @eq ClightBigstep.outcome (jet_secp_bip0340_public_parse.bip0340_parse_outcome pk)
         (ClightBigstep.Out_return
            (@Some (prod Values.val Ctypes.type)
               (@pair Values.val Ctypes.type (Values.Vint Integers.Int.zero) Ctypesdefs.tint)))
### C.jet_secp_bip0340_function.bip0340_parse_one_outcome
