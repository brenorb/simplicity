### C.jet_secp_scalar_add_reader_support.scalar_preserved_across_other_read
scalar_preserved_across_other_read
     : forall (m mf m0 : Memory.Mem.mem) (bd bw bi ba bb bl : Values.block) (edge : BinNums.Z)
         (xs : list Integers.Int64.int) (_ : not (@eq Values.block ba bb)) (_ : not (@eq Values.block ba bl))
         (_ : not (jet_secp_frame.extA m0 bd bw bi ba))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba BinNums.Z0 xs)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_sx_mem.lframe
                (jet_sx_exec.frame (jet_secp_frame.extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))
                   (jet_secp_scalar_reader_run.scalar_reader_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mf),
       and (jet_secp_scalar_get_b32_storage.scalar_at mf ba BinNums.Z0 xs)
         (Memory.Mem.range_perm mf ba BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
