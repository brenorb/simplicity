exec_elements_tapleaf_version_mid
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (mc me : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (be : Values.block)
         (ebase : BinNums.Z) (bt : Values.block) (tbase : BinNums.Z) (x : Integers.Int.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._simplicity_write8 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase)))) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 tbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add tbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr mc be
                   (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned mc bt
                   (BinInt.Z.add tbase
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                (@Some Values.val (Values.Vint x)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mc
                (@Ctypes.Internal Clight.function jets.f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vint (Cop.cast_int_int Ctypes.I8 Ctypes.Unsigned x)) (@nil Values.val)))
                Events.E0 me Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le mc elements_tapleaf_version_mid Events.E0
         (@Maps.PTree.set Values.val jets_elements._t'2 (Values.Vint x)
            (@Maps.PTree.set Values.val jets_elements._t'1 (Values.Vptr bt (Integers.Ptrofs.repr tbase)) le)) me
