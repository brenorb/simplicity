### C.jet_subtract8_exec.subtract8_borrow_expr
subtract8_borrow_expr =
Clight.Ebinop Cop.Olt (Clight.Etempvar jets._x Ctypesdefs.tuchar) (Clight.Etempvar jets._y Ctypesdefs.tuchar)
  Ctypesdefs.tint
     : Clight.expr
### C.jet_subtract8_exec.subtract8_payload_expr
subtract8_payload_expr =
Clight.Ecast
  (Clight.Ebinop Cop.Osub
     (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
        (Clight.Etempvar jets._x Ctypesdefs.tuchar) Ctypesdefs.tuint) (Clight.Etempvar jets._y Ctypesdefs.tuchar)
     Ctypesdefs.tuint) Ctypesdefs.tuchar
     : Clight.expr
