tapdata_init_local_spec
     : forall _ : jet_memcpy_model.memcpy_model,
       sha_jet_local_spec_pre (fun m : Memory.Mem.mem => and (jet_sha_add_n_exec.sha_globals_ok m) (sha_tag_ok m))
         jets_sha.f_simplicity_tapdata_init Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
