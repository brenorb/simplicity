### C.jet_sha_tapdata_jet.tp_body
tp_body
     : @eq Clight.statement (Clight.fn_body jets_sha.f_simplicity_tapdata_init)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
               (Clight.Etempvar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
            (Clight.Ssequence (Clight.Ssequence tp_init1 tp_tag)
               (Clight.Ssequence tp_init2 (Clight.Ssequence tp_hash (Clight.Ssequence tp_hash tp_write)))))
### C.jet_sha_tapdata_jet.tp_blocks
tp_blocks
     : forall bl bt bx bi bz br br1 : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_sha_linkage.sha_ge (tp_env bl bt bx bi bz br br1))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bz BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bi BinNums.Z0)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                        (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z br1 BinNums.Z0)
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                           (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z br BinNums.Z0)
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                              (@pair (prod Values.block BinNums.Z) BinNums.Z
                                 (@pair Values.block BinNums.Z bt BinNums.Z0)
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))))
### C.jet_sha_tapdata_jet.tp_tag_symbol
tp_tag_symbol
     : @eq (option Values.block)
