### C.jet_sha_tapdata_jet.eval_local_tag_s
eval_local_tag_s
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bt : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._tapleafTag e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)))),
       Clight.eval_expr jet_sha_linkage.sha_ge e le m
