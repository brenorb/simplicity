           (@nil Clight.expr))))
  (Clight.Sassign (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
     (Clight.Evar jets_sha.__res__1 (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
     : Clight.statement
### C.jet_sha_tapdata_jet.tp_tag_len
tp_tag_len =
