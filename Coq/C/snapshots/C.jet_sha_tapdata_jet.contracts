### C.jet_sha_tapdata_jet.init_ty
init_ty =
Ctypes.Tfunction
  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
     (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint) Ctypes.Tnil)) Ctypesdefs.tvoid
  (AST.mkcallconv (@None BinNums.Z) false true)
     : Ctypes.type
### C.jet_sha_tapdata_jet.tp_env
tp_env =
fun bl bt bx bi bz br br1 : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha.__res__1
  (@pair Values.block Ctypes.type br1 (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha.__res
     (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._ctx__1
        (@pair Values.block Ctypes.type bz (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._iv
           (@pair Values.block Ctypes.type bi
              (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
           (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._ctx
              (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
              (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._tapleafTag
                 (@pair Values.block Ctypes.type bt (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
                 (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._src
                    (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
                    Clight.empty_env))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : Values.block), Clight.env

Arguments tp_env bl bt bx bi bz br br1
