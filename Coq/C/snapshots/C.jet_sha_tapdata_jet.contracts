     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)) Ctypes.Tnil))
