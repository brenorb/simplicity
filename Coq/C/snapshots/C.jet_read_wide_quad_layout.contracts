### C.jet_read_wide_quad_layout.eval_read_wide_quad_at
eval_read_wide_quad_at
     : forall (s : jet_wide.wide_size) (m : Memory.Mem.mem) (bl : Values.block) (base : BinNums.Z)
         (bi : Values.block) (edge rc : BinNums.Z) (x y z w : Ty.tySem (Word.Word (jet_wide.wide_log s)))
         (_ : jet_frame_layout.frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (jet_wide.wide_bits s)))))
         (_ : jet_frame_layout.frame_fields_at m bl base bi edge rc)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge rc x)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge
                (BinInt.Z.add rc (jet_wide.wide_bits s)) y)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge
                (BinInt.Z.add rc (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (jet_wide.wide_bits s))) z)
         (_ : @jet_input_layout.frame_input_word_at (jet_wide.wide_log s) m bi edge
                (BinInt.Z.add rc (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) (jet_wide.wide_bits s))) w)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : not (@eq Values.block bl bi)),
       @ex Memory.Mem.mem
         (fun mr1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr2 : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mr3 : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun mr4 : Memory.Mem.mem =>
                   @ex Integers.Int64.int
                     (fun a : Integers.Int64.int =>
                      @ex Integers.Int64.int
                        (fun b : Integers.Int64.int =>
                         @ex Integers.Int64.int
                           (fun u : Integers.Int64.int =>
                            @ex Integers.Int64.int
                              (fun v : Integers.Int64.int =>
                               and
                                 (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m
                                    (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                                    (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base)) (@nil Values.val))
                                    Events.E0 mr1 (Values.Vlong a))
                                 (and
                                    (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr1
                                       (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                                       (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base)) (@nil Values.val))
                                       Events.E0 mr2 (Values.Vlong b))
                                    (and
                                       (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr2
                                          (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                                          (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base))
                                             (@nil Values.val)) Events.E0 mr3 (Values.Vlong u))
                                       (and
                                          (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 mr3
                                             (@Ctypes.Internal Clight.function (jet_wide.wide_reader s))
                                             (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base))
                                                (@nil Values.val)) Events.E0 mr4 (Values.Vlong v))
                                          (and
                                             (@eq BinNums.Z (Integers.Int64.unsigned a)
                                                (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) x))
                                             (and
                                                (@eq BinNums.Z (Integers.Int64.unsigned b)
                                                   (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) y))
                                                (and
                                                   (@eq BinNums.Z (Integers.Int64.unsigned u)
                                                      (@Word.ToZ.Theory.toZ (Word.WordToZ (jet_wide.wide_log s)) z))
                                                   (and
                                                      (@eq BinNums.Z (Integers.Int64.unsigned v)
                                                         (@Word.ToZ.Theory.toZ (Word.WordToZ (...)) w))
                                                      (and
                                                         (jet_frame_layout.frame_fields_at mr4 bl base bi edge
                                                            (BinInt.Z.add rc (...)))
                                                         (and (forall ... ... ... ..., @eq ... ... ...)
                                                            (and (...) (...)))))))))))))))))))
