                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))))),
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W32)))
         (jet_wide_spec.decode_wide jet_wide.W32
            (Integers.Int64.zero_ext
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (jet_bitcoin_lock_exec.lock_result final
