### C.jet_bitcoin_lock_local.lock_result_value
lock_result_value
     : forall (height final : bool) (lt : Integers.Int64.int) (L : BinNums.Z)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned lt) L)
         (_ : and (BinInt.Z.le BinNums.Z0 L)
                (BinInt.Z.lt L
                   (BinNums.Zpos
