### C.jet_bitcoin_lock_local.lock_threshold
lock_threshold =
Integers.Int64.repr
  (BinNums.Zpos
     (BinNums.xO
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (...)))))))))))))))))))))))
     : Integers.Int64.int
### C.jet_bitcoin_lock_local.lock_fn_type
lock_fn_type =
Ctypes.Tfunction
  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) Ctypes.Tnil)
  Ctypesdefs.tulong AST.cc_default
     : Ctypes.type
### C.jet_bitcoin_lock_local.bitcoin_lock_mid
bitcoin_lock_mid =
fun fid : AST.ident =>
Clight.Ssequence
  (Clight.Ssequence (jet_bitcoin_fee_local.bitcoin_env_tx_set jets_bitcoin._t'2)
     (Clight.Scall (@Some AST.ident jets_bitcoin._t'1) (Clight.Evar fid lock_fn_type)
        (@cons Clight.expr
           (Clight.Etempvar jets_bitcoin._t'2
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
           (@nil Clight.expr))))
  (Clight.Scall (@None AST.ident)
     (Clight.Evar jets_bitcoin._simplicity_write32
        (Ctypes.Tfunction
           (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
              (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
     (@cons Clight.expr
        (Clight.Etempvar jets_bitcoin._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
        (@cons Clight.expr (Clight.Etempvar jets_bitcoin._t'1 Ctypesdefs.tulong) (@nil Clight.expr))))
     : forall _ : AST.ident, Clight.statement

Arguments bitcoin_lock_mid fid
### C.jet_bitcoin_lock_local.bitcoin_lock_env_rep
bitcoin_lock_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun lt : Integers.Int64.int =>
               and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                 (and (BinInt.Z.le BinNums.Z0 ebase)
                    (and
                       (BinInt.Z.le
                          (BinInt.Z.add ebase
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                          Integers.Ptrofs.max_unsigned)
                       (and (BinInt.Z.le BinNums.Z0 tbase)
                          (and
                             (BinInt.Z.le
                                (BinInt.Z.add tbase
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...))))))))))
                                Integers.Ptrofs.max_unsigned)
                             (and
                                (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                   (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                                (and
                                   (@eq (option Values.val)
                                      (Memory.Mem.load AST.Mint8unsigned m bt
                                         (BinInt.Z.add tbase
                                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))
                                      (@Some Values.val
                                         (Values.Vint
                                            (jet_bitcoin_is_final_local.bool_int
                                               (@List.forallb Bitcoin.sigTxInput
                                                  jet_bitcoin_is_final_spec.sequence_final
                                                  (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx environment)))))))
                                   (and
                                      (@eq (option Values.val)
                                         (Memory.Mem.load AST.Mint64 m bt
                                            (BinInt.Z.add tbase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))
                                         (@Some Values.val (Values.Vlong lt)))
                                      (and
                                         (@eq BinNums.Z (Integers.Int64.unsigned lt)
                                            (Integers.Int.unsigned
                                               (Bitcoin.sigTxLock (Bitcoin.Bitcoin.envTx environment))))
                                         (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                               (@pair (prod Values.block BinNums.Z) BinNums.Z
                                                  (@pair Values.block BinNums.Z be ebase)
                                                  (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (...)))))
                                               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                                  (@pair (prod Values.block BinNums.Z) BinNums.Z
                                                     (@pair Values.block BinNums.Z bt (BinInt.Z.add tbase (...)))
                                                     (BinInt.Z.add tbase (BinNums.Zpos (...))))
                                                  (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments bitcoin_lock_env_rep m env environment fp%list_scope
