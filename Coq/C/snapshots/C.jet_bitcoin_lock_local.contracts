### C.jet_bitcoin_lock_local.bitcoin_lock_jet_local_spec
bitcoin_lock_jet_local_spec
     : forall (height : bool) (jet : Clight.function) (fid : AST.ident) (f : Clight.function)
         (_ : @eq (option Values.block)
                (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
                   (Clight.genv_genv jet_bitcoin_linkage.bitcoin_ge) fid)
                (@Some Values.block (jet_bitcoin_linkage.bitcoin_symbol_block fid)))
         (_ : @eq (option Clight.fundef)
                (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
                   (Clight.genv_genv jet_bitcoin_linkage.bitcoin_ge)
                   (Values.Vptr (jet_bitcoin_linkage.bitcoin_symbol_block fid) Integers.Ptrofs.zero))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))
         (_ : jet_bitcoin_wrapper.bitcoin_wrapper_shape jet
                (jet_bitcoin_wrapper.bitcoin_simple_rest (bitcoin_lock_mid fid)))
         (_ : forall bl : Values.block,
              @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) fid
                   (jet_bitcoin_version_exec.bitcoin_version_locals bl)) (@None (prod Values.block Ctypes.type)))
         (_ : forall (m : Memory.Mem.mem) (bt : Values.block) (tbase : BinNums.Z) (b : bool)
                (lt : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 tbase)
                (_ : BinInt.Z.le
                       (BinInt.Z.add tbase
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                       Integers.Ptrofs.max_unsigned)
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint8unsigned m bt
                          (BinInt.Z.add tbase
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                       (@Some Values.val (Values.Vint (jet_bitcoin_is_final_local.bool_int b))))
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m bt
                          (BinInt.Z.add tbase
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                       (@Some Values.val (Values.Vlong lt))),
              ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge m (@Ctypes.Internal Clight.function f)
                (@cons Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase)) (@nil Values.val)) Events.E0 m
                (Values.Vlong
                   (jet_bitcoin_lock_exec.lock_result b
                      match height return bool with
                      | true => Integers.Int64.ltu lt lock_threshold
                      | false => negb (Integers.Int64.ltu lt lock_threshold)
                      end lt)))
         (_ : @eq Ctypes.type (Clight.type_of_fundef (@Ctypes.Internal Clight.function f)) lock_fn_type)
         (spec : forall (_ : Ty.tySem Ty.Unit) (_ : Bitcoin.Bitcoin.env),
                 option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (_ : forall environment : Bitcoin.Bitcoin.env,
              @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) (spec tt environment)
                (@Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
                   (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
                      (jet_bitcoin_lock_spec.bitcoin_lock_value height environment)))),
       jet_application_sep.application_jet_local_spec_sep jet jet_bitcoin_linkage.bitcoin_ge Bitcoin.Bitcoin.env
         Ty.Unit (Word.Word (S (S (S (S (S O)))))) bitcoin_lock_env_rep spec
