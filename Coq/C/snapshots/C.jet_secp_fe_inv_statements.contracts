### C.jet_secp_fe_inv_statements.fe_inv_body_source
fe_inv_body_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_fe_inv_var) fe_inv_body
### C.jet_secp_fe_inv_statements.exec_fe_inv_body_from_calls
exec_fe_inv_body_from_calls
     : forall (le : Maps.PTree.tree Values.val) (m mc mn mp mi mf : Memory.Mem.mem) (bt bs bd : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr bd Integers.Ptrofs.zero)))
         (_ : ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (fe_inv_env bt bs) le m fe_inv_copy Events.E0 le
                mc ClightBigstep.Out_normal)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var)
                (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mn Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mn
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_to_signed62)
                (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mp
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mp
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_var)
                (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr jet_secp_modinfo_fe_global.modinfo_fe_block Integers.Ptrofs.zero)
                      (@nil Values.val))) Events.E0 mi Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mi
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_from_signed62)
                (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (fe_inv_env bt bs) le m
         (Clight.fn_body jets_secp.f_secp256k1_fe_inv_var) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_secp_fe_inv_statements.fe_inv_entry
fe_inv_entry
     : forall (m : Memory.Mem.mem) (mt mi : Memory.Mem.mem') (bt bs bd bx : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mt bt))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc mt BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mi bs)),
       Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_fe_inv_var
         (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
            (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero) (@nil Values.val))) m (fe_inv_env bt bs)
         (fe_inv_entry_temps bd bx) mi
### C.jet_secp_fe_inv_statements.fe_inv_env
fe_inv_env =
fun bt bs : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._s
  (@pair Values.block Ctypes.type bs (Ctypes.Tstruct jets_secp._secp256k1_modinv64_signed62 Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_secp._tmp
     (@pair Values.block Ctypes.type bt jet_secp_curve_statements.curve_fe_type) Clight.empty_env)
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments fe_inv_env bt bs
### C.jet_secp_fe_inv_statements.fe_inv_tmp_address
fe_inv_tmp_address =
Clight.Eaddrof (Clight.Evar jets_secp._tmp jet_secp_curve_statements.curve_fe_type)
  (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type)
     : Clight.expr
### C.jet_secp_fe_inv_statements.fe_inv_s_address
fe_inv_s_address =
Clight.Eaddrof (Clight.Evar jets_secp._s (Ctypes.Tstruct jets_secp._secp256k1_modinv64_signed62 Ctypes.noattr))
  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._secp256k1_modinv64_signed62 Ctypes.noattr))
     : Clight.expr
### C.jet_secp_fe_inv_statements.fe_inv_copy
fe_inv_copy =
Clight.Sassign (Clight.Evar jets_secp._tmp jet_secp_curve_statements.curve_fe_type)
  (Clight.Ederef (Clight.Etempvar jets_secp._x (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
     jet_secp_curve_statements.curve_fe_type)
     : Clight.statement
### C.jet_secp_fe_inv_statements.fe_inv_normalize
fe_inv_normalize =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_normalize_var jets_secp.f_secp256k1_fe_normalize_var
  (@None AST.ident) (@cons Clight.expr fe_inv_tmp_address (@nil Clight.expr))
     : Clight.statement
### C.jet_secp_fe_inv_statements.fe_inv_pack
fe_inv_pack =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_to_signed62 jets_secp.f_secp256k1_fe_to_signed62
  (@None AST.ident) (@cons Clight.expr fe_inv_s_address (@cons Clight.expr fe_inv_tmp_address (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_fe_inv_statements.fe_inv_inverse
fe_inv_inverse =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_modinv64_var jets_secp.f_secp256k1_modinv64_var
  (@None AST.ident)
  (@cons Clight.expr fe_inv_s_address
     (@cons Clight.expr
        (Clight.Eaddrof
           (Clight.Evar jets_secp._secp256k1_const_modinfo_fe
              (Ctypes.Tstruct jets_secp._secp256k1_modinv64_modinfo Ctypes.noattr))
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._secp256k1_modinv64_modinfo Ctypes.noattr)))
        (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_fe_inv_statements.fe_inv_unpack
fe_inv_unpack =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_from_signed62 jets_secp.f_secp256k1_fe_from_signed62
  (@None AST.ident)
  (@cons Clight.expr (Clight.Etempvar jets_secp._r (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
     (@cons Clight.expr fe_inv_s_address (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_fe_inv_statements.fe_inv_body
fe_inv_body =
Clight.Ssequence fe_inv_copy
  (Clight.Ssequence fe_inv_normalize (Clight.Ssequence fe_inv_pack (Clight.Ssequence fe_inv_inverse fe_inv_unpack)))
     : Clight.statement
### C.jet_secp_fe_inv_statements.fe_inv_entry_temps
fe_inv_entry_temps =
fun bd bx : Values.block =>
@Maps.PTree.set Values.val jets_secp._x (Values.Vptr bx Integers.Ptrofs.zero)
  (@Maps.PTree.set Values.val jets_secp._r (Values.Vptr bd Integers.Ptrofs.zero)
     (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_fe_inv_var)))
     : forall (_ : Values.block) (_ : Values.block), Maps.PTree.tree Values.val

Arguments fe_inv_entry_temps bd bx
