### C.jet_elements_output_nonce_literal.native_hash_word_literal_matches
native_hash_word_literal_matches
     : forall h : Digest.hash256,
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (native_hash_word_literal h) (Word.from_hash256 h)
### C.jet_elements_output_nonce_literal.encode_nonce_literal_matches
encode_nonce_literal_matches
     : forall n : option jet_elements_prim.nonce,
       @eq
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) (jet_elements_asset_jets.encode_nonce n)
         (encode_nonce_literal n)
### C.jet_elements_output_nonce_literal.word_indexed_value_literal_matches
@word_indexed_value_literal_matches
     : forall (A : Type) (B : Ty.Ty) (depth : nat) (enc literal : forall _ : A, Ty.tySem B)
         (values : list A) (a : Ty.tySem (Word.ToZ.obj (Word.WordToZ depth)))
         (_ : forall x : A, @eq (Ty.tySem B) (enc x) (literal x)),
       @eq (option (sum unit (Ty.tySem B)))
         (@Some (sum unit (Ty.tySem B))
            match
              @List.nth_error A values (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ depth) a))
              return (sum unit (Ty.tySem B))
            with
            | Some v => @inr unit (Ty.tySem B) (enc v)
            | None => @inl unit (Ty.tySem B) tt
            end) (@word_indexed_value_literal A B depth literal values a)
### C.jet_elements_output_nonce_literal.output_nonce_literal_index_range
output_nonce_literal_index_range
     : forall a : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
