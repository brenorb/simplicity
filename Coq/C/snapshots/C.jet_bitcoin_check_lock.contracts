bitcoin_check_lock_program =
fun (height : bool) (alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra) =>
@jet_bitcoin_current_spec.bitcoin_assert_spec alg (Word.Word (S (S (S (S (S O)))))) Ty.Unit
  (@jet_bitcoin_current_spec.bitcoin_comp alg (Word.Word (S (S (S (S (S O))))))
     (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) (Ty.Sum Ty.Unit Ty.Unit)
     (@jet_bitcoin_distance_spec.bitcoin_pair alg (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
        (Word.Word (S (S (S (S (S O))))))
        (@jet_bitcoin_distance_spec.bitcoin_core (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))
           (fun alg0 : Alg.Core.Algebra => @jet_bitcoin_distance_spec.DC.iden (Word.Word (S (S (S (S (S O)))))) alg0)
           alg)
        (@jet_bitcoin_current_spec.bitcoin_comp alg (Word.Word (S (S (S (S (S O)))))) Ty.Unit
           (Word.Word (S (S (S (S (S O))))))
           (@jet_bitcoin_distance_spec.bitcoin_core (Word.Word (S (S (S (S (S O)))))) Ty.Unit
              (fun alg0 : Alg.Core.Algebra => @jet_bitcoin_distance_spec.DC.unit (Word.Word (S (S (S (S (S O)))))) alg0)
              alg)
           (@jet_bitcoin_lock_spec.lock_program height
              (Bitcoin.PrimitiveBitcoin.Primitive.CanonicalStructures.toCore alg)
              (@jet_bitcoin_is_final_spec.bitcoin_tx_is_final_spec alg)
              (@jet_bitcoin_lock_spec.bitcoin_lock_time_prim alg))))
     (@jet_bitcoin_distance_spec.bitcoin_core
        (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) (Ty.Sum Ty.Unit Ty.Unit)
        (fun alg0 : Alg.Core.Algebra => @jet_order_spec.le_word_spec alg0 (S (S (S (S (S O)))))) alg))
     : forall (_ : bool) (alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra),
       Bitcoin.PrimitiveBitcoin.Primitive.domain alg (Word.Word (S (S (S (S (S O)))))) Ty.Unit

