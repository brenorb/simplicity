### C.jet_secp_point_zero_owned.point_canonical_write_rho
point_canonical_write_rho
     : forall value rc : BinNums.Z,
       @eq (forall _ : nat, Integers.Int64.int)
         (jet_secp_write_fe_wide_values.wide_fe_rho (jet_secp_b32_exec.limb_rho value O)
            (jet_secp_b32_exec.limb_rho value (S O)) (jet_secp_b32_exec.limb_rho value (S (S O)))
            (jet_secp_b32_exec.limb_rho value (S (S (S O)))) (jet_secp_b32_exec.limb_rho value (S (S (S (S O))))) rc)
         (jet_secp_write_fe_numeric.write_fe_rho value rc)
### C.jet_secp_point_zero_owned.point_zero_initial_rep
point_zero_initial_rep
     : forall (k : jet_secp_point_write_run.point_coordinate) (value rc : BinNums.Z) (m : Memory.Mem.mem)
         (b : Values.block)
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset k)
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (jet_secp_fe_math.fe_limbs_of value)))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       jet_sx_state.rep (jet_secp_write_fe_numeric.write_fe_rho value rc)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@nil (prod Values.block BinNums.Z))) (jet_secp_point_write_run.point_write_initial_regs k) m
### C.jet_secp_point_zero_owned.eval_point_zero_canonical
eval_point_zero_canonical
     : forall (k : jet_secp_point_write_run.point_coordinate) (m : Memory.Mem.mem) (b : Values.block)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_fe_nv.fe_at m b (jet_secp_point_write_run.point_coordinate_offset k)
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_fe_math.fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem value)))))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_zero)
               (@cons Values.val
                  (Values.Vptr b (Integers.Ptrofs.repr (jet_secp_point_write_run.point_coordinate_offset k)))
                  (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  (jet_readBit_layout.bit_int
                     (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem value)))))
            (and
               (Memory.Mem.range_perm mf b BinNums.Z0
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  Memtype.Cur Memtype.Freeable)
               (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf)))
