### C.jet_elements_taptweak_load_function.elements_taptweak_load_blocks
elements_taptweak_load_blocks
     : forall bs bx b_y : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_taptweak_pure.elements_taptweak_ge
            (jet_secp_pubkey_load_entry.pubkey_load_env bs bx b_y))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bs BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z b_y BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                  (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))
### C.jet_elements_taptweak_load_function.elements_taptweak_load_entry_owned
elements_taptweak_load_entry_owned
     : forall (m : Memory.Mem.mem) (out key : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bs : Values.block =>
             @ex Values.block
               (fun bx : Values.block =>
                @ex Values.block
                  (fun b_y : Values.block =>
                   and
                     (Clight.function_entry2 jet_elements_taptweak_pure.elements_taptweak_ge
                        jets_secp.f_secp256k1_pubkey_load
                        (@cons Values.val out (@cons Values.val key (@nil Values.val))) m
                        (jet_secp_pubkey_load_entry.pubkey_load_env bs bx b_y)
                        (jet_secp_pubkey_load_entry.pubkey_load_temps out key) mi)
                     (and
                        (@List.NoDup Values.block
                           (@cons Values.block bs (@cons Values.block bx (@cons Values.block b_y (@nil Values.block)))))
                        (and
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                            not
                              (@List.In Values.block b
                                 (@cons Values.block bs
                                    (@cons Values.block bx (@cons Values.block b_y (@nil Values.block))))))
                           (and
                              (forall (b : Values.block) (hi : BinNums.Z)
                                 (_ : @List.In (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b hi)
                                        (@cons (prod Values.block BinNums.Z)
                                           (@pair Values.block BinNums.Z bs
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                           (@cons (prod Values.block BinNums.Z)
                                              (@pair Values.block BinNums.Z bx
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                              (@cons (prod Values.block BinNums.Z)
                                                 (@pair Values.block BinNums.Z b_y
                                                    (BinNums.Zpos
                                                       (BinNums.xO
                                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                                 (@nil (prod Values.block BinNums.Z)))))),
                               Memory.Mem.range_perm mi b BinNums.Z0 hi Memtype.Cur Memtype.Freeable)
                              (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                                 (and (jet_clight_internal_permissions.keeps_permissions m mi)
                                    (jet_clight_internal_preserve.readonly_preserved m mi))))))))))
### C.jet_elements_taptweak_load_function.eval_elements_taptweak_pubkey_load
eval_elements_taptweak_pubkey_load
     : forall (_ : jet_memcpy_model.memcpy_model) (w : forall _ : nat, Integers.Int64.int)
         (m : Memory.Mem.mem) (bin : Values.block) (base : BinNums.Z) (bout : Values.block)
         (_ : Memory.Mem.range_perm m bout BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : jet_secp_affine_storage.affine_storage_readable m bin base w),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_pubkey_load)
               (@cons Values.val (Values.Vptr bout Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               (Values.Vint (jet_readBit_layout.bit_int (jet_secp_pubkey_load_body.pubkey_storage_accept w))))
            (and
               (forall k : bool,
                jet_secp_fe_nv.fe_at mf bout
                  match k return BinNums.Z with
                  | true => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
                  | false => BinNums.Z0
                  end (jet_secp_multiply_normalize_bridge.words5 (jet_secp_affine_storage.affine_storage_coord w k)))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint32 mf bout
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@Some Values.val (Values.Vint Integers.Int.zero)))
                  (and
                     (Memory.Mem.range_perm mf bout BinNums.Z0
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b bout)) m
                           mf) (jet_clight_internal_preserve.readonly_preserved m mf))))))
