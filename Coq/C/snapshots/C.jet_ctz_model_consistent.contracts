### C.jet_ctz_model_consistent.ctz_value
ctz_value =
fun x : Integers.Int64.int =>
match Integers.Int64.eq x Integers.Int64.zero return (option Integers.Int.int) with
| true => @None Integers.Int.int
| false => @Some Integers.Int.int (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned x)))
end
     : forall _ : Integers.Int64.int, option Integers.Int.int

Arguments ctz_value x
