         (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word O))
         (Ty.Prod (Word.Word O) (Word.Word (S (S (S (S (S (S O))))))))
         (@Word.full_left_shift1 (Word.Word O) (S (S (S (S (S (S O)))))) Alg.CoreFunSem)
