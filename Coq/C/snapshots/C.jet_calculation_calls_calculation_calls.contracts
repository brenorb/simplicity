### C.jet_calculation_calls_calculation_calls.elements_calculation_dispatch_sha
elements_calculation_dispatch_sha
     : forall (m : Memory.Mem.mem) (_ : elements_calculation_dispatch_ok m),
       jet_elements_support_sha_block_local.sha_dispatch_ok m
### C.jet_calculation_calls_calculation_calls.calculation_words_nth
calculation_words_nth
     : forall (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
         (_ : jet_uint32_array_init.uint32_array_at m b base xs)
         (_ : @eq nat (@length Integers.Int.int xs) (S (S (S (S (S (S (S (S O))))))))) (j : nat)
         (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint32 m b
            (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
         (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j xs Integers.Int.zero)))
### C.jet_calculation_calls_calculation_calls.calculation_words_array
calculation_words_array
     : forall (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int xs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m b
                   (BinInt.Z.add base
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j xs Integers.Int.zero)))),
       jet_uint32_array_init.uint32_array_at m b base xs
### C.jet_calculation_calls_calculation_calls.elements_calculate_asset_word_call
elements_calculate_asset_word_call
     : forall _ : jet_memcpy_model.memcpy_model,
       elements_calculation_word_call jets_elements.f_simplicity_calculateAsset (@nil Values.val)
         (@jet_elements_issuance_calc_spec.calculate_asset_spec Alg.CoreFunSem)
### C.jet_calculation_calls_calculation_calls.elements_calculate_token_word_call
elements_calculate_token_word_call
     : forall (_ : jet_memcpy_model.memcpy_model) (pfx : Integers.Int.int)
         (spec : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
                 Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : forall h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
              @eq SHA256.registers (Digest.hash256_reg (Word.to_hash256 (spec h)))
                (jet_elements_calculate_token_exec.calc_token_regs (Digest.hash256_reg (Word.to_hash256 h)) pfx)),
       elements_calculation_word_call jets_elements.f_simplicity_calculateToken
         (@cons Values.val (Values.Vint pfx) (@nil Values.val)) spec
### C.jet_calculation_calls_calculation_calls.elements_calculate_explicit_token_word_call
elements_calculate_explicit_token_word_call
     : forall _ : jet_memcpy_model.memcpy_model,
       elements_calculation_word_call jets_elements.f_simplicity_calculateToken
         (@cons Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos BinNums.xH))) (@nil Values.val))
         (@jet_elements_issuance_calc_spec.calculate_explicit_token_spec Alg.CoreFunSem)
### C.jet_calculation_calls_calculation_calls.elements_calculate_confidential_token_word_call
elements_calculate_confidential_token_word_call
     : forall _ : jet_memcpy_model.memcpy_model,
       elements_calculation_word_call jets_elements.f_simplicity_calculateToken
         (@cons Values.val (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH)))) (@nil Values.val))
         (@jet_elements_issuance_calc_spec.calculate_confidential_token_spec Alg.CoreFunSem)
### C.jet_calculation_calls_calculation_calls.elements_calculation_dispatch_ok
elements_calculation_dispatch_ok =
fun m : Memory.Mem.mem =>
@eq (option Values.val)
  (Memory.Mem.load AST.Mptr m (jet_elements_linkage.elements_symbol_block jets_elements._simplicity_sha256_compression)
     BinNums.Z0)
  (@Some Values.val
     (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._sha256_compression_portable)
        Integers.Ptrofs.zero))
     : forall _ : Memory.Mem.mem, Prop

Arguments elements_calculation_dispatch_ok m
### C.jet_calculation_calls_calculation_calls.calculation_word_post
calculation_word_post =
fun
  (spec : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
          Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m mf : Memory.Mem.mem) (bres : Values.block)
  (ores : BinNums.Z) =>
and (jet_uint32_array_init.uint32_array_at mf bres ores (Digest.hash256_reg (Word.to_hash256 (spec h))))
  (and
     (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
        (_ : or (not (@eq Values.block b bres))
               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) ores)
                  (BinInt.Z.le
                     (BinInt.Z.add ores
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) ofs))),
      @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))
     (and
        (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
           (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm mf b ofs k p)
        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))
     : forall
         (_ : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
              Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : Memory.Mem.mem)
         (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments calculation_word_post spec%function_scope h m mf bres ores%Z_scope
### C.jet_calculation_calls_calculation_calls.elements_calculation_word_call
elements_calculation_word_call =
fun (f : Clight.function) (suffix : list Values.val)
  (spec : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
          Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
forall (m : Memory.Mem.mem) (bres : Values.block) (ores : BinNums.Z) (bent : Values.block)
  (oent : Integers.Ptrofs.int) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (_ : BinInt.Z.le BinNums.Z0 ores)
  (_ : BinInt.Z.le
         (BinInt.Z.add ores (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) ores)
  (_ : Memory.Mem.range_perm m bres ores
         (BinInt.Z.add ores (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         Memtype.Cur Memtype.Writable)
  (_ : BinInt.Z.le
         (BinInt.Z.add (Integers.Ptrofs.unsigned oent)
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         Integers.Ptrofs.max_unsigned)
  (_ : jet_uint32_array_init.uint32_array_at m bent (Integers.Ptrofs.unsigned oent)
         (Digest.hash256_reg (Word.to_hash256 h))) (_ : elements_calculation_dispatch_ok m),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m (@Ctypes.Internal Clight.function f)
        (@app Values.val
           (@cons Values.val (Values.Vptr bres (Integers.Ptrofs.repr ores))
              (@cons Values.val (Values.Vptr bent oent) (@nil Values.val))) suffix) Events.E0 mf Values.Vundef)
     (calculation_word_post spec h m mf bres ores))
     : forall (_ : Clight.function) (_ : list Values.val)
         (_ : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
              Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), Prop

Arguments elements_calculation_word_call f suffix%list_scope spec%function_scope
