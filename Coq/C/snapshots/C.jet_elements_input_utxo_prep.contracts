                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     (let rec : Ty.Ty :=
                        let rec : Ty.Ty :=
                          let rec : Ty.Ty :=
                            let rec : Ty.Ty :=
                              let rec : Ty.Ty :=
                                let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                                Ty.Prod rec rec in
                              Ty.Prod rec rec in
                            Ty.Prod rec rec in
                          Ty.Prod rec rec in
                        Ty.Prod rec rec in
                      Ty.Prod rec rec))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end)
                     (let rec : Ty.Ty :=
                        let rec : Ty.Ty :=
                          let rec : Ty.Ty :=
                            let rec : Ty.Ty :=
                              let rec : Ty.Ty :=
                                let rec : Ty.Ty := let rec : Ty.Ty := Ty.Sum Ty.Unit Ty.Unit in Ty.Prod rec rec in
                                Ty.Prod rec rec in
                              Ty.Prod rec rec in
                            Ty.Prod rec rec in
                          Ty.Prod rec rec in
                        Ty.Prod rec rec in
                      Ty.Prod rec rec))) tt))
         (@app (option bool) (@cons (option bool) (@Some bool false) (@nil (option bool)))
            (@List.repeat (option bool) (@None bool)
               (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))))
