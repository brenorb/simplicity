### C.jet_secp_mixed_function_ratio.mixed_body_ratio_words
mixed_body_ratio_words =
fun (flag : Integers.Int.int) (x y z u v : forall _ : nat, Integers.Int64.int) =>
match Integers.Int.eq flag Integers.Int.zero return (forall _ : nat, Integers.Int64.int) with
| true => jet_secp_mixed_finite_ratio.mixed_finite_ratio_words x y z u v
| false => jet_secp_mixed_ratio_branches.zero_words
end
     : forall (_ : Integers.Int.int) (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, Integers.Int64.int)
