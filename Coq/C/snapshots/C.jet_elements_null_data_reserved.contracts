### C.jet_elements_null_data_reserved.elements_find_skip_prefix
elements_find_skip_prefix =
fix elements_find_skip_prefix (n : Integers.Int.int) (s : Clight.statement) {struct s} : option Clight.statement :=
  match s return (option Clight.statement) with
  | Clight.Sskip => @None Clight.statement
  | Clight.Sassign _ _ => @None Clight.statement
  | Clight.Sset _ _ => @None Clight.statement
  | Clight.Scall _ _ _ => @None Clight.statement
  | Clight.Sbuiltin _ _ _ _ => @None Clight.statement
  | Clight.Ssequence a b =>
      match a return (option Clight.statement) with
      | Clight.Sskip =>
          jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
            (elements_find_skip_prefix n b)
      | Clight.Sassign _ _ =>
          jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
            (elements_find_skip_prefix n b)
      | Clight.Sset _ _ =>
          jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
            (elements_find_skip_prefix n b)
      | Clight.Scall o e l =>
          match o return (option Clight.statement) with
          | Some _ =>
              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                (elements_find_skip_prefix n b)
          | None =>
              match e return (option Clight.statement) with
              | Clight.Econst_int _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Econst_float _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Econst_single _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Econst_long _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Evar id _ =>
                  match l return (option Clight.statement) with
                  | nil =>
                      jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                        (elements_find_skip_prefix n b)
                  | cons _ l0 =>
                      match l0 return (option Clight.statement) with
                      | nil =>
                          jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                            (elements_find_skip_prefix n b)
                      | cons e1 l1 =>
                          match e1 return (option Clight.statement) with
                          | Clight.Econst_int v _ =>
                              match l1 return (option Clight.statement) with
                              | nil =>
                                  match
                                    andb (BinPos.Pos.eqb id jets_elements._skipBits) (Integers.Int.eq n v)
                                    return (option Clight.statement)
                                  with
                                  | true => @Some Clight.statement s
                                  | false =>
                                      jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                        (elements_find_skip_prefix n b)
                                  end
                              | cons _ _ =>
                                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                    (elements_find_skip_prefix n b)
                              end
                          | Clight.Econst_float _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Econst_single _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Econst_long _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Evar _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Etempvar _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Ederef _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Eaddrof _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Eunop _ _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Ebinop _ _ _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Ecast _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Efield _ _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Esizeof _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          | Clight.Ealignof _ _ =>
                              jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                                (elements_find_skip_prefix n b)
                          end
                      end
                  end
              | Clight.Etempvar _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Ederef _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Eaddrof _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Eunop _ _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Ebinop _ _ _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Ecast _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
              | Clight.Efield _ _ _ =>
                  jet_elements_null_data_small.elements_stmt_first (elements_find_skip_prefix n a)
                    (elements_find_skip_prefix n b)
