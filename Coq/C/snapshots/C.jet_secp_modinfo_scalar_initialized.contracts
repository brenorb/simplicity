### C.jet_secp_modinfo_scalar_initialized.modinfo_scalar_initial_bounds
modinfo_scalar_initial_bounds
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       jet_clight_readonly_frame.readonly_region_bounds m jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block
         BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
### C.jet_secp_modinfo_scalar_initialized.modinfo_scalar_initialized_from_init
modinfo_scalar_initialized_from_init
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       modinfo_scalar_initialized m
### C.jet_secp_modinfo_scalar_initialized.modinfo_scalar_initialized_exists
modinfo_scalar_initialized_exists
     : @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                  (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m))
            (modinfo_scalar_initialized m))
### C.jet_secp_modinfo_scalar_initialized.modinfo_scalar_initialized_state
modinfo_scalar_initialized_state
     : forall (m : Memory.Mem.mem) (_ : modinfo_scalar_initialized m),
       jet_secp_modinfo_scalar_global.modinfo_scalar_state m
### C.jet_secp_modinfo_scalar_initialized.modinfo_scalar_words_readable
modinfo_scalar_words_readable
     : forall (m : Memory.Mem.mem)
         (_ : forall (i : nat) (w : Integers.Int64.int)
                (_ : @eq (option Integers.Int64.int)
                       (@List.nth_error Integers.Int64.int jet_secp_modinfo_scalar_global.modinfo_scalar_words i)
                       (@Some Integers.Int64.int w)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vlong w))),
       Memory.Mem.range_perm m jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block BinNums.Z0
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))) Memtype.Cur
         Memtype.Readable
### C.jet_secp_modinfo_scalar_initialized.modinfo_scalar_initialized_old_blocks
modinfo_scalar_initialized_old_blocks
     : forall (m mf : Memory.Mem.mem) (_ : modinfo_scalar_initialized m)
         (_ : forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
              and (Memory.Mem.valid_block mf b)
                (and
                   (forall (chunk : AST.memory_chunk) (ofs : BinNums.Z),
                    @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                   (forall (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                      (_ : Memory.Mem.perm mf b ofs k p), Memory.Mem.perm m b ofs k p))), modinfo_scalar_initialized mf
### C.jet_secp_modinfo_scalar_initialized.modinfo_scalar_initialized
modinfo_scalar_initialized =
fun m : Memory.Mem.mem =>
and (jet_secp_modinfo_scalar_global.modinfo_scalar_global_rep m)
  (jet_clight_readonly_frame.readonly_region_bounds m jet_secp_scalar_inverse_caller.scalar_inv_modinfo_block
     BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
     : forall _ : Memory.Mem.mem, Prop

Arguments modinfo_scalar_initialized m
