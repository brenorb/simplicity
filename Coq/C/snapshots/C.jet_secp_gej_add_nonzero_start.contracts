### C.jet_secp_gej_add_nonzero_start.gej_add_t_mul
gej_add_t_mul =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._t)
     (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._h)
        (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._b jets_secp._z)
           (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_gej_add_nonzero_start.gej_add_null_ratio
gej_add_null_ratio =
Clight.Sifthenelse jet_secp_double_var_statements.double_var_null_test
  (Clight.Sassign
     (Clight.Ederef (Clight.Etempvar jets_secp._rzr (Ctypesdefs.tptr jet_secp_curve_statements.curve_fe_type))
        jet_secp_curve_statements.curve_fe_type) (Clight.Evar jets_secp._t jet_secp_curve_statements.curve_fe_type))
  Clight.Sskip
     : Clight.statement
### C.jet_secp_gej_add_nonzero_start.gej_add_z_mul
gej_add_z_mul =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._r jets_secp._z)
     (@cons Clight.expr (jet_secp_double_statements.double_point_address jets_secp._a jets_secp._z)
        (@cons Clight.expr (jet_secp_curve_statements.curve_local_address jets_secp._t) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_gej_add_nonzero_start.gej_add_nonzero_start_statements
gej_add_nonzero_start_statements =
@cons Clight.statement jet_secp_mixed_nonzero_start.mixed_clear_flag
  (@cons Clight.statement gej_add_t_mul
     (@cons Clight.statement gej_add_null_ratio
        (@cons Clight.statement gej_add_z_mul
           (@cons Clight.statement jet_secp_mixed_nonzero_start.mixed_h_square (@nil Clight.statement)))))
     : list Clight.statement
### C.jet_secp_gej_add_nonzero_start.gej_add_nonzero_start_frame
gej_add_nonzero_start_frame =
fun (pa pb bh bt b2 bx : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block bx pa))
  (and (not (@eq Values.block bx pb))
     (and (not (@eq Values.block bx bh)) (and (not (@eq Values.block bx bt)) (not (@eq Values.block bx b2)))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments gej_add_nonzero_start_frame pa pb bh bt b2 bx _%Z_scope
### C.jet_secp_gej_add_nonzero_start.gej_add_nonzero_prefix_statements
gej_add_nonzero_prefix_statements =
@cons Clight.statement jet_secp_mixed_zero.mixed_zero_head gej_add_nonzero_start_statements
     : list Clight.statement
