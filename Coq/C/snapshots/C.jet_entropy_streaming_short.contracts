### C.jet_entropy_streaming_short.stream_entropy_registers
stream_entropy_registers
     : forall (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (ix : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
         (contract : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       @eq (list Integers.Int.int)
         (jet_elements_env_entropy.entropy_regs (Digest.hash256_reg (Word.to_hash256 h))
            (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) ix))
            (Digest.hash256_reg (Word.to_hash256 contract)))
         (Digest.hash256_reg
            (Word.to_hash256
               (@jet_elements_issuance_calc_spec.calculate_issuance_entropy_spec Alg.CoreFunSem
                  (@pair
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))) h ix) contract))))
