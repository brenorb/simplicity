### C.jet_equality8_exec.eq8_denotes
eq8_denotes
     : forall w z : Integers.Int64.int,
       @eq bool (eq8_bit (jet_read8.read8_result w) (jet_read8.read8_result z))
         (Bit.toBool
            (@jet_equality_spec.equality_spec (Word.Word (S (S (S O)))) Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))
                  (jet_spec.decode_word8 w) (jet_spec.decode_word8 z))))
### C.jet_equality8_exec.eq8_expr
eq8_expr =
Clight.Ebinop Cop.Oeq (Clight.Etempvar jets._x Ctypesdefs.tuchar) (Clight.Etempvar jets._y Ctypesdefs.tuchar)
  Ctypesdefs.tint
     : Clight.expr
### C.jet_equality8_exec.eq8_bit
eq8_bit =
fun r t : Integers.Int.int =>
Integers.Int.eq (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r)
  (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int), bool

Arguments eq8_bit r t
