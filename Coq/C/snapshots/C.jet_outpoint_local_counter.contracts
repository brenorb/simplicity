### C.jet_outpoint_local_counter.sha_chain_overflow
sha_chain_overflow
     : forall (c : Integers.Int64.int) (m n : BinNums.Z)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned c)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 m)
                (BinInt.Z.le m
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))),
       @eq bool
         (jet_elements_support_sha_uchars_exec.uc_overflow
            (jet_elements_support_sha_uchars_exec.uc_overflow false c (Integers.Int64.repr m))
            (Integers.Int64.add c (Integers.Int64.repr m)) (Integers.Int64.repr n))
         (jet_elements_support_sha_uchars_exec.uc_overflow false c (Integers.Int64.repr (BinInt.Z.add m n)))
### C.jet_outpoint_local_counter.op_counter_total
op_counter_total
     : forall (c : Integers.Int64.int) (a : Ty.tySem jet_outpoint_middle_common.op_pegin_type),
       @eq Integers.Int64.int
         (Integers.Int64.add (Integers.Int64.add c (Integers.Int64.repr (jet_outpoint_middle_common.op_count a)))
            (Integers.Int64.repr
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (Integers.Int64.add c (Integers.Int64.repr (jet_outpoint_middle_common.op_total_count a)))
### C.jet_outpoint_local_counter.op_overflow_total
op_overflow_total
     : forall (c : Integers.Int64.int) (a : Ty.tySem jet_outpoint_middle_common.op_pegin_type)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned c)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))))),
       @eq bool
         (jet_elements_support_sha_uchars_exec.uc_overflow (jet_outpoint_middle_common.op_overflow false c a)
            (Integers.Int64.add c (Integers.Int64.repr (jet_outpoint_middle_common.op_count a)))
            (Integers.Int64.repr
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (jet_elements_support_sha_uchars_exec.uc_overflow false c
            (Integers.Int64.repr (jet_outpoint_middle_common.op_total_count a)))
