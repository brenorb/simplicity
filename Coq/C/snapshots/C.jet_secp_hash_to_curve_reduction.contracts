### C.jet_secp_hash_to_curve_reduction.hash_ready_initial
hash_ready_initial
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function jets_secp.prog)) (@Some Memory.Mem.mem m)),
       hash_ready m
### C.jet_secp_hash_to_curve_reduction.small_block_write_separate
small_block_write_separate
     : forall (m : Memory.Mem.mem) (bg : Values.block) (hi : BinNums.Z) (bd : Values.block)
         (base : BinNums.Z) (bw : Values.block) (edge cursor N : BinNums.Z)
         (_ : BinInt.Z.le hi (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))
         (_ : BinInt.Z.lt
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                N) (_ : jet_secp_taptweak_writer_state.block_extent m bg hi)
         (_ : jet_output_layout.write_frame_at m bd base bw edge cursor N), not (@eq Values.block bw bg)
### C.jet_secp_hash_to_curve_reduction.secp_sha_startup_loads
secp_sha_startup_loads
     : forall (m mf : Memory.Mem.mem) (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : jet_clight_forward.mem_forward m mf)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr mf jet_secp_sha_startup.secp_sha_dispatch_block BinNums.Z0)
                (Memory.Mem.load AST.Mptr m jet_secp_sha_startup.secp_sha_dispatch_block BinNums.Z0))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mf jet_secp_sha_startup.secp_sha_counter_block BinNums.Z0)
                (Memory.Mem.load AST.Mint64 m jet_secp_sha_startup.secp_sha_counter_block BinNums.Z0)),
       jet_secp_sha_startup.secp_sha_startup mf
### C.jet_secp_hash_to_curve_reduction.hash_return_agreement_iff
hash_return_agreement_iff
     : forall (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (spec : option
                   (Ty.tySem
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) (flag : Integers.Int.int)
         (ox oy : forall _ : nat, Integers.Int64.int)
         (_ : @eq
                (option
                   (Ty.tySem
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) spec
                match
                  andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                    (jet_secp_generator_hash_map.generator_hash_accepted true key)
                  return
                    (option
                       (Ty.tySem
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                             (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                with
                | true =>
                    match
                      Integers.Int.eq flag Integers.Int.zero
                      return
                        (option
                           (Ty.tySem
                              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                    with
                    | true =>
                        @Some
                          (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                          (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                             (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                             (jet_secp_rescale_literal.rescale_field_output ox)
                             (jet_secp_rescale_literal.rescale_field_output oy))
                    | false =>
                        @None
                          (Ty.tySem
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    end
                | false =>
                    @None
                      (Ty.tySem
                         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                            (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                end),
       iff
         (@eq Values.val
            (Values.Vint
               (jet_secp_field_cmov.cmov_int
                  (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                     (jet_secp_generator_hash_map.generator_hash_accepted true key))))
            (@jet_partial.jet_partial_return
               (Ty.tySem
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               spec))
         (forall
            _ : @eq bool
                  (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                     (jet_secp_generator_hash_map.generator_hash_accepted true key)) true,
          not
            (@eq
               (option
                  (Ty.tySem
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) spec
               (@None
                  (Ty.tySem
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O))))))))))))))
### C.jet_secp_hash_to_curve_reduction.hash_to_curve_public_compared
hash_to_curve_public_compared
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_ctz_model.ctz_model) (env : Values.val)
         (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bi bw : Values.block) (edge outedge cursor rc : BinNums.Z)
         (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : hash_ready m)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) key))
         (_ : jet_output_layout.write_frame_at m bd base bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_hash_to_curve)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf
               (Values.Vint
                  (jet_secp_field_cmov.cmov_int
                     (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                        (jet_secp_generator_hash_map.generator_hash_accepted true key)))))
            (and
               (iff
                  (@eq Values.val
                     (Values.Vint
                        (jet_secp_field_cmov.cmov_int
                           (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                              (jet_secp_generator_hash_map.generator_hash_accepted true key))))
                     (@jet_partial.jet_partial_return
                        (Ty.tySem
                           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                              (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                        (@jet_secp_hash_to_curve_spec.literal_hash_to_curve (Alg.AssertionSem Option.option_Monad_Zero)
                           key)))
                  (forall
                     _ : @eq bool
                           (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                              (jet_secp_generator_hash_map.generator_hash_accepted true key)) true,
                   not
                     (@eq
                        (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                           (Ty.tySem
                              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                        (@jet_secp_hash_to_curve_spec.literal_hash_to_curve (Alg.AssertionSem Option.option_Monad_Zero)
                           key)
                        (@None
                           (Ty.tySem
                              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                 (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))))
               (and
                  (forall
                     (_ : @eq bool
                            (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                               (jet_secp_generator_hash_map.generator_hash_accepted true key)) true)
                     (_ : not
                            (@eq
                               (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                                  (Ty.tySem
                                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                        (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                               (@jet_secp_hash_to_curve_spec.literal_hash_to_curve
                                  (Alg.AssertionSem Option.option_Monad_Zero) key)
                               (@None
                                  (Ty.tySem
                                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))),
                   match
                     @jet_secp_hash_to_curve_spec.literal_hash_to_curve (Alg.AssertionSem Option.option_Monad_Zero) key
                     return Prop
                   with
                   | Some value =>
                       and
                         (jet_encoding.frame_output_cells_at mf bw outedge cursor
                            (@Translate.encode
                               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                  (Word.Word (S (S (S (S (S (S (S (S O)))))))))) value))
                         (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                            (jet_frame_layout.frame_fields_at mf bd base bw outedge
                               (BinInt.Z.sub cursor
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))
                   | None => True
                   end)
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (hash_ready mf)))))
### C.jet_secp_hash_to_curve_reduction.hash_to_curve_initialized_local_spec_if_finite
hash_to_curve_initialized_local_spec_if_finite
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_ctz_model.ctz_model) (_ : hash_to_curve_accepted_finite),
       jet_secp_initialized_partial_contract.secp_jet_initialized_partial_local_spec hash_ready
         jets_secp.f_simplicity_hash_to_curve (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@jet_secp_hash_to_curve_spec.literal_hash_to_curve (Alg.AssertionSem Option.option_Monad_Zero))
### C.jet_secp_hash_to_curve_reduction.hash_to_curve_differs_if_infinite
hash_to_curve_differs_if_infinite
     : forall (_ : jet_memcpy_model.memcpy_model) (_ : jet_ctz_model.ctz_model) (env : Values.val)
         (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bi bw : Values.block) (edge outedge cursor rc : BinNums.Z)
         (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool
                (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
                   (jet_secp_generator_hash_map.generator_hash_accepted true key)) true)
         (_ : @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                   (Ty.tySem
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                (@jet_secp_hash_to_curve_spec.literal_hash_to_curve (Alg.AssertionSem Option.option_Monad_Zero) key)
                (@None
                   (Ty.tySem
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) (_ : hash_ready m)
         (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) key))
         (_ : jet_output_layout.write_frame_at m bd base bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_hash_to_curve)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (@eq Values.val
               (@jet_partial.jet_partial_return
                  (Ty.tySem
                     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (@jet_secp_hash_to_curve_spec.literal_hash_to_curve (Alg.AssertionSem Option.option_Monad_Zero) key))
               (Values.Vint Integers.Int.zero)))
### C.jet_secp_hash_to_curve_reduction.hash_ready
hash_ready =
fun m : Memory.Mem.mem =>
and (jet_secp_sha_startup.secp_sha_startup m)
  (and (jet_secp_swu_startup.swu_startup m)
     (and (forall prefix : bool, jet_secp_generator_sha_absorb.generator_sha_prefix_state prefix m)
        (jet_secp_taptweak_writer_state.taptweak_dispatch_extent m)))
     : forall _ : Memory.Mem.mem, Prop

Arguments hash_ready m
### C.jet_secp_hash_to_curve_reduction.hash_to_curve_accepted_finite
hash_to_curve_accepted_finite =
forall (key : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (_ : @eq bool
         (andb (jet_secp_generator_hash_map.generator_hash_accepted false key)
            (jet_secp_generator_hash_map.generator_hash_accepted true key)) true),
not
  (@eq
     (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
        (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
     (@jet_secp_hash_to_curve_spec.literal_hash_to_curve (Alg.AssertionSem Option.option_Monad_Zero) key)
     (@None
        (Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
     : Prop
