### C.jet_sha256_count_assertion.sha256_count_check_spec
sha256_count_check_spec =
fun term : Alg.Core.Algebra =>
@AC.comp
  (Ty.Prod (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))) (Ty.Sum Ty.Unit Ty.Unit) term
  (@AC.pair
     (Ty.Prod (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))) term
     (@AC.drop (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S O))))))) term
        (@AC.take (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           (Word.Word (S (S (S (S (S (S O))))))) term (@AC.iden (Word.Word (S (S (S (S (S (S O))))))) term)))
     (@AC.comp
        (Ty.Prod (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
           (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S O))))))) term
        (@AC.unit
           (Ty.Prod (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) term)
        (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S O))))))) sha256_count_limit term)))
  (@jet_order_spec.lt_word_spec term (S (S (S (S (S (S O)))))))
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term jet_sha256_ctx8_init_spec.sha256_ctx8_type (Ty.Sum Ty.Unit Ty.Unit)

Arguments sha256_count_check_spec {term}
### C.jet_sha256_count_assertion.sha256_count_assertion_spec
sha256_count_assertion_spec =
fun term : Alg.Assertion.Algebra =>
@AC.comp jet_sha256_ctx8_init_spec.sha256_ctx8_type (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) Ty.Unit
  (Alg.Assertion.toCore term)
  (@AC.pair jet_sha256_ctx8_init_spec.sha256_ctx8_type (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit (Alg.Assertion.toCore term)
     (@sha256_count_check_spec (Alg.Assertion.toCore term))
     (@AC.unit jet_sha256_ctx8_init_spec.sha256_ctx8_type (Alg.Assertion.toCore term)))
  (@Alg.Assertion.Combinators.assertr Ty.Unit Ty.Unit Ty.Unit Ty.Unit term jet_assertion_spec.assertion_cmr_fail0
     (@AC.take Ty.Unit Ty.Unit Ty.Unit (Alg.Assertion.toCore term) (@AC.iden Ty.Unit (Alg.Assertion.toCore term))))
     : forall term : Alg.Assertion.Algebra,
       Alg.Assertion.domain term jet_sha256_ctx8_init_spec.sha256_ctx8_type Ty.Unit

Arguments sha256_count_assertion_spec {term}
