### C.jet_secp_table_normalized_step.table_point_residue
table_point_residue =
fun (n : nat) (x k : BinNums.Z)
  (p : Ty.tySem
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O))))))))))) =>
and
  (Zdiv.eqm jet_secp_fe_math.feP
     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
        (@fst
           (prod
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
           (prod
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
           (@fst
              (prod
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              (prod
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                        match n0 return Ty.Ty with
