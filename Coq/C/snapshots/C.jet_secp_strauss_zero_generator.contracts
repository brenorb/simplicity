strauss_zero_global_state =
fun m : Memory.Mem.mem =>
and
  (jet_secp_scalar_get_b32_storage.scalar_at m strauss_zero_block BinNums.Z0
     (@cons Integers.Int64.int Integers.Int64.zero
        (@cons Integers.Int64.int Integers.Int64.zero
           (@cons Integers.Int64.int Integers.Int64.zero
              (@cons Integers.Int64.int Integers.Int64.zero (@nil Integers.Int64.int))))))
  (jet_clight_readonly_frame.readonly_region_bounds m strauss_zero_block BinNums.Z0
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : forall _ : Memory.Mem.mem, Prop

Arguments strauss_zero_global_state m
### C.jet_secp_strauss_zero_generator.zero_scalar_state
zero_scalar_state =
fun (bng : Values.block) (m : Memory.Mem.mem) =>
and
  (jet_secp_scalar_get_b32_storage.scalar_at m bng BinNums.Z0
     (@cons Integers.Int64.int Integers.Int64.zero
        (@cons Integers.Int64.int Integers.Int64.zero
           (@cons Integers.Int64.int Integers.Int64.zero
              (@cons Integers.Int64.int Integers.Int64.zero (@nil Integers.Int64.int))))))
  (jet_clight_readonly_frame.readonly_region_bounds m bng BinNums.Z0
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : forall (_ : Values.block) (_ : Memory.Mem.mem), Prop

Arguments zero_scalar_state bng m
