### C.jet_secp_multiply_input_compose.two_field_foot_owner
two_field_foot_owner
     : forall (ba bb b : Values.block) (pos : BinNums.Z)
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   jet_secp_multiply_run_run.field_mul_regs) b pos), or (@eq Values.block b ba) (@eq Values.block b bb)
### C.jet_secp_multiply_input_compose.frame_fields_on_unchanged_block
frame_fields_on_unchanged_block
     : forall (m mf : Memory.Mem.mem) (bl bi : Values.block) (edge rc : BinNums.Z) (_ : Memory.Mem.valid_block m bl)
         (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : jet_sx_mem.lframe (fun (b : Values.block) (_ : BinNums.Z) => @eq Values.block b bl) m mf),
       jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge rc
### C.jet_secp_multiply_input_compose.eval_original_read_pair_mul_write
eval_original_read_pair_mul_write
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bb bl : Values.block) (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc
                (@Translate.encode
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : not (@eq Values.block ba bb)) (_ : not (@eq Values.block ba bl)) (_ : not (@eq Values.block bb bl))
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))))
         (_ : jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi m false (@nil BitMachine.Cell)),
       @ex Memory.Mem.mem
         (fun ma : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mm : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun mf : Memory.Mem.mem =>
                   and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                        (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                        (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ma
                        Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge ma
                           (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                           (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
                           Values.Vundef)
                        (and
                           (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mr
                              (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                              (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))))
                              Events.E0 mm Values.Vundef)
                           (and
                              (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mm
                                 (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                                 (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                                    (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)))
                                 Events.E0 mf Values.Vundef)
                              (and
                                 (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi mf true
                                    (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                       (jet_secp_multiply_input_input.input_product_word x y)))
                                 (and
                                    (Memory.Mem.range_perm mf ba BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (Memory.Mem.range_perm mf bb BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (Memory.Mem.range_perm mf bl BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                                                (BinInt.Z.add rc
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))
                                             (jet_sx_mem.lframe
                                                (jet_secp_multiply_input_pair.pair_locals_outside
                                                   (jet_secp_frame.extA m0 bd bw bi) ba bb bl) m mf)))))))))))))
