### C.jet_secp_affine_infinite.exec_affine_infinite_flag
exec_affine_infinite_flag
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bp br b2 b3 : Values.block)
         (flag : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr bp Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag))) (_ : not (@eq Integers.Int.int flag Integers.Int.zero))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_infinity)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_gej_affine_arithmetic.affine_local_env b2 b3)
         le m jet_secp_gej_affine_entry.affine_flag_statement Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint flag) le) mf
         (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type)))
### C.jet_secp_affine_infinite.eval_affine_infinite_owned
eval_affine_infinite_owned
     : forall (m : Memory.Mem.mem) (bp br : Values.block) (flag : Integers.Int.int) (_ : not (@eq Values.block bp br))
         (_ : not (@eq Integers.Int.int flag Integers.Int.zero))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint flag)))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_gej_var)
               (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                  (@List.repeat Integers.Int64.int Integers.Int64.zero (S (S (S (S (S O)))))))
               (and
                  (jet_secp_fe_nv.fe_at mf br
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (@List.repeat Integers.Int64.int Integers.Int64.zero (S (S (S (S (S O)))))))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf br
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.one)))
                     (and
                        (Memory.Mem.range_perm mf bp BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf br BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b br)) m mf)
                              (jet_clight_internal_preserve.readonly_preserved m mf))))))))
