exec_secp_sha_absorb_head
     : forall (used count : nat) (m : Memory.Mem.mem) (bc ba : Values.block) (oa : Integers.Ptrofs.int)
         (_ : lt used (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
