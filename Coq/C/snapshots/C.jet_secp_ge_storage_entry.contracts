### C.jet_secp_ge_storage_entry.ge_storage_ok
ge_storage_ok
     : @eq bool (jet_sx_exec.fn_okb jets_secp.f_secp256k1_ge_to_storage) true
### C.jet_secp_ge_storage_entry.ge_storage_blocks
ge_storage_blocks
     : forall bx b_y : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_secp_linkage.secp_ge (ge_storage_env bx b_y))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z b_y BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
### C.jet_secp_ge_storage_entry.ge_storage_plain
ge_storage_plain
     : forall bx b_y : Values.block, jet_clight_internal_frame.plain_env (ge_storage_env bx b_y)
### C.jet_secp_ge_storage_entry.ge_storage_entry_owned
ge_storage_entry_owned
     : forall (m : Memory.Mem.mem) (out point : Values.val),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bx : Values.block =>
             @ex Values.block
               (fun b_y : Values.block =>
                and
                  (Clight.function_entry2 jet_secp_linkage.secp_ge jets_secp.f_secp256k1_ge_to_storage
                     (@cons Values.val out (@cons Values.val point (@nil Values.val))) m (ge_storage_env bx b_y)
                     (ge_storage_temps out point) mi)
                  (and (@List.NoDup Values.block (@cons Values.block bx (@cons Values.block b_y (@nil Values.block))))
                     (and
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                         not
                           (@List.In Values.block b
                              (@cons Values.block bx (@cons Values.block b_y (@nil Values.block)))))
                        (and
                           (forall (b : Values.block)
                              (_ : @List.In Values.block b
                                     (@cons Values.block bx (@cons Values.block b_y (@nil Values.block)))),
                            Memory.Mem.range_perm mi b BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                              (and (jet_clight_internal_permissions.keeps_permissions m mi)
                                 (jet_clight_internal_preserve.readonly_preserved m mi)))))))))
