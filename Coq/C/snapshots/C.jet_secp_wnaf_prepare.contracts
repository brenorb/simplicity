### C.jet_secp_wnaf_prepare.wnaf_scalar_copy_source
wnaf_scalar_copy_source
     : @eq Clight.statement wnaf_scalar_copy
         (Clight.Sassign (Clight.Evar jets_secp._s (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
            (Clight.Ederef
               (Clight.Etempvar jets_secp._a (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
               (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
### C.jet_secp_wnaf_prepare.wnaf_post_memset_source
wnaf_post_memset_source
     : @eq Clight.statement wnaf_post_memset
         (Clight.Ssequence wnaf_scalar_copy (Clight.Ssequence wnaf_sign_select jet_secp_wnaf_loop.wnaf_loop_return))
### C.jet_secp_wnaf_prepare.exec_wnaf_scalar_copy
exec_wnaf_scalar_copy
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (n : BinNums.Z) (ba : Values.block)
         (abase : BinNums.Z) (bs : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba (Integers.Ptrofs.repr abase)))) (_ : not (@eq Values.block ba bs))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba abase
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n)))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_wnaf_digit.wnaf_env bs) le m
               wnaf_scalar_copy Events.E0 le mc ClightBigstep.Out_normal)
            (and
               (jet_secp_scalar_get_b32_storage.scalar_at mc bs BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n)))
               (and (@eq Values.block (Memory.Mem.nextblock mc) (Memory.Mem.nextblock m))
                  (and
                     (forall (bx : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
                      iff (Memory.Mem.perm mc bx pos k p) (Memory.Mem.perm m bx pos k p))
                     (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx bs)) m mc)))))
### C.jet_secp_wnaf_prepare.wnaf_top_call_source
wnaf_top_call_source
     : @eq Clight.statement wnaf_top_call
         (jet_secp_curve_statements.curve_call jets_secp._secp256k1_scalar_get_bits
            jets_secp.f_secp256k1_scalar_get_bits (@Some AST.ident jets_secp._t'1)
            (@cons Clight.expr
               (Clight.Eaddrof (Clight.Evar jets_secp._s (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr))
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__5826 Ctypes.noattr)))
               (@cons Clight.expr
                  (Clight.Econst_int
                     (Integers.Int.repr
                        (BinNums.Zpos
                           (BinNums.xI
                              (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                     Ctypesdefs.tint)
                  (@cons Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) (@nil Clight.expr)))))
### C.jet_secp_wnaf_prepare.wnaf_sign_select_source
wnaf_sign_select_source
     : @eq Clight.statement wnaf_sign_select
         (Clight.Ssequence wnaf_top_call
            (Clight.Sifthenelse (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tuint) wnaf_negative_branch Clight.Sskip))
### C.jet_secp_wnaf_prepare.exec_wnaf_sign_small
exec_wnaf_sign_small
     : forall (le : Clight.temp_env) (m : Memory.Mem.mem) (n : BinNums.Z) (bs : Values.block)
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.lt n
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m bs BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n))),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_wnaf_digit.wnaf_env bs) le m wnaf_sign_select
         Events.E0 (wnaf_small_temps le) m ClightBigstep.Out_normal
### C.jet_secp_wnaf_prepare.wnaf_small_fields
wnaf_small_fields
     : forall (le : Maps.PTree.tree Values.val) (bit len w carry sign : BinNums.Z) (b : Values.block)
         (base last : BinNums.Z) (_ : jet_secp_wnaf_control.wnaf_loop_fields le bit len w carry sign b base last),
       jet_secp_wnaf_control.wnaf_loop_fields (wnaf_small_temps le) bit len w carry sign b base last
### C.jet_secp_wnaf_prepare.exec_wnaf_post_memset_small
exec_wnaf_post_memset_small
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (n len w : BinNums.Z)
         (ba : Values.block) (abase : BinNums.Z) (bs b : Values.block) (base : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.lt n
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.le len
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : and (BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) w)
                (BinInt.Z.le w (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._a le)
                (@Some Values.val (Values.Vptr ba (Integers.Ptrofs.repr abase))))
         (_ : jet_secp_wnaf_control.wnaf_loop_fields le BinNums.Z0 len w BinNums.Z0 (BinNums.Zpos BinNums.xH) b base
                (BinNums.Zneg BinNums.xH))
         (_ : jet_secp_scalar_get_b32_storage.scalar_at m ba abase
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n))) (_ : not (@eq Values.block ba bs))
         (_ : not (@eq Values.block b bs))
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Writable) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) len))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
              Memory.Mem.valid_access m AST.Mint32 b
                (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
                Memtype.Writable)
         (_ : forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i len)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m b
                   (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint Integers.Int.zero))),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex BinNums.Z
               (fun carry : BinNums.Z =>
                @ex BinNums.Z
                  (fun last : BinNums.Z =>
                   @ex (forall _ : BinNums.Z, BinNums.Z)
                     (fun digits : forall _ : BinNums.Z, BinNums.Z =>
                      and
                        (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge (jet_secp_wnaf_digit.wnaf_env bs) le
                           m wnaf_post_memset Events.E0 lef mf
                           (ClightBigstep.Out_return
                              (@Some (prod Values.val Ctypes.type)
                                 (@pair Values.val Ctypes.type
                                    (Values.Vint (Integers.Int.repr (BinInt.Z.add last (BinNums.Zpos BinNums.xH))))
                                    Ctypesdefs.tint))))
                        (and
                           (jet_secp_wnaf_control.wnaf_loop_fields lef len len w carry (BinNums.Zpos BinNums.xH) b base
                              last)
                           (and (or (@eq BinNums.Z carry BinNums.Z0) (@eq BinNums.Z carry (BinNums.Zpos BinNums.xH)))
                              (and
                                 (jet_secp_scalar_get_b32_storage.scalar_at mf bs BinNums.Z0
                                    (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                                       (jet_secp_scalar_get_b32_numeric.scalar_limbs_of n)))
                                 (and
                                    (jet_secp_wnaf_loop.wnaf_array_state mf b base len w (BinNums.Zpos BinNums.xH) len
                                       last digits)
                                    (and
                                       (@eq BinNums.Z
                                          (BinInt.Z.add (jet_secp_wnaf_loop.wnaf_weighted digits (BinInt.Z.to_nat len))
                                             (BinInt.Z.mul (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) len)
                                                (BinInt.Z.add
                                                   (BinInt.Z.div n
                                                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) len)) carry)))
                                          n)
                                       (and
                                          (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add last (BinNums.Zpos BinNums.xH)))
                                             (BinInt.Z.le (BinInt.Z.add last (BinNums.Zpos BinNums.xH)) len))
                                          (and (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m))
                                             (and
                                                (forall (bx : Values.block) (pos : BinNums.Z)
                                                   (k : Memtype.perm_kind) (p : Memtype.permission),
                                                 iff (Memory.Mem.perm mf bx pos k p) (Memory.Mem.perm m bx pos k p))
                                                (and
                                                   (jet_sx_mem.lframe
                                                      (fun (bx : Values.block) (_ : BinNums.Z) =>
                                                       and (not (@eq Values.block bx bs)) (not (@eq Values.block bx b)))
                                                      m mf)
                                                   (forall
                                                      _ : BinInt.Z.lt n
                                                            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                               (BinInt.Z.sub len (BinNums.Zpos BinNums.xH))),
                                                    and (@eq BinNums.Z carry BinNums.Z0)
                                                      (@eq BinNums.Z
                                                         (jet_secp_wnaf_loop.wnaf_weighted digits (BinInt.Z.to_nat len))
                                                         n))))))))))))))))
### C.jet_secp_wnaf_prepare.wnaf_scalar_copy
wnaf_scalar_copy =
@List.nth Clight.statement (S (S (S (S (S (S (S (S (S O))))))))) jet_secp_wnaf_digit.wnaf_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_wnaf_prepare.wnaf_sign_select
wnaf_sign_select =
@List.nth Clight.statement (S (S (S (S (S (S (S (S (S (S O)))))))))) jet_secp_wnaf_digit.wnaf_statements Clight.Sskip
     : Clight.statement
### C.jet_secp_wnaf_prepare.wnaf_post_memset
wnaf_post_memset =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement (S (S (S (S (S (S (S (S (S O))))))))) jet_secp_wnaf_digit.wnaf_statements)
  (@snd (list Clight.statement) Clight.statement
     (jet_secp_statement_prefix.split_statement_last (Clight.fn_body jets_secp.f_secp256k1_ecmult_wnaf)))
     : Clight.statement
### C.jet_secp_wnaf_prepare.wnaf_top_call
wnaf_top_call =
match wnaf_sign_select return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence call _ => call
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_wnaf_prepare.wnaf_negative_branch
wnaf_negative_branch =
match wnaf_sign_select return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ _ => Clight.Sskip
    | Clight.Sifthenelse _ negative _ => negative
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_wnaf_prepare.wnaf_small_temps
wnaf_small_temps =
fun le : Maps.PTree.tree Values.val => @Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint Integers.Int.zero) le
     : forall _ : Maps.PTree.tree Values.val, Maps.PTree.tree Values.val

Arguments wnaf_small_temps le
