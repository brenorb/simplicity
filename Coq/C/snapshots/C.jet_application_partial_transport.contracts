### C.jet_application_partial_transport.application_jet_partial_spec_pointwise
application_jet_partial_spec_pointwise
     : forall (f : Clight.function) (ge : Clight.genv) (E : Set) (A B : Ty.Ty)
         (rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E), Prop)
         (spec1 spec2 : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B))
         (_ : forall (a : Ty.tySem A) (e : E), @eq (option (Ty.tySem B)) (spec1 a e) (spec2 a e))
         (_ : jet_application_partial.application_jet_partial_spec f ge E A B rep spec1),
       jet_application_partial.application_jet_partial_spec f ge E A B rep spec2
