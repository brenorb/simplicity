               (jet_secp_rescale_literal.rescale_field_output
                  (jet_secp_mixed_finite_body.mixed_finite_x_words (jet_secp_square_spec_bridge.square_reader_rho ax)
                     (jet_secp_square_spec_bridge.square_reader_rho ay)
                     (jet_secp_square_spec_bridge.square_reader_rho az)
                     (jet_secp_square_spec_bridge.square_reader_rho bx)
                     (jet_secp_square_spec_bridge.square_reader_rho byword)))
               (jet_secp_rescale_literal.rescale_field_output
                  (jet_secp_mixed_finite_body.mixed_finite_y_words (jet_secp_square_spec_bridge.square_reader_rho ax)
                     (jet_secp_square_spec_bridge.square_reader_rho ay)
                     (jet_secp_square_spec_bridge.square_reader_rho az)
                     (jet_secp_square_spec_bridge.square_reader_rho bx)
                     (jet_secp_square_spec_bridge.square_reader_rho byword))))
            (jet_secp_rescale_literal.rescale_field_output
               (jet_secp_mixed_finite_body.mixed_finite_z_words (jet_secp_square_spec_bridge.square_reader_rho ax)
                  (jet_secp_square_spec_bridge.square_reader_rho ay) (jet_secp_square_spec_bridge.square_reader_rho az)
                  (jet_secp_square_spec_bridge.square_reader_rho bx)
                  (jet_secp_square_spec_bridge.square_reader_rho byword))))
         (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
            (@pair
               (prod
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@pair
