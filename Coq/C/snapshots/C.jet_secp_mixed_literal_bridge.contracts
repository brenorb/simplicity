### C.jet_secp_mixed_literal_bridge.eval_mixed_literal
eval_mixed_literal
     : forall (ax ay az bx byword : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (m : Memory.Mem.mem) (bp ba : Values.block) (_ : not (@eq Values.block bp ba))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val
                   (Values.Vint
                      (jet_readBit_layout.bit_int
                         (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem az))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho ax)))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho ay)))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho az)))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho bx)))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho byword)))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (forall _ : nat, Integers.Int64.int)
            (fun x : forall _ : nat, Integers.Int64.int =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun y : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun z : forall _ : nat, Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_gej_add_ge_var)
                        (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vlong Integers.Int64.zero) (@nil Values.val))))) Events.E0
                        mf Values.Vundef)
                     (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                        (and
                           (jet_secp_fe_nv.fe_at mf bp
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 y))
                           (and
                              (jet_secp_fe_nv.fe_at mf bp
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 (jet_secp_multiply_normalize_bridge.words5 z))
                              (and
                                 (Memory.Mem.range_perm mf bp BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf ba BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and (jet_secp_square_columns.square_input_bounds x)
                                       (and (jet_secp_square_columns.square_input_bounds y)
                                          (and (jet_secp_square_columns.square_input_bounds z)
                                             (and
                                                (@eq
                                                   (prod
                                                      (prod (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...)))))))
                                                   (@pair
                                                      (prod (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...))))))
                                                      (Ty.tySem (Word.Word (S (S (S (...))))))
                                                      (@pair (Ty.tySem (Word.Word (S (S (...)))))
                                                         (Ty.tySem (Word.Word (S (S (...)))))
                                                         (jet_secp_rescale_literal.rescale_field_output x)
                                                         (jet_secp_rescale_literal.rescale_field_output y))
                                                      (jet_secp_rescale_literal.rescale_field_output z))
                                                   (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
                                                      (@pair
                                                         (prod
                                                            (prod (Ty.tySem (Word.Word (...)))
                                                               (Ty.tySem (Word.Word (...))))
                                                            (Ty.tySem (Word.Word (S (...)))))
                                                         (prod (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))))
                                                         (@pair
                                                            (prod (Ty.tySem (Word.Word (...)))
                                                               (Ty.tySem (Word.Word (...))))
                                                            (Ty.tySem (Word.Word (S (...))))
                                                            (@pair (Ty.tySem (Word.Word (...)))
                                                               (Ty.tySem (Word.Word (...))) ax ay) az)
                                                         (@pair (Ty.tySem (Word.Word (S (...))))
                                                            (Ty.tySem (Word.Word (S (...)))) bx byword))))
                                                (jet_sx_mem.lframe
                                                   (fun (b : Values.block) (_ : BinNums.Z) =>
                                                    and (not (@eq Values.block b bp)) (not (@eq Values.block b ba))) m
                                                   mf))))))))))))))
