### C.jet_secp_mixed_literal_bridge.mixed_nonzero_reader_outputs_literal
mixed_nonzero_reader_outputs_literal
     : forall (ax ay az bx byword : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool (Bit.toBool (@jet_secp_canonical_zero.canonical_fe_is_zero Alg.CoreFunSem az)) false)
         (_ : @eq bool
                (BinInt.Z.eqb
                   (BinInt.Z.modulo
                      (jet_secp_multiply_finish_product.radix_value
                         (jet_secp_mixed_finite_return.mixed_h_words (jet_secp_square_spec_bridge.square_reader_rho ax)
