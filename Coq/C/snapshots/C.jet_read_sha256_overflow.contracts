         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._compressionCount le)
                (@Some Values.val (Values.Vlong count)))
         (_ : Memory.Mem.valid_access m AST.Mint8unsigned bc
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_exec.ge0 e le m sha256_read_overflow_stmt Events.E0 lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type
                           (Values.Vint (jet_readBit_layout.bit_int (negb (sha256_read_overflow count))))
                           Ctypesdefs.tint))))
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.store AST.Mint8unsigned m bc
                        (BinInt.Z.add base
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (Values.Vint (jet_readBit_layout.bit_int (sha256_read_overflow count))))
                     (@Some Memory.Mem.mem mf))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint8unsigned mf bc
                           (BinInt.Z.add base
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                        (@Some Values.val (Values.Vint (jet_readBit_layout.bit_int (sha256_read_overflow count)))))
                     (jet_sha256_max_counter.sha256_max_counter_at mf)))))
### C.jet_read_sha256_overflow.sha256_read_overflow
sha256_read_overflow =
fun count : Integers.Int64.int =>
Integers.Int64.cmpu Integers.Cle
  (Integers.Int64.repr
     (BinNums.Zpos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))))
  count
     : forall _ : Integers.Int64.int, bool

Arguments sha256_read_overflow count
### C.jet_read_sha256_overflow.sha256_read_overflow_stmt
sha256_read_overflow_stmt =
Clight.Ssequence
  (Clight.Ssequence (Clight.Sset jets._t'3 (Clight.Evar jets._sha256_max_counter Ctypesdefs.tulong))
     (Clight.Sassign
        (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxOverflow jets._ctx)
        (Clight.Ebinop Cop.Ole
           (Clight.Ebinop Cop.Oshr (Clight.Etempvar jets._t'3 Ctypesdefs.tulong)
              (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))
                 Ctypesdefs.tint) Ctypesdefs.tulong) (Clight.Etempvar jets._compressionCount Ctypesdefs.tulong)
           Ctypesdefs.tint)))
  (Clight.Ssequence
     (Clight.Sset jets._t'2
        (jet_sha256_context_fields.sha256_context_field_expr jet_sha256_context_fields.CtxOverflow jets._ctx))
     (Clight.Sreturn
        (@Some Clight.expr (Clight.Eunop Cop.Onotbool (Clight.Etempvar jets._t'2 Ctypesdefs.tbool) Ctypesdefs.tint))))
     : Clight.statement
