### C.jet_secp_modinv_normalize62_words.norm62_value_z
norm62_value_z =
fix norm62_value_z (n : nat) (w : forall _ : nat, BinNums.Z) {struct n} : BinNums.Z :=
  match n return BinNums.Z with
  | O => w O
  | S n0 =>
      BinInt.Z.add (w O)
        (BinInt.Z.mul
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
           (norm62_value_z n0 (fun i : nat => w (S i))))
  end
     : forall (_ : nat) (_ : forall _ : nat, BinNums.Z), BinNums.Z

Arguments norm62_value_z n%nat_scope w%function_scope
### C.jet_secp_modinv_normalize62_words.norm62_carry_z
norm62_carry_z =
fix norm62_carry_z (n : nat) (w : forall _ : nat, BinNums.Z) (carry : BinNums.Z) {struct n} :
    forall _ : nat, BinNums.Z :=
  match n return (forall _ : nat, BinNums.Z) with
  | O => fun _ : nat => BinInt.Z.add (w O) carry
  | S n0 =>
      fun i : nat =>
      match i return BinNums.Z with
      | O =>
          BinInt.Z.modulo (BinInt.Z.add (w O) carry)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
      | S i0 =>
          norm62_carry_z n0 (fun j : nat => w (S j))
            (BinInt.Z.div (BinInt.Z.add (w O) carry)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))) i0
      end
  end
     : forall (_ : nat) (_ : forall _ : nat, BinNums.Z) (_ : BinNums.Z) (_ : nat), BinNums.Z

Arguments norm62_carry_z n%nat_scope w%function_scope carry%Z_scope _%nat_scope
