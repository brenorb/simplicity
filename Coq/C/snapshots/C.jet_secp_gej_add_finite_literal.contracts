### C.jet_secp_gej_add_finite_literal.gej_add_z_matches_literal
gej_add_z_matches_literal
     : forall (z h w : forall _ : nat, Integers.Int64.int)
         (a c d : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : jet_secp_square_columns.square_input_bounds h)
         (_ : jet_secp_square_columns.square_input_bounds w)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value h) jet_secp_fe_math.feP)
                (BinInt.Z.modulo
                   (BinInt.Z.opp (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a))
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) c)
                   jet_secp_fe_math.feP))
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value w) jet_secp_fe_math.feP)
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) d)
                   jet_secp_fe_math.feP)),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (jet_secp_multiply_finish_product.radix_value
               (jet_secp_point_mul_storage.point_mul_words z (jet_secp_point_mul_storage.point_mul_words h w)))
            jet_secp_fe_math.feP)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) (gej_add_literal_rz a c d))
