### C.jet_bitcoin_current_index_exec.bitcoin_env_index_field
bitcoin_env_index_field
     : match
         @Maps.PTree.get Ctypes.composite jets_bitcoin._txEnv (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge)
         return Prop
       with
       | Some co =>
           @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
             (Ctypes.field_offset (Clight.genv_cenv jet_bitcoin_linkage.bitcoin_ge) jets_bitcoin._ix
                (Ctypes.co_members co))
             (@Errors.OK (prod BinNums.Z Ctypes.bitfield)
                (@pair BinNums.Z Ctypes.bitfield
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))
                   Ctypes.Full))
       | None => False
       end
### C.jet_bitcoin_current_index_exec.eval_bitcoin_env_index
eval_bitcoin_env_index
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (be : Values.block)
         (base : BinNums.Z) (index : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m be
                   (BinInt.Z.add base
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vlong index))),
       Clight.eval_expr jet_bitcoin_linkage.bitcoin_ge e le m
         (Clight.Efield
            (Clight.Ederef
               (Clight.Etempvar jets_bitcoin._env (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._txEnv Ctypes.noattr)))
               (Ctypes.Tstruct jets_bitcoin._txEnv Ctypes.noattr)) jets_bitcoin._ix Ctypesdefs.tulong)
         (Values.Vlong index)
### C.jet_bitcoin_current_index_exec.bitcoin_current_index_entry
bitcoin_current_index_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bl bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl)),
       Clight.function_entry2 jet_bitcoin_linkage.bitcoin_ge jets_bitcoin.f_simplicity_bitcoin_current_index
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (jet_bitcoin_version_exec.bitcoin_version_locals bl) (bitcoin_current_index_temps env bd dbase bs sbase) ma
### C.jet_bitcoin_current_index_exec.call_bitcoin_write32_arg
call_bitcoin_write32_arg
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (arg : Clight.expr)
         (value : Integers.Int64.int) (_ : @eq Ctypes.type (Clight.typeof arg) Ctypesdefs.tulong)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_bitcoin._simplicity_write32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : Clight.eval_expr jet_bitcoin_linkage.bitcoin_ge e le m arg (Values.Vlong value))
         (_ : ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge m
                (@Ctypes.Internal Clight.function jets_bitcoin.f_simplicity_write32)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong value) (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_bitcoin_linkage.bitcoin_ge e le m
         (Clight.Scall (@None AST.ident)
            (Clight.Evar jets_bitcoin._simplicity_write32
               (Ctypes.Tfunction
                  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
                     (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
            (@cons Clight.expr
               (Clight.Etempvar jets_bitcoin._dst
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
               (@cons Clight.expr arg (@nil Clight.expr)))) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_bitcoin_current_index_exec.eval_bitcoin_current_index_composes
eval_bitcoin_current_index_composes
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc me mf : Memory.Mem.mem) (bl bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (be : Values.block) (ebase : BinNums.Z)
         (index : Integers.Int64.int) (bytes : list Memdata.memval) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs)) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le
                (BinInt.Z.add ebase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mc be
                   (BinInt.Z.add ebase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vlong index)))
         (_ : ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge mc
                (@Ctypes.Internal Clight.function jets_bitcoin.f_simplicity_write32)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong index) (@nil Values.val))) Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_bitcoin_linkage.bitcoin_ge m
         (@Ctypes.Internal Clight.function jets_bitcoin.f_simplicity_bitcoin_current_index)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
               (@cons Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase)) (@nil Values.val)))) Events.E0 mf
         (Values.Vint Integers.Int.one)
### C.jet_bitcoin_current_index_exec.bitcoin_current_index_temps
bitcoin_current_index_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_bitcoin._env env
  (@Maps.PTree.set Values.val jets_bitcoin._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_bitcoin._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_bitcoin.f_simplicity_bitcoin_current_index))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments bitcoin_current_index_temps env bd dbase%Z_scope bs sbase%Z_scope
### C.jet_bitcoin_current_index_exec.bitcoin_current_index_ready
bitcoin_current_index_ready =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
  (index : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_bitcoin._t'1 (Values.Vlong index) (bitcoin_current_index_temps env bd dbase bs sbase)
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : Integers.Int64.int), Clight.temp_env

Arguments bitcoin_current_index_ready env bd dbase%Z_scope bs sbase%Z_scope index
