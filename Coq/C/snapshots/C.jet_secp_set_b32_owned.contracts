     : forall (bytes : list BinNums.Z) (beta : jet_sx_state.layout) (m : Memory.Mem.mem) (r : nat)
         (_ : @eq BinNums.Z (jet_sx_state.bas beta r) BinNums.Z0)
         (_ : @List.Forall BinNums.Z
                (fun x : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 x)
                   (BinInt.Z.le x
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes)
         (_ : Memory.Mem.range_perm m (jet_sx_state.blk beta r) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m (jet_sx_state.blk beta r) (BinInt.Z.of_nat i))
                (@Some Values.val (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i bytes BinNums.Z0))))),
       jet_sx_state.region_ok (jet_secp_b32_exec.byte_rho bytes) beta m r owned_b32_source
