### C.jet_secp_scalar_reader_run.scalar_reader_entries
scalar_reader_entries
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list BitMachine.Cell) (cap : BinNums.Z)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (id : AST.ident) (ent : jet_sx_exec.fentry)
         (_ : @eq (option jet_sx_exec.fentry) (jet_sx_exec.flookup scalar_reader_table id)
                (@Some jet_sx_exec.fentry ent)),
       and
         (@ex Values.block
            (fun b : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv jet_secp_linkage.secp_ge)
                     id) (@Some Values.block b))
               (@eq (option Clight.fundef)
                  (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type
                     (Clight.genv_genv jet_secp_linkage.secp_ge) b)
                  (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (jet_sx_exec.fentry_fd ent))))))
         match ent return Prop with
         | jet_sx_exec.FInt _ => True
         | jet_sx_exec.FOra fd oracle =>
             jet_sx_exec.oracle_ok jet_secp_linkage.secp_ge (jet_secp_scalar_reader_run.rd_ev bd dbase bi edge ibits)
               (jet_secp_scalar_reader_run.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap)
               (jet_secp_scalar_reader_run.rd_ext m0 bd bw bi) fd oracle
         end
### C.jet_secp_scalar_reader_run.scalar_reader_events
scalar_reader_events
     : forall (bd : Values.block) (dbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool),
       jet_sx_exec.solves (jet_secp_scalar_reader_run.rd_ev bd dbase bi edge ibits)
         (jet_secp_wrapper_run.read_fe_rho ibits rc)
         (jet_sx_eval.slog (scalar_reader_state bi (Integers.Ptrofs.repr edge)))
### C.jet_secp_scalar_reader_run.exec_scalar_reader_first
exec_scalar_reader_first
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list BitMachine.Cell) (cap : BinNums.Z)
         (_ : jet_output_layout.write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : jet_encoding.frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : jet_sx_state.layout) (e : Clight.env) (le : Clight.temp_env)
         (_ : jet_sx_state.rep (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                (jet_sx_eval.sregs (scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m)
         (_ : jet_sx_eval.tmatch (jet_secp_wrapper_run.read_fe_rho ibits rc) layout scalar_reader_temps le)
         (_ : jet_sx_eval.ematch layout scalar_reader_venv e)
         (_ : jet_sx_exec.xsep (jet_secp_scalar_reader_run.rd_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_reader_run.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (jet_secp_wrapper_run.read_fe_rho ibits rc) (@nil jet_sx_eval.event) m),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m scalar_reader_first Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and
                  (jet_sx_state.rep (jet_secp_wrapper_run.read_fe_rho ibits rc) layout
                     (jet_sx_eval.sregs (scalar_reader_state bi (Integers.Ptrofs.repr edge))) mf)
                  (and (jet_sx_eval.tmatch (jet_secp_wrapper_run.read_fe_rho ibits rc) layout scalar_reader_temps le')
                     (and
                        (jet_secp_scalar_reader_run.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                           (jet_secp_wrapper_run.read_fe_rho ibits rc)
                           (scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                        (jet_sx_mem.lframe
                           (jet_sx_exec.frame (jet_secp_scalar_reader_run.rd_ext m0 bd bw bi) layout
                              (jet_sx_eval.sregs (scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m) m mf))))))
### C.jet_secp_scalar_reader_run.scalar_reader_table
scalar_reader_table =
@cons (prod AST.ident jet_sx_exec.fentry)
  (@pair AST.ident jet_sx_exec.fentry jets._read8s
     (jet_sx_exec.FOra jets.f_read8s
        (jet_secp_frame.orc_rd8 false
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
  jet_secp_shift64_executor.secp_shift64_table
     : list (prod AST.ident jet_sx_exec.fentry)
### C.jet_secp_scalar_reader_run.scalar_reader_initial_regs
scalar_reader_initial_regs =
fun (bi : Values.block) (edge : Integers.Ptrofs.int) =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (@cons jet_sx_state.cell (jet_sx_state.mkcell BinNums.Z0 AST.Mint64 (@None jet_sx_expr.sx))
        (@cons jet_sx_state.cell
           (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
              (@None jet_sx_expr.sx))
           (@cons jet_sx_state.cell
              (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                 AST.Mint64 (@None jet_sx_expr.sx))
              (@cons jet_sx_state.cell
                 (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))
                    AST.Mint64 (@None jet_sx_expr.sx)) (@nil jet_sx_state.cell))))) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg (jet_secp_frame.mk_frame_cells (jet_sx_expr.XA bi edge) Integers.Int64.zero) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     (@nil jet_sx_state.region))
     : forall (_ : Values.block) (_ : Integers.Ptrofs.int), list jet_sx_state.region

