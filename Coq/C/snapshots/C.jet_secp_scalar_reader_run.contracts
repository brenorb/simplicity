### C.jet_secp_scalar_reader_run.scalar_reader_buffer
scalar_reader_buffer =
jet_sx_state.mkreg
  (jet_secp_fe_b32.byte_undef BinNums.Z0
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))) true
  (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : jet_sx_state.region
### C.jet_secp_scalar_reader_run.scalar_reader_venv
scalar_reader_venv =
@cons (prod AST.ident (prod nat Ctypes.type))
  (@pair AST.ident (prod nat Ctypes.type) jets_secp._buf
