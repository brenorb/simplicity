Arguments scalar_reader_initial bi edge
### C.jet_secp_scalar_reader_run.scalar_reader_first
scalar_reader_first =
match Clight.fn_body jets_secp.f_read_scalar return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence first _ => first
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
### C.jet_secp_scalar_reader_run.scalar_reader_run
scalar_reader_run =
fun (bi : Values.block) (edge : Integers.Ptrofs.int) =>
jet_sx_exec.xstmt (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  scalar_reader_table (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
  scalar_reader_venv (scalar_reader_initial bi edge) scalar_reader_first
     : forall (_ : Values.block) (_ : Integers.Ptrofs.int), option jet_sx_exec.res

