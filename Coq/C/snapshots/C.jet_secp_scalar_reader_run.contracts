### C.jet_secp_scalar_reader_run.scalar_reader_initial
scalar_reader_initial =
fun (bi : Values.block) (edge : Integers.Ptrofs.int) =>
jet_sx_eval.mkst scalar_reader_temps
  (@app jet_sx_state.region (scalar_reader_initial_regs bi edge)
     (@cons jet_sx_state.region scalar_reader_buffer (@nil jet_sx_state.region))) (@nil jet_sx_eval.event)
  (S O)
