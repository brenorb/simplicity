### C.jet_secp_swu_literal_bridge.swu_select_branch_views
swu_select_branch_views
     : forall (x1 x2 x3 y1 y2 y3 : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (f1 f2 f3 : bool) (_ : forall (_ : @eq bool f1 false) (_ : @eq bool f2 false), @eq bool f3 true),
       @eq
         (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         match
           match f1 return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) with
           | true => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) y1
           | false => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
           end
           return
             (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         with
         | inl _ =>
             match
               match f2 return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) with
               | true => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) y2
               | false => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
               end
               return
                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
             with
             | inl _ =>
                 match
                   match f3 return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) with
                   | true => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) y3
                   | false => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
                   end
                   return
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 with
                 | inl _ =>
                     @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (@jet_secp_literal_infinity.literal_fe_zero256 Alg.CoreFunSem tt)
                       (@jet_secp_literal_infinity.literal_fe_zero256 Alg.CoreFunSem tt)
                 | inr y =>
                     @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x3 y
                 end
             | inr y =>
                 @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x2 y
             end
         | inr y =>
             @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x1 y
         end
         match
           f1
           return
             (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         with
         | true =>
             @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x1 y1
         | false =>
             match
               f2
               return
                 (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
             with
             | true =>
                 @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x2 y2
             | false =>
                 @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x3 y3
             end
         end
### C.jet_secp_swu_literal_bridge.swu_literal_select_no_fallback
swu_literal_select_no_fallback
     : forall t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@jet_secp_swu_literal.literal_swu_select Alg.CoreFunSem
            (@jet_secp_swu_literal.literal_swu_candidates Alg.CoreFunSem t)) (swu_selected_candidate t)
### C.jet_secp_swu_literal_bridge.swu_literal_selected_step
swu_literal_selected_step
     : forall t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq
         (Ty.tySem
            (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem t)
         match
           Bit.toBool (@jet_secp_canonical_odd.canonical_fe_is_odd Alg.CoreFunSem t)
           return
             (Ty.tySem
                (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         with
         | true => @jet_secp_gej_negate_literal.literal_ge_negate Alg.CoreFunSem (swu_selected_candidate t)
         | false => swu_selected_candidate t
         end
### C.jet_secp_swu_literal_bridge.swu_literal_candidate_values
swu_literal_candidate_values =
fun t : BinNums.Z =>
let s : BinNums.Z := BinInt.Z.mul t t in
let a : BinNums.Z := BinInt.Z.mul s jet_secp_swu_candidates.swu_negc_constant in
let w : BinNums.Z := BinInt.Z.add s (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) in
let b : BinNums.Z := BinInt.Z.mul s (BinNums.Zpos (BinNums.xI BinNums.xH)) in
let i : BinNums.Z := jet_secp_swu_candidates.swu_inv (BinInt.Z.mul w b) in
@pair BinNums.Z BinNums.Z (BinInt.Z.add (BinInt.Z.mul a (BinInt.Z.mul b i)) jet_secp_swu_candidates.swu_d_constant)
  (BinInt.Z.add (BinInt.Z.mul (BinInt.Z.mul (BinInt.Z.mul w w) w) (BinInt.Z.opp i)) (BinNums.Zpos BinNums.xH))
     : forall _ : BinNums.Z, prod BinNums.Z BinNums.Z

Arguments swu_literal_candidate_values t%Z_scope
### C.jet_secp_swu_literal_bridge.swu_radicand
