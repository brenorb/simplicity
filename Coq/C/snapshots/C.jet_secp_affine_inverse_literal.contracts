### C.jet_secp_affine_inverse_literal.literal_invert_numeric_mod_field
literal_invert_numeric_mod_field
     : forall (z : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 z)
                (BinInt.Z.lt z
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq BinNums.Z (jet_secp_invert_literal.literal_invert_numeric (BinInt.Z.modulo z jet_secp_fe_math.feP))
         (jet_secp_invert_literal.literal_invert_numeric z)
### C.jet_secp_affine_inverse_literal.affine_writer_closed
affine_writer_closed
     : @eq bool
         (jet_clight_internal_frame.closed_stmtb jet_secp_field_io_preserve.field_io_helpers
            (Clight.fn_body jets_secp.f_write_ge)) true
### C.jet_secp_affine_inverse_literal.eval_affine_finite_write_literal
eval_affine_finite_write_literal
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (m : Memory.Mem.mem)
         (bp br : Values.block) (a b c : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : forall (mc : Memory.Mem.mem) (w : Integers.Int64.int)
                (_ : not (@eq BinNums.Z (Integers.Int64.unsigned w) BinNums.Z0)),
              ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mc
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ctz64_var)
                (@cons Values.val (Values.Vlong w) (@nil Values.val)) Events.E0 mc
                (Values.Vint (Integers.Int.repr (extraMath.Z_ctz (Integers.Int64.unsigned w)))))
         (_ : jet_output_layout.write_frame_at m0 bd base bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N)
         (_ : jet_frame_inv.finv m0 bd base bw edge cursor N bi m true
                (@cons (option bool) (@Some bool true) (@nil (option bool))))
         (_ : jet_sx_exec.xsep (jet_secp_frame.extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bp BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z br BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))) (_ : not (@eq Values.block bp br))
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho a)))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho b)))
         (_ : jet_secp_fe_nv.fe_at m bp
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho c)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bp
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero))) (_ : jet_secp_modinfo_fe_caller.modinfo_fe_state m)
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_ge_set_gej_var)
                  (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bp Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge mr
                     (@Ctypes.Internal Clight.function jets_secp.f_write_ge)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                        (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                     Values.Vundef)
                  (and
                     (jet_frame_inv.finv m0 bd base bw edge cursor N bi mf true
                        (@app (option bool) (@cons (option bool) (@Some bool true) (@nil (option bool)))
                           (@Translate.encode
                              (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                 (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (@jet_secp_gej_norm_literal.literal_gej_norm Alg.CoreFunSem
                                 (@pair
                                    (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b) c)))))
                     (and
                        (Memory.Mem.range_perm mf bp BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf br BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (jet_sx_mem.lframe
                                 (fun (bx : Values.block) (_ : BinNums.Z) =>
                                  and (not (@eq Values.block bx bp))
                                    (and (not (@eq Values.block bx br)) (not (jet_secp_frame.extA m0 bd bw bi bx)))) m
                                 mf)
                              (and (jet_secp_modinfo_fe_caller.modinfo_fe_state mf)
                                 (jet_clight_internal_preserve.readonly_preserved m mf)))))))))
