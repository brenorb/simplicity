### C.jet_elements_taptweak_tweak_bytes_entry.elements_taptweak_tweak_bytes_vars_checked
elements_taptweak_tweak_bytes_vars_checked
     : @eq bool
         (jet_transport.vars_okb jet_secp_linkage.secp_ge jet_elements_taptweak_pure.elements_taptweak_ge
            (Clight.fn_vars jets_secp.f_secp256k1_ec_pubkey_tweak_add_helper)) true
### C.jet_elements_taptweak_tweak_bytes_entry.elements_taptweak_tweak_bytes_blocks
elements_taptweak_tweak_bytes_blocks
     : forall bt bf : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env jet_elements_taptweak_pure.elements_taptweak_ge
            (jet_secp_tweak_bytes_entry.tweak_bytes_env bt bf))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bf BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bt BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
### C.jet_elements_taptweak_tweak_bytes_entry.elements_taptweak_tweak_bytes_entry
elements_taptweak_tweak_bytes_entry
     : forall (m : Memory.Mem.mem) (bk bb : Values.block),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Values.block
            (fun bt : Values.block =>
             @ex Values.block
               (fun bf : Values.block =>
                and
                  (Clight.function_entry2 jet_elements_taptweak_pure.elements_taptweak_ge
                     jets_secp.f_secp256k1_ec_pubkey_tweak_add_helper
                     (@cons Values.val (Values.Vptr bk Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) m
                     (jet_secp_tweak_bytes_entry.tweak_bytes_env bt bf)
                     (jet_secp_tweak_bytes_entry.tweak_bytes_temps bk bb) mi)
                  (and (not (@eq Values.block bt bf))
                     (and
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                         and (not (@eq Values.block b bt)) (not (@eq Values.block b bf)))
                        (and
                           (Memory.Mem.range_perm mi bt BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mi bf BinNums.Z0
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) Memtype.Cur Memtype.Freeable)
                              (and (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mi)
                                 (and (jet_clight_internal_permissions.keeps_permissions m mi)
                                    (jet_clight_internal_preserve.readonly_preserved m mi))))))))))
### C.jet_elements_taptweak_tweak_bytes_entry.elements_taptweak_tweak_bytes_free
elements_taptweak_tweak_bytes_free
     : forall (m : Memory.Mem.mem) (bt bf : Values.block) (_ : not (@eq Values.block bt bf))
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bf BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.free_list m
                  (Clight.blocks_of_env jet_elements_taptweak_pure.elements_taptweak_ge
                     (jet_secp_tweak_bytes_entry.tweak_bytes_env bt bf))) (@Some Memory.Mem.mem mf))
            (and
               (jet_sx_mem.lframe
                  (fun (b : Values.block) (_ : BinNums.Z) =>
                   and (not (@eq Values.block b bt)) (not (@eq Values.block b bf))) m mf)
               (jet_clight_internal_preserve.readonly_preserved m mf)))
