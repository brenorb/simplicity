     : forall (le : Maps.PTree.tree Values.val) (m mc ml mf : Memory.Mem.mem) (bi : Values.block)
         (src_ofs : Integers.Ptrofs.int) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int)
