         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets._n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr n))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs))
                (@Some Values.val (Values.Vlong old)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (jet_word_bits.clear_low ds old))) (@Some Memory.Mem.mem mc))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 mc bi (Integers.Ptrofs.unsigned src_ofs))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mc bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (jet_copyBits_helper_exec.copy_left_value ss ds old source)))
                (@Some Memory.Mem.mem ml))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 ml bi
                   (Integers.Ptrofs.unsigned
                      (Integers.Ptrofs.sub src_ofs
                         (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vlong next)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 ml bw (Integers.Ptrofs.unsigned dst_ofs)
