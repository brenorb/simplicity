       ClightBigstep.Clight2.exec_stmt jet_exec.ge0 Clight.empty_env le m jet_copyBits_helper_exec.copy_helper_tail
         Events.E0 (copy_partial_cross_env le bi src_ofs ss ds n old source next) mf
         (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type)))
### C.jet_copyBits_partial_crossing.eval_copy_helper_partial_cross
eval_copy_helper_partial_cross
     : forall (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (old source next : Integers.Int64.int)
         (_ : jet_frame_layout.frame_base_valid sbase) (_ : jet_frame_layout.frame_base_valid base)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc)
         (_ : jet_frame_layout.frame_fields_at m bd base bw outedge cursor)
         (_ : and (BinInt.Z.le BinNums.Z0 rc) (BinInt.Z.le rc Integers.Int64.max_unsigned))
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) cursor) (BinInt.Z.le cursor Integers.Int64.max_unsigned))
         (_ : and
                (BinInt.Z.le
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinInt.Z.div rc
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                   edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned)) (_ : BinInt.Z.le BinNums.Z0 outedge)
         (_ : BinInt.Z.le (jet_write_layout.write_word_address outedge cursor) Integers.Ptrofs.max_unsigned)
         (_ : and
                (BinInt.Z.lt
                   (BinInt.Z.sub
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (BinInt.Z.modulo rc
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                   n)
                (BinInt.Z.le n
                   (BinInt.Z.modulo cursor
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : or (not (@eq Values.block bd bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) base)
                   (BinInt.Z.le
                      (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (jet_write_layout.write_word_address outedge cursor))))
         (_ : or (not (@eq Values.block bi bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add
                         (BinInt.Z.sub edge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                  (BinInt.Z.div rc
                                     (BinNums.Zpos
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (jet_write_layout.write_word_address outedge cursor))
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.sub edge
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                               (BinInt.Z.div rc
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
         (_ : or (not (@eq Values.block bi bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add
                         (BinInt.Z.sub edge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                                  (BinInt.Z.div rc
                                     (BinNums.Zpos
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (jet_write_layout.write_word_address outedge cursor))
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.sub edge
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                               (BinInt.Z.div rc
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                            (BinInt.Z.div rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                            (BinInt.Z.div rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong next)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address outedge cursor))
                (@Some Values.val (Values.Vlong old)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bw (jet_write_layout.write_word_address outedge cursor)
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_exec.ge0 m (@Ctypes.Internal Clight.function jets.f_copyBitsHelper)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf bw (jet_write_layout.write_word_address outedge cursor))
                  (@Some Values.val
                     (Values.Vlong
                        (copy_partial_cross_value
                           (BinInt.Z.sub
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              (BinInt.Z.modulo rc
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                           (BinInt.Z.modulo cursor
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) old
                           source next))))
               (and (jet_frame_layout.frame_fields_at mf bd base bw outedge cursor)
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (jet_write_layout.write_word_address outedge cursor))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
### C.jet_copyBits_partial_crossing.copy_cross_env
copy_cross_env =
fun (le : Maps.PTree.tree Values.val) (bi : Values.block) (src_ofs : Integers.Ptrofs.int) (ss ds n : BinNums.Z) =>
@Maps.PTree.set Values.val jets._src_shift
  (Values.Vlong
     (Integers.Int64.repr
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
  (@Maps.PTree.set Values.val jets._src_ptr
     (Values.Vptr bi
        (Integers.Ptrofs.sub src_ofs
           (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     (@Maps.PTree.set Values.val jets._dst_shift (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub ds ss)))
        (@Maps.PTree.set Values.val jets._n (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub n ss))) le)))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments copy_cross_env le bi src_ofs (ss ds n)%Z_scope
### C.jet_copyBits_partial_crossing.copy_partial_cross_value
copy_partial_cross_value =
fun (ss ds : BinNums.Z) (old source next : Integers.Int64.int) =>
jet_copyBits_helper_right.copy_right_value
  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
