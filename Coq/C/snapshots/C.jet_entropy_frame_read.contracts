### C.jet_entropy_frame_read.entropy_read_prefix
entropy_read_prefix
     : forall (m : Memory.Mem.mem) (bs : Values.block) (sbase : BinNums.Z) (bi : Values.block)
         (edge rc : BinNums.Z) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (ix : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (con : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge rc) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Int64.max_unsigned)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc
                (@Translate.encode entropy_input_type
                   (@pair
                      (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S O))))))) h ix) con))),
       @ex Memory.Mem.mem'
         (fun m1 : Memory.Mem.mem' =>
          @ex Memory.Mem.mem'
            (fun m2 : Memory.Mem.mem' =>
             @ex Memory.Mem.mem'
               (fun m3 : Memory.Mem.mem' =>
                @ex Memory.Mem.mem'
                  (fun m4 : Memory.Mem.mem' =>
                   @ex Memory.Mem.mem'
                     (fun m5 : Memory.Mem.mem' =>
                      @ex Values.block
                        (fun bl : Values.block =>
                         @ex Values.block
                           (fun bo : Values.block =>
                            @ex Values.block
                              (fun bc : Values.block =>
                               @ex Values.block
                                 (fun br : Values.block =>
                                  @ex Values.block
                                    (fun bt : Values.block =>
                                     @ex (list Memdata.memval)
                                       (fun bytes : list Memdata.memval =>
                                        @ex Memory.Mem.mem
                                          (fun mcp : Memory.Mem.mem =>
                                           @ex Memory.Mem.mem
                                             (fun mtx : Memory.Mem.mem =>
                                              @ex Memory.Mem.mem
                                                (fun mi : Memory.Mem.mem =>
                                                 @ex Memory.Mem.mem (fun ... => @ex Memory.Mem.mem ...)))))))))))))))
### C.jet_entropy_frame_read.entropy_input_type
entropy_input_type =
Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
  (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     : Ty.Ty
