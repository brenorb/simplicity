### C.jet_secp_div62_numeric.div62_cancellation
div62_cancellation
     : forall (neg : bool) (eta i f g : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 eta)
                (BinInt.Z.le eta
                   (BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) i)
                (BinInt.Z.le i
                   (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.Odd f),
       let k : BinNums.Z := div62_cancel_bits neg eta i in
       let w : BinNums.Z :=
         Integers.Int.unsigned
           (jet_secp_div62_cancel.div62_w_word neg (Integers.Int64.repr f) (Integers.Int64.repr g)
              (jet_secp_div62_limit.div62_mask neg eta i)) in
       and (and (BinInt.Z.le BinNums.Z0 w) (BinInt.Z.lt w (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
         (and
            (BinInt.Z.divide (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               (BinInt.Z.add g (BinInt.Z.mul f w)))
            (@eq Integers.Int64.int
               (Integers.Int64.and
                  (Integers.Int64.add (Integers.Int64.repr g)
                     (Integers.Int64.mul (Integers.Int64.repr f)
                        (jet_secp_div62_cancel.div62_w_long neg (Integers.Int64.repr f) (Integers.Int64.repr g)
                           (jet_secp_div62_limit.div62_mask neg eta i)))) (jet_secp_div62_limit.div62_mask neg eta i))
               Integers.Int64.zero))
### C.jet_secp_div62_numeric.div62_cancel_bits
div62_cancel_bits =
fun (neg : bool) (eta i : BinNums.Z) =>
BinInt.Z.min (jet_secp_div62_limit.div62_limit eta i)
  match neg return BinNums.Z with
  | true => BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))
  | false => BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))
  end
     : forall (_ : bool) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments div62_cancel_bits neg%bool_scope (eta i)%Z_scope
### C.jet_secp_div62_numeric.div62_w4_polynomial
div62_w4_polynomial =
fun f : BinNums.Z =>
BinInt.Z.add f
  (BinInt.Z.shiftl
     (BinInt.Z.land (BinInt.Z.add f (BinNums.Zpos BinNums.xH)) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
     (BinNums.Zpos BinNums.xH))
     : forall _ : BinNums.Z, BinNums.Z

Arguments div62_w4_polynomial f%Z_scope
