### C.jet_secp_strauss_empty_stage.exec_strauss_empty_point_stage
exec_strauss_empty_point_stage
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (br : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_gej_set_infinity e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr br Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._bits le)
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : Memory.Mem.range_perm m br BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
               jet_secp_generator_point_stage.generator_point_stage Events.E0 (strauss_empty_stage_temps le) mf
               ClightBigstep.Out_normal)
            (and
               (jet_secp_fe_nv.fe_at mf br BinNums.Z0
                  (@List.repeat Integers.Int64.int Integers.Int64.zero (S (S (S (S (S O)))))))
               (and
                  (jet_secp_fe_nv.fe_at mf br
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (@List.repeat Integers.Int64.int Integers.Int64.zero (S (S (S (S (S O)))))))
                  (and
                     (jet_secp_fe_nv.fe_at mf br
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (@List.repeat Integers.Int64.int Integers.Int64.zero (S (S (S (S (S O)))))))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf br
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                           (@Some Values.val (Values.Vint Integers.Int.one)))
                        (and
                           (Memory.Mem.range_perm mf br BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (jet_sx_mem.lframe
                                 (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b br)) m mf)
                              (forall (b : Values.block) (pos : BinNums.Z) (k : Memtype.perm_kind)
                                 (p : Memtype.permission),
                               iff (Memory.Mem.perm mf b pos k p) (Memory.Mem.perm m b pos k p)))))))))
### C.jet_secp_strauss_empty_stage.strauss_empty_stage_other
strauss_empty_stage_other
     : forall (le : Maps.PTree.tree Values.val) (id : AST.ident) (_ : not (@eq AST.ident id jets_secp._i))
         (_ : not (@eq AST.ident id jets_secp._t'16)),
       @eq (option Values.val) (@Maps.PTree.get Values.val id (strauss_empty_stage_temps le))
         (@Maps.PTree.get Values.val id le)
### C.jet_secp_strauss_empty_stage.strauss_empty_stage_temps
strauss_empty_stage_temps =
fun le : Maps.PTree.tree Values.val =>
@Maps.PTree.set Values.val jets_secp._t'16 (Values.Vint Integers.Int.one)
  (@Maps.PTree.set Values.val jets_secp._i (Values.Vint (Integers.Int.repr (BinNums.Zneg BinNums.xH))) le)
     : forall _ : Maps.PTree.tree Values.val, Maps.PTree.tree Values.val

Arguments strauss_empty_stage_temps le
