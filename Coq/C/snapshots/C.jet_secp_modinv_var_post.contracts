inv_post_word =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) (high : bool) (i : nat) =>
match inv_control_stops len rho return Integers.Int64.int with
| true => jet_secp_modinv_var_shorten.inv_control_word rho high i
| false => jet_secp_modinv_var_shorten.inv_control_short_word len rho high i
end
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : bool) (_ : nat), Integers.Int64.int

Arguments inv_post_word len%nat_scope rho%function_scope high%bool_scope i%nat_scope
### C.jet_secp_modinv_var_post.inv_post_modified
inv_post_modified =
@app AST.ident jet_secp_modinv_var_zero.inv_test_modified jet_secp_modinv_var_shorten.inv_shorten_modified
     : list AST.ident
### C.jet_secp_modinv_var_post.inv_post_temp_frame
inv_post_temp_frame =
fun le lf : Clight.temp_env =>
forall (id : AST.ident) (_ : not (@List.In AST.ident id inv_post_modified)),
@eq (option Values.val) (@Maps.PTree.get Values.val id lf) (@Maps.PTree.get Values.val id le)
     : forall (_ : Clight.temp_env) (_ : Clight.temp_env), Prop

Arguments inv_post_temp_frame le lf
### C.jet_secp_modinv_var_post.inv_post_next_rho
inv_post_next_rho =
fun (len : nat) (rho : forall _ : nat, Integers.Int64.int) (n : nat) =>
match n return Integers.Int64.int with
| O => rho n
| S n0 =>
    match n0 return Integers.Int64.int with
    | O => rho n
    | S n1 =>
        match n1 return Integers.Int64.int with
        | O => rho n
        | S n2 =>
            match n2 return Integers.Int64.int with
            | O => rho n
            | S n3 =>
                match n3 return Integers.Int64.int with
                | O => rho n
                | S n4 =>
                    match n4 return Integers.Int64.int with
                    | O => inv_post_word len rho false O
                    | S n5 =>
                        match n5 return Integers.Int64.int with
                        | O => inv_post_word len rho false (S O)
                        | S n6 =>
                            match n6 return Integers.Int64.int with
                            | O => inv_post_word len rho false (S (S O))
                            | S n7 =>
                                match n7 return Integers.Int64.int with
                                | O => inv_post_word len rho false (S (S (S O)))
                                | S n8 =>
                                    match n8 return Integers.Int64.int with
                                    | O => inv_post_word len rho false (S (S (S (S O))))
                                    | S n9 =>
                                        match n9 return Integers.Int64.int with
                                        | O => inv_post_word len rho true O
                                        | S n10 =>
                                            match n10 return Integers.Int64.int with
                                            | O => inv_post_word len rho true (S O)
                                            | S n11 =>
                                                match n11 return Integers.Int64.int with
                                                | O => inv_post_word len rho true (S (S O))
                                                | S n12 =>
                                                    match n12 return Integers.Int64.int with
                                                    | O => inv_post_word len rho true (S (S (S O)))
                                                    | S n13 =>
                                                        match n13 return Integers.Int64.int with
                                                        | O => inv_post_word len rho true (S (S (S (S O))))
                                                        | S _ => rho n
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end
     : forall (_ : nat) (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments inv_post_next_rho len%nat_scope rho%function_scope n%nat_scope
