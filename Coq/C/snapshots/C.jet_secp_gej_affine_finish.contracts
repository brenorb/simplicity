                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mr bd BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_secp_square_columns.square_input_bounds
                                       (jet_secp_point_mul_storage.point_mul_words x
                                          (jet_secp_square_numeric.square_words zi)))
                                    (and
                                       (jet_secp_square_columns.square_input_bounds
                                          (jet_secp_point_mul_storage.point_mul_words y
                                             (jet_secp_point_mul_storage.point_mul_words zi
                                                (jet_secp_square_numeric.square_words zi))))
                                       (and
                                          (@eq BinNums.Z
                                             (BinInt.Z.modulo
                                                (jet_secp_multiply_finish_product.radix_value
                                                   (jet_secp_point_mul_storage.point_mul_words x
                                                      (jet_secp_square_numeric.square_words zi)))
                                                jet_secp_multiply_checkpoint_columns.field_prime)
                                             (BinInt.Z.modulo
                                                (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value x)
                                                   (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                                                      (jet_secp_multiply_finish_product.radix_value zi)))
                                                jet_secp_multiply_checkpoint_columns.field_prime))
                                          (and
                                             (@eq BinNums.Z
                                                (BinInt.Z.modulo
                                                   (jet_secp_multiply_finish_product.radix_value
                                                      (jet_secp_point_mul_storage.point_mul_words y
                                                         (jet_secp_point_mul_storage.point_mul_words zi
                                                            (jet_secp_square_numeric.square_words zi))))
                                                   jet_secp_multiply_checkpoint_columns.field_prime)
                                                (BinInt.Z.modulo
                                                   (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value y)
                                                      (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value zi)
                                                         (BinInt.Z.mul
                                                            (jet_secp_multiply_finish_product.radix_value zi)
                                                            (jet_secp_multiply_finish_product.radix_value zi))))
                                                   jet_secp_multiply_checkpoint_columns.field_prime))
                                             (jet_sx_mem.lframe
                                                (fun (bx : Values.block) (pos : BinNums.Z) =>
                                                 and (affine_after_inverse_frame bp bd b2 b3 bx pos)
                                                   (and (not (@eq Values.block bx b2)) (not (@eq Values.block bx b3))))
                                                m mr)))))))))))))
### C.jet_secp_gej_affine_finish.affine_set_one_statement
affine_set_one_statement =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_fe_set_int jets_secp.f_secp256k1_fe_set_int
  (@None AST.ident)
  (@cons Clight.expr (jet_secp_gej_affine_arithmetic.affine_point_address jets_secp._z)
     (@cons Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) (@nil Clight.expr)))
     : Clight.statement
### C.jet_secp_gej_affine_finish.affine_set_xy_statement
affine_set_xy_statement =
jet_secp_curve_statements.curve_call jets_secp._secp256k1_ge_set_xy jets_secp.f_secp256k1_ge_set_xy
  (@None AST.ident)
  (@cons Clight.expr (Clight.Etempvar jets_secp._r (Ctypesdefs.tptr jet_secp_curve_statements.curve_ge_type))
     (@cons Clight.expr (jet_secp_gej_affine_arithmetic.affine_point_address jets_secp._x)
        (@cons Clight.expr (jet_secp_gej_affine_arithmetic.affine_point_address jets_secp._y) (@nil Clight.expr))))
     : Clight.statement
### C.jet_secp_gej_affine_finish.affine_finish_frame
affine_finish_frame =
fun (bp bd bx : Values.block) (pos : BinNums.Z) =>
and (not (@eq Values.block bx bd))
  (or (not (@eq Values.block bx bp))
     (or
        (BinInt.Z.lt pos
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
        (BinInt.Z.le
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))) pos)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments affine_finish_frame bp bd bx pos%Z_scope
### C.jet_secp_gej_affine_finish.affine_after_inverse_frame
affine_after_inverse_frame =
fun (bp bd b2 b3 bx : Values.block) (pos : BinNums.Z) =>
and (jet_secp_gej_affine_arithmetic.affine_arithmetic_frame bp b2 b3 bx pos) (not (@eq Values.block bx bd))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : BinNums.Z), Prop

Arguments affine_after_inverse_frame bp bd b2 b3 bx pos%Z_scope
