         (_ : jet_secp_fe_nv.fe_at m bi BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho t)))
         (_ : @List.Forall Values.block
                (fun b : Values.block =>
                 Memory.Mem.range_perm m b BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                   Memtype.Cur Memtype.Freeable)
                (@cons Values.block bi
                   (@cons Values.block bw
                      (@cons Values.block ba
                         (@cons Values.block bx
                            (@cons Values.block bj
                               (@cons Values.block bb
                                  (@cons Values.block bc
                                     (@cons Values.block bA
                                        (@cons Values.block bB
                                           (@cons Values.block bC
                                              (@cons Values.block by1
                                                 (@cons Values.block by2
                                                    (@cons Values.block by3 (@cons Values.block bt (@nil Values.block))))))))))))))))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex (forall _ : nat, Integers.Int64.int)
               (fun x : forall _ : nat, Integers.Int64.int =>
                @ex (forall _ : nat, Integers.Int64.int)
                  (fun y : forall _ : nat, Integers.Int64.int =>
                   and
                     (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                        (Clight.fn_body jets_secp.f_shallue_van_de_woestijne) Events.E0 lef mf ClightBigstep.Out_normal)
                     (and (jet_secp_fe_nv.fe_at mf bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                        (and
                           (jet_secp_fe_nv.fe_at mf bp
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              (jet_secp_multiply_normalize_bridge.words5 y))
                           (and
                              (@eq (option Values.val)
                                 (Memory.Mem.load AST.Mint32 mf bp
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                 (@Some Values.val (Values.Vint Integers.Int.zero)))
                              (and
                                 (Memory.Mem.range_perm mf bp BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (@List.Forall Values.block
                                       (fun b : Values.block =>
                                        Memory.Mem.range_perm mf b BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (@cons Values.block bi
                                          (@cons Values.block bw
                                             (@cons Values.block ba
                                                (@cons Values.block bx
                                                   (@cons Values.block bj
                                                      (@cons Values.block bb
                                                         (@cons Values.block bc
                                                            (@cons Values.block bA
                                                               (@cons Values.block bB (@cons Values.block bC (...))))))))))))
                                    (and (jet_secp_square_columns.square_input_bounds x)
                                       (and (jet_secp_square_columns.square_input_bounds y)
                                          (and
                                             (@eq
                                                (prod (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...))))))))
                                                (@pair (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (Ty.tySem (Word.Word (S (S (S (S (...)))))))
                                                   (jet_secp_rescale_literal.rescale_field_output x)
                                                   (jet_secp_rescale_literal.rescale_field_output y))
                                                (@jet_secp_swu_literal.literal_swu Alg.CoreFunSem t))
                                             (and (jet_secp_swu_startup.swu_startup mf)
                                                (and
                                                   (jet_sx_mem.lframe
                                                      (fun (b : Values.block) (_ : BinNums.Z) =>
                                                       not
                                                         (@List.In Values.block b
                                                            (@cons Values.block bp
                                                               (@cons Values.block bi (@cons Values.block bw ...))))) m
                                                      mf) (jet_clight_internal_preserve.readonly_preserved m mf)))))))))))))))
