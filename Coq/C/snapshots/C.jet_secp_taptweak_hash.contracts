### C.jet_secp_taptweak_hash.taptweak_pad_bytes
taptweak_pad_bytes
     : @eq (list Integers.Int.int)
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int jet_read8s_layout.word8_array_value
            (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O)))))) taptweak_pad_word))
         (jet_sha_finalize_exec.sha_pad
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
### C.jet_secp_taptweak_hash.secp_hash_bytes_word
secp_hash_bytes_word
     : forall w : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Integers.Int.int) (jet_secp_sha_hash32.secp_hash_bytes (jet_sha_ctx8_model.state_regs w))
         (jet_secp_schnorr_challenge_hash.schnorr_word_bytes w)
### C.jet_secp_taptweak_hash.taptweak_hash_registers
taptweak_hash_registers
     : forall pk h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Integers.Int.int) (jet_sha_ctx8_model.state_regs (taptweak_hash_word pk h))
         (SHA256.hash_block
            (SHA256.hash_block (jet_sha_ctx8_model.state_regs jet_secp_taptweak_tag.taptweak_iv_word)
               (jet_sha_ctx8_model.be_words
                  (@app Integers.Int.int (jet_secp_schnorr_challenge_hash.schnorr_word_bytes pk)
                     (jet_secp_schnorr_challenge_hash.schnorr_word_bytes h))))
            (jet_sha_ctx8_model.be_words
               (jet_sha_finalize_exec.sha_pad
                  (Integers.Int64.repr
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
### C.jet_secp_taptweak_hash.eval_taptweak_message_hash
eval_taptweak_message_hash
     : forall (_ : jet_memcpy_model.memcpy_model) (pk h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (m : Memory.Mem.mem) (bc bs bt bb : Values.block)
         (_ : @List.NoDup Values.block
                (@cons Values.block bc
                   (@cons Values.block bs (@cons Values.block bt (@cons Values.block bb (@nil Values.block))))))
         (_ : jet_secp_sha_startup.secp_sha_startup m)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_uint32_array_init.uint32_array_at m bt BinNums.Z0 (jet_sha_ctx8_model.state_regs h))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bc BinNums.Z0)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : jet_uint32_array_init.uint32_array_at m bs BinNums.Z0
                (jet_sha_ctx8_model.state_regs jet_secp_taptweak_tag.taptweak_iv_word))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val
                   (Values.Vlong
                      (Integers.Int64.repr
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinInt.Z.add (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.of_nat i)))
                (@Some Values.val
                   (Values.Vint
                      (@List.nth Integers.Int.int i (jet_secp_schnorr_challenge_hash.schnorr_word_bytes pk)
                         Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m2 : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                     (@Ctypes.Internal Clight.function jets_secp.f_sha256_hash)
                     (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 m1
                     Values.Vundef)
                  (and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m1
                        (@Ctypes.Internal Clight.function jets_secp.f_sha256_finalize)
                        (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 m2
                        (Values.Vint Integers.Int.one))
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m2
                           (@Ctypes.Internal Clight.function jets_secp.f_sha256_fromMidstate)
                           (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                           Values.Vundef)
                        (and
                           (jet_read8s_layout.uint8_array_at mf bb BinNums.Z0
                              (jet_secp_schnorr_challenge_hash.schnorr_word_bytes (taptweak_hash_word pk h)))
                           (and
                              (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                                 (jet_sha_ctx8_model.state_regs (taptweak_hash_word pk h)))
                              (and
                                 (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                                    (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
                                 (and
                                    (@eq (option Values.val)
                                       (Memory.Mem.load AST.Mint64 mf bc
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                       (@Some Values.val
                                          (Values.Vlong
                                             (Integers.Int64.repr
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                                    (and
                                       (@eq (option Values.val)
                                          (Memory.Mem.load AST.Mint8unsigned mf bc
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                          (@Some Values.val (Values.Vint Integers.Int.zero)))
                                       (and
                                          (Memory.Mem.range_perm mf bc BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (Memory.Mem.range_perm mf bs BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                Memtype.Cur Memtype.Freeable)
                                             (and
                                                (Memory.Mem.range_perm mf bt BinNums.Z0
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                   Memtype.Cur Memtype.Freeable)
                                                (and
                                                   (Memory.Mem.range_perm mf bb BinNums.Z0
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                      Memtype.Cur Memtype.Freeable)
                                                   (and
                                                      (jet_uint32_array_init.uint32_array_at mf bt BinNums.Z0
                                                         (jet_sha_ctx8_model.state_regs h))
                                                      (and
                                                         (jet_sx_mem.lframe
                                                            (fun (b : Values.block) (_ : BinNums.Z) =>
                                                             and (not (@eq Values.block b bc))
                                                               (and (not (...)) (not (...)))) m mf)
                                                         (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                                            (jet_secp_sha_startup.secp_sha_startup mf))))))))))))))))))
### C.jet_secp_taptweak_hash.taptweak_message_hash_source
taptweak_message_hash_source
     : @eq Clight.statement
         (jet_secp_root_chain_owned.root_drop_statements (S (S (S (S (S (S (S (S O))))))))
            (Clight.fn_body jets_secp.f_simplicity_generic_taptweak))
         (Clight.Ssequence taptweak_message_absorb
            (Clight.Ssequence taptweak_message_finalize
               (Clight.Ssequence taptweak_message_digest
                  (jet_secp_root_chain_owned.root_drop_statements (S (S (S (S (S (S (S (S (S (S (S O)))))))))))
                     (Clight.fn_body jets_secp.f_simplicity_generic_taptweak)))))
### C.jet_secp_taptweak_hash.exec_taptweak_hash_calls
exec_taptweak_hash_calls
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m m1 m2 mf : Memory.Mem.mem) (bc bs bt bb : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_hash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_finalize e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._sha256_fromMidstate e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._ctx__1 e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc jet_secp_generator_sha_start.generator_sha_ctx_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._output_hash e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bs jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._input_hash e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bt jet_secp_generator_sha_start.generator_sha_state_type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._buf e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bb
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_sha256_hash)
                (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 m1
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m1
                (@Ctypes.Internal Clight.function jets_secp.f_sha256_finalize)
                (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 m2
                (Values.Vint Integers.Int.one))
         (_ : ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m2
                (@Ctypes.Internal Clight.function jets_secp.f_sha256_fromMidstate)
                (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m taptweak_message_hash_stmt Events.E0 le mf
         ClightBigstep.Out_normal
