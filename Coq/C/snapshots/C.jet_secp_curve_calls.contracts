### C.jet_secp_curve_calls.curve_square_cube_calls
curve_square_cube_calls
     : forall (x y : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba b_y2 bx : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : not (@eq Values.block ba b_y2)) (_ : not (@eq Values.block ba bx)) (_ : not (@eq Values.block b_y2 bx))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b_y2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m2 : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                     (@cons Values.val (Values.Vptr b_y2 Integers.Ptrofs.zero)
                        (@cons Values.val
                           (Values.Vptr ba
                              (Integers.Ptrofs.repr
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@nil Values.val))) Events.E0 m1 Values.Vundef)
                  (and
                     (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m1
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                        (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 m2
                        Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m2
                           (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                           (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0
                           mf Values.Vundef)
                        (and
                           (jet_secp_fe_nv.fe_at mf b_y2 BinNums.Z0
                              (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_numeric.square_words y)))
                           (and
                              (jet_secp_fe_nv.fe_at mf bx BinNums.Z0
                                 (jet_secp_multiply_normalize_bridge.words5
                                    (jet_secp_point_mul_storage.point_mul_words
                                       (jet_secp_square_numeric.square_words x) x)))
                              (and
                                 (jet_secp_fe_nv.fe_at mf ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
                                 (and
                                    (jet_secp_fe_nv.fe_at mf ba
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                       (jet_secp_multiply_normalize_bridge.words5 y))
                                    (and
                                       (Memory.Mem.range_perm mf ba BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (Memory.Mem.range_perm mf b_y2 BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (Memory.Mem.range_perm mf bx BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                                Memtype.Cur Memtype.Freeable)
                                             (and
                                                (@eq BinNums.Z
                                                   (BinInt.Z.modulo
                                                      (jet_secp_multiply_finish_product.radix_value
                                                         (jet_secp_square_numeric.square_words y)) jet_secp_fe_math.feP)
                                                   (BinInt.Z.modulo
                                                      (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value y)
                                                         (jet_secp_multiply_finish_product.radix_value y))
                                                      jet_secp_fe_math.feP))
                                                (and
                                                   (@eq BinNums.Z
                                                      (BinInt.Z.modulo
                                                         (jet_secp_multiply_finish_product.radix_value
                                                            (jet_secp_point_mul_storage.point_mul_words
                                                               (jet_secp_square_numeric.square_words x) x))
                                                         jet_secp_fe_math.feP)
                                                      (BinInt.Z.modulo
                                                         (BinInt.Z.mul
                                                            (BinInt.Z.mul
                                                               (jet_secp_multiply_finish_product.radix_value x)
                                                               (jet_secp_multiply_finish_product.radix_value x))
                                                            (jet_secp_multiply_finish_product.radix_value x))
                                                         jet_secp_fe_math.feP))
                                                   (and
                                                      (forall (i : nat) (_ : lt i (S (S (S (...))))),
                                                       BinInt.Z.lt
                                                         (Integers.Int64.unsigned
                                                            (jet_secp_square_numeric.square_words y i))
                                                         match PeanoNat.Nat.eqb i (S (S ...)) return BinNums.Z with
                                                         | true =>
                                                             BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...)))
                                                         | false =>
                                                             BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...)))
                                                         end)
                                                      (and
                                                         (forall (i : nat) (_ : lt i (S (S (...)))),
                                                          BinInt.Z.lt
                                                            (Integers.Int64.unsigned
                                                               (jet_secp_point_mul_storage.point_mul_words
                                                                  (jet_secp_square_numeric.square_words x) x i))
                                                            match PeanoNat.Nat.eqb i (S ...) return BinNums.Z with
                                                            | true => BinNums.Zpos (BinNums.xO (BinNums.xO ...))
                                                            | false => BinNums.Zpos (BinNums.xO (BinNums.xO ...))
                                                            end)
                                                         (jet_sx_mem.lframe
                                                            (fun (b : Values.block) (_ : BinNums.Z) =>
                                                             and (not (@eq Values.block b ba))
                                                               (and (not (...)) (not (...)))) m mf)))))))))))))))))
### C.jet_secp_curve_calls.curve_six_arithmetic_calls
curve_six_arithmetic_calls
     : forall (x y : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (ba b_y2 bx : Values.block)
         (_ : jet_secp_square_columns.square_input_bounds x) (_ : jet_secp_square_columns.square_input_bounds y)
         (_ : not (@eq Values.block ba b_y2)) (_ : not (@eq Values.block ba bx)) (_ : not (@eq Values.block b_y2 bx))
         (_ : jet_secp_fe_nv.fe_at m ba BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : jet_secp_fe_nv.fe_at m ba
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (jet_secp_multiply_normalize_bridge.words5 y))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b_y2 BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m2 : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun m3 : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun m4 : Memory.Mem.mem =>
                   @ex Memory.Mem.mem
                     (fun m5 : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun mf : Memory.Mem.mem =>
                         and
                           (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
                              (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                              (@cons Values.val (Values.Vptr b_y2 Integers.Ptrofs.zero)
                                 (@cons Values.val
                                    (Values.Vptr ba
                                       (Integers.Ptrofs.repr
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                    (@nil Values.val))) Events.E0 m1 Values.Vundef)
                           (and
                              (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m1
                                 (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_sqr)
                                 (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)))
                                 Events.E0 m2 Values.Vundef)
                              (and
                                 (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m2
                                    (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_mul)
                                    (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                       (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                          (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))))
                                    Events.E0 m3 Values.Vundef)
                                 (and
                                    (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m3
                                       (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add_int)
                                       (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                          (@cons Values.val
                                             (Values.Vint
                                                (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH)))))
                                             (@nil Values.val))) Events.E0 m4 Values.Vundef)
                                    (and
                                       (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m4
                                          (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_weak)
                                          (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero) (@nil Values.val))
                                          Events.E0 m5 Values.Vundef)
                                       (and
                                          (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m5
                                             (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_equal_var)
                                             (@cons Values.val (Values.Vptr b_y2 Integers.Ptrofs.zero)
                                                (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                                                   (@nil Values.val))) Events.E0 mf
                                             (Values.Vint
                                                match
                                                  BinInt.Z.eqb
                                                    (BinInt.Z.modulo
                                                       (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value y)
                                                          (jet_secp_multiply_finish_product.radix_value y))
                                                       jet_secp_fe_math.feP)
                                                    (BinInt.Z.modulo
                                                       (BinInt.Z.add
                                                          (BinInt.Z.mul (BinInt.Z.mul ... ...)
                                                             (jet_secp_multiply_finish_product.radix_value x))
                                                          (BinNums.Zpos (BinNums.xI ...))) jet_secp_fe_math.feP)
                                                  return Integers.Int.int
                                                with
                                                | true => Integers.Int.one
                                                | false => Integers.Int.zero
                                                end))
                                          (and
                                             (jet_secp_fe_nv.fe_at mf ba BinNums.Z0
                                                (jet_secp_multiply_normalize_bridge.words5 x))
                                             (and
                                                (jet_secp_fe_nv.fe_at mf ba
                                                   (BinNums.Zpos
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...))))))
                                                   (jet_secp_multiply_normalize_bridge.words5 y))
                                                (and
                                                   (Memory.Mem.range_perm mf ba BinNums.Z0
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (...)))))
                                                      Memtype.Cur Memtype.Freeable)
                                                   (and
                                                      (Memory.Mem.range_perm mf b_y2 BinNums.Z0
                                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (...)))) Memtype.Cur
                                                         Memtype.Freeable)
                                                      (and
                                                         (Memory.Mem.range_perm mf bx BinNums.Z0
                                                            (BinNums.Zpos (BinNums.xO (...))) Memtype.Cur
                                                            Memtype.Freeable)
                                                         (jet_sx_mem.lframe
                                                            (fun (b : Values.block) (_ : BinNums.Z) =>
                                                             and (not ...) (and ... ...)) m mf)))))))))))))))))
