### C.jet_full_increment8_word.full_increment_word_spec_numeric
full_increment_word_spec_numeric
     : forall (n : nat) (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (x : Ty.tySem (Word.Word n)),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.PairToZ Word.BitToZ (Word.WordToZ n))
            (@jet_increment_spec.full_increment_word_spec Alg.CoreFunSem n
               (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word n)) c x)))
         (BinInt.Z.add (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ Word.BitToZ c))
### C.jet_full_increment8_word.full_increment8_values_denote_spec
full_increment8_values_denote_spec
     : forall (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (payload : Integers.Int64.int),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S O))))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S O)))))
            match full_increment8_carry (Bit.toBool c) (jet_read8.read8_result payload) return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (jet_spec.decode_word8
               (Integers.Int64.repr
                  (Integers.Int.unsigned (full_increment8_payload (Bit.toBool c) (jet_read8.read8_result payload))))))
         (@jet_spec.full_increment8_spec Alg.CoreFunSem
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S O))))) c
               (jet_spec.decode_word8 payload)))
### C.jet_full_increment8_word.full_increment8_carry
full_increment8_carry =
fun (cin : bool) (r : Integers.Int.int) =>
Integers.Int.ltu
  (Integers.Int.sub
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
     (jet_readBit_layout.bit_int cin))
  (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r)
     : forall (_ : bool) (_ : Integers.Int.int), bool

Arguments full_increment8_carry cin%bool_scope r
### C.jet_full_increment8_word.full_increment8_raw
full_increment8_raw =
fun (cin : bool) (r : Integers.Int.int) =>
Integers.Int.add
  (Integers.Int.mul Integers.Int.one
     (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r))
  (jet_readBit_layout.bit_int cin)
     : forall (_ : bool) (_ : Integers.Int.int), Integers.Int.int

Arguments full_increment8_raw cin%bool_scope r
### C.jet_full_increment8_word.full_increment8_payload
full_increment8_payload =
fun (cin : bool) (r : Integers.Int.int) =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (full_increment8_raw cin r)
     : forall (_ : bool) (_ : Integers.Int.int), Integers.Int.int

Arguments full_increment8_payload cin%bool_scope r
