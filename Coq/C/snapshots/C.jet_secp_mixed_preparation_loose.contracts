                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_secp._secp256k1_fe_normalize_weak e)
                (@None (prod Values.block Ctypes.type))) (_ : not (@eq Values.block bp bu))
         (_ : mixed_x_bound loose x)
         (_ : jet_secp_fe_nv.fe_at m bp BinNums.Z0 (jet_secp_multiply_normalize_bridge.words5 x))
         (_ : Memory.Mem.range_perm m bp BinNums.Z0
