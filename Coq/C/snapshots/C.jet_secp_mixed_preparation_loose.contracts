             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m
                  (jet_secp_mixed_copy_weak.mixed_copy_coordinate false) Events.E0 le mc ClightBigstep.Out_normal)
               (and
                  (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le mc
                     (jet_secp_mixed_copy_weak.mixed_weak_coordinate false) Events.E0 le mf ClightBigstep.Out_normal)
                  (and
                     (jet_secp_fe_nv.fe_at mf bu BinNums.Z0
                        (jet_secp_multiply_normalize_bridge.words5 (mixed_x_words loose x)))
                     (and
