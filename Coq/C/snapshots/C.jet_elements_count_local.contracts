### C.jet_elements_count_local.elements_count_carrier_encoding
elements_count_carrier_encoding
     : forall (r : Integers.Int64.int) (count : BinNums.Z) (_ : @eq BinNums.Z (Integers.Int64.unsigned r) count),
       @eq (Ty.tySem (Word.Word (jet_wide.wide_log jet_wide.W32)))
         (jet_wide_spec.decode_wide jet_wide.W32
            (Integers.Int64.zero_ext
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) r))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) count)
### C.jet_elements_count_local.elements_count_getter_local_spec
elements_count_getter_local_spec
     : forall (f : Clight.function) (field : AST.ident) (delta : BinNums.Z)
         (count : forall _ : jet_elements_prim.Elements.env, BinNums.Z)
         (spec : forall (_ : Ty.tySem Ty.Unit) (_ : jet_elements_prim.Elements.env),
                 option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 delta)
                (BinInt.Z.le delta
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_vars f)
                (Clight.fn_vars jets_elements.f_simplicity_version))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_params f)
                (Clight.fn_params jets_elements.f_simplicity_version))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_temps f)
                (Clight.fn_temps jets_elements.f_simplicity_version))
         (_ : @eq Ctypes.type (Clight.fn_return f) Ctypesdefs.tbool)
         (_ : @eq Clight.statement (Clight.fn_body f) (jet_elements_getter32_exec.elements_getter32_body field))
         (_ : match
                @Maps.PTree.get Ctypes.composite jets_elements._elementsTransaction
                  (Clight.genv_cenv jet_elements_linkage.elements_ge) return Prop
              with
              | Some co =>
                  @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
                    (Ctypes.field_offset (Clight.genv_cenv jet_elements_linkage.elements_ge) field
                       (Ctypes.co_members co))
                    (@Errors.OK (prod BinNums.Z Ctypes.bitfield) (@pair BinNums.Z Ctypes.bitfield delta Ctypes.Full))
              | None => False
              end)
         (_ : forall environment : jet_elements_prim.Elements.env,
              @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) (spec tt environment)
                (@Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
                   (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (count environment)))),
       jet_application_contract.application_jet_local_spec f jet_elements_linkage.elements_ge
         jet_elements_prim.Elements.env Ty.Unit (Word.Word (S (S (S (S (S O)))))) (elements_count_env_rep delta count)
         spec
### C.jet_elements_count_local.elements_num_inputs_local_spec
elements_num_inputs_local_spec
     : jet_application_contract.application_jet_local_spec jets_elements.f_simplicity_num_inputs
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
         elements_num_inputs_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env) =>
          @jet_elements_count_canonical.elements_transaction_num_inputs_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
### C.jet_elements_count_local.elements_num_outputs_local_spec
elements_num_outputs_local_spec
     : jet_application_contract.application_jet_local_spec jets_elements.f_simplicity_num_outputs
         jet_elements_linkage.elements_ge jet_elements_prim.Elements.env Ty.Unit (Word.Word (S (S (S (S (S O))))))
         elements_num_outputs_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env) =>
          @jet_elements_count_canonical.elements_transaction_num_outputs_spec
            (jet_elements_prim.PrimitiveElements.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a
            environment)
### C.jet_elements_count_local.elements_count_env_rep
elements_count_env_rep =
fun (delta : BinNums.Z) (count : forall _ : jet_elements_prim.Elements.env, BinNums.Z) (m : Memory.Mem.mem)
  (env : Values.val) (environment : jet_elements_prim.Elements.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun value : Integers.Int64.int =>
               and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                 (and (and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
                    (and (BinInt.Z.le BinNums.Z0 txbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add txbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                             (and
                                (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (BinInt.Z.add txbase delta))
                                   (@Some Values.val (Values.Vlong value)))
                                (@eq BinNums.Z (Integers.Int64.unsigned value) (count environment))))))))))))
     : forall (_ : BinNums.Z) (_ : forall _ : jet_elements_prim.Elements.env, BinNums.Z) (_ : Memory.Mem.mem)
         (_ : Values.val) (_ : jet_elements_prim.Elements.env), Prop

Arguments elements_count_env_rep delta%Z_scope count%function_scope m env environment
### C.jet_elements_count_local.elements_num_inputs_env_rep
elements_num_inputs_env_rep =
elements_count_env_rep
  (BinNums.Zpos
     (BinNums.xO
        (BinNums.xO
           (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
  (fun environment : jet_elements_prim.Elements.env =>
   BinInt.Z.of_nat
     (@length jet_elements_prim.sigTxInput (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env), Prop

Arguments elements_num_inputs_env_rep m env environment
### C.jet_elements_count_local.elements_num_outputs_env_rep
elements_num_outputs_env_rep =
elements_count_env_rep
  (BinNums.Zpos
     (BinNums.xO
        (BinNums.xO
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))))
  (fun environment : jet_elements_prim.Elements.env =>
   BinInt.Z.of_nat
     (@length jet_elements_prim.txOutput (jet_elements_prim.sigTxOut (jet_elements_prim.Elements.envTx environment))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env), Prop

Arguments elements_num_outputs_env_rep m env environment
