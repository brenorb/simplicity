### C.jet_elements_count_local.elements_tx_num_inputs_field
elements_tx_num_inputs_field
     : match
         @Maps.PTree.get Ctypes.composite jets_elements._elementsTransaction
           (Clight.genv_cenv jet_elements_linkage.elements_ge) return Prop
       with
       | Some co =>
           @eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
             (Ctypes.field_offset (Clight.genv_cenv jet_elements_linkage.elements_ge) jets_elements._numInputs
                (Ctypes.co_members co))
             (@Errors.OK (prod BinNums.Z Ctypes.bitfield)
                (@pair BinNums.Z Ctypes.bitfield
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                   Ctypes.Full))
       | None => False
       end
### C.jet_elements_count_local.elements_tx_num_outputs_field
elements_tx_num_outputs_field
     : match
