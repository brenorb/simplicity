### C.jet_secp_modinv_fg_permissions.fg_internal_subset
fg_internal_subset
     : forall (id : AST.ident) (fd : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id fd) fg_internal_table),
       @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id fd) jet_secp_fns.secp_pure
### C.jet_secp_modinv_fg_permissions.fg_internal_checks_true
fg_internal_checks_true
     : @eq bool fg_internal_checks true
### C.jet_secp_modinv_fg_permissions.fg_internal_table_ok
fg_internal_table_ok
     : jet_clight_internal_frame.internal_table_ok jet_secp_linkage.secp_ge fg_internal_table
### C.jet_secp_modinv_fg_permissions.fg_internal_allowed
fg_internal_allowed
     : jet_clight_internal_frame.allowed_call fg_internal_table
         (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_update_fg_62_var)
### C.jet_secp_modinv_fg_permissions.eval_fg_transition_matrix_permissions
eval_fg_transition_matrix_permissions
     : forall (len : nat) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (m : Memory.Mem.mem) (_ : and (lt O len) (le len (S (S (S (S (S O)))))))
         (_ : @eq Integers.Int.int
                (Integers.Int64.loword (rho (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))
                (Integers.Int.repr (BinInt.Z.of_nat len))) (_ : jet_secp_modinv_fg_start.fg_input_bounds rho)
         (_ : jet_sx_state.rep rho beta jet_secp_modinv_fg_prefix.fg_regs m)
         (_ : Memory.Mem.range_perm m (jet_sx_state.blk beta (S (S O))) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_modinv64_update_fg_62_var)
               (@cons Values.val (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat len)))
                  (@cons Values.val
                     (Values.Vptr (jet_sx_state.blk beta O) (Integers.Ptrofs.repr (jet_sx_state.bas beta O)))
                     (@cons Values.val
                        (Values.Vptr (jet_sx_state.blk beta (S O)) (Integers.Ptrofs.repr (jet_sx_state.bas beta (S O))))
                        (@cons Values.val
                           (Values.Vptr (jet_sx_state.blk beta (S (S O)))
                              (Integers.Ptrofs.repr (jet_sx_state.bas beta (S (S O))))) (@nil Values.val))))) Events.E0
               mf Values.Vundef)
            (and
               (Memory.Mem.range_perm mf (jet_sx_state.blk beta (S (S O))) BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (forall (high : bool) (j : nat) (_ : lt j len),
                   @eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf
                        (jet_sx_state.blk beta match high return nat with
                                               | true => S O
                                               | false => O
                                               end)
                        (BinInt.Z.add (jet_sx_state.bas beta match high return nat with
                                                             | true => S O
                                                             | false => O
                                                             end)
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat j))))
                     (@Some Values.val (Values.Vlong (jet_secp_modinv_fg_body.fg_body_word len rho high j))))
                  (and
                     (forall high : bool,
                      @eq BinNums.Z (jet_secp_modinv_fg_body.fg_body_value len rho high)
                        (BinInt.Z.div (jet_secp_modinv_fg_body.fg_matrix_value rho high len)
                           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                              (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                     (and
                        (jet_sx_state.rep (jet_secp_modinv_fg_body.fg_body_rho len rho) beta
                           (jet_secp_modinv_fg_call.fg_call_out len) mf)
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot beta
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape jet_secp_modinv_fg_prefix.fg_regs) b ofs)) m mf))))))
### C.jet_secp_modinv_fg_permissions.fg_internal_table
fg_internal_table =
@cons (prod AST.ident Clight.function)
  (@pair AST.ident Clight.function jets_secp._secp256k1_mul128 jets_secp.f_secp256k1_mul128)
  (@cons (prod AST.ident Clight.function)
     (@pair AST.ident Clight.function jets_secp._secp256k1_i128_mul jets_secp.f_secp256k1_i128_mul)
     (@cons (prod AST.ident Clight.function)
        (@pair AST.ident Clight.function jets_secp._secp256k1_i128_accum_mul jets_secp.f_secp256k1_i128_accum_mul)
        (@cons (prod AST.ident Clight.function)
           (@pair AST.ident Clight.function jets_secp._secp256k1_i128_rshift jets_secp.f_secp256k1_i128_rshift)
           (@cons (prod AST.ident Clight.function)
              (@pair AST.ident Clight.function jets_secp._secp256k1_i128_to_u64 jets_secp.f_secp256k1_i128_to_u64)
              (@cons (prod AST.ident Clight.function)
                 (@pair AST.ident Clight.function jets_secp._secp256k1_i128_to_i64 jets_secp.f_secp256k1_i128_to_i64)
                 (@cons (prod AST.ident Clight.function)
                    (@pair AST.ident Clight.function jets_secp._secp256k1_modinv64_update_fg_62_var
                       jets_secp.f_secp256k1_modinv64_update_fg_62_var) (@nil (prod AST.ident Clight.function))))))))
     : list (prod AST.ident Clight.function)
### C.jet_secp_modinv_fg_permissions.fg_internal_checks
fg_internal_checks =
@List.forallb (prod AST.ident Clight.function)
  (fun p : prod AST.ident Clight.function =>
   andb (jet_clight_internal_frame.closed_stmtb fg_internal_table (Clight.fn_body (@snd AST.ident Clight.function p)))
     (@List.forallb (prod AST.ident Ctypes.type)
        (fun it : prod AST.ident Ctypes.type =>
         jet_clight_internal_frame.nonfunction_type (@snd AST.ident Ctypes.type it))
        (Clight.fn_vars (@snd AST.ident Clight.function p)))) fg_internal_table
     : bool
