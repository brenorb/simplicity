and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m b ofs) (@Some Values.val (Values.Vlong xv)))
  (jet_uint32_array_init.uint32_array_at m b
     (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) (Digest.hash256_reg H))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Digest.hash256),
       Prop

