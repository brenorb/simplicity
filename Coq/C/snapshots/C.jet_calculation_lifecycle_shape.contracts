### C.jet_calculation_lifecycle_shape.calc_function_composes
calc_function_composes
     : forall (f : Clight.function) (jid : AST.ident) (p : option BinNums.Z) (cf : Clight.function)
         (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 : Memory.Mem.mem') (mcp mr mt mc me mf : Memory.Mem.mem)
         (bl bh br bt bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bytes0 bytes1 : list Memdata.memval) (_ : jet_calculation_lifecycle_entry.calculation_frame_header f)
         (_ : @eq Clight.statement (Clight.fn_body f) (calc_body jid p))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jid
                   (jet_calculation_lifecycle_entry.calculation_frame_env bl bh br bt))
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.block)
                (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type
                   (Clight.genv_genv jet_elements_linkage.elements_ge) jid)
                (@Some Values.block (jet_elements_linkage.elements_symbol_block jid)))
         (_ : @eq (option Clight.fundef)
                (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type
                   (Clight.genv_genv jet_elements_linkage.elements_ge)
                   (Values.Vptr (jet_elements_linkage.elements_symbol_block jid) Integers.Ptrofs.zero))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function cf)))
         (_ : @eq Ctypes.type (Clight.type_of_fundef (@Ctypes.Internal Clight.function cf))
                (Ctypes.Tfunction (Ctypes.Tcons calc_mid_ptr (Ctypes.Tcons calc_mid_ptr (calc_suffix_types p)))
                   Ctypesdefs.tvoid calc_cc)) (_ : jet_frame_layout.frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs)) (_ : not (@eq Values.block br bt))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bh))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m3 br))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m4 bt))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m4 bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes0))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m4 bl BinNums.Z0 bytes0) (@Some Memory.Mem.mem mcp))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mcp
                (@Ctypes.Internal Clight.function jets_elements.f_read32s)
                (@cons Values.val (Values.Vptr bh Integers.Ptrofs.zero)
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mr
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mr
                (@Ctypes.Internal Clight.function cf)
                (@app Values.val
                   (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vptr bh Integers.Ptrofs.zero) (@nil Values.val)))
                   (calc_suffix_values p)) Events.E0 mt Values.Vundef)
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mt bt BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@Some (list Memdata.memval) bytes1))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mt br BinNums.Z0 bytes1) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge mc
                (@Ctypes.Internal Clight.function jets_elements.f_writeHash)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free_list me
                   (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                      (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                         (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bh BinNums.Z0)
                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bt BinNums.Z0)
                               (BinNums.Zpos
                                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                               (@pair (prod Values.block BinNums.Z) BinNums.Z
                                  (@pair Values.block BinNums.Z br BinNums.Z0)
                                  (BinNums.Zpos
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m (@Ctypes.Internal Clight.function f)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
### C.jet_calculation_lifecycle_shape.calc_mid
calc_mid = Ctypes.Tstruct jets_elements._sha256_midstate Ctypes.noattr
     : Ctypes.type
### C.jet_calculation_lifecycle_shape.calc_mid_ptr
calc_mid_ptr = Ctypesdefs.tptr calc_mid
     : Ctypes.type
### C.jet_calculation_lifecycle_shape.calc_fr
calc_fr = Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr
     : Ctypes.type
### C.jet_calculation_lifecycle_shape.calc_cc
calc_cc = AST.mkcallconv (@None BinNums.Z) false true
     : AST.calling_convention
### C.jet_calculation_lifecycle_shape.calc_suffix_types
calc_suffix_types =
fun p : option BinNums.Z =>
match p return Ctypes.typelist with
| Some _ => Ctypes.Tcons Ctypesdefs.tint Ctypes.Tnil
| None => Ctypes.Tnil
end
     : forall _ : option BinNums.Z, Ctypes.typelist

Arguments calc_suffix_types p
### C.jet_calculation_lifecycle_shape.calc_suffix_exprs
calc_suffix_exprs =
fun p : option BinNums.Z =>
match p return (list Clight.expr) with
| Some z => @cons Clight.expr (Clight.Econst_int (Integers.Int.repr z) Ctypesdefs.tint) (@nil Clight.expr)
| None => @nil Clight.expr
end
     : forall _ : option BinNums.Z, list Clight.expr

Arguments calc_suffix_exprs p
### C.jet_calculation_lifecycle_shape.calc_suffix_values
calc_suffix_values =
fun p : option BinNums.Z =>
match p return (list Values.val) with
| Some z => @cons Values.val (Values.Vint (Integers.Int.repr z)) (@nil Values.val)
| None => @nil Values.val
end
     : forall _ : option BinNums.Z, list Values.val

Arguments calc_suffix_values p
### C.jet_calculation_lifecycle_shape.calc_copy_src
calc_copy_src =
Clight.Sassign (Clight.Evar jets_elements._src calc_fr) (Clight.Etempvar jets_elements._src calc_fr)
     : Clight.statement
