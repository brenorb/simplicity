### C.jet_elements_taptweak_hash32.elements_taptweak_hash32_lookup
elements_taptweak_hash32_lookup
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef)
            (jet_secp_linkage.secp_helper_lookup jet_elements_taptweak_pure.elements_taptweak_ge)
            elements_taptweak_hash32_helpers)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun it : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function it))) elements_taptweak_hash32_helpers)
### C.jet_elements_taptweak_hash32.elements_taptweak_hash_midstate_checked
elements_taptweak_hash_midstate_checked
     : @eq bool
         (jet_transport.expr_okb jet_secp_linkage.secp_ge jet_elements_taptweak_pure.elements_taptweak_ge
            (Clight.Efield
               (Clight.Ederef
                  (Clight.Etempvar jets_secp._h
                     (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr)))
                  (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr)) jets_secp._s
               (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         true
### C.jet_elements_taptweak_hash32.eval_elements_taptweak_hash_midstate
eval_elements_taptweak_hash_midstate
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bt : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._h le)
                (@Some Values.val (Values.Vptr bt Integers.Ptrofs.zero))),
       Clight.eval_expr jet_elements_taptweak_pure.elements_taptweak_ge e le m
         (Clight.Efield
            (Clight.Ederef
               (Clight.Etempvar jets_secp._h
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr)))
               (Ctypes.Tstruct jets_secp._sha256_midstate Ctypes.noattr)) jets_secp._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr bt Integers.Ptrofs.zero)
### C.jet_elements_taptweak_hash32.exec_elements_taptweak_hash32_call
exec_elements_taptweak_hash32_call
     : forall (id : AST.ident) (fd : Clight.function) (args : list Clight.expr) (vargs : list Values.val)
         (v : Values.val) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id fd)
                elements_taptweak_hash32_helpers)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@None (prod Values.block Ctypes.type)))
         (_ : Clight.eval_exprlist jet_elements_taptweak_pure.elements_taptweak_ge e le m args
                (Ctypes.type_of_params (Clight.fn_params fd)) vargs)
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
                (@Ctypes.Internal Clight.function fd) vargs Events.E0 mf v),
       ClightBigstep.Clight2.exec_stmt jet_elements_taptweak_pure.elements_taptweak_ge e le m
         (jet_secp_curve_statements.curve_call id fd (@None AST.ident) args) Events.E0 le mf ClightBigstep.Out_normal
### C.jet_elements_taptweak_hash32.eval_elements_taptweak_sha_hash32
eval_elements_taptweak_sha_hash32
     : forall (_ : jet_memcpy_model.memcpy_model) (l regs regsH : list Integers.Int.int) (total : BinNums.Z)
         (m : Memory.Mem.mem) (bc bs bt : Values.block)
         (_ : or (@eq nat (@length Integers.Int.int l) O)
                (@eq nat (@length Integers.Int.int l)
                   (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq nat (@length Integers.Int.int regsH) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le BinNums.Z0 total)
         (_ : BinInt.Z.lt
                (BinInt.Z.add total
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo total
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (BinInt.Z.of_nat (@length Integers.Int.int l)))
         (_ : @List.NoDup Values.block
                (@cons Values.block bc (@cons Values.block bs (@cons Values.block bt (@nil Values.block)))))
         (_ : jet_elements_taptweak_globals.elements_taptweak_sha_startup m)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bs BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bt BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : jet_uint32_array_init.uint32_array_at m bt BinNums.Z0 regsH)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bc BinNums.Z0)
                (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
         (_ : jet_uint32_array_init.uint32_array_at m bs BinNums.Z0 regs)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some Values.val (Values.Vlong (Integers.Int64.repr total))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vint Integers.Int.zero)))
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int l)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bc
                   (BinInt.Z.add (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i l Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_elements_taptweak_pure.elements_taptweak_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_sha256_hash)
               (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bt Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (jet_uint32_array_init.uint32_array_at mf bs BinNums.Z0
                  (jet_secp_sha_append32.sha_append32_regs l regs (jet_secp_sha_hash32.secp_hash_bytes regsH)))
               (and
                  (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc BinNums.Z0)
                     (@Some Values.val (Values.Vptr bs Integers.Ptrofs.zero)))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf bc
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (@Some Values.val
                           (Values.Vlong
                              (Integers.Int64.repr
                                 (BinInt.Z.add total
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint8unsigned mf bc
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@Some Values.val (Values.Vint Integers.Int.zero)))
                        (and
                           (forall (i : nat)
                              (_ : lt i
                                     (@length Integers.Int.int
                                        (jet_secp_sha_append32.sha_append32_buffer l
                                           (jet_secp_sha_hash32.secp_hash_bytes regsH)))),
                            @eq (option Values.val)
                              (Memory.Mem.load AST.Mint8unsigned mf bc
                                 (BinInt.Z.add
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                    (BinInt.Z.of_nat i)))
                              (@Some Values.val
                                 (Values.Vint
                                    (@List.nth Integers.Int.int i
                                       (jet_secp_sha_append32.sha_append32_buffer l
                                          (jet_secp_sha_hash32.secp_hash_bytes regsH)) Integers.Int.zero))))
                           (and
                              (Memory.Mem.range_perm mf bc BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bs BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mf bt BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and (jet_uint32_array_init.uint32_array_at mf bt BinNums.Z0 regsH)
                                       (and
                                          (jet_sx_mem.lframe
                                             (fun (b : Values.block) (_ : BinNums.Z) =>
                                              and (not (@eq Values.block b bc)) (not (@eq Values.block b bs))) m mf)
                                          (and (jet_clight_internal_preserve.readonly_preserved m mf)
                                             (jet_elements_taptweak_globals.elements_taptweak_sha_startup mf)))))))))))))
