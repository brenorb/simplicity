### C.jet_elements_script_cmr_local.elements_script_cmr_env_rep
elements_script_cmr_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : jet_elements_prim.Elements.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
              (and (BinInt.Z.le BinNums.Z0 ebase)
                 (and
                    (BinInt.Z.le
                       (BinInt.Z.add ebase
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                       Integers.Ptrofs.max_unsigned)
                    (and (BinInt.Z.le BinNums.Z0 tbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add tbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val)
                                (Memory.Mem.load AST.Mptr m be
                                   (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                             (and
                                (jet_uint32_array_init.uint32_array_at m bt
                                   (BinInt.Z.add tbase
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                   (Digest.hash256_reg
                                      (jet_elements_prim.tapScriptCMR (jet_elements_prim.Elements.envTap environment))))
                                (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                   (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                      (@pair (prod Values.block BinNums.Z) BinNums.Z
                                         (@pair Values.block BinNums.Z be
                                            (BinInt.Z.add ebase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                         (BinInt.Z.add ebase
                                            (BinNums.Zpos
                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                      (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                         (@pair (prod Values.block BinNums.Z) BinNums.Z
                                            (@pair Values.block BinNums.Z bt
                                               (BinInt.Z.add tbase
                                                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                            (BinInt.Z.add tbase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))
                                         (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments elements_script_cmr_env_rep m env environment fp%list_scope
