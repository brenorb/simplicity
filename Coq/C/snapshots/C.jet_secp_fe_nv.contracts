### C.jet_secp_fe_nv.fe_at_rep
fe_at_rep
     : forall (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (t0 t1 t2 t3 t4 : Integers.Int64.int)
         (_ : fe_at m b ofs
                (@cons Integers.Int64.int t0
                   (@cons Integers.Int64.int t1
                      (@cons Integers.Int64.int t2
                         (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int))))))),
       jet_sx_state.rep (rho5 t0 t1 t2 t3 t4)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b ofs) (@nil (prod Values.block BinNums.Z)))
         (@cons jet_sx_state.region (fe_reg (vars5 O)) (@nil jet_sx_state.region)) m
### C.jet_secp_fe_nv.nv_run_eq
nv_run_eq
     : @eq (option jet_sx_exec.res) nv_run
         (@Some jet_sx_exec.res
            (jet_sx_exec.RIf nv_c (jet_sx_exec.RDone nv_a jet_sx_exec.ONormal)
               (jet_sx_exec.RDone nv_b jet_sx_exec.ONormal)))
### C.jet_secp_fe_nv.nv_bridge
nv_bridge
     : forall z0 z1 z2 z3 z4 : BinNums.Z,
       @eq (list BinNums.Z) (nvz_list z0 z1 z2 z3 z4)
         match
           negb (BinInt.Z.eqb (jet_sx_zval.zval (zrho5 z0 z1 z2 z3 z4) nv_c) BinNums.Z0) return (list BinNums.Z)
         with
         | true => jet_sx_zrep.zcells (zrho5 z0 z1 z2 z3 z4) (cells0 nv_a)
         | false => jet_sx_zrep.zcells (zrho5 z0 z1 z2 z3 z4) (cells0 nv_b)
         end
### C.jet_secp_fe_nv.zrho_rho5
zrho_rho5
     : forall (t0 t1 t2 t3 t4 : Integers.Int64.int) (n : nat),
       @eq BinNums.Z (jet_sx_zval.zrho (rho5 t0 t1 t2 t3 t4) n)
         (zrho5 (Integers.Int64.unsigned t0) (Integers.Int64.unsigned t1) (Integers.Int64.unsigned t2)
            (Integers.Int64.unsigned t3) (Integers.Int64.unsigned t4) n)
### C.jet_secp_fe_nv.zcells_ext
zcells_ext
     : forall (z1 z2 : forall _ : nat, BinNums.Z) (cs : list jet_sx_state.cell)
         (_ : forall n : nat, @eq BinNums.Z (z1 n) (z2 n)),
       @eq (list BinNums.Z) (jet_sx_zrep.zcells z1 cs) (jet_sx_zrep.zcells z2 cs)
### C.jet_secp_fe_nv.fe_foot
fe_foot
     : forall (b : Values.block) (ofs : BinNums.Z) (xs : list jet_sx_expr.sx) (b' : Values.block)
         (o : BinNums.Z) (_ : @eq nat (@length jet_sx_expr.sx xs) (S (S (S (S (S O))))))
         (_ : jet_sx_state.foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b ofs)
                   (@nil (prod Values.block BinNums.Z)))
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   (@cons jet_sx_state.region (fe_reg xs) (@nil jet_sx_state.region))) b' o),
       and (@eq Values.block b' b)
         (and (BinInt.Z.le ofs o)
            (BinInt.Z.lt o
               (BinInt.Z.add ofs
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
### C.jet_secp_fe_nv.eval_fe_normalize_var
eval_fe_normalize_var
     : forall (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (t0 t1 t2 t3 t4 : Integers.Int64.int)
         (_ : fe_at m b ofs
                (@cons Integers.Int64.int t0
                   (@cons Integers.Int64.int t1
                      (@cons Integers.Int64.int t2
                         (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int)))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t0)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t1)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t2)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t3)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t4)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall jet_secp_linkage.secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr ofs)) (@nil Values.val)) Events.E0 m'
               Values.Vundef)
            (and
               (fe_at m' b ofs
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (nvz_list (Integers.Int64.unsigned t0) (Integers.Int64.unsigned t1) (Integers.Int64.unsigned t2)
                        (Integers.Int64.unsigned t3) (Integers.Int64.unsigned t4))))
               (jet_sx_mem.lframe
                  (fun (b' : Values.block) (o : BinNums.Z) =>
                   not
                     (and (@eq Values.block b' b)
                        (and (BinInt.Z.le ofs o)
                           (BinInt.Z.lt o
                              (BinInt.Z.add ofs
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))) m
                  m')))
### C.jet_secp_fe_nv.fe_at
fe_at =
fun (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (l : list Integers.Int64.int) =>
and (BinInt.Z.le BinNums.Z0 ofs)
  (and (BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) ofs)
     (and
        (BinInt.Z.le
           (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
           Integers.Ptrofs.max_unsigned)
        (and
           (Memory.Mem.range_perm m b ofs
              (BinInt.Z.add ofs
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
              Memtype.Cur Memtype.Writable)
           (forall (i : nat) (x : Integers.Int64.int)
              (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int l i)
                     (@Some Integers.Int64.int x)),
            @eq (option Values.val)
              (Memory.Mem.load AST.Mint64 m b
                 (BinInt.Z.add ofs
                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))
              (@Some Values.val (Values.Vlong x))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int64.int), Prop

Arguments fe_at m b ofs%Z_scope l%list_scope
### C.jet_secp_fe_nv.fe_reg
fe_reg =
fun xs : list jet_sx_expr.sx => jet_sx_state.mkreg (jet_sx_rep.u64_cells BinNums.Z0 xs) true (@None BinNums.Z)
     : forall _ : list jet_sx_expr.sx, jet_sx_state.region

Arguments fe_reg xs%list_scope
### C.jet_secp_fe_nv.vars5
vars5 =
fun n : nat =>
@cons jet_sx_expr.sx (jet_sx_expr.XLv n)
  (@cons jet_sx_expr.sx (jet_sx_expr.XLv (Nat.add n (S O)))
     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (Nat.add n (S (S O))))
        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (Nat.add n (S (S (S O)))))
           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (Nat.add n (S (S (S (S O)))))) (@nil jet_sx_expr.sx)))))
     : forall _ : nat, list jet_sx_expr.sx

Arguments vars5 n%nat_scope
### C.jet_secp_fe_nv.rho5
rho5 =
fun (t0 t1 t2 t3 t4 : Integers.Int64.int) (n : nat) =>
@List.nth Integers.Int64.int n
  (@cons Integers.Int64.int t0
     (@cons Integers.Int64.int t1
        (@cons Integers.Int64.int t2
           (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int)))))) Integers.Int64.zero
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments rho5 t0 t1 t2 t3 t4 n%nat_scope
### C.jet_secp_fe_nv.nv_run
nv_run =
jet_sx_exec.xfun (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (jet_sx_pure.int_table jet_secp_fns.secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_normalize_var (@cons jet_sx_expr.sx (jet_sx_expr.XP O BinNums.Z0) (@nil jet_sx_expr.sx))
  (@cons jet_sx_state.region (fe_reg (vars5 O)) (@nil jet_sx_state.region)) (@nil jet_sx_eval.event)
  (S (S (S (S (S O)))))
     : option jet_sx_exec.res
