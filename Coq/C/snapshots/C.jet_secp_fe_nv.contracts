### C.jet_secp_fe_nv.nvz_list
nvz_list =
fun z0 z1 z2 z3 z4 : BinNums.Z =>
match jet_secp_fe_math.nvz z0 z1 z2 z3 z4 return (list BinNums.Z) with
| pair p r4 =>
    match p return (list BinNums.Z) with
    | pair p0 r3 =>
        match p0 return (list BinNums.Z) with
        | pair p1 r2 =>
            match p1 return (list BinNums.Z) with
            | pair r0 r1 =>
                @cons BinNums.Z r0
                  (@cons BinNums.Z r1 (@cons BinNums.Z r2 (@cons BinNums.Z r3 (@cons BinNums.Z r4 (@nil BinNums.Z)))))
            end
        end
    end
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), list BinNums.Z

