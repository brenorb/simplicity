### C.jet_read_buffer8_chunk_layout.buffer8_read_chunk_temps
buffer8_read_chunk_temps =
fun (le : Maps.PTree.tree Values.val) (bo : Values.block) (output count : BinNums.Z) (c : jet_buffer_input.byte_chunk)
=>
let tagged : Maps.PTree.tree Values.val :=
  @Maps.PTree.set Values.val jets._t'2
    (Values.Vint (jet_readBit_layout.bit_int (jet_read_buffer8_tag_layout.byte_chunk_tag c))) le in
match @snd nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c return (Maps.PTree.tree Values.val) with
| Some xs =>
    jet_read_buffer8_exec.buffer8_read_present_temps tagged bo
      (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) count
| None => tagged
end
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : jet_buffer_input.byte_chunk), Maps.PTree.tree Values.val

Arguments buffer8_read_chunk_temps le bo (output count)%Z_scope c
