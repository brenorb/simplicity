                Memtype.Writable) (_ : Memory.Mem.valid_access m AST.Mint64 bl slot Memtype.Writable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bl slot)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr count)))) (_ : not (@eq Values.block bf bo))
         (_ : not (@eq Values.block bf bi)) (_ : not (@eq Values.block bo bi)) (_ : not (@eq Values.block bl bf))
         (_ : not (@eq Values.block bl bo)) (_ : jet_frame_layout.frame_base_valid base)
         (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add (BinInt.Z.add cursor (BinNums.Zpos BinNums.xH))
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
