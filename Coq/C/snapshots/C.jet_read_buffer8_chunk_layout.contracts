         (_ : BinInt.Z.le BinNums.Z0 count)
         (_ : BinInt.Z.le
                (BinInt.Z.add count (BinInt.Z.of_nat (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c)))
                Integers.Int64.max_unsigned)
