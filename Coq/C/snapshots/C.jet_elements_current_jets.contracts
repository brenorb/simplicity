        (Clight.Etempvar jets_elements._t'3 Ctypesdefs.tulong)
        (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)))
     (Ctypes.Tstruct jets_elements._sigInput Ctypes.noattr)) jets_elements._sequence Ctypesdefs.tulong
     : Clight.expr
