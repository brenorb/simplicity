### C.jet_elements_null_data_small.elements_null_data_path_valid
elements_null_data_path_valid =
fun (m : Memory.Mem.mem) (be : Values.block) (ebase : BinNums.Z) (bt : Values.block) (txbase : BinNums.Z)
  (bout : Values.block) (outbase : BinNums.Z) (bop : Values.block) (opbase : BinNums.Z) (i j : Integers.Int64.int)
  (code : Integers.Int.int) =>
and (BinInt.Z.le BinNums.Z0 ebase)
  (and
     (BinInt.Z.le (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
        Integers.Ptrofs.max_unsigned)
     (and (BinInt.Z.le BinNums.Z0 txbase)
        (and
           (BinInt.Z.le
              (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
              Integers.Ptrofs.max_unsigned)
           (and (BinInt.Z.le BinNums.Z0 outbase)
              (and
                 (BinInt.Z.le
                    (BinInt.Z.add
                       (BinInt.Z.add outbase
                          (BinInt.Z.mul
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                             (Integers.Int64.unsigned i)))
                       (BinNums.Zpos
                          (BinNums.xO
                             (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                    Integers.Ptrofs.max_unsigned)
                 (and (BinInt.Z.le BinNums.Z0 opbase)
                    (and
                       (BinInt.Z.le
                          (BinInt.Z.add
                             (BinInt.Z.add opbase
                                (BinInt.Z.mul
                                   (BinNums.Zpos
                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
                                   (Integers.Int64.unsigned j)))
                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                          Integers.Ptrofs.max_unsigned)
                       (jet_elements_null_data_loads.elements_null_data_path_loads m be ebase bt txbase bout outbase
                          bop opbase i j code))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int)
         (_ : Integers.Int64.int) (_ : Integers.Int.int), Prop

Arguments elements_null_data_path_valid m be ebase%Z_scope bt txbase%Z_scope bout outbase%Z_scope
  bop opbase%Z_scope i j code
### C.jet_elements_null_data_small.elements_stmt_first
elements_stmt_first =
fun a b : option Clight.statement =>
match a return (option Clight.statement) with
| Some s => @Some Clight.statement s
| None => b
end
     : forall (_ : option Clight.statement) (_ : option Clight.statement), option Clight.statement

Arguments elements_stmt_first a b
### C.jet_elements_null_data_small.elements_find_set_prefix
elements_find_set_prefix =
fix elements_find_set_prefix (id : AST.ident) (s : Clight.statement) {struct s} : option Clight.statement :=
  match s return (option Clight.statement) with
  | Clight.Sskip => @None Clight.statement
  | Clight.Sassign _ _ => @None Clight.statement
  | Clight.Sset _ _ => @None Clight.statement
  | Clight.Scall _ _ _ => @None Clight.statement
  | Clight.Sbuiltin _ _ _ _ => @None Clight.statement
  | Clight.Ssequence a b =>
      match a return (option Clight.statement) with
      | Clight.Sskip => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Sassign _ _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Sset id' _ =>
          match BinPos.Pos.eqb id id' return (option Clight.statement) with
          | true => @Some Clight.statement s
          | false => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
          end
      | Clight.Scall _ _ _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Sbuiltin _ _ _ _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Ssequence _ _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Sifthenelse _ _ _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Sloop _ _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Sbreak => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Scontinue => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Sreturn _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Sswitch _ _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Slabel _ _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      | Clight.Sgoto _ => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
      end
  | Clight.Sifthenelse _ a b => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
  | Clight.Sloop a b => elements_stmt_first (elements_find_set_prefix id a) (elements_find_set_prefix id b)
  | Clight.Sbreak => @None Clight.statement
  | Clight.Scontinue => @None Clight.statement
  | Clight.Sreturn _ => @None Clight.statement
  | Clight.Sswitch _ _ => @None Clight.statement
  | Clight.Slabel _ _ => @None Clight.statement
  | Clight.Sgoto _ => @None Clight.statement
  end
     : forall (_ : AST.ident) (_ : Clight.statement), option Clight.statement

Arguments elements_find_set_prefix id s
