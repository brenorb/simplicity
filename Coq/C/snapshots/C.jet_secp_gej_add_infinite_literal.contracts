                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : jet_secp_fe_nv.fe_at m bb BinNums.Z0
                (jet_secp_multiply_normalize_bridge.words5 (jet_secp_square_spec_bridge.square_reader_rho bx)))
         (_ : jet_secp_fe_nv.fe_at m bb
