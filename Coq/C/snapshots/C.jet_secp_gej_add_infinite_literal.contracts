                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay) az)
                                 (@pair
                                    (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                                    (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) bx byword) bz))))
                        (and
                           (Memory.Mem.range_perm mf ba BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                              Memtype.Cur Memtype.Freeable)
                           (jet_sx_mem.lframe (fun (_ : Values.block) (_ : BinNums.Z) => True) m mf)))))))
