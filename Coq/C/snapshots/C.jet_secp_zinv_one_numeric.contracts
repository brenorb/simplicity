### C.jet_secp_zinv_one_numeric.zinv_s2_one
zinv_s2_one
     : forall (v z inv : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds v)
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : jet_secp_square_columns.square_input_bounds inv)
