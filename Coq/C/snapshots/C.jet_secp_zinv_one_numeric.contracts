### C.jet_secp_zinv_one_numeric.zinv_az_one
zinv_az_one
     : forall (z inv : forall _ : nat, Integers.Int64.int) (_ : jet_secp_square_columns.square_input_bounds z)
         (_ : jet_secp_square_columns.square_input_bounds inv)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value inv) jet_secp_fe_math.feP)
                (BinNums.Zpos BinNums.xH)),
       and
         (@eq BinNums.Z
            (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value (jet_secp_zinv_start.zinv_az_words z inv))
               jet_secp_fe_math.feP)
            (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value z) jet_secp_fe_math.feP))
         (jet_secp_field_mul_small.mul_small_input_bounds (jet_secp_zinv_start.zinv_az_words z inv))
