### C.jet_secp_zinv_one_numeric.zinv_differences_one
zinv_differences_one
     : forall (x y z u v inv : forall _ : nat, Integers.Int64.int)
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (x j))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S O)))))),
              BinInt.Z.le (Integers.Int64.unsigned (y j))
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : jet_secp_square_columns.square_input_bounds z) (_ : jet_secp_square_columns.square_input_bounds u)
         (_ : jet_secp_square_columns.square_input_bounds v) (_ : jet_secp_square_columns.square_input_bounds inv)
         (_ : @eq BinNums.Z (BinInt.Z.modulo (jet_secp_multiply_finish_product.radix_value inv) jet_secp_fe_math.feP)
                (BinNums.Zpos BinNums.xH)),
       and
         (@eq BinNums.Z
            (BinInt.Z.modulo
               (jet_secp_multiply_finish_product.radix_value (jet_secp_zinv_differences.zinv_h_words x z u inv))
               jet_secp_fe_math.feP)
            (BinInt.Z.modulo
               (BinInt.Z.sub
                  (BinInt.Z.mul
                     (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value u)
                        (jet_secp_multiply_finish_product.radix_value z))
                     (jet_secp_multiply_finish_product.radix_value z)) (jet_secp_multiply_finish_product.radix_value x))
               jet_secp_fe_math.feP))
         (and
            (@eq BinNums.Z
               (BinInt.Z.modulo
                  (jet_secp_multiply_finish_product.radix_value (jet_secp_zinv_differences.zinv_i_words y z v inv))
                  jet_secp_fe_math.feP)
               (BinInt.Z.modulo
                  (BinInt.Z.sub (jet_secp_multiply_finish_product.radix_value y)
                     (BinInt.Z.mul
                        (BinInt.Z.mul
                           (BinInt.Z.mul (jet_secp_multiply_finish_product.radix_value v)
                              (jet_secp_multiply_finish_product.radix_value z))
                           (jet_secp_multiply_finish_product.radix_value z))
                        (jet_secp_multiply_finish_product.radix_value z))) jet_secp_fe_math.feP))
            (and (jet_secp_square_columns.square_input_bounds (jet_secp_zinv_differences.zinv_h_words x z u inv))
               (jet_secp_square_columns.square_input_bounds (jet_secp_zinv_differences.zinv_i_words y z v inv))))
