### C.jet_elements_single_issuance_none.eis_none_shape
eis_none_shape
     : @eq Clight.statement jet_elements_single_issuance_prep.eis_none
         (Clight.Ssequence (jet_elements_single_input_optional.eih_uchar_stmt Integers.Int.zero)
            (Clight.Ssequence (jet_elements_single_input_optional.eih_uchar_stmt Integers.Int.zero)
               (Clight.Ssequence (jet_elements_single_input_optional.eih_uchar_stmt Integers.Int.zero)
                  (Clight.Ssequence (jet_elements_single_input_optional.eih_uchar_stmt Integers.Int.zero)
                     (Clight.Ssequence (eis_hash_stmt jets_elements._assetRangeProofHash)
                        (Clight.Ssequence (eis_hash_stmt jets_elements._tokenRangeProofHash)
                           (jet_elements_single_input_optional.eih_uchar_stmt Integers.Int.zero)))))))
### C.jet_elements_single_issuance_none.eis_hash_stmt_exec
eis_hash_stmt_exec
     : forall (field : AST.ident) (delta : BinNums.Z) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bx bin : Values.block)
         (ofs : BinNums.Z) (_ : jet_elements_field_eval.elements_field_at jets_elements._assetIssuance field delta)
         (_ : BinInt.Z.le BinNums.Z0 delta)
         (_ : BinInt.Z.le
                (BinInt.Z.add delta
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._sha256_hash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_elements._sha256_context Ctypes.noattr))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._issuance le)
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr ofs))))
         (_ : ClightBigstep.Clight2.eval_funcall jet_elements_support_sha_linkage.sha_ge m
                (@Ctypes.Internal Clight.function jets_elements.f_sha256_hash)
                (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bin (Integers.Ptrofs.repr (BinInt.Z.add ofs delta)))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt jet_elements_support_sha_linkage.sha_ge e le m (eis_hash_stmt field) Events.E0
         le mf ClightBigstep.Out_normal
### C.jet_elements_single_issuance_none.eis_asset_proof_offset
