### C.jet_secp_hash_frames.hash_old_blocks
hash_old_blocks =
fun m mf : Memory.Mem.mem =>
forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
and (Memory.Mem.valid_block mf b)
  (and
     (forall (chunk : AST.memory_chunk) (ofs : BinNums.Z),
      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
     (forall (ofs : BinNums.Z) (kind : Memtype.perm_kind) (perm : Memtype.permission)
        (_ : Memory.Mem.perm mf b ofs kind perm), Memory.Mem.perm m b ofs kind perm))
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments hash_old_blocks m mf
