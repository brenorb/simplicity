### C.jet_secp_tweak_add_equivalence.literal_gej_normalize_flag_value
literal_gej_normalize_flag_value
     : forall point : Ty.tySem jet_secp_scalar_table_literal.literal_table_gej,
       @eq
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@jet_secp_gej_norm_branch.literal_gej_normalize Alg.CoreFunSem point)
         match
           Bit.toBool (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem point)
           return
             (Ty.tySem
                (Ty.Sum Ty.Unit
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | true =>
             @inl unit
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) tt
         | false =>
             @inr unit
               (Ty.tySem
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@jet_secp_gej_norm_literal.literal_gej_norm Alg.CoreFunSem point)
         end
### C.jet_secp_tweak_add_equivalence.secp_noninfinite_norm_group
secp_noninfinite_norm_group
     : forall (point : Ty.tySem jet_secp_scalar_table_literal.literal_table_gej)
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : @eq bool (Bit.toBool (@jet_secp_literal_gej_predicate.literal_gej_is_infinity Alg.CoreFunSem point))
                false)
         (_ : jet_secp_jacobian_word_group.secp_jacobian_word_rep (GZnZ.one jet_secp_fe_math.feP) point p),
       jet_secp_table_pass2_group.secp_affine_word_rep (GZnZ.one jet_secp_fe_math.feP)
         (@jet_secp_gej_norm_literal.literal_gej_norm Alg.CoreFunSem point) p
### C.jet_secp_tweak_add_equivalence.secp_gej_normalize_same_group
secp_gej_normalize_same_group
     : forall (a b : Ty.tySem jet_secp_scalar_table_literal.literal_table_gej)
         (p : jet_secp_curve_group_sign.secp_group_point)
         (_ : jet_secp_jacobian_word_group.secp_jacobian_word_rep (GZnZ.one jet_secp_fe_math.feP) a p)
         (_ : jet_secp_jacobian_word_group.secp_jacobian_word_rep (GZnZ.one jet_secp_fe_math.feP) b p),
       @eq
         (Ty.tySem
            (Ty.Sum Ty.Unit
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (@jet_secp_gej_norm_branch.literal_gej_normalize Alg.CoreFunSem a)
         (@jet_secp_gej_norm_branch.literal_gej_normalize Alg.CoreFunSem b)
### C.jet_secp_tweak_add_equivalence.eckey_tweak_value_matches_add
eckey_tweak_value_matches_add
     : forall (ng ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay))) true),
       @eq
         (option
            (Ty.tySem
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (jet_secp_eckey_tweak_function.eckey_tweak_value ng ax ay)
         match
           @jet_secp_gej_norm_branch.literal_gej_normalize Alg.CoreFunSem
             (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
                (@pair (Ty.tySem jet_secp_generate_literal.literal_generator_jacobian)
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                   (@jet_secp_generate_program.literal_generate Alg.CoreFunSem ng)
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay)))
           return
             (option
                (Ty.tySem
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | inl _ =>
             @None
               (Ty.tySem
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         | inr point =>
             @Some
               (prod
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) point
         end
### C.jet_secp_tweak_add_equivalence.tweak_bytes_value_matches_add
tweak_bytes_value_matches_add
     : forall (ng ax ay : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq bool
                (Bit.toBool
                   (@jet_secp_curve_literal.literal_ge_is_on_curve Alg.CoreFunSem
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay))) true),
       @eq
         (option
            (Ty.tySem
               (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         (jet_secp_tweak_bytes_function.tweak_bytes_value ng ax ay)
         match
           jet_secp_tweak_bytes_function.tweak_bytes_overflow ng
           return
             (option
                (Ty.tySem
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
         with
         | true =>
             @None
               (Ty.tySem
                  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         | false =>
             match
               @jet_secp_gej_norm_branch.literal_gej_normalize Alg.CoreFunSem
                 (@jet_secp_add_literal.literal_gej_ge_add Alg.CoreFunSem
                    (@pair (Ty.tySem jet_secp_generate_literal.literal_generator_jacobian)
                       (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                       (@jet_secp_generate_program.literal_generate Alg.CoreFunSem ng)
                       (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) ax ay)))
               return
                 (option
                    (Ty.tySem
                       (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                          (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
             with
             | inl _ =>
                 @None
                   (Ty.tySem
                      (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                         (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
             | inr point =>
                 @Some
                   (prod
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) point
             end
         end
