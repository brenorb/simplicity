### C.jet_secp_div62_finish.div62_finish_source
div62_finish_source
     : @eq Clight.statement (Clight.fn_body jets_secp.f_secp256k1_modinv64_divsteps_62_var)
         (jet_secp_statement_prefix.statement_sequence
            (@List.firstn Clight.statement (S (S (S (S (S (S (S O)))))))
               (@fst (list Clight.statement) Clight.statement jet_secp_div62_count.div62_parts))
            (Clight.Ssequence jet_secp_div62_count.div62_loop div62_finish))
### C.jet_secp_div62_finish.div62_finish_run_eq
div62_finish_run_eq
     : @eq (option jet_sx_exec.res) div62_finish_run
         (@Some jet_sx_exec.res
            (jet_sx_exec.RDone div62_finish_state
               (jet_sx_exec.OReturn
                  (@Some (prod jet_sx_expr.sx Ctypes.type)
                     (@pair jet_sx_expr.sx Ctypes.type (jet_sx_expr.XLv (S (S (S (S O))))) Ctypesdefs.tlong)))))
### C.jet_secp_div62_finish.div62_finish_out
div62_finish_out
     : @eq (list jet_sx_state.region) (jet_sx_eval.sregs div62_finish_state)
         (@cons jet_sx_state.region
            (jet_sx_state.mkreg
               (jet_sx_rep.u64_cells BinNums.Z0
                  (@cons jet_sx_expr.sx (jet_sx_expr.XLv O)
                     (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S O))
                        (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S O)))
                           (@cons jet_sx_expr.sx (jet_sx_expr.XLv (S (S (S O)))) (@nil jet_sx_expr.sx)))))) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@nil jet_sx_state.region))
### C.jet_secp_div62_finish.div62_finish_log
div62_finish_log
     : @eq (list jet_sx_eval.event) (jet_sx_eval.slog div62_finish_state) (@nil jet_sx_eval.event)
### C.jet_secp_div62_finish.div62_finish_initial
div62_finish_initial
     : forall (rho : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem) (b : Values.block)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       jet_sx_state.rep rho
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@nil (prod Values.block BinNums.Z))) div62_finish_regs m
### C.jet_secp_div62_finish.exec_div62_finish
exec_div62_finish
     : forall (rho : forall _ : nat, Integers.Int64.int) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (b : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._u le)
                (@Some Values.val (Values.Vlong (rho O))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._v le)
                (@Some Values.val (Values.Vlong (rho (S O)))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._q le)
                (@Some Values.val (Values.Vlong (rho (S (S O))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vlong (rho (S (S (S O)))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._eta le)
                (@Some Values.val (Values.Vlong (rho (S (S (S (S O))))))))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m div62_finish Events.E0
                  lef mf
                  (ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type (Values.Vlong (rho (S (S (S (S O)))))) Ctypesdefs.tlong))))
               (and
                  (forall (j : nat) (_ : lt j (S (S (S (S O))))),
                   @eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf b
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat j))) (@Some Values.val (Values.Vlong (rho j))))
                  (and
                     (Memory.Mem.range_perm mf b BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m mf)))))
### C.jet_secp_div62_finish.exec_div62_count_exit
exec_div62_count_exit
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (b : Values.block)
         (g u v q r : Integers.Int64.int) (eta i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i
                   (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t le)
                (@Some Values.val (Values.Vptr b Integers.Ptrofs.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._g le) (@Some Values.val (Values.Vlong g)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._u le) (@Some Values.val (Values.Vlong u)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._v le) (@Some Values.val (Values.Vlong v)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._q le) (@Some Values.val (Values.Vlong q)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._eta le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr eta))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._zeros le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env le m
                  jet_secp_div62_count.div62_after_count Events.E0
                  (jet_secp_div62_count.div62_count_temps le g u v eta i i) m ClightBigstep.Out_break)
               (and
                  (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge Clight.empty_env
                     (jet_secp_div62_count.div62_count_temps le g u v eta i i) m div62_finish Events.E0 lef mf
                     (ClightBigstep.Out_return
                        (@Some (prod Values.val Ctypes.type)
                           (@pair Values.val Ctypes.type (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub eta i)))
                              Ctypesdefs.tlong))))
                  (and
                     (forall (j : nat) (_ : lt j (S (S (S (S O))))),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf b
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat j)))
                        (@Some Values.val (Values.Vlong (div62_exit_words u v q r eta i j))))
                     (and
                        (Memory.Mem.range_perm mf b BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (jet_sx_mem.lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (@eq Values.block bx b)) m
                           mf))))))
### C.jet_secp_div62_finish.div62_finish
div62_finish =
jet_secp_statement_prefix.statement_sequence
  (@List.skipn Clight.statement (S (S (S (S (S (S (S (S O))))))))
     (@fst (list Clight.statement) Clight.statement jet_secp_div62_count.div62_parts))
  (@snd (list Clight.statement) Clight.statement jet_secp_div62_count.div62_parts)
     : Clight.statement
### C.jet_secp_div62_finish.div62_finish_regs
div62_finish_regs =
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (@cons jet_sx_state.cell (jet_sx_state.mkcell BinNums.Z0 AST.Mint64 (@None jet_sx_expr.sx))
        (@cons jet_sx_state.cell
           (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
              (@None jet_sx_expr.sx))
           (@cons jet_sx_state.cell
              (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                 AST.Mint64 (@None jet_sx_expr.sx))
              (@cons jet_sx_state.cell
                 (jet_sx_state.mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))
                    AST.Mint64 (@None jet_sx_expr.sx)) (@nil jet_sx_state.cell))))) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
  (@nil jet_sx_state.region)
     : list jet_sx_state.region
### C.jet_secp_div62_finish.div62_finish_temps
div62_finish_temps =
@Maps.PTree.set jet_sx_expr.sx jets_secp._t (jet_sx_expr.XP O BinNums.Z0)
  (@Maps.PTree.set jet_sx_expr.sx jets_secp._eta (jet_sx_expr.XLv (S (S (S (S O)))))
     (@Maps.PTree.set jet_sx_expr.sx jets_secp._r (jet_sx_expr.XLv (S (S (S O))))
        (@Maps.PTree.set jet_sx_expr.sx jets_secp._q (jet_sx_expr.XLv (S (S O)))
           (@Maps.PTree.set jet_sx_expr.sx jets_secp._v (jet_sx_expr.XLv (S O))
              (@Maps.PTree.set jet_sx_expr.sx jets_secp._u (jet_sx_expr.XLv O) (Maps.PTree.empty jet_sx_expr.sx))))))
     : Maps.PTree.tree jet_sx_expr.sx
### C.jet_secp_div62_finish.div62_finish_start
div62_finish_start =
jet_sx_eval.mkst div62_finish_temps div62_finish_regs (@nil jet_sx_eval.event) (S (S (S (S (S O)))))
     : jet_sx_eval.sstate
### C.jet_secp_div62_finish.div62_finish_run
div62_finish_run =
jet_sx_exec.xstmt (Clight.genv_cenv jet_secp_linkage.secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (@nil (prod AST.ident jet_sx_exec.fentry))
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  (@nil (prod AST.ident (prod nat Ctypes.type))) div62_finish_start div62_finish
     : option jet_sx_exec.res
### C.jet_secp_div62_finish.div62_finish_state
div62_finish_state =
match div62_finish_run return jet_sx_eval.sstate with
| Some r =>
    match r return jet_sx_eval.sstate with
    | jet_sx_exec.RDone st _ => st
    | jet_sx_exec.RIf _ _ _ => div62_finish_start
    end
| None => div62_finish_start
end
     : jet_sx_eval.sstate
### C.jet_secp_div62_finish.div62_exit_words
div62_exit_words =
fun (u v q r : Integers.Int64.int) (eta i : BinNums.Z) (n : nat) =>
@List.nth Integers.Int64.int n
  (@cons Integers.Int64.int (Integers.Int64.shl u (Integers.Int64.repr i))
     (@cons Integers.Int64.int (Integers.Int64.shl v (Integers.Int64.repr i))
        (@cons Integers.Int64.int q
           (@cons Integers.Int64.int r
              (@cons Integers.Int64.int (Integers.Int64.repr (BinInt.Z.sub eta i)) (@nil Integers.Int64.int))))))
  Integers.Int64.zero
     : forall (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : nat), Integers.Int64.int

Arguments div62_exit_words u v q r (eta i)%Z_scope n%nat_scope
