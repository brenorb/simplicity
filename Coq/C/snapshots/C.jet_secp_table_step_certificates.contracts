### C.jet_secp_table_step_certificates.table_witness_step_checked
table_witness_step_checked
     : forall (n : nat) (_ : @List.In nat n jet_secp_table_step_nonzero.table_step_indices),
       @eq (prod (prod (prod (list BinNums.Z) (list BinNums.Z)) (list BinNums.Z)) (list BinNums.Z))
         (jet_secp_table_coordinates.table_witness_step n) (jet_secp_table_coordinates.table_witness_scaled_next n)
