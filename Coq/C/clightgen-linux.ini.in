stdlib_path=@COMPCERT@/runtime
prepro=clang
linker=clang
asm=clang
prepro_options=-target x86_64-linux-gnu -U__GNUC__ -U__SIZEOF_INT128__ -nostdinc -I @COMPCERT@/runtime/include -isystem @SYSROOT@/usr/include/x86_64-linux-gnu -isystem @SYSROOT@/usr/include -E
asm_options=-m64 -c
linker_options=-m64 -no-pie
arch=x86
model=64
abi=standard
endianness=little
system=linux
has_runtime_lib=true
has_standard_headers=true
asm_supports_cfi=true
response_file_style=gnu
