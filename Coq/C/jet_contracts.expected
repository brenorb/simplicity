annex_hash_spec =
fun term : Alg.Assertion.Algebra =>
@jet_sha256_ctx8_init_spec.AC.comp
  (Ty.Prod sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) sha256_ctx8_type)
  sha256_ctx8_type (Alg.Assertion.toCore term)
  (@jet_sha256_ctx8_init_spec.AC.pair
     (Ty.Prod sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))))
     (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) sha256_ctx8_type
     (Alg.Assertion.toCore term)
     (@jet_sha256_ctx8_init_spec.AC.drop sha256_ctx8_type
        (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
        (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) (Alg.Assertion.toCore term)
        (@jet_sha256_ctx8_init_spec.AC.iden
           (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) (Alg.Assertion.toCore term)))
     (@jet_sha256_ctx8_init_spec.AC.take sha256_ctx8_type
        (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) sha256_ctx8_type
        (Alg.Assertion.toCore term) (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term))))
  (@jet_sha256_ctx8_init_spec.AC.case Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
     sha256_ctx8_type sha256_ctx8_type (Alg.Assertion.toCore term)
     (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod Ty.Unit sha256_ctx8_type)
        (Ty.Prod sha256_ctx8_type (Word.Word (S (S (S O))))) sha256_ctx8_type (Alg.Assertion.toCore term)
        (@jet_sha256_ctx8_init_spec.AC.pair (Ty.Prod Ty.Unit sha256_ctx8_type) sha256_ctx8_type
           (Word.Word (S (S (S O)))) (Alg.Assertion.toCore term)
           (@jet_sha256_ctx8_init_spec.AC.drop Ty.Unit sha256_ctx8_type sha256_ctx8_type (Alg.Assertion.toCore term)
              (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term)))
           (@jet_sha256_ctx8_init_spec.AC.take Ty.Unit sha256_ctx8_type (Word.Word (S (S (S O))))
              (Alg.Assertion.toCore term) (@Word.zero (S (S (S O))) (Alg.Assertion.toCore term))))
        (@ctx8_add1_spec term))
     (@jet_sha256_ctx8_init_spec.AC.comp
        (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) sha256_ctx8_type)
        (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) sha256_ctx8_type
        (Alg.Assertion.toCore term)
        (@jet_sha256_ctx8_init_spec.AC.pair
           (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) sha256_ctx8_type) sha256_ctx8_type
           (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) (Alg.Assertion.toCore term)
           (@jet_sha256_ctx8_init_spec.AC.comp
              (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) sha256_ctx8_type)
              (Ty.Prod sha256_ctx8_type (Word.Word (S (S (S O))))) sha256_ctx8_type (Alg.Assertion.toCore term)
              (@jet_sha256_ctx8_init_spec.AC.pair
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) sha256_ctx8_type)
                 sha256_ctx8_type (Word.Word (S (S (S O)))) (Alg.Assertion.toCore term)
                 (@jet_sha256_ctx8_init_spec.AC.drop (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
                    sha256_ctx8_type sha256_ctx8_type (Alg.Assertion.toCore term)
                    (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term)))
                 (@jet_sha256_ctx8_init_spec.AC.comp
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) sha256_ctx8_type) Ty.Unit
                    (Word.Word (S (S (S O)))) (Alg.Assertion.toCore term)
                    (@jet_sha256_ctx8_init_spec.AC.unit
                       (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) sha256_ctx8_type)
                       (Alg.Assertion.toCore term))
                    (@Alg.scribe Ty.Unit (Word.Word (S (S (S O)))) byte_one (Alg.Assertion.toCore term))))
              (@ctx8_add1_spec term))
           (@jet_sha256_ctx8_init_spec.AC.take (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
              sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
              (Alg.Assertion.toCore term)
              (@jet_sha256_ctx8_init_spec.AC.iden (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
                 (Alg.Assertion.toCore term)))) (@ctx8_addn_spec (S (S (S (S (S O))))) term)))
     : forall term : Alg.Assertion.Algebra,
       Alg.Assertion.domain term
