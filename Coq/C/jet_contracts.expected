unary_borrow_spec_parametric
     : forall (k : unary_borrow_op) (n : nat),
       @Alg.Core.Parametric (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))
         (fun term : Alg.Core.Algebra => @unary_borrow_spec k n term)
unary_borrow_spec_numeric
     : forall (k : unary_borrow_op) (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq BinNums.Z (borrow_word_balance n (@unary_borrow_spec k n Alg.CoreFunSem x))
         (unary_borrow_delta k (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
unary_borrow_representation_matches
     : forall (k : unary_borrow_op) (n : nat) (x payload : Ty.tySem (Word.Word n))
         (_ : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ n) payload)
                (BinInt.Z.modulo (unary_borrow_delta k (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)) (word_modulus n))),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word n)))
         (@pair (sum unit unit) (Ty.tySem (Word.Word n))
            match
              BinInt.Z.ltb (unary_borrow_delta k (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)) BinNums.Z0
              return (sum unit unit)
            with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end payload) (@unary_borrow_spec k n Alg.CoreFunSem x)
wide_unary_values_denote_input
     : forall (k : unary_borrow_op) (s : wide_size) (x : Ty.tySem (Word.Word (wide_log s)))
         (r : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (wide_log s))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (wide_log s)))
            match wide_unary_borrow k r return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end (decode_wide s (Integers.Int64.zero_ext (wide_bits s) (wide_unary_payload k r))))
         (@unary_borrow_spec k (wide_log s) Alg.CoreFunSem x)
unary8_values_denote_spec
     : forall (k : unary_borrow_op) (payload : Integers.Int64.int),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S O))))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S O)))))
            match unary8_borrow k (jet_read8.read8_result payload) return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (decode_word8
               (Integers.Int64.repr (Integers.Int.unsigned (unary8_payload k (jet_read8.read8_result payload))))))
         (@unary_borrow_spec k (S (S (S O))) Alg.CoreFunSem (decode_word8 payload))
eval_borrow_unary8_layout_matches_spec
     : forall (env : Values.val) (k : unary_borrow_op) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (x : Ty.tySem (Word.Word (S (S (S O))))) (cursor rc : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc) (_ : byte_slice_at m bi edge rc x)
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (borrow_unary8 k))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
                     (@unary_borrow_spec k (S (S (S O))) Alg.CoreFunSem x)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
