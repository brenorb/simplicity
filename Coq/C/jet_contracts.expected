           (Clight.Etempvar _value Ctypesdefs.tulong) Ctypesdefs.tulong) (Clight.Etempvar _amt Ctypesdefs.tuchar)
        Ctypesdefs.tulong)
     (Clight.Ebinop Cop.Oshr (Clight.Etempvar _value Ctypesdefs.tulong)
        (Clight.Ebinop Cop.Osub (Clight.Econst_int (Integers.Int.repr (wide_bits s)) Ctypesdefs.tint)
           (Clight.Etempvar _amt Ctypesdefs.tuchar) Ctypesdefs.tint) Ctypesdefs.tulong) Ctypesdefs.tulong)
