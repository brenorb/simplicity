  (@Maps.PTree.set Values.val _input (Values.Vlong r) (@Maps.PTree.set Values.val _t'1 (Values.Vlong r) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments right_extend_wide_prepared le r
wide_rotate_helper =
fun s : wide_size =>
match s return Clight.function with
| W16 => f_rotate_16
| W32 => f_rotate_32
| W64 => f_rotate_64
end
     : forall _ : wide_size, Clight.function

Arguments wide_rotate_helper s
wide_rotate_expr =
fun s : wide_size =>
Clight.Ecast
  (Clight.Ebinop Cop.Oor
     (Clight.Ebinop Cop.Oshl
        (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
           (Clight.Etempvar _value Ctypesdefs.tulong) Ctypesdefs.tulong) (Clight.Etempvar _amt Ctypesdefs.tuchar)
        Ctypesdefs.tulong)
     (Clight.Ebinop Cop.Oshr (Clight.Etempvar _value Ctypesdefs.tulong)
        (Clight.Ebinop Cop.Osub (Clight.Econst_int (Integers.Int.repr (wide_bits s)) Ctypesdefs.tint)
           (Clight.Etempvar _amt Ctypesdefs.tuchar) Ctypesdefs.tint) Ctypesdefs.tulong) Ctypesdefs.tulong)
  Ctypesdefs.tulong
     : forall _ : wide_size, Clight.expr

Arguments wide_rotate_expr s
wide_rotate_nonzero =
fun (s : wide_size) (r : Integers.Int64.int) (a : Integers.Int.int) =>
Integers.Int64.or (Integers.Int64.shl r (Integers.Int64.repr (Integers.Int.unsigned a)))
  (Integers.Int64.shru r (Integers.Int64.repr (BinInt.Z.sub (wide_bits s) (Integers.Int.unsigned a))))
     : forall (_ : wide_size) (_ : Integers.Int64.int) (_ : Integers.Int.int), Integers.Int64.int

Arguments wide_rotate_nonzero s r a
wide_rotate_result =
fun (s : wide_size) (r : Integers.Int64.int) (a : Integers.Int.int) =>
match Integers.Int.eq a Integers.Int.zero return Integers.Int64.int with
| true => r
| false => wide_rotate_nonzero s r a
end
     : forall (_ : wide_size) (_ : Integers.Int64.int) (_ : Integers.Int.int), Integers.Int64.int

Arguments wide_rotate_result s r a
le_wide_rotate =
fun (r : Integers.Int64.int) (a : Integers.Int.int) =>
@Maps.PTree.set Values.val _amt (Values.Vint a)
  (@Maps.PTree.set Values.val _value (Values.Vlong r) (Maps.PTree.empty Values.val))
     : forall (_ : Integers.Int64.int) (_ : Integers.Int.int), Clight.temp_env

Arguments le_wide_rotate r a
wide_rotate_amount =
fun (s : wide_size) (a : Integers.Int.int) =>
Integers.Int.repr (BinInt.Z.modulo (Integers.Int.unsigned a) (wide_bits s))
     : forall (_ : wide_size) (_ : Integers.Int.int), Integers.Int.int

