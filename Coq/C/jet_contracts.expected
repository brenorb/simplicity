bitcoin_count_env_rep =
fun (delta : BinNums.Z) (count : forall _ : Bitcoin.Bitcoin.env, BinNums.Z) (m : Memory.Mem.mem)
  (env : Values.val) (environment : Bitcoin.Bitcoin.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun value : Integers.Int64.int =>
               and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                 (and (and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
                    (and (BinInt.Z.le BinNums.Z0 txbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add txbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                             (and
                                (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (BinInt.Z.add txbase delta))
                                   (@Some Values.val (Values.Vlong value)))
                                (@eq BinNums.Z (Integers.Int64.unsigned value) (count environment))))))))))))
     : forall (_ : BinNums.Z) (_ : forall _ : Bitcoin.Bitcoin.env, BinNums.Z) (_ : Memory.Mem.mem)
         (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_count_env_rep delta%Z_scope count%function_scope m env environment
bitcoin_num_inputs_env_rep =
bitcoin_count_env_rep
  (BinNums.Zpos
     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
  (fun environment : Bitcoin.Bitcoin.env =>
   BinInt.Z.of_nat (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx environment))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_num_inputs_env_rep m env environment
bitcoin_num_outputs_env_rep =
bitcoin_count_env_rep
  (BinNums.Zpos
     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))
  (fun environment : Bitcoin.Bitcoin.env =>
   BinInt.Z.of_nat (@length Bitcoin.txOutput (Bitcoin.sigTxOut (Bitcoin.Bitcoin.envTx environment))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_num_outputs_env_rep m env environment
memcpy_sig =
AST.mksignature (@cons AST.typ AST.Tlong (@cons AST.typ AST.Tlong (@cons AST.typ AST.Tlong (@nil AST.typ))))
  (AST.Tret AST.Tlong) AST.cc_default
     : AST.signature
memcpy_model =
forall (ge : Globalenvs.Senv.t) (m : Memory.Mem.mem) (bd : Values.block) (od : Integers.Ptrofs.int)
  (bs : Values.block) (os : Integers.Ptrofs.int) (n : BinNums.Z) (bytes : list Memdata.memval)
  (_ : Memory.Mem.valid_block m bs) (_ : Memory.Mem.valid_block m bd)
  (_ : @eq (option (list Memdata.memval)) (Memory.Mem.loadbytes m bs (Integers.Ptrofs.unsigned os) n)
         (@Some (list Memdata.memval) bytes))
  (_ : Memory.Mem.range_perm m bd (Integers.Ptrofs.unsigned od) (BinInt.Z.add (Integers.Ptrofs.unsigned od) n)
         Memtype.Cur Memtype.Writable)
  (_ : or (not (@eq Values.block bs bd))
         (or (BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned os) n) (Integers.Ptrofs.unsigned od))
            (BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned od) n) (Integers.Ptrofs.unsigned os))))
  (_ : and (BinInt.Z.lt BinNums.Z0 n) (BinInt.Z.le n Integers.Int64.max_unsigned))
  (_ : BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned os) n)
         (BinInt.Z.add Integers.Ptrofs.max_unsigned (BinNums.Zpos BinNums.xH)))
  (_ : BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned od) n)
         (BinInt.Z.add Integers.Ptrofs.max_unsigned (BinNums.Zpos BinNums.xH))),
@ex Memory.Mem.mem
  (fun m' : Memory.Mem.mem =>
   and
     (@eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bd (Integers.Ptrofs.unsigned od) bytes)
        (@Some Memory.Mem.mem m'))
     (Events.external_call
        (AST.EF_external
           (String.String (Ascii.Ascii true false true true false true true false)
              (String.String (Ascii.Ascii true false true false false true true false)
                 (String.String (Ascii.Ascii true false true true false true true false)
                    (String.String (Ascii.Ascii true true false false false true true false)
                       (String.String (Ascii.Ascii false false false false true true true false)
                          (String.String (Ascii.Ascii true false false true true true true false) String.EmptyString))))))
           memcpy_sig) ge
        (@cons Values.val (Values.Vptr bd od)
           (@cons Values.val (Values.Vptr bs os)
              (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) m Events.E0
        (Values.Vptr bd od) m'))
     : Prop
out_low =
fun edge cursor count : BinNums.Z =>
BinInt.Z.add edge
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
     (BinInt.Z.div (BinInt.Z.sub cursor count)
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments out_low (edge cursor count)%Z_scope
out_high =
fun edge cursor : BinNums.Z =>
BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments out_high (edge cursor)%Z_scope
out_sep =
fun (bf : Values.block) (base : BinNums.Z) (bw : Values.block) (edge cursor count : BinNums.Z)
  (b : Values.block) (lo hi : BinNums.Z) =>
and
  (or (not (@eq Values.block b bf))
     (or (BinInt.Z.le hi (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (BinInt.Z.le (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
           lo)))
  (or (not (@eq Values.block b bw))
     (or (BinInt.Z.le hi (out_low edge cursor count)) (BinInt.Z.le (out_high edge cursor) lo)))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments out_sep bf base%Z_scope bw (edge cursor count)%Z_scope b (lo hi)%Z_scope
application_jet_local_spec_sep =
fun (f : Clight.function) (ge : Clight.genv) (E : Set) (A B : Ty.Ty)
  (env_rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E)
               (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
  (spec : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)) =>
forall (logical_env : E) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
  (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
  (a : Ty.tySem A) (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) (_ : env_rep m env logical_env fp)
  (_ : @List.Forall (prod (prod Values.block BinNums.Z) BinNums.Z)
         (fun pat : prod (prod Values.block BinNums.Z) BinNums.Z =>
          match pat return Prop with
          | pair y hi =>
              match y return Prop with
              | pair b lo => out_sep bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B)) b lo hi
              end
          end) fp) (_ : frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
  (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize A))) Integers.Int64.max_unsigned)
  (_ : frame_input_cells_at m bi edge read_cursor (@encode A a))
  (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   @ex (Ty.tySem B)
     (fun value : Ty.tySem B =>
      and (@eq (option (Ty.tySem B)) (spec a logical_env) (@Some (Ty.tySem B) value))
        (and
           (ClightBigstep.Clight2.eval_funcall ge m (@Ctypes.Internal Clight.function f)
              (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                 (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                    (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
           (and (frame_output_cells_at mf bw outedge cursor (@encode B value))
              (and (write_prefix_at m mf bw outedge cursor)
                 (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B))))
                    (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                       (_ : Memory.Mem.valid_block m b)
                       (_ : or (not (@eq Values.block b bd))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    ofs)))
                       (_ : or (not (@eq Values.block b bw))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add outedge
                                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                          (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B)))
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                     @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))))
     : forall (_ : Clight.function) (_ : Clight.genv) (E : Set) (A B : Ty.Ty)
         (_ : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E)
                (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
         (_ : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)), Prop

Arguments application_jet_local_spec_sep f ge E%type_scope (A B)%ty_scope (env_rep spec)%function_scope
