eval_buffer8_guard
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j)))),
       Clight.eval_expr ge0 e le m buffer8_guard_expr
         (Values.Vint
            match BinInt.Z.ltb BinNums.Z0 j return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
exec_buffer8_disabled_assert
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (assertion : Clight.statement),
       ClightBigstep.Clight2.exec_stmt ge0 e le m
         (Clight.Sloop
            (Clight.Sifthenelse
               (Clight.Eunop Cop.Onotbool (Clight.Econst_int Integers.Int.one Ctypesdefs.tint) Ctypesdefs.tint)
               assertion Clight.Sskip) Clight.Sbreak) Events.E0 le m ClightBigstep.Out_normal
eval_buffer8_empty_tag
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : and (BinInt.Z.lt BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _len le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero))),
       Clight.eval_expr ge0 e le m buffer8_tag_expr (Values.Vint Integers.Int.zero)
eval_buffer8_skip_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j)))),
       Clight.eval_expr ge0 e le m buffer8_skip_expr
         (Values.Vlong
            (Integers.Int64.repr (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) j)))
exec_buffer8_empty_iteration
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mb mf : Memory.Mem.mem) (bf : Values.block) (base j : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) _writeBit e) (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) _skipBits e) (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _len le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.lt BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_writeBit)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vint Integers.Int.zero) (@nil Values.val))) Events.E0 mb
                (Values.Vint Integers.Int.zero))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mb (@Ctypes.Internal Clight.function f_skipBits)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) j)))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt ge0 e le m (Clight.Ssequence buffer8_loop_body buffer8_loop_update) Events.E0
         (@Maps.PTree.set Values.val _i
            (Values.Vlong (Integers.Int64.repr (BinInt.Z.div j (BinNums.Zpos (BinNums.xO BinNums.xH)))))
            (@Maps.PTree.set Values.val _t'2 (Values.Vint Integers.Int.zero) le)) mf ClightBigstep.Out_normal
exec_buffer8_empty_stop
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero))),
       ClightBigstep.Clight2.exec_stmt ge0 e le m buffer8_actual_loop Events.E0 le m ClightBigstep.Out_normal
buffer63_empty_counts_chain
     : buffer8_empty_chain buffer63_empty_counts
empty_loop_from_normal_sequence
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem) (s1 s2 : Clight.statement)
         (lenext : Clight.temp_env) (mn : Memory.Mem.mem) (lef : Clight.temp_env) (mf : Memory.Mem.mem)
         (_ : ClightBigstep.Clight2.exec_stmt ge0 e le m (Clight.Ssequence s1 s2) Events.E0 lenext mn
                ClightBigstep.Out_normal)
         (_ : ClightBigstep.Clight2.exec_stmt ge0 e lenext mn (Clight.Sloop s1 s2) Events.E0 lef mf
                ClightBigstep.Out_normal),
