       ClightBigstep.Clight2.exec_stmt ge0 (jet_one8.e_one8 bl) le m (extend_wide_fill s) Events.E0
         (@Maps.PTree.set Values.val _t'2 (extend_bit_raw (extend_wide_input s) bit) le) mf ClightBigstep.Out_normal
exec_extend_wide_loop
     : forall (s : extend_wide_size) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bit : bool) (i : BinNums.Z)
         (n : nat) (_ : BinInt.Z.le BinNums.Z0 i)
         (_ : @eq BinNums.Z (BinInt.Z.add i (BinInt.Z.of_nat n)) (extend_wide_count s))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _msb le)
                (@Some Values.val (Values.Vint (bit_int bit))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : extend_wide_fill_run s bd base bit n m mf),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          and
            (ClightBigstep.Clight2.exec_stmt ge0 (jet_one8.e_one8 bl) le m (extend_wide_loop s) Events.E0 lef mf
               ClightBigstep.Out_normal)
            (forall (id : AST.ident) (_ : not (@eq AST.ident id _i)) (_ : not (@eq AST.ident id _t'2)),
             @eq (option Values.val) (@Maps.PTree.get Values.val id lef) (@Maps.PTree.get Values.val id le)))
eval_extend_wide_msb
     : forall (s : extend_wide_size) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (r : Integers.Int64.int)
