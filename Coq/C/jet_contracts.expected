     : forall (rho : forall _ : nat, Integers.Int64.int) (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : forall (n : nat) (_ : lt n (S (S (S (S (S O)))))),
              and
                (BinInt.Z.le (Integers.Int64.unsigned (rho (S n)))
                   (BinInt.Z.sub
                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                      (BinNums.Zpos BinNums.xH)))
                (BinInt.Z.le (Integers.Int64.unsigned (rho (Nat.add (S (S (S (S (S (S O)))))) n)))
                   (BinInt.Z.sub
                      (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                      (BinNums.Zpos BinNums.xH))))
         (_ : @eq BinNums.Z (field_input_value rho (S O))
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                   canonical_field_order))
         (_ : @eq BinNums.Z (field_input_value rho (S (S (S (S (S (S O)))))))
                (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                   canonical_field_order)),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (wide_fe_output (add_value rho O) (add_value rho (S O)) (add_value rho (S (S O)))
            (add_value rho (S (S (S O)))) (add_value rho (S (S (S (S O))))))
         (@literal_fe_add Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))
add_reader_rho_first
     : forall (va vb : BinNums.Z) (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @eq Integers.Int64.int (add_reader_rho va vb (S n)) (limb_rho va n)
add_reader_rho_second
     : forall (va vb : BinNums.Z) (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @eq Integers.Int64.int (add_reader_rho va vb (Nat.add (S (S (S (S (S (S O)))))) n)) (limb_rho vb n)
add_reader_field_first
     : forall va vb : BinNums.Z,
       @eq (list Integers.Int64.int) (field_values (add_reader_rho va vb) (S O))
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (fe_limbs_of va))
add_reader_field_second
     : forall va vb : BinNums.Z,
       @eq (list Integers.Int64.int) (field_values (add_reader_rho va vb) (S (S (S (S (S (S O)))))))
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (fe_limbs_of vb))
add_reader_values
     : forall (va vb : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 va)
                (BinInt.Z.lt va
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 vb)
                (BinInt.Z.lt vb
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       and (@eq BinNums.Z (field_input_value (add_reader_rho va vb) (S O)) va)
         (@eq BinNums.Z (field_input_value (add_reader_rho va vb) (S (S (S (S (S (S O))))))) vb)
add_reader_bounds
     : forall (va vb : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 va)
                (BinInt.Z.lt va
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 vb)
                (BinInt.Z.lt vb
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       and
         (BinInt.Z.le (Integers.Int64.unsigned (add_reader_rho va vb (S n)))
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
               (BinNums.Zpos BinNums.xH)))
         (BinInt.Z.le (Integers.Int64.unsigned (add_reader_rho va vb (Nat.add (S (S (S (S (S (S O)))))) n)))
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
               (BinNums.Zpos BinNums.xH)))
normalized_add_reader_facts
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (forall (n : nat) (_ : lt n (S (S (S (S (S O)))))),
          and
            (BinInt.Z.le (Integers.Int64.unsigned (normalized_add_rho a b (S n)))
               (BinInt.Z.sub
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                  (BinNums.Zpos BinNums.xH)))
            (BinInt.Z.le (Integers.Int64.unsigned (normalized_add_rho a b (Nat.add (S (S (S (S (S (S O)))))) n)))
               (BinInt.Z.sub
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                  (BinNums.Zpos BinNums.xH))))
         (and
            (@eq BinNums.Z (field_input_value (normalized_add_rho a b) (S O))
               (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
                  canonical_field_order))
            (@eq BinNums.Z (field_input_value (normalized_add_rho a b) (S (S (S (S (S (S O)))))))
               (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)
                  canonical_field_order)))
eval_field_add_from_normalized_fields
     : forall (m : Memory.Mem.mem) (ba bb : Values.block)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : not (@eq Values.block ba bb))
         (_ : fe_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_fe_normalize Alg.CoreFunSem a)))))
         (_ : fe_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_fe_normalize Alg.CoreFunSem b)))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and (fe_at mf ba BinNums.Z0 (add_values (normalized_add_rho a b)))
               (and
                  (@eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (wide_fe_output (add_value (normalized_add_rho a b) O) (add_value (normalized_add_rho a b) (S O))
                        (add_value (normalized_add_rho a b) (S (S O)))
                        (add_value (normalized_add_rho a b) (S (S (S O))))
                        (add_value (normalized_add_rho a b) (S (S (S (S O))))))
                     (@literal_fe_add Alg.CoreFunSem
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b)))
                  (and
                     (Memory.Mem.range_perm mf ba BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bb BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (lframe
                           (fun (b' : Values.block) (pos : BinNums.Z) =>
                            not
                              (foot
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))))
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape field_add_initial_regs) b' pos)) m mf))))))
read_fe_final_inv_to_next_initial
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc next_rc cap : BinNums.Z)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) cap
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) a) rc)
                (read_fe_log bi (Integers.Ptrofs.repr edge)) m),
       invA m0 bd dbase bw outedge cursor N bi next_rc false (@nil Cell) cap
         (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) b) next_rc)
         (@nil event) m
field_at_lframe
     : forall (m mf : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (xs : list Integers.Int64.int)
         (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (_ : fe_at m b ofs xs) (_ : lframe P m mf)
         (_ : forall pos : BinNums.Z, P b pos), fe_at mf b ofs xs
field_freeable_lframe
     : forall (m mf : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (xs : list Integers.Int64.int)
         (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (_ : fe_at m b ofs xs)
         (_ : Memory.Mem.range_perm m b ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable) (_ : lframe P m mf) (_ : forall pos : BinNums.Z, P b pos),
       Memory.Mem.range_perm mf b ofs
