write_fe_selected_outs_canonical
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (bd : Values.block) (base : Integers.Ptrofs.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Cell)
         (outsA (write_fe_rho (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value) rc)
            (slog
               (@fst sstate xout
                  (rsel (write_fe_rho (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value) rc)
                     layout (write_fe_result bd base)))))
         (@encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@canonical_fe_normalize Alg.CoreFunSem value))
eval_write_fe_against_canonical_program
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (w0 : bool) (outs0 : list Cell)
         (m : Memory.Mem.mem) (layout : layout) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : rep (write_fe_rho (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value) rc)
                layout write_fe_initial_regs m) (_ : xsep (jet_secp_write_fe_wrapper.write_ext m0 bd bw bi) layout)
         (_ : jet_secp_write_fe_wrapper.write_inv m0 bd dbase bw outedge cursor N bi rc w0 outs0
                (write_fe_rho (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (finv m0 bd dbase bw outedge cursor N bi mf true
                  (@app Cell outs0
                     (@encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                        (@canonical_fe_normalize Alg.CoreFunSem value))))
