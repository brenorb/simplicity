eval_full_multiply64_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem')
         (mc mr1 mr2 mr3 mr4 mk mz mw me mf : Memory.Mem.mem) (bl br bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval) (a b u v : Integers.Int64.int)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block mb br))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mb bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mb bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mc (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr1
                (Values.Vlong a))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr1 (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong b))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr2 (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr3
                (Values.Vlong u))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr3 (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr4
                (Values.Vlong v))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr4 (@Ctypes.Internal Clight.function f_secp256k1_u128_mul)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong a) (@cons Values.val (Values.Vlong b) (@nil Values.val)))) Events.E0
                mk Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mk (@Ctypes.Internal Clight.function f_secp256k1_u128_accum_u64)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong u) (@nil Values.val))) Events.E0 mz Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mz (@Ctypes.Internal Clight.function f_secp256k1_u128_accum_u64)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong v) (@nil Values.val))) Events.E0 mw Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mw (@Ctypes.Internal Clight.function f_write128)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.free_list me (Clight.blocks_of_env ge0 (e_frame_u128 bl br)))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_full_multiply_64)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
eval_read_wide_quad_at
     : forall (s : wide_size) (m : Memory.Mem.mem) (bl : Values.block) (base : BinNums.Z) (bi : Values.block)
         (edge rc : BinNums.Z) (x y z w : Ty.tySem (Word.Word (wide_log s))) (_ : frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (wide_bits s)))))
         (_ : frame_fields_at m bl base bi edge rc) (_ : @frame_input_word_at (wide_log s) m bi edge rc x)
         (_ : @frame_input_word_at (wide_log s) m bi edge (BinInt.Z.add rc (wide_bits s)) y)
         (_ : @frame_input_word_at (wide_log s) m bi edge
                (BinInt.Z.add rc (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (wide_bits s))) z)
         (_ : @frame_input_word_at (wide_log s) m bi edge
                (BinInt.Z.add rc (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) (wide_bits s))) w)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : not (@eq Values.block bl bi)),
       @ex Memory.Mem.mem
         (fun mr1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr2 : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mr3 : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun mr4 : Memory.Mem.mem =>
                   @ex Integers.Int64.int
                     (fun a : Integers.Int64.int =>
                      @ex Integers.Int64.int
                        (fun b : Integers.Int64.int =>
                         @ex Integers.Int64.int
                           (fun u : Integers.Int64.int =>
                            @ex Integers.Int64.int
                              (fun v : Integers.Int64.int =>
                               and
                                 (ClightBigstep.Clight2.eval_funcall ge0 m
                                    (@Ctypes.Internal Clight.function (wide_reader s))
                                    (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base)) (@nil Values.val))
                                    Events.E0 mr1 (Values.Vlong a))
                                 (and
                                    (ClightBigstep.Clight2.eval_funcall ge0 mr1
                                       (@Ctypes.Internal Clight.function (wide_reader s))
                                       (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base)) (@nil Values.val))
                                       Events.E0 mr2 (Values.Vlong b))
                                    (and
                                       (ClightBigstep.Clight2.eval_funcall ge0 mr2
                                          (@Ctypes.Internal Clight.function (wide_reader s))
                                          (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base))
                                             (@nil Values.val)) Events.E0 mr3 (Values.Vlong u))
                                       (and
                                          (ClightBigstep.Clight2.eval_funcall ge0 mr3
                                             (@Ctypes.Internal Clight.function (wide_reader s))
                                             (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base))
                                                (@nil Values.val)) Events.E0 mr4 (Values.Vlong v))
                                          (and
                                             (@eq BinNums.Z (Integers.Int64.unsigned a)
                                                (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x))
                                             (and
                                                (@eq BinNums.Z (Integers.Int64.unsigned b)
                                                   (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) y))
                                                (and
                                                   (@eq BinNums.Z (Integers.Int64.unsigned u)
                                                      (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) z))
                                                   (and
                                                      (@eq BinNums.Z (Integers.Int64.unsigned v)
                                                         (@Word.ToZ.Theory.toZ (Word.WordToZ (...)) w))
                                                      (and
                                                         (frame_fields_at mr4 bl base bi edge (BinInt.Z.add rc (...)))
                                                         (and (forall ... ... ... ..., @eq ... ... ...)
                                                            (and (...) (...)))))))))))))))))))
eval_full_multiply64_layout_matches_spec
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (x y z w : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (cursor rc : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge rc x)
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) y)
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) z)
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))) w)
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_full_multiply_64)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S (S (S (S (S O))))))))
                     (@Word.fullMultiplier (S (S (S (S (S (S O)))))) Alg.CoreFunSem
                        (@pair
                           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
                           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) x y)
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) z w)))))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     (forall (chunk : AST.memory_chunk) (bb : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m bb)
                        (_ : or (not (@eq Values.block bb bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block bb bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf bb ofs) (Memory.Mem.load chunk m bb ofs))))))
full_multiply64_local_spec
     : jet_local_spec f_simplicity_full_multiply_64
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
            (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))))
