encode_vector_fill
     : forall (A X : Ty.Ty) (d : nat) (t : Alg.Core.domain Alg.CoreFunSem A X) (x : Ty.tySem A),
       @eq (list Cell) (@encode (Word.Vector X d) (@Word.fill A X d Alg.CoreFunSem t x))
         (@List.concat Cell (@List.repeat (list Cell) (@encode X (t x)) (PeanoNat.Nat.pow (S (S O)) d)))
encode_left_pad_word_spec
     : forall (n d : nat) (high : bool) (x : Ty.tySem (Word.Word n)),
       @eq (list Cell) (@encode (Word.Vector (Word.Word n) d) (@left_pad_word_spec n d high Alg.CoreFunSem x))
         (@app Cell
            (@List.concat Cell
               (@List.repeat (list Cell) (@encode (Word.Word n) (@pad_word_constant n high Alg.CoreFunSem tt))
                  (Nat.sub (PeanoNat.Nat.pow (S (S O)) d) (S O)))) (@encode (Word.Word n) x))
