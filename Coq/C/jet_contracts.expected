eval_owned_read_fe
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (size : BinNums.Z) (k : point_coordinate) (m : Memory.Mem.mem) (layout : layout)
         (_ : rep (read_fe_rho ibits rc) layout (owned_read_initial_regs size k bi (Integers.Ptrofs.repr edge)) m)
         (_ : xsep (extA m0 bd bw bi) layout)
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false outs0 cap (read_fe_rho ibits rc) (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
               (@cons Values.val
                  (Values.Vptr (blk layout O)
                     (Integers.Ptrofs.repr (BinInt.Z.add (bas layout O) (point_coordinate_offset k))))
                  (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (rep (read_fe_rho ibits rc) layout
                  (sregs
                     (@fst sstate xout
                        (rsel (read_fe_rho ibits rc) (lay layout)
                           (owned_read_result size k bi (Integers.Ptrofs.repr edge))))) mf)
               (and
                  (invA m0 bd dbase bw outedge cursor N bi rc false outs0 cap (read_fe_rho ibits rc)
                     (read_fe_log bi (Integers.Ptrofs.repr edge)) mf)
                  (lframe
                     (frame (extA m0 bd bw bi) layout (owned_read_initial_regs size k bi (Integers.Ptrofs.repr edge)) m)
                     m mf))))
