canonical_scalar_normalize_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_normalize Alg.CoreFunSem x))
         (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
            canonical_group_order)
canonical_scalar_is_zero_numeric
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool (Bit.toBool (@canonical_scalar_is_zero Alg.CoreFunSem value))
         (orb (BinInt.Z.eqb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value) BinNums.Z0)
            (BinInt.Z.eqb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value)
               canonical_group_order))
word_mod_group_zero
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value) (BinInt.Z.lt value (word_modulus (S (S (S (S (S (S (S (S O))))))))))),
       @eq bool (BinInt.Z.eqb (BinInt.Z.modulo value canonical_group_order) BinNums.Z0)
         (orb (BinInt.Z.eqb value BinNums.Z0) (BinInt.Z.eqb value canonical_group_order))
canonical_scalar_zero_after_normalize
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool
         (BinInt.Z.eqb
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@canonical_scalar_normalize Alg.CoreFunSem value)) BinNums.Z0)
         (Bit.toBool (@canonical_scalar_is_zero Alg.CoreFunSem value))
