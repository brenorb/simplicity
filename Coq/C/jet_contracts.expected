           (@cons Clight.expr (Clight.Etempvar _src_shift Ctypesdefs.tulong) (@nil Clight.expr)))))
  (Clight.Sassign (copy_word _dst_ptr)
     (Clight.Ecast
        (Clight.Ebinop Cop.Oshl (Clight.Etempvar _t'4 Ctypesdefs.tulong)
           (Clight.Ebinop Cop.Osub jet_frame_constants.generated_uword_bits
              (Clight.Etempvar _src_shift Ctypesdefs.tulong) Ctypesdefs.tulong) Ctypesdefs.tulong) Ctypesdefs.tulong))
     : Clight.statement
copy_loop_value =
fun (ss : BinNums.Z) (source : Integers.Int64.int) =>
Integers.Int64.shl (Integers.Int64.zero_ext ss source)
  (Integers.Int64.repr
     (BinInt.Z.sub
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) ss))
     : forall (_ : BinNums.Z) (_ : Integers.Int64.int), Integers.Int64.int

Arguments copy_loop_value ss%Z_scope source
copy_loop_env =
fun (le : Maps.PTree.tree Values.val) (ss : BinNums.Z) (source : Integers.Int64.int) =>
@Maps.PTree.set Values.val _t'4 (Values.Vlong (Integers.Int64.zero_ext ss source))
  (@Maps.PTree.set Values.val _t'7 (Values.Vlong source) le)
     : forall (_ : Maps.PTree.tree Values.val) (_ : BinNums.Z) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments copy_loop_env le ss%Z_scope source
