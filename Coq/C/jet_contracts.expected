gen_loop_body =
fun (X : Ty.Ty)
  (add : forall term : Alg.Assertion.Algebra, Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type X) sha256_ctx8_type)
  (term : Alg.Assertion.Algebra) (C W : Ty.Ty) (array : Alg.Assertion.domain term (Ty.Prod C W) (Ty.Sum Ty.Unit X)) =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod (Ty.Prod C W) sha256_ctx8_type)
  (Ty.Prod (Ty.Sum Ty.Unit X) sha256_ctx8_type) (Ty.Sum sha256_ctx8_type sha256_ctx8_type) core
  (@jet_sha256_ctx8_init_spec.AC.pair (Ty.Prod (Ty.Prod C W) sha256_ctx8_type) (Ty.Sum Ty.Unit X) sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.take (Ty.Prod C W) sha256_ctx8_type (Ty.Sum Ty.Unit X) core array)
     (@jet_sha256_ctx8_init_spec.AC.drop (Ty.Prod C W) sha256_ctx8_type sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core)))
  (@jet_sha256_ctx8_init_spec.AC.case Ty.Unit X sha256_ctx8_type (Ty.Sum sha256_ctx8_type sha256_ctx8_type) core
     (@jet_sha256_ctx8_init_spec.AC.injl (Ty.Prod Ty.Unit sha256_ctx8_type) sha256_ctx8_type sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.drop Ty.Unit sha256_ctx8_type sha256_ctx8_type core
           (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core)))
     (@jet_sha256_ctx8_init_spec.AC.injr (Ty.Prod X sha256_ctx8_type) sha256_ctx8_type sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod X sha256_ctx8_type) (Ty.Prod sha256_ctx8_type X) sha256_ctx8_type
           core
           (@jet_sha256_ctx8_init_spec.AC.pair (Ty.Prod X sha256_ctx8_type) sha256_ctx8_type X core
              (@jet_sha256_ctx8_init_spec.AC.drop X sha256_ctx8_type sha256_ctx8_type core
                 (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core))
              (@jet_sha256_ctx8_init_spec.AC.take X sha256_ctx8_type X core (@jet_sha256_ctx8_init_spec.AC.iden X core)))
           (add term))))
     : forall (X : Ty.Ty)
         (_ : forall term : Alg.Assertion.Algebra,
              Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type X) sha256_ctx8_type) (term : Alg.Assertion.Algebra)
         (C W : Ty.Ty) (_ : Alg.Assertion.domain term (Ty.Prod C W) (Ty.Sum Ty.Unit X)),
       Alg.Assertion.domain term (Ty.Prod (Ty.Prod C W) sha256_ctx8_type) (Ty.Sum sha256_ctx8_type sha256_ctx8_type)

