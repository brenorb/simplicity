full_multiply8_context_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem
                (Ty.Prod (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
                   (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode
                 (Ty.Prod (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
                    (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))) a)
              (newWriteFrame (bitSize (Word.Word (S (S (S (S O)))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode
                 (Ty.Prod (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
                    (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))) a)
              (fullWriteFrame
                 (@encode (Word.Word (S (S (S (S O))))) (@Word.fullMultiplier (S (S (S O))) Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function f_simplicity_full_multiply_8) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@Word.fullMultiplier (S (S (S O))) Naive.translate) (Running s0) (Running s1))))
