buffer_list =
fix buffer_list (X : Ty.Ty) (depth : nat) {struct depth} :
    forall _ : Ty.tySem (buffer_type X depth), list (Ty.tySem X) :=
  match depth as depth0 return (forall _ : Ty.tySem (buffer_type X depth0), list (Ty.tySem X)) with
  | O =>
      fun x : Ty.tySem (buffer_type X O) =>
      match x return (list (Ty.tySem X)) with
      | inl _ => @nil (Ty.tySem X)
      | inr y =>
          @cons
            ((fix tySem (X0 : Ty.Ty) : Set :=
                match X0 return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end) X) y
            (@nil
               ((fix tySem (X0 : Ty.Ty) : Set :=
                   match X0 return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) X))
      end
  | S d =>
      fun x : Ty.tySem (buffer_type X (S d)) =>
      @app (Ty.tySem X)
        match
          @fst
            (sum
               ((fix tySem (X0 : Ty.Ty) : Set :=
                   match X0 return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) Ty.Unit)
               ((fix tySem (X0 : Ty.Ty) : Set :=
                   match X0 return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) (Word.Vector X (S d))))
            ((fix tySem (X0 : Ty.Ty) : Set :=
                match X0 return Set with
                | Ty.Unit => unit
                | Ty.Sum A B => sum (tySem A) (tySem B)
                | Ty.Prod A B => prod (tySem A) (tySem B)
                end)
               ((fix buffer_type (X0 : Ty.Ty) (depth0 : nat) {struct depth0} : Ty.Ty :=
                   match depth0 return Ty.Ty with
                   | O => Ty.Sum Ty.Unit X0
                   | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X0 (S d0))) (buffer_type X0 d0)
                   end) X d)) x return (list (Ty.tySem X))
        with
        | inl _ => @nil (Ty.tySem X)
        | inr v => vector_values X (S d) v
        end
        (buffer_list X d
           (@snd
              (sum
                 ((fix tySem (X0 : Ty.Ty) : Set :=
                     match X0 return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) Ty.Unit)
                 ((fix tySem (X0 : Ty.Ty) : Set :=
                     match X0 return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Word.Vector X (S d))))
              ((fix tySem (X0 : Ty.Ty) : Set :=
                  match X0 return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix buffer_type (X0 : Ty.Ty) (depth0 : nat) {struct depth0} : Ty.Ty :=
                     match depth0 return Ty.Ty with
                     | O => Ty.Sum Ty.Unit X0
                     | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X0 (S d0))) (buffer_type X0 d0)
                     end) X d)) x))
  end
     : forall (X : Ty.Ty) (depth : nat) (_ : Ty.tySem (buffer_type X depth)), list (Ty.tySem X)

Arguments buffer_list X%ty_scope depth%nat_scope _
buffer_snoc_spec =
fix buffer_snoc_spec (X : Ty.Ty) (depth : nat) (term : Alg.Core.Algebra) {struct depth} :
    Alg.Core.domain term (Ty.Prod (buffer_type X depth) X) (Ty.Sum (Word.Vector X (S depth)) (buffer_type X depth)) :=
  match
    depth as depth0
    return
      (Alg.Core.domain term (Ty.Prod (buffer_type X depth0) X)
         (Ty.Sum (Word.Vector X (S depth0)) (buffer_type X depth0)))
  with
  | O =>
      @jet_sha256_count_assertion.AC.case Ty.Unit X X (Ty.Sum (Ty.Prod X X) (Ty.Sum Ty.Unit X)) term
        (@jet_sha256_count_assertion.AC.injr (Ty.Prod Ty.Unit X) (Ty.Prod X X) (Ty.Sum Ty.Unit X) term
           (@jet_sha256_count_assertion.AC.injr (Ty.Prod Ty.Unit X) Ty.Unit X term
              (@jet_sha256_count_assertion.AC.drop Ty.Unit X X term (@jet_sha256_count_assertion.AC.iden X term))))
        (@jet_sha256_count_assertion.AC.injl (Ty.Prod X X) (Ty.Prod X X) (Ty.Sum Ty.Unit X) term
           (@jet_sha256_count_assertion.AC.iden (Ty.Prod X X) term))
  | S d =>
      @jet_sha256_count_assertion.AC.comp
        (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)) X)
        (Ty.Prod (Ty.Sum (Word.Vector X (S d)) (buffer_type X d)) (Ty.Sum Ty.Unit (Word.Vector X (S d))))
        (Ty.Sum (Ty.Prod (Word.Vector X (S d)) (Word.Vector X (S d)))
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d))) term
        (@jet_sha256_count_assertion.AC.pair
           (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)) X)
           (Ty.Sum (Word.Vector X (S d)) (buffer_type X d)) (Ty.Sum Ty.Unit (Word.Vector X (S d))) term
           (@jet_sha256_count_assertion.AC.comp
              (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)) X)
              (Ty.Prod (buffer_type X d) X) (Ty.Sum (Word.Vector X (S d)) (buffer_type X d)) term
              (@jet_sha256_count_assertion.AC.pair
                 (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)) X)
                 (buffer_type X d) X term
                 (@jet_sha256_count_assertion.AC.take
                    (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)) X (buffer_type X d) term
                    (@jet_sha256_count_assertion.AC.drop (Ty.Sum Ty.Unit (Word.Vector X (S d)))
                       (buffer_type X d) (buffer_type X d) term
                       (@jet_sha256_count_assertion.AC.iden (buffer_type X d) term)))
                 (@jet_sha256_count_assertion.AC.drop
                    (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)) X X term
                    (@jet_sha256_count_assertion.AC.iden X term))) (buffer_snoc_spec X d term))
           (@jet_sha256_count_assertion.AC.take (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)) X
              (Ty.Sum Ty.Unit (Word.Vector X (S d))) term
              (@jet_sha256_count_assertion.AC.take (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)
                 (Ty.Sum Ty.Unit (Word.Vector X (S d))) term
                 (@jet_sha256_count_assertion.AC.iden (Ty.Sum Ty.Unit (Word.Vector X (S d))) term))))
        (@jet_sha256_count_assertion.AC.case (Word.Vector X (S d)) (buffer_type X d)
           (Ty.Sum Ty.Unit (Word.Vector X (S d)))
           (Ty.Sum (Ty.Prod (Word.Vector X (S d)) (Word.Vector X (S d)))
              (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d))) term
           (@jet_sha256_count_assertion.AC.comp (Ty.Prod (Word.Vector X (S d)) (Ty.Sum Ty.Unit (Word.Vector X (S d))))
              (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (Word.Vector X (S d)))
              (Ty.Sum (Ty.Prod (Word.Vector X (S d)) (Word.Vector X (S d)))
                 (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d))) term
              (@jet_sha256_count_assertion.AC.pair
                 (Ty.Prod (Word.Vector X (S d)) (Ty.Sum Ty.Unit (Word.Vector X (S d))))
