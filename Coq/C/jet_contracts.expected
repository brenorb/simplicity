         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize (Word.Word O))))
                Integers.Int64.max_unsigned) (_ : frame_input_cells_at m bi edge read_cursor (@encode (Word.Word O) a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize (Word.Word O)))),
       @ex Memory.Mem.mem
