     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@canonical_fe_negate)
field_negate_run_eq
     : @eq (option res) field_negate_run (@Some res (RDone field_negate_state ONormal))
field_negate_return
     : @eq (option sx) (@Maps.PTree.get sx BinNums.xH (stemps field_negate_state)) (@None sx)
eval_field_negate_from_owned_region
     : forall (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho layout local_write_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (rep rho layout (sregs field_negate_state) mf)
               (and
                  (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                     (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        rshape (sregs field_negate_state))
                     (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        rshape local_write_initial_regs))
                  (lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      not
                        (foot layout
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              local_write_initial_regs) b pos)) m mf))))
negate_normalizer_bounds
     : forall (rho : forall _ : nat, Integers.Int64.int)
         (_ : fe_limbs_ok (Integers.Int64.unsigned (rho (S O))) (Integers.Int64.unsigned (rho (S (S O))))
                (Integers.Int64.unsigned (rho (S (S (S O))))) (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                (Integers.Int64.unsigned (rho (S (S (S (S (S O)))))))) (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       BinInt.Z.le (Integers.Int64.unsigned (negate_value rho n))
         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
eval_negate_normalization_calls
     : forall (m : Memory.Mem.mem) (b : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))) local_write_initial_regs m)
         (_ : fe_limbs_ok (Integers.Int64.unsigned (rho (S O))) (Integers.Int64.unsigned (rho (S (S O))))
                (Integers.Int64.unsigned (rho (S (S (S O))))) (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))))
         (_ : @eq BinNums.Z
                (fe_val (Integers.Int64.unsigned (rho (S O))) (Integers.Int64.unsigned (rho (S (S O))))
                   (Integers.Int64.unsigned (rho (S (S (S O))))) (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                   (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x) feP),
       @ex Memory.Mem.mem
         (fun mn : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mn
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall secp_ge mn
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var)
                     (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
                     Values.Vundef)
                  (and
                     (fe_at mf b BinNums.Z0
                        (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                           (fe_limbs_of
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                 (@canonical_fe_negate Alg.CoreFunSem x)))))
                     (and
                        (Memory.Mem.range_perm mn b BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (lframe
                              (fun (b' : Values.block) (pos : BinNums.Z) =>
                               not
                                 (foot
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z)))
                                    (@List.map region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       rshape local_write_initial_regs) b' pos)) m mn)
                           (lframe
                              (fun (b' : Values.block) (pos : BinNums.Z) =>
                               not
                                 (and (@eq Values.block b' b)
                                    (and (BinInt.Z.le BinNums.Z0 pos)
                                       (BinInt.Z.lt pos
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                              mn mf)))))))
fe_mask_value
     : @eq BinNums.Z
         (fe_val
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))) feR)
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
               (BinNums.Zpos BinNums.xH))
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
               (BinNums.Zpos BinNums.xH))
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
               (BinNums.Zpos BinNums.xH))
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
               (BinNums.Zpos BinNums.xH))) feP
fe_negate_unreduced
     : forall z0 z1 z2 z3 z4 : BinNums.Z,
       @eq BinNums.Z
         (fe_val
            (BinInt.Z.sub
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                  (BinInt.Z.sub
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))) feR))
               z0)
            (BinInt.Z.sub
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                  (BinInt.Z.sub
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
