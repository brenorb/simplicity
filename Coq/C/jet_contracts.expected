       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ n) (Integers.Int.unsigned (Integers.Int.not r)))
         (@complement_spec n Alg.CoreFunSem x)
