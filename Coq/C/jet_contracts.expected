  (Clight.Evar (wide_rotate_helper_id s)
     (Ctypes.Tfunction (Ctypes.Tcons Ctypesdefs.tulong (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tulong
        AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar _input Ctypesdefs.tulong)
     (@cons Clight.expr (Clight.Etempvar _amt Ctypesdefs.tuchar) (@nil Clight.expr)))
     : forall _ : wide_size, Clight.statement

