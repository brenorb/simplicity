parse_lock_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S (S (S O)))))))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor (@encode (Word.Word (S (S (S (S (S O)))))) a))
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.of_nat (bitSize (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f_simplicity_parse_lock)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))
                     (@parse_lock_spec Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor
                           (BinInt.Z.of_nat
                              (bitSize (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat
                                                    (bitSize
                                                       (Ty.Sum (Word.Word (S (S (S (S (S O))))))
                                                          (Word.Word (S (S (S (S (S O))))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
parse_lock_context_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S (S (S O)))))) a)
              (newWriteFrame (bitSize (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))))))
         in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S (S (S O)))))) a)
              (fullWriteFrame
                 (@encode (Ty.Sum (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))
                    (@parse_lock_spec Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f_simplicity_parse_lock)
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@parse_lock_spec Naive.translate) (Running s0) (Running s1))))
word_bit_spec_parametric
     : forall n i : nat, @Alg.Core.Parametric (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) (@word_bit_spec n i)
word_count_power
     : forall n : nat, @eq BinNums.Z (Zpower.two_power_nat n) (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) n))
word_bit_spec_numeric
     : forall (n i : nat) (x : Ty.tySem (Word.Word n)) (_ : lt i (PeanoNat.Nat.pow (S (S O)) n)),
       @eq bool (Bit.toBool (@word_bit_spec n i Alg.CoreFunSem x))
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (BinInt.Z.of_nat i))
top_bit_threshold
     : forall (z k : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 k)
         (_ : and (BinInt.Z.le BinNums.Z0 z)
                (BinInt.Z.lt z
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.add k (BinNums.Zpos BinNums.xH))))),
       @eq bool (BinInt.Z.testbit z k) (negb (BinInt.Z.ltb z (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
int64_single_bit_mask
     : forall (r : Integers.Int64.int) (k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.lt k
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq Integers.Int64.int
         (Integers.Int64.and r (Integers.Int64.repr (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
         match Integers.Int64.testbit r k return Integers.Int64.int with
         | true => Integers.Int64.repr (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
         | false => Integers.Int64.zero
         end
int64_single_bit_mask_nonzero
     : forall (r : Integers.Int64.int) (k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.lt k
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq bool
         (negb
            (Integers.Int64.eq
               (Integers.Int64.and r (Integers.Int64.repr (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
               Integers.Int64.zero)) (Integers.Int64.testbit r k)
parse_sequence_spec_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
         (@parse_sequence_spec)
parse_sequence_enabled_bit31
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (r : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) x)),
       @eq bool (parse_sequence_enabled r)
