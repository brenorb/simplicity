minmax_word_spec =
fun (n : nat) (maximum : bool) (term : Alg.Core.Algebra) =>
@jet_minmax_spec.AC.comp (Ty.Prod (Word.Word n) (Word.Word n))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word n) (Word.Word n))) (Word.Word n) term
  (@jet_minmax_spec.AC.pair (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit)
     (Ty.Prod (Word.Word n) (Word.Word n)) term (@le_word_spec term n)
     (@jet_minmax_spec.AC.iden (Ty.Prod (Word.Word n) (Word.Word n)) term))
  match
    maximum
    return
      (Alg.Core.domain term (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word n) (Word.Word n))) (Word.Word n))
  with
  | true =>
      @Bit.cond (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n) term
        (@jet_minmax_spec.AC.drop (Word.Word n) (Word.Word n) (Word.Word n) term
           (@jet_minmax_spec.AC.iden (Word.Word n) term))
        (@jet_minmax_spec.AC.take (Word.Word n) (Word.Word n) (Word.Word n) term
           (@jet_minmax_spec.AC.iden (Word.Word n) term))
  | false =>
      @Bit.cond (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n) term
        (@jet_minmax_spec.AC.take (Word.Word n) (Word.Word n) (Word.Word n) term
           (@jet_minmax_spec.AC.iden (Word.Word n) term))
        (@jet_minmax_spec.AC.drop (Word.Word n) (Word.Word n) (Word.Word n) term
           (@jet_minmax_spec.AC.iden (Word.Word n) term))
  end
     : forall (n : nat) (_ : bool) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n)

