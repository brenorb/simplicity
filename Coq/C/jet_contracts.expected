                (@Some Values.block (bitcoin_symbol_block fid)))
         (_ : @eq (option Clight.fundef)
                (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv bitcoin_ge)
                   (Values.Vptr (bitcoin_symbol_block fid) Integers.Ptrofs.zero))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))
