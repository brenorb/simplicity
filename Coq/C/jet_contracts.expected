@final_program_parametric ?alg1 ?alg2
     : forall (R : Alg.Core.Parametric.Rel ?alg1 ?alg2)
         (op1 : Alg.Core.domain ?alg1 (Word.Word (S (S (S (S (S O))))))
                  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (op2 : Alg.Core.domain ?alg2 (Word.Word (S (S (S (S (S O))))))
                  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (_ : @Alg.Core.Parametric.rel ?alg1 ?alg2 R (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) op1 op2),
       @Alg.Core.Parametric.rel ?alg1 ?alg2 R Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (@final_program ?alg1 op1)
         (@final_program ?alg2 op2)
where
?alg1 : [ |- Alg.Core.Algebra]
?alg2 : [ |- Alg.Core.Algebra]
@final_tail_reader_sem ?E
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : ?E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)))
         (@final_tail (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) x environment)
         (@Some (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)) (@final_tail Alg.CoreFunSem x))
where
?E : [ |- Type]
@final_body_reader_sem ?E
     : forall
         (op : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad))
                 (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (p : Ty.tySem (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit))
         (environment : ?E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)))
         (@final_body (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) op p environment)
         (final_step (fun w : Ty.tySem (Word.Word (S (S (S (S (S O)))))) => op w environment) p)
where
?E : [ |- Type]
@final_program_reader_finish ?E
     : forall
         (op : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad))
                 (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (environment : ?E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)))
         (@final_program (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) op tt environment)
         (@Option.option_bind (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)) (sum unit unit)
            (fun result : Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) =>
             match result return (option (sum unit unit)) with
             | inl x => @Some (sum unit unit) x
             | inr _ => @Some (sum unit unit) (@inr unit unit tt)
             end)
            (@for_while_program (S (S (S (S (S O))))) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit
               (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad))
               (@final_body (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) op)
               (@pair unit unit tt tt) environment))
where
?E : [ |- Type]
@final_program_reader_sem ?E
     : forall
         (op : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad))
                 (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (environment : ?E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)))
         (@final_program (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) op tt environment)
         (@Option.option_bind (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)) (sum unit unit)
            (fun result : Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) =>
             match result return (option (sum unit unit)) with
             | inl x => @Some (sum unit unit) x
             | inr _ => @Some (sum unit unit) (@inr unit unit tt)
             end)
            (@for_while_run (S (S (S (S (S O))))) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit
               (final_step (fun w : Ty.tySem (Word.Word (S (S (S (S (S O)))))) => op w environment)) tt tt))
where
?E : [ |- Type]
final_tail_value
     : forall v : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
       @eq (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)) (@final_tail Alg.CoreFunSem v)
         match
           predicate_numeric (S (S (S (S (S O))))) true (wz (S (S (S (S (S O))))) v)
           return (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit))
         with
         | true => @inr (sum unit unit) unit tt
         | false => @inl (sum unit unit) unit (@inl unit unit tt)
