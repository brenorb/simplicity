scalar_carry_sx_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (x y : sx),
       @eq Values.val (den rho layout (scalar_carry_sx x y))
         (Values.Vlong (scalar_carry64 (il (den rho layout x)) (il (den rho layout y))))
scalar_sum_values
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (x y z : sx),
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout (scalar_sum_low x y z))))
            (BinInt.Z.modulo
               (BinInt.Z.add
                  (BinInt.Z.add (Integers.Int64.unsigned (il (den rho layout x)))
                     (Integers.Int64.unsigned (il (den rho layout y))))
                  (Integers.Int64.unsigned (il (den rho layout z)))) Integers.Int64.modulus))
         (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout (scalar_sum_high x y z))))
            (BinInt.Z.div
               (BinInt.Z.add
                  (BinInt.Z.add (Integers.Int64.unsigned (il (den rho layout x)))
                     (Integers.Int64.unsigned (il (den rho layout y))))
                  (Integers.Int64.unsigned (il (den rho layout z)))) Integers.Int64.modulus))
scalar_reduce_deltas
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (b : bool) (_ : @eq Integers.Int64.int (rho (S (S (S (S O))))) (Integers.Int64.repr (b2z b))),
       and
         (@eq Values.val (den rho layout scalar_reduce_delta0)
            (Values.Vlong
               (Integers.Int64.repr
                  (BinInt.Z.mul (b2z b)
                     (BinNums.Zpos
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
         (and
            (@eq Values.val (den rho layout scalar_reduce_delta1)
               (Values.Vlong
                  (Integers.Int64.repr
                     (BinInt.Z.mul (b2z b)
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (...))))))))))))))))))))))
            (@eq Values.val (den rho layout scalar_reduce_delta2) (Values.Vlong (Integers.Int64.repr (b2z b)))))
scalar_reduce_delta_unsigned
     : forall b : bool,
       and
         (@eq BinNums.Z
            (Integers.Int64.unsigned
               (Integers.Int64.repr
                  (BinInt.Z.mul (b2z b)
                     (BinNums.Zpos
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...))))))))))))))))))))))
            (BinInt.Z.mul (b2z b)
               (BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xO
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xO
                                                               (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (and
            (@eq BinNums.Z
               (Integers.Int64.unsigned
                  (Integers.Int64.repr
                     (BinInt.Z.mul (b2z b)
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (...)))))))))))))))))))))
               (BinInt.Z.mul (b2z b)
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xI
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xO
                                                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (...))))))))))))))))))))))
            (@eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.repr (b2z b))) (b2z b)))
scalar_reduce_limbs_values
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (b : bool) (_ : @eq Integers.Int64.int (rho (S (S (S (S O))))) (Integers.Int64.repr (b2z b))),
       let s0 : BinNums.Z :=
         BinInt.Z.add (Integers.Int64.unsigned (rho O))
           (BinInt.Z.mul (b2z b)
              (BinNums.Zpos
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI
                                                           (BinNums.xO
                                                              (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (...))))))))))))))))))))))
         in
       let s1 : BinNums.Z :=
         BinInt.Z.add (BinInt.Z.add (BinInt.Z.div s0 Integers.Int64.modulus) (Integers.Int64.unsigned (rho (S O))))
           (BinInt.Z.mul (b2z b)
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xO
                                                           (BinNums.xI
                                                              (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))))))
         in
       let s2 : BinNums.Z :=
         BinInt.Z.add (BinInt.Z.add (BinInt.Z.div s1 Integers.Int64.modulus) (Integers.Int64.unsigned (rho (S (S O)))))
           (b2z b) in
       let s3 : BinNums.Z :=
         BinInt.Z.add (BinInt.Z.div s2 Integers.Int64.modulus) (Integers.Int64.unsigned (rho (S (S (S O))))) in
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_reduce_low0)))
            (BinInt.Z.modulo s0 Integers.Int64.modulus))
         (and
            (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_reduce_low1)))
               (BinInt.Z.modulo s1 Integers.Int64.modulus))
            (and
               (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_reduce_low2)))
                  (BinInt.Z.modulo s2 Integers.Int64.modulus))
               (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_reduce_low3)))
                  (BinInt.Z.modulo s3 Integers.Int64.modulus))))
scalar_reduce_weighted_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (b : bool) (_ : @eq Integers.Int64.int (rho (S (S (S (S O))))) (Integers.Int64.repr (b2z b))),
       @eq BinNums.Z (scalar_reduce_output_value rho layout)
         (BinInt.Z.modulo
            (BinInt.Z.add (scalar_limb_value rho)
               (BinInt.Z.mul (b2z b)
                  (BinInt.Z.sub
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     canonical_group_order)))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
scalar_limb_value_range
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (scalar_limb_value rho))
         (BinInt.Z.lt (scalar_limb_value rho)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
scalar_reduce_modulus_bridge
     : forall (v : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 v)
                (BinInt.Z.lt v
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add v
               (BinInt.Z.mul (b2z (BinInt.Z.leb canonical_group_order v))
                  (BinInt.Z.sub
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     canonical_group_order)))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (BinInt.Z.modulo v canonical_group_order)
scalar_reduce_canonical_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : @eq Integers.Int64.int (rho (S (S (S (S O)))))
                (Integers.Int64.repr (b2z (BinInt.Z.leb canonical_group_order (scalar_limb_value rho))))),
       @eq BinNums.Z (scalar_reduce_output_value rho layout)
         (BinInt.Z.modulo (scalar_limb_value rho) canonical_group_order)
scalar_reduce_output_region
     : @eq (option region) (@List.nth_error region (sregs scalar_reduce_state) O)
         (@Some region (mkreg (cells0 scalar_reduce_state) true (@None BinNums.Z)))
scalar_reduce_return_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout scalar_reduce_return)
         (Values.Vint (Integers.Int.repr (Integers.Int64.unsigned (rho (S (S (S (S O))))))))
scalar_reduce_output_loads
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout (sregs scalar_reduce_state) m) (i : nat) (_ : lt i (S (S (S (S O))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (blk layout O)
            (BinInt.Z.add (bas layout O)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))
         (@Some Values.val (Values.Vlong (scalar_reduce_limb rho (lay layout) i)))
scalar_reduce_limb_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (scalar_limb_value (scalar_reduce_limb rho layout)) (scalar_reduce_output_value rho layout)
eval_scalar_reduce_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout scalar_reduce_initial_regs m)
         (_ : @eq Integers.Int64.int (rho (S (S (S (S O)))))
                (Integers.Int64.repr (b2z (BinInt.Z.leb canonical_group_order (scalar_limb_value rho))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_reduce)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vint (Integers.Int.repr (Integers.Int64.unsigned (rho (S (S (S (S O))))))))
                     (@nil Values.val))) Events.E0 mf
               (Values.Vint (Integers.Int.repr (Integers.Int64.unsigned (rho (S (S (S (S O)))))))))
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (blk layout O)
                     (BinInt.Z.add (bas layout O)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i))))
                  (@Some Values.val (Values.Vlong (scalar_reduce_limb rho (lay layout) i))))
               (and
                  (@eq BinNums.Z (scalar_limb_value (scalar_reduce_limb rho (lay layout)))
                     (BinInt.Z.modulo (scalar_limb_value rho) canonical_group_order))
                  (and (rep rho layout (sregs scalar_reduce_state) mf)
                     (lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (foot layout
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 scalar_reduce_initial_regs) b ofs)) m mf)))))
scalar_bind_den
     : forall (sigma : forall _ : nat, sx) (flag : sx) (rho rho' : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z) (x : sx)
         (_ : forall n : nat, @eq Values.val (den rho layout (sigma n)) (Values.Vlong (rho' n)))
         (_ : @eq Values.val (den rho layout flag) (Values.Vint (Integers.Int64.loword (rho' (S (S (S (S O)))))))),
       @eq Values.val (den rho layout (scalar_bind sigma flag x)) (den rho' layout x)
scalar_loword_signed
     : forall i : Integers.Int.int,
       @eq Integers.Int.int (Integers.Int64.loword (Integers.Int64.repr (Integers.Int.signed i))) i
scalar_flag_lift
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (flag : sx) (_ : @eq bool (isk KI flag) true),
       @eq Values.val (den rho layout flag)
         (Values.Vint (Integers.Int64.loword (Integers.Int64.repr (Integers.Int.signed (ii (den rho layout flag))))))
scalar_set_raw_run_eq
     : @eq (option res) scalar_set_raw_run (@Some res (RDone scalar_set_raw_state ONormal))
scalar_set_raw_expressions_length
     : @eq nat (@length sx scalar_set_raw_expressions) (S (S (S (S O))))
scalar_set_raw_expressions_kind
     : @List.Forall sx (fun x : sx => @eq bool (isk KL x) true) scalar_set_raw_expressions
scalar_set_raw_sigma_kind
     : forall n : nat, @eq bool (isk KL (scalar_set_raw_sigma n)) true
scalar_set_flag_kind
     : @eq bool (isk KI scalar_set_flag) true
scalar_set_sigma_kind
     : forall n : nat, @eq bool (isk KL (scalar_set_sigma n)) true
scalar_set_output_shape
     : @eq (list cell) (cells0 scalar_set_state)
         (@cons cell (mkcell BinNums.Z0 AST.Mint64 (@Some sx (scalar_set_instantiate scalar_reduce_low0)))
            (@cons cell
               (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
                  (@Some sx (scalar_set_instantiate scalar_reduce_low1)))
               (@cons cell
                  (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) AST.Mint64
                     (@Some sx (scalar_set_instantiate scalar_reduce_low2)))
                  (@cons cell
                     (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))) AST.Mint64
                        (@Some sx (scalar_set_instantiate scalar_reduce_low3))) (@nil cell)))))
scalar_set_sigma_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (n : nat),
       @eq Values.val (den rho layout (scalar_set_sigma n)) (Values.Vlong (scalar_set_reduction_rho rho layout n))
scalar_set_bound_flag
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout scalar_set_flag)
         (Values.Vint (Integers.Int64.loword (scalar_set_reduction_rho rho layout (S (S (S (S O)))))))
scalar_set_bound_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx),
       @eq Values.val (den rho layout (scalar_set_instantiate x)) (den (scalar_set_reduction_rho rho layout) layout x)
scalar_set_raw_sigma_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (n : nat),
       @eq Values.val (den rho layout (scalar_set_raw_sigma n)) (Values.Vlong (scalar_set_raw_rho rho layout n))
scalar_set_actual_flag
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout scalar_set_flag)
         (Values.Vint (b2i (BinInt.Z.leb canonical_group_order (scalar_limb_value (scalar_set_raw_rho rho layout)))))
scalar_set_reduction_input_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (scalar_limb_value (scalar_set_reduction_rho rho layout))
         (scalar_limb_value (scalar_set_raw_rho rho layout))
scalar_set_reduction_flag_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Integers.Int64.int (scalar_set_reduction_rho rho layout (S (S (S (S O)))))
         (Integers.Int64.repr
            (b2z (BinInt.Z.leb canonical_group_order (scalar_limb_value (scalar_set_reduction_rho rho layout)))))
scalar_set_limb_bound_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (i : nat),
       @eq Integers.Int64.int (scalar_set_limb rho layout i)
         (scalar_reduce_limb (scalar_set_reduction_rho rho layout) layout i)
scalar_set_value_mod_group
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (scalar_limb_value (scalar_set_limb rho layout))
         (BinInt.Z.modulo (scalar_limb_value (scalar_set_raw_rho rho layout)) canonical_group_order)
scalar_set_raw_expression_checked
     : forall (i : nat) (_ : lt i (S (S (S (S O))))),
       @eq (option (prod BinNums.Z BinNums.Z)) (zb byte_bnd (scalar_set_raw_sigma i))
         (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 Integers.Int64.max_unsigned))
scalar_set_raw_math
     : forall (bytes : list BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun byte : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 byte)
                   (BinInt.Z.le byte
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes),
       @eq BinNums.Z (scalar_set_raw_integer (fun n : nat => @List.nth BinNums.Z n bytes BinNums.Z0))
         (jet_secp_fe_math.be_val bytes)
scalar_set_raw_unsigned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (i : nat)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (byte_bnd n)) (Integers.Int64.unsigned (rho n)))
                (BinInt.Z.le (Integers.Int64.unsigned (rho n)) (@snd BinNums.Z BinNums.Z (byte_bnd n))))
         (_ : lt i (S (S (S (S O))))),
       @eq BinNums.Z (Integers.Int64.unsigned (scalar_set_raw_rho rho layout i))
         (zval (zrho rho) (scalar_set_raw_sigma i))
scalar_set_raw_input_value
     : forall (bytes : list BinNums.Z) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun byte : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 byte)
                   (BinInt.Z.le byte
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes),
       @eq BinNums.Z (scalar_limb_value (scalar_set_raw_rho (byte_rho bytes) layout)) (jet_secp_fe_math.be_val bytes)
scalar_set_bytes_mod_group
     : forall (bytes : list BinNums.Z) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun byte : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 byte)
                   (BinInt.Z.le byte
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes),
       @eq BinNums.Z (scalar_limb_value (scalar_set_limb (byte_rho bytes) layout))
         (BinInt.Z.modulo (jet_secp_fe_math.be_val bytes) canonical_group_order)
scalar_reader_subst_den
     : forall (sigma : forall _ : nat, sx) (rho rho' : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z) (x : sx)
         (_ : forall n : nat, @eq Values.val (den rho layout (sigma n)) (Values.Vlong (rho' n))),
       @eq Values.val (den rho layout (sx_subst sigma x)) (den rho' layout x)
scalar_reader_limb_shift
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (i : nat),
       @eq Integers.Int64.int (scalar_reader_limb rho layout i) (scalar_set_limb (fun n : nat => rho (S n)) layout i)
scalar_reader_byte_rho
     : forall (bits : list bool) (rc : BinNums.Z) (n : nat)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq Integers.Int64.int (read_fe_rho bits rc (S n))
         (byte_rho
            (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))) bits) n)
scalar_reader_limb_bytes
     : forall (bits : list bool) (rc : BinNums.Z) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (i : nat)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq Integers.Int64.int (scalar_reader_limb (read_fe_rho bits rc) layout i)
         (scalar_set_limb
            (byte_rho
               (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))) bits))
            layout i)
scalar_reader_value_mod_group
     : forall (bits : list bool) (rc : BinNums.Z) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq BinNums.Z (scalar_limb_value (scalar_reader_limb (read_fe_rho bits rc) layout))
         (BinInt.Z.modulo
            (jet_secp_fe_math.be_val
               (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))) bits))
            canonical_group_order)
scalar_reader_set_loads
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (m : Memory.Mem.mem)
         (_ : rep rho layout (sregs (scalar_reader_set_state bi edge)) m) (i : nat) (_ : lt i (S (S (S (S O))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (blk layout O)
            (BinInt.Z.add (bas layout O)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))
         (@Some Values.val (Values.Vlong (scalar_reader_limb rho (lay layout) i)))
scalar_reader_first_shape
     : forall (bi : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
            (sregs (scalar_reader_state bi edge)))
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
            (sregs (scalar_reader_initial bi edge)))
exec_scalar_reader_body
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : layout) (e : Clight.env) (le : Clight.temp_env)
         (_ : rep (read_fe_rho ibits rc) layout (sregs (scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m)
         (_ : tmatch (read_fe_rho ibits rc) layout scalar_reader_temps le) (_ : ematch layout scalar_reader_venv e)
         (_ : xsep (jet_secp_scalar_reader_body.rd_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_reader_body.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (read_fe_rho ibits rc) (@nil event) m),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge e le m (Clight.fn_body jets_secp.f_read_scalar) Events.E0 le'
                  mf ClightBigstep.Out_normal)
               (and
                  (rep (read_fe_rho ibits rc) layout (sregs (scalar_reader_set_state bi (Integers.Ptrofs.repr edge)))
                     mf)
                  (and (tmatch (read_fe_rho ibits rc) layout scalar_reader_temps le')
                     (and
                        (jet_secp_scalar_reader_body.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                           (read_fe_rho ibits rc) (scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                        (lframe
                           (frame (jet_secp_scalar_reader_body.rd_ext m0 bd bw bi) layout
                              (sregs (scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m) m mf))))))
exec_scalar_reader_body_numeric
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : layout) (e : Clight.env) (le : Clight.temp_env)
         (_ : rep (read_fe_rho ibits rc) layout (sregs (scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m)
         (_ : tmatch (read_fe_rho ibits rc) layout scalar_reader_temps le) (_ : ematch layout scalar_reader_venv e)
         (_ : xsep (jet_secp_scalar_reader_body.rd_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_reader_body.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (read_fe_rho ibits rc) (@nil event) m),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge e le m (Clight.fn_body jets_secp.f_read_scalar) Events.E0 le'
                  mf ClightBigstep.Out_normal)
               (and
                  (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                   @eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf (blk layout O)
                        (BinInt.Z.add (bas layout O)
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat i))))
                     (@Some Values.val (Values.Vlong (scalar_reader_limb (read_fe_rho ibits rc) (lay layout) i))))
                  (and
                     (@eq BinNums.Z (scalar_limb_value (scalar_reader_limb (read_fe_rho ibits rc) (lay layout)))
                        (BinInt.Z.modulo
                           (jet_secp_fe_math.be_val
                              (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))) ibits))
                           canonical_group_order))
                     (and
                        (rep (read_fe_rho ibits rc) layout
                           (sregs (scalar_reader_set_state bi (Integers.Ptrofs.repr edge))) mf)
                        (and (@eq BinNums.Z (bas layout (S (S O))) BinNums.Z0)
                           (and
                              (Memory.Mem.range_perm mf (blk layout (S (S O))) BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and (tmatch (read_fe_rho ibits rc) layout scalar_reader_temps le')
                                 (and
                                    (jet_secp_scalar_reader_body.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                                       (read_fe_rho ibits rc) (scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                                    (lframe
                                       (frame (jet_secp_scalar_reader_body.rd_ext m0 bd bw bi) layout
                                          (sregs (scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m) m mf))))))))))
scalar_reader_local_lookup
     : forall (id : AST.ident) (r : nat) (ty : Ctypes.type)
         (_ : @eq (option (prod nat Ctypes.type)) (vlookup scalar_reader_venv id)
                (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty))),
       and (@eq AST.ident id jets_secp._buf)
         (and (@eq nat r (S (S O)))
            (@eq Ctypes.type ty
               (Ctypesdefs.tarray Ctypesdefs.tuchar
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
free_scalar_reader_buffer
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (e : Clight.env) (m : Memory.Mem.mem)
         (_ : rep rho layout (sregs (scalar_reader_set_state bi edge)) m) (_ : ematch layout scalar_reader_venv e),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem) (Memory.Mem.free_list m (Clight.blocks_of_env secp_ge e))
               (@Some Memory.Mem.mem mf))
            (Memory.Mem.unchanged_on
               (fun (b : Values.block) (_ : BinNums.Z) => not (@eq Values.block b (blk layout (S (S O))))) m mf))
represented_layout_valid
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (regs : list region)
         (m : Memory.Mem.mem) (b : Values.block) (_ : rep rho layout regs m)
         (_ : @List.In Values.block b
                (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) layout)),
       Memory.Mem.valid_block m b
scalar_reader_final_length
     : forall (bi : Values.block) (edge : Integers.Ptrofs.int),
       @eq nat (@length region (scalar_reader_final_regs bi edge)) (S (S O))
scalar_reader_foot_extended
     : forall (layout : list (prod Values.block BinNums.Z)) (buffer : Values.block) (base : BinNums.Z)
         (bi : Values.block) (edge : Integers.Ptrofs.int) (b : Values.block) (ofs : BinNums.Z)
         (_ : @eq nat (@length (prod Values.block BinNums.Z) layout) (S (S O)))
         (_ : foot
                (@app (prod Values.block BinNums.Z) layout
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z buffer base)
                      (@nil (prod Values.block BinNums.Z))))
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   (sregs (scalar_reader_initial bi edge))) b ofs),
       or
         (foot layout
            (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
               (scalar_reader_initial_regs bi edge)) b ofs) (@eq Values.block b buffer)
eval_scalar_reader_owned
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : layout)
         (_ : rep (jet_secp_scalar_reader_lifecycle.rd_rho rc ibits) layout
                (scalar_reader_initial_regs bi (Integers.Ptrofs.repr edge)) m)
         (_ : xsep (jet_secp_scalar_reader_lifecycle.rd_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_reader_lifecycle.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (jet_secp_scalar_reader_lifecycle.rd_rho rc ibits) (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_scalar)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (rep (jet_secp_scalar_reader_lifecycle.rd_rho rc ibits) layout
                  (scalar_reader_final_regs bi (Integers.Ptrofs.repr edge)) mf)
               (and
                  (jet_secp_scalar_reader_lifecycle.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                     (jet_secp_scalar_reader_lifecycle.rd_rho rc ibits)
                     (scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                  (lframe
                     (frame (jet_secp_scalar_reader_lifecycle.rd_ext m0 bd bw bi) layout
                        (scalar_reader_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mf))))
scalar_reader_final_loads
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (m : Memory.Mem.mem) (_ : rep rho layout (scalar_reader_final_regs bi edge) m)
         (i : nat) (_ : lt i (S (S (S (S O))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (blk layout O)
            (BinInt.Z.add (bas layout O)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))))
         (@Some Values.val (Values.Vlong (scalar_reader_limb rho (lay layout) i)))
scalar_reader_final_cursor
     : forall (bits : list bool) (rc : BinNums.Z) (layout : layout) (bi : Values.block) (edge : BinNums.Z)
         (m : Memory.Mem.mem)
         (_ : rep (read_fe_rho bits rc) layout (scalar_reader_final_regs bi (Integers.Ptrofs.repr edge)) m),
       frame_fields_at m (blk layout (S O)) (bas layout (S O)) bi edge
         (BinInt.Z.add rc
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
eval_scalar_reader_numeric_owned
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : layout)
         (_ : rep (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) layout
                (scalar_reader_initial_regs bi (Integers.Ptrofs.repr edge)) m)
         (_ : xsep (jet_secp_scalar_reader_lifecycle.value_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_reader_lifecycle.value_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_scalar)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (blk layout O)
                     (BinInt.Z.add (bas layout O)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i))))
                  (@Some Values.val
                     (Values.Vlong
                        (scalar_reader_limb (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) (lay layout) i))))
               (and
                  (@eq BinNums.Z
                     (scalar_limb_value
                        (scalar_reader_limb (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) (lay layout)))
                     (BinInt.Z.modulo
                        (jet_secp_fe_math.be_val
                           (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))) ibits))
                        canonical_group_order))
                  (and
                     (frame_fields_at mf (blk layout (S O)) (bas layout (S O)) bi edge
                        (BinInt.Z.add rc
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (and
                        (rep (jet_secp_scalar_reader_lifecycle.value_rho rc ibits) layout
                           (scalar_reader_final_regs bi (Integers.Ptrofs.repr edge)) mf)
                        (and
                           (jet_secp_scalar_reader_lifecycle.value_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                              (jet_secp_scalar_reader_lifecycle.value_rho rc ibits)
                              (scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                           (lframe
                              (frame (jet_secp_scalar_reader_lifecycle.value_ext m0 bd bw bi) layout
                                 (scalar_reader_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mf)))))))
scalar_zero_run_eq
     : @eq (option res) scalar_zero_run (@Some res (RDone scalar_zero_state ONormal))
scalar_zero_return
     : @eq (option sx) (@Maps.PTree.get sx BinNums.xH (stemps scalar_zero_state)) (@Some sx scalar_zero_ret)
scalar_zero_regions
     : @eq (list region) (sregs scalar_zero_state) scalar_initial_regs
scalar_zero_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout scalar_zero_ret)
         (Values.Vint
            match Integers.Int64.eq (scalar_or_value rho) Integers.Int64.zero return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
eval_scalar_zero_from_owned_region
     : forall (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho layout scalar_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_is_zero)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O))) (@nil Values.val))
               Events.E0 mf
               (Values.Vint
                  match Integers.Int64.eq (scalar_or_value rho) Integers.Int64.zero return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (and (rep rho layout scalar_initial_regs mf)
               (lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (foot layout
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           scalar_initial_regs) b pos)) m mf)))
scalar_or_zero_numeric
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq bool (Integers.Int64.eq (scalar_or_value rho) Integers.Int64.zero)
         (BinInt.Z.eqb (scalar_value rho) BinNums.Z0)
eval_scalar_zero_canonical
     : forall (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : rep rho layout scalar_initial_regs m)
         (_ : @eq BinNums.Z (scalar_value rho)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@canonical_scalar_normalize Alg.CoreFunSem value))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_is_zero)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O))) (@nil Values.val))
               Events.E0 mf (Values.Vint (bit_int (Bit.toBool (@canonical_scalar_is_zero Alg.CoreFunSem value)))))
            (and (rep rho layout scalar_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf (blk layout O) (bas layout O)
                     (BinInt.Z.add (bas layout O)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      not
                        (foot layout
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              scalar_initial_regs) b pos)) m mf))))
scalar_reader_zero_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (scalar_value (scalar_reader_zero_rho rho layout))
         (scalar_limb_value (scalar_reader_limb rho layout))
scalar_reader_zero_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (bi : Values.block)
         (edge : Integers.Ptrofs.int) (m : Memory.Mem.mem) (_ : rep rho layout (scalar_reader_final_regs bi edge) m),
       rep (scalar_reader_zero_rho rho (lay layout))
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z (blk layout O) (bas layout O))
            (@nil (prod Values.block BinNums.Z))) scalar_initial_regs m
scalar_reader_zero_canonical_value
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z
         (scalar_value
            (scalar_reader_zero_rho (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
               layout))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_normalize Alg.CoreFunSem value))
eval_scalar_zero_after_reader
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (m : Memory.Mem.mem) (layout : layout) (bi : Values.block) (edge : Integers.Ptrofs.int)
         (_ : rep (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) layout
                (scalar_reader_final_regs bi edge) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_is_zero)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O))) (@nil Values.val))
               Events.E0 mf (Values.Vint (bit_int (Bit.toBool (@canonical_scalar_is_zero Alg.CoreFunSem value)))))
            (and
               (rep
                  (scalar_reader_zero_rho
                     (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                     (lay layout))
                  (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z (blk layout O) (bas layout O))
                     (@nil (prod Values.block BinNums.Z))) scalar_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf (blk layout O) (bas layout O)
                     (BinInt.Z.add (bas layout O)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     Memtype.Cur Memtype.Freeable)
                  (lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      not
                        (foot
                           (@cons (prod Values.block BinNums.Z)
                              (@pair Values.block BinNums.Z (blk layout O) (bas layout O))
                              (@nil (prod Values.block BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              scalar_initial_regs) b pos)) m mf))))
scalar_public_read_symbols
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) jets_secp._read_scalar)
            (@Some Values.block (secp_symbol_block jets_secp._read_scalar)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv secp_ge)
               (Values.Vptr (secp_symbol_block jets_secp._read_scalar) Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_read_scalar)))
scalar_public_zero_symbols
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge)
               jets_secp._secp256k1_scalar_is_zero)
            (@Some Values.block (secp_symbol_block jets_secp._secp256k1_scalar_is_zero)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv secp_ge)
               (Values.Vptr (secp_symbol_block jets_secp._secp256k1_scalar_is_zero) Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_is_zero)))
exec_scalar_public_read
     : forall (le : Clight.temp_env) (m mf : Memory.Mem.mem) (bl ba : Values.block)
         (_ : ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_scalar)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt secp_ge (scalar_public_env bl ba) le m scalar_public_read_stmt Events.E0 le mf
         ClightBigstep.Out_normal
exec_scalar_public_zero
     : forall (le : Clight.temp_env) (m mf : Memory.Mem.mem) (bl ba : Values.block) (flag : Integers.Int.int)
         (_ : ClightBigstep.Clight2.eval_funcall secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_is_zero)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
                (Values.Vint flag)),
       ClightBigstep.Clight2.exec_stmt secp_ge (scalar_public_env bl ba) le m scalar_public_zero_stmt Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint flag) le) mf ClightBigstep.Out_normal
scalar_zero_foot_block
     : forall (ba b : Values.block) (pos : BinNums.Z)
         (_ : foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z)))
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   scalar_initial_regs) b pos), @eq Values.block b ba
exec_scalar_public_read_and_test
     : forall (le : Clight.temp_env) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bw : Values.block) (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bl : Values.block) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) (BinNums.Zpos BinNums.xH)
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge (scalar_public_env bl ba) le m scalar_public_read_stmt
                  Events.E0 le mr ClightBigstep.Out_normal)
               (and
                  (ClightBigstep.Clight2.exec_stmt secp_ge (scalar_public_env bl ba) le mr scalar_public_zero_stmt
                     Events.E0
                     (@Maps.PTree.set Values.val jets_secp._t'1
                        (Values.Vint (bit_int (Bit.toBool (@canonical_scalar_is_zero Alg.CoreFunSem value)))) le) mf
                     ClightBigstep.Out_normal)
                  (and
                     (rep
                        (scalar_reader_zero_rho
                           (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                           (lay
                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                    (@nil (prod Values.block BinNums.Z))))))
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                           (@nil (prod Values.block BinNums.Z))) scalar_initial_regs mf)
                     (and
                        (Memory.Mem.range_perm mf ba BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (frame_fields_at mf bl BinNums.Z0 bi edge
                              (BinInt.Z.add rc
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                           (and
                              (Memory.Mem.range_perm mf bl BinNums.Z0
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell)
                                    (BinNums.Zpos BinNums.xH)
                                    (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                                    (scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                                 (lframe
                                    (fun (b : Values.block) (pos : BinNums.Z) =>
                                     not
                                       (foot
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z ba BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z)))
                                          (@List.map region
                                             (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool)
                                                (option BinNums.Z)) rshape scalar_initial_regs) b pos)) mr mf)))))))))
scalar_public_rest_eq
     : @eq Clight.statement scalar_public_rest
         (Clight.Ssequence scalar_public_read_stmt
            (Clight.Ssequence (Clight.Ssequence scalar_public_zero_stmt secp_public_bit_write_stmt)
               (Clight.Sreturn
                  (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)))))
canonical_scalar_zero_encoded
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Cell) (@encode (Ty.Sum Ty.Unit Ty.Unit) (@canonical_scalar_is_zero Alg.CoreFunSem value))
         (@cons (option bool) (@Some bool (Bit.toBool (@canonical_scalar_is_zero Alg.CoreFunSem value)))
            (@nil (option bool)))
scalar_locals_not_foot
     : forall (ba bl bi : Values.block) (edge : Integers.Ptrofs.int) (b : Values.block) (pos : BinNums.Z)
         (_ : not (@eq Values.block b ba)) (_ : not (@eq Values.block b bl)),
       not
         (foot
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                  (@nil (prod Values.block BinNums.Z))))
            (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
               (scalar_reader_initial_regs bi edge)) b pos)
exec_scalar_public_rest_canonical
     : forall (le : Maps.PTree.tree Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bw : Values.block) (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bl : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) (BinNums.Zpos BinNums.xH)
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt secp_ge (scalar_public_env bl ba) le m scalar_public_rest Events.E0
               (@Maps.PTree.set Values.val jets_secp._t'1
                  (Values.Vint (bit_int (Bit.toBool (@canonical_scalar_is_zero Alg.CoreFunSem value)))) le) mf
               (ClightBigstep.Out_return
                  (@Some (prod Values.val Ctypes.type)
                     (@pair Values.val Ctypes.type (Values.Vint Integers.Int.one) Ctypesdefs.tint))))
            (and
               (finv m0 bd dbase bw outedge cursor N bi mf true
                  (@encode (Ty.Sum Ty.Unit Ty.Unit) (@canonical_scalar_is_zero Alg.CoreFunSem value)))
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bl BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                        Memtype.Freeable) (lframe (secp_locals_outside m0 bd bw bi ba bl) m mf)))))
scalar_alloc_lframe
     : forall (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (bl ba : Values.block) (mb : Memory.Mem.mem')
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)), lframe P m mb
scalar_alloc_fresh
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bl ba : Values.block) (mb : Memory.Mem.mem')
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)),
       and (not (Memory.Mem.valid_block m bl)) (and (not (Memory.Mem.valid_block m ba)) (not (@eq Values.block ba bl)))
scalar_alloc_freeable
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bl ba : Values.block) (mb : Memory.Mem.mem')
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)),
       and
         (Memory.Mem.range_perm mb bl BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur Memtype.Freeable)
         (Memory.Mem.range_perm mb ba BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
scalar_alloc_source_fields
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (bl ba : Values.block) (mb : Memory.Mem.mem')
         (bs : Values.block) (base : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)) (_ : frame_fields_at m bs base bi edge rc),
       frame_fields_at mb bs base bi edge rc
scalar_prepare_public_locals
     : forall (le : Maps.PTree.tree Values.val) (m0 : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (bl ba : Values.block) (mb : Memory.Mem.mem') (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
         (bi : Values.block) (edge rc : BinNums.Z) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m0 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le (BinNums.Zpos BinNums.xH) N) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m0 bs sbase bi edge rc)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)))),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt secp_ge (scalar_public_env bl ba) le mb
               (Clight.Sassign (Clight.Evar jets_secp._src secp_frame_type)
                  (Clight.Etempvar jets_secp._src secp_frame_type)) Events.E0 le mc ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mc ba BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mc bl BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                     Memtype.Freeable)
                  (and (frame_fields_at mc bl BinNums.Z0 bi edge rc)
                     (and (not (@eq Values.block ba bl))
                        (and
                           (xsep (extA m0 bd bw bi)
                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                    (@nil (prod Values.block BinNums.Z)))))
                           (and
                              (invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell)
                                 (BinNums.Zpos BinNums.xH)
                                 (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                                 (@nil event) mc)
                              (and
                                 (lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b ba)) (not (@eq Values.block b bl))) m0 mc)
                                 (and (not (Memory.Mem.valid_block m0 ba)) (not (Memory.Mem.valid_block m0 bl)))))))))))
scalar_zero_public_body
     : @eq Clight.statement (Clight.fn_body jets_secp.f_simplicity_scalar_is_zero)
         (Clight.Ssequence
