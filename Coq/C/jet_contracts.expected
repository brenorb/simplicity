fun (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int) =>
forall (i : nat) (x : Integers.Int.int)
  (_ : @eq (option Integers.Int.int) (@List.nth_error Integers.Int.int xs i) (@Some Integers.Int.int x)),
@eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m b (BinInt.Z.add base (BinInt.Z.of_nat i)))
  (@Some Values.val (Values.Vint x))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int.int), Prop

Arguments uint8_array_at m b base%Z_scope xs%list_scope
vector_values =
fix vector_values (X : Ty.Ty) (n : nat) {struct n} : forall _ : Ty.tySem (Word.Vector X n), list (Ty.tySem X) :=
  match n as n0 return (forall _ : Ty.tySem (Word.Vector X n0), list (Ty.tySem X)) with
  | O => fun x : Ty.tySem (Word.Vector X O) => @cons (Ty.tySem (Word.Vector X O)) x (@nil (Ty.tySem (Word.Vector X O)))
  | S n0 =>
      fun x : Ty.tySem (Word.Vector X (S n0)) =>
      @app (Ty.tySem X)
        (vector_values X n0
           (@fst
              ((fix tySem (X0 : Ty.Ty) : Set :=
                  match X0 return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X0 : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                     match n1 return Ty.Ty with
                     | O => X0
                     | S n2 => Ty.Prod (Vector X0 n2) (Vector X0 n2)
                     end) X n0))
              ((fix tySem (X0 : Ty.Ty) : Set :=
                  match X0 return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X0 : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                     match n1 return Ty.Ty with
                     | O => X0
                     | S n2 => Ty.Prod (Vector X0 n2) (Vector X0 n2)
                     end) X n0)) x))
        (vector_values X n0
           (@snd
              ((fix tySem (X0 : Ty.Ty) : Set :=
                  match X0 return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X0 : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                     match n1 return Ty.Ty with
                     | O => X0
                     | S n2 => Ty.Prod (Vector X0 n2) (Vector X0 n2)
                     end) X n0))
              ((fix tySem (X0 : Ty.Ty) : Set :=
                  match X0 return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X0 : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                     match n1 return Ty.Ty with
                     | O => X0
                     | S n2 => Ty.Prod (Vector X0 n2) (Vector X0 n2)
                     end) X n0)) x))
  end
     : forall (X : Ty.Ty) (n : nat) (_ : Ty.tySem (Word.Vector X n)), list (Ty.tySem X)

Arguments vector_values X%ty_scope n%nat_scope _
byte_chunk = prod nat (option (list (Ty.tySem (Word.Word (S (S (S O)))))))
     : Set
byte_chunk_cells =
fun chunk : byte_chunk =>
match @snd nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) chunk return (list Cell) with
| Some xs =>
    @cons (option bool) (@Some bool true)
      (@List.concat Cell
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) (list Cell) (@encode (Word.Word (S (S (S O))))) xs))
| None =>
    @cons (option bool) (@Some bool false)
      (@List.repeat (option bool) (@None bool)
         (Nat.mul (S (S (S (S (S (S (S (S O))))))))
            (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) chunk)))
end
     : forall _ : byte_chunk, list Cell

Arguments byte_chunk_cells chunk
buffer_byte_chunks =
fix buffer_byte_chunks (depth : nat) :
    forall _ : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) depth), list byte_chunk :=
  match
    depth as depth0 return (forall _ : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) depth0), list byte_chunk)
  with
  | O =>
      fun x : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) O) =>
      @cons
        (prod nat
           (option
              (list
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                           match n return Ty.Ty with
                           | O => X
                           | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                           match n return Ty.Ty with
                           | O => X
                           | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))))))
        (@pair nat
           (option
              (list
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                           match n return Ty.Ty with
                           | O => X
                           | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                           match n return Ty.Ty with
                           | O => X
                           | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))))) (S O)
           match
             x
             return
               (option
                  (list
                     (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                        (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))))
           with
           | inl _ =>
               @None
                 (list
                    (prod
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end)
                          ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                              match n return Ty.Ty with
                              | O => X
                              | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                              end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end)
                          ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                              match n return Ty.Ty with
                              | O => X
                              | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                              end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))))
           | inr x0 =>
               @Some
                 (list
                    (prod
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end)
                          ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                              match n return Ty.Ty with
                              | O => X
                              | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                              end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end)
                          ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                              match n return Ty.Ty with
                              | O => X
                              | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                              end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))))
                 (@cons
                    (prod
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end)
                          ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                              match n return Ty.Ty with
                              | O => X
                              | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                              end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end)
                          ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                              match n return Ty.Ty with
                              | O => X
                              | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                              end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))) x0
                    (@nil
                       (prod
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end)
                             ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                                 match n return Ty.Ty with
                                 | O => X
                                 | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end)
                             ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                                 match n return Ty.Ty with
                                 | O => X
                                 | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                                 end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))))))
           end)
        (@nil
           (prod nat
              (option
                 (list
                    (prod
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end)
                          ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                              match n return Ty.Ty with
                              | O => X
                              | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                              end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end)
                          ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                              match n return Ty.Ty with
                              | O => X
                              | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                              end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))))))))
  | S d =>
      fun x : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S d)) =>
      @cons (prod nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))))
        (@pair nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) (PeanoNat.Nat.pow (S (S O)) (S d))
           match
             @fst
               (sum
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) Ty.Unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Vector (Word.Word (S (S (S O)))) (S d))))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix buffer_type (X : Ty.Ty) (depth0 : nat) {struct depth0} : Ty.Ty :=
                      match depth0 return Ty.Ty with
                      | O => Ty.Sum Ty.Unit X
                      | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d0))) (buffer_type X d0)
                      end) (Word.Word (S (S (S O)))) d)) x return (option (list (Ty.tySem (Word.Word (S (S (S O)))))))
           with
           | inl _ => @None (list (Ty.tySem (Word.Word (S (S (S O))))))
           | inr v =>
               @Some (list (Ty.tySem (Word.Word (S (S (S O)))))) (vector_values (Word.Word (S (S (S O)))) (S d) v)
           end)
        (buffer_byte_chunks d
           (@snd
              (sum
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) Ty.Unit)
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) (Word.Vector (Word.Word (S (S (S O)))) (S d))))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix buffer_type (X : Ty.Ty) (depth0 : nat) {struct depth0} : Ty.Ty :=
                     match depth0 return Ty.Ty with
                     | O => Ty.Sum Ty.Unit X
                     | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d0))) (buffer_type X d0)
                     end) (Word.Word (S (S (S O)))) d)) x))
  end
     : forall (depth : nat) (_ : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) depth)), list byte_chunk

Arguments buffer_byte_chunks depth%nat_scope _
buffer8_read_loop =
match Clight.fn_body f_simplicity_read_buffer8 return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ loop => loop
        | Clight.Sifthenelse _ _ _ => Clight.Sskip
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
buffer8_read_body =
match buffer8_read_loop return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop body _ => body
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
buffer8_read_update =
match buffer8_read_loop return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ update => update
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
buffer8_read_present =
match buffer8_read_body return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ s0 =>
    match s0 return Clight.statement with
    | Clight.Sskip => Clight.Sskip
    | Clight.Sassign _ _ => Clight.Sskip
    | Clight.Sset _ _ => Clight.Sskip
    | Clight.Scall _ _ _ => Clight.Sskip
    | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
    | Clight.Ssequence _ s2 =>
        match s2 return Clight.statement with
        | Clight.Sskip => Clight.Sskip
        | Clight.Sassign _ _ => Clight.Sskip
        | Clight.Sset _ _ => Clight.Sskip
        | Clight.Scall _ _ _ => Clight.Sskip
        | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
        | Clight.Ssequence _ _ => Clight.Sskip
        | Clight.Sifthenelse _ yes _ => yes
        | Clight.Sloop _ _ => Clight.Sskip
        | Clight.Sbreak => Clight.Sskip
        | Clight.Scontinue => Clight.Sskip
        | Clight.Sreturn _ => Clight.Sskip
        | Clight.Sswitch _ _ => Clight.Sskip
        | Clight.Slabel _ _ => Clight.Sskip
        | Clight.Sgoto _ => Clight.Sskip
        end
    | Clight.Sifthenelse _ _ _ => Clight.Sskip
    | Clight.Sloop _ _ => Clight.Sskip
    | Clight.Sbreak => Clight.Sskip
    | Clight.Scontinue => Clight.Sskip
    | Clight.Sreturn _ => Clight.Sskip
    | Clight.Sswitch _ _ => Clight.Sskip
    | Clight.Slabel _ _ => Clight.Sskip
    | Clight.Sgoto _ => Clight.Sskip
    end
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
buffer8_read_absent =
Clight.Scall (@None AST.ident)
  (Clight.Evar _forwardBits
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar _src (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr)))
     (@cons Clight.expr buffer8_skip_expr (@nil Clight.expr)))
     : Clight.statement
buffer8_read_tag =
Clight.Scall (@Some AST.ident _t'2)
  (Clight.Evar _readBit
     (Ctypes.Tfunction (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr)) Ctypes.Tnil)
        Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar _src (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr)))
     (@nil Clight.expr))
     : Clight.statement
buffer8_read_present_temps =
fun (le : Maps.PTree.tree Values.val) (bo : Values.block) (output count : BinNums.Z) =>
@Maps.PTree.set Values.val _t'3 (Values.Vlong (Integers.Int64.repr count))
  (@Maps.PTree.set Values.val _buf (Values.Vptr bo (Integers.Ptrofs.repr output)) le)
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z),
       Maps.PTree.tree Values.val

Arguments buffer8_read_present_temps le bo (output count)%Z_scope
buffer8_read_assert =
match Clight.fn_body f_simplicity_read_buffer8 return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence s _ => s
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
