scalar_set_limb =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) (i : nat) =>
il
  (den rho layout
     (scalar_set_instantiate
        (@List.nth sx i
           (@cons sx scalar_reduce_low0
              (@cons sx scalar_reduce_low1 (@cons sx scalar_reduce_low2 (@cons sx scalar_reduce_low3 (@nil sx)))))
           (XLc Integers.Int64.zero))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : nat),
       Integers.Int64.int

Arguments scalar_set_limb (rho layout)%function_scope i%nat_scope
scalar_set_raw_integer =
fun rho : forall _ : nat, BinNums.Z =>
BinInt.Z.add
  (BinInt.Z.add
     (BinInt.Z.add (zval rho (scalar_set_raw_sigma O))
        (BinInt.Z.mul
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
           (zval rho (scalar_set_raw_sigma (S O)))))
     (BinInt.Z.mul
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        (zval rho (scalar_set_raw_sigma (S (S O))))))
  (BinInt.Z.mul
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))
     (zval rho (scalar_set_raw_sigma (S (S (S O))))))
     : forall _ : forall _ : nat, BinNums.Z, BinNums.Z

Arguments scalar_set_raw_integer rho%function_scope
scalar_reader_limb =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) (i : nat) =>
il
  (den rho layout
     (sx_subst scalar_reader_byte_shift
        (@List.nth sx i
           (@cons sx (scalar_set_instantiate scalar_reduce_low0)
              (@cons sx (scalar_set_instantiate scalar_reduce_low1)
                 (@cons sx (scalar_set_instantiate scalar_reduce_low2)
                    (@cons sx (scalar_set_instantiate scalar_reduce_low3) (@nil sx))))) (XLc Integers.Int64.zero))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : nat),
       Integers.Int64.int

