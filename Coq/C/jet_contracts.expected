       ClightBigstep.Clight2.exec_stmt ge0 e le m (divmod96_work suffix) Events.E0 lef mf out
divmod96_initial_values
     : forall (ah al b : Integers.Int64.int)
         (_ : BinInt.Z.le Integers.Int64.modulus
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned b)))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned ah) (Integers.Int64.unsigned b))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned al) divmod96_radix),
       let q : Integers.Int64.int := divmod96_clamp ah (divmod96_high b) in
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (divmod96_initial_rh ah b))
            (BinInt.Z.sub (Integers.Int64.unsigned ah)
               (BinInt.Z.mul (Integers.Int64.unsigned q) (Integers.Int64.unsigned (divmod96_high b)))))
         (@eq BinNums.Z (Integers.Int64.unsigned (divmod96_initial_d ah b))
            (BinInt.Z.mul (Integers.Int64.unsigned q) (Integers.Int64.unsigned (divmod96_low b))))
divmod96_initial_invariant
