bitcoin_tappath_env_rep_nullable =
fun (m : Memory.Mem.mem) (env : Values.val) (e : ext_environment)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            @ex Values.block
              (fun bp : Values.block =>
               @ex BinNums.Z
                 (fun pbase : BinNums.Z =>
                  and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                    (and (BinInt.Z.le BinNums.Z0 ebase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add ebase
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                             Integers.Ptrofs.max_unsigned)
                          (and (BinInt.Z.le BinNums.Z0 tbase)
                             (and
                                (BinInt.Z.le
                                   (BinInt.Z.add tbase
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI ...))))))))
                                   Integers.Ptrofs.max_unsigned)
                                (and (BinInt.Z.le BinNums.Z0 pbase)
                                   (and
                                      (BinInt.Z.le
                                         (BinInt.Z.add pbase
                                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))
                                               (BinInt.Z.of_nat (@length Digest.hash256 (extTappath e)))))
                                         Integers.Ptrofs.max_unsigned)
                                      (and
                                         (@eq (option Values.val)
                                            (Memory.Mem.load AST.Mptr m be
                                               (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))))
                                            (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                                         (and
                                            (forall
                                               _ : BinInt.Z.lt BinNums.Z0
                                                     (BinInt.Z.of_nat (@length Digest.hash256 (...))),
                                             @eq (option Values.val)
                                               (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add tbase BinNums.Z0))
                                               (@Some Values.val (Values.Vptr bp (Integers.Ptrofs.repr pbase))))
                                            (and
                                               (@eq (option Values.val)
                                                  (Memory.Mem.load AST.Mint8unsigned m bt
                                                     (BinInt.Z.add tbase (BinNums.Zpos ...)))
                                                  (@Some Values.val (Values.Vint (Integers.Int.repr ...))))
                                               (and
                                                  (forall (j : nat) (h : Digest.hash256) (_ : @eq (...) (...) (...)),
                                                   hash_elem_rep m bp (BinInt.Z.add pbase (...)) h)
                                                  (@eq (list (prod ... BinNums.Z)) fp
                                                     (@cons (prod ... BinNums.Z) (@pair ... BinNums.Z ... ...)
                                                        (@cons ... ... ...)))))))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : ext_environment)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments bitcoin_tappath_env_rep_nullable m env e fp%list_scope
jet_elements_prim.Elements.sem =
let cast : forall (A : Ty.Ty) (_ : option (Ty.tySem A)), Ty.tySem (Ty.Sum Ty.Unit A) :=
  fun (A : Ty.Ty) (x : option (Ty.tySem A)) =>
  match x return (Ty.tySem (Ty.Sum Ty.Unit A)) with
  | Some a => @inr unit (Ty.tySem A) a
  | None =>
      @inl unit
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A0 B => sum (tySem A0) (tySem B)
            | Ty.Prod A0 B => prod (tySem A0) (tySem B)
            end) A) tt
  end in
let toBit : forall _ : bool, Ty.tySem (Ty.Sum Ty.Unit Ty.Unit) :=
  fun b : bool =>
  match b return (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) with
  | true => @inr unit unit tt
  | false => @inl unit unit tt
  end in
let encodeHash : forall _ : Digest.hash256, Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) :=
  fun h : Digest.hash256 => Word.from_hash256 h in
let encodeConfidential :
  forall (A : Set) (B : Ty.Ty) (_ : forall _ : A, Ty.tySem B) (_ : jet_elements_prim.confidential unit A),
  Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B) :=
  fun (A : Set) (B : Ty.Ty) (enc : forall _ : A, Ty.tySem B) (c : jet_elements_prim.confidential unit A) =>
  match
    c return (Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B))
  with
  | jet_elements_prim.Explicit a =>
      @inr
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end) (Ty.Sum Ty.Unit Ty.Unit))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (Ty.tySem B) (enc a)
  | jet_elements_prim.Confidential pt _ =>
      match
        pt
        return (Ty.tySem (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) B))
      with
      | jet_elements_prim.Point odd x =>
          @inl (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                end) B)
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (toBit odd) (Word.from_hash256 x))
      end
  end in
let encodeAsset :
  forall _ : jet_elements_prim.assetWith unit,
  Ty.tySem
    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
       (Word.Word (S (S (S (S (S (S (S (S O)))))))))) :=
  fun a : jet_elements_prim.assetWith unit =>
  encodeConfidential Digest.hash256 (Word.Word (S (S (S (S (S (S (S (S O))))))))) encodeHash a in
let encodeAmount :
  forall _ : jet_elements_prim.amountWith unit,
  Ty.tySem
    (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
       (Word.Word (S (S (S (S (S (S O)))))))) :=
  fun a : jet_elements_prim.amountWith unit =>
  encodeConfidential Integers.Int64.int (Word.Word (S (S (S (S (S (S O)))))))
    (fun v : Integers.Int64.int =>
     @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.unsigned v)
     :
     Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) a in
let encodeNonce :
  forall _ : option jet_elements_prim.nonce,
  Ty.tySem
    (Ty.Sum Ty.Unit
       (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
          (Word.Word (S (S (S (S (S (S (S (S O))))))))))) :=
  fun n : option jet_elements_prim.nonce =>
  cast
