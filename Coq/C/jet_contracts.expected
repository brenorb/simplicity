zbyte_region_load
     : forall (rho : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (layout : layout)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (rho n)))
                (BinInt.Z.le (Integers.Int64.unsigned (rho n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (m : Memory.Mem.mem) (r : nat) (writable : bool) (cells : list cell) (offset : BinNums.Z)
         (_ : @eq bool (zbyte_reg_okb bnd offset cells) true)
         (_ : @List.Forall cell (cell_ok rho layout m r writable) cells) (i : nat) (z : BinNums.Z)
         (_ : @eq (option BinNums.Z) (@List.nth_error BinNums.Z (zcells (zrho rho) cells) i) (@Some BinNums.Z z)),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint8unsigned m (blk layout r)
            (BinInt.Z.add (bas layout r) (BinInt.Z.add offset (BinInt.Z.of_nat i))))
         (@Some Values.val (Values.Vint (Integers.Int.repr z)))
