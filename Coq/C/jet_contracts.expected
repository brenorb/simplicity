                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                         dA))
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                (BinInt.Z.sub
                   (BinInt.Z.add
                      (BinInt.Z.mul
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                         k1)
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) ss))
         (_ : forall (q : BinNums.Z)
                (_ : and
                       (BinInt.Z.le
                          (BinInt.Z.sub
                             (BinInt.Z.add
                                (BinInt.Z.mul
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                   k1)
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) ss)
                          q)
                       (BinInt.Z.lt q
                          (BinInt.Z.add
                             (BinInt.Z.sub
                                (BinInt.Z.add
                                   (BinInt.Z.mul
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                      k1)
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                ss) n1))),
              and
                (and
                   (BinInt.Z.le
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                            (BinInt.Z.div q
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                      edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned))
                (@ex Integers.Int64.int
                   (fun S : Integers.Int64.int =>
                    and
                      (@eq (option Values.val)
                         (Memory.Mem.load AST.Mint64 m0 bi
                            (BinInt.Z.sub edge
                               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                  (BinInt.Z.add (BinNums.Zpos BinNums.xH)
