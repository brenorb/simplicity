complement_spec_numeric
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ n) (@complement_spec n Alg.CoreFunSem x))
         (BinInt.Z.sub (BinInt.Z.sub (word_modulus n) (BinNums.Zpos BinNums.xH))
            (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
borrow_word_balance_injective
     : forall (n : nat) (a b : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)))
         (_ : @eq BinNums.Z (borrow_word_balance n a) (borrow_word_balance n b)),
       @eq (Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))) a b
full_subtract_word_spec_numeric
     : forall (n : nat) (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (x y : Ty.tySem (Word.Word n)),
       @eq BinNums.Z
         (borrow_word_balance n
            (@full_subtract_word_spec Alg.CoreFunSem n
               (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) c
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y))))
         (BinInt.Z.sub
            (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
            (@Word.ToZ.Theory.toZ Word.BitToZ c))
subtract_word_spec_numeric
     : forall (n : nat) (x y : Ty.tySem (Word.Word n)),
       @eq BinNums.Z
         (borrow_word_balance n
            (@subtract_word_spec Alg.CoreFunSem n (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)))
         (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
subtract_representation_matches
     : forall (n : nat) (x y payload : Ty.tySem (Word.Word n))
         (_ : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ n) payload)
                (BinInt.Z.modulo
                   (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
                   (word_modulus n))),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word n)))
         (@pair (sum unit unit) (Ty.tySem (Word.Word n))
            match
              BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y)
              return (sum unit unit)
            with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end payload)
         (@subtract_word_spec Alg.CoreFunSem n (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y))
subtract8_values_denote_spec
     : forall left right : Integers.Int64.int,
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S O))))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S O)))))
            match
              subtract8_borrow (jet_read8.read8_result left) (jet_read8.read8_result right) return (sum unit unit)
            with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (decode_word8
               (Integers.Int64.repr
                  (Integers.Int.unsigned
                     (subtract8_payload (jet_read8.read8_result left) (jet_read8.read8_result right))))))
         (@subtract_word_spec Alg.CoreFunSem (S (S (S O)))
            (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))
               (decode_word8 left) (decode_word8 right)))
wide_subtract_values_denote_input
     : forall (s : wide_size) (x y : Ty.tySem (Word.Word (wide_log s))) (r t : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) y)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (wide_log s))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (wide_log s)))
            match wide_subtract_borrow r t return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end (decode_wide s (Integers.Int64.zero_ext (wide_bits s) (wide_subtract_payload r t))))
         (@subtract_word_spec Alg.CoreFunSem (wide_log s)
