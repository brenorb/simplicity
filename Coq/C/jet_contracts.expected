     : forall (i : nat) (x : sx)
         (_ : @eq (option sx)
                (@List.nth_error sx
                   (@cons sx (XLv O)
                      (@cons sx (XLv (S O)) (@cons sx (XLv (S (S O))) (@cons sx (XLv (S (S (S O)))) (@nil sx))))) i)
