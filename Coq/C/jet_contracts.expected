         (@ex Memory.Mem.mem
            (fun mi : Memory.Mem.mem =>
             and (write_wide_sequence_run s bf base xs m mi) (write_wide_sequence_run s bf base ys mi mf)))
extend_wide_fill_from_sequence
     : forall (s : extend_wide_size) (bf : Values.block) (base : BinNums.Z) (bit : bool) (n : nat)
