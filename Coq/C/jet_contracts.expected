         (fun a : Ty.tySem Ty.Unit => @wide_one_spec W32 Alg.CoreFunSem a)
one64_local_spec
     : jet_local_spec f_simplicity_one_64 Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))
         (fun a : Ty.tySem Ty.Unit => @wide_one_spec W64 Alg.CoreFunSem a)
increment8_local_spec
     : jet_local_spec f_simplicity_increment_8 (Word.Word (S (S (S O))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
         (fun a : Ty.tySem (Word.Word (S (S (S O)))) => @increment8_spec Alg.CoreFunSem a)
increment16_local_spec
     : jet_local_spec f_simplicity_increment_16 (Word.Word (S (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S O))))))
         (fun a : Ty.tySem (Word.Word (S (S (S (S O))))) => @increment16_spec Alg.CoreFunSem a)
increment32_local_spec
     : jet_local_spec f_simplicity_increment_32 (Word.Word (S (S (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
         (fun a : Ty.tySem (Word.Word (S (S (S (S (S O)))))) => @increment32_spec Alg.CoreFunSem a)
increment64_local_spec
     : jet_local_spec f_simplicity_increment_64 (Word.Word (S (S (S (S (S (S O)))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))
         (fun a : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))) => @increment64_spec Alg.CoreFunSem a)
add8_local_spec
     : jet_local_spec f_simplicity_add_8 (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
         (fun a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) => @add8_spec Alg.CoreFunSem a)
add16_local_spec
     : jet_local_spec f_simplicity_add_16 (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S O))))))
         (fun a : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))) =>
          @add16_spec Alg.CoreFunSem a)
add32_local_spec
     : jet_local_spec f_simplicity_add_32 (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
         (fun a : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) =>
          @add32_spec Alg.CoreFunSem a)
add64_local_spec
     : jet_local_spec f_simplicity_add_64
         (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))
         (fun a : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))) =>
          @add64_spec Alg.CoreFunSem a)
one8_context
     : @jet_context_for f_simplicity_one_8 Ty.Unit (Word.Word (S (S (S O)))) (@one8_spec)
one16_context
     : @jet_context_for f_simplicity_one_16 Ty.Unit (Word.Word (wide_log W16)) (@wide_one_spec W16)
one32_context
     : @jet_context_for f_simplicity_one_32 Ty.Unit (Word.Word (wide_log W32)) (@wide_one_spec W32)
one64_context
     : @jet_context_for f_simplicity_one_64 Ty.Unit (Word.Word (wide_log W64)) (@wide_one_spec W64)
