| jet_elements_prim.Elements.InputScriptHash =>
    atInput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       encodeHash (Digest.byteStringHash (jet_elements_prim.utxoScript (jet_elements_prim.sigTxiTxo txi))))
| jet_elements_prim.Elements.InputSequence =>
    atInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
         (Integers.Int.unsigned (jet_elements_prim.sigTxiSequence txi)))
| jet_elements_prim.Elements.InputAnnexHash =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map (list Integers.Byte.int) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun x : list Integers.Byte.int => encodeHash (Digest.byteStringHash x))
            (jet_elements_prim.sigTxiAnnex txi)))
| jet_elements_prim.Elements.InputScriptSigHash =>
    atInput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       encodeHash (Digest.byteStringHash (jet_elements_prim.sigTxiScriptSig txi)))
| jet_elements_prim.Elements.ReissuanceBlinding =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            match jet_elements_prim.sigTxiIssuance txi return (option Digest.hash256) with
            | Some i =>
                match i return (option Digest.hash256) with
                | inl _ => @None Digest.hash256
                | inr re => @Some Digest.hash256 (jet_elements_prim.reissuanceBlindingNonce re)
                end
            | None => @None Digest.hash256
            end))
| jet_elements_prim.Elements.NewIssuanceContract =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            match jet_elements_prim.sigTxiIssuance txi return (option Digest.hash256) with
            | Some i =>
                match i return (option Digest.hash256) with
                | inl new => @Some Digest.hash256 (jet_elements_prim.newIssuanceContractHash new)
                | inr _ => @None Digest.hash256
                end
            | None => @None Digest.hash256
            end))
| jet_elements_prim.Elements.ReissuanceEntropy =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            match jet_elements_prim.sigTxiIssuance txi return (option Digest.hash256) with
            | Some i =>
                match i return (option Digest.hash256) with
                | inl _ => @None Digest.hash256
                | inr re => @Some Digest.hash256 (jet_elements_prim.reissuanceEntropy re)
                end
            | None => @None Digest.hash256
            end))
| jet_elements_prim.Elements.IssuanceAssetAmount =>
    atInput
      (Ty.Sum Ty.Unit
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O)))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       cast
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O))))))))
         (@option_map jet_elements_prim.issuance
            (Ty.tySem
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S ...))))))))
                  (Word.Word (S (S (S (S (S (S O)))))))))
            (fun i : jet_elements_prim.issuance =>
             encodeAmount (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (issuanceAmount i)))
            (jet_elements_prim.sigTxiIssuance txi)))
| jet_elements_prim.Elements.IssuanceTokenAmount =>
    atInput
      (Ty.Sum Ty.Unit
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O)))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       cast
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O))))))))
         (@option_map jet_elements_prim.issuance
            (Ty.tySem
               (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S ...))))))))
                  (Word.Word (S (S (S (S (S (S O)))))))))
            (fun i : jet_elements_prim.issuance =>
             encodeAmount
               (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (issuanceTokenAmount i)))
            (jet_elements_prim.sigTxiIssuance txi)))
| jet_elements_prim.Elements.IssuanceAssetProof =>
    atInput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txi : jet_elements_prim.sigTxInput => encodeHash (Digest.byteStringHash (issuanceProof issuanceAmount txi)))
| jet_elements_prim.Elements.IssuanceTokenProof =>
    atInput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       encodeHash (Digest.byteStringHash (issuanceProof issuanceTokenAmount txi)))
| jet_elements_prim.Elements.CurrentIndex =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (BinInt.Z.of_nat ix))
| jet_elements_prim.Elements.TapleafVersion =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S O))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O))))
         (Integers.Byte.unsigned (jet_elements_prim.tapleafVersion (jet_elements_prim.Elements.envTap e))))
| jet_elements_prim.Elements.Tappath =>
    fun i : Ty.tySem (Word.Word (S (S (S O)))) =>
    @Some (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            (@List.nth_error Digest.hash256 (jet_elements_prim.tappath (jet_elements_prim.Elements.envTap e))
               (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) i)))))
| jet_elements_prim.Elements.InternalKey =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (Word.from_hash256 (jet_elements_prim.tapInternalKey (jet_elements_prim.Elements.envTap e)))
| jet_elements_prim.Elements.OutputAsset =>
    atOutput
      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txo : jet_elements_prim.txOutput =>
       encodeAsset
         (@jet_elements_prim.clearPrf (list Integers.Byte.int) Digest.hash256 (jet_elements_prim.txoAsset txo)))
| jet_elements_prim.Elements.OutputAmount =>
    atOutput
      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S O))))))))
      (fun txo : jet_elements_prim.txOutput =>
       encodeAmount
         (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int (jet_elements_prim.txoAmount txo)))
| jet_elements_prim.Elements.OutputNonce =>
    atOutput
      (Ty.Sum Ty.Unit
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (fun txo : jet_elements_prim.txOutput => encodeNonce (jet_elements_prim.txoNonce txo))
| jet_elements_prim.Elements.OutputScriptHash =>
    atOutput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txo : jet_elements_prim.txOutput => encodeHash (Digest.byteStringHash (jet_elements_prim.txoScript txo)))
| jet_elements_prim.Elements.OutputNullDatum =>
    fun ij : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) =>
    let i : Ty.tySem (Word.Word (S (S (S (S (S O)))))) :=
      @fst
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O)))))))
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))) ij in
    let j : Ty.tySem (Word.Word (S (S (S (S (S O)))))) :=
      @snd
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O)))))))
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
               | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))) ij in
    @Some
      (Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Sum Ty.Unit
               (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S ...)))))))
                  (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))))
      (cast
         (Ty.Sum Ty.Unit
            (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S ...))))))))
               (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))
         match
           @List.nth_error jet_elements_prim.txOutput (jet_elements_prim.sigTxOut tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (...)))))) i))
           return
             (option
                (Ty.tySem
                   (Ty.Sum Ty.Unit
                      (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S ...))))
                         (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))))
         with
         | Some txo =>
             match
               jet_elements_prim.txNullData (jet_elements_prim.txoScript txo)
               return
                 (option
                    (Ty.tySem
                       (Ty.Sum Ty.Unit
                          (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S ...)))
                             (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S ...)))))))
             with
             | Some nullData =>
                 @Some
                   (Ty.tySem
                      (Ty.Sum Ty.Unit
                         (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (...)))))
                            (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))
                   (cast
                      (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (...))))))
                         (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))
                      (@option_map (jet_elements_prim.txNullDatumF (list Integers.Byte.int))
                         (Ty.tySem
                            (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (...))))
                               (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (...))))))
                         (fun d : jet_elements_prim.txNullDatumF (list Integers.Byte.int) =>
                          encodeNullDatum
                            (@jet_elements_prim.mapNullDatum (list Integers.Byte.int) Digest.hash256
                               Digest.byteStringHash d))
                         (@List.nth_error (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) nullData
                            (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (...))) j)))))
             | None =>
                 @None
                   (Ty.tySem
                      (Ty.Sum Ty.Unit
                         (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (...)))))
                            (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))
             end
         | None =>
             @None
               (Ty.tySem
                  (Ty.Sum Ty.Unit
                     (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (...))))))
                        (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O)))))))
         end)
| jet_elements_prim.Elements.OutputSurjectionProof =>
    atOutput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txo : jet_elements_prim.txOutput =>
       encodeHash (Digest.byteStringHash (@jet_elements_prim.viewPrf Digest.hash256 (jet_elements_prim.txoAsset txo))))
| jet_elements_prim.Elements.OutputRangeProof =>
    atOutput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txo : jet_elements_prim.txOutput =>
       encodeHash
         (Digest.byteStringHash (@jet_elements_prim.viewPrf Integers.Int64.int (jet_elements_prim.txoAmount txo))))
| jet_elements_prim.Elements.GenesisBlockHash =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (encodeHash (jet_elements_prim.Elements.envGenesisBlock e))
| jet_elements_prim.Elements.ScriptCMR =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (encodeHash (jet_elements_prim.tapScriptCMR (jet_elements_prim.Elements.envTap e)))
| jet_elements_prim.Elements.TransactionId =>
    fun _ : Ty.tySem Ty.Unit =>
