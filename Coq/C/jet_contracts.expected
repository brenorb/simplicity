       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a)
              (fullWriteFrame (@encode (Word.Word (S (S (S O)))) (@binary_word_spec (S (S (S O))) k Alg.CoreFunSem a))))
         in
