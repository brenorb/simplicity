               (ClightBigstep.Clight2.eval_funcall ge0 m
                  (@Ctypes.Internal Clight.function f_simplicity_read_sha256_context)
                  (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase))
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
                  (Values.Vint (bit_int (negb (sha256_read_overflow r)))))
               (and
                  (@eq BinNums.Z (Integers.Int64.unsigned r)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count))
                  (and
                     (@eq (option Values.val) (Memory.Mem.load AST.Mptr mf bc cbase)
                        (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))))
                     (and
                        (uint8_array_at mf bc
                           (BinInt.Z.add cbase
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value
                              (byte_chunks_values (buffer_byte_chunks (S (S (S (S (S O))))) buf))))
                        (and
                           (uint32_array_at mf bo output
                              (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int
                                 word32_array_value (word32_chunks (S (S (S O))) state)))
                           (and
                              (@eq (option Values.val)
                                 (Memory.Mem.load AST.Mint64 mf bc
                                    (BinInt.Z.add cbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (@Some Values.val
                                    (Values.Vlong
                                       (sha256_read_counter r
                                          (Integers.Int64.repr
                                             (BinInt.Z.of_nat
                                                (@length (Ty.tySem (Word.Word (S (S (S O)))))
                                                   (byte_chunks_values (buffer_byte_chunks (S (S (S (S (S O))))) buf)))))))))
                              (and
                                 (@eq (option Values.val)
                                    (Memory.Mem.load AST.Mint8unsigned mf bc
                                       (BinInt.Z.add cbase
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                                    (@Some Values.val (Values.Vint (bit_int (sha256_read_overflow r)))))
                                 (and
                                    (frame_fields_at mf bf base bi edge
                                       (BinInt.Z.add cursor
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                                    (and
                                       (@eq (option Values.val)
                                          (Memory.Mem.load AST.Mint64 mf (jet_symbol_block _sha256_max_counter)
                                             BinNums.Z0)
                                          (@Some Values.val
                                             (Values.Vlong
                                                (Integers.Int64.repr
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))
                                       (and
                                          (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                             (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                           Memory.Mem.perm mf b ofs kind p)
                                          (forall (chunk : AST.memory_chunk) (b : Values.block)
                                             (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                                             (_ : or (not (@eq Values.block b bf))
                                                    (or
                                                       (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                          (BinInt.Z.add base
                                                             (BinNums.Zpos
                                                                (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                       (BinInt.Z.le
                                                          (BinInt.Z.add base
                                                             (BinNums.Zpos
                                                                (BinNums.xO
                                                                   (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                          ofs)))
                                             (_ : or (not (@eq Values.block b bc))
                                                    (or
                                                       (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                          (BinInt.Z.add cbase
                                                             (BinNums.Zpos
                                                                (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                                       (BinInt.Z.le
                                                          (BinInt.Z.add cbase
                                                             (BinNums.Zpos
                                                                (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                                          ofs)))
                                             (_ : or (not (@eq Values.block b bo))
                                                    (or
                                                       (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                          output)
                                                       (BinInt.Z.le
                                                          (BinInt.Z.add output
                                                             (BinNums.Zpos
                                                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                                          ofs))),
                                           @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                             (Memory.Mem.load chunk m b ofs)))))))))))))
