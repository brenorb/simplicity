       @eq BinNums.Z (BinInt.Z.add (BinInt.Z.modulo a k) (BinInt.Z.mul (BinInt.Z.add b (BinInt.Z.div a k)) k))
         (BinInt.Z.add a (BinInt.Z.mul b k))
nv_pass_spec
     : forall (t0 t1 t2 t3 t4 : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 t0) (_ : BinInt.Z.le BinNums.Z0 t1)
         (_ : BinInt.Z.le BinNums.Z0 t2) (_ : BinInt.Z.le BinNums.Z0 t3) (_ : BinInt.Z.le BinNums.Z0 t4),
       match nv_pass t0 t1 t2 t3 t4 return Prop with
       | pair p r4 =>
           match p return Prop with
           | pair p0 r3 =>
               match p0 return Prop with
               | pair p1 r2 =>
                   match p1 return Prop with
