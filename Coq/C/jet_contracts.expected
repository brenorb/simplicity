              (fullWriteFrame
                 (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
                    (@subtract_word_spec Alg.CoreFunSem (S (S (S O))) a)))) in
