         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _x le)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _n le)
                (@Some Values.val
                   (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int64.int xs))))))
         (_ : read32s_run bi input bf base xs m mf),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          ClightBigstep.Clight2.exec_stmt ge0 Clight.empty_env le m (Clight.fn_body f_read32s) Events.E0 lef mf
            ClightBigstep.Out_normal)
read32s_entry
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bi : Values.block) (input count : BinNums.Z),
       Clight.function_entry2 ge0 f_read32s
         (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
            (@cons Values.val (Values.Vlong (Integers.Int64.repr count))
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) m Clight.empty_env
         (read32s_env bf base bi input count) m
eval_read32s_from_run
     : forall (m mf : Memory.Mem.mem) (bi : Values.block) (input : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (xs : list Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le
                (BinInt.Z.add input
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.of_nat (@length Integers.Int64.int xs)))) Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le (BinInt.Z.of_nat (@length Integers.Int64.int xs)) Integers.Int64.max_unsigned)
         (_ : read32s_run bi input bf base xs m mf),
       ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_read32s)
         (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
            (@cons Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int64.int xs))))
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) Events.E0 mf
         Values.Vundef
word32_carrier_loword
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
       @eq Integers.Int.int (Integers.Int64.loword (word32_carrier x)) (word32_array_value x)
read32s_run_layout
     : forall (m : Memory.Mem.mem) (bo : Values.block) (output : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le
                (BinInt.Z.add output
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) output)
         (_ : Memory.Mem.range_perm m bo output
                (BinInt.Z.add output
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs)))) Memtype.Cur
                Memtype.Writable) (_ : not (@eq Values.block bf bo)) (_ : not (@eq Values.block bf bi))
         (_ : not (@eq Values.block bo bi)) (_ : frame_base_valid base) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinInt.Z.mul
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs))))
                Integers.Int64.max_unsigned) (_ : frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : forall (i : nat) (x : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
                (_ : @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                       (@List.nth_error (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs i)
                       (@Some (Ty.tySem (Word.Word (S (S (S (S (S O))))))) x)),
              @frame_input_word_at (S (S (S (S (S O))))) m bi edge
                (BinInt.Z.add cursor
                   (BinInt.Z.mul
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.of_nat i))) x),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (read32s_run bo output bf base
               (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int64.int word32_carrier xs) m mf)
            (and
               (uint32_array_at mf bo output
                  (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value xs))
               (and
                  (frame_fields_at mf bf base bi edge
                     (BinInt.Z.add cursor
                        (BinInt.Z.mul
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs)))))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bo))
                               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) output)
                                  (BinInt.Z.le
                                     (BinInt.Z.add output
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs))))
                                     ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
eval_read32s_layout
     : forall (m : Memory.Mem.mem) (bo : Values.block) (output : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le
                (BinInt.Z.add output
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) output)
         (_ : Memory.Mem.range_perm m bo output
                (BinInt.Z.add output
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs)))) Memtype.Cur
                Memtype.Writable) (_ : not (@eq Values.block bf bo)) (_ : not (@eq Values.block bf bi))
         (_ : not (@eq Values.block bo bi)) (_ : frame_base_valid base) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinInt.Z.mul
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs))))
                Integers.Int64.max_unsigned) (_ : frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : forall (i : nat) (x : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
                (_ : @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                       (@List.nth_error (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs i)
                       (@Some (Ty.tySem (Word.Word (S (S (S (S (S O))))))) x)),
              @frame_input_word_at (S (S (S (S (S O))))) m bi edge
                (BinInt.Z.add cursor
                   (BinInt.Z.mul
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.of_nat i))) x),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_read32s)
               (@cons Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))
                  (@cons Values.val
                     (Values.Vlong
                        (Integers.Int64.repr
                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs))))
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (uint32_array_at mf bo output
                  (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value xs))
               (and
                  (frame_fields_at mf bf base bi edge
                     (BinInt.Z.add cursor
                        (BinInt.Z.mul
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs)))))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bo))
                               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) output)
                                  (BinInt.Z.le
                                     (BinInt.Z.add output
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs))))
                                     ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
word32_chunks_length
     : forall (n : nat) (x : Ty.tySem (Word.Word (Nat.add n (S (S (S (S (S O)))))))),
       @eq nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (word32_chunks n x))
         (PeanoNat.Nat.pow (S (S O)) n)
word32_chunks_encode
     : forall (n : nat) (x : Ty.tySem (Word.Word (Nat.add n (S (S (S (S (S O)))))))),
       @eq (list Cell) (@encode (Word.Word (Nat.add n (S (S (S (S (S O))))))) x)
         (@List.concat Cell
            (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (list Cell)
               (@encode (Word.Word (S (S (S (S (S O))))))) (word32_chunks n x)))
word32_chunks_injective
     : forall (n : nat) (x y : Ty.tySem (Word.Word (Nat.add n (S (S (S (S (S O))))))))
         (_ : @eq (list (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) (word32_chunks n x) (word32_chunks n y)),
       @eq (Ty.tySem (Word.Word (Nat.add n (S (S (S (S (S O)))))))) x y
frame_input_word32_sequence
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (_ : frame_input_cells_at m bi edge cursor
                (@List.concat Cell
                   (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (list Cell)
                      (@encode (Word.Word (S (S (S (S (S O))))))) xs))) (i : nat)
         (x : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (_ : @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                (@List.nth_error (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs i)
                (@Some (Ty.tySem (Word.Word (S (S (S (S (S O))))))) x)),
       @frame_input_word_at (S (S (S (S (S O))))) m bi edge
         (BinInt.Z.add cursor
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (BinInt.Z.of_nat i))) x
frame_input_word32_chunks
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge cursor : BinNums.Z) (n : nat)
         (x : Ty.tySem (Word.Word (Nat.add n (S (S (S (S (S O))))))))
         (_ : frame_input_cells_at m bi edge cursor (@encode (Word.Word (Nat.add n (S (S (S (S (S O))))))) x))
         (i : nat) (y : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (_ : @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                (@List.nth_error (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (word32_chunks n x) i)
                (@Some (Ty.tySem (Word.Word (S (S (S (S (S O))))))) y)),
       @frame_input_word_at (S (S (S (S (S O))))) m bi edge
         (BinInt.Z.add cursor
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (BinInt.Z.of_nat i))) y
word32_array_value_injective
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (_ : @eq Integers.Int.int (word32_array_value x) (word32_array_value y)),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S O))))))) x y
eq256_words_equal_true
     : forall xs ys : list Integers.Int.int,
       iff (@eq bool (eq256_words_equal xs ys) true) (@eq (list Integers.Int.int) xs ys)
eq256_array_map_injective
     : forall (xs ys : list (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (_ : @eq (list Integers.Int.int)
                (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value xs)
                (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value ys)),
       @eq (list (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) xs ys
eq256_array_denotes
     : forall x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool (eq256_array_result x y)
         (Bit.toBool
            (@equality_spec (Word.Word (S (S (S (S (S (S (S (S O))))))))) Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) x y)))
eval_eq256_array_load
     : forall (bl ba : Values.block) (le : Clight.temp_env) (m : Memory.Mem.mem) (index : BinNums.Z)
         (index_expr : Clight.expr) (x : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 index)
                (BinInt.Z.le index (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
         (_ : @eq Ctypes.type (Clight.typeof index_expr) Ctypesdefs.tint)
         (_ : Clight.eval_expr ge0 (eq256_env bl ba) le m index_expr (Values.Vint (Integers.Int.repr index)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) index))
                (@Some Values.val (Values.Vint x))),
       Clight.eval_expr ge0 (eq256_env bl ba) le m
         (Clight.Ederef
            (Clight.Ebinop Cop.Oadd
               (Clight.Evar _arr
                  (Ctypesdefs.tarray Ctypesdefs.tuint
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) index_expr
               (Ctypesdefs.tptr Ctypesdefs.tuint)) Ctypesdefs.tuint) (Values.Vint x)
eval_eq256_offset
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (i k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.le k (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i)))),
       Clight.eval_expr ge0 e le m (eq256_offset k) (Values.Vint (Integers.Int.repr (BinInt.Z.add i k)))
eval_eq256_condition
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i)))),
       Clight.eval_expr ge0 e le m eq256_condition
         (Values.Vint (bit_int (BinInt.Z.ltb i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
eval_eq256_mismatch
     : forall (bl ba : Values.block) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (x y : Integers.Int.int),
       Clight.eval_expr ge0 (eq256_env bl ba) (eq256_loaded le x y) m eq256_mismatch
         (Values.Vint (bit_int (negb (Integers.Int.eq x y))))
exec_eq256_write
     : forall (bl ba : Values.block) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bd : Values.block) (base : BinNums.Z) (bit : bool)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_writeBit)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vint (bit_int bit)) (@nil Values.val))) Events.E0 mf
                (Values.Vint (bit_int bit))),
       ClightBigstep.Clight2.exec_stmt ge0 (eq256_env bl ba) le m (eq256_write bit) Events.E0 le mf
         ClightBigstep.Out_normal
exec_eq256_loop_body
     : forall (bl ba : Values.block) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bd : Values.block) (base i : BinNums.Z) (x y : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
                (@Some Values.val (Values.Vint x)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.add i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@Some Values.val (Values.Vint y)))
         (_ : forall _ : @eq bool (Integers.Int.eq x y) false,
              ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_writeBit)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vint Integers.Int.zero) (@nil Values.val))) Events.E0 mf
                (Values.Vint Integers.Int.zero)),
       ClightBigstep.Clight2.exec_stmt ge0 (eq256_env bl ba) le m eq256_loop_body Events.E0
         (eq256_loaded le x y) match Integers.Int.eq x y return Memory.Mem.mem with
                               | true => m
                               | false => mf
                               end
         match Integers.Int.eq x y return ClightBigstep.outcome with
         | true => ClightBigstep.Out_normal
         | false =>
             ClightBigstep.Out_return
               (@Some (prod Values.val Ctypes.type)
                  (@pair Values.val Ctypes.type (Values.Vint Integers.Int.one) Ctypesdefs.tint))
         end
exec_eq256_loop
     : forall (bl ba : Values.block) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bd : Values.block) (base i : BinNums.Z) (xs ys : list Integers.Int.int) (_ : BinInt.Z.le BinNums.Z0 i)
         (_ : @eq BinNums.Z (BinInt.Z.add i (BinInt.Z.of_nat (@length Integers.Int.int xs)))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
         (_ : @eq nat (@length Integers.Int.int xs) (@length Integers.Int.int ys))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vint (Integers.Int.repr i))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : forall (j : nat) (x : Integers.Int.int)
                (_ : @eq (option Integers.Int.int) (@List.nth_error Integers.Int.int xs j) (@Some Integers.Int.int x)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.add i (BinInt.Z.of_nat j)))) (@Some Values.val (Values.Vint x)))
         (_ : forall (j : nat) (y : Integers.Int.int)
                (_ : @eq (option Integers.Int.int) (@List.nth_error Integers.Int.int ys j) (@Some Integers.Int.int y)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.add (BinInt.Z.add i (BinInt.Z.of_nat j))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@Some Values.val (Values.Vint y)))
         (_ : forall _ : @eq bool (eq256_words_equal xs ys) false,
              ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_writeBit)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vint Integers.Int.zero) (@nil Values.val))) Events.E0 mf
                (Values.Vint Integers.Int.zero)),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          and
            (ClightBigstep.Clight2.exec_stmt ge0 (eq256_env bl ba) le m eq256_loop Events.E0 lef
               match eq256_words_equal xs ys return Memory.Mem.mem with
               | true => m
               | false => mf
               end
               match eq256_words_equal xs ys return ClightBigstep.outcome with
               | true => ClightBigstep.Out_normal
               | false =>
                   ClightBigstep.Out_return
                     (@Some (prod Values.val Ctypes.type)
                        (@pair Values.val Ctypes.type (Values.Vint Integers.Int.one) Ctypesdefs.tint))
               end)
            (@eq (option Values.val) (@Maps.PTree.get Values.val _dst lef)
               (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base)))))
exec_eq256_compare
     : forall (bl ba : Values.block) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bd : Values.block) (base : BinNums.Z) (xs ys : list Integers.Int.int)
