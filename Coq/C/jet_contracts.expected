     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (w0 : bool) (outs0 : list Cell)
         (m : Memory.Mem.mem) (layout : layout) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : rep
                (scalar_limb_rho
                   (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                      (@canonical_scalar_normalize Alg.CoreFunSem value))) layout scalar_writer_initial_regs m)
         (_ : xsep (jet_secp_scalar_writer_exec.scalar_write_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_writer_exec.scalar_write_inv m0 bd dbase bw outedge cursor N bi rc w0 outs0
                (scalar_limb_rho
                   (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                      (@canonical_scalar_normalize Alg.CoreFunSem value))) (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_write_scalar)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
