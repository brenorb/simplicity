       Clight.eval_expr ge0 e le m (extend_wide_msb_expr s) (Values.Vint (bit_int (extend_wide_msb s r)))
write_wide_sequence_run_app
     : forall (s : wide_size) (bf : Values.block) (base : BinNums.Z) (xs ys : list Integers.Int64.int)
