match i return bool with
| AST.Init_int8 _ => true
| AST.Init_int16 _ => true
| AST.Init_int32 _ => true
| AST.Init_int64 _ => true
| AST.Init_float32 _ => true
| AST.Init_float64 _ => true
| AST.Init_space _ => true
| AST.Init_addrof id _ =>
    match @Globalenvs.Genv.find_symbol F V ge id return bool with
    | Some _ => true
    | None => false
    end
end
     : forall (F V : Type) (_ : Globalenvs.Genv.t F V) (_ : AST.init_data), bool

Arguments jet_program_initialization.initializer_referenceb {F V}%type_scope ge i
jet_program_initialization.program_initialization_okb =
fun (F V : Type) (p : AST.program F V) =>
@List.forallb (prod AST.ident (AST.globdef F V))
  (fun idg : prod AST.ident (AST.globdef F V) =>
   match @snd AST.ident (AST.globdef F V) idg return bool with
   | AST.Gfun _ => true
   | AST.Gvar v =>
       andb (jet_program_initialization.initializer_alignedb BinNums.Z0 (@AST.gvar_init V v))
         (@List.forallb AST.init_data
            (@jet_program_initialization.initializer_referenceb F V (@Globalenvs.Genv.globalenv F V p))
            (@AST.gvar_init V v))
   end) (@AST.prog_defs F V p)
     : forall (F V : Type) (_ : AST.program F V), bool

Arguments jet_program_initialization.program_initialization_okb {F V}%type_scope p
jet_secp_scalar_lambda_init_exists.secp_initialization_succeeds =
@jet_program_initialization.program_initialization_okb (Ctypes.fundef Clight.function) Ctypes.type
  (@Ctypes.program_of_program Clight.function jets_secp.prog)
     : bool
jet_secp_initialized_contract.secp_jet_initialized_local_spec =
fun (Ready : forall _ : Memory.Mem.mem, Prop) (f : Clight.function) (A B : Ty.Ty)
  (spec : forall _ : Ty.tySem A, Ty.tySem B) =>
forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
  (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
  (a : Ty.tySem A) (_ : Ready m) (_ : frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
  (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize A))) Integers.Int64.max_unsigned)
  (_ : frame_input_cells_at m bi edge read_cursor (@encode A a))
  (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function f)
        (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
           (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
        Events.E0 mf (Values.Vint Integers.Int.one))
     (and (frame_output_cells_at mf bw outedge cursor (@encode B (spec a)))
        (and (write_prefix_at m mf bw outedge cursor)
           (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B))))
              (and
                 (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                    (_ : Memory.Mem.valid_block m b)
                    (_ : or (not (@eq Values.block b bd))
                           (or
                              (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                 (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              (BinInt.Z.le
                                 (BinInt.Z.add dbase
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                    (_ : or (not (@eq Values.block b bw))
                           (or
                              (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                 (BinInt.Z.add outedge
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B)))
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                              (BinInt.Z.le
                                 (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                  @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                 (Ready mf))))))
     : forall (_ : forall _ : Memory.Mem.mem, Prop) (_ : Clight.function) (A B : Ty.Ty)
         (_ : forall _ : Ty.tySem A, Ty.tySem B), Prop

Arguments jet_secp_initialized_contract.secp_jet_initialized_local_spec Ready%function_scope
  f (A B)%ty_scope spec%function_scope
