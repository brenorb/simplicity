                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                               (prod
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))))
                         (prod
                            (prod
                               (prod
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                               (prod
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))
                            (prod
                               (prod
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                               (prod
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                                  (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))))))))
                z
          | inr _ => x
          end)
canonical_fe_normalize_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_fe_normalize Alg.CoreFunSem x))
         (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
            canonical_field_order)
canonical_fe_normalize_limb_bridge
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (z0 z1 z2 z3 z4 : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 z0)
                (BinInt.Z.le z0
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 z1)
                (BinInt.Z.le z1
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 z2)
                (BinInt.Z.le z2
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 z3)
                (BinInt.Z.le z3
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 z4)
                (BinInt.Z.le z4
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : @eq BinNums.Z (fe_val z0 z1 z2 z3 z4)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)),
       @eq (list BinNums.Z) (nvz_list z0 z1 z2 z3 z4)
         (fe_limbs_of
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@canonical_fe_normalize Alg.CoreFunSem x)))
eval_fe_normalize_var_against_canonical_program
     : forall (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (t0 t1 t2 t3 t4 : Integers.Int64.int)
         (x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : fe_at m b ofs
                (@cons Integers.Int64.int t0
                   (@cons Integers.Int64.int t1
                      (@cons Integers.Int64.int t2
                         (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int)))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t0)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t1)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t2)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t3)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t4)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : @eq BinNums.Z
                (fe_val (Integers.Int64.unsigned t0) (Integers.Int64.unsigned t1) (Integers.Int64.unsigned t2)
                   (Integers.Int64.unsigned t3) (Integers.Int64.unsigned t4))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr ofs)) (@nil Values.val)) Events.E0 mf
               Values.Vundef)
            (and
               (fe_at mf b ofs
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (fe_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_fe_normalize Alg.CoreFunSem x)))))
               (lframe
                  (fun (other : Values.block) (pos : BinNums.Z) =>
                   not
                     (and (@eq Values.block other b)
                        (and (BinInt.Z.le ofs pos)
                           (BinInt.Z.lt pos
                              (BinInt.Z.add ofs
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))) m
                  mf)))
canonical_fe_normalize_idempotent
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@canonical_fe_normalize Alg.CoreFunSem (@canonical_fe_normalize Alg.CoreFunSem x))
         (@canonical_fe_normalize Alg.CoreFunSem x)
secp_fe_normalize_entry
     : forall (v_env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem') (bl ba bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)),
       Clight.function_entry2 secp_ge jets_secp.f_simplicity_fe_normalize
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val v_env (@nil Values.val))))
         m (secp_public_env bl ba) (secp_public_temps v_env bd dbase bs sbase) mb
exec_secp_public_copy
     : forall (m mc : Memory.Mem.mem) (bl ba bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt secp_ge (secp_public_env bl ba) le m
         (Clight.Sassign (Clight.Evar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
secp_public_copy_from_fields
     : forall (m : Memory.Mem.mem) (bl ba bs : Values.block) (sbase : BinNums.Z) (bi : Values.block)
         (edge rc : BinNums.Z) (le : Maps.PTree.tree Values.val) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt secp_ge (secp_public_env bl ba) le m
               (Clight.Sassign (Clight.Evar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))
                  (Clight.Etempvar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))) Events.E0 le mc
               ClightBigstep.Out_normal) (frame_fields_at mc bl BinNums.Z0 bi edge rc))
secp_public_helper_symbols
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) jets_secp._read_fe)
            (@Some Values.block (secp_symbol_block jets_secp._read_fe)))
         (and
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv secp_ge)
                  (Values.Vptr (secp_symbol_block jets_secp._read_fe) Integers.Ptrofs.zero))
               (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_read_fe)))
            (and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge)
                     jets_secp._write_fe) (@Some Values.block (secp_symbol_block jets_secp._write_fe)))
               (@eq (option Clight.fundef)
                  (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv secp_ge)
                     (Values.Vptr (secp_symbol_block jets_secp._write_fe) Integers.Ptrofs.zero))
                  (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_secp.f_write_fe)))))
read_fe_tree_nonempty
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq bool match read_fe_tree input_edge edge return bool with
                | Some _ => true
                | None => false
                end true
read_fe_run_eq
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq (option res) (read_fe_run input_edge edge) (@Some res (read_fe_result input_edge edge))
all_leaf_logs_selected
     : forall (log : list event) (rr : res) (_ : all_leaf_logs log rr) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list event) (slog (@fst sstate xout (rsel rho layout rr))) log
read_fe_result_leaf_logs
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       all_leaf_logs (read_fe_log input_edge edge) (read_fe_result input_edge edge)
read_fe_selected_log
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list event) (slog (@fst sstate xout (rsel rho layout (read_fe_result input_edge edge))))
         (read_fe_log input_edge edge)
read_fe_selected_return
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (option sx)
         (@Maps.PTree.get sx BinNums.xH (stemps (@fst sstate xout (rsel rho layout (read_fe_result input_edge edge)))))
         (@None sx)
read_fe_entries
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (id : AST.ident) (ent : fentry) (_ : @eq (option fentry) (flookup read_fe_table id) (@Some fentry ent)),
       and
         (@ex Values.block
            (fun b : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) id)
                  (@Some Values.block b))
               (@eq (option Clight.fundef)
                  (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) b)
                  (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (fentry_fd ent))))))
         match ent return Prop with
         | FInt _ => True
         | FOra fd oracle =>
             oracle_ok secp_ge (jet_secp_wrapper_run.read_evok bd dbase bi edge ibits)
               (jet_secp_wrapper_run.read_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap)
               (jet_secp_wrapper_run.read_ext m0 bd bw bi) fd oracle
         end
read_fe_input_events
     : forall (bd : Values.block) (dbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (ibits : list bool) (layout : layout),
       solves (jet_secp_wrapper_run.read_evok bd dbase bi edge ibits) (read_fe_rho ibits rc)
         (slog
            (@fst sstate xout
               (rsel (read_fe_rho ibits rc) (lay layout) (read_fe_result bi (Integers.Ptrofs.repr edge)))))
eval_read_fe_from_initial_regions
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : layout)
         (_ : rep (read_fe_rho ibits rc) layout (read_fe_initial_regs bi (Integers.Ptrofs.repr edge)) m)
         (_ : xsep (jet_secp_wrapper_run.read_ext m0 bd bw bi) layout)
         (_ : jet_secp_wrapper_run.read_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (read_fe_rho ibits rc) (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (rep (read_fe_rho ibits rc) layout
                  (sregs
                     (@fst sstate xout
                        (rsel (read_fe_rho ibits rc) (lay layout) (read_fe_result bi (Integers.Ptrofs.repr edge))))) mf)
               (and
                  (jet_secp_wrapper_run.read_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                     (read_fe_rho ibits rc) (read_fe_log bi (Integers.Ptrofs.repr edge)) mf)
                  (lframe
                     (frame (jet_secp_wrapper_run.read_ext m0 bd bw bi) layout
                        (read_fe_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mf))))
zval_sx_subst
     : forall (sigma : forall _ : nat, sx) (rho : forall _ : nat, BinNums.Z) (x : sx),
       @eq BinNums.Z (zval rho (sx_subst sigma x)) (zval (fun n : nat => zval rho (sigma n)) x)
zcells_cell_subst
     : forall (sigma : forall _ : nat, sx) (rho : forall _ : nat, BinNums.Z) (cells : list cell),
       @eq (list BinNums.Z) (zcells rho (@List.map cell cell (cell_subst sigma) cells))
         (zcells (fun n : nat => zval rho (sigma n)) cells)
bits_val_app
     : forall left_bits right_bits : list bool,
       @eq BinNums.Z (bits_val (@app bool left_bits right_bits))
         (BinInt.Z.add
            (BinInt.Z.mul (bits_val left_bits)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat (@length bool right_bits))))
            (bits_val right_bits))
fold_be_linear
     : forall (bytes : list BinNums.Z) (acc : BinNums.Z),
       @eq BinNums.Z
         (@List.fold_left BinNums.Z BinNums.Z
            (fun value byte : BinNums.Z =>
             BinInt.Z.add
               (BinInt.Z.mul value
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               byte) bytes acc)
         (BinInt.Z.add
            (BinInt.Z.mul acc
               (BinInt.Z.pow
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (BinInt.Z.of_nat (@length BinNums.Z bytes)))) (jet_secp_fe_math.be_val bytes))
be_val_cons
     : forall (byte : BinNums.Z) (bytes : list BinNums.Z),
       @eq BinNums.Z (jet_secp_fe_math.be_val (@cons BinNums.Z byte bytes))
         (BinInt.Z.add
            (BinInt.Z.mul byte
               (BinInt.Z.pow
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (BinInt.Z.of_nat (@length BinNums.Z bytes)))) (jet_secp_fe_math.be_val bytes))
input_bytes_length
     : forall (count : nat) (bits : list bool), @eq nat (@length BinNums.Z (input_bytes count bits)) count
input_bytes_value
     : forall (count : nat) (bits : list bool)
         (_ : @eq nat (@length bool bits) (Nat.mul (S (S (S (S (S (S (S (S O)))))))) count)),
       @eq BinNums.Z (jet_secp_fe_math.be_val (input_bytes count bits)) (bits_val bits)
input_bytes_nth
     : forall (count : nat) (bits : list bool) (j : nat) (_ : lt j count),
       @eq (option BinNums.Z) (@List.nth_error BinNums.Z (input_bytes count bits) j)
         (@Some BinNums.Z (ifield bits (Nat.mul (S (S (S (S (S (S (S (S O)))))))) j) (S (S (S (S (S (S (S (S O))))))))))
input_bytes_bounds
     : forall (count : nat) (bits : list bool)
         (_ : @eq nat (@length bool bits) (Nat.mul (S (S (S (S (S (S (S (S O)))))))) count)),
       @List.Forall BinNums.Z
         (fun byte : BinNums.Z =>
          and (BinInt.Z.le BinNums.Z0 byte)
            (BinInt.Z.le byte
               (BinNums.Zpos
                  (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
         (input_bytes count bits)
bits_val_canonical_word
     : forall (n : nat) (value : Ty.tySem (Word.Word n)),
