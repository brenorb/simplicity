                (@List.map bool (option bool) (@Some bool) (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) y)))
         (_ : frame_input_cells_at m0 bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                (@List.map bool (option bool) (@Some bool) (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) z)))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) cap
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) x) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_gej)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and (fe_at mf ba BinNums.Z0 (point_canonical_limbs x))
               (and
                  (fe_at mf ba
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (point_canonical_limbs y))
                  (and
                     (fe_at mf ba
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                        (point_canonical_limbs z))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint32 mf ba
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                           (@Some Values.val
                              (Values.Vint (bit_int (Bit.toBool (@canonical_fe_is_zero Alg.CoreFunSem z))))))
                        (and
                           (frame_fields_at mf bl BinNums.Z0 bi edge
                              (BinInt.Z.add rc
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                           (and
                              (Memory.Mem.range_perm mf ba BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mf bl BinNums.Z0
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (invA m0 bd dbase bw outedge cursor N bi
                                       (BinInt.Z.add rc
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                       false (@nil Cell) cap
                                       (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) z)
                                          (BinInt.Z.add rc
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                                       (read_fe_log bi (Integers.Ptrofs.repr edge)) mf)
                                    (lframe (secp_locals_outside m0 bd bw bi ba bl) m mf))))))))))
point_field_load_transport
     : forall (k : point_coordinate) (m mf : Memory.Mem.mem) (b : Values.block) (xs : list Integers.Int64.int)
         (_ : le (@length Integers.Int64.int xs) (S (S (S (S (S O)))))) (_ : fe_at m b (point_coordinate_offset k) xs)
         (_ : Memory.Mem.range_perm mf b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S O)))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mf b
                   (BinInt.Z.add (point_coordinate_offset k)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.of_nat i))))
                (Memory.Mem.load AST.Mint64 m b
                   (BinInt.Z.add (point_coordinate_offset k)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.of_nat i))))), fe_at mf b (point_coordinate_offset k) xs
point_pure_frame_preserves_field
     : forall (k j : point_coordinate) (m mf : Memory.Mem.mem) (b : Values.block) (xs : list Integers.Int64.int)
         (_ : not (@eq point_coordinate k j)) (_ : le (@length Integers.Int64.int xs) (S (S (S (S (S O))))))
         (_ : fe_at m b (point_coordinate_offset j) xs)
         (_ : Memory.Mem.range_perm mf b BinNums.Z0
