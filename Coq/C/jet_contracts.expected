eval_wide_division_layout_machine
     : forall (env : Values.val) (remainder : bool) (s : wide_size) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
