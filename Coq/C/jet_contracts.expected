         (_ : @eq (option BinNums.Z) (rfree reg) (@Some BinNums.Z sz)), @eq BinNums.Z (bas layout r) BinNums.Z0
eval_u128_shift64_from_symbolic_stores
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (regs : list region)
         (m : Memory.Mem.mem) (r : nat) (reg : region) (hi : sx) (regs1 regs2 : list region)
         (_ : rep rho layout regs m) (_ : @eq (option region) (@List.nth_error region regs r) (@Some region reg))
         (_ : @eq (option BinNums.Z) (rfree reg)
                (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : @eq (option sx)
                (xload regs r (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) Ctypesdefs.tulong)
                (@Some sx hi)) (_ : @eq bool (isk KL hi) true)
         (_ : @eq (option (list region)) (xstore regs r BinNums.Z0 AST.Mint64 hi) (@Some (list region) regs1))
         (_ : @eq (option (list region))
                (xstore regs1 r (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
                   (XLc Integers.Int64.zero)) (@Some (list region) regs2)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_u128_rshift)
               (@cons Values.val (Values.Vptr (blk layout r) Integers.Ptrofs.zero)
                  (@cons Values.val
                     (Values.Vint
                        (Integers.Int.repr
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (rep rho layout regs2 mf)
               (and
                  (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                     (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        rshape regs2)
                     (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        rshape regs))
                  (lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (foot layout
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              regs) b ofs)) m mf))))
u128_shift64_oracle_correct
     : oracle_ok secp_ge (fun (_ : forall _ : nat, Integers.Int64.int) (_ : event) => True)
         (fun (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem) => True)
         (fun _ : Values.block => False) jets_secp.f_secp256k1_u128_rshift u128_shift64_oracle
secp_shift64_table_correct
     : forall (id : AST.ident) (ent : fentry)
         (_ : @eq (option fentry) (flookup secp_shift64_table id) (@Some fentry ent)),
       and
         (@ex Values.block
            (fun b : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) id)
                  (@Some Values.block b))
               (@eq (option Clight.fundef)
                  (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) b)
                  (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (fentry_fd ent))))))
         match ent return Prop with
         | FInt _ => True
         | FOra fd o =>
             oracle_ok secp_ge (fun (_ : forall _ : nat, Integers.Int64.int) (_ : event) => True)
               (fun (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem) => True)
               (fun _ : Values.block => False) fd o
         end
xfun_shift64_sound
     : forall (fuel : nat) (fd : Clight.function) (args : list sx) (regs : list region) (nv : nat)
         (result : res)
         (_ : @eq (option res)
                (xfun (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type))) secp_shift64_table fuel
                   fd args regs (@nil event) nv) (@Some res result)) (rho : forall _ : nat, Integers.Int64.int)
         (layout : layout) (m : Memory.Mem.mem) (_ : rep rho layout regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Values.val
            (fun vres : Values.val =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function fd)
                  (@List.map sx Values.val (den rho (lay layout)) args) Events.E0 mf vres)
               (and (rep rho layout (sregs (@fst sstate xout (rsel rho (lay layout) result))) mf)
                  (and
                     match
                       @Maps.PTree.get sx BinNums.xH (stemps (@fst sstate xout (rsel rho (lay layout) result)))
                       return Prop
                     with
                     | Some x => @eq Values.val vres (den rho (lay layout) x)
                     | None => @eq Values.val vres Values.Vundef
                     end
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (sregs (@fst sstate xout (rsel rho (lay layout) result))))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              regs))
                        (lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot layout
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape regs) b ofs)) m mf))))))
separated_external_not_foot
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (regs : list region)
         (m : Memory.Mem.mem) (ext : forall _ : Values.block, Prop) (b : Values.block) (ofs : BinNums.Z)
         (_ : rep rho layout regs m) (_ : xsep ext layout) (_ : ext b),
       not
         (foot layout
            (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
               regs) b ofs)
pure_frame_external
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (regs : list region)
         (m mf : Memory.Mem.mem) (ext : forall _ : Values.block, Prop) (_ : rep rho layout regs m)
         (_ : xsep ext layout) (_ : lframe (frame (fun _ : Values.block => False) layout regs m) m mf),
       lframe (fun (b : Values.block) (_ : BinNums.Z) => ext b) m mf
pure_oracle_frame_lift
     : forall (ge : Clight.genv) (fd : Clight.function) (oracle : oracle)
         (evok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (ext : forall _ : Values.block, Prop)
         (_ : oracle_ok ge (fun (_ : forall _ : nat, Integers.Int64.int) (_ : event) => True)
                (fun (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem) => True)
                (fun _ : Values.block => False) fd oracle)
         (_ : forall (rho : forall _ : nat, Integers.Int64.int) (log : list event) (m mf : Memory.Mem.mem)
                (_ : inv rho log m) (_ : lframe (fun (b : Values.block) (_ : BinNums.Z) => ext b) m mf),
              inv rho log mf)
         (_ : forall (base : nat) (xs : list sx) (regs regs' : list region) (v : option sx)
                (tag cnt : nat) (args : list sx) (log : list event)
                (_ : @eq (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                       (oracle base log xs regs)
                       (@Some (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                          (@pair (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)
                             (@pair (prod (prod (list region) (option sx)) nat) nat
                                (@pair (prod (list region) (option sx)) nat (@pair (list region) (option sx) regs' v)
                                   tag) cnt) args))) (rho : forall _ : nat, Integers.Int64.int)
                (m : Memory.Mem.mem) (_ : inv rho log m),
              inv rho (@app event log (@cons event (mkev tag base cnt args) (@nil event))) m),
       oracle_ok ge evok inv ext fd oracle
shift64_event_tag
     : forall (base : nat) (xs : list sx) (regs regs' : list region) (v : option sx) (tag cnt : nat)
         (args : list sx) (log : list event)
         (_ : @eq (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                (u128_shift64_oracle base log xs regs)
                (@Some (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                   (@pair (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)
                      (@pair (prod (prod (list region) (option sx)) nat) nat
                         (@pair (prod (list region) (option sx)) nat (@pair (list region) (option sx) regs' v) tag) cnt)
                      args))), @eq nat tag O
invA_append_nonwrite
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list Cell)
         (cap : BinNums.Z) (rho : forall _ : nat, Integers.Int64.int) (log : list event) (m : Memory.Mem.mem)
         (ev : event) (_ : @eq bool (is_wr ev) false)
         (_ : invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 cap rho log m),
       invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 cap rho (@app event log (@cons event ev (@nil event))) m
shift64_frame_oracle
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list Cell)
         (cap : BinNums.Z) (evok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (_ : write_frame_at m0 bd dbase bw outedge cursor N),
       oracle_ok secp_ge evok (invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 cap) (extA m0 bd bw bi)
         jets_secp.f_secp256k1_u128_rshift u128_shift64_oracle
scalar_reader_run_eq
     : forall (bi : Values.block) (edge : Integers.Ptrofs.int),
       @eq (option res) (scalar_reader_run bi edge) (@Some res (RDone (scalar_reader_state bi edge) ONormal))
scalar_reader_return
     : forall (bi : Values.block) (edge : Integers.Ptrofs.int),
       @eq (Maps.PTree.t sx) (stemps (scalar_reader_state bi edge)) scalar_reader_temps
scalar_reader_log_eq
     : forall (bi : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list event) (slog (scalar_reader_state bi edge)) (scalar_reader_log bi edge)
scalar_reader_allocation
     : @eq (option (prod (list region) venv))
         (xalloc (std_cells (Clight.genv_cenv secp_ge)) (Clight.genv_cenv secp_ge)
            (Clight.fn_vars jets_secp.f_read_scalar) (S (S O)))
         (@Some (prod (list region) (list (prod AST.ident (prod nat Ctypes.type))))
            (@pair (list region) (list (prod AST.ident (prod nat Ctypes.type)))
               (@cons region scalar_reader_buffer (@nil region)) scalar_reader_venv))
scalar_reader_read_regions
     : forall (bi : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list region) (sregs (scalar_reader_state bi edge))
         (@cons region
            (@List.nth region O (scalar_reader_initial_regs bi edge) (mkreg (@nil cell) true (@None BinNums.Z)))
            (@cons region
               (mkreg
                  (mk_frame_cells (XA bi edge)
                     (Integers.Int64.repr
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                  true (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@cons region
                  (mkreg
                     (jet_secp_fe_b32.byte_cells BinNums.Z0
                        (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))
                        (S O)) true
                     (@Some BinNums.Z
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (@nil region))))
scalar_reader_entries
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (id : AST.ident) (ent : fentry) (_ : @eq (option fentry) (flookup scalar_reader_table id) (@Some fentry ent)),
       and
         (@ex Values.block
            (fun b : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) id)
                  (@Some Values.block b))
               (@eq (option Clight.fundef)
                  (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) b)
                  (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (fentry_fd ent))))))
         match ent return Prop with
         | FInt _ => True
         | FOra fd oracle =>
             oracle_ok secp_ge (jet_secp_scalar_reader_run.rd_ev bd dbase bi edge ibits)
               (jet_secp_scalar_reader_run.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap)
               (jet_secp_scalar_reader_run.rd_ext m0 bd bw bi) fd oracle
         end
scalar_reader_events
     : forall (bd : Values.block) (dbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool),
       solves (jet_secp_scalar_reader_run.rd_ev bd dbase bi edge ibits) (read_fe_rho ibits rc)
         (slog (scalar_reader_state bi (Integers.Ptrofs.repr edge)))
exec_scalar_reader_first
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : layout) (e : Clight.env) (le : Clight.temp_env)
         (_ : rep (read_fe_rho ibits rc) layout (sregs (scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m)
         (_ : tmatch (read_fe_rho ibits rc) layout scalar_reader_temps le) (_ : ematch layout scalar_reader_venv e)
         (_ : xsep (jet_secp_scalar_reader_run.rd_ext m0 bd bw bi) layout)
         (_ : jet_secp_scalar_reader_run.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (read_fe_rho ibits rc) (@nil event) m),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge e le m scalar_reader_first Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and (rep (read_fe_rho ibits rc) layout (sregs (scalar_reader_state bi (Integers.Ptrofs.repr edge))) mf)
                  (and (tmatch (read_fe_rho ibits rc) layout scalar_reader_temps le')
                     (and
                        (jet_secp_scalar_reader_run.rd_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                           (read_fe_rho ibits rc) (scalar_reader_log bi (Integers.Ptrofs.repr edge)) mf)
                        (lframe
                           (frame (jet_secp_scalar_reader_run.rd_ext m0 bd bw bi) layout
                              (sregs (scalar_reader_initial bi (Integers.Ptrofs.repr edge))) m) m mf))))))
scalar_undefined_owned_from_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : @eq BinNums.Z (bas layout O) BinNums.Z0)
         (_ : Memory.Mem.range_perm m (blk layout O) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       region_ok rho layout m O
         (mkreg
            (@cons cell (mkcell BinNums.Z0 AST.Mint64 (@None sx))
               (@cons cell
                  (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64 (@None sx))
                  (@cons cell
                     (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) AST.Mint64
                        (@None sx))
                     (@cons cell
                        (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))
                           AST.Mint64 (@None sx)) (@nil cell))))) true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
scalar_reader_initial_rep_from_storage
     : forall (bits : list bool) (rc : BinNums.Z) (m : Memory.Mem.mem) (ba bl bi : Values.block)
         (edge : BinNums.Z)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bl)),
       rep (read_fe_rho bits rc)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) (scalar_reader_initial_regs bi (Integers.Ptrofs.repr edge)) m
scalar_zero_public_entry
     : forall (v_env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem') (bl ba bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)),
       Clight.function_entry2 secp_ge jets_secp.f_simplicity_scalar_is_zero
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val v_env (@nil Values.val))))
         m (scalar_public_env bl ba) (scalar_public_temps v_env bd dbase bs sbase) mb
scalar_public_blocks
     : forall bl ba : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z))
         (Clight.blocks_of_env secp_ge (scalar_public_env bl ba))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z ba BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))
scalar_public_src_temp
     : forall (v_env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z),
       @eq (option Values.val)
         (@Maps.PTree.get Values.val jets_secp._src (scalar_public_temps v_env bd dbase bs sbase))
         (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)))
exec_scalar_public_copy
     : forall (m mc : Memory.Mem.mem) (bl ba bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt secp_ge (scalar_public_env bl ba) le m
         (Clight.Sassign (Clight.Evar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_secp._src (Ctypes.Tstruct jets_secp._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
scalar_free_public_locals
     : forall (m : Memory.Mem.mem) (bl ba : Values.block) (_ : not (@eq Values.block ba bl))
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem)
               (Memory.Mem.free_list m (Clight.blocks_of_env secp_ge (scalar_public_env bl ba)))
               (@Some Memory.Mem.mem mf))
            (lframe
               (fun (b : Values.block) (_ : BinNums.Z) =>
                and (not (@eq Values.block b ba)) (not (@eq Values.block b bl))) m mf))
scalar_overflow_run_eq
     : @eq (option res) scalar_overflow_run (@Some res (RDone scalar_overflow_state ONormal))
scalar_overflow_return_eq
     : @eq (option sx) (@Maps.PTree.get sx BinNums.xH (stemps scalar_overflow_state)) (@Some sx scalar_overflow_return)
scalar_overflow_regions
     : @eq (list region) (sregs scalar_overflow_state) scalar_overflow_initial_regs
eval_scalar_overflow_from_readable_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout scalar_overflow_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_check_overflow)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O))) (@nil Values.val))
               Events.E0 mf (den rho (lay layout) scalar_overflow_return))
            (and (rep rho layout scalar_overflow_initial_regs mf)
               (lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (foot layout
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           scalar_overflow_initial_regs) b ofs)) m mf)))
scalar_overflow_symbolic_return
