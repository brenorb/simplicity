Integers.Int.cmp (order_cmp k)
  (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r)
  (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)
     : forall (_ : order_op) (_ : Integers.Int.int) (_ : Integers.Int.int), bool

Arguments order8_bit k r t
is_zero_word_spec =
fun (n : nat) (term : Alg.Core.Algebra) => @Bit.not (Word.Word n) term (@predicate_spec n false term)
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit)

Arguments is_zero_word_spec n%nat_scope {term}
is_one_word_spec =
fun (n : nat) (term : Alg.Core.Algebra) =>
@AC.comp (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit) term
  (@decrement_word_spec term n)
  (@AC.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term (@is_zero_word_spec n term))
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit)

Arguments is_one_word_spec n%nat_scope {term}
test_value_spec =
fun (n : nat) (one : bool) (term : Alg.Core.Algebra) =>
match one return (Alg.Core.domain term (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit)) with
| true => @is_one_word_spec n term
| false => @is_zero_word_spec n term
end
     : forall (n : nat) (_ : bool) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit)

