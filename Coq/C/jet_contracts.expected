u128_shift64_oracle =
fun (_ : nat) (_ : list event) (xs : list sx) (regs : list region) =>
match xs return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
| nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
| cons arg0 l =>
    match l return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
    | nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
    | cons arg1 l0 =>
        match l0 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
        | nil =>
            match arg0 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
            | XI _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            | XIc _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            | XL _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            | XLc _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            | XLv _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            | XV _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            | XA _ _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            | XP r offset =>
                match arg1 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
                | XI _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                | XIc count =>
                    match
                      andb (BinInt.Z.eqb offset BinNums.Z0)
                        (Integers.Int.eq count
                           (Integers.Int.repr
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                      return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                    with
                    | true =>
                        match
                          @List.nth_error region regs r
                          return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                        with
                        | Some reg =>
                            match
                              rfree reg
                              return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                            with
                            | Some sz =>
                                match
                                  BinInt.Z.eqb sz
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                  return
                                    (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                                with
                                | true =>
                                    match
                                      xload regs r (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                        Ctypesdefs.tulong
                                      return
                                        (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                                    with
                                    | Some hi =>
                                        match
                                          isk KL hi
                                          return
                                            (option
                                               (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                                        with
                                        | true =>
                                            match
                                              xstore regs r BinNums.Z0 AST.Mint64 hi
                                              return
                                                (option
                                                   (prod (prod (prod (prod (list region) (option sx)) nat) nat)
                                                      (list sx)))
                                            with
                                            | Some regs1 =>
