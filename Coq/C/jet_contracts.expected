frame_cells =
fun regS : region =>
match rcells regS return (option (prod sx Integers.Int64.int)) with
| nil => @None (prod sx Integers.Int64.int)
| cons c1 l =>
    match l return (option (prod sx Integers.Int64.int)) with
    | nil => @None (prod sx Integers.Int64.int)
    | cons c2 l0 =>
        match l0 return (option (prod sx Integers.Int64.int)) with
        | nil =>
            match cval c1 return (option (prod sx Integers.Int64.int)) with
            | Some xp =>
                match cval c2 return (option (prod sx Integers.Int64.int)) with
                | Some xc =>
                    match cur_k xc return (option (prod sx Integers.Int64.int)) with
                    | Some kc =>
                        match
                          andb
                            (andb
                               (andb (andb (BinInt.Z.eqb (cofs c1) BinNums.Z0) (chunk_eqb (cchunk c1) AST.Mint64))
                                  (BinInt.Z.eqb (cofs c2)
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (chunk_eqb (cchunk c2) AST.Mint64)) (isk KA xp)
                          return (option (prod sx Integers.Int64.int))
                        with
                        | true => @Some (prod sx Integers.Int64.int) (@pair sx Integers.Int64.int xp kc)
                        | false => @None (prod sx Integers.Int64.int)
                        end
                    | None => @None (prod sx Integers.Int64.int)
                    end
                | None => @None (prod sx Integers.Int64.int)
                end
            | None => @None (prod sx Integers.Int64.int)
            end
        | cons _ _ => @None (prod sx Integers.Int64.int)
        end
    end
end
     : forall _ : region, option (prod sx Integers.Int64.int)

Arguments frame_cells regS
mk_frame_cells =
fun (xp : sx) (kc : Integers.Int64.int) =>
@cons cell (mkcell BinNums.Z0 AST.Mint64 (@Some sx xp))
  (@cons cell
     (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
        (@Some sx (XLb Badd (XLv O) (XLc kc)))) (@nil cell))
     : forall (_ : sx) (_ : Integers.Int64.int), list cell

Arguments mk_frame_cells xp kc
is_wr = fun ev : event => PeanoNat.Nat.eqb (etag ev) tWR8
     : forall _ : event, bool

Arguments is_wr ev
has_wr = fun log : list event => @List.existsb event is_wr log
     : forall _ : list event, bool

Arguments has_wr log%list_scope
wr_bytes =
fun (ρ : forall _ : nat, Integers.Int64.int) (ev : event) =>
@List.map sx Integers.Int.int (fun x : sx => ii (den ρ β0 x)) (@List.tl sx (eargs ev))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), list Integers.Int.int

Arguments wr_bytes ρ%function_scope ev
outsA =
fun (ρ : forall _ : nat, Integers.Int64.int) (log : list event) =>
@List.concat Cell
  (@List.map event (list Cell)
     (fun ev : event =>
      match is_wr ev return (list Cell) with
      | true => byte_sequence_cells (wr_bytes ρ ev)
      | false => @nil Cell
      end) log)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event), list Cell

Arguments outsA ρ%function_scope log%list_scope
written =
fix written (log : list event) : BinNums.Z :=
  match log return BinNums.Z with
  | nil => BinNums.Z0
  | cons ev t =>
      BinInt.Z.add
        match is_wr ev return BinNums.Z with
        | true =>
            BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
              (BinInt.Z.of_nat (@length sx (@List.tl sx (eargs ev))))
        | false => BinNums.Z0
        end (written t)
  end
     : forall _ : list event, BinNums.Z

Arguments written log%list_scope
evokA =
fun (bd : Values.block) (dbase : BinNums.Z) (bi : Values.block) (edge : BinNums.Z) (ibits : list bool)
  (ρ : forall _ : nat, Integers.Int64.int) (ev : event) =>
match PeanoNat.Nat.eqb (etag ev) tRD8 return Prop with
| true =>
    match eargs ev return Prop with
    | nil => False
    | cons xp l =>
        match l return Prop with
        | nil => False
        | cons s l0 =>
            match s return Prop with
            | XI _ => False
            | XIc _ => False
            | XL _ => False
            | XLc k =>
                match l0 return Prop with
                | nil => False
                | cons s0 l1 =>
                    match s0 return Prop with
                    | XI _ => False
                    | XIc _ => False
                    | XL _ => False
                    | XLc _ =>
                        match l1 return Prop with
                        | nil =>
                            and (@eq Values.val (den ρ β0 xp) (Values.Vptr bi (Integers.Ptrofs.repr edge)))
                              (forall (j : nat) (_ : lt j (ecnt ev)),
                               @eq Integers.Int64.int (ρ (Nat.add (ebase ev) j))
                                 (Integers.Int64.repr
                                    (ifield ibits
                                       (Nat.add (BinInt.Z.to_nat (Integers.Int64.unsigned k))
                                          (Nat.mul (S (S (S (S (S (S (S (S O)))))))) j))
                                       (S (S (S (S (S (S (S (S O)))))))))))
                        | cons _ _ => False
                        end
                    | XLv _ => False
                    | XV _ => False
                    | XA _ _ => False
                    | XP _ _ => False
                    | XIb _ _ _ => False
                    | XLb _ _ _ => False
                    | XIsh _ _ _ => False
                    | XLsh _ _ _ => False
                    | XIcmp _ _ _ _ => False
                    | XLcmp _ _ _ _ => False
                    | XI2L _ _ => False
                    | XL2I _ => False
                    | XIcast _ _ _ => False
                    | XInz _ => False
                    | XLnz _ => False
                    | XIz _ => False
                    | XLz _ => False
                    | XIneg _ => False
                    | XLneg _ => False
                    | XInot _ => False
                    | XLnot _ => False
                    end
                end
            | XLv _ => False
            | XV _ => False
            | XA _ _ => False
            | XP _ _ => False
            | XIb _ _ _ => False
            | XLb _ _ _ => False
            | XIsh _ _ _ => False
            | XLsh _ _ _ => False
            | XIcmp _ _ _ _ => False
            | XLcmp _ _ _ _ => False
            | XI2L _ _ => False
            | XL2I _ => False
            | XIcast _ _ _ => False
            | XInz _ => False
            | XLnz _ => False
            | XIz _ => False
            | XLz _ => False
            | XIneg _ => False
            | XLneg _ => False
            | XInot _ => False
            | XLnot _ => False
            end
        end
    end
| false =>
    match PeanoNat.Nat.eqb (etag ev) tWR8 return Prop with
    | true =>
        match eargs ev return Prop with
        | nil => False
        | cons xd _ => @eq Values.val (den ρ β0 xd) (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        end
    | false => True
    end
end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : list bool)
         (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop

Arguments evokA bd dbase%Z_scope bi edge%Z_scope ibits%list_scope ρ%function_scope ev
extA =
fun (m0 : Memory.Mem.mem) (bd bw bi : Values.block) => fext m0 bd bw bi
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Prop

Arguments extA m0 bd bw bi _
invA =
fun (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
  (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list Cell) (capA : BinNums.Z)
  (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m : Memory.Mem.mem) =>
and (@eq Integers.Int64.int (ρ O) (Integers.Int64.repr rc))
  (and (finv m0 bd dbase bw outedge cursor N bi m (orb w0 (has_wr log)) (@app Cell outs0 (outsA ρ log)))
     (and (BinInt.Z.le (BinInt.Z.add (BinInt.Z.of_nat (@length Cell outs0)) capA) N) (BinInt.Z.le (written log) capA)))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : bool) (_ : list Cell)
         (_ : BinNums.Z) (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop

Arguments invA m0 bd dbase%Z_scope bw (outedge cursor N)%Z_scope bi rc%Z_scope w0%bool_scope
  outs0%list_scope capA%Z_scope ρ%function_scope log%list_scope m
orc_rd8 =
fun (w0 : bool) (nin : BinNums.Z) (base : nat) (log : list event) (xs : list sx) (regs : list region) =>
match xs return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
| nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
| cons x1 l =>
    match l return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
    | nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
    | cons xn l0 =>
        match l0 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
        | nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
        | cons x3 l1 =>
            match l1 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
            | nil =>
                match
                  as_xp0 x1 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                with
                | Some rb =>
                    match
                      xconst xn return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                    with
                    | Some n =>
                        match
                          as_xp0 x3
                          return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                        with
                        | Some rs =>
                            match
                              @List.nth_error region regs rb
                              return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                            with
                            | Some regb =>
                                match
                                  @List.nth_error region regs rs
                                  return
                                    (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                                with
                                | Some regS =>
                                    match
                                      frame_cells regS
                                      return
                                        (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                                    with
                                    | Some p =>
                                        match
                                          p
                                          return
                                            (option
                                               (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                                        with
                                        | pair xp kc =>
                                            match
                                              andb
                                                (andb
                                                   (andb
                                                      (andb
                                                         (andb
                                                            (andb
                                                               (andb (andb (negb w0) (negb (has_wr log)))
                                                                  (BinInt.Z.ltb BinNums.Z0 n))
                                                               (BinInt.Z.leb
                                                                  (BinInt.Z.add (Integers.Int64.unsigned kc)
                                                                     (BinInt.Z.mul (BinNums.Zpos ...) n)) nin))
                                                            (negb (PeanoNat.Nat.eqb rb rs)))
                                                         (rw regb)) (rw regS))
                                                   (shape_eqb
                                                      (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape
                                                         (rcells regb))
                                                      (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape
                                                         (byte_undef BinNums.Z0 (BinInt.Z.to_nat n)))))
                                                match rfree regb return bool with
                                                | Some _ => true
                                                | None => false
                                                end
                                              return
                                                (option
                                                   (prod (prod (prod (prod (list region) (option sx)) nat) nat)
                                                      (list sx)))
                                            with
                                            | true =>
                                                @Some
                                                  (prod (prod (prod (prod (list region) (option sx)) nat) nat)
                                                     (list sx))
                                                  (@pair (prod (prod (prod (list region) (option sx)) nat) nat)
                                                     (list sx)
                                                     (@pair (prod (prod (list region) (option sx)) nat) nat
                                                        (@pair (prod (list region) (option sx)) nat
                                                           (@pair (list region) (option sx)
                                                              (@upd region
                                                                 (@upd region regs rb
                                                                    (mkreg
                                                                       (byte_cells BinNums.Z0 (BinInt.Z.to_nat n) base)
                                                                       (rw regb) (rfree regb))) rs
                                                                 (mkreg
                                                                    (mk_frame_cells xp
                                                                       (Integers.Int64.repr
                                                                          (BinInt.Z.add (Integers.Int64.unsigned kc)
                                                                             (BinInt.Z.mul ... n))))
                                                                    (rw regS) (rfree regS)))
                                                              (@None sx)) tRD8) (BinInt.Z.to_nat n))
                                                     (@cons sx xp
                                                        (@cons sx (XLc kc)
                                                           (@cons sx (XLc (Integers.Int64.repr n)) (@nil sx)))))
                                            | false =>
                                                @None
                                                  (prod (prod (prod (prod (list region) (option sx)) nat) nat)
                                                     (list sx))
                                            end
                                        end
                                    | None =>
                                        @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                                    end
                                | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                                end
                            | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                            end
                        | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                        end
                    | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                    end
                | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                end
            | cons _ _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            end
        end
    end
end
     : forall (_ : bool) (_ : BinNums.Z), oracle

Arguments orc_rd8 w0%bool_scope nin%Z_scope _ _ _ _
cell_sx =
fun c : cell => match cval c return sx with
                | Some x => x
                | None => XIc Integers.Int.zero
                end
     : forall _ : cell, sx

Arguments cell_sx c
cell_KI =
fun c : cell => match cval c return bool with
                | Some x => isk KI x
                | None => false
                end
     : forall _ : cell, bool

Arguments cell_KI c
orc_wr8 =
fun (capA : BinNums.Z) (_ : nat) (log : list event) (xs : list sx) (regs : list region) =>
match xs return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
| nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
| cons xd l =>
    match l return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
    | nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
    | cons x2 l0 =>
        match l0 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
        | nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
        | cons xn l1 =>
            match l1 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
            | nil =>
                match
                  as_xp0 x2 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                with
                | Some rb =>
                    match
                      xconst xn return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                    with
                    | Some n =>
                        match
                          @List.nth_error region regs rb
                          return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                        with
                        | Some regb =>
                            match
                              andb
                                (andb
                                   (andb (andb (isk KA xd) (BinInt.Z.ltb BinNums.Z0 n))
                                      (shape_eqb
                                         (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape (rcells regb))
                                         (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape
                                            (byte_undef BinNums.Z0 (BinInt.Z.to_nat n)))))
                                   (@List.forallb cell cell_KI (rcells regb)))
                                (BinInt.Z.leb
                                   (BinInt.Z.add (written log)
                                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) n))
                                   capA)
                              return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                            with
                            | true =>
                                @Some (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                                  (@pair (prod (prod (prod (list region) (option sx)) nat) nat)
                                     (list sx)
                                     (@pair (prod (prod (list region) (option sx)) nat) nat
                                        (@pair (prod (list region) (option sx)) nat
                                           (@pair (list region) (option sx) regs (@None sx)) tWR8) O)
                                     (@cons sx xd (@List.map cell sx cell_sx (rcells regb))))
                            | false => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                            end
                        | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                        end
                    | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                    end
                | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                end
            | cons _ _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            end
        end
    end
end
     : forall _ : BinNums.Z, oracle

Arguments orc_wr8 capA%Z_scope _ _ _ _
