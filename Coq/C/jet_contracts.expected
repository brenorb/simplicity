     (@bitcoin_pair alg (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))
        (@bitcoin_core (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))
           (fun alg0 : Alg.Core.Algebra => @DC.iden (Word.Word (S (S (S (S O))))) alg0) alg)
        (@bitcoin_comp alg (Word.Word (S (S (S (S O))))) Ty.Unit (Word.Word (S (S (S (S O)))))
           (@bitcoin_core (Word.Word (S (S (S (S O))))) Ty.Unit
              (fun alg0 : Alg.Core.Algebra => @DC.unit (Word.Word (S (S (S (S O))))) alg0) alg)
           (@bitcoin_lock_distance_program dist alg)))
     (@bitcoin_core (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))) (Ty.Sum Ty.Unit Ty.Unit)
        (fun alg0 : Alg.Core.Algebra => @le_word_spec alg0 (S (S (S (S O))))) alg))
     : forall (_ : bool) (alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra),
       Bitcoin.PrimitiveBitcoin.Primitive.domain alg (Word.Word (S (S (S (S O))))) Ty.Unit

