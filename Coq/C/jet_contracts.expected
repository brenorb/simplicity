jet_elements_null_data_environment.elements_null_data_output_environment =
fun (m : Memory.Mem.mem) (bt : Values.block) (txbase : BinNums.Z) (bout : Values.block) (outbase : BinNums.Z)
  (k : nat) (txo : jet_elements_prim.txOutput) (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
and (BinInt.Z.le BinNums.Z0 outbase)
  (and
     (BinInt.Z.le
        (BinInt.Z.add
           (BinInt.Z.add outbase
              (BinInt.Z.mul
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                 (BinInt.Z.of_nat k)))
           (BinNums.Zpos
              (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
        Integers.Ptrofs.max_unsigned)
     (and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mptr m bt
              (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
           (@Some Values.val (Values.Vptr bout (Integers.Ptrofs.repr outbase))))
        (and
           (@eq (option Values.val)
              (Memory.Mem.load AST.Mint8unsigned m bout
                 (BinInt.Z.add
                    (BinInt.Z.add outbase
                       (BinInt.Z.mul
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                          (BinInt.Z.of_nat k)))
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
              (@Some Values.val
                 (Values.Vint
                    match
                      jet_elements_null_data_environment.elements_null_data_script_flag
                        (jet_elements_prim.txoScript txo) return Integers.Int.int
                    with
                    | true => Integers.Int.one
                    | false => Integers.Int.zero
                    end)))
           (and
              (@List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                 (@pair (prod Values.block BinNums.Z) BinNums.Z
                    (@pair Values.block BinNums.Z bt
                       (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                    (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                 fp)
              (and
                 (@List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                    (@pair (prod Values.block BinNums.Z) BinNums.Z
                       (@pair Values.block BinNums.Z bout
                          (BinInt.Z.add
                             (BinInt.Z.add outbase
                                (BinInt.Z.mul
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                   (BinInt.Z.of_nat k)))
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                       (BinInt.Z.add
                          (BinInt.Z.add outbase
                             (BinInt.Z.mul
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                (BinInt.Z.of_nat k)))
                          (BinNums.Zpos
                             (BinNums.xI
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                    fp)
                 match jet_elements_prim.txNullData (jet_elements_prim.txoScript txo) return Prop with
                 | Some parsed =>
                     jet_elements_null_data_environment.elements_null_data_opcode_environment m bout outbase k parsed
                       fp
                 | None => True
                 end)))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : nat) (_ : jet_elements_prim.txOutput) (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments jet_elements_null_data_environment.elements_null_data_output_environment m bt txbase%Z_scope
  bout outbase%Z_scope k%nat_scope txo fp%list_scope
jet_elements_null_data_environment.elements_null_data_environment_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : jet_elements_prim.Elements.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Values.block
              (fun bout : Values.block =>
               @ex BinNums.Z
                 (fun outbase : BinNums.Z =>
                  and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                    (and (BinInt.Z.le BinNums.Z0 ebase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                             Integers.Ptrofs.max_unsigned)
                          (and (BinInt.Z.le BinNums.Z0 txbase)
                             (and
                                (BinInt.Z.le
                                   (BinInt.Z.add txbase
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO ...))))))))
                                   Integers.Ptrofs.max_unsigned)
                                (and
                                   (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                      (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                                   (and
                                      (@eq (option Values.val)
                                         (Memory.Mem.load AST.Mint64 m bt
                                            (BinInt.Z.add txbase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                         (@Some Values.val
                                            (Values.Vlong
                                               (Integers.Int64.repr
                                                  (BinInt.Z.of_nat
                                                     (@length jet_elements_prim.txOutput
                                                        (jet_elements_prim.sigTxOut ...)))))))
                                      (and
                                         (@List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                                            (@pair (prod Values.block BinNums.Z) BinNums.Z
                                               (@pair Values.block BinNums.Z be ebase)
                                               (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO ...))))) fp)
                                         (and
                                            (@List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                                               (@pair (prod Values.block BinNums.Z) BinNums.Z
                                                  (@pair Values.block BinNums.Z bt
                                                     (BinInt.Z.add txbase (BinNums.Zpos ...)))
                                                  (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO ...)))) fp)
                                            (forall (k : nat) (txo : jet_elements_prim.txOutput)
                                               (_ : @eq (option jet_elements_prim.txOutput)
                                                      (@List.nth_error jet_elements_prim.txOutput
                                                         (jet_elements_prim.sigTxOut (...)) k)
                                                      (@Some jet_elements_prim.txOutput txo)),
                                             jet_elements_null_data_environment.elements_null_data_output_environment m
                                               bt txbase bout outbase k txo fp)))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : jet_elements_prim.Elements.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments jet_elements_null_data_environment.elements_null_data_environment_rep m env environment fp%list_scope
jet_application_context_contract.application_jet_bitmachine_spec =
fun (f : Clight.function) (ge : Clight.genv) (E : Set) (A B : Ty.Ty)
  (env_rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E)
               (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
  (spec : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)) =>
forall (logical_env : E) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (s : RunState)
  (a : Ty.tySem A) (tail : list Cell) (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z))
  (_ : env_rep m env logical_env fp)
  (_ : @List.Forall (prod (prod Values.block BinNums.Z) BinNums.Z)
         (fun pat : prod (prod Values.block BinNums.Z) BinNums.Z =>
          match pat return Prop with
          | pair y hi =>
              match y return Prop with
              | pair b lo =>
                  out_sep (frames_blk L) (item_ofs (active_write_loc L)) (cells_blk L) (edge_ofs (active_write_loc L))
                    (BinInt.Z.of_nat (writeEmpty (activeWriteFrame s))) (BinInt.Z.of_nat (bitSize B)) b lo hi
              end
          end) fp) (_ : bm_rep m L s) (_ : bm_separated L s) (_ : active_write_writable m L s)
  (_ : @eq (list Cell) (nextData (activeReadFrame s)) (@app Cell (@encode A a) tail))
  (_ : le (bitSize B) (writeEmpty (activeWriteFrame s))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   @ex (Ty.tySem B)
     (fun value : Ty.tySem B =>
      and (@eq (option (Ty.tySem B)) (spec a logical_env) (@Some (Ty.tySem B) value))
        (and
           (ClightBigstep.Clight2.eval_funcall ge m (@Ctypes.Internal Clight.function f) (jet_args env L) Events.E0 mf
              (Values.Vint Integers.Int.one))
           (bm_rep mf L
              (Build_RunState (inactiveReadFrames s) (activeReadFrame s)
                 (Build_WriteFrame (@app Cell (@List.rev Cell (@encode B value)) (writeData (activeWriteFrame s)))
                    (Nat.sub (writeEmpty (activeWriteFrame s)) (@length Cell (@encode B value))))
                 (inactiveWriteFrames s))))))
     : forall (_ : Clight.function) (_ : Clight.genv) (E : Set) (A B : Ty.Ty)
         (_ : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E)
                (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
         (_ : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)), Prop

Arguments jet_application_context_contract.application_jet_bitmachine_spec f ge E%type_scope
  (A B)%ty_scope (env_rep spec)%function_scope
Inductive
null_data_parse
    : forall (_ : list Integers.Byte.int) (_ : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int))), Prop :=
    null_data_parse_nil : jet_elements_null_data_parse.null_data_parse (@nil Integers.Byte.int)
                            (@nil (jet_elements_prim.txNullDatumF (list Integers.Byte.int)))
  | null_data_parse_cons : forall (bs : list Integers.Byte.int)
                             (d : jet_elements_prim.txNullDatumF (list Integers.Byte.int))
                             (rest : list Integers.Byte.int)
                             (ds : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int)))
                             (_ : @eq
                                    (option
                                       (prod (jet_elements_prim.txNullDatumF (list Integers.Byte.int))
                                          (list Integers.Byte.int))) (jet_elements_prim.getTxNullDatum bs)
                                    (@Some
                                       (prod (jet_elements_prim.txNullDatumF (list Integers.Byte.int))
                                          (list Integers.Byte.int))
                                       (@pair (jet_elements_prim.txNullDatumF (list Integers.Byte.int))
                                          (list Integers.Byte.int) d rest)))
                             (_ : jet_elements_null_data_parse.null_data_parse rest ds),
                           jet_elements_null_data_parse.null_data_parse bs
                             (@cons (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) d ds).

Arguments jet_elements_null_data_parse.null_data_parse (_ _)%list_scope
Arguments jet_elements_null_data_parse.null_data_parse_cons bs%list_scope d (rest ds)%list_scope _ _
jet_elements_null_data_literal.haskell_encode_null_datum =
fun d : jet_elements_prim.txNullDatumF Digest.hash256 =>
match
  d
  return
    (Ty.tySem
       (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
          (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))
with
| jet_elements_prim.Immediate h =>
    @inl (prod (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Sum Ty.Unit Ty.Unit))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S O)))))
      (@pair (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (haskell_to_word (S O) BinNums.Z0)
         (haskell_to_word (S (S (S (S (S (S (S (S O))))))))
            (jet_haskell_hash_word.haskell_integer_hash256 (Digest.hash256_to_bytelist h))))
| jet_elements_prim.PushData h =>
    @inl (prod (Ty.tySem (Word.Word (S O))) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Sum Ty.Unit Ty.Unit))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
