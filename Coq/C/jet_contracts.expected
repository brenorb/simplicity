vector_items_spec =
fix vector_items_spec (X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra) {struct n} :
    list (Alg.Core.domain term (Word.Vector X n) X) :=
  match n as n0 return (list (Alg.Core.domain term (Word.Vector X n0) X)) with
  | O =>
      @cons (Alg.Core.domain term (Word.Vector X O) (Word.Vector X O)) (@VC.iden (Word.Vector X O) term)
        (@nil (Alg.Core.domain term (Word.Vector X O) (Word.Vector X O)))
  | S n0 =>
      @app (Alg.Core.domain term (Ty.Prod (Word.Vector X n0) (Word.Vector X n0)) X)
        (@List.map (Alg.Core.domain term (Word.Vector X n0) X)
           (Alg.Core.domain term (Ty.Prod (Word.Vector X n0) (Word.Vector X n0)) X)
           (@VC.take (Word.Vector X n0) (Word.Vector X n0) X term) (vector_items_spec X n0 term))
        (@List.map (Alg.Core.domain term (Word.Vector X n0) X)
           (Alg.Core.domain term (Ty.Prod (Word.Vector X n0) (Word.Vector X n0)) X)
           (@VC.drop (Word.Vector X n0) (Word.Vector X n0) X term) (vector_items_spec X n0 term))
  end
     : forall (X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra), list (Alg.Core.domain term (Word.Vector X n) X)

Arguments vector_items_spec X%ty_scope n%nat_scope {term}
left_rotate_control_step =
fun (m : nat) (X : Ty.Ty) (n i : nat) (term : Alg.Core.Algebra) =>
@VC.pair (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Word m) (Word.Vector X n) term
  (@VC.take (Word.Word m) (Word.Vector X n) (Word.Word m) term (@VC.iden (Word.Word m) term))
  (@VC.comp (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector X n))
     (Word.Vector X n) term
     (@VC.pair (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector X n) term
        (@VC.take (Word.Word m) (Word.Vector X n) (Ty.Sum Ty.Unit Ty.Unit) term (@word_bit_spec m i term))
        (@VC.drop (Word.Word m) (Word.Vector X n) (Word.Vector X n) term (@VC.iden (Word.Vector X n) term)))
     (@Bit.cond (Word.Vector X n) (Word.Vector X n) term (@Word.left_rotate1 X n term)
        (@VC.iden (Word.Vector X n) term)))
     : forall (m : nat) (X : Ty.Ty) (n _ : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Prod (Word.Word m) (Word.Vector X n))

Arguments left_rotate_control_step m%nat_scope X%ty_scope (n i)%nat_scope {term}
left_rotate_controls_spec =
fix left_rotate_controls_spec
  (m : nat) (X : Ty.Ty) (n : nat) (indices : list nat) (term : Alg.Core.Algebra) {struct n} :
    Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Vector X n) :=
  match n as n0 return (Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n0)) (Word.Vector X n0)) with
  | O =>
      match indices return (Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X O)) (Word.Vector X O)) with
      | nil => @VC.drop (Word.Word m) (Word.Vector X O) (Word.Vector X O) term (@VC.iden (Word.Vector X O) term)
      | cons i _ =>
          @VC.comp (Ty.Prod (Word.Word m) (Word.Vector X O)) (Ty.Prod (Word.Word m) (Word.Vector X O))
            (Word.Vector X O) term (@left_rotate_control_step m X O i term)
            (@VC.drop (Word.Word m) (Word.Vector X O) (Word.Vector X O) term (@VC.iden (Word.Vector X O) term))
      end
  | S n0 =>
      match
        indices return (Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X (S n0))) (Word.Vector X (S n0)))
      with
      | nil =>
          @VC.drop (Word.Word m) (Word.Vector X (S n0)) (Word.Vector X (S n0)) term
            (@VC.iden (Word.Vector X (S n0)) term)
      | cons i rest =>
          @VC.comp (Ty.Prod (Word.Word m) (Word.Vector X (S n0))) (Ty.Prod (Word.Word m) (Word.Vector X (S n0)))
            (Word.Vector X (S n0)) term (@left_rotate_control_step m X (S n0) i term)
            (@eq_rect Ty.Ty (Word.Vector (Ty.Prod X X) n0)
               (fun V : Ty.Ty => Alg.Core.domain term (Ty.Prod (Word.Word m) V) V)
               (left_rotate_controls_spec m (Ty.Prod X X) n0 rest term) (Word.Vector X (S n0))
               (@eq_sym Ty.Ty (Word.Vector X (S n0)) (Word.Vector (Ty.Prod X X) n0) (@Word.VectorPromote X n0)))
      end
  end
     : forall (m : nat) (X : Ty.Ty) (n : nat) (_ : list nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Vector X n)

Arguments left_rotate_controls_spec m%nat_scope X%ty_scope n%nat_scope indices%list_scope {term}
left_rotate_word_spec =
fun (m n : nat) (term : Alg.Core.Algebra) =>
@left_rotate_controls_spec m (Ty.Sum Ty.Unit Ty.Unit) n (List.seq O (PeanoNat.Nat.pow (S (S O)) m)) term
     : forall (m n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n)

Arguments left_rotate_word_spec (m n)%nat_scope {term}
left_rotate_byte_spec =
fun (s : byte_rotate_size) (term : Alg.Core.Algebra) =>
@left_rotate_word_spec (S (S (S O))) (wide_log (byte_rotate_width s)) term
     : forall (s : byte_rotate_size) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s))))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s)))

Arguments left_rotate_byte_spec s {term}
rotate_low_controls_fun =
fix rotate_low_controls_fun
  (n i count : nat) (amount : Ty.tySem (Word.Word (S (S (S O))))) (x : Ty.tySem (Word.Word n)) {struct count} :
    Ty.tySem (Word.Word n) :=
  match count return (Ty.tySem (Word.Word n)) with
  | O => x
  | S count0 =>
      rotate_low_controls_fun n (S i) count0 amount
        match @word_bit_spec (S (S (S O))) i Alg.CoreFunSem amount return (Ty.tySem (Word.Word n)) with
        | inl _ => x
        | inr _ =>
            @Word.rotate_const (Ty.Sum Ty.Unit Ty.Unit) n Alg.CoreFunSem
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat i)) x
        end
  end
     : forall (n _ : nat) (_ : nat) (_ : Ty.tySem (Word.Word (S (S (S O))))) (_ : Ty.tySem (Word.Word n)),
       Ty.tySem (Word.Word n)

Arguments rotate_low_controls_fun (n i count)%nat_scope amount x
rotate_control_amount =
fix rotate_control_amount (i count : nat) (amount : Ty.tySem (Word.Word (S (S (S O))))) {struct count} : BinNums.Z :=
  match count return BinNums.Z with
  | O => BinNums.Z0
  | S count0 =>
      BinInt.Z.add
        match @word_bit_spec (S (S (S O))) i Alg.CoreFunSem amount return BinNums.Z with
        | inl _ => BinNums.Z0
        | inr _ => BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat i)
        end (rotate_control_amount (S i) count0 amount)
  end
     : forall (_ : nat) (_ : nat) (_ : Ty.tySem (Word.Word (S (S (S O))))), BinNums.Z

Arguments rotate_control_amount (i count)%nat_scope amount
right_rotate_control_step =
fun (m : nat) (X : Ty.Ty) (n i : nat) (term : Alg.Core.Algebra) =>
@RVC.pair (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Word m) (Word.Vector X n) term
  (@RVC.take (Word.Word m) (Word.Vector X n) (Word.Word m) term (@RVC.iden (Word.Word m) term))
  (@RVC.comp (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector X n))
     (Word.Vector X n) term
     (@RVC.pair (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Sum Ty.Unit Ty.Unit) (Word.Vector X n) term
        (@RVC.take (Word.Word m) (Word.Vector X n) (Ty.Sum Ty.Unit Ty.Unit) term (@word_bit_spec m i term))
        (@RVC.drop (Word.Word m) (Word.Vector X n) (Word.Vector X n) term (@RVC.iden (Word.Vector X n) term)))
     (@Bit.cond (Word.Vector X n) (Word.Vector X n) term (@Word.right_rotate1 X n term)
        (@RVC.iden (Word.Vector X n) term)))
     : forall (m : nat) (X : Ty.Ty) (n _ : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Prod (Word.Word m) (Word.Vector X n))

Arguments right_rotate_control_step m%nat_scope X%ty_scope (n i)%nat_scope {term}
right_rotate_controls_spec =
fix right_rotate_controls_spec
  (m : nat) (X : Ty.Ty) (n : nat) (indices : list nat) (term : Alg.Core.Algebra) {struct n} :
    Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Vector X n) :=
  match n as n0 return (Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n0)) (Word.Vector X n0)) with
  | O =>
      match indices return (Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X O)) (Word.Vector X O)) with
      | nil => @RVC.drop (Word.Word m) (Word.Vector X O) (Word.Vector X O) term (@RVC.iden (Word.Vector X O) term)
      | cons i _ =>
          @RVC.comp (Ty.Prod (Word.Word m) (Word.Vector X O)) (Ty.Prod (Word.Word m) (Word.Vector X O))
            (Word.Vector X O) term (@right_rotate_control_step m X O i term)
            (@RVC.drop (Word.Word m) (Word.Vector X O) (Word.Vector X O) term (@RVC.iden (Word.Vector X O) term))
      end
  | S n0 =>
      match
        indices return (Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X (S n0))) (Word.Vector X (S n0)))
      with
      | nil =>
          @RVC.drop (Word.Word m) (Word.Vector X (S n0)) (Word.Vector X (S n0)) term
            (@RVC.iden (Word.Vector X (S n0)) term)
      | cons i rest =>
          @RVC.comp (Ty.Prod (Word.Word m) (Word.Vector X (S n0))) (Ty.Prod (Word.Word m) (Word.Vector X (S n0)))
            (Word.Vector X (S n0)) term (@right_rotate_control_step m X (S n0) i term)
            (@eq_rect Ty.Ty (Word.Vector (Ty.Prod X X) n0)
               (fun V : Ty.Ty => Alg.Core.domain term (Ty.Prod (Word.Word m) V) V)
               (right_rotate_controls_spec m (Ty.Prod X X) n0 rest term) (Word.Vector X (S n0))
               (@eq_sym Ty.Ty (Word.Vector X (S n0)) (Word.Vector (Ty.Prod X X) n0) (@Word.VectorPromote X n0)))
      end
  end
     : forall (m : nat) (X : Ty.Ty) (n : nat) (_ : list nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Vector X n)

Arguments right_rotate_controls_spec m%nat_scope X%ty_scope n%nat_scope indices%list_scope {term}
right_rotate_word_spec =
fun (m n : nat) (term : Alg.Core.Algebra) =>
@right_rotate_controls_spec m (Ty.Sum Ty.Unit Ty.Unit) n (List.seq O (PeanoNat.Nat.pow (S (S O)) m)) term
     : forall (m n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word m) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n)

Arguments right_rotate_word_spec (m n)%nat_scope {term}
right_rotate_byte_spec =
fun (s : byte_rotate_size) (term : Alg.Core.Algebra) =>
@right_rotate_word_spec (S (S (S O))) (wide_log (byte_rotate_width s)) term
     : forall (s : byte_rotate_size) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s))))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s)))

Arguments right_rotate_byte_spec s {term}
right_rotate_low_controls_fun =
fix right_rotate_low_controls_fun
  (n i count : nat) (amount : Ty.tySem (Word.Word (S (S (S O))))) (x : Ty.tySem (Word.Word n)) {struct count} :
    Ty.tySem (Word.Word n) :=
  match count return (Ty.tySem (Word.Word n)) with
  | O => x
  | S count0 =>
      right_rotate_low_controls_fun n (S i) count0 amount
        match @word_bit_spec (S (S (S O))) i Alg.CoreFunSem amount return (Ty.tySem (Word.Word n)) with
        | inl _ => x
        | inr _ =>
            @Word.rotate_const (Ty.Sum Ty.Unit Ty.Unit) n Alg.CoreFunSem
              (BinInt.Z.opp (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat i))) x
        end
  end
     : forall (n _ : nat) (_ : nat) (_ : Ty.tySem (Word.Word (S (S (S O))))) (_ : Ty.tySem (Word.Word n)),
       Ty.tySem (Word.Word n)

Arguments right_rotate_low_controls_fun (n i count)%nat_scope amount x
