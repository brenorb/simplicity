compact_fun (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
  (int_table scalar_mul512_functions)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_scalar_mul_512
  (@cons sx (XP O BinNums.Z0) (@cons sx (XP (S O) BinNums.Z0) (@cons sx (XP (S O) BinNums.Z0) (@nil sx))))
  scalar_square512_regs (@nil event) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))
     : option res
scalar_square512_state =
match scalar_square512_run return sstate with
| Some r =>
    match r return sstate with
    | RDone st _ => st
    | RIf _ _ _ => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
    end
| None => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
end
     : sstate
