vector_bits =
fix vector_bits (T : Word.ToZ.type) (n : nat) {struct n} : nat :=
  match n return nat with
  | O => Word.ToZ.Theory.bitSize T
  | S n0 => Nat.add (vector_bits T n0) (vector_bits T n0)
  end
     : forall (_ : Word.ToZ.type) (_ : nat), nat

Arguments vector_bits T n%nat_scope
vector_value =
fix vector_value (T : Word.ToZ.type) (n : nat) {struct n} :
    forall _ : Ty.tySem (Word.Vector (Word.ToZ.obj T) n), BinNums.Z :=
  match n as n0 return (forall _ : Ty.tySem (Word.Vector (Word.ToZ.obj T) n0), BinNums.Z) with
  | O => fun x : Ty.tySem (Word.Vector (Word.ToZ.obj T) O) => @Word.ToZ.Theory.toZ T x
  | S n0 =>
      fun x : Ty.tySem (Word.Vector (Word.ToZ.obj T) (S n0)) =>
      BinInt.Z.add
        (BinInt.Z.mul
           (vector_value T n0
              (@fst
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                        match n1 return Ty.Ty with
                        | O => X
                        | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                        end) (Word.ToZ.obj T) n0))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                        match n1 return Ty.Ty with
                        | O => X
                        | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                        end) (Word.ToZ.obj T) n0)) x)) (Zpower.two_power_nat (vector_bits T n0)))
        (vector_value T n0
           (@snd
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                     match n1 return Ty.Ty with
                     | O => X
                     | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                     end) (Word.ToZ.obj T) n0))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n1 : nat) {struct n1} : Ty.Ty :=
                     match n1 return Ty.Ty with
                     | O => X
                     | S n2 => Ty.Prod (Vector X n2) (Vector X n2)
                     end) (Word.ToZ.obj T) n0)) x))
  end
     : forall (T : Word.ToZ.type) (n : nat) (_ : Ty.tySem (Word.Vector (Word.ToZ.obj T) n)), BinNums.Z

Arguments vector_value T n%nat_scope _
pair_type_eq =
fun (A B C D : Ty.Ty) (e : @eq Ty.Ty A C) (f : @eq Ty.Ty B D) =>
match e in (eq _ a) return (@eq Ty.Ty (Ty.Prod A B) (Ty.Prod a D)) with
| eq_refl =>
    match f in (eq _ a) return (@eq Ty.Ty (Ty.Prod A B) (Ty.Prod A a)) with
    | eq_refl => @eq_refl Ty.Ty (Ty.Prod A B)
    end
end
     : forall (A B C D : Ty.Ty) (_ : @eq Ty.Ty A C) (_ : @eq Ty.Ty B D), @eq Ty.Ty (Ty.Prod A B) (Ty.Prod C D)

Arguments pair_type_eq A B C D e f
vector_word_eq =
fix vector_word_eq (n m : nat) {struct m} : @eq Ty.Ty (Word.Vector (Word.Word n) m) (Word.Word (Nat.add m n)) :=
  match m as m0 return (@eq Ty.Ty (Word.Vector (Word.Word n) m0) (Word.Word (Nat.add m0 n))) with
  | O => @eq_refl Ty.Ty (Word.Vector (Word.Word n) O)
  | S k =>
      pair_type_eq (Word.Vector (Word.Word n) k) (Word.Vector (Word.Word n) k) (Word.Word (Nat.add k n))
        (Word.Word (Nat.add k n)) (vector_word_eq n k) (vector_word_eq n k)
  end
     : forall n m : nat, @eq Ty.Ty (Word.Vector (Word.Word n) m) (Word.Word (Nat.add m n))

Arguments vector_word_eq (n m)%nat_scope
full_left_word_spec =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@eq_rect Ty.Ty (Word.Vector (Word.Word n) m)
  (fun V : Ty.Ty => Alg.Core.domain term (Ty.Prod V (Word.Word n)) (Ty.Prod (Word.Word n) V))
  (@Word.full_left_shift1 (Word.Word n) m term) (Word.Word (Nat.add m n)) (vector_word_eq n m)
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n))
         (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n)))

Arguments full_left_word_spec (n m)%nat_scope {term}
full_right_word_spec =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@eq_rect Ty.Ty (Word.Vector (Word.Word n) m)
  (fun V : Ty.Ty => Alg.Core.domain term (Ty.Prod (Word.Word n) V) (Ty.Prod V (Word.Word n)))
  (@Word.full_right_shift1 (Word.Word n) m term) (Word.Word (Nat.add m n)) (vector_word_eq n m)
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n)))
         (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n))

Arguments full_right_word_spec (n m)%nat_scope {term}
division_pre_shift_step =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n)))
  (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n)) term
  (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n)))
     (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word n)) (Word.Word (Nat.add (S m) n)) term
     (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n)))
        (Word.Word (Nat.add (S m) n)) (Word.Word n) term
        (@Alg.Core.Combinators.take (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n))
           (Word.Word (Nat.add (S m) n)) term (@Alg.Core.Combinators.iden (Word.Word (Nat.add (S m) n)) term))
        (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n))) Ty.Unit
           (Word.Word n) term
           (@Alg.Core.Combinators.unit (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n))) term)
           (@Word.zero n term)))
     (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word n))
        (Ty.Prod (Word.Word n) (Word.Word (Nat.add (S m) n))) (Word.Word (Nat.add (S m) n)) term
        (@full_left_word_spec n (S m) term)
        (@Alg.Core.Combinators.drop (Word.Word n) (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add (S m) n)) term
           (@Alg.Core.Combinators.iden (Word.Word (Nat.add (S m) n)) term))))
  (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n)))
     (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n)) (Word.Word (Nat.add m n)) term
     (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n)))
        (Word.Word (Nat.add m n)) (Word.Word n) term
        (@Alg.Core.Combinators.drop (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n))
           (Word.Word (Nat.add m n)) term (@Alg.Core.Combinators.iden (Word.Word (Nat.add m n)) term))
        (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n))) Ty.Unit
           (Word.Word n) term
           (@Alg.Core.Combinators.unit (Ty.Prod (Word.Word (Nat.add (S m) n)) (Word.Word (Nat.add m n))) term)
           (@Word.zero n term)))
     (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n))
        (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n))) (Word.Word (Nat.add m n)) term
        (@full_left_word_spec n m term)
        (@Alg.Core.Combinators.drop (Word.Word n) (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)) term
           (@Alg.Core.Combinators.iden (Word.Word (Nat.add m n)) term))))
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)))
         (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)))

Arguments division_pre_shift_step (n m)%nat_scope {term}
division_post_shift_step =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) (Word.Word (Nat.add m n))
  (Word.Word (Nat.add m n)) term
  (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
     (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n))) (Word.Word (Nat.add m n)) term
     (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
        (Word.Word n) (Word.Word (Nat.add m n)) term
        (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) Ty.Unit
           (Word.Word n) term
           (@Alg.Core.Combinators.unit (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term)
           (@Word.zero n term))
        (@Alg.Core.Combinators.take (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)) term
           (@Alg.Core.Combinators.iden (Word.Word (Nat.add m n)) term)))
     (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n)))
        (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n)) (Word.Word (Nat.add m n)) term
        (@full_right_word_spec n m term)
        (@Alg.Core.Combinators.take (Word.Word (Nat.add m n)) (Word.Word n) (Word.Word (Nat.add m n)) term
           (@Alg.Core.Combinators.iden (Word.Word (Nat.add m n)) term))))
  (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
     (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n)) (Word.Word (Nat.add m n)) term
     (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
        (Word.Word (Nat.add m n)) (Word.Word n) term
        (@Alg.Core.Combinators.drop (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)) term
           (@Alg.Core.Combinators.iden (Word.Word (Nat.add m n)) term))
        (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) Ty.Unit
           (Word.Word n) term
           (@Alg.Core.Combinators.unit (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term)
           (@Word.zero n term)))
     (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word n))
        (Ty.Prod (Word.Word n) (Word.Word (Nat.add m n))) (Word.Word (Nat.add m n)) term
        (@full_left_word_spec n m term)
        (@Alg.Core.Combinators.drop (Word.Word n) (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)) term
           (@Alg.Core.Combinators.iden (Word.Word (Nat.add m n)) term))))
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
         (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))

Arguments division_post_shift_step (n m)%nat_scope {term}
division_leftmost_block =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@eq_rect Ty.Ty (Word.Vector (Word.Word n) m) (fun V : Ty.Ty => Alg.Core.domain term V (Word.Word n))
  (@Word.leftmost (Word.Word n) m term) (Word.Word (Nat.add m n)) (vector_word_eq n m)
     : forall (n m : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (Word.Word (Nat.add m n)) (Word.Word n)

Arguments division_leftmost_block (n m)%nat_scope {term}
division_pre_state = fun w : nat => Ty.Prod (Word.Word (S w)) (Word.Word w)
     : forall _ : nat, Ty.Ty

Arguments division_pre_state w%nat_scope
division_post_state = fun w : nat => Ty.Prod (Word.Word w) (Word.Word w)
     : forall _ : nat, Ty.Ty

Arguments division_post_state w%nat_scope
cast_state_endo =
fun (F : forall _ : nat, Ty.Ty) (p q : nat) (e : @eq nat p q) (term : Alg.Core.Algebra)
  (f : Alg.Core.domain term (F p) (F p)) => @eq_rect nat p (fun w : nat => Alg.Core.domain term (F w) (F w)) f q e
     : forall (F : forall _ : nat, Ty.Ty) (p q : nat) (_ : @eq nat p q) (term : Alg.Core.Algebra)
         (_ : Alg.Core.domain term (F p) (F p)), Alg.Core.domain term (F q) (F q)

Arguments cast_state_endo F%function_scope (p q)%nat_scope e {term} f
division_pre_branch =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))))
  (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term
  (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)))
     (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term
     (@Alg.Core.Combinators.drop (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)) (Ty.Sum Ty.Unit Ty.Unit) term
        (@Alg.Core.Combinators.comp (Word.Word (Nat.add m n)) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term
           (@division_leftmost_block n m term) (@is_zero_word_spec n term)))
     (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term))
  (@Bit.cond (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n)))
     (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term (@division_pre_shift_step n m term)
     (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word (S (Nat.add m n))) (Word.Word (Nat.add m n))) term))
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (division_pre_state (Nat.add m n)) (division_pre_state (Nat.add m n))

Arguments division_pre_branch (n m)%nat_scope {term}
division_post_branch =
fun (n m : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))))
  (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term
  (@Alg.Core.Combinators.pair (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
     (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term
     (@Alg.Core.Combinators.drop (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)) (Ty.Sum Ty.Unit Ty.Unit) term
        (@Alg.Core.Combinators.comp (Word.Word (Nat.add m n)) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term
           (@division_leftmost_block n m term) (@is_zero_word_spec n term)))
     (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term))
  (@Bit.cond (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n)))
     (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term (@division_post_shift_step n m term)
     (@Alg.Core.Combinators.iden (Ty.Prod (Word.Word (Nat.add m n)) (Word.Word (Nat.add m n))) term))
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (division_post_state (Nat.add m n)) (division_post_state (Nat.add m n))

Arguments division_post_branch (n m)%nat_scope {term}
division_pre_shift_spec =
fix division_pre_shift_spec (n m : nat) (term : Alg.Core.Algebra) {struct n} :
    Alg.Core.domain term (division_pre_state (Nat.add m n)) (division_pre_state (Nat.add m n)) :=
  match
    n as n0 return (Alg.Core.domain term (division_pre_state (Nat.add m n0)) (division_pre_state (Nat.add m n0)))
  with
  | O => @Alg.Core.Combinators.iden (division_pre_state (Nat.add m O)) term
  | S n0 =>
      @cast_state_endo division_pre_state (Nat.add (S m) n0) (Nat.add m (S n0))
        (@eq_sym nat (PeanoNat.Nat.add m (S n0)) (S (PeanoNat.Nat.add m n0)) (PeanoNat.Nat.add_succ_r m n0)) term
        (@Alg.Core.Combinators.comp (division_pre_state (Nat.add (S m) n0)) (division_pre_state (Nat.add (S m) n0))
           (division_pre_state (Nat.add (S m) n0)) term (@division_pre_branch n0 (S m) term)
           (division_pre_shift_spec n0 (S m) term))
  end
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (division_pre_state (Nat.add m n)) (division_pre_state (Nat.add m n))

Arguments division_pre_shift_spec (n m)%nat_scope {term}
division_post_shift_spec =
fix division_post_shift_spec (n m : nat) (term : Alg.Core.Algebra) {struct n} :
    Alg.Core.domain term (division_post_state (Nat.add m n)) (division_post_state (Nat.add m n)) :=
  match
    n as n0 return (Alg.Core.domain term (division_post_state (Nat.add m n0)) (division_post_state (Nat.add m n0)))
  with
  | O => @Alg.Core.Combinators.iden (division_post_state (Nat.add m O)) term
  | S n0 =>
      @cast_state_endo division_post_state (Nat.add (S m) n0) (Nat.add m (S n0))
        (@eq_sym nat (PeanoNat.Nat.add m (S n0)) (S (PeanoNat.Nat.add m n0)) (PeanoNat.Nat.add_succ_r m n0)) term
        (@Alg.Core.Combinators.comp (division_post_state (Nat.add (S m) n0)) (division_post_state (Nat.add (S m) n0))
           (division_post_state (Nat.add (S m) n0)) term (@division_post_branch n0 (S m) term)
           (division_post_shift_spec n0 (S m) term))
  end
     : forall (n m : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (division_post_state (Nat.add m n)) (division_post_state (Nat.add m n))

Arguments division_post_shift_spec (n m)%nat_scope {term}
division_high_word =
