                  (@canonical_scalar_normalize Alg.CoreFunSem x))) canonical_group_order)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_negate Alg.CoreFunSem x))
scalar_negate_run_eq
     : @eq (option res) scalar_negate_run (@Some res (RDone scalar_negate_state ONormal))
scalar_negate_return
     : @eq (option sx) (@Maps.PTree.get sx BinNums.xH (stemps scalar_negate_state)) (@None sx)
scalar_negate_output_shape
     : @ex (list sx)
         (fun limbs : list sx =>
          and (@eq nat (@length sx limbs) (S (S (S (S O)))))
            (@eq (list region) (sregs scalar_negate_state)
               (@cons region
                  (mkreg (u64_cells BinNums.Z0 limbs) true
                     (@Some BinNums.Z
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (@nil region))))
scalar_negate_output_owned
     : and (@eq nat (@length region (sregs scalar_negate_state)) (S O))
         (@eq (option BinNums.Z)
            (rfree (@List.nth region O (sregs scalar_negate_state) (mkreg (@nil cell) false (@None BinNums.Z))))
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
scalar_negate_limbs_length
     : @eq nat (@length sx scalar_negate_limbs) (S (S (S (S O))))
scalar_negate_regions_exact
     : @eq (list region) (sregs scalar_negate_state)
         (@cons region
            (mkreg (u64_cells BinNums.Z0 scalar_negate_limbs) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@nil region))
scalar_negate_limbs_long
     : @List.Forall sx (fun x : sx => @eq bool (isk KL x) true) scalar_negate_limbs
eval_scalar_negate_from_owned_region
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout scalar_writer_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (rep rho layout (sregs scalar_negate_state) mf)
               (lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (foot layout
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           scalar_writer_initial_regs) b ofs)) m mf)))
scalar_negate_final_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout (sregs scalar_negate_state) m),
       and (@eq BinNums.Z (bas layout O) BinNums.Z0)
         (and
            (Memory.Mem.range_perm m (blk layout O) BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
               Memtype.Freeable)
            (forall (i : nat) (x : sx) (_ : @eq (option sx) (@List.nth_error sx scalar_negate_limbs i) (@Some sx x)),
             @eq (option Values.val)
               (Memory.Mem.load AST.Mint64 m (blk layout O)
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
               (@Some Values.val (Values.Vlong (il (den rho (lay layout) x))))))
scalar_negate_output_exact
     : @eq (list sx) scalar_negate_limbs
         (@List.map sx sx (fun x : sx => XLb Band x scalar_negate_mask) scalar_negate_raw)
scalar_negate_delta0_value
     : @eq Integers.Int64.int
         (Integers.Int64.add
            (Integers.Int64.repr
               (BinNums.Zneg
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xO
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xO
                                                               (BinNums.xI
                                                                  (BinNums.xI
                                                                     (BinNums.xO (BinNums.xO (BinNums.xI ...))))))))))))))))))))))
            (Integers.Int64.repr (Integers.Int.signed Integers.Int.one)))
         (Integers.Int64.repr
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xI
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xO
                                       (BinNums.xI
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xI
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xI
                                                                     (BinNums.xI (BinNums.xO (BinNums.xI ...)))))))))))))))))))))))
scalar_negate_or_zero
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq bool
         (Integers.Int64.eq
            (Integers.Int64.or (Integers.Int64.or (Integers.Int64.or (rho O) (rho (S O))) (rho (S (S O))))
               (rho (S (S (S O))))) Integers.Int64.zero) (BinInt.Z.eqb (scalar_limb_value rho) BinNums.Z0)
scalar_negate_mask_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout scalar_negate_mask)
         (Values.Vlong
            match BinInt.Z.eqb (scalar_limb_value rho) BinNums.Z0 return Integers.Int64.int with
            | true => Integers.Int64.zero
            | false => Integers.Int64.mone
            end)
scalar_negate_limb_masked
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx),
       @eq Integers.Int64.int (il (den rho layout (XLb Band x scalar_negate_mask)))
         match BinInt.Z.eqb (scalar_limb_value rho) BinNums.Z0 return Integers.Int64.int with
         | true => Integers.Int64.zero
         | false => il (den rho layout x)
         end
scalar_negate_raw_values
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       let s0 : BinNums.Z :=
         BinInt.Z.add (BinInt.Z.sub Integers.Int64.max_unsigned (Integers.Int64.unsigned (rho O)))
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO
                                (BinNums.xI
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xI
                                                           (BinNums.xO
                                                              (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (...))))))))))))))))))))))
         in
       let s1 : BinNums.Z :=
         BinInt.Z.add
           (BinInt.Z.add (BinInt.Z.div s0 Integers.Int64.modulus)
              (BinInt.Z.sub Integers.Int64.max_unsigned (Integers.Int64.unsigned (rho (S O)))))
           (BinNums.Zpos
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xO
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xI
                                                        (BinNums.xO
                                                           (BinNums.xI
                                                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))))))))))))))))
         in
       let s2 : BinNums.Z :=
         BinInt.Z.add
           (BinInt.Z.add (BinInt.Z.div s1 Integers.Int64.modulus)
              (BinInt.Z.sub Integers.Int64.max_unsigned (Integers.Int64.unsigned (rho (S (S O))))))
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI
                                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
         in
       let s3 : BinNums.Z :=
         BinInt.Z.add
           (BinInt.Z.add (BinInt.Z.div s2 Integers.Int64.modulus)
              (BinInt.Z.sub Integers.Int64.max_unsigned (Integers.Int64.unsigned (rho (S (S (S O)))))))
           (BinNums.Zpos
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI
                                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))
         in
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_negate_low0)))
            (BinInt.Z.modulo s0 Integers.Int64.modulus))
         (and
            (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_negate_low1)))
               (BinInt.Z.modulo s1 Integers.Int64.modulus))
            (and
               (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_negate_low2)))
                  (BinInt.Z.modulo s2 Integers.Int64.modulus))
               (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_negate_low3)))
                  (BinInt.Z.modulo s3 Integers.Int64.modulus))))
scalar_negate_raw_weighted_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (scalar_negate_raw_value rho layout)
         (BinInt.Z.modulo (BinInt.Z.sub canonical_group_order (scalar_limb_value rho))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
scalar_negate_masked_weighted_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (scalar_negate_output_value rho layout)
         match BinInt.Z.eqb (scalar_limb_value rho) BinNums.Z0 return BinNums.Z with
         | true => BinNums.Z0
         | false => scalar_negate_raw_value rho layout
         end
scalar_negate_normalized_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 (scalar_limb_value rho))
                (BinInt.Z.lt (scalar_limb_value rho) canonical_group_order)),
       @eq BinNums.Z (scalar_negate_output_value rho layout)
         (BinInt.Z.modulo (BinInt.Z.opp (scalar_limb_value rho)) canonical_group_order)
scalar_negate_output_limbs_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Integers.Int64.int)
         (@List.map sx Integers.Int64.int (fun x : sx => il (den rho layout x)) scalar_negate_limbs)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (scalar_limbs_of (scalar_negate_output_value rho layout)))
scalar_negate_output_scalar_at
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout (sregs scalar_negate_state) m),
       and
         (scalar_at m (blk layout O) (bas layout O)
            (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
               (scalar_limbs_of (scalar_negate_output_value rho (lay layout)))))
         (Memory.Mem.range_perm m (blk layout O) BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
eval_scalar_negate_numeric_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout scalar_writer_initial_regs m)
         (_ : and (BinInt.Z.le BinNums.Z0 (scalar_limb_value rho))
                (BinInt.Z.lt (scalar_limb_value rho) canonical_group_order)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (scalar_at mf (blk layout O) (bas layout O)
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (scalar_limbs_of (BinInt.Z.modulo (BinInt.Z.opp (scalar_limb_value rho)) canonical_group_order))))
               (and
                  (Memory.Mem.range_perm mf (blk layout O) BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (foot layout
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              scalar_writer_initial_regs) b ofs)) m mf))))
scalar_writer_initial_rep_from_negate
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout (sregs scalar_negate_state) m),
       rep (scalar_limb_rho (scalar_negate_output_value rho (lay layout)))
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z (blk layout O) (bas layout O))
            (@nil (prod Values.block BinNums.Z))) scalar_writer_initial_regs m
scalar_limb_rho_value
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq BinNums.Z (scalar_limb_value (scalar_limb_rho value)) value
scalar_negate_normalize_range
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (BinInt.Z.le BinNums.Z0
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@canonical_scalar_normalize Alg.CoreFunSem value)))
         (BinInt.Z.lt
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@canonical_scalar_normalize Alg.CoreFunSem value)) canonical_group_order)
scalar_negate_output_canonical
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq BinNums.Z (scalar_limb_value rho)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@canonical_scalar_normalize Alg.CoreFunSem value))),
       @eq BinNums.Z (scalar_negate_output_value rho layout)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_negate Alg.CoreFunSem value))
eval_scalar_negate_canonical_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : rep rho layout scalar_writer_initial_regs m)
         (_ : @eq BinNums.Z (scalar_limb_value rho)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@canonical_scalar_normalize Alg.CoreFunSem value))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (scalar_at mf (blk layout O) (bas layout O)
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (scalar_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_scalar_negate Alg.CoreFunSem value)))))
               (and
                  (rep
                     (scalar_limb_rho
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_scalar_negate Alg.CoreFunSem value)))
                     (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z (blk layout O) (bas layout O))
                        (@nil (prod Values.block BinNums.Z))) scalar_writer_initial_regs mf)
                  (and
                     (Memory.Mem.range_perm mf (blk layout O) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (foot layout
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 scalar_writer_initial_regs) b ofs)) m mf)))))
scalar_negate_normalize_identity
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (@canonical_scalar_normalize Alg.CoreFunSem (@canonical_scalar_negate Alg.CoreFunSem value))
         (@canonical_scalar_negate Alg.CoreFunSem value)
eval_scalar_read_negate_write_canonical
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bl : Values.block) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mn : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall secp_ge m
                     (@Ctypes.Internal Clight.function jets_secp.f_read_scalar)
                     (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
                     Values.Vundef)
                  (and
                     (ClightBigstep.Clight2.eval_funcall secp_ge mr
                        (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)
                        (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mn
                        Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall secp_ge mn
                           (@Ctypes.Internal Clight.function jets_secp.f_write_scalar)
                           (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                              (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                           Values.Vundef)
                        (and
                           (finv m0 bd dbase bw outedge cursor N bi mf true
                              (@encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                 (@canonical_scalar_negate Alg.CoreFunSem value)))
                           (and
                              (Memory.Mem.range_perm mf ba BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (frame_fields_at mf bl BinNums.Z0 bi edge
                                    (BinInt.Z.add rc
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                 (and
                                    (Memory.Mem.range_perm mf bl BinNums.Z0
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                       Memtype.Cur Memtype.Freeable)
                                    (lframe (secp_locals_outside m0 bd bw bi ba bl) m mf))))))))))
scalar_negate_rest_eq
     : @eq Clight.statement scalar_negate_rest
         (Clight.Ssequence scalar_public_read_stmt
            (Clight.Ssequence scalar_negate_inplace_stmt
               (Clight.Ssequence scalar_normalize_write_stmt
                  (Clight.Sreturn
                     (@Some Clight.expr
                        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint))))))
scalar_negate_symbols
     : and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge)
               jets_secp._secp256k1_scalar_negate)
            (@Some Values.block (secp_symbol_block jets_secp._secp256k1_scalar_negate)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv secp_ge)
               (Values.Vptr (secp_symbol_block jets_secp._secp256k1_scalar_negate) Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)))
exec_scalar_negate_inplace
     : forall (le : Clight.temp_env) (m mf : Memory.Mem.mem) (bl ba : Values.block)
         (_ : ClightBigstep.Clight2.eval_funcall secp_ge m
                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_negate)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                Values.Vundef),
       ClightBigstep.Clight2.exec_stmt secp_ge (scalar_public_env bl ba) le m scalar_negate_inplace_stmt Events.E0 le
         mf ClightBigstep.Out_normal
