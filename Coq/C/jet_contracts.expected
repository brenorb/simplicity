               (@canonical_scalar_normalize Alg.CoreFunSem a)))
         (@eq BinNums.Z (scalar_mul512_input_value (scalar_mul_normalized_rho a b) (S (S (S (S O)))))
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@canonical_scalar_normalize Alg.CoreFunSem b)))
scalar_mul_initial_rep_from_storage
     : forall (va vb : BinNums.Z) (m : Memory.Mem.mem) (ba bb : Values.block)
         (_ : scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (scalar_limbs_of va)))
         (_ : scalar_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (scalar_limbs_of vb)))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block ba bb)),
       rep (scalar_mul_reader_rho va vb)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) scalar_mul_caller_inputs m
eval_scalar_mul_from_normalized_scalars
     : forall (m : Memory.Mem.mem) (ba bb : Values.block)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : not (@eq Values.block ba bb))
         (_ : scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_scalar_normalize Alg.CoreFunSem a)))))
         (_ : scalar_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_scalar_normalize Alg.CoreFunSem b)))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (rep
                  (scalar_limb_rho
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@canonical_scalar_multiply Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
                  (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                     (@nil (prod Values.block BinNums.Z))) scalar_writer_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bb BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (lframe
                        (fun (block : Values.block) (ofs : BinNums.Z) =>
                         not
                           (foot
                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                                    (@nil (prod Values.block BinNums.Z))))
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 scalar_mul_caller_inputs) block ofs)) m mf)))))
scalar_mul_foot_blocks
     : forall (ba bb block : Values.block) (pos : BinNums.Z)
         (_ : foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   scalar_mul_caller_inputs) block pos), or (@eq Values.block block ba) (@eq Values.block block bb)
eval_scalar_mul_read_read_mul_write
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bb bl : Values.block) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@encode
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bb))
         (_ : not (@eq Values.block ba bl)) (_ : not (@eq Values.block bb bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) a) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun ma : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mn : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun mf : Memory.Mem.mem =>
                   and
                     (ClightBigstep.Clight2.eval_funcall secp_ge m
                        (@Ctypes.Internal Clight.function jets_secp.f_read_scalar)
                        (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                           (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ma
                        Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall secp_ge ma
                           (@Ctypes.Internal Clight.function jets_secp.f_read_scalar)
                           (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                              (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
                           Values.Vundef)
                        (and
                           (ClightBigstep.Clight2.eval_funcall secp_ge mr
                              (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
                              (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                                 (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                                    (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))))
                              Events.E0 mn Values.Vundef)
                           (and
                              (ClightBigstep.Clight2.eval_funcall secp_ge mn
                                 (@Ctypes.Internal Clight.function jets_secp.f_write_scalar)
                                 (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                                    (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)))
                                 Events.E0 mf Values.Vundef)
                              (and
                                 (finv m0 bd dbase bw outedge cursor N bi mf true
                                    (@encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                       (@canonical_scalar_multiply Alg.CoreFunSem
                                          (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (...)))))))))
                                             (Ty.tySem (Word.Word (S (S (S (S (S (S (...))))))))) a b))))
                                 (and
                                    (Memory.Mem.range_perm mf ba BinNums.Z0
                                       (BinNums.Zpos
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (Memory.Mem.range_perm mf bb BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (frame_fields_at mf bl BinNums.Z0 bi edge
                                             (BinInt.Z.add rc
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))
                                          (and
                                             (Memory.Mem.range_perm mf bl BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                                Memtype.Cur Memtype.Freeable)
                                             (lframe (scalar_mul_locals_outside m0 bd bw bi ba bb bl) m mf)))))))))))))
exec_scalar_multiply_rest_literal
     : forall (le : Maps.PTree.tree Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bw : Values.block) (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bb bl : Values.block)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@encode
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bb))
         (_ : not (@eq Values.block ba bl)) (_ : not (@eq Values.block bb bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) a) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt secp_ge (scalar_multiply_public_env bl ba bb) le m scalar_multiply_rest
               Events.E0 le mf
               (ClightBigstep.Out_return
                  (@Some (prod Values.val Ctypes.type)
                     (@pair Values.val Ctypes.type (Values.Vint Integers.Int.one) Ctypesdefs.tint))))
            (and
               (finv m0 bd dbase bw outedge cursor N bi mf true
                  (@encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                     (@canonical_scalar_multiply Alg.CoreFunSem
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
               (and
                  (Memory.Mem.range_perm mf ba BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf bb BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bl BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                           Memtype.Freeable)
                        (lframe
                           (fun (bx : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block bx ba))
                              (and (not (@eq Values.block bx bb))
                                 (and (not (@eq Values.block bx bl)) (not (extA m0 bd bw bi bx))))) m mf))))))
eval_secp_scalar_multiply_literal
     : forall (v_env : Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
         (bi : Values.block) (edge rc : BinNums.Z) (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m0 bs sbase bi edge rc)
         (_ : frame_input_cells_at m0 bi edge rc
                (@encode
                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Int64.max_unsigned),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m0
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_scalar_multiply)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val v_env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (finv m0 bd dbase bw outedge cursor N bi mf true
                  (@encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                     (@canonical_scalar_multiply Alg.CoreFunSem
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
               (lframe (fun (bx : Values.block) (_ : BinNums.Z) => not (extA m0 bd bw bi bx)) m0 mf)))
scalar_multiply_literal_local_spec
     : secp_jet_local_spec jets_secp.f_simplicity_scalar_multiply
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@canonical_scalar_multiply Alg.CoreFunSem)
canonical_scalar_square_parametric
     : @Alg.Core.Parametric (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@canonical_scalar_square)
canonical_scalar_square_step
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@canonical_scalar_square Alg.CoreFunSem value)
         (@canonical_scalar_multiply Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) value value))
canonical_scalar_square_normalized_value
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem value))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem value))) canonical_group_order)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_square Alg.CoreFunSem value))
den_sx_rename
     : forall (f : forall _ : nat, nat) (rho : forall _ : nat, Integers.Int64.int)
         (beta : forall _ : nat, prod Values.block BinNums.Z) (x : sx),
       @eq Values.val (den rho beta (sx_rename f x)) (den (fun n : nat => rho (f n)) beta x)
u64_cells_rename
     : forall (f : forall _ : nat, nat) (xs : list sx) (ofs : BinNums.Z),
       @eq (list cell) (@List.map cell cell (cell_subst (fun n : nat => XLv (f n))) (u64_cells ofs xs))
         (u64_cells ofs (@List.map sx sx (sx_rename f) xs))
scalar_square512_completes
     : @eq bool
         match scalar_square512_run return bool with
         | Some r =>
             match r return bool with
             | RDone _ o =>
                 match o return bool with
                 | ONormal => true
                 | OBreak => false
                 | OContinue => false
                 | OReturn _ => false
                 end
             | RIf _ _ _ => false
             end
         | None => false
         end true
scalar_square512_run_eq
     : @eq (option res) scalar_square512_run (@Some res (RDone scalar_square512_state ONormal))
scalar_square512_return
     : @eq (option sx) (@Maps.PTree.get sx BinNums.xH (stemps scalar_square512_state)) (@None sx)
scalar_square512_log_nil
     : @eq (list event) (slog scalar_square512_state) (@nil event)
scalar_square512_output
     : @eq (list region) (sregs scalar_square512_state) scalar_square512_output_regs
eval_scalar_square512_fresh
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_square512_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                     (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (rep rho beta scalar_square512_output_regs mf)
               (lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (foot beta
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           scalar_square512_regs) b ofs)) m mf)))
square512_input_zero
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (scalar_mul512_input_value (square512_rho rho) O) (scalar_mul512_input_value rho O)
square512_input_four
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (scalar_mul512_input_value (square512_rho rho) (S (S (S (S O)))))
         (scalar_mul512_input_value rho O)
scalar_square512_machine_length
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq nat (@length Integers.Int64.int (scalar_square512_machine_outputs rho)) (S (S (S (S (S (S (S (S O))))))))
scalar_square512_machine_product
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (column_words_value (scalar_square512_machine_outputs rho))
         (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho O))
scalar_square512_machine_cell
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (i : nat) (x : Integers.Int64.int)
         (_ : @eq (option Integers.Int64.int)
                (@List.nth_error Integers.Int64.int (scalar_square512_machine_outputs rho) i)
                (@Some Integers.Int64.int x)),
       @ex sx
         (fun sy : sx =>
          and
            (@List.In cell
               (mkcell
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))
                  AST.Mint64 (@Some sx sy)) (u64_cells BinNums.Z0 scalar_square512_limbs))
            (@eq Values.val (den rho beta sy) (Values.Vlong x)))
eval_scalar_square512_fresh_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_square512_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                     (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (forall (i : nat) (x : Integers.Int64.int)
                  (_ : @eq (option Integers.Int64.int)
                         (@List.nth_error Integers.Int64.int (scalar_square512_machine_outputs rho) i)
                         (@Some Integers.Int64.int x)),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (blk beta O)
                     (BinInt.Z.add (bas beta O)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong x)))
               (and
                  (@eq nat (@length Integers.Int64.int (scalar_square512_machine_outputs rho))
                     (S (S (S (S (S (S (S (S O)))))))))
                  (and
                     (@eq BinNums.Z (column_words_value (scalar_square512_machine_outputs rho))
                        (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho O)))
                     (and (rep rho beta scalar_square512_output_regs mf)
                        (lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot beta
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape scalar_square512_regs) b ofs)) m mf))))))
scalar_square_inputs_valid
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_square_caller_inputs m) (b : Values.block)
         (_ : @List.In Values.block b
                (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) beta)),
       Memory.Mem.valid_block m b
scalar_square_stack_rotate
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : list (prod Values.block BinNums.Z))
         (m : Memory.Mem.mem) (bl : Values.block)
         (_ : rep rho
                (@app (prod Values.block BinNums.Z) beta
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (@app region scalar_square_caller_inputs
                   (@cons region
                      (mkreg scalar_mul_stack_cells true
                         (@Some BinNums.Z
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                      (@nil region))) m) (_ : @eq nat (@length (prod Values.block BinNums.Z) beta) (S O)),
       rep rho (scalar_mul_stack_layout beta bl) scalar_square512_regs m
scalar_square_caller_allocates
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (ma : Memory.Mem.mem') (bl : Values.block) (_ : rep rho beta scalar_square_caller_inputs m)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block ma bl)),
       rep rho (scalar_mul_stack_layout beta bl) scalar_square512_regs ma
scalar_square512_limbs_length
     : @eq nat (@length sx scalar_square512_limbs) (S (S (S (S (S (S (S (S O))))))))
scalar_square512_outputs_machine
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Values.val) (@List.map sx Values.val (den rho beta) scalar_square512_limbs)
         (@List.map Integers.Int64.int Values.val Values.Vlong (scalar_square512_machine_outputs rho))
