     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq (option res) (read_fe_run input_edge edge) (@Some res (read_fe_result input_edge edge))
all_leaf_logs_selected
     : forall (log : list event) (rr : res) (_ : all_leaf_logs log rr) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list event) (slog (@fst sstate xout (rsel rho layout rr))) log
read_fe_result_leaf_logs
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       all_leaf_logs (read_fe_log input_edge edge) (read_fe_result input_edge edge)
read_fe_selected_log
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list event) (slog (@fst sstate xout (rsel rho layout (read_fe_result input_edge edge))))
         (read_fe_log input_edge edge)
read_fe_selected_return
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (option sx)
         (@Maps.PTree.get sx BinNums.xH (stemps (@fst sstate xout (rsel rho layout (read_fe_result input_edge edge)))))
         (@None sx)
read_fe_entries
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (id : AST.ident) (ent : fentry) (_ : @eq (option fentry) (flookup read_fe_table id) (@Some fentry ent)),
       and
         (@ex Values.block
            (fun b : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) id)
                  (@Some Values.block b))
               (@eq (option Clight.fundef)
                  (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) b)
                  (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (fentry_fd ent))))))
         match ent return Prop with
         | FInt _ => True
         | FOra fd oracle =>
             oracle_ok secp_ge (jet_secp_wrapper_run.read_evok bd dbase bi edge ibits)
               (jet_secp_wrapper_run.read_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap)
               (jet_secp_wrapper_run.read_ext m0 bd bw bi) fd oracle
         end
read_fe_input_events
     : forall (bd : Values.block) (dbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (ibits : list bool) (layout : layout),
       solves (jet_secp_wrapper_run.read_evok bd dbase bi edge ibits) (read_fe_rho ibits rc)
         (slog
            (@fst sstate xout
               (rsel (read_fe_rho ibits rc) (lay layout) (read_fe_result bi (Integers.Ptrofs.repr edge)))))
eval_read_fe_from_initial_regions
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (outs0 : list Cell) (cap : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (_ : @eq nat (@length bool ibits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (m : Memory.Mem.mem) (layout : layout)
         (_ : rep (read_fe_rho ibits rc) layout (read_fe_initial_regs bi (Integers.Ptrofs.repr edge)) m)
         (_ : xsep (jet_secp_wrapper_run.read_ext m0 bd bw bi) layout)
         (_ : jet_secp_wrapper_run.read_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (read_fe_rho ibits rc) (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (rep (read_fe_rho ibits rc) layout
                  (sregs
                     (@fst sstate xout
                        (rsel (read_fe_rho ibits rc) (lay layout) (read_fe_result bi (Integers.Ptrofs.repr edge))))) mf)
               (and
                  (jet_secp_wrapper_run.read_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                     (read_fe_rho ibits rc) (read_fe_log bi (Integers.Ptrofs.repr edge)) mf)
                  (lframe
                     (frame (jet_secp_wrapper_run.read_ext m0 bd bw bi) layout
                        (read_fe_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mf))))
zval_sx_subst
     : forall (sigma : forall _ : nat, sx) (rho : forall _ : nat, BinNums.Z) (x : sx),
       @eq BinNums.Z (zval rho (sx_subst sigma x)) (zval (fun n : nat => zval rho (sigma n)) x)
zcells_cell_subst
     : forall (sigma : forall _ : nat, sx) (rho : forall _ : nat, BinNums.Z) (cells : list cell),
       @eq (list BinNums.Z) (zcells rho (@List.map cell cell (cell_subst sigma) cells))
         (zcells (fun n : nat => zval rho (sigma n)) cells)
bits_val_app
     : forall left_bits right_bits : list bool,
       @eq BinNums.Z (bits_val (@app bool left_bits right_bits))
         (BinInt.Z.add
            (BinInt.Z.mul (bits_val left_bits)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat (@length bool right_bits))))
            (bits_val right_bits))
fold_be_linear
     : forall (bytes : list BinNums.Z) (acc : BinNums.Z),
       @eq BinNums.Z
         (@List.fold_left BinNums.Z BinNums.Z
            (fun value byte : BinNums.Z =>
             BinInt.Z.add
               (BinInt.Z.mul value
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               byte) bytes acc)
         (BinInt.Z.add
            (BinInt.Z.mul acc
               (BinInt.Z.pow
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (BinInt.Z.of_nat (@length BinNums.Z bytes)))) (jet_secp_fe_math.be_val bytes))
be_val_cons
     : forall (byte : BinNums.Z) (bytes : list BinNums.Z),
       @eq BinNums.Z (jet_secp_fe_math.be_val (@cons BinNums.Z byte bytes))
         (BinInt.Z.add
            (BinInt.Z.mul byte
               (BinInt.Z.pow
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (BinInt.Z.of_nat (@length BinNums.Z bytes)))) (jet_secp_fe_math.be_val bytes))
input_bytes_length
     : forall (count : nat) (bits : list bool), @eq nat (@length BinNums.Z (input_bytes count bits)) count
input_bytes_value
     : forall (count : nat) (bits : list bool)
         (_ : @eq nat (@length bool bits) (Nat.mul (S (S (S (S (S (S (S (S O)))))))) count)),
       @eq BinNums.Z (jet_secp_fe_math.be_val (input_bytes count bits)) (bits_val bits)
input_bytes_nth
     : forall (count : nat) (bits : list bool) (j : nat) (_ : lt j count),
       @eq (option BinNums.Z) (@List.nth_error BinNums.Z (input_bytes count bits) j)
         (@Some BinNums.Z (ifield bits (Nat.mul (S (S (S (S (S (S (S (S O)))))))) j) (S (S (S (S (S (S (S (S O))))))))))
input_bytes_bounds
     : forall (count : nat) (bits : list bool)
         (_ : @eq nat (@length bool bits) (Nat.mul (S (S (S (S (S (S (S (S O)))))))) count)),
       @List.Forall BinNums.Z
         (fun byte : BinNums.Z =>
          and (BinInt.Z.le BinNums.Z0 byte)
            (BinInt.Z.le byte
               (BinNums.Zpos
                  (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
         (input_bytes count bits)
bits_val_canonical_word
     : forall (n : nat) (value : Ty.tySem (Word.Word n)),
       @eq BinNums.Z (bits_val (@frame_input_word_bits n value)) (@Word.ToZ.Theory.toZ (Word.WordToZ n) value)
input_bytes_word256_value
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (jet_secp_fe_math.be_val
            (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))
               (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value)))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value)
input_bytes_word256_bounds
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @List.Forall BinNums.Z
         (fun byte : BinNums.Z =>
          and (BinInt.Z.le BinNums.Z0 byte)
            (BinInt.Z.le byte
               (BinNums.Zpos
                  (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
         (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))
            (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value))
ifield_byte_bounds
     : forall (bits : list bool) (offset : nat),
       and (BinInt.Z.le BinNums.Z0 (ifield bits offset (S (S (S (S (S (S (S (S O))))))))))
         (BinInt.Z.le (ifield bits offset (S (S (S (S (S (S (S (S O)))))))))
            (BinNums.Zpos
               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
input_bytes_nth_total
     : forall (count : nat) (bits : list bool) (j : nat)
         (_ : @eq nat (@length bool bits) (Nat.mul (S (S (S (S (S (S (S (S O)))))))) count)),
       @eq BinNums.Z (@List.nth BinNums.Z j (input_bytes count bits) BinNums.Z0)
         (ifield bits (Nat.mul (S (S (S (S (S (S (S (S O)))))))) j) (S (S (S (S (S (S (S (S O)))))))))
read_fe_condition_from_set_b32
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq sx (read_fe_condition input_edge edge) (XIz (sx_subst read_byte_shift sb_ret))
read_fe_condition_from_normalizer
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq sx (read_fe_nv_condition input_edge edge) (sx_subst read_nv_variables nv_c)
read_fe_nv_true_cells
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list cell) (read_fe_nv_true input_edge edge)
         (@List.map cell cell (cell_subst read_nv_variables) (cells0 nv_a))
read_fe_nv_false_cells
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list cell) (read_fe_nv_false input_edge edge)
         (@List.map cell cell (cell_subst read_nv_variables) (cells0 nv_b))
read_fe_no_normalize_cells
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list cell) (read_fe_no_normalize input_edge edge)
         (@List.map cell cell (cell_subst read_byte_shift) (cells0 sb_leaf))
read_fe_condition_checked
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       and
         (@eq (option (prod BinNums.Z BinNums.Z)) (zb read_bounds (read_fe_condition input_edge edge))
            (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))))
         (@eq bool (isk KI (read_fe_condition input_edge edge)) true)
read_fe_nv_condition_checked
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       and
         (@eq (option (prod BinNums.Z BinNums.Z)) (zb read_bounds (read_fe_nv_condition input_edge edge))
            (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))))
         (@eq bool (isk KI (read_fe_nv_condition input_edge edge)) true)
read_fe_nv_true_checked
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq bool (zreg_okb read_bounds BinNums.Z0 (read_fe_nv_true input_edge edge)) true
read_fe_nv_false_checked
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq bool (zreg_okb read_bounds BinNums.Z0 (read_fe_nv_false input_edge edge)) true
read_fe_no_normalize_checked
     : forall (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq bool (zreg_okb read_bounds BinNums.Z0 (read_fe_no_normalize input_edge edge)) true
read_rho_bounds
     : forall (bits : list bool) (rc : BinNums.Z) (n : nat),
       and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (read_bounds n)) (Integers.Int64.unsigned (read_fe_rho bits rc n)))
         (BinInt.Z.le (Integers.Int64.unsigned (read_fe_rho bits rc n)) (@snd BinNums.Z BinNums.Z (read_bounds n)))
read_shifted_input_value
     : forall (bits : list bool) (rc : BinNums.Z) (n : nat)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq BinNums.Z (zval (zrho (read_fe_rho bits rc)) (read_byte_shift n))
         (@List.nth BinNums.Z n
            (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))) bits)
            BinNums.Z0)
read_set_values
     : forall (bits : list bool) (rc : BinNums.Z)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq (list BinNums.Z) (@List.map sx BinNums.Z (zval (zrho (read_fe_rho bits rc))) read_set_limbs)
         (fe_limbs_of
            (jet_secp_fe_math.be_val
               (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))) bits)))
read_nv_variable_value
     : forall (bits : list bool) (rc : BinNums.Z) (n : nat)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq BinNums.Z (zval (zrho (read_fe_rho bits rc)) (read_nv_variables n))
         (@List.nth BinNums.Z n
            (fe_limbs_of
               (jet_secp_fe_math.be_val
                  (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))) bits)))
            BinNums.Z0)
read_set_return_value
     : forall (bits : list bool) (rc : BinNums.Z)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq BinNums.Z (zval (zrho (read_fe_rho bits rc)) (sx_subst read_byte_shift sb_ret))
         (b2z
            (BinInt.Z.ltb
               (jet_secp_fe_math.be_val
                  (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))) bits)) feP))
read_fe_invalid_condition
     : forall (bits : list bool) (rc : BinNums.Z) (input_edge : Values.block) (edge : Integers.Ptrofs.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq bool (truth (read_fe_rho bits rc) layout (read_fe_condition input_edge edge))
         (negb
            (BinInt.Z.ltb
               (jet_secp_fe_math.be_val
                  (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))) bits)) feP))
read_fe_normalizer_condition
     : forall (bits : list bool) (rc : BinNums.Z) (input_edge : Values.block) (edge : Integers.Ptrofs.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq bool (truth (read_fe_rho bits rc) layout (read_fe_nv_condition input_edge edge))
         (negb (BinInt.Z.eqb (zval (read_math_rho bits) nv_c) BinNums.Z0))
read_fe_nv_true_values
     : forall (bits : list bool) (rc : BinNums.Z) (input_edge : Values.block) (edge : Integers.Ptrofs.int)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq (list BinNums.Z) (zcells (zrho (read_fe_rho bits rc)) (read_fe_nv_true input_edge edge))
         (zcells (read_math_rho bits) (cells0 nv_a))
read_fe_nv_false_values
     : forall (bits : list bool) (rc : BinNums.Z) (input_edge : Values.block) (edge : Integers.Ptrofs.int)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq (list BinNums.Z) (zcells (zrho (read_fe_rho bits rc)) (read_fe_nv_false input_edge edge))
         (zcells (read_math_rho bits) (cells0 nv_b))
read_fe_no_normalize_values
     : forall (bits : list bool) (rc : BinNums.Z) (input_edge : Values.block) (edge : Integers.Ptrofs.int)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq (list BinNums.Z) (zcells (zrho (read_fe_rho bits rc)) (read_fe_no_normalize input_edge edge))
         (fe_limbs_of
            (jet_secp_fe_math.be_val
               (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))) bits)))
selected_cells_rsel
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (rr : res), @eq (list cell) (cells0 (@fst sstate xout (rsel rho layout rr))) (selected_cells rho layout rr)
read_fe_selected_cells
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (input_edge : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list cell) (cells0 (@fst sstate xout (rsel rho layout (read_fe_result input_edge edge))))
         match truth rho layout (read_fe_condition input_edge edge) return (list cell) with
         | true =>
             match truth rho layout (read_fe_nv_condition input_edge edge) return (list cell) with
             | true => read_fe_nv_true input_edge edge
             | false => read_fe_nv_false input_edge edge
             end
         | false => read_fe_no_normalize input_edge edge
         end
input_bytes_256_range
     : forall (bits : list bool)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       and
         (BinInt.Z.le BinNums.Z0
            (jet_secp_fe_math.be_val
               (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))) bits)))
         (BinInt.Z.lt
            (jet_secp_fe_math.be_val
               (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))) bits))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
nvz_canonical_input_limbs
     : forall (W : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 W)
                (BinInt.Z.lt W
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @eq (list BinNums.Z)
         (nvz_list
            (BinInt.Z.modulo W
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.modulo
               (BinInt.Z.div W
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.modulo
               (BinInt.Z.div W
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.modulo
               (BinInt.Z.div W
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.div W
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
         (fe_limbs_of (BinInt.Z.modulo W feP))
zcells_cond
     : forall (rho : forall _ : nat, BinNums.Z) (c : bool) (a b : list cell),
       @eq (list BinNums.Z) (zcells rho match c return (list cell) with
                                        | true => a
                                        | false => b
                                        end)
         match c return (list BinNums.Z) with
         | true => zcells rho a
         | false => zcells rho b
         end
read_fe_selected_numeric
     : forall (bits : list bool) (rc : BinNums.Z) (input_edge : Values.block) (edge : Integers.Ptrofs.int)
