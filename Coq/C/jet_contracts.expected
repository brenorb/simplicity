current_annex_cells =
fun o : option Digest.hash256 =>
match o return (list Cell) with
| Some h => @cons (option bool) (@Some bool true) (hash_cells (Digest.hash256_reg h))
| None =>
    @cons (option bool) (@Some bool false)
      (@List.repeat (option bool) (@None bool)
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
end
     : forall _ : option Digest.hash256, list Cell

