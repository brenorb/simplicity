sig_all_hash_spec =
fun alg : PF.Algebra =>
let term : Alg.Assertion.Algebra := PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit (Ty.Prod sha256_ctx8_type (Word.Word (S (S (S (S (S O)))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit sha256_ctx8_type (Word.Word (S (S (S (S (S O)))))) core
     (@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit
        (Ty.Prod sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
           (@sha256_ctx8_init_spec core)
           (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@tx_hash_spec alg) (@tap_env_hash_spec alg)))
        (@ctx8_addn_spec (S (S (S (S (S (S O)))))) term))
     (@PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
        (@BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.CurrentIndex)))
  (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S O))))
     sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@ctx8_addn_spec (S (S O)) term)
     (@ctx8_finalize_spec term))
     : forall alg : PF.Algebra, PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments sig_all_hash_spec {alg}
