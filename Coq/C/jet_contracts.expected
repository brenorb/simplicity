           (Build_LocalState (@encode (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S (S O)))))) a)
              (newWriteFrame (bitSize (Word.Word (S (S (S (S O)))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S (S O)))))) a)
              (fullWriteFrame (@encode (Word.Word (S (S (S (S O))))) (@shift16_plain_spec right Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (shift_wide_plain_function W16 right)) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@shift16_plain_spec right Naive.translate) (Running s0) (Running s1))))
