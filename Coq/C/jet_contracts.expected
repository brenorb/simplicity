     : Clight.statement
eq256_loop_body =
Clight.Ssequence (Clight.Sifthenelse eq256_condition Clight.Sskip Clight.Sbreak)
  (Clight.Ssequence (Clight.Sset _t'1 eq256_first)
     (Clight.Ssequence (Clight.Sset _t'2 eq256_second)
        (Clight.Sifthenelse eq256_mismatch (Clight.Ssequence (eq256_write false) eq256_return) Clight.Sskip)))
     : Clight.statement
eq256_loop_step = Clight.Sset _i (eq256_offset (BinNums.Zpos BinNums.xH))
     : Clight.statement
eq256_loop = Clight.Sloop eq256_loop_body eq256_loop_step
     : Clight.statement
