sha256_count_check_spec =
fun term : Alg.Core.Algebra =>
@jet_sha256_count_assertion.AC.comp
  (Ty.Prod (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))) (Ty.Sum Ty.Unit Ty.Unit) term
  (@jet_sha256_count_assertion.AC.pair
     (Ty.Prod (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
     (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))) term
     (@jet_sha256_count_assertion.AC.drop (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
        (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S O))))))) term
        (@jet_sha256_count_assertion.AC.take (Word.Word (S (S (S (S (S (S O)))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S O))))))) term
           (@jet_sha256_count_assertion.AC.iden (Word.Word (S (S (S (S (S (S O))))))) term)))
     (@jet_sha256_count_assertion.AC.comp
        (Ty.Prod (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
           (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S O))))))) term
        (@jet_sha256_count_assertion.AC.unit
           (Ty.Prod (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
              (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) term)
        (@Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S O))))))) sha256_count_limit term)))
  (@lt_word_spec term (S (S (S (S (S (S O)))))))
     : forall term : Alg.Core.Algebra, Alg.Core.domain term sha256_ctx8_type (Ty.Sum Ty.Unit Ty.Unit)

Arguments sha256_count_check_spec {term}
sha256_count_assertion_spec =
fun term : Alg.Assertion.Algebra =>
@jet_sha256_count_assertion.AC.comp sha256_ctx8_type (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) Ty.Unit
  (Alg.Assertion.toCore term)
  (@jet_sha256_count_assertion.AC.pair sha256_ctx8_type (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit (Alg.Assertion.toCore term)
     (@sha256_count_check_spec (Alg.Assertion.toCore term))
     (@jet_sha256_count_assertion.AC.unit sha256_ctx8_type (Alg.Assertion.toCore term)))
  (@Alg.Assertion.Combinators.assertr Ty.Unit Ty.Unit Ty.Unit Ty.Unit term assertion_cmr_fail0
     (@jet_sha256_count_assertion.AC.take Ty.Unit Ty.Unit Ty.Unit (Alg.Assertion.toCore term)
        (@jet_sha256_count_assertion.AC.iden Ty.Unit (Alg.Assertion.toCore term))))
     : forall term : Alg.Assertion.Algebra, Alg.Assertion.domain term sha256_ctx8_type Ty.Unit

Arguments sha256_count_assertion_spec {term}
bitcoin_core_composite_ids =
@cons AST.ident _sha256_midstate
  (@cons AST.ident _sha256_context (@cons AST.ident _frameItem (@cons AST.ident _secp256k1_uint128 (@nil AST.ident))))
     : list AST.ident
bitcoin_version_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun version : Integers.Int64.int =>
               and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                 (and (and (BinInt.Z.le BinNums.Z0 ebase) (BinInt.Z.le ebase Integers.Ptrofs.max_unsigned))
                    (and (BinInt.Z.le BinNums.Z0 txbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add txbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                             (and
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint64 m bt
                                      (BinInt.Z.add txbase
                                         (BinNums.Zpos
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))))
                                   (@Some Values.val (Values.Vlong version)))
                                (@eq BinNums.Z (Integers.Int64.unsigned version)
                                   (Integers.Int.unsigned (Bitcoin.sigTxVersion (Bitcoin.Bitcoin.envTx environment))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env), Prop

Arguments bitcoin_version_env_rep m env environment
bitcoin_transaction_version_spec =
fun alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra =>
@Bitcoin.PrimitiveBitcoin.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
  Bitcoin.Bitcoin.Version
     : forall alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra,
       Bitcoin.PrimitiveBitcoin.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S O))))))

Arguments bitcoin_transaction_version_spec {alg}
bitcoin_ge = Clight.globalenv jets_bitcoin.prog
     : Clight.genv
bitcoin_symbol_block =
fun id : AST.ident =>
match @Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv bitcoin_ge) id return Values.block with
| Some b => b
| None => BinNums.xH
end
     : forall _ : AST.ident, Values.block

Arguments bitcoin_symbol_block id
application_jet_local_spec =
fun (f : Clight.function) (ge : Clight.genv) (E : Set) (A B : Ty.Ty)
  (env_rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E), Prop)
  (spec : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)) =>
forall (logical_env : E) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
  (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
  (a : Ty.tySem A) (_ : env_rep m env logical_env) (_ : frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
  (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize A))) Integers.Int64.max_unsigned)
  (_ : frame_input_cells_at m bi edge read_cursor (@encode A a))
  (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   @ex (Ty.tySem B)
     (fun value : Ty.tySem B =>
      and (@eq (option (Ty.tySem B)) (spec a logical_env) (@Some (Ty.tySem B) value))
        (and
           (ClightBigstep.Clight2.eval_funcall ge m (@Ctypes.Internal Clight.function f)
              (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                 (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                    (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
           (and (frame_output_cells_at mf bw outedge cursor (@encode B value))
              (and (write_prefix_at m mf bw outedge cursor)
                 (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B))))
                    (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                       (_ : Memory.Mem.valid_block m b)
                       (_ : or (not (@eq Values.block b bd))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    ofs)))
                       (_ : or (not (@eq Values.block b bw))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add outedge
                                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                          (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B)))
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                     @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))))
     : forall (_ : Clight.function) (_ : Clight.genv) (E : Set) (A B : Ty.Ty)
         (_ : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E), Prop)
         (_ : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)), Prop

Arguments application_jet_local_spec f ge E%type_scope (A B)%ty_scope (env_rep spec)%function_scope
