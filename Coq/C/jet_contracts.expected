Integers.Int64.ltu
  (Integers.Int64.repr
     (BinNums.Zpos
        (BinNums.xO
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
  r
     : forall _ : Integers.Int64.int, bool

