memcpy_word_effect
     : forall (_ : memcpy_model) (m : Memory.Mem.mem) (bi : Values.block) (src : BinNums.Z)
         (bw : Values.block) (dst : BinNums.Z) (v : Integers.Int64.int)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bi src) (@Some Values.val (Values.Vlong v)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bw dst Memtype.Writable)
         (_ : and (BinInt.Z.le BinNums.Z0 src) (BinInt.Z.le src Integers.Ptrofs.max_unsigned))
         (_ : and (BinInt.Z.le BinNums.Z0 dst) (BinInt.Z.le dst Integers.Ptrofs.max_unsigned))
         (_ : or (not (@eq Values.block bi bw))
                (or
                   (BinInt.Z.le (BinInt.Z.add src (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) dst)
                   (BinInt.Z.le (BinInt.Z.add dst (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) src))),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (Events.external_call
               (AST.EF_external
                  (String.String (Ascii.Ascii true false true true false true true false)
                     (String.String (Ascii.Ascii true false true false false true true false)
                        (String.String (Ascii.Ascii true false true true false true true false)
                           (String.String (Ascii.Ascii true true false false false true true false)
                              (String.String (Ascii.Ascii false false false false true true true false)
                                 (String.String (Ascii.Ascii true false false true true true true false)
                                    String.EmptyString)))))) memcpy_sig)
               (@Globalenvs.Genv.to_senv Clight.fundef Ctypes.type (Clight.genv_genv ge0))
               (@cons Values.val (Values.Vptr bw (Integers.Ptrofs.repr dst))
                  (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr src))
                     (@cons Values.val
                        (Values.Vlong
                           (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (@nil Values.val)))) m Events.E0 (Values.Vptr bw (Integers.Ptrofs.repr dst)) m')
            (and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m' bw dst) (@Some Values.val (Values.Vlong v)))
               (and
                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : or (not (@eq Values.block b bw))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) dst)
                               (BinInt.Z.le
