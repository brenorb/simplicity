  (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value
     (word32_chunks (S (S (S O))) x))
  (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value
     (word32_chunks (S (S (S O))) y))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), bool

