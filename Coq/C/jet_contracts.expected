         (_ : BinInt.Z.le BinNums.Z0 count)
         (_ : BinInt.Z.le (BinInt.Z.add count (BinInt.Z.of_nat (byte_chunks_capacity chunks)))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m bo output (BinInt.Z.add output (BinInt.Z.of_nat (byte_chunks_capacity chunks)))
                Memtype.Cur Memtype.Writable) (_ : Memory.Mem.valid_access m AST.Mint64 bl slot Memtype.Writable)
