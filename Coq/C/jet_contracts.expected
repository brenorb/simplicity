              (newWriteFrame (bitSize (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O)))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode
                 (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
                    (Ty.Prod (Word.Word (S (S O))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))) a)
              (fullWriteFrame
                 (@encode (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O)))))
                    (@shift16_with_spec right Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
