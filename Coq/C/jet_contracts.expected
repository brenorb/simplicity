wide_test_value =
fun (s : wide_size) (one : bool) =>
match s return Clight.function with
| W16 => match one return Clight.function with
         | true => f_simplicity_is_one_16
         | false => f_simplicity_is_zero_16
         end
| W32 => match one return Clight.function with
         | true => f_simplicity_is_one_32
         | false => f_simplicity_is_zero_32
         end
| W64 => match one return Clight.function with
