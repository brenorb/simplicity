@jet_pad_bit_spec.AC.comp (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit))
  (Word.Word n) term
  (@jet_pad_bit_spec.AC.pair (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit) term
     (@jet_pad_bit_spec.AC.iden (Ty.Sum Ty.Unit Ty.Unit) term)
     (@jet_pad_bit_spec.AC.iden (Ty.Sum Ty.Unit Ty.Unit) term))
  (@Bit.cond (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) term (@left_pad_high_1_n n term) (@left_pad_low_1_n term n))
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)

