for_while_program_parametric
     : forall (n : nat) (C B A : Ty.Ty) (alg1 alg2 : Alg.Core.Algebra) (R : Alg.Core.Parametric.Rel alg1 alg2)
         (body1 : Alg.Core.domain alg1 (Ty.Prod (Ty.Prod C (Word.Word n)) A) (Ty.Sum B A))
         (body2 : Alg.Core.domain alg2 (Ty.Prod (Ty.Prod C (Word.Word n)) A) (Ty.Sum B A))
         (_ : @Alg.Core.Parametric.rel alg1 alg2 R (Ty.Prod (Ty.Prod C (Word.Word n)) A) (Ty.Sum B A) body1 body2),
       @Alg.Core.Parametric.rel alg1 alg2 R (Ty.Prod C A) (Ty.Sum B A) (@for_while_program n C B A alg1 body1)
         (@for_while_program n C B A alg2 body2)
for_while_run_ext
     : forall (n : nat) (C B A : Ty.Ty)
         (body1 body2 : forall _ : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word n)) A), option (Ty.tySem (Ty.Sum B A)))
         (context : Ty.tySem C) (state : Ty.tySem A)
         (_ : forall p : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word n)) A),
              @eq (option (Ty.tySem (Ty.Sum B A))) (body1 p) (body2 p)),
       @eq (option (Ty.tySem (Ty.Sum B A))) (@for_while_run n C B A body1 context state)
         (@for_while_run n C B A body2 context state)
for_while_program_reader_sem
     : forall (n : nat) (E : Type) (C B A : Ty.Ty)
         (body : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad))
                   (Ty.Prod (Ty.Prod C (Word.Word n)) A) (Ty.Sum B A)) (context : Ty.tySem C)
         (state : Ty.tySem A) (environment : E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum B A)))
         (@for_while_program n C B A (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad)) body
            (@pair (Ty.tySem C) (Ty.tySem A) context state) environment)
         (@for_while_run n C B A (fun p : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word n)) A) => body p environment) context
            state)
first_fail_body_parametric
     : forall (n : nat) (A B : Ty.Ty) (alg1 alg2 : Alg.Core.Algebra) (R : Alg.Core.Parametric.Rel alg1 alg2)
         (op1 : Alg.Core.domain alg1 (Word.Word n) (Ty.Sum A B))
         (op2 : Alg.Core.domain alg2 (Word.Word n) (Ty.Sum A B))
         (_ : @Alg.Core.Parametric.rel alg1 alg2 R (Word.Word n) (Ty.Sum A B) op1 op2),
       @Alg.Core.Parametric.rel alg1 alg2 R (Ty.Prod (Ty.Prod Ty.Unit (Word.Word n)) Ty.Unit)
         (Ty.Sum (Word.Word n) Ty.Unit) (@first_fail_body n A B alg1 op1) (@first_fail_body n A B alg2 op2)
first_fail_program_parametric
     : forall (n : nat) (A B : Ty.Ty) (alg1 alg2 : Alg.Assertion.Algebra) (R : Alg.Assertion.Parametric.Rel alg1 alg2)
         (op1 : Alg.Assertion.domain alg1 (Word.Word n) (Ty.Sum A B))
         (op2 : Alg.Assertion.domain alg2 (Word.Word n) (Ty.Sum A B))
         (_ : @Alg.Assertion.Parametric.rel alg1 alg2 R (Word.Word n) (Ty.Sum A B) op1 op2),
       @Alg.Assertion.Parametric.rel alg1 alg2 R Ty.Unit (Word.Word n) (@first_fail_program n A B alg1 op1)
         (@first_fail_program n A B alg2 op2)
first_fail_program_reader_finish
     : forall (n : nat) (E : Type) (A B : Ty.Ty)
         (op : Alg.Assertion.domain (Alg.AssertionSem (Reader.ReaderT_CIMonadZero E Option.option_Monad_Zero))
                 (Word.Word n) (Ty.Sum A B)) (environment : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Word.Word n)))
         (@first_fail_program n A B (Alg.AssertionSem (Reader.ReaderT_CIMonadZero E Option.option_Monad_Zero)) op tt
            environment)
         (@Option.option_bind (Ty.tySem (Ty.Sum (Word.Word n) Ty.Unit))
            ((fix tySem (X : Ty.Ty) : Set :=
                match X return Set with
                | Ty.Unit => unit
                | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                end) (Word.Word n))
            (fun result : Ty.tySem (Ty.Sum (Word.Word n) Ty.Unit) =>
             match
               result
               return
                 (option
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                        | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                        end) (Word.Word n)))
             with
             | inl counter =>
                 @Some
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) (Word.Word n)) counter
             | inr _ =>
                 @None
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) (Word.Word n))
             end)
            (@for_while_program n Ty.Unit (Word.Word n) Ty.Unit
               (Alg.Assertion.toCore (Alg.AssertionSem (Reader.ReaderT_CIMonadZero E Option.option_Monad_Zero)))
               (@first_fail_body n A B
                  (Alg.Assertion.toCore (Alg.AssertionSem (Reader.ReaderT_CIMonadZero E Option.option_Monad_Zero))) op)
               (@pair unit unit tt tt) environment))
first_fail_body_reader_sem
     : forall (n : nat) (E : Type) (A B : Ty.Ty)
         (op : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad))
                 (Word.Word n) (Ty.Sum A B)) (p : Ty.tySem (Ty.Prod (Ty.Prod Ty.Unit (Word.Word n)) Ty.Unit))
         (environment : E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum (Word.Word n) Ty.Unit)))
         (@first_fail_body n A B (Alg.CoreSem (Reader.ReaderT_CIMonad E Option.option_CIMonad)) op p environment)
         (@first_fail_step n A B (fun w : Ty.tySem (Word.Word n) => op w environment) p)
first_fail_program_reader_sem
     : forall (n : nat) (E : Type) (A B : Ty.Ty)
         (op : Alg.Assertion.domain (Alg.AssertionSem (Reader.ReaderT_CIMonadZero E Option.option_Monad_Zero))
                 (Word.Word n) (Ty.Sum A B)) (environment : E),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Word.Word n)))
         (@first_fail_program n A B (Alg.AssertionSem (Reader.ReaderT_CIMonadZero E Option.option_Monad_Zero)) op tt
            environment) (@first_fail_run n A B (fun w : Ty.tySem (Word.Word n) => op w environment))
for_while_run_all_right
     : forall (n : nat) (C B A : Ty.Ty)
         (body : forall _ : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word n)) A), option (Ty.tySem (Ty.Sum B A)))
         (context : Ty.tySem C) (state : Ty.tySem A)
         (_ : forall
                w : (fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                       | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                       end) (Word.Word n),
              @eq (option (Ty.tySem (Ty.Sum B A)))
                (body
                   (@pair
                      (prod (Ty.tySem C)
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) (Word.Word n))) (Ty.tySem A)
                      (@pair (Ty.tySem C)
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) (Word.Word n)) context w) state))
                (@Some
                   (sum
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                          | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                          end) B) (Ty.tySem A))
                   (@inr
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                          | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                          end) B) (Ty.tySem A) state))),
       @eq (option (Ty.tySem (Ty.Sum B A))) (@for_while_run n C B A body context state)
         (@Some
            (sum
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) B) (Ty.tySem A))
            (@inr
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) B) (Ty.tySem A) state))
search_word_pair_lt_high
     : forall (n : nat) (hi lo hi' lo' : Ty.tySem (Word.Word n))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ n) hi) (@Word.ToZ.Theory.toZ (Word.WordToZ n) hi')),
       BinInt.Z.lt
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) hi lo))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) hi' lo'))
search_word_pair_lt_low
     : forall (n : nat) (hi lo lo' : Ty.tySem (Word.Word n))
         (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ n) lo) (@Word.ToZ.Theory.toZ (Word.WordToZ n) lo')),
       BinInt.Z.lt
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) hi lo))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) hi lo'))
for_while_run_first_left
     : forall (n : nat) (C B A : Ty.Ty)
         (body : forall _ : Ty.tySem (Ty.Prod (Ty.Prod C (Word.Word n)) A), option (Ty.tySem (Ty.Sum B A)))
         (context : Ty.tySem C) (state : Ty.tySem A) (target : Ty.tySem (Word.Word n)) (result : Ty.tySem B)
         (_ : forall (w : Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
                (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ n) w)
                       (@Word.ToZ.Theory.toZ (Word.WordToZ n) target)),
              @eq (option (Ty.tySem (Ty.Sum B A)))
                (body
                   (@pair (prod (Ty.tySem C) (Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))) (Ty.tySem A)
                      (@pair (Ty.tySem C) (Ty.tySem (Word.ToZ.obj (Word.WordToZ n))) context w) state))
                (@Some
                   (sum
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                          | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                          end) B) (Ty.tySem A))
                   (@inr
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                          | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                          end) B) (Ty.tySem A) state)))
         (_ : @eq (option (Ty.tySem (Ty.Sum B A)))
                (body
                   (@pair (prod (Ty.tySem C) (Ty.tySem (Word.Word n))) (Ty.tySem A)
                      (@pair (Ty.tySem C) (Ty.tySem (Word.Word n)) context target) state))
                (@Some
                   (sum (Ty.tySem B)
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                          | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                          end) A))
                   (@inl (Ty.tySem B)
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                          | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                          end) A) result))),
       @eq (option (Ty.tySem (Ty.Sum B A))) (@for_while_run n C B A body context state)
         (@Some
            (sum (Ty.tySem B)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) A))
            (@inl (Ty.tySem B)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                   | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                   end) A) result))
first_fail_run_first_left
     : forall (n : nat) (A B : Ty.Ty) (op : forall _ : Ty.tySem (Word.Word n), option (Ty.tySem (Ty.Sum A B)))
         (target : Ty.tySem (Word.Word n))
         (_ : forall (w : Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
                (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ n) w)
                       (@Word.ToZ.Theory.toZ (Word.WordToZ n) target)),
              @ex
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) B)
                (fun
                   b : (fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                          | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                          end) B =>
                 @eq (option (Ty.tySem (Ty.Sum A B))) (op w)
                   (@Some
                      (sum
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) A)
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) B))
                      (@inr
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) A)
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) B) b))))
         (_ : @ex
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) A)
                (fun
                   a : (fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                          | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                          end) A =>
                 @eq (option (Ty.tySem (Ty.Sum A B))) (op target)
                   (@Some
                      (sum
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) A)
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) B))
                      (@inl
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) A)
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                             | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                             end) B) a)))),
       @eq (option (Ty.tySem (Word.Word n))) (@first_fail_run n A B op) (@Some (Ty.tySem (Word.Word n)) target)
first_fail_list_count
     : forall (n : nat) (X : Type) (B : Ty.Ty) (xs : list X) (encode : forall _ : X, Ty.tySem B)
         (_ : BinInt.Z.lt (BinInt.Z.of_nat (@length X xs))
