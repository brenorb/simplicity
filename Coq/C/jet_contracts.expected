exec_buffer8_read_chunk_layout
     : forall (m : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (bf : Values.block) (base : BinNums.Z)
         (bi : Values.block) (edge cursor : BinNums.Z) (bo : Values.block) (output : BinNums.Z)
         (bl : Values.block) (slot count : BinNums.Z)
         (c : prod nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src le)
