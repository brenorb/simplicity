@AC.comp (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit) term
  (@decrement_word_spec term n)
  (@AC.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term (@is_zero_word_spec n term))
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit)

