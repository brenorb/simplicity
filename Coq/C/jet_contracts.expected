elems_hash_spec =
fun (X : Ty.Ty)
  (add : forall term : Alg.Assertion.Algebra, Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type X) sha256_ctx8_type)
  (w : nat) (p : BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit X)) (alg : PF.Algebra) =>
let term : Alg.Assertion.Algebra := PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit (Ty.Prod Ty.Unit sha256_ctx8_type)
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit Ty.Unit sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.unit Ty.Unit core) (@sha256_ctx8_init_spec core))
  (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod Ty.Unit sha256_ctx8_type) (Ty.Sum sha256_ctx8_type sha256_ctx8_type)
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@gen_loop_run X add w term Ty.Unit
        (@jet_sha256_ctx8_init_spec.AC.drop Ty.Unit (Word.Word w) (Ty.Sum Ty.Unit X) core
           (@PF.Combinators.prim (Word.Word w) (Ty.Sum Ty.Unit X) alg p)))
     (@jet_sha256_ctx8_init_spec.AC.copair sha256_ctx8_type sha256_ctx8_type
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@ctx8_finalize_spec term) (@ctx8_finalize_spec term)))
     : forall (X : Ty.Ty)
         (_ : forall term : Alg.Assertion.Algebra,
              Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type X) sha256_ctx8_type) (w : nat)
         (_ : BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit X)) (alg : PF.Algebra),
       PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

