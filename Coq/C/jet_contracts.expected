fe_negate_normalized_limbs
     : forall (z0 z1 z2 z3 z4 : BinNums.Z) (_ : fe_limbs_ok z0 z1 z2 z3 z4)
         (_ : BinInt.Z.lt (fe_val z0 z1 z2 z3 z4) feP),
       @eq (list BinNums.Z) (fe_negate_limbs z0 z1 z2 z3 z4)
         (fe_limbs_of (BinInt.Z.modulo (BinInt.Z.sub feP (fe_val z0 z1 z2 z3 z4)) feP))
fe_negate_of_canonical_value
     : forall (V : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 V) (BinInt.Z.lt V feP)),
       @eq (list BinNums.Z)
         (fe_negate_limbs
            (BinInt.Z.modulo V
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.modulo
               (BinInt.Z.div V
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.modulo
               (BinInt.Z.div V
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.modulo
               (BinInt.Z.div V
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.div V
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
         (fe_limbs_of (BinInt.Z.modulo (BinInt.Z.sub feP V) feP))
fe_negate_machine_normalized
     : forall (rho : forall _ : nat, Integers.Int64.int)
         (_ : fe_limbs_ok (Integers.Int64.unsigned (rho (S O))) (Integers.Int64.unsigned (rho (S (S O))))
                (Integers.Int64.unsigned (rho (S (S (S O))))) (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))))
         (_ : BinInt.Z.lt
                (fe_val (Integers.Int64.unsigned (rho (S O))) (Integers.Int64.unsigned (rho (S (S O))))
                   (Integers.Int64.unsigned (rho (S (S (S O))))) (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                   (Integers.Int64.unsigned (rho (S (S (S (S (S O)))))))) feP),
       @eq (list BinNums.Z)
         (nvz_list (Integers.Int64.unsigned (negate_value rho O)) (Integers.Int64.unsigned (negate_value rho (S O)))
            (Integers.Int64.unsigned (negate_value rho (S (S O))))
            (Integers.Int64.unsigned (negate_value rho (S (S (S O)))))
            (Integers.Int64.unsigned (negate_value rho (S (S (S (S O)))))))
         (fe_limbs_of
            (BinInt.Z.modulo
               (BinInt.Z.sub feP
                  (fe_val (Integers.Int64.unsigned (rho (S O))) (Integers.Int64.unsigned (rho (S (S O))))
                     (Integers.Int64.unsigned (rho (S (S (S O))))) (Integers.Int64.unsigned (rho (S (S (S (S O))))))
                     (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))))) feP))
negate_rep_field
     : forall (m : Memory.Mem.mem) (b : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))) (sregs field_negate_state) m),
       and (fe_at m b BinNums.Z0 (negate_values rho))
         (Memory.Mem.range_perm m b BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
eval_field_negate_to_field
     : forall (m : Memory.Mem.mem) (b : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))) local_write_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr b Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (fe_at mf b BinNums.Z0 (negate_values rho))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (lframe
                     (fun (b' : Values.block) (pos : BinNums.Z) =>
                      not
                        (foot
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                              (@nil (prod Values.block BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              local_write_initial_regs) b' pos)) m mf))))
negate_cell_present
     : forall (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @List.In cell
         (mkcell (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat n))
            AST.Mint64 (@Some sx (negate_limb_expr n)))
         (rcells (@List.hd region (mkreg (@nil cell) true (@None BinNums.Z)) (sregs field_negate_state)))
negate_expr_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @eq Values.val (den rho beta (negate_limb_expr n)) (Values.Vlong (negate_value rho n))
field_negate_rep_loads
     : forall (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho layout (sregs field_negate_state) m) (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (blk layout O)
            (BinInt.Z.add (bas layout O)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat n))))
         (@Some Values.val (Values.Vlong (negate_value rho n)))
eval_field_negate_with_values
     : forall (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho layout local_write_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (rep rho layout (sregs field_negate_state) mf)
               (and
                  (forall (n : nat) (_ : lt n (S (S (S (S (S O)))))),
                   @eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf (blk layout O)
                        (BinInt.Z.add (bas layout O)
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat n)))) (@Some Values.val (Values.Vlong (negate_value rho n))))
                  (and
                     (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           (sregs field_negate_state))
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           local_write_initial_regs))
                     (lframe
                        (fun (b : Values.block) (pos : BinNums.Z) =>
                         not
                           (foot layout
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 local_write_initial_regs) b pos)) m mf)))))
unsigned_sub_constant
     : forall (c : BinNums.Z) (x : Integers.Int64.int)
         (_ : and (BinInt.Z.le BinNums.Z0 c) (BinInt.Z.le c Integers.Int64.max_unsigned))
         (_ : BinInt.Z.le (Integers.Int64.unsigned x) c),
       @eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.sub (Integers.Int64.repr c) x))
         (BinInt.Z.sub c (Integers.Int64.unsigned x))
negate_mask_range
     : forall (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       or
         (and
            (BinInt.Z.le
