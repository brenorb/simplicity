read32s_run =
fix read32s_run
  (bi : Values.block) (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int64.int)
  (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons x rest =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         @ex Memory.Mem.mem
           (fun ms : Memory.Mem.mem =>
            and
              (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_read32)
                 (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mi
                 (Values.Vlong x))
              (and
                 (@eq (option Memory.Mem.mem)
                    (Memory.Mem.store AST.Mint32 mi bi input (Values.Vint (Integers.Int64.loword x)))
                    (@Some Memory.Mem.mem ms))
                 (read32s_run bi (BinInt.Z.add input (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))) bf base rest
                    ms mf))))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int64.int)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments read32s_run bi input%Z_scope bf base%Z_scope xs%list_scope m mf
read32s_loop_body =
match Clight.fn_body f_read32s return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop body _ => body
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
read32s_loop_step =
Clight.Sset _n
  (Clight.Ebinop Cop.Osub (Clight.Etempvar _n Ctypesdefs.tulong)
     (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint) Ctypesdefs.tulong)
     : Clight.statement
read32s_body_env =
fun (le : Maps.PTree.tree Values.val) (bi : Values.block) (input : BinNums.Z) (x : Integers.Int64.int) =>
@Maps.PTree.set Values.val _t'2 (Values.Vlong x)
  (@Maps.PTree.set Values.val _x
     (Values.Vptr bi (Integers.Ptrofs.repr (BinInt.Z.add input (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))))
     (@Maps.PTree.set Values.val _t'1 (Values.Vptr bi (Integers.Ptrofs.repr input)) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int),
       Maps.PTree.tree Values.val

Arguments read32s_body_env le bi input%Z_scope x
