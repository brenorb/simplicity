            (BinInt.Z.modulo (BinInt.Z.add len n)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
add_counter_count
     : forall (r : Integers.Int64.int) (len n : BinNums.Z)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned r)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.lt len
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))))
         (_ : BinInt.Z.lt
                (BinInt.Z.add (Integers.Int64.unsigned r)
                   (BinInt.Z.div (BinInt.Z.add len n)
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                ctx8_limit),
       @eq (Ty.tySem (Word.Word (wide_log W64)))
         (decode_wide W64
            (Integers.Int64.zero_ext
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (Integers.Int64.shru
                  (Integers.Int64.add (sha256_read_counter r (Integers.Int64.repr len)) (Integers.Int64.repr n))
                  (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH)))))))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
            (BinInt.Z.add (Integers.Int64.unsigned r)
               (BinInt.Z.div (BinInt.Z.add len n)
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
fz_body
     : @eq Clight.statement (Clight.fn_body jets_sha.f_simplicity_sha_256_ctx_8_finalize)
