bool_x2
     : forall (q : BinNums.Z) (B1 B2 B3 : bool)
         (_ : or (@eq BinNums.Z q BinNums.Z0) (@eq BinNums.Z q (BinNums.Zpos BinNums.xH))),
       iff (@eq BinNums.Z (BinInt.Z.lor q (BinInt.Z.land (BinInt.Z.land (b2z B1) (b2z B2)) (b2z B3))) BinNums.Z0)
         (and (@eq BinNums.Z q BinNums.Z0) (@eq bool (andb (andb B1 B2) B3) false))
nvz_spec
     : forall (t0 t1 t2 t3 t4 : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 t0)
                (BinInt.Z.le t0
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t1)
                (BinInt.Z.le t1
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t2)
                (BinInt.Z.le t2
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t3)
                (BinInt.Z.le t3
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 t4)
                (BinInt.Z.le t4
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))),
       match nvz t0 t1 t2 t3 t4 return Prop with
       | pair p r4 =>
           match p return Prop with
           | pair p0 r3 =>
               match p0 return Prop with
               | pair p1 r2 =>
                   match p1 return Prop with
                   | pair r0 r1 =>
                       and (fe_limbs_ok r0 r1 r2 r3 r4)
                         (@eq BinNums.Z (fe_val r0 r1 r2 r3 r4) (BinInt.Z.modulo (fe_val t0 t1 t2 t3 t4) feP))
                   end
               end
           end
       end
fe_limbs_unique
     : forall (l0 l1 l2 l3 l4 V : BinNums.Z) (_ : fe_limbs_ok l0 l1 l2 l3 l4)
         (_ : @eq BinNums.Z (fe_val l0 l1 l2 l3 l4) V),
       @eq (list BinNums.Z)
         (@cons BinNums.Z l0
            (@cons BinNums.Z l1 (@cons BinNums.Z l2 (@cons BinNums.Z l3 (@cons BinNums.Z l4 (@nil BinNums.Z))))))
         (fe_limbs_of V)
fe_limbs_of_ok
     : forall (V : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 V)
                (BinInt.Z.lt V
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       and
         (fe_limbs_ok
            (BinInt.Z.modulo V
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.modulo
               (BinInt.Z.div V
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.modulo
               (BinInt.Z.div V
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.modulo
               (BinInt.Z.div V
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
            (BinInt.Z.div V
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
         (@eq BinNums.Z
            (fe_val
               (BinInt.Z.modulo V
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
               (BinInt.Z.modulo
                  (BinInt.Z.div V
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
               (BinInt.Z.modulo
                  (BinInt.Z.div V
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
               (BinInt.Z.modulo
                  (BinInt.Z.div V
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))
               (BinInt.Z.div V
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
            V)
lor_shift_add
     : forall (x y k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 x) (BinInt.Z.lt x (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
         (_ : BinInt.Z.le BinNums.Z0 y) (_ : BinInt.Z.le BinNums.Z0 k),
       @eq BinNums.Z (BinInt.Z.lor x (BinInt.Z.mul y (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
         (BinInt.Z.add x (BinInt.Z.mul y (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
mod_div_mod
     : forall (x a b c : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 b) (_ : BinInt.Z.le BinNums.Z0 c)
         (_ : BinInt.Z.le (BinInt.Z.add b c) a),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.div (BinInt.Z.modulo x (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) a))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) b))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) c))
         (BinInt.Z.modulo (BinInt.Z.div x (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) b))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) c))
div_div_pow
     : forall (x a b : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 a) (_ : BinInt.Z.le BinNums.Z0 b),
       @eq BinNums.Z
         (BinInt.Z.div (BinInt.Z.div x (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) a))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) b))
         (BinInt.Z.div x (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.add a b)))
mod256_split
     : forall x : BinNums.Z,
       @eq BinNums.Z
         (BinInt.Z.modulo x
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (BinInt.Z.add
            (BinInt.Z.modulo x
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))
            (BinInt.Z.mul
               (BinInt.Z.modulo
                  (BinInt.Z.div x
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))))
land_15
     : forall a : BinNums.Z,
       @eq BinNums.Z (BinInt.Z.land a (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))
         (BinInt.Z.modulo a
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))
land_255
     : forall a : BinNums.Z,
       @eq BinNums.Z
         (BinInt.Z.land a
            (BinNums.Zpos
               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (BinInt.Z.modulo a
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
overflow_flag
     : forall (l0 l1 l2 l3 l4 : BinNums.Z) (_ : fe_limbs_ok l0 l1 l2 l3 l4),
       @eq bool
         (BinInt.Z.eqb
            (BinInt.Z.land
               (BinInt.Z.land
                  (b2z
                     (BinInt.Z.eqb l4
                        (BinNums.Zpos
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))))))))))))
                  (b2z
                     (BinInt.Z.eqb (BinInt.Z.land (BinInt.Z.land l3 l2) l1)
                        (BinNums.Zpos
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
               (b2z
                  (negb
                     (BinInt.Z.ltb l0
                        (BinNums.Zpos
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xO
                                          (BinNums.xI
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))))))))))))))
            BinNums.Z0) (BinInt.Z.ltb (fe_val l0 l1 l2 l3 l4) feP)
fe_at_rep
     : forall (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (t0 t1 t2 t3 t4 : Integers.Int64.int)
         (_ : fe_at m b ofs
                (@cons Integers.Int64.int t0
                   (@cons Integers.Int64.int t1
                      (@cons Integers.Int64.int t2
                         (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int))))))),
       rep (rho5 t0 t1 t2 t3 t4)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b ofs) (@nil (prod Values.block BinNums.Z)))
         (@cons region (fe_reg (vars5 O)) (@nil region)) m
nv_run_eq
     : @eq (option res) nv_run (@Some res (RIf nv_c (RDone nv_a ONormal) (RDone nv_b ONormal)))
nv_bridge
     : forall z0 z1 z2 z3 z4 : BinNums.Z,
       @eq (list BinNums.Z) (nvz_list z0 z1 z2 z3 z4)
         match negb (BinInt.Z.eqb (zval (zrho5 z0 z1 z2 z3 z4) nv_c) BinNums.Z0) return (list BinNums.Z) with
         | true => zcells (zrho5 z0 z1 z2 z3 z4) (cells0 nv_a)
         | false => zcells (zrho5 z0 z1 z2 z3 z4) (cells0 nv_b)
         end
zrho_rho5
     : forall (t0 t1 t2 t3 t4 : Integers.Int64.int) (n : nat),
       @eq BinNums.Z (zrho (rho5 t0 t1 t2 t3 t4) n)
         (zrho5 (Integers.Int64.unsigned t0) (Integers.Int64.unsigned t1) (Integers.Int64.unsigned t2)
            (Integers.Int64.unsigned t3) (Integers.Int64.unsigned t4) n)
zcells_ext
     : forall (z1 z2 : forall _ : nat, BinNums.Z) (cs : list cell) (_ : forall n : nat, @eq BinNums.Z (z1 n) (z2 n)),
       @eq (list BinNums.Z) (zcells z1 cs) (zcells z2 cs)
fe_foot
     : forall (b : Values.block) (ofs : BinNums.Z) (xs : list sx) (b' : Values.block) (o : BinNums.Z)
         (_ : @eq nat (@length sx xs) (S (S (S (S (S O))))))
         (_ : foot
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b ofs)
                   (@nil (prod Values.block BinNums.Z)))
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   (@cons region (fe_reg xs) (@nil region))) b' o),
       and (@eq Values.block b' b)
         (and (BinInt.Z.le ofs o)
            (BinInt.Z.lt o
               (BinInt.Z.add ofs
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
eval_fe_normalize_var
     : forall (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (t0 t1 t2 t3 t4 : Integers.Int64.int)
         (_ : fe_at m b ofs
                (@cons Integers.Int64.int t0
                   (@cons Integers.Int64.int t1
                      (@cons Integers.Int64.int t2
                         (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int)))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t0)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t1)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t2)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t3)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t4)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_normalize_var)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr ofs)) (@nil Values.val)) Events.E0 m'
               Values.Vundef)
            (and
               (fe_at m' b ofs
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (nvz_list (Integers.Int64.unsigned t0) (Integers.Int64.unsigned t1) (Integers.Int64.unsigned t2)
                        (Integers.Int64.unsigned t3) (Integers.Int64.unsigned t4))))
               (lframe
                  (fun (b' : Values.block) (o : BinNums.Z) =>
                   not
                     (and (@eq Values.block b' b)
                        (and (BinInt.Z.le ofs o)
                           (BinInt.Z.lt o
                              (BinInt.Z.add ofs
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))) m
                  m')))
secp_pure_lookup
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef) (symbol_lookup secp_ge) secp_pure)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun p : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) secp_pure)
secp_pure_ok
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) secp_pure),
       @ex Values.block
         (fun b : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) id)
               (@Some Values.block b))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) b)
               (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))))
byte_cells_shape
     : forall (n : nat) (ofs : BinNums.Z) (v : nat),
       @eq (list (prod BinNums.Z AST.memory_chunk))
         (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape (byte_cells ofs n v))
         (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape (byte_undef ofs n))
byte_cells_In
     : forall (n : nat) (ofs : BinNums.Z) (v : nat) (c : cell) (_ : @List.In cell c (byte_cells ofs n v)),
       @ex nat
         (fun j : nat =>
          and (lt j n)
            (@eq cell c
               (mkcell (BinInt.Z.add ofs (BinInt.Z.of_nat j)) AST.Mint8unsigned (@Some sx (XL2I (XLv (Nat.add v j)))))))
byte_undef_nth
     : forall (n : nat) (ofs : BinNums.Z) (j : nat) (_ : lt j n),
       @List.In (prod BinNums.Z AST.memory_chunk)
         (@pair BinNums.Z AST.memory_chunk (BinInt.Z.add ofs (BinInt.Z.of_nat j)) AST.Mint8unsigned)
         (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape (byte_undef ofs n))
shape_eqb_eq
     : forall (a b : list (prod BinNums.Z AST.memory_chunk)) (_ : @eq bool (shape_eqb a b) true),
       @eq (list (prod BinNums.Z AST.memory_chunk)) a b
as_xp0_eq
     : forall (x : sx) (r : nat) (_ : @eq (option nat) (as_xp0 x) (@Some nat r)), @eq sx x (XP r BinNums.Z0)
cur_k_eq
     : forall (x : sx) (kc : Integers.Int64.int)
         (_ : @eq (option Integers.Int64.int) (cur_k x) (@Some Integers.Int64.int kc)),
       @eq sx x (XLb Badd (XLv O) (XLc kc))
frame_cells_eq
     : forall (regS : region) (xp : sx) (kc : Integers.Int64.int)
         (_ : @eq (option (prod sx Integers.Int64.int)) (frame_cells regS)
                (@Some (prod sx Integers.Int64.int) (@pair sx Integers.Int64.int xp kc))),
       and (@eq (list cell) (rcells regS) (mk_frame_cells xp kc)) (@eq bool (isk KA xp) true)
outsA_length
     : forall (ρ : forall _ : nat, Integers.Int64.int) (log : list event),
       @eq BinNums.Z (BinInt.Z.of_nat (@length Cell (outsA ρ log))) (written log)
outsA_app
     : forall (ρ : forall _ : nat, Integers.Int64.int) (l1 l2 : list event),
       @eq (list Cell) (outsA ρ (@app event l1 l2)) (@app Cell (outsA ρ l1) (outsA ρ l2))
has_wr_app
     : forall l1 l2 : list event, @eq bool (has_wr (@app event l1 l2)) (orb (has_wr l1) (has_wr l2))
written_app
     : forall l1 l2 : list event, @eq BinNums.Z (written (@app event l1 l2)) (BinInt.Z.add (written l1) (written l2))
i64_add_repr
     : forall a b : BinNums.Z,
       @eq Integers.Int64.int (Integers.Int64.add (Integers.Int64.repr a) (Integers.Int64.repr b))
         (Integers.Int64.repr (BinInt.Z.add a b))
secp_read8s_layout
     : forall (m : Memory.Mem.mem) (bo : Values.block) (output : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S O)))))) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bo output
                (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) Memtype.Cur
                Memtype.Writable) (_ : not (@eq Values.block bf bo)) (_ : not (@eq Values.block bf bi))
         (_ : not (@eq Values.block bo bi)) (_ : frame_base_valid base) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))) Integers.Int64.max_unsigned)
         (_ : frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : forall (i : nat) (x : Ty.tySem (Word.Word (S (S (S O)))))
                (_ : @eq (option (Ty.tySem (Word.Word (S (S (S O))))))
                       (@List.nth_error (Ty.tySem (Word.Word (S (S (S O))))) xs i)
                       (@Some (Ty.tySem (Word.Word (S (S (S O))))) x)),
              @frame_input_word_at (S (S (S O))) m bi edge
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                x),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function f_read8s)
               (@cons Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))
                  (@cons Values.val
                     (Values.Vlong
                        (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (uint8_array_at mf bo output
                  (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value xs))
               (and
                  (frame_fields_at mf bf base bi edge
                     (BinInt.Z.add cursor
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bo))
                               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) output)
                                  (BinInt.Z.le
                                     (BinInt.Z.add output
                                        (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
invA_stable
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list Cell)
         (capA : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m m' : Memory.Mem.mem)
         (_ : invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA ρ log m)
         (_ : lframe (fun (b : Values.block) (_ : BinNums.Z) => extA m0 bd bw bi b) m m'),
       invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA ρ log m'
invA_valid
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list Cell)
         (capA : BinNums.Z) (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m : Memory.Mem.mem)
         (b : Values.block) (_ : invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA ρ log m)
         (_ : extA m0 bd bw bi b), Memory.Mem.valid_block m b
loword_byte
     : forall (_ : list bool) (z : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 z)
                (BinInt.Z.lt z
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @eq Integers.Int.int (Integers.Int64.loword (Integers.Int64.repr z))
         (word8_array_value (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O)))) z))
orc_rd8_ok
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (w0 : bool) (outs0 : list Cell) (capA : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc (@List.map bool (option bool) (@Some bool) ibits))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le (BinInt.Z.add rc (BinInt.Z.of_nat (@length bool ibits))) Integers.Int64.max_unsigned)
         (nin : BinNums.Z) (_ : @eq BinNums.Z nin (BinInt.Z.of_nat (@length bool ibits))),
       oracle_ok secp_ge (evokA bd dbase bi edge ibits) (invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA)
         (extA m0 bd bw bi) f_read8s (orc_rd8 w0 nin)
secp_write8s_layout
     : forall (m : Memory.Mem.mem) (bb : Values.block) (input : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bw' : Values.block) (edge' cursor' : BinNums.Z) (xs : list Integers.Int.int)
         (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le (BinInt.Z.add input (BinInt.Z.of_nat (@length Integers.Int.int xs)))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bb bf)) (_ : not (@eq Values.block bb bw'))
         (_ : uint8_array_at m bb input xs)
         (_ : write_frame_at m bf base bw' edge' cursor'
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                   (BinInt.Z.of_nat (@length Integers.Int.int xs)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function f_write8s)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bb (Integers.Ptrofs.repr input))
                     (@cons Values.val
                        (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int.int xs))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (write_effect m mf bf base bw' edge' cursor'
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                  (BinInt.Z.of_nat (@length Integers.Int.int xs))) (byte_sequence_cells xs)))
byte_undef_length
     : forall (n : nat) (ofs : BinNums.Z), @eq nat (@length cell (byte_undef ofs n)) n
byte_shape_nth
     : forall (_ : list bool) (n : nat) (ofs : BinNums.Z) (cs : list cell)
         (_ : @eq (list (prod BinNums.Z AST.memory_chunk)) (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape cs)
                (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape (byte_undef ofs n)))
         (j : nat) (c : cell) (_ : @eq (option cell) (@List.nth_error cell cs j) (@Some cell c)),
       and (@eq BinNums.Z (cofs c) (BinInt.Z.add ofs (BinInt.Z.of_nat j)))
         (@eq AST.memory_chunk (cchunk c) AST.Mint8unsigned)
orc_wr8_ok
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (w0 : bool) (outs0 : list Cell) (capA : BinNums.Z) (_ : write_frame_at m0 bd dbase bw outedge cursor N),
       oracle_ok secp_ge (evokA bd dbase bi edge ibits) (invA m0 bd dbase bw outedge cursor N bi rc w0 outs0 capA)
         (extA m0 bd bw bi) f_write8s (orc_wr8 capA)
@secp_map_eq_in ?A ?B
     : forall (F G : forall _ : ?A, ?B) (l : list ?A) (_ : @eq (list ?B) (@List.map ?A ?B F l) (@List.map ?A ?B G l))
         (x : ?A) (_ : @List.In ?A x l), @eq ?B (F x) (G x)
where
?A : [ |- Type]
?B : [ |- Type]
secp_helper_lookup_core
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef) (secp_helper_lookup ge0) secp_core_helpers)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun p : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) secp_core_helpers)
secp_helper_lookup_secp
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef) (secp_helper_lookup secp_ge)
            secp_core_helpers)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun p : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) secp_core_helpers)
secp_helper_lookup_exists
     : forall (ge : Clight.genv) (id : AST.ident) (f : Clight.function)
         (_ : @eq (option Clight.fundef) (secp_helper_lookup ge (@pair AST.ident Clight.function id f))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))),
       @ex Values.block
         (fun b : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
               (@Some Values.block b))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
               (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))))
secp_core_helpers_entries
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) secp_core_helpers),
       @ex Values.block
         (fun b1 : Values.block =>
          @ex Values.block
            (fun b2 : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge0) id)
                  (@Some Values.block b1))
               (and
                  (@eq (option Clight.fundef)
                     (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge0) b1)
                     (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))
                  (and
                     (@eq (option Values.block)
                        (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) id)
                        (@Some Values.block b2))
                     (@eq (option Clight.fundef)
                        (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) b2)
                        (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))))))
secp_helpers_okb_true
     : @eq bool secp_helpers_okb true
secp_core_helpers_ok
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) secp_core_helpers),
       @eq bool
         (jet_transport.fundef_okb ge0 secp_ge
            (@List.map (prod AST.ident Clight.function) AST.ident (@fst AST.ident Clight.function) secp_core_helpers)
            (@Ctypes.Internal Clight.function f)) true
secp_transport_call
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) secp_core_helpers)
         (m : Memory.Mem.mem) (args : list Values.val) (t : Events.trace) (m' : Memory.Mem.mem)
         (res : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f) args t m' res),
       ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function f) args t m' res
ctx8_add_buffer_spec_parametric
     : forall d : nat,
       @Alg.Assertion.Parametric (Ty.Prod sha256_ctx8_type (buffer_type (Word.Word (S (S (S O)))) d)) sha256_ctx8_type
         (@ctx8_add_buffer_spec d)
ctx8_add_buffer_option
     : forall (d : nat) (c : Ty.tySem sha256_ctx8_type) (b : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) d)),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem sha256_ctx8_type))
         (@ctx8_add_buffer_spec d (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair (Ty.tySem sha256_ctx8_type) (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) d)) c b))
         (ctx8_add_buffer_model d c b)
ctx8_add1_some_count
     : forall (c : Ty.tySem sha256_ctx8_type) (x : Ty.tySem (Word.Word (S (S (S O))))) (c' : Ty.tySem sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem sha256_ctx8_type)) (ctx8_add1_model c x) (@Some (Ty.tySem sha256_ctx8_type) c')),
       BinInt.Z.lt (ctx8_count c') ctx8_limit
ctx8_add_list_some_count
     : forall (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (c c' : Ty.tySem sha256_ctx8_type)
         (_ : not (@eq (list (Ty.tySem (Word.Word (S (S (S O)))))) l (@nil (Ty.tySem (Word.Word (S (S (S O))))))))
         (_ : @eq (option (Ty.tySem sha256_ctx8_type)) (ctx8_add_list c l) (@Some (Ty.tySem sha256_ctx8_type) c')),
       BinInt.Z.lt (ctx8_count c') ctx8_limit
ctx8_add_buffer_model_list
     : forall (d : nat) (c : Ty.tySem sha256_ctx8_type) (b : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) d)),
       and
         (forall
            _ : @eq (list (Ty.tySem (Word.Word (S (S (S O)))))) (buffer_list (Word.Word (S (S (S O)))) d b)
                  (@nil (Ty.tySem (Word.Word (S (S (S O)))))),
          @eq (option (Ty.tySem sha256_ctx8_type)) (ctx8_add_buffer_model d c b)
            match BinInt.Z.ltb (ctx8_count c) ctx8_limit return (option (Ty.tySem sha256_ctx8_type)) with
            | true => @Some (Ty.tySem sha256_ctx8_type) c
            | false => @None (Ty.tySem sha256_ctx8_type)
            end)
         (forall
            _ : not
                  (@eq (list (Ty.tySem (Word.Word (S (S (S O)))))) (buffer_list (Word.Word (S (S (S O)))) d b)
                     (@nil (Ty.tySem (Word.Word (S (S (S O))))))),
          @eq (option (Ty.tySem sha256_ctx8_type)) (ctx8_add_buffer_model d c b)
            (ctx8_add_list c (buffer_list (Word.Word (S (S (S O)))) d b)))
ctx8_add_values
     : forall (buf : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
         (count : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (state : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (vs : list (Ty.tySem (Word.Word (S (S (S O)))))),
       let lbuf : list (Ty.tySem (Word.Word (S (S (S O))))) :=
         buffer_list (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) buf in
       let regs : list Integers.Int.int := state_regs state in
       let total : BinNums.Z :=
         BinInt.Z.add (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count)
           (BinInt.Z.div
              (BinInt.Z.add (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) lbuf))
                 (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) vs)))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         in
       let result :
         option
           (prod (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) :=
         match
           vs
           return
             (option
                (prod (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                   (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
         with
         | nil =>
             match
               BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count) ctx8_limit
               return
                 (option
                    (prod (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                       (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
             with
             | true =>
                 @Some
                   (prod (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                      (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                   (@pair (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                      (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) buf
                      (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) count state))
             | false =>
                 @None
                   (prod (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                      (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                         (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
             end
         | cons _ _ =>
             ctx8_add_list
               (@pair (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) buf
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) count state)) vs
         end in
       @ex (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
         (fun buf' : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) =>
          @ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun h' : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
             and
               (@eq (list (Ty.tySem (Word.Word (S (S (S O))))))
                  (buffer_list (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) buf')
                  (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb lbuf regs vs)))
               (and
                  (@eq (list Integers.Int.int) (state_regs h')
                     (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb lbuf regs vs)))
                  (@eq
                     (option
                        (prod (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) result
                     match
                       BinInt.Z.ltb total ctx8_limit
                       return
                         (option
                            (prod (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                     with
                     | true =>
                         @Some
                           (prod (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                              (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                           (@pair (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                              (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) buf'
                              (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) total) h'))
                     | false =>
                         @None
                           (prod (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                     end))))
