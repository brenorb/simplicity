@frame_input_word_triple_encode ?n
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x y z : Ty.tySem (Word.Word ?n)),
       iff
         (and (@frame_input_word_at ?n m bw edge cursor x)
            (and
               (@frame_input_word_at ?n m bw edge
                  (BinInt.Z.add cursor (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) ?n))) y)
               (@frame_input_word_at ?n m bw edge
                  (BinInt.Z.add cursor
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) ?n)))) z)))
         (frame_input_cells_at m bw edge cursor
            (@encode (Ty.Prod (Word.Word ?n) (Ty.Prod (Word.Word ?n) (Word.Word ?n)))
               (@pair (Ty.tySem (Word.Word ?n)) (prod (Ty.tySem (Word.Word ?n)) (Ty.tySem (Word.Word ?n))) x
                  (@pair (Ty.tySem (Word.Word ?n)) (Ty.tySem (Word.Word ?n)) y z))))
where
?n : [ |- nat]
ternary_word_spec_parametric
     : forall (n : nat) (k : ternary_op),
       @Alg.Core.Parametric
         (Ty.Prod (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n)
            (Ty.Prod (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n)))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n) (@ternary_word_spec n k)
ternary_int_denotes
     : forall (n : nat) (k : ternary_op) (x y z : Ty.tySem (Word.Word n)) (r t u : Integers.Int.int)
         (_ : BinInt.Z.le (Zpower.two_power_nat n)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : @eq BinNums.Z (Integers.Int.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
         (_ : @eq BinNums.Z (Integers.Int.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
         (_ : @eq BinNums.Z (Integers.Int.unsigned u) (@Word.ToZ.Theory.toZ (Word.WordToZ n) z)),
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ n) (Integers.Int.unsigned (ternary_int k r t u)))
         (@ternary_word_spec n k Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word n)) (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) x
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) y z)))
ternary_int64_denotes
     : forall (n : nat) (k : ternary_op) (x y z : Ty.tySem (Word.Word n)) (r t u : Integers.Int64.int)
         (_ : BinInt.Z.le (Zpower.two_power_nat n)
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned u) (@Word.ToZ.Theory.toZ (Word.WordToZ n) z)),
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ n) (Integers.Int64.unsigned (ternary_int64 k r t u)))
         (@ternary_word_spec n k Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word n)) (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) x
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) y z)))
eval_wide_ternary_layout_matches_spec
     : forall (env : Values.val) (k : ternary_op) (s : wide_size) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (x y z : Ty.tySem (Word.Word (wide_log s))) (cursor rc : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) (wide_bits s)))))
         (_ : @frame_input_word_at (wide_log s) m bi edge rc x)
         (_ : @frame_input_word_at (wide_log s) m bi edge (BinInt.Z.add rc (wide_bits s)) y)
         (_ : @frame_input_word_at (wide_log s) m bi edge
                (BinInt.Z.add rc (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (wide_bits s))) z)
         (_ : write_frame_at m bd dbase bw outedge cursor (wide_bits s)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (wide_ternary k s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log s))
                     (@ternary_word_spec (wide_log s) k Alg.CoreFunSem
                        (@pair (Ty.tySem (Word.Word (wide_log s)))
                           (prod (Ty.tySem (Word.Word (wide_log s))) (Ty.tySem (Word.Word (wide_log s)))) x
                           (@pair (Ty.tySem (Word.Word (wide_log s))) (Ty.tySem (Word.Word (wide_log s))) y z)))))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (wide_bits s)))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (wide_bits s))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
