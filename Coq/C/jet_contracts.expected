         (@cons Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase)) (@nil Values.val)) Events.E0 m
         (Values.Vlong (lock_result b (Integers.Int64.ltu lt lock_threshold) lt))
lockTime_exec
     : forall (m : Memory.Mem.mem) (bt : Values.block) (tbase : BinNums.Z) (b : bool) (lt : Integers.Int64.int)
