Inductive unary_borrow_op : Set :=  UNegate : unary_borrow_op | UDecrement : unary_borrow_op.
unary_borrow_spec =
fun (k : unary_borrow_op) (n : nat) (term : Alg.Core.Algebra) =>
match k return (Alg.Core.domain term (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))) with
| UNegate => @negate_word_spec term n
| UDecrement => @decrement_word_spec term n
end
     : forall (_ : unary_borrow_op) (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))

