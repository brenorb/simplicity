         (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bl : Values.block) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool) (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) x)))
         (_ : frame_input_cells_at m0 bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                (@List.map bool (option bool) (@Some bool) (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) y)))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) cap
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) x) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_ge)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and (fe_at mf ba BinNums.Z0 (point_canonical_limbs x))
               (and
                  (fe_at mf ba
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                     (point_canonical_limbs y))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint32 mf ba
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                        (@Some Values.val (Values.Vint Integers.Int.zero)))
                     (and
                        (frame_fields_at mf bl BinNums.Z0 bi edge
                           (BinInt.Z.add rc
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                        (and
                           (Memory.Mem.range_perm mf ba BinNums.Z0
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mf bl BinNums.Z0
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (invA m0 bd dbase bw outedge cursor N bi
                                    (BinInt.Z.add rc
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                    false (@nil Cell) cap
                                    (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) y)
                                       (BinInt.Z.add rc
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                    (read_fe_log bi (Integers.Ptrofs.repr edge)) mf)
                                 (lframe (secp_locals_outside m0 bd bw bi ba bl) m mf)))))))))
owned_write_tree_nonempty
     : forall (size : BinNums.Z) (k : point_coordinate) (bd : Values.block) (base : Integers.Ptrofs.int),
       @eq bool match owned_write_tree size k bd base return bool with
                | Some _ => true
                | None => false
                end true
owned_write_run_eq
     : forall (size : BinNums.Z) (k : point_coordinate) (bd : Values.block) (base : Integers.Ptrofs.int),
       @eq (option res) (owned_write_run size k bd base) (@Some res (owned_write_result size k bd base))
owned_write_selected_return
     : forall (size : BinNums.Z) (k : point_coordinate) (bd : Values.block) (base : Integers.Ptrofs.int)
         (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (option sx)
         (@Maps.PTree.get sx BinNums.xH
            (stemps (@fst sstate xout (rsel rho layout (owned_write_result size k bd base)))))
         (@None sx)
owned_write_selected_log
     : forall (size : BinNums.Z) (k : point_coordinate) (bd : Values.block) (base : Integers.Ptrofs.int)
         (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list event) (slog (@fst sstate xout (rsel rho layout (owned_write_result size k bd base))))
         (slog (@fst sstate xout (rsel rho layout (write_fe_result bd base))))
owned_write_leaf_storage
     : forall (size : BinNums.Z) (k : point_coordinate) (bd : Values.block) (base : Integers.Ptrofs.int),
       all_leaf_property (owned_write_storage_shape size) (owned_write_result size k bd base)
owned_write_selected_storage
     : forall (size : BinNums.Z) (k : point_coordinate) (bd : Values.block) (base : Integers.Ptrofs.int)
         (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       owned_write_storage_shape size (@fst sstate xout (rsel rho layout (owned_write_result size k bd base)))
owned_write_field_storage_size
     : forall (size : BinNums.Z) (k : point_coordinate)
         (_ : BinInt.Z.le
                (BinInt.Z.add (point_coordinate_offset k)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size),
       @List.Forall cell (fun c : cell => BinInt.Z.le (BinInt.Z.add (cofs c) (Memdata.size_chunk (cchunk c))) size)
         (rcells (@List.hd region (mkreg (@nil cell) true (@None BinNums.Z)) (owned_write_initial_regs size k)))
eval_owned_write_fe
     : forall (size : BinNums.Z) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bw : Values.block) (edge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z)
         (w0 : bool) (outs0 : list Cell) (k : point_coordinate) (m : Memory.Mem.mem) (layout : layout)
         (rho : forall _ : nat, Integers.Int64.int) (_ : write_frame_at m0 bd dbase bw edge cursor N)
         (_ : rep rho layout (owned_write_initial_regs size k) m) (_ : xsep (extA m0 bd bw bi) layout)
         (_ : invA m0 bd dbase bw edge cursor N bi rc w0 outs0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                rho (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val
                     (Values.Vptr (blk layout O)
                        (Integers.Ptrofs.repr (BinInt.Z.add (bas layout O) (point_coordinate_offset k))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (rep rho layout
                  (sregs
                     (@fst sstate xout
                        (rsel rho (lay layout) (owned_write_result size k bd (Integers.Ptrofs.repr dbase))))) mf)
               (and
                  (invA m0 bd dbase bw edge cursor N bi rc w0 outs0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                     rho
                     (slog
                        (@fst sstate xout
                           (rsel rho (lay layout) (owned_write_result size k bd (Integers.Ptrofs.repr dbase))))) mf)
                  (lframe (frame (extA m0 bd bw bi) layout (owned_write_initial_regs size k) m) m mf))))
eval_owned_wide_write_fe
     : forall (size : BinNums.Z) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bw : Values.block) (edge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z)
         (t0 t1 t2 t3 t4 : Integers.Int64.int) (w0 : bool) (outs0 : list Cell) (k : point_coordinate)
         (m : Memory.Mem.mem) (b : Values.block) (_ : write_frame_at m0 bd dbase bw edge cursor N)
         (_ : BinInt.Z.le (Integers.Int64.unsigned t0)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t1)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t2)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t3)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned t4)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : rep (wide_fe_rho t0 t1 t2 t3 t4 rc)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))) (owned_write_initial_regs size k) m)
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : invA m0 bd dbase bw edge cursor N bi rc w0 outs0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (wide_fe_rho t0 t1 t2 t3 t4 rc) (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr (point_coordinate_offset k)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (finv m0 bd dbase bw edge cursor N bi mf true
                  (@app Cell outs0
                     (@encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (wide_fe_output t0 t1 t2 t3 t4))))
               (and (Memory.Mem.range_perm mf b BinNums.Z0 size Memtype.Cur Memtype.Freeable)
                  (lframe
                     (frame (extA m0 bd bw bi)
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                           (@nil (prod Values.block BinNums.Z))) (owned_write_initial_regs size k) m) m mf))))
owned_write_initial_rep
     : forall (size : BinNums.Z) (k : point_coordinate) (t0 t1 t2 t3 t4 : Integers.Int64.int)
         (rc : BinNums.Z) (m : Memory.Mem.mem) (b : Values.block)
         (_ : BinInt.Z.le
                (BinInt.Z.add (point_coordinate_offset k)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : fe_at m b (point_coordinate_offset k)
                (@cons Integers.Int64.int t0
                   (@cons Integers.Int64.int t1
                      (@cons Integers.Int64.int t2
                         (@cons Integers.Int64.int t3 (@cons Integers.Int64.int t4 (@nil Integers.Int64.int)))))))
         (_ : Memory.Mem.range_perm m b BinNums.Z0 size Memtype.Cur Memtype.Freeable),
       rep (wide_fe_rho t0 t1 t2 t3 t4 rc)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
            (@nil (prod Values.block BinNums.Z))) (owned_write_initial_regs size k) m
eval_owned_bounded_field_write
     : forall (size : BinNums.Z) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bw : Values.block) (edge cursor N : BinNums.Z) (bi : Values.block) (rc : BinNums.Z)
         (f : point_field) (w0 : bool) (outs0 : list Cell) (k : point_coordinate) (m : Memory.Mem.mem)
         (b : Values.block)
         (_ : BinInt.Z.le
                (BinInt.Z.add (point_coordinate_offset k)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : write_frame_at m0 bd dbase bw edge cursor N) (_ : point_field_bounds f)
         (_ : fe_at m b (point_coordinate_offset k) (point_field_limbs f))
         (_ : Memory.Mem.range_perm m b BinNums.Z0 size Memtype.Cur Memtype.Freeable)
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : invA m0 bd dbase bw edge cursor N bi rc w0 outs0
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (point_field_rho f rc) (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr (point_coordinate_offset k)))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (finv m0 bd dbase bw edge cursor N bi mf true
                  (@app Cell outs0 (@encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (point_field_output f))))
               (and (Memory.Mem.range_perm mf b BinNums.Z0 size Memtype.Cur Memtype.Freeable)
                  (lframe
                     (frame (extA m0 bd bw bi)
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                           (@nil (prod Values.block BinNums.Z))) (owned_write_initial_regs size k) m) m mf))))
owned_write_preserves_field
     : forall (size : BinNums.Z) (m mf m0 : Memory.Mem.mem) (bd bw bi b : Values.block) (k j : point_coordinate)
         (limbs : list Integers.Int64.int) (_ : not (@eq point_coordinate k j))
         (_ : BinInt.Z.le
                (BinInt.Z.add (point_coordinate_offset j)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))) size)
         (_ : @eq nat (@length Integers.Int64.int limbs) (S (S (S (S (S O))))))
         (_ : fe_at m b (point_coordinate_offset j) limbs)
         (_ : Memory.Mem.range_perm mf b BinNums.Z0 size Memtype.Cur Memtype.Freeable)
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z))))
         (_ : lframe
                (frame (extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))) (owned_write_initial_regs size k) m) m mf),
       fe_at mf b (point_coordinate_offset j) limbs
owned_write_outside_owner
     : forall (size : BinNums.Z) (m mf m0 : Memory.Mem.mem) (bd bw bi b : Values.block) (k : point_coordinate)
         (_ : lframe
                (frame (extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))) (owned_write_initial_regs size k) m) m mf),
       lframe
         (fun (bx : Values.block) (_ : BinNums.Z) => and (not (@eq Values.block bx b)) (not (extA m0 bd bw bi bx))) m
         mf
eval_affine_two_general_writes
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (m : Memory.Mem.mem)
         (b : Values.block) (fx fy : point_field) (_ : write_frame_at m0 bd dbase bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                N) (_ : finv m0 bd dbase bw edge cursor N bi m false (@nil Cell)) (_ : point_field_bounds fx)
         (_ : point_field_bounds fy) (_ : fe_at m b BinNums.Z0 (point_field_limbs fx))
         (_ : fe_at m b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                (point_field_limbs fy))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Freeable)
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                   (@nil (prod Values.block BinNums.Z)))),
       @ex Memory.Mem.mem
         (fun mx : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                  (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                     (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val))) Events.E0
                  mx Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall secp_ge mx
                     (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                        (@cons Values.val
                           (Values.Vptr b
                              (Integers.Ptrofs.repr
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@nil Values.val))) Events.E0 mf Values.Vundef)
                  (and
                     (finv m0 bd dbase bw edge cursor N bi mf true
                        (@app Cell (@encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (point_field_output fx))
                           (@encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (point_field_output fy))))
                     (and
                        (Memory.Mem.range_perm mf b BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                           Memtype.Cur Memtype.Freeable)
                        (lframe
                           (fun (bx : Values.block) (_ : BinNums.Z) =>
                            and (not (@eq Values.block bx b)) (not (extA m0 bd bw bi bx))) m mf))))))
write_ge_body
     : @eq Clight.statement (Clight.fn_body jets_secp.f_write_ge)
         (Clight.Ssequence (write_ge_field_stmt jets_secp._x) (write_ge_field_stmt jets_secp._y))
exec_write_ge_field
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (b bd : Values.block)
