       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode Ty.Unit a)
              (fullWriteFrame (@encode (Word.Word (wide_log W32)) (@wide_one_spec W32 Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f_simplicity_one_32)
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@wide_one_spec W32 Naive.translate) (Running s0) (Running s1))))
