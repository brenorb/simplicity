                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : lframe
                (fun (bx : Values.block) (pos : BinNums.Z) =>
                 not
                   (foot
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z)))
                      (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                         rshape (point_write_initial_regs k)) bx pos)) m mf), fe_at mf b (point_coordinate_offset j) xs
point_initial_cell_present
     : forall (k : point_coordinate) (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @List.In cell
         (mkcell
            (BinInt.Z.add (point_coordinate_offset k)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat n)))
            AST.Mint64 (@Some sx (XLv (S n))))
         (rcells (@List.hd region (mkreg (@nil cell) true (@None BinNums.Z)) (point_write_initial_regs k)))
point_initial_rep_loads
     : forall (k : point_coordinate) (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho layout (point_write_initial_regs k) m) (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (blk layout O)
            (BinInt.Z.add (bas layout O)
               (BinInt.Z.add (point_coordinate_offset k)
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat n)))))
         (@Some Values.val (Values.Vlong (rho (S n))))
eval_point_zero_canonical_preserved
     : forall (k : point_coordinate) (m : Memory.Mem.mem) (b : Values.block)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : fe_at m b (point_coordinate_offset k)
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_fe_normalize Alg.CoreFunSem value)))))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_zero)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr (point_coordinate_offset k))) (@nil Values.val))
               Events.E0 mf (Values.Vint (bit_int (Bit.toBool (@canonical_fe_is_zero Alg.CoreFunSem value)))))
            (and
               (fe_at mf b (point_coordinate_offset k)
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (fe_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_fe_normalize Alg.CoreFunSem value)))))
               (and
                  (Memory.Mem.range_perm mf b BinNums.Z0
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     Memtype.Cur Memtype.Freeable)
                  (lframe
                     (fun (bx : Values.block) (pos : BinNums.Z) =>
                      not
                        (foot
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
                              (@nil (prod Values.block BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (point_write_initial_regs k)) bx pos)) m mf))))
point_canonical_field_limbs
     : forall value : BinNums.Z,
       @eq (list Integers.Int64.int) (point_field_limbs (point_canonical_field value))
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (fe_limbs_of value))
point_negative_field_limbs
     : forall value : BinNums.Z,
       @eq (list Integers.Int64.int) (point_field_limbs (point_negative_field value))
         (negate_values (write_fe_rho value BinNums.Z0))
point_reader_limb_model
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
