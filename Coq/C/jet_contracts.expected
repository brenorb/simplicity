encode =
fix encode (X : Ty.Ty) : forall _ : Ty.tySem X, list Cell :=
  match X as X0 return (forall _ : Ty.tySem X0, list Cell) with
  | Ty.Unit => fun _ : Ty.tySem Ty.Unit => @nil Cell
  | Ty.Sum A B =>
      fun ab : Ty.tySem (Ty.Sum A B) =>
      match ab return (list Cell) with
      | inl a =>
          @cons (option bool) (@Some bool false)
            (@app (option bool) (@List.repeat (option bool) (@None bool) (padL A B)) (encode A a))
      | inr b =>
          @cons (option bool) (@Some bool true)
            (@app (option bool) (@List.repeat (option bool) (@None bool) (padR A B)) (encode B b))
      end
  | Ty.Prod A B =>
      fun ab : Ty.tySem (Ty.Prod A B) =>
      match ab return (list Cell) with
      | pair a b => @app Cell (encode A a) (encode B b)
      end
  end
     : forall (X : Ty.Ty) (_ : Ty.tySem X), list Cell

Arguments encode {X}%ty_scope _
fillContext =
fun (ctx : Context) (h : LocalState) =>
Build_RunState (inactiveReadFrames ctx)
  (Build_ReadFrame (prevData (activeReadFrame ctx)) (@app Cell (readLocalState h) (nextData (activeReadFrame ctx))))
  (Build_WriteFrame (@app Cell (writeData (writeLocalState h)) (writeData (activeWriteFrame ctx)))
     (Nat.add (writeEmpty (writeLocalState h)) (writeEmpty (activeWriteFrame ctx)))) (inactiveWriteFrames ctx)
     : forall (_ : Context) (_ : LocalState), RunState

Arguments fillContext ctx h
Record ReadFrame : Set := Build_ReadFrame { prevData : list Cell;  nextData : list Cell }.

ReadFrame has primitive projections with eta conversion.
Arguments Build_ReadFrame (prevData nextData)%list_scope
Record WriteFrame : Set := Build_WriteFrame { writeData : list Cell;  writeEmpty : nat }.

WriteFrame has primitive projections with eta conversion.
Arguments Build_WriteFrame writeData%list_scope writeEmpty%nat_scope
Record RunState : Set := Build_RunState
  { inactiveReadFrames : list ReadFrame;
    activeReadFrame : ReadFrame;
    activeWriteFrame : WriteFrame;
    inactiveWriteFrames : list WriteFrame }.

RunState has primitive projections with eta conversion.
Arguments Build_RunState inactiveReadFrames%list_scope activeReadFrame activeWriteFrame inactiveWriteFrames%list_scope
Context = RunState
     : Set
newWriteFrame = fun n : nat => Build_WriteFrame (@nil Cell) n
     : forall _ : nat, WriteFrame

Arguments newWriteFrame n%nat_scope
fullWriteFrame = fun l : list Cell => Build_WriteFrame (@List.rev Cell l) O
     : forall _ : list Cell, WriteFrame

Arguments fullWriteFrame l%list_scope
bitSize =
fix bitSize (X : Ty.Ty) : nat :=
  match X return nat with
  | Ty.Unit => O
  | Ty.Sum A B => Nat.add (S O) (Nat.max (bitSize A) (bitSize B))
  | Ty.Prod A B => Nat.add (bitSize A) (bitSize B)
  end
     : forall _ : Ty.Ty, nat

Arguments bitSize X%ty_scope
ge0 = Clight.globalenv jets.prog
     : Clight.genv
complement_spec =
fix complement_spec (n : nat) (term : Alg.Core.Algebra) {struct n} :
    Alg.Core.domain term (Word.Word n) (Word.Word n) :=
  match n as n0 return (Alg.Core.domain term (Word.Word n0) (Word.Word n0)) with
  | O => @Bit.not (Ty.Sum Ty.Unit Ty.Unit) term (@Alg.Core.Combinators.iden (Ty.Sum Ty.Unit Ty.Unit) term)
  | S n0 =>
      @Alg.Core.Combinators.pair (Word.Word (S n0)) (Word.Word n0) (Word.Word n0) term
        (@Alg.Core.Combinators.take (Word.Word n0) (Word.Word n0) (Word.Word n0) term (complement_spec n0 term))
        (@Alg.Core.Combinators.drop (Word.Word n0) (Word.Word n0) (Word.Word n0) term (complement_spec n0 term))
  end
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term (Word.Word n) (Word.Word n)

Arguments complement_spec n%nat_scope {term}
