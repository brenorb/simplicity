core_copy_phase_call_wide
     : forall (_ : memcpy_model) (m1 : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z)
         (bw : Values.block) (outedge cursor : BinNums.Z) (bi : Values.block) (edge rc K : BinNums.Z)
         (cells : list Cell) (_ : frame_fields_at m1 bl BinNums.Z0 bi edge rc)
         (_ : write_frame_at m1 bd dbase bw outedge cursor K)
         (_ : @eq BinNums.Z K (BinInt.Z.of_nat (@length Cell cells)))
         (_ : and
                (BinInt.Z.lt
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) K)
                (BinInt.Z.le K
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : jet_copy_buffers_separated bd bi bw edge outedge cursor rc K)
         (_ : frame_input_cells_at m1 bi edge rc cells),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m1 (@Ctypes.Internal Clight.function f_simplicity_copyBits)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vlong (Integers.Int64.repr K)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef) (write_effect m1 mf bd dbase bw outedge cursor K cells))
core_leftmost_jet_e_wide
     : forall (_ : memcpy_model) (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, Ty.tySem B)
         (arg : Clight.expr)
         (_ : jet_core_wrapper.core_wrapper_shape f
                (jet_core_wrapper.core_simple_rest (jet_core_copy_exec.core_copy_call_e arg)))
         (_ : @eq Ctypes.type (Clight.typeof arg) Ctypesdefs.tint)
         (_ : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem),
              Clight.eval_expr ge0 e le m arg (Values.Vint (Integers.Int.repr (BinInt.Z.of_nat (bitSize B)))))
         (_ : and
                (BinInt.Z.lt
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   (BinInt.Z.of_nat (bitSize B)))
                (BinInt.Z.le (BinInt.Z.of_nat (bitSize B))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : le (bitSize B) (bitSize A))
         (_ : forall a : Ty.tySem A, @eq (list Cell) (@encode B (spec a)) (@List.firstn Cell (bitSize B) (@encode A a))),
       jet_separated_local_spec f A B spec
