@Alg.Core.Combinators.comp (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O))))))
  (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))) alg
  (@Alg.Core.Combinators.pair
     (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O))))) alg
     (@Alg.Core.Combinators.take (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O)))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg
        (@Alg.Core.Combinators.drop Ty.Unit (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg op))
     (@Alg.Core.Combinators.drop (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S O)))))
        (Word.Word (S (S (S (S O))))) alg (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S O))))) alg)))
  (@Alg.Core.Combinators.case Ty.Unit (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S O)))))
     (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))) alg
     (@Alg.Core.Combinators.injl (Ty.Prod Ty.Unit (Word.Word (S (S (S (S O)))))) (Word.Word (S (S (S (S O)))))
        (Word.Word (S (S (S (S O))))) alg
        (@Alg.Core.Combinators.drop Ty.Unit (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))) alg
           (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S O))))) alg)))
     (@Alg.Core.Combinators.injr (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S O))))))
        (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))) alg
        (@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S O))))))
