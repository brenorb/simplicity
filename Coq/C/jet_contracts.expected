eval_tx_input_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (t : BinNums.positive)
         (bt : Values.block) (txbase : BinNums.Z) (bin : Values.block) (inbase : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val t le)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase)))) (_ : BinInt.Z.le BinNums.Z0 txbase)
         (_ : BinInt.Z.le (BinInt.Z.add txbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add txbase BinNums.Z0))
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase)))),
       Clight.eval_expr bitcoin_ge e le m (tx_input_expr t) (Values.Vptr bin (Integers.Ptrofs.repr inbase))
eval_elem_hasAnnex
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (t ip : BinNums.positive)
         (bin : Values.block) (inbase : BinNums.Z) (r : Integers.Int64.int) (v : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val t le)
                (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val ip le) (@Some Values.val (Values.Vlong r)))
         (_ : BinInt.Z.le BinNums.Z0 inbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add
                   (BinInt.Z.add inbase
                      (BinInt.Z.mul
                         (BinNums.Zpos
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                         (Integers.Int64.unsigned r)))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bin
                   (BinInt.Z.add
                      (BinInt.Z.add inbase
                         (BinInt.Z.mul
                            (BinNums.Zpos
