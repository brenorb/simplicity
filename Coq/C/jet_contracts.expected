eval_fe_get_b32_from_initial_regions
     : forall (m : Memory.Mem.mem) (b : Values.block) (offset : BinNums.Z) (bf : Values.block)
         (base value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : rep (limb_rho value)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b offset)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bf base)
                      (@nil (prod Values.block BinNums.Z))))
                (@cons region
                   (mkreg
                      (jet_secp_fe_b32.byte_undef BinNums.Z0
                         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))) true
                      (@None BinNums.Z))
                   (@cons region (mkreg (u64_cells BinNums.Z0 (vars5 O)) false (@None BinNums.Z)) (@nil region))) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_get_b32)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr offset))
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (uint8_array_at mf b offset
                  (@List.map BinNums.Z Integers.Int.int Integers.Int.repr (jet_secp_fe_b32.be_bytes value)))
               (lframe
                  (fun (block : Values.block) (pos : BinNums.Z) =>
                   not
                     (foot
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b offset)
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bf base)
                              (@nil (prod Values.block BinNums.Z))))
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           (@cons region
                              (mkreg
                                 (jet_secp_fe_b32.byte_undef BinNums.Z0
                                    (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))) true
                                 (@None BinNums.Z))
                              (@cons region (mkreg (u64_cells BinNums.Z0 (vars5 O)) false (@None BinNums.Z))
                                 (@nil region)))) block pos)) m mf)))
