read_fe_final_field_numeric
     : forall (m : Memory.Mem.mem) (layout : layout) (bits : list bool) (rc : BinNums.Z) (input_edge : Values.block)
         (edge : Integers.Ptrofs.int)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : BinInt.Z.le BinNums.Z0 (bas layout O))
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (bas layout O))
         (_ : BinInt.Z.le
                (BinInt.Z.add (bas layout O)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : rep (read_fe_rho bits rc) layout
                (sregs (@fst sstate xout (rsel (read_fe_rho bits rc) (lay layout) (read_fe_result input_edge edge)))) m),
       fe_at m (blk layout O) (bas layout O)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (fe_limbs_of
               (BinInt.Z.modulo
                  (jet_secp_fe_math.be_val
                     (input_bytes (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))) bits)) feP)))
read_fe_final_field_canonical
     : forall (m : Memory.Mem.mem) (layout : layout) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (rc : BinNums.Z) (input_edge : Values.block) (edge : Integers.Ptrofs.int)
         (_ : BinInt.Z.le BinNums.Z0 (bas layout O))
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (bas layout O))
         (_ : BinInt.Z.le
                (BinInt.Z.add (bas layout O)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : rep (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) layout
                (sregs
                   (@fst sstate xout
                      (rsel (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                         (lay layout) (read_fe_result input_edge edge)))) m),
       fe_at m (blk layout O) (bas layout O)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (fe_limbs_of
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_fe_normalize Alg.CoreFunSem value))))
eval_read_fe_against_canonical_program
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (outs0 : list Cell)
         (cap : BinNums.Z) (m : Memory.Mem.mem) (layout : layout) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 (bas layout O))
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (bas layout O))
         (_ : BinInt.Z.le
                (BinInt.Z.add (bas layout O)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : rep (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) layout
                (read_fe_initial_regs bi (Integers.Ptrofs.repr edge)) m)
         (_ : xsep (jet_secp_wrapper_run.read_ext m0 bd bw bi) layout)
         (_ : jet_secp_wrapper_run.read_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (fe_at mf (blk layout O) (bas layout O)
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (fe_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_fe_normalize Alg.CoreFunSem value)))))
               (and
                  (jet_secp_wrapper_run.read_inv m0 bd dbase bw outedge cursor N bi rc outs0 cap
                     (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                     (read_fe_log bi (Integers.Ptrofs.repr edge)) mf)
                  (lframe
                     (frame (jet_secp_wrapper_run.read_ext m0 bd bw bi) layout
                        (read_fe_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mf))))
