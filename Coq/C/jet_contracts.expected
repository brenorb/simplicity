negate_limb_expr =
fun n : nat =>
XLb Bsub
  (XLb Bmul
     (XLb Bmul (XLc (Integers.Int64.repr (negate_mask n)))
        (XI2L Ctypes.Signed (XIc (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))))))
     (XI2L Ctypes.Signed (XIb Badd (XIc Integers.Int.one) (XIc Integers.Int.one)))) (XLv (S n))
     : forall _ : nat, sx

