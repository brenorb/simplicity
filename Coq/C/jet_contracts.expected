                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
test_value8_context_guarantees
     : forall (one : bool) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Word.Word (S (S (S O))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S O)))) a) (newWriteFrame (bitSize (Ty.Sum Ty.Unit Ty.Unit))))
         in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S O)))) a)
              (fullWriteFrame (@encode (Ty.Sum Ty.Unit Ty.Unit) (@test_value_spec (S (S (S O))) one Alg.CoreFunSem a))))
         in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (test_value8 one))
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@test_value_spec (S (S (S O))) one Naive.translate) (Running s0) (Running s1))))
eval_wide_test_value_layout_matches_spec
     : forall (env : Values.val) (s : wide_size) (one : bool) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (x : Ty.tySem (Word.Word (wide_log s))) (cursor rc : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc) (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (wide_bits s))))
         (_ : @frame_input_word_at (wide_log s) m bi edge rc x)
         (_ : write_frame_at m bd dbase bw outedge cursor (BinNums.Zpos BinNums.xH)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (wide_test_value s one))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Ty.Sum Ty.Unit Ty.Unit) (@test_value_spec (wide_log s) one Alg.CoreFunSem x)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
