  (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._b le) (@Some Values.val (Values.Vptr bb ob)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Ptrofs.int)
