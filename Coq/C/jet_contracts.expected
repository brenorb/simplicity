Record sigTx : Set := Build_sigTx
  { sigTxVersion : Integers.Int.int;
    sigTxIn : list Bitcoin.sigTxInput;
    sigTxOut : list Bitcoin.txOutput;
    sigTxLock : Bitcoin.lock;
    sigTxInBounds : and (BinInt.Z.lt BinNums.Z0 (@Zcomplements.Zlength Bitcoin.sigTxInput sigTxIn))
                      (BinInt.Z.lt (@Zcomplements.Zlength Bitcoin.sigTxInput sigTxIn) Integers.Int.modulus);
    sigTxOutBounds : and (BinInt.Z.le BinNums.Z0 (@Zcomplements.Zlength Bitcoin.txOutput sigTxOut))
                       (BinInt.Z.lt (@Zcomplements.Zlength Bitcoin.txOutput sigTxOut) Integers.Int.modulus);
    sigTxTotalInValue := List.Z_sum
                           (@List.map Bitcoin.sigTxInput BinNums.Z
                              (fun i : Bitcoin.sigTxInput => Integers.Int64.signed (Bitcoin.sigTxiValue i)) sigTxIn);
    sigTxTotalOutValue := List.Z_sum
                            (@List.map Bitcoin.txOutput BinNums.Z
                               (fun i : Bitcoin.txOutput => Integers.Int64.signed (Bitcoin.txoValue i)) sigTxOut);
    sigTxFee := BinInt.Z.sub sigTxTotalInValue sigTxTotalOutValue }.

sigTx has primitive projections with eta conversion.
Arguments Bitcoin.Build_sigTx sigTxVersion (sigTxIn sigTxOut)%list_scope sigTxLock sigTxInBounds sigTxOutBounds
Bitcoin.sigTxTotalInValue =
fun s : Bitcoin.sigTx =>
List.Z_sum
  (@List.map Bitcoin.sigTxInput BinNums.Z (fun i : Bitcoin.sigTxInput => Integers.Int64.signed (Bitcoin.sigTxiValue i))
     (Bitcoin.sigTxIn s))
     : forall _ : Bitcoin.sigTx, BinNums.Z

Arguments Bitcoin.sigTxTotalInValue s
Bitcoin.sigTxTotalOutValue =
fun s : Bitcoin.sigTx =>
List.Z_sum
  (@List.map Bitcoin.txOutput BinNums.Z (fun i : Bitcoin.txOutput => Integers.Int64.signed (Bitcoin.txoValue i))
     (Bitcoin.sigTxOut s))
     : forall _ : Bitcoin.sigTx, BinNums.Z

Arguments Bitcoin.sigTxTotalOutValue s
Bitcoin.sigTxFee =
fun s : Bitcoin.sigTx =>
BinInt.Z.sub
  (List.Z_sum
     (@List.map Bitcoin.sigTxInput BinNums.Z
        (fun i : Bitcoin.sigTxInput => Integers.Int64.signed (Bitcoin.sigTxiValue i)) (Bitcoin.sigTxIn s)))
  (List.Z_sum
     (@List.map Bitcoin.txOutput BinNums.Z (fun i : Bitcoin.txOutput => Integers.Int64.signed (Bitcoin.txoValue i))
        (Bitcoin.sigTxOut s)))
     : forall _ : Bitcoin.sigTx, BinNums.Z

Arguments Bitcoin.sigTxFee s
