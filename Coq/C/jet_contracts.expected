                (@List.map bool (option bool) (@Some bool) (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) z)))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) cap
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) x) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mx : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun my : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mz : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                     (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mx
                     Values.Vundef)
                  (and
                     (ClightBigstep.Clight2.eval_funcall secp_ge mx
                        (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                        (@cons Values.val
                           (Values.Vptr ba
                              (Integers.Ptrofs.repr
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                           (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 my
                        Values.Vundef)
                     (and
                        (ClightBigstep.Clight2.eval_funcall secp_ge my
                           (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                           (@cons Values.val
                              (Values.Vptr ba
                                 (Integers.Ptrofs.repr
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                              (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mz
                           Values.Vundef)
                        (and (fe_at mz ba BinNums.Z0 (point_canonical_limbs x))
                           (and
                              (fe_at mz ba
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 (point_canonical_limbs y))
                              (and
                                 (fe_at mz ba
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                                    (point_canonical_limbs z))
                                 (and
                                    (frame_fields_at mz bl BinNums.Z0 bi edge
                                       (BinInt.Z.add rc
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                                    (and
                                       (Memory.Mem.range_perm mz ba BinNums.Z0
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                          Memtype.Cur Memtype.Freeable)
                                       (and
                                          (Memory.Mem.range_perm mz bl BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                             Memtype.Cur Memtype.Freeable)
                                          (and
                                             (invA m0 bd dbase bw outedge cursor N bi
                                                (BinInt.Z.add rc
                                                   (BinNums.Zpos
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))
                                                false (@nil Cell) cap
                                                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S ...)))))) z)
                                                   (BinInt.Z.add rc
                                                      (BinNums.Zpos
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))
                                                (read_fe_log bi (Integers.Ptrofs.repr edge)) mz)
                                             (and
                                                (lframe
                                                   (frame (extA m0 bd bw bi)
                                                      (@cons (prod Values.block BinNums.Z)
                                                         (@pair Values.block BinNums.Z ba BinNums.Z0)
                                                         (@cons (prod Values.block BinNums.Z)
                                                            (@pair Values.block BinNums.Z bl BinNums.Z0)
                                                            (@nil (prod Values.block BinNums.Z))))
                                                      (point_read_initial_regs PointX bi (Integers.Ptrofs.repr edge)) m)
                                                   m mx)
                                                (and
                                                   (lframe
                                                      (frame (extA m0 bd bw bi)
                                                         (@cons (prod Values.block BinNums.Z)
                                                            (@pair Values.block BinNums.Z ba BinNums.Z0)
                                                            (@cons (prod Values.block BinNums.Z)
                                                               (@pair Values.block BinNums.Z bl BinNums.Z0)
                                                               (@nil (prod Values.block BinNums.Z))))
                                                         (point_read_initial_regs PointY bi (Integers.Ptrofs.repr edge))
                                                         mx) mx my)
                                                   (lframe
                                                      (frame (extA m0 bd bw bi)
                                                         (@cons (prod Values.block BinNums.Z)
                                                            (@pair Values.block BinNums.Z ba BinNums.Z0)
                                                            (@cons (prod Values.block BinNums.Z)
                                                               (@pair Values.block BinNums.Z bl BinNums.Z0)
                                                               (@nil (prod Values.block BinNums.Z))))
                                                         (point_read_initial_regs PointZ bi (Integers.Ptrofs.repr edge))
                                                         my) my mz)))))))))))))))
point_zero_run_eq
     : forall k : point_coordinate,
       @eq (option res) (point_zero_run k) (@Some res (RDone (point_zero_state k) ONormal))
point_zero_return
     : forall k : point_coordinate,
       @eq (option sx) (@Maps.PTree.get sx BinNums.xH (stemps (point_zero_state k))) (@Some sx (point_zero_ret k))
point_zero_regions
     : forall k : point_coordinate, @eq (list region) (sregs (point_zero_state k)) (point_write_initial_regs k)
point_zero_log_nil
     : forall k : point_coordinate, @eq bool (leaves_log_nil (RDone (point_zero_state k) ONormal)) true
point_zero_value
     : forall (k : point_coordinate) (rho : forall _ : nat, Integers.Int64.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout (point_zero_ret k))
         (Values.Vint
            match Integers.Int64.eq (field_or_value rho) Integers.Int64.zero return Integers.Int.int with
            | true => Integers.Int.one
            | false => Integers.Int.zero
            end)
eval_point_zero_from_owned_region
     : forall (k : point_coordinate) (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho layout (point_write_initial_regs k) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_zero)
               (@cons Values.val
                  (Values.Vptr (blk layout O)
                     (Integers.Ptrofs.repr (BinInt.Z.add (bas layout O) (point_coordinate_offset k))))
                  (@nil Values.val)) Events.E0 mf
               (Values.Vint
                  match Integers.Int64.eq (field_or_value rho) Integers.Int64.zero return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (and (rep rho layout (point_write_initial_regs k) mf)
               (lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (foot layout
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           (point_write_initial_regs k)) b pos)) m mf)))
point_canonical_write_rho
     : forall value rc : BinNums.Z,
       @eq (forall _ : nat, Integers.Int64.int)
         (wide_fe_rho (limb_rho value O) (limb_rho value (S O)) (limb_rho value (S (S O)))
            (limb_rho value (S (S (S O)))) (limb_rho value (S (S (S (S O))))) rc) (write_fe_rho value rc)
point_zero_initial_rep
