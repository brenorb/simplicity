ctx8_add_buffer_spec =
fix ctx8_add_buffer_spec (d : nat) (term : Alg.Assertion.Algebra) {struct d} :
    Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type (buffer_type (Word.Word (S (S (S O)))) d)) sha256_ctx8_type :=
  match
    d as d0
    return
      (Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type (buffer_type (Word.Word (S (S (S O)))) d0)) sha256_ctx8_type)
  with
  | O =>
      @jet_sha256_count_assertion.AC.comp (Ty.Prod sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))))
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))) sha256_ctx8_type) sha256_ctx8_type
        (Alg.Assertion.toCore term)
        (@jet_sha256_count_assertion.AC.pair (Ty.Prod sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))) sha256_ctx8_type (Alg.Assertion.toCore term)
           (@jet_sha256_count_assertion.AC.drop sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Word (S (S (S O)))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))) (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.iden (Ty.Sum Ty.Unit (Word.Word (S (S (S O)))))
                 (Alg.Assertion.toCore term)))
           (@jet_sha256_count_assertion.AC.take sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Word (S (S (S O)))))
              sha256_ctx8_type (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term))))
        (@jet_sha256_count_assertion.AC.case Ty.Unit (Word.Word (S (S (S O)))) sha256_ctx8_type sha256_ctx8_type
           (Alg.Assertion.toCore term)
           (@jet_sha256_count_assertion.AC.drop Ty.Unit sha256_ctx8_type sha256_ctx8_type (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.comp sha256_ctx8_type (Ty.Prod sha256_ctx8_type Ty.Unit) sha256_ctx8_type
                 (Alg.Assertion.toCore term)
                 (@jet_sha256_count_assertion.AC.pair sha256_ctx8_type sha256_ctx8_type Ty.Unit
                    (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term))
                    (@sha256_count_assertion_spec term))
                 (@jet_sha256_count_assertion.AC.take sha256_ctx8_type Ty.Unit sha256_ctx8_type
                    (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term)))))
           (@jet_sha256_count_assertion.AC.comp (Ty.Prod (Word.Word (S (S (S O)))) sha256_ctx8_type)
              (Ty.Prod sha256_ctx8_type (Word.Word (S (S (S O))))) sha256_ctx8_type (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.pair (Ty.Prod (Word.Word (S (S (S O)))) sha256_ctx8_type)
                 sha256_ctx8_type (Word.Word (S (S (S O)))) (Alg.Assertion.toCore term)
                 (@jet_sha256_count_assertion.AC.drop (Word.Word (S (S (S O)))) sha256_ctx8_type sha256_ctx8_type
                    (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term)))
                 (@jet_sha256_count_assertion.AC.take (Word.Word (S (S (S O)))) sha256_ctx8_type
                    (Word.Word (S (S (S O)))) (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.iden (Word.Word (S (S (S O)))) (Alg.Assertion.toCore term))))
              (@ctx8_add1_spec term)))
  | S d' =>
      @jet_sha256_count_assertion.AC.comp
        (Ty.Prod sha256_ctx8_type
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
              (buffer_type (Word.Word (S (S (S O)))) d')))
        (Ty.Prod sha256_ctx8_type (buffer_type (Word.Word (S (S (S O)))) d')) sha256_ctx8_type
        (Alg.Assertion.toCore term)
        (@jet_sha256_count_assertion.AC.pair
           (Ty.Prod sha256_ctx8_type
              (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
                 (buffer_type (Word.Word (S (S (S O)))) d'))) sha256_ctx8_type
           (buffer_type (Word.Word (S (S (S O)))) d') (Alg.Assertion.toCore term)
           (@jet_sha256_count_assertion.AC.comp
              (Ty.Prod sha256_ctx8_type
                 (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
                    (buffer_type (Word.Word (S (S (S O)))) d')))
              (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))) sha256_ctx8_type)
              sha256_ctx8_type (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.pair
                 (Ty.Prod sha256_ctx8_type
                    (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
                       (buffer_type (Word.Word (S (S (S O)))) d')))
                 (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))) sha256_ctx8_type
                 (Alg.Assertion.toCore term)
                 (@jet_sha256_count_assertion.AC.drop sha256_ctx8_type
                    (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
                       (buffer_type (Word.Word (S (S (S O)))) d'))
                    (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))) (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.take
                       (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
                       (buffer_type (Word.Word (S (S (S O)))) d')
                       (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))) (Alg.Assertion.toCore term)
                       (@jet_sha256_count_assertion.AC.iden
                          (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))) (Alg.Assertion.toCore term))))
                 (@jet_sha256_count_assertion.AC.take sha256_ctx8_type
                    (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
                       (buffer_type (Word.Word (S (S (S O)))) d')) sha256_ctx8_type (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term))))
              (@jet_sha256_count_assertion.AC.case Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))
                 sha256_ctx8_type sha256_ctx8_type (Alg.Assertion.toCore term)
                 (@jet_sha256_count_assertion.AC.drop Ty.Unit sha256_ctx8_type sha256_ctx8_type
                    (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term)))
                 (@jet_sha256_count_assertion.AC.comp
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S d')) sha256_ctx8_type)
                    (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S d'))) sha256_ctx8_type
                    (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.pair
                       (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S d')) sha256_ctx8_type) sha256_ctx8_type
                       (Word.Vector (Word.Word (S (S (S O)))) (S d')) (Alg.Assertion.toCore term)
                       (@jet_sha256_count_assertion.AC.drop (Word.Vector (Word.Word (S (S (S O)))) (S d'))
                          sha256_ctx8_type sha256_ctx8_type (Alg.Assertion.toCore term)
                          (@jet_sha256_count_assertion.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term)))
                       (@jet_sha256_count_assertion.AC.take (Word.Vector (Word.Word (S (S (S O)))) (S d'))
                          sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S d')) (Alg.Assertion.toCore term)
                          (@jet_sha256_count_assertion.AC.iden (Word.Vector (Word.Word (S (S (S O)))) (S d'))
                             (Alg.Assertion.toCore term)))) (@ctx8_addn_spec (S d') term))))
           (@jet_sha256_count_assertion.AC.drop sha256_ctx8_type
              (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
                 (buffer_type (Word.Word (S (S (S O)))) d')) (buffer_type (Word.Word (S (S (S O)))) d')
              (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.drop (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
                 (buffer_type (Word.Word (S (S (S O)))) d') (buffer_type (Word.Word (S (S (S O)))) d')
                 (Alg.Assertion.toCore term)
                 (@jet_sha256_count_assertion.AC.iden (buffer_type (Word.Word (S (S (S O)))) d')
                    (Alg.Assertion.toCore term))))) (ctx8_add_buffer_spec d' term)
  end
     : forall (d : nat) (term : Alg.Assertion.Algebra),
       Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type (buffer_type (Word.Word (S (S (S O)))) d)) sha256_ctx8_type

Arguments ctx8_add_buffer_spec d%nat_scope {term}
ctx8_count =
fun c : Ty.tySem sha256_ctx8_type =>
@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O)))))))
  (@fst
     (prod
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end)
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end)
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O))))))))
     (prod
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end)
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end)
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O))))))))))
     (@snd
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end)
              ((fix buffer_type (X : Ty.Ty) (depth : nat) {struct depth} : Ty.Ty :=
                  match depth return Ty.Ty with
                  | O => Ty.Sum Ty.Unit X
                  | S d => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d))) (buffer_type X d)
                  end) (Word.Word (S (S (S O)))) (S (S (S (S O)))))))
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word (S (S (S (S (S (S O))))))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))) c))
     : forall _ : Ty.tySem sha256_ctx8_type, BinNums.Z

Arguments ctx8_count c
ctx8_add_buffer_model =
fix ctx8_add_buffer_model (d : nat) (c : Ty.tySem sha256_ctx8_type) {struct d} :
    forall _ : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) d), option (Ty.tySem sha256_ctx8_type) :=
  match
    d as d0 return (forall _ : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) d0), option (Ty.tySem sha256_ctx8_type))
  with
  | O =>
      fun b : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) O) =>
      match b return (option (Ty.tySem sha256_ctx8_type)) with
      | inl _ =>
          match BinInt.Z.ltb (ctx8_count c) ctx8_limit return (option (Ty.tySem sha256_ctx8_type)) with
          | true => @Some (Ty.tySem sha256_ctx8_type) c
          | false => @None (Ty.tySem sha256_ctx8_type)
          end
      | inr x => ctx8_add1_model c x
      end
  | S d' =>
      fun b : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S d')) =>
      match
        @fst
          (sum
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) Ty.Unit)
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Vector (Word.Word (S (S (S O)))) (S d'))))
          ((fix tySem (X : Ty.Ty) : Set :=
              match X return Set with
              | Ty.Unit => unit
              | Ty.Sum A B => sum (tySem A) (tySem B)
              | Ty.Prod A B => prod (tySem A) (tySem B)
              end)
             ((fix buffer_type (X : Ty.Ty) (depth : nat) {struct depth} : Ty.Ty :=
                 match depth return Ty.Ty with
                 | O => Ty.Sum Ty.Unit X
                 | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d0))) (buffer_type X d0)
                 end) (Word.Word (S (S (S O)))) d')) b return (option (Ty.tySem sha256_ctx8_type))
      with
      | inl _ =>
          ctx8_add_buffer_model d' c
            (@snd
               (sum
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) Ty.Unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Vector (Word.Word (S (S (S O)))) (S d'))))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix buffer_type (X : Ty.Ty) (depth : nat) {struct depth} : Ty.Ty :=
                      match depth return Ty.Ty with
                      | O => Ty.Sum Ty.Unit X
                      | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d0))) (buffer_type X d0)
                      end) (Word.Word (S (S (S O)))) d')) b)
      | inr v =>
          match
            ctx8_add_list c (vector_values (Word.Word (S (S (S O)))) (S d') v)
            return (option (Ty.tySem sha256_ctx8_type))
          with
          | Some c' =>
              ctx8_add_buffer_model d' c'
                (@snd
                   (sum
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) Ty.Unit)
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Vector (Word.Word (S (S (S O)))) (S d'))))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix buffer_type (X : Ty.Ty) (depth : nat) {struct depth} : Ty.Ty :=
                          match depth return Ty.Ty with
                          | O => Ty.Sum Ty.Unit X
                          | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d0))) (buffer_type X d0)
                          end) (Word.Word (S (S (S O)))) d')) b)
          | None => @None (Ty.tySem sha256_ctx8_type)
          end
      end
  end
     : forall (d : nat) (_ : Ty.tySem sha256_ctx8_type) (_ : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) d)),
       option (Ty.tySem sha256_ctx8_type)

Arguments ctx8_add_buffer_model d%nat_scope c _
