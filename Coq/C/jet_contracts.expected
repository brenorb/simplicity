                             end) (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                         (prod
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S O))))))))
                            ((fix tySem (X0 : Ty.Ty) : Set :=
                                match X0 return Set with
                                | Ty.Unit => unit
                                | Ty.Sum A B => sum (tySem A) (tySem B)
                                | Ty.Prod A B => prod (tySem A) (tySem B)
                                end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) X) c x)) (ctx8_add_list c (bytes_of x))) (w : nat) (C : Ty.Ty)
         (array : Alg.Assertion.domain
                    (PF.CanonicalStructures.toAssertion
                       (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))
                    (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit X)) (c : Ty.tySem C) (ctx0 : Ty.tySem sha256_ctx8_type)
         (e : ext_environment) (xs : list (Ty.tySem X))
         (_ : forall
                i : (fix tySem (X0 : Ty.Ty) : Set :=
                       match X0 return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word w),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum Ty.Unit X)))
                (array
                   (@pair (Ty.tySem C)
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word w)) c i) e)
                (@Some (sum unit (Ty.tySem X))
                   match @List.nth_error (Ty.tySem X) xs (BinInt.Z.to_nat (wz w i)) return (sum unit (Ty.tySem X)) with
                   | Some x => @inr unit (Ty.tySem X) x
                   | None => @inl unit (Ty.tySem X) tt
                   end)) (cf : Ty.tySem sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem sha256_ctx8_type))
                (ctx8_add_list ctx0 (gen_bytes X bytes_of (@List.firstn (Ty.tySem X) (BinInt.Z.to_nat (wsize w)) xs)))
                (@Some (Ty.tySem sha256_ctx8_type) cf)),
       @ex (Ty.tySem (Ty.Sum sha256_ctx8_type sha256_ctx8_type))
         (fun r : Ty.tySem (Ty.Sum sha256_ctx8_type sha256_ctx8_type) =>
          and
            (@eq
               (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                  (Ty.tySem (Ty.Sum sha256_ctx8_type sha256_ctx8_type)))
               (@gen_loop_run X add w
                  (PF.CanonicalStructures.toAssertion
                     (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)) C array
                  (@pair (Ty.tySem C) (Ty.tySem sha256_ctx8_type) c ctx0) e)
               (@Some (Ty.tySem (Ty.Sum sha256_ctx8_type sha256_ctx8_type)) r))
            (@eq
               (prod
                  ((fix tySem (X0 : Ty.Ty) : Set :=
                      match X0 return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                  (prod
                     ((fix tySem (X0 : Ty.Ty) : Set :=
                         match X0 return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S O))))))))
                     ((fix tySem (X0 : Ty.Ty) : Set :=
                         match X0 return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
               match
                 r
                 return
                   (prod
                      ((fix tySem (X0 : Ty.Ty) : Set :=
                          match X0 return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                      (prod
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S O))))))))
                         ((fix tySem (X0 : Ty.Ty) : Set :=
                             match X0 return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
               with
               | inl a => a
               | inr a => a
               end cf))
ctx8_hash_closed_gen
     : forall (bs : list (Ty.tySem (Word.Word (S (S (S O))))))
         (buf : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
         (count : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       let l : list (Ty.tySem (Word.Word (S (S (S O))))) :=
         buffer_list (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) buf in
       forall
         _ : BinInt.Z.lt
               (BinInt.Z.add (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count)
                  (BinInt.Z.div
                     (BinInt.Z.add (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) l))
                        (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) bs)))
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               ctx8_limit,
       @ex (Ty.tySem sha256_ctx8_type)
         (fun cf : Ty.tySem sha256_ctx8_type =>
          and
            (@eq (option (Ty.tySem sha256_ctx8_type))
               (ctx8_add_list
                  (@pair (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) buf
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) count h)) bs)
               (@Some (Ty.tySem sha256_ctx8_type) cf))
            (@eq
               (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
               (@ctx8_finalize_spec (Alg.AssertionSem Option.option_Monad_Zero) cf)
               (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Word.from_hash256
                     (mk_hash256
                        (sha_stream l (state_regs h)
                           (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count) bs))))))
@fx_unit ?A
     : forall (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem Ty.Unit))
         (@jet_sha256_ctx8_init_spec.AC.unit ?A
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) a e)
         (@Some unit tt)
where
?A : [ |- Ty.Ty]
hash_words_spec_parametric
     : forall (k w : nat) (C : Ty.Ty) (alg1 alg2 : Alg.Assertion.Algebra) (R : Alg.Assertion.Parametric.Rel alg1 alg2)
         (a1 : Alg.Assertion.domain alg1 (Ty.Prod C (Word.Word w))
                 (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (a2 : Alg.Assertion.domain alg2 (Ty.Prod C (Word.Word w))
                 (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (_ : @Alg.Assertion.Parametric.rel alg1 alg2 R (Ty.Prod C (Word.Word w))
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) a1 a2),
       @Alg.Assertion.Parametric.rel alg1 alg2 R C (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@hash_words_spec k w alg1 C a1) (@hash_words_spec k w alg2 C a2)
iv_spec_regs
     : @eq (list Integers.Int.int) (state_regs (@sha256_iv_spec Alg.CoreFunSem tt)) sha256_iv_words
loop_bytes_length
     : forall (k : nat) (l : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))),
       @eq nat (@length (Ty.tySem (Word.Word (S (S (S O))))) (loop_bytes k l))
         (Nat.mul (PeanoNat.Nat.pow (S (S O)) k) (@length (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) l))
hash_words_sem
     : forall (k w : nat) (C : Ty.Ty)
         (array : Alg.Assertion.domain
                    (PF.CanonicalStructures.toAssertion
                       (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))
                    (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (c : Ty.tySem C) (e : ext_environment) (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
         (_ : forall
                i : (fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word w),
              @eq
                (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                   (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (array
                   (@pair (Ty.tySem C)
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Word w)) c i) e)
                (@Some (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) xs (BinInt.Z.to_nat (wz w i))
                     return (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x => @inr unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None => @inl unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end))
         (_ : BinInt.Z.lt
                (BinInt.Z.div (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)) (wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                ctx8_limit),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@hash_words_spec k w
            (PF.CanonicalStructures.toAssertion
               (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)) C array c e)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.from_hash256
               (hash_words_of k
                  (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (BinInt.Z.to_nat (wsize w)) xs))))
