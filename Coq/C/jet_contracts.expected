buffer_empty_cells =
fix buffer_empty_cells (X : Ty.Ty) (depth : nat) {struct depth} : list Cell :=
  match depth return (list Cell) with
  | O => @cons (option bool) (@Some bool false) (@List.repeat (option bool) (@None bool) (bitSize X))
  | S d =>
      @app (option bool)
        (@cons (option bool) (@Some bool false)
           (@List.repeat (option bool) (@None bool) (bitSize (Word.Vector X (S d))))) (buffer_empty_cells X d)
  end
     : forall (_ : Ty.Ty) (_ : nat), list Cell

