scalar_negate_state =
match scalar_negate_tree return sstate with
| Some r =>
    match r return sstate with
    | RDone state _ => state
    | RIf _ _ _ => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
    end
| None => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
end
     : sstate
scalar_negate_limbs =
match sregs scalar_negate_state return (list sx) with
| nil => @nil sx
| cons reg _ => @List.map cell sx cell_sx (rcells reg)
end
     : list sx
