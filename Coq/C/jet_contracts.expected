           (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@inputs_hash_spec alg) (@outputs_hash_spec alg)))
        (@ctx8_addn_spec (S (S (S (S (S (S O)))))) term)) (@input_utxos_hash_spec alg))
