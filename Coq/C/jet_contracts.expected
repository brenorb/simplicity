exec_copy_src_init
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (_ : frame_base_valid sbase)
