     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit
        (Ty.Prod sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O)))))))))) sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
           (@sha256_ctx8_init_spec core) (@tapleaf_hash_spec alg)) (@ctx8_addn_spec (S (S (S (S (S O))))) term))
     (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
