@jet_core_pad_spec.AC.copair Ty.Unit X (Ty.Sum Ty.Unit Ty.Unit) term (@Bit.false Ty.Unit term) (@Bit.true X term)
     : forall (X : Ty.Ty) (term : Alg.Core.Algebra), Alg.Core.domain term (Ty.Sum Ty.Unit X) (Ty.Sum Ty.Unit Ty.Unit)

