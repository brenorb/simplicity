u64_add_with_carry
     : forall x y : Integers.Int64.int,
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.add x y))
            (BinInt.Z.modulo (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y))
               Integers.Int64.modulus))
         (@eq BinNums.Z (BinInt.Z.b2z (Integers.Int64.ltu (Integers.Int64.add x y) x))
            (BinInt.Z.div (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y)) Integers.Int64.modulus))
u64_add_carry_bit
     : forall x y : Integers.Int64.int,
       @eq BinNums.Z
         (Integers.Int64.unsigned
            (Integers.Int64.repr
               (Integers.Int.signed
                  match Integers.Int64.ltu (Integers.Int64.add x y) x return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end)))
         (BinInt.Z.div (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y)) Integers.Int64.modulus)
u64_add_carry_bit_right
     : forall x y : Integers.Int64.int,
       @eq BinNums.Z
         (Integers.Int64.unsigned
            (Integers.Int64.repr
               (Integers.Int.signed
                  match Integers.Int64.ltu (Integers.Int64.add x y) y return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end)))
         (BinInt.Z.div (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y)) Integers.Int64.modulus)
scalar_carry64_value
     : forall x y : Integers.Int64.int,
       @eq BinNums.Z (Integers.Int64.unsigned (scalar_carry64 x y))
         (BinInt.Z.div (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y)) Integers.Int64.modulus)
scalar_carry64_bounds
     : forall x y : Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned (scalar_carry64 x y)))
         (BinInt.Z.le (Integers.Int64.unsigned (scalar_carry64 x y)) (BinNums.Zpos BinNums.xH))
u64_three_add_value
     : forall x y z : Integers.Int64.int,
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.add (Integers.Int64.add x y) z))
            (BinInt.Z.modulo
               (BinInt.Z.add (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y))
                  (Integers.Int64.unsigned z)) Integers.Int64.modulus))
         (@eq BinNums.Z
            (Integers.Int64.unsigned
               (Integers.Int64.add (scalar_carry64 x y) (scalar_carry64 (Integers.Int64.add x y) z)))
            (BinInt.Z.div
               (BinInt.Z.add (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y))
                  (Integers.Int64.unsigned z)) Integers.Int64.modulus))
