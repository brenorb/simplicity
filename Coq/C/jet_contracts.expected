point_negate_args =
fun k : point_coordinate =>
@cons sx (XP O (point_coordinate_offset k))
  (@cons sx (XP O (point_coordinate_offset k)) (@cons sx (XIc Integers.Int.one) (@nil sx)))
     : forall _ : point_coordinate, list sx

