     : forall (right fill : bool) (amount : Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S O)))))
         (x : Ty.tySem (Word.Word (S (S (S (S O)))))) (r : Integers.Int64.int) (a : Integers.Int.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S O))))) x))
         (_ : @eq BinNums.Z (Integers.Int.unsigned a) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S O))) amount)),
