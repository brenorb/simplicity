                      (Integers.Ptrofs.unsigned os)))) (st st' : cst) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (lhs e : Clight.expr) (_ : sha_R lb bs os bc oc st le m)
         (_ : @eq (option cst) (interp_assign st lhs e) (@Some cst st')),
