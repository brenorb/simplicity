         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor)
         (_ : and (BinInt.Z.le BinNums.Z0 read_cursor)
                (BinInt.Z.le read_cursor
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge read_cursor x)
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
