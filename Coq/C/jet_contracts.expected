hash_loop_body =
fun (k : nat) (term : Alg.Assertion.Algebra) (C W : Ty.Ty)
  (array : Alg.Assertion.domain term (Ty.Prod C W) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod (Ty.Prod C W) sha256_ctx8_type)
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) sha256_ctx8_type)
  (Ty.Sum sha256_ctx8_type sha256_ctx8_type) core
  (@jet_sha256_ctx8_init_spec.AC.pair (Ty.Prod (Ty.Prod C W) sha256_ctx8_type)
     (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.take (Ty.Prod C W) sha256_ctx8_type
        (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) core array)
     (@jet_sha256_ctx8_init_spec.AC.drop (Ty.Prod C W) sha256_ctx8_type sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core)))
  (@jet_sha256_ctx8_init_spec.AC.case Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k) sha256_ctx8_type
     (Ty.Sum sha256_ctx8_type sha256_ctx8_type) core
     (@jet_sha256_ctx8_init_spec.AC.injl (Ty.Prod Ty.Unit sha256_ctx8_type) sha256_ctx8_type sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.drop Ty.Unit sha256_ctx8_type sha256_ctx8_type core
           (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core)))
     (@jet_sha256_ctx8_init_spec.AC.injr (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) k) sha256_ctx8_type)
        sha256_ctx8_type sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) k) sha256_ctx8_type)
           (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k)) sha256_ctx8_type core
           (@jet_sha256_ctx8_init_spec.AC.pair (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) k) sha256_ctx8_type)
              sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) k) core
              (@jet_sha256_ctx8_init_spec.AC.drop (Word.Vector (Word.Word (S (S (S O)))) k) sha256_ctx8_type
                 sha256_ctx8_type core (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core))
              (@jet_sha256_ctx8_init_spec.AC.take (Word.Vector (Word.Word (S (S (S O)))) k) sha256_ctx8_type
                 (Word.Vector (Word.Word (S (S (S O)))) k) core
                 (@jet_sha256_ctx8_init_spec.AC.iden (Word.Vector (Word.Word (S (S (S O)))) k) core)))
           (@ctx8_addn_spec k term))))
     : forall (k : nat) (term : Alg.Assertion.Algebra) (C W : Ty.Ty)
         (_ : Alg.Assertion.domain term (Ty.Prod C W) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))),
       Alg.Assertion.domain term (Ty.Prod (Ty.Prod C W) sha256_ctx8_type) (Ty.Sum sha256_ctx8_type sha256_ctx8_type)

Arguments hash_loop_body k%nat_scope {term} {C W}%ty_scope array
hash_loop_spec =
fun (k w : nat) (term : Alg.Assertion.Algebra) (C : Ty.Ty)
  (array : Alg.Assertion.domain term (Ty.Prod C (Word.Word w))
             (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))) =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod C sha256_ctx8_type) (Ty.Sum sha256_ctx8_type sha256_ctx8_type)
  sha256_ctx8_type core
  (@for_while_program w C sha256_ctx8_type sha256_ctx8_type core (@hash_loop_body k term C (Word.Word w) array))
  (@jet_sha256_ctx8_init_spec.AC.copair sha256_ctx8_type sha256_ctx8_type sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core)
     (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core))
     : forall (k w : nat) (term : Alg.Assertion.Algebra) (C : Ty.Ty)
         (_ : Alg.Assertion.domain term (Ty.Prod C (Word.Word w))
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))),
       Alg.Assertion.domain term (Ty.Prod C sha256_ctx8_type) sha256_ctx8_type

