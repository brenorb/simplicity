         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mc (@Ctypes.Internal Clight.function f_simplicity_read8)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr
                (@Ctypes.Internal Clight.function (wide_reader (byte_rotate_width s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr2
                (@Ctypes.Internal Clight.function (wide_writer (byte_rotate_width s)))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (left_rotate_byte_payload s r a)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (left_rotate_byte_function s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
eval_left_rotate_byte_layout_machine
     : forall (env : Values.val) (s : byte_rotate_size) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (amount : Ty.tySem (Word.Word (S (S (S O)))))
         (x : Ty.tySem (Word.Word (wide_log (byte_rotate_width s)))) (cursor rc : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.add (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (wide_bits (byte_rotate_width s))))))
         (_ : @frame_input_word_at (S (S (S O))) m bi edge rc amount)
         (_ : @frame_input_word_at (wide_log (byte_rotate_width s)) m bi edge
                (BinInt.Z.add rc (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) x)
         (_ : write_frame_at m bd dbase bw outedge cursor (wide_bits (byte_rotate_width s))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (left_rotate_byte_function s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (wide_log (byte_rotate_width s))) (left_rotate_byte_machine_value s amount x)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (wide_bits (byte_rotate_width s))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (wide_bits (byte_rotate_width s)))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
@word8_reverse_items_spec ?term
     : @eq (list (Alg.Core.domain ?term (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))) (Ty.Sum Ty.Unit Ty.Unit)))
         (@List.rev
            (Alg.Core.domain ?term (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))) (Ty.Sum Ty.Unit Ty.Unit))
            (@vector_items_spec (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))) ?term))
         (@List.map nat (Alg.Core.domain ?term (Word.Word (S (S (S O)))) (Ty.Sum Ty.Unit Ty.Unit))
            (fun i : nat => @word_bit_spec (S (S (S O))) i ?term) (List.seq O (S (S (S (S (S (S (S (S O))))))))))
where
?term : [ |- Alg.Core.Algebra]
left_rotate_control_step_parametric
     : forall (m : nat) (X : Ty.Ty) (n i : nat),
       @Alg.Core.Parametric (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Prod (Word.Word m) (Word.Vector X n))
         (@left_rotate_control_step m X n i)
left_rotate_controls_spec_parametric
     : forall (m : nat) (X : Ty.Ty) (n : nat) (indices : list nat),
       @Alg.Core.Parametric (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Vector X n)
         (@left_rotate_controls_spec m X n indices)
left_rotate_word_spec_parametric
     : forall m n : nat,
       @Alg.Core.Parametric (Ty.Prod (Word.Word m) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n) (@left_rotate_word_spec m n)
left_rotate_byte_spec_parametric
     : forall s : byte_rotate_size,
       @Alg.Core.Parametric
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s))))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s))) (@left_rotate_byte_spec s)
left_rotate32_controls_normalform
     : forall (amount : Ty.tySem (Word.Word (S (S (S O))))) (x : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq (Ty.tySem (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
         (@left_rotate_word_spec (S (S (S O))) (S (S (S (S (S O))))) Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S O))))))) amount x))
         (rotate_low_controls_fun (S (S (S (S (S O))))) O (S (S (S (S (S O))))) amount x)
left_rotate64_controls_normalform
     : forall (amount : Ty.tySem (Word.Word (S (S (S O))))) (x : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))),
       @eq (Ty.tySem (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O))))))))
         (@left_rotate_word_spec (S (S (S O))) (S (S (S (S (S (S O)))))) Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) amount x))
         (rotate_low_controls_fun (S (S (S (S (S (S O)))))) O (S (S (S (S (S (S O)))))) amount x)
rotate_const_left_bits
     : forall (n : nat) (a : BinNums.Z) (x : Ty.tySem (Word.Word n)) (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j (Zpower.two_power_nat n))),
       @eq bool
         (BinInt.Z.testbit
            (@Word.ToZ.Theory.toZ (Word.WordToZ n) (@Word.rotate_const (Ty.Sum Ty.Unit Ty.Unit) n Alg.CoreFunSem a x))
            j)
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)
            (BinInt.Z.modulo (BinInt.Z.sub j a) (Zpower.two_power_nat n)))
rotate_mod_sub
     : forall (a b modulus : BinNums.Z) (_ : not (@eq BinNums.Z modulus BinNums.Z0)),
       @eq BinNums.Z (BinInt.Z.modulo (BinInt.Z.sub (BinInt.Z.modulo a modulus) b) modulus)
         (BinInt.Z.modulo (BinInt.Z.sub a b) modulus)
rotate_low_controls_bits
     : forall (n i count : nat) (amount : Ty.tySem (Word.Word (S (S (S O))))) (x : Ty.tySem (Word.Word n))
         (j : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j (Zpower.two_power_nat n))),
       @eq bool
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ n) (rotate_low_controls_fun n i count amount x)) j)
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)
            (BinInt.Z.modulo (BinInt.Z.sub j (rotate_control_amount i count amount)) (Zpower.two_power_nat n)))
rotate_control_amount32
     : forall amount : Ty.tySem (Word.Word (S (S (S O)))),
       @eq BinNums.Z (rotate_control_amount O (S (S (S (S (S O))))) amount)
         (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) amount)
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
rotate_control_amount64
     : forall amount : Ty.tySem (Word.Word (S (S (S O)))),
       @eq BinNums.Z (rotate_control_amount O (S (S (S (S (S (S O)))))) amount)
         (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) amount)
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
left_rotate_byte_spec_bits
     : forall (s : byte_rotate_size)
         (amount : prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
         (x : (fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s))))
         (j : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j (wide_bits (byte_rotate_width s)))),
       @eq bool
         (BinInt.Z.testbit
            (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log (byte_rotate_width s)))
               (@left_rotate_byte_spec s Alg.CoreFunSem
                  (@pair
                     (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                        (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit))))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s)))) amount x))) j)
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log (byte_rotate_width s))) x)
            (BinInt.Z.modulo
               (BinInt.Z.sub j
                  (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) amount)
                     (wide_bits (byte_rotate_width s)))) (wide_bits (byte_rotate_width s))))
wide_rotate_result_bits
     : forall (s : wide_size) (x : Ty.tySem (Word.Word (wide_log s))) (r : Integers.Int64.int)
         (a : Integers.Int.int) (j : BinNums.Z)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x))
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a) (wide_bits s)))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j (wide_bits s))),
       @eq bool (Integers.Int64.testbit (wide_rotate_result s r a) j)
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x)
            (BinInt.Z.modulo (BinInt.Z.sub j (Integers.Int.unsigned a)) (wide_bits s)))
left_rotate_byte_machine_denotes
     : forall (s : byte_rotate_size) (amount : Ty.tySem (Word.Word (S (S (S O)))))
         (x : Ty.tySem (Word.Word (wide_log (byte_rotate_width s)))),
       @eq (Ty.tySem (Word.Word (wide_log (byte_rotate_width s)))) (left_rotate_byte_machine_value s amount x)
         (@left_rotate_byte_spec s Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (wide_log (byte_rotate_width s)))) amount
               x))
left_rotate_byte_local_spec
     : forall s : byte_rotate_size,
       jet_local_spec (left_rotate_byte_function s)
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (wide_log (byte_rotate_width s))))
         (Word.Word (wide_log (byte_rotate_width s)))
         (fun ax : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (wide_log (byte_rotate_width s)))) =>
          @left_rotate_byte_spec s Alg.CoreFunSem ax)
left_rotate32_local_spec
     : jet_local_spec f_simplicity_left_rotate_32 (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S (S (S O)))))))
         (Word.Word (S (S (S (S (S O))))))
         (fun ax : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S (S (S O))))))) =>
          @left_rotate_byte_spec R32 Alg.CoreFunSem ax)
left_rotate64_local_spec
     : jet_local_spec f_simplicity_left_rotate_64
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S (S (S (S O))))))))
         (Word.Word (S (S (S (S (S (S O)))))))
         (fun ax : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S (S (S (S O)))))))) =>
          @left_rotate_byte_spec R64 Alg.CoreFunSem ax)
left_rotate_byte_context
     : forall s : byte_rotate_size,
       @jet_context_for (left_rotate_byte_function s)
         (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s))))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s))) (@left_rotate_byte_spec s)
left_rotate_byte_guarantees
     : forall (s : byte_rotate_size) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (wide_log (byte_rotate_width s)))))
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add read_cursor
                   (BinInt.Z.of_nat
                      (bitSize (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (wide_log (byte_rotate_width s)))))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor
                (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (wide_log (byte_rotate_width s)))) a))
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.of_nat (bitSize (Word.Word (wide_log (byte_rotate_width s)))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (left_rotate_byte_function s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (wide_log (byte_rotate_width s))) (@left_rotate_byte_spec s Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Word.Word (wide_log (byte_rotate_width s)))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat
                                                    (bitSize (Word.Word (wide_log (byte_rotate_width s))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
left_rotate_byte_context_guarantees
     : forall (s : byte_rotate_size) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout)
         (ctx : Context)
         (a : Ty.tySem
                (Ty.Prod (Word.Word (S (S (S O))))
                   (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode
                 (Ty.Prod (Word.Word (S (S (S O))))
                    (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s)))) a)
              (newWriteFrame (bitSize (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s)))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode
                 (Ty.Prod (Word.Word (S (S (S O))))
                    (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s)))) a)
              (fullWriteFrame
                 (@encode (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (wide_log (byte_rotate_width s)))
                    (@left_rotate_byte_spec s Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (left_rotate_byte_function s)) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@left_rotate_byte_spec s Naive.translate) (Running s0) (Running s1))))
right_rotate_control_step_parametric
     : forall (m : nat) (X : Ty.Ty) (n i : nat),
       @Alg.Core.Parametric (Ty.Prod (Word.Word m) (Word.Vector X n)) (Ty.Prod (Word.Word m) (Word.Vector X n))
         (@right_rotate_control_step m X n i)
right_rotate_controls_spec_parametric
     : forall (m : nat) (X : Ty.Ty) (n : nat) (indices : list nat),
       @Alg.Core.Parametric (Ty.Prod (Word.Word m) (Word.Vector X n)) (Word.Vector X n)
         (@right_rotate_controls_spec m X n indices)
right_rotate_word_spec_parametric
     : forall m n : nat,
       @Alg.Core.Parametric (Ty.Prod (Word.Word m) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n))
