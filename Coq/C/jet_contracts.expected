         (_ : forall (m : Memory.Mem.mem) (bt : Values.block) (tbase : BinNums.Z) (bin : Values.block)
                (inbase : BinNums.Z) (ix nI ver seq : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 tbase)
                (_ : BinInt.Z.le
                       (BinInt.Z.add tbase
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                       Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 inbase)
                (_ : BinInt.Z.le
                       (BinInt.Z.add
                          (BinInt.Z.add
                             (BinInt.Z.add inbase
                                (BinInt.Z.mul
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                   (Integers.Int64.unsigned ix)))
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                       Integers.Ptrofs.max_unsigned)
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m bt
                          (BinInt.Z.add tbase
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                       (@Some Values.val (Values.Vlong nI)))
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m bt
                          (BinInt.Z.add tbase
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                       (@Some Values.val (Values.Vlong ver)))
                (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add tbase BinNums.Z0))
                       (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m bin
                          (BinInt.Z.add
                             (BinInt.Z.add inbase
                                (BinInt.Z.mul
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                   (Integers.Int64.unsigned ix)))
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                       (@Some Values.val (Values.Vlong seq))) (_ : @eq bool (Integers.Int64.ltu ix nI) true),
              ClightBigstep.Clight2.eval_funcall bitcoin_ge m (@Ctypes.Internal Clight.function f)
                (@cons Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))
                   (@cons Values.val (Values.Vlong ix) (@nil Values.val))) Events.E0 m
                (Values.Vlong
                   (dist_result ver seq
                      match dist return bool with
                      | true => negb (parse_sequence_tag seq)
                      | false => parse_sequence_tag seq
                      end))),
       application_jet_local_spec jet bitcoin_ge Bitcoin.Bitcoin.env Ty.Unit (Word.Word (S (S (S (S O)))))
         bitcoin_distance_env_rep
         (fun (a : Ty.tySem Ty.Unit) (environment : Bitcoin.Bitcoin.env) =>
          @bitcoin_lock_distance_program dist
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a environment)
