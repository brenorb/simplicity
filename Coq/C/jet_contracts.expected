xfun (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type))) secp_shift64_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_scalar_reduce (@cons sx (XP O BinNums.Z0) (@cons sx (XL2I (XLv (S (S (S (S O)))))) (@nil sx)))
  scalar_reduce_initial_regs (@nil event) (S (S (S (S (S O)))))
     : option res
