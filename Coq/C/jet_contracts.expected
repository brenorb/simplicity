               (Clight.Ssequence shift8_fill_step
                  (Clight.Ssequence
                     (Clight.Sifthenelse shift8_count_expr (Clight.Sset _output (shift8_scalar_expr right))
                        (Clight.Sset _output
                           (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Ctypesdefs.tuchar)))
                     (Clight.Ssequence shift8_fill_step
