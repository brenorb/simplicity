     : @eq Clight.statement (Clight.fn_body f_read32s) (Clight.Sloop read32s_loop_body read32s_loop_step)
exec_read32s_body
     : forall (m mi ms : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (bi : Values.block)
         (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (x : Integers.Int64.int)
         (count : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le (BinInt.Z.add input (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                Integers.Ptrofs.max_unsigned)
         (_ : and (BinInt.Z.lt BinNums.Z0 count) (BinInt.Z.le count Integers.Int64.max_unsigned))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _frame le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _x le)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr count))))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_read32)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mi
                (Values.Vlong x))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint32 mi bi input (Values.Vint (Integers.Int64.loword x)))
                (@Some Memory.Mem.mem ms)),
       ClightBigstep.Clight2.exec_stmt ge0 Clight.empty_env le m read32s_loop_body Events.E0
         (read32s_body_env le bi input x) ms ClightBigstep.Out_normal
exec_read32s_run
     : forall (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bi : Values.block)
         (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int64.int)
         (_ : BinInt.Z.le BinNums.Z0 input)
         (_ : BinInt.Z.le
                (BinInt.Z.add input
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.of_nat (@length Integers.Int64.int xs)))) Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le (BinInt.Z.of_nat (@length Integers.Int64.int xs)) Integers.Int64.max_unsigned)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _frame le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _x le)
                (@Some Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _n le)
                (@Some Values.val
                   (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat (@length Integers.Int64.int xs))))))
         (_ : read32s_run bi input bf base xs m mf),
       @ex Clight.temp_env
         (fun lef : Clight.temp_env =>
          ClightBigstep.Clight2.exec_stmt ge0 Clight.empty_env le m (Clight.fn_body f_read32s) Events.E0 lef mf
            ClightBigstep.Out_normal)
