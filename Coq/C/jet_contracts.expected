     (Clight.Sifthenelse (median_cmp src_ty _z _x) (median_set3 src_ty dst_ty _x) (median_set3 src_ty dst_ty _z)))
  (Clight.Sifthenelse (median_cmp src_ty _x _z) (median_set2 src_ty dst_ty _x)
     (Clight.Sifthenelse (median_cmp src_ty _z _y) (median_set3 src_ty dst_ty _y) (median_set3 src_ty dst_ty _z)))
     : forall (_ : Ctypes.type) (_ : Ctypes.type), Clight.statement

