| TMaj =>
    long_bin BOr
      (long_bin BOr (long_bin BAnd (Clight.Etempvar _x Ctypesdefs.tulong) (Clight.Etempvar _y Ctypesdefs.tulong))
         (long_bin BAnd (Clight.Etempvar _y Ctypesdefs.tulong) (Clight.Etempvar _z Ctypesdefs.tulong)))
      (long_bin BAnd (Clight.Etempvar _z Ctypesdefs.tulong) (Clight.Etempvar _x Ctypesdefs.tulong))
| TXorXor =>
    long_bin BXor (long_bin BXor (Clight.Etempvar _x Ctypesdefs.tulong) (Clight.Etempvar _y Ctypesdefs.tulong))
      (Clight.Etempvar _z Ctypesdefs.tulong)
| TCh =>
    long_bin BOr (long_bin BAnd (Clight.Etempvar _x Ctypesdefs.tulong) (Clight.Etempvar _y Ctypesdefs.tulong))
      (long_bin BAnd
         (Clight.Eunop Cop.Onotint
            (Clight.Ebinop Cop.Omul (Clight.Econst_int Integers.Int.one Ctypesdefs.tuint)
               (Clight.Etempvar _x Ctypesdefs.tulong) Ctypesdefs.tulong) Ctypesdefs.tulong)
         (Clight.Etempvar _z Ctypesdefs.tulong))
end
     : forall _ : ternary_op, Clight.expr

