                (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val)) Events.E0 mr
                (Values.Vlong xr))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr mr be ebase)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
         (_ : ClightBigstep.Clight2.eval_funcall bitcoin_ge mr (@Ctypes.Internal Clight.function f)
                (@cons Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase)) (@nil Values.val)) Events.E0 mr
                (Values.Vlong r)),
       @ex Clight.temp_env
         (fun le1 : Clight.temp_env =>
          ClightBigstep.Clight2.exec_stmt bitcoin_ge (bitcoin_version_locals bl) le mc (bitcoin_check_lock_rest fid)
