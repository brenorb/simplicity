                       (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                       (@jet_bitcoin_build_tapbranch_spec.AC.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))
                    (@jet_bitcoin_build_tapbranch_spec.AC.take (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                       (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
                       (@jet_bitcoin_build_tapbranch_spec.AC.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))))))
        (@SHA256.hashBlock term))
     (@jet_bitcoin_build_tapbranch_spec.AC.comp
        (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) term
