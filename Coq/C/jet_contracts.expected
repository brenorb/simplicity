left_pad_bit8_context_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Ty.Sum Ty.Unit Ty.Unit) a) (newWriteFrame (bitSize (Word.Word (S (S (S O)))))))
         in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Ty.Sum Ty.Unit Ty.Unit) a)
              (fullWriteFrame (@encode (Word.Word (S (S (S O)))) (@left_pad_low_1_n Alg.CoreFunSem (S (S (S O))) a))))
         in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function f_simplicity_left_pad_low_1_8) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@left_pad_low_1_n Naive.translate (S (S (S O)))) (Running s0) (Running s1))))
