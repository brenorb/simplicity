forget_after =
fix forget_after (n : nat) (regs : list region) {struct regs} : list region :=
  match regs return (list region) with
  | nil => @nil region
  | cons h t =>
      match n return (list region) with
      | O => @cons region (forget_region h) (forget_after O t)
      | S k => @cons region h (forget_after k t)
      end
  end
     : forall (_ : nat) (_ : list region), list region

