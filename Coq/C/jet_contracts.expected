eval_make_tapleaf
     : forall (_ : memcpy_model) (m : Memory.Mem.mem) (bres : Values.block) (ores : BinNums.Z)
         (v : Integers.Int.int) (bcmr : Values.block) (ocmr : Integers.Ptrofs.int) (cmr : list Integers.Int.int)
         (_ : @eq Integers.Int.int
                (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) v) v)
         (_ : BinInt.Z.le BinNums.Z0 ores)
         (_ : BinInt.Z.le
                (BinInt.Z.add ores
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) ores)
         (_ : Memory.Mem.range_perm m bres ores
                (BinInt.Z.add ores
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable)
         (_ : @eq nat (@length Integers.Int.int cmr) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned ocmr)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bcmr
                   (BinInt.Z.add (Integers.Ptrofs.unsigned ocmr)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j cmr Integers.Int.zero))))
         (_ : sha_dispatch_ok m)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m (sha_symbol_block jets_sha._sha256_max_counter) BinNums.Z0)
                (@Some Values.val (Values.Vlong sha_max_counter))) (_ : sha_tapleaf_tag_ok m),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall sha_ge m
               (@Ctypes.Internal Clight.function jets_sha.f_simplicity_bitcoin_make_tapleaf)
               (@cons Values.val (Values.Vptr bres (Integers.Ptrofs.repr ores))
                  (@cons Values.val (Values.Vint v) (@cons Values.val (Values.Vptr bcmr ocmr) (@nil Values.val))))
               Events.E0 m' Values.Vundef)
            (and
               (forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 m' bres
                     (BinInt.Z.add ores
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                  (@Some Values.val
                     (Values.Vint (@List.nth Integers.Int.int j (make_tapleaf_regs v cmr) Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : or (not (@eq Values.block b bres))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) ores)
                               (BinInt.Z.le
                                  (BinInt.Z.add ores
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
