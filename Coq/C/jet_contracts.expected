                                 (@RingMicromega.PsatzMulC BinNums.Z (@EnvRing.Pc BinNums.Z (BinNums.Zneg BinNums.xH))
                                    (RingMicromega.PsatzIn BinNums.Z (S (S O)))) (RingMicromega.PsatzIn BinNums.Z O))
                              ZMicromega.DoneProof) (@nil ZMicromega.ZArithProof))) in
                 let __varmap : VarMap.t BinNums.Z :=
                   @VarMap.Branch BinNums.Z (@VarMap.Elt BinNums.Z __x2) __x1 (@VarMap.Empty BinNums.Z) in
                 let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
                   @Tauto.IMPL (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                     (@Tauto.OR (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                        (@Tauto.AND (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                           (@Tauto.X (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp __p1)
                           (@Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                              (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEX BinNums.Z BinNums.xH)
                                 RingMicromega.OpEq
                                 (@EnvRing.PEc BinNums.Z
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) tt))
                        (@Tauto.AND (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                           (@Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                              (@RingMicromega.Build_Formula BinNums.Z
                                 (@EnvRing.PEadd BinNums.Z (@EnvRing.PEX BinNums.Z (BinNums.xO BinNums.xH))
                                    (@EnvRing.PEc BinNums.Z
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 RingMicromega.OpLe
                                 (@EnvRing.PEc BinNums.Z
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) tt)
                           (@Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                              (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEX BinNums.Z BinNums.xH)
                                 RingMicromega.OpEq
                                 (@EnvRing.PEadd BinNums.Z (@EnvRing.PEX BinNums.Z (BinNums.xO BinNums.xH))
                                    (@EnvRing.PEc BinNums.Z
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) tt)))
                     (@None unit)
                     (@Tauto.IMPL (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                        (@Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                           (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z BinNums.Z0)
                              RingMicromega.OpLe (@EnvRing.PEX BinNums.Z (BinNums.xO BinNums.xH))) tt)
                        (@None unit)
                        (@Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
                           (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEX BinNums.Z BinNums.xH)
                              RingMicromega.OpEq
                              (@EnvRing.PEc BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           tt)) in
                 ZMicromega.ZTautoChecker_sound __ff __wit
                   (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
                   (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
               __arith
                 (BinInt.Z.lt (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                    (BinInt.Z.add (BinInt.Z.of_nat (@length Integers.Int.int rs))
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                 (BinInt.Z.of_nat (@length Integers.Int.int rs)) z0 H0 cstr))
           (@length Integers.Int.int
              (@List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S (S O))))))))))
           (@List.repeat_length Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S (S O))))))))))
        (@length Integers.Int.int
           (@app Integers.Int.int rs
              (@List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S (S O)))))))))))
        (@List.app_length Integers.Int.int rs
