                                      (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                       (@Some Values.val (Values.Vlong seq))) (_ : @eq bool (Integers.Int64.ltu ix nI) true),
              ClightBigstep.Clight2.eval_funcall bitcoin_ge m (@Ctypes.Internal Clight.function f)
                (@cons Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))
                   (@cons Values.val (Values.Vlong ix) (@nil Values.val))) Events.E0 m
