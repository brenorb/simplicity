        (@ctx8_addn_spec (S (S (S (S (S (S O)))))) term))
     (@PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
        (@BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.CurrentIndex)))
  (@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S O))))
     sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@ctx8_addn_spec (S (S O)) term)
     (@ctx8_finalize_spec term))
