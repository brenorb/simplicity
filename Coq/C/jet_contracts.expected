         (Word.from_hash256 Digest.sha256_iv)
sha256_iv_spec_cells
     : @eq (list Cell) (@encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@sha256_iv_spec Alg.CoreFunSem tt))
         (@List.concat Cell
            (@List.map Integers.Int.int (list Cell)
               (fun x : Integers.Int.int =>
                @encode (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))
                  (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned x)))
               sha256_iv_words))
