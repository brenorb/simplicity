    | RIf _ _ _ => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
    end
| None => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
end
     : sstate
scalar_limbs_of =
fun value : BinNums.Z =>
@cons BinNums.Z
  (BinInt.Z.modulo value
     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
  (@cons BinNums.Z
     (BinInt.Z.modulo
        (BinInt.Z.div value
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     (@cons BinNums.Z
        (BinInt.Z.modulo
           (BinInt.Z.div value
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        (@cons BinNums.Z
           (BinInt.Z.div value
              (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
           (@nil BinNums.Z))))
     : forall _ : BinNums.Z, list BinNums.Z

