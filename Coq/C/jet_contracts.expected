                  (add16_payload r s))))
         (add16_spec_value
            (@pair (Ty.tySem (Word.Word (S (S (S (S O)))))) (Ty.tySem (Word.Word (S (S (S (S O)))))) x y))
add32_values_denote_input
     : forall (r s : Integers.Int64.int) (x y : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned s) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) y)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (wide_log W32))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (wide_log W32)))
            match add32_carry r s return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (decode_wide W32
               (Integers.Int64.zero_ext
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (add32_payload r s))))
         (add32_spec_value
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S (S (S O))))))) x y))
add64_values_denote_input
     : forall (r s : Integers.Int64.int) (x y : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned s)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) y)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (wide_log W64))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (wide_log W64)))
            match add64_carry r s return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (decode_wide W64
               (Integers.Int64.zero_ext
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (add64_payload r s))))
         (add64_spec_value
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) x
               y))
encode_word
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq (list Cell) (@encode (Word.Word n) x)
         (@List.map bool (option bool) (@Some bool) (@frame_input_word_bits n x))
@frame_input_word_at_encode ?n
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x : Ty.tySem (Word.Word ?n)),
       iff (@frame_input_word_at ?n m bw edge cursor x)
         (frame_input_cells_at m bw edge cursor (@encode (Word.Word ?n) x))
where
?n : [ |- nat]
@frame_input_word_pair_encode ?n
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x y : Ty.tySem (Word.Word ?n)),
       iff
         (and (@frame_input_word_at ?n m bw edge cursor x)
            (@frame_input_word_at ?n m bw edge (BinInt.Z.add cursor (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) ?n)))
               y))
         (frame_input_cells_at m bw edge cursor
            (@encode (Ty.Prod (Word.Word ?n) (Word.Word ?n))
               (@pair (Ty.tySem (Word.Word ?n)) (Ty.tySem (Word.Word ?n)) x y)))
where
?n : [ |- nat]
byte_slice_at_encode
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word (S (S (S O))))),
       iff (byte_slice_at m bw edge cursor x)
         (and
            (and (BinInt.Z.le BinNums.Z0 cursor)
               (BinInt.Z.le cursor
                  (BinInt.Z.sub Integers.Int64.max_unsigned
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (frame_input_cells_at m bw edge cursor (@encode (Word.Word (S (S (S O)))) x)))
byte_input_single_encode
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (x : Ty.tySem (Word.Word (S (S (S O))))),
       iff
         (byte_input_at m bf base bw edge cursor
            (@cons (Ty.tySem (Word.Word (S (S (S O))))) x (@nil (Ty.tySem (Word.Word (S (S (S O))))))))
         (and (frame_base_valid base)
            (and (frame_fields_at m bf base bw edge cursor)
               (and
                  (and (BinInt.Z.le BinNums.Z0 cursor)
                     (BinInt.Z.le cursor
                        (BinInt.Z.sub Integers.Int64.max_unsigned
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (frame_input_cells_at m bw edge cursor (@encode (Word.Word (S (S (S O)))) x)))))
byte_input_pair_encode
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (x y : Ty.tySem (Word.Word (S (S (S O))))),
       iff
         (byte_input_at m bf base bw edge cursor
            (@cons (Ty.tySem (Word.Word (S (S (S O))))) x
               (@cons (Ty.tySem (Word.Word (S (S (S O))))) y (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
         (and (frame_base_valid base)
            (and (frame_fields_at m bf base bw edge cursor)
               (and
                  (and (BinInt.Z.le BinNums.Z0 cursor)
                     (BinInt.Z.le cursor
                        (BinInt.Z.sub Integers.Int64.max_unsigned
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (frame_input_cells_at m bw edge cursor
                     (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
                        (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O))))) x y))))))
slice_word_output_encode
     : forall (lg : nat) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word lg))
         (_ : BinInt.Z.le (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) lg))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : BinInt.Z.le (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) lg)) cursor),
       iff
         (@ex Integers.Int64.int
            (fun p : Integers.Int64.int =>
             and (slice_output_at (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) lg)) m bw edge cursor p)
               (@eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ lg)))
                  (@Word.ToZ.Theory.fromZ (Word.WordToZ lg) (Integers.Int64.unsigned p)) x)))
         (frame_output_cells_at m bw edge cursor (@encode (Word.Word lg) x))
wide_output_at_encode
     : forall (s : wide_size) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word (wide_log s))) (_ : BinInt.Z.le (wide_bits s) cursor),
       iff (wide_output_at s m bw edge cursor x)
         (frame_output_cells_at m bw edge cursor (@encode (Word.Word (wide_log s)) x))
byte_output_at_encode
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word (S (S (S O)))))
         (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) cursor),
       iff (byte_output_at m bw edge cursor x)
         (frame_output_cells_at m bw edge cursor (@encode (Word.Word (S (S (S O)))) x))
carry_wide_output_encode
     : forall (s : wide_size) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (v : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s))))
         (_ : BinInt.Z.le (BinInt.Z.add (BinNums.Zpos BinNums.xH) (wide_bits s)) cursor),
       iff (carry_wide_output_at s m bw edge cursor v)
         (frame_output_cells_at m bw edge cursor
            (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s))) v))
carry_byte_output_encode
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (v : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))))
         (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))) cursor),
       iff (carry_byte_output_at m bw edge cursor v)
         (frame_output_cells_at m bw edge cursor
            (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))) v))
bm_rep_after_write
     : forall (m mf : Memory.Mem.mem) (L : bm_layout) (s : RunState) (wd : list Cell) (e : nat)
         (out : list Cell)
         (_ : @eq WriteFrame (activeWriteFrame s) (Build_WriteFrame wd (Nat.add (@length Cell out) e)))
         (_ : le (S O) (@length Cell out)) (_ : bm_rep m L s) (_ : bm_separated L s)
         (_ : frame_output_cells_at mf (cells_blk L) (edge_ofs (active_write_loc L))
                (BinInt.Z.of_nat (Nat.add (@length Cell out) e)) out)
         (_ : write_prefix_at m mf (cells_blk L) (edge_ofs (active_write_loc L))
                (BinInt.Z.of_nat (Nat.add (@length Cell out) e)))
         (_ : frame_fields_at mf (frames_blk L) (item_ofs (active_write_loc L)) (cells_blk L)
                (edge_ofs (active_write_loc L)) (BinInt.Z.of_nat e))
         (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                (_ : or (not (@eq Values.block b (frames_blk L)))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add (item_ofs (active_write_loc L))
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                          (BinInt.Z.le
                             (BinInt.Z.add (item_ofs (active_write_loc L))
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                (_ : or (not (@eq Values.block b (cells_blk L)))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add (edge_ofs (active_write_loc L))
                                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                   (BinInt.Z.div (BinInt.Z.of_nat e)
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                          (BinInt.Z.le
                             (BinInt.Z.add
                                (jet_write_layout.write_word_address (edge_ofs (active_write_loc L))
                                   (BinInt.Z.of_nat (Nat.add (@length Cell out) e)))
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs)),
       bm_rep mf L
         (Build_RunState (inactiveReadFrames s) (activeReadFrame s)
            (Build_WriteFrame (@app Cell (@List.rev Cell out) wd) e) (inactiveWriteFrames s))
@jet_context ?A ?B
     : forall (f : Clight.function) (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg ?A ?B)
         (_ : @Alg.Core.Parametric ?A ?B t) (_ : jet_local_spec f ?A ?B (fun a : Ty.tySem ?A => t Alg.CoreFunSem a))
         (_ : le (S O) (bitSize ?B)) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout)
         (ctx : Context) (a : Ty.tySem ?A),
       let s0 : RunState := fillContext ctx (Build_LocalState (@encode ?A a) (newWriteFrame (bitSize ?B))) in
       let s1 : RunState :=
         fillContext ctx (Build_LocalState (@encode ?A a) (fullWriteFrame (@encode ?B (t Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f)
               (jet_args env L) Events.E0 mf (Values.Vint Integers.Int.one))
            (and (bm_rep mf L s1) (runProgram (t Naive.translate) (Running s0) (Running s1))))
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
gap_buffer_separated
     : forall (L : bm_layout) (s : RunState)
         (_ : @eq nat (@length frame_loc (inactive_read_locs L)) (@length ReadFrame (inactiveReadFrames s)))
         (_ : @eq nat (@length frame_loc (inactive_write_locs L)) (@length WriteFrame (inactiveWriteFrames s)))
         (_ : gap_buffer_layout L s), bm_separated L s
one8_local_spec
     : jet_local_spec f_simplicity_one_8 Ty.Unit (Word.Word (S (S (S O))))
         (fun a : Ty.tySem Ty.Unit => @one8_spec Alg.CoreFunSem a)
one16_local_spec
     : jet_local_spec f_simplicity_one_16 Ty.Unit (Word.Word (S (S (S (S O)))))
         (fun a : Ty.tySem Ty.Unit => @wide_one_spec W16 Alg.CoreFunSem a)
one32_local_spec
     : jet_local_spec f_simplicity_one_32 Ty.Unit (Word.Word (S (S (S (S (S O))))))
         (fun a : Ty.tySem Ty.Unit => @wide_one_spec W32 Alg.CoreFunSem a)
one64_local_spec
     : jet_local_spec f_simplicity_one_64 Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))
         (fun a : Ty.tySem Ty.Unit => @wide_one_spec W64 Alg.CoreFunSem a)
increment8_local_spec
     : jet_local_spec f_simplicity_increment_8 (Word.Word (S (S (S O))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
         (fun a : Ty.tySem (Word.Word (S (S (S O)))) => @increment8_spec Alg.CoreFunSem a)
increment16_local_spec
     : jet_local_spec f_simplicity_increment_16 (Word.Word (S (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S O))))))
         (fun a : Ty.tySem (Word.Word (S (S (S (S O))))) => @increment16_spec Alg.CoreFunSem a)
increment32_local_spec
     : jet_local_spec f_simplicity_increment_32 (Word.Word (S (S (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
         (fun a : Ty.tySem (Word.Word (S (S (S (S (S O)))))) => @increment32_spec Alg.CoreFunSem a)
increment64_local_spec
     : jet_local_spec f_simplicity_increment_64 (Word.Word (S (S (S (S (S (S O)))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))
         (fun a : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))) => @increment64_spec Alg.CoreFunSem a)
add8_local_spec
     : jet_local_spec f_simplicity_add_8 (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
         (fun a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) => @add8_spec Alg.CoreFunSem a)
add16_local_spec
     : jet_local_spec f_simplicity_add_16 (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S O))))))
         (fun a : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))) =>
          @add16_spec Alg.CoreFunSem a)
add32_local_spec
     : jet_local_spec f_simplicity_add_32 (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
         (fun a : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) =>
          @add32_spec Alg.CoreFunSem a)
add64_local_spec
     : jet_local_spec f_simplicity_add_64
         (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))
         (fun a : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))) =>
          @add64_spec Alg.CoreFunSem a)
one8_context
     : @jet_context_for f_simplicity_one_8 Ty.Unit (Word.Word (S (S (S O)))) (@one8_spec)
one16_context
     : @jet_context_for f_simplicity_one_16 Ty.Unit (Word.Word (wide_log W16)) (@wide_one_spec W16)
one32_context
     : @jet_context_for f_simplicity_one_32 Ty.Unit (Word.Word (wide_log W32)) (@wide_one_spec W32)
one64_context
     : @jet_context_for f_simplicity_one_64 Ty.Unit (Word.Word (wide_log W64)) (@wide_one_spec W64)
increment8_context
     : @jet_context_for f_simplicity_increment_8 (Word.Word (S (S (S O))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))) (@increment8_spec)
increment16_context
     : @jet_context_for f_simplicity_increment_16 (Word.Word (S (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S O)))))) (@increment16_spec)
increment32_context
     : @jet_context_for f_simplicity_increment_32 (Word.Word (S (S (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O))))))) (@increment32_spec)
increment64_context
     : @jet_context_for f_simplicity_increment_64 (Word.Word (S (S (S (S (S (S O)))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))) (@increment64_spec)
add8_context
     : @jet_context_for f_simplicity_add_8 (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))) (@add8_spec)
add16_context
     : @jet_context_for f_simplicity_add_16 (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S O)))))) (@add16_spec)
add32_context
     : @jet_context_for f_simplicity_add_32
         (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O)))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O))))))) (@add32_spec)
add64_context
     : @jet_context_for f_simplicity_add_64
         (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))) (@add64_spec)
increment64_layout_witness
     : forall a z w : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))),
       @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          @ex bm_layout
            (fun L : bm_layout =>
             and (bm_rep m L (witness_state a z w))
               (and (bm_separated L (witness_state a z w))
                  (and (active_write_writable m L (witness_state a z w)) (gap_buffer_layout L (witness_state a z w))))))
increment64_layout_witness_context
     : forall (env : Values.val) (a z w : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))),
       @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          @ex bm_layout
            (fun L : bm_layout =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall ge0 m
                     (@Ctypes.Internal Clight.function f_simplicity_increment_64) (jet_args env L) Events.E0 mf
                     (Values.Vint Integers.Int.one))
                  (and
                     (bm_rep mf L
                        (fillContext (witness_ctx z w)
                           (Build_LocalState (@encode (Word.Word (S (S (S (S (S (S O))))))) a)
                              (fullWriteFrame
                                 (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))
                                    (@increment64_spec Alg.CoreFunSem a))))))
                     (and
                        (runProgram (@increment64_spec Naive.translate) (Running (witness_state a z w))
                           (Running
                              (fillContext (witness_ctx z w)
                                 (Build_LocalState (@encode (Word.Word (S (S (S (S (S (S O))))))) a)
                                    (fullWriteFrame
                                       (@encode
                                          (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))
                                          (@increment64_spec Alg.CoreFunSem a)))))))
                        (and
                           (@eq (list ReadFrame) (inactiveReadFrames (witness_ctx z w))
                              (@cons ReadFrame
                                 (Build_ReadFrame (@nil Cell) (@encode (Word.Word (S (S (S (S (S (S O))))))) z))
                                 (@nil ReadFrame)))
                           (@eq (list WriteFrame) (inactiveWriteFrames (witness_ctx z w))
                              (@cons WriteFrame
                                 (Build_WriteFrame (@List.rev Cell (@encode (Word.Word (S (S (S (S (S (S O))))))) w)) O)
                                 (@nil WriteFrame)))))))))
step2_determ
     : forall (ge : Clight.genv) (s : Clight.state) (t1 : Events.trace) (s1 : Clight.state)
         (t2 : Events.trace) (s2 : Clight.state) (_ : Clight.step2 ge s t1 s1) (_ : Clight.step2 ge s t2 s2),
       and (Events.match_traces (@Globalenvs.Genv.to_senv Clight.fundef Ctypes.type (Clight.genv_genv ge)) t1 t2)
         (forall _ : @eq Events.trace t1 t2, @eq Clight.state s1 s2)
eval_funcall_call_boundary
     : forall (p : Clight.program) (m : Memory.Mem.mem) (fd : Clight.fundef) (args : list Values.val)
         (mf : Memory.Mem.mem) (res : Values.val) (k : Clight.cont)
         (_ : ClightBigstep.Clight2.eval_funcall (Clight.globalenv p) m fd args Events.E0 mf res)
         (_ : Clight.is_call_cont k), @ex nat (fun n : nat => call_boundary (Clight.globalenv p) fd args k m res mf n)
eval_funcall_unique
     : forall (p : Clight.program) (m : Memory.Mem.mem) (fd : Clight.fundef) (args : list Values.val)
         (mf : Memory.Mem.mem) (res : Values.val) (t' : Events.trace) (m' : Memory.Mem.mem)
         (res' : Values.val) (_ : ClightBigstep.Clight2.eval_funcall (Clight.globalenv p) m fd args Events.E0 mf res)
         (_ : ClightBigstep.Clight2.eval_funcall (Clight.globalenv p) m fd args t' m' res'),
       and (@eq Events.trace t' Events.E0) (and (@eq Memory.Mem.mem m' mf) (@eq Values.val res' res))
eval_funcall_Kstop_terminates
     : forall (p : Clight.program) (m : Memory.Mem.mem) (fd : Clight.fundef) (args : list Values.val)
         (mf : Memory.Mem.mem) (res : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall (Clight.globalenv p) m fd args Events.E0 mf res),
       and
         (forall T : Events.traceinf,
          not
            (@Smallstep.forever Clight.genv Clight.state Clight.step2 (Clight.globalenv p)
               (Clight.Callstate fd args Clight.Kstop m) T))
         (forall (t : Events.trace) (S : Clight.state)
            (_ : @Smallstep.star Clight.genv Clight.state Clight.step2 (Clight.globalenv p)
                   (Clight.Callstate fd args Clight.Kstop m) t S)
            (_ : forall (t' : Events.trace) (S' : Clight.state), not (Clight.step2 (Clight.globalenv p) S t' S')),
          and (@eq Events.trace t Events.E0) (@eq Clight.state S (Clight.Returnstate res Clight.Kstop mf)))
eval_funcall_silent_guarantees
     : forall (p : Clight.program) (m : Memory.Mem.mem) (fd : Clight.fundef) (args : list Values.val)
         (mf : Memory.Mem.mem) (res : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall (Clight.globalenv p) m fd args Events.E0 mf res),
       silent_call_guarantees (Clight.globalenv p) fd args m res mf
jet_local_spec_guarantees
     : forall (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, Ty.tySem B)
         (_ : jet_local_spec f A B spec) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z) (a : Ty.tySem A) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize A))) Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor (@encode A a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and (frame_output_cells_at mf bw outedge cursor (@encode B (spec a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B)))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
@jet_context_guarantees ?A ?B
     : forall (f : Clight.function) (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg ?A ?B)
         (_ : @Alg.Core.Parametric ?A ?B t) (_ : jet_local_spec f ?A ?B (fun a : Ty.tySem ?A => t Alg.CoreFunSem a))
         (_ : le (S O) (bitSize ?B)) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout)
         (ctx : Context) (a : Ty.tySem ?A),
       let s0 : RunState := fillContext ctx (Build_LocalState (@encode ?A a) (newWriteFrame (bitSize ?B))) in
       let s1 : RunState :=
         fillContext ctx (Build_LocalState (@encode ?A a) (fullWriteFrame (@encode ?B (t Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f)
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (t Naive.translate) (Running s0) (Running s1))))
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
one8_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem Ty.Unit) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize Ty.Unit))) Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor (@encode Ty.Unit a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f_simplicity_one_8)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S O)))) (@one8_spec Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O))))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O)))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
