         (absorb_i (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value l) regs
            (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value bs))
         (@pair (list Integers.Int.int) (list Integers.Int.int)
