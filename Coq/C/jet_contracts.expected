            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (ternary1 k))
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@ternary_word_spec O k Naive.translate) (Running s0) (Running s1))))
