extend_bit_true_expr =
fun s : wide_size =>
match s return Clight.expr with
| W16 =>
    Clight.Econst_int
      (Integers.Int.repr
         (BinNums.Zpos
            (BinNums.xI
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
      Ctypesdefs.tint
| W32 => Clight.Econst_int (Integers.Int.repr (BinNums.Zneg BinNums.xH)) Ctypesdefs.tuint
| W64 => Clight.Econst_long (Integers.Int64.repr (BinNums.Zneg BinNums.xH)) Ctypesdefs.tulong
end
     : forall _ : wide_size, Clight.expr

Arguments extend_bit_true_expr s
extend_bit_raw =
fun (s : wide_size) (bit : bool) =>
match s return Values.val with
| W16 =>
    Values.Vint
      match bit return Integers.Int.int with
      | true =>
          Integers.Int.repr
            (BinNums.Zpos
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))))))
      | false => Integers.Int.zero
      end
| W32 =>
    Values.Vint match bit return Integers.Int.int with
                | true => Integers.Int.mone
                | false => Integers.Int.zero
                end
| W64 =>
    Values.Vlong
      match bit return Integers.Int64.int with
      | true => Integers.Int64.mone
      | false => Integers.Int64.zero
      end
end
     : forall (_ : wide_size) (_ : bool), Values.val

Arguments extend_bit_raw s bit%bool_scope
extend_bit_choice_expr =
