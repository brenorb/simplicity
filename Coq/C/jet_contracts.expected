Arguments parse_sequence_spec {term}
parse_sequence_enabled =
fun r : Integers.Int64.int =>
Integers.Int64.ltu r
  (Integers.Int64.shl Integers.Int64.one
     (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
     : forall _ : Integers.Int64.int, bool

Arguments parse_sequence_enabled r
parse_sequence_tag =
fun r : Integers.Int64.int =>
negb
  (Integers.Int64.eq
     (Integers.Int64.and r
        (Integers.Int64.shl Integers.Int64.one
           (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
     Integers.Int64.zero)
     : forall _ : Integers.Int64.int, bool

Arguments parse_sequence_tag r
parse_sequence_payload =
fun r : Integers.Int64.int =>
Integers.Int64.and r
  (Integers.Int64.repr
     (BinNums.Zpos
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
     : forall _ : Integers.Int64.int, Integers.Int64.int

Arguments parse_sequence_payload r
skip_frame_env =
fun (bf : Values.block) (base n : BinNums.Z) =>
@Maps.PTree.set Values.val _n (Values.Vlong (Integers.Int64.repr n))
  (@Maps.PTree.set Values.val _frame (Values.Vptr bf (Integers.Ptrofs.repr base))
     (Clight.create_undef_temps (Clight.fn_temps f_skipBits)))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments skip_frame_env bf (base n)%Z_scope
long_one_shift_expr =
fun k : BinNums.Z =>
Clight.Ebinop Cop.Oshl
  (Clight.Ecast (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint) Ctypesdefs.tulong)
  (Clight.Econst_int (Integers.Int.repr k) Ctypesdefs.tint) Ctypesdefs.tulong
     : forall _ : BinNums.Z, Clight.expr

Arguments long_one_shift_expr k%Z_scope
parse_sequence_enabled_expr =
Clight.Ebinop Cop.Olt (Clight.Etempvar _nSequence Ctypesdefs.tulong)
  (long_one_shift_expr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))) Ctypesdefs.tint
     : Clight.expr
parse_sequence_tag_expr =
Clight.Ebinop Cop.Oand (Clight.Etempvar _nSequence Ctypesdefs.tulong)
  (long_one_shift_expr (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))) Ctypesdefs.tulong
     : Clight.expr
parse_sequence_payload_expr =
Clight.Ebinop Cop.Oand (Clight.Etempvar _nSequence Ctypesdefs.tulong)
  (Clight.Econst_int
     (Integers.Int.repr
        (BinNums.Zpos
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
     Ctypesdefs.tint) Ctypesdefs.tulong
     : Clight.expr
le_parse_sequence_x =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
@Maps.PTree.set Values.val _nSequence (Values.Vlong r)
  (@Maps.PTree.set Values.val _t'1 (Values.Vlong r)
     (jet_arith8_layout_exec.le_arith8_layout env f_simplicity_parse_sequence bd dofs bs sofs))
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments le_parse_sequence_x env bd dofs bs sofs r
le_parse_sequence_flag =
fun (env : Values.val) (bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block)
  (sofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
@Maps.PTree.set Values.val _t'2
  (Values.Vint
     match parse_sequence_enabled r return Integers.Int.int with
     | true => Integers.Int.one
     | false => Integers.Int.zero
     end) (le_parse_sequence_x env bd dofs bs sofs r)
     : forall (_ : Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Values.block)
         (_ : Integers.Ptrofs.int) (_ : Integers.Int64.int), Maps.PTree.tree Values.val

Arguments le_parse_sequence_flag env bd dofs bs sofs r
parse_sequence_branch_calls =
fun (mb me : Memory.Mem.mem) (bd : Values.block) (dofs : Integers.Ptrofs.int) (r : Integers.Int64.int) =>
match parse_sequence_enabled r return Prop with
| true =>
    @ex Memory.Mem.mem
      (fun mt : Memory.Mem.mem =>
       and
         (ClightBigstep.Clight2.eval_funcall ge0 mb (@Ctypes.Internal Clight.function f_writeBit)
            (@cons Values.val (Values.Vptr bd dofs)
               (@cons Values.val
                  (Values.Vint
                     match parse_sequence_tag r return Integers.Int.int with
                     | true => Integers.Int.one
                     | false => Integers.Int.zero
                     end) (@nil Values.val))) Events.E0 mt
            (Values.Vint
               match parse_sequence_tag r return Integers.Int.int with
               | true => Integers.Int.one
               | false => Integers.Int.zero
               end))
         (ClightBigstep.Clight2.eval_funcall ge0 mt (@Ctypes.Internal Clight.function (wide_writer W16))
            (@cons Values.val (Values.Vptr bd dofs)
               (@cons Values.val (Values.Vlong (parse_sequence_payload r)) (@nil Values.val))) Events.E0 me
            Values.Vundef))
| false =>
    ClightBigstep.Clight2.eval_funcall ge0 mb (@Ctypes.Internal Clight.function f_skipBits)
      (@cons Values.val (Values.Vptr bd dofs)
         (@cons Values.val
            (Values.Vlong
               (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (@nil Values.val))) Events.E0 me Values.Vundef
end
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Integers.Int64.int), Prop

Arguments parse_sequence_branch_calls mb me bd dofs r
uint32_init_value =
fun z : BinNums.Z => Integers.Int64.loword (Integers.Int64.repr z)
     : forall _ : BinNums.Z, Integers.Int.int

Arguments uint32_init_value z%Z_scope
uint32_init_stmt =
fun (i : nat) (z : BinNums.Z) =>
Clight.Sassign
  (Clight.Ederef
     (Clight.Ebinop Cop.Oadd (Clight.Etempvar _iv (Ctypesdefs.tptr Ctypesdefs.tuint))
        (Clight.Econst_int (Integers.Int.repr (BinInt.Z.of_nat i)) Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tuint))
     Ctypesdefs.tuint) (Clight.Econst_long (Integers.Int64.repr z) Ctypesdefs.tulong)
     : forall (_ : nat) (_ : BinNums.Z), Clight.statement

Arguments uint32_init_stmt i%nat_scope z%Z_scope
uint32_init_stmts =
fix uint32_init_stmts (i : nat) (zs : list BinNums.Z) {struct zs} : Clight.statement :=
  match zs return Clight.statement with
  | nil => Clight.Sskip
  | cons z rest =>
      match rest return Clight.statement with
      | nil => uint32_init_stmt i z
      | cons _ _ => Clight.Ssequence (uint32_init_stmt i z) (uint32_init_stmts (S i) rest)
      end
  end
     : forall (_ : nat) (_ : list BinNums.Z), Clight.statement

Arguments uint32_init_stmts i%nat_scope zs%list_scope
uint32_array_at =
fun (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int) =>
forall (i : nat) (x : Integers.Int.int)
  (_ : @eq (option Integers.Int.int) (@List.nth_error Integers.Int.int xs i) (@Some Integers.Int.int x)),
@eq (option Values.val)
  (Memory.Mem.load AST.Mint32 m b
     (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
  (@Some Values.val (Values.Vint x))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int.int), Prop

Arguments uint32_array_at m b base%Z_scope xs%list_scope
