         (Clight.fn_body jets_secp.f_secp256k1_scalar_reduce_512)
reduce512_second_boundary
     : and
         (@eq bool (statement_ends_set jets_secp._p4 (@List.last Clight.statement reduce512_second_spine Clight.Sskip))
            true)
         (and (lt reduce512_first_count reduce512_second_count)
            (lt reduce512_second_count (@length Clight.statement reduce512_spine)))
reduce512_second_completes
     : @eq bool
         match reduce512_second_run return bool with
         | Some r =>
             match r return bool with
