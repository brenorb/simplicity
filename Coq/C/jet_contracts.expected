jet_elements_null_data_read_index.exec_elements_null_data_read_index_block
     : forall (parsed : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int))) (unused_hash : Digest.hash256)
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cur : BinNums.Z) (bi : Values.block) (inedge rc : BinNums.Z)
         (jw : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (be : Values.block) (ebase : BinNums.Z)
         (bt : Values.block) (txbase : BinNums.Z) (bout : Values.block) (outbase : BinNums.Z)
         (i : Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._simplicity_read32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._src e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._writeBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._skipBits e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_elements._writeHash e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_elements._i le)
                (@Some Values.val (Values.Vlong i)))
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : frame_fields_at m bl BinNums.Z0 bi inedge rc)
         (_ : @frame_input_word_at (S (S (S (S (S O))))) m bi inedge rc jw)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                Memtype.Writable) (_ : not (@eq Values.block bl bi)) (_ : not (@eq Values.block bl bd))
         (_ : not (@eq Values.block bl bw)) (_ : not (@eq Values.block bl be)) (_ : not (@eq Values.block bl bt))
         (_ : not (@eq Values.block bl bout))
         (_ : BinInt.Z.le (BinInt.Z.of_nat (@length (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) parsed))
                Integers.Int64.max_unsigned)
         (_ : jet_elements_null_data_index.elements_null_data_count_path m be ebase bt txbase bout outbase i
                (Integers.Int64.repr
                   (BinInt.Z.of_nat (@length (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) parsed))))
         (_ : forall (r : Integers.Int64.int)
                (_ : @eq BinNums.Z (Integers.Int64.unsigned r)
                       (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) jw)),
              jet_elements_null_data_read_index.elements_null_data_selected_private m bl bd dbase bw edge cur be ebase
                bt txbase bout outbase i r parsed unused_hash)
         (_ : write_frame_at m bd dbase bw edge cur
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             @ex Integers.Int64.int
               (fun r : Integers.Int64.int =>
                and
                  (@eq BinNums.Z (Integers.Int64.unsigned r)
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) jw))
                  (and
                     (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge e le m
                        jet_elements_null_data_read_index.elements_null_data_read_index_block Events.E0 le' mf
                        ClightBigstep.Out_normal)
                     (and
                        (jet_elements_null_data_read_index.write_effect_private bl m mf bd dbase bw edge cur
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                           (@encode
                              (Ty.Sum Ty.Unit
                                 (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                    (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))
                              (jet_elements_null_data_index.elements_null_data_index_value parsed r unused_hash)))
                        (@ex Memory.Mem.mem
                           (fun mr : Memory.Mem.mem =>
                            and
                              (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                 (_ : not (@eq Values.block b bl)),
                               @eq (option Values.val) (Memory.Mem.load chunk mr b ofs) (Memory.Mem.load chunk m b ofs))
                              (and
                                 (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                  Memory.Mem.perm mr b ofs kind p)
                                 (and
                                    (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                     Memory.Mem.valid_block mr b)
                                    (jet_elements_effects.write_effect mr mf bd dbase bw edge cur
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xI
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                       (@encode
                                          (Ty.Sum Ty.Unit
                                             (Ty.Sum (Ty.Prod (Word.Word (S O)) (Word.Word (S (S (S (S (S (...))))))))
                                                (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S O))))))
                                          (jet_elements_null_data_index.elements_null_data_index_value parsed r
                                             unused_hash))))))))))))
