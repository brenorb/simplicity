         (_ : BinInt.Z.le (BinInt.Z.of_nat i)
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
