wide_binary_guarantees
     : forall (k : binary_op) (s : wide_size) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
