reduce512_typed_stage_run_eq
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int),
       @eq (option res) (reduce512_typed_stage_run digits m6)
         (@Some res (RDone (reduce512_typed_stage_state digits m6) ONormal))
reduce512_typed_stage_log
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int),
       @eq (list event) (slog (reduce512_typed_stage_state digits m6)) (@nil event)
reduce512_typed_stage_limb_kinds
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int),
       @eq bool (@List.forallb sx (isk KL) (reduce512_typed_stage_limbs digits m6)) true
reduce512_third_source
     : @eq Clight.statement (statement_sequence reduce512_second_spine reduce512_third_stage) reduce512_third_prefix
reduce512_third_boundary
     : and
         (@eq bool (statement_ends_set jets_secp._c (@List.last Clight.statement reduce512_third_spine Clight.Sskip))
            true)
         (and (lt reduce512_second_count reduce512_third_count)
            (lt reduce512_third_count (@length Clight.statement reduce512_spine)))
reduce512_third_completes
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq bool
         match reduce512_third_run digits p4 return bool with
         | Some r =>
             match r return bool with
             | RDone _ o =>
                 match o return bool with
                 | ONormal => true
                 | OBreak => false
                 | OContinue => false
                 | OReturn _ => false
                 end
             | RIf _ _ _ => false
             end
         | None => false
         end true
