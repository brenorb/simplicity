              (fullWriteFrame (@encode (Ty.Sum Ty.Unit Ty.Unit) (@divides_word_spec (S (S (S O))) Alg.CoreFunSem a))))
         in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f_simplicity_divides_8)
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@divides_word_spec (S (S (S O))) Naive.translate) (Running s0) (Running s1))))
wide_divides_body
     : forall s : wide_size,
       @eq Clight.statement (Clight.fn_body (wide_divides s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar _src (Ctypes.Tstruct _frameItem Ctypes.noattr))
               (Clight.Etempvar _src (Ctypes.Tstruct _frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (wide_binary_read s _t'1) (Clight.Sset _x (Clight.Etempvar _t'1 Ctypesdefs.tulong)))
               (Clight.Ssequence
                  (Clight.Ssequence (wide_binary_read s _t'2) (Clight.Sset _y (Clight.Etempvar _t'2 Ctypesdefs.tulong)))
                  (Clight.Ssequence
                     (Clight.Ssequence wide_divides_choose
                        (jet_arith8_layout_exec.frame_writer_call _writeBit Ctypesdefs.tbool Ctypesdefs.tbool
                           wide_divides_test_expr))
