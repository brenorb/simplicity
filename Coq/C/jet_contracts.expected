           (@cons (prod AST.ident Clight.function)
              (@pair AST.ident Clight.function _simplicity_write32 f_simplicity_write32)
              (@cons (prod AST.ident Clight.function)
                 (@pair AST.ident Clight.function _simplicity_write64 f_simplicity_write64)
                 (@cons (prod AST.ident Clight.function)
                    (@pair AST.ident Clight.function _simplicity_read4 f_simplicity_read4)
                    (@cons (prod AST.ident Clight.function)
                       (@pair AST.ident Clight.function _simplicity_read8 f_simplicity_read8)
                       (@cons (prod AST.ident Clight.function)
                          (@pair AST.ident Clight.function _simplicity_read16 f_simplicity_read16)
                          (@cons (prod AST.ident Clight.function)
                             (@pair AST.ident Clight.function _simplicity_read32 f_simplicity_read32)
                             (@cons (prod AST.ident Clight.function)
                                (@pair AST.ident Clight.function _simplicity_read64 f_simplicity_read64)
                                (@cons (prod AST.ident Clight.function)
                                   (@pair AST.ident Clight.function _peekBit f_peekBit)
                                   (@cons (prod AST.ident Clight.function)
                                      (@pair AST.ident Clight.function _readBit f_readBit)
                                      (@cons (prod AST.ident Clight.function)
                                         (@pair AST.ident Clight.function _writeBit f_writeBit)
                                         (@cons (prod AST.ident Clight.function)
                                            (@pair AST.ident Clight.function _forwardBits f_forwardBits)
