     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m mi mf : Memory.Mem.mem)
         (lef : Clight.temp_env) (suffix : Clight.statement) (out : ClightBigstep.outcome)
         (bq : Values.block) (ofs : Integers.Ptrofs.int) (ah b : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _q le) (@Some Values.val (Values.Vptr bq ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _ah le) (@Some Values.val (Values.Vlong ah)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _b le) (@Some Values.val (Values.Vlong b)))
