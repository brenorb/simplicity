                  (fe_val (Integers.Int64.unsigned t0) (Integers.Int64.unsigned t1) (Integers.Int64.unsigned t2)
                     (Integers.Int64.unsigned t3) (Integers.Int64.unsigned t4)) feP)))
field_add_run_eq
     : @eq (option res) field_add_run (@Some res (RDone field_add_state ONormal))
field_add_return
     : @eq (option sx) (@Maps.PTree.get sx BinNums.xH (stemps field_add_state)) (@None sx)
eval_field_add_from_owned_region
     : forall (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho layout field_add_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and (rep rho layout (sregs field_add_state) mf)
               (and
                  (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                     (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        rshape (sregs field_add_state))
                     (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                        rshape field_add_initial_regs))
                  (lframe
                     (fun (b : Values.block) (pos : BinNums.Z) =>
                      not
                        (foot layout
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              field_add_initial_regs) b pos)) m mf))))
add_cell_present
     : forall (n : nat) (_ : lt n (S (S (S (S (S O)))))),
