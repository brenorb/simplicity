wide_one_spec =
fun (s : wide_size) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)) term (@Bit.true Ty.Unit term)
  (@left_pad_low_1_n term (wide_log s))
