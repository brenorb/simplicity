eval_wide_test_value_layout_matches_spec
     : forall (env : Values.val) (s : wide_size) (one : bool) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (x : Ty.tySem (Word.Word (wide_log s))) (cursor rc : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc) (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (wide_bits s))))
         (_ : @frame_input_word_at (wide_log s) m bi edge rc x)
