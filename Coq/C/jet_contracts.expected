                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (byte_write_low outedge (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))))
                                  (BinInt.Z.le
