unary_borrow_spec_numeric
     : forall (k : unary_borrow_op) (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq BinNums.Z (borrow_word_balance n (@unary_borrow_spec k n Alg.CoreFunSem x))
         (unary_borrow_delta k (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
unary_borrow_representation_matches
     : forall (k : unary_borrow_op) (n : nat) (x payload : Ty.tySem (Word.Word n))
         (_ : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ n) payload)
                (BinInt.Z.modulo (unary_borrow_delta k (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)) (word_modulus n))),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word n)))
         (@pair (sum unit unit) (Ty.tySem (Word.Word n))
            match
              BinInt.Z.ltb (unary_borrow_delta k (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)) BinNums.Z0
              return (sum unit unit)
            with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end payload) (@unary_borrow_spec k n Alg.CoreFunSem x)
wide_unary_values_denote_input
     : forall (k : unary_borrow_op) (s : wide_size) (x : Ty.tySem (Word.Word (wide_log s)))
         (r : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (wide_log s))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (wide_log s)))
            match wide_unary_borrow k r return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end (decode_wide s (Integers.Int64.zero_ext (wide_bits s) (wide_unary_payload k r))))
         (@unary_borrow_spec k (wide_log s) Alg.CoreFunSem x)
unary8_values_denote_spec
     : forall (k : unary_borrow_op) (payload : Integers.Int64.int),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S O))))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S O)))))
