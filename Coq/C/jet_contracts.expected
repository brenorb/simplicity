scalar_bind =
fix scalar_bind (sigma : forall _ : nat, sx) (flag x : sx) {struct x} : sx :=
  match x return sx with
  | XI _ => x
  | XIc _ => x
  | XL _ => x
  | XLc _ => x
  | XLv n => sigma n
  | XV _ => x
  | XA _ _ => x
  | XP _ _ => x
  | XIb o a b => XIb o (scalar_bind sigma flag a) (scalar_bind sigma flag b)
  | XLb o a b => XLb o (scalar_bind sigma flag a) (scalar_bind sigma flag b)
  | XIsh o a k => XIsh o (scalar_bind sigma flag a) k
  | XLsh o a k => XLsh o (scalar_bind sigma flag a) k
  | XIcmp c sg a b => XIcmp c sg (scalar_bind sigma flag a) (scalar_bind sigma flag b)
  | XLcmp c sg a b => XLcmp c sg (scalar_bind sigma flag a) (scalar_bind sigma flag b)
  | XI2L sg a => XI2L sg (scalar_bind sigma flag a)
  | XL2I a =>
      match a return sx with
      | XI _ => XL2I (scalar_bind sigma flag a)
      | XIc _ => XL2I (scalar_bind sigma flag a)
      | XL _ => XL2I (scalar_bind sigma flag a)
      | XLc _ => XL2I (scalar_bind sigma flag a)
      | XLv n => match PeanoNat.Nat.eqb n (S (S (S (S O)))) return sx with
                 | true => flag
                 | false => XL2I (sigma n)
                 end
      | XV _ => XL2I (scalar_bind sigma flag a)
      | XA _ _ => XL2I (scalar_bind sigma flag a)
      | XP _ _ => XL2I (scalar_bind sigma flag a)
      | XIb _ _ _ => XL2I (scalar_bind sigma flag a)
      | XLb _ _ _ => XL2I (scalar_bind sigma flag a)
      | XIsh _ _ _ => XL2I (scalar_bind sigma flag a)
      | XLsh _ _ _ => XL2I (scalar_bind sigma flag a)
      | XIcmp _ _ _ _ => XL2I (scalar_bind sigma flag a)
      | XLcmp _ _ _ _ => XL2I (scalar_bind sigma flag a)
      | XI2L _ _ => XL2I (scalar_bind sigma flag a)
      | XL2I _ => XL2I (scalar_bind sigma flag a)
      | XIcast _ _ _ => XL2I (scalar_bind sigma flag a)
      | XInz _ => XL2I (scalar_bind sigma flag a)
      | XLnz _ => XL2I (scalar_bind sigma flag a)
      | XIz _ => XL2I (scalar_bind sigma flag a)
      | XLz _ => XL2I (scalar_bind sigma flag a)
      | XIneg _ => XL2I (scalar_bind sigma flag a)
      | XLneg _ => XL2I (scalar_bind sigma flag a)
      | XInot _ => XL2I (scalar_bind sigma flag a)
      | XLnot _ => XL2I (scalar_bind sigma flag a)
      end
  | XIcast sz sg a => XIcast sz sg (scalar_bind sigma flag a)
  | XInz a => XInz (scalar_bind sigma flag a)
  | XLnz a => XLnz (scalar_bind sigma flag a)
  | XIz a => XIz (scalar_bind sigma flag a)
  | XLz a => XLz (scalar_bind sigma flag a)
  | XIneg a => XIneg (scalar_bind sigma flag a)
  | XLneg a => XLneg (scalar_bind sigma flag a)
  | XInot a => XInot (scalar_bind sigma flag a)
  | XLnot a => XLnot (scalar_bind sigma flag a)
  end
     : forall (_ : forall _ : nat, sx) (_ : sx) (_ : sx), sx

