    | W32 => f_simplicity_xor_xor_32
    | W64 => f_simplicity_xor_xor_64
    end
| TCh =>
    match s return Clight.function with
    | W16 => f_simplicity_ch_16
    | W32 => f_simplicity_ch_32
    | W64 => f_simplicity_ch_64
    end
end
     : forall (_ : ternary_op) (_ : wide_size), Clight.function

