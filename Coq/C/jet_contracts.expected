point_negate_run_eq
     : forall k : point_coordinate,
       @eq (option res) (point_negate_run k) (@Some res (RDone (point_negate_state k) ONormal))
point_negate_return
     : forall k : point_coordinate,
       @eq (option sx) (@Maps.PTree.get sx BinNums.xH (stemps (point_negate_state k))) (@None sx)
point_negate_log_nil
     : forall k : point_coordinate, @eq bool (leaves_log_nil (RDone (point_negate_state k) ONormal)) true
eval_point_negate_from_owned_region
     : forall (k : point_coordinate) (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho layout (point_write_initial_regs k) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
               (@cons Values.val
                  (Values.Vptr (blk layout O)
                     (Integers.Ptrofs.repr (BinInt.Z.add (bas layout O) (point_coordinate_offset k))))
                  (@cons Values.val
                     (Values.Vptr (blk layout O)
                        (Integers.Ptrofs.repr (BinInt.Z.add (bas layout O) (point_coordinate_offset k))))
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (rep rho layout (sregs (point_negate_state k)) mf)
               (lframe
                  (fun (b : Values.block) (pos : BinNums.Z) =>
                   not
                     (foot layout
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           (point_write_initial_regs k)) b pos)) m mf)))
point_negate_cell_present
     : forall (k : point_coordinate) (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @List.In cell
         (mkcell
            (BinInt.Z.add (point_coordinate_offset k)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat n)))
            AST.Mint64 (@Some sx (negate_limb_expr n)))
         (rcells (@List.hd region (mkreg (@nil cell) true (@None BinNums.Z)) (sregs (point_negate_state k))))
point_negate_rep_loads
     : forall (k : point_coordinate) (m : Memory.Mem.mem) (layout : layout) (rho : forall _ : nat, Integers.Int64.int)
         (_ : rep rho layout (sregs (point_negate_state k)) m) (n : nat) (_ : lt n (S (S (S (S (S O)))))),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (blk layout O)
            (BinInt.Z.add (bas layout O)
