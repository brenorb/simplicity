  (@Word.ToZ.Theory.toZ (Word.WordToZ n)
     (@snd
        (sum
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) Ty.Unit)
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) Ty.Unit))
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end) (Word.Word n)) z))
  (BinInt.Z.mul (word_modulus n)
     (@Word.ToZ.Theory.toZ Word.BitToZ
        (@fst
           (sum
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end) Ty.Unit)
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end) Ty.Unit))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) (Word.Word n)) z)))
