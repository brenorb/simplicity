read4_crossing_high =
fun (k : BinNums.Z) (high : Integers.Int64.int) =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
  (Integers.Int.or Integers.Int.zero
     (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
        (Integers.Int.shl (read4_narrow (Integers.Int64.zero_ext k high))
           (Integers.Int64.loword
              (Integers.Int64.repr (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) k))))))
     : forall (_ : BinNums.Z) (_ : Integers.Int64.int), Integers.Int.int

