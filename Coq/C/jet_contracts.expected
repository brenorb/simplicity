sha256_max_counter_threshold
     : @eq Integers.Int64.int
         (Integers.Int64.shru
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
