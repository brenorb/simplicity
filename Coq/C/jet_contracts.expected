annexes_sem
     : forall (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : BitcoinFull.env),
       @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
         (@BitcoinFull.sem (Word.Word (S (S (S (S (S O))))))
