let c6 : symbolic_column :=
  column_symbolic_muladd_fast (S (S (S O))) (S (S (S (S (S (S (S O))))))) (column_symbolic_extract c5) in
@cons sx (sc_lo c0)
  (@cons sx (sc_lo c1)
     (@cons sx (sc_lo c2)
        (@cons sx (sc_lo c3)
           (@cons sx (sc_lo c4) (@cons sx (sc_lo c5) (@cons sx (sc_lo c6) (@cons sx (sc_hi c6) (@nil sx))))))))
     : list sx
