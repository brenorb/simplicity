reduce512_second_run_eq
     : @eq (option res) reduce512_second_run (@Some res (RDone reduce512_second_state ONormal))
reduce512_second_temps_present
     : @eq bool
         (@List.forallb BinNums.positive
            (fun id : BinNums.positive =>
             match @Maps.PTree.get sx id (stemps reduce512_second_state) return bool with
             | Some _ => true
             | None => false
