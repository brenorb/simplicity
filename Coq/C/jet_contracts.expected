ternary8_expr =
fun k : ternary_op =>
match k return Clight.expr with
| TMaj =>
    int_bin BOr Ctypesdefs.tint
      (int_bin BOr Ctypesdefs.tint
         (int_bin BAnd Ctypesdefs.tint (Clight.Etempvar _x Ctypesdefs.tuchar) (Clight.Etempvar _y Ctypesdefs.tuchar))
         (int_bin BAnd Ctypesdefs.tint (Clight.Etempvar _y Ctypesdefs.tuchar) (Clight.Etempvar _z Ctypesdefs.tuchar)))
      (int_bin BAnd Ctypesdefs.tint (Clight.Etempvar _z Ctypesdefs.tuchar) (Clight.Etempvar _x Ctypesdefs.tuchar))
| TXorXor =>
    int_bin BXor Ctypesdefs.tint
