bitcoin_tx_is_final_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
              (and (BinInt.Z.le BinNums.Z0 ebase)
                 (and
                    (BinInt.Z.le
                       (BinInt.Z.add ebase
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                       Integers.Ptrofs.max_unsigned)
                    (and (BinInt.Z.le BinNums.Z0 tbase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add tbase
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO
                                            (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                             Integers.Ptrofs.max_unsigned)
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                             (and
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint8unsigned m bt
                                      (BinInt.Z.add tbase
                                         (BinNums.Zpos
                                            (BinNums.xO
                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI ...)))))))))
                                   (@Some Values.val
                                      (Values.Vint
                                         (bool_int
                                            (@List.forallb Bitcoin.sigTxInput sequence_final
                                               (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx environment)))))))
                                (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                   (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                      (@pair (prod Values.block BinNums.Z) BinNums.Z
                                         (@pair Values.block BinNums.Z be ebase)
                                         (BinInt.Z.add ebase
                                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                      (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                         (@pair (prod Values.block BinNums.Z) BinNums.Z
                                            (@pair Values.block BinNums.Z bt
                                               (BinInt.Z.add tbase
                                                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                            (BinInt.Z.add tbase
                                               (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))
                                         (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments bitcoin_tx_is_final_env_rep m env environment fp%list_scope
final_tail =
fun alg : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit Ty.Unit)
  (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) alg (@predicate_spec (S (S (S (S (S O))))) true alg)
  (@Alg.Core.Combinators.copair Ty.Unit Ty.Unit (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) alg
     (@Alg.Core.Combinators.injl Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit alg (@Bit.false Ty.Unit alg))
     (@Alg.Core.Combinators.injr Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit alg (@Alg.Core.Combinators.unit Ty.Unit alg)))
     : forall alg : Alg.Core.Algebra,
       Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)

Arguments final_tail {alg}
final_body =
fun (alg : Alg.Core.Algebra)
  (op : Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))) =>
@Alg.Core.Combinators.comp (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit)
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) alg
  (@Alg.Core.Combinators.take (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg
     (@Alg.Core.Combinators.drop Ty.Unit (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg op))
  (@Alg.Core.Combinators.copair Ty.Unit (Word.Word (S (S (S (S (S O)))))) (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit) alg
     (@Alg.Core.Combinators.injl Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit alg (@Bit.true Ty.Unit alg))
     (@final_tail alg))
     : forall (alg : Alg.Core.Algebra)
         (_ : Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))),
       Alg.Core.domain alg (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit)
         (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)

