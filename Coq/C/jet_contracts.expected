wide_mixed_bits =
fix wide_mixed_bits (xs : list (prod wide_size Integers.Int64.int)) : BinNums.Z :=
  match xs return BinNums.Z with
  | nil => BinNums.Z0
  | cons p xs0 => match p return BinNums.Z with
                  | pair s _ => BinInt.Z.add (wide_bits s) (wide_mixed_bits xs0)
                  end
  end
     : forall _ : list (prod wide_size Integers.Int64.int), BinNums.Z

