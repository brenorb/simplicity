     : forall cs : list byte_chunk, BinInt.Z.le BinNums.Z0 (byte_chunks_width cs)
exec_buffer8_read_loop_layout
     : forall (chunks : list byte_chunk) (m : Memory.Mem.mem) (le : Maps.PTree.tree Values.val)
         (bf : Values.block) (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
