order8_context
     : forall k : order_op,
       @jet_context_for (order8 k) (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
         (Ty.Sum Ty.Unit Ty.Unit) (@order_word_spec k (S (S (S O))))
order8_guarantees
     : forall (k : order_op) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add read_cursor
                   (BinInt.Z.of_nat (bitSize (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor
                (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize (Ty.Sum Ty.Unit Ty.Unit)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (order8 k))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Ty.Sum Ty.Unit Ty.Unit) (@order_word_spec k (S (S (S O))) Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Ty.Sum Ty.Unit Ty.Unit)))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Ty.Sum Ty.Unit Ty.Unit))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
order8_context_guarantees
     : forall (k : order_op) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a)
              (newWriteFrame (bitSize (Ty.Sum Ty.Unit Ty.Unit)))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a)
              (fullWriteFrame (@encode (Ty.Sum Ty.Unit Ty.Unit) (@order_word_spec k (S (S (S O))) Alg.CoreFunSem a))))
         in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (order8 k))
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@order_word_spec k (S (S (S O))) Naive.translate) (Running s0) (Running s1))))
is_zero_word_spec_parametric
     : forall n : nat, @Alg.Core.Parametric (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) (@is_zero_word_spec n)
is_one_word_spec_parametric
     : forall n : nat, @Alg.Core.Parametric (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) (@is_one_word_spec n)
test_value_spec_parametric
     : forall (n : nat) (one : bool),
       @Alg.Core.Parametric (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) (@test_value_spec n one)
is_zero_word_spec_numeric
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq bool (Bit.toBool (@is_zero_word_spec n Alg.CoreFunSem x))
         (BinInt.Z.eqb (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) BinNums.Z0)
word_modulus_at_least_two
     : forall n : nat, BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) (word_modulus n)
decrement_payload_zero_iff_one
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq bool
         (BinInt.Z.eqb
            (@Word.ToZ.Theory.toZ (Word.WordToZ n)
               (@snd (sum unit unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Word n)) (@decrement_word_spec Alg.CoreFunSem n x))) BinNums.Z0)
         (BinInt.Z.eqb (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (BinNums.Zpos BinNums.xH))
is_one_word_spec_numeric
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq bool (Bit.toBool (@is_one_word_spec n Alg.CoreFunSem x))
         (BinInt.Z.eqb (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (BinNums.Zpos BinNums.xH))
test_value_spec_numeric
     : forall (n : nat) (one : bool) (x : Ty.tySem (Word.Word n)),
       @eq bool (Bit.toBool (@test_value_spec n one Alg.CoreFunSem x))
         (test_value_numeric one (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
test_value8_denotes
     : forall (one : bool) (payload : Integers.Int64.int),
       @eq bool (test_value8_bit one (jet_read8.read8_result payload))
         (Bit.toBool (@test_value_spec (S (S (S O))) one Alg.CoreFunSem (decode_word8 payload)))
wide_test_value_denotes
     : forall (s : wide_size) (one : bool) (x : Ty.tySem (Word.Word (wide_log s))) (r : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x)),
       @eq bool (wide_test_value_bit s one r) (Bit.toBool (@test_value_spec (wide_log s) one Alg.CoreFunSem x))
eval_test_value8_layout_matches_spec
     : forall (env : Values.val) (one : bool) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (x : Ty.tySem (Word.Word (S (S (S O))))) (cursor rc : BinNums.Z) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc) (_ : byte_slice_at m bi edge rc x)
         (_ : write_frame_at m bd dbase bw outedge cursor (BinNums.Zpos BinNums.xH)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (test_value8 one))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Ty.Sum Ty.Unit Ty.Unit) (@test_value_spec (S (S (S O))) one Alg.CoreFunSem x)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
