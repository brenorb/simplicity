xp_le =
fun (r : nat) (x : sx) =>
match x return bool with
| XI _ => true
| XIc _ => true
| XL _ => true
| XLc _ => true
| XLv _ => true
| XV _ => true
| XA _ _ => true
| XP r' _ => PeanoNat.Nat.leb r' r
| XIb _ _ _ => true
| XLb _ _ _ => true
| XIsh _ _ _ => true
| XLsh _ _ _ => true
| XIcmp _ _ _ _ => true
| XLcmp _ _ _ _ => true
| XI2L _ _ => true
| XL2I _ => true
| XIcast _ _ _ => true
| XInz _ => true
| XLnz _ => true
| XIz _ => true
| XLz _ => true
| XIneg _ => true
| XLneg _ => true
| XInot _ => true
| XLnot _ => true
end
     : forall (_ : nat) (_ : sx), bool

