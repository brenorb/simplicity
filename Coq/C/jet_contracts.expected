minmax_select =
fun (A : Type) (maximum less : bool) (x y : A) =>
match less return A with
| true => match maximum return A with
          | true => y
          | false => x
          end
| false => match maximum return A with
           | true => x
           | false => y
           end
end
     : forall (A : Type) (_ : bool) (_ : bool) (_ : A) (_ : A), A

