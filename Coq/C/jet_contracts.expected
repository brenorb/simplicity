let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Ty.Prod C sha256_ctx8_type) (Ty.Sum sha256_ctx8_type sha256_ctx8_type)
  sha256_ctx8_type core
  (@for_while_program w C sha256_ctx8_type sha256_ctx8_type core (@hash_loop_body k term C (Word.Word w) array))
  (@jet_sha256_ctx8_init_spec.AC.copair sha256_ctx8_type sha256_ctx8_type sha256_ctx8_type core
     (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core)
     (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type core))
