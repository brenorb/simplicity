division_wide_raw_unsigned
     : forall (remainder : bool) (r t : Integers.Int64.int),
       @eq BinNums.Z (Integers.Int64.unsigned (division_wide_raw remainder r t))
         (division_numeric remainder (Integers.Int64.unsigned r) (Integers.Int64.unsigned t))
division8_not_mone
     : forall t : Integers.Int.int,
       @eq bool
         (Integers.Int.eq (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)
            Integers.Int.mone) false
eval_division8_zero_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (t : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _y le)
                (@Some Values.val
                   (Values.Vint
                      (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)))),
       Clight.eval_expr ge0 e le m division8_zero_expr
         (Values.Vint
            (bit_int
               (Integers.Int.eq Integers.Int.zero
