ctx8_finalize_closed
     : forall (buf : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
         (count : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       let l0 : list (Ty.tySem (Word.Word (S (S (S O))))) :=
         buffer_list (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) buf in
       let c : Integers.Int64.int :=
         Integers.Int64.repr
           (BinInt.Z.add
              (BinInt.Z.mul
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count))
              (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) l0))) in
       and
         (forall _ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count) ctx8_limit,
          @ex (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (fun hf : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
             and
               (@eq
                  (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                  (@ctx8_finalize_spec (Alg.AssertionSem Option.option_Monad_Zero)
                     (@pair (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                        (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) buf
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) count h)))
                  (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) hf))
               (@eq (list Integers.Int.int) (state_regs hf)
                  (@snd (list Integers.Int.int) (list Integers.Int.int)
                     (absorb_i (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value l0)
                        (state_regs h) (sha_pad c))))))
         (forall _ : BinInt.Z.le ctx8_limit (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) count),
          @eq
            (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (@ctx8_finalize_spec (Alg.AssertionSem Option.option_Monad_Zero)
               (@pair (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                  (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) buf
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                     (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) count h)))
            (@None (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
sha_finalize_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv sha_ge) jets_sha._sha256_finalize)
         (@Some Values.block (sha_symbol_block jets_sha._sha256_finalize))
sha_finalize_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv sha_ge)
            (Values.Vptr (sha_symbol_block jets_sha._sha256_finalize) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_sha.f_sha256_finalize))
finalize_body
     : @eq Clight.statement (Clight.fn_body jets_sha.f_sha256_finalize)
         (Clight.Ssequence fin_result
            (Clight.Ssequence fin_length
               (Clight.Ssequence fin_pad
                  (Clight.Ssequence fin_len_call
                     (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar jets_sha._result Ctypesdefs.tbool)))))))
fin_blocks
     : forall bk : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) (Clight.blocks_of_env sha_ge (fin_env bk))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bk BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
fin_entry
     : forall (m : Memory.Mem.mem) (m1 : Memory.Mem.mem') (bk bx : Values.block) (cbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m1 bk)),
       Clight.function_entry2 sha_ge jets_sha.f_sha256_finalize
         (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr cbase)) (@nil Values.val)) m
         (fin_env bk) (fin_temps bx cbase) m1
pad_source_nth
     : forall (k : nat)
         (_ : lt k (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq Integers.Int.int (@List.nth Integers.Int.int k pad_source Integers.Int.zero)
         (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
            (Integers.Int.repr
               match k return BinNums.Z with
               | O =>
                   BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               | S _ => BinNums.Z0
               end))
cf_fill_exec
     : forall (bk : Values.block) (e : Clight.env)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha.___compound e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bk
                      (Ctypesdefs.tarray Ctypesdefs.tuchar
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (k : nat) (_ : lt k (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (le0 : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : Memory.Mem.range_perm m bk BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and (ClightBigstep.Clight2.exec_stmt sha_ge e le0 m (cf_fill k) Events.E0 le0 m' ClightBigstep.Out_normal)
            (and
               (forall (j : nat) (_ : le j k),
                @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m' bk (BinInt.Z.of_nat j))
                  (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j pad_source Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : not (@eq Values.block b bk)),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (kd : Memtype.perm_kind)
                        (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kd p), Memory.Mem.perm m' b ofs kd p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
pad_count_unsigned
     : forall c : Integers.Int64.int,
       @eq BinNums.Z (Integers.Int64.unsigned (pad_count c))
         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
            (BinInt.Z.modulo
               (BinInt.Z.sub
                  (BinNums.Zpos
                     (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                  (BinInt.Z.modulo (Integers.Int64.unsigned c)
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
pad_bytes_length
     : forall c : Integers.Int64.int,
       @eq BinNums.Z (BinInt.Z.of_nat (@length Integers.Int.int (pad_bytes c))) (Integers.Int64.unsigned (pad_count c))
@nth_firstn_lt ?A
     : forall (n i : nat) (l : list ?A) (d : ?A) (_ : lt i n),
       @eq ?A (@List.nth ?A i (@List.firstn ?A n l) d) (@List.nth ?A i l d)
where
?A : [ |- Type]
add_mod64
     : forall a b : Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.modulo (Integers.Int64.unsigned (Integers.Int64.add a b))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.modulo (Integers.Int64.unsigned a)
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
               (Integers.Int64.unsigned b))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
eval_sha256_finalize
     : forall (_ : memcpy_model) (m : Memory.Mem.mem) (bx : Values.block) (cbase : BinNums.Z)
         (bo : Values.block) (obase : BinNums.Z) (l regs : list Integers.Int.int) (c : Integers.Int64.int)
         (ovf : bool) (_ : BinInt.Z.le BinNums.Z0 cbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 obase)
         (_ : BinInt.Z.le
                (BinInt.Z.add obase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bo bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bo))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bo))
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bx cbase)
                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr obase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bx
                   (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong c)))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo (Integers.Int64.unsigned c)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (BinInt.Z.of_nat (@length Integers.Int.int l)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bx
                   (BinInt.Z.add cbase
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                (@Some Values.val (Values.Vint (bit_int ovf))))
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int l)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bx
                   (BinInt.Z.add
                      (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i l Integers.Int.zero))))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
              and
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint32 m bo
                      (BinInt.Z.add obase
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                   (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
                (Memory.Mem.valid_access m AST.Mint32 bo
                   (BinInt.Z.add obase
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                   Memtype.Writable)) (_ : sha_dispatch_ok m)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m (sha_symbol_block jets_sha._sha256_max_counter) BinNums.Z0)
                (@Some Values.val (Values.Vlong sha_max_counter)))
         (_ : Memory.Mem.range_perm m bx
                (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Writable)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) cbase),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_sha256_finalize)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr cbase)) (@nil Values.val)) Events.E0 m'
               (Values.Vint (bit_int (negb ovf))))
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 m' bo
                     (BinInt.Z.add obase
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                  (@Some Values.val
                     (Values.Vint
                        (@List.nth Integers.Int.int i
                           (@snd (list Integers.Int.int) (list Integers.Int.int) (absorb_i l regs (sha_pad c)))
                           Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : or (not (@eq Values.block b bx))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                                  (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add cbase
                                     (BinNums.Zpos
                                        (BinNums.xI
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                  ofs)))
                     (_ : or (not (@eq Values.block b bo))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) obase)
                               (BinInt.Z.le
                                  (BinInt.Z.add obase
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
buffer_pad_spec_parametric
     : forall d : nat,
       @Alg.Core.Parametric (buffer_type (Word.Word (S (S (S O)))) d) (Word.Vector (Word.Word (S (S (S O)))) (S d))
         (@buffer_pad_spec d)
vector_values_fill_zero
     : forall (n : nat) (u : unit),
       @eq (list (Ty.tySem (Word.Word (S (S (S O))))))
         (vector_values (Word.Word (S (S (S O)))) n
            (@Word.fill Ty.Unit (Word.Word (S (S (S O)))) n Alg.CoreFunSem (@Word.zero (S (S (S O))) Alg.CoreFunSem) u))
         (@List.repeat (Ty.tySem (Word.Word (S (S (S O))))) zero8 (PeanoNat.Nat.pow (S (S O)) n))
buffer_pad_value
