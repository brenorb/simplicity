eval_sha256_ctx8_init_layout_matches_spec
     : forall (env : Values.val) (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (source bw : Values.block) (edge outedge cursor rc : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase source edge rc)
         (_ : write_frame_at m bf base bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m
               (@Ctypes.Internal Clight.function f_simplicity_sha_256_ctx_8_init)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode sha256_ctx8_type (@sha256_ctx8_init_spec Alg.CoreFunSem tt)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bf base bw outedge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI
                                                                (BinNums.xI
                                                                   (BinNums.xI (BinNums.xO (BinNums.xO (...)))))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
sha256_ctx8_init_local_spec
     : jet_local_spec f_simplicity_sha_256_ctx_8_init Ty.Unit sha256_ctx8_type
         (fun a : Ty.tySem Ty.Unit => @sha256_ctx8_init_spec Alg.CoreFunSem a)
sha256_ctx8_init_context
     : @jet_context_for f_simplicity_sha_256_ctx_8_init Ty.Unit sha256_ctx8_type (@sha256_ctx8_init_spec)
frame_input_word_at_bit8
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word (S (S (S O))))) (i : nat) (_ : @frame_input_word_at (S (S (S O))) m bw edge cursor x)
         (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
       frame_input_bit_at m bw edge (BinInt.Z.add cursor (BinInt.Z.of_nat i))
         (BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x)
            (BinInt.Z.sub (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))) (BinInt.Z.of_nat i)))
read8_input_loads
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word (S (S (S O)))))
         (_ : and (BinInt.Z.le BinNums.Z0 cursor)
                (BinInt.Z.le cursor
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : @frame_input_word_at (S (S (S O))) m bw edge cursor x),
       and
         (and
            (BinInt.Z.le
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                  (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                     (BinInt.Z.div cursor
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned))
         (@ex Integers.Int64.int
            (fun high : Integers.Int64.int =>
             @ex Integers.Int64.int
               (fun low : Integers.Int64.int =>
                and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 m bw
                        (BinInt.Z.sub edge
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.add (BinNums.Zpos BinNums.xH)
