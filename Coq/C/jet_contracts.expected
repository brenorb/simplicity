exec_gej_read_flag_store
     : forall (le : Maps.PTree.tree Values.val) (m mi : Memory.Mem.mem) (b : Values.block)
         (base : BinNums.Z) (flag : Integers.Int.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO
