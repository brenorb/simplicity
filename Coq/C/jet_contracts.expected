         (edge outedge cursor read_cursor : BinNums.Z) (a : Ty.tySem (Word.Word (wide_log s)))
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize (Word.Word (wide_log s)))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor (@encode (Word.Word (wide_log s)) a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize (Ty.Sum Ty.Unit Ty.Unit)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (wide_test_value s one))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Ty.Sum Ty.Unit Ty.Unit) (@test_value_spec (wide_log s) one Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Ty.Sum Ty.Unit Ty.Unit)))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Ty.Sum Ty.Unit Ty.Unit))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
wide_test_value_context_guarantees
     : forall (s : wide_size) (one : bool) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout)
         (ctx : Context) (a : Ty.tySem (Word.Word (wide_log s))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (wide_log s)) a) (newWriteFrame (bitSize (Ty.Sum Ty.Unit Ty.Unit))))
         in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (wide_log s)) a)
              (fullWriteFrame (@encode (Ty.Sum Ty.Unit Ty.Unit) (@test_value_spec (wide_log s) one Alg.CoreFunSem a))))
         in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (wide_test_value s one))
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@test_value_spec (wide_log s) one Naive.translate) (Running s0) (Running s1))))
minmax_word_spec_parametric
     : forall (n : nat) (maximum : bool),
       @Alg.Core.Parametric (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n) (@minmax_word_spec n maximum)
minmax_word_spec_le
     : forall (n : nat) (maximum : bool) (x y : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (Word.Word n))
         (@minmax_word_spec n maximum Alg.CoreFunSem (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y))
         (@minmax_select (Ty.tySem (Word.Word n)) maximum
            (Bit.toBool (@le_word_spec Alg.CoreFunSem n (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)))
            x y)
minmax_word_spec_strict
     : forall (n : nat) (maximum : bool) (x y : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (Word.Word n))
