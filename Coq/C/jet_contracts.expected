        (Alg.Assertion.toCore term)
        (@jet_sha256_ctx8_init_spec.AC.drop (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
           (Word.Vector (Word.Word (S (S (S O)))) (S (S O))) (Word.Vector (Word.Word (S (S (S O)))) (S (S O)))
           (Alg.Assertion.toCore term)
           (@jet_sha256_ctx8_init_spec.AC.iden (Word.Vector (Word.Word (S (S (S O)))) (S (S O)))
              (Alg.Assertion.toCore term))))) (@ctx8_addn_spec (S (S O)) term)
     : forall term : Alg.Assertion.Algebra,
       Alg.Assertion.domain term
