         (_ : @eq (option (Ty.tySem sha256_ctx8_type))
                (ctx8_add_list c (@app (Ty.tySem (Word.Word (S (S (S O))))) bs1 bs2))
                (@Some (Ty.tySem sha256_ctx8_type) cf)),
       @ex (Ty.tySem sha256_ctx8_type)
         (fun c1 : Ty.tySem sha256_ctx8_type =>
          and (@eq (option (Ty.tySem sha256_ctx8_type)) (ctx8_add_list c bs1) (@Some (Ty.tySem sha256_ctx8_type) c1))
            (@eq (option (Ty.tySem sha256_ctx8_type)) (ctx8_add_list c1 bs2) (@Some (Ty.tySem sha256_ctx8_type) cf)))
pair_hash_spec_sem
     : forall
