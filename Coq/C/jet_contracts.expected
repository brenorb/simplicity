cur_k =
fun x : sx =>
match x return (option Integers.Int64.int) with
| XI _ => @None Integers.Int64.int
| XIc _ => @None Integers.Int64.int
| XL _ => @None Integers.Int64.int
| XLc _ => @None Integers.Int64.int
| XLv _ => @None Integers.Int64.int
| XV _ => @None Integers.Int64.int
| XA _ _ => @None Integers.Int64.int
| XP _ _ => @None Integers.Int64.int
| XIb _ _ _ => @None Integers.Int64.int
| XLb o a b =>
    match o return (option Integers.Int64.int) with
    | Badd =>
        match a return (option Integers.Int64.int) with
        | XI _ => @None Integers.Int64.int
        | XIc _ => @None Integers.Int64.int
        | XL _ => @None Integers.Int64.int
        | XLc _ => @None Integers.Int64.int
        | XLv n =>
            match n return (option Integers.Int64.int) with
            | O =>
                match b return (option Integers.Int64.int) with
                | XI _ => @None Integers.Int64.int
                | XIc _ => @None Integers.Int64.int
                | XL _ => @None Integers.Int64.int
                | XLc kc => @Some Integers.Int64.int kc
                | XLv _ => @None Integers.Int64.int
                | XV _ => @None Integers.Int64.int
                | XA _ _ => @None Integers.Int64.int
                | XP _ _ => @None Integers.Int64.int
                | XIb _ _ _ => @None Integers.Int64.int
                | XLb _ _ _ => @None Integers.Int64.int
                | XIsh _ _ _ => @None Integers.Int64.int
                | XLsh _ _ _ => @None Integers.Int64.int
                | XIcmp _ _ _ _ => @None Integers.Int64.int
                | XLcmp _ _ _ _ => @None Integers.Int64.int
                | XI2L _ _ => @None Integers.Int64.int
                | XL2I _ => @None Integers.Int64.int
                | XIcast _ _ _ => @None Integers.Int64.int
                | XInz _ => @None Integers.Int64.int
                | XLnz _ => @None Integers.Int64.int
                | XIz _ => @None Integers.Int64.int
                | XLz _ => @None Integers.Int64.int
                | XIneg _ => @None Integers.Int64.int
                | XLneg _ => @None Integers.Int64.int
                | XInot _ => @None Integers.Int64.int
                | XLnot _ => @None Integers.Int64.int
                end
            | S _ => @None Integers.Int64.int
            end
        | XV _ => @None Integers.Int64.int
        | XA _ _ => @None Integers.Int64.int
        | XP _ _ => @None Integers.Int64.int
        | XIb _ _ _ => @None Integers.Int64.int
        | XLb _ _ _ => @None Integers.Int64.int
        | XIsh _ _ _ => @None Integers.Int64.int
        | XLsh _ _ _ => @None Integers.Int64.int
        | XIcmp _ _ _ _ => @None Integers.Int64.int
        | XLcmp _ _ _ _ => @None Integers.Int64.int
        | XI2L _ _ => @None Integers.Int64.int
        | XL2I _ => @None Integers.Int64.int
        | XIcast _ _ _ => @None Integers.Int64.int
        | XInz _ => @None Integers.Int64.int
        | XLnz _ => @None Integers.Int64.int
        | XIz _ => @None Integers.Int64.int
        | XLz _ => @None Integers.Int64.int
        | XIneg _ => @None Integers.Int64.int
        | XLneg _ => @None Integers.Int64.int
        | XInot _ => @None Integers.Int64.int
        | XLnot _ => @None Integers.Int64.int
        end
    | Bsub => @None Integers.Int64.int
    | Bmul => @None Integers.Int64.int
    | Band => @None Integers.Int64.int
    | Bor => @None Integers.Int64.int
    | Bxor => @None Integers.Int64.int
