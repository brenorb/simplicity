         (src_ofs : Integers.Ptrofs.int) (ss ds n : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (and (BinInt.Z.lt ss ds)
                   (BinInt.Z.le ds
                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.lt ss n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src_ptr le)
                (@Some Values.val (Values.Vptr bi src_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr n)))),
       ClightBigstep.Clight2.exec_stmt ge0 Clight.empty_env le m copy_left_after_return Events.E0
         (copy_cross_env le bi src_ofs ss ds n) m ClightBigstep.Out_normal
copy_left_low_clear
     : forall (ss ds : BinNums.Z) (old source : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
