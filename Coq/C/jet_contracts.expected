encode_word
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq (list Cell) (@encode (Word.Word n) x)
         (@List.map bool (option bool) (@Some bool) (@frame_input_word_bits n x))
@frame_input_word_at_encode ?n
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x : Ty.tySem (Word.Word ?n)),
       iff (@frame_input_word_at ?n m bw edge cursor x)
         (frame_input_cells_at m bw edge cursor (@encode (Word.Word ?n) x))
where
?n : [ |- nat]
@frame_input_word_pair_encode ?n
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x y : Ty.tySem (Word.Word ?n)),
       iff
         (and (@frame_input_word_at ?n m bw edge cursor x)
            (@frame_input_word_at ?n m bw edge (BinInt.Z.add cursor (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) ?n)))
               y))
         (frame_input_cells_at m bw edge cursor
            (@encode (Ty.Prod (Word.Word ?n) (Word.Word ?n))
               (@pair (Ty.tySem (Word.Word ?n)) (Ty.tySem (Word.Word ?n)) x y)))
where
?n : [ |- nat]
byte_slice_at_encode
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word (S (S (S O))))),
       iff (byte_slice_at m bw edge cursor x)
         (and
            (and (BinInt.Z.le BinNums.Z0 cursor)
               (BinInt.Z.le cursor
                  (BinInt.Z.sub Integers.Int64.max_unsigned
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (frame_input_cells_at m bw edge cursor (@encode (Word.Word (S (S (S O)))) x)))
byte_input_single_encode
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (x : Ty.tySem (Word.Word (S (S (S O))))),
       iff
         (byte_input_at m bf base bw edge cursor
            (@cons (Ty.tySem (Word.Word (S (S (S O))))) x (@nil (Ty.tySem (Word.Word (S (S (S O))))))))
         (and (frame_base_valid base)
            (and (frame_fields_at m bf base bw edge cursor)
               (and
                  (and (BinInt.Z.le BinNums.Z0 cursor)
                     (BinInt.Z.le cursor
                        (BinInt.Z.sub Integers.Int64.max_unsigned
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (frame_input_cells_at m bw edge cursor (@encode (Word.Word (S (S (S O)))) x)))))
byte_input_pair_encode
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (x y : Ty.tySem (Word.Word (S (S (S O))))),
       iff
         (byte_input_at m bf base bw edge cursor
            (@cons (Ty.tySem (Word.Word (S (S (S O))))) x
               (@cons (Ty.tySem (Word.Word (S (S (S O))))) y (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
         (and (frame_base_valid base)
            (and (frame_fields_at m bf base bw edge cursor)
               (and
                  (and (BinInt.Z.le BinNums.Z0 cursor)
                     (BinInt.Z.le cursor
                        (BinInt.Z.sub Integers.Int64.max_unsigned
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (frame_input_cells_at m bw edge cursor
                     (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
                        (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O))))) x y))))))
slice_word_output_encode
     : forall (lg : nat) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word lg))
         (_ : BinInt.Z.le (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) lg))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : BinInt.Z.le (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) lg)) cursor),
       iff
         (@ex Integers.Int64.int
            (fun p : Integers.Int64.int =>
             and (slice_output_at (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) lg)) m bw edge cursor p)
               (@eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ lg)))
                  (@Word.ToZ.Theory.fromZ (Word.WordToZ lg) (Integers.Int64.unsigned p)) x)))
         (frame_output_cells_at m bw edge cursor (@encode (Word.Word lg) x))
wide_output_at_encode
     : forall (s : wide_size) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word (wide_log s))) (_ : BinInt.Z.le (wide_bits s) cursor),
       iff (wide_output_at s m bw edge cursor x)
         (frame_output_cells_at m bw edge cursor (@encode (Word.Word (wide_log s)) x))
byte_output_at_encode
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (x : Ty.tySem (Word.Word (S (S (S O)))))
         (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) cursor),
       iff (byte_output_at m bw edge cursor x)
         (frame_output_cells_at m bw edge cursor (@encode (Word.Word (S (S (S O)))) x))
carry_wide_output_encode
     : forall (s : wide_size) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (v : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s))))
         (_ : BinInt.Z.le (BinInt.Z.add (BinNums.Zpos BinNums.xH) (wide_bits s)) cursor),
       iff (carry_wide_output_at s m bw edge cursor v)
         (frame_output_cells_at m bw edge cursor
            (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s))) v))
carry_byte_output_encode
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (v : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))))
         (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))) cursor),
       iff (carry_byte_output_at m bw edge cursor v)
         (frame_output_cells_at m bw edge cursor
            (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))) v))
bm_rep_after_write
     : forall (m mf : Memory.Mem.mem) (L : bm_layout) (s : RunState) (wd : list Cell) (e : nat)
         (out : list Cell)
         (_ : @eq WriteFrame (activeWriteFrame s) (Build_WriteFrame wd (Nat.add (@length Cell out) e)))
         (_ : le (S O) (@length Cell out)) (_ : bm_rep m L s) (_ : bm_separated L s)
         (_ : frame_output_cells_at mf (cells_blk L) (edge_ofs (active_write_loc L))
                (BinInt.Z.of_nat (Nat.add (@length Cell out) e)) out)
         (_ : write_prefix_at m mf (cells_blk L) (edge_ofs (active_write_loc L))
                (BinInt.Z.of_nat (Nat.add (@length Cell out) e)))
         (_ : frame_fields_at mf (frames_blk L) (item_ofs (active_write_loc L)) (cells_blk L)
                (edge_ofs (active_write_loc L)) (BinInt.Z.of_nat e))
         (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                (_ : or (not (@eq Values.block b (frames_blk L)))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add (item_ofs (active_write_loc L))
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                          (BinInt.Z.le
                             (BinInt.Z.add (item_ofs (active_write_loc L))
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                (_ : or (not (@eq Values.block b (cells_blk L)))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add (edge_ofs (active_write_loc L))
                                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                   (BinInt.Z.div (BinInt.Z.of_nat e)
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                          (BinInt.Z.le
                             (BinInt.Z.add
                                (jet_write_layout.write_word_address (edge_ofs (active_write_loc L))
                                   (BinInt.Z.of_nat (Nat.add (@length Cell out) e)))
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs)),
       bm_rep mf L
         (Build_RunState (inactiveReadFrames s) (activeReadFrame s)
            (Build_WriteFrame (@app Cell (@List.rev Cell out) wd) e) (inactiveWriteFrames s))
@jet_context ?A ?B
     : forall (f : Clight.function) (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg ?A ?B)
         (_ : @Alg.Core.Parametric ?A ?B t) (_ : jet_local_spec f ?A ?B (fun a : Ty.tySem ?A => t Alg.CoreFunSem a))
         (_ : le (S O) (bitSize ?B)) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout)
         (ctx : Context) (a : Ty.tySem ?A),
       let s0 : RunState := fillContext ctx (Build_LocalState (@encode ?A a) (newWriteFrame (bitSize ?B))) in
       let s1 : RunState :=
         fillContext ctx (Build_LocalState (@encode ?A a) (fullWriteFrame (@encode ?B (t Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f)
               (jet_args env L) Events.E0 mf (Values.Vint Integers.Int.one))
            (and (bm_rep mf L s1) (runProgram (t Naive.translate) (Running s0) (Running s1))))
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
gap_buffer_separated
     : forall (L : bm_layout) (s : RunState)
         (_ : @eq nat (@length frame_loc (inactive_read_locs L)) (@length ReadFrame (inactiveReadFrames s)))
         (_ : @eq nat (@length frame_loc (inactive_write_locs L)) (@length WriteFrame (inactiveWriteFrames s)))
         (_ : gap_buffer_layout L s), bm_separated L s
one8_local_spec
