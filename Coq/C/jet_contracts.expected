               (Clight.Ebinop Cop.Oadd (Clight.Etempvar t4 (Ctypesdefs.tptr (Ctypes.Tstruct sid Ctypes.noattr)))
                  (Clight.Etempvar jets_sha._i Ctypesdefs.tulong) (Ctypesdefs.tptr (Ctypes.Tstruct sid Ctypes.noattr)))
               (Ctypes.Tstruct sid Ctypes.noattr)) field Ctypesdefs.tulong) (Values.Vlong v)
eval_shx_elem_nested_field_at
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (t4 ip : BinNums.positive)
         (sid : AST.ident) (sz : BinNums.Z) (f1 : AST.ident) (d1 : BinNums.Z) (sid1 f2 : AST.ident)
         (d2 : BinNums.Z) (b : Values.block) (inbase : BinNums.Z) (r v : Integers.Int64.int)
