  (bi : Values.block) (rc : BinNums.Z) (outs0 : list Cell) (cap : BinNums.Z) =>
invA m0 bd dbase bw outedge cursor N bi rc false outs0 cap
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
