     : forall high : bool,
       @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge0) (u128_get_id high))
         (@Some Values.block (jet_symbol_block (u128_get_id high)))
