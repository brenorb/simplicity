     : Ty.tySem (Word.Word (S (S (S O))))
decode_word8 =
fun w : Integers.Int64.int => @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S O)))) (Integers.Int64.unsigned w)
     : forall _ : Integers.Int64.int, Ty.tySem (Word.Word (S (S (S O))))

Arguments decode_word8 w
one8_output_spec =
fun (m : Memory.Mem.mem) (bw : Values.block) =>
@ex Integers.Int64.int
  (fun w : Integers.Int64.int =>
   and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw BinNums.Z0) (@Some Values.val (Values.Vlong w)))
     (@eq (Ty.tySem (Word.Word (S (S (S O))))) (decode_word8 w) one8_spec_value))
     : forall (_ : Memory.Mem.mem) (_ : Values.block), Prop

Arguments one8_output_spec m bw
full_increment_word_spec =
fun (term : Alg.Core.Algebra) (n : nat) =>
@Alg.Core.Combinators.comp (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word n) (Word.Word n)))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) term
  (@Alg.Core.Combinators.pair (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit)
     (Ty.Prod (Word.Word n) (Word.Word n)) term
     (@Alg.Core.Combinators.take (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term
        (@Alg.Core.Combinators.iden (Ty.Sum Ty.Unit Ty.Unit) term))
     (@Alg.Core.Combinators.pair (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) (Word.Word n)
        (Word.Word n) term
        (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) (Word.Word n) term
           (@Alg.Core.Combinators.iden (Word.Word n) term))
        (@Alg.Core.Combinators.comp (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) Ty.Unit
           (Word.Word n) term (@Alg.Core.Combinators.unit (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) term)
           (@Word.zero n term)))) (@Word.fullAdder n term)
     : forall (term : Alg.Core.Algebra) (n : nat),
       Alg.Core.domain term (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))

Arguments full_increment_word_spec {term} n%nat_scope
increment_word_spec =
fun (term : Alg.Core.Algebra) (n : nat) =>
@Alg.Core.Combinators.comp (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)) term
  (@Alg.Core.Combinators.pair (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) term (@Bit.true (Word.Word n) term)
     (@Alg.Core.Combinators.iden (Word.Word n) term)) (@full_increment_word_spec term n)
     : forall (term : Alg.Core.Algebra) (n : nat),
       Alg.Core.domain term (Word.Word n) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))

