@firstn_snoc ?A
     : forall (l : list ?A) (n : nat) (x : ?A) (_ : @eq (option ?A) (@List.nth_error ?A l n) (@Some ?A x)),
       @eq (list ?A) (@List.firstn ?A (S n) l) (@app ?A (@List.firstn ?A n l) (@cons ?A x (@nil ?A)))
where
?A : [ |- Type]
loop_bytes_app
     : forall (k : nat) (l1 l2 : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))),
       @eq (list (Ty.tySem (Word.Word (S (S (S O))))))
         (loop_bytes k (@app (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) l1 l2))
         (@app (Ty.tySem (Word.Word (S (S (S O))))) (loop_bytes k l1) (loop_bytes k l2))
loop_prefix_some
     : forall (k w : nat) (ctx0 : Ty.tySem sha256_ctx8_type)
         (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))) (cf : Ty.tySem sha256_ctx8_type)
         (_ : @eq (option (Ty.tySem sha256_ctx8_type))
                (ctx8_add_list ctx0
                   (loop_bytes k
                      (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (BinInt.Z.to_nat (wsize w)) xs)))
                (@Some (Ty.tySem sha256_ctx8_type) cf)) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i
                   (BinInt.Z.of_nat
                      (@length (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                         (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
                            (BinInt.Z.to_nat (wsize w)) xs))))),
