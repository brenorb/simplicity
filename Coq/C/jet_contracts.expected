          end) (Clight.find_label lbl s2 (cont_app (Clight.Kloop1 s2 s3 k0) k))
         (find_label_app lbl s2 (Clight.Kloop1 s2 s3 k0) k)
       :
       @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl (Clight.Sloop s2 s3) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
