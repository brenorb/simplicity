memcpy_builtin_witness
     : forall (ge : Globalenvs.Senv.t) (m : Memory.Mem.mem) (bd : Values.block) (od : Integers.Ptrofs.int)
         (bs : Values.block) (os : Integers.Ptrofs.int) (n : BinNums.Z) (bytes : list Memdata.memval)
         (_ : @eq (option (list Memdata.memval)) (Memory.Mem.loadbytes m bs (Integers.Ptrofs.unsigned os) n)
                (@Some (list Memdata.memval) bytes))
         (_ : Memory.Mem.range_perm m bd (Integers.Ptrofs.unsigned od) (BinInt.Z.add (Integers.Ptrofs.unsigned od) n)
                Memtype.Cur Memtype.Writable)
         (_ : or (not (@eq Values.block bs bd))
                (or (BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned os) n) (Integers.Ptrofs.unsigned od))
                   (BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned od) n) (Integers.Ptrofs.unsigned os))))
         (_ : BinInt.Z.le BinNums.Z0 n),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bd (Integers.Ptrofs.unsigned od) bytes)
               (@Some Memory.Mem.mem m'))
            (Events.extcall_memcpy_sem n (BinNums.Zpos BinNums.xH) ge
               (@cons Values.val (Values.Vptr bd od) (@cons Values.val (Values.Vptr bs os) (@nil Values.val))) m
               Events.E0 Values.Vundef m'))
@bitcoin_ext_tag_def_canonical ?A ?B
     : forall p : BitcoinExt.t ?A ?B,
       @eq Digest.hash256 (@BitcoinExt.tag_def ?A ?B p)
         (MerkleRoot.tag
            (@app String.string
               (Primitive.primitivePrefix
                  (String.String (Ascii.Ascii false true false false false false true false)
                     (String.String (Ascii.Ascii true false false true false true true false)
                        (String.String (Ascii.Ascii false false true false true true true false)
                           (String.String (Ascii.Ascii true true false false false true true false)
                              (String.String (Ascii.Ascii true true true true false true true false)
                                 (String.String (Ascii.Ascii true false false true false true true false)
                                    (String.String (Ascii.Ascii false true true true false true true false)
                                       String.EmptyString))))))))
               (@cons String.string (@BitcoinExt.name ?A ?B p) (@nil String.string))))
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
bitcoin_ext_current_index_tag
     : @eq Digest.hash256 (@BitcoinExt.tag Ty.Unit (Word.Word (S (S (S (S (S O)))))) BitcoinExt.CurrentIndex)
         (@Bitcoin.Bitcoin.tag Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.CurrentIndex)
bitcoin_ext_current_index_sem
     : forall (e : ext_environment) (a : Ty.tySem Ty.Unit),
       @eq (option (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (@BitcoinExt.sem Ty.Unit (Word.Word (S (S (S (S (S O)))))) BitcoinExt.CurrentIndex a e)
         (@Bitcoin.Bitcoin.sem Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.CurrentIndex a (extBase e))
