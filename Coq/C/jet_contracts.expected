               (Integers.Ptrofs.mul (Integers.Ptrofs.repr (BinNums.Zpos BinNums.xH)) (Integers.Ptrofs.of_int64 v))))
         (BinInt.Z.add (Integers.Ptrofs.unsigned o) (Integers.Int64.unsigned v))
