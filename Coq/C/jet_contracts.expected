bitcoin_fee_env_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (environment : Bitcoin.Bitcoin.env)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun tbase : BinNums.Z =>
            @ex Integers.Int64.int
              (fun vi : Integers.Int64.int =>
               @ex Integers.Int64.int
                 (fun vo : Integers.Int64.int =>
                  and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                    (and (BinInt.Z.le BinNums.Z0 ebase)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add ebase
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                             Integers.Ptrofs.max_unsigned)
                          (and (BinInt.Z.le BinNums.Z0 tbase)
                             (and
                                (BinInt.Z.le
                                   (BinInt.Z.add tbase
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI ...))))))))
                                   Integers.Ptrofs.max_unsigned)
                                (and
                                   (@eq (option Values.val) (Memory.Mem.load AST.Mptr m be ebase)
                                      (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
                                   (and
                                      (@eq (option Values.val)
                                         (Memory.Mem.load AST.Mint64 m bt
                                            (BinInt.Z.add tbase
                                               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))
                                         (@Some Values.val (Values.Vlong vi)))
                                      (and
                                         (@eq (option Values.val)
                                            (Memory.Mem.load AST.Mint64 m bt
                                               (BinInt.Z.add tbase (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))))
                                            (@Some Values.val (Values.Vlong vo)))
                                         (and
                                            (@eq BinNums.Z (Integers.Int64.unsigned vi)
                                               (Bitcoin.sigTxTotalInValue (Bitcoin.Bitcoin.envTx environment)))
                                            (and
                                               (@eq BinNums.Z (Integers.Int64.unsigned vo)
                                                  (Bitcoin.sigTxTotalOutValue (Bitcoin.Bitcoin.envTx environment)))
                                               (@eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) fp
                                                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                                                     (@pair (prod Values.block BinNums.Z) BinNums.Z
                                                        (@pair Values.block BinNums.Z be ebase)
                                                        (BinInt.Z.add ebase ...))
                                                     (@cons (prod ... BinNums.Z) (@pair ... BinNums.Z ... ...)
                                                        (@nil ...)))))))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : Bitcoin.Bitcoin.env)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments bitcoin_fee_env_rep m env environment fp%list_scope
fee_tail =
fun alg : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))) alg
  (@subtract_word_spec alg (S (S (S (S (S (S O)))))))
  (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))
     (Word.Word (S (S (S (S (S (S O))))))) alg (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) alg))
     : forall alg : Alg.Core.Algebra,
       Alg.Core.domain alg (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Word.Word (S (S (S (S (S (S O)))))))

Arguments fee_tail {alg}
fee_program =
fun (alg : Alg.Core.Algebra) (tin tout : Alg.Core.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) =>
@Alg.Core.Combinators.comp Ty.Unit
  (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
  (Word.Word (S (S (S (S (S (S O))))))) alg
  (@Alg.Core.Combinators.pair Ty.Unit (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))) alg
     tin tout) (@fee_tail alg)
     : forall (alg : Alg.Core.Algebra) (_ : Alg.Core.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
         (_ : Alg.Core.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))),
       Alg.Core.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))

Arguments fee_program {alg} tin tout
bitcoin_fee_spec =
fun alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra =>
@fee_program (Bitcoin.PrimitiveBitcoin.Primitive.CanonicalStructures.toCore alg) (@bitcoin_total_input_value_spec alg)
  (@bitcoin_total_output_value_spec alg)
     : forall alg : Bitcoin.PrimitiveBitcoin.Primitive.Algebra,
       Bitcoin.PrimitiveBitcoin.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))

Arguments bitcoin_fee_spec {alg}
Inductive prim : forall (_ : Ty.Ty) (_ : Ty.Ty), Set :=
    Base : forall (A B : Ty.Ty) (_ : Bitcoin.Bitcoin.prim A B), BitcoinFull.prim A B
  | Ext : forall (A B : Ty.Ty) (_ : BitcoinExt.prim A B), BitcoinFull.prim A B.

Arguments BitcoinFull.prim (_ _)%ty_scope
Arguments BitcoinFull.Base {A B}%ty_scope _
Arguments BitcoinFull.Ext {A B}%ty_scope _
BitcoinFull.t = BitcoinFull.prim
     : forall (_ : Ty.Ty) (_ : Ty.Ty), Set

Arguments BitcoinFull.t (_ _)%ty_scope
BitcoinFull.tag =
fun (A B : Ty.Ty) (p : BitcoinFull.t A B) =>
match p in (BitcoinFull.prim t t0) return Digest.hash256 with
| @BitcoinFull.Base A0 B0 q => @Bitcoin.Bitcoin.tag A0 B0 q
| @BitcoinFull.Ext A0 B0 q => @BitcoinExt.tag A0 B0 q
end
     : forall (A B : Ty.Ty) (_ : BitcoinFull.t A B), Digest.hash256

Arguments BitcoinFull.tag {A B}%ty_scope p
BitcoinFull.env = ext_environment
     : Set
BitcoinFull.sem =
fun (A B : Ty.Ty) (p : BitcoinFull.t A B) (a : Ty.tySem A) (e : BitcoinFull.env) =>
match p in (BitcoinFull.prim A0 B0) return (forall _ : Ty.tySem A0, option (Ty.tySem B0)) with
| @BitcoinFull.Base A0 B0 q => fun a0 : Ty.tySem A0 => @Bitcoin.Bitcoin.sem A0 B0 q a0 (extBase e)
| @BitcoinFull.Ext A0 B0 q => fun a0 : Ty.tySem A0 => @BitcoinExt.sem A0 B0 q a0 e
end a
     : forall (A B : Ty.Ty) (_ : BitcoinFull.t A B) (_ : Ty.tySem A) (_ : BitcoinFull.env), option (Ty.tySem B)

Arguments BitcoinFull.sem {A B}%ty_scope p a e
