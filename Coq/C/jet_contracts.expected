                (@Some (list Memdata.memval) ctxbytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mi bc BinNums.Z0 ctxbytes) (@Some Memory.Mem.mem mx))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mx
                (@Ctypes.Internal Clight.function f_simplicity_write_sha256_context)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 me
                (Values.Vint Integers.Int.one))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free_list me (Clight.blocks_of_env ge0 (ctx_init_env bl bi bc br)))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_sha_256_ctx_8_init)
         (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
prepare_sha256_ctx8_init
     : forall (m : Memory.Mem.mem) (bs : Values.block) (sbase : BinNums.Z) (source : Values.block)
         (edge rc : BinNums.Z) (_ : frame_fields_at m bs sbase source edge rc),
       @ex Memory.Mem.mem'
         (fun ma : Memory.Mem.mem' =>
          @ex Memory.Mem.mem'
            (fun mb : Memory.Mem.mem' =>
             @ex Memory.Mem.mem'
               (fun mc : Memory.Mem.mem' =>
                @ex Memory.Mem.mem'
                  (fun md : Memory.Mem.mem' =>
                   @ex Memory.Mem.mem
                     (fun ms : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun mi : Memory.Mem.mem =>
                         @ex Memory.Mem.mem
                           (fun mx : Memory.Mem.mem =>
                            @ex Values.block
                              (fun bl : Values.block =>
                               @ex Values.block
                                 (fun bi : Values.block =>
                                  @ex Values.block
