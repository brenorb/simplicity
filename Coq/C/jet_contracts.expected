         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _q le) (@Some Values.val (Values.Vptr bq qo)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _r le) (@Some Values.val (Values.Vptr br ro)))
