                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                  edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned))
            (@ex Integers.Int64.int
               (fun source : Integers.Int64.int =>
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 m bi
                     (BinInt.Z.sub edge
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                              (BinInt.Z.div rc
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                  (@Some Values.val (Values.Vlong source)))))
eval_copyBits_short_layout
     : forall (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (cells : list Cell) (_ : frame_base_valid sbase)
         (_ : frame_fields_at m bs sbase bi edge rc) (_ : write_frame_at m bd base bw outedge cursor n)
         (_ : @eq BinNums.Z n (BinInt.Z.of_nat (@length Cell cells)))
         (_ : and (BinInt.Z.lt BinNums.Z0 n)
                (BinInt.Z.le n
                   (BinInt.Z.sub
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (BinInt.Z.modulo rc
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : BinInt.Z.le n
                (BinInt.Z.modulo cursor
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : or (not (@eq Values.block bi bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add
                         (BinInt.Z.sub edge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                  (BinInt.Z.div rc
                                     (BinNums.Zpos
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (jet_write_layout.write_word_address outedge cursor))
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.sub edge
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                               (BinInt.Z.div rc
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
         (_ : frame_input_cells_at m bi edge rc cells),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_copyBits)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and (frame_output_cells_at mf bw outedge cursor cells)
               (and (write_prefix_at m mf bw outedge cursor)
                  (and (frame_fields_at mf bd base bw outedge (BinInt.Z.sub cursor n))
                     (and
                        (loads_outside_ranges m mf bd
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (jet_write_layout.write_word_address outedge cursor)
                           (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
