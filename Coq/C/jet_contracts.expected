pad8_bytes_ints
     : @eq (list Integers.Int.int)
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value pad8_bytes)
         (@cons Integers.Int.int
            (Integers.Int.repr
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
            (@List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S O)))))))))
zero8_int
