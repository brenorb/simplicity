         (_ : @eq Ctypes.mode (Ctypes.access_mode ty) Ctypes.By_reference)
         (_ : Clight.eval_expr sha_ge e le m a (Values.Vptr b ofs)),
       Clight.eval_expr sha_ge e le m (Clight.Efield a field ty)
