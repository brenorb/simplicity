                                                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (negate_mask n)))
            (BinInt.Z.le (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (negate_mask n))
               Integers.Int64.max_unsigned))
         (and (@eq nat n (S (S (S (S O)))))
            (and
               (BinInt.Z.le
                  (BinNums.Zpos
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))))))))))))
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (negate_mask n)))
               (BinInt.Z.le (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (negate_mask n))
                  Integers.Int64.max_unsigned)))
negate_value_unsigned
     : forall (rho : forall _ : nat, Integers.Int64.int) (n : nat) (_ : lt n (S (S (S (S (S O))))))
         (_ : BinInt.Z.le (Integers.Int64.unsigned (rho (S n)))
                match PeanoNat.Nat.eqb n (S (S (S (S O)))) return BinNums.Z with
                | true =>
                    BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI
                                                                (BinNums.xI
                                                                   (BinNums.xI
                                                                      (BinNums.xI
                                                                         (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))
                | false =>
                    BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI
                                                                (BinNums.xI
                                                                   (BinNums.xI
                                                                      (BinNums.xI
                                                                         (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))))
                end),
       @eq BinNums.Z (Integers.Int64.unsigned (negate_value rho n))
         (BinInt.Z.sub (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (negate_mask n))
            (Integers.Int64.unsigned (rho (S n))))
field_rho_facts
     : forall (v rc : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 v)
                (BinInt.Z.lt v
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
