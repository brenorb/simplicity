fun (n : nat) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (value : Ty.tySem (Word.Word n)) =>
frame_input_bits_at m bw edge cursor (@frame_input_word_bits n value)
     : forall (n : nat) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Ty.tySem (Word.Word n)), Prop

Arguments frame_input_word_at {n}%nat_scope m bw (edge cursor)%Z_scope value
write_frame_at =
fun (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block) (edge cursor count : BinNums.Z) =>
and (frame_base_valid base)
  (and (frame_fields_at m bf base bw edge cursor)
     (and (BinInt.Z.le BinNums.Z0 edge)
        (and (and (BinInt.Z.le BinNums.Z0 count) (BinInt.Z.le count cursor))
           (and (BinInt.Z.le cursor Integers.Int64.max_unsigned)
              (and (not (@eq Values.block bf bw))
                 (and
                    (Memory.Mem.valid_access m AST.Mint64 bf
                       (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                       Memtype.Writable)
                    (forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i count)),
                     let addr : BinNums.Z := write_cell_address edge cursor i in
                     and (BinInt.Z.le BinNums.Z0 addr)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add addr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                             Integers.Ptrofs.max_unsigned)
                          (and (Memory.Mem.valid_access m AST.Mint64 bw addr Memtype.Writable)
                             (@ex Integers.Int64.int
                                (fun w : Integers.Int64.int =>
                                 @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw addr)
                                   (@Some Values.val (Values.Vlong w)))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments write_frame_at m bf base%Z_scope bw (edge cursor count)%Z_scope
byte_output_at =
fun (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x : Ty.tySem (Word.Word (S (S (S O))))) =>
match
  ZArith_dec.Z_le_dec (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
    (jet_write_layout.write_word_shift cursor) return Prop
with
| left _ =>
    @ex Integers.Int64.int
      (fun w : Integers.Int64.int =>
       and
         (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
            (@Some Values.val (Values.Vlong w)))
         (@eq (Ty.tySem (Word.Word (S (S (S O)))))
            (decode_word8
               (Integers.Int64.shru w
                  (Integers.Int64.repr
                     (BinInt.Z.sub (jet_write_layout.write_word_shift cursor)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) x))
| right _ =>
    @ex Integers.Int64.int
      (fun high : Integers.Int64.int =>
       @ex Integers.Int64.int
         (fun low : Integers.Int64.int =>
          and
            (@eq (option Values.val)
               (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
               (@Some Values.val (Values.Vlong high)))
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 m bw
                     (BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (@Some Values.val (Values.Vlong low)))
               (@eq (Ty.tySem (Word.Word (S (S (S O)))))
                  (decode_word8 (jet_crossing_word.crossing_byte (jet_write_layout.write_word_shift cursor) high low))
                  x))))
end
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Ty.tySem (Word.Word (S (S (S O))))), Prop

Arguments byte_output_at m bw (edge cursor)%Z_scope x
write_prefix_at =
fun (m mf : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) =>
forall (old : Integers.Int64.int)
  (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
         (@Some Values.val (Values.Vlong old))),
@ex Integers.Int64.int
  (fun w : Integers.Int64.int =>
   and
     (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bw (jet_write_layout.write_word_address edge cursor))
        (@Some Values.val (Values.Vlong w)))
     (word_outside_eq BinNums.Z0 (jet_write_layout.write_word_shift cursor) w old))
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments write_prefix_at m mf bw (edge cursor)%Z_scope
loads_outside_ranges =
fun (m mf : Memory.Mem.mem) (bf : Values.block) (flo fhi : BinNums.Z) (bw : Values.block) (wlo whi : BinNums.Z) =>
forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
  (_ : or (not (@eq Values.block b bf))
         (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) flo) (BinInt.Z.le fhi ofs)))
  (_ : or (not (@eq Values.block b bw))
         (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) wlo) (BinInt.Z.le whi ofs))),
@eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs)
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments loads_outside_ranges m mf bf (flo fhi)%Z_scope bw (wlo whi)%Z_scope
byte_write_low =
fun edge cursor : BinNums.Z =>
match
  ZArith_dec.Z_le_dec (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
    (jet_write_layout.write_word_shift cursor) return BinNums.Z
with
| left _ => jet_write_layout.write_word_address edge cursor
| right _ =>
    BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments byte_write_low (edge cursor)%Z_scope
slice_output_at =
fun (n : BinNums.Z) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x : Integers.Int64.int) =>
match ZArith_dec.Z_le_dec n (jet_write_layout.write_word_shift cursor) return Prop with
| left _ =>
    @ex Integers.Int64.int
      (fun w : Integers.Int64.int =>
       and
         (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
            (@Some Values.val (Values.Vlong w)))
         (@eq Integers.Int64.int
            (Integers.Int64.zero_ext n
               (Integers.Int64.shru w (Integers.Int64.repr (BinInt.Z.sub (jet_write_layout.write_word_shift cursor) n))))
            x))
| right _ =>
    @ex Integers.Int64.int
      (fun high : Integers.Int64.int =>
       @ex Integers.Int64.int
         (fun low : Integers.Int64.int =>
          and
            (@eq (option Values.val)
               (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
               (@Some Values.val (Values.Vlong high)))
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 m bw
                     (BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (@Some Values.val (Values.Vlong low)))
               (@eq Integers.Int64.int
                  (jet_word_slice.crossing_slice n (jet_write_layout.write_word_shift cursor) high low) x))))
end
     : forall (_ : BinNums.Z) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Integers.Int64.int), Prop

Arguments slice_output_at n%Z_scope m bw (edge cursor)%Z_scope x
slice_write_low =
fun n edge cursor : BinNums.Z =>
match ZArith_dec.Z_le_dec n (jet_write_layout.write_word_shift cursor) return BinNums.Z with
| left _ => jet_write_layout.write_word_address edge cursor
| right _ =>
    BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments slice_write_low (n edge cursor)%Z_scope
carry_byte_output_at =
fun (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
  (value : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))) =>
and
  (@ex Integers.Int64.int
     (fun w : Integers.Int64.int =>
      and
        (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
           (@Some Values.val (Values.Vlong w)))
        (@eq (sum unit unit)
           match
             Integers.Int64.testbit w
               (BinInt.Z.modulo (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
             return (sum unit unit)
           with
           | true => @inr unit unit tt
           | false => @inl unit unit tt
           end
           (@fst
              (sum
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) Ty.Unit)
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) Ty.Unit))
              (prod
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))) value))))
  (byte_output_at m bw edge (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
     (@snd
        (sum
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) Ty.Unit)
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) Ty.Unit))
        (prod
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end)
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))) value))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))), Prop

Arguments carry_byte_output_at m bw (edge cursor)%Z_scope value
carry_wide_output_at =
fun (s : wide_size) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
  (value : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)))) =>
and
  (@ex Integers.Int64.int
     (fun w : Integers.Int64.int =>
      and
        (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
           (@Some Values.val (Values.Vlong w)))
        (@eq (sum unit unit)
           match
             Integers.Int64.testbit w
               (BinInt.Z.modulo (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
             return (sum unit unit)
           with
           | true => @inr unit unit tt
           | false => @inl unit unit tt
           end
           (@fst
              (sum
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) Ty.Unit)
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end) Ty.Unit))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end) (Word.Word (wide_log s))) value))))
  (wide_output_at s m bw edge (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
     (@snd
        (sum
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) Ty.Unit)
           ((fix tySem (X : Ty.Ty) : Set :=
               match X return Set with
               | Ty.Unit => unit
               | Ty.Sum A B => sum (tySem A) (tySem B)
               | Ty.Prod A B => prod (tySem A) (tySem B)
               end) Ty.Unit))
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A B => sum (tySem A) (tySem B)
            | Ty.Prod A B => prod (tySem A) (tySem B)
            end) (Word.Word (wide_log s))) value))
     : forall (s : wide_size) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)))), Prop

Arguments carry_wide_output_at s m bw (edge cursor)%Z_scope value
msb_bits =
fun (N : nat) (z : BinNums.Z) =>
@List.map nat bool (fun i : nat => BinInt.Z.testbit z (BinInt.Z.of_nat (Nat.sub N (S i)))) (List.seq O N)
     : forall (_ : nat) (_ : BinNums.Z), list bool

Arguments msb_bits N%nat_scope z%Z_scope
cell_matches =
fun (P : forall _ : bool, Prop) (c : Cell) =>
match c return Prop with
| Some b => P b
| None => @ex bool (fun b : bool => P b)
end
     : forall (_ : forall _ : bool, Prop) (_ : Cell), Prop

Arguments cell_matches P%function_scope c
frame_input_cells_at =
fun (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (cells : list Cell) =>
forall (i : nat) (c : Cell) (_ : @eq (option Cell) (@List.nth_error Cell cells i) (@Some Cell c)),
cell_matches (frame_input_bit_at m bw edge (BinInt.Z.add cursor (BinInt.Z.of_nat i))) c
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : list Cell), Prop

Arguments frame_input_cells_at m bw (edge cursor)%Z_scope cells%list_scope
frame_output_bit_at =
fun (m : Memory.Mem.mem) (bw : Values.block) (edge q : BinNums.Z) (b : bool) =>
and (BinInt.Z.le BinNums.Z0 q)
  (@ex Integers.Int64.int
     (fun w : Integers.Int64.int =>
      and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint64 m bw
              (BinInt.Z.add edge
                 (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                    (BinInt.Z.div q
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
           (@Some Values.val (Values.Vlong w)))
        (@eq bool b
           (Integers.Int64.testbit w
              (BinInt.Z.modulo q
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : bool), Prop

Arguments frame_output_bit_at m bw (edge q)%Z_scope b%bool_scope
frame_output_cells_at =
fun (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (cells : list Cell) =>
forall (i : nat) (c : Cell) (_ : @eq (option Cell) (@List.nth_error Cell cells i) (@Some Cell c)),
cell_matches
  (frame_output_bit_at m bw edge (BinInt.Z.sub (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) (BinInt.Z.of_nat i))) c
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : list Cell), Prop

Arguments frame_output_cells_at m bw (edge cursor)%Z_scope cells%list_scope
frame_words =
fun n : BinNums.Z =>
BinInt.Z.div
  (BinInt.Z.add n (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : forall _ : BinNums.Z, BinNums.Z

Arguments frame_words n%Z_scope
read_padding =
fun n : BinNums.Z =>
BinInt.Z.sub
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     (frame_words n)) n
     : forall _ : BinNums.Z, BinNums.Z

Arguments read_padding n%Z_scope
Variant frame_loc : Set :=  Build_frame_loc : forall (_ : BinNums.Z) (_ : BinNums.Z), frame_loc.

Arguments Build_frame_loc (item_ofs edge_ofs)%Z_scope
Variant bm_layout : Type :=
    Build_bm_layout : forall (_ : Values.block) (_ : Values.block) (_ : list frame_loc) (_ : frame_loc)
                        (_ : frame_loc) (_ : list frame_loc), bm_layout.

Arguments Build_bm_layout cells_blk frames_blk inactive_read_locs%list_scope active_read_loc
  active_write_loc inactive_write_locs%list_scope
read_size =
fun rf : ReadFrame => BinInt.Z.of_nat (Nat.add (@length Cell (prevData rf)) (@length Cell (nextData rf)))
     : forall _ : ReadFrame, BinNums.Z

Arguments read_size rf
write_size =
fun wf : WriteFrame => BinInt.Z.of_nat (Nat.add (@length Cell (writeData wf)) (writeEmpty wf))
     : forall _ : WriteFrame, BinNums.Z

Arguments write_size wf
read_frame_rep =
fun (m : Memory.Mem.mem) (L : bm_layout) (l : frame_loc) (rf : ReadFrame) =>
let n : BinNums.Z := read_size rf in
and (frame_base_valid (item_ofs l))
  (and (BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (item_ofs l))
     (and
        (frame_fields_at m (frames_blk L) (item_ofs l) (cells_blk L) (edge_ofs l)
           (BinInt.Z.add (read_padding n) (BinInt.Z.of_nat (@length Cell (prevData rf)))))
        (and
           (and
              (BinInt.Z.le
                 (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (frame_words n))
                 (edge_ofs l)) (BinInt.Z.le (edge_ofs l) Integers.Ptrofs.max_unsigned))
           (and (BinInt.Z.le (BinInt.Z.add (read_padding n) n) Integers.Int64.max_unsigned)
              (and
                 (forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i (frame_words n))),
                  @ex Integers.Int64.int
                    (fun w : Integers.Int64.int =>
                     @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m (cells_blk L)
                          (BinInt.Z.sub (edge_ofs l)
                             (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                (BinInt.Z.add (BinNums.Zpos BinNums.xH) i)))) (@Some Values.val (Values.Vlong w))))
                 (frame_input_cells_at m (cells_blk L) (edge_ofs l) (read_padding n)
                    (@app Cell (@List.rev Cell (prevData rf)) (nextData rf))))))))
     : forall (_ : Memory.Mem.mem) (_ : bm_layout) (_ : frame_loc) (_ : ReadFrame), Prop

Arguments read_frame_rep m L l rf
write_frame_rep =
fun (m : Memory.Mem.mem) (L : bm_layout) (l : frame_loc) (wf : WriteFrame) =>
let n : BinNums.Z := write_size wf in
and (frame_base_valid (item_ofs l))
  (and (frame_fields_at m (frames_blk L) (item_ofs l) (cells_blk L) (edge_ofs l) (BinInt.Z.of_nat (writeEmpty wf)))
     (and (BinInt.Z.le BinNums.Z0 (edge_ofs l))
        (and (BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (edge_ofs l))
           (and
              (BinInt.Z.le
                 (BinInt.Z.add (edge_ofs l)
                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (frame_words n)))
                 Integers.Ptrofs.max_unsigned)
              (and (BinInt.Z.le n Integers.Int64.max_unsigned)
                 (and
                    (forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i (frame_words n))),
                     @ex Integers.Int64.int
                       (fun w : Integers.Int64.int =>
                        @eq (option Values.val)
                          (Memory.Mem.load AST.Mint64 m (cells_blk L)
                             (BinInt.Z.add (edge_ofs l)
                                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) i)))
                          (@Some Values.val (Values.Vlong w))))
                    (frame_output_cells_at m (cells_blk L) (edge_ofs l) n (@List.rev Cell (writeData wf)))))))))
     : forall (_ : Memory.Mem.mem) (_ : bm_layout) (_ : frame_loc) (_ : WriteFrame), Prop

Arguments write_frame_rep m L l wf
bm_rep =
fun (m : Memory.Mem.mem) (L : bm_layout) (s : RunState) =>
and (not (@eq Values.block (cells_blk L) (frames_blk L)))
  (and (@List.Forall2 frame_loc ReadFrame (read_frame_rep m L) (inactive_read_locs L) (inactiveReadFrames s))
     (and (read_frame_rep m L (active_read_loc L) (activeReadFrame s))
        (and (write_frame_rep m L (active_write_loc L) (activeWriteFrame s))
           (@List.Forall2 frame_loc WriteFrame (write_frame_rep m L) (inactive_write_locs L) (inactiveWriteFrames s)))))
     : forall (_ : Memory.Mem.mem) (_ : bm_layout) (_ : RunState), Prop

Arguments bm_rep m L s
disjoint_ranges =
fun lo1 hi1 lo2 hi2 : BinNums.Z => or (BinInt.Z.le hi1 lo2) (BinInt.Z.le hi2 lo1)
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments disjoint_ranges (lo1 hi1 lo2 hi2)%Z_scope
read_region_lo =
fun (l : frame_loc) (rf : ReadFrame) =>
BinInt.Z.sub (edge_ofs l)
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (frame_words (read_size rf)))
     : forall (_ : frame_loc) (_ : ReadFrame), BinNums.Z

Arguments read_region_lo l rf
write_region_hi =
fun (l : frame_loc) (wf : WriteFrame) =>
BinInt.Z.add (edge_ofs l)
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (frame_words (write_size wf)))
     : forall (_ : frame_loc) (_ : WriteFrame), BinNums.Z

Arguments write_region_hi l wf
bm_separated =
fun (L : bm_layout) (s : RunState) =>
let aw : frame_loc := active_write_loc L in
let awf : WriteFrame := activeWriteFrame s in
and
  (forall (l : frame_loc)
     (_ : @List.In frame_loc l
            (@cons frame_loc (active_read_loc L) (@app frame_loc (inactive_read_locs L) (inactive_write_locs L)))),
   disjoint_ranges (item_ofs l)
     (BinInt.Z.add (item_ofs l) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (BinInt.Z.add (item_ofs aw) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     (BinInt.Z.add (item_ofs aw) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  (and
     (@List.Forall2 frame_loc ReadFrame
        (fun (l : frame_loc) (rf : ReadFrame) =>
         disjoint_ranges (edge_ofs aw) (write_region_hi aw awf) (read_region_lo l rf) (edge_ofs l))
        (@cons frame_loc (active_read_loc L) (inactive_read_locs L))
        (@cons ReadFrame (activeReadFrame s) (inactiveReadFrames s)))
     (@List.Forall2 frame_loc WriteFrame
        (fun (l : frame_loc) (wf : WriteFrame) =>
         disjoint_ranges (edge_ofs aw) (write_region_hi aw awf) (edge_ofs l) (write_region_hi l wf))
        (inactive_write_locs L) (inactiveWriteFrames s)))
     : forall (_ : bm_layout) (_ : RunState), Prop

Arguments bm_separated L s
active_write_writable =
fun (m : Memory.Mem.mem) (L : bm_layout) (s : RunState) =>
let aw : frame_loc := active_write_loc L in
and
  (Memory.Mem.valid_access m AST.Mint64 (frames_blk L)
     (BinInt.Z.add (item_ofs aw) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
  (Memory.Mem.range_perm m (cells_blk L) (edge_ofs aw) (write_region_hi aw (activeWriteFrame s)) Memtype.Cur
     Memtype.Writable)
     : forall (_ : Memory.Mem.mem) (_ : bm_layout) (_ : RunState), Prop

Arguments active_write_writable m L s
jet_args =
fun (env : Values.val) (L : bm_layout) =>
@cons Values.val (Values.Vptr (frames_blk L) (Integers.Ptrofs.repr (item_ofs (active_write_loc L))))
  (@cons Values.val (Values.Vptr (frames_blk L) (Integers.Ptrofs.repr (item_ofs (active_read_loc L))))
     (@cons Values.val env (@nil Values.val)))
     : forall (_ : Values.val) (_ : bm_layout), list Values.val

Arguments jet_args env L
jet_local_spec =
fun (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, Ty.tySem B) =>
forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
  (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
  (a : Ty.tySem A) (_ : frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
  (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize A))) Integers.Int64.max_unsigned)
  (_ : frame_input_cells_at m bi edge read_cursor (@encode A a))
  (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f)
        (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
           (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
        Events.E0 mf (Values.Vint Integers.Int.one))
     (and (frame_output_cells_at mf bw outedge cursor (@encode B (spec a)))
        (and (write_prefix_at m mf bw outedge cursor)
           (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B))))
              (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                 (_ : or (not (@eq Values.block b bd))
                        (or
                           (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                              (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (BinInt.Z.le
                              (BinInt.Z.add dbase
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                 (_ : or (not (@eq Values.block b bw))
                        (or
                           (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                              (BinInt.Z.add outedge
                                 (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                    (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B)))
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                           (BinInt.Z.le
                              (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
               @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
     : forall (_ : Clight.function) (A B : Ty.Ty) (_ : forall _ : Ty.tySem A, Ty.tySem B), Prop

Arguments jet_local_spec f (A B)%ty_scope spec%function_scope
jet_context_for =
fun (f : Clight.function) (A B : Ty.Ty) (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg A B) =>
forall (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context) (a : Ty.tySem A),
let s0 : RunState := fillContext ctx (Build_LocalState (@encode A a) (newWriteFrame (bitSize B))) in
let s1 : RunState := fillContext ctx (Build_LocalState (@encode A a) (fullWriteFrame (@encode B (t Alg.CoreFunSem a))))
  in
forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f) (jet_args env L) Events.E0 mf
        (Values.Vint Integers.Int.one))
     (and (bm_rep mf L s1) (runProgram (t Naive.translate) (Running s0) (Running s1))))
     : forall (_ : Clight.function) (A B : Ty.Ty) (_ : forall alg : Alg.Core.Algebra, Alg.Core.domain alg A B), Prop

Arguments jet_context_for f {A B}%ty_scope t%function_scope
increasing_ranges =
fix increasing_ranges (l : list (prod BinNums.Z BinNums.Z)) : Prop :=
  match l return Prop with
  | nil => True
  | cons x l' =>
      and (BinInt.Z.le (@fst BinNums.Z BinNums.Z x) (@snd BinNums.Z BinNums.Z x))
        (and
           match l' return Prop with
           | nil => True
           | cons y _ => BinInt.Z.le (@snd BinNums.Z BinNums.Z x) (@fst BinNums.Z BinNums.Z y)
           end (increasing_ranges l'))
  end
     : forall _ : list (prod BinNums.Z BinNums.Z), Prop

Arguments increasing_ranges l%list_scope
read_ranges =
fun (ls : list frame_loc) (rfs : list ReadFrame) =>
@List.map (prod frame_loc ReadFrame) (prod BinNums.Z BinNums.Z)
  (fun p : prod frame_loc ReadFrame =>
   @pair BinNums.Z BinNums.Z (read_region_lo (@fst frame_loc ReadFrame p) (@snd frame_loc ReadFrame p))
     (edge_ofs (@fst frame_loc ReadFrame p))) (@List.combine frame_loc ReadFrame ls rfs)
     : forall (_ : list frame_loc) (_ : list ReadFrame), list (prod BinNums.Z BinNums.Z)

Arguments read_ranges (ls rfs)%list_scope
write_ranges =
fun (ls : list frame_loc) (wfs : list WriteFrame) =>
@List.map (prod frame_loc WriteFrame) (prod BinNums.Z BinNums.Z)
  (fun p : prod frame_loc WriteFrame =>
   @pair BinNums.Z BinNums.Z (edge_ofs (@fst frame_loc WriteFrame p))
     (write_region_hi (@fst frame_loc WriteFrame p) (@snd frame_loc WriteFrame p)))
  (@List.combine frame_loc WriteFrame ls wfs)
     : forall (_ : list frame_loc) (_ : list WriteFrame), list (prod BinNums.Z BinNums.Z)

Arguments write_ranges (ls wfs)%list_scope
item_ranges =
fun ls : list frame_loc =>
@List.map frame_loc (prod BinNums.Z BinNums.Z)
  (fun l : frame_loc =>
   @pair BinNums.Z BinNums.Z (item_ofs l)
     (BinInt.Z.add (item_ofs l) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) ls
     : forall _ : list frame_loc, list (prod BinNums.Z BinNums.Z)

Arguments item_ranges ls%list_scope
gap_buffer_layout =
fun (L : bm_layout) (s : RunState) =>
and
  (increasing_ranges
     (@app (prod BinNums.Z BinNums.Z)
        (@List.rev (prod BinNums.Z BinNums.Z)
           (item_ranges (@cons frame_loc (active_read_loc L) (inactive_read_locs L))))
        (item_ranges (@cons frame_loc (active_write_loc L) (inactive_write_locs L)))))
  (increasing_ranges
     (@app (prod BinNums.Z BinNums.Z)
        (@List.rev (prod BinNums.Z BinNums.Z)
           (read_ranges (@cons frame_loc (active_read_loc L) (inactive_read_locs L))
              (@cons ReadFrame (activeReadFrame s) (inactiveReadFrames s))))
        (write_ranges (@cons frame_loc (active_write_loc L) (inactive_write_locs L))
           (@cons WriteFrame (activeWriteFrame s) (inactiveWriteFrames s)))))
     : forall (_ : bm_layout) (_ : RunState), Prop

Arguments gap_buffer_layout L s
cont_app =
fix cont_app (k0 k : Clight.cont) {struct k0} : Clight.cont :=
  match k0 return Clight.cont with
  | Clight.Kstop => k
  | Clight.Kseq s k1 => Clight.Kseq s (cont_app k1 k)
  | Clight.Kloop1 s1 s2 k1 => Clight.Kloop1 s1 s2 (cont_app k1 k)
  | Clight.Kloop2 s1 s2 k1 => Clight.Kloop2 s1 s2 (cont_app k1 k)
  | Clight.Kswitch k1 => Clight.Kswitch (cont_app k1 k)
  | Clight.Kcall o f e le k1 => Clight.Kcall o f e le (cont_app k1 k)
  end
     : forall (_ : Clight.cont) (_ : Clight.cont), Clight.cont

Arguments cont_app k0 k
state_app =
fun (k : Clight.cont) (s : Clight.state) =>
match s return Clight.state with
| Clight.State f st k0 e le m => Clight.State f st (cont_app k0 k) e le m
| Clight.Callstate fd args k0 m => Clight.Callstate fd args (cont_app k0 k) m
| Clight.Returnstate v k0 m => Clight.Returnstate v (cont_app k0 k) m
end
     : forall (_ : Clight.cont) (_ : Clight.state), Clight.state

Arguments state_app k s
cont_size =
fix cont_size (k : Clight.cont) : nat :=
  match k return nat with
  | Clight.Kstop => O
  | Clight.Kseq _ k0 => S (cont_size k0)
  | Clight.Kloop1 _ _ k0 => S (cont_size k0)
  | Clight.Kloop2 _ _ k0 => S (cont_size k0)
  | Clight.Kswitch k0 => S (cont_size k0)
  | Clight.Kcall _ _ _ _ k0 => S (cont_size k0)
  end
     : forall _ : Clight.cont, nat

Arguments cont_size k
find_label_app =
fix find_label_app (lbl : Clight.label) (s : Clight.statement) (k0 k : Clight.cont) {struct s} :
    @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl s (cont_app k0 k))
      (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
         (fun p : prod Clight.statement Clight.cont =>
          @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
            (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl s k0)) :=
  match
    s as s0
    return
      (@eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl s0 (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl s0 k0)))
  with
  | Clight.Sskip =>
      @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
      :
      @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl Clight.Sskip (cont_app k0 k))
        (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
           (fun p : prod Clight.statement Clight.cont =>
            @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
              (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl Clight.Sskip k0))
  | Clight.Sassign e e0 =>
      (fun e1 e2 : Clight.expr =>
       @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
       :
       @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl (Clight.Sassign e1 e2) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl (Clight.Sassign e1 e2) k0)))
        e e0
  | Clight.Sset i e =>
      (fun (i0 : AST.ident) (e0 : Clight.expr) =>
       @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
       :
       @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl (Clight.Sset i0 e0) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl (Clight.Sset i0 e0) k0))) i e
  | Clight.Scall o e l =>
      (fun (o0 : option AST.ident) (e0 : Clight.expr) (l0 : list Clight.expr) =>
       @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
       :
       @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl (Clight.Scall o0 e0 l0) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl (Clight.Scall o0 e0 l0) k0)))
        o e l
  | Clight.Sbuiltin o e t l =>
      (fun (o0 : option AST.ident) (e0 : AST.external_function) (t0 : Ctypes.typelist) (l0 : list Clight.expr) =>
       @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
       :
       @eq (option (prod Clight.statement Clight.cont))
         (Clight.find_label lbl (Clight.Sbuiltin o0 e0 t0 l0) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k))
            (Clight.find_label lbl (Clight.Sbuiltin o0 e0 t0 l0) k0))) o e t l
  | Clight.Ssequence s0 s1 =>
      (fun s2 s3 : Clight.statement =>
       @eq_ind_r (option (prod Clight.statement Clight.cont))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl s2 (Clight.Kseq s3 k0)))
         (fun o : option (prod Clight.statement Clight.cont) =>
          @eq (option (prod Clight.statement Clight.cont))
            match o return (option (prod Clight.statement Clight.cont)) with
            | Some sk => @Some (prod Clight.statement Clight.cont) sk
            | None => Clight.find_label lbl s3 (cont_app k0 k)
            end
            (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
               (fun p : prod Clight.statement Clight.cont =>
                @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                  (cont_app (@snd Clight.statement Clight.cont p) k))
               match
                 Clight.find_label lbl s2 (Clight.Kseq s3 k0) return (option (prod Clight.statement Clight.cont))
               with
               | Some sk => @Some (prod Clight.statement Clight.cont) sk
               | None => Clight.find_label lbl s3 k0
               end))
         (let o : option (prod Clight.statement Clight.cont) := Clight.find_label lbl s2 (Clight.Kseq s3 k0) in
          match
            o as o0
            return
              (@eq (option (prod Clight.statement Clight.cont))
                 match
                   @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                     (fun p : prod Clight.statement Clight.cont =>
                      @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                        (cont_app (@snd Clight.statement Clight.cont p) k)) o0
                   return (option (prod Clight.statement Clight.cont))
                 with
                 | Some sk => @Some (prod Clight.statement Clight.cont) sk
                 | None => Clight.find_label lbl s3 (cont_app k0 k)
                 end
                 (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k))
                    match o0 return (option (prod Clight.statement Clight.cont)) with
                    | Some sk => @Some (prod Clight.statement Clight.cont) sk
                    | None => Clight.find_label lbl s3 k0
                    end))
          with
          | Some a =>
              (fun p : prod Clight.statement Clight.cont =>
               @eq_refl (option (prod Clight.statement Clight.cont))
                 (@Some (prod Clight.statement Clight.cont)
                    (@pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k)))
               :
               @eq (option (prod Clight.statement Clight.cont))
                 match
                   @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                     (fun p0 : prod Clight.statement Clight.cont =>
                      @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p0)
                        (cont_app (@snd Clight.statement Clight.cont p0) k))
                     (@Some (prod Clight.statement Clight.cont) p) return (option (prod Clight.statement Clight.cont))
                 with
                 | Some sk => @Some (prod Clight.statement Clight.cont) sk
                 | None => Clight.find_label lbl s3 (cont_app k0 k)
                 end
                 (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p0 : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p0)
                       (cont_app (@snd Clight.statement Clight.cont p0) k))
                    (@Some (prod Clight.statement Clight.cont) p))) a
          | None =>
              find_label_app lbl s3 k0 k
              :
              @eq (option (prod Clight.statement Clight.cont))
                match
                  @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k)) (@None (prod Clight.statement Clight.cont))
                  return (option (prod Clight.statement Clight.cont))
                with
                | Some sk => @Some (prod Clight.statement Clight.cont) sk
                | None => Clight.find_label lbl s3 (cont_app k0 k)
                end
                (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                   (fun p : prod Clight.statement Clight.cont =>
                    @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                      (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl s3 k0))
          end) (Clight.find_label lbl s2 (cont_app (Clight.Kseq s3 k0) k))
         (find_label_app lbl s2 (Clight.Kseq s3 k0) k)
       :
       @eq (option (prod Clight.statement Clight.cont))
         (Clight.find_label lbl (Clight.Ssequence s2 s3) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl (Clight.Ssequence s2 s3) k0)))
        s0 s1
  | Clight.Sifthenelse e s0 s1 =>
      (fun (e0 : Clight.expr) (s2 s3 : Clight.statement) =>
       @eq_ind_r (option (prod Clight.statement Clight.cont))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl s2 k0))
         (fun o : option (prod Clight.statement Clight.cont) =>
          @eq (option (prod Clight.statement Clight.cont))
            match o return (option (prod Clight.statement Clight.cont)) with
            | Some sk => @Some (prod Clight.statement Clight.cont) sk
            | None => Clight.find_label lbl s3 (cont_app k0 k)
            end
            (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
               (fun p : prod Clight.statement Clight.cont =>
                @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                  (cont_app (@snd Clight.statement Clight.cont p) k))
               match Clight.find_label lbl s2 k0 return (option (prod Clight.statement Clight.cont)) with
               | Some sk => @Some (prod Clight.statement Clight.cont) sk
               | None => Clight.find_label lbl s3 k0
               end))
         (let o : option (prod Clight.statement Clight.cont) := Clight.find_label lbl s2 k0 in
          match
            o as o0
            return
              (@eq (option (prod Clight.statement Clight.cont))
                 match
                   @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                     (fun p : prod Clight.statement Clight.cont =>
                      @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                        (cont_app (@snd Clight.statement Clight.cont p) k)) o0
                   return (option (prod Clight.statement Clight.cont))
                 with
                 | Some sk => @Some (prod Clight.statement Clight.cont) sk
                 | None => Clight.find_label lbl s3 (cont_app k0 k)
                 end
                 (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k))
                    match o0 return (option (prod Clight.statement Clight.cont)) with
                    | Some sk => @Some (prod Clight.statement Clight.cont) sk
                    | None => Clight.find_label lbl s3 k0
                    end))
          with
          | Some a =>
              (fun p : prod Clight.statement Clight.cont =>
               @eq_refl (option (prod Clight.statement Clight.cont))
                 (@Some (prod Clight.statement Clight.cont)
                    (@pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k)))
               :
               @eq (option (prod Clight.statement Clight.cont))
                 match
                   @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                     (fun p0 : prod Clight.statement Clight.cont =>
                      @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p0)
                        (cont_app (@snd Clight.statement Clight.cont p0) k))
                     (@Some (prod Clight.statement Clight.cont) p) return (option (prod Clight.statement Clight.cont))
                 with
                 | Some sk => @Some (prod Clight.statement Clight.cont) sk
                 | None => Clight.find_label lbl s3 (cont_app k0 k)
                 end
                 (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p0 : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p0)
                       (cont_app (@snd Clight.statement Clight.cont p0) k))
                    (@Some (prod Clight.statement Clight.cont) p))) a
          | None =>
              find_label_app lbl s3 k0 k
              :
              @eq (option (prod Clight.statement Clight.cont))
                match
                  @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k)) (@None (prod Clight.statement Clight.cont))
                  return (option (prod Clight.statement Clight.cont))
                with
                | Some sk => @Some (prod Clight.statement Clight.cont) sk
                | None => Clight.find_label lbl s3 (cont_app k0 k)
                end
                (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                   (fun p : prod Clight.statement Clight.cont =>
                    @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                      (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl s3 k0))
          end) (Clight.find_label lbl s2 (cont_app k0 k)) (find_label_app lbl s2 k0 k)
       :
       @eq (option (prod Clight.statement Clight.cont))
         (Clight.find_label lbl (Clight.Sifthenelse e0 s2 s3) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k))
            (Clight.find_label lbl (Clight.Sifthenelse e0 s2 s3) k0))) e s0 s1
  | Clight.Sloop s0 s1 =>
      (fun s2 s3 : Clight.statement =>
       @eq_ind_r (option (prod Clight.statement Clight.cont))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl s2 (Clight.Kloop1 s2 s3 k0)))
         (fun o : option (prod Clight.statement Clight.cont) =>
          @eq (option (prod Clight.statement Clight.cont))
            match o return (option (prod Clight.statement Clight.cont)) with
            | Some sk => @Some (prod Clight.statement Clight.cont) sk
            | None => Clight.find_label lbl s3 (Clight.Kloop2 s2 s3 (cont_app k0 k))
            end
            (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
               (fun p : prod Clight.statement Clight.cont =>
                @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                  (cont_app (@snd Clight.statement Clight.cont p) k))
               match
                 Clight.find_label lbl s2 (Clight.Kloop1 s2 s3 k0) return (option (prod Clight.statement Clight.cont))
               with
               | Some sk => @Some (prod Clight.statement Clight.cont) sk
               | None => Clight.find_label lbl s3 (Clight.Kloop2 s2 s3 k0)
               end))
         (let o : option (prod Clight.statement Clight.cont) := Clight.find_label lbl s2 (Clight.Kloop1 s2 s3 k0) in
          match
            o as o0
            return
              (@eq (option (prod Clight.statement Clight.cont))
                 match
                   @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                     (fun p : prod Clight.statement Clight.cont =>
                      @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                        (cont_app (@snd Clight.statement Clight.cont p) k)) o0
                   return (option (prod Clight.statement Clight.cont))
                 with
                 | Some sk => @Some (prod Clight.statement Clight.cont) sk
                 | None => Clight.find_label lbl s3 (Clight.Kloop2 s2 s3 (cont_app k0 k))
                 end
                 (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k))
                    match o0 return (option (prod Clight.statement Clight.cont)) with
                    | Some sk => @Some (prod Clight.statement Clight.cont) sk
                    | None => Clight.find_label lbl s3 (Clight.Kloop2 s2 s3 k0)
                    end))
          with
          | Some a =>
              (fun p : prod Clight.statement Clight.cont =>
               @eq_refl (option (prod Clight.statement Clight.cont))
                 (@Some (prod Clight.statement Clight.cont)
                    (@pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k)))
               :
               @eq (option (prod Clight.statement Clight.cont))
                 match
                   @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                     (fun p0 : prod Clight.statement Clight.cont =>
                      @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p0)
                        (cont_app (@snd Clight.statement Clight.cont p0) k))
                     (@Some (prod Clight.statement Clight.cont) p) return (option (prod Clight.statement Clight.cont))
                 with
                 | Some sk => @Some (prod Clight.statement Clight.cont) sk
                 | None => Clight.find_label lbl s3 (Clight.Kloop2 s2 s3 (cont_app k0 k))
                 end
                 (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p0 : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p0)
                       (cont_app (@snd Clight.statement Clight.cont p0) k))
                    (@Some (prod Clight.statement Clight.cont) p))) a
          | None =>
              find_label_app lbl s3 (Clight.Kloop2 s2 s3 k0) k
              :
              @eq (option (prod Clight.statement Clight.cont))
                match
                  @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k)) (@None (prod Clight.statement Clight.cont))
                  return (option (prod Clight.statement Clight.cont))
                with
                | Some sk => @Some (prod Clight.statement Clight.cont) sk
                | None => Clight.find_label lbl s3 (Clight.Kloop2 s2 s3 (cont_app k0 k))
                end
                (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                   (fun p : prod Clight.statement Clight.cont =>
                    @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                      (cont_app (@snd Clight.statement Clight.cont p) k))
                   (Clight.find_label lbl s3 (Clight.Kloop2 s2 s3 k0)))
          end) (Clight.find_label lbl s2 (cont_app (Clight.Kloop1 s2 s3 k0) k))
         (find_label_app lbl s2 (Clight.Kloop1 s2 s3 k0) k)
       :
       @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl (Clight.Sloop s2 s3) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl (Clight.Sloop s2 s3) k0))) s0
        s1
  | Clight.Sbreak =>
      @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
      :
      @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl Clight.Sbreak (cont_app k0 k))
        (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
           (fun p : prod Clight.statement Clight.cont =>
            @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
              (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl Clight.Sbreak k0))
  | Clight.Scontinue =>
      @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
      :
      @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl Clight.Scontinue (cont_app k0 k))
        (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
           (fun p : prod Clight.statement Clight.cont =>
            @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
              (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl Clight.Scontinue k0))
  | Clight.Sreturn o =>
      (fun o0 : option Clight.expr =>
       @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
       :
       @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl (Clight.Sreturn o0) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl (Clight.Sreturn o0) k0))) o
  | Clight.Sswitch e l =>
      (fun (e0 : Clight.expr) (l0 : Clight.labeled_statements) =>
       find_label_ls_app lbl l0 (Clight.Kswitch k0) k
       :
       @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl (Clight.Sswitch e0 l0) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl (Clight.Sswitch e0 l0) k0)))
        e l
  | Clight.Slabel l s0 =>
      (fun (l0 : Clight.label) (s1 : Clight.statement) =>
       (let s2 : sumbool (@eq BinNums.positive lbl l0) (not (@eq BinNums.positive lbl l0)) := AST.ident_eq lbl l0 in
        match
          s2 as s3
          return
            (@eq (option (prod Clight.statement Clight.cont))
               match s3 return (option (prod Clight.statement Clight.cont)) with
               | left _ =>
                   @Some (prod Clight.statement Clight.cont) (@pair Clight.statement Clight.cont s1 (cont_app k0 k))
               | right _ => Clight.find_label lbl s1 (cont_app k0 k)
               end
               (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                  (fun p : prod Clight.statement Clight.cont =>
                   @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                     (cont_app (@snd Clight.statement Clight.cont p) k))
                  match s3 return (option (prod Clight.statement Clight.cont)) with
                  | left _ => @Some (prod Clight.statement Clight.cont) (@pair Clight.statement Clight.cont s1 k0)
                  | right _ => Clight.find_label lbl s1 k0
