         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))) (@increment8_spec)
increment16_context
     : @jet_context_for f_simplicity_increment_16 (Word.Word (S (S (S (S O)))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S O)))))) (@increment16_spec)
increment32_context
     : @jet_context_for f_simplicity_increment_32 (Word.Word (S (S (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O))))))) (@increment32_spec)
