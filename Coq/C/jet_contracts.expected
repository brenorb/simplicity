               (@None BinNums.Z))
            (@cons region (mkreg (u64_cells BinNums.Z0 (vars5 O)) false (@None BinNums.Z)) (@nil region))) m
eval_fe_get_b32_from_storage
     : forall (m : Memory.Mem.mem) (b : Values.block) (offset : BinNums.Z) (bf : Values.block)
         (base value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : BinInt.Z.le BinNums.Z0 offset)
         (_ : BinInt.Z.le
                (BinInt.Z.add offset
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b offset
                (BinInt.Z.add offset
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable)
         (_ : fe_at m bf base (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (fe_limbs_of value)))
         (_ : not (@eq Values.block b bf)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_get_b32)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr offset))
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (uint8_array_at mf b offset
                  (@List.map BinNums.Z Integers.Int.int Integers.Int.repr (jet_secp_fe_b32.be_bytes value)))
               (lframe
                  (fun (block : Values.block) (pos : BinNums.Z) =>
                   not
                     (foot
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b offset)
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bf base)
                              (@nil (prod Values.block BinNums.Z))))
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           (@cons region
                              (mkreg
                                 (jet_secp_fe_b32.byte_undef BinNums.Z0
                                    (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))) true
                                 (@None BinNums.Z))
                              (@cons region (mkreg (u64_cells BinNums.Z0 (vars5 O)) false (@None BinNums.Z))
                                 (@nil region)))) block pos)) m mf)))
msb_bits_mod
     : forall (N : nat) (value : BinNums.Z),
       @eq (list bool)
         (msb_bits N (BinInt.Z.modulo value (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat N))))
         (msb_bits N value)
be_chunks_bits
     : forall (count : nat) (value : BinNums.Z),
       @eq (list bool)
         (@List.concat bool
            (@List.map BinNums.Z (list bool) (msb_bits (S (S (S (S (S (S (S (S O))))))))) (be_chunks count value)))
         (msb_bits (Nat.mul (S (S (S (S (S (S (S (S O)))))))) count) value)
be_chunks_32
     : forall value : BinNums.Z,
       @eq (list BinNums.Z)
         (be_chunks (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))) value)
         (jet_secp_fe_b32.be_bytes value)
be_chunks_byte_bounds
     : forall (count : nat) (value : BinNums.Z),
       @List.Forall BinNums.Z
         (fun byte : BinNums.Z =>
          and (BinInt.Z.le BinNums.Z0 byte)
            (BinInt.Z.lt byte
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (be_chunks count value)
machine_byte_encoding
     : forall (byte : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 byte)
                (BinInt.Z.lt byte
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @eq (list Cell)
         (@encode (Word.Word (S (S (S O))))
            (decode_word8 (Integers.Int64.repr (Integers.Int.unsigned (Integers.Int.repr byte)))))
         (@List.map bool (option bool) (@Some bool) (msb_bits (S (S (S (S (S (S (S (S O)))))))) byte))
be_bytes_canonical_encoding
     : forall value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Cell)
         (byte_sequence_cells
            (@List.map BinNums.Z Integers.Int.int Integers.Int.repr
               (jet_secp_fe_b32.be_bytes (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) value))))
         (@encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) value)
