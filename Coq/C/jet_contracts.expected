     : forall (k w : nat) (p : BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (xs_of : forall _ : BitcoinFull.env,
                  list
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Word.Vector (Word.Word (S (S (S O)))) k))) (f : Clight.function)
         (field : AST.ident) (hdelta : BinNums.Z)
         (_ : forall (i : Ty.tySem (Word.Word w)) (e : BitcoinFull.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (@BitcoinFull.sem (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) p i e)
                (@Some
                   (sum unit
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end) (Word.Vector (Word.Word (S (S (S O)))) k)) (xs_of e) (BinInt.Z.to_nat (wz w i))
                     return
                       (sum unit
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x =>
                       @inr unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None =>
                       @inl unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end))
         (_ : BinInt.Z.lt
                (BinInt.Z.div (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)) (wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                ctx8_limit)
         (_ : jet_bitcoin_wrapper.bitcoin_wrapper_shape f
                (jet_bitcoin_wrapper.bitcoin_simple_rest
                   (jet_bitcoin_hash_getters.bitcoin_hash_mid_writeHash jets_bitcoin._tx
                      jets_bitcoin._bitcoinTransaction field)))
