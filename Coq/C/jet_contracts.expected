         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m0 bs sbase bi edge rc)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)))),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt secp_ge (scalar_multiply_public_env bl ba bb) le mb
               (Clight.Sassign (Clight.Evar jets_secp._src secp_frame_type)
                  (Clight.Etempvar jets_secp._src secp_frame_type)) Events.E0 le mc ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mc ba BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mc bb BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mc bl BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                        Memtype.Freeable)
                     (and (frame_fields_at mc bl BinNums.Z0 bi edge rc)
                        (and (not (@eq Values.block ba bb))
                           (and (not (@eq Values.block ba bl))
                              (and (not (@eq Values.block bb bl))
                                 (and
                                    (xsep (extA m0 bd bw bi)
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z ba BinNums.Z0)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bl BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z)))))
                                    (and
                                       (xsep (extA m0 bd bw bi)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bb BinNums.Z0)
                                             (@cons (prod Values.block BinNums.Z)
                                                (@pair Values.block BinNums.Z bl BinNums.Z0)
                                                (@nil (prod Values.block BinNums.Z)))))
                                       (and
                                          (invA m0 bd dbase bw outedge cursor N bi rc false
                                             (@nil Cell)
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                             (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) a)
                                                rc) (@nil event) mc)
                                          (and
                                             (lframe
                                                (fun (bx : Values.block) (_ : BinNums.Z) =>
                                                 and (not (@eq Values.block bx ba))
                                                   (and (not (@eq Values.block bx bb)) (not (@eq Values.block bx bl))))
                                                m0 mc)
                                             (and (not (Memory.Mem.valid_block m0 ba))
                                                (and (not (Memory.Mem.valid_block m0 bb))
                                                   (not (Memory.Mem.valid_block m0 bl))))))))))))))))
both_skip_true
     : forall (a b : Clight.statement) (_ : @eq bool (both_skip a b) true),
       and (@eq Clight.statement a Clight.Sskip) (@eq Clight.statement b Clight.Sskip)
break_stmt_true
     : forall (s : Clight.statement) (_ : @eq bool (break_stmt s) true), @eq Clight.statement s Clight.Sbreak
compact_stmt_lext
     : forall (ce : Ctypes.composite_env) (gv : venv) (fns : list (prod AST.ident fentry))
         (n : nat) (s : Clight.statement) (ve : venv) (st : sstate) (r : res)
         (_ : @eq (option res) (compact_stmt ce gv fns n ve st s) (@Some res r))
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       lext rho beta (slog st) r
compact_stmt_sound
     : forall (ge : Clight.genv) (gv : venv) (fns : list (prod AST.ident fentry))
         (ev_ok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (ext : forall _ : Values.block, Prop)
         (_ : forall (rho : forall _ : nat, Integers.Int64.int) (log : list event) (m m' : Memory.Mem.mem)
                (_ : inv rho log m) (_ : lframe (fun (b : Values.block) (_ : BinNums.Z) => ext b) m m'),
              inv rho log m')
         (_ : forall (rho : forall _ : nat, Integers.Int64.int) (log : list event) (m : Memory.Mem.mem)
                (b : Values.block) (_ : inv rho log m) (_ : ext b), Memory.Mem.valid_block m b)
         (_ : forall (id : AST.ident) (ent : fentry) (_ : @eq (option fentry) (flookup fns id) (@Some fentry ent)),
              and
                (@ex Values.block
                   (fun b : Values.block =>
                    and
                      (@eq (option Values.block)
                         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
                         (@Some Values.block b))
                      (@eq (option Clight.fundef)
                         (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
                         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (fentry_fd ent))))))
                match ent return Prop with
                | FInt _ => True
                | FOra fd o => oracle_ok ge ev_ok inv ext fd o
                end) (n : nat), sound_rec ge gv ev_ok inv ext (compact_stmt (Clight.genv_cenv ge) gv fns n)
compact_fun_pure
     : forall (ge : Clight.genv) (l : list (prod AST.ident Clight.function))
         (_ : forall (id : AST.ident) (f : Clight.function)
                (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) l),
              @ex Values.block
                (fun b : Values.block =>
                 and
                   (@eq (option Values.block)
                      (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
                      (@Some Values.block b))
                   (@eq (option Clight.fundef)
                      (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
                      (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))))
         (n : nat) (fd : Clight.function) (xs : list sx) (regs : list region) (nv : nat) (rr : res)
         (_ : @eq (option res)
                (compact_fun (Clight.genv_cenv ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
                   (int_table l) n fd xs regs (@nil event) nv) (@Some res rr)) (_ : @eq bool (leaves_log_nil rr) true)
         (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem) (_ : rep rho beta regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Values.val
            (fun vres : Values.val =>
             and
               (ClightBigstep.Clight2.eval_funcall ge m (@Ctypes.Internal Clight.function fd)
                  (@List.map sx Values.val (den rho (lay beta)) xs) Events.E0 mf vres)
               (and (rep rho beta (sregs (@fst sstate xout (rsel rho (lay beta) rr))) mf)
                  (and
                     match
                       @Maps.PTree.get sx BinNums.xH (stemps (@fst sstate xout (rsel rho (lay beta) rr))) return Prop
                     with
                     | Some x => @eq Values.val vres (den rho (lay beta) x)
                     | None => @eq Values.val vres Values.Vundef
                     end
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (sregs (@fst sstate xout (rsel rho (lay beta) rr))))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              regs))
                        (lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot beta
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape regs) b ofs)) m mf))))))
compact_fun_shift64_sound
     : forall (fuel : nat) (fd : Clight.function) (args : list sx) (regs : list region) (nv : nat)
         (result : res)
         (_ : @eq (option res)
                (compact_fun (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
                   secp_shift64_table fuel fd args regs (@nil event) nv) (@Some res result))
         (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem) (_ : rep rho beta regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Values.val
            (fun vres : Values.val =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function fd)
                  (@List.map sx Values.val (den rho (lay beta)) args) Events.E0 mf vres)
               (and (rep rho beta (sregs (@fst sstate xout (rsel rho (lay beta) result))) mf)
                  (and
                     match
                       @Maps.PTree.get sx BinNums.xH (stemps (@fst sstate xout (rsel rho (lay beta) result)))
                       return Prop
                     with
                     | Some x => @eq Values.val vres (den rho (lay beta) x)
                     | None => @eq Values.val vres Values.Vundef
                     end
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (sregs (@fst sstate xout (rsel rho (lay beta) result))))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              regs))
                        (lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot beta
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape regs) b ofs)) m mf))))))
initialized_u64_rebuild
     : forall (cs : list cell) (ofs : BinNums.Z) (_ : @eq bool (initialized_u64_cells ofs cs) true),
       @eq (list cell) (u64_cells ofs (@List.map cell sx cell_sx cs)) cs
two_owned_u64_rebuild
     : forall (regs : list region) (src : region) (sz : BinNums.Z) (_ : @eq nat (@length region regs) (S (S O)))
         (_ : @eq (option region) (@List.nth_error region regs (S O)) (@Some region src))
         (_ : @eq bool (rw (@List.hd region (mkreg (@nil cell) false (@None BinNums.Z)) regs)) true)
         (_ : @eq (option BinNums.Z) (rfree (@List.hd region (mkreg (@nil cell) false (@None BinNums.Z)) regs))
                (@Some BinNums.Z sz))
         (_ : @eq bool
                (initialized_u64_cells BinNums.Z0
                   (rcells (@List.hd region (mkreg (@nil cell) false (@None BinNums.Z)) regs))) true),
       @eq (list region) regs
         (@cons region
            (mkreg
               (u64_cells BinNums.Z0
                  (@List.map cell sx cell_sx
                     (rcells (@List.hd region (mkreg (@nil cell) false (@None BinNums.Z)) regs)))) true
               (@Some BinNums.Z sz)) (@cons region src (@nil region)))
scalar_reduce512_run_completes
     : @eq bool
         match scalar_reduce512_run return bool with
         | Some r =>
             match r return bool with
             | RDone _ o =>
                 match o return bool with
                 | ONormal => true
                 | OBreak => false
                 | OContinue => false
                 | OReturn _ => false
                 end
             | RIf _ _ _ => false
             end
         | None => false
         end true
scalar_reduce512_run_eq
