field_negate_state =
match field_negate_tree return sstate with
| Some r =>
    match r return sstate with
    | RDone state _ => state
    | RIf _ _ _ => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
    end
| None => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
end
     : sstate
fe_negate_limbs =
fun z0 z1 z2 z3 z4 : BinNums.Z =>
match
  nvz
    (BinInt.Z.sub
       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
          (BinInt.Z.sub
             (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))) feR)) z0)
    (BinInt.Z.sub
       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
          (BinInt.Z.sub
             (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
             (BinNums.Zpos BinNums.xH))) z1)
    (BinInt.Z.sub
       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
          (BinInt.Z.sub
             (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
             (BinNums.Zpos BinNums.xH))) z2)
    (BinInt.Z.sub
       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
          (BinInt.Z.sub
             (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
             (BinNums.Zpos BinNums.xH))) z3)
    (BinInt.Z.sub
       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
          (BinInt.Z.sub
             (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
             (BinNums.Zpos BinNums.xH))) z4) return (list BinNums.Z)
with
| pair p r4 =>
    match p return (list BinNums.Z) with
    | pair p0 r3 =>
        match p0 return (list BinNums.Z) with
        | pair p1 r2 =>
            match p1 return (list BinNums.Z) with
            | pair r0 r1 =>
                @cons BinNums.Z r0
                  (@cons BinNums.Z r1 (@cons BinNums.Z r2 (@cons BinNums.Z r3 (@cons BinNums.Z r4 (@nil BinNums.Z)))))
            end
        end
    end
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), list BinNums.Z

Arguments fe_negate_limbs (z0 z1 z2 z3 z4)%Z_scope
