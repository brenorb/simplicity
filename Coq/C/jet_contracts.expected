copy_loop_join_value_bits
     : forall (ss : BinNums.Z) (source next : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (BinInt.Z.le ss
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq bool (Integers.Int64.testbit (copy_loop_join_value ss source next) i)
         match
           Coqlib.zlt i
             (BinInt.Z.sub
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                ss) return bool
         with
         | left _ => Integers.Int64.testbit next (BinInt.Z.add i ss)
         | right _ =>
             Integers.Int64.testbit source
               (BinInt.Z.sub i
                  (BinInt.Z.sub
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) ss))
         end
copy_loop_join_copied_bit
     : forall (ss n : BinNums.Z) (source next : Integers.Int64.int) (j : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
