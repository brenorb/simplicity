let issuanceAmount : forall _ : jet_elements_prim.issuance, jet_elements_prim.amountWith (list Integers.Byte.int) :=
  fun i : jet_elements_prim.issuance =>
  match i return (jet_elements_prim.amountWith (list Integers.Byte.int)) with
  | inl new => jet_elements_prim.newIssuanceAmount new
  | inr re => jet_elements_prim.reissuanceAmount re
  end in
let issuanceTokenAmount :
  forall _ : jet_elements_prim.issuance, jet_elements_prim.amountWith (list Integers.Byte.int) :=
  fun i : jet_elements_prim.issuance =>
  match i return (jet_elements_prim.amountWith (list Integers.Byte.int)) with
  | inl new => jet_elements_prim.newIssuanceTokenAmount new
  | inr _ => @jet_elements_prim.Explicit (list Integers.Byte.int) Integers.Int64.int Integers.Int64.zero
  end in
let issuanceProof :
  forall (_ : forall _ : jet_elements_prim.issuance, jet_elements_prim.amountWith (list Integers.Byte.int))
    (_ : jet_elements_prim.sigTxInput), list Integers.Byte.int :=
  fun (f : forall _ : jet_elements_prim.issuance, jet_elements_prim.amountWith (list Integers.Byte.int))
    (txi : jet_elements_prim.sigTxInput) =>
  match jet_elements_prim.sigTxiIssuance txi return (list Integers.Byte.int) with
  | Some i => @jet_elements_prim.viewPrf Integers.Int64.int (f i)
  | None => @nil Integers.Byte.int
  end in
fun (A B : Ty.Ty) (p : jet_elements_prim.Elements.t A B) (a : Ty.tySem A) (e : jet_elements_prim.Elements.env) =>
let tx : jet_elements_prim.sigTx := jet_elements_prim.Elements.envTx e in
let ix : nat := jet_elements_prim.Elements.envIx e in
let atInput :
  forall (A0 : Ty.Ty) (_ : forall _ : jet_elements_prim.sigTxInput, Ty.tySem A0)
    (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))), option (Ty.tySem (Ty.Sum Ty.Unit A0)) :=
  fun (A0 : Ty.Ty) (f : forall _ : jet_elements_prim.sigTxInput, Ty.tySem A0)
    (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
  @Some (Ty.tySem (Ty.Sum Ty.Unit A0))
    (cast A0
       (@option_map jet_elements_prim.sigTxInput (Ty.tySem A0) f
          (@List.nth_error jet_elements_prim.sigTxInput (jet_elements_prim.sigTxIn tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))))) in
let atOutput :
  forall (A0 : Ty.Ty) (_ : forall _ : jet_elements_prim.txOutput, Ty.tySem A0)
    (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))), option (Ty.tySem (Ty.Sum Ty.Unit A0)) :=
  fun (A0 : Ty.Ty) (f : forall _ : jet_elements_prim.txOutput, Ty.tySem A0)
    (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
  @Some (Ty.tySem (Ty.Sum Ty.Unit A0))
    (cast A0
       (@option_map jet_elements_prim.txOutput (Ty.tySem A0) f
          (@List.nth_error jet_elements_prim.txOutput (jet_elements_prim.sigTxOut tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))))) in
match p in (jet_elements_prim.Elements.prim A0 B0) return (forall _ : Ty.tySem A0, option (Ty.tySem B0)) with
| jet_elements_prim.Elements.Version =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
         (Integers.Int.unsigned (jet_elements_prim.sigTxVersion tx)))
| jet_elements_prim.Elements.LockTime =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
         (Integers.Int.unsigned (jet_elements_prim.sigTxLock tx)))
| jet_elements_prim.Elements.InputPegin =>
    atInput (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       cast (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@option_map Digest.hash256 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) encodeHash
            (jet_elements_prim.sigTxiPegin txi)))
| jet_elements_prim.Elements.InputPrevOutpoint =>
    atInput (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
      (fun txi : jet_elements_prim.sigTxInput => encodeOutpoint (jet_elements_prim.sigTxiPreviousOutpoint txi))
| jet_elements_prim.Elements.InputAsset =>
    atInput
      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
       encodeAsset (jet_elements_prim.utxoAsset (jet_elements_prim.sigTxiTxo txi)))
| jet_elements_prim.Elements.InputAmount =>
    atInput
      (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (Word.Word (S (S (S (S (S (S O))))))))
      (fun txi : jet_elements_prim.sigTxInput =>
