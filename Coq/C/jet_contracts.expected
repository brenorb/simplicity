eval_shift_wide_scalar_expr
     : forall (right : bool) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (r : Integers.Int64.int) (a : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _output le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _amt le) (@Some Values.val (Values.Vint a))),
       Clight.eval_expr ge0 e le m (shift_wide_scalar_expr right) (Values.Vlong (shift_wide_scalar_result right r a))
eval_shift_wide_fill_expr
     : forall (s : wide_size) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (r : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _output le) (@Some Values.val (Values.Vlong r))),
       Clight.eval_expr ge0 e le m (shift_wide_fill_expr s) (Values.Vlong (shift_wide_fill_result s r))
eval_shift_wide_count_expr
     : forall (s : wide_size) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (a : Integers.Int.int)
         (_ : and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned a))
                (BinInt.Z.lt (Integers.Int.unsigned a)
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _amt le) (@Some Values.val (Values.Vint a))),
       Clight.eval_expr ge0 e le m (shift_wide_count_expr s)
         (Values.Vint
            match Coqlib.zlt (Integers.Int.unsigned a) (wide_bits s) return Integers.Int.int with
            | left _ => Integers.Int.one
            | right _ => Integers.Int.zero
            end)
eval_readBit4_wide_sequence
     : forall (s : wide_size) (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bi : Values.block)
         (edge rc : BinNums.Z) (fill : bool) (amount : Ty.tySem (Word.Word (S (S O))))
         (x : Ty.tySem (Word.Word (wide_log s))) (_ : frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.add
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                         (wide_bits s))))) (_ : frame_fields_at m bf base bi edge rc)
         (_ : frame_input_bit_at m bi edge rc fill)
         (_ : @frame_input_word_at (S (S O)) m bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) amount)
         (_ : @frame_input_word_at (wide_log s) m bi edge
                (BinInt.Z.add rc
                   (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))) x)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : not (@eq Values.block bf bi)),
       @ex Memory.Mem.mem
         (fun mb : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                @ex Integers.Int.int
                  (fun a : Integers.Int.int =>
                   @ex Integers.Int64.int
                     (fun r : Integers.Int64.int =>
                      and
                        (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_readBit)
                           (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0
                           mb (Values.Vint (bit_int fill)))
                        (and
                           (ClightBigstep.Clight2.eval_funcall ge0 mb
                              (@Ctypes.Internal Clight.function f_simplicity_read4)
                              (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))
                              Events.E0 mr (Values.Vint a))
                           (and
                              (@eq BinNums.Z (Integers.Int.unsigned a)
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S O))) amount))
                              (and
                                 (@eq Integers.Int.int
                                    (Integers.Int.zero_ext
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) a) a)
                                 (and
                                    (ClightBigstep.Clight2.eval_funcall ge0 mr
                                       (@Ctypes.Internal Clight.function (wide_reader s))
                                       (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))
                                       Events.E0 mf (Values.Vlong r))
                                    (and
                                       (@eq BinNums.Z (Integers.Int64.unsigned r)
                                          (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x))
                                       (and
                                          (frame_fields_at mf bf base bi edge
                                             (BinInt.Z.add rc
                                                (BinInt.Z.add
                                                   (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                                                   (wide_bits s))))
                                          (and
                                             (forall (chunk : AST.memory_chunk) (b : Values.block)
                                                (ofs : BinNums.Z)
                                                (_ : or (not (@eq Values.block b bf))
                                                       (or
                                                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                             (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (...)))))
                                                          (BinInt.Z.le
                                                             (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (...)))) ofs))),
                                              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                                (Memory.Mem.load chunk m b ofs))
                                             (and
                                                (forall (b : Values.block) (ofs : BinNums.Z)
                                                   (kind : Memtype.perm_kind) (p : Memtype.permission)
                                                   (_ : Memory.Mem.perm m b ofs kind p),
                                                 Memory.Mem.perm mf b ofs kind p)
                                                (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                                 Memory.Mem.valid_block mf b))))))))))))))
exec_shift_wide_with_helper_call
     : forall (s : wide_size) (right fill : bool) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bl bd : Values.block) (dofs : Integers.Ptrofs.int) (a : Integers.Int.int) (r : Integers.Int64.int)
         (mr mr2 : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst le) (@Some Values.val (Values.Vptr bd dofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _with le)
                (@Some Values.val (Values.Vint (bit_int fill))))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m
                (@Ctypes.Internal Clight.function
                   (shift8_reader_function match s return bool with
                                           | W16 => true
                                           | W32 => false
                                           | W64 => false
                                           end))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr (@Ctypes.Internal Clight.function (wide_reader s))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr2 (@Ctypes.Internal Clight.function (wide_writer s))
                (@cons Values.val (Values.Vptr bd dofs)
                   (@cons Values.val (Values.Vlong (shift_wide_payload s right fill r a)) (@nil Values.val))) Events.E0
                mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt ge0 (jet_one8.e_one8 bl) le m (shift_wide_with_helper_call s right) Events.E0 le
         mf ClightBigstep.Out_normal
shift_wide_with_body
     : forall (s : wide_size) (right : bool),
       @eq Clight.statement (Clight.fn_body (shift_wide_with_function s right))
