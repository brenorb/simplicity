ternary1_choose =
fun k : ternary_op =>
match k return Clight.statement with
| TMaj =>
    Clight.Ssequence
      (Clight.Ssequence
         (Clight.Sifthenelse (Clight.Etempvar _x Ctypesdefs.tbool)
            (Clight.Sset _t'4 (Clight.Ecast (Clight.Etempvar _y Ctypesdefs.tbool) Ctypesdefs.tbool))
            (Clight.Sset _t'4 (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)))
         (Clight.Sifthenelse (Clight.Etempvar _t'4 Ctypesdefs.tint)
            (Clight.Sset _t'5 (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))
            (Clight.Sifthenelse (Clight.Etempvar _y Ctypesdefs.tbool)
               (Clight.Ssequence
                  (Clight.Sset _t'5 (Clight.Ecast (Clight.Etempvar _z Ctypesdefs.tbool) Ctypesdefs.tbool))
                  (Clight.Sset _t'5 (Clight.Ecast (Clight.Etempvar _t'5 Ctypesdefs.tint) Ctypesdefs.tbool)))
               (Clight.Sset _t'5 (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Ctypesdefs.tbool)))))
      (Clight.Sifthenelse (Clight.Etempvar _t'5 Ctypesdefs.tint)
         (Clight.Sset _t'6 (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))
         (Clight.Sifthenelse (Clight.Etempvar _z Ctypesdefs.tbool)
            (Clight.Ssequence (Clight.Sset _t'6 (Clight.Ecast (Clight.Etempvar _x Ctypesdefs.tbool) Ctypesdefs.tbool))
               (Clight.Sset _t'6 (Clight.Ecast (Clight.Etempvar _t'6 Ctypesdefs.tint) Ctypesdefs.tbool)))
            (Clight.Sset _t'6 (Clight.Ecast (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) Ctypesdefs.tbool))))
| TXorXor => Clight.Sskip
| TCh =>
    Clight.Sifthenelse (Clight.Etempvar _x Ctypesdefs.tbool)
      (Clight.Sset _t'4 (Clight.Ecast (Clight.Etempvar _y Ctypesdefs.tbool) Ctypesdefs.tint))
      (Clight.Sset _t'4 (Clight.Ecast (Clight.Etempvar _z Ctypesdefs.tbool) Ctypesdefs.tint))
end
