                              (@cons sx (XLv (S (S (S O))))
                                 (@cons sx (XLv (S (S (S (S O)))))
                                    (@cons sx (XLv (S (S (S (S (S O))))))
                                       (@cons sx (XLv (S (S (S (S (S (S O)))))))
                                          (@cons sx (XLv (S (S (S (S (S (S (S O)))))))) (@nil sx)))))))))) true
                  (@Some BinNums.Z
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
               (@nil region)))
eval_scalar_reduce512_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_reduce512_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_reduce_512)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (rep rho beta
                  (@cons region
                     (mkreg (u64_cells BinNums.Z0 scalar_reduce512_limbs) true
                        (@Some BinNums.Z
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (@cons region
                        (mkreg
                           (u64_cells BinNums.Z0
                              (@cons sx (XLv O)
                                 (@cons sx (XLv (S O))
                                    (@cons sx (XLv (S (S O)))
                                       (@cons sx (XLv (S (S (S O))))
                                          (@cons sx (XLv (S (S (S (S O)))))
                                             (@cons sx (XLv (S (S (S (S (S O))))))
                                                (@cons sx (XLv (S (S (S (S (S (S O)))))))
                                                   (@cons sx (XLv (S (S (S (S (S (S ...))))))) (@nil sx)))))))))) true
                           (@Some BinNums.Z
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                        (@nil region))) mf)
               (lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (foot beta
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           scalar_reduce512_initial_regs) b ofs)) m mf)))
eval_scalar_reduce512_owned_loads
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_reduce512_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_reduce_512)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                     (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (forall (i : nat) (sy : sx)
                  (_ : @eq (option sx) (@List.nth_error sx scalar_reduce512_limbs i) (@Some sx sy)),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (blk beta O)
                     (BinInt.Z.add (bas beta O)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i)))) (@Some Values.val (den rho (lay beta) sy)))
               (and (rep rho beta (sregs scalar_reduce512_state) mf)
                  (lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (foot beta
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              scalar_reduce512_initial_regs) b ofs)) m mf))))
reduce512_first_source
     : @eq Clight.statement (statement_sequence reduce512_first_spine reduce512_first_suffix)
         (Clight.fn_body jets_secp.f_secp256k1_scalar_reduce_512)
reduce512_first_boundary
     : and
         (@eq bool (statement_ends_set jets_secp._m6 (@List.last Clight.statement reduce512_first_spine Clight.Sskip))
            true)
         (and (lt O reduce512_first_count) (lt reduce512_first_count (@length Clight.statement reduce512_spine)))
reduce512_first_completes
     : @eq bool
         match reduce512_first_run return bool with
         | Some r =>
             match r return bool with
             | RDone _ o =>
                 match o return bool with
                 | ONormal => true
                 | OBreak => false
                 | OContinue => false
                 | OReturn _ => false
                 end
             | RIf _ _ _ => false
             end
         | None => false
