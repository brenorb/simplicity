                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                   (Values.Vint flag)) (@Some Memory.Mem.mem mi)),
       ClightBigstep.Clight2.exec_stmt secp_ge Clight.empty_env le m
         (Clight.Sassign
            (Clight.Efield
               (Clight.Ederef
                  (Clight.Etempvar jets_secp._r (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
                  (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)) jets_secp._infinity Ctypesdefs.tint)
            (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tint)) Events.E0 le mi ClightBigstep.Out_normal
exec_gej_read_flag_owned
     : forall (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z)
         (flag : Integers.Int.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr b (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t'1 le)
                (@Some Values.val (Values.Vint flag)))
         (_ : Memory.Mem.range_perm m b base
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt secp_ge Clight.empty_env le m
               (Clight.Sassign
                  (Clight.Efield
                     (Clight.Ederef
                        (Clight.Etempvar jets_secp._r (Ctypesdefs.tptr (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)))
                        (Ctypes.Tstruct jets_secp.__6123 Ctypes.noattr)) jets_secp._infinity Ctypesdefs.tint)
                  (Clight.Etempvar jets_secp._t'1 Ctypesdefs.tint)) Events.E0 le mi ClightBigstep.Out_normal)
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 mi b
                     (BinInt.Z.add base
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                  (@Some Values.val (Values.Vint flag)))
               (and
                  (Memory.Mem.range_perm mi b base
                     (BinInt.Z.add base
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (forall (chunk : AST.memory_chunk) (b' : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b' b))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mi b' ofs) (Memory.Mem.load chunk m b' ofs))
                     (and
                        (forall (b' : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
                         iff (Memory.Mem.perm mi b' ofs k p) (Memory.Mem.perm m b' ofs k p))
                        (forall (b' : Values.block) (_ : Memory.Mem.valid_block m b'), Memory.Mem.valid_block mi b'))))))
