eval_copyBits_aligned_short_layout
     : forall (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (cells : list Cell) (_ : frame_base_valid sbase)
         (_ : frame_fields_at m bs sbase bi edge rc) (_ : write_frame_at m bd base bw outedge cursor n)
         (_ : @eq BinNums.Z n (BinInt.Z.of_nat (@length Cell cells)))
         (_ : BinInt.Z.lt BinNums.Z0
                (BinInt.Z.modulo rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @eq BinNums.Z
