annex_elem_bytes =
fun a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl _ => @cons (Ty.tySem (Word.Word (S (S (S O))))) byte_zero (@nil (Ty.tySem (Word.Word (S (S (S O))))))
| inr h =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) byte_one
      (vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
end
     : forall _ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments annex_elem_bytes a
input_annexes_hash_spec =
fun alg : PF.Algebra =>
@elems_hash_spec (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (fun term : Alg.Assertion.Algebra => @annex_hash_spec term) (S (S (S (S (S O)))))
  (@BitcoinFull.Ext (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) BitcoinExt.InputAnnexHash) alg
     : forall alg : PF.Algebra, PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments input_annexes_hash_spec {alg}
annexes_of =
fun e : ext_environment =>
@List.map (option Digest.hash256) (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (fun o : option Digest.hash256 =>
   match o return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) with
   | Some h => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
   | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) tt
   end) (extInAnnexHash e)
     : forall _ : ext_environment, list (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))

Arguments annexes_of e
input_annexes_hash_of =
fun e : ext_environment =>
elems_hash_of (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) annex_elem_bytes
  (S (S (S (S (S O))))) (annexes_of e)
     : forall _ : ext_environment, Digest.hash256

Arguments input_annexes_hash_of e
inputs_hash_spec =
fun alg : PF.Algebra =>
let term : Alg.Assertion.Algebra := PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit (Ty.Prod sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit
        (Ty.Prod sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
           (@sha256_ctx8_init_spec core)
           (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@input_outpoints_hash_spec alg)
              (@prim_words_hash_spec (S (S O)) (S (S (S (S (S O)))))
                 (@BitcoinFull.Base (Word.Word (S (S (S (S (S O))))))
                    (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) Bitcoin.Bitcoin.InputSequence) alg)))
        (@ctx8_addn_spec (S (S (S (S (S (S O)))))) term)) (@input_annexes_hash_spec alg))
  (@jet_sha256_ctx8_init_spec.AC.comp
     (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) sha256_ctx8_type
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@ctx8_addn_spec (S (S (S (S (S O))))) term)
     (@ctx8_finalize_spec term))
     : forall alg : PF.Algebra, PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments inputs_hash_spec {alg}
inputs_hash_of =
fun e : ext_environment =>
sha256_bytes_of
  (@app (Ty.tySem (Word.Word (S (S (S O)))))
     (vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O))))))
        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 (input_outpoints_hash_of e))
           (Word.from_hash256 (words_hash_of (S (S O)) (S (S (S (S (S O))))) (input_sequences_of e)))))
     (vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) (Word.from_hash256 (input_annexes_hash_of e))))
     : forall _ : ext_environment, Digest.hash256

Arguments inputs_hash_of e
tx_hash_spec =
fun alg : PF.Algebra =>
let term : Alg.Assertion.Algebra := PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit (Ty.Prod sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit
        (Ty.Prod sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
        sha256_ctx8_type core
        (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
           (@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit
              (Ty.Prod sha256_ctx8_type (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))))
              sha256_ctx8_type core
              (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit sha256_ctx8_type
                 (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) core
                 (@sha256_ctx8_init_spec core)
                 (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S O))))))
                    (Word.Word (S (S (S (S (S O)))))) core
                    (@PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
                       (@BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.Version))
                    (@PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
                       (@BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.LockTime))))
              (@ctx8_addn_spec (S (S (S O))) term))
           (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@inputs_hash_spec alg) (@outputs_hash_spec alg)))
        (@ctx8_addn_spec (S (S (S (S (S (S O)))))) term)) (@input_utxos_hash_spec alg))
  (@jet_sha256_ctx8_init_spec.AC.comp
     (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) sha256_ctx8_type
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@ctx8_addn_spec (S (S (S (S (S O))))) term)
     (@ctx8_finalize_spec term))
     : forall alg : PF.Algebra, PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments tx_hash_spec {alg}
tx_version_word =
fun e : ext_environment =>
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
  (Integers.Int.signed (Bitcoin.sigTxVersion (Bitcoin.Bitcoin.envTx (extBase e))))
     : forall _ : ext_environment, Ty.tySem (Word.Word (S (S (S (S (S O))))))

Arguments tx_version_word e
tx_locktime_word =
fun e : ext_environment =>
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
  (Integers.Int.unsigned (Bitcoin.sigTxLock (Bitcoin.Bitcoin.envTx (extBase e))))
     : forall _ : ext_environment, Ty.tySem (Word.Word (S (S (S (S (S O))))))

Arguments tx_locktime_word e
tx_hash_of =
fun e : ext_environment =>
sha256_bytes_of
  (@app (Ty.tySem (Word.Word (S (S (S O)))))
     (vector_values (Word.Word (S (S (S O)))) (S (S (S O)))
        (@pair (Ty.tySem (Word.Word (S (S (S (S (S O))))))) (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
           (tx_version_word e) (tx_locktime_word e)))
     (@app (Ty.tySem (Word.Word (S (S (S O)))))
        (vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S (S O))))))
           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 (inputs_hash_of e))
              (Word.from_hash256 (outputs_hash_of e))))
        (vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) (Word.from_hash256 (input_utxos_hash_of e)))))
     : forall _ : ext_environment, Digest.hash256

Arguments tx_hash_of e
assert_spec =
fun (term : Alg.Assertion.Algebra) (A B : Ty.Ty) (t : Alg.Assertion.domain term A (Ty.Sum Ty.Unit B)) =>
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp A (Ty.Prod (Ty.Sum Ty.Unit B) Ty.Unit) B core
  (@jet_sha256_ctx8_init_spec.AC.pair A (Ty.Sum Ty.Unit B) Ty.Unit core t (@jet_sha256_ctx8_init_spec.AC.unit A core))
  (@Alg.Assertion.Combinators.assertr Ty.Unit B Ty.Unit B term assertion_cmr_fail0
     (@jet_sha256_ctx8_init_spec.AC.take B Ty.Unit B core (@jet_sha256_ctx8_init_spec.AC.iden B core)))
     : forall (term : Alg.Assertion.Algebra) (A B : Ty.Ty) (_ : Alg.Assertion.domain term A (Ty.Sum Ty.Unit B)),
       Alg.Assertion.domain term A B

Arguments assert_spec {term} {A B}%ty_scope t
assert_iden_spec =
fun (B : Ty.Ty) (term : Alg.Assertion.Algebra) =>
@assert_spec term (Ty.Sum Ty.Unit B) B
  (@jet_sha256_ctx8_init_spec.AC.iden (Ty.Sum Ty.Unit B) (Alg.Assertion.toCore term))
     : forall (B : Ty.Ty) (term : Alg.Assertion.Algebra), Alg.Assertion.domain term (Ty.Sum Ty.Unit B) B

Arguments assert_iden_spec B%ty_scope {term}
vh_hash_spec =
fun (pv : BitcoinFull.t (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
  (ph : BitcoinFull.t (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (alg : PF.Algebra) =>
let term : Alg.Assertion.Algebra := PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_sha256_ctx8_init_spec.AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@jet_sha256_ctx8_init_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@PF.Combinators.prim (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) alg
        pv)
     (@PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg ph))
  (@jet_sha256_ctx8_init_spec.AC.case Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_sha256_ctx8_init_spec.AC.injl
        (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_sha256_ctx8_init_spec.AC.unit
           (Ty.Prod Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core))
     (@jet_sha256_ctx8_init_spec.AC.injr
        (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_sha256_ctx8_init_spec.AC.comp
           (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (Ty.Prod sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
           (@jet_sha256_ctx8_init_spec.AC.pair
              (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) sha256_ctx8_type
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
              (@jet_sha256_ctx8_init_spec.AC.comp
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                    (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                 (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))) sha256_ctx8_type core
                 (@jet_sha256_ctx8_init_spec.AC.pair
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) sha256_ctx8_type
                    (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O)))) core
                    (@jet_sha256_ctx8_init_spec.AC.comp
                       (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                          (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) Ty.Unit sha256_ctx8_type core
                       (@jet_sha256_ctx8_init_spec.AC.unit
                          (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                             (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core)
                       (@sha256_ctx8_init_spec core))
                    (@jet_sha256_ctx8_init_spec.AC.take (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                       (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O)))) core
                       (@jet_sha256_ctx8_init_spec.AC.iden (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O)))) core)))
                 (@ctx8_addn_spec (S (S (S O))) term))
              (@jet_sha256_ctx8_init_spec.AC.drop (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O))))
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
                 (@assert_iden_spec (Word.Word (S (S (S (S (S (S (S (S O))))))))) term)))
           (@jet_sha256_ctx8_init_spec.AC.comp
              (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))) sha256_ctx8_type
              (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@ctx8_addn_spec (S (S (S (S (S O))))) term)
              (@ctx8_finalize_spec term)))))
     : forall
         (_ : BitcoinFull.t (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
         (_ : BitcoinFull.t (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) (alg : PF.Algebra),
       PF.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments vh_hash_spec pv ph {alg}
vh_bytes =
fun (v : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
=>
@app (Ty.tySem (Word.Word (S (S (S O))))) (vector_values (Word.Word (S (S (S O)))) (S (S (S O))) v)
  (vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments vh_bytes v h
prim_words_hash_spec =
fun (k w : nat) (p : BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
  (alg : PF.Algebra) =>
let term : Alg.Assertion.Algebra := PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@hash_words_spec k w term Ty.Unit
  (@jet_buffer_empty_spec.AC.drop Ty.Unit (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) core
     (@PF.Combinators.prim (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) alg p))
     : forall (k w : nat) (_ : BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (alg : PF.Algebra), PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments prim_words_hash_spec (k w)%nat_scope p {alg}
words_hash_of =
fun (k w : nat) (xs : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))) =>
hash_words_of k (@List.firstn (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (BinInt.Z.to_nat (wsize w)) xs)
     : forall (k _ : nat) (_ : list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))), Digest.hash256

Arguments words_hash_of (k w)%nat_scope xs%list_scope
