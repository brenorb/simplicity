                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint x))), Clight.eval_expr sha_ge e le m (cmp_elem p i) (Values.Vint x)
cmp_blk_exec
     : forall (m : Memory.Mem.mem) (ba bb : Values.block) (oa ob : Integers.Ptrofs.int)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (e : Clight.env) (le : Maps.PTree.tree Values.val)
         (i : BinNums.Z) (ta tb tc td tr : AST.ident) (x y : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._a le)
                (@Some Values.val (Values.Vptr ba oa)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._b le)
                (@Some Values.val (Values.Vptr bb ob))) (_ : not (@eq AST.ident ta jets_sha._a))
         (_ : not (@eq AST.ident ta jets_sha._b)) (_ : not (@eq AST.ident tb jets_sha._a))
         (_ : not (@eq AST.ident tb jets_sha._b)) (_ : not (@eq AST.ident ta tb))
         (_ : not (@eq AST.ident tc jets_sha._a)) (_ : not (@eq AST.ident tc jets_sha._b))
         (_ : not (@eq AST.ident td jets_sha._a)) (_ : not (@eq AST.ident td jets_sha._b))
         (_ : not (@eq AST.ident tc td))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint x)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bb
                   (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint y))),
       and
         (forall _ : @eq Integers.Int.int x y,
          ClightBigstep.Clight2.exec_stmt sha_ge e le m (cmp_blk i ta tb tc td tr) Events.E0
            (@Maps.PTree.set Values.val tb (Values.Vint y) (@Maps.PTree.set Values.val ta (Values.Vint x) le)) m
            ClightBigstep.Out_normal)
         (forall _ : not (@eq Integers.Int.int x y),
          @ex Clight.temp_env
            (fun le' : Clight.temp_env =>
             ClightBigstep.Clight2.exec_stmt sha_ge e le m (cmp_blk i ta tb tc td tr) Events.E0 le' m
               (ClightBigstep.Out_return
                  (@Some (prod Values.val Ctypes.type)
                     (@pair Values.val Ctypes.type (Values.Vint (cmp_res x y)) Ctypesdefs.tint)))))
cmp_seq_step
     : forall (m : Memory.Mem.mem) (ba bb : Values.block) (oa ob : Integers.Ptrofs.int)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (e : Clight.env) (le : Clight.temp_env) (i : BinNums.Z)
         (ta tb tc td tr : AST.ident) (rest : Clight.statement) (x y : Integers.Int.int)
         (xs ys : list Integers.Int.int) (_ : cmp_good ba bb oa ob le) (_ : not (@eq AST.ident ta jets_sha._a))
         (_ : not (@eq AST.ident ta jets_sha._b)) (_ : not (@eq AST.ident tb jets_sha._a))
         (_ : not (@eq AST.ident tb jets_sha._b)) (_ : not (@eq AST.ident ta tb))
         (_ : not (@eq AST.ident tc jets_sha._a)) (_ : not (@eq AST.ident tc jets_sha._b))
         (_ : not (@eq AST.ident td jets_sha._a)) (_ : not (@eq AST.ident td jets_sha._b))
         (_ : not (@eq AST.ident tc td))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint x)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bb
                   (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)))
                (@Some Values.val (Values.Vint y)))
         (_ : forall (le' : Clight.temp_env) (_ : cmp_good ba bb oa ob le'),
              @ex Clight.temp_env
                (fun le'' : Clight.temp_env =>
                 ClightBigstep.Clight2.exec_stmt sha_ge e le' m rest Events.E0 le'' m
                   (ClightBigstep.Out_return
                      (@Some (prod Values.val Ctypes.type)
                         (@pair Values.val Ctypes.type (Values.Vint (cmp_model xs ys)) Ctypesdefs.tint))))),
       @ex Clight.temp_env
         (fun le'' : Clight.temp_env =>
          ClightBigstep.Clight2.exec_stmt sha_ge e le m (Clight.Ssequence (cmp_blk i ta tb tc td tr) rest) Events.E0
            le'' m
            (ClightBigstep.Out_return
               (@Some (prod Values.val Ctypes.type)
                  (@pair Values.val Ctypes.type
                     (Values.Vint (cmp_model (@cons Integers.Int.int x xs) (@cons Integers.Int.int y ys)))
                     Ctypesdefs.tint))))
eval_sha256_cmp_be
     : forall (m : Memory.Mem.mem) (ba bb : Values.block) (oa ob : Integers.Ptrofs.int)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (xs ys : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int xs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq nat (@length Integers.Int.int ys) (S (S (S (S (S (S (S (S O)))))))))
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j xs Integers.Int.zero))))
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bb
                   (BinInt.Z.add (Integers.Ptrofs.unsigned ob)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j ys Integers.Int.zero)))),
       ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_sha256_cmp_be)
         (@cons Values.val (Values.Vptr ba oa) (@cons Values.val (Values.Vptr bb ob) (@nil Values.val))) Events.E0 m
         (Values.Vint (cmp_model xs ys))
be_val_range
     : forall ws : list (Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       and (BinInt.Z.le BinNums.Z0 (be_val ws))
         (BinInt.Z.lt (be_val ws)
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) ws)))))
be_val_app
     : forall xs ys : list (Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq BinNums.Z (be_val (@app (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs ys))
         (BinInt.Z.add
            (BinInt.Z.mul (be_val xs)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinInt.Z.mul
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) ys)))))
            (be_val ys))
be_val_chunks
     : forall (n : nat) (x : Ty.tySem (Word.Word (Nat.add n (S (S (S (S (S O)))))))),
       @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (Nat.add n (S (S (S (S (S O))))))) x)
         (be_val (word32_chunks n x))
cmp_model_words
     : forall (xs ys : list (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
         (_ : @eq nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xs)
                (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) ys)),
       @eq bool
         (Integers.Int.lt
            (cmp_model (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value xs)
               (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value ys))
            Integers.Int.zero) (BinInt.Z.ltb (be_val xs) (be_val ys))
cmp_model_lt
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq bool (Integers.Int.lt (cmp_model (state_regs a) (state_regs b)) Integers.Int.zero)
         (BinInt.Z.ltb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b))
mext_refl
     : forall m : Memory.Mem.mem, mext m m
mext_trans
     : forall (m1 m2 m3 : Memory.Mem.mem) (_ : mext m1 m2) (_ : mext m2 m3), mext m1 m3
mext_alloc
     : forall (m : Memory.Mem.mem) (lo hi : BinNums.Z) (m' : Memory.Mem.mem') (b : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m lo hi)
                (@pair Memory.Mem.mem' Values.block m' b)), mext m m'
alloc4_access
     : forall (m : Memory.Mem.mem) (m' : Memory.Mem.mem') (b : Values.block)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                (@pair Memory.Mem.mem' Values.block m' b)),
       and (Memory.Mem.valid_access m' AST.Mint32 b BinNums.Z0 Memtype.Freeable)
         (and (not (Memory.Mem.valid_block m b))
            (and (Memory.Mem.valid_block m' b)
               (Memory.Mem.range_perm m' b BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) Memtype.Cur
                  Memtype.Freeable)))
free_list_blocks
     : forall (l : list (prod (prod Values.block BinNums.Z) BinNums.Z)) (m : Memory.Mem.mem)
         (_ : forall (b : Values.block) (lo hi : BinNums.Z)
                (_ : @List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                       (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z b lo) hi) l),
              Memory.Mem.range_perm m b lo hi Memtype.Cur Memtype.Freeable)
         (_ : @List.NoDup Values.block
                (@List.map (prod (prod Values.block BinNums.Z) BinNums.Z) Values.block
                   (fun x : prod (prod Values.block BinNums.Z) BinNums.Z =>
                    @fst Values.block BinNums.Z (@fst (prod Values.block BinNums.Z) BinNums.Z x)) l)),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and (@eq (option Memory.Mem.mem) (Memory.Mem.free_list m l) (@Some Memory.Mem.mem m'))
            (and
               (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                  (_ : not
                         (@List.In Values.block b
                            (@List.map (prod (prod Values.block BinNums.Z) BinNums.Z) Values.block
                               (fun x : prod (prod Values.block BinNums.Z) BinNums.Z =>
                                @fst Values.block BinNums.Z (@fst (prod Values.block BinNums.Z) BinNums.Z x)) l))),
                @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
               (and
                  (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                     (_ : not
                            (@List.In Values.block b
                               (@List.map (prod (prod Values.block BinNums.Z) BinNums.Z) Values.block
                                  (fun x : prod (prod Values.block BinNums.Z) BinNums.Z =>
                                   @fst Values.block BinNums.Z (@fst (prod Values.block BinNums.Z) BinNums.Z x)) l)))
                     (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                  (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b))))
eval_sha_compression
     : forall (m : Memory.Mem.mem) (bs : Values.block) (os : Integers.Ptrofs.int) (bc : Values.block)
         (oc : Integers.Ptrofs.int) (regs blk : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq nat (@length Integers.Int.int blk) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : or (not (@eq Values.block bs bc))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (Integers.Ptrofs.unsigned oc))
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (Integers.Ptrofs.unsigned os))))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
              and
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint32 m bs
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                   (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
                (Memory.Mem.valid_access m AST.Mint32 bs
                   (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                   Memtype.Writable))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bc
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i blk Integers.Int.zero)))),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall sha_ge m
               (@Ctypes.Internal Clight.function jets_sha.f_sha256_compression_portable)
               (@cons Values.val (Values.Vptr bs os) (@cons Values.val (Values.Vptr bc oc) (@nil Values.val)))
               Events.E0 m' Values.Vundef)
            (and
               (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint32 m' bs
                     (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                  (@Some Values.val
                     (Values.Vint (@List.nth Integers.Int.int i (SHA256.hash_block regs blk) Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : or (not (@eq Values.block b bs))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) (Integers.Ptrofs.unsigned os))
                               (BinInt.Z.le
                                  (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
interp_spine_run
     : forall (fuel : nat) (s : Clight.statement) (st : cst),
       @eq (option cst) (interp_spine fuel s st) (run (split_spine fuel s) st)
run_app
     : forall (l1 l2 : list Clight.statement) (st : cst),
       @eq (option cst) (run (@app Clight.statement l1 l2) st)
         match run l1 st return (option cst) with
         | Some st1 => run l2 st1
         | None => @None cst
         end
body_elems_eq
     : @eq (list Clight.statement)
         (split_spine (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
            (Clight.fn_body jets_sha.f_sha256_compression_portable)) body_elems
int_eq_true_eq
     : forall (a b : Integers.Int.int) (_ : @eq bool (Integers.Int.eq a b) true), @eq Integers.Int.int a b
int_mul_one'
     : forall (o x : Integers.Int.int) (_ : @eq bool (Integers.Int.eq o Integers.Int.one) true),
       @eq Integers.Int.int (Integers.Int.mul o x) x
rnd_function_c
     : forall (x0 x1 x2 x3 x4 x5 x6 x7 Kc K W wt : Integers.Int.int) (_ : @eq bool (Integers.Int.eq Kc K) true)
         (_ : @eq Integers.Int.int wt W),
       @eq SHA256.registers
         (SHA256.rnd_function
            (@cons Integers.Int.int x0
               (@cons Integers.Int.int x1
                  (@cons Integers.Int.int x2
                     (@cons Integers.Int.int x3
                        (@cons Integers.Int.int x4
                           (@cons Integers.Int.int x5
                              (@cons Integers.Int.int x6 (@cons Integers.Int.int x7 (@nil Integers.Int.int))))))))) K W)
         (@cons Integers.Int.int (Integers.Int.add (c_T1 x7 x4 x5 x6 (Integers.Int.add Kc wt)) (c_T2 x0 x1 x2))
            (@cons Integers.Int.int x0
               (@cons Integers.Int.int x1
                  (@cons Integers.Int.int x2
                     (@cons Integers.Int.int (Integers.Int.add x3 (c_T1 x7 x4 x5 x6 (Integers.Int.add Kc wt)))
                        (@cons Integers.Int.int x4
                           (@cons Integers.Int.int x5 (@cons Integers.Int.int x6 (@nil Integers.Int.int)))))))))
W_first
     : forall (c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 : Integers.Int.int) (t : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 t)
                (BinInt.Z.lt t (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))),
       @eq Integers.Int.int (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15) t)
         (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 t)
W_step
     : forall (c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 : Integers.Int.int) (t : BinNums.Z)
         (wa wb wc wd one : Integers.Int.int)
         (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) t)
         (_ : @eq Integers.Int.int wa
                (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)
                   (BinInt.Z.sub t (BinNums.Zpos (BinNums.xO BinNums.xH)))))
         (_ : @eq Integers.Int.int wb
                (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)
                   (BinInt.Z.sub t (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))))))
         (_ : @eq Integers.Int.int wc
                (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)
                   (BinInt.Z.sub t (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
         (_ : @eq Integers.Int.int wd
                (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15)
                   (BinInt.Z.sub t (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq bool (Integers.Int.eq one Integers.Int.one) true),
       @eq Integers.Int.int
         (Integers.Int.add (Integers.Int.add (Integers.Int.add (Integers.Int.mul one wd) (c_sigma1 wa)) wb)
            (c_sigma0 wc)) (SHA256.W (M c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15) t)
