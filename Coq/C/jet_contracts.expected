increment64_values_denote_input
     : forall (r : Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) x)),
