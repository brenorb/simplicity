invA =
fun (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
  (bi : Values.block) (rc : BinNums.Z) (w0 : bool) (outs0 : list Cell) (capA : BinNums.Z)
  (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m : Memory.Mem.mem) =>
and (@eq Integers.Int64.int (ρ O) (Integers.Int64.repr rc))
  (and (finv m0 bd dbase bw outedge cursor N bi m (orb w0 (has_wr log)) (@app Cell outs0 (outsA ρ log)))
     (and (BinInt.Z.le (BinInt.Z.add (BinInt.Z.of_nat (@length Cell outs0)) capA) N) (BinInt.Z.le (written log) capA)))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : bool) (_ : list Cell)
         (_ : BinNums.Z) (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop

Arguments invA m0 bd dbase%Z_scope bw (outedge cursor N)%Z_scope bi rc%Z_scope w0%bool_scope
  outs0%list_scope capA%Z_scope ρ%function_scope log%list_scope m
orc_rd8 =
fun (w0 : bool) (nin : BinNums.Z) (base : nat) (log : list event) (xs : list sx) (regs : list region) =>
match xs return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
| nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
| cons x1 l =>
    match l return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
    | nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
    | cons xn l0 =>
        match l0 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
        | nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
        | cons x3 l1 =>
            match l1 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
            | nil =>
                match
                  as_xp0 x1 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                with
                | Some rb =>
                    match
                      xconst xn return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                    with
                    | Some n =>
                        match
                          as_xp0 x3
                          return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                        with
                        | Some rs =>
                            match
                              @List.nth_error region regs rb
                              return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                            with
                            | Some regb =>
                                match
                                  @List.nth_error region regs rs
                                  return
                                    (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                                with
                                | Some regS =>
                                    match
                                      frame_cells regS
                                      return
                                        (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                                    with
                                    | Some p =>
                                        match
                                          p
                                          return
                                            (option
                                               (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                                        with
                                        | pair xp kc =>
                                            match
                                              andb
                                                (andb
                                                   (andb
                                                      (andb
                                                         (andb
                                                            (andb
                                                               (andb (andb (negb w0) (negb (has_wr log)))
                                                                  (BinInt.Z.ltb BinNums.Z0 n))
                                                               (BinInt.Z.leb
                                                                  (BinInt.Z.add (Integers.Int64.unsigned kc)
                                                                     (BinInt.Z.mul (BinNums.Zpos ...) n)) nin))
                                                            (negb (PeanoNat.Nat.eqb rb rs)))
                                                         (rw regb)) (rw regS))
                                                   (shape_eqb
                                                      (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape
                                                         (rcells regb))
                                                      (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape
                                                         (byte_undef BinNums.Z0 (BinInt.Z.to_nat n)))))
                                                match rfree regb return bool with
                                                | Some _ => true
                                                | None => false
                                                end
                                              return
                                                (option
                                                   (prod (prod (prod (prod (list region) (option sx)) nat) nat)
                                                      (list sx)))
                                            with
                                            | true =>
                                                @Some
                                                  (prod (prod (prod (prod (list region) (option sx)) nat) nat)
                                                     (list sx))
                                                  (@pair (prod (prod (prod (list region) (option sx)) nat) nat)
                                                     (list sx)
                                                     (@pair (prod (prod (list region) (option sx)) nat) nat
                                                        (@pair (prod (list region) (option sx)) nat
                                                           (@pair (list region) (option sx)
                                                              (@upd region
                                                                 (@upd region regs rb
                                                                    (mkreg
                                                                       (byte_cells BinNums.Z0 (BinInt.Z.to_nat n) base)
                                                                       (rw regb) (rfree regb))) rs
                                                                 (mkreg
                                                                    (mk_frame_cells xp
                                                                       (Integers.Int64.repr
                                                                          (BinInt.Z.add (Integers.Int64.unsigned kc)
                                                                             (BinInt.Z.mul ... n))))
                                                                    (rw regS) (rfree regS)))
                                                              (@None sx)) tRD8) (BinInt.Z.to_nat n))
                                                     (@cons sx xp
                                                        (@cons sx (XLc kc)
                                                           (@cons sx (XLc (Integers.Int64.repr n)) (@nil sx)))))
                                            | false =>
                                                @None
                                                  (prod (prod (prod (prod (list region) (option sx)) nat) nat)
                                                     (list sx))
                                            end
                                        end
                                    | None =>
                                        @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                                    end
                                | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                                end
                            | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                            end
                        | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                        end
                    | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                    end
                | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                end
            | cons _ _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            end
        end
    end
end
     : forall (_ : bool) (_ : BinNums.Z), oracle

Arguments orc_rd8 w0%bool_scope nin%Z_scope _ _ _ _
cell_sx =
fun c : cell => match cval c return sx with
                | Some x => x
                | None => XIc Integers.Int.zero
                end
     : forall _ : cell, sx

Arguments cell_sx c
cell_KI =
fun c : cell => match cval c return bool with
                | Some x => isk KI x
                | None => false
                end
     : forall _ : cell, bool

Arguments cell_KI c
orc_wr8 =
fun (capA : BinNums.Z) (_ : nat) (log : list event) (xs : list sx) (regs : list region) =>
match xs return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
| nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
| cons xd l =>
    match l return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
    | nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
    | cons x2 l0 =>
        match l0 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
        | nil => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
        | cons xn l1 =>
            match l1 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))) with
            | nil =>
                match
                  as_xp0 x2 return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                with
                | Some rb =>
                    match
                      xconst xn return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                    with
                    | Some n =>
                        match
                          @List.nth_error region regs rb
                          return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                        with
                        | Some regb =>
                            match
                              andb
                                (andb
                                   (andb (andb (isk KA xd) (BinInt.Z.ltb BinNums.Z0 n))
                                      (shape_eqb
                                         (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape (rcells regb))
                                         (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape
                                            (byte_undef BinNums.Z0 (BinInt.Z.to_nat n)))))
                                   (@List.forallb cell cell_KI (rcells regb)))
                                (BinInt.Z.leb
                                   (BinInt.Z.add (written log)
                                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) n))
                                   capA)
                              return (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
                            with
                            | true =>
                                @Some (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                                  (@pair (prod (prod (prod (list region) (option sx)) nat) nat)
                                     (list sx)
                                     (@pair (prod (prod (list region) (option sx)) nat) nat
                                        (@pair (prod (list region) (option sx)) nat
                                           (@pair (list region) (option sx) regs (@None sx)) tWR8) O)
                                     (@cons sx xd (@List.map cell sx cell_sx (rcells regb))))
                            | false => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                            end
                        | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                        end
                    | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                    end
                | None => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
                end
            | cons _ _ => @None (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            end
        end
    end
end
     : forall _ : BinNums.Z, oracle

Arguments orc_wr8 capA%Z_scope _ _ _ _
secp_ge = Clight.globalenv jets_secp.prog
     : Clight.genv
secp_symbol_block =
