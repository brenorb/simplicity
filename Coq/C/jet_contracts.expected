exec_copy_tail_partial_cross
     : forall (le : Maps.PTree.tree Values.val) (m mc ml mf : Memory.Mem.mem) (bi : Values.block)
         (src_ofs : Integers.Ptrofs.int) (bw : Values.block) (dst_ofs : Integers.Ptrofs.int)
         (ss ds n : BinNums.Z) (old source next : Integers.Int64.int)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (and (BinInt.Z.lt ss ds)
                   (BinInt.Z.le ds
                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.lt ss n) (BinInt.Z.le n ds))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src_ptr le)
                (@Some Values.val (Values.Vptr bi src_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst_ptr le)
                (@Some Values.val (Values.Vptr bw dst_ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ss))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst_shift le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr ds))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _n le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr n))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs))
                (@Some Values.val (Values.Vlong old)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (jet_word_bits.clear_low ds old))) (@Some Memory.Mem.mem mc))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 mc bi (Integers.Ptrofs.unsigned src_ofs))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mc bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (copy_left_value ss ds old source))) (@Some Memory.Mem.mem ml))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 ml bi
                   (Integers.Ptrofs.unsigned
                      (Integers.Ptrofs.sub src_ofs
                         (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (@Some Values.val (Values.Vlong next)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 ml bw (Integers.Ptrofs.unsigned dst_ofs)
                   (Values.Vlong (copy_partial_cross_value ss ds old source next))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt ge0 Clight.empty_env le m copy_helper_tail Events.E0
         (copy_partial_cross_env le bi src_ofs ss ds n old source next) mf
         (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type)))
eval_copy_helper_partial_cross
     : forall (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (old source next : Integers.Int64.int) (_ : frame_base_valid sbase)
         (_ : frame_base_valid base) (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : frame_fields_at m bd base bw outedge cursor)
         (_ : and (BinInt.Z.le BinNums.Z0 rc) (BinInt.Z.le rc Integers.Int64.max_unsigned))
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) cursor) (BinInt.Z.le cursor Integers.Int64.max_unsigned))
         (_ : and
                (BinInt.Z.le
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                         (BinInt.Z.div rc
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                   edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned)) (_ : BinInt.Z.le BinNums.Z0 outedge)
         (_ : BinInt.Z.le (jet_write_layout.write_word_address outedge cursor) Integers.Ptrofs.max_unsigned)
         (_ : and
                (BinInt.Z.lt
                   (BinInt.Z.sub
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (BinInt.Z.modulo rc
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                   n)
                (BinInt.Z.le n
                   (BinInt.Z.modulo cursor
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : not (@eq Values.block bd bw))
         (_ : or (not (@eq Values.block bi bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add
                         (BinInt.Z.sub edge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                  (BinInt.Z.div rc
                                     (BinNums.Zpos
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (jet_write_layout.write_word_address outedge cursor))
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.sub edge
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                               (BinInt.Z.div rc
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
         (_ : or (not (@eq Values.block bi bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add
                         (BinInt.Z.sub edge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                                  (BinInt.Z.div rc
                                     (BinNums.Zpos
                                        (BinNums.xO
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (jet_write_layout.write_word_address outedge cursor))
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (BinInt.Z.sub edge
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                               (BinInt.Z.div rc
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                            (BinInt.Z.div rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong source)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bi
                   (BinInt.Z.sub edge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                            (BinInt.Z.div rc
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                (@Some Values.val (Values.Vlong next)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address outedge cursor))
                (@Some Values.val (Values.Vlong old)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bw (jet_write_layout.write_word_address outedge cursor)
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_copyBitsHelper)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf bw (jet_write_layout.write_word_address outedge cursor))
                  (@Some Values.val
                     (Values.Vlong
                        (copy_partial_cross_value
                           (BinInt.Z.sub
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              (BinInt.Z.modulo rc
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                           (BinInt.Z.modulo cursor
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) old
                           source next))))
               (and (frame_fields_at mf bd base bw outedge cursor)
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (jet_write_layout.write_word_address outedge cursor))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
copy_partial_cross_value_bits
     : forall (ss ds : BinNums.Z) (old source next : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (and (BinInt.Z.lt ss ds)
                   (BinInt.Z.le ds
                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.lt i
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq bool (Integers.Int64.testbit (copy_partial_cross_value ss ds old source next) i)
         match Coqlib.zlt i (BinInt.Z.sub ds ss) return bool with
         | left _ =>
             Integers.Int64.testbit next
               (BinInt.Z.add i
                  (BinInt.Z.sub
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (BinInt.Z.sub ds ss)))
         | right _ =>
             match Coqlib.zlt i ds return bool with
             | left _ => Integers.Int64.testbit source (BinInt.Z.sub i (BinInt.Z.sub ds ss))
             | right _ => Integers.Int64.testbit old i
             end
         end
copy_partial_cross_copied_bit
     : forall (ss ds n : BinNums.Z) (old source next : Integers.Int64.int) (j : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (and (BinInt.Z.lt ss ds)
                   (BinInt.Z.le ds
                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.lt ss n) (BinInt.Z.le n ds)) (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.lt j n)),
       @eq bool
         (Integers.Int64.testbit (copy_partial_cross_value ss ds old source next)
            (BinInt.Z.sub (BinInt.Z.sub ds (BinNums.Zpos BinNums.xH)) j))
         match Coqlib.zlt j ss return bool with
         | left _ => Integers.Int64.testbit source (BinInt.Z.sub (BinInt.Z.sub ss (BinNums.Zpos BinNums.xH)) j)
         | right _ =>
             Integers.Int64.testbit next
               (BinInt.Z.sub (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                  (BinInt.Z.sub j ss))
         end
copy_partial_cross_existing_bit
     : forall (ss ds : BinNums.Z) (old source next : Integers.Int64.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) ss)
                (and (BinInt.Z.lt ss ds)
                   (BinInt.Z.le ds
                      (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
         (_ : and (BinInt.Z.le ds i)
                (BinInt.Z.lt i
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq bool (Integers.Int64.testbit (copy_partial_cross_value ss ds old source next) i)
         (Integers.Int64.testbit old i)
copy_partial_cross_output_bit
     : forall (m mf : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block)
         (outedge cursor n : BinNums.Z) (old source next : Integers.Int64.int) (j : BinNums.Z)
         (bit : bool)
         (_ : and
                (BinInt.Z.lt
                   (BinInt.Z.sub
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (BinInt.Z.modulo rc
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                   n)
