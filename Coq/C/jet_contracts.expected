scalar_reduce512_owned_metadata
     : and (@eq nat (@length region (sregs scalar_reduce512_state)) (S (S O)))
         (and
            (@eq (option region) (@List.nth_error region (sregs scalar_reduce512_state) (S O))
               (@Some region
                  (mkreg
                     (u64_cells BinNums.Z0
                        (@cons sx (XLv O)
                           (@cons sx (XLv (S O))
                              (@cons sx (XLv (S (S O)))
                                 (@cons sx (XLv (S (S (S O))))
                                    (@cons sx (XLv (S (S (S (S O)))))
                                       (@cons sx (XLv (S (S (S (S (S O))))))
                                          (@cons sx (XLv (S (S (S (S (S (S O)))))))
                                             (@cons sx (XLv (S (S (S (S (S (S (S O)))))))) (@nil sx)))))))))) true
                     (@Some BinNums.Z
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
            (and
               (@eq bool
                  (rw (@List.hd region (mkreg (@nil cell) false (@None BinNums.Z)) (sregs scalar_reduce512_state)))
                  true)
               (and
                  (@eq (option BinNums.Z)
                     (rfree
                        (@List.hd region (mkreg (@nil cell) false (@None BinNums.Z)) (sregs scalar_reduce512_state)))
                     (@Some BinNums.Z
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (@eq bool
                     (initialized_u64_cells BinNums.Z0
                        (rcells
                           (@List.hd region (mkreg (@nil cell) false (@None BinNums.Z)) (sregs scalar_reduce512_state))))
                     true))))
scalar_reduce512_output
     : @eq (list region) (sregs scalar_reduce512_state)
         (@cons region
