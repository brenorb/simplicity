fun a b c d : Values.block =>
and (not (@eq Values.block a b))
  (and (not (@eq Values.block a c))
     (and (not (@eq Values.block a d))
        (and (not (@eq Values.block b c)) (and (not (@eq Values.block b d)) (not (@eq Values.block c d))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Prop

Arguments four_local_distinct a b c d
four_local_permissions =
fun (m : Memory.Mem.mem) (a : Values.block) (na : BinNums.Z) (b : Values.block) (nb : BinNums.Z)
  (c : Values.block) (nc : BinNums.Z) (d : Values.block) (nd : BinNums.Z) =>
and (Memory.Mem.range_perm m a BinNums.Z0 na Memtype.Cur Memtype.Freeable)
  (and (Memory.Mem.range_perm m b BinNums.Z0 nb Memtype.Cur Memtype.Freeable)
     (and (Memory.Mem.range_perm m c BinNums.Z0 nc Memtype.Cur Memtype.Freeable)
        (Memory.Mem.range_perm m d BinNums.Z0 nd Memtype.Cur Memtype.Freeable)))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments four_local_permissions m a na%Z_scope b nb%Z_scope c nc%Z_scope d nd%Z_scope
ctx_init_env =
fun bl bi bc br : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) __res
  (@pair Values.block Ctypes.type br (Ctypes.Tstruct _sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) _ctx
     (@pair Values.block Ctypes.type bc (Ctypes.Tstruct _sha256_context Ctypes.noattr)) (sha256_iv_jet_env bl bi))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block),
       Maps.PTree.tree (prod Values.block Ctypes.type)

Arguments ctx_init_env bl bi bc br
ctx_init_temps =
fun (env : Values.val) (bf : Values.block) (base : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
jet_arith8_layout_exec.le_arith8_layout env f_simplicity_sha_256_ctx_8_init bf (Integers.Ptrofs.repr base) bs
  (Integers.Ptrofs.repr sbase)
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments ctx_init_temps env bf base%Z_scope bs sbase%Z_scope
sha256_ctx8_init_guarantees =
jet_local_spec_guarantees f_simplicity_sha_256_ctx_8_init Ty.Unit sha256_ctx8_type
  (fun a : Ty.tySem Ty.Unit => @sha256_ctx8_init_spec Alg.CoreFunSem a) sha256_ctx8_init_local_spec
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem Ty.Unit) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize Ty.Unit))) Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor (@encode Ty.Unit a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize sha256_ctx8_type))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function f_simplicity_sha_256_ctx_8_init)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode sha256_ctx8_type ((fun a0 : Ty.tySem Ty.Unit => @sha256_ctx8_init_spec Alg.CoreFunSem a0) a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize sha256_ctx8_type))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize sha256_ctx8_type)))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))

Arguments sha256_ctx8_init_guarantees env m bd dbase%Z_scope bs sbase%Z_scope bi bw
  (edge outedge cursor read_cursor)%Z_scope a _ _ _ _ _ _ _
sha256_ctx8_init_context_guarantees =
@jet_context_guarantees Ty.Unit sha256_ctx8_type f_simplicity_sha_256_ctx_8_init (@sha256_ctx8_init_spec)
  sha256_ctx8_init_spec_parametric sha256_ctx8_init_local_spec
  (ZifyClasses.rew_iff_rev
     (le (S O) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
     (BinInt.Z.le (BinNums.Zpos BinNums.xH)
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
     (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
        (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH))
        (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))
        (BinNums.Zpos
           (BinNums.xO
              (BinNums.xI
                 (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
        (@eq_refl BinNums.Z
           (BinNums.Zpos
              (BinNums.xO
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
     (let __arith :
        BinInt.Z.le (BinNums.Zpos BinNums.xH)
          (BinNums.Zpos
             (BinNums.xO
                (BinNums.xI
                   (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))) :=
        let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
        let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
        let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
          @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
            (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
               RingMicromega.OpLe
               (@EnvRing.PEc BinNums.Z
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
            tt in
        ZMicromega.ZTautoChecker_sound __ff __wit
          (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
          (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
      __arith)
   <:
   le (S O) (bitSize sha256_ctx8_type))
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context) (a : Ty.tySem Ty.Unit),
       let s0 : RunState :=
         fillContext ctx (Build_LocalState (@encode Ty.Unit a) (newWriteFrame (bitSize sha256_ctx8_type))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode Ty.Unit a)
              (fullWriteFrame (@encode sha256_ctx8_type (@sha256_ctx8_init_spec Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function f_simplicity_sha_256_ctx_8_init) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@sha256_ctx8_init_spec Naive.translate) (Running s0) (Running s1))))

Arguments sha256_ctx8_init_context_guarantees env m L ctx a _ _ _
read8s_run =
fix read8s_run
  (bi : Values.block) (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
  (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons x rest =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         @ex Memory.Mem.mem
           (fun ms : Memory.Mem.mem =>
            and
              (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_read8)
                 (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mi
                 (Values.Vint x))
              (and
                 (@eq (option Memory.Mem.mem)
                    (Memory.Mem.store AST.Mint8unsigned mi bi input
                       (Values.Vint
                          (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) x)))
                    (@Some Memory.Mem.mem ms))
                 (read8s_run bi (BinInt.Z.add input (BinNums.Zpos BinNums.xH)) bf base rest ms mf))))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int.int)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments read8s_run bi input%Z_scope bf base%Z_scope xs%list_scope m mf
read8s_loop_body =
match Clight.fn_body f_read8s return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ _ => Clight.Sskip
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop body _ => body
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
read8s_loop_step =
Clight.Sset _n
  (Clight.Ebinop Cop.Osub (Clight.Etempvar _n Ctypesdefs.tulong)
     (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint) Ctypesdefs.tulong)
     : Clight.statement
read8s_body_env =
fun (le : Maps.PTree.tree Values.val) (bi : Values.block) (input : BinNums.Z) (x : Integers.Int.int) =>
@Maps.PTree.set Values.val _t'2 (Values.Vint x)
  (@Maps.PTree.set Values.val _x (Values.Vptr bi (Integers.Ptrofs.repr (BinInt.Z.add input (BinNums.Zpos BinNums.xH))))
     (@Maps.PTree.set Values.val _t'1 (Values.Vptr bi (Integers.Ptrofs.repr input)) le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int.int),
       Maps.PTree.tree Values.val

Arguments read8s_body_env le bi input%Z_scope x
read8s_env =
fun (bf : Values.block) (base : BinNums.Z) (bi : Values.block) (input count : BinNums.Z) =>
@Maps.PTree.set Values.val _n (Values.Vlong (Integers.Int64.repr count))
  (@Maps.PTree.set Values.val _x (Values.Vptr bi (Integers.Ptrofs.repr input))
     (@Maps.PTree.set Values.val _frame (Values.Vptr bf (Integers.Ptrofs.repr base))
        (Clight.create_undef_temps (Clight.fn_temps f_read8s))))
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z),
       Maps.PTree.tree Values.val

Arguments read8s_env bf base%Z_scope bi (input count)%Z_scope
