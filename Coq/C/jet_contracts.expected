       Clight.function_entry2 ge0 f_sha256_iv
         (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr base)) (@nil Values.val)) m Clight.empty_env
         (sha256_iv_init_env b base) m
eval_sha256_iv_init_layout
     : forall (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) base)
         (_ : Memory.Mem.range_perm m b base
                (BinInt.Z.add base
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_sha256_iv)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mf
               Values.Vundef)
            (and (uint32_array_at mf b base sha256_iv_words)
               (and
                  (forall (chunk : AST.memory_chunk) (bb : Values.block) (ofs : BinNums.Z)
                     (_ : or (not (@eq Values.block bb b))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) base)
                               (BinInt.Z.le
                                  (BinInt.Z.add base
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load chunk mf bb ofs) (Memory.Mem.load chunk m bb ofs))
                  (and
                     (forall (bb : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                        (p : Memtype.permission) (_ : Memory.Mem.perm m bb ofs kind p),
                      Memory.Mem.perm mf bb ofs kind p)
                     (forall (bb : Values.block) (_ : Memory.Mem.valid_block m bb), Memory.Mem.valid_block mf bb)))))
write_frame_at_after_slice
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor n count : BinNums.Z) (x : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 count)
         (_ : and (BinInt.Z.le (BinNums.Zpos BinNums.xH) n)
                (BinInt.Z.le n
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : write_frame_at m bf base bw edge cursor (BinInt.Z.add n count))
         (_ : frame_fields_at mf bf base bw edge (BinInt.Z.sub cursor n)) (_ : slice_output_at n mf bw edge cursor x)
         (_ : loads_outside_ranges m mf bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                (slice_write_low n edge cursor)
                (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mf b ofs kind p),
       write_frame_at mf bf base bw edge (BinInt.Z.sub cursor n) count
write_prefix_at_chain
     : forall (m mi mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor next low : BinNums.Z)
         (_ : or (not (@eq Values.block bf bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) base)
