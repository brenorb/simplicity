     : Clight.expr
wide_multiply_spec =
fun (s : multiply_wide_size) (term : Alg.Core.Algebra) =>
match
  s as s0
  return
    (Alg.Core.domain term
       (Ty.Prod (Word.Word (wide_log (multiply_input_size s0))) (Word.Word (wide_log (multiply_input_size s0))))
       (Word.Word (wide_log (multiply_output_size s0))))
with
| M16 => @multiply_word_spec (S (S (S (S O)))) term
| jet_multiply_wide_exec.M32 => @multiply_word_spec (S (S (S (S (S O))))) term
end
     : forall (s : multiply_wide_size) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod (Word.Word (wide_log (multiply_input_size s))) (Word.Word (wide_log (multiply_input_size s))))
         (Word.Word (wide_log (multiply_output_size s)))

