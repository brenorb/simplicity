                       (Integers.Int.repr
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                       Ctypesdefs.tint) Ctypesdefs.tulong))))))
     : Clight.statement
uc_cond =
Clight.Ebinop Cop.Ole (Clight.Etempvar jets_sha._delta Ctypesdefs.tulong)
  (Clight.Etempvar jets_sha._len Ctypesdefs.tulong) Ctypesdefs.tint
     : Clight.expr
uc_loop = Clight.Swhile uc_cond uc_loop_body
     : Clight.statement
ust =
fun (bx bo ba : Values.block) (cbase obase : BinNums.Z) (m : Memory.Mem.mem) (le : Clight.temp_env)
  (l regs rem : list Integers.Int.int) (aoff : BinNums.Z) =>
and
  (lt (@length Integers.Int.int l)
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
  (and (@eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
     (and (BinInt.Z.le BinNums.Z0 aoff)
        (and
           (BinInt.Z.le (BinInt.Z.add aoff (BinInt.Z.of_nat (@length Integers.Int.int rem)))
              Integers.Ptrofs.max_unsigned)
           (and
              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._ctx le)
                 (@Some Values.val (Values.Vptr bx (Integers.Ptrofs.repr cbase))))
              (and
                 (@ex Integers.Ptrofs.int
                    (fun oa : Integers.Ptrofs.int =>
                     and
                       (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._arr le)
                          (@Some Values.val (Values.Vptr ba oa))) (@eq BinNums.Z (Integers.Ptrofs.unsigned oa) aoff)))
                 (and
                    (@ex Integers.Int64.int
                       (fun vl : Integers.Int64.int =>
                        and
                          (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._len le)
                             (@Some Values.val (Values.Vlong vl)))
                          (@eq BinNums.Z (Integers.Int64.unsigned vl) (BinInt.Z.of_nat (@length Integers.Int.int rem)))))
                    (and
                       (@ex Integers.Int64.int
                          (fun vd : Integers.Int64.int =>
                           and
                             (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._delta le)
                                (@Some Values.val (Values.Vlong vd)))
                             (@eq BinNums.Z (Integers.Int64.unsigned vd)
                                (BinInt.Z.sub
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                   (BinInt.Z.of_nat (@length Integers.Int.int l))))))
                       (and
                          (@ex Integers.Ptrofs.int
                             (fun ob : Integers.Ptrofs.int =>
                              and
                                (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._block le)
                                   (@Some Values.val (Values.Vptr bx ob)))
                                (@eq BinNums.Z (Integers.Ptrofs.unsigned ob)
                                   (BinInt.Z.add
                                      (BinInt.Z.add cbase
                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                      (BinInt.Z.of_nat (@length Integers.Int.int l))))))
                          (and
                             (@eq (option Values.val) (Memory.Mem.load AST.Mptr m bx cbase)
                                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr obase))))
                             (and
                                (forall (i : nat) (_ : lt i (@length Integers.Int.int l)),
                                 @eq (option Values.val)
                                   (Memory.Mem.load AST.Mint8unsigned m bx
                                      (BinInt.Z.add
                                         (BinInt.Z.add cbase
                                            (BinNums.Zpos
                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                         (BinInt.Z.of_nat i)))
                                   (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i l Integers.Int.zero))))
                                (and
                                   (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                                    and
                                      (@eq (option Values.val)
                                         (Memory.Mem.load AST.Mint32 m bo
                                            (BinInt.Z.add obase
                                               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                                  (BinInt.Z.of_nat i))))
                                         (@Some Values.val
                                            (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
                                      (Memory.Mem.valid_access m AST.Mint32 bo
                                         (BinInt.Z.add obase
                                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                               (BinInt.Z.of_nat i))) Memtype.Writable))
                                   (and
                                      (forall (i : nat) (_ : lt i (@length Integers.Int.int rem)),
                                       @eq (option Values.val)
                                         (Memory.Mem.load AST.Mint8unsigned m ba
                                            (BinInt.Z.add aoff (BinInt.Z.of_nat i)))
                                         (@Some Values.val
                                            (Values.Vint (@List.nth Integers.Int.int i rem Integers.Int.zero))))
                                      (and (sha_dispatch_ok m)
                                         (Memory.Mem.range_perm m bx
                                            (BinInt.Z.add cbase
                                               (BinNums.Zpos
                                                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                            (BinInt.Z.add cbase
                                               (BinNums.Zpos
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                            Memtype.Cur Memtype.Writable))))))))))))))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Memory.Mem.mem) (_ : Clight.temp_env) (_ : list Integers.Int.int) (_ : list Integers.Int.int)
         (_ : list Integers.Int.int) (_ : BinNums.Z), Prop

Arguments ust bx bo ba (cbase obase)%Z_scope m le (l regs rem)%list_scope aoff%Z_scope
uframe =
fun (bx bo : Values.block) (cbase obase : BinNums.Z) (m m' : Memory.Mem.mem) =>
and
  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
     (_ : or (not (@eq Values.block b bx))
            (or
               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                  (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (BinInt.Z.le
                  (BinInt.Z.add cbase
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))) ofs)))
     (_ : or (not (@eq Values.block b bo))
            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) obase)
               (BinInt.Z.le
                  (BinInt.Z.add obase
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) ofs))),
   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
  (and
     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b))
     : forall (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Memory.Mem.mem)
         (_ : Memory.Mem.mem), Prop

Arguments uframe bx bo (cbase obase)%Z_scope m m'
absorb_step_i =
fun (st : prod (list Integers.Int.int) (list Integers.Int.int)) (x : Integers.Int.int) =>
let l' : list Integers.Int.int :=
  @app Integers.Int.int (@fst (list Integers.Int.int) (list Integers.Int.int) st)
    (@cons Integers.Int.int x (@nil Integers.Int.int)) in
match
  PeanoNat.Nat.eqb (@length Integers.Int.int l')
    (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))
  return (prod (list Integers.Int.int) (list Integers.Int.int))
with
| true =>
    @pair (list Integers.Int.int) SHA256.registers (@nil Integers.Int.int)
      (SHA256.hash_block (@snd (list Integers.Int.int) (list Integers.Int.int) st) (be_words l'))
| false =>
    @pair (list Integers.Int.int) (list Integers.Int.int) l' (@snd (list Integers.Int.int) (list Integers.Int.int) st)
end
     : forall (_ : prod (list Integers.Int.int) (list Integers.Int.int)) (_ : Integers.Int.int),
       prod (list Integers.Int.int) (list Integers.Int.int)

Arguments absorb_step_i st x
absorb_i =
fun l regs bs : list Integers.Int.int =>
@List.fold_left (prod (list Integers.Int.int) (list Integers.Int.int)) Integers.Int.int absorb_step_i bs
  (@pair (list Integers.Int.int) (list Integers.Int.int) l regs)
     : forall (_ : list Integers.Int.int) (_ : list Integers.Int.int) (_ : list Integers.Int.int),
       prod (list Integers.Int.int) (list Integers.Int.int)

Arguments absorb_i (l regs bs)%list_scope
Inductive ctx_slot : Set :=  SOutput : ctx_slot | SCounter : ctx_slot | SBlock : ctx_slot | SOverflow : ctx_slot.
ctx_field =
fun k : ctx_slot =>
match k return AST.ident with
| SOutput => jets_sha._output
| SCounter => jets_sha._counter
| SBlock => jets_sha._block
| SOverflow => jets_sha._overflow
end
     : forall _ : ctx_slot, AST.ident

Arguments ctx_field k
ctx_offset =
fun k : ctx_slot =>
match k return BinNums.Z with
| SOutput => BinNums.Z0
| SCounter => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))
| SBlock => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
| SOverflow => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
end
     : forall _ : ctx_slot, BinNums.Z

Arguments ctx_offset k
ctx_field_type =
fun k : ctx_slot =>
match k return Ctypes.type with
| SOutput => Ctypesdefs.tptr Ctypesdefs.tuint
| SCounter => Ctypesdefs.tulong
| SBlock =>
    Ctypesdefs.tarray Ctypesdefs.tuchar
      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
| SOverflow => Ctypesdefs.tbool
end
     : forall _ : ctx_slot, Ctypes.type

Arguments ctx_field_type k
ctx_field_expr =
fun (k : ctx_slot) (id : AST.ident) =>
Clight.Efield
  (Clight.Ederef (Clight.Etempvar id (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
     (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)) (ctx_field k) (ctx_field_type k)
     : forall (_ : ctx_slot) (_ : AST.ident), Clight.expr

Arguments ctx_field_expr k id
Variant event : Type :=  mkev : forall (_ : nat) (_ : nat) (_ : nat) (_ : list sx), event.

Arguments mkev (etag ebase ecnt)%nat_scope eargs%list_scope
Variant sstate : Type :=  mkst : forall (_ : Maps.PTree.t sx) (_ : list region) (_ : list event) (_ : nat), sstate.

Arguments mkst stemps (sregs slog)%list_scope snv%nat_scope
venv = list (prod AST.ident (prod nat Ctypes.type))
     : Set
vlookup =
fix vlookup (ve : venv) (id : AST.ident) {struct ve} : option (prod nat Ctypes.type) :=
  match ve return (option (prod nat Ctypes.type)) with
  | nil => @None (prod nat Ctypes.type)
  | cons p t =>
      match p return (option (prod nat Ctypes.type)) with
      | pair i v =>
          match BinPos.Pos.eqb i id return (option (prod nat Ctypes.type)) with
          | true => @Some (prod nat Ctypes.type) v
          | false => vlookup t id
          end
      end
  end
     : forall (_ : venv) (_ : AST.ident), option (prod nat Ctypes.type)

Arguments vlookup ve id
lv_var =
fun (ve gv : venv) (id : AST.ident) (ty : Ctypes.type) =>
match vlookup ve id return (option (prod nat BinNums.Z)) with
| Some p =>
    match p return (option (prod nat BinNums.Z)) with
    | pair r ty' =>
        match Ctypes.type_eq ty ty' return (option (prod nat BinNums.Z)) with
        | left _ => @Some (prod nat BinNums.Z) (@pair nat BinNums.Z r BinNums.Z0)
        | right _ => @None (prod nat BinNums.Z)
        end
    end
| None =>
    match vlookup gv id return (option (prod nat BinNums.Z)) with
    | Some p =>
        match p return (option (prod nat BinNums.Z)) with
        | pair r _ => @Some (prod nat BinNums.Z) (@pair nat BinNums.Z r BinNums.Z0)
        end
    | None => @None (prod nat BinNums.Z)
    end
end
     : forall (_ : venv) (_ : venv) (_ : AST.ident) (_ : Ctypes.type), option (prod nat BinNums.Z)

Arguments lv_var ve gv id ty
lv_deref =
fun xa : option sx =>
match xa return (option (prod nat BinNums.Z)) with
| Some s =>
    match s return (option (prod nat BinNums.Z)) with
    | XI _ => @None (prod nat BinNums.Z)
    | XIc _ => @None (prod nat BinNums.Z)
    | XL _ => @None (prod nat BinNums.Z)
    | XLc _ => @None (prod nat BinNums.Z)
    | XLv _ => @None (prod nat BinNums.Z)
    | XV _ => @None (prod nat BinNums.Z)
    | XA _ _ => @None (prod nat BinNums.Z)
    | XP r d => @Some (prod nat BinNums.Z) (@pair nat BinNums.Z r d)
    | XIb _ _ _ => @None (prod nat BinNums.Z)
    | XLb _ _ _ => @None (prod nat BinNums.Z)
    | XIsh _ _ _ => @None (prod nat BinNums.Z)
    | XLsh _ _ _ => @None (prod nat BinNums.Z)
    | XIcmp _ _ _ _ => @None (prod nat BinNums.Z)
    | XLcmp _ _ _ _ => @None (prod nat BinNums.Z)
    | XI2L _ _ => @None (prod nat BinNums.Z)
    | XL2I _ => @None (prod nat BinNums.Z)
    | XIcast _ _ _ => @None (prod nat BinNums.Z)
    | XInz _ => @None (prod nat BinNums.Z)
    | XLnz _ => @None (prod nat BinNums.Z)
    | XIz _ => @None (prod nat BinNums.Z)
    | XLz _ => @None (prod nat BinNums.Z)
    | XIneg _ => @None (prod nat BinNums.Z)
    | XLneg _ => @None (prod nat BinNums.Z)
    | XInot _ => @None (prod nat BinNums.Z)
    | XLnot _ => @None (prod nat BinNums.Z)
    end
| None => @None (prod nat BinNums.Z)
end
     : forall _ : option sx, option (prod nat BinNums.Z)

Arguments lv_deref xa
lv_field =
fun (ce : Ctypes.composite_env) (xa : option sx) (ta : Ctypes.type) (f : AST.ident) =>
match xa return (option (prod nat BinNums.Z)) with
| Some s =>
    match s return (option (prod nat BinNums.Z)) with
    | XI _ => @None (prod nat BinNums.Z)
    | XIc _ => @None (prod nat BinNums.Z)
    | XL _ => @None (prod nat BinNums.Z)
    | XLc _ => @None (prod nat BinNums.Z)
    | XLv _ => @None (prod nat BinNums.Z)
    | XV _ => @None (prod nat BinNums.Z)
    | XA _ _ => @None (prod nat BinNums.Z)
    | XP r d =>
        match ta return (option (prod nat BinNums.Z)) with
        | Ctypes.Tvoid => @None (prod nat BinNums.Z)
        | Ctypes.Tint _ _ _ => @None (prod nat BinNums.Z)
        | Ctypes.Tlong _ _ => @None (prod nat BinNums.Z)
        | Ctypes.Tfloat _ _ => @None (prod nat BinNums.Z)
        | Ctypes.Tpointer _ _ => @None (prod nat BinNums.Z)
        | Ctypes.Tarray _ _ _ => @None (prod nat BinNums.Z)
        | Ctypes.Tfunction _ _ _ => @None (prod nat BinNums.Z)
        | Ctypes.Tstruct id _ =>
            match @Maps.PTree.get Ctypes.composite id ce return (option (prod nat BinNums.Z)) with
            | Some co =>
                match Ctypes.field_offset ce f (Ctypes.co_members co) return (option (prod nat BinNums.Z)) with
                | Errors.OK p =>
                    match p return (option (prod nat BinNums.Z)) with
                    | pair delta b =>
                        match b return (option (prod nat BinNums.Z)) with
                        | Ctypes.Full => @Some (prod nat BinNums.Z) (@pair nat BinNums.Z r (BinInt.Z.add d delta))
                        | Ctypes.Bits _ _ _ _ => @None (prod nat BinNums.Z)
                        end
                    end
                | Errors.Error _ => @None (prod nat BinNums.Z)
                end
            | None => @None (prod nat BinNums.Z)
            end
        | Ctypes.Tunion _ _ => @None (prod nat BinNums.Z)
        end
    | XIb _ _ _ => @None (prod nat BinNums.Z)
    | XLb _ _ _ => @None (prod nat BinNums.Z)
    | XIsh _ _ _ => @None (prod nat BinNums.Z)
    | XLsh _ _ _ => @None (prod nat BinNums.Z)
    | XIcmp _ _ _ _ => @None (prod nat BinNums.Z)
    | XLcmp _ _ _ _ => @None (prod nat BinNums.Z)
    | XI2L _ _ => @None (prod nat BinNums.Z)
    | XL2I _ => @None (prod nat BinNums.Z)
    | XIcast _ _ _ => @None (prod nat BinNums.Z)
    | XInz _ => @None (prod nat BinNums.Z)
    | XLnz _ => @None (prod nat BinNums.Z)
    | XIz _ => @None (prod nat BinNums.Z)
    | XLz _ => @None (prod nat BinNums.Z)
    | XIneg _ => @None (prod nat BinNums.Z)
    | XLneg _ => @None (prod nat BinNums.Z)
    | XInot _ => @None (prod nat BinNums.Z)
    | XLnot _ => @None (prod nat BinNums.Z)
    end
| None => @None (prod nat BinNums.Z)
end
     : forall (_ : Ctypes.composite_env) (_ : option sx) (_ : Ctypes.type) (_ : AST.ident), option (prod nat BinNums.Z)

Arguments lv_field ce xa ta f
xptradd =
fun (ce : Ctypes.composite_env) (xa : sx) (ta : Ctypes.type) (xb : sx) (tb : Ctypes.type) =>
match xa return (option sx) with
| XI _ => @None sx
| XIc _ => @None sx
| XL _ => @None sx
| XLc _ => @None sx
| XLv _ => @None sx
| XV _ => @None sx
| XA _ _ => @None sx
| XP r d =>
    match ta return (option sx) with
    | Ctypes.Tvoid => @None sx
    | Ctypes.Tint _ _ _ => @None sx
    | Ctypes.Tlong _ _ => @None sx
    | Ctypes.Tfloat _ _ => @None sx
    | Ctypes.Tpointer ty _ =>
        match xb return (option sx) with
        | XI _ => @None sx
        | XIc n =>
            match tb return (option sx) with
            | Ctypes.Tvoid => @None sx
            | Ctypes.Tint _ _ _ =>
                @Some sx
                  (XP r
                     (BinInt.Z.add d
                        (BinInt.Z.mul (Ctypes.sizeof ce ty)
                           match isg tb return BinNums.Z with
                           | Ctypes.Signed => Integers.Int.signed n
                           | Ctypes.Unsigned => Integers.Int.unsigned n
                           end)))
            | Ctypes.Tlong _ _ => @None sx
            | Ctypes.Tfloat _ _ => @None sx
            | Ctypes.Tpointer _ _ => @None sx
            | Ctypes.Tarray _ _ _ => @None sx
            | Ctypes.Tfunction _ _ _ => @None sx
            | Ctypes.Tstruct _ _ => @None sx
            | Ctypes.Tunion _ _ => @None sx
            end
        | XL _ => @None sx
        | XLc n =>
            match tb return (option sx) with
            | Ctypes.Tvoid => @None sx
            | Ctypes.Tint _ _ _ => @None sx
            | Ctypes.Tlong _ _ =>
                @Some sx (XP r (BinInt.Z.add d (BinInt.Z.mul (Ctypes.sizeof ce ty) (Integers.Int64.unsigned n))))
            | Ctypes.Tfloat _ _ => @None sx
            | Ctypes.Tpointer _ _ => @None sx
            | Ctypes.Tarray _ _ _ => @None sx
            | Ctypes.Tfunction _ _ _ => @None sx
            | Ctypes.Tstruct _ _ => @None sx
            | Ctypes.Tunion _ _ => @None sx
            end
        | XLv _ => @None sx
        | XV _ => @None sx
        | XA _ _ => @None sx
        | XP _ _ => @None sx
        | XIb _ _ _ => @None sx
        | XLb _ _ _ => @None sx
        | XIsh _ _ _ => @None sx
        | XLsh _ _ _ => @None sx
        | XIcmp _ _ _ _ => @None sx
        | XLcmp _ _ _ _ => @None sx
        | XI2L _ _ => @None sx
        | XL2I _ => @None sx
        | XIcast _ _ _ => @None sx
        | XInz _ => @None sx
        | XLnz _ => @None sx
        | XIz _ => @None sx
        | XLz _ => @None sx
        | XIneg _ => @None sx
        | XLneg _ => @None sx
        | XInot _ => @None sx
        | XLnot _ => @None sx
        end
    | Ctypes.Tarray ty _ _ =>
        match xb return (option sx) with
        | XI _ => @None sx
        | XIc n =>
            match tb return (option sx) with
            | Ctypes.Tvoid => @None sx
            | Ctypes.Tint _ _ _ =>
                @Some sx
                  (XP r
                     (BinInt.Z.add d
                        (BinInt.Z.mul (Ctypes.sizeof ce ty)
                           match isg tb return BinNums.Z with
                           | Ctypes.Signed => Integers.Int.signed n
                           | Ctypes.Unsigned => Integers.Int.unsigned n
                           end)))
            | Ctypes.Tlong _ _ => @None sx
            | Ctypes.Tfloat _ _ => @None sx
            | Ctypes.Tpointer _ _ => @None sx
            | Ctypes.Tarray _ _ _ => @None sx
            | Ctypes.Tfunction _ _ _ => @None sx
            | Ctypes.Tstruct _ _ => @None sx
            | Ctypes.Tunion _ _ => @None sx
            end
        | XL _ => @None sx
        | XLc n =>
            match tb return (option sx) with
            | Ctypes.Tvoid => @None sx
            | Ctypes.Tint _ _ _ => @None sx
            | Ctypes.Tlong _ _ =>
                @Some sx (XP r (BinInt.Z.add d (BinInt.Z.mul (Ctypes.sizeof ce ty) (Integers.Int64.unsigned n))))
            | Ctypes.Tfloat _ _ => @None sx
            | Ctypes.Tpointer _ _ => @None sx
            | Ctypes.Tarray _ _ _ => @None sx
            | Ctypes.Tfunction _ _ _ => @None sx
            | Ctypes.Tstruct _ _ => @None sx
            | Ctypes.Tunion _ _ => @None sx
            end
        | XLv _ => @None sx
        | XV _ => @None sx
        | XA _ _ => @None sx
        | XP _ _ => @None sx
        | XIb _ _ _ => @None sx
        | XLb _ _ _ => @None sx
        | XIsh _ _ _ => @None sx
        | XLsh _ _ _ => @None sx
        | XIcmp _ _ _ _ => @None sx
        | XLcmp _ _ _ _ => @None sx
        | XI2L _ _ => @None sx
        | XL2I _ => @None sx
        | XIcast _ _ _ => @None sx
        | XInz _ => @None sx
        | XLnz _ => @None sx
        | XIz _ => @None sx
        | XLz _ => @None sx
        | XIneg _ => @None sx
        | XLneg _ => @None sx
        | XInot _ => @None sx
        | XLnot _ => @None sx
        end
    | Ctypes.Tfunction _ _ _ => @None sx
    | Ctypes.Tstruct _ _ => @None sx
    | Ctypes.Tunion _ _ => @None sx
    end
| XIb _ _ _ => @None sx
| XLb _ _ _ => @None sx
| XIsh _ _ _ => @None sx
| XLsh _ _ _ => @None sx
| XIcmp _ _ _ _ => @None sx
| XLcmp _ _ _ _ => @None sx
| XI2L _ _ => @None sx
| XL2I _ => @None sx
| XIcast _ _ _ => @None sx
| XInz _ => @None sx
| XLnz _ => @None sx
| XIz _ => @None sx
| XLz _ => @None sx
| XIneg _ => @None sx
| XLneg _ => @None sx
| XInot _ => @None sx
| XLnot _ => @None sx
end
     : forall (_ : Ctypes.composite_env) (_ : sx) (_ : Ctypes.type) (_ : sx) (_ : Ctypes.type), option sx

Arguments xptradd ce xa ta xb tb
xbinop =
fun (ce : Ctypes.composite_env) (op : Cop.binary_operation) (xa : sx) (ta : Ctypes.type) (xb : sx) (tb : Ctypes.type)
=>
match op return (option sx) with
| Cop.Oadd =>
    match xa return (option sx) with
    | XI _ => xbin op xa ta xb tb
    | XIc _ => xbin op xa ta xb tb
    | XL _ => xbin op xa ta xb tb
    | XLc _ => xbin op xa ta xb tb
    | XLv _ => xbin op xa ta xb tb
    | XV _ => xbin op xa ta xb tb
    | XA _ _ => xbin op xa ta xb tb
    | XP _ _ => xptradd ce xa ta xb tb
    | XIb _ _ _ => xbin op xa ta xb tb
    | XLb _ _ _ => xbin op xa ta xb tb
    | XIsh _ _ _ => xbin op xa ta xb tb
    | XLsh _ _ _ => xbin op xa ta xb tb
    | XIcmp _ _ _ _ => xbin op xa ta xb tb
    | XLcmp _ _ _ _ => xbin op xa ta xb tb
    | XI2L _ _ => xbin op xa ta xb tb
    | XL2I _ => xbin op xa ta xb tb
    | XIcast _ _ _ => xbin op xa ta xb tb
    | XInz _ => xbin op xa ta xb tb
    | XLnz _ => xbin op xa ta xb tb
    | XIz _ => xbin op xa ta xb tb
    | XLz _ => xbin op xa ta xb tb
    | XIneg _ => xbin op xa ta xb tb
    | XLneg _ => xbin op xa ta xb tb
    | XInot _ => xbin op xa ta xb tb
    | XLnot _ => xbin op xa ta xb tb
    end
| Cop.Osub => xbin op xa ta xb tb
| Cop.Omul => xbin op xa ta xb tb
| Cop.Odiv => xbin op xa ta xb tb
| Cop.Omod => xbin op xa ta xb tb
| Cop.Oand => xbin op xa ta xb tb
| Cop.Oor => xbin op xa ta xb tb
| Cop.Oxor => xbin op xa ta xb tb
| Cop.Oshl => xbin op xa ta xb tb
| Cop.Oshr => xbin op xa ta xb tb
| Cop.Oeq => xbin op xa ta xb tb
| Cop.One => xbin op xa ta xb tb
| Cop.Olt => xbin op xa ta xb tb
| Cop.Ogt => xbin op xa ta xb tb
| Cop.Ole => xbin op xa ta xb tb
| Cop.Oge => xbin op xa ta xb tb
end
     : forall (_ : Ctypes.composite_env) (_ : Cop.binary_operation) (_ : sx) (_ : Ctypes.type)
         (_ : sx) (_ : Ctypes.type), option sx

Arguments xbinop ce op xa ta xb tb
xlv_of =
fun (ce : Ctypes.composite_env) (ve gv : venv) (rec : forall _ : Clight.expr, option sx) (a : Clight.expr) =>
match a return (option (prod nat BinNums.Z)) with
| Clight.Econst_int _ _ => @None (prod nat BinNums.Z)
| Clight.Econst_float _ _ => @None (prod nat BinNums.Z)
| Clight.Econst_single _ _ => @None (prod nat BinNums.Z)
| Clight.Econst_long _ _ => @None (prod nat BinNums.Z)
| Clight.Evar id ty => lv_var ve gv id ty
| Clight.Etempvar _ _ => @None (prod nat BinNums.Z)
| Clight.Ederef b _ => lv_deref (rec b)
| Clight.Eaddrof _ _ => @None (prod nat BinNums.Z)
| Clight.Eunop _ _ _ => @None (prod nat BinNums.Z)
| Clight.Ebinop _ _ _ _ => @None (prod nat BinNums.Z)
| Clight.Ecast _ _ => @None (prod nat BinNums.Z)
| Clight.Efield b f _ => lv_field ce (rec b) (Clight.typeof b) f
| Clight.Esizeof _ _ => @None (prod nat BinNums.Z)
| Clight.Ealignof _ _ => @None (prod nat BinNums.Z)
end
     : forall (_ : Ctypes.composite_env) (_ : venv) (_ : venv) (_ : forall _ : Clight.expr, option sx)
         (_ : Clight.expr), option (prod nat BinNums.Z)

Arguments xlv_of ce ve gv rec%function_scope a
load_lv =
fun (Σ : sstate) (lv : option (prod nat BinNums.Z)) (ty : Ctypes.type) =>
match lv return (option sx) with
| Some p => match p return (option sx) with
            | pair r d => xload (sregs Σ) r d ty
            end
| None => @None sx
end
     : forall (_ : sstate) (_ : option (prod nat BinNums.Z)) (_ : Ctypes.type), option sx

Arguments load_lv Σ lv ty
xexpr =
fun (ce : Ctypes.composite_env) (ve gv : venv) =>
fix xexpr (Σ : sstate) (a : Clight.expr) {struct a} : option sx :=
  match a return (option sx) with
  | Clight.Econst_int i _ => @Some sx (XIc i)
  | Clight.Econst_float _ _ => @None sx
  | Clight.Econst_single _ _ => @None sx
  | Clight.Econst_long l _ => @Some sx (XLc l)
  | Clight.Evar id ty => load_lv Σ (lv_var ve gv id ty) ty
  | Clight.Etempvar id _ => @Maps.PTree.get sx id (stemps Σ)
  | Clight.Ederef b ty => load_lv Σ (lv_deref (xexpr Σ b)) ty
  | Clight.Eaddrof b _ =>
      match xlv_of ce ve gv (xexpr Σ) b return (option sx) with
      | Some p => match p return (option sx) with
                  | pair r d => @Some sx (XP r d)
                  end
      | None => @None sx
      end
  | Clight.Eunop op b _ =>
      match xexpr Σ b return (option sx) with
      | Some xb => xun op xb (Clight.typeof b)
      | None => @None sx
      end
  | Clight.Ebinop op b c _ =>
      match xexpr Σ b return (option sx) with
      | Some xb =>
          match xexpr Σ c return (option sx) with
          | Some xc => xbinop ce op xb (Clight.typeof b) xc (Clight.typeof c)
          | None => @None sx
          end
      | None => @None sx
      end
  | Clight.Ecast b ty =>
      match xexpr Σ b return (option sx) with
      | Some xb => xcast xb (Clight.typeof b) ty
      | None => @None sx
      end
  | Clight.Efield b f ty => load_lv Σ (lv_field ce (xexpr Σ b) (Clight.typeof b) f) ty
  | Clight.Esizeof _ _ => @None sx
  | Clight.Ealignof _ _ => @None sx
  end
     : forall (_ : Ctypes.composite_env) (_ : venv) (_ : venv) (_ : sstate) (_ : Clight.expr), option sx

Arguments xexpr ce ve gv Σ a
xlval =
fun (ce : Ctypes.composite_env) (ve gv : venv) (Σ : sstate) (a : Clight.expr) => xlv_of ce ve gv (xexpr ce ve gv Σ) a
     : forall (_ : Ctypes.composite_env) (_ : venv) (_ : venv) (_ : sstate) (_ : Clight.expr),
       option (prod nat BinNums.Z)

Arguments xlval ce ve gv Σ a
xargs =
fun (ce : Ctypes.composite_env) (ve gv : venv) =>
fix xargs (Σ : sstate) (al : list Clight.expr) (tys : Ctypes.typelist) {struct al} : option (list sx) :=
  match al return (option (list sx)) with
  | nil =>
      match tys return (option (list sx)) with
      | Ctypes.Tnil => @Some (list sx) (@nil sx)
      | Ctypes.Tcons _ _ => @None (list sx)
      end
  | cons a al0 =>
      match tys return (option (list sx)) with
      | Ctypes.Tnil => @None (list sx)
      | Ctypes.Tcons ty tys0 =>
          match xexpr ce ve gv Σ a return (option (list sx)) with
          | Some x =>
              match xcast x (Clight.typeof a) ty return (option (list sx)) with
              | Some x' =>
                  match xargs Σ al0 tys0 return (option (list sx)) with
                  | Some xs => @Some (list sx) (@cons sx x' xs)
                  | None => @None (list sx)
                  end
              | None => @None (list sx)
              end
          | None => @None (list sx)
          end
      end
  end
     : forall (_ : Ctypes.composite_env) (_ : venv) (_ : venv) (_ : sstate) (_ : list Clight.expr)
         (_ : Ctypes.typelist), option (list sx)

Arguments xargs ce ve gv Σ al%list_scope tys
tmatch =
fun (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (ts : Maps.PTree.t sx) (le : Clight.temp_env) =>
forall (id : BinNums.positive) (x : sx) (_ : @eq (option sx) (@Maps.PTree.get sx id ts) (@Some sx x)),
@eq (option Values.val) (@Maps.PTree.get Values.val id le) (@Some Values.val (den ρ (lay β) x))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : layout) (_ : Maps.PTree.t sx) (_ : Clight.temp_env), Prop

Arguments tmatch ρ%function_scope β ts le
ematch =
fun (β : layout) (ve : venv) (e : Clight.env) =>
forall id : BinNums.positive,
and
  (@eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
     match vlookup ve id return (option (prod Values.block Ctypes.type)) with
     | Some p =>
         match p return (option (prod Values.block Ctypes.type)) with
         | pair r ty => @Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type (blk β r) ty)
         end
     | None => @None (prod Values.block Ctypes.type)
     end)
  (forall (r : nat) (ty : Ctypes.type)
     (_ : @eq (option (prod nat Ctypes.type)) (vlookup ve id)
            (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty))), @eq BinNums.Z (bas β r) BinNums.Z0)
     : forall (_ : layout) (_ : venv) (_ : Clight.env), Prop

Arguments ematch β ve e
gmatch =
fun (ge : Clight.genv) (β : layout) (gv : venv) =>
forall (id : AST.ident) (r : nat) (ty : Ctypes.type)
  (_ : @eq (option (prod nat Ctypes.type)) (vlookup gv id) (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty))),
and
  (@eq (option Values.block) (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
     (@Some Values.block (blk β r))) (@eq BinNums.Z (bas β r) BinNums.Z0)
     : forall (_ : Clight.genv) (_ : layout) (_ : venv), Prop

Arguments gmatch ge β gv
Inductive xout : Type :=
    ONormal : xout | OBreak : xout | OContinue : xout | OReturn : forall _ : option (prod sx Ctypes.type), xout.

Arguments OReturn v
Inductive res : Type :=  RDone : forall (_ : sstate) (_ : xout), res | RIf : forall (_ : sx) (_ : res) (_ : res), res.

Arguments RDone Σ o
Arguments RIf c a b
rsel =
fix rsel
  (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z) (r : res) {struct r} :
    prod sstate xout :=
  match r return (prod sstate xout) with
  | RDone Σ o => @pair sstate xout Σ o
  | RIf c a b => match truth ρ β c return (prod sstate xout) with
                 | true => rsel ρ β a
                 | false => rsel ρ β b
                 end
  end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : res),
       prod sstate xout

Arguments rsel (ρ β)%function_scope r
tbind =
fix tbind (r : res) (k : forall (_ : sstate) (_ : xout), option res) {struct r} : option res :=
  match r return (option res) with
  | RDone Σ o => k Σ o
  | RIf c a b =>
      match tbind a k return (option res) with
      | Some a' =>
          match tbind b k return (option res) with
          | Some b' => @Some res (RIf c a' b')
          | None => @None res
          end
      | None => @None res
      end
  end
     : forall (_ : res) (_ : forall (_ : sstate) (_ : xout), option res), option res

Arguments tbind r k%function_scope
is_const =
fun c : sx =>
match c return (option Integers.Int.int) with
| XI _ => @None Integers.Int.int
| XIc i => @Some Integers.Int.int i
| XL _ => @None Integers.Int.int
| XLc _ => @None Integers.Int.int
| XLv _ => @None Integers.Int.int
| XV _ => @None Integers.Int.int
| XA _ _ => @None Integers.Int.int
| XP _ _ => @None Integers.Int.int
| XIb _ _ _ => @None Integers.Int.int
| XLb _ _ _ => @None Integers.Int.int
| XIsh _ _ _ => @None Integers.Int.int
| XLsh _ _ _ => @None Integers.Int.int
| XIcmp _ _ _ _ => @None Integers.Int.int
| XLcmp _ _ _ _ => @None Integers.Int.int
| XI2L _ _ => @None Integers.Int.int
| XL2I _ => @None Integers.Int.int
| XIcast _ _ _ => @None Integers.Int.int
| XInz _ => @None Integers.Int.int
| XLnz _ => @None Integers.Int.int
| XIz _ => @None Integers.Int.int
| XLz _ => @None Integers.Int.int
| XIneg _ => @None Integers.Int.int
| XLneg _ => @None Integers.Int.int
| XInot _ => @None Integers.Int.int
| XLnot _ => @None Integers.Int.int
end
     : forall _ : sx, option Integers.Int.int

Arguments is_const c
set_opt =
fun (optid : option AST.ident) (v : option sx) (ts : Maps.PTree.t sx) =>
match optid return (Maps.PTree.t sx) with
| Some id =>
    match v return (Maps.PTree.t sx) with
    | Some x => @Maps.PTree.set sx id x ts
    | None => @Maps.PTree.remove sx id ts
    end
| None => ts
end
     : forall (_ : option AST.ident) (_ : option sx) (_ : Maps.PTree.t sx), Maps.PTree.t sx

Arguments set_opt optid v ts
xret =
fun (ty : Ctypes.type) (o : xout) =>
match o return (option (option sx)) with
| ONormal =>
    match ty return (option (option sx)) with
    | Ctypes.Tvoid => @Some (option sx) (@None sx)
    | Ctypes.Tint _ _ _ => @None (option sx)
    | Ctypes.Tlong _ _ => @None (option sx)
    | Ctypes.Tfloat _ _ => @None (option sx)
    | Ctypes.Tpointer _ _ => @None (option sx)
    | Ctypes.Tarray _ _ _ => @None (option sx)
    | Ctypes.Tfunction _ _ _ => @None (option sx)
    | Ctypes.Tstruct _ _ => @None (option sx)
    | Ctypes.Tunion _ _ => @None (option sx)
    end
| OBreak => @None (option sx)
| OContinue => @None (option sx)
| OReturn v =>
    match v return (option (option sx)) with
    | Some p =>
        match p return (option (option sx)) with
        | pair x tx =>
            match ty return (option (option sx)) with
            | Ctypes.Tvoid => @None (option sx)
            | Ctypes.Tint _ _ _ =>
                match xcast x tx ty return (option (option sx)) with
                | Some v0 => @Some (option sx) (@Some sx v0)
                | None => @None (option sx)
                end
            | Ctypes.Tlong _ _ =>
                match xcast x tx ty return (option (option sx)) with
                | Some v0 => @Some (option sx) (@Some sx v0)
                | None => @None (option sx)
                end
            | Ctypes.Tfloat _ _ =>
                match xcast x tx ty return (option (option sx)) with
                | Some v0 => @Some (option sx) (@Some sx v0)
                | None => @None (option sx)
                end
            | Ctypes.Tpointer _ _ =>
                match xcast x tx ty return (option (option sx)) with
                | Some v0 => @Some (option sx) (@Some sx v0)
                | None => @None (option sx)
                end
            | Ctypes.Tarray _ _ _ =>
                match xcast x tx ty return (option (option sx)) with
                | Some v0 => @Some (option sx) (@Some sx v0)
                | None => @None (option sx)
                end
            | Ctypes.Tfunction _ _ _ =>
                match xcast x tx ty return (option (option sx)) with
                | Some v0 => @Some (option sx) (@Some sx v0)
                | None => @None (option sx)
                end
            | Ctypes.Tstruct _ _ =>
                match xcast x tx ty return (option (option sx)) with
                | Some v0 => @Some (option sx) (@Some sx v0)
                | None => @None (option sx)
                end
            | Ctypes.Tunion _ _ =>
                match xcast x tx ty return (option (option sx)) with
                | Some v0 => @Some (option sx) (@Some sx v0)
                | None => @None (option sx)
                end
            end
        end
    | None =>
        match ty return (option (option sx)) with
        | Ctypes.Tvoid => @Some (option sx) (@None sx)
        | Ctypes.Tint _ _ _ => @None (option sx)
        | Ctypes.Tlong _ _ => @None (option sx)
        | Ctypes.Tfloat _ _ => @None (option sx)
        | Ctypes.Tpointer _ _ => @None (option sx)
        | Ctypes.Tarray _ _ _ => @None (option sx)
        | Ctypes.Tfunction _ _ _ => @None (option sx)
        | Ctypes.Tstruct _ _ => @None (option sx)
        | Ctypes.Tunion _ _ => @None (option sx)
        end
    end
end
     : forall (_ : Ctypes.type) (_ : xout), option (option sx)

Arguments xret ty o
oracle =
forall (_ : nat) (_ : list event) (_ : list sx) (_ : list region),
option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
     : Type
Inductive fentry : Type :=
    FInt : forall _ : Clight.function, fentry | FOra : forall (_ : Clight.function) (_ : oracle), fentry.

Arguments FInt fd
Arguments FOra fd o
fentry_fd =
fun ent : fentry => match ent return Clight.function with
                    | FInt fd => fd
                    | FOra fd _ => fd
                    end
     : forall _ : fentry, Clight.function

Arguments fentry_fd ent
flookup =
fix flookup (fns : list (prod AST.ident fentry)) (id : AST.ident) {struct fns} : option fentry :=
  match fns return (option fentry) with
  | nil => @None fentry
  | cons p t =>
      match p return (option fentry) with
      | pair i f =>
          match BinPos.Pos.eqb i id return (option fentry) with
          | true => @Some fentry f
          | false => flookup t id
          end
      end
  end
     : forall (_ : list (prod AST.ident fentry)) (_ : AST.ident), option fentry

Arguments flookup fns%list_scope id
fn_okb =
fun fd : Clight.function =>
andb
  (andb
     match
       @Coqlib.list_norepet_dec BinNums.positive AST.ident_eq (Clight.var_names (Clight.fn_vars fd)) return bool
     with
     | left _ => true
     | right _ => false
     end
     match
       @Coqlib.list_norepet_dec BinNums.positive AST.ident_eq (Clight.var_names (Clight.fn_params fd)) return bool
     with
     | left _ => true
     | right _ => false
     end)
  match
    @Coqlib.list_disjoint_dec BinNums.positive AST.ident_eq (Clight.var_names (Clight.fn_params fd))
      (Clight.var_names (Clight.fn_temps fd)) return bool
  with
  | left _ => true
  | right _ => false
  end
     : forall _ : Clight.function, bool

Arguments fn_okb fd
xcall_ret =
fun (optid : option AST.ident) (ts : Maps.PTree.t sx) (nreg : nat) (ty : Ctypes.type) (Σb : sstate) (ob : xout) =>
match xret ty ob return (option res) with
| Some v =>
    match match v return bool with
          | Some x => xp_lt nreg x
          | None => true
          end return (option res) with
    | true =>
        @Some res (RDone (mkst (set_opt optid v ts) (@List.firstn region nreg (sregs Σb)) (slog Σb) (snv Σb)) ONormal)
    | false => @None res
    end
| None => @None res
end
     : forall (_ : option AST.ident) (_ : Maps.PTree.t sx) (_ : nat) (_ : Ctypes.type) (_ : sstate) (_ : xout),
       option res

Arguments xcall_ret optid ts nreg%nat_scope ty Σb ob
xfun_with =
fun (ce : Ctypes.composite_env) (rec : forall (_ : venv) (_ : sstate) (_ : Clight.statement), option res)
  (fd : Clight.function) (xs : list sx) (regs : list region) (log : list event) (nv : nat)
  (k : forall (_ : sstate) (_ : xout), option res) =>
match fn_okb fd return (option res) with
| true =>
    match @List.forallb sx (xp_lt (@length region regs)) xs return (option res) with
    | true =>
        match xalloc (std_cells ce) ce (Clight.fn_vars fd) (@length region regs) return (option res) with
        | Some p =>
            match p return (option res) with
            | pair regsN veN =>
                match xbind (Clight.fn_params fd) xs (Maps.PTree.empty sx) return (option res) with
                | Some ts0 =>
                    match
                      rec veN (mkst ts0 (@app region regs regsN) log nv) (Clight.fn_body fd) return (option res)
                    with
                    | Some rb => tbind rb k
                    | None => @None res
                    end
                | None => @None res
                end
            end
        | None => @None res
        end
    | false => @None res
    end
| false => @None res
end
     : forall (_ : Ctypes.composite_env) (_ : forall (_ : venv) (_ : sstate) (_ : Clight.statement), option res)
         (_ : Clight.function) (_ : list sx) (_ : list region) (_ : list event) (_ : nat)
         (_ : forall (_ : sstate) (_ : xout), option res), option res

Arguments xfun_with ce rec%function_scope fd (xs regs log)%list_scope nv%nat_scope k%function_scope
xstmt =
fun (ce : Ctypes.composite_env) (gv : venv) (fns : list (prod AST.ident fentry)) =>
fix xstmt (n : nat) (ve : venv) (Σ : sstate) (s : Clight.statement) {struct n} : option res :=
  match n return (option res) with
  | O => @None res
  | S n0 =>
      match s return (option res) with
      | Clight.Sskip => @Some res (RDone Σ ONormal)
      | Clight.Sassign a1 a2 =>
          match xlval ce ve gv Σ a1 return (option res) with
          | Some p =>
              match p return (option res) with
              | pair r d =>
                  match xexpr ce ve gv Σ a2 return (option res) with
                  | Some x2 =>
                      match Ctypes.access_mode (Clight.typeof a1) return (option res) with
                      | Ctypes.By_value ch =>
                          match xcast x2 (Clight.typeof a2) (Clight.typeof a1) return (option res) with
                          | Some x =>
                              match xstore (sregs Σ) r d ch x return (option res) with
                              | Some regs' => @Some res (RDone (mkst (stemps Σ) regs' (slog Σ) (snv Σ)) ONormal)
                              | None => @None res
                              end
                          | None => @None res
                          end
                      | Ctypes.By_reference => @None res
                      | Ctypes.By_copy => @None res
                      | Ctypes.By_nothing => @None res
                      end
                  | None => @None res
                  end
              end
          | None => @None res
          end
      | Clight.Sset id a =>
          match xexpr ce ve gv Σ a return (option res) with
          | Some x => @Some res (RDone (mkst (@Maps.PTree.set sx id x (stemps Σ)) (sregs Σ) (slog Σ) (snv Σ)) ONormal)
          | None => @None res
          end
      | Clight.Scall optid e al =>
          match e return (option res) with
          | Clight.Econst_int _ _ => @None res
          | Clight.Econst_float _ _ => @None res
          | Clight.Econst_single _ _ => @None res
          | Clight.Econst_long _ _ => @None res
          | Clight.Evar fid fty =>
              match vlookup ve fid return (option res) with
              | Some _ => @None res
              | None =>
                  match flookup fns fid return (option res) with
                  | Some ent =>
                      match fty return (option res) with
                      | Ctypes.Tvoid => @None res
                      | Ctypes.Tint _ _ _ => @None res
                      | Ctypes.Tlong _ _ => @None res
                      | Ctypes.Tfloat _ _ => @None res
                      | Ctypes.Tpointer _ _ => @None res
                      | Ctypes.Tarray _ _ _ => @None res
                      | Ctypes.Tfunction tyargs _ _ =>
                          match Ctypes.type_eq (Clight.type_of_function (fentry_fd ent)) fty return (option res) with
                          | left _ =>
                              match xargs ce ve gv Σ al tyargs return (option res) with
                              | Some xs =>
                                  match ent return (option res) with
                                  | FInt fd =>
                                      xfun_with ce (xstmt n0) fd xs (sregs Σ) (slog Σ) (snv Σ)
                                        (xcall_ret optid (stemps Σ) (@length region (sregs Σ)) (Clight.fn_return fd))
                                  | FOra _ o =>
                                      match o (snv Σ) (slog Σ) xs (sregs Σ) return (option res) with
                                      | Some p =>
                                          match p return (option res) with
                                          | pair p0 eargs =>
                                              match p0 return (option res) with
                                              | pair p1 cnt =>
                                                  match p1 return (option res) with
                                                  | pair p2 tag =>
                                                      match p2 return (option res) with
                                                      | pair regs' v =>
                                                          @Some res
                                                            (RDone
                                                               (mkst (set_opt optid v (stemps Σ)) regs'
                                                                  (@app event (slog Σ)
                                                                     (@cons event (mkev tag (snv Σ) cnt eargs)
                                                                        (@nil event))) (Nat.add (snv Σ) cnt)) ONormal)
                                                      end
                                                  end
                                              end
                                          end
                                      | None => @None res
                                      end
                                  end
                              | None => @None res
                              end
                          | right _ => @None res
                          end
                      | Ctypes.Tstruct _ _ => @None res
                      | Ctypes.Tunion _ _ => @None res
                      end
                  | None => @None res
                  end
              end
          | Clight.Etempvar _ _ => @None res
          | Clight.Ederef _ _ => @None res
          | Clight.Eaddrof _ _ => @None res
          | Clight.Eunop _ _ _ => @None res
          | Clight.Ebinop _ _ _ _ => @None res
          | Clight.Ecast _ _ => @None res
          | Clight.Efield _ _ _ => @None res
          | Clight.Esizeof _ _ => @None res
          | Clight.Ealignof _ _ => @None res
          end
      | Clight.Sbuiltin _ _ _ _ => @None res
      | Clight.Ssequence s1 s2 =>
          match xstmt n0 ve Σ s1 return (option res) with
          | Some r1 =>
              tbind r1
                (fun (Σ1 : sstate) (o : xout) =>
                 match o return (option res) with
                 | ONormal => xstmt n0 ve Σ1 s2
                 | OBreak => @Some res (RDone Σ1 o)
                 | OContinue => @Some res (RDone Σ1 o)
                 | OReturn _ => @Some res (RDone Σ1 o)
                 end)
          | None => @None res
          end
      | Clight.Sifthenelse a s1 s2 =>
          match xexpr ce ve gv Σ a return (option res) with
          | Some xa =>
              match xbool xa (Clight.typeof a) return (option res) with
              | Some c =>
                  match is_const c return (option res) with
                  | Some i =>
                      xstmt n0 ve Σ
                        match negb (Integers.Int.eq i Integers.Int.zero) return Clight.statement with
                        | true => s1
                        | false => s2
                        end
                  | None =>
                      match xstmt n0 ve Σ s1 return (option res) with
                      | Some r1 =>
                          match xstmt n0 ve Σ s2 return (option res) with
                          | Some r2 => @Some res (RIf c r1 r2)
                          | None => @None res
                          end
                      | None => @None res
                      end
                  end
              | None => @None res
              end
          | None => @None res
          end
      | Clight.Sloop s1 s2 =>
          match xstmt n0 ve Σ s1 return (option res) with
          | Some r1 =>
              tbind r1
                (fun (Σ1 : sstate) (o1 : xout) =>
                 match o1 return (option res) with
                 | ONormal =>
                     match xstmt n0 ve Σ1 s2 return (option res) with
                     | Some r2 =>
                         tbind r2
                           (fun (Σ2 : sstate) (o2 : xout) =>
                            match o2 return (option res) with
                            | ONormal => xstmt n0 ve Σ2 (Clight.Sloop s1 s2)
                            | OBreak => @Some res (RDone Σ2 ONormal)
                            | OContinue => @None res
                            | OReturn v => @Some res (RDone Σ2 (OReturn v))
                            end)
                     | None => @None res
                     end
                 | OBreak => @Some res (RDone Σ1 ONormal)
                 | OContinue =>
                     match xstmt n0 ve Σ1 s2 return (option res) with
                     | Some r2 =>
                         tbind r2
                           (fun (Σ2 : sstate) (o2 : xout) =>
                            match o2 return (option res) with
                            | ONormal => xstmt n0 ve Σ2 (Clight.Sloop s1 s2)
                            | OBreak => @Some res (RDone Σ2 ONormal)
                            | OContinue => @None res
                            | OReturn v => @Some res (RDone Σ2 (OReturn v))
                            end)
                     | None => @None res
                     end
                 | OReturn v => @Some res (RDone Σ1 (OReturn v))
                 end)
          | None => @None res
          end
      | Clight.Sbreak => @Some res (RDone Σ OBreak)
      | Clight.Scontinue => @Some res (RDone Σ OContinue)
      | Clight.Sreturn o =>
          match o return (option res) with
          | Some a =>
              match xexpr ce ve gv Σ a return (option res) with
              | Some x =>
                  @Some res
                    (RDone Σ (OReturn (@Some (prod sx Ctypes.type) (@pair sx Ctypes.type x (Clight.typeof a)))))
              | None => @None res
              end
          | None => @Some res (RDone Σ (OReturn (@None (prod sx Ctypes.type))))
          end
      | Clight.Sswitch _ _ => @None res
      | Clight.Slabel _ _ => @None res
      | Clight.Sgoto _ => @None res
      end
  end
     : forall (_ : Ctypes.composite_env) (_ : venv) (_ : list (prod AST.ident fentry)) (_ : nat)
         (_ : venv) (_ : sstate) (_ : Clight.statement), option res

Arguments xstmt ce gv fns%list_scope n%nat_scope ve Σ s
xfun =
fun (ce : Ctypes.composite_env) (gv : venv) (fns : list (prod AST.ident fentry)) (n : nat)
  (fd : Clight.function) (xs : list sx) (regs : list region) (log : list event) (nv : nat) =>
xfun_with ce (xstmt ce gv fns n) fd xs regs log nv
  (xcall_ret (@Some BinNums.positive BinNums.xH) (Maps.PTree.empty sx) (@length region regs) (Clight.fn_return fd))
     : forall (_ : Ctypes.composite_env) (_ : venv) (_ : list (prod AST.ident fentry)) (_ : nat)
         (_ : Clight.function) (_ : list sx) (_ : list region) (_ : list event) (_ : nat),
       option res

Arguments xfun ce gv fns%list_scope n%nat_scope fd (xs regs log)%list_scope nv%nat_scope
lext =
fun (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
  (log : list event) (r : res) =>
@ex (list event) (fun suf : list event => @eq (list event) (slog (@fst sstate xout (rsel ρ β r))) (@app event log suf))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z)
         (_ : list event) (_ : res), Prop

Arguments lext (ρ β)%function_scope log%list_scope r
outmatch =
fun (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (o : xout) (out : ClightBigstep.outcome) =>
match o return Prop with
| ONormal =>
    match out return Prop with
    | ClightBigstep.Out_break => False
    | ClightBigstep.Out_continue => False
    | ClightBigstep.Out_normal => True
    | ClightBigstep.Out_return _ => False
    end
| OBreak =>
    match out return Prop with
    | ClightBigstep.Out_break => True
    | ClightBigstep.Out_continue => False
    | ClightBigstep.Out_normal => False
    | ClightBigstep.Out_return _ => False
    end
| OContinue =>
    match out return Prop with
    | ClightBigstep.Out_break => False
    | ClightBigstep.Out_continue => True
    | ClightBigstep.Out_normal => False
    | ClightBigstep.Out_return _ => False
    end
| OReturn v0 =>
    match v0 return Prop with
    | Some p =>
        match p return Prop with
        | pair x ty =>
            match out return Prop with
            | ClightBigstep.Out_break => False
            | ClightBigstep.Out_continue => False
            | ClightBigstep.Out_normal => False
            | ClightBigstep.Out_return o0 =>
                match o0 return Prop with
                | Some p0 =>
                    match p0 return Prop with
                    | pair v ty' => and (@eq Values.val v (den ρ (lay β) x)) (@eq Ctypes.type ty' ty)
                    end
                | None => False
                end
            end
        end
    | None =>
        match out return Prop with
        | ClightBigstep.Out_break => False
        | ClightBigstep.Out_continue => False
        | ClightBigstep.Out_normal => False
        | ClightBigstep.Out_return o0 => match o0 return Prop with
                                         | Some _ => False
                                         | None => True
                                         end
        end
    end
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : layout) (_ : xout) (_ : ClightBigstep.outcome), Prop

Arguments outmatch ρ%function_scope β o out
gmatch2 =
fun (ge : Clight.genv) (β : layout) (gv : venv) =>
and (gmatch ge β gv)
  (forall (id : AST.ident) (r : nat) (ty : Ctypes.type)
     (_ : @eq (option (prod nat Ctypes.type)) (vlookup gv id)
            (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty))),
   lt r (@length (prod Values.block BinNums.Z) β))
     : forall (_ : Clight.genv) (_ : layout) (_ : venv), Prop

Arguments gmatch2 ge β gv
lv =
fun (ρ : forall _ : nat, Integers.Int64.int) (x : sx) =>
il (den ρ (fun _ : nat => @pair BinNums.positive BinNums.Z BinNums.xH BinNums.Z0) x)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : sx), Integers.Int64.int

Arguments lv ρ%function_scope x
solves =
fun (ev_ok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
  (ρ : forall _ : nat, Integers.Int64.int) (log : list event) => @List.Forall event (ev_ok ρ) log
     : forall (_ : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (_ : forall _ : nat, Integers.Int64.int) (_ : list event), Prop

Arguments solves (ev_ok ρ)%function_scope log%list_scope
xsep =
fun (ext : forall _ : Values.block, Prop) (β : layout) =>
forall (r : nat) (_ : lt r (@length (prod Values.block BinNums.Z) β)), not (ext (blk β r))
     : forall (_ : forall _ : Values.block, Prop) (_ : layout), Prop

Arguments xsep ext%function_scope β
frame =
fun (ext : forall _ : Values.block, Prop) (β : layout) (regs : list region) (m : Memory.Mem.mem)
  (b : Values.block) (o : BinNums.Z) =>
and (Memory.Mem.valid_block m b)
  (and
     (not
        (foot β
           (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape regs)
           b o)) (not (ext b)))
     : forall (_ : forall _ : Values.block, Prop) (_ : layout) (_ : list region) (_ : Memory.Mem.mem)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments frame ext%function_scope β regs%list_scope m _ _%Z_scope
oracle_ok =
fun (ge : Clight.genv) (ev_ok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
  (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
  (ext : forall _ : Values.block, Prop) (fd : Clight.function) (o : oracle) =>
forall (base : nat) (xs : list sx) (regs regs' : list region) (v : option sx) (tag cnt : nat)
  (eargs : list sx) (log : list event) (ρ : forall _ : nat, Integers.Int64.int) (β : layout)
  (m : Memory.Mem.mem)
  (_ : @eq (option (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)))
         (o base log xs regs)
         (@Some (prod (prod (prod (prod (list region) (option sx)) nat) nat) (list sx))
            (@pair (prod (prod (prod (list region) (option sx)) nat) nat) (list sx)
               (@pair (prod (prod (list region) (option sx)) nat) nat
                  (@pair (prod (list region) (option sx)) nat (@pair (list region) (option sx) regs' v) tag) cnt) eargs)))
  (_ : rep ρ β regs m) (_ : xsep ext β) (_ : inv ρ log m) (_ : solves ev_ok ρ log)
  (_ : ev_ok ρ (mkev tag base cnt eargs)),
@ex Memory.Mem.mem
  (fun m' : Memory.Mem.mem =>
   @ex Values.val
     (fun vres : Values.val =>
      and
        (ClightBigstep.eval_funcall Clight.function_entry2 ge m (@Ctypes.Internal Clight.function fd)
           (@List.map sx Values.val (den ρ (lay β)) xs) Events.E0 m' vres)
        (and (rep ρ β regs' m')
           (and (inv ρ (@app event log (@cons event (mkev tag base cnt eargs) (@nil event))) m')
              (and
                 (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                    (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                       rshape regs')
                    (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                       rshape regs))
                 (and
                    match v return Prop with
                    | Some x => @eq Values.val vres (den ρ (lay β) x)
                    | None => @eq Values.val vres Values.Vundef
                    end (lframe (frame ext β regs m) m m')))))))
     : forall (_ : Clight.genv) (_ : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (_ : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (_ : forall _ : Values.block, Prop) (_ : Clight.function) (_ : oracle), Prop

Arguments oracle_ok ge (ev_ok inv ext)%function_scope fd o
post =
fun (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
  (ext : forall _ : Values.block, Prop) (ρ : forall _ : nat, Integers.Int64.int) (β : layout)
  (Σ0 : sstate) (m0 : Memory.Mem.mem) (r : res) (le' : Clight.temp_env) (m' : Memory.Mem.mem)
  (out : ClightBigstep.outcome) =>
and (rep ρ β (sregs (@fst sstate xout (rsel ρ (lay β) r))) m')
  (and (tmatch ρ β (stemps (@fst sstate xout (rsel ρ (lay β) r))) le')
     (and (outmatch ρ β (@snd sstate xout (rsel ρ (lay β) r)) out)
        (and
           (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
              (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                 (sregs (@fst sstate xout (rsel ρ (lay β) r))))
              (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                 (sregs Σ0)))
           (and (inv ρ (slog (@fst sstate xout (rsel ρ (lay β) r))) m') (lframe (frame ext β (sregs Σ0) m0) m0 m')))))
     : forall (_ : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (_ : forall _ : Values.block, Prop) (_ : forall _ : nat, Integers.Int64.int) (_ : layout)
         (_ : sstate) (_ : Memory.Mem.mem) (_ : res) (_ : Clight.temp_env) (_ : Memory.Mem.mem)
         (_ : ClightBigstep.outcome), Prop

Arguments post (inv ext ρ)%function_scope β Σ0 m0 r le' m' out
sound_rec =
fun (ge : Clight.genv) (gv : venv) (ev_ok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
  (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
  (ext : forall _ : Values.block, Prop) (rec : forall (_ : venv) (_ : sstate) (_ : Clight.statement), option res) =>
forall (ve : venv) (Σ : sstate) (s : Clight.statement) (r : res) (_ : @eq (option res) (rec ve Σ s) (@Some res r))
  (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (e : Clight.env) (le : Clight.temp_env)
  (m : Memory.Mem.mem) (_ : rep ρ β (sregs Σ) m) (_ : tmatch ρ β (stemps Σ) le) (_ : ematch β ve e)
  (_ : gmatch2 ge β gv) (_ : xsep ext β) (_ : inv ρ (slog Σ) m)
  (_ : solves ev_ok ρ (slog (@fst sstate xout (rsel ρ (lay β) r)))),
@ex Clight.temp_env
  (fun le' : Clight.temp_env =>
   @ex Memory.Mem.mem
     (fun m' : Memory.Mem.mem =>
      @ex ClightBigstep.outcome
        (fun out : ClightBigstep.outcome =>
         and (ClightBigstep.exec_stmt Clight.function_entry2 ge e le m s Events.E0 le' m' out)
           (post inv ext ρ β Σ m r le' m' out))))
     : forall (_ : Clight.genv) (_ : venv) (_ : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (_ : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (_ : forall _ : Values.block, Prop) (_ : forall (_ : venv) (_ : sstate) (_ : Clight.statement), option res),
       Prop

Arguments sound_rec ge gv (ev_ok inv ext rec)%function_scope
Inductive kind : Set :=  KI : kind | KL : kind | KP : kind | KA : kind | KV : kind.
Inductive bop : Set :=  Badd : bop | Bsub : bop | Bmul : bop | Band : bop | Bor : bop | Bxor : bop.
Inductive shop : Set :=  Hshl : shop | Hshr : shop | Hshru : shop.
Inductive sx : Type :=
    XI : forall _ : Integers.Int.int, sx
  | XIc : forall _ : Integers.Int.int, sx
  | XL : forall _ : Integers.Int64.int, sx
  | XLc : forall _ : Integers.Int64.int, sx
  | XLv : forall _ : nat, sx
  | XV : forall _ : Values.val, sx
  | XA : forall (_ : Values.block) (_ : Integers.Ptrofs.int), sx
  | XP : forall (_ : nat) (_ : BinNums.Z), sx
  | XIb : forall (_ : bop) (_ : sx) (_ : sx), sx
  | XLb : forall (_ : bop) (_ : sx) (_ : sx), sx
  | XIsh : forall (_ : shop) (_ : sx) (_ : BinNums.Z), sx
  | XLsh : forall (_ : shop) (_ : sx) (_ : BinNums.Z), sx
  | XIcmp : forall (_ : Integers.comparison) (_ : Ctypes.signedness) (_ : sx) (_ : sx), sx
  | XLcmp : forall (_ : Integers.comparison) (_ : Ctypes.signedness) (_ : sx) (_ : sx), sx
  | XI2L : forall (_ : Ctypes.signedness) (_ : sx), sx
  | XL2I : forall _ : sx, sx
  | XIcast : forall (_ : Ctypes.intsize) (_ : Ctypes.signedness) (_ : sx), sx
  | XInz : forall _ : sx, sx
  | XLnz : forall _ : sx, sx
  | XIz : forall _ : sx, sx
  | XLz : forall _ : sx, sx
  | XIneg : forall _ : sx, sx
  | XLneg : forall _ : sx, sx
  | XInot : forall _ : sx, sx
  | XLnot : forall _ : sx, sx.

