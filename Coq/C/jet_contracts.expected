               (and
                  (@eq BinNums.Z
                     (final_output_value (reduce512_body_digits (product_reduce_rho rho))
                        (reduce512_body_carry (product_reduce_rho rho)) (product_reduce_rho rho)
                        (lay (product_reduce_layout beta)))
                     (BinInt.Z.modulo
                        (BinInt.Z.mul (scalar_mul512_input_value rho O)
                           (scalar_mul512_input_value rho (S (S (S (S O)))))) canonical_group_order))
                  (and
                     (Memory.Mem.range_perm mf (blk beta (S (S O))) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (foot beta
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 scalar_mul512_fresh_regs) b ofs)) m mf)))))
eval_scalar_mul_call_second_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_mul_caller_inputs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                     (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (rep (product_reduce_rho rho)
                  (@cons (prod Values.block BinNums.Z) (lay beta O) (@nil (prod Values.block BinNums.Z)))
                  (scalar_mul_caller_output rho) mf)
               (and
                  (@eq BinNums.Z
                     (final_output_value (reduce512_body_digits (product_reduce_rho rho))
                        (reduce512_body_carry (product_reduce_rho rho)) (product_reduce_rho rho)
                        (lay (@cons (prod Values.block BinNums.Z) (lay beta O) (@nil (prod Values.block BinNums.Z)))))
                     (BinInt.Z.modulo
                        (BinInt.Z.mul (scalar_mul512_input_value rho O)
                           (scalar_mul512_input_value rho (S (S (S (S O)))))) canonical_group_order))
                  (and
                     (Memory.Mem.range_perm mf (blk beta (S O)) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (foot beta
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 scalar_mul_caller_inputs) b ofs)) m mf)))))
eval_scalar_mul_call_second_owned_observed
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_mul_caller_inputs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                     (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (forall (i : nat) (w : Integers.Int64.int)
                  (_ : @eq (option Integers.Int64.int)
                         (@List.nth_error Integers.Int64.int (scalar_mul_caller_words rho) i)
                         (@Some Integers.Int64.int w)),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (blk beta O)
                     (BinInt.Z.add (bas beta O)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong w)))
               (and
                  (@eq BinNums.Z (column_words_value (scalar_mul_caller_words rho))
                     (BinInt.Z.modulo
                        (BinInt.Z.mul (scalar_mul512_input_value rho O)
                           (scalar_mul512_input_value rho (S (S (S (S O)))))) canonical_group_order))
                  (and
                     (rep (product_reduce_rho rho)
                        (@cons (prod Values.block BinNums.Z) (lay beta O) (@nil (prod Values.block BinNums.Z)))
                        (scalar_mul_caller_output rho) mf)
                     (and
                        (Memory.Mem.range_perm mf (blk beta (S O)) BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot beta
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape scalar_mul_caller_inputs) b ofs)) m mf))))))
canonical_scalar_multiply_numeric
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_multiply Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b)))
         (BinInt.Z.modulo
            (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)) canonical_group_order)
canonical_scalar_multiply_normalized_value
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.mul
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem a))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem b))) canonical_group_order)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_multiply Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b)))
four_words_decompose
     : forall (xs : list Integers.Int64.int) (_ : @eq nat (@length Integers.Int64.int xs) (S (S (S (S O))))),
       @eq (list Integers.Int64.int) xs
         (@cons Integers.Int64.int (@List.nth Integers.Int64.int O xs Integers.Int64.zero)
            (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S O) xs Integers.Int64.zero)
               (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S O)) xs Integers.Int64.zero)
                  (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S (S O))) xs Integers.Int64.zero)
                     (@nil Integers.Int64.int)))))
four_words_scalar_limbs
     : forall (xs : list Integers.Int64.int) (_ : @eq nat (@length Integers.Int64.int xs) (S (S (S (S O))))),
       @eq (list Integers.Int64.int)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (scalar_limbs_of (column_words_value xs))) xs
four_words_scalar_at
     : forall (m : Memory.Mem.mem) (b : Values.block) (xs : list Integers.Int64.int)
         (_ : @eq nat (@length Integers.Int64.int xs) (S (S (S (S O)))))
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : forall (i : nat) (w : Integers.Int64.int)
                (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int xs i)
                       (@Some Integers.Int64.int w)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m b
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vlong w))),
       scalar_at m b BinNums.Z0
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (scalar_limbs_of (column_words_value xs)))
scalar_mul_output_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep (product_reduce_rho rho)
                (@cons (prod Values.block BinNums.Z) (lay beta O) (@nil (prod Values.block BinNums.Z)))
                (scalar_mul_caller_output rho) m),
       and (@eq BinNums.Z (bas beta O) BinNums.Z0)
         (Memory.Mem.range_perm m (blk beta O) BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
scalar_writer_initial_rep_from_mul
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep (product_reduce_rho rho)
                (@cons (prod Values.block BinNums.Z) (lay beta O) (@nil (prod Values.block BinNums.Z)))
                (scalar_mul_caller_output rho) m)
         (_ : forall (i : nat) (w : Integers.Int64.int)
                (_ : @eq (option Integers.Int64.int)
                       (@List.nth_error Integers.Int64.int (scalar_mul_caller_words rho) i)
                       (@Some Integers.Int64.int w)),
