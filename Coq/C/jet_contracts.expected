bitcoin_frame_fields_checked
     : match @Maps.PTree.get Ctypes.composite jets_bitcoin._frameItem (Clight.genv_cenv bitcoin_ge) return Prop with
       | Some co =>
           and
             (@eq (Errors.res (prod BinNums.Z Ctypes.bitfield))
