       extend_wide_fill_run s bf base bit n m mf
extend_wide_body_shape
     : forall s : extend_wide_size,
       @eq Clight.statement (Clight.fn_body (extend_wide_function s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar _src (Ctypes.Tstruct _frameItem Ctypes.noattr))
               (Clight.Etempvar _src (Ctypes.Tstruct _frameItem Ctypes.noattr)))
            (Clight.Ssequence
