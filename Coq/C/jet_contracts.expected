ctx_abs_other
     : forall (m m' : Memory.Mem.mem) (bx bm : Values.block) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
         (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : ctx_abs m bx bm l regs c ovf)
         (_ : forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                (_ : or (@eq Values.block b bx)
                       (or (@eq Values.block b bm)
                          (or (@eq Values.block b (sha_symbol_block jets_sha._simplicity_sha256_compression))
                             (@eq Values.block b (sha_symbol_block jets_sha._sha256_max_counter))))),
              @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
         (_ : forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p), ctx_abs m' bx bm l regs c ovf
ah_counter_two
     : forall (r : Integers.Int64.int) (len : BinNums.Z)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned r)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO
                                                                   (BinNums.xO
                                                                      (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 len)
                (BinInt.Z.lt len
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       let c : Integers.Int64.int := sha256_read_counter r (Integers.Int64.repr len) in
       and
         (@eq Integers.Int64.int
            (Integers.Int64.add (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (Integers.Int64.add c
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (@eq bool
            (uc_overflow (uc_overflow false c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
               (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (uc_overflow false c
               (Integers.Int64.repr
                  (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
