     : forall (le : Maps.PTree.tree Values.val) (m0 : Memory.Mem.mem) (ml ma mb : Memory.Mem.mem')
         (bl ba bb bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bw : Values.block) (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (a : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m0 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ml bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ml BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block ma ba))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb bb)) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m0 bs sbase bi edge rc)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)))),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt secp_ge (scalar_add_public_env bl ba bb) le mb
               (Clight.Sassign (Clight.Evar jets_secp._src secp_frame_type)
                  (Clight.Etempvar jets_secp._src secp_frame_type)) Events.E0 le mc ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mc ba BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mc bb BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mc bl BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                        Memtype.Freeable)
                     (and (frame_fields_at mc bl BinNums.Z0 bi edge rc)
                        (and (not (@eq Values.block ba bb))
                           (and (not (@eq Values.block ba bl))
                              (and (not (@eq Values.block bb bl))
                                 (and
                                    (xsep (extA m0 bd bw bi)
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z ba BinNums.Z0)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bl BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z)))))
                                    (and
                                       (xsep (extA m0 bd bw bi)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bb BinNums.Z0)
                                             (@cons (prod Values.block BinNums.Z)
                                                (@pair Values.block BinNums.Z bl BinNums.Z0)
                                                (@nil (prod Values.block BinNums.Z)))))
                                       (and
                                          (invA m0 bd dbase bw outedge cursor N bi rc false
                                             (@nil Cell)
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                             (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) a)
                                                rc) (@nil event) mc)
                                          (and
                                             (lframe
                                                (fun (bx : Values.block) (_ : BinNums.Z) =>
                                                 and (not (@eq Values.block bx ba))
                                                   (and (not (@eq Values.block bx bb)) (not (@eq Values.block bx bl))))
                                                m0 mc)
                                             (and (not (Memory.Mem.valid_block m0 ba))
                                                (and (not (Memory.Mem.valid_block m0 bb))
                                                   (not (Memory.Mem.valid_block m0 bl))))))))))))))))
scalar_add_run_eq
     : @eq (option res) scalar_add_run (@Some res scalar_add_result)
scalar_add_selected
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (prod sstate xout) (rsel rho beta scalar_add_result) (@pair sstate xout scalar_add_state ONormal)
scalar_add_return
     : @eq (option sx) (@Maps.PTree.get sx BinNums.xH (stemps scalar_add_state)) (@Some sx scalar_add_return_sx)
scalar_add_output_shape
     : @ex (list sx)
         (fun limbs : list sx =>
          and (@eq nat (@length sx limbs) (S (S (S (S O)))))
            (@eq (list region) (sregs scalar_add_state)
               (@cons region
                  (mkreg (u64_cells BinNums.Z0 limbs) true
                     (@Some BinNums.Z
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                  (@cons region
                     (mkreg
                        (u64_cells BinNums.Z0
                           (@cons sx (XLv (S (S (S (S O)))))
                              (@cons sx (XLv (S (S (S (S (S O))))))
                                 (@cons sx (XLv (S (S (S (S (S (S O)))))))
                                    (@cons sx (XLv (S (S (S (S (S (S (S O)))))))) (@nil sx)))))) true
                        (@Some BinNums.Z
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                     (@nil region)))))
scalar_add_caller_owned
     : and (@eq nat (@length region (sregs scalar_add_state)) (S (S O)))
         (and
            (@eq (option BinNums.Z)
               (rfree (@List.nth region O (sregs scalar_add_state) (mkreg (@nil cell) false (@None BinNums.Z))))
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@eq (option BinNums.Z)
               (rfree (@List.nth region (S O) (sregs scalar_add_state) (mkreg (@nil cell) false (@None BinNums.Z))))
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
scalar_add_vars_nth
     : forall (start i : nat) (x : sx)
         (_ : @eq (option sx) (@List.nth_error sx (scalar_add_vars start) i) (@Some sx x)),
       and (lt i (S (S (S (S O))))) (@eq sx x (XLv (Nat.add start i)))
scalar_add_region_from_values
     : forall (rho : forall _ : nat, Integers.Int64.int) (start : nat) (layout : layout) (m : Memory.Mem.mem)
         (r : nat) (_ : @eq BinNums.Z (bas layout r) BinNums.Z0)
         (_ : scalar_at m (blk layout r) (bas layout r) (scalar_add_values rho start))
         (_ : Memory.Mem.range_perm m (blk layout r) BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       region_ok rho layout m r
         (mkreg (u64_cells BinNums.Z0 (scalar_add_vars start)) true
            (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
scalar_add_initial_from_owned_scalars
     : forall (m : Memory.Mem.mem) (a b : Values.block) (rho : forall _ : nat, Integers.Int64.int)
         (_ : not (@eq Values.block a b)) (_ : scalar_at m a BinNums.Z0 (scalar_add_values rho O))
         (_ : scalar_at m b BinNums.Z0 (scalar_add_values rho (S (S (S (S O))))))
         (_ : Memory.Mem.range_perm m a BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       rep rho
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z a BinNums.Z0)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
               (@nil (prod Values.block BinNums.Z)))) scalar_add_initial_regs m
canonical_scalar_add_numeric
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_add Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b)))
         (BinInt.Z.modulo
            (BinInt.Z.add (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) a)
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) b)) canonical_group_order)
canonical_scalar_add_normalize_value
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem a))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem b))) canonical_group_order)
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_scalar_add Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b)))
canonical_scalar_add_normalized_inputs_range
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (BinInt.Z.le BinNums.Z0
            (BinInt.Z.add
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem a))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem b))))
         (BinInt.Z.lt
            (BinInt.Z.add
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem a))
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem b)))
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))
scalar_add_limbs_length
     : @eq nat (@length sx scalar_add_limbs) (S (S (S (S O))))
scalar_add_regions_exact
     : @eq (list region) (sregs scalar_add_state)
         (@cons region
            (mkreg (u64_cells BinNums.Z0 scalar_add_limbs) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@cons region
               (mkreg
                  (u64_cells BinNums.Z0
                     (@cons sx (XLv (S (S (S (S O)))))
                        (@cons sx (XLv (S (S (S (S (S O))))))
                           (@cons sx (XLv (S (S (S (S (S (S O)))))))
                              (@cons sx (XLv (S (S (S (S (S (S (S O)))))))) (@nil sx)))))) true
                  (@Some BinNums.Z
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
               (@nil region)))
scalar_add_limbs_long
     : @List.Forall sx (fun x : sx => @eq bool (isk KL x) true) scalar_add_limbs
scalar_add_return_int
     : @eq bool (isk KI scalar_add_return_sx) true
eval_scalar_add_from_owned_regions
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout scalar_add_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                        (@nil Values.val)))) Events.E0 mf
               (Values.Vint (ii (den rho (lay layout) scalar_add_return_sx))))
            (and (rep rho layout (sregs scalar_add_state) mf)
               (lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (foot layout
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           scalar_add_initial_regs) b ofs)) m mf)))
scalar_add_final_storage
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout (sregs scalar_add_state) m),
       and (@eq BinNums.Z (bas layout O) BinNums.Z0)
         (and
            (Memory.Mem.range_perm m (blk layout O) BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
               Memtype.Freeable)
            (and (@eq BinNums.Z (bas layout (S O)) BinNums.Z0)
               (and
                  (Memory.Mem.range_perm m (blk layout (S O)) BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (forall (i : nat) (x : sx)
                        (_ : @eq (option sx) (@List.nth_error sx scalar_add_limbs i) (@Some sx x)),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 m (blk layout O)
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat i))) (@Some Values.val (Values.Vlong (il (den rho (lay layout) x)))))
                     (forall (i : nat) (x : sx)
                        (_ : @eq (option sx)
                               (@List.nth_error sx
                                  (@cons sx (XLv (S (S (S (S O)))))
                                     (@cons sx (XLv (S (S (S (S (S O))))))
                                        (@cons sx (XLv (S (S (S (S (S (S O)))))))
                                           (@cons sx (XLv (S (S (S (S (S (S (S O)))))))) (@nil sx))))) i)
                               (@Some sx x)),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 m (blk layout (S O))
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat i))) (@Some Values.val (den rho (lay layout) x)))))))
scalar_add_raw_length
     : @eq nat (@length sx scalar_add_raw) (S (S (S (S O))))
scalar_add_raw_sigma_kind
     : forall n : nat, @eq bool (isk KL (scalar_add_raw_sigma n)) true
scalar_add_overflow_kind
     : @eq bool (isk KI scalar_add_overflow_sx) true
scalar_add_flag_exact
     : @eq sx scalar_add_return_sx scalar_add_flag
scalar_add_reduction_exact
     : @eq (list sx) scalar_add_limbs
         (@List.map sx sx scalar_add_instantiate
            (@cons sx scalar_reduce_low0
               (@cons sx scalar_reduce_low1 (@cons sx scalar_reduce_low2 (@cons sx scalar_reduce_low3 (@nil sx))))))
scalar_add_raw_sigma_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (n : nat),
       @eq Values.val (den rho layout (scalar_add_raw_sigma n)) (Values.Vlong (scalar_add_raw_rho rho layout n))
scalar_add_reduction_sigma_kind
     : forall n : nat, @eq bool (isk KL (scalar_add_reduction_sigma n)) true
scalar_add_reduction_sigma_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (n : nat),
       @eq Values.val (den rho layout (scalar_add_reduction_sigma n))
         (Values.Vlong (scalar_add_reduction_rho rho layout n))
scalar_add_bound_flag
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout scalar_add_flag)
         (Values.Vint (Integers.Int64.loword (scalar_add_reduction_rho rho layout (S (S (S (S O)))))))
scalar_add_bound_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx),
       @eq Values.val (den rho layout (scalar_add_instantiate x)) (den (scalar_add_reduction_rho rho layout) layout x)
scalar_add_actual_overflow
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout scalar_add_overflow_sx)
         (Values.Vint (b2i (BinInt.Z.leb canonical_group_order (scalar_limb_value (scalar_add_raw_rho rho layout)))))
scalar_add_reduction_input_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (scalar_limb_value (scalar_add_reduction_rho rho layout))
         (scalar_limb_value (scalar_add_raw_rho rho layout))
scalar_add_raw_values
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       let s0 : BinNums.Z :=
         BinInt.Z.add (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S (S (S (S O)))))) in
       let s1 : BinNums.Z :=
         BinInt.Z.add (BinInt.Z.add (BinInt.Z.div s0 Integers.Int64.modulus) (Integers.Int64.unsigned (rho (S O))))
           (Integers.Int64.unsigned (rho (S (S (S (S (S O))))))) in
       let s2 : BinNums.Z :=
         BinInt.Z.add (BinInt.Z.add (BinInt.Z.div s1 Integers.Int64.modulus) (Integers.Int64.unsigned (rho (S (S O)))))
           (Integers.Int64.unsigned (rho (S (S (S (S (S (S O)))))))) in
       let s3 : BinNums.Z :=
         BinInt.Z.add
           (BinInt.Z.add (BinInt.Z.div s2 Integers.Int64.modulus) (Integers.Int64.unsigned (rho (S (S (S O))))))
           (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S O))))))))) in
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_add_low0)))
            (BinInt.Z.modulo s0 Integers.Int64.modulus))
         (and
            (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_add_low1)))
               (BinInt.Z.modulo s1 Integers.Int64.modulus))
            (and
               (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_add_low2)))
                  (BinInt.Z.modulo s2 Integers.Int64.modulus))
               (and
                  (@eq BinNums.Z (Integers.Int64.unsigned (il (den rho layout scalar_add_low3)))
                     (BinInt.Z.modulo s3 Integers.Int64.modulus))
                  (@eq BinNums.Z (scalar_add_carry_value rho layout) (BinInt.Z.div s3 Integers.Int64.modulus)))))
scalar_add_input_range
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (scalar_add_input_value rho))
         (BinInt.Z.lt (scalar_add_input_value rho)
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
scalar_add_raw_decomposition
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z
         (BinInt.Z.add (scalar_add_raw_value rho layout)
            (BinInt.Z.mul
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
               (scalar_add_carry_value rho layout))) (scalar_add_input_value rho)
scalar_add_raw_and_carry
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       and
         (@eq BinNums.Z (scalar_add_raw_value rho layout)
            (BinInt.Z.modulo (scalar_add_input_value rho)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (@eq BinNums.Z (scalar_add_carry_value rho layout)
            (BinInt.Z.div (scalar_add_input_value rho)
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
scalar_add_carry_bit
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       and (BinInt.Z.le BinNums.Z0 (scalar_add_carry_value rho layout))
         (BinInt.Z.le (scalar_add_carry_value rho layout) (BinNums.Zpos BinNums.xH))
scalar_add_flag_integer
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout scalar_add_flag)
         (Values.Vint
            (Integers.Int.repr
               (BinInt.Z.add (scalar_add_carry_value rho layout)
                  (b2z (BinInt.Z.leb canonical_group_order (scalar_add_raw_value rho layout))))))
scalar_add_flag_threshold
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 (scalar_add_input_value rho))
                (BinInt.Z.lt (scalar_add_input_value rho)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))),
       @eq BinNums.Z
         (BinInt.Z.add (scalar_add_carry_value rho layout)
            (b2z (BinInt.Z.leb canonical_group_order (scalar_add_raw_value rho layout))))
         (b2z (BinInt.Z.leb canonical_group_order (scalar_add_input_value rho)))
scalar_add_flag_reduced
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 (scalar_add_input_value rho))
                (BinInt.Z.lt (scalar_add_input_value rho)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))),
       @eq Values.val (den rho layout scalar_add_flag)
         (Values.Vint (b2i (BinInt.Z.leb canonical_group_order (scalar_add_input_value rho))))
scalar_add_reduction_flag_reduced
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 (scalar_add_input_value rho))
                (BinInt.Z.lt (scalar_add_input_value rho)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))),
       @eq Integers.Int64.int (scalar_add_reduction_rho rho layout (S (S (S (S O)))))
         (Integers.Int64.repr (b2z (BinInt.Z.leb canonical_group_order (scalar_add_input_value rho))))
scalar_add_limb_reduced_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (i : nat) (_ : lt i (S (S (S (S O))))),
       @eq Integers.Int64.int (scalar_add_limb rho layout i)
         (scalar_reduce_limb (scalar_add_reduction_rho rho layout) layout i)
scalar_add_output_weighted
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 (scalar_add_input_value rho))
                (BinInt.Z.lt (scalar_add_input_value rho)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))),
       @eq BinNums.Z (scalar_add_output_value rho layout)
         (BinInt.Z.modulo
            (BinInt.Z.add (scalar_add_raw_value rho layout)
               (BinInt.Z.mul (b2z (BinInt.Z.leb canonical_group_order (scalar_add_input_value rho)))
                  (BinInt.Z.sub
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     canonical_group_order)))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
scalar_add_modulus_bridge
     : forall (s : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 s)
                (BinInt.Z.lt s (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.modulo s
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
               (BinInt.Z.mul (b2z (BinInt.Z.leb canonical_group_order s))
                  (BinInt.Z.sub
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     canonical_group_order)))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (BinInt.Z.modulo s canonical_group_order)
scalar_add_output_mod_group
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 (scalar_add_input_value rho))
                (BinInt.Z.lt (scalar_add_input_value rho)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))),
       @eq BinNums.Z (scalar_add_output_value rho layout)
         (BinInt.Z.modulo (scalar_add_input_value rho) canonical_group_order)
eval_scalar_add_mod_group_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout scalar_add_initial_regs m)
         (_ : and (BinInt.Z.le BinNums.Z0 (scalar_add_input_value rho))
                (BinInt.Z.lt (scalar_add_input_value rho)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                        (@nil Values.val)))) Events.E0 mf
               (Values.Vint (b2i (BinInt.Z.leb canonical_group_order (scalar_add_input_value rho)))))
            (and (rep rho layout (sregs scalar_add_state) mf)
               (and
                  (and (@eq BinNums.Z (bas layout O) BinNums.Z0)
                     (Memory.Mem.range_perm mf (blk layout O) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable))
                  (and
                     (and (@eq BinNums.Z (bas layout (S O)) BinNums.Z0)
                        (Memory.Mem.range_perm mf (blk layout (S O)) BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable))
                     (and
                        (forall (i : nat) (_ : lt i (S (S (S (S O))))),
                         @eq (option Values.val)
                           (Memory.Mem.load AST.Mint64 mf (blk layout O)
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.of_nat i)))
                           (@Some Values.val (Values.Vlong (scalar_add_limb rho (lay layout) i))))
                        (and
                           (@eq BinNums.Z (scalar_add_output_value rho (lay layout))
                              (BinInt.Z.modulo (scalar_add_input_value rho) canonical_group_order))
                           (lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (foot layout
                                    (@List.map region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       rshape scalar_add_initial_regs) b ofs)) m mf)))))))
scalar_add_output_limbs_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Integers.Int64.int)
         (@List.map sx Integers.Int64.int (fun x : sx => il (den rho layout x)) scalar_add_limbs)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (scalar_limbs_of (scalar_add_output_value rho layout)))
scalar_add_output_scalar_at
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout (sregs scalar_add_state) m),
       and
         (scalar_at m (blk layout O) (bas layout O)
            (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
               (scalar_limbs_of (scalar_add_output_value rho (lay layout)))))
         (and
            (Memory.Mem.range_perm m (blk layout O) BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
               Memtype.Freeable)
            (Memory.Mem.range_perm m (blk layout (S O)) BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
               Memtype.Freeable))
scalar_writer_initial_rep_from_add
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout (sregs scalar_add_state) m),
       rep (scalar_limb_rho (scalar_add_output_value rho (lay layout)))
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z (blk layout O) (bas layout O))
            (@nil (prod Values.block BinNums.Z))) scalar_writer_initial_regs m
eval_scalar_add_literal_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : rep rho layout scalar_add_initial_regs m)
         (_ : @eq BinNums.Z (scalar_limb_value rho)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@canonical_scalar_normalize Alg.CoreFunSem a)))
         (_ : @eq BinNums.Z (scalar_limb_value (scalar_add_second_rho rho))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@canonical_scalar_normalize Alg.CoreFunSem b))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                     (@cons Values.val (Values.Vptr (blk layout (S O)) (Integers.Ptrofs.repr (bas layout (S O))))
                        (@nil Values.val)))) Events.E0 mf
               (Values.Vint (b2i (BinInt.Z.leb canonical_group_order (scalar_add_input_value rho)))))
            (and
               (rep
                  (scalar_limb_rho
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@canonical_scalar_add Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
                  (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z (blk layout O) (bas layout O))
                     (@nil (prod Values.block BinNums.Z))) scalar_writer_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf (blk layout O) BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf (blk layout (S O)) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (lframe
                        (fun (block : Values.block) (ofs : BinNums.Z) =>
                         not
                           (foot layout
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 scalar_add_initial_regs) block ofs)) m mf)))))
scalar_add_reader_first
     : forall (va vb : BinNums.Z) (n : nat) (_ : lt n (S (S (S (S O))))),
       @eq Integers.Int64.int (scalar_add_reader_rho va vb n) (scalar_limb_rho va n)
scalar_add_reader_second
     : forall (va vb : BinNums.Z) (n : nat) (_ : lt n (S (S (S (S O))))),
       @eq Integers.Int64.int (scalar_add_reader_rho va vb (Nat.add (S (S (S (S O)))) n)) (scalar_limb_rho vb n)
scalar_add_reader_values_first
     : forall va vb : BinNums.Z,
       @eq (list Integers.Int64.int) (scalar_add_values (scalar_add_reader_rho va vb) O)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (scalar_limbs_of va))
scalar_add_reader_values_second
     : forall va vb : BinNums.Z,
       @eq (list Integers.Int64.int) (scalar_add_values (scalar_add_reader_rho va vb) (S (S (S (S O)))))
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (scalar_limbs_of vb))
scalar_add_reader_weighted_values
     : forall (va vb : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 va)
                (BinInt.Z.lt va
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 vb)
                (BinInt.Z.lt vb
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       and (@eq BinNums.Z (scalar_limb_value (scalar_add_reader_rho va vb)) va)
         (@eq BinNums.Z (scalar_limb_value (scalar_add_second_rho (scalar_add_reader_rho va vb))) vb)
scalar_add_normalized_reader_values
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (@eq BinNums.Z (scalar_limb_value (scalar_add_normalized_rho a b))
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@canonical_scalar_normalize Alg.CoreFunSem a)))
         (@eq BinNums.Z (scalar_limb_value (scalar_add_second_rho (scalar_add_normalized_rho a b)))
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
               (@canonical_scalar_normalize Alg.CoreFunSem b)))
eval_scalar_add_from_normalized_scalars
     : forall (m : Memory.Mem.mem) (ba bb : Values.block)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : not (@eq Values.block ba bb))
         (_ : scalar_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_scalar_normalize Alg.CoreFunSem a)))))
         (_ : scalar_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (scalar_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_scalar_normalize Alg.CoreFunSem b)))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Integers.Int.int
            (fun ret : Integers.Int.int =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_add)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mf
                  (Values.Vint ret))
               (and
                  (rep
                     (scalar_limb_rho
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_scalar_add Alg.CoreFunSem
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
                     (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                        (@nil (prod Values.block BinNums.Z))) scalar_writer_initial_regs mf)
                  (and
                     (Memory.Mem.range_perm mf ba BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mf bb BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (lframe
                           (fun (block : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))))
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape scalar_add_initial_regs) block ofs)) m mf))))))
eval_read_scalar_canonical_with_source
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N cap : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bl : Values.block) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) cap
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          and
