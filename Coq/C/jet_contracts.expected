jet_partial_return =
fun (B : Type) (result : option B) =>
match result return Values.val with
| Some _ => Values.Vint Integers.Int.one
| None => Values.Vint Integers.Int.zero
end
     : forall (B : Type) (_ : option B), Values.val

Arguments jet_partial_return {B}%type_scope result
jet_partial_local_spec =
fun (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, option (Ty.tySem B)) =>
forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
  (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
  (a : Ty.tySem A) (_ : frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
  (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize A))) Integers.Int64.max_unsigned)
  (_ : frame_input_cells_at m bi edge read_cursor (@encode A a))
  (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f)
        (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
           (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
        Events.E0 mf (@jet_partial_return (Ty.tySem B) (spec a)))
     (and
        match spec a return Prop with
        | Some b =>
            and (frame_output_cells_at mf bw outedge cursor (@encode B b))
              (and (write_prefix_at m mf bw outedge cursor)
                 (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B)))))
        | None => True
        end
        (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
           (_ : or (not (@eq Values.block b bd))
                  (or
                     (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                        (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (BinInt.Z.le
                        (BinInt.Z.add dbase
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
           (_ : or (not (@eq Values.block b bw))
                  (or
                     (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                        (BinInt.Z.add outedge
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B)))
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (BinInt.Z.le
                        (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
         @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))
     : forall (_ : Clight.function) (A B : Ty.Ty) (_ : forall _ : Ty.tySem A, option (Ty.tySem B)), Prop

Arguments jet_partial_local_spec f (A B)%ty_scope spec%function_scope
Alg.AssertionSem_mixin =
fun M : Monad.MonadZero.type =>
Alg.Assertion.Mixin (fun x x0 : Ty.Ty => forall _ : Ty.tySem x, Monad.MonadZero.domain M (Ty.tySem x0))
  (fun (A B C D : Ty.Ty)
     (s : (fun x x0 : Ty.Ty => forall _ : Ty.tySem x, Monad.MonadZero.domain M (Ty.tySem x0)) (Ty.Prod A C) D)
     (_ : Digest.hash256) (p : Ty.tySem (Ty.Prod (Ty.Sum A B) C)) =>
   match p return (Monad.MonadZero.domain M (Ty.tySem D)) with
   | pair ab c =>
       match ab return (Monad.MonadZero.domain M (Ty.tySem D)) with
       | inl a =>
           s
             (@pair
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) A)
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) C) a c)
       | inr _ => @Monad.MonadZero.Theory.mzero M (Ty.tySem D)
       end
   end)
  (fun (A B C D : Ty.Ty) (_ : Digest.hash256)
     (t : (fun x x0 : Ty.Ty => forall _ : Ty.tySem x, Monad.MonadZero.domain M (Ty.tySem x0)) (Ty.Prod B C) D)
     (p : Ty.tySem (Ty.Prod (Ty.Sum A B) C)) =>
   match p return (Monad.MonadZero.domain M (Ty.tySem D)) with
   | pair ab c =>
       match ab return (Monad.MonadZero.domain M (Ty.tySem D)) with
       | inl _ => @Monad.MonadZero.Theory.mzero M (Ty.tySem D)
       | inr b =>
           t
             (@pair
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) B)
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A0 B0 => sum (tySem A0) (tySem B0)
                    | Ty.Prod A0 B0 => prod (tySem A0) (tySem B0)
                    end) C) b c)
       end
   end)
  (fun (A B : Ty.Ty) (_ : prod Digest.hash256 Digest.hash256) =>
   @Monad.MonadZero.Theory.kzero M (Ty.tySem A) (Ty.tySem B))
     : forall M : Monad.MonadZero.type,
       Alg.Assertion.mixin (Ty.Kleisli (Monad.CIMonad.domain (Monad.MonadZero.to_Monad M)))

Arguments Alg.AssertionSem_mixin M
