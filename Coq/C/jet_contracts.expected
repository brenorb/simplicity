     : option res
scalar_add_state =
match scalar_add_tree return sstate with
| Some r =>
    match r return sstate with
    | RDone state _ => state
    | RIf _ a _ =>
        match a return sstate with
        | RDone state _ => state
        | RIf _ _ _ => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
        end
    end
| None => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
end
     : sstate
scalar_add_condition =
match scalar_add_tree return sx with
| Some r => match r return sx with
            | RDone _ _ => XIc Integers.Int.zero
            | RIf c _ _ => c
            end
| None => XIc Integers.Int.zero
end
     : sx
scalar_add_result =
RIf scalar_add_condition (RDone scalar_add_state ONormal) (RDone scalar_add_state ONormal)
     : res
scalar_add_return_sx =
match @Maps.PTree.get sx BinNums.xH (stemps scalar_add_state) return sx with
| Some x => x
| None => XV Values.Vundef
end
     : sx
scalar_add_vars =
fun start : nat =>
@cons sx (XLv start)
  (@cons sx (XLv (Nat.add start (S O)))
     (@cons sx (XLv (Nat.add start (S (S O)))) (@cons sx (XLv (Nat.add start (S (S (S O))))) (@nil sx))))
     : forall _ : nat, list sx

Arguments scalar_add_vars start%nat_scope
scalar_add_values =
fun (rho : forall _ : nat, Integers.Int64.int) (start : nat) =>
@cons Integers.Int64.int (rho start)
  (@cons Integers.Int64.int (rho (Nat.add start (S O)))
     (@cons Integers.Int64.int (rho (Nat.add start (S (S O))))
        (@cons Integers.Int64.int (rho (Nat.add start (S (S (S O))))) (@nil Integers.Int64.int))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), list Integers.Int64.int

Arguments scalar_add_values rho%function_scope start%nat_scope
scalar_add_limbs =
match sregs scalar_add_state return (list sx) with
| nil => @nil sx
| cons reg _ => @List.map cell sx cell_sx (rcells reg)
end
     : list sx
scalar_add_low0 = XLb Badd (XLv O) (XLv (S (S (S (S O)))))
     : sx
scalar_add_high0 =
XLb Badd (XI2L Ctypes.Signed (XIc Integers.Int.zero)) (scalar_carry_sx (XLv O) (XLv (S (S (S (S O))))))
     : sx
scalar_add_low1 = scalar_sum_low scalar_add_high0 (XLv (S O)) (XLv (S (S (S (S (S O))))))
     : sx
scalar_add_high1 = scalar_sum_high scalar_add_high0 (XLv (S O)) (XLv (S (S (S (S (S O))))))
     : sx
scalar_add_low2 = scalar_sum_low scalar_add_high1 (XLv (S (S O))) (XLv (S (S (S (S (S (S O)))))))
     : sx
scalar_add_high2 = scalar_sum_high scalar_add_high1 (XLv (S (S O))) (XLv (S (S (S (S (S (S O)))))))
     : sx
scalar_add_low3 = scalar_sum_low scalar_add_high2 (XLv (S (S (S O)))) (XLv (S (S (S (S (S (S (S O))))))))
     : sx
scalar_add_high3 = scalar_sum_high scalar_add_high2 (XLv (S (S (S O)))) (XLv (S (S (S (S (S (S (S O))))))))
     : sx
scalar_add_raw =
@cons sx scalar_add_low0 (@cons sx scalar_add_low1 (@cons sx scalar_add_low2 (@cons sx scalar_add_low3 (@nil sx))))
     : list sx
scalar_add_raw_sigma = fun n : nat => @List.nth sx n scalar_add_raw (XLc Integers.Int64.zero)
     : forall _ : nat, sx

Arguments scalar_add_raw_sigma n%nat_scope
scalar_add_overflow_sx = scalar_bind scalar_add_raw_sigma (XIc Integers.Int.zero) scalar_overflow_return
     : sx
scalar_add_flag = XL2I (XLb Badd scalar_add_high3 (XI2L Ctypes.Signed scalar_add_overflow_sx))
     : sx
scalar_add_reduction_sigma =
fun n : nat =>
match PeanoNat.Nat.eqb n (S (S (S (S O)))) return sx with
| true => XI2L Ctypes.Signed scalar_add_flag
| false => scalar_add_raw_sigma n
end
     : forall _ : nat, sx

Arguments scalar_add_reduction_sigma n%nat_scope
scalar_add_instantiate = scalar_bind scalar_add_reduction_sigma scalar_add_flag
     : forall _ : sx, sx

Arguments scalar_add_instantiate x
scalar_add_raw_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) (n : nat) =>
il (den rho layout (scalar_add_raw_sigma n))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : nat),
       Integers.Int64.int

Arguments scalar_add_raw_rho (rho layout)%function_scope n%nat_scope
scalar_add_reduction_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) (n : nat) =>
il (den rho layout (scalar_add_reduction_sigma n))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : nat),
       Integers.Int64.int

Arguments scalar_add_reduction_rho (rho layout)%function_scope n%nat_scope
scalar_add_second_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (n : nat) => rho (Nat.add (S (S (S (S O)))) n)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments scalar_add_second_rho rho%function_scope n%nat_scope
scalar_add_input_value =
fun rho : forall _ : nat, Integers.Int64.int =>
BinInt.Z.add (scalar_limb_value rho) (scalar_limb_value (scalar_add_second_rho rho))
     : forall _ : forall _ : nat, Integers.Int64.int, BinNums.Z

Arguments scalar_add_input_value rho%function_scope
scalar_add_raw_value =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) =>
scalar_limb_value (scalar_add_raw_rho rho layout)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z), BinNums.Z

Arguments scalar_add_raw_value (rho layout)%function_scope
scalar_add_carry_value =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) =>
Integers.Int64.unsigned (il (den rho layout scalar_add_high3))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z), BinNums.Z

