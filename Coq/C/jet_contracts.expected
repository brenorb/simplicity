        (@Word.fill (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit) n0 term
           (@jet_pad_bit_spec.AC.comp (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) term
              (@jet_pad_bit_spec.AC.unit (Ty.Sum Ty.Unit Ty.Unit) term) (@Bit.true Ty.Unit term)))
        (left_pad_high_1_n n0 term)
  end
