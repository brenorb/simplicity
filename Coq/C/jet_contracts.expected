Arguments ctx8_finalize_block_spec {term}
ctx8_finalize_spec =
fun term : Alg.Assertion.Algebra =>
@jet_core_pad_spec.AC.comp sha256_ctx8_type
  (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Alg.Assertion.toCore term)
  (@jet_core_pad_spec.AC.pair sha256_ctx8_type
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     (Word.Word (S (S (S (S (S (S O))))))) (Alg.Assertion.toCore term) (@ctx8_finalize_pad_spec term)
     (@ctx8_bitlen_spec (Alg.Assertion.toCore term)))
  (@jet_core_pad_spec.AC.comp
     (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
        (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Alg.Assertion.toCore term)
     (@ctx8_finalize_block_spec (Alg.Assertion.toCore term)) (@SHA256.hashBlock (Alg.Assertion.toCore term)))
     : forall term : Alg.Assertion.Algebra,
       Alg.Assertion.domain term sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments ctx8_finalize_spec {term}
zero64 = @Word.zero (S (S (S (S (S (S O)))))) Alg.CoreFunSem tt
     : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))
pad8_bytes =
vector_values (Word.Word (S (S (S O)))) (S (S (S O))) pad_word64
     : list (Ty.tySem (Word.Word (S (S (S O)))))
sha_stream =
fun (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int) (c : BinNums.Z)
  (bs : list (Ty.tySem (Word.Word (S (S (S O)))))) =>
let l' : list (Ty.tySem (Word.Word (S (S (S O))))) :=
  @fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb l regs bs) in
let total : BinNums.Z :=
  BinInt.Z.add c
    (BinInt.Z.div
       (BinInt.Z.add (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) l))
          (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) bs)))
       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) in
@snd (list Integers.Int.int) (list Integers.Int.int)
  (absorb_i (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value l')
     (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb l regs bs))
     (sha_pad
        (Integers.Int64.repr
           (BinInt.Z.add
              (BinInt.Z.mul
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                 total) (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) l'))))))
     : forall (_ : list (Ty.tySem (Word.Word (S (S (S O)))))) (_ : list Integers.Int.int) (_ : BinNums.Z)
         (_ : list (Ty.tySem (Word.Word (S (S (S O)))))), list Integers.Int.int

Arguments sha_stream (l regs)%list_scope c%Z_scope bs%list_scope
mk_hash256 =
fun rs : list Integers.Int.int =>
Digest.Hash256
  (@List.firstn Integers.Int.int (S (S (S (S (S (S (S (S O))))))))
