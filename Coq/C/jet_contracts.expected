     : forall (height : bool) (jet : Clight.function) (fid : AST.ident) (f : Clight.function)
         (_ : @eq (option Values.block)
                (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv bitcoin_ge) fid)
                (@Some Values.block (bitcoin_symbol_block fid)))
         (_ : @eq (option Clight.fundef)
                (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv bitcoin_ge)
                   (Values.Vptr (bitcoin_symbol_block fid) Integers.Ptrofs.zero))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))
         (_ : jet_bitcoin_wrapper.bitcoin_wrapper_shape jet (bitcoin_check_lock_rest fid))
         (_ : forall bl : Values.block,
              @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) fid (bitcoin_version_locals bl))
                (@None (prod Values.block Ctypes.type)))
         (_ : forall (m : Memory.Mem.mem) (bt : Values.block) (tbase : BinNums.Z) (b : bool)
                (lt : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 tbase)
                (_ : BinInt.Z.le
                       (BinInt.Z.add tbase
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                       Integers.Ptrofs.max_unsigned)
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint8unsigned m bt
                          (BinInt.Z.add tbase
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                       (@Some Values.val (Values.Vint (bool_int b))))
                (_ : @eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m bt
                          (BinInt.Z.add tbase
                             (BinNums.Zpos
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO
                                         (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                       (@Some Values.val (Values.Vlong lt))),
              ClightBigstep.Clight2.eval_funcall bitcoin_ge m (@Ctypes.Internal Clight.function f)
                (@cons Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase)) (@nil Values.val)) Events.E0 m
                (Values.Vlong
                   (lock_result b
                      match height return bool with
                      | true => Integers.Int64.ltu lt lock_threshold
                      | false => negb (Integers.Int64.ltu lt lock_threshold)
                      end lt)))
         (_ : @eq Ctypes.type (Clight.type_of_fundef (@Ctypes.Internal Clight.function f)) lock_fn_type),
       application_jet_partial_spec jet bitcoin_ge Bitcoin.Bitcoin.env (Word.Word (S (S (S (S (S O)))))) Ty.Unit
         bitcoin_check_lock_env_rep
         (fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : Bitcoin.Bitcoin.env) =>
          @bitcoin_check_lock_program height
            (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) a environment)
lockHeight_exec
     : forall (m : Memory.Mem.mem) (bt : Values.block) (tbase : BinNums.Z) (b : bool) (lt : Integers.Int64.int)
         (_ : BinInt.Z.le BinNums.Z0 tbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add tbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
