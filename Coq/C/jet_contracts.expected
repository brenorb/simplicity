divides_word_spec_numeric
     : forall (n : nat) (x y : Ty.tySem (Word.Word n)),
       @eq bool
         (Bit.toBool
            (@divides_word_spec n Alg.CoreFunSem (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)))
         (divides_numeric (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
divides8_bit_numeric
     : forall r t : Integers.Int.int,
       @eq bool (divides8_bit r t)
         (divides_numeric (Integers.Int.unsigned (jet_add8.add8_u r)) (Integers.Int.unsigned (jet_add8.add8_u t)))
divides8_denotes
     : forall w z : Integers.Int64.int,
       @eq bool (divides8_bit (jet_read8.read8_result w) (jet_read8.read8_result z))
         (Bit.toBool
            (@divides_word_spec (S (S (S O))) Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))
                  (decode_word8 w) (decode_word8 z))))
wide_divides_bit_numeric
     : forall r t : Integers.Int64.int,
       @eq bool (wide_divides_bit r t) (divides_numeric (Integers.Int64.unsigned r) (Integers.Int64.unsigned t))
divides_int64_denotes
     : forall (n : nat) (x y : Ty.tySem (Word.Word n)) (r t : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y)),
       @eq bool (wide_divides_bit r t)
         (Bit.toBool
            (@divides_word_spec n Alg.CoreFunSem (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)))
exec_divides8_choose
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r t : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _x le)
                (@Some Values.val
                   (Values.Vint
                      (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) r))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _y le)
                (@Some Values.val
                   (Values.Vint
                      (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) t)))),
       ClightBigstep.Clight2.exec_stmt ge0 e le m divides8_choose Events.E0
         (@Maps.PTree.set Values.val _t'3 (Values.Vint (division8_raw true t r)) le) m ClightBigstep.Out_normal
eval_divides8_test_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r t : Integers.Int.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _t'3 le)
                (@Some Values.val (Values.Vint (division8_raw true t r)))),
       Clight.eval_expr ge0 e le m divides8_test_expr (Values.Vint (bit_int (divides8_bit r t)))
exec_wide_divides_choose
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r t : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _x le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _y le) (@Some Values.val (Values.Vlong t))),
       ClightBigstep.Clight2.exec_stmt ge0 e le m wide_divides_choose Events.E0
         (@Maps.PTree.set Values.val _t'3 (Values.Vlong (division_wide_raw true t r)) le) m ClightBigstep.Out_normal
eval_wide_divides_test_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r t : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _t'3 le)
                (@Some Values.val (Values.Vlong (division_wide_raw true t r)))),
       Clight.eval_expr ge0 e le m wide_divides_test_expr (Values.Vint (bit_int (wide_divides_bit r t)))
divides8_body
     : @eq Clight.statement (Clight.fn_body f_simplicity_divides_8)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar _src (Ctypes.Tstruct _frameItem Ctypes.noattr))
               (Clight.Etempvar _src (Ctypes.Tstruct _frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (binary8_read _t'1)
                  (Clight.Sset _x (Clight.Ecast (Clight.Etempvar _t'1 Ctypesdefs.tuchar) Ctypesdefs.tuchar)))
               (Clight.Ssequence
                  (Clight.Ssequence (binary8_read _t'2)
                     (Clight.Sset _y (Clight.Ecast (Clight.Etempvar _t'2 Ctypesdefs.tuchar) Ctypesdefs.tuchar)))
                  (Clight.Ssequence
                     (Clight.Ssequence divides8_choose
                        (jet_arith8_layout_exec.frame_writer_call _writeBit Ctypesdefs.tbool Ctypesdefs.tbool
                           divides8_test_expr))
                     (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))))
eval_divides8_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc mr mr2 me mf : Memory.Mem.mem)
         (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (r t : Integers.Int.int) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
