scalar_set_raw_state =
match scalar_set_raw_tree return sstate with
| Some r =>
    match r return sstate with
    | RDone state _ => state
    | RIf _ _ _ => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
    end
| None => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
end
     : sstate
scalar_set_raw_expressions =
@List.map cell sx (fun c : cell => match cval c return sx with
                                   | Some x => x
                                   | None => XLc Integers.Int64.zero
                                   end) (cells0 scalar_set_raw_state)
     : list sx
scalar_set_raw_sigma =
fun n : nat => @List.nth sx n scalar_set_raw_expressions (XLc Integers.Int64.zero)
     : forall _ : nat, sx

Arguments scalar_set_raw_sigma n%nat_scope
scalar_set_flag = scalar_bind scalar_set_raw_sigma (XIc Integers.Int.zero) scalar_overflow_return
     : sx
scalar_set_sigma =
fun n : nat =>
match PeanoNat.Nat.eqb n (S (S (S (S O)))) return sx with
| true => XI2L Ctypes.Signed scalar_set_flag
| false => scalar_set_raw_sigma n
end
     : forall _ : nat, sx

Arguments scalar_set_sigma n%nat_scope
scalar_set_instantiate = scalar_bind scalar_set_sigma scalar_set_flag
     : forall _ : sx, sx

Arguments scalar_set_instantiate x
scalar_set_raw_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z) (n : nat) =>
il (den rho layout (scalar_set_raw_sigma n))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : nat),
       Integers.Int64.int

