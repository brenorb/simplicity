               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               k)) k
copy_read_prefix_words
     : forall (n q : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 n) (_ : and (BinInt.Z.le BinNums.Z0 q) (BinInt.Z.le q n)),
       BinInt.Z.le (frame_words (BinInt.Z.add (read_padding n) q)) (frame_words n)
copy_buffers_separated_of_rep
     : forall (m : Memory.Mem.mem) (L : bm_layout) (s : RunState) (count : BinNums.Z) (_ : bm_rep m L s)
         (_ : bm_separated L s)
         (_ : and (BinInt.Z.le BinNums.Z0 count)
                (BinInt.Z.le count (BinInt.Z.of_nat (@length Cell (nextData (activeReadFrame s)))))),
       jet_copy_buffers_separated (frames_blk L) (cells_blk L) (cells_blk L) (edge_ofs (active_read_loc L))
         (edge_ofs (active_write_loc L)) (BinInt.Z.of_nat (writeEmpty (activeWriteFrame s)))
         (BinInt.Z.add (read_padding (read_size (activeReadFrame s)))
            (BinInt.Z.of_nat (@length Cell (prevData (activeReadFrame s))))) count
@jet_context_separated ?A ?B
     : forall (f : Clight.function) (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg ?A ?B)
         (_ : @Alg.Core.Parametric ?A ?B t)
         (_ : jet_separated_local_spec f ?A ?B (fun a : Ty.tySem ?A => t Alg.CoreFunSem a))
         (_ : le (S O) (bitSize ?B)) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout)
         (ctx : Context) (a : Ty.tySem ?A),
       let s0 : RunState := fillContext ctx (Build_LocalState (@encode ?A a) (newWriteFrame (bitSize ?B))) in
       let s1 : RunState :=
         fillContext ctx (Build_LocalState (@encode ?A a) (fullWriteFrame (@encode ?B (t Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f)
               (jet_args env L) Events.E0 mf (Values.Vint Integers.Int.one))
            (and (bm_rep mf L s1) (runProgram (t Naive.translate) (Running s0) (Running s1))))
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
copy_frame_entry
