       and
         (fe_limbs_ok (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S O)))
            (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S (S O))))
            (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S (S (S O)))))
            (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S (S (S (S O))))))
            (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S (S (S (S (S O))))))))
         (@eq BinNums.Z
            (fe_val (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S O)))
               (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S (S O))))
               (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S (S (S O)))))
               (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S (S (S (S O))))))
               (Integers.Int64.unsigned (write_fe_rho value BinNums.Z0 (S (S (S (S (S O)))))))) value)
point_canonical_field_bounded
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
