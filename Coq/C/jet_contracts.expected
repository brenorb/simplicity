orb_hi =
fun ha hb : BinNums.Z =>
BinInt.Z.sub
  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
     (BinInt.Z.add (BinInt.Z.log2 (BinInt.Z.max ha hb)) (BinNums.Zpos BinNums.xH))) (BinNums.Zpos BinNums.xH)
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments orb_hi (ha hb)%Z_scope
zb_op =
fun (mx : BinNums.Z) (o : bop) (la ha lb hb : BinNums.Z) =>
match o return (option (prod BinNums.Z BinNums.Z)) with
| Badd =>
    match BinInt.Z.leb (BinInt.Z.add ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z (BinInt.Z.add la lb) (BinInt.Z.add ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| Bsub =>
    match BinInt.Z.leb BinNums.Z0 (BinInt.Z.sub la hb) return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z (BinInt.Z.sub la hb) (BinInt.Z.sub ha lb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| Bmul =>
    match BinInt.Z.leb (BinInt.Z.mul ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true =>
        @Some (prod BinNums.Z BinNums.Z)
          (@pair BinNums.Z BinNums.Z (BinInt.Z.mul (BinInt.Z.max BinNums.Z0 la) (BinInt.Z.max BinNums.Z0 lb))
             (BinInt.Z.mul ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| Band => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinInt.Z.min ha hb))
| Bor =>
    match BinInt.Z.leb (orb_hi ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (orb_hi ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| Bxor =>
    match BinInt.Z.leb (orb_hi ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (orb_hi ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
end
     : forall (_ : BinNums.Z) (_ : bop) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       option (prod BinNums.Z BinNums.Z)

Arguments zb_op mx%Z_scope o (la ha lb hb)%Z_scope
zb_sh =
fun (w mx : BinNums.Z) (o : shop) (la ha k : BinNums.Z) =>
match andb (BinInt.Z.leb BinNums.Z0 k) (BinInt.Z.ltb k w) return (option (prod BinNums.Z BinNums.Z)) with
| true =>
    match o return (option (prod BinNums.Z BinNums.Z)) with
    | Hshl =>
        match
          BinInt.Z.leb (BinInt.Z.mul ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)) mx
          return (option (prod BinNums.Z BinNums.Z))
        with
        | true =>
            @Some (prod BinNums.Z BinNums.Z)
              (@pair BinNums.Z BinNums.Z (BinInt.Z.mul la (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
                 (BinInt.Z.mul ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
        | false => @None (prod BinNums.Z BinNums.Z)
        end
    | Hshr =>
        match
          BinInt.Z.ltb ha
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.sub w (BinNums.Zpos BinNums.xH)))
          return (option (prod BinNums.Z BinNums.Z))
        with
        | true =>
            @Some (prod BinNums.Z BinNums.Z)
              (@pair BinNums.Z BinNums.Z (BinInt.Z.div la (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
                 (BinInt.Z.div ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
        | false => @None (prod BinNums.Z BinNums.Z)
        end
    | Hshru =>
        @Some (prod BinNums.Z BinNums.Z)
          (@pair BinNums.Z BinNums.Z (BinInt.Z.div la (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
             (BinInt.Z.div ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
    end
| false => @None (prod BinNums.Z BinNums.Z)
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : shop) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       option (prod BinNums.Z BinNums.Z)

Arguments zb_sh (w mx)%Z_scope o (la ha k)%Z_scope
zb =
fix zb (bnd : forall _ : nat, prod BinNums.Z BinNums.Z) (x : sx) {struct x} : option (prod BinNums.Z BinNums.Z) :=
  match x return (option (prod BinNums.Z BinNums.Z)) with
  | XI _ => @None (prod BinNums.Z BinNums.Z)
  | XIc i =>
      @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z (Integers.Int.unsigned i) (Integers.Int.unsigned i))
  | XL _ => @None (prod BinNums.Z BinNums.Z)
  | XLc l =>
      @Some (prod BinNums.Z BinNums.Z)
        (@pair BinNums.Z BinNums.Z (Integers.Int64.unsigned l) (Integers.Int64.unsigned l))
  | XLv n => @Some (prod BinNums.Z BinNums.Z) (bnd n)
  | XV _ => @None (prod BinNums.Z BinNums.Z)
  | XA _ _ => @None (prod BinNums.Z BinNums.Z)
  | XP _ _ => @None (prod BinNums.Z BinNums.Z)
  | XIb o a b =>
      match andb (isk KI a) (isk KI b) return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair lb hb => zb_op M32 o la ha lb hb
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XLb o a b =>
      match andb (isk KL a) (isk KL b) return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair lb hb => zb_op M64 o la ha lb hb
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XIsh o a k =>
      match isk KI a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  zb_sh (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) M32
                    o la ha k
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XLsh o a k =>
      match isk KL a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  zb_sh
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) M64 o
                    la ha k
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XIcmp _ sg a b =>
      match andb (isk KI a) (isk KI b) return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair _ ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair _ hb =>
                          match sg return (option (prod BinNums.Z BinNums.Z)) with
                          | Ctypes.Signed =>
                              match
                                andb
                                  (BinInt.Z.ltb ha
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                  (BinInt.Z.ltb hb
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                return (option (prod BinNums.Z BinNums.Z))
                              with
                              | true =>
                                  @Some (prod BinNums.Z BinNums.Z)
                                    (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                              | false => @None (prod BinNums.Z BinNums.Z)
                              end
                          | Ctypes.Unsigned =>
                              @Some (prod BinNums.Z BinNums.Z)
                                (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                          end
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XLcmp _ sg a b =>
      match andb (isk KL a) (isk KL b) return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair _ ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair _ hb =>
                          match sg return (option (prod BinNums.Z BinNums.Z)) with
                          | Ctypes.Signed =>
                              match
                                andb
                                  (BinInt.Z.ltb ha
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos
                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                  (BinInt.Z.ltb hb
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos
                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                return (option (prod BinNums.Z BinNums.Z))
                              with
                              | true =>
                                  @Some (prod BinNums.Z BinNums.Z)
                                    (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                              | false => @None (prod BinNums.Z BinNums.Z)
                              end
                          | Ctypes.Unsigned =>
                              @Some (prod BinNums.Z BinNums.Z)
                                (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                          end
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XI2L sg a =>
      match isk KI a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match sg return (option (prod BinNums.Z BinNums.Z)) with
                  | Ctypes.Signed =>
                      match
                        BinInt.Z.ltb ha
                          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                             (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                        return (option (prod BinNums.Z BinNums.Z))
                      with
                      | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z la ha)
                      | false => @None (prod BinNums.Z BinNums.Z)
                      end
                  | Ctypes.Unsigned => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z la ha)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XL2I a =>
      match isk KL a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match BinInt.Z.leb ha M32 return (option (prod BinNums.Z BinNums.Z)) with
                  | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z la ha)
                  | false => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 M32)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XIcast sz sg a =>
      match sz return (option (prod BinNums.Z BinNums.Z)) with
      | Ctypes.I8 =>
          match sg return (option (prod BinNums.Z BinNums.Z)) with
          | Ctypes.Signed => @None (prod BinNums.Z BinNums.Z)
          | Ctypes.Unsigned =>
              match isk KI a return (option (prod BinNums.Z BinNums.Z)) with
              | true =>
                  match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
                  | Some _ =>
                      @Some (prod BinNums.Z BinNums.Z)
                        (@pair BinNums.Z BinNums.Z BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              | false => @None (prod BinNums.Z BinNums.Z)
              end
          end
      | Ctypes.I16 =>
          match sg return (option (prod BinNums.Z BinNums.Z)) with
          | Ctypes.Signed => @None (prod BinNums.Z BinNums.Z)
          | Ctypes.Unsigned =>
              match isk KI a return (option (prod BinNums.Z BinNums.Z)) with
              | true =>
                  match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
                  | Some _ =>
                      @Some (prod BinNums.Z BinNums.Z)
                        (@pair BinNums.Z BinNums.Z BinNums.Z0
                           (BinNums.Zpos
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI
                                                                  (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              | false => @None (prod BinNums.Z BinNums.Z)
              end
          end
      | Ctypes.I32 => @None (prod BinNums.Z BinNums.Z)
      | Ctypes.IBool => @None (prod BinNums.Z BinNums.Z)
      end
  | XInz a =>
      match isk KI a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some _ => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XLnz a =>
      match isk KL a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some _ => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XIz a =>
      match isk KI a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some _ => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XLz a =>
      match isk KL a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some _ => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XIneg _ => @None (prod BinNums.Z BinNums.Z)
  | XLneg _ => @None (prod BinNums.Z BinNums.Z)
  | XInot _ => @None (prod BinNums.Z BinNums.Z)
  | XLnot _ => @None (prod BinNums.Z BinNums.Z)
  end
     : forall (_ : forall _ : nat, prod BinNums.Z BinNums.Z) (_ : sx), option (prod BinNums.Z BinNums.Z)

Arguments zb bnd%function_scope x
zrho =
fun (ρ : forall _ : nat, Integers.Int64.int) (n : nat) => Integers.Int64.unsigned (ρ n)
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), BinNums.Z

Arguments zrho ρ%function_scope n%nat_scope
zgood =
fun (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z) (x : sx) =>
match ktop x return Prop with
| KI => @eq BinNums.Z (Integers.Int.unsigned (ii (den ρ β x))) (zval (zrho ρ) x)
| KL => @eq BinNums.Z (Integers.Int64.unsigned (il (den ρ β x))) (zval (zrho ρ) x)
| KP => True
| KA => True
| KV => True
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : sx), Prop

Arguments zgood (ρ β)%function_scope x
Record outpoint : Set := Build_outpoint { opHash : Digest.hash256;  opIndex : Integers.Int.int }.

outpoint has primitive projections with eta conversion.
Arguments Bitcoin.Build_outpoint opHash opIndex
Record sigTxInput : Set := Build_sigTxInput
  { sigTxiPreviousOutpoint : Bitcoin.outpoint;
    sigTxiValue : Integers.Int64.int;
    sigTxiSequence : Integers.Int.int;
    sigTxiValue_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) (Integers.Int64.signed sigTxiValue))
                          (BinInt.Z.lt (Integers.Int64.signed sigTxiValue) (BinInt.Z.succ Bitcoin.MAX_MONEY)) }.

sigTxInput has primitive projections with eta conversion.
Arguments Bitcoin.Build_sigTxInput sigTxiPreviousOutpoint sigTxiValue sigTxiSequence sigTxiValue_bound
Record txOutput : Set := Build_txOutput
  { txoValue : Integers.Int64.int;
    txoScript : Bitcoin.script;
    txoValue_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) (Integers.Int64.signed txoValue))
                       (BinInt.Z.lt (Integers.Int64.signed txoValue) (BinInt.Z.succ Bitcoin.MAX_MONEY));
    txoScript_bound : BinInt.Z.lt (@Zcomplements.Zlength Integers.Byte.int txoScript) Integers.Int.modulus }.

txOutput has primitive projections with eta conversion.
Arguments Bitcoin.Build_txOutput txoValue txoScript txoValue_bound txoScript_bound
Record sigTx : Set := Build_sigTx
  { sigTxVersion : Integers.Int.int;
    sigTxIn : list Bitcoin.sigTxInput;
    sigTxOut : list Bitcoin.txOutput;
    sigTxLock : Bitcoin.lock;
    sigTxInBounds : and (BinInt.Z.lt BinNums.Z0 (@Zcomplements.Zlength Bitcoin.sigTxInput sigTxIn))
                      (BinInt.Z.lt (@Zcomplements.Zlength Bitcoin.sigTxInput sigTxIn) Integers.Int.modulus);
    sigTxOutBounds : and (BinInt.Z.lt BinNums.Z0 (@Zcomplements.Zlength Bitcoin.txOutput sigTxOut))
                       (BinInt.Z.lt (@Zcomplements.Zlength Bitcoin.txOutput sigTxOut) Integers.Int.modulus);
    sigTxTotalInValue := List.Z_sum
                           (@List.map Bitcoin.sigTxInput BinNums.Z
                              (fun i : Bitcoin.sigTxInput => Integers.Int64.signed (Bitcoin.sigTxiValue i)) sigTxIn);
    sigTxTotalOutValue := List.Z_sum
                            (@List.map Bitcoin.txOutput BinNums.Z
                               (fun i : Bitcoin.txOutput => Integers.Int64.signed (Bitcoin.txoValue i)) sigTxOut);
    sigTxFee := BinInt.Z.sub sigTxTotalOutValue sigTxTotalInValue;
    sigTxTotalInValue_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) sigTxTotalInValue)
                                (BinInt.Z.lt sigTxTotalInValue (BinInt.Z.succ Bitcoin.MAX_MONEY));
    sigTxTotalOutValue_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) sigTxTotalOutValue)
                                 (BinInt.Z.lt sigTxTotalOutValue (BinInt.Z.succ Bitcoin.MAX_MONEY));
    sigTxFee_bound : and (BinInt.Z.lt (BinNums.Zneg BinNums.xH) sigTxFee)
                       (BinInt.Z.lt sigTxFee (BinInt.Z.succ Bitcoin.MAX_MONEY)) }.

sigTx has primitive projections with eta conversion.
Arguments Bitcoin.Build_sigTx sigTxVersion (sigTxIn sigTxOut)%list_scope sigTxLock sigTxInBounds
  sigTxOutBounds sigTxTotalInValue_bound sigTxTotalOutValue_bound sigTxFee_bound
Bitcoin.sigTxTotalInValue =
fun s : Bitcoin.sigTx =>
List.Z_sum
  (@List.map Bitcoin.sigTxInput BinNums.Z (fun i : Bitcoin.sigTxInput => Integers.Int64.signed (Bitcoin.sigTxiValue i))
     (Bitcoin.sigTxIn s))
     : forall _ : Bitcoin.sigTx, BinNums.Z

Arguments Bitcoin.sigTxTotalInValue s
Bitcoin.sigTxTotalOutValue =
fun s : Bitcoin.sigTx =>
List.Z_sum
  (@List.map Bitcoin.txOutput BinNums.Z (fun i : Bitcoin.txOutput => Integers.Int64.signed (Bitcoin.txoValue i))
     (Bitcoin.sigTxOut s))
     : forall _ : Bitcoin.sigTx, BinNums.Z

Arguments Bitcoin.sigTxTotalOutValue s
Bitcoin.sigTxFee =
fun s : Bitcoin.sigTx =>
BinInt.Z.sub
  (List.Z_sum
     (@List.map Bitcoin.txOutput BinNums.Z (fun i : Bitcoin.txOutput => Integers.Int64.signed (Bitcoin.txoValue i))
        (Bitcoin.sigTxOut s)))
  (List.Z_sum
     (@List.map Bitcoin.sigTxInput BinNums.Z
        (fun i : Bitcoin.sigTxInput => Integers.Int64.signed (Bitcoin.sigTxiValue i)) (Bitcoin.sigTxIn s)))
     : forall _ : Bitcoin.sigTx, BinNums.Z

Arguments Bitcoin.sigTxFee s
Record environment : Set := Build_environment
  { envTx : Bitcoin.sigTx;
    envIx : nat;
    envScriptCMR : Digest.hash256;
    envIxBounded : lt envIx (@length Bitcoin.sigTxInput (Bitcoin.sigTxIn envTx)) }.

environment has primitive projections with eta conversion.
Arguments Bitcoin.Bitcoin.Build_environment envTx [envIx]%nat_scope envScriptCMR envIxBounded
Bitcoin.putInt64le =
fun x : Integers.Int64.int =>
let z : BinNums.Z := Integers.Int64.unsigned x in
@List.map nat Integers.Byte.int
  (fun i : nat => Integers.Byte.repr (BinInt.Z.div z (Zpower.two_power_nat (Nat.mul i Integers.Byte.wordsize))))
  (List.seq O (S (S (S (S (S (S (S (S O)))))))))
     : forall _ : Integers.Int64.int, list Integers.Byte.int

Arguments Bitcoin.putInt64le x
Bitcoin.putInt32le =
fun x : Integers.Int.int =>
let z : BinNums.Z := Integers.Int.unsigned x in
@List.map nat Integers.Byte.int
  (fun i : nat => Integers.Byte.repr (BinInt.Z.div z (Zpower.two_power_nat (Nat.mul i Integers.Byte.wordsize))))
  (List.seq O (S (S (S (S O)))))
     : forall _ : Integers.Int.int, list Integers.Byte.int

Arguments Bitcoin.putInt32le x
Bitcoin.putOutpoint =
fun x : Bitcoin.outpoint =>
@app Integers.Byte.int (Bitcoin.putHash256 (Bitcoin.opHash x)) (Bitcoin.putInt32le (Bitcoin.opIndex x))
     : forall _ : Bitcoin.outpoint, list Integers.Byte.int

Arguments Bitcoin.putOutpoint x
