scalar_reduce512_log_shift64
     : @eq (list event) (slog scalar_reduce512_state)
         (@List.repeat event (mkev O (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))) O (@nil sx))
            (S (S (S (S (S (S O)))))))
scalar_reduce512_limbs_length
     : @eq nat (@length sx scalar_reduce512_limbs) (S (S (S (S O))))
scalar_reduce512_limbs_kind
