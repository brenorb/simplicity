cell_allocb =
fun (sz : BinNums.Z) (c : cell) =>
andb
  (andb (BinInt.Z.leb (BinInt.Z.add (cofs c) (Memdata.size_chunk (cchunk c))) sz)
     (BinInt.Z.eqb (BinInt.Z.modulo (cofs c) (Memdata.align_chunk (cchunk c))) BinNums.Z0))
  match cval c return bool with
  | Some _ => false
  | None => true
  end
     : forall (_ : BinNums.Z) (_ : cell), bool

