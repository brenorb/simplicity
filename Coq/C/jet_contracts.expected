b2z =
fun b : bool => match b return BinNums.Z with
                | true => BinNums.Zpos BinNums.xH
                | false => BinNums.Z0
                end
     : forall _ : bool, BinNums.Z

Arguments b2z b%bool_scope
zcmp =
fun (c : Integers.comparison) (a b : BinNums.Z) =>
match c return bool with
| Integers.Ceq => BinInt.Z.eqb a b
| Integers.Cne => negb (BinInt.Z.eqb a b)
| Integers.Clt => BinInt.Z.ltb a b
| Integers.Cle => negb (BinInt.Z.ltb b a)
| Integers.Cgt => BinInt.Z.ltb b a
| Integers.Cge => negb (BinInt.Z.ltb a b)
end
     : forall (_ : Integers.comparison) (_ : BinNums.Z) (_ : BinNums.Z), bool

Arguments zcmp c (a b)%Z_scope
zop =
fun (o : bop) (a b : BinNums.Z) =>
match o return BinNums.Z with
| Badd => BinInt.Z.add a b
| Bsub => BinInt.Z.sub a b
| Bmul => BinInt.Z.mul a b
| Band => BinInt.Z.land a b
| Bor => BinInt.Z.lor a b
| Bxor => BinInt.Z.lxor a b
end
     : forall (_ : bop) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments zop o (a b)%Z_scope
zval =
fix zval (ρ : forall _ : nat, BinNums.Z) (x : sx) {struct x} : BinNums.Z :=
  match x return BinNums.Z with
  | XI i => Integers.Int.unsigned i
  | XIc i => Integers.Int.unsigned i
  | XL l => Integers.Int64.unsigned l
  | XLc l => Integers.Int64.unsigned l
  | XLv n => ρ n
  | XV _ => BinNums.Z0
  | XA _ _ => BinNums.Z0
  | XP _ _ => BinNums.Z0
  | XIb o a b => zop o (zval ρ a) (zval ρ b)
  | XLb o a b => zop o (zval ρ a) (zval ρ b)
  | XIsh o a k =>
      match o return BinNums.Z with
      | Hshl => BinInt.Z.mul (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | Hshr => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | Hshru => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      end
  | XLsh o a k =>
      match o return BinNums.Z with
      | Hshl => BinInt.Z.mul (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | Hshr => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | Hshru => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      end
  | XIcmp c _ a b => b2z (zcmp c (zval ρ a) (zval ρ b))
  | XLcmp c _ a b => b2z (zcmp c (zval ρ a) (zval ρ b))
  | XI2L _ a => zval ρ a
  | XL2I a =>
      BinInt.Z.modulo (zval ρ a)
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  | XIcast sz sg a =>
      match sz return BinNums.Z with
      | Ctypes.I8 =>
          match sg return BinNums.Z with
          | Ctypes.Signed => zval ρ a
          | Ctypes.Unsigned =>
              BinInt.Z.modulo (zval ρ a)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
          end
      | Ctypes.I16 =>
          match sg return BinNums.Z with
          | Ctypes.Signed => zval ρ a
          | Ctypes.Unsigned =>
              BinInt.Z.modulo (zval ρ a)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
          end
      | Ctypes.I32 => zval ρ a
      | Ctypes.IBool => zval ρ a
      end
  | XInz a => b2z (negb (BinInt.Z.eqb (zval ρ a) BinNums.Z0))
  | XLnz a => b2z (negb (BinInt.Z.eqb (zval ρ a) BinNums.Z0))
  | XIz a => b2z (BinInt.Z.eqb (zval ρ a) BinNums.Z0)
  | XLz a => b2z (BinInt.Z.eqb (zval ρ a) BinNums.Z0)
  | XIneg _ => BinNums.Z0
  | XLneg _ => BinNums.Z0
  | XInot _ => BinNums.Z0
  | XLnot _ => BinNums.Z0
  end
     : forall (_ : forall _ : nat, BinNums.Z) (_ : sx), BinNums.Z

Arguments zval ρ%function_scope x
