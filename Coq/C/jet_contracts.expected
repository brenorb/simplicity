                         (BinInt.Z.modulo cursor
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                         old source)))), write_prefix_at m mf bw edge cursor
copy_input_cells_head
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (cells : list Cell)
         (_ : BinInt.Z.lt BinNums.Z0 (BinInt.Z.of_nat (@length Cell cells)))
