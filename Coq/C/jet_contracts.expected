full_subtract_representation_matches
     : forall (n : nat) (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (x y payload : Ty.tySem (Word.Word n))
         (_ : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ n) payload)
                (BinInt.Z.modulo
                   (BinInt.Z.sub
                      (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
                      (@Word.ToZ.Theory.toZ Word.BitToZ c)) (word_modulus n))),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word n)))
         (@pair (sum unit unit) (Ty.tySem (Word.Word n))
            match
              BinInt.Z.ltb
                (BinInt.Z.sub
                   (BinInt.Z.sub (@Word.ToZ.Theory.toZ (Word.WordToZ n) x) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
                   (@Word.ToZ.Theory.toZ Word.BitToZ c)) BinNums.Z0 return (sum unit unit)
            with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end payload)
         (@full_subtract_word_spec Alg.CoreFunSem n
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n))) c
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)))
borrow_short_circuit
     : forall (a b c : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 c),
       @eq bool (orb (BinInt.Z.ltb a b) (BinInt.Z.ltb (BinInt.Z.sub a b) c))
         (BinInt.Z.ltb (BinInt.Z.sub (BinInt.Z.sub a b) c) BinNums.Z0)
carrier_mod_difference_word
     : forall (n : nat) (carrier a b : BinNums.Z) (_ : BinInt.Z.lt BinNums.Z0 carrier)
         (_ : BinInt.Z.divide (word_modulus n) carrier),
       @eq BinNums.Z (BinInt.Z.modulo (BinInt.Z.sub (BinInt.Z.modulo a carrier) b) (word_modulus n))
         (BinInt.Z.modulo (BinInt.Z.sub a b) (word_modulus n))
full_subtract8_first_borrow_numeric
     : forall r t : Integers.Int.int,
       @eq bool (full_subtract8_first_borrow r t)
         (BinInt.Z.ltb (Integers.Int.unsigned (jet_add8.add8_u r)) (Integers.Int.unsigned (jet_add8.add8_u t)))
full_subtract8_borrow_numeric
     : forall (cin : bool) (r t : Integers.Int.int),
       @eq bool (full_subtract8_borrow cin r t)
         (BinInt.Z.ltb
            (BinInt.Z.sub
               (BinInt.Z.sub (Integers.Int.unsigned (jet_add8.add8_u r)) (Integers.Int.unsigned (jet_add8.add8_u t)))
               (Integers.Int.unsigned (bit_int cin))) BinNums.Z0)
full_subtract8_payload_numeric
     : forall (cin : bool) (r t : Integers.Int.int),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O))))
            (decode_word8 (Integers.Int64.repr (Integers.Int.unsigned (full_subtract8_payload cin r t)))))
         (BinInt.Z.modulo
            (BinInt.Z.sub
               (BinInt.Z.sub (Integers.Int.unsigned (jet_add8.add8_u r)) (Integers.Int.unsigned (jet_add8.add8_u t)))
               (Integers.Int.unsigned (bit_int cin))) (word_modulus (S (S (S O)))))
full_subtract8_values_denote_spec
     : forall (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (left right : Integers.Int64.int),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S O))))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S O)))))
            match
              full_subtract8_borrow (Bit.toBool c) (jet_read8.read8_result left) (jet_read8.read8_result right)
              return (sum unit unit)
            with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (decode_word8
               (Integers.Int64.repr
                  (Integers.Int.unsigned
                     (full_subtract8_payload (Bit.toBool c) (jet_read8.read8_result left)
                        (jet_read8.read8_result right))))))
         (@full_subtract_word_spec Alg.CoreFunSem (S (S (S O)))
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
               (prod (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))) c
               (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))
                  (decode_word8 left) (decode_word8 right))))
wide_full_subtract_borrow_numeric
     : forall (cin : bool) (r t : Integers.Int64.int),
       @eq bool (wide_full_subtract_borrow cin r t)
         (BinInt.Z.ltb
            (BinInt.Z.sub (BinInt.Z.sub (Integers.Int64.unsigned r) (Integers.Int64.unsigned t))
               (Integers.Int64.unsigned (bit_long cin))) BinNums.Z0)
wide_full_subtract_payload_numeric
     : forall (s : wide_size) (cin : bool) (r t : Integers.Int64.int),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s))
