                          jets_sha._t'11 jets_sha._t'12 jets_sha._t'8)
                       (Clight.Sreturn
                          (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr BinNums.Z0) Ctypesdefs.tint))))))))))
     : Clight.statement
cmp_res =
fun x y : Integers.Int.int =>
match Integers.Int.ltu x y return Integers.Int.int with
| true => Integers.Int.neg (Integers.Int.repr (BinNums.Zpos BinNums.xH))
| false => Integers.Int.repr (BinNums.Zpos BinNums.xH)
end
     : forall (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments cmp_res x y
cmp_model =
fix cmp_model (xs ys : list Integers.Int.int) {struct xs} : Integers.Int.int :=
  match xs return Integers.Int.int with
  | nil => Integers.Int.zero
  | cons x xs' =>
      match ys return Integers.Int.int with
      | nil => Integers.Int.zero
      | cons y ys' =>
          match Integers.Int.eq x y return Integers.Int.int with
          | true => cmp_model xs' ys'
          | false => cmp_res x y
          end
      end
  end
     : forall (_ : list Integers.Int.int) (_ : list Integers.Int.int), Integers.Int.int

Arguments cmp_model (xs ys)%list_scope
cmp_good =
fun (ba bb : Values.block) (oa ob : Integers.Ptrofs.int) (le : Clight.temp_env) =>
and (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._a le) (@Some Values.val (Values.Vptr ba oa)))
  (@eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._b le) (@Some Values.val (Values.Vptr bb ob)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : Integers.Ptrofs.int)
         (_ : Clight.temp_env), Prop

Arguments cmp_good ba bb oa ob le
be_val =
fix be_val (ws : list (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) : BinNums.Z :=
  match ws return BinNums.Z with
  | nil => BinNums.Z0
  | cons w ws' =>
      BinInt.Z.add
        (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) w)
           (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                 (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S (S (S O))))))) ws')))))
        (be_val ws')
  end
     : forall _ : list (Ty.tySem (Word.Word (S (S (S (S (S O))))))), BinNums.Z

Arguments be_val ws%list_scope
mext =
fun m m' : Memory.Mem.mem =>
and (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)
  (and
     (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b),
      @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
     (and
        (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
           (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
        (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (p : Memtype.permission)
           (_ : Memory.Mem.valid_access m ch b ofs p), Memory.Mem.valid_access m' ch b ofs p)))
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments mext m m'
