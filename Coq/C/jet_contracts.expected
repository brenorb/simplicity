         (fun (a : Ty.tySem Ty.Unit) (environment : ext_environment) =>
          @prim_words_hash_spec k w p (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)
            a environment)
