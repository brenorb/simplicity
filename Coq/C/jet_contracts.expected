         (os : Integers.Ptrofs.int) (bd : Values.block) (od : Integers.Ptrofs.int) (xs : list Integers.Int.int),
       let n : BinNums.Z := BinInt.Z.of_nat (@length Integers.Int.int xs) in
       forall (_ : BinInt.Z.lt BinNums.Z0 n)
         (_ : BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned os) n) Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned od) n) Integers.Ptrofs.max_unsigned)
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int xs)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bs
                   (BinInt.Z.add (Integers.Ptrofs.unsigned os) (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i xs Integers.Int.zero))))
         (_ : Memory.Mem.range_perm m bd (Integers.Ptrofs.unsigned od) (BinInt.Z.add (Integers.Ptrofs.unsigned od) n)
                Memtype.Cur Memtype.Writable) (_ : not (@eq Values.block bs bd)),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (Events.external_call
               (AST.EF_external
                  (String.String (Ascii.Ascii true false true true false true true false)
                     (String.String (Ascii.Ascii true false true false false true true false)
                        (String.String (Ascii.Ascii true false true true false true true false)
                           (String.String (Ascii.Ascii true true false false false true true false)
                              (String.String (Ascii.Ascii false false false false true true true false)
                                 (String.String (Ascii.Ascii true false false true true true true false)
                                    String.EmptyString)))))) memcpy_sig) ge
               (@cons Values.val (Values.Vptr bd od)
                  (@cons Values.val (Values.Vptr bs os)
                     (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val)))) m Events.E0
               (Values.Vptr bd od) m')
            (and
               (forall (i : nat) (_ : lt i (@length Integers.Int.int xs)),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint8unsigned m' bd
                     (BinInt.Z.add (Integers.Ptrofs.unsigned od) (BinInt.Z.of_nat i)))
                  (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i xs Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : or (not (@eq Values.block b bd))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) (Integers.Ptrofs.unsigned od))
                               (BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned od) n) ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
sha_memcpy_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv sha_ge) jets_sha._memcpy)
         (@Some Values.block (sha_symbol_block jets_sha._memcpy))
sha_memcpy_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv sha_ge)
            (Values.Vptr (sha_symbol_block jets_sha._memcpy) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function)
            (@Ctypes.External Clight.function
               (AST.EF_external
                  (String.String (Ascii.Ascii true false true true false true true false)
                     (String.String (Ascii.Ascii true false true false false true true false)
                        (String.String (Ascii.Ascii true false true true false true true false)
                           (String.String (Ascii.Ascii true true false false false true true false)
                              (String.String (Ascii.Ascii false false false false true true true false)
                                 (String.String (Ascii.Ascii true false false true true true true false)
                                    String.EmptyString)))))) memcpy_sig)
               (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tvoid)
                  (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tvoid) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)))
               (Ctypesdefs.tptr Ctypesdefs.tvoid) AST.cc_default))
sha_compression_uchar_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv sha_ge)
            jets_sha._sha256_compression_uchar)
         (@Some Values.block (sha_symbol_block jets_sha._sha256_compression_uchar))
sha_compression_uchar_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv sha_ge)
            (Values.Vptr (sha_symbol_block jets_sha._sha256_compression_uchar) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_sha.f_sha256_compression_uchar))
sha_max_counter_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv sha_ge) jets_sha._sha256_max_counter)
         (@Some Values.block (sha_symbol_block jets_sha._sha256_max_counter))
ctx_address
     : forall (base : BinNums.Z) (k : ctx_slot) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned),
       @eq BinNums.Z
         (Integers.Ptrofs.unsigned
            (Integers.Ptrofs.add (Integers.Ptrofs.repr base) (Integers.Ptrofs.repr (ctx_offset k))))
         (BinInt.Z.add base (ctx_offset k))
eval_ctx_field_lvalue
     : forall (k : ctx_slot) (id : BinNums.positive) (e : Clight.env) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bc : Values.block) (base : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base)))),
       Clight.eval_lvalue sha_ge e le m (ctx_field_expr k id) bc
         (Integers.Ptrofs.add (Integers.Ptrofs.repr base) (Integers.Ptrofs.repr (ctx_offset k))) Ctypes.Full
eval_ctx_field
     : forall (k : ctx_slot) (id : BinNums.positive) (e : Clight.env) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bc : Values.block) (base : BinNums.Z) (chunk : AST.memory_chunk)
         (v : Values.val) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq Ctypes.mode (Ctypes.access_mode (ctx_field_type k)) (Ctypes.By_value chunk))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (Memory.Mem.load chunk m bc (BinInt.Z.add base (ctx_offset k)))
                (@Some Values.val v)), Clight.eval_expr sha_ge e le m (ctx_field_expr k id) v
eval_ctx_block
     : forall (id : BinNums.positive) (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (bc : Values.block) (base : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base)))),
       Clight.eval_expr sha_ge e le m (ctx_field_expr SBlock id)
         (Values.Vptr bc
            (Integers.Ptrofs.add (Integers.Ptrofs.repr base)
               (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
exec_ctx_assign
     : forall (k : ctx_slot) (id : BinNums.positive) (e : Clight.env) (le : Maps.PTree.tree Values.val)
         (m m' : Memory.Mem.mem) (bc : Values.block) (base : BinNums.Z) (chunk : AST.memory_chunk)
         (a : Clight.expr) (v v' : Values.val) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq Ctypes.mode (Ctypes.access_mode (ctx_field_type k)) (Ctypes.By_value chunk))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : Clight.eval_expr sha_ge e le m a v)
         (_ : @eq (option Values.val) (Cop.sem_cast v (Clight.typeof a) (ctx_field_type k) m) (@Some Values.val v'))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.store chunk m bc (BinInt.Z.add base (ctx_offset k)) v')
                (@Some Memory.Mem.mem m')),
       ClightBigstep.Clight2.exec_stmt sha_ge e le m (Clight.Sassign (ctx_field_expr k id) a) Events.E0 le m'
         ClightBigstep.Out_normal
ptr_add_repr
     : forall B d sz k : BinNums.Z,
       @eq Integers.Ptrofs.int
         (Integers.Ptrofs.add (Integers.Ptrofs.repr (BinInt.Z.add B d))
            (Integers.Ptrofs.mul (Integers.Ptrofs.repr sz) (Integers.Ptrofs.repr k)))
         (Integers.Ptrofs.repr (BinInt.Z.add B (BinInt.Z.add d (BinInt.Z.mul sz k))))
ptr_add_repr1
     : forall B d k : BinNums.Z,
       @eq Integers.Ptrofs.int (Integers.Ptrofs.add (Integers.Ptrofs.repr (BinInt.Z.add B d)) (Integers.Ptrofs.repr k))
         (Integers.Ptrofs.repr (BinInt.Z.add B (BinInt.Z.add d k)))
xptradd_sound
     : forall (ge : Clight.genv) (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m : Memory.Mem.mem)
         (xa : sx) (ta : Ctypes.type) (xb : sx) (tb : Ctypes.type) (x : sx)
         (_ : @eq (option sx) (xptradd (Clight.genv_cenv ge) xa ta xb tb) (@Some sx x)),
       @eq (option Values.val)
         (Cop.sem_binary_operation (Clight.genv_cenv ge) Cop.Oadd (den ρ (lay β) xa) ta (den ρ (lay β) xb) tb m)
         (@Some Values.val (den ρ (lay β) x))
xbinop_sound
     : forall (ge : Clight.genv) (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m : Memory.Mem.mem)
         (op : Cop.binary_operation) (xa : sx) (ta : Ctypes.type) (xb : sx) (tb : Ctypes.type)
         (x : sx) (_ : @eq (option sx) (xbinop (Clight.genv_cenv ge) op xa ta xb tb) (@Some sx x)),
       @eq (option Values.val)
         (Cop.sem_binary_operation (Clight.genv_cenv ge) op (den ρ (lay β) xa) ta (den ρ (lay β) xb) tb m)
         (@Some Values.val (den ρ (lay β) x))
load_lv_sound
     : forall (ge : Clight.genv) (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (Σ : sstate)
         (m : Memory.Mem.mem) (e : Clight.env) (le : Clight.temp_env) (_ : rep ρ β (sregs Σ) m)
         (a : Clight.expr) (r : nat) (d : BinNums.Z) (x : sx)
         (_ : Clight.eval_lvalue ge e le m a (blk β r) (Integers.Ptrofs.repr (BinInt.Z.add (bas β r) d)) Ctypes.Full)
         (_ : @eq (option sx) (xload (sregs Σ) r d (Clight.typeof a)) (@Some sx x)),
       Clight.eval_expr ge e le m a (den ρ (lay β) x)
lv_var_sound
     : forall (ge : Clight.genv) (ve gv : venv) (β : layout) (m : Memory.Mem.mem) (e : Clight.env)
         (le : Clight.temp_env) (_ : ematch β ve e) (_ : gmatch ge β gv) (id : AST.ident) (ty : Ctypes.type)
         (r : nat) (d : BinNums.Z)
         (_ : @eq (option (prod nat BinNums.Z)) (lv_var ve gv id ty)
                (@Some (prod nat BinNums.Z) (@pair nat BinNums.Z r d))),
       Clight.eval_lvalue ge e le m (Clight.Evar id ty) (blk β r) (Integers.Ptrofs.repr (BinInt.Z.add (bas β r) d))
         Ctypes.Full
xexpr_sound_both
     : forall (ge : Clight.genv) (ve gv : venv) (ρ : forall _ : nat, Integers.Int64.int) (β : layout)
         (Σ : sstate) (m : Memory.Mem.mem) (e : Clight.env) (le : Clight.temp_env) (_ : rep ρ β (sregs Σ) m)
         (_ : tmatch ρ β (stemps Σ) le) (_ : ematch β ve e) (_ : gmatch ge β gv) (a : Clight.expr),
       and
         (forall (x : sx) (_ : @eq (option sx) (xexpr (Clight.genv_cenv ge) ve gv Σ a) (@Some sx x)),
          Clight.eval_expr ge e le m a (den ρ (lay β) x))
         (forall (r : nat) (d : BinNums.Z)
            (_ : @eq (option (prod nat BinNums.Z)) (xlval (Clight.genv_cenv ge) ve gv Σ a)
                   (@Some (prod nat BinNums.Z) (@pair nat BinNums.Z r d))),
          Clight.eval_lvalue ge e le m a (blk β r) (Integers.Ptrofs.repr (BinInt.Z.add (bas β r) d)) Ctypes.Full)
xexpr_sound
     : forall (ge : Clight.genv) (ve gv : venv) (ρ : forall _ : nat, Integers.Int64.int) (β : layout)
         (Σ : sstate) (m : Memory.Mem.mem) (e : Clight.env) (le : Clight.temp_env) (_ : rep ρ β (sregs Σ) m)
         (_ : tmatch ρ β (stemps Σ) le) (_ : ematch β ve e) (_ : gmatch ge β gv) (a : Clight.expr)
         (x : sx) (_ : @eq (option sx) (xexpr (Clight.genv_cenv ge) ve gv Σ a) (@Some sx x)),
       Clight.eval_expr ge e le m a (den ρ (lay β) x)
xlval_sound
     : forall (ge : Clight.genv) (ve gv : venv) (ρ : forall _ : nat, Integers.Int64.int) (β : layout)
         (Σ : sstate) (m : Memory.Mem.mem) (e : Clight.env) (le : Clight.temp_env) (_ : rep ρ β (sregs Σ) m)
         (_ : tmatch ρ β (stemps Σ) le) (_ : ematch β ve e) (_ : gmatch ge β gv) (a : Clight.expr)
         (r : nat) (d : BinNums.Z)
         (_ : @eq (option (prod nat BinNums.Z)) (xlval (Clight.genv_cenv ge) ve gv Σ a)
                (@Some (prod nat BinNums.Z) (@pair nat BinNums.Z r d))),
       Clight.eval_lvalue ge e le m a (blk β r) (Integers.Ptrofs.repr (BinInt.Z.add (bas β r) d)) Ctypes.Full
xargs_sound
     : forall (ge : Clight.genv) (ve gv : venv) (ρ : forall _ : nat, Integers.Int64.int) (β : layout)
         (Σ : sstate) (m : Memory.Mem.mem) (e : Clight.env) (le : Clight.temp_env) (_ : rep ρ β (sregs Σ) m)
         (_ : tmatch ρ β (stemps Σ) le) (_ : ematch β ve e) (_ : gmatch ge β gv) (al : list Clight.expr)
         (tys : Ctypes.typelist) (xs : list sx)
         (_ : @eq (option (list sx)) (xargs (Clight.genv_cenv ge) ve gv Σ al tys) (@Some (list sx) xs)),
       Clight.eval_exprlist ge e le m al tys (@List.map sx Values.val (den ρ (lay β)) xs)
rsel_indep
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β β' : forall _ : nat, prod Values.block BinNums.Z) (r : res),
       @eq (prod sstate xout) (rsel ρ β r) (rsel ρ β' r)
tbind_sel
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (r : res) (k : forall (_ : sstate) (_ : xout), option res) (r' : res)
         (_ : @eq (option res) (tbind r k) (@Some res r')),
       @ex res
         (fun rk : res =>
          and (@eq (option res) (k (@fst sstate xout (rsel ρ β r)) (@snd sstate xout (rsel ρ β r))) (@Some res rk))
            (@eq (prod sstate xout) (rsel ρ β r') (rsel ρ β rk)))
is_const_eq
     : forall (c : sx) (i : Integers.Int.int)
         (_ : @eq (option Integers.Int.int) (is_const c) (@Some Integers.Int.int i)), @eq sx c (XIc i)
fn_okb_true
     : forall (fd : Clight.function) (_ : @eq bool (fn_okb fd) true),
       and (@Coqlib.list_norepet AST.ident (Clight.var_names (Clight.fn_vars fd)))
         (and (@Coqlib.list_norepet AST.ident (Clight.var_names (Clight.fn_params fd)))
            (@Coqlib.list_disjoint AST.ident (Clight.var_names (Clight.fn_params fd))
               (Clight.var_names (Clight.fn_temps fd))))
lext_refl
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (Σ : sstate) (o : xout), lext ρ β (slog Σ) (RDone Σ o)
lext_sel
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (log : list event) (r r' : res) (_ : @eq (prod sstate xout) (rsel ρ β r) (rsel ρ β r'))
         (_ : lext ρ β log r'), lext ρ β log r
lext_trans
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (log : list event) (r1 r2 : res) (_ : lext ρ β log r1)
         (_ : lext ρ β (slog (@fst sstate xout (rsel ρ β r1))) r2), lext ρ β log r2
xfun_lext
     : forall (ce : Ctypes.composite_env) (rec : forall (_ : venv) (_ : sstate) (_ : Clight.statement), option res)
         (_ : forall (ve : venv) (Σ : sstate) (s : Clight.statement) (r : res)
                (_ : @eq (option res) (rec ve Σ s) (@Some res r)) (ρ : forall _ : nat, Integers.Int64.int)
                (β : forall _ : nat, prod Values.block BinNums.Z), lext ρ β (slog Σ) r) (fd : Clight.function)
         (xs : list sx) (regs : list region) (log : list event) (nv : nat) (ts : Maps.PTree.t sx)
         (optid : option AST.ident) (nreg : nat) (ty : Ctypes.type) (rr : res)
         (_ : @eq (option res) (xfun_with ce rec fd xs regs log nv (xcall_ret optid ts nreg ty)) (@Some res rr))
         (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z),
       lext ρ β log rr
xstmt_lext
     : forall (ce : Ctypes.composite_env) (gv : venv) (fns : list (prod AST.ident fentry))
         (n : nat) (ve : venv) (Σ : sstate) (s : Clight.statement) (r : res)
         (_ : @eq (option res) (xstmt ce gv fns n ve Σ s) (@Some res r)) (ρ : forall _ : nat, Integers.Int64.int)
         (β : forall _ : nat, prod Values.block BinNums.Z), lext ρ β (slog Σ) r
shape_nth
     : forall (regs regs' : list region) (r : nat) (reg : region)
         (_ : @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   regs')
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   regs)) (_ : @eq (option region) (@List.nth_error region regs r) (@Some region reg)),
       @ex region
         (fun reg' : region =>
          and (@eq (option region) (@List.nth_error region regs' r) (@Some region reg'))
            (@eq (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
               (rshape reg') (rshape reg)))
callee_env_blocks
     : forall (ge : Clight.genv) (β' : layout) (veN : venv) (e' : Maps.PTree.tree (prod Values.block Ctypes.type))
         (_ : forall (id1 id2 : AST.ident) (r1 r2 : nat) (ty1 ty2 : Ctypes.type)
                (_ : @eq (option (prod nat Ctypes.type)) (vlookup veN id1)
                       (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r1 ty1)))
                (_ : @eq (option (prod nat Ctypes.type)) (vlookup veN id2)
                       (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r2 ty2)))
                (_ : @eq Values.block (blk β' r1) (blk β' r2)), @eq nat r1 r2)
         (_ : forall id : BinNums.positive,
              @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e')
                match vlookup veN id return (option (prod Values.block Ctypes.type)) with
                | Some p =>
                    match p return (option (prod Values.block Ctypes.type)) with
                    | pair r ty => @Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type (blk β' r) ty)
                    end
                | None => @None (prod Values.block Ctypes.type)
                end)
         (_ : forall (id : AST.ident) (r : nat) (ty : Ctypes.type)
                (_ : @eq (option (prod nat Ctypes.type)) (vlookup veN id)
                       (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty))),
              lt r (@length (prod Values.block BinNums.Z) β'))
         (_ : forall (id1 id2 : AST.ident) (r : nat) (ty1 ty2 : Ctypes.type)
                (_ : @eq (option (prod nat Ctypes.type)) (vlookup veN id1)
                       (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty1)))
                (_ : @eq (option (prod nat Ctypes.type)) (vlookup veN id2)
                       (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty2))), @eq AST.ident id1 id2),
       and
         (forall (b : Values.block) (lo hi : BinNums.Z)
            (_ : @List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                   (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z b lo) hi)
                   (Clight.blocks_of_env ge e')),
          @ex AST.ident
            (fun id : AST.ident =>
             @ex nat
               (fun r : nat =>
                @ex Ctypes.type
                  (fun ty : Ctypes.type =>
                   and
                     (@eq (option (prod nat Ctypes.type)) (vlookup veN id)
                        (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty)))
                     (and (@eq Values.block b (blk β' r))
                        (and (@eq BinNums.Z lo BinNums.Z0) (@eq BinNums.Z hi (Ctypes.sizeof (Clight.genv_cenv ge) ty))))))))
         (@Coqlib.list_norepet Values.block
            (@List.map (prod (prod Values.block BinNums.Z) BinNums.Z) Values.block
               (fun x : prod (prod Values.block BinNums.Z) BinNums.Z =>
                @fst Values.block BinNums.Z (@fst (prod Values.block BinNums.Z) BinNums.Z x))
               (Clight.blocks_of_env ge e')))
xret_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (ty : Ctypes.type) (ob : xout)
         (out : ClightBigstep.outcome) (m : Memory.Mem.mem) (v : option sx)
         (_ : @eq (option (option sx)) (xret ty ob) (@Some (option sx) v)) (_ : outmatch ρ β ob out),
       @ex Values.val
         (fun vres : Values.val =>
          and (ClightBigstep.outcome_result_value out ty vres m)
            match v return Prop with
            | Some x => @eq Values.val vres (den ρ (lay β) x)
            | None => @eq Values.val vres Values.Vundef
            end)
map_den_ext
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β β' : forall _ : nat, prod Values.block BinNums.Z)
         (n : nat) (xs : list sx) (_ : forall (r : nat) (_ : lt r n), @eq (prod Values.block BinNums.Z) (β' r) (β r))
         (_ : @eq bool (@List.forallb sx (xp_lt n) xs) true),
       @eq (list Values.val) (@List.map sx Values.val (den ρ β') xs) (@List.map sx Values.val (den ρ β) xs)
lv_den
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z) (x : sx),
       @eq Integers.Int64.int (il (den ρ β x)) (lv ρ x)
post_sel
     : forall (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (ext : forall _ : Values.block, Prop) (ρ : forall _ : nat, Integers.Int64.int) (β : layout)
         (Σ : sstate) (m : Memory.Mem.mem) (r r' : res) (le' : Clight.temp_env) (m' : Memory.Mem.mem)
         (out : ClightBigstep.outcome) (_ : @eq (prod sstate xout) (rsel ρ (lay β) r) (rsel ρ (lay β) r'))
         (_ : post inv ext ρ β Σ m r' le' m' out), post inv ext ρ β Σ m r le' m' out
frame_shape
     : forall (ext : forall _ : Values.block, Prop) (β : layout) (regs regs' : list region)
         (m : Memory.Mem.mem)
         (_ : @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   regs')
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   regs)),
       @eq (forall (_ : Values.block) (_ : BinNums.Z), Prop) (frame ext β regs' m) (frame ext β regs m)
post_trans
     : forall (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (ext : forall _ : Values.block, Prop) (ρ : forall _ : nat, Integers.Int64.int) (β : layout)
         (Σ : sstate) (m : Memory.Mem.mem) (r1 : res) (le1 : Clight.temp_env) (m1 : Memory.Mem.mem)
         (out1 : ClightBigstep.outcome) (r2 : res) (le2 : Clight.temp_env) (m2 : Memory.Mem.mem)
         (out2 : ClightBigstep.outcome) (_ : post inv ext ρ β Σ m r1 le1 m1 out1)
         (_ : post inv ext ρ β (@fst sstate xout (rsel ρ (lay β) r1)) m1 r2 le2 m2 out2),
       post inv ext ρ β Σ m r2 le2 m2 out2
ext_unchanged
     : forall (ext : forall _ : Values.block, Prop) (ρ : forall _ : nat, Integers.Int64.int)
         (β : layout) (regs : list region) (m m' : Memory.Mem.mem) (_ : rep ρ β regs m) (_ : xsep ext β)
         (_ : Memory.Mem.unchanged_on
                (fun (b : Values.block) (o : BinNums.Z) =>
                 not
                   (foot β
                      (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                         rshape regs) b o)) m m'), lframe (fun (b : Values.block) (_ : BinNums.Z) => ext b) m m'
solves_app
     : forall (ev_ok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (ρ : forall _ : nat, Integers.Int64.int) (l1 l2 : list event) (_ : solves ev_ok ρ (@app event l1 l2)),
       and (solves ev_ok ρ l1) (solves ev_ok ρ l2)
xfun_sound
     : forall (ge : Clight.genv) (gv : venv)
         (ev_ok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (ext : forall _ : Values.block, Prop)
         (_ : forall (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m m' : Memory.Mem.mem)
                (_ : inv ρ log m) (_ : lframe (fun (b : Values.block) (_ : BinNums.Z) => ext b) m m'),
              inv ρ log m')
         (_ : forall (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m : Memory.Mem.mem)
                (b : Values.block) (_ : inv ρ log m) (_ : ext b), Memory.Mem.valid_block m b)
         (rec : forall (_ : venv) (_ : sstate) (_ : Clight.statement), option res)
         (_ : sound_rec ge gv ev_ok inv ext rec) (fd : Clight.function) (xs : list sx) (regs : list region)
         (log : list event) (nv : nat) (ts : Maps.PTree.t sx) (optid : option AST.ident) (rr : res)
         (_ : @eq (option res)
                (xfun_with (Clight.genv_cenv ge) rec fd xs regs log nv
                   (xcall_ret optid ts (@length region regs) (Clight.fn_return fd))) (@Some res rr))
         (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m : Memory.Mem.mem) (_ : rep ρ β regs m)
         (_ : gmatch2 ge β gv) (_ : xsep ext β) (_ : inv ρ log m)
         (_ : solves ev_ok ρ (slog (@fst sstate xout (rsel ρ (lay β) rr)))),
       @ex Memory.Mem.mem
         (fun m3 : Memory.Mem.mem =>
          @ex Values.val
            (fun vres : Values.val =>
             and
               (ClightBigstep.eval_funcall Clight.function_entry2 ge m (@Ctypes.Internal Clight.function fd)
                  (@List.map sx Values.val (den ρ (lay β)) xs) Events.E0 m3 vres)
               (and (rep ρ β (sregs (@fst sstate xout (rsel ρ (lay β) rr))) m3)
                  (and
                     (@ex (option sx)
                        (fun v : option sx =>
                         and
                           (@eq (Maps.PTree.t sx) (stemps (@fst sstate xout (rsel ρ (lay β) rr))) (set_opt optid v ts))
                           match v return Prop with
                           | Some x => @eq Values.val vres (den ρ (lay β) x)
                           | None => @eq Values.val vres Values.Vundef
                           end))
                     (and (@eq xout (@snd sstate xout (rsel ρ (lay β) rr)) ONormal)
                        (and
                           (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 (sregs (@fst sstate xout (rsel ρ (lay β) rr))))
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 regs))
                           (and (inv ρ (slog (@fst sstate xout (rsel ρ (lay β) rr))) m3)
                              (lframe (frame ext β regs m) m m3))))))))
xstmt_sound
     : forall (ge : Clight.genv) (gv : venv) (fns : list (prod AST.ident fentry))
         (ev_ok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (ext : forall _ : Values.block, Prop)
         (_ : forall (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m m' : Memory.Mem.mem)
                (_ : inv ρ log m) (_ : lframe (fun (b : Values.block) (_ : BinNums.Z) => ext b) m m'),
              inv ρ log m')
         (_ : forall (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m : Memory.Mem.mem)
                (b : Values.block) (_ : inv ρ log m) (_ : ext b), Memory.Mem.valid_block m b)
         (_ : forall (id : AST.ident) (ent : fentry) (_ : @eq (option fentry) (flookup fns id) (@Some fentry ent)),
              and
                (@ex Values.block
                   (fun b : Values.block =>
                    and
                      (@eq (option Values.block)
                         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
                         (@Some Values.block b))
                      (@eq (option Clight.fundef)
                         (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
                         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (fentry_fd ent))))))
                match ent return Prop with
                | FInt _ => True
                | FOra fd o => oracle_ok ge ev_ok inv ext fd o
                end) (n : nat), sound_rec ge gv ev_ok inv ext (xstmt (Clight.genv_cenv ge) gv fns n)
xfun_top_sound
     : forall (ge : Clight.genv) (gv : venv) (fns : list (prod AST.ident fentry))
         (ev_ok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (inv : forall (_ : forall _ : nat, Integers.Int64.int) (_ : list event) (_ : Memory.Mem.mem), Prop)
         (ext : forall _ : Values.block, Prop)
         (_ : forall (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m m' : Memory.Mem.mem)
                (_ : inv ρ log m) (_ : lframe (fun (b : Values.block) (_ : BinNums.Z) => ext b) m m'),
              inv ρ log m')
         (_ : forall (ρ : forall _ : nat, Integers.Int64.int) (log : list event) (m : Memory.Mem.mem)
                (b : Values.block) (_ : inv ρ log m) (_ : ext b), Memory.Mem.valid_block m b)
         (_ : forall (id : AST.ident) (ent : fentry) (_ : @eq (option fentry) (flookup fns id) (@Some fentry ent)),
              and
                (@ex Values.block
                   (fun b : Values.block =>
                    and
                      (@eq (option Values.block)
                         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
                         (@Some Values.block b))
                      (@eq (option Clight.fundef)
                         (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
                         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (fentry_fd ent))))))
                match ent return Prop with
                | FInt _ => True
                | FOra fd o => oracle_ok ge ev_ok inv ext fd o
                end) (n : nat) (fd : Clight.function) (xs : list sx) (regs : list region) (log : list event)
         (nv : nat) (rr : res)
         (_ : @eq (option res) (xfun (Clight.genv_cenv ge) gv fns n fd xs regs log nv) (@Some res rr))
         (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m : Memory.Mem.mem) (_ : rep ρ β regs m)
         (_ : gmatch2 ge β gv) (_ : xsep ext β) (_ : inv ρ log m)
         (_ : solves ev_ok ρ (slog (@fst sstate xout (rsel ρ (lay β) rr)))),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          @ex Values.val
            (fun vres : Values.val =>
             and
               (ClightBigstep.eval_funcall Clight.function_entry2 ge m (@Ctypes.Internal Clight.function fd)
                  (@List.map sx Values.val (den ρ (lay β)) xs) Events.E0 m' vres)
               (and (rep ρ β (sregs (@fst sstate xout (rsel ρ (lay β) rr))) m')
                  (and
                     match
                       @Maps.PTree.get sx BinNums.xH (stemps (@fst sstate xout (rsel ρ (lay β) rr))) return Prop
                     with
                     | Some x => @eq Values.val vres (den ρ (lay β) x)
                     | None => @eq Values.val vres Values.Vundef
                     end
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (sregs (@fst sstate xout (rsel ρ (lay β) rr))))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              regs))
                        (and (inv ρ (slog (@fst sstate xout (rsel ρ (lay β) rr))) m')
                           (lframe (frame ext β regs m) m m')))))))
flookup_In
     : forall (fns : list (prod AST.ident fentry)) (id : AST.ident) (ent : fentry)
         (_ : @eq (option fentry) (flookup fns id) (@Some fentry ent)),
       @List.In (prod AST.ident fentry) (@pair AST.ident fentry id ent) fns
kind_eqb_eq
     : forall (a b : kind) (_ : @eq bool (kind_eqb a b) true), @eq kind a b
den_KI
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx) (_ : @eq bool (isk KI x) true), @eq Values.val (den ρ β x) (Values.Vint (ii (den ρ β x)))
den_KL
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx) (_ : @eq bool (isk KL x) true), @eq Values.val (den ρ β x) (Values.Vlong (il (den ρ β x)))
den_KP
     : forall (x : sx) (_ : @eq bool (isk KP x) true),
       @ex nat (fun r : nat => @ex BinNums.Z (fun d : BinNums.Z => @eq sx x (XP r d)))
den_KA
     : forall (x : sx) (_ : @eq bool (isk KA x) true),
       @ex Values.block
         (fun b : Values.block => @ex Integers.Ptrofs.int (fun o : Integers.Ptrofs.int => @eq sx x (XA b o)))
xcast_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx) (t1 t2 : Ctypes.type) (x' : sx) (m : Memory.Mem.mem)
         (_ : @eq (option sx) (xcast x t1 t2) (@Some sx x')),
       @eq (option Values.val) (Cop.sem_cast (den ρ β x) t1 t2 m) (@Some Values.val (den ρ β x'))
xbinarith_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (fi : forall (_ : Ctypes.signedness) (_ : Integers.Int.int) (_ : Integers.Int.int), option Values.val)
         (fl : forall (_ : Ctypes.signedness) (_ : Integers.Int64.int) (_ : Integers.Int64.int), option Values.val)
         (ff : forall (_ : Floats.float) (_ : Floats.float), option Values.val)
         (fs : forall (_ : Floats.float32) (_ : Floats.float32), option Values.val)
         (mki mkl : forall (_ : Ctypes.signedness) (_ : sx) (_ : sx), sx)
         (_ : forall (sg : Ctypes.signedness) (a b : sx),
              @eq (option Values.val) (fi sg (ii (den ρ β a)) (ii (den ρ β b)))
                (@Some Values.val (den ρ β (mki sg a b))))
         (_ : forall (sg : Ctypes.signedness) (a b : sx),
              @eq (option Values.val) (fl sg (il (den ρ β a)) (il (den ρ β b)))
                (@Some Values.val (den ρ β (mkl sg a b)))) (xa : sx) (ta : Ctypes.type) (xb : sx)
         (tb : Ctypes.type) (x : sx) (m : Memory.Mem.mem)
         (_ : @eq (option sx) (xbinarith mki mkl xa ta xb tb) (@Some sx x)),
       @eq (option Values.val) (Cop.sem_binarith fi fl ff fs (den ρ β xa) ta (den ρ β xb) tb m)
         (@Some Values.val (den ρ β x))
xbinarith_arith
     : forall (mki mkl : forall (_ : Ctypes.signedness) (_ : sx) (_ : sx), sx) (xa : sx) (ta : Ctypes.type)
         (xb : sx) (tb : Ctypes.type) (x : sx) (_ : @eq (option sx) (xbinarith mki mkl xa ta xb tb) (@Some sx x)),
       or
         (@ex Ctypes.intsize
            (fun sz : Ctypes.intsize =>
             @ex Ctypes.signedness
               (fun sg : Ctypes.signedness =>
                @ex Ctypes.attr (fun a : Ctypes.attr => @eq Ctypes.type ta (Ctypes.Tint sz sg a)))))
         (@ex Ctypes.signedness
            (fun sg : Ctypes.signedness =>
             @ex Ctypes.attr (fun a : Ctypes.attr => @eq Ctypes.type ta (Ctypes.Tlong sg a))))
xbinarith_arith_r
     : forall (mki mkl : forall (_ : Ctypes.signedness) (_ : sx) (_ : sx), sx) (xa : sx) (ta : Ctypes.type)
         (xb : sx) (tb : Ctypes.type) (x : sx) (_ : @eq (option sx) (xbinarith mki mkl xa ta xb tb) (@Some sx x)),
       or
         (@ex Ctypes.intsize
            (fun sz : Ctypes.intsize =>
             @ex Ctypes.signedness
               (fun sg : Ctypes.signedness =>
                @ex Ctypes.attr (fun a : Ctypes.attr => @eq Ctypes.type tb (Ctypes.Tint sz sg a)))))
         (@ex Ctypes.signedness
            (fun sg : Ctypes.signedness =>
             @ex Ctypes.attr (fun a : Ctypes.attr => @eq Ctypes.type tb (Ctypes.Tlong sg a))))
xshift_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (left : bool) (xa : sx) (ta : Ctypes.type) (xb : sx) (tb : Ctypes.type) (x : sx)
         (_ : @eq (option sx) (xshift left xa ta xb tb) (@Some sx x)),
       @eq (option Values.val)
         (match
            left
            return (forall (_ : Values.val) (_ : Ctypes.type) (_ : Values.val) (_ : Ctypes.type), option Values.val)
          with
          | true => Cop.sem_shl
          | false => Cop.sem_shr
          end (den ρ β xa) ta (den ρ β xb) tb) (@Some Values.val (den ρ β x))
of_bool_b2i
     : forall b : bool, @eq Values.val (Values.Val.of_bool b) (Values.Vint (b2i b))
xbin_sound
     : forall (ce : Ctypes.composite_env) (ρ : forall _ : nat, Integers.Int64.int)
         (β : forall _ : nat, prod Values.block BinNums.Z) (op : Cop.binary_operation) (xa : sx)
         (ta : Ctypes.type) (xb : sx) (tb : Ctypes.type) (x : sx) (m : Memory.Mem.mem)
         (_ : @eq (option sx) (xbin op xa ta xb tb) (@Some sx x)),
       @eq (option Values.val) (Cop.sem_binary_operation ce op (den ρ β xa) ta (den ρ β xb) tb m)
         (@Some Values.val (den ρ β x))
xun_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (op : Cop.unary_operation) (xa : sx) (ta : Ctypes.type) (x : sx) (m : Memory.Mem.mem)
         (_ : @eq (option sx) (xun op xa ta) (@Some sx x)),
       @eq (option Values.val) (Cop.sem_unary_operation op (den ρ β xa) ta m) (@Some Values.val (den ρ β x))
xbool_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (xa : sx) (ta : Ctypes.type) (c : sx) (m : Memory.Mem.mem) (_ : @eq (option sx) (xbool xa ta) (@Some sx c)),
       @eq (option bool) (Cop.bool_val (den ρ β xa) ta m) (@Some bool (truth ρ β c))
xnorm_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (chunk : AST.memory_chunk) (x x' : sx) (_ : @eq (option sx) (xnorm chunk x) (@Some sx x')),
       @eq Values.val (Values.Val.load_result chunk (den ρ β x)) (den ρ β x')
den_proj_indep
     : forall (ρ : forall _ : nat, Integers.Int64.int) (x : sx) (β β' : forall _ : nat, prod Values.block BinNums.Z),
       and (@eq Integers.Int.int (ii (den ρ β x)) (ii (den ρ β' x)))
         (@eq Integers.Int64.int (il (den ρ β x)) (il (den ρ β' x)))
truth_indep
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β β' : forall _ : nat, prod Values.block BinNums.Z) (c : sx),
       @eq bool (truth ρ β c) (truth ρ β' c)
den_ext
     : forall (ρ : forall _ : nat, Integers.Int64.int) (x : sx) (β β' : forall _ : nat, prod Values.block BinNums.Z)
         (n : nat) (_ : forall (r : nat) (_ : lt r n), @eq (prod Values.block BinNums.Z) (β' r) (β r))
         (_ : @eq bool (xp_lt n x) true), @eq Values.val (den ρ β' x) (den ρ β x)
xp_le_lt
     : forall (r : nat) (x : sx) (_ : @eq bool (xp_le r x) true), @eq bool (xp_lt (S r) x) true
lay_app_l
     : forall (β βN : list (prod Values.block BinNums.Z)) (r : nat)
         (_ : lt r (@length (prod Values.block BinNums.Z) β)),
       @eq (prod Values.block BinNums.Z) (lay (@app (prod Values.block BinNums.Z) β βN) r) (lay β r)
region_ok_ext
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β β' : layout) (m : Memory.Mem.mem)
         (r : nat) (reg : region)
         (_ : forall (r' : nat) (_ : le r' r), @eq (prod Values.block BinNums.Z) (lay β' r') (lay β r'))
         (_ : region_ok ρ β m r reg), region_ok ρ β' m r reg
region_ok_mem
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m m' : Memory.Mem.mem)
         (r : nat) (reg : region)
         (_ : Memory.Mem.unchanged_on (fun (b : Values.block) (_ : BinNums.Z) => @eq Values.block b (blk β r)) m m')
         (_ : region_ok ρ β m r reg), region_ok ρ β m' r reg
rep_mem
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : list (prod Values.block BinNums.Z))
         (regs : list region) (m m' : Memory.Mem.mem)
         (_ : Memory.Mem.unchanged_on
                (fun (b : Values.block) (_ : BinNums.Z) =>
                 @List.In Values.block b
                   (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) β)) m m')
         (_ : rep ρ β regs m), rep ρ β regs m'
rep_prefix
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β βN : list (prod Values.block BinNums.Z))
         (regs regsN : list region) (m : Memory.Mem.mem)
         (_ : rep ρ (@app (prod Values.block BinNums.Z) β βN) (@app region regs regsN) m)
         (_ : @eq nat (@length (prod Values.block BinNums.Z) β) (@length region regs)), rep ρ β regs m
blk_in
     : forall (β : list (prod Values.block BinNums.Z)) (r : nat) (_ : lt r (@length (prod Values.block BinNums.Z) β)),
       @List.In Values.block (blk β r)
         (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) β)
rsep_snoc
     : forall (β : list (prod Values.block BinNums.Z)) (regs : list region) (b : Values.block)
         (base : BinNums.Z) (reg : region)
         (_ : @eq nat (@length (prod Values.block BinNums.Z) β) (@length region regs)) (_ : rsep β regs)
         (_ : not
                (@List.In Values.block b
                   (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) β))),
       rsep
         (@app (prod Values.block BinNums.Z) β
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b base)
               (@nil (prod Values.block BinNums.Z)))) (@app region regs (@cons region reg (@nil region)))
rep_snoc
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (regs : list region) (m : Memory.Mem.mem)
         (b : Values.block) (cs : list cell) (sz : BinNums.Z) (_ : rep ρ β regs m)
         (_ : not
                (@List.In Values.block b
                   (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) β)))
         (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.range_perm m b BinNums.Z0 sz Memtype.Cur Memtype.Freeable)
         (_ : @eq bool (cells_sorted BinNums.Z0 cs) true)
         (_ : @List.Forall cell
                (fun c : cell =>
                 and (BinInt.Z.le (BinInt.Z.add (cofs c) (Memdata.size_chunk (cchunk c))) sz)
                   (and (BinInt.Z.divide (Memdata.align_chunk (cchunk c)) (cofs c))
                      (@eq (option sx) (cval c) (@None sx)))) cs) (_ : BinInt.Z.le sz Integers.Ptrofs.max_unsigned),
       rep ρ
         (@app (prod Values.block BinNums.Z) β
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b BinNums.Z0)
               (@nil (prod Values.block BinNums.Z))))
         (@app region regs (@cons region (mkreg cs true (@Some BinNums.Z sz)) (@nil region))) m
align_chunk_pos'
     : forall ch : AST.memory_chunk, BinInt.Z.lt BinNums.Z0 (Memdata.align_chunk ch)
cell_allocb_true
     : forall (sz : BinNums.Z) (c : cell) (_ : @eq bool (cell_allocb sz c) true),
       and (BinInt.Z.le (BinInt.Z.add (cofs c) (Memdata.size_chunk (cchunk c))) sz)
         (and (BinInt.Z.divide (Memdata.align_chunk (cchunk c)) (cofs c)) (@eq (option sx) (cval c) (@None sx)))
vlookup_cons
     : forall (id0 : AST.ident) (v : prod nat Ctypes.type) (ve : list (prod AST.ident (prod nat Ctypes.type)))
         (id : AST.ident),
       @eq (option (prod nat Ctypes.type))
         (vlookup (@cons (prod AST.ident (prod nat Ctypes.type)) (@pair AST.ident (prod nat Ctypes.type) id0 v) ve) id)
         match BinPos.Pos.eqb id0 id return (option (prod nat Ctypes.type)) with
         | true => @Some (prod nat Ctypes.type) v
         | false => vlookup ve id
         end
xalloc_sound
     : forall (ge : Clight.genv) (ρ : forall _ : nat, Integers.Int64.int)
         (cf : forall (_ : AST.ident) (_ : Ctypes.type), option (list cell)) (vars : list (prod AST.ident Ctypes.type))
         (n : nat) (regsN : list region) (veN : venv) (β : layout) (regs : list region) (m : Memory.Mem.mem)
         (e : Clight.env)
         (_ : @eq (option (prod (list region) venv)) (xalloc cf (Clight.genv_cenv ge) vars n)
                (@Some (prod (list region) venv) (@pair (list region) venv regsN veN))) (_ : rep ρ β regs m)
         (_ : @eq nat (@length (prod Values.block BinNums.Z) β) n)
         (_ : @Coqlib.list_norepet AST.ident (Clight.var_names vars)),
       @ex Clight.env
         (fun e' : Clight.env =>
          @ex Memory.Mem.mem
            (fun m' : Memory.Mem.mem =>
             @ex (list (prod Values.block BinNums.Z))
               (fun βN : list (prod Values.block BinNums.Z) =>
                and (Clight.alloc_variables ge e m vars e' m')
                  (and (rep ρ (@app (prod Values.block BinNums.Z) β βN) (@app region regs regsN) m')
                     (and (@eq nat (@length (prod Values.block BinNums.Z) βN) (@length region regsN))
                        (and
                           (forall id : BinNums.positive,
                            @eq (option (prod Values.block Ctypes.type))
                              (@Maps.PTree.get (prod Values.block Ctypes.type) id e')
                              match vlookup veN id return (option (prod Values.block Ctypes.type)) with
                              | Some p =>
                                  match p return (option (prod Values.block Ctypes.type)) with
                                  | pair r ty =>
                                      @Some (prod Values.block Ctypes.type)
                                        (@pair Values.block Ctypes.type
                                           (blk (@app (prod Values.block BinNums.Z) β βN) r) ty)
                                  end
                              | None => @Maps.PTree.get (prod Values.block Ctypes.type) id e
                              end)
                           (and
                              (forall (id : AST.ident) (r : nat) (ty : Ctypes.type)
                                 (_ : @eq (option (prod nat Ctypes.type)) (vlookup veN id)
                                        (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty))),
                               and (@List.In AST.ident id (Clight.var_names vars))
                                 (and (le n r)
                                    (and (@eq BinNums.Z (bas (@app (prod Values.block BinNums.Z) β βN) r) BinNums.Z0)
                                       (@ex region
                                          (fun reg : region =>
                                           and
                                             (@eq (option region) (@List.nth_error region (@app region regs regsN) r)
                                                (@Some region reg))
                                             (@eq (option BinNums.Z) (rfree reg)
                                                (@Some BinNums.Z (Ctypes.sizeof (Clight.genv_cenv ge) ty))))))))
                              (and
                                 (forall (id1 id2 : AST.ident) (r : nat) (ty1 ty2 : Ctypes.type)
                                    (_ : @eq (option (prod nat Ctypes.type)) (vlookup veN id1)
                                           (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty1)))
                                    (_ : @eq (option (prod nat Ctypes.type)) (vlookup veN id2)
                                           (@Some (prod nat Ctypes.type) (@pair nat Ctypes.type r ty2))),
                                  @eq AST.ident id1 id2)
                                 (and
                                    (@List.Forall (prod Values.block BinNums.Z)
                                       (fun p : prod Values.block BinNums.Z =>
                                        not (Memory.Mem.valid_block m (@fst Values.block BinNums.Z p))) βN)
                                    (Memory.Mem.unchanged_on (fun (_ : Values.block) (_ : BinNums.Z) => True) m m'))))))))))
tmatch_set
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (ts : Maps.PTree.t sx)
         (le : Clight.temp_env) (id : BinNums.positive) (x : sx) (_ : tmatch ρ β ts le),
       tmatch ρ β (@Maps.PTree.set sx id x ts) (@Maps.PTree.set Values.val id (den ρ (lay β) x) le)
xbind_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (params : list (prod AST.ident Ctypes.type))
         (xs : list sx) (ts ts' : Maps.PTree.t sx) (le : Clight.temp_env)
         (_ : @eq (option (Maps.PTree.t sx)) (xbind params xs ts) (@Some (Maps.PTree.t sx) ts'))
         (_ : tmatch ρ β ts le),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          and
            (@eq (option Clight.temp_env)
               (Clight.bind_parameter_temps params (@List.map sx Values.val (den ρ (lay β)) xs) le)
               (@Some Clight.temp_env le')) (tmatch ρ β ts' le'))
free_list_exists
     : forall (l : list (prod (prod Values.block BinNums.Z) BinNums.Z)) (m : Memory.Mem.mem)
         (_ : @Coqlib.list_norepet Values.block
                (@List.map (prod (prod Values.block BinNums.Z) BinNums.Z) Values.block
                   (fun x : prod (prod Values.block BinNums.Z) BinNums.Z =>
                    @fst Values.block BinNums.Z (@fst (prod Values.block BinNums.Z) BinNums.Z x)) l))
         (_ : forall (b : Values.block) (lo hi : BinNums.Z)
                (_ : @List.In (prod (prod Values.block BinNums.Z) BinNums.Z)
                       (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z b lo) hi) l),
              Memory.Mem.range_perm m b lo hi Memtype.Cur Memtype.Freeable),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and (@eq (option Memory.Mem.mem) (Memory.Mem.free_list m l) (@Some Memory.Mem.mem m'))
            (Memory.Mem.unchanged_on
               (fun (b : Values.block) (_ : BinNums.Z) =>
                not
                  (@List.In Values.block b
                     (@List.map (prod (prod Values.block BinNums.Z) BinNums.Z) Values.block
                        (fun x : prod (prod Values.block BinNums.Z) BinNums.Z =>
                         @fst Values.block BinNums.Z (@fst (prod Values.block BinNums.Z) BinNums.Z x)) l))) m m'))
@norepet_map_keys ?A ?B ?C
     : forall (f : forall _ : ?A, ?B) (g : forall _ : ?A, ?C) (l : list ?A)
         (_ : @Coqlib.list_norepet ?B (@List.map ?A ?B f l))
         (_ : forall (x y : ?A) (_ : @List.In ?A x l) (_ : @List.In ?A y l) (_ : @eq ?C (g x) (g y)),
              @eq ?B (f x) (f y)), @Coqlib.list_norepet ?C (@List.map ?A ?C g l)
where
?A : [ |- Type]
?B : [ |- Type]
?C : [ |- Type]
lframe_refl
     : forall (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (m : Memory.Mem.mem), lframe P m m
lframe_unchanged
     : forall (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (m m' : Memory.Mem.mem)
         (_ : Memory.Mem.unchanged_on P m m'), lframe P m m'
lframe_implies
     : forall (P Q : forall (_ : Values.block) (_ : BinNums.Z), Prop) (m m' : Memory.Mem.mem)
         (_ : lframe P m m')
         (_ : forall (b : Values.block) (ofs : BinNums.Z) (_ : Q b ofs) (_ : Memory.Mem.valid_block m b), P b ofs),
       lframe Q m m'
lframe_trans
     : forall (P : forall (_ : Values.block) (_ : BinNums.Z), Prop) (m1 m2 m3 : Memory.Mem.mem)
         (_ : lframe P m1 m2) (_ : lframe P m2 m3), lframe P m1 m3
xconst_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx) (z : BinNums.Z) (_ : @eq (option BinNums.Z) (xconst x) (@Some BinNums.Z z)),
       and (@eq Values.val (den ρ β x) (Values.Vlong (Integers.Int64.repr z)))
         (and (BinInt.Z.le BinNums.Z0 z) (BinInt.Z.le z Integers.Int64.max_unsigned))
cells_sorted_shape
     : forall (cs cs' : list cell) (lo : BinNums.Z)
         (_ : @eq (list (prod BinNums.Z AST.memory_chunk))
                (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape cs')
                (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape cs)),
       @eq bool (cells_sorted lo cs) (cells_sorted lo cs')
rep_update
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (regs regs' : list region)
         (m m' : Memory.Mem.mem) (_ : rep ρ β regs m)
         (_ : @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   regs')
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   regs))
         (_ : forall (b : Values.block) (o : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m b o k p), Memory.Mem.perm m' b o k p)
         (_ : forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)
         (_ : forall (r : nat) (reg reg' : region) (c' : cell) (x : sx)
                (_ : @eq (option region) (@List.nth_error region regs r) (@Some region reg))
                (_ : @eq (option region) (@List.nth_error region regs' r) (@Some region reg'))
                (_ : @List.In cell c' (rcells reg')) (_ : @eq (option sx) (cval c') (@Some sx x)),
              or
                (and (@List.In cell c' (rcells reg))
                   (@eq (option Values.val)
                      (Memory.Mem.load (cchunk c') m' (blk β r) (BinInt.Z.add (bas β r) (cofs c')))
                      (Memory.Mem.load (cchunk c') m (blk β r) (BinInt.Z.add (bas β r) (cofs c')))))
                (and
                   (@eq (option Values.val)
                      (Memory.Mem.load (cchunk c') m' (blk β r) (BinInt.Z.add (bas β r) (cofs c')))
                      (@Some Values.val (den ρ (lay β) x))) (@eq bool (xp_le r x) true))),
       rep ρ β regs' m'
bnd_of_log_sound
     : forall (tb : forall (_ : nat) (_ : nat), prod BinNums.Z BinNums.Z)
         (ev_ok : forall (_ : forall _ : nat, Integers.Int64.int) (_ : event), Prop)
         (ρ : forall _ : nat, Integers.Int64.int) (log : list event)
         (_ : forall (ev : event) (_ : ev_ok ρ ev) (j : nat) (_ : lt j (ecnt ev)),
              and
                (BinInt.Z.le (@fst BinNums.Z BinNums.Z (tb (etag ev) j))
                   (Integers.Int64.unsigned (ρ (Nat.add (ebase ev) j))))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ (Nat.add (ebase ev) j)))
                   (@snd BinNums.Z BinNums.Z (tb (etag ev) j)))) (_ : @List.Forall event (ev_ok ρ) log)
         (n : nat),
       and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd_of_log tb log n)) (Integers.Int64.unsigned (ρ n)))
         (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd_of_log tb log n)))
int_table_lookup
     : forall (l : list (prod AST.ident Clight.function)) (id : AST.ident) (ent : fentry)
         (_ : @eq (option fentry) (flookup (int_table l) id) (@Some fentry ent)),
       @ex Clight.function
         (fun f : Clight.function =>
          and (@eq fentry ent (FInt f))
            (@List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) l))
leaves_log_nil_sel
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (r : res) (_ : @eq bool (leaves_log_nil r) true),
       @eq (list event) (slog (@fst sstate xout (rsel ρ β r))) (@nil event)
symbol_lookup_table
     : forall (ge : Clight.genv) (l : list (prod AST.ident Clight.function))
         (_ : @eq (list (option Clight.fundef))
                (@List.map (prod AST.ident Clight.function) (option Clight.fundef) (symbol_lookup ge) l)
                (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
                   (fun p : prod AST.ident Clight.function =>
                    @Some (Ctypes.fundef Clight.function)
                      (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) l))
         (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) l),
       @ex Values.block
         (fun b : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
               (@Some Values.block b))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
               (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))))
xfun_pure
     : forall (ge : Clight.genv) (l : list (prod AST.ident Clight.function))
         (_ : forall (id : AST.ident) (f : Clight.function)
                (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) l),
              @ex Values.block
                (fun b : Values.block =>
                 and
                   (@eq (option Values.block)
                      (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
                      (@Some Values.block b))
                   (@eq (option Clight.fundef)
                      (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
                      (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))))
         (n : nat) (fd : Clight.function) (xs : list sx) (regs : list region) (nv : nat) (rr : res)
         (_ : @eq (option res)
                (xfun (Clight.genv_cenv ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
                   (int_table l) n fd xs regs (@nil event) nv) (@Some res rr)) (_ : @eq bool (leaves_log_nil rr) true)
         (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m : Memory.Mem.mem) (_ : rep ρ β regs m),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          @ex Values.val
            (fun vres : Values.val =>
             and
               (ClightBigstep.eval_funcall Clight.function_entry2 ge m (@Ctypes.Internal Clight.function fd)
                  (@List.map sx Values.val (den ρ (lay β)) xs) Events.E0 m' vres)
               (and (rep ρ β (sregs (@fst sstate xout (rsel ρ (lay β) rr))) m')
                  (and
                     match
                       @Maps.PTree.get sx BinNums.xH (stemps (@fst sstate xout (rsel ρ (lay β) rr))) return Prop
                     with
                     | Some x => @eq Values.val vres (den ρ (lay β) x)
                     | None => @eq Values.val vres Values.Vundef
                     end
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (sregs (@fst sstate xout (rsel ρ (lay β) rr))))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              regs))
                        (lframe
                           (fun (b : Values.block) (o : BinNums.Z) =>
                            not
                              (foot β
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape regs) b o)) m m'))))))
rep_nil
     : forall (ρ : forall _ : nat, Integers.Int64.int) (m : Memory.Mem.mem),
       rep ρ (@nil (prod Values.block BinNums.Z)) (@nil region) m
lay_app_new
     : forall (β : list (prod Values.block BinNums.Z)) (p : prod Values.block BinNums.Z),
       @eq (prod Values.block BinNums.Z)
         (lay
            (@app (prod Values.block BinNums.Z) β
               (@cons (prod Values.block BinNums.Z) p (@nil (prod Values.block BinNums.Z))))
            (@length (prod Values.block BinNums.Z) β)) p
rep_add
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (regs : list region) (m : Memory.Mem.mem)
         (b : Values.block) (base : BinNums.Z) (reg : region) (_ : rep ρ β regs m)
         (_ : not
                (@List.In Values.block b
                   (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) β)))
         (_ : region_ok ρ
                (@app (prod Values.block BinNums.Z) β
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b base)
                      (@nil (prod Values.block BinNums.Z)))) m (@length region regs) reg),
       rep ρ
         (@app (prod Values.block BinNums.Z) β
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b base)
               (@nil (prod Values.block BinNums.Z)))) (@app region regs (@cons region reg (@nil region))) m
rep_region
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (regs : list region) (m : Memory.Mem.mem)
         (r : nat) (reg : region) (_ : rep ρ β regs m)
         (_ : @eq (option region) (@List.nth_error region regs r) (@Some region reg)), region_ok ρ β m r reg
region_load
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m : Memory.Mem.mem) (r : nat)
         (reg : region) (d : BinNums.Z) (ch : AST.memory_chunk) (x : sx) (_ : region_ok ρ β m r reg)
         (_ : @List.In cell (mkcell d ch (@Some sx x)) (rcells reg)),
       @eq (option Values.val) (Memory.Mem.load ch m (blk β r) (BinInt.Z.add (bas β r) d))
         (@Some Values.val (den ρ (lay β) x))
u64_cells_sorted
     : forall (xs : list sx) (ofs lo : BinNums.Z) (_ : BinInt.Z.le lo ofs),
       @eq bool (cells_sorted lo (u64_cells ofs xs)) true
u64_cells_In
     : forall (xs : list sx) (ofs : BinNums.Z) (c : cell) (_ : @List.In cell c (u64_cells ofs xs)),
       @ex nat
         (fun i : nat =>
          @ex sx
            (fun x : sx =>
             and (@eq (option sx) (@List.nth_error sx xs i) (@Some sx x))
               (@eq cell c
                  (mkcell
                     (BinInt.Z.add ofs
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i))) AST.Mint64 (@Some sx x)))))
u64_cells_nth
     : forall (xs : list sx) (ofs : BinNums.Z) (i : nat) (x : sx)
         (_ : @eq (option sx) (@List.nth_error sx xs i) (@Some sx x)),
       @List.In cell
         (mkcell
            (BinInt.Z.add ofs
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
            AST.Mint64 (@Some sx x)) (u64_cells ofs xs)
region_u64
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m : Memory.Mem.mem) (r : nat)
         (xs : list sx) (w : bool) (_ : BinInt.Z.le BinNums.Z0 (bas β r))
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (bas β r))
         (_ : BinInt.Z.le
                (BinInt.Z.add (bas β r)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (@length sx xs)))) Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.valid_block m (blk β r))
         (_ : Memory.Mem.range_perm m (blk β r) (bas β r)
                (BinInt.Z.add (bas β r)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (@length sx xs)))) Memtype.Cur
                match w return Memtype.permission with
                | true => Memtype.Writable
                | false => Memtype.Readable
                end)
         (_ : forall (i : nat) (x : sx) (_ : @eq (option sx) (@List.nth_error sx xs i) (@Some sx x)),
              and
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint64 m (blk β r)
                      (BinInt.Z.add (bas β r)
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.of_nat i)))) (@Some Values.val (den ρ (lay β) x))) (@eq bool (xp_le r x) true)),
       region_ok ρ β m r (mkreg (u64_cells BinNums.Z0 xs) w (@None BinNums.Z))
chunk_eqb_eq
     : forall (a b : AST.memory_chunk) (_ : @eq bool (chunk_eqb a b) true), @eq AST.memory_chunk a b
size_chunk_pos'
     : forall ch : AST.memory_chunk, BinInt.Z.lt BinNums.Z0 (Memdata.size_chunk ch)
cell_at_true
     : forall (c : cell) (d : BinNums.Z) (ch : AST.memory_chunk) (_ : @eq bool (cell_at c d ch) true),
       and (@eq BinNums.Z (cofs c) d) (@eq AST.memory_chunk (cchunk c) ch)
find_cell_In
     : forall (cs : list cell) (d : BinNums.Z) (ch : AST.memory_chunk) (c : cell)
         (_ : @eq (option cell) (find_cell cs d ch) (@Some cell c)),
       and (@List.In cell c cs) (and (@eq BinNums.Z (cofs c) d) (@eq AST.memory_chunk (cchunk c) ch))
sorted_lower
     : forall (lo : BinNums.Z) (cs : list cell) (c : cell) (_ : @eq bool (cells_sorted lo cs) true)
         (_ : @List.In cell c cs), BinInt.Z.le lo (cofs c)
sorted_disj
     : forall (lo : BinNums.Z) (cs : list cell) (c1 c2 : cell) (_ : @eq bool (cells_sorted lo cs) true)
         (_ : @List.In cell c1 cs) (_ : @List.In cell c2 cs),
       or (@eq cell c1 c2)
         (or (BinInt.Z.le (BinInt.Z.add (cofs c1) (Memdata.size_chunk (cchunk c1))) (cofs c2))
            (BinInt.Z.le (BinInt.Z.add (cofs c2) (Memdata.size_chunk (cchunk c2))) (cofs c1)))
sorted_unique
     : forall (lo : BinNums.Z) (cs : list cell) (c1 c2 : cell) (_ : @eq bool (cells_sorted lo cs) true)
         (_ : @List.In cell c1 cs) (_ : @List.In cell c2 cs) (_ : @eq BinNums.Z (cofs c1) (cofs c2)),
       @eq cell c1 c2
set_cell_sorted
     : forall (lo : BinNums.Z) (cs : list cell) (d : BinNums.Z) (ch : AST.memory_chunk) (v : option sx)
         (_ : @eq bool (cells_sorted lo cs) true), @eq bool (cells_sorted lo (set_cell cs d ch v)) true
set_cell_In
     : forall (cs : list cell) (d : BinNums.Z) (ch : AST.memory_chunk) (v : option sx) (c : cell)
         (_ : @List.In cell c (set_cell cs d ch v)), or (@eq cell c (mkcell d ch v)) (@List.In cell c cs)
set_cell_new
     : forall (cs : list cell) (d : BinNums.Z) (ch : AST.memory_chunk) (v : option sx) (c : cell)
         (_ : @eq (option cell) (find_cell cs d ch) (@Some cell c)), @List.In cell (mkcell d ch v) (set_cell cs d ch v)
set_cell_shape
     : forall (cs : list cell) (d : BinNums.Z) (ch : AST.memory_chunk) (v : option sx),
       @eq (list (prod BinNums.Z AST.memory_chunk))
         (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape (set_cell cs d ch v))
         (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape cs)
shape_In
     : forall (cs cs' : list cell) (c' : cell)
         (_ : @eq (list (prod BinNums.Z AST.memory_chunk))
                (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape cs')
                (@List.map cell (prod BinNums.Z AST.memory_chunk) cshape cs)) (_ : @List.In cell c' cs'),
       @ex cell
         (fun c : cell =>
          and (@List.In cell c cs)
            (and (@eq BinNums.Z (cofs c) (cofs c')) (@eq AST.memory_chunk (cchunk c) (cchunk c'))))
rsep_shape
     : forall (β : layout) (regs regs' : list region)
         (_ : @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   regs')
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   regs)) (_ : rsep β regs), rsep β regs'
@upd_length ?A
     : forall (l : list ?A) (i : nat) (v : ?A), @eq nat (@length ?A (@upd ?A l i v)) (@length ?A l)
where
?A : [ |- Type]
@upd_same ?A
     : forall (l : list ?A) (i : nat) (v x : ?A) (_ : @eq (option ?A) (@List.nth_error ?A l i) (@Some ?A x)),
       @eq (option ?A) (@List.nth_error ?A (@upd ?A l i v) i) (@Some ?A v)
where
?A : [ |- Type]
@upd_other ?A
     : forall (l : list ?A) (i j : nat) (v : ?A) (_ : not (@eq nat i j)),
       @eq (option ?A) (@List.nth_error ?A (@upd ?A l i v) j) (@List.nth_error ?A l j)
where
?A : [ |- Type]
@upd_map_id ?A ?B
     : forall (f : forall _ : ?A, ?B) (l : list ?A) (i : nat) (v x : ?A)
         (_ : @eq (option ?A) (@List.nth_error ?A l i) (@Some ?A x)) (_ : @eq ?B (f v) (f x)),
       @eq (list ?B) (@List.map ?A ?B f (@upd ?A l i v)) (@List.map ?A ?B f l)
where
?A : [ |- Type]
?B : [ |- Type]
blk_inj
     : forall (β : list (prod Values.block BinNums.Z)) (r1 r2 : nat)
         (_ : @Coqlib.list_norepet Values.block
                (@List.map (prod Values.block BinNums.Z) Values.block (@fst Values.block BinNums.Z) β))
         (_ : lt r1 (@length (prod Values.block BinNums.Z) β)) (_ : lt r2 (@length (prod Values.block BinNums.Z) β))
         (_ : @eq Values.block (blk β r1) (blk β r2)), @eq nat r1 r2
xstore_shape
     : forall (regs : list region) (r : nat) (d : BinNums.Z) (ch : AST.memory_chunk) (x : sx)
         (regs' : list region) (_ : @eq (option (list region)) (xstore regs r d ch x) (@Some (list region) regs')),
       @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape regs')
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape regs)
xstore_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (regs : list region) (m : Memory.Mem.mem)
         (r : nat) (d : BinNums.Z) (ch : AST.memory_chunk) (x : sx) (regs' : list region) (_ : rep ρ β regs m)
         (_ : @eq (option (list region)) (xstore regs r d ch x) (@Some (list region) regs')),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem) (Memory.Mem.store ch m (blk β r) (BinInt.Z.add (bas β r) d) (den ρ (lay β) x))
               (@Some Memory.Mem.mem m'))
            (and
               (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add (bas β r) d))
                  (BinInt.Z.le (BinInt.Z.add (bas β r) d) Integers.Ptrofs.max_unsigned))
               (and (rep ρ β regs' m')
                  (Memory.Mem.unchanged_on
                     (fun (b : Values.block) (o : BinNums.Z) =>
                      not
                        (foot β
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              regs) b o)) m m'))))
xload_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (regs : list region) (m : Memory.Mem.mem)
         (r : nat) (d : BinNums.Z) (ch : AST.memory_chunk) (c : cell) (reg : region) (x : sx)
         (_ : rep ρ β regs m) (_ : @eq (option region) (@List.nth_error region regs r) (@Some region reg))
         (_ : @eq (option cell) (find_cell (rcells reg) d ch) (@Some cell c))
         (_ : @eq (option sx) (cval c) (@Some sx x)),
       and
         (@eq (option Values.val) (Memory.Mem.load ch m (blk β r) (BinInt.Z.add (bas β r) d))
            (@Some Values.val (den ρ (lay β) x)))
         (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add (bas β r) d))
            (BinInt.Z.le (BinInt.Z.add (bas β r) d) Integers.Ptrofs.max_unsigned))
zreg_load
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : layout)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (ρ n)))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (m : Memory.Mem.mem) (r : nat) (w : bool) (cs : list cell) (ofs : BinNums.Z)
         (_ : @eq bool (zreg_okb bnd ofs cs) true) (_ : @List.Forall cell (cell_ok ρ β m r w) cs),
       and
         (forall (i : nat) (z : BinNums.Z)
            (_ : @eq (option BinNums.Z) (@List.nth_error BinNums.Z (zcells (zrho ρ) cs) i) (@Some BinNums.Z z)),
          @eq (option Values.val)
            (Memory.Mem.load AST.Mint64 m (blk β r)
               (BinInt.Z.add (bas β r)
                  (BinInt.Z.add ofs
                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))))
            (@Some Values.val (Values.Vlong (Integers.Int64.repr z))))
         (Memory.Mem.range_perm m (blk β r) (BinInt.Z.add (bas β r) ofs)
            (BinInt.Z.add (BinInt.Z.add (bas β r) ofs)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                  (BinInt.Z.of_nat (@length cell cs)))) Memtype.Cur
            match w return Memtype.permission with
            | true => Memtype.Writable
            | false => Memtype.Readable
            end)
land_range
     : forall (a b n : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.lt a (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) n)))
         (_ : BinInt.Z.le BinNums.Z0 b) (_ : BinInt.Z.le BinNums.Z0 n),
       and (BinInt.Z.le BinNums.Z0 (BinInt.Z.land a b))
         (BinInt.Z.lt (BinInt.Z.land a b) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) n))
lor_range
     : forall (a b h : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.le a h))
         (_ : and (BinInt.Z.le BinNums.Z0 b) (BinInt.Z.le b h)),
       and (BinInt.Z.le BinNums.Z0 (BinInt.Z.lor a b))
         (BinInt.Z.le (BinInt.Z.lor a b)
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinInt.Z.add (BinInt.Z.log2 h) (BinNums.Zpos BinNums.xH))) (BinNums.Zpos BinNums.xH)))
lxor_range
     : forall (a b h : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.le a h))
         (_ : and (BinInt.Z.le BinNums.Z0 b) (BinInt.Z.le b h)),
       and (BinInt.Z.le BinNums.Z0 (BinInt.Z.lxor a b))
         (BinInt.Z.le (BinInt.Z.lxor a b)
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinInt.Z.add (BinInt.Z.log2 h) (BinNums.Zpos BinNums.xH))) (BinNums.Zpos BinNums.xH)))
op64_sound
     : forall (o : bop) (a b : Integers.Int64.int) (la ha lb hb lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z)) (zb_op M64 o la ha lb hb)
                (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi)))
         (_ : and (BinInt.Z.le la (Integers.Int64.unsigned a)) (BinInt.Z.le (Integers.Int64.unsigned a) ha))
         (_ : and (BinInt.Z.le lb (Integers.Int64.unsigned b)) (BinInt.Z.le (Integers.Int64.unsigned b) hb)),
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (lop o a b))
            (zop o (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
         (and (BinInt.Z.le lo (zop o (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
            (BinInt.Z.le (zop o (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)) hi))
op32_sound
     : forall (o : bop) (a b : Integers.Int.int) (la ha lb hb lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z)) (zb_op M32 o la ha lb hb)
                (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi)))
         (_ : and (BinInt.Z.le la (Integers.Int.unsigned a)) (BinInt.Z.le (Integers.Int.unsigned a) ha))
         (_ : and (BinInt.Z.le lb (Integers.Int.unsigned b)) (BinInt.Z.le (Integers.Int.unsigned b) hb)),
       and
         (@eq BinNums.Z (Integers.Int.unsigned (iop o a b)) (zop o (Integers.Int.unsigned a) (Integers.Int.unsigned b)))
         (and (BinInt.Z.le lo (zop o (Integers.Int.unsigned a) (Integers.Int.unsigned b)))
            (BinInt.Z.le (zop o (Integers.Int.unsigned a) (Integers.Int.unsigned b)) hi))
pow2_pos
     : forall (k : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 k),
       BinInt.Z.lt BinNums.Z0 (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
sh64_sound
     : forall (o : shop) (a : Integers.Int64.int) (la ha k lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z))
                (zb_sh
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) M64 o
                   la ha k) (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi)))
         (_ : and (BinInt.Z.le la (Integers.Int64.unsigned a)) (BinInt.Z.le (Integers.Int64.unsigned a) ha)),
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (lsh o a k))
            match o return BinNums.Z with
            | Hshl => BinInt.Z.mul (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
            | Hshr => BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
            | Hshru => BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
            end)
         (and
            (BinInt.Z.le lo
               match o return BinNums.Z with
               | Hshl =>
                   BinInt.Z.mul (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | Hshr =>
                   BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | Hshru =>
                   BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               end)
            (BinInt.Z.le
               match o return BinNums.Z with
               | Hshl =>
                   BinInt.Z.mul (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | Hshr =>
                   BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | Hshru =>
                   BinInt.Z.div (Integers.Int64.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               end hi))
sh32_sound
     : forall (o : shop) (a : Integers.Int.int) (la ha k lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z))
                (zb_sh (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) M32 o
                   la ha k) (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi)))
         (_ : and (BinInt.Z.le la (Integers.Int.unsigned a)) (BinInt.Z.le (Integers.Int.unsigned a) ha)),
       and
         (@eq BinNums.Z (Integers.Int.unsigned (ish o a k))
            match o return BinNums.Z with
            | Hshl => BinInt.Z.mul (Integers.Int.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
            | Hshr => BinInt.Z.div (Integers.Int.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
            | Hshru => BinInt.Z.div (Integers.Int.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
            end)
         (and
            (BinInt.Z.le lo
               match o return BinNums.Z with
               | Hshl => BinInt.Z.mul (Integers.Int.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | Hshr => BinInt.Z.div (Integers.Int.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | Hshru =>
                   BinInt.Z.div (Integers.Int.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               end)
            (BinInt.Z.le
               match o return BinNums.Z with
               | Hshl => BinInt.Z.mul (Integers.Int.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | Hshr => BinInt.Z.div (Integers.Int.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               | Hshru =>
                   BinInt.Z.div (Integers.Int.unsigned a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
               end hi))
cmpu64_zcmp
     : forall (c : Integers.comparison) (a b : Integers.Int64.int),
       @eq bool (Integers.Int64.cmpu c a b) (zcmp c (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
cmpu32_zcmp
     : forall (c : Integers.comparison) (a b : Integers.Int.int),
       @eq bool (Integers.Int.cmpu c a b) (zcmp c (Integers.Int.unsigned a) (Integers.Int.unsigned b))
cmp64_zcmp
     : forall (c : Integers.comparison) (a b : Integers.Int64.int)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned a)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned b)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))),
       @eq bool (Integers.Int64.cmp c a b) (zcmp c (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
cmp32_zcmp
     : forall (c : Integers.comparison) (a b : Integers.Int.int)
         (_ : BinInt.Z.lt (Integers.Int.unsigned a)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
         (_ : BinInt.Z.lt (Integers.Int.unsigned b)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))),
       @eq bool (Integers.Int.cmp c a b) (zcmp c (Integers.Int.unsigned a) (Integers.Int.unsigned b))
b2i_unsigned
     : forall b : bool, @eq BinNums.Z (Integers.Int.unsigned (b2i b)) (b2z b)
b2z_range
     : forall b : bool, and (BinInt.Z.le BinNums.Z0 (b2z b)) (BinInt.Z.le (b2z b) (BinNums.Zpos BinNums.xH))
zgood_KI
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (a : sx) (_ : @eq bool (isk KI a) true) (_ : zgood ρ β a),
       @eq BinNums.Z (Integers.Int.unsigned (ii (den ρ β a))) (zval (zrho ρ) a)
zgood_KL
     : forall (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z)
         (a : sx) (_ : @eq bool (isk KL a) true) (_ : zgood ρ β a),
       @eq BinNums.Z (Integers.Int64.unsigned (il (den ρ β a))) (zval (zrho ρ) a)
zb_sound
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : forall _ : nat, prod Values.block BinNums.Z)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (ρ n)))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (x : sx) (lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z)) (zb bnd x)
                (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi))),
       and (zgood ρ β x) (and (BinInt.Z.le lo (zval (zrho ρ) x)) (BinInt.Z.le (zval (zrho ρ) x) hi))
den_zval_long
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : forall _ : nat, prod Values.block BinNums.Z)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (ρ n)))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (x : sx) (lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z)) (zb bnd x)
                (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi))) (_ : @eq bool (isk KL x) true),
       and (@eq Values.val (den ρ β x) (Values.Vlong (Integers.Int64.repr (zval (zrho ρ) x))))
         (and (BinInt.Z.le lo (zval (zrho ρ) x)) (BinInt.Z.le (zval (zrho ρ) x) hi))
den_zval_int
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : forall _ : nat, prod Values.block BinNums.Z)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (ρ n)))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (x : sx) (lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z)) (zb bnd x)
                (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi))) (_ : @eq bool (isk KI x) true),
       and (@eq Values.val (den ρ β x) (Values.Vint (Integers.Int.repr (zval (zrho ρ) x))))
         (and (BinInt.Z.le lo (zval (zrho ρ) x)) (BinInt.Z.le (zval (zrho ρ) x) hi))
truth_zval
     : forall (ρ : forall _ : nat, Integers.Int64.int) (bnd : forall _ : nat, prod BinNums.Z BinNums.Z)
         (β : forall _ : nat, prod Values.block BinNums.Z)
         (_ : forall n : nat,
              and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (bnd n)) (Integers.Int64.unsigned (ρ n)))
                (BinInt.Z.le (Integers.Int64.unsigned (ρ n)) (@snd BinNums.Z BinNums.Z (bnd n))))
         (c : sx) (lo hi : BinNums.Z)
         (_ : @eq (option (prod BinNums.Z BinNums.Z)) (zb bnd c)
                (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z lo hi))) (_ : @eq bool (isk KI c) true),
       @eq bool (truth ρ β c) (negb (BinInt.Z.eqb (zval (zrho ρ) c) BinNums.Z0))
zval_ext
     : forall (z1 z2 : forall _ : nat, BinNums.Z) (x : sx) (_ : forall n : nat, @eq BinNums.Z (z1 n) (z2 n)),
       @eq BinNums.Z (zval z1 x) (zval z2 x)
copy_word_storebytes_effect
     : forall (m m' : Memory.Mem.mem) (bi : Values.block) (src : BinNums.Z) (bw : Values.block)
         (dst : BinNums.Z) (v : Integers.Int64.int) (bytes : list Memdata.memval)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bi src) (@Some Values.val (Values.Vlong v)))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bi src (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bw dst bytes) (@Some Memory.Mem.mem m'))
         (_ : BinInt.Z.divide (Memdata.align_chunk AST.Mint64) dst),
       and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m' bw dst) (@Some Values.val (Values.Vlong v)))
         (and
            (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
               (_ : or (not (@eq Values.block b bw))
                      (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) dst)
                         (BinInt.Z.le
                            (BinInt.Z.add dst (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
             @eq (option Values.val) (Memory.Mem.load chunk m' b ofs) (Memory.Mem.load chunk m b ofs))
            (and
               (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                  (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm m' b ofs kind p)
               (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))
