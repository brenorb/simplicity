              jets_sha._t'4)
           (Clight.Ssequence
              (cmp_blk (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) jets_sha._t'21 jets_sha._t'22 jets_sha._t'23
                 jets_sha._t'24 jets_sha._t'5)
              (Clight.Ssequence
                 (cmp_blk (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))) jets_sha._t'17 jets_sha._t'18
                    jets_sha._t'19 jets_sha._t'20 jets_sha._t'6)
                 (Clight.Ssequence
                    (cmp_blk (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))) jets_sha._t'13 jets_sha._t'14
                       jets_sha._t'15 jets_sha._t'16 jets_sha._t'7)
                    (Clight.Ssequence
                       (cmp_blk (BinNums.Zpos (BinNums.xI (BinNums.xI BinNums.xH))) jets_sha._t'9 jets_sha._t'10
                          jets_sha._t'11 jets_sha._t'12 jets_sha._t'8)
