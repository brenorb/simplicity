     : forall (m m1 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cur : BinNums.Z) (bit : bool) (be : Values.block) (ebase : BinNums.Z) (bt : Values.block)
         (txbase : BinNums.Z) (bout : Values.block) (outbase : BinNums.Z) (i count : Integers.Int64.int)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xI
                      (BinNums.xO
                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                cur)
         (_ : jet_elements_effects.write_effect m m1 bd dbase bw edge cur (BinNums.Zpos BinNums.xH)
                (@cons (option bool) (@Some bool bit) (@nil (option bool))))
         (_ : @List.Forall (prod (prod Values.block BinNums.Z) BinNums.Z)
                (fun pat : prod (prod Values.block BinNums.Z) BinNums.Z =>
                 match pat return Prop with
                 | pair y hi =>
                     match y return Prop with
                     | pair b lo =>
                         out_sep bd dbase bw edge cur
                           (BinNums.Zpos
                              (BinNums.xI
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                           b lo hi
                     end
                 end)
                (jet_elements_null_data_guard_compose.elements_null_data_count_footprint be ebase bt txbase bout
                   outbase i))
