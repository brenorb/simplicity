                  (@cons AST.ident jets_secp._p2
                     (@cons AST.ident jets_secp._p3 (@cons AST.ident jets_secp._p4 (@nil AST.ident))))))) true
reduce512_second_limb_kinds
     : @eq bool (@List.forallb sx (isk KL) reduce512_second_limbs) true
reduce512_typed_stage_source
     : @eq Clight.statement (statement_sequence reduce512_first_spine reduce512_typed_stage) reduce512_second_prefix
