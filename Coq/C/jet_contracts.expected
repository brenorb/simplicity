  | Clight.Scontinue =>
      @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
      :
      @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl Clight.Scontinue (cont_app k0 k))
        (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
           (fun p : prod Clight.statement Clight.cont =>
            @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
              (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl Clight.Scontinue k0))
  | Clight.Sreturn o =>
      (fun o0 : option Clight.expr =>
