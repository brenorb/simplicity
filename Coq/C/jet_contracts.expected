complement_spec_numeric
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ n) (@complement_spec n Alg.CoreFunSem x))
