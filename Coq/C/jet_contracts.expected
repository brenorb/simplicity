match k return BinNums.Z with
| PointX => BinNums.Z0
| PointY => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))
| PointZ => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
end
     : forall _ : point_coordinate, BinNums.Z

Arguments point_coordinate_offset k
point_write_initial_regs =
fun k : point_coordinate =>
@cons region
  (free_region (mkreg (u64_cells (point_coordinate_offset k) (vars5 (S O))) true (@None BinNums.Z))
     (BinNums.Zpos
        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
  (@nil region)
     : forall _ : point_coordinate, list region

Arguments point_write_initial_regs k
point_write_run =
fun (k : point_coordinate) (bd : Values.block) (base : Integers.Ptrofs.int) =>
xfun (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type))) write_fe_table
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))) jets_secp.f_write_fe
  (@cons sx (XA bd base) (@cons sx (XP O (point_coordinate_offset k)) (@nil sx))) (point_write_initial_regs k)
  (@nil event) (S (S (S (S (S (S O))))))
     : forall (_ : point_coordinate) (_ : Values.block) (_ : Integers.Ptrofs.int), option res

