region_u64_transport
     : forall (rho rho' : forall _ : nat, Integers.Int64.int) (beta beta' : layout) (m : Memory.Mem.mem)
         (r r' : nat) (xs ys : list sx) (w : bool) (owned : option BinNums.Z)
         (_ : @eq (prod Values.block BinNums.Z) (lay beta' r') (lay beta r))
         (_ : @eq nat (@length sx ys) (@length sx xs))
         (_ : @eq (list Values.val) (@List.map sx Values.val (den rho' (lay beta')) ys)
                (@List.map sx Values.val (den rho (lay beta)) xs)) (_ : @eq bool (@List.forallb sx (xp_le r') ys) true)
         (_ : region_ok rho beta m r (mkreg (u64_cells BinNums.Z0 xs) w owned)),
       region_ok rho' beta' m r' (mkreg (u64_cells BinNums.Z0 ys) w owned)
eight_words_nth
     : forall (xs : list Integers.Int64.int)
         (_ : @eq nat (@length Integers.Int64.int xs) (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Integers.Int64.int) xs
         (@cons Integers.Int64.int (@List.nth Integers.Int64.int O xs Integers.Int64.zero)
            (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S O) xs Integers.Int64.zero)
               (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S O)) xs Integers.Int64.zero)
                  (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S (S O))) xs Integers.Int64.zero)
                     (@cons Integers.Int64.int (@List.nth Integers.Int64.int (S (S (S (S O)))) xs Integers.Int64.zero)
                        (@cons Integers.Int64.int
                           (@List.nth Integers.Int64.int (S (S (S (S (S O))))) xs Integers.Int64.zero)
                           (@cons Integers.Int64.int
                              (@List.nth Integers.Int64.int (S (S (S (S (S (S O)))))) xs Integers.Int64.zero)
                              (@cons Integers.Int64.int
                                 (@List.nth Integers.Int64.int (S (S (S (S (S (S (S O))))))) xs Integers.Int64.zero)
                                 (@nil Integers.Int64.int)))))))))
product_reduce_input_map
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Values.val)
         (@List.map sx Values.val (den (product_reduce_rho rho) beta)
            (@cons sx (XLv O)
               (@cons sx (XLv (S O))
                  (@cons sx (XLv (S (S O)))
                     (@cons sx (XLv (S (S (S O))))
                        (@cons sx (XLv (S (S (S (S O)))))
                           (@cons sx (XLv (S (S (S (S (S O))))))
                              (@cons sx (XLv (S (S (S (S (S (S O)))))))
                                 (@cons sx (XLv (S (S (S (S (S (S (S O)))))))) (@nil sx))))))))))
         (@List.map Integers.Int64.int Values.val Values.Vlong (scalar_mul512_machine_outputs rho))
product_reduce_output_map
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta beta' : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Values.val)
         (@List.map sx Values.val (den (product_reduce_rho rho) beta')
            (@cons sx (XLv (S (S (S (S (S (S (S (S O)))))))))
               (@cons sx (XLv (S (S (S (S (S (S (S (S (S O))))))))))
                  (@cons sx (XLv (S (S (S (S (S (S (S (S (S (S O)))))))))))
                     (@cons sx (XLv (S (S (S (S (S (S (S (S (S (S (S O)))))))))))) (@nil sx))))))
         (@List.map sx Values.val (den rho beta)
            (@cons sx (XLv O)
               (@cons sx (XLv (S O)) (@cons sx (XLv (S (S O))) (@cons sx (XLv (S (S (S O)))) (@nil sx))))))
empty_region_index
     : forall n : nat, @eq (option region) (@List.nth_error region (@nil region) n) (@None region)
product_reduce_entry_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta (sregs scalar_mul512_state) m),
       rep (product_reduce_rho rho) (product_reduce_layout beta) scalar_reduce512_initial_regs m
product_reduce_integer
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (reduce512_input_integer (product_reduce_rho rho))
         (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho (S (S (S (S O))))))
product_reduce_foot_embed
     : forall (beta : layout) (b : Values.block) (ofs : BinNums.Z)
         (_ : foot (product_reduce_layout beta)
                (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                   scalar_reduce512_initial_regs) b ofs),
       foot beta
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
            scalar_mul512_fresh_regs) b ofs
eval_product_then_reduce
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_mul512_fresh_regs m),
       @ex Memory.Mem.mem
         (fun mp : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
                  (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                     (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                        (@cons Values.val
                           (Values.Vptr (blk beta (S (S O))) (Integers.Ptrofs.repr (bas beta (S (S O)))))
                           (@nil Values.val)))) Events.E0 mp Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall secp_ge mp
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_reduce_512)
                     (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                        (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                           (@nil Values.val))) Events.E0 mf Values.Vundef)
                  (and
                     (rep (product_reduce_rho rho) (product_reduce_layout beta)
                        (reduce512_numeric_owned_regs (product_reduce_rho rho)) mf)
                     (and
                        (@eq BinNums.Z
                           (final_output_value (reduce512_body_digits (product_reduce_rho rho))
                              (reduce512_body_carry (product_reduce_rho rho)) (product_reduce_rho rho)
                              (lay (product_reduce_layout beta)))
                           (BinInt.Z.modulo
                              (BinInt.Z.mul (scalar_mul512_input_value rho O)
                                 (scalar_mul512_input_value rho (S (S (S (S O)))))) canonical_group_order))
                        (and
                           (lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (foot beta
                                    (@List.map region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       rshape scalar_mul512_fresh_regs) b ofs)) m mp)
                           (lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (foot (product_reduce_layout beta)
                                    (@List.map region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       rshape scalar_reduce512_initial_regs) b ofs)) mp mf)))))))
