Arguments word_slice_eq (lo count)%Z_scope a b
word_outside_eq =
fun (lo count : BinNums.Z) (a b : Integers.Int64.int) =>
forall (i : BinNums.Z)
  (_ : and (BinInt.Z.le BinNums.Z0 i)
         (BinInt.Z.lt i
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
  (_ : or (BinInt.Z.lt i lo) (BinInt.Z.le (BinInt.Z.add lo count) i)),
