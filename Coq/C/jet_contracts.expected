               (@Ctypes.Internal Clight.function (shift8_plain_function right)) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@shift8_plain_spec right Naive.translate) (Running s0) (Running s1))))
