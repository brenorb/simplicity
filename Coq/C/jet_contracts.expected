                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b ofs
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable) (_ : BinInt.Z.le BinNums.Z0 offset)
         (_ : BinInt.Z.le
                (BinInt.Z.add offset
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bb offset
                (BinInt.Z.add offset
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Readable)
         (_ : forall (i : nat)
                (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bb (BinInt.Z.add offset (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (Integers.Int.repr (@List.nth BinNums.Z i bytes BinNums.Z0)))))
         (_ : not (@eq Values.block b bb)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_set_b32)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr ofs))
                  (@cons Values.val (Values.Vptr bb (Integers.Ptrofs.repr offset)) (@nil Values.val))) Events.E0 mf
               (Values.Vint (Integers.Int.repr (b2z (BinInt.Z.ltb (jet_secp_fe_math.be_val bytes) feP)))))
            (and
               (fe_at mf b ofs
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (fe_limbs_of (jet_secp_fe_math.be_val bytes))))
               (lframe
                  (fun (block : Values.block) (pos : BinNums.Z) =>
                   not
                     (foot
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b ofs)
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb offset)
                              (@nil (prod Values.block BinNums.Z))))
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           (@cons region fe_undef
                              (@cons region
                                 (mkreg
                                    (jet_secp_fe_b32.byte_cells BinNums.Z0
                                       (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))) O) false
                                    (@None BinNums.Z)) (@nil region)))) block pos)) m mf)))
