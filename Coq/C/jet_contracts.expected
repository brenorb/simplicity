                     (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl s1 k0))) b
        end)
       :
       @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl (Clight.Slabel l0 s1) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl (Clight.Slabel l0 s1) k0))) l
        s0
  | Clight.Sgoto l =>
