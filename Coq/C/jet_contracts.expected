  end
with find_label_ls_app (lbl : Clight.label) (sl : Clight.labeled_statements) (k0 k : Clight.cont) {struct sl} :
    @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label_ls lbl sl (cont_app k0 k))
      (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
         (fun p : prod Clight.statement Clight.cont =>
          @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
            (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label_ls lbl sl k0)) :=
  match
    sl as l
    return
      (@eq (option (prod Clight.statement Clight.cont)) (Clight.find_label_ls lbl l (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label_ls lbl l k0)))
  with
  | Clight.LSnil =>
      @eq_refl (option (prod Clight.statement Clight.cont)) (@None (prod Clight.statement Clight.cont))
      :
      @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label_ls lbl Clight.LSnil (cont_app k0 k))
        (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
           (fun p : prod Clight.statement Clight.cont =>
            @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
              (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label_ls lbl Clight.LSnil k0))
  | Clight.LScons o s l =>
      (fun (o0 : option BinNums.Z) (s0 : Clight.statement) (sl0 : Clight.labeled_statements) =>
       @eq_ind_r (option (prod Clight.statement Clight.cont))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k))
            (Clight.find_label lbl s0 (Clight.Kseq (Clight.seq_of_labeled_statement sl0) k0)))
         (fun o1 : option (prod Clight.statement Clight.cont) =>
          @eq (option (prod Clight.statement Clight.cont))
            match o1 return (option (prod Clight.statement Clight.cont)) with
            | Some sk => @Some (prod Clight.statement Clight.cont) sk
            | None => Clight.find_label_ls lbl sl0 (cont_app k0 k)
            end
            (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
               (fun p : prod Clight.statement Clight.cont =>
                @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                  (cont_app (@snd Clight.statement Clight.cont p) k))
               match
                 Clight.find_label lbl s0 (Clight.Kseq (Clight.seq_of_labeled_statement sl0) k0)
                 return (option (prod Clight.statement Clight.cont))
               with
               | Some sk => @Some (prod Clight.statement Clight.cont) sk
               | None => Clight.find_label_ls lbl sl0 k0
               end))
         (let o1 : option (prod Clight.statement Clight.cont) :=
            Clight.find_label lbl s0 (Clight.Kseq (Clight.seq_of_labeled_statement sl0) k0) in
          match
            o1 as o2
            return
              (@eq (option (prod Clight.statement Clight.cont))
                 match
                   @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                     (fun p : prod Clight.statement Clight.cont =>
                      @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                        (cont_app (@snd Clight.statement Clight.cont p) k)) o2
                   return (option (prod Clight.statement Clight.cont))
                 with
                 | Some sk => @Some (prod Clight.statement Clight.cont) sk
                 | None => Clight.find_label_ls lbl sl0 (cont_app k0 k)
                 end
                 (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k))
                    match o2 return (option (prod Clight.statement Clight.cont)) with
                    | Some sk => @Some (prod Clight.statement Clight.cont) sk
                    | None => Clight.find_label_ls lbl sl0 k0
                    end))
          with
          | Some a =>
              (fun p : prod Clight.statement Clight.cont =>
               @eq_refl (option (prod Clight.statement Clight.cont))
                 (@Some (prod Clight.statement Clight.cont)
                    (@pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k)))
               :
               @eq (option (prod Clight.statement Clight.cont))
                 match
                   @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                     (fun p0 : prod Clight.statement Clight.cont =>
                      @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p0)
                        (cont_app (@snd Clight.statement Clight.cont p0) k))
                     (@Some (prod Clight.statement Clight.cont) p) return (option (prod Clight.statement Clight.cont))
                 with
                 | Some sk => @Some (prod Clight.statement Clight.cont) sk
                 | None => Clight.find_label_ls lbl sl0 (cont_app k0 k)
                 end
                 (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p0 : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p0)
                       (cont_app (@snd Clight.statement Clight.cont p0) k))
                    (@Some (prod Clight.statement Clight.cont) p))) a
          | None =>
              find_label_ls_app lbl sl0 k0 k
              :
              @eq (option (prod Clight.statement Clight.cont))
                match
                  @Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                    (fun p : prod Clight.statement Clight.cont =>
                     @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                       (cont_app (@snd Clight.statement Clight.cont p) k)) (@None (prod Clight.statement Clight.cont))
                  return (option (prod Clight.statement Clight.cont))
                with
                | Some sk => @Some (prod Clight.statement Clight.cont) sk
                | None => Clight.find_label_ls lbl sl0 (cont_app k0 k)
                end
                (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
                   (fun p : prod Clight.statement Clight.cont =>
                    @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
                      (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label_ls lbl sl0 k0))
          end) (Clight.find_label lbl s0 (cont_app (Clight.Kseq (Clight.seq_of_labeled_statement sl0) k0) k))
         (find_label_app lbl s0 (Clight.Kseq (Clight.seq_of_labeled_statement sl0) k0) k)
       :
       @eq (option (prod Clight.statement Clight.cont))
         (Clight.find_label_ls lbl (Clight.LScons o0 s0 sl0) (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k))
            (Clight.find_label_ls lbl (Clight.LScons o0 s0 sl0) k0))) o s l
  end
for
find_label_app
     : forall (lbl : Clight.label) (s : Clight.statement) (k0 k : Clight.cont),
       @eq (option (prod Clight.statement Clight.cont)) (Clight.find_label lbl s (cont_app k0 k))
         (@Coqlib.option_map (prod Clight.statement Clight.cont) (prod Clight.statement Clight.cont)
            (fun p : prod Clight.statement Clight.cont =>
             @pair Clight.statement Clight.cont (@fst Clight.statement Clight.cont p)
               (cont_app (@snd Clight.statement Clight.cont p) k)) (Clight.find_label lbl s k0))

Arguments find_label_app lbl s k0 k
Variant
call_boundary (ge : Clight.genv) (fd : Clight.fundef) (args : list Values.val) (k : Clight.cont)
(m : Memory.Mem.mem) (res : Values.val) (mf : Memory.Mem.mem) (n : nat) : Prop :=
    Build_call_boundary : forall
                            (_ : @Smallstep.starN Clight.genv Clight.state Clight.step2 ge n
                                   (Clight.Callstate fd args k m) Events.E0 (Clight.Returnstate res k mf))
                            (_ : forall (j : nat) (t : Events.trace) (S : Clight.state) (_ : lt j n)
                                   (_ : @Smallstep.starN Clight.genv Clight.state Clight.step2 ge j
                                          (Clight.Callstate fd args k m) t S),
                                 and (@eq Events.trace t Events.E0)
                                   (and
                                      (forall (v : Values.val) (k' : Clight.cont) (m' : Memory.Mem.mem)
                                         (_ : @eq Clight.state S (Clight.Returnstate v k' m')),
                                       not (@eq Clight.cont k' k))
                                      (@ex Clight.state
                                         (fun S' : Clight.state =>
                                          and (Clight.step2 ge S Events.E0 S')
                                            (forall (t' : Events.trace) (S'' : Clight.state)
                                               (_ : Clight.step2 ge S t' S''),
                                             and (@eq Events.trace t' Events.E0) (@eq Clight.state S'' S'))))))
                            (_ : forall (j : nat) (t : Events.trace) (S : Clight.state) (_ : le n j)
                                   (_ : @Smallstep.starN Clight.genv Clight.state Clight.step2 ge j
                                          (Clight.Callstate fd args k m) t S),
                                 @Smallstep.starN Clight.genv Clight.state Clight.step2 ge
                                   (Nat.sub j n) (Clight.Returnstate res k mf) t S)
                            (_ : forall (T : Events.traceinf)
                                   (_ : @Smallstep.forever Clight.genv Clight.state Clight.step2 ge
                                          (Clight.Callstate fd args k m) T),
                                 @Smallstep.forever Clight.genv Clight.state Clight.step2 ge
                                   (Clight.Returnstate res k mf) T), call_boundary ge fd args k m res mf n.

Arguments call_boundary ge fd args%list_scope k m res mf n%nat_scope
Arguments Build_call_boundary ge fd args%list_scope k m res mf n%nat_scope cb_path
  (cb_before cb_after cb_forever)%function_scope
silent_call_guarantees =
fun (ge : Clight.genv) (fd : Clight.fundef) (args : list Values.val) (m : Memory.Mem.mem) (res : Values.val)
  (mf : Memory.Mem.mem) =>
and
  (forall (k : Clight.cont) (_ : Clight.is_call_cont k), @ex nat (fun n : nat => call_boundary ge fd args k m res mf n))
  (and
     (forall (t' : Events.trace) (m' : Memory.Mem.mem) (res' : Values.val)
        (_ : ClightBigstep.Clight2.eval_funcall ge m fd args t' m' res'),
      and (@eq Events.trace t' Events.E0) (and (@eq Memory.Mem.mem m' mf) (@eq Values.val res' res)))
     (and
        (forall T : Events.traceinf,
         not (@Smallstep.forever Clight.genv Clight.state Clight.step2 ge (Clight.Callstate fd args Clight.Kstop m) T))
        (forall (t : Events.trace) (S : Clight.state)
           (_ : @Smallstep.star Clight.genv Clight.state Clight.step2 ge (Clight.Callstate fd args Clight.Kstop m) t S)
           (_ : forall (t' : Events.trace) (S' : Clight.state), not (Clight.step2 ge S t' S')),
         and (@eq Events.trace t Events.E0) (@eq Clight.state S (Clight.Returnstate res Clight.Kstop mf)))))
     : forall (_ : Clight.genv) (_ : Clight.fundef) (_ : list Values.val) (_ : Memory.Mem.mem)
         (_ : Values.val) (_ : Memory.Mem.mem), Prop

Arguments silent_call_guarantees ge fd args%list_scope m res mf
Inductive wide_size : Set :=  W16 : wide_size | W32 : wide_size | W64 : wide_size.
Inductive constant_size : Set :=
    C1 : constant_size | C8 : constant_size | C16 : constant_size | C32 : constant_size | C64 : constant_size.
constant_bits =
fun s : constant_size =>
match s return BinNums.Z with
| C1 => BinNums.Zpos BinNums.xH
| C8 => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))
| C16 => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
| C32 => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
| C64 => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
end
     : forall _ : constant_size, BinNums.Z

Arguments constant_bits s
constant_log =
fun s : constant_size =>
match s return nat with
| C1 => O
| C8 => S (S (S O))
| C16 => S (S (S (S O)))
| C32 => S (S (S (S (S O))))
| C64 => S (S (S (S (S (S O)))))
end
     : forall _ : constant_size, nat

Arguments constant_log s
constant_jet =
fun (s : constant_size) (high : bool) =>
match s return Clight.function with
| C1 => match high return Clight.function with
        | true => f_simplicity_high_1
        | false => f_simplicity_low_1
        end
| C8 => match high return Clight.function with
        | true => f_simplicity_high_8
        | false => f_simplicity_low_8
        end
| C16 => match high return Clight.function with
         | true => f_simplicity_high_16
         | false => f_simplicity_low_16
         end
| C32 => match high return Clight.function with
         | true => f_simplicity_high_32
         | false => f_simplicity_low_32
         end
| C64 => match high return Clight.function with
         | true => f_simplicity_high_64
         | false => f_simplicity_low_64
         end
end
     : forall (_ : constant_size) (_ : bool), Clight.function

Arguments constant_jet s high%bool_scope
constant_spec =
fun (s : constant_size) (high : bool) (term : Alg.Core.Algebra) =>
match high return (Alg.Core.domain term Ty.Unit (Word.Word (constant_log s))) with
| true => @Word.fill Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (constant_log s) term (@Bit.true Ty.Unit term)
| false => @Word.zero (constant_log s) term
end
     : forall (s : constant_size) (_ : bool) (term : Alg.Core.Algebra),
       Alg.Core.domain term Ty.Unit (Word.Word (constant_log s))

Arguments constant_spec s high%bool_scope {term}
constant_writer =
fun s : constant_size =>
match s return Clight.function with
| C1 => f_writeBit
| C8 => f_simplicity_write8
| C16 => wide_writer W16
| C32 => wide_writer W32
| C64 => wide_writer W64
end
     : forall _ : constant_size, Clight.function

Arguments constant_writer s
constant_writer_id =
fun s : constant_size =>
match s return AST.ident with
| C1 => _writeBit
| C8 => _simplicity_write8
| C16 => wide_writer_id W16
| C32 => wide_writer_id W32
| C64 => wide_writer_id W64
end
     : forall _ : constant_size, AST.ident

Arguments constant_writer_id s
constant_arg_type =
fun s : constant_size =>
match s return Ctypes.type with
| C1 => Ctypesdefs.tbool
| C8 => Ctypesdefs.tuchar
| C16 => Ctypesdefs.tulong
| C32 => Ctypesdefs.tulong
| C64 => Ctypesdefs.tulong
end
     : forall _ : constant_size, Ctypes.type

Arguments constant_arg_type s
constant_return_type =
fun s : constant_size =>
match s return Ctypes.type with
| C1 => Ctypesdefs.tbool
| C8 => Ctypesdefs.tvoid
| C16 => Ctypesdefs.tvoid
| C32 => Ctypesdefs.tvoid
| C64 => Ctypesdefs.tvoid
end
     : forall _ : constant_size, Ctypes.type

Arguments constant_return_type s
constant_unsigned =
fun (s : constant_size) (high : bool) =>
match high return BinNums.Z with
| true =>
    BinInt.Z.sub (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (constant_bits s)) (BinNums.Zpos BinNums.xH)
| false => BinNums.Z0
end
     : forall (_ : constant_size) (_ : bool), BinNums.Z

Arguments constant_unsigned s high%bool_scope
constant_value =
fun (s : constant_size) (high : bool) =>
match s return Values.val with
| C1 => Values.Vint (Integers.Int.repr (constant_unsigned s high))
| C8 => Values.Vint (Integers.Int.repr (constant_unsigned s high))
| C16 => Values.Vlong (Integers.Int64.repr (constant_unsigned s high))
| C32 => Values.Vlong (Integers.Int64.repr (constant_unsigned s high))
| C64 => Values.Vlong (Integers.Int64.repr (constant_unsigned s high))
end
     : forall (_ : constant_size) (_ : bool), Values.val

Arguments constant_value s high%bool_scope
constant_return =
fun (s : constant_size) (high : bool) =>
match s return Values.val with
| C1 => constant_value s high
| C8 => Values.Vundef
| C16 => Values.Vundef
| C32 => Values.Vundef
| C64 => Values.Vundef
end
     : forall (_ : constant_size) (_ : bool), Values.val

Arguments constant_return s high%bool_scope
constant_expr =
fun (s : constant_size) (high : bool) =>
match high return Clight.expr with
| true =>
    match s return Clight.expr with
    | C1 => Clight.Econst_int Integers.Int.one Ctypesdefs.tint
    | C8 =>
        Clight.Econst_int
          (Integers.Int.repr
             (BinNums.Zpos
                (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
          Ctypesdefs.tint
    | C16 =>
        Clight.Econst_int
          (Integers.Int.repr
             (BinNums.Zpos
                (BinNums.xI
                   (BinNums.xI
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
          Ctypesdefs.tint
    | C32 => Clight.Econst_int (Integers.Int.repr (BinNums.Zneg BinNums.xH)) Ctypesdefs.tuint
    | C64 => Clight.Econst_long (Integers.Int64.repr (BinNums.Zneg BinNums.xH)) Ctypesdefs.tulong
    end
| false => Clight.Econst_int Integers.Int.zero Ctypesdefs.tint
end
     : forall (_ : constant_size) (_ : bool), Clight.expr

Arguments constant_expr s high%bool_scope
constant_raw =
fun (s : constant_size) (high : bool) =>
match high return Values.val with
| true =>
    match s return Values.val with
    | C1 => Values.Vint Integers.Int.one
    | C8 =>
        Values.Vint
          (Integers.Int.repr
             (BinNums.Zpos
                (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
    | C16 =>
        Values.Vint
          (Integers.Int.repr
             (BinNums.Zpos
                (BinNums.xI
                   (BinNums.xI
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
    | C32 => Values.Vint (Integers.Int.repr (BinNums.Zneg BinNums.xH))
    | C64 => Values.Vlong (Integers.Int64.repr (BinNums.Zneg BinNums.xH))
    end
| false => Values.Vint Integers.Int.zero
end
     : forall (_ : constant_size) (_ : bool), Values.val

Arguments constant_raw s high%bool_scope
Word.zero =
fix zero (n : nat) (term : Alg.Core.Algebra) {struct n} : Alg.Core.domain term Ty.Unit (Word.Word n) :=
  match n as n0 return (Alg.Core.domain term Ty.Unit (Word.Word n0)) with
  | O => @Bit.false Ty.Unit term
  | S n0 => @Alg.Core.Combinators.pair Ty.Unit (Word.Word n0) (Word.Word n0) term (zero n0 term) (zero n0 term)
  end
     : forall (n : nat) (term : Alg.Core.Algebra), Alg.Core.domain term Ty.Unit (Word.Word n)

Arguments Word.zero {n}%nat_scope {term}
Word.fill =
fix fill (C X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra) (t : Alg.Core.domain term C X) {struct n} :
    Alg.Core.domain term C (Word.Vector X n) :=
  match n as n0 return (Alg.Core.domain term C (Word.Vector X n0)) with
  | O => t
  | S n0 => @Word.build_fill C (Word.Vector X n0) term (fill C X n0 term t)
  end
     : forall (C X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra) (_ : Alg.Core.domain term C X),
       Alg.Core.domain term C (Word.Vector X n)

Arguments Word.fill {C X}%ty_scope {n}%nat_scope {term} t
