match @Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) id return Values.block with
| Some b => b
| None => BinNums.xH
end
     : forall _ : AST.ident, Values.block

Arguments secp_symbol_block id
secp_core_helpers =
@cons (prod AST.ident Clight.function) (@pair AST.ident Clight.function _LSBclear f_LSBclear)
  (@cons (prod AST.ident Clight.function) (@pair AST.ident Clight.function _LSBkeep f_LSBkeep)
     (@cons (prod AST.ident Clight.function) (@pair AST.ident Clight.function _simplicity_write8 f_simplicity_write8)
        (@cons (prod AST.ident Clight.function)
