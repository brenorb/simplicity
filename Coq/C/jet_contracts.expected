write8s_run =
fix write8s_run
  (bi : Values.block) (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
  (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons x rest =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         and
           (@eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m bi input) (@Some Values.val (Values.Vint x)))
           (and
              (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_write8)
                 (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                    (@cons Values.val (Values.Vint x) (@nil Values.val))) Events.E0 mi Values.Vundef)
              (write8s_run bi (BinInt.Z.add input (BinNums.Zpos BinNums.xH)) bf base rest mi mf)))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int.int)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

