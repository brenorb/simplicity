Arguments scalar_reader_set_tree bi edge
scalar_reader_set_state =
fun (bi : Values.block) (edge : Integers.Ptrofs.int) =>
match scalar_reader_set_tree bi edge return sstate with
| Some r =>
    match r return sstate with
    | RDone state _ => state
    | RIf _ _ _ => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
    end
| None => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
end
     : forall (_ : Values.block) (_ : Integers.Ptrofs.int), sstate

Arguments scalar_reader_set_state bi edge
scalar_reader_byte_shift = fun n : nat => XLv (S n)
     : forall _ : nat, sx

Arguments scalar_reader_byte_shift n%nat_scope
scalar_reader_set_concrete_temps =
fun (rho : forall _ : nat, Integers.Int64.int) (layout : layout) =>
@Maps.PTree.set Values.val jets_secp._overflow (den rho (lay layout) (XLc Integers.Int64.zero))
  (@Maps.PTree.set Values.val jets_secp._b32 (den rho (lay layout) (XP (S (S O)) BinNums.Z0))
     (@Maps.PTree.set Values.val jets_secp._r (den rho (lay layout) (XP O BinNums.Z0))
        (Clight.create_undef_temps (Clight.fn_temps jets_secp.f_secp256k1_scalar_set_b32))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : layout), Maps.PTree.tree Values.val

Arguments scalar_reader_set_concrete_temps rho%function_scope layout
scalar_reader_second =
match Clight.fn_body jets_secp.f_read_scalar return Clight.statement with
| Clight.Sskip => Clight.Sskip
| Clight.Sassign _ _ => Clight.Sskip
| Clight.Sset _ _ => Clight.Sskip
| Clight.Scall _ _ _ => Clight.Sskip
| Clight.Sbuiltin _ _ _ _ => Clight.Sskip
| Clight.Ssequence _ second => second
| Clight.Sifthenelse _ _ _ => Clight.Sskip
| Clight.Sloop _ _ => Clight.Sskip
| Clight.Sbreak => Clight.Sskip
| Clight.Scontinue => Clight.Sskip
| Clight.Sreturn _ => Clight.Sskip
| Clight.Sswitch _ _ => Clight.Sskip
| Clight.Slabel _ _ => Clight.Sskip
| Clight.Sgoto _ => Clight.Sskip
end
     : Clight.statement
