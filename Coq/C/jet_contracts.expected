add16_values_denote_input
     : forall (r s : Integers.Int64.int) (x y : Ty.tySem (Word.Word (S (S (S (S O))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S O))))) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned s) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S O))))) y)),
