fun (n : nat) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp
  (Ty.Prod
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) n)
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) n))
  (Ty.Prod
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) n)
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Ty.Sum Ty.Unit Ty.Unit) term
  (@Alg.Core.Combinators.pair
     (Ty.Prod
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) n)
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) n))
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) n)
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) n) term
     (@Alg.Core.Combinators.drop
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) n)
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) n)
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) n) term
        (@Alg.Core.Combinators.iden
           ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
               match n0 return Ty.Ty with
               | O => X
               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
               end) (Ty.Sum Ty.Unit Ty.Unit) n) term))
     (@Alg.Core.Combinators.take
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) n)
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) n)
        ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
            match n0 return Ty.Ty with
            | O => X
            | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
            end) (Ty.Sum Ty.Unit Ty.Unit) n) term
        (@Alg.Core.Combinators.iden
           ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
               match n0 return Ty.Ty with
               | O => X
               | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
               end) (Ty.Sum Ty.Unit Ty.Unit) n) term)))
  (@Alg.Core.Combinators.comp (Word.Word (S n))
     ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
         match n0 return Ty.Ty with
         | O => X
         | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
         end) (Ty.Sum Ty.Unit Ty.Unit) n) (Ty.Sum Ty.Unit Ty.Unit) term (@modulo_word_spec n term)
     (@is_zero_word_spec n term))
     : forall (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod
            ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                match n0 return Ty.Ty with
                | O => X
                | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                end) (Ty.Sum Ty.Unit Ty.Unit) n)
            ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                match n0 return Ty.Ty with
                | O => X
                | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                end) (Ty.Sum Ty.Unit Ty.Unit) n)) (Ty.Sum Ty.Unit Ty.Unit)

Arguments divides_word_spec n%nat_scope {term}
division_normalized_result =
fun (n : nat) (rec : Ty.Arrow (Ty.Prod (Word.Word (S n)) (Word.Word n)) (Word.Word (S n))) =>
forall (a : Ty.tySem (Word.Word (S n))) (b : Ty.tySem (Word.Word n))
  (_ : BinInt.Z.le (word_modulus n)
         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
  (_ : BinInt.Z.lt (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) a)
         (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ n) b) (word_modulus n))),
let qr : Ty.tySem (Word.Word (S n)) := rec (@pair (Ty.tySem (Word.Word (S n))) (Ty.tySem (Word.Word n)) a b) in
and
  (@eq BinNums.Z
     (BinInt.Z.add
        (BinInt.Z.mul
           (@Word.ToZ.Theory.toZ (Word.WordToZ n)
              (@fst
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                        match n0 return Ty.Ty with
                        | O => X
                        | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                        end) (Ty.Sum Ty.Unit Ty.Unit) n))
                 ((fix tySem (X : Ty.Ty) : Set :=
                     match X return Set with
                     | Ty.Unit => unit
                     | Ty.Sum A B => sum (tySem A) (tySem B)
                     | Ty.Prod A B => prod (tySem A) (tySem B)
                     end)
                    ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                        match n0 return Ty.Ty with
                        | O => X
                        | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                        end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr)) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b))
        (@Word.ToZ.Theory.toZ (Word.WordToZ n)
           (@snd
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr))) (@Word.ToZ.Theory.toZ (Word.WordToZ (S n)) a))
  (and
     (BinInt.Z.le BinNums.Z0
        (@Word.ToZ.Theory.toZ (Word.WordToZ n)
           (@snd
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr)))
     (BinInt.Z.lt
        (@Word.ToZ.Theory.toZ (Word.WordToZ n)
           (@snd
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit) n)) qr)) (@Word.ToZ.Theory.toZ (Word.WordToZ n) b)))
     : forall (n : nat) (_ : Ty.Arrow (Ty.Prod (Word.Word (S n)) (Word.Word n)) (Word.Word (S n))), Prop

Arguments division_normalized_result n%nat_scope rec
division_word_spec =
fun (n : nat) (remainder : bool) (term : Alg.Core.Algebra) =>
match
  remainder
  return
    (Alg.Core.domain term (Word.Word (S n))
       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
           match n0 return Ty.Ty with
           | O => X
           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
           end) (Ty.Sum Ty.Unit Ty.Unit) n))
with
| true => @modulo_word_spec n term
| false => @divide_word_spec n term
end
     : forall (n : nat) (_ : bool) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Word.Word (S n))
         ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
             match n0 return Ty.Ty with
             | O => X
             | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
             end) (Ty.Sum Ty.Unit Ty.Unit) n)

Arguments division_word_spec n%nat_scope remainder%bool_scope {term}
division8_guarantees =
fun remainder : bool =>
jet_local_spec_guarantees (division8 remainder) (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
  (Word.Word (S (S (S O))))
  (fun xy : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) =>
   @division_word_spec (S (S (S O))) remainder Alg.CoreFunSem xy) (division8_local_spec remainder)
     : forall (remainder : bool) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add read_cursor
                   (BinInt.Z.of_nat (bitSize (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor
                (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (division8 remainder))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S O))))
                     ((fun xy : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) =>
                       @division_word_spec (S (S (S O))) remainder Alg.CoreFunSem xy) a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O))))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O)))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))

Arguments division8_guarantees remainder%bool_scope env m bd dbase%Z_scope bs sbase%Z_scope
  bi bw (edge outedge cursor read_cursor)%Z_scope a _ _ _ _ _ _ _
division8_context_guarantees =
fun remainder : bool =>
@jet_context_guarantees (Word.Word (S (S (S (S O)))))
  (Ty.Prod
     ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
         match n return Ty.Ty with
         | O => X
         | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
         end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
     ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
         match n return Ty.Ty with
         | O => X
         | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
         end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))) (division8 remainder) (@division_word_spec (S (S (S O))) remainder)
  (division_word_spec_parametric (S (S (S O))) remainder) (division8_local_spec remainder)
  (ZifyClasses.rew_iff_rev (le (S O) (S (S (S (S (S (S (S (S O)))))))))
     (BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
        (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH)) (S (S (S (S (S (S (S (S O))))))))
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
        (@eq_refl BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (let __arith :
        BinInt.Z.le (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) :=
        let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
        let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
        let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
          @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
            (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
               RingMicromega.OpLe
               (@EnvRing.PEc BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) tt in
        ZMicromega.ZTautoChecker_sound __ff __wit
          (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
          (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
      __arith)
   <:
   le (S O)
     (bitSize
        (Ty.Prod
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))))
     : forall (remainder : bool) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Word.Word (S (S (S (S O)))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S (S O))))) a)
              (newWriteFrame
                 (bitSize
                    (Ty.Prod
                       ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                           match n return Ty.Ty with
                           | O => X
                           | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
                       ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                           match n return Ty.Ty with
                           | O => X
                           | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S (S O))))) a)
              (fullWriteFrame
                 (@encode
                    (Ty.Prod
                       ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                           match n return Ty.Ty with
                           | O => X
                           | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
                       ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                           match n return Ty.Ty with
                           | O => X
                           | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                           end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
                    (@division_word_spec (S (S (S O))) remainder Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (division8 remainder))
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@division_word_spec (S (S (S O))) remainder Naive.translate) (Running s0) (Running s1))))

Arguments division8_context_guarantees remainder%bool_scope env m L ctx a _ _ _
wide_division_guarantees =
fun (remainder : bool) (s : wide_size) =>
jet_local_spec_guarantees (wide_division remainder s) (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s)))
  (Word.Word (wide_log s))
  (fun xy : Ty.tySem (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s))) =>
   @division_word_spec (wide_log s) remainder Alg.CoreFunSem xy) (wide_division_local_spec remainder s)
     : forall (remainder : bool) (s : wide_size) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s)))) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
