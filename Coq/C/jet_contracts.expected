                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @List.Forall BinNums.Z
         (fun limb : BinNums.Z =>
          and (BinInt.Z.le BinNums.Z0 limb)
            (BinInt.Z.le limb
               (BinInt.Z.sub
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                  (BinNums.Zpos BinNums.xH)))) (fe_limbs_of value)
nth_limb_52_bound
     : forall (limbs : list BinNums.Z)
         (_ : @List.Forall BinNums.Z
                (fun limb : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 limb)
                   (BinInt.Z.le limb
                      (BinInt.Z.sub
                         (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                         (BinNums.Zpos BinNums.xH)))) limbs) (n : nat),
       and (BinInt.Z.le BinNums.Z0 (@List.nth BinNums.Z n limbs BinNums.Z0))
         (BinInt.Z.le (@List.nth BinNums.Z n limbs BinNums.Z0)
            (BinInt.Z.sub
               (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
               (BinNums.Zpos BinNums.xH)))
limb_rho_unsigned
     : forall (value : BinNums.Z) (n : nat)
