     : forall (m : Memory.Mem.mem) (bo : Values.block) (output : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S O)))))) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bo output
                (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) Memtype.Cur
                Memtype.Writable) (_ : not (@eq Values.block bf bo)) (_ : not (@eq Values.block bf bi))
         (_ : not (@eq Values.block bo bi)) (_ : frame_base_valid base) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))) Integers.Int64.max_unsigned)
         (_ : frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : forall (i : nat) (x : Ty.tySem (Word.Word (S (S (S O)))))
                (_ : @eq (option (Ty.tySem (Word.Word (S (S (S O))))))
                       (@List.nth_error (Ty.tySem (Word.Word (S (S (S O))))) xs i)
                       (@Some (Ty.tySem (Word.Word (S (S (S O))))) x)),
              @frame_input_word_at (S (S (S O))) m bi edge
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                x),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (read8s_run bo output bf base
               (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value xs) m mf)
            (and
               (uint8_array_at mf bo output
                  (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value xs))
               (and
                  (frame_fields_at mf bf base bi edge
                     (BinInt.Z.add cursor
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bo))
                               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) output)
                                  (BinInt.Z.le
                                     (BinInt.Z.add output
                                        (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
eval_read8s_layout
     : forall (m : Memory.Mem.mem) (bo : Values.block) (output : BinNums.Z) (bf : Values.block)
         (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S O)))))) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bo output
                (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) Memtype.Cur
                Memtype.Writable) (_ : not (@eq Values.block bf bo)) (_ : not (@eq Values.block bf bi))
         (_ : not (@eq Values.block bo bi)) (_ : frame_base_valid base) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))) Integers.Int64.max_unsigned)
         (_ : frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : forall (i : nat) (x : Ty.tySem (Word.Word (S (S (S O)))))
                (_ : @eq (option (Ty.tySem (Word.Word (S (S (S O))))))
                       (@List.nth_error (Ty.tySem (Word.Word (S (S (S O))))) xs i)
                       (@Some (Ty.tySem (Word.Word (S (S (S O))))) x)),
              @frame_input_word_at (S (S (S O))) m bi edge
                (BinInt.Z.add cursor
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
                x),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_read8s)
               (@cons Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))
                  (@cons Values.val
                     (Values.Vlong
                        (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) Events.E0 mf
               Values.Vundef)
            (and
               (uint8_array_at mf bo output
                  (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value xs))
               (and
                  (frame_fields_at mf bf base bi edge
                     (BinInt.Z.add cursor
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bo))
                               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) output)
                                  (BinInt.Z.le
                                     (BinInt.Z.add output
                                        (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
vector_values_length
     : forall (X : Ty.Ty) (n : nat) (x : Ty.tySem (Word.Vector X n)),
       @eq nat (@length (Ty.tySem X) (vector_values X n x)) (PeanoNat.Nat.pow (S (S O)) n)
buffer_input_cells_preserved
     : forall (m mf : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (cells : list Cell)
         (_ : forall (ofs : BinNums.Z) (w : Integers.Int64.int)
                (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw ofs) (@Some Values.val (Values.Vlong w))),
              @eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bw ofs) (@Some Values.val (Values.Vlong w)))
         (_ : frame_input_cells_at m bw edge cursor cells), frame_input_cells_at mf bw edge cursor cells
encode_vector_values
     : forall (X : Ty.Ty) (n : nat) (x : Ty.tySem (Word.Vector X n)),
       @eq (list Cell) (@encode (Word.Vector X n) x)
         (@List.concat Cell (@List.map (Ty.tySem X) (list Cell) (@encode X) (vector_values X n x)))
encode_present_sum
     : forall (X : Ty.Ty) (x : Ty.tySem X),
       @eq (list Cell) (@encode (Ty.Sum Ty.Unit X) (@inr unit (Ty.tySem X) x))
         (@cons (option bool) (@Some bool true) (@encode X x))
vector_byte_bitSize
     : forall n : nat,
       @eq nat (bitSize (Word.Vector (Word.Word (S (S (S O)))) n))
         (Nat.mul (S (S (S (S (S (S (S (S O)))))))) (PeanoNat.Nat.pow (S (S O)) n))
buffer_byte_chunks_cells
     : forall (depth : nat) (x : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) depth)),
       @eq (list Cell) (@encode (buffer_type (Word.Word (S (S (S O)))) depth) x)
         (@List.concat Cell (@List.map byte_chunk (list Cell) byte_chunk_cells (buffer_byte_chunks depth x)))
buffer_byte_chunks_lengths
     : forall (depth : nat) (x : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) depth)),
       @List.Forall (prod nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))))
         (fun chunk : prod nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) =>
          match @snd nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) chunk return Prop with
          | Some xs =>
              @eq nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)
                (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) chunk)
          | None => True
          end) (buffer_byte_chunks depth x)
frame_input_byte_list
     : forall (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S O)))))),
       iff
         (frame_input_cells_at m bw edge cursor
            (@List.concat Cell
               (@List.map (Ty.tySem (Word.Word (S (S (S O))))) (list Cell) (@encode (Word.Word (S (S (S O))))) xs)))
         (forall (i : nat) (x : Ty.tySem (Word.Word (S (S (S O)))))
            (_ : @eq (option (Ty.tySem (Word.Word (S (S (S O))))))
                   (@List.nth_error (Ty.tySem (Word.Word (S (S (S O))))) xs i)
                   (@Some (Ty.tySem (Word.Word (S (S (S O))))) x)),
          @frame_input_word_at (S (S (S O))) m bw edge
            (BinInt.Z.add cursor
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))) x)
buffer8_read_loop_shape
     : @eq Clight.statement buffer8_read_loop
         (Clight.Sloop
            (Clight.Ssequence (Clight.Sifthenelse buffer8_guard_expr Clight.Sskip Clight.Sbreak)
               (Clight.Ssequence buffer8_read_tag
                  (Clight.Sifthenelse (Clight.Etempvar _t'2 Ctypesdefs.tbool) buffer8_read_present buffer8_read_absent)))
            (Clight.Sset _i
               (Clight.Ebinop Cop.Odiv (Clight.Etempvar _i Ctypesdefs.tulong)
                  (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO BinNums.xH))) Ctypesdefs.tint)
                  Ctypesdefs.tulong)))
buffer8_read_forward_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge0) _forwardBits)
         (@Some Values.block (jet_symbol_block _forwardBits))
buffer8_read_forward_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv ge0)
            (Values.Vptr (jet_symbol_block _forwardBits) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f_forwardBits))
buffer8_read_array_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge0) _read8s)
         (@Some Values.block (jet_symbol_block _read8s))
buffer8_read_array_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv ge0)
            (Values.Vptr (jet_symbol_block _read8s) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f_read8s))
call_buffer8_read_tag
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mr : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bit : bool)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) _readBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_readBit)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mr
                (Values.Vint (bit_int bit))),
       ClightBigstep.Clight2.exec_stmt ge0 e le m buffer8_read_tag Events.E0
         (@Maps.PTree.set Values.val _t'2 (Values.Vint (bit_int bit)) le) mr ClightBigstep.Out_normal
exec_buffer8_read_absent
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mf : Memory.Mem.mem) (bf : Values.block) (base j : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) _forwardBits e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_forwardBits)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                   (@cons Values.val
                      (Values.Vlong
                         (Integers.Int64.repr
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) j)))
                      (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt ge0 e le m buffer8_read_absent Events.E0 le mf ClightBigstep.Out_normal
exec_buffer8_read_present
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mr mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bo : Values.block)
         (output : BinNums.Z) (bl : Values.block) (slot j count : BinNums.Z)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) _read8s e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _buf le)
                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _len le)
                (@Some Values.val (Values.Vptr bl (Integers.Ptrofs.repr slot))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j)))) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le (BinInt.Z.add output j) Integers.Ptrofs.max_unsigned)
         (_ : and (BinInt.Z.le BinNums.Z0 slot) (BinInt.Z.le slot Integers.Ptrofs.max_unsigned))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : and (BinInt.Z.le BinNums.Z0 count) (BinInt.Z.le count Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_read8s)
                (@cons Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))
                   (@cons Values.val (Values.Vlong (Integers.Int64.repr j))
                      (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)))) Events.E0 mr
                Values.Vundef)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 mr bl slot)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr count))))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 mr bl slot (Values.Vlong (Integers.Int64.repr (BinInt.Z.add count j))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt ge0 e le m buffer8_read_present Events.E0
         (buffer8_read_present_temps le bo (BinInt.Z.add output j) count) mf ClightBigstep.Out_normal
exec_buffer8_read_body
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m mr mf : Memory.Mem.mem) (lef : Clight.temp_env) (bf : Values.block) (base j : BinNums.Z)
         (bit : bool)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) _readBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.lt BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_readBit)
                (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mr
                (Values.Vint (bit_int bit)))
         (_ : ClightBigstep.Clight2.exec_stmt ge0 e (@Maps.PTree.set Values.val _t'2 (Values.Vint (bit_int bit)) le) mr
                match bit return Clight.statement with
                | true => buffer8_read_present
                | false => buffer8_read_absent
                end Events.E0 lef mf ClightBigstep.Out_normal),
       ClightBigstep.Clight2.exec_stmt ge0 e le m buffer8_read_body Events.E0 lef mf ClightBigstep.Out_normal
exec_buffer8_read_halve
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (j : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr j))))
         (_ : and (BinInt.Z.le BinNums.Z0 j) (BinInt.Z.le j Integers.Int64.max_unsigned)),
       ClightBigstep.Clight2.exec_stmt ge0 e le m buffer8_read_update Events.E0
         (@Maps.PTree.set Values.val _i
            (Values.Vlong (Integers.Int64.repr (BinInt.Z.div j (BinNums.Zpos (BinNums.xO BinNums.xH))))) le) m
         ClightBigstep.Out_normal
exec_buffer8_read_stop
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val (Values.Vlong Integers.Int64.zero))),
       ClightBigstep.Clight2.exec_stmt ge0 e le m buffer8_read_loop Events.E0 le m ClightBigstep.Out_normal
exec_buffer8_read_present_layout
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bi : Values.block) (edge cursor : BinNums.Z)
         (bo : Values.block) (output : BinNums.Z) (bl : Values.block) (slot count : BinNums.Z)
         (xs : list (Ty.tySem (Word.Word (S (S (S O))))))
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) _read8s e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src le)
                (@Some Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _buf le)
                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr output))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _len le)
                (@Some Values.val (Values.Vptr bl (Integers.Ptrofs.repr slot))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _i le)
                (@Some Values.val
                   (Values.Vlong
                      (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))))
         (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le (BinInt.Z.add output (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))
                Integers.Ptrofs.max_unsigned)
         (_ : and (BinInt.Z.le BinNums.Z0 slot) (BinInt.Z.le slot Integers.Ptrofs.max_unsigned))
         (_ : and (BinInt.Z.le BinNums.Z0 count) (BinInt.Z.le count Integers.Int64.max_unsigned))
