                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...))))))))))))))))))
            | S n3 =>
                match n3 return BinNums.Z with
                | O =>
                    BinNums.Zpos
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI
                                        (BinNums.xI
                                           (BinNums.xI
