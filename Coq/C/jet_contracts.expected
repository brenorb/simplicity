extend_bit_raw =
fun (s : wide_size) (bit : bool) =>
match s return Values.val with
| W16 =>
    Values.Vint
      match bit return Integers.Int.int with
      | true =>
          Integers.Int.repr
            (BinNums.Zpos
               (BinNums.xI
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
