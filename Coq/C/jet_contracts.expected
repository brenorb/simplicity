  (Clight.Ebinop Cop.Oeq (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint) (Clight.Etempvar _x Ctypesdefs.tuchar)
     Ctypesdefs.tint) (Clight.Sset _t'3 (Clight.Ecast (Clight.Etempvar _y Ctypesdefs.tuchar) Ctypesdefs.tint))
  (Clight.Sset _t'3
     (Clight.Ecast
        (Clight.Ebinop Cop.Omod (Clight.Etempvar _y Ctypesdefs.tuchar) (Clight.Etempvar _x Ctypesdefs.tuchar)
