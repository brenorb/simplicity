xstmt_shift64_normal
     : forall (fuel : nat) (initial : sstate) (stmt : Clight.statement) (final : sstate)
         (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (le : Clight.temp_env)
         (_ : @eq (option res)
                (xstmt (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type))) secp_shift64_table
                   fuel (@nil (prod AST.ident (prod nat Ctypes.type))) initial stmt) (@Some res (RDone final ONormal)))
         (_ : rep rho layout (sregs initial) m) (_ : tmatch rho layout (stemps initial) le),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge Clight.empty_env le m stmt Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and (rep rho layout (sregs final) mf)
                  (and (tmatch rho layout (stemps final) le')
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (sregs final))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (sregs initial)))
                        (lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot layout
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape (sregs initial)) b ofs)) m mf))))))
