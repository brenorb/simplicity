     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (rh al d : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _rh le) (@Some Values.val (Values.Vlong rh)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _al le) (@Some Values.val (Values.Vlong al)))
