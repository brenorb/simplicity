                (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_is_zero)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mf
                (Values.Vint (bit_int bit))),
       ClightBigstep.Clight2.exec_stmt secp_ge (secp_public_env bl ba) le m secp_public_zero_stmt Events.E0
         (@Maps.PTree.set Values.val jets_secp._t'1 (Values.Vint (bit_int bit)) le) mf ClightBigstep.Out_normal
