                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned b)))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned ah) (Integers.Int64.unsigned b))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned al) divmod96_radix)
         (_ : Memory.Mem.valid_access m AST.Mint64 bq (Integers.Ptrofs.unsigned qo) Memtype.Writable)
         (_ : Memory.Mem.valid_access m AST.Mint64 br (Integers.Ptrofs.unsigned ro) Memtype.Writable)
         (_ : or (not (@eq Values.block bq br))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned qo)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (Integers.Ptrofs.unsigned ro))
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned ro)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                      (Integers.Ptrofs.unsigned qo)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Integers.Int64.int
            (fun qf : Integers.Int64.int =>
             @ex Integers.Int64.int
               (fun rf : Integers.Int64.int =>
                and
                  (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_div_mod_96_64)
                     (@cons Values.val (Values.Vptr bq qo)
                        (@cons Values.val (Values.Vptr br ro)
                           (@cons Values.val (Values.Vlong ah)
                              (@cons Values.val (Values.Vlong al) (@cons Values.val (Values.Vlong b) (@nil Values.val))))))
                     Events.E0 mf Values.Vundef)
                  (and
                     (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bq (Integers.Ptrofs.unsigned qo))
                        (@Some Values.val (Values.Vlong qf)))
                     (and
                        (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf br (Integers.Ptrofs.unsigned ro))
                           (@Some Values.val (Values.Vlong rf)))
                        (and
                           (and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned qf))
                              (BinInt.Z.lt (Integers.Int64.unsigned qf) divmod96_radix))
                           (and
                              (and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned rf))
                                 (BinInt.Z.lt (Integers.Int64.unsigned rf) (Integers.Int64.unsigned b)))
                              (and
                                 (@eq BinNums.Z
                                    (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned ah) divmod96_radix)
                                       (Integers.Int64.unsigned al))
                                    (BinInt.Z.add
                                       (BinInt.Z.mul (Integers.Int64.unsigned qf) (Integers.Int64.unsigned b))
                                       (Integers.Int64.unsigned rf)))
                                 (and
                                    (forall (chunk : AST.memory_chunk) (bb : Values.block)
                                       (addr : BinNums.Z)
                                       (_ : or (not (@eq Values.block bb bq))
                                              (or
                                                 (BinInt.Z.le (BinInt.Z.add addr (Memdata.size_chunk chunk))
                                                    (Integers.Ptrofs.unsigned qo))
                                                 (BinInt.Z.le
                                                    (BinInt.Z.add (Integers.Ptrofs.unsigned qo)
                                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                                    addr)))
                                       (_ : or (not (@eq Values.block bb br))
                                              (or
                                                 (BinInt.Z.le (BinInt.Z.add addr (Memdata.size_chunk chunk))
                                                    (Integers.Ptrofs.unsigned ro))
                                                 (BinInt.Z.le
                                                    (BinInt.Z.add (Integers.Ptrofs.unsigned ro)
                                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                                    addr))),
                                     @eq (option Values.val) (Memory.Mem.load chunk mf bb addr)
                                       (Memory.Mem.load chunk m bb addr))
                                    (and
                                       (forall (bb : Values.block) (addr : BinNums.Z) (kind : Memtype.perm_kind)
                                          (p : Memtype.permission) (_ : Memory.Mem.perm m bb addr kind p),
                                        Memory.Mem.perm mf bb addr kind p)
                                       (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m))))))))))))
frame_fields =
fun (m : Memory.Mem.mem) (bf bw : Values.block) (edge cursor : BinNums.Z) =>
and
  (@eq (option Values.val) (Memory.Mem.load AST.Mptr m bf BinNums.Z0)
     (@Some Values.val (Values.Vptr bw (Integers.Ptrofs.repr edge))))
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint64 m bf (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     (@Some Values.val (Values.Vlong (Integers.Int64.repr cursor))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments frame_fields m bf bw (edge cursor)%Z_scope
read_cell_address =
fun edge cursor i : BinNums.Z =>
BinInt.Z.sub edge
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
     (BinInt.Z.add (BinNums.Zpos BinNums.xH)
        (BinInt.Z.div (BinInt.Z.add cursor i)
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments read_cell_address (edge cursor i)%Z_scope
read_cell_bit =
fun cursor i : BinNums.Z =>
BinInt.Z.sub (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
  (BinInt.Z.modulo (BinInt.Z.add cursor i)
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments read_cell_bit (cursor i)%Z_scope
write_cell_address =
fun edge cursor i : BinNums.Z =>
BinInt.Z.add edge
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
     (BinInt.Z.div (BinInt.Z.sub (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) i)
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments write_cell_address (edge cursor i)%Z_scope
write_cell_bit =
fun cursor i : BinNums.Z =>
BinInt.Z.modulo (BinInt.Z.sub (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) i)
  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments write_cell_bit (cursor i)%Z_scope
read_frame =
fun (m : Memory.Mem.mem) (bf bw : Values.block) (edge cursor : BinNums.Z) (cells : list bool) =>
and (frame_fields m bf bw edge cursor)
  (and (BinInt.Z.le BinNums.Z0 cursor)
     (and (BinInt.Z.le (BinInt.Z.add cursor (BinInt.Z.of_nat (@length bool cells))) Integers.Int64.max_unsigned)
        (forall (i : nat) (bit : bool) (_ : @eq (option bool) (@List.nth_error bool cells i) (@Some bool bit)),
         @ex Integers.Int64.int
           (fun w : Integers.Int64.int =>
            and
              (@eq (option Values.val)
                 (Memory.Mem.load AST.Mint64 m bw (read_cell_address edge cursor (BinInt.Z.of_nat i)))
                 (@Some Values.val (Values.Vlong w)))
              (@eq bool (Integers.Int64.testbit w (read_cell_bit cursor (BinInt.Z.of_nat i))) bit)))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : list bool), Prop

Arguments read_frame m bf bw (edge cursor)%Z_scope cells%list_scope
write_frame =
fun (m : Memory.Mem.mem) (bf bw : Values.block) (edge cursor count : BinNums.Z) =>
and (frame_fields m bf bw edge cursor)
  (and (and (BinInt.Z.le BinNums.Z0 count) (BinInt.Z.le count cursor))
     (and (BinInt.Z.le cursor Integers.Int64.max_unsigned)
        (and (not (@eq Values.block bf bw))
           (and
              (Memory.Mem.valid_access m AST.Mint64 bf (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                 Memtype.Writable)
              (forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i count)),
               let addr : BinNums.Z := write_cell_address edge cursor i in
               and (BinInt.Z.le BinNums.Z0 addr)
                 (and
                    (BinInt.Z.le (BinInt.Z.add addr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                       Integers.Ptrofs.max_unsigned)
                    (and (Memory.Mem.valid_access m AST.Mint64 bw addr Memtype.Writable)
                       (@ex Integers.Int64.int
                          (fun w : Integers.Int64.int =>
                           @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw addr)
                             (@Some Values.val (Values.Vlong w)))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : BinNums.Z), Prop

Arguments write_frame m bf bw (edge cursor count)%Z_scope
word_slice_eq =
fun (lo count : BinNums.Z) (a b : Integers.Int64.int) =>
forall (i : BinNums.Z) (_ : and (BinInt.Z.le lo i) (BinInt.Z.lt i (BinInt.Z.add lo count))),
@eq bool (Integers.Int64.testbit a i) (Integers.Int64.testbit b i)
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Prop

Arguments word_slice_eq (lo count)%Z_scope a b
word_outside_eq =
fun (lo count : BinNums.Z) (a b : Integers.Int64.int) =>
forall (i : BinNums.Z)
  (_ : and (BinInt.Z.le BinNums.Z0 i)
         (BinInt.Z.lt i
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
  (_ : or (BinInt.Z.lt i lo) (BinInt.Z.le (BinInt.Z.add lo count) i)),
@eq bool (Integers.Int64.testbit a i) (Integers.Int64.testbit b i)
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Prop

Arguments word_outside_eq (lo count)%Z_scope a b
loads_outside_blocks =
fun (m m' : Memory.Mem.mem) (bf bw : Values.block) =>
forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
  (_ : not (@eq Values.block b bf)) (_ : not (@eq Values.block b bw)),
@eq (option Values.val) (Memory.Mem.load chunk m' b ofs) (Memory.Mem.load chunk m b ofs)
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block), Prop

Arguments loads_outside_blocks m m' bf bw
single_word_input =
fun (m : Memory.Mem.mem) (bf bw : Values.block) (count : BinNums.Z) (payload : Integers.Int64.int) =>
and
  (frame_fields m bf bw (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
     (BinInt.Z.sub
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) count))
  (and
     (and (BinInt.Z.lt BinNums.Z0 count)
        (BinInt.Z.le count
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     (@ex Integers.Int64.int
        (fun w : Integers.Int64.int =>
         and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw BinNums.Z0) (@Some Values.val (Values.Vlong w)))
           (@eq Integers.Int64.int (Integers.Int64.zero_ext count w) (Integers.Int64.zero_ext count payload)))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int), Prop

Arguments single_word_input m bf bw count%Z_scope payload
single_word_output =
fun (m : Memory.Mem.mem) (bf bw : Values.block) (count : BinNums.Z) =>
and (frame_fields m bf bw BinNums.Z0 count)
  (and
     (and (BinInt.Z.lt BinNums.Z0 count)
        (BinInt.Z.le count
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     (and (not (@eq Values.block bf bw))
        (and
           (Memory.Mem.valid_access m AST.Mint64 bf (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
              Memtype.Writable)
           (and (Memory.Mem.valid_access m AST.Mint64 bw BinNums.Z0 Memtype.Writable)
              (@ex Integers.Int64.int
                 (fun w : Integers.Int64.int =>
                  @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw BinNums.Z0)
                    (@Some Values.val (Values.Vlong w))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z), Prop

Arguments single_word_output m bf bw count%Z_scope
frame_base_valid =
fun base : BinNums.Z =>
and (BinInt.Z.le BinNums.Z0 base)
  (BinInt.Z.le (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     Integers.Ptrofs.max_unsigned)
     : forall _ : BinNums.Z, Prop

Arguments frame_base_valid base%Z_scope
frame_fields_at =
fun (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z) =>
and
  (@eq (option Values.val) (Memory.Mem.load AST.Mptr m bf base)
     (@Some Values.val (Values.Vptr bw (Integers.Ptrofs.repr edge))))
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint64 m bf
        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (@Some Values.val (Values.Vlong (Integers.Int64.repr cursor))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z), Prop

Arguments frame_fields_at m bf base%Z_scope bw (edge cursor)%Z_scope
byte_slice_at =
fun (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x : Ty.tySem (Word.Word (S (S (S O))))) =>
and
  (and (BinInt.Z.le BinNums.Z0 cursor)
     (BinInt.Z.le cursor
        (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  (and
     (and
        (BinInt.Z.le
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
              (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                 (BinInt.Z.div cursor
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
           edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned))
     (@ex Integers.Int64.int
        (fun high : Integers.Int64.int =>
         @ex Integers.Int64.int
           (fun low : Integers.Int64.int =>
            and
              (@eq (option Values.val)
                 (Memory.Mem.load AST.Mint64 m bw
                    (BinInt.Z.sub edge
                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                          (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                             (BinInt.Z.div cursor
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                 (@Some Values.val (Values.Vlong high)))
              (and
                 (forall
                    _ : BinInt.Z.lt
                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))
                          (BinInt.Z.modulo cursor
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
                  and
                    (BinInt.Z.le
                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                          (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                             (BinInt.Z.div cursor
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                       edge)
                    (@eq (option Values.val)
                       (Memory.Mem.load AST.Mint64 m bw
                          (BinInt.Z.sub edge
                             (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                (BinInt.Z.add (BinNums.Zpos (BinNums.xO BinNums.xH))
                                   (BinInt.Z.div cursor
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                       (@Some Values.val (Values.Vlong low))))
                 (@eq (Ty.tySem (Word.Word (S (S (S O)))))
                    (decode_word8 (jet_read8_layout_total.read8_layout_byte cursor high low)) x))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Ty.tySem (Word.Word (S (S (S O))))), Prop

Arguments byte_slice_at m bw (edge cursor)%Z_scope x
byte_input_at =
fun (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block) (edge cursor : BinNums.Z)
  (xs : list (Ty.tySem (Word.Word (S (S (S O)))))) =>
and (frame_base_valid base)
  (and (frame_fields_at m bf base bw edge cursor)
     (forall (i : nat) (x : Ty.tySem (Word.Word (S (S (S O)))))
        (_ : @eq (option (Ty.tySem (Word.Word (S (S (S O))))))
               (@List.nth_error (Ty.tySem (Word.Word (S (S (S O))))) xs i)
               (@Some (Ty.tySem (Word.Word (S (S (S O))))) x)),
      byte_slice_at m bw edge
        (BinInt.Z.add cursor
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))) x))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : list (Ty.tySem (Word.Word (S (S (S O)))))), Prop

Arguments byte_input_at m bf base%Z_scope bw (edge cursor)%Z_scope xs%list_scope
frame_input_bit_at =
fun (m : Memory.Mem.mem) (bw : Values.block) (edge q : BinNums.Z) (b : bool) =>
and (and (BinInt.Z.le BinNums.Z0 q) (BinInt.Z.le q Integers.Int64.max_unsigned))
  (and
     (and
        (BinInt.Z.le
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
              (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                 (BinInt.Z.div q
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
           edge) (BinInt.Z.le edge Integers.Ptrofs.max_unsigned))
     (@ex Integers.Int64.int
        (fun w : Integers.Int64.int =>
         and
           (@eq (option Values.val)
              (Memory.Mem.load AST.Mint64 m bw
                 (BinInt.Z.sub edge
                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                       (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                          (BinInt.Z.div q
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
              (@Some Values.val (Values.Vlong w)))
           (@eq bool b
              (BinInt.Z.testbit (Integers.Int64.unsigned w)
                 (BinInt.Z.sub
                    (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                    (BinInt.Z.modulo q
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : bool), Prop

Arguments frame_input_bit_at m bw (edge q)%Z_scope b%bool_scope
frame_input_bits_at =
fun (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (bits : list bool) =>
forall (i : nat) (b : bool) (_ : @eq (option bool) (@List.nth_error bool bits i) (@Some bool b)),
frame_input_bit_at m bw edge (BinInt.Z.add cursor (BinInt.Z.of_nat i)) b
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : list bool), Prop

Arguments frame_input_bits_at m bw (edge cursor)%Z_scope bits%list_scope
frame_input_word_bits =
fun (n : nat) (value : Ty.tySem (Word.Word n)) =>
@List.map nat bool
  (fun i : nat =>
   BinInt.Z.testbit (@Word.ToZ.Theory.toZ (Word.WordToZ n) value)
     (BinInt.Z.of_nat (Nat.sub (PeanoNat.Nat.pow (S (S O)) n) (S i)))) (List.seq O (PeanoNat.Nat.pow (S (S O)) n))
     : forall (n : nat) (_ : Ty.tySem (Word.Word n)), list bool

Arguments frame_input_word_bits {n}%nat_scope value
frame_input_word_at =
fun (n : nat) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (value : Ty.tySem (Word.Word n)) =>
frame_input_bits_at m bw edge cursor (@frame_input_word_bits n value)
     : forall (n : nat) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Ty.tySem (Word.Word n)), Prop

Arguments frame_input_word_at {n}%nat_scope m bw (edge cursor)%Z_scope value
write_frame_at =
fun (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block) (edge cursor count : BinNums.Z) =>
and (frame_base_valid base)
  (and (frame_fields_at m bf base bw edge cursor)
     (and (BinInt.Z.le BinNums.Z0 edge)
        (and (and (BinInt.Z.le BinNums.Z0 count) (BinInt.Z.le count cursor))
           (and (BinInt.Z.le cursor Integers.Int64.max_unsigned)
              (and (not (@eq Values.block bf bw))
                 (and
                    (Memory.Mem.valid_access m AST.Mint64 bf
                       (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                       Memtype.Writable)
                    (forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i count)),
                     let addr : BinNums.Z := write_cell_address edge cursor i in
                     and (BinInt.Z.le BinNums.Z0 addr)
                       (and
                          (BinInt.Z.le
                             (BinInt.Z.add addr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                             Integers.Ptrofs.max_unsigned)
                          (and (Memory.Mem.valid_access m AST.Mint64 bw addr Memtype.Writable)
                             (@ex Integers.Int64.int
                                (fun w : Integers.Int64.int =>
                                 @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw addr)
                                   (@Some Values.val (Values.Vlong w)))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments write_frame_at m bf base%Z_scope bw (edge cursor count)%Z_scope
byte_output_at =
fun (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x : Ty.tySem (Word.Word (S (S (S O))))) =>
match
  ZArith_dec.Z_le_dec (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
    (jet_write_layout.write_word_shift cursor) return Prop
with
| left _ =>
    @ex Integers.Int64.int
      (fun w : Integers.Int64.int =>
       and
         (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
            (@Some Values.val (Values.Vlong w)))
         (@eq (Ty.tySem (Word.Word (S (S (S O)))))
            (decode_word8
               (Integers.Int64.shru w
                  (Integers.Int64.repr
                     (BinInt.Z.sub (jet_write_layout.write_word_shift cursor)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) x))
| right _ =>
    @ex Integers.Int64.int
      (fun high : Integers.Int64.int =>
       @ex Integers.Int64.int
         (fun low : Integers.Int64.int =>
          and
            (@eq (option Values.val)
               (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
               (@Some Values.val (Values.Vlong high)))
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 m bw
                     (BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (@Some Values.val (Values.Vlong low)))
               (@eq (Ty.tySem (Word.Word (S (S (S O)))))
                  (decode_word8 (jet_crossing_word.crossing_byte (jet_write_layout.write_word_shift cursor) high low))
                  x))))
end
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Ty.tySem (Word.Word (S (S (S O))))), Prop

Arguments byte_output_at m bw (edge cursor)%Z_scope x
write_prefix_at =
fun (m mf : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) =>
forall (old : Integers.Int64.int)
  (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
         (@Some Values.val (Values.Vlong old))),
@ex Integers.Int64.int
  (fun w : Integers.Int64.int =>
   and
     (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bw (jet_write_layout.write_word_address edge cursor))
        (@Some Values.val (Values.Vlong w)))
     (word_outside_eq BinNums.Z0 (jet_write_layout.write_word_shift cursor) w old))
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments write_prefix_at m mf bw (edge cursor)%Z_scope
loads_outside_ranges =
fun (m mf : Memory.Mem.mem) (bf : Values.block) (flo fhi : BinNums.Z) (bw : Values.block) (wlo whi : BinNums.Z) =>
forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
  (_ : or (not (@eq Values.block b bf))
         (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) flo) (BinInt.Z.le fhi ofs)))
  (_ : or (not (@eq Values.block b bw))
         (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) wlo) (BinInt.Z.le whi ofs))),
@eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs)
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z)
         (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments loads_outside_ranges m mf bf (flo fhi)%Z_scope bw (wlo whi)%Z_scope
byte_write_low =
fun edge cursor : BinNums.Z =>
match
  ZArith_dec.Z_le_dec (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
    (jet_write_layout.write_word_shift cursor) return BinNums.Z
with
| left _ => jet_write_layout.write_word_address edge cursor
| right _ =>
    BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments byte_write_low (edge cursor)%Z_scope
slice_output_at =
fun (n : BinNums.Z) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z) (x : Integers.Int64.int) =>
match ZArith_dec.Z_le_dec n (jet_write_layout.write_word_shift cursor) return Prop with
| left _ =>
    @ex Integers.Int64.int
      (fun w : Integers.Int64.int =>
       and
         (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
            (@Some Values.val (Values.Vlong w)))
         (@eq Integers.Int64.int
            (Integers.Int64.zero_ext n
               (Integers.Int64.shru w (Integers.Int64.repr (BinInt.Z.sub (jet_write_layout.write_word_shift cursor) n))))
            x))
| right _ =>
    @ex Integers.Int64.int
      (fun high : Integers.Int64.int =>
       @ex Integers.Int64.int
         (fun low : Integers.Int64.int =>
          and
            (@eq (option Values.val)
               (Memory.Mem.load AST.Mint64 m bw (jet_write_layout.write_word_address edge cursor))
               (@Some Values.val (Values.Vlong high)))
            (and
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 m bw
                     (BinInt.Z.sub (jet_write_layout.write_word_address edge cursor)
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                  (@Some Values.val (Values.Vlong low)))
               (@eq Integers.Int64.int
                  (jet_word_slice.crossing_slice n (jet_write_layout.write_word_shift cursor) high low) x))))
end
     : forall (_ : BinNums.Z) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Integers.Int64.int), Prop

Arguments slice_output_at n%Z_scope m bw (edge cursor)%Z_scope x
