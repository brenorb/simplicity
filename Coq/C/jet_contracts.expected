scalar_mul512_machine_cell
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (i : nat) (x : Integers.Int64.int)
         (_ : @eq (option Integers.Int64.int)
                (@List.nth_error Integers.Int64.int (scalar_mul512_machine_outputs rho) i)
                (@Some Integers.Int64.int x)),
       @ex sx
         (fun sy : sx =>
          and
            (@List.In cell
               (mkcell
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i))
                  AST.Mint64 (@Some sx sy)) (u64_cells BinNums.Z0 scalar_mul512_limbs))
            (@eq Values.val (den rho beta sy) (Values.Vlong x)))
eval_scalar_mul512_owned_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_mul512_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex (list Integers.Int64.int)
            (fun words : list Integers.Int64.int =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
                  (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                     (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                        (@cons Values.val
                           (Values.Vptr (blk beta (S (S O))) (Integers.Ptrofs.repr (bas beta (S (S O)))))
                           (@nil Values.val)))) Events.E0 mf Values.Vundef)
               (and
                  (forall (i : nat) (x : Integers.Int64.int)
                     (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int words i)
                            (@Some Integers.Int64.int x)),
                   @eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf (blk beta O)
                        (BinInt.Z.add (bas beta O)
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong x)))
                  (and (@eq nat (@length Integers.Int64.int words) (S (S (S (S (S (S (S (S O)))))))))
                     (and
                        (@eq BinNums.Z (column_words_value words)
                           (BinInt.Z.mul (scalar_mul512_input_value rho O)
                              (scalar_mul512_input_value rho (S (S (S (S O)))))))
                        (and (rep rho beta (sregs scalar_mul512_state) mf)
                           (lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (foot beta
                                    (@List.map region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       rshape scalar_mul512_initial_regs) b ofs)) m mf)))))))
scalar_mul512_fresh_completes
     : @eq bool
         match scalar_mul512_fresh_run return bool with
         | Some r =>
             match r return bool with
             | RDone _ o =>
                 match o return bool with
                 | ONormal => true
                 | OBreak => false
                 | OContinue => false
                 | OReturn _ => false
                 end
             | RIf _ _ _ => false
             end
         | None => false
         end true
scalar_mul512_fresh_run_eq
