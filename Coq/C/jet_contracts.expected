     (left_rotate_byte_payload s
        (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log (byte_rotate_width s))) x))
        (Integers.Int.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) amount))))
     : forall (s : byte_rotate_size) (_ : Ty.tySem (Word.Word (S (S (S O)))))
         (_ : Ty.tySem (Word.Word (wide_log (byte_rotate_width s)))),
