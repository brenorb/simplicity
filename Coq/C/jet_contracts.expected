     : @Bitcoin.PrimitiveBitcoin.Primitive.Parametric Ty.Unit (Word.Word (S (S (S (S (S (S O))))))) (@bitcoin_fee_spec)
bitcoin_fee_spec_value
     : forall environment : Bitcoin.Bitcoin.env,
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
         (@bitcoin_fee_spec (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt
            environment)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
            (fw6
               (BinInt.Z.sub (Bitcoin.sigTxTotalInValue (Bitcoin.Bitcoin.envTx environment))
                  (Bitcoin.sigTxTotalOutValue (Bitcoin.Bitcoin.envTx environment)))))
@fx_comp ?A ?B ?C
     : forall
         (s : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?A ?B)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?B ?C) (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?C))
         (@jet_buffer_empty_spec.AC.comp ?A ?B ?C
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) s t a e)
         match
           s a e return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?C))
         with
         | Some b => t b e
         | None => @None (Ty.tySem ?C)
         end
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
?C : [ |- Ty.Ty]
@fx_pair ?A ?B ?C
     : forall
         (s : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?A ?B)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?A ?C) (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod ?B ?C)))
         (@jet_buffer_empty_spec.AC.pair ?A ?B ?C
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) s t a e)
         match
           s a e
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod ?B ?C)))
         with
         | Some b =>
             match
               t a e
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod ?B ?C)))
             with
             | Some c => @Some (prod (Ty.tySem ?B) (Ty.tySem ?C)) (@pair (Ty.tySem ?B) (Ty.tySem ?C) b c)
             | None => @None (Ty.tySem (Ty.Prod ?B ?C))
             end
         | None => @None (Ty.tySem (Ty.Prod ?B ?C))
         end
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
?C : [ |- Ty.Ty]
@fx_prim ?A ?B
     : forall (p : BitcoinFull.t ?A ?B) (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?B))
         (@PF.Combinators.prim ?A ?B (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)
            p a e) (@BitcoinFull.sem ?A ?B p a e)
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
@fx_assert ?A ?B
     : forall (t : forall alg : Alg.Assertion.Algebra, Alg.Assertion.domain alg ?A ?B)
         (_ : @Alg.Assertion.Parametric ?A ?B t) (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?B))
         (t
            (PF.CanonicalStructures.toAssertion
               (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)) a e)
         (t (Alg.AssertionSem Option.option_Monad_Zero) a)
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
@fx_core ?A ?B
     : forall (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg ?A ?B) (_ : @Alg.Core.Parametric ?A ?B t)
         (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?B))
         (t
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) a e)
         (@Some (Ty.tySem ?B) (t Alg.CoreFunSem a))
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
ih_body
     : @eq Clight.statement (Clight.fn_body jets_sha.f_simplicity_bitcoin_input_hash)
