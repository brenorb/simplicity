  (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
     : Ty.Ty
sha256_ctx8_init_spec =
fun term : Alg.Core.Algebra =>
@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term
  (@buffer_empty_spec (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) Ty.Unit term)
  (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) term (@Word.zero (S (S (S (S (S (S O)))))) term)
     (@sha256_iv_spec term))
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit sha256_ctx8_type

