                         (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))) tail)),
       @ex Memory.Mem.mem
         (fun mb : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_writeBit)
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                     (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val))) Events.E0 mb
                  (Values.Vint Integers.Int.one))
               (and
                  (ClightBigstep.Clight2.eval_funcall ge0 mb (@Ctypes.Internal Clight.function f_write8s)
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                        (@cons Values.val (Values.Vptr bi (Integers.Ptrofs.repr input))
                           (@cons Values.val
                              (Values.Vlong
                                 (Integers.Int64.repr
                                    (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))
                              (@nil Values.val)))) Events.E0 mf Values.Vundef)
                  (and
                     (frame_output_cells_at mf bw edge cursor
                        (@cons (option bool) (@Some bool true)
                           (@List.concat Cell
                              (@List.map (Ty.tySem (Word.Word (S (S (S O))))) (list Cell)
                                 (@encode (Word.Word (S (S (S O))))) xs))))
                     (and (write_prefix_at m mf bw edge cursor)
                        (and
                           (write_frame_at mf bf base bw edge
                              (BinInt.Z.sub cursor
                                 (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs))))) tail)
                           (and
                              (loads_outside_ranges m mf bf
                                 (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 (BinInt.Z.add base
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                                 (BinInt.Z.add edge
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       (BinInt.Z.div
                                          (BinInt.Z.sub cursor
                                             (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                                (BinInt.Z.mul
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                                   (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)))))
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                 (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              (and
                                 (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                  Memory.Mem.perm mf b ofs kind p)
                                 (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                  Memory.Mem.valid_block mf b)))))))))
