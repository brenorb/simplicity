shape_eqb =
fix shape_eqb (a b : list (prod BinNums.Z AST.memory_chunk)) {struct a} : bool :=
  match a return bool with
  | nil => match b return bool with
           | nil => true
           | cons _ _ => false
           end
  | cons p t1 =>
      match p return bool with
      | pair o1 c1 =>
          match b return bool with
          | nil => false
          | cons p0 t2 =>
              match p0 return bool with
              | pair o2 c2 => andb (andb (BinInt.Z.eqb o1 o2) (chunk_eqb c1 c2)) (shape_eqb t1 t2)
              end
          end
      end
  end
     : forall (_ : list (prod BinNums.Z AST.memory_chunk)) (_ : list (prod BinNums.Z AST.memory_chunk)), bool

Arguments shape_eqb (a b)%list_scope
as_xp0 =
fun x : sx =>
match x return (option nat) with
| XI _ => @None nat
| XIc _ => @None nat
| XL _ => @None nat
| XLc _ => @None nat
| XLv _ => @None nat
| XV _ => @None nat
| XA _ _ => @None nat
| XP r d => match BinInt.Z.eqb d BinNums.Z0 return (option nat) with
            | true => @Some nat r
            | false => @None nat
            end
| XIb _ _ _ => @None nat
| XLb _ _ _ => @None nat
| XIsh _ _ _ => @None nat
| XLsh _ _ _ => @None nat
| XIcmp _ _ _ _ => @None nat
| XLcmp _ _ _ _ => @None nat
| XI2L _ _ => @None nat
| XL2I _ => @None nat
| XIcast _ _ _ => @None nat
| XInz _ => @None nat
| XLnz _ => @None nat
| XIz _ => @None nat
| XLz _ => @None nat
| XIneg _ => @None nat
| XLneg _ => @None nat
| XInot _ => @None nat
| XLnot _ => @None nat
end
     : forall _ : sx, option nat

