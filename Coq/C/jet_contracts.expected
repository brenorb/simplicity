both_skip =
fun a b : Clight.statement =>
match a return bool with
| Clight.Sskip =>
    match b return bool with
    | Clight.Sskip => true
    | Clight.Sassign _ _ => false
    | Clight.Sset _ _ => false
    | Clight.Scall _ _ _ => false
    | Clight.Sbuiltin _ _ _ _ => false
    | Clight.Ssequence _ _ => false
    | Clight.Sifthenelse _ _ _ => false
    | Clight.Sloop _ _ => false
    | Clight.Sbreak => false
    | Clight.Scontinue => false
    | Clight.Sreturn _ => false
    | Clight.Sswitch _ _ => false
    | Clight.Slabel _ _ => false
    | Clight.Sgoto _ => false
    end
| Clight.Sassign _ _ => false
| Clight.Sset _ _ => false
| Clight.Scall _ _ _ => false
| Clight.Sbuiltin _ _ _ _ => false
| Clight.Ssequence _ _ => false
| Clight.Sifthenelse _ _ _ => false
| Clight.Sloop _ _ => false
| Clight.Sbreak => false
| Clight.Scontinue => false
| Clight.Sreturn _ => false
| Clight.Sswitch _ _ => false
| Clight.Slabel _ _ => false
| Clight.Sgoto _ => false
end
     : forall (_ : Clight.statement) (_ : Clight.statement), bool

Arguments both_skip a b
break_stmt =
fun s : Clight.statement =>
match s return bool with
| Clight.Sskip => false
| Clight.Sassign _ _ => false
| Clight.Sset _ _ => false
| Clight.Scall _ _ _ => false
| Clight.Sbuiltin _ _ _ _ => false
| Clight.Ssequence _ _ => false
| Clight.Sifthenelse _ _ _ => false
| Clight.Sloop _ _ => false
| Clight.Sbreak => true
| Clight.Scontinue => false
| Clight.Sreturn _ => false
| Clight.Sswitch _ _ => false
| Clight.Slabel _ _ => false
| Clight.Sgoto _ => false
end
     : forall _ : Clight.statement, bool

Arguments break_stmt s
compact_stmt =
fun (ce : Ctypes.composite_env) (gv : venv) (fns : list (prod AST.ident fentry)) (n : nat) =>
fix compact_stmt (ve : venv) (st : sstate) (s : Clight.statement) {struct s} : option res :=
  match s return (option res) with
  | Clight.Sskip => xstmt ce gv fns n ve st s
  | Clight.Sassign _ _ => xstmt ce gv fns n ve st s
  | Clight.Sset _ _ => xstmt ce gv fns n ve st s
  | Clight.Scall _ _ _ => xstmt ce gv fns n ve st s
  | Clight.Sbuiltin _ _ _ _ => xstmt ce gv fns n ve st s
  | Clight.Ssequence a b =>
      match compact_stmt ve st a return (option res) with
      | Some r =>
          tbind r
            (fun (st' : sstate) (o : xout) =>
             match o return (option res) with
             | ONormal => compact_stmt ve st' b
             | OBreak => @Some res (RDone st' o)
             | OContinue => @Some res (RDone st' o)
             | OReturn _ => @Some res (RDone st' o)
             end)
      | None => @None res
      end
  | Clight.Sifthenelse a b c =>
      match both_skip b c return (option res) with
      | true =>
          match xexpr ce ve gv st a return (option res) with
          | Some x =>
              match xbool x (Clight.typeof a) return (option res) with
              | Some _ => @Some res (RDone st ONormal)
              | None => @None res
              end
          | None => @None res
          end
      | false => xstmt ce gv fns n ve st s
      end
  | Clight.Sloop a b =>
      match break_stmt b return (option res) with
      | true =>
          match compact_stmt ve st a return (option res) with
          | Some r =>
              tbind r
                (fun (st' : sstate) (o : xout) =>
                 match o return (option res) with
                 | ONormal => @Some res (RDone st' ONormal)
                 | OBreak => @Some res (RDone st' ONormal)
                 | OContinue => @Some res (RDone st' ONormal)
                 | OReturn v => @Some res (RDone st' (OReturn v))
                 end)
          | None => @None res
          end
      | false => xstmt ce gv fns n ve st s
      end
  | Clight.Sbreak => xstmt ce gv fns n ve st s
  | Clight.Scontinue => xstmt ce gv fns n ve st s
  | Clight.Sreturn _ => xstmt ce gv fns n ve st s
  | Clight.Sswitch _ _ => xstmt ce gv fns n ve st s
  | Clight.Slabel _ _ => xstmt ce gv fns n ve st s
  | Clight.Sgoto _ => xstmt ce gv fns n ve st s
  end
     : forall (_ : Ctypes.composite_env) (_ : venv) (_ : list (prod AST.ident fentry)) (_ : nat)
         (_ : venv) (_ : sstate) (_ : Clight.statement), option res

Arguments compact_stmt ce gv fns%list_scope n%nat_scope ve st s
compact_fun =
fun (ce : Ctypes.composite_env) (gv : venv) (fns : list (prod AST.ident fentry)) (n : nat)
  (fd : Clight.function) (xs : list sx) (regs : list region) (log : list event) (nv : nat) =>
xfun_with ce (compact_stmt ce gv fns n) fd xs regs log nv
  (xcall_ret (@Some BinNums.positive BinNums.xH) (Maps.PTree.empty sx) (@length region regs) (Clight.fn_return fd))
     : forall (_ : Ctypes.composite_env) (_ : venv) (_ : list (prod AST.ident fentry)) (_ : nat)
         (_ : Clight.function) (_ : list sx) (_ : list region) (_ : list event) (_ : nat),
       option res

