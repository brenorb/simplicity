bitcoin_check_distance_program_value
     : forall (dist : bool) (x : Ty.tySem (Word.Word (S (S (S (S O)))))) (environment : Bitcoin.Bitcoin.env),
       @ex Bitcoin.sigTxInput
         (fun txi : Bitcoin.sigTxInput =>
          and
            (@eq (option Bitcoin.sigTxInput)
               (@List.nth_error Bitcoin.sigTxInput (Bitcoin.sigTxIn (Bitcoin.Bitcoin.envTx environment))
                  (Bitcoin.Bitcoin.envIx environment)) (@Some Bitcoin.sigTxInput txi))
            (@eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem Ty.Unit))
               (@bitcoin_check_distance_program dist
                  (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) x environment)
               match
                 BinInt.Z.leb (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S O))))) x)
                   (BinInt.Z.modulo
                      (dist_value dist
                         (BinInt.Z.leb (BinNums.Zpos (BinNums.xO BinNums.xH))
                            (Integers.Int.unsigned (Bitcoin.sigTxVersion (Bitcoin.Bitcoin.envTx environment))))
                         (Integers.Int.unsigned (Bitcoin.sigTxiSequence txi)))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xO
                                        (BinNums.xO
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))
                 return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem Ty.Unit))
               with
               | true => @Some unit tt
               | false => @None (Ty.tySem Ty.Unit)
               end))
exec_bitcoin_check_distance_rest
     : forall (fid : AST.ident) (f : Clight.function) (bl : Values.block) (le : Maps.PTree.tree Values.val)
         (mc mr : Memory.Mem.mem) (be : Values.block) (ebase : BinNums.Z) (bt : Values.block)
         (tbase : BinNums.Z) (nI ixv xr r : Integers.Int64.int)
         (_ : @eq (option Values.block)
                (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv bitcoin_ge) fid)
                (@Some Values.block (bitcoin_symbol_block fid)))
         (_ : @eq (option Clight.fundef)
                (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv bitcoin_ge)
                   (Values.Vptr (bitcoin_symbol_block fid) Integers.Ptrofs.zero))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))
         (_ : @eq Ctypes.type (Clight.type_of_fundef (@Ctypes.Internal Clight.function f)) dist_fn_type)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) fid (bitcoin_version_locals bl))
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase)))) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le
                (BinInt.Z.add ebase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 tbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add tbase
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr mc be (BinInt.Z.add ebase BinNums.Z0))
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mc bt
                   (BinInt.Z.add tbase
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                (@Some Values.val (Values.Vlong nI)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mc be
                   (BinInt.Z.add ebase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))
                (@Some Values.val (Values.Vlong ixv))) (_ : @eq bool (Integers.Int64.ltu ixv nI) true)
         (_ : ClightBigstep.Clight2.eval_funcall bitcoin_ge mc (@Ctypes.Internal Clight.function f_simplicity_read16)
                (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val)) Events.E0 mr
                (Values.Vlong xr))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr mr be (BinInt.Z.add ebase BinNums.Z0))
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 mr be
                   (BinInt.Z.add ebase
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))
