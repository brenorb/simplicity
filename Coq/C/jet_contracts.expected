     (jet_secp_umul128_exec.mul_low32 jet_secp_umul128_exec.umul128_lh))
  (jet_secp_umul128_exec.mul_low32 jet_secp_umul128_exec.umul128_hl)
     : sx
jet_secp_umul128_exec.umul128_lo =
XLb Badd
  (XLsh Hshl jet_secp_umul128_exec.umul128_mid
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  (jet_secp_umul128_exec.mul_low32 jet_secp_umul128_exec.umul128_ll)
