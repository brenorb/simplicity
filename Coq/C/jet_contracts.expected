scalar_region_from_storage
     : forall (value : BinNums.Z) (layout : layout) (m : Memory.Mem.mem) (r : nat)
         (_ : scalar_at m (blk layout r) (bas layout r)
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (scalar_limbs_of value))),
       region_ok (scalar_limb_rho value) layout m r
         (mkreg
            (u64_cells BinNums.Z0
               (@cons sx (XLv O)
                  (@cons sx (XLv (S O)) (@cons sx (XLv (S (S O))) (@cons sx (XLv (S (S (S O)))) (@nil sx)))))) false
            (@None BinNums.Z))
scalar_get_initial_rep_derived
     : forall (value : BinNums.Z) (bbytes : Values.block) (byteofs : BinNums.Z) (bscalar : Values.block)
         (scalarofs : BinNums.Z) (m : Memory.Mem.mem) (_ : BinInt.Z.le BinNums.Z0 byteofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add byteofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m bbytes byteofs
                (BinInt.Z.add byteofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable)
         (_ : scalar_at m bscalar scalarofs
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (scalar_limbs_of value)))
         (_ : not (@eq Values.block bbytes bscalar)),
       rep (scalar_limb_rho value)
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bbytes byteofs)
            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bscalar scalarofs)
               (@nil (prod Values.block BinNums.Z)))) scalar_get_regs m
eval_scalar_get_b32_from_storage
     : forall (m : Memory.Mem.mem) (b : Values.block) (offset : BinNums.Z) (bs : Values.block)
         (base value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : BinInt.Z.le BinNums.Z0 offset)
         (_ : BinInt.Z.le
                (BinInt.Z.add offset
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : Memory.Mem.range_perm m b offset
                (BinInt.Z.add offset
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable)
         (_ : scalar_at m bs base (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr (scalar_limbs_of value)))
         (_ : not (@eq Values.block b bs)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_get_b32)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr offset))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr base)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (uint8_array_at mf b offset
                  (@List.map BinNums.Z Integers.Int.int Integers.Int.repr (jet_secp_fe_b32.be_bytes value)))
               (lframe
                  (fun (block : Values.block) (pos : BinNums.Z) =>
                   not
                     (foot
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b offset)
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bs base)
                              (@nil (prod Values.block BinNums.Z))))
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           scalar_get_regs) block pos)) m mf)))
radix_four_limbs
     : forall (base a0 a1 a2 a3 : BinNums.Z) (_ : BinInt.Z.lt BinNums.Z0 base)
         (_ : and (BinInt.Z.le BinNums.Z0 a0) (BinInt.Z.lt a0 base))
         (_ : and (BinInt.Z.le BinNums.Z0 a1) (BinInt.Z.lt a1 base))
         (_ : and (BinInt.Z.le BinNums.Z0 a2) (BinInt.Z.lt a2 base))
         (_ : and (BinInt.Z.le BinNums.Z0 a3) (BinInt.Z.lt a3 base)),
       let value : BinNums.Z :=
         BinInt.Z.add
           (BinInt.Z.add (BinInt.Z.add a0 (BinInt.Z.mul base a1))
              (BinInt.Z.mul (BinInt.Z.pow base (BinNums.Zpos (BinNums.xO BinNums.xH))) a2))
           (BinInt.Z.mul (BinInt.Z.pow base (BinNums.Zpos (BinNums.xI BinNums.xH))) a3) in
       and (@eq BinNums.Z (BinInt.Z.modulo value base) a0)
         (and (@eq BinNums.Z (BinInt.Z.modulo (BinInt.Z.div value base) base) a1)
            (and
               (@eq BinNums.Z
                  (BinInt.Z.modulo (BinInt.Z.div value (BinInt.Z.pow base (BinNums.Zpos (BinNums.xO BinNums.xH)))) base)
                  a2)
               (@eq BinNums.Z (BinInt.Z.div value (BinInt.Z.pow base (BinNums.Zpos (BinNums.xI BinNums.xH)))) a3)))
scalar_limbs_of_four_words
     : forall w0 w1 w2 w3 : Integers.Int64.int,
       @eq (list BinNums.Z)
         (scalar_limbs_of
            (BinInt.Z.add
               (BinInt.Z.add
                  (BinInt.Z.add (Integers.Int64.unsigned w0)
                     (BinInt.Z.mul
                        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinNums.Zpos
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                        (Integers.Int64.unsigned w1)))
                  (BinInt.Z.mul
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                     (Integers.Int64.unsigned w2)))
               (BinInt.Z.mul
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))
                  (Integers.Int64.unsigned w3))))
         (@cons BinNums.Z (Integers.Int64.unsigned w0)
            (@cons BinNums.Z (Integers.Int64.unsigned w1)
               (@cons BinNums.Z (Integers.Int64.unsigned w2)
                  (@cons BinNums.Z (Integers.Int64.unsigned w3) (@nil BinNums.Z)))))
scalar_reader_limbs_canonical
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Integers.Int64.int)
         (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
            (scalar_limbs_of
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (@canonical_scalar_normalize Alg.CoreFunSem value))))
         (@cons Integers.Int64.int
            (scalar_reader_limb (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
               layout O)
            (@cons Integers.Int64.int
               (scalar_reader_limb (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                  layout (S O))
               (@cons Integers.Int64.int
                  (scalar_reader_limb (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                     layout (S (S O)))
                  (@cons Integers.Int64.int
                     (scalar_reader_limb
                        (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) layout
                        (S (S (S O)))) (@nil Integers.Int64.int)))))
scalar_reader_storage_for_serializer
     : forall (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (rc : BinNums.Z)
         (layout : layout) (bi : Values.block) (edge : Integers.Ptrofs.int) (m : Memory.Mem.mem)
         (_ : rep (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc) layout
                (scalar_reader_final_regs bi edge) m),
       and
         (scalar_at m (blk layout O) (bas layout O)
