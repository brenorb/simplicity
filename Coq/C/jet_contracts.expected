         Memtype.Cur Memtype.Freeable
field_preserved_across_other_read
     : forall (m mf m0 : Memory.Mem.mem) (bd bw bi ba bb bl : Values.block) (edge : BinNums.Z)
         (xs : list Integers.Int64.int) (_ : not (@eq Values.block ba bb)) (_ : not (@eq Values.block ba bl))
         (_ : not (extA m0 bd bw bi ba)) (_ : fe_at m ba BinNums.Z0 xs)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : lframe
                (frame (extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))
                   (local_read_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mf),
       and (fe_at mf ba BinNums.Z0 xs)
         (Memory.Mem.range_perm mf ba BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
            Memtype.Freeable)
local_read_leaf_source
     : forall (bi : Values.block) (edge : Integers.Ptrofs.int),
       all_leaf_property
         (fun state : sstate =>
          @eq (list cell) (rcells (@List.nth region (S O) (sregs state) (mkreg (@nil cell) true (@None BinNums.Z))))
            (mk_frame_cells (XA bi edge)
               (Integers.Int64.repr
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (local_read_result bi edge)
local_read_selected_source
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z)
         (bi : Values.block) (edge : Integers.Ptrofs.int),
       @eq (list cell)
         (rcells
            (@List.nth region (S O) (sregs (@fst sstate xout (rsel rho layout (local_read_result bi edge))))
               (mkreg (@nil cell) true (@None BinNums.Z))))
         (mk_frame_cells (XA bi edge)
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
local_read_final_source_fields
     : forall (m : Memory.Mem.mem) (ba bl bi : Values.block) (edge rc : BinNums.Z)
         (rho : forall _ : nat, Integers.Int64.int) (_ : @eq Integers.Int64.int (rho O) (Integers.Int64.repr rc))
         (_ : rep rho
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z))))
                (sregs
                   (@fst sstate xout
                      (rsel rho
                         (lay
                            (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                               (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                  (@nil (prod Values.block BinNums.Z)))))
                         (local_read_result bi (Integers.Ptrofs.repr edge))))) m),
       frame_fields_at m bl BinNums.Z0 bi edge
         (BinInt.Z.add rc
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
eval_read_fe_canonical_with_source
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N cap : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bl : Values.block) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) cap
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
               (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                  (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
               Values.Vundef)
            (and
               (fe_at mr ba BinNums.Z0
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (fe_limbs_of
                        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_fe_normalize Alg.CoreFunSem value)))))
               (and
                  (frame_fields_at mr bl BinNums.Z0 bi edge
                     (BinInt.Z.add rc
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                  (and
                     (Memory.Mem.range_perm mr ba BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (and
                        (Memory.Mem.range_perm mr bl BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                           Memtype.Freeable)
                        (and
                           (invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) cap
                              (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                              (read_fe_log bi (Integers.Ptrofs.repr edge)) mr)
                           (lframe
                              (frame (extA m0 bd bw bi)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))))
                                 (local_read_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mr)))))))
eval_add_two_readers
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N cap : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (m : Memory.Mem.mem)
         (ba bb bl : Values.block) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool) (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) a)))
         (_ : frame_input_cells_at m0 bi edge
