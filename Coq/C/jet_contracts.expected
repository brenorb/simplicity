wide_one_spec =
fun (s : wide_size) (term : Alg.Core.Algebra) =>
@Alg.Core.Combinators.comp Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)) term (@Bit.true Ty.Unit term)
  (@left_pad_low_1_n term (wide_log s))
     : forall (s : wide_size) (term : Alg.Core.Algebra), Alg.Core.domain term Ty.Unit (Word.Word (wide_log s))

Arguments wide_one_spec s {term}
decode_wide =
fun (s : wide_size) (w : Integers.Int64.int) =>
@Word.ToZ.Theory.fromZ (Word.WordToZ (wide_log s)) (Integers.Int64.unsigned w)
     : forall (s : wide_size) (_ : Integers.Int64.int), Ty.tySem (Word.Word (wide_log s))

Arguments decode_wide s w
wide_output_at =
fun (s : wide_size) (m : Memory.Mem.mem) (bw : Values.block) (edge cursor : BinNums.Z)
  (value : Ty.tySem (Word.Word (wide_log s))) =>
@ex Integers.Int64.int
  (fun payload : Integers.Int64.int =>
   and (slice_output_at (wide_bits s) m bw edge cursor payload)
     (@eq (Ty.tySem (Word.Word (wide_log s))) (decode_wide s payload) value))
     : forall (s : wide_size) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Ty.tySem (Word.Word (wide_log s))), Prop

Arguments wide_output_at s m bw (edge cursor)%Z_scope value
left_pad_low_1_n =
fix left_pad_low_1_n (term : Alg.Core.Algebra) (n : nat) {struct n} :
    Alg.Core.domain term (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) :=
  match n as n0 return (Alg.Core.domain term (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n0)) with
  | O => @Alg.Core.Combinators.iden (Ty.Sum Ty.Unit Ty.Unit) term
  | S n0 =>
      @Alg.Core.Combinators.pair (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n0) (Word.Word n0) term
        (@Word.fill (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit) n0 term
           (@Alg.Core.Combinators.comp (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) term
              (@Alg.Core.Combinators.unit (Ty.Sum Ty.Unit Ty.Unit) term) (@Bit.false Ty.Unit term)))
        (left_pad_low_1_n term n0)
  end
     : forall (term : Alg.Core.Algebra) (n : nat), Alg.Core.domain term (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n)

Arguments left_pad_low_1_n {term} n%nat_scope
left_pad_low_1_8 =
fun term : Alg.Core.Algebra => @left_pad_low_1_n term (S (S (S O)))
     : forall term : Alg.Core.Algebra, Alg.Core.domain term (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))

Arguments left_pad_low_1_8 {term}
one8_spec =
