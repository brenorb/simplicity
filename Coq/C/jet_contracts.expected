absorb_small
     : forall (bs l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (_ : lt
                (Nat.add (@length (Ty.tySem (Word.Word (S (S (S O))))) l)
                   (@length (Ty.tySem (Word.Word (S (S (S O))))) bs))
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq (prod (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)) (absorb l regs bs)
         (@pair (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
            (@app (Ty.tySem (Word.Word (S (S (S O))))) l bs) regs)
short_hash_regs
     : forall (bs : list (Ty.tySem (Word.Word (S (S (S O))))))
         (_ : lt (@length (Ty.tySem (Word.Word (S (S (S O))))) bs)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))),
       @eq SHA256.registers (Digest.hash256_reg (sha256_bytes_of bs))
         (@snd (list Integers.Int.int) (list Integers.Int.int)
            (absorb_i (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value bs)
               sha256_iv_words
               (sha_pad (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) bs))))))
prim_words_hash_spec_parametric
     : forall (k w : nat) (p : BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))),
       @PF.Parametric Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@prim_words_hash_spec k w p)
prim_words_hash_spec_sem
     : forall (k w : nat) (p : BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (xs_of : forall _ : ext_environment, list (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
         (_ : forall (i : Ty.tySem (Word.Word w)) (e : BitcoinFull.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (@BitcoinFull.sem (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) p i e)
                (@Some (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) (xs_of e)
                       (BinInt.Z.to_nat (wz w i))
                     return (sum unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x => @inr unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None => @inl unit (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end))
         (_ : BinInt.Z.lt
                (BinInt.Z.div (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)) (wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                ctx8_limit) (e : BitcoinFull.env),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@prim_words_hash_spec k w p (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)
            tt e)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.from_hash256 (words_hash_of k w (xs_of e))))
tx_words_hash_jet
     : forall (k w : nat) (p : BitcoinFull.t (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)))
         (xs_of : forall _ : BitcoinFull.env,
                  list
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end) (Word.Vector (Word.Word (S (S (S O)))) k))) (f : Clight.function)
         (field : AST.ident) (hdelta : BinNums.Z)
         (_ : forall (i : Ty.tySem (Word.Word w)) (e : BitcoinFull.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k))))
                (@BitcoinFull.sem (Word.Word w) (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) p i e)
                (@Some
                   (sum unit
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Vector (Word.Word (S (S (S O)))) k)))
                   match
                     @List.nth_error
                       ((fix tySem (X : Ty.Ty) : Set :=
                           match X return Set with
                           | Ty.Unit => unit
                           | Ty.Sum A B => sum (tySem A) (tySem B)
                           | Ty.Prod A B => prod (tySem A) (tySem B)
                           end) (Word.Vector (Word.Word (S (S (S O)))) k)) (xs_of e) (BinInt.Z.to_nat (wz w i))
                     return
                       (sum unit
                          ((fix tySem (X : Ty.Ty) : Set :=
                              match X return Set with
                              | Ty.Unit => unit
                              | Ty.Sum A B => sum (tySem A) (tySem B)
                              | Ty.Prod A B => prod (tySem A) (tySem B)
                              end) (Word.Vector (Word.Word (S (S (S O)))) k)))
                   with
                   | Some x =>
                       @inr unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Vector (Word.Word (S (S (S O)))) k)) x
                   | None =>
                       @inl unit
                         ((fix tySem (X : Ty.Ty) : Set :=
                             match X return Set with
                             | Ty.Unit => unit
                             | Ty.Sum A B => sum (tySem A) (tySem B)
                             | Ty.Prod A B => prod (tySem A) (tySem B)
                             end) (Word.Vector (Word.Word (S (S (S O)))) k)) tt
                   end))
         (_ : BinInt.Z.lt
                (BinInt.Z.div (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)) (wsize w))
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                ctx8_limit)
         (_ : jet_bitcoin_wrapper.bitcoin_wrapper_shape f
                (jet_bitcoin_wrapper.bitcoin_simple_rest
                   (jet_bitcoin_hash_getters.bitcoin_hash_mid_writeHash jets_bitcoin._tx
                      jets_bitcoin._bitcoinTransaction field)))
         (_ : jet_bitcoin_field_eval.bitcoin_field_at jets_bitcoin._bitcoinTransaction field hdelta)
         (_ : and (BinInt.Z.le BinNums.Z0 hdelta)
                (BinInt.Z.le
                   (BinInt.Z.add hdelta
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))))),
       application_jet_local_spec_sep f bitcoin_ge ext_environment Ty.Unit
         (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (@hash_getter_rep BitcoinFull.env (fun e : BitcoinFull.env => words_hash_of k w (xs_of e)) BinNums.Z0 hdelta
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))))))
         (fun (a : Ty.tySem Ty.Unit) (environment : ext_environment) =>
          @prim_words_hash_spec k w p (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)
            a environment)
words_bound_8
     : BinInt.Z.lt
         (BinInt.Z.div
            (BinInt.Z.mul (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) (S (S (S O))))) (wsize (S (S (S (S (S O)))))))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         ctx8_limit
