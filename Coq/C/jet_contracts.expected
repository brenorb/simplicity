         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S O))))))
         (fun a : Ty.tySem (Word.Word (S (S (S (S O))))) => @increment16_spec Alg.CoreFunSem a)
increment32_local_spec
     : jet_local_spec jets.f_simplicity_increment_32 (Word.Word (S (S (S (S (S O))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S O)))))))
         (fun a : Ty.tySem (Word.Word (S (S (S (S (S O)))))) => @increment32_spec Alg.CoreFunSem a)
increment64_local_spec
     : jet_local_spec jets.f_simplicity_increment_64 (Word.Word (S (S (S (S (S (S O)))))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O))))))))
