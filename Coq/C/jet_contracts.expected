     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv sha_ge)
            (Values.Vptr (sha_symbol_block jets_sha._sha256_hash) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_sha.f_sha256_hash))
fromMidstate_body
     : @eq Clight.statement (Clight.fn_body jets_sha.f_sha256_fromMidstate) (fm_seq O (S (S (S (S (S (S (S O))))))))
fm_temp_fresh
     : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
       and (not (@eq AST.ident (fm_temp i) jets_sha._midstate)) (not (@eq AST.ident (fm_temp i) jets_sha._hash))
ptr_word_index
     : forall (o : Integers.Ptrofs.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned o)
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i)) Integers.Ptrofs.max_unsigned),
       @eq BinNums.Z
         (Integers.Ptrofs.unsigned
            (Integers.Ptrofs.add o
               (Integers.Ptrofs.mul (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                  (Integers.Ptrofs.of_ints (Integers.Int.repr i)))))
         (BinInt.Z.add (Integers.Ptrofs.unsigned o)
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) i))
fm_pair_exec
     : forall (bh bmid : Values.block) (oh omid : Integers.Ptrofs.int) (regs : list Integers.Int.int)
         (_ : not (@eq Values.block bh bmid))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned omid)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (i : nat) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem)
         (_ : lt i (S (S (S (S (S (S (S (S O))))))))) (_ : fm_ok bh bmid oh omid regs m)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._midstate le)
                (@Some Values.val (Values.Vptr bmid omid)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._hash le)
                (@Some Values.val (Values.Vptr bh oh))),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt sha_ge Clight.empty_env le m (fm_pair i) Events.E0
               (@Maps.PTree.set Values.val (fm_temp i)
                  (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero)) le) m' ClightBigstep.Out_normal)
            (and
               (forall (q : nat) (_ : lt q (S (S (S (S O))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint8unsigned m' bh
                     (BinInt.Z.add
                        (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                        (BinInt.Z.of_nat q)))
                  (@Some Values.val (Values.Vint (@List.nth Integers.Int.int q (fm_word regs i) Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : or (not (@eq Values.block b bh))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                                  (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                        (BinInt.Z.of_nat i))))
                               (BinInt.Z.le
                                  (BinInt.Z.add
                                     (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                           (BinInt.Z.of_nat i))) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
fm_seq_exec
     : forall (bh bmid : Values.block) (oh omid : Integers.Ptrofs.int) (regs : list Integers.Int.int)
         (_ : not (@eq Values.block bh bmid))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned omid)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (n i : nat) (le0 : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (_ : @eq nat (Nat.add i n) (S (S (S (S (S (S (S O))))))))
         (_ : fm_ok bh bmid oh omid regs m)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._midstate le0)
                (@Some Values.val (Values.Vptr bmid omid)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._hash le0)
                (@Some Values.val (Values.Vptr bh oh))),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun m' : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt sha_ge Clight.empty_env le0 m (fm_seq i n) Events.E0 le' m'
                  ClightBigstep.Out_normal)
               (and
                  (forall (j q : nat) (_ : and (le i j) (lt j (S (S (S (S (S (S (S (S O))))))))))
                     (_ : lt q (S (S (S (S O))))),
                   @eq (option Values.val)
                     (Memory.Mem.load AST.Mint8unsigned m' bh
                        (BinInt.Z.add
                           (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j)))
                           (BinInt.Z.of_nat q)))
                     (@Some Values.val (Values.Vint (@List.nth Integers.Int.int q (fm_word regs j) Integers.Int.zero))))
                  (and
                     (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bh))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                                     (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                           (BinInt.Z.of_nat i))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                                        (BinNums.Zpos
                                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                     ofs))),
                      @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b))))))
eval_sha_fromMidstate
     : forall (m : Memory.Mem.mem) (bh : Values.block) (oh : Integers.Ptrofs.int) (bmid : Values.block)
         (omid : Integers.Ptrofs.int) (regs : list Integers.Int.int) (_ : not (@eq Values.block bh bmid))
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned omid)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bmid
                   (BinInt.Z.add (Integers.Ptrofs.unsigned omid)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j regs Integers.Int.zero))))
         (_ : Memory.Mem.range_perm m bh (Integers.Ptrofs.unsigned oh)
                (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall sha_ge m
               (@Ctypes.Internal Clight.function jets_sha.f_sha256_fromMidstate)
               (@cons Values.val (Values.Vptr bh oh) (@cons Values.val (Values.Vptr bmid omid) (@nil Values.val)))
               Events.E0 m' Values.Vundef)
            (and
               (forall (k : nat) (_ : lt k (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint8unsigned m' bh
                     (BinInt.Z.add (Integers.Ptrofs.unsigned oh) (BinInt.Z.of_nat k)))
                  (@Some Values.val (Values.Vint (@List.nth Integers.Int.int k (be_bytes regs) Integers.Int.zero))))
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : or (not (@eq Values.block b bh))
                            (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) (Integers.Ptrofs.unsigned oh))
                               (BinInt.Z.le
                                  (BinInt.Z.add (Integers.Ptrofs.unsigned oh)
                                     (BinNums.Zpos
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                  ofs))),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
hash_blocks
     : forall bb : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) (Clight.blocks_of_env sha_ge (hash_env bb))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bb BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
            (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))
hash_entry
     : forall (m : Memory.Mem.mem) (m1 : Memory.Mem.mem') (bb bx : Values.block) (cbase : BinNums.Z)
         (bt : Values.block) (ot : Integers.Ptrofs.int)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m1 bb)),
       Clight.function_entry2 sha_ge jets_sha.f_sha256_hash
         (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr cbase))
            (@cons Values.val (Values.Vptr bt ot) (@nil Values.val))) m (hash_env bb) (hash_temps bx cbase bt ot) m1
eval_midstate_s
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bt : Values.block)
         (ot : Integers.Ptrofs.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._h le)
                (@Some Values.val (Values.Vptr bt ot))),
       Clight.eval_expr sha_ge e le m
         (Clight.Efield
            (Clight.Ederef
               (Clight.Etempvar jets_sha._h (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)))
               (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)) jets_sha._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr bt (Integers.Ptrofs.add ot (Integers.Ptrofs.repr BinNums.Z0)))
eval_sha256_hash
     : forall (_ : memcpy_model) (m : Memory.Mem.mem) (bx : Values.block) (cbase : BinNums.Z)
         (bo : Values.block) (obase : BinNums.Z) (bt : Values.block) (ot : Integers.Ptrofs.int)
         (l regs regsH : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool)
         (_ : BinInt.Z.le BinNums.Z0 cbase)
         (_ : BinInt.Z.le
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 obase)
         (_ : BinInt.Z.le
                (BinInt.Z.add obase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned) (_ : not (@eq Values.block bo bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bo))
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
         (_ : @eq nat (@length Integers.Int.int regsH) (S (S (S (S (S (S (S (S O)))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned ot)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : forall (j : nat) (_ : lt j (S (S (S (S (S (S (S (S O))))))))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m bt
                   (BinInt.Z.add (Integers.Ptrofs.unsigned ot)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat j))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int j regsH Integers.Int.zero))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m bx cbase)
                (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr obase))))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m bx
                   (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong c)))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo (Integers.Int64.unsigned c)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                (BinInt.Z.of_nat (@length Integers.Int.int l)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bx
                   (BinInt.Z.add cbase
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                (@Some Values.val (Values.Vint (bit_int ovf))))
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int l)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m bx
                   (BinInt.Z.add
                      (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i l Integers.Int.zero))))
         (_ : forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
              and
                (@eq (option Values.val)
                   (Memory.Mem.load AST.Mint32 m bo
                      (BinInt.Z.add obase
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                   (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
                (Memory.Mem.valid_access m AST.Mint32 bo
                   (BinInt.Z.add obase
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                   Memtype.Writable)) (_ : sha_dispatch_ok m)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m (sha_symbol_block jets_sha._sha256_max_counter) BinNums.Z0)
                (@Some Values.val (Values.Vlong sha_max_counter)))
         (_ : Memory.Mem.range_perm m bx
                (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (BinInt.Z.add cbase
                   (BinNums.Zpos
                      (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Memtype.Cur Memtype.Writable)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) cbase),
       let bs : list Integers.Int.int := be_bytes regsH in
       let ovf' : bool :=
         uc_overflow ovf c
           (Integers.Int64.repr
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) in
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_sha256_hash)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr cbase))
                  (@cons Values.val (Values.Vptr bt ot) (@nil Values.val))) Events.E0 m' Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr m' bx cbase)
                  (@Some Values.val (Values.Vptr bo (Integers.Ptrofs.repr obase))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 m' bx
                        (BinInt.Z.add cbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val
                        (Values.Vlong
                           (Integers.Int64.add c
                              (Integers.Int64.repr
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint8unsigned m' bx
                           (BinInt.Z.add cbase
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                        (@Some Values.val (Values.Vint (bit_int ovf'))))
                     (and
                        (forall (i : nat)
                           (_ : lt i
                                  (@length Integers.Int.int
                                     (@fst (list Integers.Int.int) (list Integers.Int.int) (absorb_i l regs bs)))),
                         @eq (option Values.val)
                           (Memory.Mem.load AST.Mint8unsigned m' bx
                              (BinInt.Z.add
                                 (BinInt.Z.add cbase
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (BinInt.Z.of_nat i)))
                           (@Some Values.val
                              (Values.Vint
                                 (@List.nth Integers.Int.int i
                                    (@fst (list Integers.Int.int) (list Integers.Int.int) (absorb_i l regs bs))
                                    Integers.Int.zero))))
                        (and
                           (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
                            @eq (option Values.val)
                              (Memory.Mem.load AST.Mint32 m' bo
                                 (BinInt.Z.add obase
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                                       (BinInt.Z.of_nat i))))
                              (@Some Values.val
                                 (Values.Vint
                                    (@List.nth Integers.Int.int i
                                       (@snd (list Integers.Int.int) (list Integers.Int.int) (absorb_i l regs bs))
                                       Integers.Int.zero))))
                           (and
                              (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                 (_ : Memory.Mem.valid_block m b)
                                 (_ : or (not (@eq Values.block b bx))
                                        (or
                                           (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch))
                                              (BinInt.Z.add cbase
                                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                           (BinInt.Z.le
                                              (BinInt.Z.add cbase
                                                 (BinNums.Zpos
                                                    (BinNums.xI
                                                       (BinNums.xO
                                                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                              ofs)))
                                 (_ : or (not (@eq Values.block b bo))
                                        (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) obase)
                                           (BinInt.Z.le
                                              (BinInt.Z.add obase
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                              ofs))),
                               @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                              (and
                                 (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.valid_block m b)
                                    (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p)
                                 (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                  Memory.Mem.valid_block m' b)))))))))
