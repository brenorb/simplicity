one8_context_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context) (a : Ty.tySem Ty.Unit),
       let s0 : RunState :=
         fillContext ctx (Build_LocalState (@encode Ty.Unit a) (newWriteFrame (bitSize (Word.Word (S (S (S O))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode Ty.Unit a)
              (fullWriteFrame (@encode (Word.Word (S (S (S O)))) (@one8_spec Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv jets.prog)
               (@Ctypes.Internal Clight.function jets.f_simplicity_one_8) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@one8_spec Naive.translate) (Running s0) (Running s1))))
