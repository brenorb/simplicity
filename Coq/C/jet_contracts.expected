                  (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr slot))
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                        (@cons Values.val
                           (Values.Vint (Integers.Int.repr (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))))
                           (@nil Values.val))))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bl slot)
                  (@Some Values.val (Values.Vlong Integers.Int64.zero)))
               (and
                  (frame_fields_at mf bf base bi edge
                     (BinInt.Z.add cursor
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))
                  (and
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : or (not (@eq Values.block b bf))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bl))
                               (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk)) slot)
                                  (BinInt.Z.le
                                     (BinInt.Z.add slot
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                     (and
                        (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                         Memory.Mem.perm mf b ofs kind p)
                        (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b))))))
buffer_byte_chunks_counts
     : forall (depth : nat) (x : Ty.tySem (buffer_type (Word.Word (S (S (S O)))) depth)),
