extend_word8_context
     : forall s : extend_word8_size,
       @jet_context_for (extend_word8_function s) (Word.Word (S (S (S O))))
         (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))
         (fun term : Alg.Core.Algebra => @left_extend_word_spec (S (S (S O))) (extend_word8_depth s) term)
extend_word8_guarantees
     : forall (s : extend_word8_size) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z) (a : Ty.tySem (Word.Word (S (S (S O)))))
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O)))))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor (@encode (Word.Word (S (S (S O)))) a))
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.of_nat (bitSize (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (extend_word8_function s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))
                     (@left_extend_word_spec (S (S (S O))) (extend_word8_depth s) Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor
                           (BinInt.Z.of_nat (bitSize (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat
                                                    (bitSize
                                                       (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s)))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
extend_word8_context_guarantees
     : forall (s : extend_word8_size) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout)
         (ctx : Context) (a : Ty.tySem (Word.Word (S (S (S O))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S O)))) a)
              (newWriteFrame (bitSize (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S O)))) a)
              (fullWriteFrame
                 (@encode (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))
                    (@left_extend_word_spec (S (S (S O))) (extend_word8_depth s) Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (extend_word8_function s)) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@left_extend_word_spec (S (S (S O))) (extend_word8_depth s) Naive.translate)
                  (Running s0) (Running s1))))
int32_single_bit_mask
     : forall (r : Integers.Int.int) (k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.lt k
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq Integers.Int.int
         (Integers.Int.and r (Integers.Int.repr (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
         match Integers.Int.testbit r k return Integers.Int.int with
         | true => Integers.Int.repr (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
         | false => Integers.Int.zero
         end
int32_single_bit_mask_nonzero
     : forall (r : Integers.Int.int) (k : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 k)
                (BinInt.Z.lt k
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))),
       @eq bool
         (negb
            (Integers.Int.eq
               (Integers.Int.and r (Integers.Int.repr (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
               Integers.Int.zero)) (Integers.Int.testbit r k)
right_extend_word8_loop_shape
     : forall s : extend_word8_size,
       @eq Clight.statement
         match Clight.fn_body (right_extend_word8_function s) return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s1 =>
             match s1 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s3 =>
                 match s3 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence _ s5 =>
                     match s5 return Clight.statement with
                     | Clight.Sskip => Clight.Sskip
                     | Clight.Sassign _ _ => Clight.Sskip
                     | Clight.Sset _ _ => Clight.Sskip
                     | Clight.Scall _ _ _ => Clight.Sskip
                     | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                     | Clight.Ssequence _ s7 =>
                         match s7 return Clight.statement with
                         | Clight.Sskip => Clight.Sskip
                         | Clight.Sassign _ _ => Clight.Sskip
                         | Clight.Sset _ _ => Clight.Sskip
                         | Clight.Scall _ _ _ => Clight.Sskip
                         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                         | Clight.Ssequence s8 _ =>
                             match s8 return Clight.statement with
                             | Clight.Sskip => Clight.Sskip
                             | Clight.Sassign _ _ => Clight.Sskip
                             | Clight.Sset _ _ => Clight.Sskip
                             | Clight.Scall _ _ _ => Clight.Sskip
                             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                             | Clight.Ssequence _ loop => loop
                             | Clight.Sifthenelse _ _ _ => Clight.Sskip
                             | Clight.Sloop _ _ => Clight.Sskip
                             | Clight.Sbreak => Clight.Sskip
                             | Clight.Scontinue => Clight.Sskip
                             | Clight.Sreturn _ => Clight.Sskip
                             | Clight.Sswitch _ _ => Clight.Sskip
                             | Clight.Slabel _ _ => Clight.Sskip
                             | Clight.Sgoto _ => Clight.Sskip
                             end
                         | Clight.Sifthenelse _ _ _ => Clight.Sskip
                         | Clight.Sloop _ _ => Clight.Sskip
                         | Clight.Sbreak => Clight.Sskip
                         | Clight.Scontinue => Clight.Sskip
                         | Clight.Sreturn _ => Clight.Sskip
                         | Clight.Sswitch _ _ => Clight.Sskip
                         | Clight.Slabel _ _ => Clight.Sskip
                         | Clight.Sgoto _ => Clight.Sskip
                         end
                     | Clight.Sifthenelse _ _ _ => Clight.Sskip
                     | Clight.Sloop _ _ => Clight.Sskip
                     | Clight.Sbreak => Clight.Sskip
                     | Clight.Scontinue => Clight.Sskip
                     | Clight.Sreturn _ => Clight.Sskip
                     | Clight.Sswitch _ _ => Clight.Sskip
                     | Clight.Slabel _ _ => Clight.Sskip
                     | Clight.Sgoto _ => Clight.Sskip
                     end
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end (right_extend_word8_loop s)
