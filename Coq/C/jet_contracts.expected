fun (k : order_op) (s : wide_size) =>
match k return Clight.function with
| OLt =>
    match s return Clight.function with
    | W16 => f_simplicity_lt_16
    | W32 => f_simplicity_lt_32
    | W64 => f_simplicity_lt_64
    end
| OLe =>
    match s return Clight.function with
    | W16 => f_simplicity_le_16
    | W32 => f_simplicity_le_32
    | W64 => f_simplicity_le_64
    end
end
     : forall (_ : order_op) (_ : wide_size), Clight.function

