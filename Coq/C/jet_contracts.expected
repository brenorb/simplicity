read32s_run =
fix read32s_run
  (bi : Values.block) (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int64.int)
  (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons x rest =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         @ex Memory.Mem.mem
           (fun ms : Memory.Mem.mem =>
            and
              (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_read32)
                 (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mi
                 (Values.Vlong x))
              (and
                 (@eq (option Memory.Mem.mem)
                    (Memory.Mem.store AST.Mint32 mi bi input (Values.Vint (Integers.Int64.loword x)))
                    (@Some Memory.Mem.mem ms))
                 (read32s_run bi (BinInt.Z.add input (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))) bf base rest
                    ms mf))))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int64.int)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

