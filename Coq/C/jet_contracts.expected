                                  | Some _ => true
                                  | None => false
                                  end
     : forall _ : option Digest.hash256, bool

Arguments ih_has ax
ih_annex_value =
fun ax : option Digest.hash256 =>
match ax return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) with
| Some h => @inr unit (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 h)
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end)
            ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                match n return Ty.Ty with
                | O => X
                | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S (S O)))))))))) tt
end
     : forall _ : option Digest.hash256, Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments ih_annex_value ax
ih_cbytes =
fun (txid : Digest.hash256) (ix seq : Integers.Int.int) (ax : option Digest.hash256) =>
match ax return (list Integers.Int.int) with
| Some h =>
    @app Integers.Int.int
      (@app Integers.Int.int
         (@app Integers.Int.int
            (@app Integers.Int.int (be_bytes (Digest.hash256_reg txid))
               (c_be32_bytes (Integers.Int64.repr (Integers.Int.unsigned ix))))
            (c_be32_bytes (Integers.Int64.repr (Integers.Int.unsigned seq))))
         (@cons Integers.Int.int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) (@nil Integers.Int.int)))
      (be_bytes (Digest.hash256_reg h))
| None =>
    @app Integers.Int.int
      (@app Integers.Int.int
         (@app Integers.Int.int (be_bytes (Digest.hash256_reg txid))
            (c_be32_bytes (Integers.Int64.repr (Integers.Int.unsigned ix))))
         (c_be32_bytes (Integers.Int64.repr (Integers.Int.unsigned seq))))
      (@cons Integers.Int.int (Integers.Int.repr BinNums.Z0) (@nil Integers.Int.int))
end
     : forall (_ : Digest.hash256) (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : option Digest.hash256),
       list Integers.Int.int

Arguments ih_cbytes txid ix seq ax
ih_elem_rep =
fun (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (txi : Bitcoin.sigTxInput) (ax : option Digest.hash256)
=>
and
  (uint32_array_at m b
     (BinInt.Z.add base
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (Digest.hash256_reg (Bitcoin.opHash (Bitcoin.sigTxiPreviousOutpoint txi))))
  (and
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m b
           (BinInt.Z.add base
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))
        (@Some Values.val
           (Values.Vlong
              (Integers.Int64.repr (Integers.Int.unsigned (Bitcoin.opIndex (Bitcoin.sigTxiPreviousOutpoint txi)))))))
     (and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint64 m b
              (BinInt.Z.add base
                 (BinNums.Zpos
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
           (@Some Values.val (Values.Vlong (Integers.Int64.repr (Integers.Int.unsigned (Bitcoin.sigTxiSequence txi))))))
        (and
           (@eq (option Values.val)
              (Memory.Mem.load AST.Mint8unsigned m b
                 (BinInt.Z.add base
                    (BinNums.Zpos
                       (BinNums.xO
                          (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
              (@Some Values.val (Values.Vint (bit_int (ih_has ax)))))
           (forall (h : Digest.hash256) (_ : @eq (option Digest.hash256) ax (@Some Digest.hash256 h)),
            uint32_array_at m b (BinInt.Z.add base BinNums.Z0) (Digest.hash256_reg h)))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Bitcoin.sigTxInput)
         (_ : option Digest.hash256), Prop

Arguments ih_elem_rep m b base%Z_scope txi ax
input_hash_rep =
fun (m : Memory.Mem.mem) (env : Values.val) (e : ext_environment)
  (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z)) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Values.block
              (fun bin : Values.block =>
               @ex BinNums.Z
                 (fun inbase : BinNums.Z =>
                  @ex Integers.Int64.int
                    (fun nI : Integers.Int64.int =>
                     and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                       (and (BinInt.Z.le BinNums.Z0 ebase)
                          (and
                             (BinInt.Z.le
                                (BinInt.Z.add ebase
                                   (BinNums.Zpos
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                Integers.Ptrofs.max_unsigned)
                             (and (BinInt.Z.le BinNums.Z0 txbase)
                                (and
                                   (BinInt.Z.le
                                      (BinInt.Z.add txbase
                                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (...)))))))
                                      Integers.Ptrofs.max_unsigned)
                                   (and (BinInt.Z.le BinNums.Z0 inbase)
                                      (and
                                         (BinInt.Z.le
                                            (BinInt.Z.add inbase
                                               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (...)))
                                                  (BinInt.Z.of_nat (@length Bitcoin.sigTxInput (...)))))
                                            Integers.Ptrofs.max_unsigned)
                                         (and
                                            (@eq (option Values.val)
                                               (Memory.Mem.load AST.Mptr m be (BinInt.Z.add ebase BinNums.Z0))
                                               (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                                            (and
                                               (@eq (option Values.val)
                                                  (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add txbase BinNums.Z0))
                                                  (@Some Values.val (Values.Vptr bin (...))))
                                               (and
                                                  (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bt (...))
                                                     (@Some Values.val (...)))
                                                  (and (@eq BinNums.Z (...) (...)) (and (...) (...)))))))))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : ext_environment)
         (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop

Arguments input_hash_rep m env e fp%list_scope
input_hash_spec =
fun alg : PF.Algebra =>
let term : Alg.Assertion.Algebra := PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_bitcoin_build_tapleaf_spec.AC.comp (Word.Word (S (S (S (S (S O))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
     (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
  (@jet_bitcoin_build_tapleaf_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
     (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
     (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))) core
     (@PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))) alg
        (@BitcoinFull.Base (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
           Bitcoin.Bitcoin.InputPrevOutpoint))
     (@jet_bitcoin_build_tapleaf_spec.AC.pair (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) core
        (@PF.Combinators.prim (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))) alg
           (@BitcoinFull.Base (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
              Bitcoin.Bitcoin.InputSequence))
        (@PF.Combinators.prim (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) alg
           (@BitcoinFull.Ext (Word.Word (S (S (S (S (S O))))))
              (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) BitcoinExt.InputAnnexHash))))
  (@jet_bitcoin_build_tapleaf_spec.AC.case Ty.Unit
     (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
     (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
     (@jet_bitcoin_build_tapleaf_spec.AC.injl
        (Ty.Prod Ty.Unit
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
              (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_bitcoin_build_tapleaf_spec.AC.unit
           (Ty.Prod Ty.Unit
              (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                 (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) core))
     (@jet_bitcoin_build_tapleaf_spec.AC.injr
        (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
              (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
        (@jet_bitcoin_build_tapleaf_spec.AC.comp
           (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
              (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                 (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
           (Ty.Prod sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
           (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
           (@jet_bitcoin_build_tapleaf_spec.AC.pair
              (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                 (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                    (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))) sha256_ctx8_type
              (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
              (@jet_bitcoin_build_tapleaf_spec.AC.comp
                 (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                    (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                       (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                 (Ty.Prod sha256_ctx8_type (Word.Word (S (S (S (S (S O))))))) sha256_ctx8_type core
                 (@jet_bitcoin_build_tapleaf_spec.AC.pair
                    (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                       (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                          (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                    sha256_ctx8_type (Word.Word (S (S (S (S (S O)))))) core
                    (@jet_bitcoin_build_tapleaf_spec.AC.comp
                       (Ty.Prod
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                          (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                             (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                       (Ty.Prod sha256_ctx8_type
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
                       sha256_ctx8_type core
                       (@jet_bitcoin_build_tapleaf_spec.AC.pair
                          (Ty.Prod
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                             (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                                (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))))
                          sha256_ctx8_type
                          (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                          core
                          (@jet_bitcoin_build_tapleaf_spec.AC.comp
                             (Ty.Prod
                                (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                   (Word.Word (S (S (S (S (S O)))))))
                                (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                                   (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S ...))))))))))))
                             Ty.Unit sha256_ctx8_type core
                             (@jet_bitcoin_build_tapleaf_spec.AC.unit
                                (Ty.Prod
                                   (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                      (Word.Word (S (S (S (S (S O)))))))
                                   (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                                      (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S ...))))))))))) core)
                             (@sha256_ctx8_init_spec core))
                          (@jet_bitcoin_build_tapleaf_spec.AC.take
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                             (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                                (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                             (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                             core
                             (@jet_bitcoin_build_tapleaf_spec.AC.iden
                                (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                                   (Word.Word (S (S (S (S (S O))))))) core))) (@outpoint_hash_spec term))
                    (@jet_bitcoin_build_tapleaf_spec.AC.drop
                       (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                       (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                          (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                       (Word.Word (S (S (S (S (S O)))))) core
                       (@jet_bitcoin_build_tapleaf_spec.AC.take (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                          (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                          (Word.Word (S (S (S (S (S O)))))) core
                          (@assert_iden_spec (Word.Word (S (S (S (S (S O)))))) term))))
                 (@ctx8_addn_spec (S (S O)) term))
              (@jet_bitcoin_build_tapleaf_spec.AC.drop
                 (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
                 (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                    (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))))
                 (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
                 (@jet_bitcoin_build_tapleaf_spec.AC.drop (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O)))))))
                    (Ty.Sum Ty.Unit (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                    (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
                    (@assert_iden_spec (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) term))))
           (@jet_bitcoin_build_tapleaf_spec.AC.comp
              (Ty.Prod sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
              sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@annex_hash_spec term)
              (@ctx8_finalize_spec term)))))
     : forall alg : PF.Algebra,
       PF.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments input_hash_spec {alg}
input_hash_bytes =
fun (op : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
  (sq : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
  (ax : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) =>
@app (Ty.tySem (Word.Word (S (S (S O))))) (outpoint_bytes op)
  (@app (Ty.tySem (Word.Word (S (S (S O))))) (vector_values (Word.Word (S (S (S O)))) (S (S O)) sq)
     (annex_elem_bytes ax))
     : forall (_ : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (_ : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))),
       list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments input_hash_bytes op sq ax
iu_env =
fun bl bm bx br : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha.__res
  (@pair Values.block Ctypes.type br (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
  (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._ctx
     (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
     (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._midstate
        (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
        (@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha._src
           (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Clight.empty_env)))
     : forall (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Clight.env

Arguments iu_env bl bm bx br
iu_temps =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_sha._env env
  (@Maps.PTree.set Values.val jets_sha._src (Values.Vptr bs (Integers.Ptrofs.repr sbase))
     (@Maps.PTree.set Values.val jets_sha._dst (Values.Vptr bd (Integers.Ptrofs.repr dbase))
        (Clight.create_undef_temps (Clight.fn_temps jets_sha.f_simplicity_bitcoin_input_utxo_hash))))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments iu_temps env bd dbase%Z_scope bs sbase%Z_scope
iu_then =
Clight.Ssequence
  (Clight.Ssequence
     (Clight.Sset jets_sha._t'4
        (Clight.Efield
           (Clight.Ederef
              (Clight.Etempvar jets_sha._env (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._txEnv Ctypes.noattr)))
              (Ctypes.Tstruct jets_sha._txEnv Ctypes.noattr)) jets_sha._tx
           (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._bitcoinTransaction Ctypes.noattr))))
     (Clight.Ssequence
        (Clight.Sset jets_sha._t'5
           (Clight.Efield
              (Clight.Ederef
                 (Clight.Etempvar jets_sha._t'4
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._bitcoinTransaction Ctypes.noattr)))
                 (Ctypes.Tstruct jets_sha._bitcoinTransaction Ctypes.noattr)) jets_sha._input
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr))))
        (Clight.Sset jets_sha._txo
           (Clight.Eaddrof
              (Clight.Efield
                 (Clight.Ederef
                    (Clight.Ebinop Cop.Oadd
                       (Clight.Etempvar jets_sha._t'5
                          (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)))
                       (Clight.Etempvar jets_sha._i Ctypesdefs.tulong)
                       (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)))
                    (Ctypes.Tstruct jets_sha._sigInput Ctypes.noattr)) jets_sha._txo
                 (Ctypes.Tstruct jets_sha._sigOutput Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigOutput Ctypes.noattr))))))
  (Clight.Ssequence
     (Clight.Ssequence
        (Clight.Scall (@None AST.ident) (Clight.Evar jets_sha._sha256_init init_ty)
           (@cons Clight.expr
              (Clight.Eaddrof (Clight.Evar jets_sha.__res (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
              (@cons Clight.expr
                 (Clight.Efield
                    (Clight.Evar jets_sha._midstate (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
                    jets_sha._s
                    (Ctypesdefs.tarray Ctypesdefs.tuint
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) (@nil Clight.expr))))
        (Clight.Sassign (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
           (Clight.Evar jets_sha.__res (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))))
     (Clight.Ssequence
        (Clight.Ssequence
           (Clight.Sset jets_sha._t'3
              (Clight.Efield
                 (Clight.Ederef
                    (Clight.Etempvar jets_sha._txo (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigOutput Ctypes.noattr)))
                    (Ctypes.Tstruct jets_sha._sigOutput Ctypes.noattr)) jets_sha._value Ctypesdefs.tulong))
           (Clight.Scall (@None AST.ident)
              (Clight.Evar jets_sha._sha256_u64be
                 (Ctypes.Tfunction
                    (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                       (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
              (@cons Clight.expr
                 (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
                 (@cons Clight.expr (Clight.Etempvar jets_sha._t'3 Ctypesdefs.tulong) (@nil Clight.expr)))))
        (Clight.Ssequence
           (Clight.Scall (@None AST.ident)
              (Clight.Evar jets_sha._sha256_hash
                 (Ctypes.Tfunction
                    (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                       (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
                          Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
              (@cons Clight.expr
                 (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
                 (@cons Clight.expr
                    (Clight.Eaddrof
                       (Clight.Efield
                          (Clight.Ederef
                             (Clight.Etempvar jets_sha._txo
                                (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sigOutput Ctypes.noattr)))
                             (Ctypes.Tstruct jets_sha._sigOutput Ctypes.noattr)) jets_sha._scriptPubKey
                          (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
                       (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)))
                    (@nil Clight.expr))))
           (Clight.Ssequence
              (Clight.Scall (@None AST.ident)
                 (Clight.Evar jets_sha._sha256_finalize
                    (Ctypes.Tfunction
                       (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                          Ctypes.Tnil) Ctypesdefs.tbool AST.cc_default))
                 (@cons Clight.expr
                    (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                       (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
                    (@nil Clight.expr)))
              (Clight.Scall (@None AST.ident)
                 (Clight.Evar jets_sha._writeHash
                    (Ctypes.Tfunction
                       (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
                          (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
                             Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
                 (@cons Clight.expr
                    (Clight.Etempvar jets_sha._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
                    (@cons Clight.expr
                       (Clight.Eaddrof
                          (Clight.Evar jets_sha._midstate (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
                          (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)))
                       (@nil Clight.expr))))))))
     : Clight.statement
iu_else =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_sha._skipBits
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Etempvar jets_sha._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Econst_int
           (Integers.Int.repr
              (BinNums.Zpos
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
           Ctypesdefs.tint) (@nil Clight.expr)))
     : Clight.statement
iu_elem_rep =
fun (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (xv : Integers.Int64.int) (H : Digest.hash256) =>
and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m b ofs) (@Some Values.val (Values.Vlong xv)))
  (uint32_array_at m b (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     (Digest.hash256_reg H))
