read_fe_final_field_numeric
     : forall (m : Memory.Mem.mem) (layout : layout) (bits : list bool) (rc : BinNums.Z) (input_edge : Values.block)
         (edge : Integers.Ptrofs.int)
         (_ : @eq nat (@length bool bits)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : BinInt.Z.le BinNums.Z0 (bas layout O))
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (bas layout O))
         (_ : BinInt.Z.le
                (BinInt.Z.add (bas layout O)
