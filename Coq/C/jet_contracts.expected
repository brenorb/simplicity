word32_chunks =
fix word32_chunks (n : nat) :
    forall _ : Ty.tySem (Word.Word (Nat.add n (S (S (S (S (S O))))))),
    list (Ty.tySem (Word.Word (S (S (S (S (S O))))))) :=
  match
    n as k
    return
      (forall _ : Ty.tySem (Word.Word (Nat.add k (S (S (S (S (S O))))))),
       list (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
  with
  | O =>
      fun x : Ty.tySem (Word.Word (Nat.add O (S (S (S (S (S O))))))) =>
      @cons (Ty.tySem (Word.Word (Nat.add O (S (S (S (S (S O)))))))) x
        (@nil (Ty.tySem (Word.Word (Nat.add O (S (S (S (S (S O)))))))))
  | S k =>
      fun x : Ty.tySem (Word.Word (Nat.add (S k) (S (S (S (S (S O))))))) =>
      @app (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
        (word32_chunks k
           (@fst
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit)
                    ((fix add (n0 m : nat) {struct n0} : nat :=
                        match n0 return nat with
                        | O => m
                        | S p => S (add p m)
                        end) k (S (S (S (S (S O))))))))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit)
                    ((fix add (n0 m : nat) {struct n0} : nat :=
                        match n0 return nat with
                        | O => m
                        | S p => S (add p m)
                        end) k (S (S (S (S (S O)))))))) x))
        (word32_chunks k
           (@snd
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit)
                    ((fix add (n0 m : nat) {struct n0} : nat :=
                        match n0 return nat with
                        | O => m
                        | S p => S (add p m)
                        end) k (S (S (S (S (S O))))))))
              ((fix tySem (X : Ty.Ty) : Set :=
                  match X return Set with
                  | Ty.Unit => unit
                  | Ty.Sum A B => sum (tySem A) (tySem B)
                  | Ty.Prod A B => prod (tySem A) (tySem B)
                  end)
                 ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
                     match n0 return Ty.Ty with
                     | O => X
                     | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
                     end) (Ty.Sum Ty.Unit Ty.Unit)
                    ((fix add (n0 m : nat) {struct n0} : nat :=
                        match n0 return nat with
                        | O => m
                        | S p => S (add p m)
                        end) k (S (S (S (S (S O)))))))) x))
  end
     : forall (n : nat) (_ : Ty.tySem (Word.Word (Nat.add n (S (S (S (S (S O)))))))),
       list (Ty.tySem (Word.Word (S (S (S (S (S O)))))))

Arguments word32_chunks n%nat_scope _
eq256_words_equal =
fix eq256_words_equal (xs ys : list Integers.Int.int) {struct xs} : bool :=
  match xs return bool with
  | nil => match ys return bool with
           | nil => true
           | cons _ _ => false
           end
  | cons x xs0 =>
      match ys return bool with
      | nil => false
      | cons y ys0 => andb (Integers.Int.eq x y) (eq256_words_equal xs0 ys0)
      end
  end
     : forall (_ : list Integers.Int.int) (_ : list Integers.Int.int), bool

Arguments eq256_words_equal (xs ys)%list_scope
eq256_array_result =
fun x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
eq256_words_equal
  (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value
     (word32_chunks (S (S (S O))) x))
  (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value
     (word32_chunks (S (S (S O))) y))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), bool

