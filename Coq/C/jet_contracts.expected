                                 (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr))
                                    (Ctypes.Tcons Ctypesdefs.tuchar Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
                           (@cons Clight.expr
                              (Clight.Etempvar _dst (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr)))
                              (@cons Clight.expr (Clight.Etempvar _output Ctypesdefs.tuchar) (@nil Clight.expr)))))))))
