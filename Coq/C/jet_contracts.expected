@point_encode_pair ?A ?B
     : forall (a : Ty.tySem ?A) (b : Ty.tySem ?B),
       @eq (list Cell) (@encode (Ty.Prod ?A ?B) (@pair (Ty.tySem ?A) (Ty.tySem ?B) a b))
         (@app Cell (@encode ?A a) (@encode ?B b))
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
literal_gej_negate_writer_encoding
     : forall x y z : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Cell)
         (@app Cell
