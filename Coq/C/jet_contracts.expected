         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) sha_core_helpers),
       and
         (@eq (option Values.block)
            (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv sha_ge) id)
            (@Some Values.block (sha_symbol_block id)))
         (@eq (option Clight.fundef)
            (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv sha_ge)
               (Values.Vptr (sha_symbol_block id) Integers.Ptrofs.zero))
            (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))
exec_shx_helper_call
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (optid : option AST.ident) (id : AST.ident) (f : Clight.function)
         (al : list Clight.expr) (tyargs : Ctypes.typelist) (tyres : Ctypes.type) (cc : AST.calling_convention)
         (vargs : list Values.val) (vres : Values.val) (m' : Memory.Mem.mem)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) sha_core_helpers)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
                (@None (prod Values.block Ctypes.type))) (_ : Clight.eval_exprlist sha_ge e le m al tyargs vargs)
         (_ : @eq Ctypes.type (Clight.type_of_fundef (@Ctypes.Internal Clight.function f))
                (Ctypes.Tfunction tyargs tyres cc))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function f) vargs Events.E0 m' vres),
       ClightBigstep.Clight2.exec_stmt sha_ge e le m
         (Clight.Scall optid (Clight.Evar id (Ctypes.Tfunction tyargs tyres cc)) al) Events.E0
         (Clight.set_opttemp optid vres le) m' ClightBigstep.Out_normal
shx_ltu_cmp
     : forall (r nI : Integers.Int64.int) (m : Memory.Mem.mem),
       @eq (option Values.val)
         (Cop.sem_binary_operation (Clight.genv_cenv sha_ge) Cop.Olt (Values.Vlong r) Ctypesdefs.tulong
            (Values.Vlong nI) Ctypesdefs.tulong m) (@Some Values.val (Values.Val.of_bool (Integers.Int64.ltu r nI)))
shx_bool_cast
     : forall (b : bool) (m : Memory.Mem.mem),
       @eq (option Values.val) (Cop.sem_cast (Values.Val.of_bool b) Ctypesdefs.tint Ctypesdefs.tbool m)
         (@Some Values.val
            (Values.Vint
               match b return Integers.Int.int with
               | true => Integers.Int.one
               | false => Integers.Int.zero
               end))
exec_shx_indexed_rest
     : forall (tp cp : AST.ident)
         (_ : and (not (@eq AST.ident tp jets_sha._env))
                (and (not (@eq AST.ident tp jets_sha._dst))
                   (and (not (@eq AST.ident tp jets_sha._i))
                      (and (not (@eq AST.ident tp jets_sha._t'1))
                         (and (not (@eq AST.ident tp jets_sha._t'2)) (not (@eq AST.ident tp cp)))))))
         (_ : and (not (@eq AST.ident cp jets_sha._env))
                (and (not (@eq AST.ident cp jets_sha._dst))
                   (and (not (@eq AST.ident cp jets_sha._i))
                      (and (not (@eq AST.ident cp jets_sha._t'1)) (not (@eq AST.ident cp jets_sha._t'2))))))
         (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le0 : Maps.PTree.tree Values.val)
         (countfield : AST.ident) (cdelta : BinNums.Z) (then_s else_s : Clight.statement) (mc mr mb : Memory.Mem.mem)
         (be : Values.block) (ebase : BinNums.Z) (bt : Values.block) (txbase : BinNums.Z) (bl bd : Values.block)
         (dbase : BinNums.Z) (r nI : Integers.Int64.int) (Post : forall _ : Memory.Mem.mem, Prop)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._simplicity_read32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._writeBit e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._src e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bl (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._env le0)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._dst le0)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge mc (@Ctypes.Internal Clight.function f_simplicity_read32)
                (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val)) Events.E0 mr
                (Values.Vlong r)) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.le BinNums.Z0 txbase) (_ : BinInt.Z.le BinNums.Z0 cdelta)
         (_ : BinInt.Z.le
                (BinInt.Z.add (BinInt.Z.add txbase cdelta)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Integers.Ptrofs.max_unsigned)
         (_ : shx_field_at jets_sha._bitcoinTransaction countfield cdelta)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr mr be (BinInt.Z.add ebase BinNums.Z0))
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 mr bt (BinInt.Z.add txbase cdelta))
                (@Some Values.val (Values.Vlong nI)))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge mr (@Ctypes.Internal Clight.function f_writeBit)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val
                      (Values.Vint
                         match Integers.Int64.ltu r nI return Integers.Int.int with
                         | true => Integers.Int.one
                         | false => Integers.Int.zero
                         end) (@nil Values.val))) Events.E0 mb
                (Values.Vint
                   match Integers.Int64.ltu r nI return Integers.Int.int with
                   | true => Integers.Int.one
                   | false => Integers.Int.zero
                   end))
         (_ : forall (le' : Maps.PTree.tree Values.val)
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._i le')
                       (@Some Values.val (Values.Vlong r)))
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._dst le')
                       (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._env le')
                       (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase))))
                (_ : @eq bool (Integers.Int64.ltu r nI) true),
              @ex Clight.temp_env
                (fun le'' : Clight.temp_env =>
                 @ex Memory.Mem.mem
                   (fun me : Memory.Mem.mem =>
                    and
                      (ClightBigstep.Clight2.exec_stmt sha_ge e le' mb then_s Events.E0 le'' me
                         ClightBigstep.Out_normal) (Post me))))
         (_ : forall (le' : Maps.PTree.tree Values.val)
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._i le')
                       (@Some Values.val (Values.Vlong r)))
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._dst le')
                       (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
                (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._env le')
                       (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase))))
                (_ : @eq bool (Integers.Int64.ltu r nI) false),
              @ex Clight.temp_env
                (fun le'' : Clight.temp_env =>
                 @ex Memory.Mem.mem
                   (fun me : Memory.Mem.mem =>
                    and
                      (ClightBigstep.Clight2.exec_stmt sha_ge e le' mb else_s Events.E0 le'' me
                         ClightBigstep.Out_normal) (Post me)))),
       @ex Clight.temp_env
         (fun le1 : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun me : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt sha_ge e le0 mc (shx_indexed_rest tp cp countfield then_s else_s)
                  Events.E0 le1 me shx_returned_one) (Post me)))
@init_map_eq_in ?A ?B
     : forall (F G : forall _ : ?A, ?B) (l : list ?A) (_ : @eq (list ?B) (@List.map ?A ?B F l) (@List.map ?A ?B G l))
         (x : ?A) (_ : @List.In ?A x l), @eq ?B (F x) (G x)
where
?A : [ |- Type]
?B : [ |- Type]
init_helper_lookup_core
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef) (init_helper_lookup ge0) sha_init_helpers)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun p : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) sha_init_helpers)
init_helper_lookup_sha
     : @eq (list (option Clight.fundef))
         (@List.map (prod AST.ident Clight.function) (option Clight.fundef) (init_helper_lookup sha_ge)
            sha_init_helpers)
         (@List.map (prod AST.ident Clight.function) (option (Ctypes.fundef Clight.function))
            (fun p : prod AST.ident Clight.function =>
             @Some (Ctypes.fundef Clight.function)
               (@Ctypes.Internal Clight.function (@snd AST.ident Clight.function p))) sha_init_helpers)
init_helper_lookup_exists
     : forall (ge : Clight.genv) (id : AST.ident) (f : Clight.function)
         (_ : @eq (option Clight.fundef) (init_helper_lookup ge (@pair AST.ident Clight.function id f))
                (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))),
       @ex Values.block
         (fun b : Values.block =>
          and
            (@eq (option Values.block)
               (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
               (@Some Values.block b))
            (@eq (option Clight.fundef)
               (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
               (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f))))
sha_init_helpers_entries
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) sha_init_helpers),
       @ex Values.block
         (fun b1 : Values.block =>
          @ex Values.block
            (fun b2 : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge0) id)
                  (@Some Values.block b1))
               (and
                  (@eq (option Clight.fundef)
                     (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge0) b1)
                     (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))
                  (and
                     (@eq (option Values.block)
                        (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv sha_ge) id)
                        (@Some Values.block b2))
                     (@eq (option Clight.fundef)
                        (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv sha_ge) b2)
                        (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f)))))))
init_helpers_okb_true
     : @eq bool init_helpers_okb true
sha_init_helpers_ok
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) sha_init_helpers),
       @eq bool
         (jet_transport.fundef_okb ge0 sha_ge
            (@List.map (prod AST.ident Clight.function) AST.ident (@fst AST.ident Clight.function) sha_init_helpers)
            (@Ctypes.Internal Clight.function f)) true
init_sha_transport_call
     : forall (id : AST.ident) (f : Clight.function)
         (_ : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function id f) sha_init_helpers)
         (m : Memory.Mem.mem) (args : list Values.val) (t : Events.trace) (m' : Memory.Mem.mem)
         (res : Values.val)
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f) args t m' res),
       ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function f) args t m' res
@jet_sha_interp.upd_length ?A
     : forall (l : list ?A) (i : nat) (v : ?A), @eq nat (@length ?A (@jet_sha_interp.upd ?A l i v)) (@length ?A l)
where
?A : [ |- Type]
@nth_upd_same ?A
     : forall (l : list ?A) (i : nat) (v d : ?A) (_ : lt i (@length ?A l)),
       @eq ?A (@List.nth ?A i (@jet_sha_interp.upd ?A l i v) d) v
where
?A : [ |- Type]
@nth_upd_other ?A
     : forall (l : list ?A) (i j : nat) (v d : ?A) (_ : not (@eq nat i j)),
       @eq ?A (@List.nth ?A j (@jet_sha_interp.upd ?A l i v) d) (@List.nth ?A j l d)
where
?A : [ |- Type]
index_of_nth
     : forall (x : AST.ident) (l : list AST.ident) (i : nat) (_ : @eq (option nat) (index_of x l) (@Some nat i)),
       @eq (option AST.ident) (@List.nth_error AST.ident l i) (@Some AST.ident x)
index_of_lt
     : forall (x : AST.ident) (l : list AST.ident) (i : nat) (_ : @eq (option nat) (index_of x l) (@Some nat i)),
       lt i (@length AST.ident l)
index_of_none
     : forall (x : AST.ident) (l : list AST.ident) (_ : @eq (option nat) (index_of x l) (@None nat)),
       not (@List.In AST.ident x l)
@nth_error_inj_nodup ?A
     : forall (l : list ?A) (i j : nat) (x : ?A) (_ : @List.NoDup ?A l)
         (_ : @eq (option ?A) (@List.nth_error ?A l i) (@Some ?A x))
         (_ : @eq (option ?A) (@List.nth_error ?A l j) (@Some ?A x)), @eq nat i j
where
?A : [ |- Type]
wids_nodup
     : @List.NoDup AST.ident wids
lids_nodup
     : @List.NoDup AST.ident lids
attr_noattrb_true
     : forall (a : Ctypes.attr) (_ : @eq bool (attr_noattrb a) true), @eq Ctypes.attr a Ctypes.noattr
is_tuint_true
     : forall (ty : Ctypes.type) (_ : @eq bool (is_tuint ty) true), @eq Ctypes.type ty Ctypesdefs.tuint
is_tint_true
     : forall (ty : Ctypes.type) (_ : @eq bool (is_tint ty) true), @eq Ctypes.type ty Ctypesdefs.tint
is_ptuint_true
     : forall (ty : Ctypes.type) (_ : @eq bool (is_ptuint ty) true),
       @eq Ctypes.type ty (Ctypesdefs.tptr Ctypesdefs.tuint)
is_cc_default_true
     : forall (cc : AST.calling_convention) (_ : @eq bool (is_cc_default cc) true),
       @eq AST.calling_convention cc AST.cc_default
is_sigma_ty_true
     : forall (ty : Ctypes.type) (_ : @eq bool (is_sigma_ty ty) true), @eq Ctypes.type ty sigma_ty
is_round_ty_true
     : forall (ty : Ctypes.type) (_ : @eq bool (is_round_ty ty) true), @eq Ctypes.type ty round_ty
arr_expr_inv
     : forall (a : Clight.expr) (p : AST.ident) (i : Integers.Int.int)
         (_ : @eq (option (prod AST.ident Integers.Int.int)) (arr_expr a)
                (@Some (prod AST.ident Integers.Int.int) (@pair AST.ident Integers.Int.int p i))),
       @eq Clight.expr a
         (Clight.Ebinop Cop.Oadd (Clight.Etempvar p (Ctypesdefs.tptr Ctypesdefs.tuint))
            (Clight.Econst_int i Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tuint))
addr_local_inv
     : forall (e : Clight.expr) (i : nat) (_ : @eq (option nat) (addr_local e) (@Some nat i)),
       @ex AST.ident
         (fun x : AST.ident =>
          and (@eq Clight.expr e (Clight.Eaddrof (Clight.Evar x Ctypesdefs.tuint) (Ctypesdefs.tptr Ctypesdefs.tuint)))
            (@eq (option nat) (index_of x lids) (@Some nat i)))
arr_ofs
     : forall (base : Integers.Ptrofs.int) (i : Integers.Int.int) (k : nat)
         (_ : @eq nat k (BinInt.Z.to_nat (Integers.Int.unsigned i)))
         (_ : lt k (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S O)))))))))))))))))
         (_ : BinInt.Z.le
                (BinInt.Z.add
                   (BinInt.Z.add (Integers.Ptrofs.unsigned base)
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat k)))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))) Integers.Ptrofs.max_unsigned),
       @eq BinNums.Z
         (Integers.Ptrofs.unsigned
            (Integers.Ptrofs.add base
               (Integers.Ptrofs.mul (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                  (Integers.Ptrofs.of_ints i))))
         (BinInt.Z.add (Integers.Ptrofs.unsigned base)
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat k)))
sha_F_refl
     : forall (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int) (m : Memory.Mem.mem),
       sha_F lb bs os m m
sha_F_trans
     : forall (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int) (m1 m2 m3 : Memory.Mem.mem)
         (_ : sha_F lb bs os m1 m2) (_ : sha_F lb bs os m2 m3), sha_F lb bs os m1 m3
lb_nth
     : forall (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int) (bc : Values.block)
         (oc : Integers.Ptrofs.int) (_ : @eq nat (@length Values.block lb) (S (S (S (S (S (S (S (S O)))))))))
         (_ : or (not (@eq Values.block bs bc))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (Integers.Ptrofs.unsigned oc))
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (Integers.Ptrofs.unsigned os)))) (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
       @ex Values.block
         (fun b : Values.block => @eq (option Values.block) (@List.nth_error Values.block lb i) (@Some Values.block b))
lb_in
     : forall (lb : list Values.block) (i : nat) (b : Values.block)
         (_ : @eq (option Values.block) (@List.nth_error Values.block lb i) (@Some Values.block b)),
       @List.In Values.block b lb
eval_ie_sound
     : forall (env : Clight.env) (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int)
         (bc : Values.block) (oc : Integers.Ptrofs.int)
         (_ : @eq nat (@length Values.block lb) (S (S (S (S (S (S (S (S O)))))))))
         (_ : forall (i : nat) (x : AST.ident) (b : Values.block)
                (_ : @eq (option AST.ident) (@List.nth_error AST.ident lids i) (@Some AST.ident x))
                (_ : @eq (option Values.block) (@List.nth_error Values.block lb i) (@Some Values.block b)),
              @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) x env)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type b Ctypesdefs.tuint)))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : or (not (@eq Values.block bs bc))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (Integers.Ptrofs.unsigned oc))
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (Integers.Ptrofs.unsigned os)))) (st : cst) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (e : Clight.expr) (v : Integers.Int.int) (_ : sha_R lb bs os bc oc st le m)
         (_ : @eq (option Integers.Int.int) (eval_ie st e) (@Some Integers.Int.int v)),
       and (Clight.eval_expr sha_ge env le m e (Values.Vint v)) (@eq Ctypes.type (Clight.typeof e) Ctypesdefs.tuint)
set_temp_sound
     : forall (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int) (bc : Values.block)
         (oc : Integers.Ptrofs.int) (_ : @eq nat (@length Values.block lb) (S (S (S (S (S (S (S (S O)))))))))
         (_ : or (not (@eq Values.block bs bc))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (Integers.Ptrofs.unsigned oc))
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
