Arguments division_normalized_result n%nat_scope rec
division_word_spec =
fun (n : nat) (remainder : bool) (term : Alg.Core.Algebra) =>
match
  remainder
  return
    (Alg.Core.domain term (Word.Word (S n))
       ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
           match n0 return Ty.Ty with
           | O => X
           | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
           end) (Ty.Sum Ty.Unit Ty.Unit) n))
with
| true => @modulo_word_spec n term
| false => @divide_word_spec n term
end
     : forall (n : nat) (_ : bool) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Word.Word (S n))
         ((fix Vector (X : Ty.Ty) (n0 : nat) {struct n0} : Ty.Ty :=
             match n0 return Ty.Ty with
             | O => X
             | S n1 => Ty.Prod (Vector X n1) (Vector X n1)
             end) (Ty.Sum Ty.Unit Ty.Unit) n)

Arguments division_word_spec n%nat_scope remainder%bool_scope {term}
division8_guarantees =
fun remainder : bool =>
jet_local_spec_guarantees (division8 remainder) (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))
  (Word.Word (S (S (S O))))
  (fun xy : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) =>
   @division_word_spec (S (S (S O))) remainder Alg.CoreFunSem xy) (division8_local_spec remainder)
     : forall (remainder : bool) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add read_cursor
                   (BinInt.Z.of_nat (bitSize (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor
                (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (division8 remainder))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S O))))
                     ((fun xy : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) =>
