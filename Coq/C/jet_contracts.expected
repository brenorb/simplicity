       @eq (list event) (slog (@fst sstate xout (rsel rho layout (write_fe_result bd base))))
         match truth rho layout (write_fe_condition bd base) return (list event) with
         | true => @cons event (write_fe_true_event bd base) (@nil event)
         | false => @cons event (write_fe_false_event bd base) (@nil event)
         end
