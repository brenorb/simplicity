                     (BinInt.Z.add (bas layout O) (BinInt.Z.of_nat i)))
                  (@Some Values.val (Values.Vint (Integers.Int.repr byte))))
               (and (rep (scalar_limb_rho value) layout (sregs scalar_get_state) mf)
                  (lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (foot layout
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              scalar_get_regs) b ofs)) m mf))))
