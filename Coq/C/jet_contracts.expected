fun field : AST.ident =>
Clight.Ssequence
  (Clight.Sassign (Clight.Evar jets_bitcoin._src (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
     (Clight.Etempvar jets_bitcoin._src (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
  (Clight.Ssequence
     (Clight.Ssequence
        (Clight.Sset jets_bitcoin._t'1
           (Clight.Efield
              (Clight.Ederef
                 (Clight.Etempvar jets_bitcoin._env
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._txEnv Ctypes.noattr)))
                 (Ctypes.Tstruct jets_bitcoin._txEnv Ctypes.noattr)) jets_bitcoin._tx
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr))))
        (Clight.Ssequence
           (Clight.Sset jets_bitcoin._t'2
              (Clight.Efield
                 (Clight.Ederef
                    (Clight.Etempvar jets_bitcoin._t'1
                       (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
                    (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) field Ctypesdefs.tulong))
           (Clight.Scall (@None AST.ident)
              (Clight.Evar jets_bitcoin._simplicity_write32
                 (Ctypes.Tfunction
                    (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
                       (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tvoid AST.cc_default))
              (@cons Clight.expr
                 (Clight.Etempvar jets_bitcoin._dst
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
                 (@cons Clight.expr (Clight.Etempvar jets_bitcoin._t'2 Ctypesdefs.tulong) (@nil Clight.expr))))))
     (Clight.Sreturn
        (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint))))
     : forall _ : AST.ident, Clight.statement

