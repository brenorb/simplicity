wide_prefix_post =
fun (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (bw : Values.block) (outedge cursor n : BinNums.Z)
=>
let ds : BinNums.Z :=
  BinInt.Z.modulo cursor
    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) in
let k0 : BinNums.Z :=
  BinInt.Z.div rc
    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) in
let cq : BinNums.Z :=
  BinInt.Z.div cursor
    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) in
let C : BinNums.Z := BinInt.Z.add (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) rc in
let dA : BinNums.Z := BinInt.Z.sub cq (BinNums.Zpos BinNums.xH) in
let wwa : BinNums.Z := jet_write_layout.write_word_address outedge cursor in
fun (le1 : Clight.temp_env) (m1 : Memory.Mem.mem) (so1 do1 : Integers.Ptrofs.int) (k1 ss1 : BinNums.Z) =>
and (@eq (option Values.val) (@Maps.PTree.get Values.val _src_ptr le1) (@Some Values.val (Values.Vptr bi so1)))
  (and (@eq (option Values.val) (@Maps.PTree.get Values.val _dst_ptr le1) (@Some Values.val (Values.Vptr bw do1)))
     (and
        (@eq (option Values.val) (@Maps.PTree.get Values.val _src_shift le1)
           (@Some Values.val (Values.Vlong (Integers.Int64.repr ss1))))
        (and
           (@eq (option Values.val) (@Maps.PTree.get Values.val _n le1)
              (@Some Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.sub n ds)))))
           (and
              (@eq BinNums.Z (Integers.Ptrofs.unsigned so1)
                 (BinInt.Z.sub edge
                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                       (BinInt.Z.add (BinNums.Zpos BinNums.xH) k1))))
              (and
                 (@eq BinNums.Z (Integers.Ptrofs.unsigned do1)
                    (BinInt.Z.add outedge
                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) dA)))
                 (and
                    (and (BinInt.Z.le BinNums.Z0 ss1)
                       (BinInt.Z.le ss1
                          (BinNums.Zpos
                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                    (and (BinInt.Z.le k0 k1)
                       (and
                          (@eq BinNums.Z (BinInt.Z.add rc ds)
                             (BinInt.Z.sub
                                (BinInt.Z.add
                                   (BinInt.Z.mul
                                      (BinNums.Zpos
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))) k1)
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                ss1))
                          (and (copied m m1 bi edge bw outedge C (BinInt.Z.sub cursor ds) cursor)
                             (and
                                (forall (old : Integers.Int64.int)
                                   (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw wwa)
                                          (@Some Values.val (Values.Vlong old))),
                                 @ex Integers.Int64.int
                                   (fun W : Integers.Int64.int =>
                                    and
                                      (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m1 bw wwa)
                                         (@Some Values.val (Values.Vlong W)))
                                      (forall (i : BinNums.Z)
                                         (_ : and (BinInt.Z.le (jet_write_layout.write_word_shift cursor) i)
                                                (BinInt.Z.lt i (BinNums.Zpos (BinNums.xO ...)))),
                                       @eq bool (Integers.Int64.testbit W i) (Integers.Int64.testbit old i))))
                                (and
                                   (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                      (_ : or (not (@eq Values.block b bw))
                                             (or
                                                (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                   (BinInt.Z.add outedge
                                                      (BinInt.Z.mul (BinNums.Zpos ...) (BinInt.Z.add dA ...))))
                                                (BinInt.Z.le (BinInt.Z.add wwa (BinNums.Zpos (BinNums.xO ...))) ofs))),
                                    @eq (option Values.val) (Memory.Mem.load chunk m1 b ofs)
                                      (Memory.Mem.load chunk m b ofs))
                                   (and
                                      (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                         (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                       Memory.Mem.perm m1 b ofs kind p)
                                      (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                       Memory.Mem.valid_block m1 b)))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Values.block)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Clight.temp_env) (_ : Memory.Mem.mem)
         (_ : Integers.Ptrofs.int) (_ : Integers.Ptrofs.int) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments wide_prefix_post m bi (edge rc)%Z_scope bw (outedge cursor n)%Z_scope le1 m1 so1 do1 (k1 ss1)%Z_scope
copy_mcpy_env2 =
fun le : Maps.PTree.tree Values.val =>
@Maps.PTree.set Values.val _m (Values.Vlong (Integers.Int64.repr (BinNums.Zpos (BinNums.xO BinNums.xH)))) le
     : forall _ : Maps.PTree.tree Values.val, Maps.PTree.tree Values.val

Arguments copy_mcpy_env2 le
copied =
fun (m0 mf : Memory.Mem.mem) (bi : Values.block) (edge : BinNums.Z) (bw : Values.block) (outedge C lo hi : BinNums.Z)
=>
forall (p : BinNums.Z) (b : bool) (_ : and (BinInt.Z.le lo p) (BinInt.Z.lt p hi))
  (_ : frame_input_bit_at m0 bi edge (BinInt.Z.sub C p) b), frame_output_bit_at mf bw outedge p b
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments copied m0 mf bi edge%Z_scope bw (outedge C lo hi)%Z_scope
copy_loop_next_env =
fun (le : Maps.PTree.tree Values.val) (bi : Values.block) (src_ofs : Integers.Ptrofs.int) (bw : Values.block)
  (dst_ofs : Integers.Ptrofs.int) (n : BinNums.Z) =>
@Maps.PTree.set Values.val _src_ptr
  (Values.Vptr bi
     (Integers.Ptrofs.sub src_ofs
        (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  (@Maps.PTree.set Values.val _dst_ptr
     (Values.Vptr bw
        (Integers.Ptrofs.sub dst_ofs
           (Integers.Ptrofs.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     (@Maps.PTree.set Values.val _n
        (Values.Vlong
           (Integers.Int64.repr
              (BinInt.Z.sub n
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
        le))
     : forall (_ : Maps.PTree.tree Values.val) (_ : Values.block) (_ : Integers.Ptrofs.int)
         (_ : Values.block) (_ : Integers.Ptrofs.int) (_ : BinNums.Z), Maps.PTree.tree Values.val

Arguments copy_loop_next_env le bi src_ofs bw dst_ofs n%Z_scope
wide_tail_post =
fun (m0 m1 : Memory.Mem.mem) (bi : Values.block) (edge : BinNums.Z) (bw : Values.block) (outedge C dA n1 : BinNums.Z)
  (_ : Clight.temp_env) (mf : Memory.Mem.mem) (out : ClightBigstep.outcome) =>
and
  (or (@eq ClightBigstep.outcome out ClightBigstep.Out_normal)
     (@eq ClightBigstep.outcome out (ClightBigstep.Out_return (@None (prod Values.val Ctypes.type)))))
  (and
     (copied m0 mf bi edge bw outedge C
        (BinInt.Z.sub
           (BinInt.Z.mul
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
              (BinInt.Z.add dA (BinNums.Zpos BinNums.xH))) n1)
        (BinInt.Z.mul
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
           (BinInt.Z.add dA (BinNums.Zpos BinNums.xH))))
     (and
        (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
           (_ : or (not (@eq Values.block b bw))
                  (or
                     (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                        (BinInt.Z.add outedge
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.div
                                 (BinInt.Z.sub
                                    (BinInt.Z.mul
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                       (BinInt.Z.add dA (BinNums.Zpos BinNums.xH))) n1)
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                     (BinInt.Z.le
                        (BinInt.Z.add outedge
                           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                              (BinInt.Z.add dA (BinNums.Zpos BinNums.xH)))) ofs))),
         @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m1 b ofs))
        (and
           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
              (_ : Memory.Mem.perm m1 b ofs kind p), Memory.Mem.perm mf b ofs kind p)
           (forall (b : Values.block) (_ : Memory.Mem.valid_block m1 b), Memory.Mem.valid_block mf b))))
     : forall (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : Clight.temp_env) (_ : Memory.Mem.mem) (_ : ClightBigstep.outcome), Prop

Arguments wide_tail_post m0 m1 bi edge%Z_scope bw (outedge C dA n1)%Z_scope le' mf out
bits_val =
fix bits_val (l : list bool) : BinNums.Z :=
  match l return BinNums.Z with
  | nil => BinNums.Z0
  | cons b t =>
      BinInt.Z.add
        match b return BinNums.Z with
        | true => BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat (@length bool t))
        | false => BinNums.Z0
        end (bits_val t)
  end
     : forall _ : list bool, BinNums.Z

Arguments bits_val l%list_scope
ifield =
fun (ibits : list bool) (k n : nat) => bits_val (@List.firstn bool n (@List.skipn bool k ibits))
     : forall (_ : list bool) (_ : nat) (_ : nat), BinNums.Z

Arguments ifield ibits%list_scope (k n)%nat_scope
fext =
fun (m0 : Memory.Mem.mem) (bd bw bi b : Values.block) =>
and (or (@eq Values.block b bd) (or (@eq Values.block b bw) (@eq Values.block b bi))) (Memory.Mem.valid_block m0 b)
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block) (_ : Values.block), Prop

Arguments fext m0 bd bw bi b
eqext =
fun (m0 : Memory.Mem.mem) (bd bw bi : Values.block) (m m' : Memory.Mem.mem) =>
lframe (fun (b : Values.block) (_ : BinNums.Z) => fext m0 bd bw bi b) m m'
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments eqext m0 bd bw bi m m'
weffE =
fun (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (outedge cursor : BinNums.Z)
  (bi : Values.block) (m : Memory.Mem.mem) (n : BinNums.Z) (cells : list Cell) =>
and (frame_output_cells_at m bw outedge cursor cells)
  (and (write_prefix_at m0 m bw outedge cursor)
     (and (frame_fields_at m bd dbase bw outedge (BinInt.Z.sub cursor n))
        (and
           (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : fext m0 bd bw bi b)
              (_ : or (not (@eq Values.block b bd))
                     (or
                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                           (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (BinInt.Z.le
                           (BinInt.Z.add dbase
