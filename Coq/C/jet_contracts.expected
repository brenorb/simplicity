affine_negate_run =
fun k : affine_coordinate =>
xfun (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type))) (int_table secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_negate (affine_negate_args k) (affine_initial_regs k) (@nil event)
  (S (S (S (S (S (S O))))))
     : forall _ : affine_coordinate, option res

