               (Integers.Int64.unsigned (write_fe_rho v rc (S (S O))))
               (Integers.Int64.unsigned (write_fe_rho v rc (S (S (S O)))))
               (Integers.Int64.unsigned (write_fe_rho v rc (S (S (S (S O))))))
               (Integers.Int64.unsigned (write_fe_rho v rc (S (S (S (S (S O)))))))) v)
eval_negate_write_after_read_field
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z)
         (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (mr : Memory.Mem.mem)
         (ba bl : Values.block) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : fe_at mr ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_fe_normalize Alg.CoreFunSem value)))))
         (_ : Memory.Mem.range_perm mr ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm mr bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : not (@eq Values.block ba bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                (read_fe_log bi (Integers.Ptrofs.repr edge)) mr),
       @ex Memory.Mem.mem
         (fun mn : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mw : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge mr
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_negate)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vint Integers.Int.one) (@nil Values.val)))) Events.E0 mn
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall secp_ge mn
                     (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                        (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mw
                     Values.Vundef)
                  (and
                     (finv m0 bd dbase bw outedge cursor N bi mw true
                        (@encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_fe_negate Alg.CoreFunSem value)))
                     (and
                        (Memory.Mem.range_perm mw ba BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mw bl BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                              Memtype.Freeable)
                           (lframe
                              (frame (extA m0 bd bw bi)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                    (@nil (prod Values.block BinNums.Z))) local_write_initial_regs mr) mr mw)))))))
