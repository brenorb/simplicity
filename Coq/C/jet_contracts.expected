         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) fid e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_bitcoin._simplicity_write32 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._env le)
                (@Some Values.val (Values.Vptr be (Integers.Ptrofs.repr ebase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_bitcoin._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase)))) (_ : BinInt.Z.le BinNums.Z0 ebase)
         (_ : BinInt.Z.le (BinInt.Z.add ebase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr mc be ebase)
                (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase))))
         (_ : ClightBigstep.Clight2.eval_funcall bitcoin_ge mc (@Ctypes.Internal Clight.function f)
                (@cons Values.val (Values.Vptr bt (Integers.Ptrofs.repr tbase)) (@nil Values.val)) Events.E0 mc
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall bitcoin_ge mc (@Ctypes.Internal Clight.function f_simplicity_write32)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong r) (@nil Values.val))) Events.E0 me Values.Vundef),
       ClightBigstep.Clight2.exec_stmt bitcoin_ge e le mc (bitcoin_lock_mid fid) Events.E0
         (@Maps.PTree.set Values.val jets_bitcoin._t'1 (Values.Vlong r)
