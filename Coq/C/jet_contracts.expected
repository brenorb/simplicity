ctx8_addn_spec_parametric
     : forall n : nat,
       @Alg.Assertion.Parametric (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n)) sha256_ctx8_type
         (@ctx8_addn_spec n)
ctx8_add_list_app
     : forall (c : Ty.tySem sha256_ctx8_type) (l1 l2 : list (Ty.tySem (Word.Word (S (S (S O)))))),
       @eq (option (Ty.tySem sha256_ctx8_type)) (ctx8_add_list c (@app (Ty.tySem (Word.Word (S (S (S O))))) l1 l2))
         match ctx8_add_list c l1 return (option (Ty.tySem sha256_ctx8_type)) with
         | Some c' => ctx8_add_list c' l2
         | None => @None (Ty.tySem sha256_ctx8_type)
         end
ctx8_addn_option
     : forall (n : nat) (c : Ty.tySem sha256_ctx8_type) (v : Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) n)),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem sha256_ctx8_type))
         (@ctx8_addn_spec n (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair (Ty.tySem sha256_ctx8_type) (Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) n)) c v))
         (ctx8_add_list c (vector_values (Word.Word (S (S (S O)))) n v))
ctx_abs_fst
     : forall (A B : Type) (a : A) (b : B), @eq A (@fst A B (@pair A B a b)) a
ctx_abs_snd
     : forall (A B : Type) (a : A) (b : B), @eq B (@snd A B (@pair A B a b)) b
absorb_i_fst
     : forall (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (bs : list (Ty.tySem (Word.Word (S (S (S O)))))),
       @eq (list Integers.Int.int)
         (@fst (list Integers.Int.int) (list Integers.Int.int)
            (absorb_i (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value l) regs
               (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value bs)))
         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value
            (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb l regs bs)))
absorb_i_snd
     : forall (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (bs : list (Ty.tySem (Word.Word (S (S (S O)))))),
       @eq (list Integers.Int.int)
         (@snd (list Integers.Int.int) (list Integers.Int.int)
            (absorb_i (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value l) regs
               (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value bs)))
         (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb l regs bs))
absorb_app
     : forall (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (bs1 bs2 : list (Ty.tySem (Word.Word (S (S (S O)))))),
       @eq (prod (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int))
         (absorb (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb l regs bs1))
            (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb l regs bs1)) bs2)
         (absorb l regs (@app (Ty.tySem (Word.Word (S (S (S O))))) bs1 bs2))
counter_mod_add
     : forall (c : Integers.Int64.int) (n len : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 n) (BinInt.Z.le n Integers.Int64.max_unsigned))
         (_ : @eq BinNums.Z
                (BinInt.Z.modulo (Integers.Int64.unsigned c)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) len),
       @eq BinNums.Z
         (BinInt.Z.modulo (Integers.Int64.unsigned (Integers.Int64.add c (Integers.Int64.repr n)))
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (BinInt.Z.modulo (BinInt.Z.add len n)
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
ctx_abs_frame
     : forall (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bm))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bm)) (m m' : Memory.Mem.mem)
         (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int) (c : Integers.Int64.int)
         (ovf : bool) (_ : ctx_abs m bx bm l regs c ovf)
         (_ : forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
              @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
         (_ : forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm m' b ofs k p),
       and
         (Memory.Mem.range_perm m' bx BinNums.Z0
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
            Memtype.Cur Memtype.Freeable)
         (and
            (Memory.Mem.range_perm m' bm BinNums.Z0
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
               Memtype.Freeable)
            (and (sha_dispatch_ok m')
               (@eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 m' (sha_symbol_block jets_sha._sha256_max_counter) BinNums.Z0)
                  (@Some Values.val (Values.Vlong sha_max_counter)))))
ctx_abs_uchars
     : forall (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bm))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bm)) (_ : memcpy_model)
         (m : Memory.Mem.mem) (ba : Values.block) (oa : Integers.Ptrofs.int)
         (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (bs : list (Ty.tySem (Word.Word (S (S (S O)))))) (c : Integers.Int64.int) (ovf : bool)
         (_ : ctx_abs m bx bm l regs c ovf) (_ : not (@eq Values.block ba bx)) (_ : not (@eq Values.block ba bm))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oa)
                   (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) bs))) Integers.Ptrofs.max_unsigned)
         (_ : forall (i : nat)
                (_ : lt i
                       (@length Integers.Int.int
                          (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value bs))),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m ba
                   (BinInt.Z.add (Integers.Ptrofs.unsigned oa) (BinInt.Z.of_nat i)))
                (@Some Values.val
                   (Values.Vint
                      (@List.nth Integers.Int.int i
                         (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value bs)
                         Integers.Int.zero)))),
       let vn : Integers.Int64.int :=
         Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) bs)) in
       let ovf' : bool := uc_overflow ovf c vn in
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_sha256_uchars)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr BinNums.Z0))
                  (@cons Values.val (Values.Vptr ba oa) (@cons Values.val (Values.Vlong vn) (@nil Values.val))))
               Events.E0 m' (Values.Vint (bit_int (negb ovf'))))
            (and
               (ctx_abs m' bx bm
                  (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb l regs bs))
                  (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb l regs bs))
                  (Integers.Int64.add c vn) ovf')
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
ctx_abs_uchar
     : forall (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bm))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bm)) (_ : memcpy_model)
         (m : Memory.Mem.mem) (l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (x : Ty.tySem (Word.Word (S (S (S O))))) (c : Integers.Int64.int) (ovf : bool)
         (_ : ctx_abs m bx bm l regs c ovf),
       let vn : Integers.Int64.int := Integers.Int64.repr (BinNums.Zpos BinNums.xH) in
       let ovf' : bool := uc_overflow ovf c vn in
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_sha256_uchar)
               (@cons Values.val (Values.Vptr bx (Integers.Ptrofs.repr BinNums.Z0))
                  (@cons Values.val (Values.Vint (word8_array_value x)) (@nil Values.val))) Events.E0 m'
               (Values.Vint (bit_int (negb ovf'))))
            (and
               (ctx_abs m' bx bm
                  (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                     (absorb l regs
                        (@cons (Ty.tySem (Word.Word (S (S (S O))))) x (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
                  (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                     (absorb l regs
                        (@cons (Ty.tySem (Word.Word (S (S (S O))))) x (@nil (Ty.tySem (Word.Word (S (S (S O)))))))))
                  (Integers.Int64.add c vn) ovf')
               (and
                  (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                     (_ : not (@eq Values.block b bx)) (_ : not (@eq Values.block b bm)),
                   @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                        (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs k p),
                      Memory.Mem.perm m' b ofs k p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block m' b)))))
absorb_i_cons
     : forall (l regs : list Integers.Int.int) (x : Integers.Int.int) (bs : list Integers.Int.int),
       @eq (prod (list Integers.Int.int) (list Integers.Int.int)) (absorb_i l regs (@cons Integers.Int.int x bs))
         (absorb_i
            (@fst (list Integers.Int.int) (list Integers.Int.int)
               (absorb_step_i (@pair (list Integers.Int.int) (list Integers.Int.int) l regs) x))
            (@snd (list Integers.Int.int) (list Integers.Int.int)
               (absorb_step_i (@pair (list Integers.Int.int) (list Integers.Int.int) l regs) x)) bs)
absorb_i_len
     : forall (bs l regs : list Integers.Int.int)
         (_ : lt (@length Integers.Int.int l)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O))))))))),
       and
         (@eq BinNums.Z
            (BinInt.Z.of_nat
               (@length Integers.Int.int (@fst (list Integers.Int.int) (list Integers.Int.int) (absorb_i l regs bs))))
            (BinInt.Z.modulo
               (BinInt.Z.add (BinInt.Z.of_nat (@length Integers.Int.int l))
                  (BinInt.Z.of_nat (@length Integers.Int.int bs)))
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (and
            (lt (@length Integers.Int.int (@fst (list Integers.Int.int) (list Integers.Int.int) (absorb_i l regs bs)))
               (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...))))))))))))))))))))))
            (@eq nat
               (@length Integers.Int.int (@snd (list Integers.Int.int) (list Integers.Int.int) (absorb_i l regs bs)))
               (S (S (S (S (S (S (S (S O))))))))))
ctxi_other
     : forall (m m' : Memory.Mem.mem) (bx bm : Values.block) (l regs : list Integers.Int.int)
         (c : Integers.Int64.int) (ovf : bool) (_ : ctxi m bx bm l regs c ovf)
         (_ : forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                (_ : or (@eq Values.block b bx)
                       (or (@eq Values.block b bm)
                          (or (@eq Values.block b (sha_symbol_block jets_sha._simplicity_sha256_compression))
                             (@eq Values.block b (sha_symbol_block jets_sha._sha256_max_counter))))),
              @eq (option Values.val) (Memory.Mem.load ch m' b ofs) (Memory.Mem.load ch m b ofs))
         (_ : forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                (_ : or (@eq Values.block b bx) (@eq Values.block b bm)) (_ : Memory.Mem.perm m b ofs k p),
              Memory.Mem.perm m' b ofs k p), ctxi m' bx bm l regs c ovf
ctxi_valid
     : forall (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bm))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bm)) (m : Memory.Mem.mem)
         (l regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : ctxi m bx bm l regs c ovf),
       and (Memory.Mem.valid_block m bx)
         (and (Memory.Mem.valid_block m bm)
            (and (Memory.Mem.valid_block m (sha_symbol_block jets_sha._simplicity_sha256_compression))
               (Memory.Mem.valid_block m (sha_symbol_block jets_sha._sha256_max_counter))))
ctxi_regs_access
     : forall (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bm))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bm)) (m : Memory.Mem.mem)
         (l regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : ctxi m bx bm l regs c ovf)
         (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
       and
         (@eq (option Values.val)
            (Memory.Mem.load AST.Mint32 m bm
               (BinInt.Z.add BinNums.Z0
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
            (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
         (Memory.Mem.valid_access m AST.Mint32 bm
            (BinInt.Z.add BinNums.Z0
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))) Memtype.Writable)
ctxi_block_perm
     : forall (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bm))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bm)) (m : Memory.Mem.mem)
         (l regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (_ : ctxi m bx bm l regs c ovf),
       Memory.Mem.range_perm m bx
         (BinInt.Z.add BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
         (BinInt.Z.add BinNums.Z0
            (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
         Memtype.Cur Memtype.Writable
ctxi_step
     : forall (bx bm : Values.block) (_ : not (@eq Values.block bm bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._simplicity_sha256_compression) bm))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bx))
         (_ : not (@eq Values.block (sha_symbol_block jets_sha._sha256_max_counter) bm)) (m m' : Memory.Mem.mem)
         (l regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) (bs : list Integers.Int.int)
         (n : BinNums.Z) (ovf' : bool) (_ : ctxi m bx bm l regs c ovf)
         (_ : and (BinInt.Z.le BinNums.Z0 n) (BinInt.Z.le n Integers.Int64.max_unsigned))
         (_ : @eq BinNums.Z (BinInt.Z.of_nat (@length Integers.Int.int bs)) n)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mptr m' bx BinNums.Z0)
                (@Some Values.val (Values.Vptr bm (Integers.Ptrofs.repr BinNums.Z0))))
