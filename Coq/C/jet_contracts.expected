Arguments ctx8_add_list c l%list_scope
ctx_abs =
fun (m : Memory.Mem.mem) (bx bm : Values.block) (l : list (Ty.tySem (Word.Word (S (S (S O))))))
  (regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool) =>
and
  (@eq (option Values.val) (Memory.Mem.load AST.Mptr m bx BinNums.Z0)
     (@Some Values.val (Values.Vptr bm (Integers.Ptrofs.repr BinNums.Z0))))
  (and
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m bx
           (BinInt.Z.add BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (@Some Values.val (Values.Vlong c)))
     (and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint8unsigned m bx
              (BinInt.Z.add BinNums.Z0
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
           (@Some Values.val (Values.Vint (bit_int ovf))))
        (and
           (forall (i : nat)
              (_ : lt i
                     (@length Integers.Int.int
                        (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value l))),
            @eq (option Values.val)
              (Memory.Mem.load AST.Mint8unsigned m bx
                 (BinInt.Z.add
                    (BinInt.Z.add BinNums.Z0
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                    (BinInt.Z.of_nat i)))
              (@Some Values.val
                 (Values.Vint
                    (@List.nth Integers.Int.int i
                       (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value l)
                       Integers.Int.zero))))
           (and
              (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
               @eq (option Values.val)
                 (Memory.Mem.load AST.Mint32 m bm
                    (BinInt.Z.add BinNums.Z0
                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                 (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
              (and
                 (@eq BinNums.Z
                    (BinInt.Z.modulo (Integers.Int64.unsigned c)
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                    (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) l)))
                 (and
                    (lt (@length (Ty.tySem (Word.Word (S (S (S O))))) l)
                       (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))
                    (and (@eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
                       (and
                          (Memory.Mem.range_perm m bx BinNums.Z0
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                             Memtype.Cur Memtype.Freeable)
                          (and
                             (Memory.Mem.range_perm m bm BinNums.Z0
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                Memtype.Cur Memtype.Freeable)
                             (and (sha_dispatch_ok m)
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint64 m (sha_symbol_block jets_sha._sha256_max_counter)
                                      BinNums.Z0) (@Some Values.val (Values.Vlong sha_max_counter)))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block)
         (_ : list (Ty.tySem (Word.Word (S (S (S O)))))) (_ : list Integers.Int.int) (_ : Integers.Int64.int)
         (_ : bool), Prop

Arguments ctx_abs m bx bm (l regs)%list_scope c ovf%bool_scope
ctxi =
fun (m : Memory.Mem.mem) (bx bm : Values.block) (l regs : list Integers.Int.int) (c : Integers.Int64.int) (ovf : bool)
=>
and
  (@eq (option Values.val) (Memory.Mem.load AST.Mptr m bx BinNums.Z0)
     (@Some Values.val (Values.Vptr bm (Integers.Ptrofs.repr BinNums.Z0))))
  (and
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m bx
           (BinInt.Z.add BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (@Some Values.val (Values.Vlong c)))
     (and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint8unsigned m bx
              (BinInt.Z.add BinNums.Z0
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))))
           (@Some Values.val (Values.Vint (bit_int ovf))))
        (and
           (forall (i : nat) (_ : lt i (@length Integers.Int.int l)),
            @eq (option Values.val)
              (Memory.Mem.load AST.Mint8unsigned m bx
                 (BinInt.Z.add
                    (BinInt.Z.add BinNums.Z0
                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                    (BinInt.Z.of_nat i)))
              (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i l Integers.Int.zero))))
           (and
              (forall (i : nat) (_ : lt i (S (S (S (S (S (S (S (S O))))))))),
               @eq (option Values.val)
                 (Memory.Mem.load AST.Mint32 m bm
                    (BinInt.Z.add BinNums.Z0
                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                 (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i regs Integers.Int.zero))))
              (and
                 (@eq BinNums.Z
                    (BinInt.Z.modulo (Integers.Int64.unsigned c)
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                    (BinInt.Z.of_nat (@length Integers.Int.int l)))
                 (and (lt (@length Integers.Int.int l) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))
                    (and (@eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O)))))))))
                       (and
                          (Memory.Mem.range_perm m bx BinNums.Z0
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                             Memtype.Cur Memtype.Freeable)
                          (and
                             (Memory.Mem.range_perm m bm BinNums.Z0
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                Memtype.Cur Memtype.Freeable)
                             (and (sha_dispatch_ok m)
                                (@eq (option Values.val)
                                   (Memory.Mem.load AST.Mint64 m (sha_symbol_block jets_sha._sha256_max_counter)
                                      BinNums.Z0) (@Some Values.val (Values.Vlong sha_max_counter)))))))))))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : list Integers.Int.int)
         (_ : list Integers.Int.int) (_ : Integers.Int64.int) (_ : bool), Prop

Arguments ctxi m bx bm (l regs)%list_scope c ovf%bool_scope
cf_assign =
fun k : nat =>
Clight.Sassign
  (Clight.Ederef
     (Clight.Ebinop Cop.Oadd
        (Clight.Evar jets_sha.___compound
           (Ctypesdefs.tarray Ctypesdefs.tuchar
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        (Clight.Econst_int (Integers.Int.repr (BinInt.Z.of_nat k)) Ctypesdefs.tint) (Ctypesdefs.tptr Ctypesdefs.tuchar))
     Ctypesdefs.tuchar)
  (Clight.Econst_int
     (Integers.Int.repr
        match k return BinNums.Z with
        | O =>
            BinNums.Zpos
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
        | S _ => BinNums.Z0
        end) Ctypesdefs.tint)
     : forall _ : nat, Clight.statement

Arguments cf_assign k%nat_scope
cf_fill =
fix cf_fill (k : nat) : Clight.statement :=
  match k return Clight.statement with
  | O => cf_assign O
  | S k' => Clight.Ssequence (cf_fill k') (cf_assign k)
  end
     : forall _ : nat, Clight.statement

Arguments cf_fill k%nat_scope
fin_result =
Clight.Ssequence (Clight.Sset jets_sha._t'3 (ctx_field_expr SOverflow jets_sha._ctx))
  (Clight.Sset jets_sha._result
     (Clight.Ecast (Clight.Eunop Cop.Onotbool (Clight.Etempvar jets_sha._t'3 Ctypesdefs.tbool) Ctypesdefs.tint)
        Ctypesdefs.tbool))
     : Clight.statement
fin_length =
Clight.Ssequence (Clight.Sset jets_sha._t'2 (ctx_field_expr SCounter jets_sha._ctx))
  (Clight.Sset jets_sha._length
     (Clight.Ebinop Cop.Omul (Clight.Etempvar jets_sha._t'2 Ctypesdefs.tulong)
        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
           Ctypesdefs.tint) Ctypesdefs.tulong))
     : Clight.statement
fin_pad_len =
Clight.Ebinop Cop.Oadd (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint)
  (Clight.Ebinop Cop.Omod
     (Clight.Ebinop Cop.Osub
        (Clight.Ebinop Cop.Osub
           (Clight.Ebinop Cop.Oadd
              (Clight.Econst_int
                 (Integers.Int.repr
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                 Ctypesdefs.tint)
              (Clight.Econst_int
                 (Integers.Int.repr
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
                 Ctypesdefs.tint) Ctypesdefs.tint)
           (Clight.Ebinop Cop.Omod (Clight.Etempvar jets_sha._t'1 Ctypesdefs.tulong)
              (Clight.Econst_int
                 (Integers.Int.repr
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                 Ctypesdefs.tint) Ctypesdefs.tulong) Ctypesdefs.tulong)
        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint) Ctypesdefs.tulong)
     (Clight.Econst_int
        (Integers.Int.repr
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        Ctypesdefs.tint) Ctypesdefs.tulong) Ctypesdefs.tulong
     : Clight.expr
uchars_ty =
Ctypes.Tfunction
  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
     (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuchar) (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil))) Ctypesdefs.tbool
  AST.cc_default
     : Ctypes.type
fin_pad =
Clight.Ssequence (cf_fill (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  (Clight.Ssequence (Clight.Sset jets_sha._t'1 (ctx_field_expr SCounter jets_sha._ctx))
     (Clight.Scall (@None AST.ident) (Clight.Evar jets_sha._sha256_uchars uchars_ty)
        (@cons Clight.expr
           (Clight.Etempvar jets_sha._ctx (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
           (@cons Clight.expr
              (Clight.Evar jets_sha.___compound
                 (Ctypesdefs.tarray Ctypesdefs.tuchar
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
              (@cons Clight.expr fin_pad_len (@nil Clight.expr))))))
     : Clight.statement
fin_len_call =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_sha._sha256_u64be
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tulong Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Etempvar jets_sha._ctx (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
     (@cons Clight.expr (Clight.Etempvar jets_sha._length Ctypesdefs.tulong) (@nil Clight.expr)))
     : Clight.statement
pad_source =
@cons Integers.Int.int
  (Integers.Int.repr
     (BinNums.Zpos
        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
  (@List.repeat Integers.Int.int Integers.Int.zero
     (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
     : list Integers.Int.int
fin_env =
fun bk : Values.block =>
@Maps.PTree.set (prod Values.block Ctypes.type) jets_sha.___compound
  (@pair Values.block Ctypes.type bk
     (Ctypesdefs.tarray Ctypesdefs.tuchar
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
  Clight.empty_env
     : forall _ : Values.block, Clight.env

Arguments fin_env bk
fin_temps =
fun (bx : Values.block) (cbase : BinNums.Z) =>
@Maps.PTree.set Values.val jets_sha._ctx (Values.Vptr bx (Integers.Ptrofs.repr cbase))
  (Clight.create_undef_temps (Clight.fn_temps jets_sha.f_sha256_finalize))
     : forall (_ : Values.block) (_ : BinNums.Z), Clight.temp_env

Arguments fin_temps bx cbase%Z_scope
pad_count =
fun c : Integers.Int64.int =>
Integers.Int64.add (Integers.Int64.repr (BinNums.Zpos BinNums.xH))
  (Integers.Int64.modu
     (Integers.Int64.sub
        (Integers.Int64.sub
           (Integers.Int64.repr
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
           (Integers.Int64.modu c c64)) (Integers.Int64.repr (BinNums.Zpos BinNums.xH))) c64)
     : forall _ : Integers.Int64.int, Integers.Int64.int

Arguments pad_count c
pad_bytes =
fun c : Integers.Int64.int =>
@List.firstn Integers.Int.int (BinInt.Z.to_nat (Integers.Int64.unsigned (pad_count c))) pad_source
     : forall _ : Integers.Int64.int, list Integers.Int.int

Arguments pad_bytes c
sha_pad =
fun c : Integers.Int64.int =>
@app Integers.Int.int (pad_bytes c)
  (c_be64_bytes
     (Integers.Int64.mul c (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : forall _ : Integers.Int64.int, list Integers.Int.int

Arguments sha_pad c
buffer_pad_spec =
fix buffer_pad_spec (d : nat) (term : Alg.Core.Algebra) {struct d} :
    Alg.Core.domain term (buffer_type (Word.Word (S (S (S O)))) d) (Word.Vector (Word.Word (S (S (S O)))) (S d)) :=
  match
    d as d0
    return
      (Alg.Core.domain term (buffer_type (Word.Word (S (S (S O)))) d0) (Word.Vector (Word.Word (S (S (S O)))) (S d0)))
  with
  | O =>
      @jet_core_pad_spec.AC.copair Ty.Unit
        (Ty.Prod
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
           ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
               match n return Ty.Ty with
               | O => X
               | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
               end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))) (Word.Word (S (S (S (S O))))) term
        (@Word.zero (S (S (S (S O)))) term)
        (@jet_core_pad_spec.AC.pair
           (Ty.Prod
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O))))
           (Ty.Prod
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
              ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                  match n return Ty.Ty with
                  | O => X
                  | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                  end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))) (Word.Word (S (S (S O)))) term
           (@jet_core_pad_spec.AC.iden
              (Ty.Prod
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))) term)
           (@jet_core_pad_spec.AC.comp
              (Ty.Prod
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
                 ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                     match n return Ty.Ty with
                     | O => X
                     | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                     end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))) Ty.Unit (Word.Word (S (S (S O)))) term
              (@jet_core_pad_spec.AC.unit
                 (Ty.Prod
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))
                    ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                        match n return Ty.Ty with
                        | O => X
                        | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                        end) (Ty.Sum Ty.Unit Ty.Unit) (S (S O)))) term) (@Word.zero (S (S (S O))) term)))
  | S d' =>
      @jet_core_pad_spec.AC.comp
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
           (buffer_type (Word.Word (S (S (S O)))) d'))
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
           (Word.Vector (Word.Word (S (S (S O)))) (S d')))
        (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S d')) (Word.Vector (Word.Word (S (S (S O)))) (S d'))) term
        (@jet_core_pad_spec.AC.pair
           (Ty.Prod (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
              (buffer_type (Word.Word (S (S (S O)))) d'))
           (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
           (Word.Vector (Word.Word (S (S (S O)))) (S d')) term
           (@jet_core_pad_spec.AC.take (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
              (buffer_type (Word.Word (S (S (S O)))) d')
              (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))) term
              (@jet_core_pad_spec.AC.iden (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))) term))
           (@jet_core_pad_spec.AC.drop (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
              (buffer_type (Word.Word (S (S (S O)))) d') (Word.Vector (Word.Word (S (S (S O)))) (S d')) term
              (buffer_pad_spec d' term)))
        (@jet_core_pad_spec.AC.case Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))
           (Word.Vector (Word.Word (S (S (S O)))) (S d'))
           (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S d')) (Word.Vector (Word.Word (S (S (S O)))) (S d'))) term
           (@jet_core_pad_spec.AC.pair (Ty.Prod Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d')))
              (Word.Vector (Word.Word (S (S (S O)))) (S d')) (Word.Vector (Word.Word (S (S (S O)))) (S d')) term
              (@jet_core_pad_spec.AC.drop Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))
                 (Word.Vector (Word.Word (S (S (S O)))) (S d')) term
                 (@jet_core_pad_spec.AC.iden (Word.Vector (Word.Word (S (S (S O)))) (S d')) term))
              (@jet_core_pad_spec.AC.take Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S d'))
                 (Word.Vector (Word.Word (S (S (S O)))) (S d')) term
