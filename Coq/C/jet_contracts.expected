          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f_simplicity_div_mod_8)
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@div_mod_word_spec (S (S (S O))) Naive.translate) (Running s0) (Running s1))))
