      match s return Clight.expr with
      | W16 =>
          Clight.Econst_int
            (Integers.Int.repr
               (BinNums.Zpos
                  (BinNums.xI
                     (BinNums.xI
                        (BinNums.xI
                           (BinNums.xI
                              (BinNums.xI
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))))))))))
            Ctypesdefs.tint
      | W32 => Clight.Econst_int (Integers.Int.repr (BinNums.Zneg BinNums.xH)) Ctypesdefs.tuint
      | W64 => Clight.Econst_long (Integers.Int64.repr (BinNums.Zneg BinNums.xH)) Ctypesdefs.tulong
      end Ctypesdefs.tint
| false =>
    Clight.Ebinop Cop.One (Clight.Etempvar _x Ctypesdefs.tulong) (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint)
      Ctypesdefs.tint
