@final_tail_reader_sem ?E
     : forall (x : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : ?E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)))
         (@final_tail (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) x environment)
