wide_rep =
fun (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
  (sy : symbolic_column) (ma : wide_column) =>
and (@eq Values.val (den rho beta (sc_lo sy)) (Values.Vlong (wlo ma)))
  (and (@eq Values.val (den rho beta (sc_hi sy)) (Values.Vlong (whi ma)))
     (@eq Values.val (den rho beta (sc_top sy)) (Values.Vlong (wtop ma))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z)
         (_ : symbolic_column) (_ : wide_column), Prop

