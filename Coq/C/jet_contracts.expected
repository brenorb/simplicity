owned_read_final_source_fields
     : forall (size : BinNums.Z) (k : point_coordinate) (m : Memory.Mem.mem) (ba bl bi : Values.block)
         (edge rc : BinNums.Z) (rho : forall _ : nat, Integers.Int64.int)
