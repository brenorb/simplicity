increment8_output_denotes_spec
     : forall x : Ty.tySem (Word.Word (S (S (S O)))),
       @eq (Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))))
         (decode_increment8 (jet_increment8_exec.increment8_written_word (jet_read8.read8_result (encode_word8 x))))
         (increment8_spec_value x)
add8_values_denote_spec
     : forall left right : Integers.Int64.int,
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (S (S (S O))))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (S (S (S O)))))
            match
              Integers.Int.ltu
                (Integers.Int.sub
                   (Integers.Int.repr
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
                   (jet_add8.add8_u (jet_read8.read8_result right))) (jet_add8.add8_u (jet_read8.read8_result left))
              return (sum unit unit)
            with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (decode_word8
               (Integers.Int64.repr
                  (Integers.Int.unsigned
                     (jet_add8.add8_byte (jet_read8.read8_result left) (jet_read8.read8_result right))))))
         (@add8_spec Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S O))))) (Ty.tySem (Word.Word (S (S (S O)))))
               (decode_word8 left) (decode_word8 right)))
increment16_values_denote_input
     : forall (r : Integers.Int64.int) (x : Ty.tySem (Word.Word (S (S (S (S O))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S O))))) x)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (wide_log W16))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (wide_log W16)))
            match increment16_carry r return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end
            (decode_wide W16
               (Integers.Int64.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                  (increment16_payload r)))) (increment16_spec_value x)
increment32_values_denote_input
