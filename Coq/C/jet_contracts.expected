cell_ok =
fun (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m : Memory.Mem.mem) (r : nat) (w : bool) (c : cell) =>
and
  (BinInt.Z.le (BinInt.Z.add (BinInt.Z.add (bas β r) (cofs c)) (Memdata.size_chunk (cchunk c)))
     Integers.Ptrofs.max_unsigned)
  (and (BinInt.Z.divide (Memdata.align_chunk (cchunk c)) (BinInt.Z.add (bas β r) (cofs c)))
     (and
        (Memory.Mem.range_perm m (blk β r) (BinInt.Z.add (bas β r) (cofs c))
           (BinInt.Z.add (BinInt.Z.add (bas β r) (cofs c)) (Memdata.size_chunk (cchunk c))) Memtype.Cur
           match w return Memtype.permission with
           | true => Memtype.Writable
           | false => Memtype.Readable
           end)
        (forall (x : sx) (_ : @eq (option sx) (cval c) (@Some sx x)),
         and
           (@eq (option Values.val) (Memory.Mem.load (cchunk c) m (blk β r) (BinInt.Z.add (bas β r) (cofs c)))
              (@Some Values.val (den ρ (lay β) x))) (@eq bool (xp_le r x) true))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : layout) (_ : Memory.Mem.mem) (_ : nat)
         (_ : bool) (_ : cell), Prop

Arguments cell_ok ρ%function_scope β m r%nat_scope w%bool_scope c
region_ok =
fun (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (m : Memory.Mem.mem) (r : nat) (reg : region) =>
and (BinInt.Z.le BinNums.Z0 (bas β r))
  (and (Memory.Mem.valid_block m (blk β r))
     (and (@eq bool (cells_sorted BinNums.Z0 (rcells reg)) true)
        (and (@List.Forall cell (cell_ok ρ β m r (rw reg)) (rcells reg))
           match rfree reg return Prop with
           | Some sz =>
               and (@eq BinNums.Z (bas β r) BinNums.Z0)
                 (and (@eq bool (rw reg) true)
                    (and (Memory.Mem.range_perm m (blk β r) BinNums.Z0 sz Memtype.Cur Memtype.Freeable)
                       (@List.Forall cell
                          (fun c : cell => BinInt.Z.le (BinInt.Z.add (cofs c) (Memdata.size_chunk (cchunk c))) sz)
                          (rcells reg))))
           | None => True
           end)))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : layout) (_ : Memory.Mem.mem) (_ : nat) (_ : region), Prop

Arguments region_ok ρ%function_scope β m r%nat_scope reg
rsep =
fun (β : layout) (regs : list region) =>
forall (r1 r2 : nat) (reg1 reg2 : region) (_ : not (@eq nat r1 r2))
  (_ : @eq (option region) (@List.nth_error region regs r1) (@Some region reg1))
  (_ : @eq (option region) (@List.nth_error region regs r2) (@Some region reg2)),
or (not (@eq Values.block (blk β r1) (blk β r2)))
  (and (@eq (option BinNums.Z) (rfree reg1) (@None BinNums.Z))
     (and (@eq (option BinNums.Z) (rfree reg2) (@None BinNums.Z))
        (forall (c1 c2 : cell) (_ : @List.In cell c1 (rcells reg1)) (_ : @List.In cell c2 (rcells reg2)),
         or
           (BinInt.Z.le (BinInt.Z.add (BinInt.Z.add (bas β r1) (cofs c1)) (Memdata.size_chunk (cchunk c1)))
              (BinInt.Z.add (bas β r2) (cofs c2)))
           (BinInt.Z.le (BinInt.Z.add (BinInt.Z.add (bas β r2) (cofs c2)) (Memdata.size_chunk (cchunk c2)))
              (BinInt.Z.add (bas β r1) (cofs c1))))))
     : forall (_ : layout) (_ : list region), Prop

Arguments rsep β regs%list_scope
rep =
fun (ρ : forall _ : nat, Integers.Int64.int) (β : layout) (regs : list region) (m : Memory.Mem.mem) =>
and (@eq nat (@length (prod Values.block BinNums.Z) β) (@length region regs))
  (and (rsep β regs)
     (forall (r : nat) (reg : region) (_ : @eq (option region) (@List.nth_error region regs r) (@Some region reg)),
      region_ok ρ β m r reg))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : layout) (_ : list region) (_ : Memory.Mem.mem), Prop

Arguments rep ρ%function_scope β regs%list_scope m
foot =
fun (β : layout) (sh : list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
  (b : Values.block) (o : BinNums.Z) =>
@ex nat
  (fun r : nat =>
   @ex (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
     (fun s : prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z) =>
      @ex BinNums.Z
        (fun d : BinNums.Z =>
         @ex AST.memory_chunk
           (fun ch : AST.memory_chunk =>
            and
              (@eq (option (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                 (@List.nth_error (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) sh r)
                 (@Some (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) s))
              (and
                 (@List.In (prod BinNums.Z AST.memory_chunk) (@pair BinNums.Z AST.memory_chunk d ch)
                    (@fst (list (prod BinNums.Z AST.memory_chunk)) bool
                       (@fst (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z) s)))
                 (and (@eq Values.block b (blk β r))
                    (and (BinInt.Z.le (BinInt.Z.add (bas β r) d) o)
                       (BinInt.Z.lt o (BinInt.Z.add (BinInt.Z.add (bas β r) d) (Memdata.size_chunk ch))))))))))
     : forall (_ : layout) (_ : list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments foot β sh%list_scope b o%Z_scope
upd =
fix upd (A : Type) (l : list A) (i : nat) (v : A) {struct l} : list A :=
  match l return (list A) with
  | nil => @nil A
  | cons x t => match i return (list A) with
                | O => @cons A v t
                | S i0 => @cons A x (upd A t i0 v)
                end
  end
     : forall (A : Type) (_ : list A) (_ : nat) (_ : A), list A

Arguments upd {A}%type_scope l%list_scope i%nat_scope v
xstore =
fun (regs : list region) (r : nat) (d : BinNums.Z) (ch : AST.memory_chunk) (x : sx) =>
match @List.nth_error region regs r return (option (list region)) with
| Some reg =>
    match rw reg return (option (list region)) with
    | true =>
        match find_cell (rcells reg) d ch return (option (list region)) with
        | Some _ =>
            match xnorm ch x return (option (list region)) with
            | Some x' =>
                match xp_le r x' return (option (list region)) with
                | true =>
                    @Some (list region)
                      (@upd region regs r (mkreg (set_cell (rcells reg) d ch (@Some sx x')) (rw reg) (rfree reg)))
                | false => @None (list region)
                end
            | None => @None (list region)
            end
        | None => @None (list region)
        end
    | false => @None (list region)
    end
| None => @None (list region)
end
     : forall (_ : list region) (_ : nat) (_ : BinNums.Z) (_ : AST.memory_chunk) (_ : sx), option (list region)

Arguments xstore regs%list_scope r%nat_scope d%Z_scope ch x
xload =
fun (regs : list region) (r : nat) (d : BinNums.Z) (ty : Ctypes.type) =>
match Ctypes.access_mode ty return (option sx) with
| Ctypes.By_value ch =>
    match @List.nth_error region regs r return (option sx) with
    | Some reg => match find_cell (rcells reg) d ch return (option sx) with
                  | Some c => cval c
                  | None => @None sx
                  end
    | None => @None sx
    end
| Ctypes.By_reference => @Some sx (XP r d)
| Ctypes.By_copy => @Some sx (XP r d)
| Ctypes.By_nothing => @None sx
end
     : forall (_ : list region) (_ : nat) (_ : BinNums.Z) (_ : Ctypes.type), option sx

Arguments xload regs%list_scope r%nat_scope d%Z_scope ty
zreg_okb =
fix zreg_okb (bnd : forall _ : nat, prod BinNums.Z BinNums.Z) (ofs : BinNums.Z) (cs : list cell) {struct cs} : bool :=
  match cs return bool with
  | nil => true
  | cons c t =>
      andb
        (andb (andb (BinInt.Z.eqb (cofs c) ofs) (chunk_eqb (cchunk c) AST.Mint64))
           match cval c return bool with
           | Some x => andb (isk KL x) match zb bnd x return bool with
                                       | Some _ => true
                                       | None => false
                                       end
           | None => false
           end) (zreg_okb bnd (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) t)
  end
     : forall (_ : forall _ : nat, prod BinNums.Z BinNums.Z) (_ : BinNums.Z) (_ : list cell), bool

Arguments zreg_okb bnd%function_scope ofs%Z_scope cs%list_scope
zcells =
fun (zρ : forall _ : nat, BinNums.Z) (cs : list cell) =>
@List.map cell BinNums.Z
  (fun c : cell => match cval c return BinNums.Z with
                   | Some x => zval zρ x
                   | None => BinNums.Z0
                   end) cs
     : forall (_ : forall _ : nat, BinNums.Z) (_ : list cell), list BinNums.Z

Arguments zcells zρ%function_scope cs%list_scope
b2z =
fun b : bool => match b return BinNums.Z with
                | true => BinNums.Zpos BinNums.xH
                | false => BinNums.Z0
                end
     : forall _ : bool, BinNums.Z

Arguments b2z b%bool_scope
zcmp =
fun (c : Integers.comparison) (a b : BinNums.Z) =>
match c return bool with
| Integers.Ceq => BinInt.Z.eqb a b
| Integers.Cne => negb (BinInt.Z.eqb a b)
| Integers.Clt => BinInt.Z.ltb a b
| Integers.Cle => negb (BinInt.Z.ltb b a)
| Integers.Cgt => BinInt.Z.ltb b a
| Integers.Cge => negb (BinInt.Z.ltb a b)
end
     : forall (_ : Integers.comparison) (_ : BinNums.Z) (_ : BinNums.Z), bool

Arguments zcmp c (a b)%Z_scope
zop =
fun (o : bop) (a b : BinNums.Z) =>
match o return BinNums.Z with
| Badd => BinInt.Z.add a b
| Bsub => BinInt.Z.sub a b
| Bmul => BinInt.Z.mul a b
| Band => BinInt.Z.land a b
| Bor => BinInt.Z.lor a b
| Bxor => BinInt.Z.lxor a b
end
     : forall (_ : bop) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments zop o (a b)%Z_scope
zval =
fix zval (ρ : forall _ : nat, BinNums.Z) (x : sx) {struct x} : BinNums.Z :=
  match x return BinNums.Z with
  | XI i => Integers.Int.unsigned i
  | XIc i => Integers.Int.unsigned i
  | XL l => Integers.Int64.unsigned l
  | XLc l => Integers.Int64.unsigned l
  | XLv n => ρ n
  | XV _ => BinNums.Z0
  | XA _ _ => BinNums.Z0
  | XP _ _ => BinNums.Z0
  | XIb o a b => zop o (zval ρ a) (zval ρ b)
  | XLb o a b => zop o (zval ρ a) (zval ρ b)
  | XIsh o a k =>
      match o return BinNums.Z with
      | Hshl => BinInt.Z.mul (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | Hshr => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | Hshru => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      end
  | XLsh o a k =>
      match o return BinNums.Z with
      | Hshl => BinInt.Z.mul (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | Hshr => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      | Hshru => BinInt.Z.div (zval ρ a) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)
      end
  | XIcmp c _ a b => b2z (zcmp c (zval ρ a) (zval ρ b))
  | XLcmp c _ a b => b2z (zcmp c (zval ρ a) (zval ρ b))
  | XI2L _ a => zval ρ a
  | XL2I a =>
      BinInt.Z.modulo (zval ρ a)
        (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
  | XIcast sz sg a =>
      match sz return BinNums.Z with
      | Ctypes.I8 =>
          match sg return BinNums.Z with
          | Ctypes.Signed => zval ρ a
          | Ctypes.Unsigned =>
              BinInt.Z.modulo (zval ρ a)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
          end
      | Ctypes.I16 =>
          match sg return BinNums.Z with
          | Ctypes.Signed => zval ρ a
          | Ctypes.Unsigned =>
              BinInt.Z.modulo (zval ρ a)
                (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
          end
      | Ctypes.I32 => zval ρ a
      | Ctypes.IBool => zval ρ a
      end
  | XInz a => b2z (negb (BinInt.Z.eqb (zval ρ a) BinNums.Z0))
  | XLnz a => b2z (negb (BinInt.Z.eqb (zval ρ a) BinNums.Z0))
  | XIz a => b2z (BinInt.Z.eqb (zval ρ a) BinNums.Z0)
  | XLz a => b2z (BinInt.Z.eqb (zval ρ a) BinNums.Z0)
  | XIneg _ => BinNums.Z0
  | XLneg _ => BinNums.Z0
  | XInot _ => BinNums.Z0
  | XLnot _ => BinNums.Z0
  end
     : forall (_ : forall _ : nat, BinNums.Z) (_ : sx), BinNums.Z

Arguments zval ρ%function_scope x
M32 =
BinNums.Zpos
  (BinNums.xI
     (BinNums.xI
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
     : BinNums.Z
M64 =
BinNums.Zpos
  (BinNums.xI
     (BinNums.xI
        (BinNums.xI
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))))))))
     : BinNums.Z
orb_hi =
fun ha hb : BinNums.Z =>
BinInt.Z.sub
  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
     (BinInt.Z.add (BinInt.Z.log2 (BinInt.Z.max ha hb)) (BinNums.Zpos BinNums.xH))) (BinNums.Zpos BinNums.xH)
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments orb_hi (ha hb)%Z_scope
zb_op =
fun (mx : BinNums.Z) (o : bop) (la ha lb hb : BinNums.Z) =>
match o return (option (prod BinNums.Z BinNums.Z)) with
| Badd =>
    match BinInt.Z.leb (BinInt.Z.add ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z (BinInt.Z.add la lb) (BinInt.Z.add ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| Bsub =>
    match BinInt.Z.leb BinNums.Z0 (BinInt.Z.sub la hb) return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z (BinInt.Z.sub la hb) (BinInt.Z.sub ha lb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| Bmul =>
    match BinInt.Z.leb (BinInt.Z.mul ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true =>
        @Some (prod BinNums.Z BinNums.Z)
          (@pair BinNums.Z BinNums.Z (BinInt.Z.mul (BinInt.Z.max BinNums.Z0 la) (BinInt.Z.max BinNums.Z0 lb))
             (BinInt.Z.mul ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| Band => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinInt.Z.min ha hb))
| Bor =>
    match BinInt.Z.leb (orb_hi ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (orb_hi ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
| Bxor =>
    match BinInt.Z.leb (orb_hi ha hb) mx return (option (prod BinNums.Z BinNums.Z)) with
    | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (orb_hi ha hb))
    | false => @None (prod BinNums.Z BinNums.Z)
    end
end
     : forall (_ : BinNums.Z) (_ : bop) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       option (prod BinNums.Z BinNums.Z)

Arguments zb_op mx%Z_scope o (la ha lb hb)%Z_scope
zb_sh =
fun (w mx : BinNums.Z) (o : shop) (la ha k : BinNums.Z) =>
match andb (BinInt.Z.leb BinNums.Z0 k) (BinInt.Z.ltb k w) return (option (prod BinNums.Z BinNums.Z)) with
| true =>
    match o return (option (prod BinNums.Z BinNums.Z)) with
    | Hshl =>
        match
          BinInt.Z.leb (BinInt.Z.mul ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)) mx
          return (option (prod BinNums.Z BinNums.Z))
        with
        | true =>
            @Some (prod BinNums.Z BinNums.Z)
              (@pair BinNums.Z BinNums.Z (BinInt.Z.mul la (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
                 (BinInt.Z.mul ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
        | false => @None (prod BinNums.Z BinNums.Z)
        end
    | Hshr =>
        match
          BinInt.Z.ltb ha
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.sub w (BinNums.Zpos BinNums.xH)))
          return (option (prod BinNums.Z BinNums.Z))
        with
        | true =>
            @Some (prod BinNums.Z BinNums.Z)
              (@pair BinNums.Z BinNums.Z (BinInt.Z.div la (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
                 (BinInt.Z.div ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
        | false => @None (prod BinNums.Z BinNums.Z)
        end
    | Hshru =>
        @Some (prod BinNums.Z BinNums.Z)
          (@pair BinNums.Z BinNums.Z (BinInt.Z.div la (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k))
             (BinInt.Z.div ha (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) k)))
    end
| false => @None (prod BinNums.Z BinNums.Z)
end
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : shop) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z),
       option (prod BinNums.Z BinNums.Z)

Arguments zb_sh (w mx)%Z_scope o (la ha k)%Z_scope
zb =
fix zb (bnd : forall _ : nat, prod BinNums.Z BinNums.Z) (x : sx) {struct x} : option (prod BinNums.Z BinNums.Z) :=
  match x return (option (prod BinNums.Z BinNums.Z)) with
  | XI _ => @None (prod BinNums.Z BinNums.Z)
  | XIc i =>
      @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z (Integers.Int.unsigned i) (Integers.Int.unsigned i))
  | XL _ => @None (prod BinNums.Z BinNums.Z)
  | XLc l =>
      @Some (prod BinNums.Z BinNums.Z)
        (@pair BinNums.Z BinNums.Z (Integers.Int64.unsigned l) (Integers.Int64.unsigned l))
  | XLv n => @Some (prod BinNums.Z BinNums.Z) (bnd n)
  | XV _ => @None (prod BinNums.Z BinNums.Z)
  | XA _ _ => @None (prod BinNums.Z BinNums.Z)
  | XP _ _ => @None (prod BinNums.Z BinNums.Z)
  | XIb o a b =>
      match andb (isk KI a) (isk KI b) return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair lb hb => zb_op M32 o la ha lb hb
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XLb o a b =>
      match andb (isk KL a) (isk KL b) return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair lb hb => zb_op M64 o la ha lb hb
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XIsh o a k =>
      match isk KI a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  zb_sh (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) M32
                    o la ha k
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XLsh o a k =>
      match isk KL a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  zb_sh
                    (BinNums.Zpos
                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))) M64 o
                    la ha k
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XIcmp _ sg a b =>
      match andb (isk KI a) (isk KI b) return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair _ ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair _ hb =>
                          match sg return (option (prod BinNums.Z BinNums.Z)) with
                          | Ctypes.Signed =>
                              match
                                andb
                                  (BinInt.Z.ltb ha
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                  (BinInt.Z.ltb hb
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))
                                return (option (prod BinNums.Z BinNums.Z))
                              with
                              | true =>
                                  @Some (prod BinNums.Z BinNums.Z)
                                    (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                              | false => @None (prod BinNums.Z BinNums.Z)
                              end
                          | Ctypes.Unsigned =>
                              @Some (prod BinNums.Z BinNums.Z)
                                (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                          end
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XLcmp _ sg a b =>
      match andb (isk KL a) (isk KL b) return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair _ ha =>
                  match zb bnd b return (option (prod BinNums.Z BinNums.Z)) with
                  | Some p0 =>
                      match p0 return (option (prod BinNums.Z BinNums.Z)) with
                      | pair _ hb =>
                          match sg return (option (prod BinNums.Z BinNums.Z)) with
                          | Ctypes.Signed =>
                              match
                                andb
                                  (BinInt.Z.ltb ha
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos
                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                  (BinInt.Z.ltb hb
                                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                        (BinNums.Zpos
                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))
                                return (option (prod BinNums.Z BinNums.Z))
                              with
                              | true =>
                                  @Some (prod BinNums.Z BinNums.Z)
                                    (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                              | false => @None (prod BinNums.Z BinNums.Z)
                              end
                          | Ctypes.Unsigned =>
                              @Some (prod BinNums.Z BinNums.Z)
                                (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH))
                          end
                      end
                  | None => @None (prod BinNums.Z BinNums.Z)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XI2L sg a =>
      match isk KI a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match sg return (option (prod BinNums.Z BinNums.Z)) with
                  | Ctypes.Signed =>
                      match
                        BinInt.Z.ltb ha
                          (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                             (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
                        return (option (prod BinNums.Z BinNums.Z))
                      with
                      | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z la ha)
                      | false => @None (prod BinNums.Z BinNums.Z)
                      end
                  | Ctypes.Unsigned => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z la ha)
                  end
              end
          | None => @None (prod BinNums.Z BinNums.Z)
          end
      | false => @None (prod BinNums.Z BinNums.Z)
      end
  | XL2I a =>
      match isk KL a return (option (prod BinNums.Z BinNums.Z)) with
      | true =>
          match zb bnd a return (option (prod BinNums.Z BinNums.Z)) with
          | Some p =>
              match p return (option (prod BinNums.Z BinNums.Z)) with
              | pair la ha =>
                  match BinInt.Z.leb ha M32 return (option (prod BinNums.Z BinNums.Z)) with
                  | true => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z la ha)
                  | false => @Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 M32)
