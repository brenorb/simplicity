and (@eq Values.val (den rho beta (sc_lo symbolic)) (Values.Vlong (col_lo machine)))
  (and (@eq Values.val (den rho beta (sc_hi symbolic)) (Values.Vlong (col_hi machine)))
     (@eq Values.val (den rho beta (sc_top symbolic)) (Values.Vint (col_top machine))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z)
         (_ : symbolic_column) (_ : mul_column), Prop

