@Alg.Core.Combinators.comp Ty.Unit (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))) term
  (@Bit.true Ty.Unit term) (@left_pad_low_1_8 term)
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit (Word.Word (S (S (S O))))

