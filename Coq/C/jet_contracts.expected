     : forall (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, Ty.tySem B)
         (_ : jet_local_spec f A B spec), jet_separated_local_spec f A B spec
copy_frame_words_mono
     : forall (n k : BinNums.Z) (_ : BinInt.Z.le n k), BinInt.Z.le (frame_words n) (frame_words k)
copy_frame_words_mul
     : forall k : BinNums.Z,
       @eq BinNums.Z
         (frame_words
