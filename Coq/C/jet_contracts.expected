buffer_list_empty
     : forall (X : Ty.Ty) (depth : nat),
       @eq (list (Ty.tySem X)) (buffer_list X depth (buffer_empty_value X depth)) (@nil (Ty.tySem X))
buffer_snoc_spec_parametric
     : forall (X : Ty.Ty) (depth : nat),
       @Alg.Core.Parametric (Ty.Prod (buffer_type X depth) X) (Ty.Sum (Word.Vector X (S depth)) (buffer_type X depth))
         (@buffer_snoc_spec X depth)
buffer_snoc_value
     : forall (X : Ty.Ty) (depth : nat) (b : Ty.tySem (buffer_type X depth)) (x : Ty.tySem X),
       match
         @buffer_snoc_spec X depth Alg.CoreFunSem (@pair (Ty.tySem (buffer_type X depth)) (Ty.tySem X) b x) return Prop
       with
       | inl v =>
           @eq (list (Ty.tySem X)) (vector_values X (S depth) v)
             (@app (Ty.tySem X) (buffer_list X depth b) (@cons (Ty.tySem X) x (@nil (Ty.tySem X))))
       | inr b' =>
           @eq (list (Ty.tySem X)) (buffer_list X depth b')
             (@app (Ty.tySem X) (buffer_list X depth b) (@cons (Ty.tySem X) x (@nil (Ty.tySem X))))
       end
