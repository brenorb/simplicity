                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                         (@Some Values.val (Values.Vlong S)))
                      (@eq (option Values.val)
                         (Memory.Mem.load AST.Mint64 m1 bi
                            (BinInt.Z.sub edge
                               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                  (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                     (BinInt.Z.div q
                                        (BinNums.Zpos
                                           (BinNums.xO
                                              (BinNums.xO
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                         (@Some Values.val (Values.Vlong S))))))
         (_ : forall (p : BinNums.Z)
                (_ : and
                       (BinInt.Z.le
                          (BinInt.Z.sub
                             (BinInt.Z.mul
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                (BinInt.Z.add dA (BinNums.Zpos BinNums.xH))) n1) p)
                       (BinInt.Z.lt p
                          (BinInt.Z.mul
                             (BinNums.Zpos
                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                             (BinInt.Z.add dA (BinNums.Zpos BinNums.xH))))),
              and
                (BinInt.Z.le BinNums.Z0
                   (BinInt.Z.add outedge
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.div p
                            (BinNums.Zpos
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                (and
                   (BinInt.Z.le
                      (BinInt.Z.add
                         (BinInt.Z.add outedge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.div p
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Integers.Ptrofs.max_unsigned)
                   (Memory.Mem.valid_access m1 AST.Mint64 bw
                      (BinInt.Z.add outedge
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.div p
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                      Memtype.Writable)))
         (_ : forall (q p : BinNums.Z)
                (_ : and
                       (BinInt.Z.le
                          (BinInt.Z.sub
                             (BinInt.Z.add
                                (BinInt.Z.mul
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                   k1)
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) ss)
                          q)
                       (BinInt.Z.lt q
                          (BinInt.Z.add
                             (BinInt.Z.sub
                                (BinInt.Z.add
                                   (BinInt.Z.mul
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                      k1)
                                   (BinNums.Zpos
