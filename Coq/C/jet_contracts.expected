       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@canonical_scalar_negate Alg.CoreFunSem x)
         (@canonical_scalar_normalize512 Alg.CoreFunSem
            (@multiply_word_spec (S (S (S (S (S (S (S (S O)))))))) Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
