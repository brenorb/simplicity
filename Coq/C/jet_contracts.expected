wide_full_add_guarantees
     : forall (s : wide_size) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s)))))
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add read_cursor
                   (BinInt.Z.of_nat
                      (bitSize
                         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s)))))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor
                (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s))))
                   a))
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.of_nat (bitSize (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (wide_full_add s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)))
                     (@wide_full_add_spec s Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor
                           (BinInt.Z.of_nat (bitSize (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat
                                                    (bitSize
                                                       (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
wide_full_add_context_guarantees
     : forall (s : wide_size) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s)))) a)
              (newWriteFrame (bitSize (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s)))) a)
              (fullWriteFrame
                 (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)))
                    (@wide_full_add_spec s Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (wide_full_add s))
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@wide_full_add_spec s Naive.translate) (Running s0) (Running s1))))
