              (@jet_sha256_ctx8_init_spec.AC.pair
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) sha256_ctx8_type)
                 sha256_ctx8_type (Word.Word (S (S (S O)))) (Alg.Assertion.toCore term)
                 (@jet_sha256_ctx8_init_spec.AC.drop (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
                    sha256_ctx8_type sha256_ctx8_type (Alg.Assertion.toCore term)
                    (@jet_sha256_ctx8_init_spec.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term)))
                 (@jet_sha256_ctx8_init_spec.AC.comp
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) sha256_ctx8_type) Ty.Unit
