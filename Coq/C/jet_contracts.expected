        (Word.Word (S (S (S (S (S (S (S (S O))))))))) core s t))
  (@jet_sha256_ctx8_init_spec.AC.comp
     (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S (S O)))))))) sha256_ctx8_type
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) core (@ctx8_addn_spec (S (S (S (S (S (S O)))))) term)
