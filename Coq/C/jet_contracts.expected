jet_secp_umul128_exec.umul128_hi =
XLb Badd
  (XLb Badd
     (XLb Badd jet_secp_umul128_exec.umul128_hh
        (XLsh Hshru jet_secp_umul128_exec.umul128_lh
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     (XLsh Hshru jet_secp_umul128_exec.umul128_hl
