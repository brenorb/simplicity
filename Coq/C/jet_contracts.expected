copy_small_memcpy_case =
fun rc cursor n : BinNums.Z =>
or
  (and
     (@eq BinNums.Z
        (BinInt.Z.modulo cursor
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        BinNums.Z0)
     (@eq BinNums.Z
        (BinInt.Z.modulo rc
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        BinNums.Z0))
  (and
     (BinInt.Z.lt BinNums.Z0
        (BinInt.Z.modulo cursor
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     (and
        (@eq BinNums.Z
           (BinInt.Z.sub
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
              (BinInt.Z.modulo rc
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
           (BinInt.Z.modulo cursor
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
        (BinInt.Z.lt
           (BinInt.Z.modulo cursor
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
           n)))
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), Prop

