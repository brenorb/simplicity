?E : [ |- Type]
@final_body_reader_sem ?E
     : forall
         (op : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad))
                 (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (p : Ty.tySem (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) Ty.Unit))
         (environment : ?E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)))
         (@final_body (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) op p environment)
         (final_step (fun w : Ty.tySem (Word.Word (S (S (S (S (S O)))))) => op w environment) p)
where
?E : [ |- Type]
@final_program_reader_finish ?E
     : forall
         (op : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad))
                 (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))
         (environment : ?E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)))
