  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
  jets_secp.f_secp256k1_u128_mul (@cons sx (XP O BinNums.Z0) (@cons sx (XLv O) (@cons sx (XLv (S O)) (@nil sx))))
