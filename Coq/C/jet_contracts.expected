     : application_jet_local_spec jets_bitcoin.f_simplicity_bitcoin_version bitcoin_ge Bitcoin.Bitcoin.env Ty.Unit
         (Word.Word (S (S (S (S (S O)))))) bitcoin_version_env_rep
