                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m0
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_fe_is_zero)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val v_env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (finv m0 bd dbase bw outedge cursor N bi mf true
                  (@encode (Ty.Sum Ty.Unit Ty.Unit) (@canonical_fe_is_zero Alg.CoreFunSem value)))
               (lframe (fun (b : Values.block) (_ : BinNums.Z) => not (extA m0 bd bw bi b)) m0 mf)))
