?alg1 : [ |- Alg.Core.Algebra]
?alg2 : [ |- Alg.Core.Algebra]
@fee_tail_reader_sem ?E
     : forall (x : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))))
         (environment : ?E),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
         (@fee_tail (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) x environment)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (@fee_tail Alg.CoreFunSem x))
where
?E : [ |- Type]
@fee_program_reader_sem ?E
     : forall
         (tin
          tout : Alg.Core.domain (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) Ty.Unit
                   (Word.Word (S (S (S (S (S (S O)))))))) (environment : ?E)
         (x y : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (_ : @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
                (tin tt environment) (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) x))
         (_ : @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
                (tout tt environment) (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) y)),
       @eq (Monad.CIMonad.domain Option.option_CIMonad (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
         (@fee_program (Alg.CoreSem (Reader.ReaderT_CIMonad ?E Option.option_CIMonad)) tin tout tt environment)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
            (@fee_tail Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                  x y)))
where
?E : [ |- Type]
subtract_balance
     : forall (a b : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
         (w : Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (_ : @eq (Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))))
                (@subtract_word_spec Alg.CoreFunSem (S (S (S (S (S (S O))))))
                   (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                      (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) a b))
                (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) c w)),
       @eq BinNums.Z
         (BinInt.Z.sub (wz (S (S (S (S (S (S O)))))) w)
            (BinInt.Z.mul (wsize (S (S (S (S (S (S O))))))) (@Word.ToZ.Theory.toZ Word.BitToZ c)))
         (BinInt.Z.sub (wz (S (S (S (S (S (S O)))))) a) (wz (S (S (S (S (S (S O)))))) b))
fee_tail_fromZ
     : forall x y : BinNums.Z,
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
         (@fee_tail Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
               (fw6 x) (fw6 y))) (fw6 (BinInt.Z.sub x y))
bitcoin_fee_spec_parametric
     : @Bitcoin.PrimitiveBitcoin.Primitive.Parametric Ty.Unit (Word.Word (S (S (S (S (S (S O))))))) (@bitcoin_fee_spec)
bitcoin_fee_spec_value
     : forall environment : Bitcoin.Bitcoin.env,
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
         (@bitcoin_fee_spec (Bitcoin.PrimitiveBitcoin.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero) tt
            environment)
         (@Some (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
            (fw6
               (BinInt.Z.sub (Bitcoin.sigTxTotalInValue (Bitcoin.Bitcoin.envTx environment))
                  (Bitcoin.sigTxTotalOutValue (Bitcoin.Bitcoin.envTx environment)))))
@fx_comp ?A ?B ?C
     : forall
         (s : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?A ?B)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?B ?C) (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?C))
         (@jet_buffer_empty_spec.AC.comp ?A ?B ?C
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) s t a e)
         match
           s a e return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?C))
         with
         | Some b => t b e
         | None => @None (Ty.tySem ?C)
         end
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
?C : [ |- Ty.Ty]
@fx_pair ?A ?B ?C
     : forall
         (s : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?A ?B)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?A ?C) (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod ?B ?C)))
         (@jet_buffer_empty_spec.AC.pair ?A ?B ?C
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) s t a e)
         match
           s a e
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod ?B ?C)))
         with
         | Some b =>
             match
               t a e
               return
                 (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Prod ?B ?C)))
             with
             | Some c => @Some (prod (Ty.tySem ?B) (Ty.tySem ?C)) (@pair (Ty.tySem ?B) (Ty.tySem ?C) b c)
             | None => @None (Ty.tySem (Ty.Prod ?B ?C))
             end
         | None => @None (Ty.tySem (Ty.Prod ?B ?C))
         end
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
?C : [ |- Ty.Ty]
@fx_prim ?A ?B
     : forall (p : BitcoinFull.t ?A ?B) (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?B))
         (@PF.Combinators.prim ?A ?B (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)
            p a e) (@BitcoinFull.sem ?A ?B p a e)
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
@fx_assert ?A ?B
     : forall (t : forall alg : Alg.Assertion.Algebra, Alg.Assertion.domain alg ?A ?B)
         (_ : @Alg.Assertion.Parametric ?A ?B t) (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?B))
         (t
            (PF.CanonicalStructures.toAssertion
               (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)) a e)
         (t (Alg.AssertionSem Option.option_Monad_Zero) a)
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
@fx_core ?A ?B
     : forall (t : forall alg : Alg.Core.Algebra, Alg.Core.domain alg ?A ?B) (_ : @Alg.Core.Parametric ?A ?B t)
         (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?B))
         (t
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) a e)
         (@Some (Ty.tySem ?B) (t Alg.CoreFunSem a))
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
ih_body
     : @eq Clight.statement (Clight.fn_body jets_sha.f_simplicity_bitcoin_input_hash)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
               (Clight.Etempvar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
            (shx_indexed_rest jets_sha._t'8 jets_sha._t'9 jets_sha._numInputs ih_then ih_else))
ih_blocks
     : forall bl bm bx br : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) (Clight.blocks_of_env sha_ge (ih_env bl bm bx br))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bl BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bm BinNums.Z0)
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                  (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                     (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z br BinNums.Z0)
                        (BinNums.Zpos
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                     (@nil (prod (prod Values.block BinNums.Z) BinNums.Z))))))
ih_entry
     : forall (env : Values.val) (m : Memory.Mem.mem) (m1 m2 m3 m4 : Memory.Mem.mem') (bl bm bx br bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block m1 bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m2 bm))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m3 bx))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m3 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m4 br)),
       Clight.function_entry2 sha_ge jets_sha.f_simplicity_bitcoin_input_hash
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         m (ih_env bl bm bx br) (ih_temps env bd dbase bs sbase) m4
ih_copy
     : forall (m mc : Memory.Mem.mem) (bl bm bx br bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt sha_ge (ih_env bl bm bx br) le m
         (Clight.Sassign (Clight.Evar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
            (Clight.Etempvar jets_sha._src (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))) Events.E0 le mc
         ClightBigstep.Out_normal
