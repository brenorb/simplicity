                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                (@List.map bool (option bool) (@Some bool) (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) b)))
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable) (_ : frame_fields_at m bl BinNums.Z0 bi edge rc) (_ : not (@eq Values.block ba bb))
         (_ : not (@eq Values.block ba bl)) (_ : not (@eq Values.block bb bl))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell) cap
                (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) a) rc)
                (@nil event) m),
       @ex Memory.Mem.mem
         (fun ma : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mb : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 ma
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall secp_ge ma (@Ctypes.Internal Clight.function jets_secp.f_read_fe)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                        (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mb
                     Values.Vundef)
                  (and
                     (fe_at mb ba BinNums.Z0
                        (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                           (fe_limbs_of
                              (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                 (@canonical_fe_normalize Alg.CoreFunSem a)))))
                     (and
                        (fe_at mb bb BinNums.Z0
                           (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                              (fe_limbs_of
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                                    (@canonical_fe_normalize Alg.CoreFunSem b)))))
                        (and
                           (frame_fields_at mb bl BinNums.Z0 bi edge
                              (BinInt.Z.add rc
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                           (and
                              (Memory.Mem.range_perm mb ba BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mb bb BinNums.Z0
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (Memory.Mem.range_perm mb bl BinNums.Z0
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                       Memtype.Cur Memtype.Freeable)
                                    (and
                                       (invA m0 bd dbase bw outedge cursor N bi
                                          (BinInt.Z.add rc
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                          false (@nil Cell) cap
                                          (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) b)
                                             (BinInt.Z.add rc
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))
                                          (read_fe_log bi (Integers.Ptrofs.repr edge)) mb)
                                       (and
                                          (lframe
                                             (frame (extA m0 bd bw bi)
                                                (@cons (prod Values.block BinNums.Z)
                                                   (@pair Values.block BinNums.Z ba BinNums.Z0)
                                                   (@cons (prod Values.block BinNums.Z)
                                                      (@pair Values.block BinNums.Z bl BinNums.Z0)
                                                      (@nil (prod Values.block BinNums.Z))))
                                                (local_read_initial_regs bi (Integers.Ptrofs.repr edge)) m) m ma)
                                          (lframe
                                             (frame (extA m0 bd bw bi)
                                                (@cons (prod Values.block BinNums.Z)
                                                   (@pair Values.block BinNums.Z bb BinNums.Z0)
                                                   (@cons (prod Values.block BinNums.Z)
                                                      (@pair Values.block BinNums.Z bl BinNums.Z0)
                                                      (@nil (prod Values.block BinNums.Z))))
                                                (local_read_initial_regs bi (Integers.Ptrofs.repr edge)) ma) ma mb))))))))))))
field_pair_input_slices
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z)
