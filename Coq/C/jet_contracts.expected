umul128_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge0) _secp256k1_umul128)
         (@Some Values.block (jet_symbol_block _secp256k1_umul128))
umul128_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv ge0)
            (Values.Vptr (jet_symbol_block _secp256k1_umul128) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f_secp256k1_umul128))
eval_u128_mul_layout
     : forall (m : Memory.Mem.mem) (br : Values.block) (base : BinNums.Z) (a b : Integers.Int64.int)
         (_ : frame_base_valid base) (_ : Memory.Mem.valid_access m AST.Mint64 br base Memtype.Writable)
         (_ : Memory.Mem.valid_access m AST.Mint64 br
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_secp256k1_u128_mul)
               (@cons Values.val (Values.Vptr br (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vlong a) (@cons Values.val (Values.Vlong b) (@nil Values.val)))) Events.E0
               mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf br base)
                  (@Some Values.val (Values.Vlong (umul128_result_lo a b))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf br
                        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val (Values.Vlong (umul128_result_hi a b))))
                  (and
                     (@eq BinNums.Z (Integers.Int64.unsigned (umul128_result_hi a b))
                        (BinInt.Z.div (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
                           Integers.Int64.modulus))
                     (and
                        (@eq BinNums.Z (Integers.Int64.unsigned (umul128_result_lo a b))
                           (BinInt.Z.modulo (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
                              Integers.Int64.modulus))
                        (and
                           (forall (chunk : AST.memory_chunk) (bb : Values.block) (addr : BinNums.Z)
                              (_ : or (not (@eq Values.block bb br))
                                     (or (BinInt.Z.le (BinInt.Z.add addr (Memdata.size_chunk chunk)) base)
                                        (BinInt.Z.le
                                           (BinInt.Z.add base
                                              (BinNums.Zpos
                                                 (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) addr))),
                            @eq (option Values.val) (Memory.Mem.load chunk mf bb addr)
                              (Memory.Mem.load chunk m bb addr))
                           (and
                              (forall (bb : Values.block) (addr : BinNums.Z) (kind : Memtype.perm_kind)
                                 (p : Memtype.permission) (_ : Memory.Mem.perm m bb addr kind p),
                               Memory.Mem.perm mf bb addr kind p)
                              (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m)))))))))
write128_body
     : @eq Clight.statement (Clight.fn_body f_write128)
         (Clight.Ssequence (Clight.Ssequence (write128_get_call true _t'1) (write128_write_call _t'1))
            (Clight.Ssequence (write128_get_call false _t'2) (write128_write_call _t'2)))
call_write128_get
     : forall (high : bool) (result : AST.ident) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (br : Values.block) (base : BinNums.Z)
         (w : Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) (u128_get_id high) e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _x le)
                (@Some Values.val (Values.Vptr br (Integers.Ptrofs.repr base)))) (_ : frame_base_valid base)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m br (BinInt.Z.add base (u128_field_offset high)))
                (@Some Values.val (Values.Vlong w))),
       ClightBigstep.Clight2.exec_stmt ge0 e le m (write128_get_call high result) Events.E0
         (@Maps.PTree.set Values.val result (Values.Vlong w) le) m ClightBigstep.Out_normal
call_write128_write
     : forall (result : BinNums.positive) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z)
         (w : Integers.Int64.int)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) _simplicity_write64 e)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _frame le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val result le) (@Some Values.val (Values.Vlong w)))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_write64)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                   (@cons Values.val (Values.Vlong w) (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt ge0 e le m (write128_write_call result) Events.E0 le mf ClightBigstep.Out_normal
eval_write128_layout
     : forall (m : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (br : Values.block) (rbase : BinNums.Z) (hi lo : Integers.Int64.int)
         (_ : frame_base_valid rbase) (_ : not (@eq Values.block br bd)) (_ : not (@eq Values.block br bw))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m br
                   (BinInt.Z.add rbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong hi)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m br rbase) (@Some Values.val (Values.Vlong lo)))
         (_ : write_frame_at m bd base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_write128)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr br (Integers.Ptrofs.repr rbase)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and
               (frame_output_cells_at mf bw edge cursor
                  (@encode (Word.Word (S (S (S (S (S (S (S O))))))))
                     (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
                        (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
                        (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.unsigned hi))
                        (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.unsigned lo)))))
               (and (write_prefix_at m mf bw edge cursor)
                  (and
                     (frame_fields_at mf bd base bw edge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     (and
                        (loads_outside_ranges m mf bd
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (bb : Values.block) (addr : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m bb addr kind p),
                            Memory.Mem.perm mf bb addr kind p)
                           (forall (bb : Values.block) (_ : Memory.Mem.valid_block m bb), Memory.Mem.valid_block mf bb)))))))
multiply64_product_representation
     : forall (x y : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (a b : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned a)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned b)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) y)),
       @eq
         (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))))
         (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
               (Integers.Int64.unsigned (umul128_result_hi a b)))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
               (Integers.Int64.unsigned (umul128_result_lo a b))))
         (@multiply_word_spec (S (S (S (S (S (S O)))))) Alg.CoreFunSem
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) x
               y))
entry_frame_u128_jet
     : forall (env : Values.val) (f : Clight.function) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem')
         (bl br bd : Values.block) (dofs : Integers.Ptrofs.int) (bs : Values.block) (sofs : Integers.Ptrofs.int)
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_vars f)
                (@cons (prod AST.ident Ctypes.type)
                   (@pair AST.ident Ctypes.type _src (Ctypes.Tstruct _frameItem Ctypes.noattr))
                   (@cons (prod AST.ident Ctypes.type)
                      (@pair AST.ident Ctypes.type _r (Ctypes.Tstruct _secp256k1_uint128 Ctypes.noattr))
                      (@nil (prod AST.ident Ctypes.type)))))
         (_ : @eq (list (prod AST.ident Ctypes.type)) (Clight.fn_params f)
                (@cons (prod AST.ident Ctypes.type)
                   (@pair AST.ident Ctypes.type _dst (Ctypesdefs.tptr (Ctypes.Tstruct _frameItem Ctypes.noattr)))
                   (@cons (prod AST.ident Ctypes.type)
                      (@pair AST.ident Ctypes.type _src (Ctypes.Tstruct _frameItem Ctypes.noattr))
                      (@cons (prod AST.ident Ctypes.type)
                         (@pair AST.ident Ctypes.type _env (Ctypesdefs.tptr (Ctypes.Tstruct _txEnv Ctypes.noattr)))
                         (@nil (prod AST.ident Ctypes.type))))))
         (_ : @Coqlib.list_disjoint AST.ident
                (@cons AST.ident _dst (@cons AST.ident _src (@cons AST.ident _env (@nil AST.ident))))
                (@List.map (prod AST.ident Ctypes.type) AST.ident (@fst AST.ident Ctypes.type) (Clight.fn_temps f)))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block mb br)),
       Clight.function_entry2 ge0 f
         (@cons Values.val (Values.Vptr bd dofs)
            (@cons Values.val (Values.Vptr bs sofs) (@cons Values.val env (@nil Values.val)))) m
         (e_frame_u128 bl br) (jet_arith8_layout_exec.le_arith8_layout env f bd dofs bs sofs) mb
exec_frame_u128_copy
     : forall (m mc : Memory.Mem.mem) (bl br bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval)
         (le : Maps.PTree.tree Values.val) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _src le)
                (@Some Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes m bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes m bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       ClightBigstep.Clight2.exec_stmt ge0 (e_frame_u128 bl br) le m
         (Clight.Sassign (Clight.Evar _src (Ctypes.Tstruct _frameItem Ctypes.noattr))
            (Clight.Etempvar _src (Ctypes.Tstruct _frameItem Ctypes.noattr))) Events.E0 le mc ClightBigstep.Out_normal
call_frame_u128_read
     : forall (s : wide_size) (result : AST.ident) (le : Clight.temp_env) (m mr : Memory.Mem.mem)
