xalloc =
fix xalloc
  (cf : forall (_ : AST.ident) (_ : Ctypes.type), option (list cell)) (ce : Ctypes.composite_env)
  (vars : list (prod AST.ident Ctypes.type)) (n : nat) {struct vars} : option (prod (list region) venv) :=
  match vars return (option (prod (list region) venv)) with
  | nil =>
      @Some (prod (list region) (list (prod AST.ident (prod nat Ctypes.type))))
        (@pair (list region) (list (prod AST.ident (prod nat Ctypes.type))) (@nil region)
           (@nil (prod AST.ident (prod nat Ctypes.type))))
  | cons p t =>
      match p return (option (prod (list region) venv)) with
      | pair id ty =>
          match cf id ty return (option (prod (list region) venv)) with
          | Some cs =>
              match xalloc cf ce t (S n) return (option (prod (list region) venv)) with
              | Some p0 =>
                  match p0 return (option (prod (list region) venv)) with
                  | pair regs ve =>
                      let sz : BinNums.Z := Ctypes.sizeof ce ty in
                      match
                        andb (andb (cells_sorted BinNums.Z0 cs) (@List.forallb cell (cell_allocb sz) cs))
                          (BinInt.Z.leb sz Integers.Ptrofs.max_unsigned) return (option (prod (list region) venv))
                      with
                      | true =>
                          @Some (prod (list region) (list (prod AST.ident (prod nat Ctypes.type))))
                            (@pair (list region) (list (prod AST.ident (prod nat Ctypes.type)))
                               (@cons region (mkreg cs true (@Some BinNums.Z sz)) regs)
                               (@cons (prod AST.ident (prod nat Ctypes.type))
                                  (@pair AST.ident (prod nat Ctypes.type) id (@pair nat Ctypes.type n ty)) ve))
                      | false => @None (prod (list region) venv)
                      end
                  end
              | None => @None (prod (list region) venv)
              end
          | None => @None (prod (list region) venv)
          end
      end
  end
     : forall (_ : forall (_ : AST.ident) (_ : Ctypes.type), option (list cell)) (_ : Ctypes.composite_env)
         (_ : list (prod AST.ident Ctypes.type)) (_ : nat), option (prod (list region) venv)

Arguments xalloc cf%function_scope ce vars%list_scope n%nat_scope
xbind =
fix xbind (params : list (prod AST.ident Ctypes.type)) (xs : list sx) (ts : Maps.PTree.t sx) {struct params} :
    option (Maps.PTree.t sx) :=
  match params return (option (Maps.PTree.t sx)) with
  | nil =>
      match xs return (option (Maps.PTree.t sx)) with
      | nil => @Some (Maps.PTree.t sx) ts
      | cons _ _ => @None (Maps.PTree.t sx)
      end
  | cons p ps =>
      match p return (option (Maps.PTree.t sx)) with
      | pair id _ =>
          match xs return (option (Maps.PTree.t sx)) with
          | nil => @None (Maps.PTree.t sx)
          | cons x xs0 => xbind ps xs0 (@Maps.PTree.set sx id x ts)
          end
      end
  end
     : forall (_ : list (prod AST.ident Ctypes.type)) (_ : list sx) (_ : Maps.PTree.t sx), option (Maps.PTree.t sx)

