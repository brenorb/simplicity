         (rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : ext_environment)
                  (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
         (spec : forall (_ : Ty.tySem A) (_ : ext_environment), option (Ty.tySem B))
         (raw_spec : forall (_ : Ty.tySem A) (_ : raw_bitcoin_environment), option (Ty.tySem B))
         (_ : forall (a : Ty.tySem A) (logical : raw_bitcoin_environment)
                (Hpath : le (@length Digest.hash256 (raw_tap_path logical))
