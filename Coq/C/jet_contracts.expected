                   (Values.Vlong
                      (Integers.Int64.repr
                         (BinInt.Z.of_nat (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c))))))
         (_ : BinInt.Z.lt BinNums.Z0
                (BinInt.Z.of_nat (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c)))
         (_ : match @snd nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c return Prop with
              | Some xs =>
                  @eq nat (@length (Ty.tySem (Word.Word (S (S (S O))))) xs)
                    (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c)
              | None => True
              end) (_ : BinInt.Z.le BinNums.Z0 output)
         (_ : BinInt.Z.le
                (BinInt.Z.add output
                   (BinInt.Z.of_nat (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c)))
                Integers.Ptrofs.max_unsigned)
         (_ : and (BinInt.Z.le BinNums.Z0 slot) (BinInt.Z.le slot Integers.Ptrofs.max_unsigned))
         (_ : BinInt.Z.le BinNums.Z0 count)
         (_ : BinInt.Z.le
                (BinInt.Z.add count (BinInt.Z.of_nat (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c)))
                Integers.Int64.max_unsigned)
         (_ : Memory.Mem.range_perm m bo output
                (BinInt.Z.add output
                   (BinInt.Z.of_nat (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c))) Memtype.Cur
                Memtype.Writable) (_ : Memory.Mem.valid_access m AST.Mint64 bl slot Memtype.Writable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bl slot)
                (@Some Values.val (Values.Vlong (Integers.Int64.repr count)))) (_ : not (@eq Values.block bf bo))
         (_ : not (@eq Values.block bf bi)) (_ : not (@eq Values.block bo bi)) (_ : not (@eq Values.block bl bf))
         (_ : not (@eq Values.block bl bo)) (_ : frame_base_valid base) (_ : BinInt.Z.le BinNums.Z0 cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add (BinInt.Z.add cursor (BinNums.Zpos BinNums.xH))
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c))))
                Integers.Int64.max_unsigned) (_ : frame_fields_at m bf base bi edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : frame_input_cells_at m bi edge cursor (byte_chunk_cells c)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt ge0 Clight.empty_env le m
               (Clight.Ssequence buffer8_read_body buffer8_read_update) Events.E0
               (@Maps.PTree.set Values.val _i
                  (Values.Vlong
                     (Integers.Int64.repr
                        (BinInt.Z.div
                           (BinInt.Z.of_nat (@fst nat (option (list (Ty.tySem (Word.Word (S (S (S O))))))) c))
                           (BinNums.Zpos (BinNums.xO BinNums.xH))))) (buffer8_read_chunk_temps le bo output count c))
               mf ClightBigstep.Out_normal)
            (and
               (uint8_array_at mf bo output
                  (@List.map (Ty.tySem (Word.Word (S (S (S O))))) Integers.Int.int word8_array_value
                     (byte_chunk_values c)))
               (and
                  (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bl slot)
                     (@Some Values.val
                        (Values.Vlong
                           (Integers.Int64.repr
                              (BinInt.Z.add count
