         (_ : @Alg.Assertion.Parametric.rel alg1 alg2 R (Ty.Prod C (Word.Word w))
                (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) k)) a1 a2),
       @Alg.Assertion.Parametric.rel alg1 alg2 R (Ty.Prod C sha256_ctx8_type) sha256_ctx8_type
         (@hash_loop_spec k w alg1 C a1) (@hash_loop_spec k w alg2 C a2)
@fx_take ?A ?B ?C
     : forall
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?A ?C) (p : Ty.tySem (Ty.Prod ?A ?B)) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?C))
         (@jet_sha256_ctx8_init_spec.AC.take ?A ?B ?C
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) t p e)
         (t
            (@fst
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) ?A)
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) ?B) p) e)
