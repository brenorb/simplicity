peekBit_extract
     : forall (w : Integers.Int64.int) (shift : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 shift)
                (BinInt.Z.lt shift
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq Integers.Int64.int
         (Integers.Int64.and Integers.Int64.one (Integers.Int64.shru w (Integers.Int64.repr shift)))
         (bit_long (Integers.Int64.testbit w shift))
eval_readBit_layout
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (bit : bool) (_ : frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 cursor)
                (BinInt.Z.le cursor (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))))
         (_ : frame_fields_at m bf base bw edge cursor) (_ : frame_input_bit_at m bw edge cursor bit)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function jets.f_readBit)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0 mf
               (Values.Vint (bit_int bit)))
            (and (frame_fields_at mf bf base bw edge (BinInt.Z.add cursor (BinNums.Zpos BinNums.xH)))
               (and
                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : or (not (@eq Values.block b bf))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add base
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs))),
                   @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                        (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mf b ofs kind p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
eval_complement1_layout_matches_spec
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (x : Ty.tySem (Word.Word O)) (cursor rc : BinNums.Z) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc (BinInt.Z.sub Integers.Int64.max_unsigned (BinNums.Zpos BinNums.xH))))
         (_ : frame_input_bit_at m bi edge rc (Bit.toBool x))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinNums.Zpos BinNums.xH)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function jets.f_simplicity_complement_1)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word O) (@complement_spec O Alg.CoreFunSem x)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
