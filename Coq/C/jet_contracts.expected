         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt sha_ge env le m (Clight.Sassign lhs e) Events.E0 le m'
               ClightBigstep.Out_normal) (and (sha_R lb bs os bc oc st' le m') (sha_F lb bs os m m')))
interp_sigma_sound
     : forall (env : Clight.env) (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int)
         (bc : Values.block) (oc : Integers.Ptrofs.int)
         (_ : @eq nat (@length Values.block lb) (S (S (S (S (S (S (S (S O)))))))))
         (_ : forall (i : nat) (x : AST.ident) (b : Values.block)
                (_ : @eq (option AST.ident) (@List.nth_error AST.ident lids i) (@Some AST.ident x))
                (_ : @eq (option Values.block) (@List.nth_error Values.block lb i) (@Some Values.block b)),
              @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) x env)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type b Ctypesdefs.tuint)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._sigma0 env)
                (@None (prod Values.block Ctypes.type)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._sigma1 env)
                (@None (prod Values.block Ctypes.type)))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : or (not (@eq Values.block bs bc))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (Integers.Ptrofs.unsigned oc))
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (Integers.Ptrofs.unsigned os)))) (st st' : cst) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (t f : AST.ident) (fty : Ctypes.type) (a : Clight.expr)
         (_ : sha_R lb bs os bc oc st le m) (_ : @eq (option cst) (interp_sigma st t f fty a) (@Some cst st')),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          and
            (ClightBigstep.Clight2.exec_stmt sha_ge env le m
               (Clight.Scall (@Some AST.ident t) (Clight.Evar f fty) (@cons Clight.expr a (@nil Clight.expr)))
               Events.E0 le' m ClightBigstep.Out_normal) (sha_R lb bs os bc oc st' le' m))
interp_round_sound
     : forall (env : Clight.env) (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int)
         (bc : Values.block) (oc : Integers.Ptrofs.int)
         (_ : @eq nat (@length Values.block lb) (S (S (S (S (S (S (S (S O))))))))) (_ : @List.NoDup Values.block lb)
         (_ : not (@List.In Values.block bs lb)) (_ : not (@List.In Values.block bc lb))
         (_ : forall (i : nat) (x : AST.ident) (b : Values.block)
                (_ : @eq (option AST.ident) (@List.nth_error AST.ident lids i) (@Some AST.ident x))
                (_ : @eq (option Values.block) (@List.nth_error Values.block lb i) (@Some Values.block b)),
              @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) x env)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type b Ctypesdefs.tuint)))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._Round env)
                (@None (prod Values.block Ctypes.type)))
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.le
                (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : or (not (@eq Values.block bs bc))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned os)
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (Integers.Ptrofs.unsigned oc))
                   (BinInt.Z.le
                      (BinInt.Z.add (Integers.Ptrofs.unsigned oc)
                         (BinNums.Zpos
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                      (Integers.Ptrofs.unsigned os)))) (st st' : cst) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (f : AST.ident) (fty : Ctypes.type) (a b c d e f' g h k : Clight.expr)
         (_ : sha_R lb bs os bc oc st le m)
         (_ : @eq (option cst) (interp_round st f fty a b c d e f' g h k) (@Some cst st')),
       @ex Memory.Mem.mem
         (fun m' : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt sha_ge env le m
               (Clight.Scall (@None AST.ident) (Clight.Evar f fty)
                  (@cons Clight.expr a
                     (@cons Clight.expr b
                        (@cons Clight.expr c
                           (@cons Clight.expr d
                              (@cons Clight.expr e
                                 (@cons Clight.expr f'
                                    (@cons Clight.expr g (@cons Clight.expr h (@cons Clight.expr k (@nil Clight.expr)))))))))))
               Events.E0 le m' ClightBigstep.Out_normal) (and (sha_R lb bs os bc oc st' le m') (sha_F lb bs os m m')))
interp_sound
     : forall (env : Clight.env) (lb : list Values.block) (bs : Values.block) (os : Integers.Ptrofs.int)
         (bc : Values.block) (oc : Integers.Ptrofs.int)
         (_ : @eq nat (@length Values.block lb) (S (S (S (S (S (S (S (S O))))))))) (_ : @List.NoDup Values.block lb)
         (_ : not (@List.In Values.block bs lb)) (_ : not (@List.In Values.block bc lb))
         (_ : forall (i : nat) (x : AST.ident) (b : Values.block)
                (_ : @eq (option AST.ident) (@List.nth_error AST.ident lids i) (@Some AST.ident x))
                (_ : @eq (option Values.block) (@List.nth_error Values.block lb i) (@Some Values.block b)),
              @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) x env)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type b Ctypesdefs.tuint)))
