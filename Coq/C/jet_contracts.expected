write128_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv ge0)
            (Values.Vptr (jet_symbol_block _write128) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f_write128))
eval_multiply64_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem')
         (mcopy mr1 mr2 mk me mf : Memory.Mem.mem) (bl br bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval) (a b : Integers.Int64.int)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block mb br))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mb bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mb bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mcopy))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mcopy (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr1
                (Values.Vlong a))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr1 (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong b))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr2 (@Ctypes.Internal Clight.function f_secp256k1_u128_mul)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong a) (@cons Values.val (Values.Vlong b) (@nil Values.val)))) Events.E0
                mk Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mk (@Ctypes.Internal Clight.function f_write128)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.free_list me (Clight.blocks_of_env ge0 (e_frame_u128 bl br)))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_multiply_64)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
frame_u128_permissions_preserved
     : forall (m mf : Memory.Mem.mem) (bl br : Values.block)
         (_ : forall (bb : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m bb ofs kind p), Memory.Mem.perm mf bb ofs kind p)
         (_ : frame_u128_local_permissions m bl br), frame_u128_local_permissions mf bl br
allocate_frame_u128_locals
     : forall m : Memory.Mem.mem,
       @ex Memory.Mem.mem'
         (fun ma : Memory.Mem.mem' =>
          @ex Memory.Mem.mem'
            (fun mb : Memory.Mem.mem' =>
             @ex Values.block
               (fun bl : Values.block =>
                @ex Values.block
                  (fun br : Values.block =>
                   and
                     (@eq (prod Memory.Mem.mem' Values.block)
                        (Memory.Mem.alloc m BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (@pair Memory.Mem.mem' Values.block ma bl))
                     (and
                        (@eq (prod Memory.Mem.mem' Values.block)
                           (Memory.Mem.alloc ma BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (@pair Memory.Mem.mem' Values.block mb br))
                        (and (not (@eq Values.block bl br))
                           (and (frame_u128_local_permissions mb bl br)
                              (and
                                 (forall (bb : Values.block) (_ : Memory.Mem.valid_block m bb),
                                  and (not (@eq Values.block bb bl)) (not (@eq Values.block bb br)))
                                 (and
                                    (forall (chunk : AST.memory_chunk) (bb : Values.block)
                                       (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m bb),
                                     @eq (option Values.val) (Memory.Mem.load chunk mb bb ofs)
                                       (Memory.Mem.load chunk m bb ofs))
                                    (forall (bb : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                       (p : Memtype.permission) (_ : Memory.Mem.perm m bb ofs kind p),
                                     Memory.Mem.perm mb bb ofs kind p))))))))))
frame_u128_slots_writable
     : forall (m : Memory.Mem.mem) (bl br : Values.block) (_ : frame_u128_local_permissions m bl br),
       and
         (Memory.Mem.valid_access m AST.Mint64 bl (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
            Memtype.Writable)
         (and (Memory.Mem.valid_access m AST.Mint64 br BinNums.Z0 Memtype.Writable)
            (Memory.Mem.valid_access m AST.Mint64 br (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
               Memtype.Writable))
initialize_frame_u128_input
     : forall (m : Memory.Mem.mem) (bs : Values.block) (sbase : BinNums.Z) (bi : Values.block)
         (edge rc : BinNums.Z) (_ : frame_fields_at m bs sbase bi edge rc),
       @ex Memory.Mem.mem'
         (fun ma : Memory.Mem.mem' =>
          @ex Memory.Mem.mem'
            (fun mb : Memory.Mem.mem' =>
             @ex Memory.Mem.mem
               (fun mc : Memory.Mem.mem =>
                @ex Values.block
                  (fun bl : Values.block =>
                   @ex Values.block
                     (fun br : Values.block =>
                      @ex (list Memdata.memval)
                        (fun bytes : list Memdata.memval =>
                         and
                           (@eq (prod Memory.Mem.mem' Values.block)
                              (Memory.Mem.alloc m BinNums.Z0
                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              (@pair Memory.Mem.mem' Values.block ma bl))
                           (and
                              (@eq (prod Memory.Mem.mem' Values.block)
                                 (Memory.Mem.alloc ma BinNums.Z0
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (@pair Memory.Mem.mem' Values.block mb br))
                              (and
                                 (@eq (option (list Memdata.memval))
                                    (Memory.Mem.loadbytes mb bs sbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    (@Some (list Memdata.memval) bytes))
                                 (and
                                    (@eq (option Memory.Mem.mem) (Memory.Mem.storebytes mb bl BinNums.Z0 bytes)
                                       (@Some Memory.Mem.mem mc))
                                    (and (not (@eq Values.block bl br))
                                       (and (frame_fields_at mc bl BinNums.Z0 bi edge rc)
                                          (and (frame_u128_local_permissions mc bl br)
                                             (and
                                                (forall (bb : Values.block) (_ : Memory.Mem.valid_block m bb),
                                                 and (not (@eq Values.block bb bl)) (not (@eq Values.block bb br)))
                                                (and
                                                   (forall (chunk : AST.memory_chunk) (bb : Values.block)
                                                      (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m bb),
                                                    @eq (option Values.val) (Memory.Mem.load chunk mc bb ofs)
                                                      (Memory.Mem.load chunk m bb ofs))
                                                   (forall (bb : Values.block) (ofs : BinNums.Z)
                                                      (kind : Memtype.perm_kind) (p : Memtype.permission)
                                                      (_ : Memory.Mem.perm m bb ofs kind p),
                                                    Memory.Mem.perm mc bb ofs kind p)))))))))))))))
free_frame_u128_locals
     : forall (m : Memory.Mem.mem) (bl br : Values.block) (_ : not (@eq Values.block bl br))
         (_ : frame_u128_local_permissions m bl br),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (@eq (option Memory.Mem.mem) (Memory.Mem.free_list m (Clight.blocks_of_env ge0 (e_frame_u128 bl br)))
               (@Some Memory.Mem.mem mf))
            (and
               (forall (chunk : AST.memory_chunk) (bb : Values.block) (ofs : BinNums.Z)
                  (_ : not (@eq Values.block bb bl)) (_ : not (@eq Values.block bb br)),
                @eq (option Values.val) (Memory.Mem.load chunk mf bb ofs) (Memory.Mem.load chunk m bb ofs))
               (and
                  (forall (bb : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                     (p : Memtype.permission) (_ : not (@eq Values.block bb bl)) (_ : not (@eq Values.block bb br))
                     (_ : Memory.Mem.perm m bb ofs kind p), Memory.Mem.perm mf bb ofs kind p)
                  (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m)))))
eval_multiply64_layout_matches_spec
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (x y : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (cursor rc : BinNums.Z) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge rc x)
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) y)
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_multiply_64)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S (S (S (S (S O))))))))
                     (@multiply_word_spec (S (S (S (S (S (S O)))))) Alg.CoreFunSem
                        (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) x y))))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     (forall (chunk : AST.memory_chunk) (bb : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m bb)
                        (_ : or (not (@eq Values.block bb bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block bb bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf bb ofs) (Memory.Mem.load chunk m bb ofs))))))
multiply64_local_spec
     : jet_local_spec f_simplicity_multiply_64
         (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Word.Word (S (S (S (S (S (S (S O))))))))
         (fun xy : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))) =>
          @multiply_word_spec (S (S (S (S (S (S O)))))) Alg.CoreFunSem xy)
multiply64_context
     : @jet_context_for f_simplicity_multiply_64
         (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Word.Word (S (S (S (S (S (S (S O)))))))) (@multiply_word_spec (S (S (S (S (S (S O)))))))
u128_accum_low_balance
     : forall lo a : Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.add (Integers.Int64.unsigned (u128_accum_lo lo a))
            (BinInt.Z.mul (Integers.Int64.unsigned (bit_long (u128_accum_carry lo a))) Integers.Int64.modulus))
         (BinInt.Z.add (Integers.Int64.unsigned lo) (Integers.Int64.unsigned a))
u128_accum_machine_observation
     : forall (hi lo a : Integers.Int64.int)
         (_ : BinInt.Z.lt
                (BinInt.Z.add
                   (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned hi) Integers.Int64.modulus)
                      (Integers.Int64.unsigned lo)) (Integers.Int64.unsigned a))
                (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)),
       @eq BinNums.Z
         (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned (u128_accum_hi hi lo a)) Integers.Int64.modulus)
            (Integers.Int64.unsigned (u128_accum_lo lo a)))
         (BinInt.Z.add
            (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned hi) Integers.Int64.modulus)
               (Integers.Int64.unsigned lo)) (Integers.Int64.unsigned a))
u128_accum_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge0) _secp256k1_u128_accum_u64)
         (@Some Values.block (jet_symbol_block _secp256k1_u128_accum_u64))
u128_accum_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv ge0)
            (Values.Vptr (jet_symbol_block _secp256k1_u128_accum_u64) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f_secp256k1_u128_accum_u64))
eval_u128_accum_hi_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (hi lo a : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _t'1 le) (@Some Values.val (Values.Vlong hi)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _t'2 le)
                (@Some Values.val (Values.Vlong (u128_accum_lo lo a))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _a le) (@Some Values.val (Values.Vlong a))),
       Clight.eval_expr ge0 e le m u128_accum_hi_expr (Values.Vlong (u128_accum_hi hi lo a))
eval_u128_accum_layout
     : forall (m : Memory.Mem.mem) (br : Values.block) (base : BinNums.Z) (hi lo a : Integers.Int64.int)
         (_ : frame_base_valid base) (_ : Memory.Mem.valid_access m AST.Mint64 br base Memtype.Writable)
         (_ : Memory.Mem.valid_access m AST.Mint64 br
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m br base) (@Some Values.val (Values.Vlong lo)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint64 m br
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Values.val (Values.Vlong hi))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_secp256k1_u128_accum_u64)
               (@cons Values.val (Values.Vptr br (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vlong a) (@nil Values.val))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf br base)
                  (@Some Values.val (Values.Vlong (u128_accum_lo lo a))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf br
                        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val (Values.Vlong (u128_accum_hi hi lo a))))
                  (and
                     (forall (chunk : AST.memory_chunk) (bb : Values.block) (addr : BinNums.Z)
                        (_ : or (not (@eq Values.block bb br))
                               (or (BinInt.Z.le (BinInt.Z.add addr (Memdata.size_chunk chunk)) base)
                                  (BinInt.Z.le
                                     (BinInt.Z.add base
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     addr))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf bb addr) (Memory.Mem.load chunk m bb addr))
                     (and
                        (forall (bb : Values.block) (addr : BinNums.Z) (kind : Memtype.perm_kind)
                           (p : Memtype.permission) (_ : Memory.Mem.perm m bb addr kind p),
                         Memory.Mem.perm mf bb addr kind p)
                        (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m)))))))
full_multiply64_machine_observation
     : forall (a b u v : Integers.Int64.int)
         (_ : BinInt.Z.lt
                (BinInt.Z.add
                   (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
                      (Integers.Int64.unsigned u)) (Integers.Int64.unsigned v))
                (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)),
       @eq BinNums.Z
         (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned (full_multiply64_hi a b u v)) Integers.Int64.modulus)
            (Integers.Int64.unsigned (full_multiply64_lo a b u v)))
         (BinInt.Z.add
            (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
               (Integers.Int64.unsigned u)) (Integers.Int64.unsigned v))
full_multiply64_representation
     : forall (x y z w : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (a b u v : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned a)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned b)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) y))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned u)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) z))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned v)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S O))))))) w)),
       @eq
         (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))))
         (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
               (Integers.Int64.unsigned (full_multiply64_hi a b u v)))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
               (Integers.Int64.unsigned (full_multiply64_lo a b u v))))
         (@Word.fullMultiplier (S (S (S (S (S (S O)))))) Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                  x y)
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                  z w)))
call_frame_u128_mul
     : forall (le : Maps.PTree.tree Values.val) (m mk : Memory.Mem.mem) (bl br : Values.block)
         (a b : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _x le) (@Some Values.val (Values.Vlong a)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _y le) (@Some Values.val (Values.Vlong b)))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_secp256k1_u128_mul)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong a) (@cons Values.val (Values.Vlong b) (@nil Values.val)))) Events.E0
                mk Values.Vundef),
       ClightBigstep.Clight2.exec_stmt ge0 (e_frame_u128 bl br) le m frame_u128_mul_call Events.E0 le mk
         ClightBigstep.Out_normal
call_frame_u128_accum
     : forall (id : BinNums.positive) (le : Maps.PTree.tree Values.val) (m mk : Memory.Mem.mem)
         (bl br : Values.block) (a : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le) (@Some Values.val (Values.Vlong a)))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_secp256k1_u128_accum_u64)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong a) (@nil Values.val))) Events.E0 mk Values.Vundef),
       ClightBigstep.Clight2.exec_stmt ge0 (e_frame_u128 bl br) le m (frame_u128_accum_call id) Events.E0 le mk
         ClightBigstep.Out_normal
eval_full_multiply64_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem')
         (mc mr1 mr2 mr3 mr4 mk mz mw me mf : Memory.Mem.mem) (bl br bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval) (a b u v : Integers.Int64.int)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block mb br))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes mb bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes mb bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mc (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr1
                (Values.Vlong a))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr1 (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong b))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr2 (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr3
                (Values.Vlong u))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr3 (@Ctypes.Internal Clight.function f_simplicity_read64)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr4
                (Values.Vlong v))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr4 (@Ctypes.Internal Clight.function f_secp256k1_u128_mul)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong a) (@cons Values.val (Values.Vlong b) (@nil Values.val)))) Events.E0
                mk Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mk (@Ctypes.Internal Clight.function f_secp256k1_u128_accum_u64)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong u) (@nil Values.val))) Events.E0 mz Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mz (@Ctypes.Internal Clight.function f_secp256k1_u128_accum_u64)
                (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong v) (@nil Values.val))) Events.E0 mw Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mw (@Ctypes.Internal Clight.function f_write128)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr br Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.free_list me (Clight.blocks_of_env ge0 (e_frame_u128 bl br)))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_full_multiply_64)
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
eval_read_wide_quad_at
     : forall (s : wide_size) (m : Memory.Mem.mem) (bl : Values.block) (base : BinNums.Z) (bi : Values.block)
         (edge rc : BinNums.Z) (x y z w : Ty.tySem (Word.Word (wide_log s))) (_ : frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (wide_bits s)))))
         (_ : frame_fields_at m bl base bi edge rc) (_ : @frame_input_word_at (wide_log s) m bi edge rc x)
         (_ : @frame_input_word_at (wide_log s) m bi edge (BinInt.Z.add rc (wide_bits s)) y)
         (_ : @frame_input_word_at (wide_log s) m bi edge
                (BinInt.Z.add rc (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (wide_bits s))) z)
         (_ : @frame_input_word_at (wide_log s) m bi edge
                (BinInt.Z.add rc (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) (wide_bits s))) w)
         (_ : Memory.Mem.valid_access m AST.Mint64 bl
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : not (@eq Values.block bl bi)),
       @ex Memory.Mem.mem
         (fun mr1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr2 : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mr3 : Memory.Mem.mem =>
                @ex Memory.Mem.mem
                  (fun mr4 : Memory.Mem.mem =>
                   @ex Integers.Int64.int
                     (fun a : Integers.Int64.int =>
                      @ex Integers.Int64.int
                        (fun b : Integers.Int64.int =>
                         @ex Integers.Int64.int
                           (fun u : Integers.Int64.int =>
                            @ex Integers.Int64.int
                              (fun v : Integers.Int64.int =>
                               and
                                 (ClightBigstep.Clight2.eval_funcall ge0 m
                                    (@Ctypes.Internal Clight.function (wide_reader s))
                                    (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base)) (@nil Values.val))
                                    Events.E0 mr1 (Values.Vlong a))
                                 (and
                                    (ClightBigstep.Clight2.eval_funcall ge0 mr1
                                       (@Ctypes.Internal Clight.function (wide_reader s))
                                       (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base)) (@nil Values.val))
                                       Events.E0 mr2 (Values.Vlong b))
                                    (and
                                       (ClightBigstep.Clight2.eval_funcall ge0 mr2
                                          (@Ctypes.Internal Clight.function (wide_reader s))
                                          (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base))
                                             (@nil Values.val)) Events.E0 mr3 (Values.Vlong u))
                                       (and
                                          (ClightBigstep.Clight2.eval_funcall ge0 mr3
                                             (@Ctypes.Internal Clight.function (wide_reader s))
                                             (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr base))
                                                (@nil Values.val)) Events.E0 mr4 (Values.Vlong v))
                                          (and
                                             (@eq BinNums.Z (Integers.Int64.unsigned a)
                                                (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x))
                                             (and
                                                (@eq BinNums.Z (Integers.Int64.unsigned b)
                                                   (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) y))
                                                (and
                                                   (@eq BinNums.Z (Integers.Int64.unsigned u)
                                                      (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) z))
                                                   (and
                                                      (@eq BinNums.Z (Integers.Int64.unsigned v)
                                                         (@Word.ToZ.Theory.toZ (Word.WordToZ (...)) w))
                                                      (and
                                                         (frame_fields_at mr4 bl base bi edge (BinInt.Z.add rc (...)))
                                                         (and (forall ... ... ... ..., @eq ... ... ...)
                                                            (and (...) (...)))))))))))))))))))
eval_full_multiply64_layout_matches_spec
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (x y z w : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (cursor rc : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge rc x)
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) y)
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) z)
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))) w)
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_full_multiply_64)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S (S (S (S (S O))))))))
                     (@Word.fullMultiplier (S (S (S (S (S (S O)))))) Alg.CoreFunSem
                        (@pair
                           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
                           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) x y)
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) z w)))))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     (forall (chunk : AST.memory_chunk) (bb : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m bb)
                        (_ : or (not (@eq Values.block bb bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block bb bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf bb ofs) (Memory.Mem.load chunk m bb ofs))))))
full_multiply64_local_spec
     : jet_local_spec f_simplicity_full_multiply_64
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
            (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))))
         (Word.Word (S (S (S (S (S (S (S O))))))))
         (fun
            input : Ty.tySem
                      (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
                         (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))) =>
          @Word.fullMultiplier (S (S (S (S (S (S O)))))) Alg.CoreFunSem input)
full_multiply64_spec_parametric
     : @Alg.Core.Parametric
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
            (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))))
         (Word.Word (S (S (S (S (S (S (S O)))))))) (@Word.fullMultiplier (S (S (S (S (S (S O)))))))
full_multiply64_context
     : @jet_context_for f_simplicity_full_multiply_64
         (Ty.Prod (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
            (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))))
         (Word.Word (S (S (S (S (S (S (S O)))))))) (@Word.fullMultiplier (S (S (S (S (S (S O)))))))
buffer_empty_spec_parametric
     : forall (X : Ty.Ty) (depth : nat) (A : Ty.Ty),
       @Alg.Core.Parametric A (buffer_type X depth) (@buffer_empty_spec X depth A)
buffer_empty_spec_value
     : forall (X : Ty.Ty) (depth : nat) (A : Ty.Ty) (a : Ty.tySem A),
       @eq (Ty.tySem (buffer_type X depth)) (@buffer_empty_spec X depth A Alg.CoreFunSem a)
         (buffer_empty_value X depth)
encode_empty_sum
     : forall X : Ty.Ty,
       @eq (list Cell)
         (@encode (Ty.Sum Ty.Unit X)
            (@inl unit
               ((fix tySem (X0 : Ty.Ty) : Set :=
                   match X0 return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end) X) tt))
         (@cons (option bool) (@Some bool false) (@List.repeat (option bool) (@None bool) (bitSize X)))
buffer_empty_value_cells
     : forall (X : Ty.Ty) (depth : nat),
       @eq (list Cell) (@encode (buffer_type X depth) (buffer_empty_value X depth)) (buffer_empty_cells X depth)
buffer_empty_spec_cells
     : forall (X : Ty.Ty) (depth : nat) (A : Ty.Ty) (a : Ty.tySem A),
       @eq (list Cell) (@encode (buffer_type X depth) (@buffer_empty_spec X depth A Alg.CoreFunSem a))
         (buffer_empty_cells X depth)
buffer63_byte_cells_length
     : @eq nat (@length Cell (buffer_empty_cells (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))))
sha256_ctx8_init_spec_parametric
     : @Alg.Core.Parametric Ty.Unit sha256_ctx8_type (@sha256_ctx8_init_spec)
sha256_ctx8_init_spec_value
     : @eq (Ty.tySem sha256_ctx8_type) (@sha256_ctx8_init_spec Alg.CoreFunSem tt)
         (@pair (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
            (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
            (buffer_empty_value (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@Word.zero (S (S (S (S (S (S O)))))) Alg.CoreFunSem tt) (@sha256_iv_spec Alg.CoreFunSem tt)))
encode_ctx_product
     : forall (A B : Ty.Ty) (a : Ty.tySem A) (b : Ty.tySem B),
       @eq (list Cell) (@encode (Ty.Prod A B) (@pair (Ty.tySem A) (Ty.tySem B) a b))
         (@app Cell (@encode A a) (@encode B b))
sha256_ctx8_init_spec_cells
     : @eq (list Cell) (@encode sha256_ctx8_type (@sha256_ctx8_init_spec Alg.CoreFunSem tt))
         (@app Cell (buffer_empty_cells (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
            (@app Cell
               (@encode (Word.Word (S (S (S (S (S (S O))))))) (@Word.zero (S (S (S (S (S (S O)))))) Alg.CoreFunSem tt))
               (uint32_word_cells sha256_iv_words)))
sha256_ctx8_type_bits
     : @eq nat (bitSize sha256_ctx8_type)
         (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))))
write_frame_at_after_padding
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor n count : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 n) (_ : BinInt.Z.le BinNums.Z0 count)
         (_ : write_frame_at m bf base bw edge cursor (BinInt.Z.add n count))
         (_ : frame_fields_at mf bf base bw edge (BinInt.Z.sub cursor n))
         (_ : forall (chunk : AST.memory_chunk) (bb : Values.block) (ofs : BinNums.Z)
                (_ : or (not (@eq Values.block bb bf))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                          (BinInt.Z.le
                             (BinInt.Z.add base
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs))),
              @eq (option Values.val) (Memory.Mem.load chunk mf bb ofs) (Memory.Mem.load chunk m bb ofs))
         (_ : forall (bb : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                (_ : Memory.Mem.perm m bb ofs kind p), Memory.Mem.perm mf bb ofs kind p),
       write_frame_at mf bf base bw edge (BinInt.Z.sub cursor n) count
eval_empty_buffer_segment
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (count : nat) (tail : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 tail)
         (_ : write_frame_at m bf base bw edge cursor
                (BinInt.Z.add (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinInt.Z.of_nat count)) tail)),
       @ex Memory.Mem.mem
         (fun mb : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_writeBit)
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                     (@cons Values.val (Values.Vint Integers.Int.zero) (@nil Values.val))) Events.E0 mb
                  (Values.Vint Integers.Int.zero))
               (and
                  (ClightBigstep.Clight2.eval_funcall ge0 mb (@Ctypes.Internal Clight.function f_skipBits)
                     (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                        (@cons Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat count)))
                           (@nil Values.val))) Events.E0 mf Values.Vundef)
                  (and
                     (frame_output_cells_at mf bw edge cursor
                        (@cons (option bool) (@Some bool false) (@List.repeat (option bool) (@None bool) count)))
                     (and (write_prefix_at m mf bw edge cursor)
                        (and
                           (write_frame_at mf bf base bw edge
                              (BinInt.Z.sub cursor (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinInt.Z.of_nat count)))
                              tail)
                           (and
                              (loads_outside_ranges m mf bf
                                 (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 (BinInt.Z.add base
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                                 (BinInt.Z.add edge
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       (BinInt.Z.div
                                          (BinInt.Z.sub cursor
                                             (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinInt.Z.of_nat count)))
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
