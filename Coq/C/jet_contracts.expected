                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat
                                                    (bitSize
                                                       (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
full_add8_context_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))
                 a) (newWriteFrame (bitSize (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))
                 a)
              (fullWriteFrame
                 (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S O)))))
                    (@full_add8_spec Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f_simplicity_full_add_8)
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@full_add8_spec Naive.translate) (Running s0) (Running s1))))
wide_full_add_values_denote_input
     : forall (s : wide_size) (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (x y : Ty.tySem (Word.Word (wide_log s)))
         (r t : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) y)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (wide_log s))))
         (@pair (sum unit unit) (Ty.tySem (Word.Word (wide_log s)))
            match wide_full_add_carry s (Bit.toBool c) r t return (sum unit unit) with
            | true => @inr unit unit tt
            | false => @inl unit unit tt
            end (decode_wide s (Integers.Int64.zero_ext (wide_bits s) (wide_full_add_payload (Bit.toBool c) r t))))
         (@wide_full_add_spec s Alg.CoreFunSem
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
               (prod (Ty.tySem (Word.Word (wide_log s))) (Ty.tySem (Word.Word (wide_log s)))) c
               (@pair (Ty.tySem (Word.Word (wide_log s))) (Ty.tySem (Word.Word (wide_log s))) x y)))
wide_full_add_spec_parametric
     : forall s : wide_size,
       @Alg.Core.Parametric
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s))))
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s))) (@wide_full_add_spec s)
eval_wide_full_add_layout_matches_spec
     : forall (env : Values.val) (s : wide_size) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (c : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (x y : Ty.tySem (Word.Word (wide_log s)))
         (cursor rc : BinNums.Z) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (wide_bits s))))))
         (_ : frame_input_bit_at m bi edge rc (Bit.toBool c))
         (_ : @frame_input_word_at (wide_log s) m bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) x)
         (_ : @frame_input_word_at (wide_log s) m bi edge
                (BinInt.Z.add (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) (wide_bits s)) y)
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.add (BinNums.Zpos BinNums.xH) (wide_bits s))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (wide_full_add s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (wide_log s)))
                     (@wide_full_add_spec s Alg.CoreFunSem
                        (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
                           (prod (Ty.tySem (Word.Word (wide_log s))) (Ty.tySem (Word.Word (wide_log s)))) c
                           (@pair (Ty.tySem (Word.Word (wide_log s))) (Ty.tySem (Word.Word (wide_log s))) x y)))))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.add (BinNums.Zpos BinNums.xH) (wide_bits s))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.add (BinNums.Zpos BinNums.xH) (wide_bits s)))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
