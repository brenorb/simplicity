                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))),
       write_prefix_at m mf bw edge cursor
frame_output_bit_prefix_preserved
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor low q : BinNums.Z) (bit : bool)
         (_ : or (not (@eq Values.block bf bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add
                         (BinInt.Z.add edge
                            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                               (BinInt.Z.div q
                                  (BinNums.Zpos
                                     (BinNums.xO
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) base)
                   (BinInt.Z.le
                      (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (BinInt.Z.add edge
                         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (BinInt.Z.div q
                               (BinNums.Zpos
                                  (BinNums.xO
                                     (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 cursor) (BinInt.Z.le cursor q)) (_ : write_prefix_at m mf bw edge cursor)
         (_ : loads_outside_ranges m mf bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                low
                (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : frame_output_bit_at m bw edge q bit), frame_output_bit_at mf bw edge q bit
frame_output_cells_prefix_preserved
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor low original : BinNums.Z) (cells : list Cell)
         (_ : forall (i : nat) (_ : lt i (@length Cell cells)),
              or (not (@eq Values.block bf bw))
                (or
                   (BinInt.Z.le
                      (BinInt.Z.add (write_cell_address edge original (BinInt.Z.of_nat i))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) base)
                   (BinInt.Z.le
                      (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                      (write_cell_address edge original (BinInt.Z.of_nat i)))))
         (_ : and (BinInt.Z.le BinNums.Z0 cursor)
                (BinInt.Z.le cursor (BinInt.Z.sub original (BinInt.Z.of_nat (@length Cell cells)))))
         (_ : write_prefix_at m mf bw edge cursor)
         (_ : loads_outside_ranges m mf bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                low
                (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (_ : frame_output_cells_at m bw edge original cells), frame_output_cells_at mf bw edge original cells
write32s_body_shape
     : @eq Clight.statement (Clight.fn_body f_write32s) (Clight.Sloop write32s_loop_body write32s_loop_step)
exec_write32s_body
     : forall (m mi : Memory.Mem.mem) (le : Maps.PTree.tree Values.val) (bi : Values.block)
         (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (x : Integers.Int.int)
