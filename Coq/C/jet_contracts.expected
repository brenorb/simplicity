Inductive ternary_op : Set :=  TMaj : ternary_op | TXorXor : ternary_op | TCh : ternary_op.
ternary_bool =
fun (k : ternary_op) (x y z : bool) =>
match k return bool with
| TMaj => orb (orb (andb x y) (andb y z)) (andb z x)
| TXorXor => xorb (xorb x y) z
| TCh => orb (andb x y) (andb (negb x) z)
end
     : forall (_ : ternary_op) (_ : bool) (_ : bool) (_ : bool), bool

Arguments ternary_bool k (x y z)%bool_scope
ternary_int64 =
fun (k : ternary_op) (x y z : Integers.Int64.int) =>
match k return Integers.Int64.int with
| TMaj =>
    Integers.Int64.or (Integers.Int64.or (Integers.Int64.and x y) (Integers.Int64.and y z)) (Integers.Int64.and z x)
| TXorXor => Integers.Int64.xor (Integers.Int64.xor x y) z
| TCh =>
    Integers.Int64.or (Integers.Int64.and x y)
      (Integers.Int64.and (Integers.Int64.not (Integers.Int64.mul Integers.Int64.one x)) z)
end
     : forall (_ : ternary_op) (_ : Integers.Int64.int) (_ : Integers.Int64.int) (_ : Integers.Int64.int),
       Integers.Int64.int

Arguments ternary_int64 k x y z
ternary_int =
fun (k : ternary_op) (x y z : Integers.Int.int) =>
match k return Integers.Int.int with
| TMaj => Integers.Int.or (Integers.Int.or (Integers.Int.and x y) (Integers.Int.and y z)) (Integers.Int.and z x)
| TXorXor => Integers.Int.xor (Integers.Int.xor x y) z
| TCh =>
    Integers.Int.or (Integers.Int.and x y)
      (Integers.Int.and (Integers.Int.not (Integers.Int.mul Integers.Int.one x)) z)
end
     : forall (_ : ternary_op) (_ : Integers.Int.int) (_ : Integers.Int.int) (_ : Integers.Int.int), Integers.Int.int

Arguments ternary_int k x y z
ternary_bit_spec =
fun (k : ternary_op) (term : Alg.Core.Algebra) =>
match
  k
  return
    (Alg.Core.domain term
       (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit)))
       (Ty.Sum Ty.Unit Ty.Unit))
with
| TMaj => @Bit.maj term
| TXorXor => @Bit.xor3 term
| TCh => @Bit.ch (Ty.Sum Ty.Unit Ty.Unit) term
end
     : forall (_ : ternary_op) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit)))
         (Ty.Sum Ty.Unit Ty.Unit)

Arguments ternary_bit_spec k {term}
ternary_word_spec =
fun (n : nat) (k : ternary_op) (term : Alg.Core.Algebra) =>
@Word.bitwiseTri (Ty.Sum Ty.Unit Ty.Unit) n term (@ternary_bit_spec k term)
     : forall (n : nat) (_ : ternary_op) (term : Alg.Core.Algebra),
       Alg.Core.domain term
         (Ty.Prod (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n)
            (Ty.Prod (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n)))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) n)

Arguments ternary_word_spec n%nat_scope k {term}
Word.bitwiseTri =
fix bitwiseTri
  (X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra) (op : Alg.Core.domain term (Ty.Prod X (Ty.Prod X X)) X) {struct n} :
    Alg.Core.domain term (Ty.Prod (Word.Vector X n) (Ty.Prod (Word.Vector X n) (Word.Vector X n))) (Word.Vector X n) :=
  match
    n as n0
    return
      (Alg.Core.domain term (Ty.Prod (Word.Vector X n0) (Ty.Prod (Word.Vector X n0) (Word.Vector X n0)))
         (Word.Vector X n0))
  with
  | O => op
  | S n0 => @Word.buildBitwiseTri (Word.Vector X n0) term (bitwiseTri X n0 term op)
  end
     : forall (X : Ty.Ty) (n : nat) (term : Alg.Core.Algebra) (_ : Alg.Core.domain term (Ty.Prod X (Ty.Prod X X)) X),
       Alg.Core.domain term (Ty.Prod (Word.Vector X n) (Ty.Prod (Word.Vector X n) (Word.Vector X n))) (Word.Vector X n)

Arguments Word.bitwiseTri {X}%ty_scope {n}%nat_scope {term} op
Word.buildBitwiseTri =
fun (W : Ty.Ty) (term : Alg.Core.Algebra) (rec : Alg.Core.domain term (Ty.Prod W (Ty.Prod W W)) W) =>
@Alg.Core.Combinators.pair (Ty.Prod (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W))) W W term
  (@Alg.Core.Combinators.comp (Ty.Prod (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W)))
     (Ty.Prod W (Ty.Prod W W)) W term
     (@Alg.Core.Combinators.pair (Ty.Prod (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W))) W
        (Ty.Prod W W) term
        (@Alg.Core.Combinators.take (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W)) W term
           (@Alg.Core.Combinators.take W W W term (@Alg.Core.Combinators.iden W term)))
        (@Alg.Core.Combinators.pair (Ty.Prod (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W))) W W term
           (@Alg.Core.Combinators.drop (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W)) W term
              (@Alg.Core.Combinators.take (Ty.Prod W W) (Ty.Prod W W) W term
                 (@Alg.Core.Combinators.take W W W term (@Alg.Core.Combinators.iden W term))))
           (@Alg.Core.Combinators.drop (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W)) W term
              (@Alg.Core.Combinators.drop (Ty.Prod W W) (Ty.Prod W W) W term
                 (@Alg.Core.Combinators.take W W W term (@Alg.Core.Combinators.iden W term)))))) rec)
  (@Alg.Core.Combinators.comp (Ty.Prod (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W)))
     (Ty.Prod W (Ty.Prod W W)) W term
     (@Alg.Core.Combinators.pair (Ty.Prod (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W))) W
        (Ty.Prod W W) term
        (@Alg.Core.Combinators.take (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W)) W term
           (@Alg.Core.Combinators.drop W W W term (@Alg.Core.Combinators.iden W term)))
        (@Alg.Core.Combinators.pair (Ty.Prod (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W))) W W term
           (@Alg.Core.Combinators.drop (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W)) W term
              (@Alg.Core.Combinators.take (Ty.Prod W W) (Ty.Prod W W) W term
                 (@Alg.Core.Combinators.drop W W W term (@Alg.Core.Combinators.iden W term))))
           (@Alg.Core.Combinators.drop (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W)) W term
              (@Alg.Core.Combinators.drop (Ty.Prod W W) (Ty.Prod W W) W term
                 (@Alg.Core.Combinators.drop W W W term (@Alg.Core.Combinators.iden W term)))))) rec)
     : forall (W : Ty.Ty) (term : Alg.Core.Algebra) (_ : Alg.Core.domain term (Ty.Prod W (Ty.Prod W W)) W),
       Alg.Core.domain term (Ty.Prod (Ty.Prod W W) (Ty.Prod (Ty.Prod W W) (Ty.Prod W W))) (Ty.Prod W W)

Arguments Word.buildBitwiseTri {W}%ty_scope {term} rec
