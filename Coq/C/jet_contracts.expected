read4_narrow =
fun w : Integers.Int64.int =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
  (Integers.Int.repr (Integers.Int64.unsigned w))
     : forall _ : Integers.Int64.int, Integers.Int.int

Arguments read4_narrow w
read4_crossing_high =
fun (k : BinNums.Z) (high : Integers.Int64.int) =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
  (Integers.Int.or Integers.Int.zero
     (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
        (Integers.Int.shl (read4_narrow (Integers.Int64.zero_ext k high))
           (Integers.Int64.loword
              (Integers.Int64.repr (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) k))))))
     : forall (_ : BinNums.Z) (_ : Integers.Int64.int), Integers.Int.int

Arguments read4_crossing_high k%Z_scope high
read4_crossing_result =
fun (k : BinNums.Z) (high low : Integers.Int64.int) =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
  (Integers.Int.or (read4_crossing_high k high)
     (read4_narrow
        (Integers.Int64.zero_ext (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) k)
           (Integers.Int64.shru low
              (Integers.Int64.repr
                 (BinInt.Z.add
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))) k))))))
     : forall (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int.int

Arguments read4_crossing_result k%Z_scope high low
read4_layout_result =
fun (cursor : BinNums.Z) (high low : Integers.Int64.int) =>
match
  ZArith_dec.Z_le_dec
    (BinInt.Z.modulo cursor
       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
  return Integers.Int.int
with
| left _ =>
    read4_at
      (BinInt.Z.modulo cursor
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) high
| right _ =>
    read4_crossing_result
      (BinInt.Z.sub
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (BinInt.Z.modulo cursor
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
      high low
end
     : forall (_ : BinNums.Z) (_ : Integers.Int64.int) (_ : Integers.Int64.int), Integers.Int.int

