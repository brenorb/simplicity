eval_parse_sequence_writer
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (r : Integers.Int64.int)
         (_ : write_frame_at m bf base bw edge cursor
                (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))),
       @ex Memory.Mem.mem
         (fun mb : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_writeBit)
                  (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                     (@cons Values.val
                        (Values.Vint
                           match parse_sequence_enabled r return Integers.Int.int with
                           | true => Integers.Int.one
                           | false => Integers.Int.zero
                           end) (@nil Values.val))) Events.E0 mb
                  (Values.Vint
                     match parse_sequence_enabled r return Integers.Int.int with
                     | true => Integers.Int.one
                     | false => Integers.Int.zero
                     end))
               (and (parse_sequence_branch_calls mb mf bf (Integers.Ptrofs.repr base) r)
                  (and
                     (frame_output_cells_at mf bw edge cursor
                        (@encode (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
                           match
                             parse_sequence_enabled r
                             return
                               (Ty.tySem
                                  (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))))
                           with
                           | true =>
                               @inr unit
                                 (sum (Ty.tySem (Word.Word (wide_log W16))) (Ty.tySem (Word.Word (wide_log W16))))
                                 match
                                   parse_sequence_tag r
                                   return
                                     (sum (Ty.tySem (Word.Word (wide_log W16))) (Ty.tySem (Word.Word (wide_log W16))))
                                 with
                                 | true =>
                                     @inr (Ty.tySem (Word.Word (wide_log W16))) (Ty.tySem (Word.Word (wide_log W16)))
                                       (decode_wide W16
                                          (Integers.Int64.zero_ext
                                             (BinNums.Zpos
                                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                             (parse_sequence_payload r)))
                                 | false =>
                                     @inl (Ty.tySem (Word.Word (wide_log W16))) (Ty.tySem (Word.Word (wide_log W16)))
                                       (decode_wide W16
                                          (Integers.Int64.zero_ext
                                             (BinNums.Zpos
                                                (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                             (parse_sequence_payload r)))
                                 end
                           | false =>
                               @inl unit
                                 (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))) tt
                           end))
                     (and (write_prefix_at m mf bw edge cursor)
                        (and
                           (frame_fields_at mf bf base bw edge
                              (BinInt.Z.sub cursor
                                 (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                           (and
                              (loads_outside_ranges m mf bf
                                 (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                 (BinInt.Z.add base
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                                 (BinInt.Z.add edge
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                       (BinInt.Z.div
                                          (BinInt.Z.sub cursor
                                             (BinNums.Zpos
                                                (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                                 (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                              (and
                                 (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                                    (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                                  Memory.Mem.perm mf b ofs kind p)
                                 (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                  Memory.Mem.valid_block mf b)))))))))
eval_parse_sequence_layout_matches_spec
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (x : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (cursor read_cursor : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor)
         (_ : and (BinInt.Z.le BinNums.Z0 read_cursor)
                (BinInt.Z.le read_cursor
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
         (_ : @frame_input_word_at (S (S (S (S (S O))))) m bi edge read_cursor x)
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_parse_sequence)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
                     (@parse_sequence_spec Alg.CoreFunSem x)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos
                                                    (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
parse_sequence_local_spec
     : jet_local_spec f_simplicity_parse_sequence (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Ty.Sum (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))))
