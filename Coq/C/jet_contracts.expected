extend_word8_guarantees
     : forall (s : extend_word8_size) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z) (a : Ty.tySem (Word.Word (S (S (S O)))))
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O)))))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor (@encode (Word.Word (S (S (S O)))) a))
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinInt.Z.of_nat (bitSize (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (extend_word8_function s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))
                     (@left_extend_word_spec (S (S (S O))) (extend_word8_depth s) Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor
                           (BinInt.Z.of_nat (bitSize (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat
                                                    (bitSize
                                                       (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s)))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
extend_word8_context_guarantees
     : forall (s : extend_word8_size) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout)
         (ctx : Context) (a : Ty.tySem (Word.Word (S (S (S O))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S O)))) a)
              (newWriteFrame (bitSize (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S O)))) a)
              (fullWriteFrame
                 (@encode (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))
                    (@left_extend_word_spec (S (S (S O))) (extend_word8_depth s) Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (extend_word8_function s)) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@left_extend_word_spec (S (S (S O))) (extend_word8_depth s) Naive.translate)
                  (Running s0) (Running s1))))
frame_fields =
fun (m : Memory.Mem.mem) (bf bw : Values.block) (edge cursor : BinNums.Z) =>
and
  (@eq (option Values.val) (Memory.Mem.load AST.Mptr m bf BinNums.Z0)
     (@Some Values.val (Values.Vptr bw (Integers.Ptrofs.repr edge))))
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint64 m bf (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
     (@Some Values.val (Values.Vlong (Integers.Int64.repr cursor))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z), Prop

Arguments frame_fields m bf bw (edge cursor)%Z_scope
read_cell_address =
fun edge cursor i : BinNums.Z =>
BinInt.Z.sub edge
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
     (BinInt.Z.add (BinNums.Zpos BinNums.xH)
        (BinInt.Z.div (BinInt.Z.add cursor i)
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments read_cell_address (edge cursor i)%Z_scope
read_cell_bit =
fun cursor i : BinNums.Z =>
BinInt.Z.sub (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))
  (BinInt.Z.modulo (BinInt.Z.add cursor i)
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments read_cell_bit (cursor i)%Z_scope
write_cell_address =
fun edge cursor i : BinNums.Z =>
BinInt.Z.add edge
  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
     (BinInt.Z.div (BinInt.Z.sub (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) i)
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments write_cell_address (edge cursor i)%Z_scope
write_cell_bit =
fun cursor i : BinNums.Z =>
BinInt.Z.modulo (BinInt.Z.sub (BinInt.Z.sub cursor (BinNums.Zpos BinNums.xH)) i)
  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : forall (_ : BinNums.Z) (_ : BinNums.Z), BinNums.Z

Arguments write_cell_bit (cursor i)%Z_scope
read_frame =
fun (m : Memory.Mem.mem) (bf bw : Values.block) (edge cursor : BinNums.Z) (cells : list bool) =>
and (frame_fields m bf bw edge cursor)
  (and (BinInt.Z.le BinNums.Z0 cursor)
     (and (BinInt.Z.le (BinInt.Z.add cursor (BinInt.Z.of_nat (@length bool cells))) Integers.Int64.max_unsigned)
        (forall (i : nat) (bit : bool) (_ : @eq (option bool) (@List.nth_error bool cells i) (@Some bool bit)),
         @ex Integers.Int64.int
           (fun w : Integers.Int64.int =>
            and
              (@eq (option Values.val)
                 (Memory.Mem.load AST.Mint64 m bw (read_cell_address edge cursor (BinInt.Z.of_nat i)))
                 (@Some Values.val (Values.Vlong w)))
              (@eq bool (Integers.Int64.testbit w (read_cell_bit cursor (BinInt.Z.of_nat i))) bit)))))
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : list bool), Prop

Arguments read_frame m bf bw (edge cursor)%Z_scope cells%list_scope
write_frame =
fun (m : Memory.Mem.mem) (bf bw : Values.block) (edge cursor count : BinNums.Z) =>
and (frame_fields m bf bw edge cursor)
  (and (and (BinInt.Z.le BinNums.Z0 count) (BinInt.Z.le count cursor))
     (and (BinInt.Z.le cursor Integers.Int64.max_unsigned)
        (and (not (@eq Values.block bf bw))
           (and
              (Memory.Mem.valid_access m AST.Mint64 bf (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                 Memtype.Writable)
              (forall (i : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 i) (BinInt.Z.lt i count)),
               let addr : BinNums.Z := write_cell_address edge cursor i in
               and (BinInt.Z.le BinNums.Z0 addr)
                 (and
                    (BinInt.Z.le (BinInt.Z.add addr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                       Integers.Ptrofs.max_unsigned)
                    (and (Memory.Mem.valid_access m AST.Mint64 bw addr Memtype.Writable)
                       (@ex Integers.Int64.int
                          (fun w : Integers.Int64.int =>
                           @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw addr)
                             (@Some Values.val (Values.Vlong w)))))))))))
