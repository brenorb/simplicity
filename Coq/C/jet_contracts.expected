         (n : nat),
       and
         (BinInt.Z.le (@fst BinNums.Z BinNums.Z (write_bounds n)) (Integers.Int64.unsigned (write_fe_rho value rc n)))
         (BinInt.Z.le (Integers.Int64.unsigned (write_fe_rho value rc n)) (@snd BinNums.Z BinNums.Z (write_bounds n)))
write_shifted_limb_value
     : forall (value rc : BinNums.Z) (n : nat)
