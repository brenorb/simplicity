an_write_context_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv sha_ge)
            (Values.Vptr (sha_symbol_block jets_sha._simplicity_write_sha256_context) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function f_simplicity_write_sha256_context))
an_blocks
     : forall bm bb bx : Values.block,
       @eq (list (prod (prod Values.block BinNums.Z) BinNums.Z)) (Clight.blocks_of_env sha_ge (an_env bm bb bx))
         (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
            (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bx BinNums.Z0)
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
            (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
               (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bm BinNums.Z0)
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               (@cons (prod (prod Values.block BinNums.Z) BinNums.Z)
                  (@pair (prod Values.block BinNums.Z) BinNums.Z (@pair Values.block BinNums.Z bb BinNums.Z0)
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                  (@nil (prod (prod Values.block BinNums.Z) BinNums.Z)))))
an_entry
     : forall (m : Memory.Mem.mem) (m1 m2 m3 : Memory.Mem.mem') (bm bb bx bd : Values.block)
         (dbase : BinNums.Z) (bsf : Values.block) (sbase : BinNums.Z) (vn : Integers.Int64.int)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block m1 bm))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m1 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                (@pair Memory.Mem.mem' Values.block m2 bb))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m2 BinNums.Z0
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                (@pair Memory.Mem.mem' Values.block m3 bx)),
       Clight.function_entry2 sha_ge jets_sha.f_sha_256_ctx_8_add_n
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bsf (Integers.Ptrofs.repr sbase))
               (@cons Values.val (Values.Vlong vn) (@nil Values.val)))) m (an_env bm bb bx)
         (an_temps bd dbase bsf sbase vn) m3
an_eval_ctx_addr
     : forall (bm bb bx : Values.block) (le : Clight.temp_env) (m : Memory.Mem.mem),
       Clight.eval_expr sha_ge (an_env bm bb bx) le m
         (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
            (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
         (Values.Vptr bx Integers.Ptrofs.zero)
an_eval_buf
     : forall (bm bb bx : Values.block) (le : Clight.temp_env) (m : Memory.Mem.mem),
       Clight.eval_expr sha_ge (an_env bm bb bx) le m
         (Clight.Evar jets_sha._buf
            (Ctypesdefs.tarray Ctypesdefs.tuchar
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (Values.Vptr bb Integers.Ptrofs.zero)
an_call_read
     : forall (bm bb bx : Values.block) (le : Maps.PTree.tree Values.val) (m m' : Memory.Mem.mem)
         (bsf : Values.block) (sbase : BinNums.Z) (v : Values.val)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._src le)
                (@Some Values.val (Values.Vptr bsf (Integers.Ptrofs.repr sbase))))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge m
                (@Ctypes.Internal Clight.function f_simplicity_read_sha256_context)
                (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bsf (Integers.Ptrofs.repr sbase)) (@nil Values.val))) Events.E0 m' v),
       ClightBigstep.Clight2.exec_stmt sha_ge (an_env bm bb bx) le m
         (Clight.Scall (@Some AST.ident jets_sha._t'3)
            (Clight.Evar jets_sha._simplicity_read_sha256_context
               (Ctypes.Tfunction
                  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                     (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)) Ctypes.Tnil))
                  Ctypesdefs.tbool AST.cc_default))
            (@cons Clight.expr
               (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                  (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
               (@cons Clight.expr
                  (Clight.Etempvar jets_sha._src (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
                  (@nil Clight.expr)))) Events.E0 (@Maps.PTree.set Values.val jets_sha._t'3 v le) m'
         ClightBigstep.Out_normal
an_call_read8s
     : forall (bm bb bx : Values.block) (le : Maps.PTree.tree Values.val) (m m' : Memory.Mem.mem)
         (bsf : Values.block) (sbase : BinNums.Z) (vn : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._src le)
                (@Some Values.val (Values.Vptr bsf (Integers.Ptrofs.repr sbase))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._n le) (@Some Values.val (Values.Vlong vn)))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function f_read8s)
                (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vlong vn)
                      (@cons Values.val (Values.Vptr bsf (Integers.Ptrofs.repr sbase)) (@nil Values.val)))) Events.E0
                m' Values.Vundef),
       ClightBigstep.Clight2.exec_stmt sha_ge (an_env bm bb bx) le m an_read8s Events.E0 le m' ClightBigstep.Out_normal
an_call_uchars
     : forall (bm bb bx : Values.block) (le : Maps.PTree.tree Values.val) (m m' : Memory.Mem.mem)
         (vn : Integers.Int64.int) (v : Values.val)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._n le) (@Some Values.val (Values.Vlong vn)))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_sha256_uchars)
                (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero)
                      (@cons Values.val (Values.Vlong vn) (@nil Values.val)))) Events.E0 m' v),
       ClightBigstep.Clight2.exec_stmt sha_ge (an_env bm bb bx) le m an_uchars Events.E0 le m' ClightBigstep.Out_normal
an_call_write
     : forall (bm bb bx : Values.block) (le : Maps.PTree.tree Values.val) (m m' : Memory.Mem.mem)
         (bd : Values.block) (dbase : BinNums.Z) (v : Values.val)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_sha._dst le)
                (@Some Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge m
                (@Ctypes.Internal Clight.function f_simplicity_write_sha256_context)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr bx Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 m' v),
       ClightBigstep.Clight2.exec_stmt sha_ge (an_env bm bb bx) le m
         (Clight.Scall (@Some AST.ident jets_sha._t'4)
            (Clight.Evar jets_sha._simplicity_write_sha256_context
               (Ctypes.Tfunction
                  (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr))
                     (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                        Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
            (@cons Clight.expr
               (Clight.Etempvar jets_sha._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._frameItem Ctypes.noattr)))
               (@cons Clight.expr
                  (Clight.Eaddrof (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
                     (Ctypesdefs.tptr (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))
                  (@nil Clight.expr)))) Events.E0 (@Maps.PTree.set Values.val jets_sha._t'4 v le) m'
         ClightBigstep.Out_normal
u8_nth
     : forall (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
         (_ : uint8_array_at m b base xs) (i : nat) (_ : lt i (@length Integers.Int.int xs)),
       @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m b (BinInt.Z.add base (BinInt.Z.of_nat i)))
         (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i xs Integers.Int.zero)))
u8_of_nth
     : forall (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int xs)),
              @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m b (BinInt.Z.add base (BinInt.Z.of_nat i)))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i xs Integers.Int.zero)))),
       uint8_array_at m b base xs
u32_nth
     : forall (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
         (_ : uint32_array_at m b base xs) (i : nat) (_ : lt i (@length Integers.Int.int xs)),
       @eq (option Values.val)
         (Memory.Mem.load AST.Mint32 m b
            (BinInt.Z.add base (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
         (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i xs Integers.Int.zero)))
u32_of_nth
     : forall (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
         (_ : forall (i : nat) (_ : lt i (@length Integers.Int.int xs)),
              @eq (option Values.val)
                (Memory.Mem.load AST.Mint32 m b
                   (BinInt.Z.add base
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                (@Some Values.val (Values.Vint (@List.nth Integers.Int.int i xs Integers.Int.zero)))),
       uint32_array_at m b base xs
absorb_regs_length
     : forall (bs l : list (Ty.tySem (Word.Word (S (S (S O)))))) (regs : list Integers.Int.int)
         (_ : lt (@length (Ty.tySem (Word.Word (S (S (S O))))) l)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq nat (@length Integers.Int.int regs) (S (S (S (S (S (S (S (S O))))))))),
       @eq nat
         (@length Integers.Int.int
            (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int) (absorb l regs bs)))
         (S (S (S (S (S (S (S (S O))))))))
sg_in_read8s
     : @List.In (prod AST.ident Clight.function) (@pair AST.ident Clight.function _read8s f_read8s) sha_core_helpers
sg_in_write_context
     : @List.In (prod AST.ident Clight.function)
         (@pair AST.ident Clight.function _simplicity_write_sha256_context f_simplicity_write_sha256_context)
         sha_core_helpers
vector_values_pos
     : forall (X : Ty.Ty) (k : nat) (v : Ty.tySem (Word.Vector X k)),
       not (@eq (list (Ty.tySem X)) (vector_values X k v) (@nil (Ty.tySem X)))
pow2_le_512
     : forall (k : nat) (_ : le k (S (S (S (S (S (S (S (S (S O)))))))))),
       and (le (S O) (PeanoNat.Nat.pow (S (S O)) k))
         (le (PeanoNat.Nat.pow (S (S O)) k)
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
eval_sha_add_n
     : forall (_ : memcpy_model) (k : nat) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bsf : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor rc : BinNums.Z)
         (c : Ty.tySem sha256_ctx8_type) (v : Ty.tySem (Word.Vector (Word.Word (S (S (S O)))) k))
         (_ : le k (S (S (S (S (S (S (S (S (S O)))))))))) (_ : sha_globals_ok m) (_ : frame_base_valid sbase)
         (_ : frame_fields_at m bsf sbase bi edge rc)
         (_ : Memory.Mem.valid_access m AST.Mint64 bsf
                (BinInt.Z.add sbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add
                   (BinInt.Z.add rc
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xI
                               (BinNums.xI
                                  (BinNums.xI
                                     (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                      (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) k)))) Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge rc
                (@app Cell (@encode sha256_ctx8_type c) (@encode (Word.Vector (Word.Word (S (S (S O)))) k) v)))
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
         (_ : not (@eq Values.block bsf bi)) (_ : not (@eq Values.block bsf bd)) (_ : not (@eq Values.block bsf bw))
         (_ : not (@eq Values.block bsf (sha_symbol_block jets_sha._sha256_max_counter)))
         (_ : not (@eq Values.block bsf (sha_symbol_block jets_sha._simplicity_sha256_compression))),
       let vs : list (Ty.tySem (Word.Word (S (S (S O))))) := vector_values (Word.Word (S (S (S O)))) k v in
       let spec : option (Ty.tySem sha256_ctx8_type) := ctx8_add_list c vs in
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall sha_ge m
               (@Ctypes.Internal Clight.function jets_sha.f_sha_256_ctx_8_add_n)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bsf (Integers.Ptrofs.repr sbase))
                     (@cons Values.val
                        (Values.Vlong
                           (Integers.Int64.repr (BinInt.Z.of_nat (@length (Ty.tySem (Word.Word (S (S (S O))))) vs))))
                        (@nil Values.val)))) Events.E0 mf (@jet_partial_return (Ty.tySem sha256_ctx8_type) spec))
            (and
               match spec return Prop with
               | Some b =>
                   and (frame_output_cells_at mf bw outedge cursor (@encode sha256_ctx8_type b))
                     (and (write_prefix_at m mf bw outedge cursor)
                        (frame_fields_at mf bd dbase bw outedge
                           (BinInt.Z.sub cursor
                              (BinNums.Zpos
                                 (BinNums.xO
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI
                                             (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))))
               | None => True
               end
               (and
                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : Memory.Mem.valid_block m b)
                     (_ : or (not (@eq Values.block b bd))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add dbase
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                     (_ : or (not (@eq Values.block b bw))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add outedge
                                     (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                        (BinInt.Z.div
                                           (BinInt.Z.sub cursor
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (...)))))))))))
                                           (BinNums.Zpos
                                              (BinNums.xO
                                                 (BinNums.xO
                                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs)))
                     (_ : or (not (@eq Values.block b bsf))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add sbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add sbase
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs))),
                   @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                  (forall (b : Values.block) (ofs : BinNums.Z) (kd : Memtype.perm_kind) (p : Memtype.permission)
                     (_ : Memory.Mem.valid_block m b) (_ : Memory.Mem.perm m b ofs kd p), Memory.Mem.perm mf b ofs kd p))))
an_body
     : @eq Clight.statement (Clight.fn_body jets_sha.f_sha_256_ctx_8_add_n)
         (Clight.Ssequence an_assert (an_init an_rest))
eval_local_ctx_field_lvalue
     : forall (k : ctx_slot) (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bx : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr)))),
       Clight.eval_lvalue sha_ge e le m
         (Clight.Efield (Clight.Evar jets_sha._ctx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))
            (ctx_field k) (ctx_field_type k)) bx
         (Integers.Ptrofs.add Integers.Ptrofs.zero (Integers.Ptrofs.repr (ctx_offset k))) Ctypes.Full
local_ctx_offset
     : forall k : ctx_slot,
       @eq BinNums.Z
         (Integers.Ptrofs.unsigned (Integers.Ptrofs.add Integers.Ptrofs.zero (Integers.Ptrofs.repr (ctx_offset k))))
         (ctx_offset k)
eval_local_midstate_s
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (bm : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._midstate e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr)))),
       Clight.eval_expr sha_ge e le m
         (Clight.Efield (Clight.Evar jets_sha._midstate (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))
            jets_sha._s
            (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (Values.Vptr bm Integers.Ptrofs.zero)
an_assert_exec
     : forall (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem),
       ClightBigstep.Clight2.exec_stmt sha_ge e le m an_assert Events.E0 le m ClightBigstep.Out_normal
init_frame_store
     : forall (ch : AST.memory_chunk) (bx : Values.block) (lo : BinNums.Z) (m : Memory.Mem.mem)
         (ofs : BinNums.Z) (v : Values.val) (m1 : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.store ch m bx ofs v) (@Some Memory.Mem.mem m1))
         (_ : BinInt.Z.le lo ofs), init_frame bx lo m m1
init_frame_trans
     : forall (bx : Values.block) (lo lo' : BinNums.Z) (m1 m2 m3 : Memory.Mem.mem) (_ : BinInt.Z.le lo lo')
         (_ : init_frame bx lo' m1 m2) (_ : init_frame bx lo m2 m3), init_frame bx lo m1 m3
an_blk_init_exec
     : forall (e : Clight.env) (bx : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))))
         (n k : nat) (le0 : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : le (Nat.add k n)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          and
            (forall (rest : Clight.statement) (t : Events.trace) (le' : Clight.temp_env) (m' : Memory.Mem.mem)
               (out : ClightBigstep.outcome) (_ : ClightBigstep.Clight2.exec_stmt sha_ge e le0 m1 rest t le' m' out),
             ClightBigstep.Clight2.exec_stmt sha_ge e le0 m (an_blk_init n k rest) t le' m' out)
            (init_frame bx (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) m m1))
an_init_exec
     : forall (e : Clight.env) (bx bm : Values.block)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._ctx e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bx (Ctypes.Tstruct jets_sha._sha256_context Ctypes.noattr))))
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) jets_sha._midstate e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bm (Ctypes.Tstruct jets_sha._sha256_midstate Ctypes.noattr))))
         (le : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : Memory.Mem.range_perm m bx BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Memtype.Cur Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          and
            (forall (rest : Clight.statement) (t : Events.trace) (le' : Clight.temp_env) (m' : Memory.Mem.mem)
               (out : ClightBigstep.outcome) (_ : ClightBigstep.Clight2.exec_stmt sha_ge e le m1 rest t le' m' out),
             ClightBigstep.Clight2.exec_stmt sha_ge e le m (an_init rest) t le' m' out)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mptr m1 bx BinNums.Z0)
                  (@Some Values.val (Values.Vptr bm Integers.Ptrofs.zero))) (init_frame bx BinNums.Z0 m m1)))
sha_ReadBE32_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv sha_ge) jets_sha._ReadBE32)
         (@Some Values.block (sha_symbol_block jets_sha._ReadBE32))
sha_ReadBE32_funct
     : @eq (option Clight.fundef)
         (@Globalenvs.Genv.find_funct Clight.fundef Ctypes.type (Clight.genv_genv sha_ge)
            (Values.Vptr (sha_symbol_block jets_sha._ReadBE32) Integers.Ptrofs.zero))
         (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function jets_sha.f_ReadBE32))
ptr_byte_offset
     : forall (o : Integers.Ptrofs.int) (i : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 i)
                (BinInt.Z.le i
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))
         (_ : BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned o) i) Integers.Ptrofs.max_unsigned),
       @eq BinNums.Z
         (Integers.Ptrofs.unsigned
            (Integers.Ptrofs.add o
               (Integers.Ptrofs.mul (Integers.Ptrofs.repr (BinNums.Zpos BinNums.xH))
                  (Integers.Ptrofs.of_ints (Integers.Int.repr i))))) (BinInt.Z.add (Integers.Ptrofs.unsigned o) i)
eval_sha_ReadBE32
     : forall (m : Memory.Mem.mem) (b : Values.block) (o : Integers.Ptrofs.int) (x1 x2 x3 x4 : Integers.Int.int)
         (_ : BinInt.Z.le (BinInt.Z.add (Integers.Ptrofs.unsigned o) (BinNums.Zpos (BinNums.xI BinNums.xH)))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m b (Integers.Ptrofs.unsigned o))
                (@Some Values.val (Values.Vint x1)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m b
                   (BinInt.Z.add (Integers.Ptrofs.unsigned o) (BinNums.Zpos BinNums.xH)))
                (@Some Values.val (Values.Vint x2)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m b
                   (BinInt.Z.add (Integers.Ptrofs.unsigned o) (BinNums.Zpos (BinNums.xO BinNums.xH))))
                (@Some Values.val (Values.Vint x3)))
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mint8unsigned m b
                   (BinInt.Z.add (Integers.Ptrofs.unsigned o) (BinNums.Zpos (BinNums.xI BinNums.xH))))
                (@Some Values.val (Values.Vint x4))),
       ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function jets_sha.f_ReadBE32)
         (@cons Values.val (Values.Vptr b o) (@nil Values.val)) Events.E0 m (Values.Vint (c_be32 x1 x2 x3 x4))
lor_shift8
     : forall (hi lo : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 hi)
         (_ : and (BinInt.Z.le BinNums.Z0 lo)
                (BinInt.Z.lt lo
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))),
       @eq BinNums.Z
         (BinInt.Z.lor (BinInt.Z.shiftl hi (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) lo)
         (BinInt.Z.add
            (BinInt.Z.mul hi
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))) lo)
byte_and_255
     : forall (x : Integers.Int.int)
         (_ : BinInt.Z.lt (Integers.Int.unsigned x)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @eq Integers.Int.int
         (Integers.Int.and x
            (Integers.Int.repr
               (BinNums.Zpos
                  (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
         x
c_be32_be32
     : forall (x1 x2 x3 x4 : Integers.Int.int)
         (_ : BinInt.Z.lt (Integers.Int.unsigned x1)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : BinInt.Z.lt (Integers.Int.unsigned x2)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : BinInt.Z.lt (Integers.Int.unsigned x3)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
         (_ : BinInt.Z.lt (Integers.Int.unsigned x4)
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))),
       @eq Integers.Int.int (c_be32 x1 x2 x3 x4) (be32 x1 x2 x3 x4)
load_byte_range
     : forall (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (x : Integers.Int.int)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m b ofs) (@Some Values.val (Values.Vint x))),
       BinInt.Z.lt (Integers.Int.unsigned x)
         (BinNums.Zpos
            (BinNums.xO
               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
be_words_length
     : forall (n : nat) (bs : list Integers.Int.int)
         (_ : @eq nat (@length Integers.Int.int bs) (Nat.mul (S (S (S (S O)))) n)),
       @eq nat (@length Integers.Int.int (be_words bs)) n
be_words_nth
     : forall (i : nat) (bs : list Integers.Int.int)
