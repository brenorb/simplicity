     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (x : Ty.tySem (Word.Word (S (S (S O))))) (_ : frame_base_valid base)
