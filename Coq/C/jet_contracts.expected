encode_vector_fill
     : forall (A X : Ty.Ty) (d : nat) (t : Alg.Core.domain Alg.CoreFunSem A X) (x : Ty.tySem A),
       @eq (list Cell) (@encode (Word.Vector X d) (@Word.fill A X d Alg.CoreFunSem t x))
         (@List.concat Cell (@List.repeat (list Cell) (@encode X (t x)) (PeanoNat.Nat.pow (S (S O)) d)))
encode_left_pad_word_spec
     : forall (n d : nat) (high : bool) (x : Ty.tySem (Word.Word n)),
       @eq (list Cell) (@encode (Word.Vector (Word.Word n) d) (@left_pad_word_spec n d high Alg.CoreFunSem x))
         (@app Cell
            (@List.concat Cell
               (@List.repeat (list Cell) (@encode (Word.Word n) (@pad_word_constant n high Alg.CoreFunSem tt))
                  (Nat.sub (PeanoNat.Nat.pow (S (S O)) d) (S O)))) (@encode (Word.Word n) x))
extend_word8_msb_denotes
     : forall (x : Ty.tySem (Word.Word (S (S (S O))))) (r : Integers.Int.int)
         (_ : @eq BinNums.Z (Integers.Int.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x)),
       @eq bool (extend_word8_msb r)
         (Bit.toBool (@Word.leftmost (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))) Alg.CoreFunSem x))
extend_word8_constant_decode
     : forall bit : bool,
       @eq (Ty.tySem (Word.Word (S (S (S O)))))
         (decode_word8 (Integers.Int64.repr (Integers.Int.unsigned (extend_bit8_arg bit))))
         (@pad_word_constant (S (S (S O))) bit Alg.CoreFunSem tt)
extend_word8_args_length
     : forall (s : extend_word8_size) (r : Integers.Int.int),
       @eq BinNums.Z
         (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
            (BinInt.Z.of_nat (@length Integers.Int.int (extend_word8_output_args s r)))) (extend_word8_bits s)
extend_word8_sequence_denotes
     : forall (s : extend_word8_size) (x : Ty.tySem (Word.Word (S (S (S O))))) (r : Integers.Int.int)
         (_ : @eq BinNums.Z (Integers.Int.unsigned (extend_word8_payload r))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x))
         (_ : @eq (Ty.tySem (Word.Word (S (S (S O)))))
                (decode_word8 (Integers.Int64.repr (Integers.Int.unsigned (extend_word8_payload r)))) x),
       @eq (list Cell) (byte_sequence_cells (extend_word8_output_args s r))
         (@encode (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))
            (@left_extend_word_spec (S (S (S O))) (extend_word8_depth s) Alg.CoreFunSem x))
eval_extend_word8_layout_matches_spec
     : forall (env : Values.val) (s : extend_word8_size) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (x : Ty.tySem (Word.Word (S (S (S O))))) (cursor rc : BinNums.Z)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc) (_ : byte_slice_at m bi edge rc x)
         (_ : write_frame_at m bd dbase bw outedge cursor (extend_word8_bits s)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (extend_word8_function s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))
                     (@left_extend_word_spec (S (S (S O))) (extend_word8_depth s) Alg.CoreFunSem x)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (extend_word8_bits s)))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (extend_word8_bits s))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
