                                                                   (BinNums.xI
                                                                      (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))
                                     (and (BinInt.Z.le t4 r4)
                                        (@eq BinNums.Z r4
                                           (BinInt.Z.add t4
                                              (BinInt.Z.div
                                                 (BinInt.Z.add t3
                                                    (BinInt.Z.div
                                                       (BinInt.Z.add t2
                                                          (BinInt.Z.div
                                                             (BinInt.Z.add t1
                                                                (BinInt.Z.div t0
                                                                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO (...)))))))
                                                             (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                                                                (BinNums.Zpos
