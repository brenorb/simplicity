              (fullWriteFrame (@encode (Word.Word (S (S (S (S O))))) (@rotate16_spec right Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
