           (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) sha256_ctx8_type) sha256_ctx8_type
           (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))) (Alg.Assertion.toCore term)
