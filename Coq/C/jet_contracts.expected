               (decode_word8 left) (decode_word8 right)))
wide_subtract_values_denote_input
     : forall (s : wide_size) (x y : Ty.tySem (Word.Word (wide_log s))) (r t : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log s)) y)),
       @eq (prod (sum unit unit) (Ty.tySem (Word.Word (wide_log s))))
