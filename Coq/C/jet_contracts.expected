                (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S (S (S (S O)))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (shift_wide_with_function W64 right))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S (S (S (S O))))))) (@shift64_with_spec right Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S (S (S (S O)))))))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S (S (S (S O))))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
shift64_with_context_guarantees
     : forall (right : bool) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem
                (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
                   (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O)))))))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode
                 (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
                    (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O)))))))))
                 a) (newWriteFrame (bitSize (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O)))))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode
                 (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
                    (Ty.Prod (Word.Word (S (S (S O)))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O)))))))))
                 a)
              (fullWriteFrame
                 (@encode (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S (S O)))))))
                    (@shift64_with_spec right Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (shift_wide_with_function W64 right)) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@shift64_with_spec right Naive.translate) (Running s0) (Running s1))))
division_numeric_range
     : forall (remainder : bool) (a b bound : BinNums.Z) (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.lt a bound))
         (_ : and (BinInt.Z.le BinNums.Z0 b) (BinInt.Z.lt b bound)),
       and (BinInt.Z.le BinNums.Z0 (division_numeric remainder a b))
         (BinInt.Z.lt (division_numeric remainder a b) bound)
