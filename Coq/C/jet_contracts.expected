u128_shift64_storage
     : forall (m : Memory.Mem.mem) (b : Values.block) (value : Integers.Int64.int)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun m1 : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (@eq (option Memory.Mem.mem) (Memory.Mem.store AST.Mint64 m b BinNums.Z0 (Values.Vlong value))
                  (@Some Memory.Mem.mem m1))
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.store AST.Mint64 m1 b (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                        (Values.Vlong Integers.Int64.zero)) (@Some Memory.Mem.mem mf))
                  (and
                     (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf b BinNums.Z0)
                        (@Some Values.val (Values.Vlong value)))
                     (and
                        (@eq (option Values.val)
                           (Memory.Mem.load AST.Mint64 mf b
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (@Some Values.val (Values.Vlong Integers.Int64.zero)))
                        (and
                           (forall (bb : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m bb ofs k p),
                            Memory.Mem.perm mf bb ofs k p)
                           (lframe
                              (fun (bb : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (and (@eq Values.block bb b)
                                    (and (BinInt.Z.le BinNums.Z0 ofs)
                                       (BinInt.Z.lt ofs
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                              m mf)))))))
eval_u128_shift64_from_storage
     : forall (m : Memory.Mem.mem) (b : Values.block) (value : Integers.Int64.int)
         (_ : Memory.Mem.range_perm m b BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Writable)
         (_ : @eq (option Values.val)
