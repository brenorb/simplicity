scalar_writer_tree =
fun (bd : Values.block) (base : Integers.Ptrofs.int) =>
@Some res
  (RDone
     (mkst (@Maps.PTree.Empty sx)
        (@cons region
           (mkreg
              (@cons cell (mkcell BinNums.Z0 AST.Mint64 (@Some sx (XLv O)))
                 (@cons cell
                    (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) AST.Mint64
                       (@Some sx (XLv (S O))))
                    (@cons cell
                       (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) AST.Mint64
                          (@Some sx (XLv (S (S O)))))
                       (@cons cell
                          (mkcell (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))
                             AST.Mint64 (@Some sx (XLv (S (S (S O)))))) (@nil cell))))) true
              (@Some BinNums.Z
                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
           (@nil region))
        (@cons event
           (mkev (S (S O)) (S (S (S (S O)))) O
              (@cons sx (XA bd base)
                 (@cons sx
                    (XIcast Ctypes.I8 Ctypes.Unsigned
                       (XIcast Ctypes.I8 Ctypes.Unsigned
                          (XL2I
                             (XLsh Hshru (XLv (S (S (S O))))
                                (BinNums.Zpos
                                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                    (@cons sx
                       (XIcast Ctypes.I8 Ctypes.Unsigned
                          (XIcast Ctypes.I8 Ctypes.Unsigned
                             (XL2I
                                (XLsh Hshru (XLv (S (S (S O))))
                                   (BinNums.Zpos
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
                       (@cons sx
                          (XIcast Ctypes.I8 Ctypes.Unsigned
                             (XIcast Ctypes.I8 Ctypes.Unsigned
                                (XL2I
                                   (XLsh Hshru (XLv (S (S (S O))))
                                      (BinNums.Zpos
                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))))
                          (@cons sx
                             (XIcast Ctypes.I8 Ctypes.Unsigned
                                (XIcast Ctypes.I8 Ctypes.Unsigned
                                   (XL2I
                                      (XLsh Hshru (XLv (S (S (S O))))
                                         (BinNums.Zpos
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                             (@cons sx
                                (XIcast Ctypes.I8 Ctypes.Unsigned
                                   (XIcast Ctypes.I8 Ctypes.Unsigned
                                      (XL2I
                                         (XLsh Hshru (XLv (S (S (S O))))
                                            (BinNums.Zpos
                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))
                                (@cons sx
                                   (XIcast Ctypes.I8 Ctypes.Unsigned
                                      (XIcast Ctypes.I8 Ctypes.Unsigned
                                         (XL2I
                                            (XLsh Hshru (XLv (S (S (S O))))
                                               (BinNums.Zpos
                                                  (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                   (@cons sx
                                      (XIcast Ctypes.I8 Ctypes.Unsigned
                                         (XIcast Ctypes.I8 Ctypes.Unsigned
                                            (XL2I
                                               (XLsh Hshru (XLv (S (S (S O))))
                                                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
                                      (@cons sx
                                         (XIcast Ctypes.I8 Ctypes.Unsigned
                                            (XIcast Ctypes.I8 Ctypes.Unsigned (XL2I (XLv (S (S (S O)))))))
                                         (@cons sx
                                            (XIcast Ctypes.I8 Ctypes.Unsigned
                                               (XIcast Ctypes.I8 Ctypes.Unsigned
                                                  (XL2I
                                                     (XLsh Hshru (XLv (S (S O)))
                                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))
                                            (@cons sx
                                               (XIcast Ctypes.I8 Ctypes.Unsigned
                                                  (XIcast Ctypes.I8 Ctypes.Unsigned
                                                     (XL2I
                                                        (XLsh Hshru (XLv (S (S O)))
                                                           (BinNums.Zpos (BinNums.xO (BinNums.xO ...)))))))
                                               (@cons sx
                                                  (XIcast Ctypes.I8 Ctypes.Unsigned
                                                     (XIcast Ctypes.I8 Ctypes.Unsigned
                                                        (XL2I
                                                           (XLsh Hshru (XLv (S ...)) (BinNums.Zpos (BinNums.xO ...))))))
                                                  (@cons sx
                                                     (XIcast Ctypes.I8 Ctypes.Unsigned
                                                        (XIcast Ctypes.I8 Ctypes.Unsigned
                                                           (XL2I (XLsh Hshru (XLv ...) (BinNums.Zpos ...)))))
                                                     (@cons sx
                                                        (XIcast Ctypes.I8 Ctypes.Unsigned
                                                           (XIcast Ctypes.I8 Ctypes.Unsigned
                                                              (XL2I (XLsh Hshru ... ...))))
                                                        (@cons sx
                                                           (XIcast Ctypes.I8 Ctypes.Unsigned
                                                              (XIcast Ctypes.I8 Ctypes.Unsigned (XL2I ...)))
                                                           (@cons sx
                                                              (XIcast Ctypes.I8 Ctypes.Unsigned
                                                                 (XIcast Ctypes.I8 Ctypes.Unsigned ...))
                                                              (@cons sx (XIcast Ctypes.I8 Ctypes.Unsigned ...)
                                                                 (@cons sx ... ...)))))))))))))))))))
           (@nil event)) (S (S (S (S O))))) ONormal)
