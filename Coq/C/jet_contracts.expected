     : forall (s : constant_size) (high : bool),
       jet_local_spec (constant_jet s high) Ty.Unit (Word.Word (constant_log s))
         (fun a : Ty.tySem Ty.Unit => @constant_spec s high Alg.CoreFunSem a)
