multiply8_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le
                (BinInt.Z.add read_cursor
                   (BinInt.Z.of_nat (bitSize (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))))))
                Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor
                (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S (S O)))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f_simplicity_multiply_8)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S (S O))))) (@multiply_word_spec (S (S (S O))) Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S (S O)))))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S (S O))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
multiply8_context_guarantees
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a)
              (newWriteFrame (bitSize (Word.Word (S (S (S (S O)))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) a)
              (fullWriteFrame
                 (@encode (Word.Word (S (S (S (S O))))) (@multiply_word_spec (S (S (S O))) Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function f_simplicity_multiply_8)
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@multiply_word_spec (S (S (S O))) Naive.translate) (Running s0) (Running s1))))
projection_vector_size
     : forall (X : Ty.Ty) (n : nat), le (bitSize X) (bitSize (Word.Vector X n))
encode_leftmost
     : forall (X : Ty.Ty) (n : nat) (v : Ty.tySem (Word.Vector X n)),
       @eq (list Cell) (@encode X (@Word.leftmost X n Alg.CoreFunSem v))
         (@List.firstn Cell (bitSize X) (@encode (Word.Vector X n) v))
encode_rightmost
     : forall (X : Ty.Ty) (n : nat) (v : Ty.tySem (Word.Vector X n)),
       @eq (list Cell) (@encode X (@Word.rightmost X n Alg.CoreFunSem v))
         (@List.skipn Cell (Nat.sub (bitSize (Word.Vector X n)) (bitSize X)) (@encode (Word.Vector X n) v))
projection_input_firstn
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (cells : list Cell)
         (n : nat) (_ : frame_input_cells_at m bi edge rc cells),
       frame_input_cells_at m bi edge rc (@List.firstn Cell n cells)
projection_input_skipn
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (cells : list Cell)
         (n : nat) (_ : le n (@length Cell cells)) (_ : frame_input_cells_at m bi edge rc cells),
       frame_input_cells_at m bi edge (BinInt.Z.add rc (BinInt.Z.of_nat n)) (@List.skipn Cell n cells)
projection_left_input
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (X : Ty.Ty) (n : nat)
         (v : Ty.tySem (Word.Vector X n)) (_ : frame_input_cells_at m bi edge rc (@encode (Word.Vector X n) v)),
       frame_input_cells_at m bi edge rc (@encode X (@Word.leftmost X n Alg.CoreFunSem v))
projection_right_input
     : forall (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z) (X : Ty.Ty) (n : nat)
         (v : Ty.tySem (Word.Vector X n)) (_ : frame_input_cells_at m bi edge rc (@encode (Word.Vector X n) v)),
       frame_input_cells_at m bi edge
         (BinInt.Z.add rc (BinInt.Z.of_nat (Nat.sub (bitSize (Word.Vector X n)) (bitSize X))))
         (@encode X (@Word.rightmost X n Alg.CoreFunSem v))
projection_buffers_slice
     : forall (bd bi bw : Values.block) (edge outedge cursor rc total skip count : BinNums.Z)
         (_ : jet_copy_buffers_separated bd bi bw edge outedge cursor rc total) (_ : BinInt.Z.le BinNums.Z0 skip)
         (_ : BinInt.Z.le BinNums.Z0 count) (_ : BinInt.Z.le (BinInt.Z.add skip count) total),
       jet_copy_buffers_separated bd bi bw edge outedge cursor (BinInt.Z.add rc skip) count
full_multiply_int64_denotes
     : forall (n : nat) (x y z w : Ty.tySem (Word.Word n)) (r t u v : Integers.Int64.int)
         (_ : BinInt.Z.le (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) (S n)))
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ n) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t) (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned u) (@Word.ToZ.Theory.toZ (Word.WordToZ n) z))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned v) (@Word.ToZ.Theory.toZ (Word.WordToZ n) w)),
       @eq (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S n))))
         (@Word.ToZ.Theory.fromZ (Word.WordToZ (S n))
            (Integers.Int64.unsigned (Integers.Int64.add (Integers.Int64.add (Integers.Int64.mul r t) u) v)))
         (@Word.fullMultiplier n Alg.CoreFunSem
            (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
               (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)
               (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) z w)))
frame_input_word_quad_encode
     : forall (n : nat) (m : Memory.Mem.mem) (bi : Values.block) (edge rc : BinNums.Z)
         (x y z w : Ty.tySem (Word.Word n)),
       iff
         (frame_input_cells_at m bi edge rc
            (@encode (Ty.Prod (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)))
               (@pair (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                  (prod (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)))
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y)
                  (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) z w))))
         (and (@frame_input_word_at n m bi edge rc x)
            (and
               (@frame_input_word_at n m bi edge (BinInt.Z.add rc (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) n))) y)
               (and
                  (@frame_input_word_at n m bi edge
                     (BinInt.Z.add rc
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
                           (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) n)))) z)
                  (@frame_input_word_at n m bi edge
                     (BinInt.Z.add rc
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH))
                           (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) n)))) w))))
wide_full_multiply_body
     : forall s : multiply_wide_size,
       @eq Clight.statement (Clight.fn_body (wide_full_multiply s))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar _src (Ctypes.Tstruct _frameItem Ctypes.noattr))
               (Clight.Etempvar _src (Ctypes.Tstruct _frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (wide_binary_read (multiply_input_size s) _t'1)
                  (Clight.Sset _x (Clight.Etempvar _t'1 Ctypesdefs.tulong)))
               (Clight.Ssequence
                  (Clight.Ssequence (wide_binary_read (multiply_input_size s) _t'2)
                     (Clight.Sset _y (Clight.Etempvar _t'2 Ctypesdefs.tulong)))
                  (Clight.Ssequence
                     (Clight.Ssequence (wide_binary_read (multiply_input_size s) _t'3)
                        (Clight.Sset _z (Clight.Etempvar _t'3 Ctypesdefs.tulong)))
                     (Clight.Ssequence
                        (Clight.Ssequence (wide_binary_read (multiply_input_size s) _t'4)
                           (Clight.Sset _w (Clight.Etempvar _t'4 Ctypesdefs.tulong)))
                        (Clight.Ssequence
                           (jet_arith8_layout_exec.frame_writer_call (wide_writer_id (multiply_output_size s))
                              Ctypesdefs.tulong Ctypesdefs.tvoid full_multiply_expr)
                           (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint)))))))))
eval_full_multiply_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (r t u v : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _x le) (@Some Values.val (Values.Vlong r)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _y le) (@Some Values.val (Values.Vlong t)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _z le) (@Some Values.val (Values.Vlong u)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _w le) (@Some Values.val (Values.Vlong v))),
       Clight.eval_expr ge0 e le m full_multiply_expr (Values.Vlong (full_multiply_value r t u v))
eval_wide_full_multiply_composes
     : forall (env : Values.val) (s : multiply_wide_size) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (mc mr mr2 mr3 mr4 me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bytes : list Memdata.memval) (r t u v : Integers.Int64.int)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mc
                (@Ctypes.Internal Clight.function (wide_reader (multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vlong r))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr
                (@Ctypes.Internal Clight.function (wide_reader (multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vlong t))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr2
                (@Ctypes.Internal Clight.function (wide_reader (multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr3
                (Values.Vlong u))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr3
                (@Ctypes.Internal Clight.function (wide_reader (multiply_input_size s)))
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr4
                (Values.Vlong v))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr4
                (@Ctypes.Internal Clight.function (wide_writer (multiply_output_size s)))
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vlong (full_multiply_value r t u v)) (@nil Values.val))) Events.E0 me
                Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (wide_full_multiply s))
         (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
            (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase)) (@cons Values.val env (@nil Values.val))))
         Events.E0 mf (Values.Vint Integers.Int.one)
wide_full_multiply_decode
     : forall (s : multiply_wide_size) (x y z d : Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
         (r t u v : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned r)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log (multiply_input_size s))) x))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned t)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log (multiply_input_size s))) y))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned u)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log (multiply_input_size s))) z))
         (_ : @eq BinNums.Z (Integers.Int64.unsigned v)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log (multiply_input_size s))) d)),
       @eq (Ty.tySem (Word.Word (wide_log (multiply_output_size s))))
         (decode_wide (multiply_output_size s)
            (Integers.Int64.zero_ext (wide_bits (multiply_output_size s)) (full_multiply_value r t u v)))
         (@wide_full_multiply_spec s Alg.CoreFunSem
            (@pair
               (prod (Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
                  (Ty.tySem (Word.Word (wide_log (multiply_input_size s)))))
               (prod (Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
                  (Ty.tySem (Word.Word (wide_log (multiply_input_size s)))))
               (@pair (Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
                  (Ty.tySem (Word.Word (wide_log (multiply_input_size s)))) x y)
               (@pair (Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
                  (Ty.tySem (Word.Word (wide_log (multiply_input_size s)))) z d)))
eval_wide_full_multiply_layout_matches_spec
     : forall (env : Values.val) (s : multiply_wide_size) (m : Memory.Mem.mem) (bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge : BinNums.Z) (x y z d : Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
         (cursor rc : BinNums.Z) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                         (wide_bits (multiply_input_size s))))))
         (_ : @frame_input_word_at (wide_log (multiply_input_size s)) m bi edge rc x)
         (_ : @frame_input_word_at (wide_log (multiply_input_size s)) m bi edge
                (BinInt.Z.add rc (wide_bits (multiply_input_size s))) y)
         (_ : @frame_input_word_at (wide_log (multiply_input_size s)) m bi edge
                (BinInt.Z.add rc
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (wide_bits (multiply_input_size s)))) z)
         (_ : @frame_input_word_at (wide_log (multiply_input_size s)) m bi edge
                (BinInt.Z.add rc
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) (wide_bits (multiply_input_size s)))) d)
         (_ : write_frame_at m bd dbase bw outedge cursor (wide_bits (multiply_output_size s))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (wide_full_multiply s))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (wide_log (multiply_output_size s)))
                     (@wide_full_multiply_spec s Alg.CoreFunSem
                        (@pair
                           (prod (Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
                              (Ty.tySem (Word.Word (wide_log (multiply_input_size s)))))
                           (prod (Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
                              (Ty.tySem (Word.Word (wide_log (multiply_input_size s)))))
                           (@pair (Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
                              (Ty.tySem (Word.Word (wide_log (multiply_input_size s)))) x y)
                           (@pair (Ty.tySem (Word.Word (wide_log (multiply_input_size s))))
                              (Ty.tySem (Word.Word (wide_log (multiply_input_size s)))) z d)))))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (wide_bits (multiply_output_size s))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div (BinInt.Z.sub cursor (wide_bits (multiply_output_size s)))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
wide_full_multiply_local_spec
     : forall s : multiply_wide_size,
       jet_local_spec (wide_full_multiply s)
         (Ty.Prod
            (Ty.Prod (Word.Word (wide_log (multiply_input_size s))) (Word.Word (wide_log (multiply_input_size s))))
            (Ty.Prod (Word.Word (wide_log (multiply_input_size s))) (Word.Word (wide_log (multiply_input_size s)))))
         (Word.Word (wide_log (multiply_output_size s)))
         (fun
            input : Ty.tySem
                      (Ty.Prod
