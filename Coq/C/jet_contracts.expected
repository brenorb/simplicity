bitcoin_version_ready =
fun (env : Values.val) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
  (bt : Values.block) (txbase : BinNums.Z) (version : Integers.Int64.int) =>
@Maps.PTree.set Values.val jets_bitcoin._t'2 (Values.Vlong version)
  (@Maps.PTree.set Values.val jets_bitcoin._t'1 (Values.Vptr bt (Integers.Ptrofs.repr txbase))
     (bitcoin_version_temps env bd dbase bs sbase))
     : forall (_ : Values.val) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z)
         (_ : Values.block) (_ : BinNums.Z) (_ : Integers.Int64.int), Clight.temp_env

Arguments bitcoin_version_ready env bd dbase%Z_scope bs sbase%Z_scope bt txbase%Z_scope version
Bitcoin.Bitcoin.sem =
let cast : forall (A : Ty.Ty) (_ : option (Ty.tySem A)), Ty.tySem (Ty.Sum Ty.Unit A) :=
  fun (A : Ty.Ty) (x : option (Ty.tySem A)) =>
  match x return (Ty.tySem (Ty.Sum Ty.Unit A)) with
  | Some a => @inr unit (Ty.tySem A) a
  | None =>
      @inl unit
        ((fix tySem (X : Ty.Ty) : Set :=
            match X return Set with
            | Ty.Unit => unit
            | Ty.Sum A0 B => sum (tySem A0) (tySem B)
            | Ty.Prod A0 B => prod (tySem A0) (tySem B)
            end) A) tt
  end in
let encodeOutpoint :
  forall _ : Bitcoin.outpoint,
  Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O))))))) :=
  fun op : Bitcoin.outpoint =>
  @pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
    (Word.from_hash256 (Bitcoin.opHash op))
    (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (Bitcoin.opIndex op))
     :
     Ty.tySem (Word.Word (S (S (S (S (S O))))))) in
fun (A B : Ty.Ty) (p : Bitcoin.Bitcoin.t A B) (a : Ty.tySem A) (e : Bitcoin.Bitcoin.env) =>
let tx : Bitcoin.sigTx := Bitcoin.Bitcoin.envTx e in
let ix : nat := Bitcoin.Bitcoin.envIx e in
let currentInput : forall (A0 : Ty.Ty) (_ : forall _ : Bitcoin.sigTxInput, Ty.tySem A0), option (Ty.tySem A0) :=
  fun (A0 : Ty.Ty) (f : forall _ : Bitcoin.sigTxInput, Ty.tySem A0) =>
  @option_map Bitcoin.sigTxInput (Ty.tySem A0) f (@List.nth_error Bitcoin.sigTxInput (Bitcoin.sigTxIn tx) ix) in
let atInput :
  forall (A0 : Ty.Ty) (_ : forall _ : Bitcoin.sigTxInput, Ty.tySem A0) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
  option (Ty.tySem (Ty.Sum Ty.Unit A0)) :=
  fun (A0 : Ty.Ty) (f : forall _ : Bitcoin.sigTxInput, Ty.tySem A0) (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
  @Some (Ty.tySem (Ty.Sum Ty.Unit A0))
    (cast A0
       (@option_map Bitcoin.sigTxInput (Ty.tySem A0) f
          (@List.nth_error Bitcoin.sigTxInput (Bitcoin.sigTxIn tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))))) in
let atOutput :
  forall (A0 : Ty.Ty) (_ : forall _ : Bitcoin.txOutput, Ty.tySem A0) (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
  option (Ty.tySem (Ty.Sum Ty.Unit A0)) :=
  fun (A0 : Ty.Ty) (f : forall _ : Bitcoin.txOutput, Ty.tySem A0) (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
  @Some (Ty.tySem (Ty.Sum Ty.Unit A0))
    (cast A0
       (@option_map Bitcoin.txOutput (Ty.tySem A0) f
          (@List.nth_error Bitcoin.txOutput (Bitcoin.sigTxOut tx)
             (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) i))))) in
let outputsHash : Digest.hash256 :=
  let go : forall _ : Bitcoin.txOutput, list Integers.Byte.int :=
    fun i : Bitcoin.txOutput =>
    @app Integers.Byte.int (Bitcoin.putInt64le (Bitcoin.txoValue i))
      (Bitcoin.putHash256 (Digest.byteStringHash (Bitcoin.txoScript i))) in
  Digest.byteStringHash
    (@List.concat Integers.Byte.int (@List.map Bitcoin.txOutput (list Integers.Byte.int) go (Bitcoin.sigTxOut tx))) in
let inputsHash : Digest.hash256 :=
  let go : forall _ : Bitcoin.sigTxInput, list Integers.Byte.int :=
    fun i : Bitcoin.sigTxInput =>
    @app Integers.Byte.int (Bitcoin.putOutpoint (Bitcoin.sigTxiPreviousOutpoint i))
      (@app Integers.Byte.int (Bitcoin.putInt64le (Bitcoin.sigTxiValue i))
         (Bitcoin.putInt32le (Bitcoin.sigTxiSequence i))) in
  Digest.byteStringHash
    (@List.concat Integers.Byte.int (@List.map Bitcoin.sigTxInput (list Integers.Byte.int) go (Bitcoin.sigTxIn tx))) in
match p in (Bitcoin.Bitcoin.prim A0 B0) return (forall _ : Ty.tySem A0, option (Ty.tySem B0)) with
| Bitcoin.Bitcoin.Version =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.signed (Bitcoin.sigTxVersion tx)))
| Bitcoin.Bitcoin.LockTime =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (Bitcoin.sigTxLock tx)))
| Bitcoin.Bitcoin.InputsHash =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 inputsHash)
| Bitcoin.Bitcoin.OutputsHash =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 outputsHash)
| Bitcoin.Bitcoin.NumInputs =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
         (@Zcomplements.Zlength Bitcoin.sigTxInput (Bitcoin.sigTxIn tx)))
| Bitcoin.Bitcoin.TotalInputValue =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Bitcoin.sigTxTotalInValue tx))
| Bitcoin.Bitcoin.CurrentPrevOutpoint =>
    fun _ : Ty.tySem Ty.Unit =>
    currentInput (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
      (fun txi : Bitcoin.sigTxInput => encodeOutpoint (Bitcoin.sigTxiPreviousOutpoint txi))
| Bitcoin.Bitcoin.CurrentValue =>
    fun _ : Ty.tySem Ty.Unit =>
    currentInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))
      (fun txi : Bitcoin.sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
         (Integers.Int64.signed (Bitcoin.sigTxiValue txi)))
| Bitcoin.Bitcoin.CurrentSequence =>
    fun _ : Ty.tySem Ty.Unit =>
    currentInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))
      (fun txi : Bitcoin.sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (Bitcoin.sigTxiSequence txi)))
| Bitcoin.Bitcoin.CurrentIndex =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (BinInt.Z.of_nat ix))
| Bitcoin.Bitcoin.InputPrevOutpoint =>
    atInput (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S O)))))))
      (fun txi : Bitcoin.sigTxInput => encodeOutpoint (Bitcoin.sigTxiPreviousOutpoint txi))
| Bitcoin.Bitcoin.InputValue =>
    atInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))
      (fun txi : Bitcoin.sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O)))))))
         (Integers.Int64.signed (Bitcoin.sigTxiValue txi)))
| Bitcoin.Bitcoin.InputSequence =>
    atInput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O)))))))
      (fun txi : Bitcoin.sigTxInput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O)))))) (Integers.Int.unsigned (Bitcoin.sigTxiSequence txi)))
| Bitcoin.Bitcoin.NumOutputs =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S O))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S O))))))
         (@Zcomplements.Zlength Bitcoin.txOutput (Bitcoin.sigTxOut tx)))
| Bitcoin.Bitcoin.TotalOutputValue =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Bitcoin.sigTxTotalOutValue tx))
| Bitcoin.Bitcoin.OutputValue =>
    atOutput (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O))))))))
      (fun txout : Bitcoin.txOutput =>
       @Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.signed (Bitcoin.txoValue txout)))
| Bitcoin.Bitcoin.OutputScriptHash =>
    atOutput (Word.Word (S (S (S (S (S (S (S (S O)))))))))
      (fun txout : Bitcoin.txOutput => Word.from_hash256 (Digest.byteStringHash (Bitcoin.txoScript txout)))
| Bitcoin.Bitcoin.ScriptCMR =>
    fun _ : Ty.tySem Ty.Unit =>
    @Some (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (Word.from_hash256 (Bitcoin.Bitcoin.envScriptCMR e))
end a
     : forall (A B : Ty.Ty) (_ : Bitcoin.Bitcoin.t A B) (_ : Ty.tySem A) (_ : Bitcoin.Bitcoin.env), option (Ty.tySem B)

Arguments Bitcoin.Bitcoin.sem {A B}%ty_scope p a e
bitcoin_getter32_body =
fun field : AST.ident =>
Clight.Ssequence
  (Clight.Sassign (Clight.Evar jets_bitcoin._src (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr))
     (Clight.Etempvar jets_bitcoin._src (Ctypes.Tstruct jets_bitcoin._frameItem Ctypes.noattr)))
  (Clight.Ssequence
     (Clight.Ssequence
        (Clight.Sset jets_bitcoin._t'1
           (Clight.Efield
              (Clight.Ederef
                 (Clight.Etempvar jets_bitcoin._env
                    (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._txEnv Ctypes.noattr)))
                 (Ctypes.Tstruct jets_bitcoin._txEnv Ctypes.noattr)) jets_bitcoin._tx
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr))))
        (Clight.Ssequence
           (Clight.Sset jets_bitcoin._t'2
              (Clight.Efield
                 (Clight.Ederef
                    (Clight.Etempvar jets_bitcoin._t'1
                       (Ctypesdefs.tptr (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)))
                    (Ctypes.Tstruct jets_bitcoin._bitcoinTransaction Ctypes.noattr)) field Ctypesdefs.tulong))
