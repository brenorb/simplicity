                            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                      (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0 mr2
                Values.Vundef)
         (_ : @eq (option Values.val)
                (Memory.Mem.load AST.Mptr mr2 (sha_symbol_block jets_sha._simplicity_sha256_compression) BinNums.Z0)
                (@Some Values.val
                   (Values.Vptr (sha_symbol_block jets_sha._sha256_compression_portable) Integers.Ptrofs.zero)))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge mr2
                (@Ctypes.Internal Clight.function jets_sha.f_sha256_compression_portable)
                (@cons Values.val (Values.Vptr bh Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 m4
                Values.Vundef)
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge m4 (@Ctypes.Internal Clight.function f_write32s)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val (Values.Vptr bh Integers.Ptrofs.zero)
