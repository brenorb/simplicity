write_fe_selected_outs_numeric
     : forall (value rc : BinNums.Z) (bd : Values.block) (base : Integers.Ptrofs.int)
         (layout : forall _ : nat, prod Values.block BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
