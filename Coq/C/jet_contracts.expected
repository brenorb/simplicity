xconst =
fun x : sx =>
match x return (option BinNums.Z) with
| XI _ => @None BinNums.Z
| XIc _ => @None BinNums.Z
| XL _ => @None BinNums.Z
| XLc l => @Some BinNums.Z (Integers.Int64.unsigned l)
| XLv _ => @None BinNums.Z
| XV _ => @None BinNums.Z
| XA _ _ => @None BinNums.Z
| XP _ _ => @None BinNums.Z
| XIb _ _ _ => @None BinNums.Z
| XLb _ _ _ => @None BinNums.Z
| XIsh _ _ _ => @None BinNums.Z
| XLsh _ _ _ => @None BinNums.Z
| XIcmp _ _ _ _ => @None BinNums.Z
| XLcmp _ _ _ _ => @None BinNums.Z
| XI2L sg a =>
    match sg return (option BinNums.Z) with
    | Ctypes.Signed =>
        match a return (option BinNums.Z) with
        | XI _ => @None BinNums.Z
        | XIc i =>
            match BinInt.Z.leb BinNums.Z0 (Integers.Int.signed i) return (option BinNums.Z) with
            | true => @Some BinNums.Z (Integers.Int.signed i)
            | false => @None BinNums.Z
            end
        | XL _ => @None BinNums.Z
        | XLc _ => @None BinNums.Z
        | XLv _ => @None BinNums.Z
        | XV _ => @None BinNums.Z
        | XA _ _ => @None BinNums.Z
        | XP _ _ => @None BinNums.Z
        | XIb _ _ _ => @None BinNums.Z
        | XLb _ _ _ => @None BinNums.Z
        | XIsh _ _ _ => @None BinNums.Z
        | XLsh _ _ _ => @None BinNums.Z
        | XIcmp _ _ _ _ => @None BinNums.Z
        | XLcmp _ _ _ _ => @None BinNums.Z
        | XI2L _ _ => @None BinNums.Z
        | XL2I _ => @None BinNums.Z
        | XIcast _ _ _ => @None BinNums.Z
        | XInz _ => @None BinNums.Z
        | XLnz _ => @None BinNums.Z
        | XIz _ => @None BinNums.Z
        | XLz _ => @None BinNums.Z
        | XIneg _ => @None BinNums.Z
        | XLneg _ => @None BinNums.Z
        | XInot _ => @None BinNums.Z
        | XLnot _ => @None BinNums.Z
        end
    | Ctypes.Unsigned =>
        match a return (option BinNums.Z) with
        | XI _ => @None BinNums.Z
        | XIc i => @Some BinNums.Z (Integers.Int.unsigned i)
        | XL _ => @None BinNums.Z
        | XLc _ => @None BinNums.Z
        | XLv _ => @None BinNums.Z
        | XV _ => @None BinNums.Z
        | XA _ _ => @None BinNums.Z
        | XP _ _ => @None BinNums.Z
        | XIb _ _ _ => @None BinNums.Z
        | XLb _ _ _ => @None BinNums.Z
        | XIsh _ _ _ => @None BinNums.Z
        | XLsh _ _ _ => @None BinNums.Z
        | XIcmp _ _ _ _ => @None BinNums.Z
        | XLcmp _ _ _ _ => @None BinNums.Z
        | XI2L _ _ => @None BinNums.Z
        | XL2I _ => @None BinNums.Z
        | XIcast _ _ _ => @None BinNums.Z
        | XInz _ => @None BinNums.Z
        | XLnz _ => @None BinNums.Z
        | XIz _ => @None BinNums.Z
        | XLz _ => @None BinNums.Z
        | XIneg _ => @None BinNums.Z
        | XLneg _ => @None BinNums.Z
        | XInot _ => @None BinNums.Z
        | XLnot _ => @None BinNums.Z
        end
    end
| XL2I _ => @None BinNums.Z
| XIcast _ _ _ => @None BinNums.Z
| XInz _ => @None BinNums.Z
| XLnz _ => @None BinNums.Z
| XIz _ => @None BinNums.Z
| XLz _ => @None BinNums.Z
| XIneg _ => @None BinNums.Z
| XLneg _ => @None BinNums.Z
| XInot _ => @None BinNums.Z
| XLnot _ => @None BinNums.Z
end
     : forall _ : sx, option BinNums.Z

