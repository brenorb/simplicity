right_rotate_byte_machine_value =
fun (s : byte_rotate_size) (amount : Ty.tySem (Word.Word (S (S (S O)))))
  (x : Ty.tySem (Word.Word (wide_log (byte_rotate_width s)))) =>
decode_wide (byte_rotate_width s)
  (Integers.Int64.zero_ext (wide_bits (byte_rotate_width s))
     (right_rotate_byte_payload s
        (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (wide_log (byte_rotate_width s))) x))
        (Integers.Int.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) amount))))
     : forall (s : byte_rotate_size) (_ : Ty.tySem (Word.Word (S (S (S O)))))
         (_ : Ty.tySem (Word.Word (wide_log (byte_rotate_width s)))),
       Ty.tySem (Word.Word (wide_log (byte_rotate_width s)))

Arguments right_rotate_byte_machine_value s amount x
read4_result =
fun w : Integers.Int64.int =>
Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
  (Integers.Int.or Integers.Int.zero
     (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
        (Integers.Int.repr
           (Integers.Int64.unsigned
              (Integers.Int64.and w
                 (Integers.Int64.repr (BinNums.Zpos (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
     : forall _ : Integers.Int64.int, Integers.Int.int

Arguments read4_result w
read4_at =
fun (cursor : BinNums.Z) (w : Integers.Int64.int) =>
read4_result
  (Integers.Int64.shru w
     (Integers.Int64.repr
        (BinInt.Z.sub (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))) cursor)))
     : forall (_ : BinNums.Z) (_ : Integers.Int64.int), Integers.Int.int

