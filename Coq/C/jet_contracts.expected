Arguments affine_weak_tree k
affine_weak_state =
fun k : affine_coordinate =>
match affine_weak_tree k return sstate with
| Some r =>
    match r return sstate with
    | RDone state _ => state
    | RIf _ _ _ => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
    end
| None => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
end
     : forall _ : affine_coordinate, sstate

Arguments affine_weak_state k
affine_negate_args =
fun k : affine_coordinate =>
@cons sx (XP O (affine_coordinate_offset k))
  (@cons sx (XP O (affine_coordinate_offset k)) (@cons sx (XIc Integers.Int.one) (@nil sx)))
     : forall _ : affine_coordinate, list sx

