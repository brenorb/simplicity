divmod128_context_guarantees =
@jet_context_guarantees (Ty.Prod (Word.Word (S (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))))
  (Word.Word (S (S (S (S (S (S (S O)))))))) f_simplicity_div_mod_128_64 (@div2n1n_word_spec (S (S (S (S (S (S O)))))))
  (div2n1n_word_spec_parametric (S (S (S (S (S (S O))))))) divmod128_local_spec
  (ZifyClasses.rew_iff_rev
     (le (S O) (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...)))))))))))))))))))))
     (BinInt.Z.le (BinNums.Zpos BinNums.xH)
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
     (ZifyClasses.mkrel nat BinNums.Z le BinInt.Z.of_nat BinInt.Z.le Znat.Nat2Z.inj_le (S O)
        (BinNums.Zpos BinNums.xH) (@eq_refl BinNums.Z (BinNums.Zpos BinNums.xH))
        (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))
        (BinNums.Zpos
           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
        (@eq_refl BinNums.Z
           (BinNums.Zpos
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
     (let __arith :
        BinInt.Z.le (BinNums.Zpos BinNums.xH)
          (BinNums.Zpos
             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) :=
        let __wit : list ZMicromega.ZArithProof := @nil ZMicromega.ZArithProof in
        let __varmap : VarMap.t BinNums.Z := @VarMap.Empty BinNums.Z in
        let __ff : Tauto.BFormula (RingMicromega.Formula BinNums.Z) Tauto.isProp :=
          @Tauto.A (RingMicromega.Formula BinNums.Z) Tauto.eKind unit unit Tauto.isProp
            (@RingMicromega.Build_Formula BinNums.Z (@EnvRing.PEc BinNums.Z (BinNums.Zpos BinNums.xH))
               RingMicromega.OpLe
               (@EnvRing.PEc BinNums.Z
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))) tt
          in
        ZMicromega.ZTautoChecker_sound __ff __wit
          (@eq_refl bool true <: @eq bool (ZMicromega.ZTautoChecker __ff __wit) true)
          (@VarMap.find BinNums.Z BinNums.Z0 __varmap) in
      __arith)
   <:
   le (S O) (bitSize (Word.Word (S (S (S (S (S (S (S O))))))))))
     : forall (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode (Ty.Prod (Word.Word (S (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O)))))))) a)
              (newWriteFrame (bitSize (Word.Word (S (S (S (S (S (S (S O))))))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode (Ty.Prod (Word.Word (S (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O)))))))) a)
              (fullWriteFrame
                 (@encode (Word.Word (S (S (S (S (S (S (S O))))))))
                    (@div2n1n_word_spec (S (S (S (S (S (S O)))))) Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function f_simplicity_div_mod_128_64) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@div2n1n_word_spec (S (S (S (S (S (S O)))))) Naive.translate) (Running s0) (Running s1))))

