           (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))) core
           (@jet_sha256_ctx8_init_spec.AC.comp Ty.Unit
              (Ty.Prod sha256_ctx8_type (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))))
              sha256_ctx8_type core
              (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit sha256_ctx8_type
                 (Ty.Prod (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S O))))))) core
                 (@sha256_ctx8_init_spec core)
                 (@jet_sha256_ctx8_init_spec.AC.pair Ty.Unit (Word.Word (S (S (S (S (S O))))))
                    (Word.Word (S (S (S (S (S O)))))) core
                    (@PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
                       (@BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.Version))
                    (@PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
                       (@BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S O)))))) Bitcoin.Bitcoin.LockTime))))
