jet_elements_null_data_read_index.write_effect_private =
fun (bl : Values.block) (m mf : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
  (edge cur count : BinNums.Z) (cells : list Cell) =>
and (frame_output_cells_at mf bw edge cur cells)
  (and (write_prefix_at m mf bw edge cur)
     (and (frame_fields_at mf bd dbase bw edge (BinInt.Z.sub cur count))
        (and
           (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : not (@eq Values.block b bl))
              (_ : or (not (@eq Values.block b bd))
                     (or
                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                           (BinInt.Z.add dbase (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (BinInt.Z.le
                           (BinInt.Z.add dbase
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
              (_ : or (not (@eq Values.block b bw))
                     (or
                        (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div (BinInt.Z.sub cur count)
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                        (BinInt.Z.le
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cur)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
            @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
           (and
              (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                 (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mf b ofs kind p)
              (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
     : forall (_ : Values.block) (_ : Memory.Mem.mem) (_ : Memory.Mem.mem) (_ : Values.block)
         (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z)
         (_ : list Cell), Prop

Arguments jet_elements_null_data_read_index.write_effect_private bl m mf bd dbase%Z_scope bw
  (edge cur count)%Z_scope cells%list_scope
jet_elements_null_data_read_index.elements_null_data_selected_private =
fun (m : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bw : Values.block) (edge cur : BinNums.Z)
  (be : Values.block) (ebase : BinNums.Z) (bt : Values.block) (txbase : BinNums.Z) (bout : Values.block)
  (outbase : BinNums.Z) (i j : Integers.Int64.int)
  (parsed : list (jet_elements_prim.txNullDatumF (list Integers.Byte.int))) (unused_hash : Digest.hash256) =>
forall (d : jet_elements_prim.txNullDatumF (list Integers.Byte.int))
  (_ : @eq (option (jet_elements_prim.txNullDatumF (list Integers.Byte.int)))
         (@List.nth_error (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) parsed
            (BinInt.Z.to_nat (Integers.Int64.unsigned j)))
         (@Some (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) d)),
@ex Values.block
  (fun bop : Values.block =>
   @ex BinNums.Z
     (fun opbase : BinNums.Z =>
      and (not (@eq Values.block bl bop))
        (and
           (jet_elements_null_data_small.elements_null_data_path_valid m be ebase bt txbase bout outbase bop opbase i j
              (jet_elements_null_data_opcode.elements_datum_code
                 (@jet_elements_prim.mapNullDatum (list Integers.Byte.int) Digest.hash256 Digest.byteStringHash d)))
           (and
              (@List.Forall (prod (prod Values.block BinNums.Z) BinNums.Z)
                 (fun pat : prod (prod Values.block BinNums.Z) BinNums.Z =>
                  match pat return Prop with
                  | pair y hi =>
                      match y return Prop with
                      | pair b lo =>
                          out_sep bd dbase bw edge cur
                            (BinNums.Zpos
                               (BinNums.xO
                                  (BinNums.xO
                                     (BinNums.xI
                                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                            b lo hi
                      end
                  end)
                 (jet_elements_null_data_loads.elements_null_data_path_footprint be ebase bt txbase bout outbase bop
                    opbase i j))
              match
                jet_elements_null_data_opcode.elements_datum_push
                  (@jet_elements_prim.mapNullDatum (list Integers.Byte.int) Digest.hash256 Digest.byteStringHash d)
                return Prop
