bitcoin_input_script_sig_hash_spec =
fun alg : PrimitiveBitcoinExt.Primitive.Algebra =>
@PrimitiveBitcoinExt.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
  (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg BitcoinExt.InputScriptSigHash
     : forall alg : PrimitiveBitcoinExt.Primitive.Algebra,
       PrimitiveBitcoinExt.Primitive.domain alg (Word.Word (S (S (S (S (S O))))))
         (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))

Arguments bitcoin_input_script_sig_hash_spec {alg}
ext_assert_spec =
fun (alg : PrimitiveBitcoinExt.Primitive.Algebra) (A B : Ty.Ty)
  (t : PrimitiveBitcoinExt.Primitive.domain alg A (Ty.Sum Ty.Unit B)) =>
@Alg.Core.Combinators.comp A (Ty.Prod (Ty.Sum Ty.Unit B) Ty.Unit) B
  (PrimitiveBitcoinExt.Primitive.CanonicalStructures.toCore alg)
  (@Alg.Core.Combinators.pair A (Ty.Sum Ty.Unit B) Ty.Unit
     (PrimitiveBitcoinExt.Primitive.CanonicalStructures.toCore alg) t
     (@Alg.Core.Combinators.unit A (PrimitiveBitcoinExt.Primitive.CanonicalStructures.toCore alg)))
  (@Alg.Assertion.Combinators.assertr Ty.Unit B Ty.Unit B
     (PrimitiveBitcoinExt.Primitive.CanonicalStructures.toAssertion alg) assertion_cmr_fail0
     (@Alg.Core.Combinators.take B Ty.Unit B
        (Alg.Assertion.toCore (PrimitiveBitcoinExt.Primitive.CanonicalStructures.toAssertion alg))
        (@Alg.Core.Combinators.iden B
           (Alg.Assertion.toCore (PrimitiveBitcoinExt.Primitive.CanonicalStructures.toAssertion alg)))))
     : forall (alg : PrimitiveBitcoinExt.Primitive.Algebra) (A B : Ty.Ty)
         (_ : PrimitiveBitcoinExt.Primitive.domain alg A (Ty.Sum Ty.Unit B)),
       PrimitiveBitcoinExt.Primitive.domain alg A B

Arguments ext_assert_spec {alg} {A B}%ty_scope t
ext_comp =
fun (alg : PrimitiveBitcoinExt.Primitive.Algebra) (A B C : Ty.Ty) (p : PrimitiveBitcoinExt.Primitive.domain alg A B)
  (q : PrimitiveBitcoinExt.Primitive.domain alg B C) =>
@Alg.Core.Combinators.comp A B C (PrimitiveBitcoinExt.Primitive.CanonicalStructures.toCore alg) p q
     : forall (alg : PrimitiveBitcoinExt.Primitive.Algebra) (A B C : Ty.Ty)
         (_ : PrimitiveBitcoinExt.Primitive.domain alg A B) (_ : PrimitiveBitcoinExt.Primitive.domain alg B C),
       PrimitiveBitcoinExt.Primitive.domain alg A C

Arguments ext_comp {alg} {A B C}%ty_scope p q
ext_ix = fun e : ext_environment => Bitcoin.Bitcoin.envIx (extBase e)
     : forall _ : ext_environment, nat

Arguments ext_ix e
bitcoin_current_script_hash_spec =
fun alg : PrimitiveBitcoinExt.Primitive.Algebra =>
@ext_comp alg Ty.Unit (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (@PrimitiveBitcoinExt.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
     BitcoinExt.CurrentIndex)
  (@ext_assert_spec alg (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (@PrimitiveBitcoinExt.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg BitcoinExt.InputScriptHash))
     : forall alg : PrimitiveBitcoinExt.Primitive.Algebra,
       PrimitiveBitcoinExt.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments bitcoin_current_script_hash_spec {alg}
bitcoin_current_script_sig_hash_spec =
fun alg : PrimitiveBitcoinExt.Primitive.Algebra =>
@ext_comp alg Ty.Unit (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (@PrimitiveBitcoinExt.Primitive.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S O)))))) alg
     BitcoinExt.CurrentIndex)
  (@ext_assert_spec alg (Word.Word (S (S (S (S (S O)))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (@PrimitiveBitcoinExt.Primitive.Combinators.prim (Word.Word (S (S (S (S (S O))))))
        (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))) alg BitcoinExt.InputScriptSigHash))
     : forall alg : PrimitiveBitcoinExt.Primitive.Algebra,
       PrimitiveBitcoinExt.Primitive.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments bitcoin_current_script_sig_hash_spec {alg}
wz =
fun (n : nat) (w : Ty.tySem (Word.Word n)) => @Word.ToZ.Theory.toZ (Word.WordToZ n) w
     : forall (n : nat) (_ : Ty.tySem (Word.Word n)), BinNums.Z

Arguments wz n%nat_scope w
wsize =
fun n : nat => BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (BinInt.Z.of_nat (PeanoNat.Nat.pow (S (S O)) n))
     : forall _ : nat, BinNums.Z

Arguments wsize n%nat_scope
sum_first =
fix sum_first (vals : list BinNums.Z) (j : nat) {struct vals} : BinNums.Z :=
  match j return BinNums.Z with
  | O => BinNums.Z0
  | S j0 => match vals return BinNums.Z with
            | nil => BinNums.Z0
            | cons v t => BinInt.Z.add v (sum_first t j0)
            end
  end
     : forall (_ : list BinNums.Z) (_ : nat), BinNums.Z

Arguments sum_first vals%list_scope j%nat_scope
total_adder =
fun alg : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
  (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))) alg
  (@Word.adder (S (S (S (S (S (S O)))))) alg)
  (@Alg.Core.Combinators.drop (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S O)))))))
     (Word.Word (S (S (S (S (S (S O))))))) alg (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) alg))
     : forall alg : Alg.Core.Algebra,
       Alg.Core.domain alg (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Word.Word (S (S (S (S (S (S O)))))))

Arguments total_adder {alg}
total_body =
fun (alg : Alg.Core.Algebra)
  (op : Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
=>
@Alg.Core.Combinators.comp
  (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
  (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))))
  (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))) alg
  (@Alg.Core.Combinators.pair
     (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))) alg
     (@Alg.Core.Combinators.take (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Word.Word (S (S (S (S (S (S O))))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) alg
        (@Alg.Core.Combinators.drop Ty.Unit (Word.Word (S (S (S (S (S O))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))) alg op))
     (@Alg.Core.Combinators.drop (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O)))))))
        (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))) alg
        (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) alg)))
  (@Alg.Core.Combinators.case Ty.Unit (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))
     (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))) alg
     (@Alg.Core.Combinators.injl (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
        (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))) alg
        (@Alg.Core.Combinators.drop Ty.Unit (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))
           alg (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) alg)))
     (@Alg.Core.Combinators.injr (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
        (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))) alg (@total_adder alg)))
     : forall (alg : Alg.Core.Algebra)
         (_ : Alg.Core.domain alg (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))),
       Alg.Core.domain alg
         (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))

Arguments total_body {alg} op
total_program =
fun (alg : Alg.Core.Algebra)
  (op : Alg.Core.domain alg (Word.Word (S (S (S (S (S O)))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))))
=>
@Alg.Core.Combinators.comp Ty.Unit (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
  (Word.Word (S (S (S (S (S (S O))))))) alg
  (@Alg.Core.Combinators.pair Ty.Unit Ty.Unit (Word.Word (S (S (S (S (S (S O))))))) alg
     (@Alg.Core.Combinators.iden Ty.Unit alg) (@Word.zero (S (S (S (S (S (S O)))))) alg))
  (@Alg.Core.Combinators.comp (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))
     (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))
     (Word.Word (S (S (S (S (S (S O))))))) alg
     (@for_while_program (S (S (S (S (S O))))) Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))
        (Word.Word (S (S (S (S (S (S O))))))) alg (@total_body alg op))
     (@Alg.Core.Combinators.copair (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O)))))))
        (Word.Word (S (S (S (S (S (S O))))))) alg
        (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) alg)
        (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S O))))))) alg)))
     : forall (alg : Alg.Core.Algebra)
         (_ : Alg.Core.domain alg (Word.Word (S (S (S (S (S O))))))
                (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))),
       Alg.Core.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S O)))))))

Arguments total_program {alg} op
total_step =
fun
  (op : forall _ : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
        option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S O))))))))))
  (p : Ty.tySem (Ty.Prod (Ty.Prod Ty.Unit (Word.Word (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))) =>
match
  op
    (@snd unit
       (prod
          ((fix tySem (X : Ty.Ty) : Set :=
              match X return Set with
              | Ty.Unit => unit
              | Ty.Sum A B => sum (tySem A) (tySem B)
              | Ty.Prod A B => prod (tySem A) (tySem B)
              end)
             ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                 match n return Ty.Ty with
                 | O => X
                 | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                 end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O))))))
          ((fix tySem (X : Ty.Ty) : Set :=
              match X return Set with
              | Ty.Unit => unit
              | Ty.Sum A B => sum (tySem A) (tySem B)
              | Ty.Prod A B => prod (tySem A) (tySem B)
              end)
             ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                 match n return Ty.Ty with
                 | O => X
                 | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                 end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S O)))))))
       (@fst
          (prod
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) Ty.Unit)
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Word (S (S (S (S (S O))))))))
          (prod
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))) p))
  return (option (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))))
with
| Some t =>
    match
      t return (option (Ty.tySem (Ty.Sum (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S O))))))))))
    with
    | inl _ =>
        @Some
          (sum
             (prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O))))))))
             (prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))))
          (@inl
             (prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O))))))))
             (prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O))))))))
             (@snd
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) Ty.Unit)
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end) (Word.Word (S (S (S (S (S O))))))))
                (prod
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                          match n return Ty.Ty with
                          | O => X
                          | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                          end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                          match n return Ty.Ty with
                          | O => X
                          | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                          end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))) p))
    | inr v =>
        @Some
          (sum
             (prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O))))))))
             (Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))))
          (@inr
             (prod
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end)
                   ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                       match n return Ty.Ty with
                       | O => X
                       | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                       end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O))))))))
