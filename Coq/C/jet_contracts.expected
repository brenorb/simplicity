indexed_ptr_cells =
fun (A : Type) (elems : list A) (nbits : BinNums.Z) (pcells : forall _ : A, list Cell)
  (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match @List.nth_error A elems (BinInt.Z.to_nat (toZ32 a)) return (list Cell) with
| Some x => @cons (option bool) (@Some bool true) (pcells x)
| None => @cons (option bool) (@Some bool false) (@List.repeat (option bool) (@None bool) (BinInt.Z.to_nat nbits))
end
     : forall (A : Type) (_ : list A) (_ : BinNums.Z) (_ : forall _ : A, list Cell)
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))), list Cell

