Clight.Ssequence (cmp_blk BinNums.Z0 jets_sha._t'37 jets_sha._t'38 jets_sha._t'39 jets_sha._t'40 jets_sha._t'1)
  (Clight.Ssequence
     (cmp_blk (BinNums.Zpos BinNums.xH) jets_sha._t'33 jets_sha._t'34 jets_sha._t'35 jets_sha._t'36 jets_sha._t'2)
     (Clight.Ssequence
