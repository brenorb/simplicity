                 (Ty.Prod (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))
                    (Ty.Prod (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))
