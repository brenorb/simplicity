wide_divides_guarantees =
fun s : wide_size =>
jet_local_spec_guarantees (wide_divides s) (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s)))
  (Ty.Sum Ty.Unit Ty.Unit)
  (fun xy : Ty.tySem (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s))) =>
