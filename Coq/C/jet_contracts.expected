canonical_512_divisor_value
     : @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S (S O))))))))))
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (@Word.zero (S (S (S (S (S (S (S (S O)))))))) Alg.CoreFunSem tt) canonical_field_word))
         canonical_field_order
canonical_fe_normalize512_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S (S O)))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
            (@canonical_fe_normalize512 Alg.CoreFunSem x))
         (BinInt.Z.modulo (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S (S O)))))))))) x)
            canonical_field_order)
canonical_negate_factor_value
     : @eq BinNums.Z (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) canonical_negate_factor)
         (BinInt.Z.sub canonical_field_order (BinNums.Zpos BinNums.xH))
canonical_fe_negate_step
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (@canonical_fe_negate Alg.CoreFunSem x)
         (@canonical_fe_normalize512 Alg.CoreFunSem
            (@multiply_word_spec (S (S (S (S (S (S (S (S O)))))))) Alg.CoreFunSem
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) canonical_negate_factor x)))
canonical_fe_negate_numeric
     : forall x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq BinNums.Z
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) (@canonical_fe_negate Alg.CoreFunSem x))
         (BinInt.Z.modulo
            (BinInt.Z.sub canonical_field_order
               (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)) canonical_field_order)
