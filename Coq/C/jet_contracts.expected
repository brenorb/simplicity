                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
right_extend_word8_context_guarantees
     : forall (s : extend_word8_size) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout)
         (ctx : Context) (a : Ty.tySem (Word.Word (S (S (S O))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S O)))) a)
              (newWriteFrame (bitSize (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S O)))) a)
              (fullWriteFrame
                 (@encode (Word.Vector (Word.Word (S (S (S O)))) (extend_word8_depth s))
                    (@right_extend_word_spec (S (S (S O))) (extend_word8_depth s) Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (right_extend_word8_function s)) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@right_extend_word_spec (S (S (S O))) (extend_word8_depth s) Naive.translate)
                  (Running s0) (Running s1))))
write_wide_sequence_run_layout
     : forall (s : wide_size) (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (xs : list Integers.Int64.int)
         (_ : write_frame_at m bf base bw edge cursor
                (BinInt.Z.mul (wide_bits s) (BinInt.Z.of_nat (@length Integers.Int64.int xs)))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and (write_wide_sequence_run s bf base xs m mf)
            (and (frame_output_cells_at mf bw edge cursor (wide_sequence_cells s xs))
               (and (write_prefix_at m mf bw edge cursor)
                  (and
                     (frame_fields_at mf bf base bw edge
                        (BinInt.Z.sub cursor
                           (BinInt.Z.mul (wide_bits s) (BinInt.Z.of_nat (@length Integers.Int64.int xs)))))
                     (and
                        (loads_outside_ranges m mf bf
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor
                                       (BinInt.Z.mul (wide_bits s) (BinInt.Z.of_nat (@length Integers.Int64.int xs))))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
extend_wide_loop_shape
     : forall s : extend_wide_size,
       @eq Clight.statement
         match Clight.fn_body (extend_wide_function s) return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s1 =>
             match s1 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s3 =>
                 match s3 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence _ s5 =>
                     match s5 return Clight.statement with
                     | Clight.Sskip => Clight.Sskip
                     | Clight.Sassign _ _ => Clight.Sskip
                     | Clight.Sset _ _ => Clight.Sskip
                     | Clight.Scall _ _ _ => Clight.Sskip
                     | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                     | Clight.Ssequence s6 _ =>
                         match s6 return Clight.statement with
                         | Clight.Sskip => Clight.Sskip
                         | Clight.Sassign _ _ => Clight.Sskip
                         | Clight.Sset _ _ => Clight.Sskip
                         | Clight.Scall _ _ _ => Clight.Sskip
                         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                         | Clight.Ssequence _ loop => loop
                         | Clight.Sifthenelse _ _ _ => Clight.Sskip
                         | Clight.Sloop _ _ => Clight.Sskip
                         | Clight.Sbreak => Clight.Sskip
                         | Clight.Scontinue => Clight.Sskip
                         | Clight.Sreturn _ => Clight.Sskip
                         | Clight.Sswitch _ _ => Clight.Sskip
                         | Clight.Slabel _ _ => Clight.Sskip
                         | Clight.Sgoto _ => Clight.Sskip
                         end
                     | Clight.Sifthenelse _ _ _ => Clight.Sskip
                     | Clight.Sloop _ _ => Clight.Sskip
                     | Clight.Sbreak => Clight.Sskip
                     | Clight.Scontinue => Clight.Sskip
                     | Clight.Sreturn _ => Clight.Sskip
                     | Clight.Sswitch _ _ => Clight.Sskip
                     | Clight.Slabel _ _ => Clight.Sskip
                     | Clight.Sgoto _ => Clight.Sskip
                     end
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end (extend_wide_loop s)
