  match n return (list cell) with
  | O => @nil cell
  | S n0 =>
      @cons cell (mkcell ofs AST.Mint8unsigned (@None sx)) (byte_undef (BinInt.Z.add ofs (BinNums.Zpos BinNums.xH)) n0)
  end
     : forall (_ : BinNums.Z) (_ : nat), list cell

