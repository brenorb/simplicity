                                                                (BinNums.xI
                                                                   (BinNums.xI
                                                                      (BinNums.xI (BinNums.xI (BinNums.xI (...)))))))))))))))))
                               (and
                                  (and (BinInt.Z.le BinNums.Z0 r2)
                                     (BinInt.Z.le r2
                                        (BinNums.Zpos
                                           (BinNums.xI
                                              (BinNums.xI
                                                 (BinNums.xI
                                                    (BinNums.xI
                                                       (BinNums.xI
                                                          (BinNums.xI
                                                             (BinNums.xI
                                                                (BinNums.xI
                                                                   (BinNums.xI
                                                                      (BinNums.xI (BinNums.xI (BinNums.xI (...))))))))))))))))
                                  (and
                                     (and (BinInt.Z.le BinNums.Z0 r3)
                                        (BinInt.Z.le r3
                                           (BinNums.Zpos
                                              (BinNums.xI
                                                 (BinNums.xI
