                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._r le)
                (@Some Values.val (Values.Vptr b (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t'1 le)
                (@Some Values.val (Values.Vint flag)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint32 m b
