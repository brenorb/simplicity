eval_skipBits_layout
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor n : BinNums.Z) (_ : frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 n) (BinInt.Z.le n cursor))
         (_ : BinInt.Z.le cursor Integers.Int64.max_unsigned) (_ : frame_fields_at m bf base bw edge cursor)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_skipBits)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vlong (Integers.Int64.repr n)) (@nil Values.val))) Events.E0 mf
               Values.Vundef)
            (and (frame_fields_at mf bf base bw edge (BinInt.Z.sub cursor n))
               (and
                  (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                     (_ : or (not (@eq Values.block b bf))
                            (or
                               (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                  (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                               (BinInt.Z.le
                                  (BinInt.Z.add base
                                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs))),
                   @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                  (and
                     (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                        (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mf b ofs kind p)
                     (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
eval_skipBits_padding
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (count : nat) (_ : write_frame_at m bf base bw edge cursor (BinInt.Z.of_nat count)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_skipBits)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vlong (Integers.Int64.repr (BinInt.Z.of_nat count))) (@nil Values.val)))
               Events.E0 mf Values.Vundef)
            (and (frame_output_cells_at mf bw edge cursor (@List.repeat (option bool) (@None bool) count))
               (and (write_prefix_at m mf bw edge cursor)
                  (and (frame_fields_at mf bf base bw edge (BinInt.Z.sub cursor (BinInt.Z.of_nat count)))
                     (and
                        (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                           (_ : or (not (@eq Values.block b bf))
                                  (or
                                     (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                        (BinInt.Z.add base
                                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     (BinInt.Z.le
                                        (BinInt.Z.add base
                                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                        ofs))),
                         @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
