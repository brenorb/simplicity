                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@canonical_scalar_normalize Alg.CoreFunSem value))) layout scalar_writer_initial_regs mf)
               (and
                  (finv m0 bd dbase bw outedge cursor N bi mf true
                     (@app Cell outs0
                        (@encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                           (@canonical_scalar_normalize Alg.CoreFunSem value))))
                  (lframe
                     (frame (jet_secp_scalar_writer_exec.scalar_write_ext m0 bd bw bi) layout
                        scalar_writer_initial_regs m) m mf))))
