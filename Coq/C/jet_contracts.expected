           (Build_LocalState (@encode (Word.Word (S (S (S (S O))))) a)
              (newWriteFrame (bitSize (Word.Word (S (S (S (S O)))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (S (S (S O))))) a)
              (fullWriteFrame
                 (@encode (Word.Word (S (S (S (S O))))) (@div_mod_word_spec (S (S (S O))) Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
