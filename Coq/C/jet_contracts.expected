upd =
fix upd (A : Type) (l : list A) (i : nat) (v : A) {struct l} : list A :=
  match l return (list A) with
  | nil => @nil A
  | cons x t => match i return (list A) with
                | O => @cons A v t
                | S i0 => @cons A x (upd A t i0 v)
                end
  end
     : forall (A : Type) (_ : list A) (_ : nat) (_ : A), list A

Arguments upd {A}%type_scope l%list_scope i%nat_scope v
xstore =
fun (regs : list region) (r : nat) (d : BinNums.Z) (ch : AST.memory_chunk) (x : sx) =>
match @List.nth_error region regs r return (option (list region)) with
| Some reg =>
    match rw reg return (option (list region)) with
    | true =>
        match find_cell (rcells reg) d ch return (option (list region)) with
        | Some _ =>
            match xnorm ch x return (option (list region)) with
            | Some x' =>
                match xp_le r x' return (option (list region)) with
                | true =>
                    @Some (list region)
                      (@upd region regs r (mkreg (set_cell (rcells reg) d ch (@Some sx x')) (rw reg) (rfree reg)))
                | false => @None (list region)
                end
            | None => @None (list region)
            end
        | None => @None (list region)
        end
    | false => @None (list region)
    end
| None => @None (list region)
end
     : forall (_ : list region) (_ : nat) (_ : BinNums.Z) (_ : AST.memory_chunk) (_ : sx), option (list region)

Arguments xstore regs%list_scope r%nat_scope d%Z_scope ch x
xload =
fun (regs : list region) (r : nat) (d : BinNums.Z) (ty : Ctypes.type) =>
match Ctypes.access_mode ty return (option sx) with
| Ctypes.By_value ch =>
    match @List.nth_error region regs r return (option sx) with
    | Some reg => match find_cell (rcells reg) d ch return (option sx) with
                  | Some c => cval c
                  | None => @None sx
                  end
    | None => @None sx
    end
| Ctypes.By_reference => @Some sx (XP r d)
| Ctypes.By_copy => @Some sx (XP r d)
| Ctypes.By_nothing => @None sx
end
     : forall (_ : list region) (_ : nat) (_ : BinNums.Z) (_ : Ctypes.type), option sx

Arguments xload regs%list_scope r%nat_scope d%Z_scope ty
zreg_okb =
fix zreg_okb (bnd : forall _ : nat, prod BinNums.Z BinNums.Z) (ofs : BinNums.Z) (cs : list cell) {struct cs} : bool :=
  match cs return bool with
  | nil => true
  | cons c t =>
      andb
        (andb (andb (BinInt.Z.eqb (cofs c) ofs) (chunk_eqb (cchunk c) AST.Mint64))
           match cval c return bool with
           | Some x => andb (isk KL x) match zb bnd x return bool with
                                       | Some _ => true
                                       | None => false
                                       end
           | None => false
           end) (zreg_okb bnd (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) t)
  end
     : forall (_ : forall _ : nat, prod BinNums.Z BinNums.Z) (_ : BinNums.Z) (_ : list cell), bool

