write_fe_entries
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (ibits : list bool)
         (w0 : bool) (outs0 : list Cell) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (id : AST.ident) (ent : fentry) (_ : @eq (option fentry) (flookup write_fe_table id) (@Some fentry ent)),
       and
         (@ex Values.block
            (fun b : Values.block =>
             and
               (@eq (option Values.block)
                  (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) id)
                  (@Some Values.block b))
               (@eq (option Clight.fundef)
                  (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv secp_ge) b)
                  (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function (fentry_fd ent))))))
         match ent return Prop with
         | FInt _ => True
         | FOra fd oracle =>
             oracle_ok secp_ge (jet_secp_write_fe_wrapper.write_evok bd dbase bi edge ibits)
               (jet_secp_write_fe_wrapper.write_inv m0 bd dbase bw outedge cursor N bi rc w0 outs0)
               (jet_secp_write_fe_wrapper.write_ext m0 bd bw bi) fd oracle
         end
