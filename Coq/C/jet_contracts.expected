ctx8_add_list =
fix ctx8_add_list (c : Ty.tySem sha256_ctx8_type) (l : list (Ty.tySem (Word.Word (S (S (S O)))))) {struct l} :
    option (Ty.tySem sha256_ctx8_type) :=
  match l return (option (Ty.tySem sha256_ctx8_type)) with
  | nil => @Some (Ty.tySem sha256_ctx8_type) c
