                (@encode (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O)))))) a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (shift8_with_function right))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) m (Values.Vint Integers.Int.one) mf)
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S O)))) (@shift8_with_spec right Alg.CoreFunSem a)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O))))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat (bitSize (Word.Word (S (S (S O)))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
shift8_with_context_guarantees
     : forall (right : bool) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem
                (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
                   (Ty.Prod (Word.Word (S (S O))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode
                 (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
                    (Ty.Prod (Word.Word (S (S O))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))) a)
              (newWriteFrame (bitSize (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState
              (@encode
                 (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
                    (Ty.Prod (Word.Word (S (S O))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))) a)
              (fullWriteFrame
                 (@encode (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))
                    (@shift8_with_spec right Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog)
               (@Ctypes.Internal Clight.function (shift8_with_function right)) (jet_args env L) m
               (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1) (runProgram (@shift8_with_spec right Naive.translate) (Running s0) (Running s1))))
shift8_with_machine_denotes
     : forall (right : bool) (fill : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (amount : Ty.tySem (Word.Word (S (S O))))
         (x : Ty.tySem (Word.Word (S (S (S O))))),
       @eq (Ty.tySem (Word.Word (S (S (S O))))) (shift8_with_machine_value right fill amount x)
         (@shift8_with_spec right Alg.CoreFunSem
            (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit))
               (prod (Ty.tySem (Word.Word (S (S O)))) (Ty.tySem (Word.Word (S (S (S O)))))) fill
               (@pair (Ty.tySem (Word.Word (S (S O)))) (Ty.tySem (Word.Word (S (S (S O))))) amount x)))
eval_shift8_with_layout_machine
     : forall (env : Values.val) (right : bool) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (fill : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (amount : Ty.tySem (Word.Word (S (S O))))
         (x : Ty.tySem (Word.Word (S (S (S O))))) (cursor rc : BinNums.Z) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.add
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : frame_input_bit_at m bi edge rc (Bit.toBool fill))
         (_ : @frame_input_word_at (S (S O)) m bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) amount)
         (_ : @frame_input_word_at (S (S (S O))) m bi edge
                (BinInt.Z.add rc
                   (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))) x)
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function (shift8_with_function right))
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S O)))) (shift8_with_machine_value right fill amount x)))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m b)
                        (_ : or (not (@eq Values.block b bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
shift8_with_spec_parametric
     : forall right : bool,
       @Alg.Core.Parametric
         (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit)
            (Ty.Prod (Word.Word (S (S O))) (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))))
         (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))) (@shift8_with_spec right)
bit_flip_twice
     : forall b : Ty.tySem (Ty.Sum Ty.Unit Ty.Unit),
       @eq (sum unit unit)
         match
           match b return (sum unit unit) with
           | inl _ => @inr unit unit tt
           | inr _ => @inl unit unit tt
           end return (sum unit unit)
         with
         | inl _ => @inr unit unit tt
         | inr _ => @inl unit unit tt
         end b
shift8_with_complement_normalform
     : forall (right fill : bool)
         (amount : prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
         (x : Ty.tySem (Word.Word (S (S (S O))))),
       @eq (Ty.tySem (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O)))))
         (@shift8_with_spec right Alg.CoreFunSem
            (@pair (sum unit unit)
               (prod (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                  (Ty.tySem (Word.Word (S (S (S O)))))) (Bit.fromBool fill)
               (@pair (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                  (Ty.tySem (Word.Word (S (S (S O))))) amount x)))
         match fill return (Ty.tySem (Word.Vector (Ty.Sum Ty.Unit Ty.Unit) (S (S (S O))))) with
         | true =>
             @complement_spec (S (S (S O))) Alg.CoreFunSem
               (@shift8_plain_spec right Alg.CoreFunSem
                  (@pair (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                     (Ty.tySem (Word.Word (S (S (S O))))) amount (@complement_spec (S (S (S O))) Alg.CoreFunSem x)))
         | false =>
             @shift8_plain_spec right Alg.CoreFunSem
               (@pair (prod (prod (sum unit unit) (sum unit unit)) (prod (sum unit unit) (sum unit unit)))
                  (Ty.tySem (Word.Word (S (S (S O))))) amount x)
         end
complement_spec_involutive
     : forall (n : nat) (x : Ty.tySem (Word.Word n)),
       @eq (Ty.tySem (Word.Word n)) (@complement_spec n Alg.CoreFunSem (@complement_spec n Alg.CoreFunSem x)) x
low_byte_mask_bit
     : forall (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))),
       @eq bool
         (Integers.Int.testbit
            (Integers.Int.repr
               (BinNums.Zpos
                  (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
            j) true
shift8_fill_result_bits
     : forall (r : Integers.Int.int) (j : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 j)
                (BinInt.Z.lt j (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))),
       @eq bool (Integers.Int.testbit (shift8_fill_result r) j) (negb (Integers.Int.testbit r j))
shift8_fill_result_repr
     : forall (x : Ty.tySem (Word.Word (S (S (S O))))) (r : Integers.Int.int)
         (_ : @eq BinNums.Z (Integers.Int.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x)),
       @eq Integers.Int.int (shift8_fill_result r)
         (Integers.Int.repr
            (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) (@complement_spec (S (S (S O))) Alg.CoreFunSem x)))
shift8_fill_result_unsigned
     : forall (x : Ty.tySem (Word.Word (S (S (S O))))) (r : Integers.Int.int)
         (_ : @eq BinNums.Z (Integers.Int.unsigned r) (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x)),
       @eq BinNums.Z (Integers.Int.unsigned (shift8_fill_result r))
         (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) (@complement_spec (S (S (S O))) Alg.CoreFunSem x))
eval_readBit4_byte_sequence
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bi : Values.block)
         (edge rc : BinNums.Z) (fill : bool) (amount : Ty.tySem (Word.Word (S (S O))))
         (x : Ty.tySem (Word.Word (S (S (S O))))) (_ : frame_base_valid base)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinInt.Z.add
                         (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (_ : frame_fields_at m bf base bi edge rc) (_ : frame_input_bit_at m bi edge rc fill)
         (_ : @frame_input_word_at (S (S O)) m bi edge (BinInt.Z.add rc (BinNums.Zpos BinNums.xH)) amount)
         (_ : @frame_input_word_at (S (S (S O))) m bi edge
                (BinInt.Z.add rc
                   (BinInt.Z.add (BinNums.Zpos BinNums.xH) (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))) x)
         (_ : Memory.Mem.valid_access m AST.Mint64 bf
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : not (@eq Values.block bf bi)),
       @ex Memory.Mem.mem
         (fun mb : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mr : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                @ex Integers.Int.int
                  (fun a : Integers.Int.int =>
                   @ex Integers.Int.int
                     (fun r : Integers.Int.int =>
                      and
                        (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_readBit)
                           (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val)) Events.E0
                           mb (Values.Vint (bit_int fill)))
                        (and
                           (ClightBigstep.Clight2.eval_funcall ge0 mb
                              (@Ctypes.Internal Clight.function f_simplicity_read4)
                              (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))
                              Events.E0 mr (Values.Vint a))
                           (and
                              (@eq BinNums.Z (Integers.Int.unsigned a)
                                 (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S O))) amount))
                              (and
                                 (@eq Integers.Int.int
                                    (Integers.Int.zero_ext
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) a) a)
                                 (and
                                    (ClightBigstep.Clight2.eval_funcall ge0 mr
                                       (@Ctypes.Internal Clight.function f_simplicity_read8)
                                       (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base)) (@nil Values.val))
                                       Events.E0 mf (Values.Vint r))
                                    (and
                                       (@eq BinNums.Z (Integers.Int.unsigned r)
                                          (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x))
                                       (and
                                          (frame_fields_at mf bf base bi edge
                                             (BinInt.Z.add rc
                                                (BinInt.Z.add
                                                   (BinInt.Z.add (BinNums.Zpos BinNums.xH)
                                                      (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))))
                                                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                          (and
                                             (forall (chunk : AST.memory_chunk) (b : Values.block)
                                                (ofs : BinNums.Z)
                                                (_ : or (not (@eq Values.block b bf))
                                                       (or
                                                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                                             (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (...)))))
                                                          (BinInt.Z.le
                                                             (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (...)))) ofs))),
                                              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs)
                                                (Memory.Mem.load chunk m b ofs))
                                             (and
                                                (forall (b : Values.block) (ofs : BinNums.Z)
                                                   (kind : Memtype.perm_kind) (p : Memtype.permission)
                                                   (_ : Memory.Mem.perm m b ofs kind p),
                                                 Memory.Mem.perm mf b ofs kind p)
                                                (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                                 Memory.Mem.valid_block mf b))))))))))))))
exec_shift8_with_helper_call
     : forall (right fill : bool) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem)
         (bl bd : Values.block) (dofs : Integers.Ptrofs.int) (a r : Integers.Int.int) (mr mr2 : Memory.Mem.mem)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _dst le) (@Some Values.val (Values.Vptr bd dofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _with le)
                (@Some Values.val (Values.Vint (bit_int fill))))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_read4)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr (@Ctypes.Internal Clight.function f_simplicity_read8)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vint r))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr2 (@Ctypes.Internal Clight.function f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd dofs)
                   (@cons Values.val
                      (Values.Vint
                         (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (shift8_payload right fill r a))) (@nil Values.val))) Events.E0 mf Values.Vundef),
       ClightBigstep.Clight2.exec_stmt ge0 (jet_one8.e_one8 bl) le m (shift8_with_helper_call right) Events.E0 le mf
         ClightBigstep.Out_normal
shift8_with_body
     : forall right : bool,
       @eq Clight.statement (Clight.fn_body (shift8_with_function right))
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar _src (Ctypes.Tstruct _frameItem Ctypes.noattr))
               (Clight.Etempvar _src (Ctypes.Tstruct _frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence bit_jet_read
                  (Clight.Sset _with (Clight.Ecast (Clight.Etempvar _t'1 Ctypesdefs.tbool) Ctypesdefs.tbool)))
               (Clight.Ssequence (shift8_with_helper_call right)
                  (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))))))
eval_shift8_with_composes
     : forall (env : Values.val) (right fill : bool) (m : Memory.Mem.mem) (ma : Memory.Mem.mem')
         (mc mb mr mr2 me mf : Memory.Mem.mem) (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bytes : list Memdata.memval) (a r : Integers.Int.int) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mc (@Ctypes.Internal Clight.function f_readBit)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mb
                (Values.Vint (bit_int fill)))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mb (@Ctypes.Internal Clight.function f_simplicity_read4)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                (Values.Vint a))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr (@Ctypes.Internal Clight.function f_simplicity_read8)
                (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr2
                (Values.Vint r))
         (_ : ClightBigstep.Clight2.eval_funcall ge0 mr2 (@Ctypes.Internal Clight.function f_simplicity_write8)
                (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                   (@cons Values.val
                      (Values.Vint
                         (Integers.Int.zero_ext (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                            (shift8_payload right fill r a))) (@nil Values.val))) Events.E0 me Values.Vundef)
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.free me bl BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
