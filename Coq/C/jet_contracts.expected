                ctx8_limit) (xs_of : forall _ : ext_environment, list (Ty.tySem X))
         (_ : forall (i : Ty.tySem (Word.Word w)) (e : BitcoinFull.env),
              @eq (option (Ty.tySem (Ty.Sum Ty.Unit X))) (@BitcoinFull.sem (Word.Word w) (Ty.Sum Ty.Unit X) p i e)
                (@Some (sum unit (Ty.tySem X))
                   match
                     @List.nth_error (Ty.tySem X) (xs_of e) (BinInt.Z.to_nat (wz w i)) return (sum unit (Ty.tySem X))
                   with
