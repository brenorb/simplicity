                     (@nil region)) mf)
               (lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (foot layout
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           u128_accum_mul_initial_regs) b ofs)) m mf)))
accum_mul_lo_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout accum_mul_lo) (Values.Vlong (accum_mul_lo_machine rho))
accum_mul_hi_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho layout accum_mul_hi) (Values.Vlong (accum_mul_hi_machine rho))
accum_mul_unsigned_outputs
     : forall rho : forall _ : nat, Integers.Int64.int,
       let product : BinNums.Z := BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S O)))
         in
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (accum_mul_lo_machine rho))
            (BinInt.Z.modulo
               (BinInt.Z.add (Integers.Int64.unsigned (rho (S (S O)))) (BinInt.Z.modulo product Integers.Int64.modulus))
               Integers.Int64.modulus))
         (@eq BinNums.Z (Integers.Int64.unsigned (accum_mul_hi_machine rho))
            (BinInt.Z.modulo
               (BinInt.Z.add
                  (BinInt.Z.add (Integers.Int64.unsigned (rho (S (S (S O)))))
                     (BinInt.Z.div product Integers.Int64.modulus))
                  (BinInt.Z.div
                     (BinInt.Z.add (Integers.Int64.unsigned (rho (S (S O))))
                        (BinInt.Z.modulo product Integers.Int64.modulus)) Integers.Int64.modulus))
               Integers.Int64.modulus))
accum_mul_two_limb_mod
     : forall (M H L P : BinNums.Z) (_ : BinInt.Z.lt BinNums.Z0 M),
       @eq BinNums.Z
         (BinInt.Z.add
            (BinInt.Z.mul
               (BinInt.Z.modulo
                  (BinInt.Z.add (BinInt.Z.add H (BinInt.Z.div P M))
                     (BinInt.Z.div (BinInt.Z.add L (BinInt.Z.modulo P M)) M)) M) M)
            (BinInt.Z.modulo (BinInt.Z.add L (BinInt.Z.modulo P M)) M))
         (BinInt.Z.modulo (BinInt.Z.add (BinInt.Z.add (BinInt.Z.mul H M) L) P) (BinInt.Z.mul M M))
accum_mul_numeric_value
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned (accum_mul_hi_machine rho)) Integers.Int64.modulus)
            (Integers.Int64.unsigned (accum_mul_lo_machine rho)))
         (BinInt.Z.modulo
            (BinInt.Z.add
               (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned (rho (S (S (S O))))) Integers.Int64.modulus)
                  (Integers.Int64.unsigned (rho (S (S O)))))
               (BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S O)))))
            (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus))
eval_u128_accum_mul_owned_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (layout : layout) (m : Memory.Mem.mem)
         (_ : rep rho layout u128_accum_mul_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_u128_accum_mul)
               (@cons Values.val (Values.Vptr (blk layout O) (Integers.Ptrofs.repr (bas layout O)))
                  (@cons Values.val (Values.Vlong (rho O))
                     (@cons Values.val (Values.Vlong (rho (S O))) (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf (blk layout O) (bas layout O))
                  (@Some Values.val (Values.Vlong (accum_mul_lo_machine rho))))
               (and
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf (blk layout O)
                        (BinInt.Z.add (bas layout O) (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val (Values.Vlong (accum_mul_hi_machine rho))))
                  (and
                     (@eq BinNums.Z
                        (BinInt.Z.add
                           (BinInt.Z.mul (Integers.Int64.unsigned (accum_mul_hi_machine rho)) Integers.Int64.modulus)
                           (Integers.Int64.unsigned (accum_mul_lo_machine rho)))
                        (BinInt.Z.modulo
                           (BinInt.Z.add
                              (BinInt.Z.add
                                 (BinInt.Z.mul (Integers.Int64.unsigned (rho (S (S (S O))))) Integers.Int64.modulus)
                                 (Integers.Int64.unsigned (rho (S (S O)))))
                              (BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S O)))))
                           (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)))
                     (and
                        (rep rho layout
                           (@cons region
                              (mkreg (u64_cells BinNums.Z0 (@cons sx accum_mul_lo (@cons sx accum_mul_hi (@nil sx))))
                                 true
                                 (@Some BinNums.Z
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                              (@nil region)) mf)
                        (lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot layout
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape u128_accum_mul_initial_regs) b ofs)) m mf))))))
column_value_nonnegative
     : forall s : mul_column, BinInt.Z.le BinNums.Z0 (column_value s)
column_value_zero
     : @eq BinNums.Z (column_value column_zero) BinNums.Z0
column_top_small
     : forall (s : mul_column)
         (_ : BinInt.Z.lt (column_value s)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))
                   (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus))),
       BinInt.Z.lt (Integers.Int.unsigned (col_top s)) Integers.Int.max_unsigned
column_muladd_value
     : forall (a b : Integers.Int64.int) (s : mul_column)
         (_ : BinInt.Z.lt (Integers.Int.unsigned (col_top s)) Integers.Int.max_unsigned),
       @eq BinNums.Z (column_value (column_muladd a b s))
         (BinInt.Z.add (column_value s) (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
column_extract_decomposition
     : forall s : mul_column,
       @eq BinNums.Z (column_value s)
         (BinInt.Z.add (Integers.Int64.unsigned (col_lo s))
            (BinInt.Z.mul Integers.Int64.modulus (column_value (column_extract s))))
column_extract_value
     : forall s : mul_column,
       @eq BinNums.Z (column_value (column_extract s)) (BinInt.Z.div (column_value s) Integers.Int64.modulus)
column_fast_mod
     : forall (a b : Integers.Int64.int) (s : mul_column) (_ : @eq Integers.Int.int (col_top s) Integers.Int.zero),
       @eq BinNums.Z (column_value (column_muladd_fast a b s))
         (BinInt.Z.modulo
            (BinInt.Z.add (column_value s) (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
            (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus))
column_fast_value
     : forall (a b : Integers.Int64.int) (s : mul_column) (_ : @eq Integers.Int.int (col_top s) Integers.Int.zero)
         (_ : BinInt.Z.lt
                (BinInt.Z.add (column_value s) (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
                (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)),
       @eq BinNums.Z (column_value (column_muladd_fast a b s))
         (BinInt.Z.add (column_value s) (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
column_fast_extract_decomposition
     : forall (s : mul_column) (_ : @eq Integers.Int.int (col_top s) Integers.Int.zero),
       @eq BinNums.Z (column_value s)
         (BinInt.Z.add (Integers.Int64.unsigned (col_lo s))
            (BinInt.Z.mul Integers.Int64.modulus (column_value (column_extract_fast s))))
column_products_bound
     : forall ps : list (prod Integers.Int64.int Integers.Int64.int),
       and (BinInt.Z.le BinNums.Z0 (column_products ps))
         (BinInt.Z.le (column_products ps)
            (BinInt.Z.mul (BinInt.Z.of_nat (@length (prod Integers.Int64.int Integers.Int64.int) ps))
               (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)))
column_accumulate_value
     : forall (ps : list (prod Integers.Int64.int Integers.Int64.int)) (s : mul_column)
         (_ : BinInt.Z.lt (BinInt.Z.add (column_value s) (column_products ps))
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))
                   (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus))),
       @eq BinNums.Z (column_value (column_accumulate ps s)) (BinInt.Z.add (column_value s) (column_products ps))
column_accumulate_small
     : forall (ps : list (prod Integers.Int64.int Integers.Int64.int)) (s : mul_column)
         (_ : le (@length (prod Integers.Int64.int Integers.Int64.int) ps) (S (S (S (S O)))))
         (_ : BinInt.Z.lt (column_value s)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))) Integers.Int64.modulus)),
       and (@eq BinNums.Z (column_value (column_accumulate ps s)) (BinInt.Z.add (column_value s) (column_products ps)))
         (and
            (BinInt.Z.lt (column_value (column_accumulate ps s))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))
                  (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)))
            (BinInt.Z.lt (column_value (column_extract (column_accumulate ps s)))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))) Integers.Int64.modulus)))
column_fast_carry_small
     : forall a b : Integers.Int64.int,
       BinInt.Z.lt (column_value (column_extract_fast (column_muladd_fast a b column_zero)))
         (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))) Integers.Int64.modulus)
column_fast_zero_product
     : forall a b : Integers.Int64.int,
       @eq BinNums.Z (column_value (column_muladd_fast a b column_zero))
         (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
column_words_bound
     : forall xs : list Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (column_words_value xs))
         (BinInt.Z.lt (column_words_value xs)
            (BinInt.Z.pow Integers.Int64.modulus (BinInt.Z.of_nat (@length Integers.Int64.int xs))))
column_words_append
     : forall xs ys : list Integers.Int64.int,
       @eq BinNums.Z (column_words_value (@app Integers.Int64.int xs ys))
         (BinInt.Z.add (column_words_value xs)
            (BinInt.Z.mul (BinInt.Z.pow Integers.Int64.modulus (BinInt.Z.of_nat (@length Integers.Int64.int xs)))
               (column_words_value ys)))
final_symbolic_source
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int),
       @eq (list sx) (reduce512_final_limbs digits carry) (final_symbolic_outputs digits carry)
final_overflow_den
     : forall (digits rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho beta (final_overflow_sx digits)) (Values.Vint (b2i (scalar_overflow_bool digits)))
final_flag_integer_small
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (_ : BinInt.Z.le (Integers.Int64.unsigned carry) (BinNums.Zpos BinNums.xH)),
       and (BinInt.Z.le BinNums.Z0 (final_flag_integer digits carry))
         (BinInt.Z.le (final_flag_integer digits carry) (BinNums.Zpos (BinNums.xO BinNums.xH)))
final_flag_den
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (_ : BinInt.Z.le (Integers.Int64.unsigned carry) (BinNums.Zpos BinNums.xH)),
       @eq Values.val (den rho beta (final_flag_sx digits carry))
         (Values.Vint (Integers.Int.repr (final_flag_integer digits carry)))
final_bind_den
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx) (_ : BinInt.Z.le (Integers.Int64.unsigned carry) (BinNums.Zpos BinNums.xH)),
       @eq Values.val (den rho beta (final_bind digits carry x)) (den (final_rho digits carry) beta x)
final_output_weighted
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (_ : BinInt.Z.le (Integers.Int64.unsigned carry) (BinNums.Zpos BinNums.xH)) (b : bool)
         (_ : @eq BinNums.Z (final_flag_integer digits carry) (b2z b)),
       @eq BinNums.Z (final_output_value digits carry rho beta)
         (BinInt.Z.modulo
            (BinInt.Z.add (scalar_limb_value digits)
               (BinInt.Z.mul (b2z b)
                  (BinInt.Z.sub
                     (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                        (BinNums.Zpos
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     canonical_group_order)))
            (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
wide_value_nonnegative
     : forall s : wide_column, BinInt.Z.le BinNums.Z0 (wide_value s)
wide_from_word_value
     : forall x : Integers.Int64.int, @eq BinNums.Z (wide_value (wide_from_word x)) (Integers.Int64.unsigned x)
wide_top_small
     : forall (s : wide_column)
         (_ : BinInt.Z.lt (wide_value s)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))
                   (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus))),
       BinInt.Z.lt (Integers.Int64.unsigned (wtop s)) Integers.Int64.max_unsigned
wide_add_top_value
     : forall (t x y : Integers.Int64.int) (_ : BinInt.Z.lt (Integers.Int64.unsigned t) Integers.Int64.max_unsigned),
       @eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.add t (column_carry64 x y)))
         (BinInt.Z.add (Integers.Int64.unsigned t)
            (BinInt.Z.div (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y)) Integers.Int64.modulus))
wide_muladd_value
     : forall (a b : Integers.Int64.int) (s : wide_column)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned (wtop s)) Integers.Int64.max_unsigned),
       @eq BinNums.Z (wide_value (wide_muladd a b s))
         (BinInt.Z.add (wide_value s) (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
wide_sumadd_value
     : forall (x : Integers.Int64.int) (s : wide_column)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned (wtop s)) Integers.Int64.max_unsigned),
       @eq BinNums.Z (wide_value (wide_sumadd x s)) (BinInt.Z.add (wide_value s) (Integers.Int64.unsigned x))
wide_lower_value
     : forall (s : wide_column) (_ : @eq Integers.Int64.int (wtop s) Integers.Int64.zero),
       @eq BinNums.Z (column_value (wide_lower s)) (wide_value s)
wide_muladd_fast_value
     : forall (a b : Integers.Int64.int) (s : wide_column) (_ : @eq Integers.Int64.int (wtop s) Integers.Int64.zero)
         (_ : BinInt.Z.lt
                (BinInt.Z.add (wide_value s) (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
                (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)),
       @eq BinNums.Z (wide_value (wide_muladd_fast a b s))
         (BinInt.Z.add (wide_value s) (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)))
wide_sumadd_fast_value
     : forall (x : Integers.Int64.int) (s : wide_column) (_ : @eq Integers.Int64.int (wtop s) Integers.Int64.zero)
         (_ : BinInt.Z.lt (BinInt.Z.add (wide_value s) (Integers.Int64.unsigned x))
                (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)),
       @eq BinNums.Z (wide_value (wide_sumadd_fast x s)) (BinInt.Z.add (wide_value s) (Integers.Int64.unsigned x))
wide_extract_decomposition
     : forall s : wide_column,
       @eq BinNums.Z (wide_value s)
         (BinInt.Z.add (Integers.Int64.unsigned (wlo s))
            (BinInt.Z.mul Integers.Int64.modulus (wide_value (wide_extract s))))
wide_extract_value
     : forall s : wide_column,
       @eq BinNums.Z (wide_value (wide_extract s)) (BinInt.Z.div (wide_value s) Integers.Int64.modulus)
wide_extract_fast_decomposition
     : forall (s : wide_column) (_ : @eq Integers.Int64.int (wtop s) Integers.Int64.zero),
       @eq BinNums.Z (wide_value s)
         (BinInt.Z.add (Integers.Int64.unsigned (wlo s))
            (BinInt.Z.mul Integers.Int64.modulus (wide_value (wide_extract_fast s))))
column_bind_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : nat) (x : sx),
       @eq Values.val (den rho beta (column_bind a b x))
         (den
            (fun n : nat =>
             match PeanoNat.Nat.eqb n O return Integers.Int64.int with
             | true => rho a
             | false => rho b
             end) beta x)
column_symbolic_product_lo_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : nat),
       @eq Values.val (den rho beta (column_symbolic_product_lo a b))
         (Values.Vlong (umul128_lo_machine (rho a) (rho b)))
column_symbolic_product_hi_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : nat),
       @eq Values.val (den rho beta (column_symbolic_product_hi a b))
         (Values.Vlong (umul128_hi_machine (rho a) (rho b)))
scalar_mul512_symbolic_exact
     : @eq (list sx) scalar_mul512_limbs scalar_mul512_symbolic_outputs
column_rep_zero
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       column_rep rho beta column_symbolic_zero column_zero
column_ladd_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : sx) (x y : Integers.Int64.int) (_ : @eq Values.val (den rho beta a) (Values.Vlong x))
         (_ : @eq Values.val (den rho beta b) (Values.Vlong y)),
       @eq Values.val (den rho beta (XLb Badd a b)) (Values.Vlong (Integers.Int64.add x y))
column_lcarry_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : sx) (x y : Integers.Int64.int) (_ : @eq Values.val (den rho beta a) (Values.Vlong x))
         (_ : @eq Values.val (den rho beta b) (Values.Vlong y)),
       @eq Values.val (den rho beta (XI2L Ctypes.Signed (XLcmp Integers.Clt Ctypes.Unsigned (XLb Badd a b) b)))
         (Values.Vlong (column_carry64 x y))
column_icarry_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : sx) (x y : Integers.Int64.int) (_ : @eq Values.val (den rho beta a) (Values.Vlong x))
         (_ : @eq Values.val (den rho beta b) (Values.Vlong y)),
       @eq Values.val (den rho beta (XLcmp Integers.Clt Ctypes.Unsigned (XLb Badd a b) b))
         (Values.Vint (column_carry32 x y))
column_lo_add_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : nat) (sy : symbolic_column) (ma : mul_column) (_ : column_rep rho beta sy ma),
       @eq Values.val (den rho beta (column_symbolic_lo_add a b sy))
         (Values.Vlong (column_product_lo (rho a) (rho b) ma))
column_hi_add_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : nat) (sy : symbolic_column) (ma : mul_column) (_ : column_rep rho beta sy ma),
       @eq Values.val (den rho beta (column_symbolic_hi_add a b sy))
         (Values.Vlong (column_product_hi_add (rho a) (rho b) ma))
column_muladd_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : nat) (sy : symbolic_column) (ma : mul_column) (_ : column_rep rho beta sy ma),
       column_rep rho beta (column_symbolic_muladd a b sy) (column_muladd (rho a) (rho b) ma)
column_muladd_fast_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : nat) (sy : symbolic_column) (ma : mul_column) (_ : column_rep rho beta sy ma),
       column_rep rho beta (column_symbolic_muladd_fast a b sy) (column_muladd_fast (rho a) (rho b) ma)
column_extract_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (sy : symbolic_column) (ma : mul_column) (_ : column_rep rho beta sy ma),
       column_rep rho beta (column_symbolic_extract sy) (column_extract ma)
column_extract_fast_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (sy : symbolic_column) (ma : mul_column) (_ : column_rep rho beta sy ma),
       column_rep rho beta (column_symbolic_extract_fast sy) (column_extract_fast ma)
column_rep_lo
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (sy : symbolic_column) (ma : mul_column) (_ : column_rep rho beta sy ma),
       @eq Values.val (den rho beta (sc_lo sy)) (Values.Vlong (col_lo ma))
column_rep_hi
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (sy : symbolic_column) (ma : mul_column) (_ : column_rep rho beta sy ma),
       @eq Values.val (den rho beta (sc_hi sy)) (Values.Vlong (col_hi ma))
scalar_mul512_outputs_machine
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Values.val) (@List.map sx Values.val (den rho beta) scalar_mul512_limbs)
         (@List.map Integers.Int64.int Values.val Values.Vlong (scalar_mul512_machine_outputs rho))
wide_C0_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho beta wide_symbolic_C0) (Values.Vlong wide_C0)
wide_C1_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho beta wide_symbolic_C1) (Values.Vlong wide_C1)
wide_bind_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b x : sx) (A B : Integers.Int64.int) (_ : @eq Values.val (den rho beta a) (Values.Vlong A))
         (_ : @eq Values.val (den rho beta b) (Values.Vlong B)),
       @eq Values.val (den rho beta (wide_bind a b x))
         (den (fun n : nat => match PeanoNat.Nat.eqb n O return Integers.Int64.int with
                              | true => A
                              | false => B
                              end) beta x)
wide_product_lo_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : sx) (A B : Integers.Int64.int) (_ : @eq Values.val (den rho beta a) (Values.Vlong A))
         (_ : @eq Values.val (den rho beta b) (Values.Vlong B)),
       @eq Values.val (den rho beta (wide_symbolic_product_lo a b)) (Values.Vlong (umul128_lo_machine A B))
wide_product_hi_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : sx) (A B : Integers.Int64.int) (_ : @eq Values.val (den rho beta a) (Values.Vlong A))
         (_ : @eq Values.val (den rho beta b) (Values.Vlong B)),
       @eq Values.val (den rho beta (wide_symbolic_product_hi a b)) (Values.Vlong (umul128_hi_machine A B))
wide_carry_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (sg : Ctypes.signedness) (a b : sx) (A B : Integers.Int64.int)
         (_ : @eq Values.val (den rho beta a) (Values.Vlong A)) (_ : @eq Values.val (den rho beta b) (Values.Vlong B)),
       @eq Values.val (den rho beta (wide_symbolic_carry sg a b)) (Values.Vlong (column_carry64 A B))
wide_from_word_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx) (X : Integers.Int64.int) (_ : @eq Values.val (den rho beta x) (Values.Vlong X)),
       wide_rep rho beta (wide_symbolic_from_word x) (wide_from_word X)
wide_lo_add_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : sx) (A B : Integers.Int64.int) (sy : symbolic_column) (ma : wide_column)
         (_ : @eq Values.val (den rho beta a) (Values.Vlong A)) (_ : @eq Values.val (den rho beta b) (Values.Vlong B))
         (_ : wide_rep rho beta sy ma),
       @eq Values.val (den rho beta (wide_symbolic_lo_add a b sy))
         (Values.Vlong (column_product_lo A B (wide_lower ma)))
wide_hi_add_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : sx) (A B : Integers.Int64.int) (sy : symbolic_column) (ma : wide_column)
         (_ : @eq Values.val (den rho beta a) (Values.Vlong A)) (_ : @eq Values.val (den rho beta b) (Values.Vlong B))
         (_ : wide_rep rho beta sy ma),
       @eq Values.val (den rho beta (wide_symbolic_hi_add a b sy))
         (Values.Vlong (column_product_hi_add A B (wide_lower ma)))
wide_muladd_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : sx) (A B : Integers.Int64.int) (sy : symbolic_column) (ma : wide_column)
         (_ : @eq Values.val (den rho beta a) (Values.Vlong A)) (_ : @eq Values.val (den rho beta b) (Values.Vlong B))
         (_ : wide_rep rho beta sy ma), wide_rep rho beta (wide_symbolic_muladd a b sy) (wide_muladd A B ma)
wide_muladd_fast_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (a b : sx) (A B : Integers.Int64.int) (sy : symbolic_column) (ma : wide_column)
         (_ : @eq Values.val (den rho beta a) (Values.Vlong A)) (_ : @eq Values.val (den rho beta b) (Values.Vlong B))
         (_ : wide_rep rho beta sy ma), wide_rep rho beta (wide_symbolic_muladd_fast a b sy) (wide_muladd_fast A B ma)
wide_sumadd_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx) (X : Integers.Int64.int) (sy : symbolic_column) (ma : wide_column)
         (_ : @eq Values.val (den rho beta x) (Values.Vlong X)) (_ : wide_rep rho beta sy ma),
       wide_rep rho beta (wide_symbolic_sumadd x sy) (wide_sumadd X ma)
wide_sumadd_fast_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (x : sx) (X : Integers.Int64.int) (sy : symbolic_column) (ma : wide_column)
         (_ : @eq Values.val (den rho beta x) (Values.Vlong X)) (_ : wide_rep rho beta sy ma),
       wide_rep rho beta (wide_symbolic_sumadd_fast x sy) (wide_sumadd_fast X ma)
wide_extract_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (sy : symbolic_column) (ma : wide_column) (_ : wide_rep rho beta sy ma),
       wide_rep rho beta (wide_symbolic_extract sy) (wide_extract ma)
wide_extract_fast_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (sy : symbolic_column) (ma : wide_column) (_ : wide_rep rho beta sy ma),
       wide_rep rho beta (wide_symbolic_extract_fast sy) (wide_extract_fast ma)
first_symbolic_source
     : @eq (list sx) reduce512_first_limbs first_symbolic_outputs
first_columns_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       and (wide_rep rho beta first_sy0 (first_ma0 rho))
         (and (wide_rep rho beta first_sy1 (first_ma1 rho))
            (and (wide_rep rho beta first_sy2 (first_ma2 rho))
               (and (wide_rep rho beta first_sy3 (first_ma3 rho))
                  (and (wide_rep rho beta first_sy4 (first_ma4 rho)) (wide_rep rho beta first_sy5 (first_ma5 rho))))))
first_outputs_machine
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Values.val) (@List.map sx Values.val (den rho beta) reduce512_first_limbs)
         (@List.map Integers.Int64.int Values.val Values.Vlong (first_machine_outputs rho))
wide_operation_bound
     : forall op : wide_operation,
       and (BinInt.Z.le BinNums.Z0 (wide_operation_value op))
         (BinInt.Z.lt (wide_operation_value op) (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus))
wide_operation_exact
     : forall (op : wide_operation) (s : wide_column)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned (wtop s)) Integers.Int64.max_unsigned),
       @eq BinNums.Z (wide_value (wide_operation_apply op s)) (BinInt.Z.add (wide_value s) (wide_operation_value op))
wide_operation_sum_bound
     : forall ops : list wide_operation,
       and (BinInt.Z.le BinNums.Z0 (wide_operation_sum ops))
         (BinInt.Z.le (wide_operation_sum ops)
            (BinInt.Z.mul (BinInt.Z.of_nat (@length wide_operation ops))
               (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)))
wide_accumulate_value
     : forall (ops : list wide_operation) (s : wide_column)
         (_ : BinInt.Z.lt (BinInt.Z.add (wide_value s) (wide_operation_sum ops))
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))
                   (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus))),
       @eq BinNums.Z (wide_value (wide_accumulate ops s)) (BinInt.Z.add (wide_value s) (wide_operation_sum ops))
wide_accumulate_small
     : forall (ops : list wide_operation) (s : wide_column) (_ : le (@length wide_operation ops) (S (S (S (S O)))))
         (_ : BinInt.Z.lt (wide_value s)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))) Integers.Int64.modulus)),
       and (@eq BinNums.Z (wide_value (wide_accumulate ops s)) (BinInt.Z.add (wide_value s) (wide_operation_sum ops)))
         (and
            (BinInt.Z.lt (wide_value (wide_accumulate ops s))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)))
                  (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus)))
            (BinInt.Z.lt (wide_value (wide_extract (wide_accumulate ops s)))
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))) Integers.Int64.modulus)))
scalar_mul512_low_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho beta scalar_mul512_low)
         (Values.Vlong (Integers.Int64.add Integers.Int64.zero (umul128_lo_machine (rho O) (rho (S (S (S (S O))))))))
scalar_mul512_low_carrier
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho beta scalar_mul512_low)
         (Values.Vlong
            (Integers.Int64.repr
               (BinInt.Z.modulo
                  (BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S (S (S (S O)))))))
                  Integers.Int64.modulus)))
scalar_mul512_input_product_low
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho (S (S (S (S O))))))
            Integers.Int64.modulus)
         (BinInt.Z.modulo
            (BinInt.Z.mul (Integers.Int64.unsigned (rho O)) (Integers.Int64.unsigned (rho (S (S (S (S O)))))))
            Integers.Int64.modulus)
scalar_mul512_low_full_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho beta scalar_mul512_low)
         (Values.Vlong
            (Integers.Int64.repr
               (BinInt.Z.modulo
                  (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho (S (S (S (S O))))))
                  Integers.Int64.modulus)))
scalar_mul512_low_cell
     : @List.In cell (mkcell BinNums.Z0 AST.Mint64 (@Some sx scalar_mul512_low))
         (u64_cells BinNums.Z0 scalar_mul512_limbs)
eval_scalar_mul512_owned_low_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta scalar_mul512_initial_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                     (@cons Values.val (Values.Vptr (blk beta (S (S O))) (Integers.Ptrofs.repr (bas beta (S (S O)))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf (blk beta O) (bas beta O))
                  (@Some Values.val
                     (Values.Vlong
                        (Integers.Int64.repr
                           (BinInt.Z.modulo
                              (BinInt.Z.mul (scalar_mul512_input_value rho O)
                                 (scalar_mul512_input_value rho (S (S (S (S O)))))) Integers.Int64.modulus)))))
               (and (rep rho beta (sregs scalar_mul512_state) mf)
                  (lframe
                     (fun (b : Values.block) (ofs : BinNums.Z) =>
                      not
                        (foot beta
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              scalar_mul512_initial_regs) b ofs)) m mf))))
mul512_schedule
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq (list Integers.Int64.int) (scalar_mul512_machine_outputs rho)
         (@app Integers.Int64.int (mul512_prefix rho)
            (@cons Integers.Int64.int (col_lo (mul512_c6 rho))
               (@cons Integers.Int64.int (col_hi (mul512_c6 rho)) (@nil Integers.Int64.int))))
mul512_column_values
     : forall rho : forall _ : nat, Integers.Int64.int,
       and
         (@eq BinNums.Z (column_value (mul512_c1 rho))
            (BinInt.Z.add (column_value (column_extract_fast (mul512_c0 rho))) (column_products (mul512_ps1 rho))))
         (and
            (@eq BinNums.Z (column_value (mul512_c2 rho))
               (BinInt.Z.add (column_value (column_extract (mul512_c1 rho))) (column_products (mul512_ps2 rho))))
            (and
               (@eq BinNums.Z (column_value (mul512_c3 rho))
                  (BinInt.Z.add (column_value (column_extract (mul512_c2 rho))) (column_products (mul512_ps3 rho))))
               (and
                  (@eq BinNums.Z (column_value (mul512_c4 rho))
                     (BinInt.Z.add (column_value (column_extract (mul512_c3 rho))) (column_products (mul512_ps4 rho))))
                  (@eq BinNums.Z (column_value (mul512_c5 rho))
                     (BinInt.Z.add (column_value (column_extract (mul512_c4 rho))) (column_products (mul512_ps5 rho)))))))
mul512_input_bound
     : forall (rho : forall _ : nat, Integers.Int64.int) (start : nat),
       and (BinInt.Z.le BinNums.Z0 (scalar_mul512_input_value rho start))
         (BinInt.Z.lt (scalar_mul512_input_value rho start)
            (BinInt.Z.pow Integers.Int64.modulus (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))))
mul512_product_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and
         (BinInt.Z.le BinNums.Z0
            (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho (S (S (S (S O)))))))
         (BinInt.Z.lt
            (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho (S (S (S (S O))))))
            (BinInt.Z.pow Integers.Int64.modulus (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
mul512_reconstruction
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho (S (S (S (S O))))))
         (BinInt.Z.add (column_words_value (mul512_prefix rho))
            (BinInt.Z.mul (BinInt.Z.pow Integers.Int64.modulus (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))
               (mul512_residual rho)))
mul512_residual_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (mul512_residual rho))
         (BinInt.Z.lt (mul512_residual rho) (BinInt.Z.mul Integers.Int64.modulus Integers.Int64.modulus))
mul512_final_column
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (column_value (mul512_c6 rho)) (mul512_residual rho)
scalar_mul512_machine_product
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (column_words_value (scalar_mul512_machine_outputs rho))
         (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho (S (S (S (S O))))))
first_carry0_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       BinInt.Z.lt (wide_value (wide_extract_fast (first_ma0 rho))) Integers.Int64.modulus
first_column_values
     : forall rho : forall _ : nat, Integers.Int64.int,
       and
         (@eq BinNums.Z (wide_value (first_ma0 rho))
            (BinInt.Z.add (Integers.Int64.unsigned (rho O))
               (BinInt.Z.mul (Integers.Int64.unsigned (rho (S (S (S (S O)))))) (Integers.Int64.unsigned wide_C0))))
         (and
            (@eq BinNums.Z (wide_value (first_ma1 rho))
               (BinInt.Z.add
                  (BinInt.Z.add (wide_value (wide_extract_fast (first_ma0 rho))) (Integers.Int64.unsigned (rho (S O))))
                  (wide_operation_sum (first_ops1 rho))))
            (and
               (@eq BinNums.Z (wide_value (first_ma2 rho))
                  (BinInt.Z.add (wide_value (wide_extract (first_ma1 rho))) (wide_operation_sum (first_ops2 rho))))
               (and
                  (@eq BinNums.Z (wide_value (first_ma3 rho))
                     (BinInt.Z.add (wide_value (wide_extract (first_ma2 rho))) (wide_operation_sum (first_ops3 rho))))
                  (and
                     (@eq BinNums.Z (wide_value (first_ma4 rho))
                        (BinInt.Z.add (wide_value (wide_extract (first_ma3 rho))) (wide_operation_sum (first_ops4 rho))))
                     (@eq BinNums.Z (wide_value (first_ma5 rho))
                        (BinInt.Z.add (wide_value (wide_extract (first_ma4 rho)))
                           (Integers.Int64.unsigned (rho (S (S (S (S (S (S (S O)))))))))))))))
first_reconstruction
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (column_words_value (first_untruncated_outputs rho))
         (BinInt.Z.add (scalar_mul512_input_value rho O)
            (BinInt.Z.mul (scalar_mul512_input_value rho (S (S (S (S O))))) first_delta))
first_fold_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and
         (BinInt.Z.le BinNums.Z0
            (BinInt.Z.add (scalar_mul512_input_value rho O)
               (BinInt.Z.mul (scalar_mul512_input_value rho (S (S (S (S O))))) first_delta)))
         (BinInt.Z.lt
            (BinInt.Z.add (scalar_mul512_input_value rho O)
               (BinInt.Z.mul (scalar_mul512_input_value rho (S (S (S (S O))))) first_delta))
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH))
               (BinInt.Z.pow Integers.Int64.modulus (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))))
first_m6_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned (whi (first_ma5 rho))))
         (BinInt.Z.le (Integers.Int64.unsigned (whi (first_ma5 rho))) (BinNums.Zpos BinNums.xH))
first_m6_cast_exact
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq Integers.Int64.int
         (Integers.Int64.repr (Integers.Int.unsigned (Integers.Int64.loword (whi (first_ma5 rho)))))
         (whi (first_ma5 rho))
first_machine_value
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (column_words_value (first_machine_outputs rho))
         (BinInt.Z.add (scalar_mul512_input_value rho O)
            (BinInt.Z.mul (scalar_mul512_input_value rho (S (S (S (S O))))) first_delta))
reduce512_first_source_value
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z
         (column_words_value
            (@List.map sx Integers.Int64.int (fun sy : sx => il (den rho beta sy)) reduce512_first_limbs))
         (BinInt.Z.add (scalar_mul512_input_value rho O)
            (BinInt.Z.mul (scalar_mul512_input_value rho (S (S (S (S O))))) first_delta))
reduce512_delta_order
     : @eq BinNums.Z first_delta (BinInt.Z.sub reduce512_radix canonical_group_order)
reduce512_delta_bounds
     : and (and (BinInt.Z.lt BinNums.Z0 first_delta) (BinInt.Z.lt first_delta reduce512_radix))
         (and
            (BinInt.Z.lt (BinInt.Z.mul first_delta first_delta)
               (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) reduce512_radix))
            (and (BinInt.Z.lt (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) first_delta) reduce512_radix)
               (BinInt.Z.lt
                  (BinInt.Z.add reduce512_radix (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) first_delta))
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))))
first_machine_split
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (column_words_value (first_machine_outputs rho))
         (BinInt.Z.add (first_low256 rho) (BinInt.Z.mul reduce512_radix (first_high256 rho)))
first_low256_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (first_low256 rho)) (BinInt.Z.lt (first_low256 rho) reduce512_radix)
first_high256_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (first_high256 rho)) (BinInt.Z.le (first_high256 rho) first_delta)
second_fold_bridge_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (second_fold_bridge_value rho))
         (BinInt.Z.lt (second_fold_bridge_value rho)
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) reduce512_radix))
first_fold_modulo_order
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (BinInt.Z.modulo (column_words_value (first_machine_outputs rho)) canonical_group_order)
         (BinInt.Z.modulo
            (BinInt.Z.add (scalar_mul512_input_value rho O)
               (BinInt.Z.mul (scalar_mul512_input_value rho (S (S (S (S O))))) reduce512_radix)) canonical_group_order)
second_fold_bridge_modulo_order
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (BinInt.Z.modulo (second_fold_bridge_value rho) canonical_group_order)
         (BinInt.Z.modulo (column_words_value (first_machine_outputs rho)) canonical_group_order)
stage_symbolic_source
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int),
       @eq (list sx) (reduce512_typed_stage_limbs digits m6) (stage_symbolic_outputs digits m6)
stage_m6_den
     : forall (m6 : Integers.Int.int) (rho : forall _ : nat, Integers.Int64.int)
         (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho beta (stage_sy_m6 m6)) (Values.Vlong (stage_ma_m6 m6))
stage_columns_rep
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       and (wide_rep rho beta (stage_sy0 digits) (stage_ma0 digits))
         (and (wide_rep rho beta (stage_sy1 digits) (stage_ma1 digits))
            (and (wide_rep rho beta (stage_sy2 digits m6) (stage_ma2 digits m6))
               (wide_rep rho beta (stage_sy3 digits m6) (stage_ma3 digits m6))))
stage_outputs_machine
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq (list Values.val) (@List.map sx Values.val (den rho beta) (reduce512_typed_stage_limbs digits m6))
         (@List.map Integers.Int64.int Values.val Values.Vlong (stage_machine_outputs digits m6))
stage_m6_unsigned
     : forall m6 : Integers.Int.int,
       @eq BinNums.Z (Integers.Int64.unsigned (stage_ma_m6 m6)) (Integers.Int.unsigned m6)
stage_carry0_bound
     : forall digits : forall _ : nat, Integers.Int64.int,
       BinInt.Z.lt (wide_value (wide_extract_fast (stage_ma0 digits))) Integers.Int64.modulus
stage_column_values
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned m6) (BinNums.Zpos BinNums.xH)),
       and
         (@eq BinNums.Z (wide_value (stage_ma0 digits))
            (BinInt.Z.add (Integers.Int64.unsigned (digits O))
               (BinInt.Z.mul (Integers.Int64.unsigned (digits (S (S (S (S O)))))) (Integers.Int64.unsigned wide_C0))))
         (and
            (@eq BinNums.Z (wide_value (stage_ma1 digits))
               (BinInt.Z.add
                  (BinInt.Z.add (wide_value (wide_extract_fast (stage_ma0 digits)))
                     (Integers.Int64.unsigned (digits (S O)))) (wide_operation_sum (stage_ops1 digits))))
            (and
               (@eq BinNums.Z (wide_value (stage_ma2 digits m6))
                  (BinInt.Z.add (wide_value (wide_extract (stage_ma1 digits)))
                     (wide_operation_sum (stage_ops2 digits m6))))
               (@eq BinNums.Z (wide_value (stage_ma3 digits m6))
                  (BinInt.Z.add
                     (BinInt.Z.add
                        (BinInt.Z.add (wide_value (wide_extract (stage_ma2 digits m6)))
                           (Integers.Int64.unsigned (digits (S (S (S O))))))
                        (BinInt.Z.mul (Integers.Int64.unsigned (stage_ma_m6 m6)) (Integers.Int64.unsigned wide_C1)))
                     (Integers.Int64.unsigned (digits (S (S (S (S (S O)))))))))))
stage_reconstruction
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned m6) (BinNums.Zpos BinNums.xH)),
       @eq BinNums.Z
         (BinInt.Z.add (column_words_value (stage_prefix digits m6))
            (BinInt.Z.mul reduce512_radix (stage_p4_integer digits m6)))
         (BinInt.Z.add (stage_low256 digits) (BinInt.Z.mul (stage_high256 digits m6) first_delta))
stage_p4_bound
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned m6) (BinNums.Zpos BinNums.xH))
         (_ : BinInt.Z.le (stage_high256 digits m6) first_delta),
       and (BinInt.Z.le BinNums.Z0 (stage_p4_integer digits m6))
         (BinInt.Z.le (stage_p4_integer digits m6) (BinNums.Zpos (BinNums.xO BinNums.xH)))
stage_p4_unsigned
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned m6) (BinNums.Zpos BinNums.xH))
         (_ : BinInt.Z.le (stage_high256 digits m6) first_delta),
       @eq BinNums.Z
         (Integers.Int64.unsigned
            (Integers.Int64.repr
               (Integers.Int.unsigned
                  (Integers.Int64.loword (Integers.Int64.add (whi (stage_ma3 digits m6)) (stage_ma_m6 m6))))))
         (stage_p4_integer digits m6)
stage_machine_value
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned m6) (BinNums.Zpos BinNums.xH))
         (_ : BinInt.Z.le (stage_high256 digits m6) first_delta),
       @eq BinNums.Z (column_words_value (stage_machine_outputs digits m6))
         (BinInt.Z.add (stage_low256 digits) (BinInt.Z.mul (stage_high256 digits m6) first_delta))
typed_second_source_value
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (_ : BinInt.Z.le (Integers.Int.unsigned m6) (BinNums.Zpos BinNums.xH))
         (_ : BinInt.Z.le (stage_high256 digits m6) first_delta),
       @eq BinNums.Z
         (column_words_value
            (@List.map sx Integers.Int64.int (fun sy : sx => il (den rho beta sy))
               (reduce512_typed_stage_limbs digits m6)))
         (BinInt.Z.add (stage_low256 digits) (BinInt.Z.mul (stage_high256 digits m6) first_delta))
tmatch_checkpoint_set
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (ts : Maps.PTree.t sx)
         (le : Clight.temp_env) (id : BinNums.positive) (x : sx) (_ : tmatch rho beta ts le)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le) (@Some Values.val (den rho (lay beta) x))),
       tmatch rho beta (@Maps.PTree.set sx id x ts) le
first_checkpoint_m6_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned (first_checkpoint_m6 rho)))
         (BinInt.Z.le (Integers.Int.unsigned (first_checkpoint_m6 rho)) (BinNums.Zpos BinNums.xH))
first_checkpoint_values
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (@eq BinNums.Z (stage_low256 (first_checkpoint_digits rho)) (first_low256 rho))
         (@eq BinNums.Z (stage_high256 (first_checkpoint_digits rho) (first_checkpoint_m6 rho)) (first_high256 rho))
first_checkpoint_second_value
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (column_words_value (stage_machine_outputs (first_checkpoint_digits rho) (first_checkpoint_m6 rho)))
         (second_fold_bridge_value rho)
first_checkpoint_p4_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (stage_p4_integer (first_checkpoint_digits rho) (first_checkpoint_m6 rho)))
         (BinInt.Z.le (stage_p4_integer (first_checkpoint_digits rho) (first_checkpoint_m6 rho))
            (BinNums.Zpos (BinNums.xO BinNums.xH)))
first_raw_checkpoint_sources
     : and
         (@eq (option sx) (@Maps.PTree.get sx jets_secp._r (stemps reduce512_first_state)) (@Some sx (XP O BinNums.Z0)))
         (and
            (@eq (option sx) (@Maps.PTree.get sx jets_secp._l (stemps reduce512_first_state))
               (@Some sx (XP (S O) BinNums.Z0)))
            (and
               (@eq (option sx) (@Maps.PTree.get sx jets_secp._m0 (stemps reduce512_first_state))
                  (@Some sx (sc_lo first_sy0)))
               (and
                  (@eq (option sx) (@Maps.PTree.get sx jets_secp._m1 (stemps reduce512_first_state))
                     (@Some sx (sc_lo first_sy1)))
                  (and
                     (@eq (option sx) (@Maps.PTree.get sx jets_secp._m2 (stemps reduce512_first_state))
                        (@Some sx (sc_lo first_sy2)))
                     (and
                        (@eq (option sx) (@Maps.PTree.get sx jets_secp._m3 (stemps reduce512_first_state))
                           (@Some sx (sc_lo first_sy3)))
                        (and
                           (@eq (option sx) (@Maps.PTree.get sx jets_secp._m4 (stemps reduce512_first_state))
                              (@Some sx (sc_lo first_sy4)))
                           (and
                              (@eq (option sx) (@Maps.PTree.get sx jets_secp._m5 (stemps reduce512_first_state))
                                 (@Some sx (sc_lo first_sy5)))
                              (@eq (option sx) (@Maps.PTree.get sx jets_secp._m6 (stemps reduce512_first_state))
                                 (@Some sx (XL2I (sc_hi first_sy5)))))))))))
first_checkpoint_tmatch
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (le : Clight.temp_env)
         (_ : tmatch rho beta (stemps reduce512_first_state) le),
       tmatch rho beta (reduce512_typed_stage_temps (first_checkpoint_digits rho) (first_checkpoint_m6 rho)) le
final_carry_one_no_overflow
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (_ : @eq BinNums.Z (Integers.Int64.unsigned carry) (BinNums.Zpos BinNums.xH))
         (_ : BinInt.Z.lt (final_untruncated digits carry)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order)),
       @eq bool (scalar_overflow_bool digits) false
final_flag_bound
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (_ : BinInt.Z.le (Integers.Int64.unsigned carry) (BinNums.Zpos BinNums.xH))
         (_ : BinInt.Z.lt (final_untruncated digits carry)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order)),
       and (BinInt.Z.le BinNums.Z0 (final_flag_integer digits carry))
         (BinInt.Z.le (final_flag_integer digits carry) (BinNums.Zpos BinNums.xH))
final_flag_bool_value
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (_ : BinInt.Z.le (Integers.Int64.unsigned carry) (BinNums.Zpos BinNums.xH))
         (_ : BinInt.Z.lt (final_untruncated digits carry)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order)),
       @eq BinNums.Z (final_flag_integer digits carry) (b2z (final_flag_bool digits carry))
final_modulo_identity
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (_ : BinInt.Z.le (Integers.Int64.unsigned carry) (BinNums.Zpos BinNums.xH))
         (_ : BinInt.Z.lt (final_untruncated digits carry)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order)),
       @eq BinNums.Z
         (BinInt.Z.modulo
            (BinInt.Z.add (scalar_limb_value digits) (BinInt.Z.mul (final_flag_integer digits carry) first_delta))
            reduce512_radix) (BinInt.Z.modulo (final_untruncated digits carry) canonical_group_order)
final_suffix_numeric
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (_ : BinInt.Z.le (Integers.Int64.unsigned carry) (BinNums.Zpos BinNums.xH))
         (_ : BinInt.Z.lt (final_untruncated digits carry)
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order)),
       @eq BinNums.Z (final_output_value digits carry rho beta)
         (BinInt.Z.modulo (final_untruncated digits carry) canonical_group_order)
third_shift_rep
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (sy : symbolic_column) (ma : wide_column) (_ : wide_rep rho beta sy ma),
       wide_rep rho beta (third_symbolic_shift sy) (wide_from_word (whi ma))
third_symbolic_source
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq (list sx) (reduce512_third_limbs digits p4) (third_symbolic_outputs digits p4)
third_c_source
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq sx (reduce512_third_c digits p4) (sc_hi (third_sy3 digits p4))
third_p4_den
     : forall (p4 : Integers.Int.int) (rho : forall _ : nat, Integers.Int64.int)
         (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq Values.val (den rho beta (third_sy_p4 p4)) (Values.Vlong (third_ma_p4 p4))
third_columns_rep
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       and (wide_rep rho beta (third_sy0 digits p4) (third_ma0 digits p4))
         (and (wide_rep rho beta (third_sy1 digits p4) (third_ma1 digits p4))
            (and (wide_rep rho beta (third_sy2 digits p4) (third_ma2 digits p4))
               (wide_rep rho beta (third_sy3 digits p4) (third_ma3 digits p4))))
third_outputs_machine
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       and
         (@eq (list Values.val) (@List.map sx Values.val (den rho beta) (reduce512_third_limbs digits p4))
            (@List.map Integers.Int64.int Values.val Values.Vlong (third_machine_outputs digits p4)))
         (@eq Values.val (den rho beta (reduce512_third_c digits p4)) (Values.Vlong (whi (third_ma3 digits p4))))
compact_stmt_shift64_normal
     : forall (fuel : nat) (ve : venv) (st : sstate) (stmt : Clight.statement) (st' : sstate)
         (_ : @eq (option res)
                (compact_stmt (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type)))
                   secp_shift64_table fuel ve st stmt) (@Some res (RDone st' ONormal)))
         (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (e : Clight.env) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (_ : rep rho beta (sregs st) m) (_ : tmatch rho beta (stemps st) le)
         (_ : ematch beta ve e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun m' : Memory.Mem.mem =>
             and (ClightBigstep.Clight2.exec_stmt secp_ge e le m stmt Events.E0 le' m' ClightBigstep.Out_normal)
               (and (rep rho beta (sregs st') m')
                  (and (tmatch rho beta (stemps st') le')
                     (and
                        (@eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (sregs st'))
                           (@List.map region
                              (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                              (sregs st)))
                        (lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot beta
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape (sregs st)) b ofs)) m m'))))))
third_output_region
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq (option region) (@List.nth_error region (sregs (reduce512_third_state digits p4)) O)
         (@Some region
            (mkreg (u64_cells BinNums.Z0 (reduce512_third_limbs digits p4)) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
third_raw_c
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq (option sx) (@Maps.PTree.get sx jets_secp._c (stemps (reduce512_third_state digits p4)))
         (@Some sx (sc_hi (third_sy3 digits p4)))
exec_typed_third_stage
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (e : Clight.env) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (_ : rep rho beta (sregs (reduce512_third_initial digits p4)) m)
         (_ : tmatch rho beta (reduce512_third_temps digits p4) le)
         (_ : ematch beta (@snd (list region) venv reduce512_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge e le m reduce512_third_stage Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and (rep rho beta (sregs (reduce512_third_state digits p4)) mf)
                  (and
                     (forall (i : nat) (x : Integers.Int64.int)
                        (_ : @eq (option Integers.Int64.int)
                               (@List.nth_error Integers.Int64.int (third_machine_outputs digits p4) i)
                               (@Some Integers.Int64.int x)),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf (blk beta O)
                           (BinInt.Z.add (bas beta O)
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong x)))
                     (and
                        (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._c le')
                           (@Some Values.val (Values.Vlong (whi (third_ma3 digits p4)))))
                        (and (tmatch rho beta (stemps (reduce512_third_state digits p4)) le')
                           (lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (foot beta
                                    (@List.map region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       rshape (sregs (reduce512_third_initial digits p4))) b ofs)) m mf)))))))
third_carry_bound
     : forall (s : wide_column) (k : BinNums.Z)
         (_ : BinInt.Z.lt (wide_value s) (BinInt.Z.mul k Integers.Int64.modulus)),
       BinInt.Z.lt (Integers.Int64.unsigned (whi s)) k
third_lower_split
     : forall (s : wide_column) (_ : @eq Integers.Int64.int (wtop s) Integers.Int64.zero),
       @eq BinNums.Z (wide_value s)
         (BinInt.Z.add (Integers.Int64.unsigned (wlo s))
            (BinInt.Z.mul Integers.Int64.modulus (Integers.Int64.unsigned (whi s))))
third_p4_unsigned
     : forall p4 : Integers.Int.int,
       @eq BinNums.Z (Integers.Int64.unsigned (third_ma_p4 p4)) (Integers.Int.unsigned p4)
third_column_values
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned p4) (BinNums.Zpos (BinNums.xO BinNums.xH))),
       and
         (@eq BinNums.Z (wide_value (third_ma0 digits p4))
            (BinInt.Z.add (Integers.Int64.unsigned (digits O))
               (BinInt.Z.mul (Integers.Int64.unsigned wide_C0) (Integers.Int.unsigned p4))))
         (and
            (@eq BinNums.Z (wide_value (third_ma1 digits p4))
               (BinInt.Z.add
                  (BinInt.Z.add (Integers.Int64.unsigned (whi (third_ma0 digits p4)))
                     (Integers.Int64.unsigned (digits (S O))))
                  (BinInt.Z.mul (Integers.Int64.unsigned wide_C1) (Integers.Int.unsigned p4))))
            (and
               (@eq BinNums.Z (wide_value (third_ma2 digits p4))
                  (BinInt.Z.add
                     (BinInt.Z.add (Integers.Int64.unsigned (whi (third_ma1 digits p4)))
                        (Integers.Int64.unsigned (digits (S (S O))))) (Integers.Int.unsigned p4)))
               (@eq BinNums.Z (wide_value (third_ma3 digits p4))
                  (BinInt.Z.add (Integers.Int64.unsigned (whi (third_ma2 digits p4)))
                     (Integers.Int64.unsigned (digits (S (S (S O)))))))))
third_reconstruction
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned p4) (BinNums.Zpos (BinNums.xO BinNums.xH))),
       @eq BinNums.Z
         (BinInt.Z.add (column_words_value (third_machine_outputs digits p4))
            (BinInt.Z.mul reduce512_radix (Integers.Int64.unsigned (whi (third_ma3 digits p4)))))
         (third_fold_value digits p4)
third_fold_bound
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned p4) (BinNums.Zpos (BinNums.xO BinNums.xH))),
       and (BinInt.Z.le BinNums.Z0 (third_fold_value digits p4))
         (BinInt.Z.lt (third_fold_value digits p4)
            (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order))
third_c_bound
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned p4) (BinNums.Zpos (BinNums.xO BinNums.xH))),
       and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned (whi (third_ma3 digits p4))))
         (BinInt.Z.le (Integers.Int64.unsigned (whi (third_ma3 digits p4))) (BinNums.Zpos BinNums.xH))
forget_cells_sorted
     : forall (cs : list cell) (lo : BinNums.Z),
       @eq bool (cells_sorted lo (@List.map cell cell forget_cell cs)) (cells_sorted lo cs)
forget_region_shape
     : forall reg : region,
       @eq (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) (rshape (forget_region reg))
         (rshape reg)
forget_after_length
     : forall (regs : list region) (n : nat), @eq nat (@length region (forget_after n regs)) (@length region regs)
forget_after_shape
     : forall (regs : list region) (n : nat),
       @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
            (forget_after n regs))
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape regs)
forget_after_lookup
     : forall (regs : list region) (n i : nat) (reg : region)
         (_ : @eq (option region) (@List.nth_error region (forget_after n regs) i) (@Some region reg)),
       @ex region
         (fun old : region =>
          and (@eq (option region) (@List.nth_error region regs i) (@Some region old))
            (or (@eq region reg old) (@eq region reg (forget_region old))))
forget_region_ok
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (r : nat) (reg : region) (_ : region_ok rho beta m r reg), region_ok rho beta m r (forget_region reg)
forget_regions_shape
     : forall regs : list region,
       @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
            (@List.map region region forget_region regs))
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape regs)
rep_forget_cells
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (regs : list region)
         (m : Memory.Mem.mem) (_ : rep rho beta regs m), rep rho beta (@List.map region region forget_region regs) m
rep_forget_after
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (regs : list region)
         (m : Memory.Mem.mem) (n : nat) (_ : rep rho beta regs m), rep rho beta (forget_after n regs) m
revalue_cells_sorted
     : forall (f : forall _ : sx, sx) (cs : list cell) (lo : BinNums.Z),
       @eq bool (cells_sorted lo (@List.map cell cell (revalue_cell f) cs)) (cells_sorted lo cs)
revalue_region_shape
     : forall (f : forall _ : sx, sx) (reg : region),
       @eq (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
         (rshape (revalue_region f reg)) (rshape reg)
region_ok_revalue
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (r : nat) (f : forall _ : sx, sx) (reg : region) (_ : region_ok rho beta m r reg)
         (_ : forall (c : cell) (x : sx) (_ : @List.In cell c (rcells reg)) (_ : @eq (option sx) (cval c) (@Some sx x)),
              and (@eq Values.val (den rho (lay beta) (f x)) (den rho (lay beta) x)) (@eq bool (xp_le r (f x)) true)),
       region_ok rho beta m r (revalue_region f reg)
rep_change_head
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (old new : region)
         (rest : list region) (m : Memory.Mem.mem)
         (_ : @eq (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                (rshape new) (rshape old)) (_ : region_ok rho beta m O new)
         (_ : rep rho beta (@cons region old rest) m), rep rho beta (@cons region new rest) m
revalue_u64_den
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (r : nat) (x : sx)
         (_ : @eq bool (isk KL x) true),
       and (@eq Values.val (den rho (lay beta) (revalue_u64 rho beta x)) (den rho (lay beta) x))
         (@eq bool (xp_le r (revalue_u64 rho beta x)) true)
revalue_u64_cells
     : forall (f : forall _ : sx, sx) (xs : list sx) (ofs : BinNums.Z),
       @eq (list cell) (@List.map cell cell (revalue_cell f) (u64_cells ofs xs)) (u64_cells ofs (@List.map sx sx f xs))
region_ok_revalue_u64
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (r : nat) (xs : list sx) (w : bool) (owned : option BinNums.Z)
         (_ : region_ok rho beta m r (mkreg (u64_cells BinNums.Z0 xs) w owned))
         (_ : @eq bool (@List.forallb sx (isk KL) xs) true),
       region_ok rho beta m r (mkreg (u64_cells BinNums.Z0 (@List.map sx sx (revalue_u64 rho beta) xs)) w owned)
revalue_u64_machine_map
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (xs : list sx) (ys : list Integers.Int64.int)
         (_ : @eq (list Values.val) (@List.map sx Values.val (den rho (lay beta)) xs)
                (@List.map Integers.Int64.int Values.val Values.Vlong ys)),
       @eq (list sx) (@List.map sx sx (revalue_u64 rho beta) xs) (@List.map Integers.Int64.int sx XL ys)
third_checkpoint_limb_value
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq BinNums.Z (scalar_limb_value (third_checkpoint_digits digits p4))
         (column_words_value (third_machine_outputs digits p4))
third_checkpoint_value
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (_ : BinInt.Z.le (Integers.Int.unsigned p4) (BinNums.Zpos (BinNums.xO BinNums.xH))),
       @eq BinNums.Z (final_untruncated (third_checkpoint_digits digits p4) (third_checkpoint_c digits p4))
         (third_fold_value digits p4)
third_checkpoint_final_numeric
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z)
         (_ : BinInt.Z.le (Integers.Int.unsigned p4) (BinNums.Zpos (BinNums.xO BinNums.xH))),
       @eq BinNums.Z (final_output_value (third_checkpoint_digits digits p4) (third_checkpoint_c digits p4) rho beta)
         (BinInt.Z.modulo (third_fold_value digits p4) canonical_group_order)
third_checkpoint_forget_stack
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq (list region) (forget_after (S (S O)) (sregs (reduce512_third_state digits p4)))
         (@cons region
            (mkreg (u64_cells BinNums.Z0 (reduce512_third_limbs digits p4)) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@app region (@List.tl region scalar_reduce512_initial_regs) (@fst (list region) venv reduce512_allocated)))
third_checkpoint_param_sources
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       and
         (@eq (option sx) (@Maps.PTree.get sx jets_secp._r (stemps (reduce512_third_state digits p4)))
            (@Some sx (XP O BinNums.Z0)))
         (@eq (option sx) (@Maps.PTree.get sx jets_secp._l (stemps (reduce512_third_state digits p4)))
            (@Some sx (XP (S O) BinNums.Z0)))
third_checkpoint_rep
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta (sregs (reduce512_third_state digits p4)) m),
       rep rho beta (reduce512_final_regs (third_checkpoint_digits digits p4)) m
third_checkpoint_tmatch
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (le : Clight.temp_env)
         (_ : tmatch rho beta (stemps (reduce512_third_state digits p4)) le),
       tmatch rho beta (reduce512_final_temps (third_checkpoint_c digits p4)) le
final_output_region
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int),
       @eq (option region) (@List.nth_error region (sregs (reduce512_final_state digits carry)) O)
         (@Some region
            (mkreg (u64_cells BinNums.Z0 (reduce512_final_limbs digits carry)) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
exec_typed_final_suffix
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (e : Clight.env) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (_ : rep rho beta (sregs (reduce512_final_initial digits carry)) m)
         (_ : tmatch rho beta (reduce512_final_temps carry) le)
         (_ : ematch beta (@snd (list region) venv reduce512_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge e le m reduce512_final_suffix Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and (rep rho beta (sregs (reduce512_final_state digits carry)) mf)
                  (and
                     (forall (i : nat) (sy : sx)
                        (_ : @eq (option sx) (@List.nth_error sx (reduce512_final_limbs digits carry) i) (@Some sx sy)),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf (blk beta O)
                           (BinInt.Z.add (bas beta O)
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.of_nat i)))) (@Some Values.val (den rho (lay beta) sy)))
                     (and (tmatch rho beta (stemps (reduce512_final_state digits carry)) le')
                        (lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (foot beta
                                 (@List.map region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    rshape (sregs (reduce512_final_initial digits carry))) b ofs)) m mf))))))
typed_stage_raw_temps
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int),
       and
         (@eq (option sx) (@Maps.PTree.get sx jets_secp._p0 (stemps (reduce512_typed_stage_state digits m6)))
            (@Some sx (sc_lo (stage_sy0 digits))))
         (and
            (@eq (option sx) (@Maps.PTree.get sx jets_secp._p1 (stemps (reduce512_typed_stage_state digits m6)))
               (@Some sx (sc_lo (stage_sy1 digits))))
            (and
               (@eq (option sx) (@Maps.PTree.get sx jets_secp._p2 (stemps (reduce512_typed_stage_state digits m6)))
                  (@Some sx (sc_lo (stage_sy2 digits m6))))
               (and
                  (@eq (option sx) (@Maps.PTree.get sx jets_secp._p3 (stemps (reduce512_typed_stage_state digits m6)))
                     (@Some sx (sc_lo (stage_sy3 digits m6))))
                  (@eq (option sx) (@Maps.PTree.get sx jets_secp._p4 (stemps (reduce512_typed_stage_state digits m6)))
                     (@Some sx (XL2I (XLb Badd (sc_hi (stage_sy3 digits m6)) (stage_sy_m6 m6))))))))
exec_typed_second_stage
     : forall (digits : forall _ : nat, Integers.Int64.int) (m6 : Integers.Int.int)
         (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (e : Clight.env) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (_ : rep rho beta (sregs (reduce512_typed_stage_initial digits m6)) m)
         (_ : tmatch rho beta (reduce512_typed_stage_temps digits m6) le)
         (_ : ematch beta (@snd (list region) venv reduce512_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge e le m reduce512_typed_stage Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and (rep rho beta (sregs (reduce512_typed_stage_state digits m6)) mf)
                  (and
                     (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p0 le')
                        (@Some Values.val (Values.Vlong (wlo (stage_ma0 digits)))))
                     (and
                        (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p1 le')
                           (@Some Values.val (Values.Vlong (wlo (stage_ma1 digits)))))
                        (and
                           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p2 le')
                              (@Some Values.val (Values.Vlong (wlo (stage_ma2 digits m6)))))
                           (and
                              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p3 le')
                                 (@Some Values.val (Values.Vlong (wlo (stage_ma3 digits m6)))))
                              (and
                                 (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p4 le')
                                    (@Some Values.val
                                       (Values.Vint
                                          (Integers.Int64.loword
                                             (Integers.Int64.add (whi (stage_ma3 digits m6)) (stage_ma_m6 m6))))))
                                 (and (tmatch rho beta (stemps (reduce512_typed_stage_state digits m6)) le')
                                    (lframe
                                       (fun (b : Values.block) (ofs : BinNums.Z) =>
                                        not
                                          (foot beta
                                             (@List.map region
                                                (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool)
                                                   (option BinNums.Z)) rshape
                                                (sregs (reduce512_typed_stage_initial digits m6))) b ofs)) m mf))))))))))
second_checkpoint_p4_value
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z (Integers.Int.unsigned (second_checkpoint_p4 rho))
         (stage_p4_integer (first_checkpoint_digits rho) (first_checkpoint_m6 rho))
second_checkpoint_p4_bound
     : forall rho : forall _ : nat, Integers.Int64.int,
       and (BinInt.Z.le BinNums.Z0 (Integers.Int.unsigned (second_checkpoint_p4 rho)))
         (BinInt.Z.le (Integers.Int.unsigned (second_checkpoint_p4 rho)) (BinNums.Zpos (BinNums.xO BinNums.xH)))
second_checkpoint_split
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.add (third_input_low (second_checkpoint_digits rho))
            (BinInt.Z.mul reduce512_radix (Integers.Int.unsigned (second_checkpoint_p4 rho))))
         (second_fold_bridge_value rho)
second_checkpoint_third_modulo
     : forall rho : forall _ : nat, Integers.Int64.int,
       @eq BinNums.Z
         (BinInt.Z.modulo (third_fold_value (second_checkpoint_digits rho) (second_checkpoint_p4 rho))
            canonical_group_order) (BinInt.Z.modulo (second_fold_bridge_value rho) canonical_group_order)
second_checkpoint_forget_stack
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       @eq (list region) (forget_after (S (S O)) (sregs (reduce512_typed_stage_state digits p4)))
         (@app region scalar_reduce512_initial_regs (@fst (list region) venv reduce512_allocated))
second_checkpoint_param_sources
     : forall (digits : forall _ : nat, Integers.Int64.int) (p4 : Integers.Int.int),
       and
         (@eq (option sx) (@Maps.PTree.get sx jets_secp._r (stemps (reduce512_typed_stage_state digits p4)))
            (@Some sx (XP O BinNums.Z0)))
         (@eq (option sx) (@Maps.PTree.get sx jets_secp._l (stemps (reduce512_typed_stage_state digits p4)))
            (@Some sx (XP (S O) BinNums.Z0)))
second_checkpoint_tmatch
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (le : Clight.temp_env)
         (_ : tmatch rho beta
                (stemps (reduce512_typed_stage_state (first_checkpoint_digits rho) (first_checkpoint_m6 rho))) le),
       tmatch rho beta (reduce512_third_temps (second_checkpoint_digits rho) (second_checkpoint_p4 rho)) le
@extract_stage_entry ?A ?B ?C ?R
     : forall (alloc : option (prod ?A ?B)) (binding : option ?C) (run : forall (_ : ?A) (_ : ?B) (_ : ?C), option ?R)
         (pair : prod ?A ?B) (args : ?C) (result : ?R) (_ : @eq (option (prod ?A ?B)) alloc (@Some (prod ?A ?B) pair))
         (_ : @eq (option ?C) binding (@Some ?C args))
         (_ : @eq (option ?R)
                match alloc return (option ?R) with
                | Some p =>
                    match p return (option ?R) with
                    | pair locals ve =>
                        match binding return (option ?R) with
                        | Some ts => run locals ve ts
                        | None => @None ?R
                        end
                    end
                | None => @None ?R
                end (@Some ?R result)),
       @eq (option ?R) (run (@fst ?A ?B pair) (@snd ?A ?B pair) args) (@Some ?R result)
where
?A : [ |- Type]
?B : [ |- Type]
?C : [ |- Type]
?R : [ |- Type]
reduce512_allocated_exact
     : @eq (option (prod (list region) venv))
         (xalloc (std_cells (Clight.genv_cenv secp_ge)) (Clight.genv_cenv secp_ge)
            (Clight.fn_vars jets_secp.f_secp256k1_scalar_reduce_512) (S (S O)))
         (@Some (prod (list region) venv) reduce512_allocated)
reduce512_bound_exact
     : @eq (option (Maps.PTree.t sx))
         (xbind (Clight.fn_params jets_secp.f_secp256k1_scalar_reduce_512)
            (@cons sx (XP O BinNums.Z0) (@cons sx (XP (S O) BinNums.Z0) (@nil sx))) (Maps.PTree.empty sx))
         (@Some (Maps.PTree.tree sx) reduce512_initial_temps)
reduce512_first_compact_run
     : @eq (option res)
         (compact_stmt (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type))) secp_shift64_table
            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
            (@snd (list region) venv reduce512_allocated) reduce512_first_initial reduce512_first_prefix)
         (@Some res (RDone reduce512_first_state ONormal))
reduce512_first_forget_stack
     : @eq (list region) (forget_after (S (S O)) (sregs reduce512_first_state))
         (@app region scalar_reduce512_initial_regs (@fst (list region) venv reduce512_allocated))
exec_reduce512_first_two_stages
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (e : Clight.env) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (_ : rep rho beta (sregs reduce512_first_initial) m)
         (_ : tmatch rho beta reduce512_initial_temps le)
         (_ : ematch beta (@snd (list region) venv reduce512_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge e le m reduce512_second_prefix Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and
                  (rep rho beta
                     (sregs (reduce512_typed_stage_state (first_checkpoint_digits rho) (first_checkpoint_m6 rho))) mf)
                  (and
                     (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p0 le')
                        (@Some Values.val (Values.Vlong (wlo (stage_ma0 (first_checkpoint_digits rho))))))
                     (and
                        (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p1 le')
                           (@Some Values.val (Values.Vlong (wlo (stage_ma1 (first_checkpoint_digits rho))))))
                        (and
                           (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p2 le')
                              (@Some Values.val
                                 (Values.Vlong
                                    (wlo (stage_ma2 (first_checkpoint_digits rho) (first_checkpoint_m6 rho))))))
                           (and
                              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p3 le')
                                 (@Some Values.val
                                    (Values.Vlong
                                       (wlo (stage_ma3 (first_checkpoint_digits rho) (first_checkpoint_m6 rho))))))
                              (and
                                 (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._p4 le')
                                    (@Some Values.val
                                       (Values.Vint
                                          (Integers.Int64.loword
                                             (Integers.Int64.add
                                                (whi
                                                   (stage_ma3 (first_checkpoint_digits rho) (first_checkpoint_m6 rho)))
                                                (stage_ma_m6 (first_checkpoint_m6 rho)))))))
                                 (and
                                    (@eq BinNums.Z
                                       (column_words_value
                                          (stage_machine_outputs (first_checkpoint_digits rho)
                                             (first_checkpoint_m6 rho))) (second_fold_bridge_value rho))
                                    (and
                                       (and
                                          (BinInt.Z.le BinNums.Z0
                                             (stage_p4_integer (first_checkpoint_digits rho) (first_checkpoint_m6 rho)))
                                          (BinInt.Z.le
                                             (stage_p4_integer (first_checkpoint_digits rho) (first_checkpoint_m6 rho))
                                             (BinNums.Zpos (BinNums.xO BinNums.xH))))
                                       (and
                                          (tmatch rho beta
                                             (stemps
                                                (reduce512_typed_stage_state (first_checkpoint_digits rho)
                                                   (first_checkpoint_m6 rho))) le')
                                          (lframe
                                             (fun (b : Values.block) (ofs : BinNums.Z) =>
                                              not
                                                (foot beta
                                                   (@List.map region
                                                      (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool)
                                                         (option BinNums.Z)) rshape (sregs reduce512_first_initial)) b
                                                   ofs)) m mf))))))))))))
exec_reduce512_first_three_stages
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (e : Clight.env) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (_ : rep rho beta (sregs reduce512_first_initial) m)
         (_ : tmatch rho beta reduce512_initial_temps le)
         (_ : ematch beta (@snd (list region) venv reduce512_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge e le m reduce512_third_prefix Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and
                  (rep rho beta
                     (sregs (reduce512_third_state (second_checkpoint_digits rho) (second_checkpoint_p4 rho))) mf)
                  (and
                     (forall (i : nat) (x : Integers.Int64.int)
                        (_ : @eq (option Integers.Int64.int)
                               (@List.nth_error Integers.Int64.int
                                  (third_machine_outputs (second_checkpoint_digits rho) (second_checkpoint_p4 rho)) i)
                               (@Some Integers.Int64.int x)),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf (blk beta O)
                           (BinInt.Z.add (bas beta O)
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong x)))
                     (and
                        (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._c le')
                           (@Some Values.val
                              (Values.Vlong (whi (third_ma3 (second_checkpoint_digits rho) (second_checkpoint_p4 rho))))))
                        (and
                           (@eq BinNums.Z
                              (BinInt.Z.add
                                 (column_words_value
                                    (third_machine_outputs (second_checkpoint_digits rho) (second_checkpoint_p4 rho)))
                                 (BinInt.Z.mul reduce512_radix
                                    (Integers.Int64.unsigned
                                       (whi (third_ma3 (second_checkpoint_digits rho) (second_checkpoint_p4 rho))))))
                              (third_fold_value (second_checkpoint_digits rho) (second_checkpoint_p4 rho)))
                           (and
                              (and
                                 (BinInt.Z.le BinNums.Z0
                                    (third_fold_value (second_checkpoint_digits rho) (second_checkpoint_p4 rho)))
                                 (BinInt.Z.lt
                                    (third_fold_value (second_checkpoint_digits rho) (second_checkpoint_p4 rho))
                                    (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) canonical_group_order)))
                              (and
                                 (and
                                    (BinInt.Z.le BinNums.Z0
                                       (Integers.Int64.unsigned
                                          (whi (third_ma3 (second_checkpoint_digits rho) (second_checkpoint_p4 rho)))))
                                    (BinInt.Z.le
                                       (Integers.Int64.unsigned
                                          (whi (third_ma3 (second_checkpoint_digits rho) (second_checkpoint_p4 rho))))
                                       (BinNums.Zpos BinNums.xH)))
                                 (and
                                    (@eq BinNums.Z
                                       (BinInt.Z.modulo
                                          (third_fold_value (second_checkpoint_digits rho) (second_checkpoint_p4 rho))
                                          canonical_group_order)
                                       (BinInt.Z.modulo (second_fold_bridge_value rho) canonical_group_order))
                                    (and
                                       (tmatch rho beta
                                          (stemps
                                             (reduce512_third_state (second_checkpoint_digits rho)
                                                (second_checkpoint_p4 rho))) le')
                                       (lframe
                                          (fun (b : Values.block) (ofs : BinNums.Z) =>
                                           not
                                             (foot beta
                                                (@List.map region
                                                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool)
                                                      (option BinNums.Z)) rshape (sregs reduce512_first_initial)) b ofs))
                                          m mf)))))))))))
reduce512_body_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : forall _ : nat, prod Values.block BinNums.Z),
       @eq BinNums.Z (final_output_value (reduce512_body_digits rho) (reduce512_body_carry rho) rho beta)
         (BinInt.Z.modulo (reduce512_input_integer rho) canonical_group_order)
final_shape_same_entry
     : forall digits : forall _ : nat, Integers.Int64.int,
       @eq (list (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)))
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
            (reduce512_final_regs digits))
         (@List.map region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
            (sregs reduce512_first_initial))
final_state_output_exact
     : forall (digits : forall _ : nat, Integers.Int64.int) (carry : Integers.Int64.int),
       @eq (list region) (sregs (reduce512_final_state digits carry))
         (@cons region
            (mkreg (u64_cells BinNums.Z0 (reduce512_final_limbs digits carry)) true
               (@Some BinNums.Z
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
            (@app region (@List.tl region scalar_reduce512_initial_regs) (@fst (list region) venv reduce512_allocated)))
exec_reduce512_body_numeric
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (e : Clight.env) (le : Clight.temp_env)
         (m : Memory.Mem.mem) (_ : rep rho beta (sregs reduce512_first_initial) m)
         (_ : tmatch rho beta reduce512_initial_temps le)
         (_ : ematch beta (@snd (list region) venv reduce512_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt secp_ge e le m (Clight.fn_body jets_secp.f_secp256k1_scalar_reduce_512)
                  Events.E0 le' mf ClightBigstep.Out_normal)
               (and
                  (rep rho beta (sregs (reduce512_final_state (reduce512_body_digits rho) (reduce512_body_carry rho)))
                     mf)
                  (and
                     (forall (i : nat) (sy : sx)
                        (_ : @eq (option sx)
                               (@List.nth_error sx
                                  (reduce512_final_limbs (reduce512_body_digits rho) (reduce512_body_carry rho)) i)
                               (@Some sx sy)),
                      @eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf (blk beta O)
                           (BinInt.Z.add (bas beta O)
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.of_nat i)))) (@Some Values.val (den rho (lay beta) sy)))
                     (and
                        (@eq BinNums.Z
                           (final_output_value (reduce512_body_digits rho) (reduce512_body_carry rho) rho (lay beta))
                           (BinInt.Z.modulo (reduce512_input_integer rho) canonical_group_order))
                        (and
                           (tmatch rho beta
                              (stemps (reduce512_final_state (reduce512_body_digits rho) (reduce512_body_carry rho)))
                              le')
                           (lframe
                              (fun (b : Values.block) (ofs : BinNums.Z) =>
                               not
                                 (foot beta
                                    (@List.map region
                                       (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                       rshape (sregs reduce512_first_initial)) b ofs)) m mf)))))))
reduce512_function_ok
     : @eq bool (fn_okb jets_secp.f_secp256k1_scalar_reduce_512) true
reduce512_numeric_body_shape
