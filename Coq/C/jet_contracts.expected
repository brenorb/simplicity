Arguments point_read_tree k bi edge
point_read_result =
fun (k : point_coordinate) (bi : Values.block) (edge : Integers.Ptrofs.int) =>
match point_read_tree k bi edge return res with
| Some rr => rr
| None => RDone (mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O) ONormal
end
     : forall (_ : point_coordinate) (_ : Values.block) (_ : Integers.Ptrofs.int), res

Arguments point_read_result k bi edge
point_read_storage_shape =
fun state : sstate =>
and (@eq nat (@length region (sregs state)) (S (S O)))
  (and
     (@eq (option BinNums.Z) (rfree (@List.nth region O (sregs state) (mkreg (@nil cell) true (@None BinNums.Z))))
        (@Some BinNums.Z
           (BinNums.Zpos
              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
     (@eq (option BinNums.Z) (rfree (@List.nth region (S O) (sregs state) (mkreg (@nil cell) true (@None BinNums.Z))))
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
     : forall _ : sstate, Prop

Arguments point_read_storage_shape state
point_shift_cell =
fun (delta : BinNums.Z) (c : cell) => mkcell (BinInt.Z.add delta (cofs c)) (cchunk c) (cval c)
     : forall (_ : BinNums.Z) (_ : cell), cell

Arguments point_shift_cell delta%Z_scope c
point_canonical_limbs =
fun value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
  (fe_limbs_of
     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
        (@canonical_fe_normalize Alg.CoreFunSem value)))
     : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))), list Integers.Int64.int

Arguments point_canonical_limbs value
point_zero_run =
fun k : point_coordinate =>
xfun (Clight.genv_cenv secp_ge) (@nil (prod AST.ident (prod nat Ctypes.type))) (int_table secp_pure)
  (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S ...))))))))))))))))))))))
  jets_secp.f_secp256k1_fe_is_zero (@cons sx (XP O (point_coordinate_offset k)) (@nil sx))
  (point_write_initial_regs k) (@nil event) (S (S (S (S (S (S O))))))
     : forall _ : point_coordinate, option res

