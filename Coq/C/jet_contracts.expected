ctx8_addn_spec =
fix ctx8_addn_spec (n : nat) (term : Alg.Assertion.Algebra) {struct n} :
    Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n)) sha256_ctx8_type :=
  match
    n as n0
    return
      (Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0)) sha256_ctx8_type)
  with
  | O => @ctx8_add1_spec term
  | S n0 =>
      @jet_sha256_count_assertion.AC.comp
        (Ty.Prod sha256_ctx8_type
           (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)))
        (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0)) sha256_ctx8_type
        (Alg.Assertion.toCore term)
        (@jet_sha256_count_assertion.AC.pair
           (Ty.Prod sha256_ctx8_type
              (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)))
           sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0) (Alg.Assertion.toCore term)
           (@jet_sha256_count_assertion.AC.comp
              (Ty.Prod sha256_ctx8_type
                 (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)))
              (Ty.Prod sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0)) sha256_ctx8_type
              (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.pair
                 (Ty.Prod sha256_ctx8_type
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)))
                 sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) n0) (Alg.Assertion.toCore term)
                 (@jet_sha256_count_assertion.AC.take sha256_ctx8_type
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0))
                    sha256_ctx8_type (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.iden sha256_ctx8_type (Alg.Assertion.toCore term)))
                 (@jet_sha256_count_assertion.AC.drop sha256_ctx8_type
                    (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0))
                    (Word.Vector (Word.Word (S (S (S O)))) n0) (Alg.Assertion.toCore term)
                    (@jet_sha256_count_assertion.AC.take (Word.Vector (Word.Word (S (S (S O)))) n0)
                       (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)
                       (Alg.Assertion.toCore term)
                       (@jet_sha256_count_assertion.AC.iden (Word.Vector (Word.Word (S (S (S O)))) n0)
                          (Alg.Assertion.toCore term))))) (ctx8_addn_spec n0 term))
           (@jet_sha256_count_assertion.AC.drop sha256_ctx8_type
              (Ty.Prod (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0))
              (Word.Vector (Word.Word (S (S (S O)))) n0) (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.drop (Word.Vector (Word.Word (S (S (S O)))) n0)
                 (Word.Vector (Word.Word (S (S (S O)))) n0) (Word.Vector (Word.Word (S (S (S O)))) n0)
                 (Alg.Assertion.toCore term)
                 (@jet_sha256_count_assertion.AC.iden (Word.Vector (Word.Word (S (S (S O)))) n0)
