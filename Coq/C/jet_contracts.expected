           (Build_LocalState (@encode (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) a)
              (newWriteFrame (bitSize (Word.Word (S (S (S O))))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Ty.Prod (Word.Word (S (S O))) (Word.Word (S (S (S O))))) a)
              (fullWriteFrame (@encode (Word.Word (S (S (S O)))) (@shift8_plain_spec right Alg.CoreFunSem a)))) in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
