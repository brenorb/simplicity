output_values_sem
     : forall (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (e : BitcoinFull.env),
       @eq (option (Ty.tySem (Ty.Sum Ty.Unit (Word.Vector (Word.Word (S (S (S O)))) (S (S (S O)))))))
