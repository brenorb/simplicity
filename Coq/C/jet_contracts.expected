?E : [ |- Type]
final_tail_value
     : forall v : Ty.tySem (Word.Word (S (S (S (S (S O)))))),
       @eq (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit)) (@final_tail Alg.CoreFunSem v)
         match
           predicate_numeric (S (S (S (S (S O))))) true (wz (S (S (S (S (S O))))) v)
           return (Ty.tySem (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) Ty.Unit))
         with
         | true => @inr (sum unit unit) unit tt
         | false => @inl (sum unit unit) unit (@inl unit unit tt)
