                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) y),
       @ex Memory.Mem.mem'
         (fun ma : Memory.Mem.mem' =>
          @ex Memory.Mem.mem'
            (fun mb : Memory.Mem.mem' =>
             @ex Memory.Mem.mem'
               (fun mc : Memory.Mem.mem' =>
                @ex Memory.Mem.mem'
                  (fun md : Memory.Mem.mem' =>
                   @ex Memory.Mem.mem
                     (fun mcopy : Memory.Mem.mem =>
                      @ex Memory.Mem.mem
                        (fun mr1 : Memory.Mem.mem =>
                         @ex Memory.Mem.mem
                           (fun mr2 : Memory.Mem.mem =>
                            @ex Memory.Mem.mem
                              (fun mr3 : Memory.Mem.mem =>
                               @ex Memory.Mem.mem
                                 (fun mr4 : Memory.Mem.mem =>
                                  @ex Values.block
                                    (fun bl : Values.block =>
                                     @ex Values.block
                                       (fun bqh : Values.block =>
                                        @ex Values.block
                                          (fun bql : Values.block =>
                                           @ex Values.block
                                             (fun br : Values.block =>
                                              @ex (list Memdata.memval)
                                                (fun bytes : list Memdata.memval =>
                                                 @ex Integers.Int64.int (fun ... => @ex Integers.Int64.int ...)))))))))))))))
eval_divmod128_layout_matches_spec
     : forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge : BinNums.Z)
         (xh : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (xm xl : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (y : Ty.tySem (Word.Word (S (S (S (S (S (S O)))))))) (cursor rc : BinNums.Z) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge rc)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge rc xh)
         (_ : @frame_input_word_at (S (S (S (S (S O))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))) xm)
         (_ : @frame_input_word_at (S (S (S (S (S O))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))) xl)
         (_ : @frame_input_word_at (S (S (S (S (S (S O)))))) m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) y)
         (_ : write_frame_at m bd dbase bw outedge cursor
                (BinNums.Zpos
                   (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_simplicity_div_mod_128_64)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (frame_output_cells_at mf bw outedge cursor
                  (@encode (Word.Word (S (S (S (S (S (S (S O))))))))
                     (@div2n1n_word_spec (S (S (S (S (S (S O)))))) Alg.CoreFunSem
                        (@pair
                           (prod (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S O)))))))))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S O))))))))
                              (prod (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) xh
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S O))))))) xm xl)) y))))
               (and (write_prefix_at m mf bw outedge cursor)
                  (and
                     (frame_fields_at mf bd dbase bw outedge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                     (forall (chunk : AST.memory_chunk) (bb : Values.block) (ofs : BinNums.Z)
                        (_ : Memory.Mem.valid_block m bb)
                        (_ : or (not (@eq Values.block bb bd))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block bb bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinNums.Zpos
                                                    (BinNums.xO
                                                       (BinNums.xO
                                                          (BinNums.xO
                                                             (BinNums.xO
                                                                (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf bb ofs) (Memory.Mem.load chunk m bb ofs))))))
divmod128_local_spec
     : jet_local_spec f_simplicity_div_mod_128_64
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Word.Word (S (S (S (S (S (S (S O))))))))
         (fun xy : Ty.tySem (Ty.Prod (Word.Word (S (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))))
          => @div2n1n_word_spec (S (S (S (S (S (S O)))))) Alg.CoreFunSem xy)
divmod128_context
     : @jet_context_for f_simplicity_div_mod_128_64
         (Ty.Prod (Word.Word (S (S (S (S (S (S (S O)))))))) (Word.Word (S (S (S (S (S (S O))))))))
         (Word.Word (S (S (S (S (S (S (S O)))))))) (@div2n1n_word_spec (S (S (S (S (S (S O)))))))
umul128_limb_algorithm
     : forall (B a b : BinNums.Z) (_ : BinInt.Z.lt (BinNums.Zpos BinNums.xH) B)
         (_ : and (BinInt.Z.le BinNums.Z0 a) (BinInt.Z.lt a (BinInt.Z.mul B B)))
         (_ : and (BinInt.Z.le BinNums.Z0 b) (BinInt.Z.lt b (BinInt.Z.mul B B))),
       let ll : BinNums.Z := BinInt.Z.mul (BinInt.Z.modulo a B) (BinInt.Z.modulo b B) in
       let lh : BinNums.Z := BinInt.Z.mul (BinInt.Z.modulo a B) (BinInt.Z.div b B) in
       let hl : BinNums.Z := BinInt.Z.mul (BinInt.Z.div a B) (BinInt.Z.modulo b B) in
       let hh : BinNums.Z := BinInt.Z.mul (BinInt.Z.div a B) (BinInt.Z.div b B) in
       let mid : BinNums.Z :=
         BinInt.Z.add (BinInt.Z.add (BinInt.Z.div ll B) (BinInt.Z.modulo lh B)) (BinInt.Z.modulo hl B) in
       let hi : BinNums.Z :=
         BinInt.Z.add (BinInt.Z.add (BinInt.Z.add hh (BinInt.Z.div lh B)) (BinInt.Z.div hl B)) (BinInt.Z.div mid B) in
       let lo : BinNums.Z := BinInt.Z.add (BinInt.Z.mul (BinInt.Z.modulo mid B) B) (BinInt.Z.modulo ll B) in
       and (and (BinInt.Z.le BinNums.Z0 ll) (BinInt.Z.lt ll (BinInt.Z.mul B B)))
         (and (and (BinInt.Z.le BinNums.Z0 lh) (BinInt.Z.lt lh (BinInt.Z.mul B B)))
            (and (and (BinInt.Z.le BinNums.Z0 hl) (BinInt.Z.lt hl (BinInt.Z.mul B B)))
               (and (and (BinInt.Z.le BinNums.Z0 hh) (BinInt.Z.lt hh (BinInt.Z.mul B B)))
                  (and
                     (and (BinInt.Z.le BinNums.Z0 mid)
                        (BinInt.Z.lt mid (BinInt.Z.mul (BinNums.Zpos (BinNums.xI BinNums.xH)) B)))
                     (and (and (BinInt.Z.le BinNums.Z0 hi) (BinInt.Z.lt hi (BinInt.Z.mul B B)))
                        (and (and (BinInt.Z.le BinNums.Z0 lo) (BinInt.Z.lt lo (BinInt.Z.mul B B)))
                           (and
                              (@eq BinNums.Z (BinInt.Z.mul a b) (BinInt.Z.add (BinInt.Z.mul hi (BinInt.Z.mul B B)) lo))
                              (and (@eq BinNums.Z hi (BinInt.Z.div (BinInt.Z.mul a b) (BinInt.Z.mul B B)))
                                 (@eq BinNums.Z lo (BinInt.Z.modulo (BinInt.Z.mul a b) (BinInt.Z.mul B B)))))))))))
umul128_low_unsigned
     : forall w : Integers.Int64.int,
       @eq BinNums.Z (Integers.Int64.unsigned (umul128_low w))
         (BinInt.Z.modulo (Integers.Int64.unsigned w) divmod96_radix)
umul128_mul_unsigned
     : forall (x y : Integers.Int64.int)
         (_ : BinInt.Z.lt (BinInt.Z.mul (Integers.Int64.unsigned x) (Integers.Int64.unsigned y)) Integers.Int64.modulus),
       @eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.mul x y))
         (BinInt.Z.mul (Integers.Int64.unsigned x) (Integers.Int64.unsigned y))
umul128_add_unsigned
     : forall (x y : Integers.Int64.int)
         (_ : BinInt.Z.lt (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y)) Integers.Int64.modulus),
       @eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.add x y))
         (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y))
umul128_sum3_unsigned
     : forall (x y z : Integers.Int64.int)
         (_ : BinInt.Z.lt
                (BinInt.Z.add (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y))
                   (Integers.Int64.unsigned z)) Integers.Int64.modulus),
       @eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.add (Integers.Int64.add x y) z))
         (BinInt.Z.add (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y))
            (Integers.Int64.unsigned z))
umul128_sum4_unsigned
     : forall (x y z w : Integers.Int64.int)
         (_ : BinInt.Z.lt
                (BinInt.Z.add
                   (BinInt.Z.add (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y))
                      (Integers.Int64.unsigned z)) (Integers.Int64.unsigned w)) Integers.Int64.modulus),
       @eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.add (Integers.Int64.add (Integers.Int64.add x y) z) w))
         (BinInt.Z.add
            (BinInt.Z.add (BinInt.Z.add (Integers.Int64.unsigned x) (Integers.Int64.unsigned y))
               (Integers.Int64.unsigned z)) (Integers.Int64.unsigned w))
umul128_lo_modular
     : forall ll mid : Integers.Int64.int,
       @eq Integers.Int64.int (umul128_lo ll mid)
         (Integers.Int64.repr
            (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned mid) divmod96_radix)
               (Integers.Int64.unsigned (umul128_low ll))))
umul128_machine_observation
     : forall a b : Integers.Int64.int,
       let ll : Integers.Int64.int := umul128_ll a b in
       let lh : Integers.Int64.int := umul128_lh a b in
       let hl : Integers.Int64.int := umul128_hl a b in
       let hh : Integers.Int64.int := umul128_hh a b in
       let mid : Integers.Int64.int := umul128_mid ll lh hl in
       and
         (@eq BinNums.Z (Integers.Int64.unsigned (umul128_hi hh lh hl mid))
            (BinInt.Z.div (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)) Integers.Int64.modulus))
         (@eq BinNums.Z (Integers.Int64.unsigned (umul128_lo ll mid))
            (BinInt.Z.modulo (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
               Integers.Int64.modulus))
eval_umul128_layout
     : forall (m : Memory.Mem.mem) (bh : Values.block) (ofs : Integers.Ptrofs.int) (a b : Integers.Int64.int)
         (_ : Memory.Mem.valid_access m AST.Mint64 bh (Integers.Ptrofs.unsigned ofs) Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m (@Ctypes.Internal Clight.function f_secp256k1_umul128)
               (@cons Values.val (Values.Vlong a)
                  (@cons Values.val (Values.Vlong b) (@cons Values.val (Values.Vptr bh ofs) (@nil Values.val))))
               Events.E0 mf (Values.Vlong (umul128_result_lo a b)))
            (and
               (@eq (option Values.val) (Memory.Mem.load AST.Mint64 mf bh (Integers.Ptrofs.unsigned ofs))
                  (@Some Values.val (Values.Vlong (umul128_result_hi a b))))
               (and
                  (@eq BinNums.Z (Integers.Int64.unsigned (umul128_result_hi a b))
                     (BinInt.Z.div (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
                        Integers.Int64.modulus))
                  (and
                     (@eq BinNums.Z (Integers.Int64.unsigned (umul128_result_lo a b))
                        (BinInt.Z.modulo (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b))
                           Integers.Int64.modulus))
                     (and
                        (forall (chunk : AST.memory_chunk) (bb : Values.block) (addr : BinNums.Z)
                           (_ : or (not (@eq Values.block bb bh))
                                  (or
                                     (BinInt.Z.le (BinInt.Z.add addr (Memdata.size_chunk chunk))
                                        (Integers.Ptrofs.unsigned ofs))
                                     (BinInt.Z.le
                                        (BinInt.Z.add (Integers.Ptrofs.unsigned ofs)
                                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) addr))),
                         @eq (option Values.val) (Memory.Mem.load chunk mf bb addr) (Memory.Mem.load chunk m bb addr))
                        (and
                           (forall (bb : Values.block) (addr : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m bb addr kind p),
                            Memory.Mem.perm mf bb addr kind p)
                           (@eq Values.block (Memory.Mem.nextblock mf) (Memory.Mem.nextblock m))))))))
eval_u128_field_lvalue
     : forall (high : bool) (id : BinNums.positive) (e : Clight.env) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (br : Values.block) (base : BinNums.Z)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr br (Integers.Ptrofs.repr base)))),
       Clight.eval_lvalue ge0 e le m (u128_field_expr high id) br
         (Integers.Ptrofs.add (Integers.Ptrofs.repr base) (Integers.Ptrofs.repr (u128_field_offset high))) Ctypes.Full
eval_u128_field
     : forall (high : bool) (id : BinNums.positive) (e : Clight.env) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (br : Values.block) (base : BinNums.Z) (w : Integers.Int64.int)
         (_ : frame_base_valid base)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val id le)
                (@Some Values.val (Values.Vptr br (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m br (BinInt.Z.add base (u128_field_offset high)))
                (@Some Values.val (Values.Vlong w))),
       Clight.eval_expr ge0 e le m (u128_field_expr high id) (Values.Vlong w)
u128_get_body
     : forall high : bool,
       @eq Clight.statement (Clight.fn_body (u128_get high))
         (Clight.Ssequence (Clight.Sset _t'1 (u128_field_expr high _a))
            (Clight.Sreturn (@Some Clight.expr (Clight.Etempvar _t'1 Ctypesdefs.tulong))))
