secp_prepare_public_locals
     : forall (v_env : Values.val) (m0 : Memory.Mem.mem) (ma : Memory.Mem.mem') (bl ba : Values.block)
         (mb : Memory.Mem.mem') (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
         (sbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z) (bi : Values.block)
         (edge rc : BinNums.Z) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m0 BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                (@pair Memory.Mem.mem' Values.block mb ba)) (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m0 bs sbase bi edge rc),
       @ex Memory.Mem.mem
         (fun mc : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt secp_ge (secp_public_env bl ba)
               (secp_public_temps v_env bd dbase bs sbase) mb
               (Clight.Sassign (Clight.Evar jets_secp._src secp_frame_type)
                  (Clight.Etempvar jets_secp._src secp_frame_type)) Events.E0
               (secp_public_temps v_env bd dbase bs sbase) mc ClightBigstep.Out_normal)
            (and
               (Memory.Mem.range_perm mc ba BinNums.Z0
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                  Memtype.Cur Memtype.Freeable)
               (and
                  (Memory.Mem.range_perm mc bl BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                     Memtype.Freeable)
                  (and (frame_fields_at mc bl BinNums.Z0 bi edge rc)
                     (and (not (@eq Values.block ba bl))
                        (and
                           (xsep (extA m0 bd bw bi)
                              (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                 (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                                    (@nil (prod Values.block BinNums.Z)))))
                           (and
                              (invA m0 bd dbase bw outedge cursor N bi rc false (@nil Cell)
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                                 (read_fe_rho (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value) rc)
                                 (@nil event) mc)
                              (and
                                 (lframe
                                    (fun (b : Values.block) (_ : BinNums.Z) =>
                                     and (not (@eq Values.block b ba)) (not (@eq Values.block b bl))) m0 mc)
                                 (and (not (Memory.Mem.valid_block m0 ba)) (not (Memory.Mem.valid_block m0 bl)))))))))))
eval_secp_fe_normalize_canonical
     : forall (v_env : Values.val) (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (bs : Values.block) (sbase : BinNums.Z) (bw : Values.block) (outedge cursor N : BinNums.Z)
         (bi : Values.block) (edge rc : BinNums.Z) (value : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : write_frame_at m0 bd dbase bw outedge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m0 bs sbase bi edge rc)
         (_ : frame_input_cells_at m0 bi edge rc
                (@List.map bool (option bool) (@Some bool)
                   (@frame_input_word_bits (S (S (S (S (S (S (S (S O)))))))) value))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m0
               (@Ctypes.Internal Clight.function jets_secp.f_simplicity_fe_normalize)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                  (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                     (@cons Values.val v_env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
            (and
               (finv m0 bd dbase bw outedge cursor N bi mf true
                  (@encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@canonical_fe_normalize Alg.CoreFunSem value)))
               (lframe (fun (b : Values.block) (_ : BinNums.Z) => not (extA m0 bd bw bi b)) m0 mf)))
fe_normalize_local_spec
     : secp_jet_local_spec jets_secp.f_simplicity_fe_normalize (Word.Word (S (S (S (S (S (S (S (S O)))))))))
         (Word.Word (S (S (S (S (S (S (S (S O))))))))) (@canonical_fe_normalize Alg.CoreFunSem)
