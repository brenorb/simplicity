point_weak_state =
fun k : point_coordinate =>
match point_weak_tree k return sstate with
| Some r =>
    match r return sstate with
    | RDone state _ => state
    | RIf _ _ _ => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
    end
| None => mkst (Maps.PTree.empty sx) (@nil region) (@nil event) O
end
     : forall _ : point_coordinate, sstate

