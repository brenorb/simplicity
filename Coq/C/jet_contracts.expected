?A : [ |- Ty.Ty]
@fx_case ?A ?B ?C ?D
     : forall
         (s : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                (Ty.Prod ?A ?C) ?D)
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                (Ty.Prod ?B ?C) ?D) (p : Ty.tySem (Ty.Prod (Ty.Sum ?A ?B) ?C)) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?D))
         (@jet_sha256_ctx8_init_spec.AC.case ?A ?B ?C ?D
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) s t p e)
         match
           @fst
             (sum
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) ?A)
                ((fix tySem (X : Ty.Ty) : Set :=
                    match X return Set with
                    | Ty.Unit => unit
                    | Ty.Sum A B => sum (tySem A) (tySem B)
                    | Ty.Prod A B => prod (tySem A) (tySem B)
                    end) ?B))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) ?C) p
           return (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem ?D))
         with
         | inl a =>
             s
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) ?A)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) ?C) a
                  (@snd
                     (sum
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) ?A)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) ?B))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) ?C) p)) e
         | inr b =>
             t
               (@pair
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) ?B)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) ?C) b
                  (@snd
                     (sum
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) ?A)
                        ((fix tySem (X : Ty.Ty) : Set :=
                            match X return Set with
                            | Ty.Unit => unit
                            | Ty.Sum A B => sum (tySem A) (tySem B)
                            | Ty.Prod A B => prod (tySem A) (tySem B)
                            end) ?B))
                     ((fix tySem (X : Ty.Ty) : Set :=
                         match X return Set with
                         | Ty.Unit => unit
                         | Ty.Sum A B => sum (tySem A) (tySem B)
                         | Ty.Prod A B => prod (tySem A) (tySem B)
                         end) ?C) p)) e
         end
where
?A : [ |- Ty.Ty]
?B : [ |- Ty.Ty]
?C : [ |- Ty.Ty]
?D : [ |- Ty.Ty]
@fx_injl ?A ?B ?C
     : forall
         (t : Alg.Core.domain
                (Alg.Assertion.toCore
                   (PF.CanonicalStructures.toAssertion
                      (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero)))
                ?A ?B) (a : Ty.tySem ?A) (e : BitcoinFull.env),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem (Ty.Sum ?B ?C)))
         (@jet_sha256_ctx8_init_spec.AC.injl ?A ?B ?C
            (Alg.Assertion.toCore
               (PF.CanonicalStructures.toAssertion
                  (PrimitiveBitcoinFull.Primitive.Theory.PrimitivePrimSem Option.option_Monad_Zero))) t a e)
         match
           t a e
