byte_cells =
fix byte_cells (ofs : BinNums.Z) (n v : nat) {struct n} : list cell :=
  match n return (list cell) with
  | O => @nil cell
  | S n0 =>
      @cons cell (mkcell ofs AST.Mint8unsigned (@Some sx (XL2I (XLv v))))
        (byte_cells (BinInt.Z.add ofs (BinNums.Zpos BinNums.xH)) n0 (S v))
  end
     : forall (_ : BinNums.Z) (_ : nat) (_ : nat), list cell

