                      (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                         (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong w))),
       rep (scalar_limb_rho (column_words_value (scalar_mul_caller_words rho)))
         (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z (blk beta O) (bas beta O))
            (@nil (prod Values.block BinNums.Z))) scalar_writer_initial_regs m
eval_scalar_mul_literal_both_owned
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : rep rho beta scalar_mul_caller_inputs m)
         (_ : @eq BinNums.Z (scalar_mul512_input_value rho O)
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@canonical_scalar_normalize Alg.CoreFunSem a)))
         (_ : @eq BinNums.Z (scalar_mul512_input_value rho (S (S (S (S O)))))
                (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                   (@canonical_scalar_normalize Alg.CoreFunSem b))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                     (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (rep
                  (scalar_limb_rho
                     (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                        (@canonical_scalar_multiply Alg.CoreFunSem
                           (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                              (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
                  (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z (blk beta O) (bas beta O))
                     (@nil (prod Values.block BinNums.Z))) scalar_writer_initial_regs mf)
               (and
                  (Memory.Mem.range_perm mf (blk beta O) BinNums.Z0
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     Memtype.Cur Memtype.Freeable)
                  (and
                     (Memory.Mem.range_perm mf (blk beta (S O)) BinNums.Z0
                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        Memtype.Cur Memtype.Freeable)
                     (lframe
                        (fun (block : Values.block) (ofs : BinNums.Z) =>
                         not
                           (foot beta
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 scalar_mul_caller_inputs) block ofs)) m mf)))))
scalar_mul_reader_input_values
     : forall (va vb : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 va)
                (BinInt.Z.lt va
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
         (_ : and (BinInt.Z.le BinNums.Z0 vb)
                (BinInt.Z.lt vb
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       and (@eq BinNums.Z (scalar_mul512_input_value (scalar_mul_reader_rho va vb) O) va)
         (@eq BinNums.Z (scalar_mul512_input_value (scalar_mul_reader_rho va vb) (S (S (S (S O))))) vb)
scalar_mul_normalized_input_values
     : forall a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       and
         (@eq BinNums.Z (scalar_mul512_input_value (scalar_mul_normalized_rho a b) O)
