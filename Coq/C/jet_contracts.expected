                  mf)
               (and
                  (jet_secp_write_fe_wrapper.write_inv m0 bd dbase bw outedge cursor N bi rc w0 outs0 rho
                     (slog (@fst sstate xout (rsel rho (lay layout) (write_fe_result bd (Integers.Ptrofs.repr dbase)))))
                     mf)
                  (lframe (frame (jet_secp_write_fe_wrapper.write_ext m0 bd bw bi) layout write_fe_initial_regs m) m mf))))
nth_byte_bound
     : forall (bytes : list BinNums.Z)
         (_ : @List.Forall BinNums.Z
                (fun byte : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 byte)
                   (BinInt.Z.le byte
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (n : nat),
       and (BinInt.Z.le BinNums.Z0 (@List.nth BinNums.Z n bytes BinNums.Z0))
         (BinInt.Z.le (@List.nth BinNums.Z n bytes BinNums.Z0)
            (BinNums.Zpos
               (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH)))))))))
byte_rho_unsigned
     : forall (bytes : list BinNums.Z) (n : nat)
         (_ : @List.Forall BinNums.Z
                (fun byte : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 byte)
                   (BinInt.Z.le byte
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes),
       @eq BinNums.Z (Integers.Int64.unsigned (byte_rho bytes n)) (@List.nth BinNums.Z n bytes BinNums.Z0)
byte_rho_bound
     : forall (bytes : list BinNums.Z)
         (_ : @List.Forall BinNums.Z
                (fun byte : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 byte)
                   (BinInt.Z.le byte
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (n : nat),
       and (BinInt.Z.le (@fst BinNums.Z BinNums.Z (byte_bnd n)) (Integers.Int64.unsigned (byte_rho bytes n)))
         (BinInt.Z.le (Integers.Int64.unsigned (byte_rho bytes n)) (@snd BinNums.Z BinNums.Z (byte_bnd n)))
sb_output_region
     : @eq (option region) (@List.nth_error region (sregs sb_leaf) O)
         (@Some region (mkreg (cells0 sb_leaf) true (@None BinNums.Z)))
sb_output_length
     : @eq nat (@length cell (cells0 sb_leaf)) (S (S (S (S (S O)))))
sb_output_checked
     : @eq bool (zreg_okb byte_bnd BinNums.Z0 (cells0 sb_leaf)) true
sb_return_checked
     : @eq (option (prod BinNums.Z BinNums.Z)) (zb byte_bnd sb_ret)
         (@Some (prod BinNums.Z BinNums.Z) (@pair BinNums.Z BinNums.Z BinNums.Z0 (BinNums.Zpos BinNums.xH)))
sb_return_kind
     : @eq bool (isk KI sb_ret) true
sb_output_numeric
     : forall (bytes : list BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun byte : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 byte)
                   (BinInt.Z.le byte
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes),
       and
         (@eq (list BinNums.Z) (zcells (zrho (byte_rho bytes)) (cells0 sb_leaf))
            (fe_limbs_of (jet_secp_fe_math.be_val bytes)))
         (@eq BinNums.Z (zval (zrho (byte_rho bytes)) sb_ret) (b2z (BinInt.Z.ltb (jet_secp_fe_math.be_val bytes) feP)))
eval_fe_set_b32_from_initial_regions
     : forall (m : Memory.Mem.mem) (b : Values.block) (ofs : BinNums.Z) (bb : Values.block)
         (offset : BinNums.Z) (bytes : list BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
                (fun byte : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 byte)
                   (BinInt.Z.le byte
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (_ : BinInt.Z.le BinNums.Z0 ofs)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) ofs)
         (_ : BinInt.Z.le
                (BinInt.Z.add ofs
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
                Integers.Ptrofs.max_unsigned)
         (_ : rep (byte_rho bytes)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b ofs)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb offset)
                      (@nil (prod Values.block BinNums.Z))))
                (@cons region fe_undef
                   (@cons region
                      (mkreg
                         (jet_secp_fe_b32.byte_cells BinNums.Z0
                            (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))) O) false
                         (@None BinNums.Z)) (@nil region))) m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_set_b32)
               (@cons Values.val (Values.Vptr b (Integers.Ptrofs.repr ofs))
                  (@cons Values.val (Values.Vptr bb (Integers.Ptrofs.repr offset)) (@nil Values.val))) Events.E0 mf
               (Values.Vint (Integers.Int.repr (b2z (BinInt.Z.ltb (jet_secp_fe_math.be_val bytes) feP)))))
            (and
               (fe_at mf b ofs
                  (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                     (fe_limbs_of (jet_secp_fe_math.be_val bytes))))
               (lframe
                  (fun (block : Values.block) (pos : BinNums.Z) =>
                   not
                     (foot
                        (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z b ofs)
                           (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb offset)
                              (@nil (prod Values.block BinNums.Z))))
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           (@cons region fe_undef
                              (@cons region
                                 (mkreg
                                    (jet_secp_fe_b32.byte_cells BinNums.Z0
                                       (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))) O) false
                                    (@None BinNums.Z)) (@nil region)))) block pos)) m mf)))
fold_be_bytes_bound
     : forall (bytes : list BinNums.Z)
         (_ : @List.Forall BinNums.Z
                (fun byte : BinNums.Z =>
                 and (BinInt.Z.le BinNums.Z0 byte)
                   (BinInt.Z.le byte
                      (BinNums.Zpos
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))
                bytes) (acc : BinNums.Z) (_ : BinInt.Z.le BinNums.Z0 acc),
       and
         (BinInt.Z.le
            (BinInt.Z.mul acc
               (BinInt.Z.pow
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (BinInt.Z.of_nat (@length BinNums.Z bytes))))
            (@List.fold_left BinNums.Z BinNums.Z
               (fun v byte : BinNums.Z =>
                BinInt.Z.add
                  (BinInt.Z.mul v
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                  byte) bytes acc))
         (BinInt.Z.lt
            (@List.fold_left BinNums.Z BinNums.Z
               (fun v byte : BinNums.Z =>
                BinInt.Z.add
                  (BinInt.Z.mul v
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                  byte) bytes acc)
            (BinInt.Z.mul (BinInt.Z.add acc (BinNums.Zpos BinNums.xH))
               (BinInt.Z.pow
                  (BinNums.Zpos
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                  (BinInt.Z.of_nat (@length BinNums.Z bytes)))))
be_32_bytes_bound
     : forall (bytes : list BinNums.Z)
         (_ : @eq nat (@length BinNums.Z bytes)
                (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @List.Forall BinNums.Z
