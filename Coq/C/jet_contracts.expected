one8_output_spec =
fun (m : Memory.Mem.mem) (bw : Values.block) =>
@ex Integers.Int64.int
  (fun w : Integers.Int64.int =>
   and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m bw BinNums.Z0) (@Some Values.val (Values.Vlong w)))
     (@eq (Ty.tySem (Word.Word (S (S (S O))))) (decode_word8 w) one8_spec_value))
