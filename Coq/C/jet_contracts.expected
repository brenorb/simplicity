gen_loop_run =
fun (X : Ty.Ty)
  (add : forall term : Alg.Assertion.Algebra, Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type X) sha256_ctx8_type)
  (w : nat) (term : Alg.Assertion.Algebra) (C : Ty.Ty)
  (array : Alg.Assertion.domain term (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit X)) =>
@for_while_program w C sha256_ctx8_type sha256_ctx8_type (Alg.Assertion.toCore term)
  (@gen_loop_body X add term C (Word.Word w) array)
     : forall (X : Ty.Ty)
         (_ : forall term : Alg.Assertion.Algebra,
              Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type X) sha256_ctx8_type) (w : nat)
         (term : Alg.Assertion.Algebra) (C : Ty.Ty)
         (_ : Alg.Assertion.domain term (Ty.Prod C (Word.Word w)) (Ty.Sum Ty.Unit X)),
       Alg.Assertion.domain term (Ty.Prod C sha256_ctx8_type) (Ty.Sum sha256_ctx8_type sha256_ctx8_type)

