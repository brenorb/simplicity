     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m mf : Memory.Mem.mem) (bc : Values.block) (i : nat)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) ___compound e)
                (@Some (prod Values.block Ctypes.type)
                   (@pair Values.block Ctypes.type bc (Ctypes.Tstruct _sha256_context Ctypes.noattr))))
         (_ : lt i (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (S (...)))))))))))))))))))))))
         (_ : @eq (option Memory.Mem.mem)
