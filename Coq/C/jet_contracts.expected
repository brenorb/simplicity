exec_bitcoin_lock_mid
     : forall (fid : AST.ident) (f : Clight.function) (e : Maps.PTree.tree (prod Values.block Ctypes.type))
         (le : Maps.PTree.tree Values.val) (mc me : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
         (be : Values.block) (ebase : BinNums.Z) (bt : Values.block) (tbase : BinNums.Z) (r : Integers.Int64.int)
         (_ : @eq (option Values.block)
