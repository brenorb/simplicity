limb_list_52_bound
     : forall (value : BinNums.Z)
         (_ : and (BinInt.Z.le BinNums.Z0 value)
                (BinInt.Z.lt value
                   (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                      (BinNums.Zpos
                         (BinNums.xO
                            (BinNums.xO
                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))),
       @List.Forall BinNums.Z
         (fun limb : BinNums.Z =>
          and (BinInt.Z.le BinNums.Z0 limb)
            (BinInt.Z.le limb
               (BinInt.Z.sub
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))
                  (BinNums.Zpos BinNums.xH)))) (fe_limbs_of value)
nth_limb_52_bound
     : forall (limbs : list BinNums.Z)
