                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH)))))))))
               Integers.Int64.one)) (BinInt.Z.b2z (BinInt.Z.testbit value BinNums.Z0))
secp_writeBit_step
     : forall (m : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor : BinNums.Z) (bit : bool) (_ : write_frame_at m bf base bw edge cursor (BinNums.Zpos BinNums.xH)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function f_writeBit)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val
                     (Values.Vint
                        match bit return Integers.Int.int with
                        | true => Integers.Int.one
                        | false => Integers.Int.zero
                        end) (@nil Values.val))) Events.E0 mf
               (Values.Vint
                  match bit return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (write_effect m mf bf base bw edge cursor (BinNums.Zpos BinNums.xH)
               (@cons (option bool) (@Some bool bit) (@nil (option bool)))))
eval_secp_writeBit_from_invariant
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (m : Memory.Mem.mem) (bit : bool)
         (_ : write_frame_at m0 bd base bw edge cursor N) (_ : BinInt.Z.le (BinNums.Zpos BinNums.xH) N)
         (_ : finv m0 bd base bw edge cursor N bi m false (@nil Cell)),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function f_writeBit)
               (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr base))
                  (@cons Values.val
                     (Values.Vint
                        match bit return Integers.Int.int with
                        | true => Integers.Int.one
                        | false => Integers.Int.zero
                        end) (@nil Values.val))) Events.E0 mf
               (Values.Vint
                  match bit return Integers.Int.int with
                  | true => Integers.Int.one
                  | false => Integers.Int.zero
                  end))
            (and
               (finv m0 bd base bw edge cursor N bi mf true (@cons (option bool) (@Some bool bit) (@nil (option bool))))
               (and
                  (lframe
                     (fun (b : Values.block) (_ : BinNums.Z) =>
                      and (not (@eq Values.block b bd)) (not (@eq Values.block b bw))) m mf)
                  (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                     (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm mf b ofs k p))))
secp_fe_odd_entry
     : forall (v_env : Values.val) (m : Memory.Mem.mem) (ma mb : Memory.Mem.mem') (bl ba bd : Values.block)
         (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc ma BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
