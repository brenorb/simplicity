outpoint_hash_option
     : forall (c : Ty.tySem sha256_ctx8_type) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (i : Ty.tySem (Word.Word (S (S (S (S (S O))))))),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem sha256_ctx8_type))
         (@outpoint_hash_spec (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair (Ty.tySem sha256_ctx8_type)
               (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S O)))))))) c
               (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                  (Ty.tySem (Word.Word (S (S (S (S (S O))))))) h i)))
         (ctx8_add_list c
            (@app (Ty.tySem (Word.Word (S (S (S O)))))
               (vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
               (vector_values (Word.Word (S (S (S O)))) (S (S O)) i)))
annex_hash_option
     : forall (c : Ty.tySem sha256_ctx8_type)
         (a : Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))),
       @eq (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero) (Ty.tySem sha256_ctx8_type))
         (@annex_hash_spec (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair (Ty.tySem sha256_ctx8_type)
               (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))))) c a))
         (ctx8_add_list c
            match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
            | inl _ => @cons (Ty.tySem (Word.Word (S (S (S O))))) byte_zero (@nil (Ty.tySem (Word.Word (S (S (S O))))))
            | inr h =>
                @cons (Ty.tySem (Word.Word (S (S (S O))))) byte_one
                  (vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
            end)
