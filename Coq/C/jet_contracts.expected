                  (ClightBigstep.Clight2.eval_funcall secp_ge mp
                     (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_reduce_512)
                     (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                        (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                           (@nil Values.val))) Events.E0 mf Values.Vundef)
                  (and
                     (rep (product_reduce_rho rho) (product_reduce_layout beta)
                        (reduce512_numeric_owned_regs (product_reduce_rho rho)) mf)
