       ClightBigstep.Clight2.exec_stmt ge0 (e_frame_u128 bl br) le m (wide_binary_read s result) Events.E0
         (@Maps.PTree.set Values.val result (Values.Vlong w) le) mr ClightBigstep.Out_normal
