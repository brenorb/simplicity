eval_add_write_calls
     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (edge cursor N : BinNums.Z) (bi : Values.block) (_ : BinNums.Z) (m : Memory.Mem.mem)
         (ba bb : Values.block) (a b : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : write_frame_at m0 bd dbase bw edge cursor N)
         (_ : BinInt.Z.le
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))) N)
         (_ : not (@eq Values.block ba bb))
         (_ : fe_at m ba BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_fe_normalize Alg.CoreFunSem a)))))
         (_ : fe_at m bb BinNums.Z0
                (@List.map BinNums.Z Integers.Int64.int Integers.Int64.repr
                   (fe_limbs_of
                      (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                         (@canonical_fe_normalize Alg.CoreFunSem b)))))
         (_ : Memory.Mem.range_perm m ba BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : xsep (extA m0 bd bw bi)
                (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bb BinNums.Z0)
                      (@nil (prod Values.block BinNums.Z)))))
         (_ : finv m0 bd dbase bw edge cursor N bi m false (@nil Cell)),
       @ex Memory.Mem.mem
         (fun mn : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.eval_funcall secp_ge m
                  (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_fe_add)
                  (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                     (@cons Values.val (Values.Vptr bb Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mn
                  Values.Vundef)
               (and
                  (ClightBigstep.Clight2.eval_funcall secp_ge mn
                     (@Ctypes.Internal Clight.function jets_secp.f_write_fe)
                     (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                        (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mf
                     Values.Vundef)
                  (and
                     (finv m0 bd dbase bw edge cursor N bi mf true
                        (@encode (Word.Word (S (S (S (S (S (S (S (S O)))))))))
                           (@literal_fe_add Alg.CoreFunSem
                              (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                                 (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) a b))))
                     (and
                        (Memory.Mem.range_perm mf ba BinNums.Z0
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                           Memtype.Cur Memtype.Freeable)
                        (and
                           (Memory.Mem.range_perm mf bb BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (lframe
                                 (fun (b' : Values.block) (pos : BinNums.Z) =>
                                  not
                                    (foot
                                       (@cons (prod Values.block BinNums.Z)
                                          (@pair Values.block BinNums.Z ba BinNums.Z0)
                                          (@cons (prod Values.block BinNums.Z)
                                             (@pair Values.block BinNums.Z bb BinNums.Z0)
                                             (@nil (prod Values.block BinNums.Z))))
                                       (@List.map region
                                          (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                          rshape field_add_initial_regs) b' pos)) m mn)
                              (lframe
                                 (frame (extA m0 bd bw bi)
                                    (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                                       (@nil (prod Values.block BinNums.Z))) local_write_initial_regs mn) mn mf))))))))
no_field_add_foot
     : forall (ba bb bx : Values.block) (pos : BinNums.Z) (_ : not (@eq Values.block bx ba))
         (_ : not (@eq Values.block bx bb)),
