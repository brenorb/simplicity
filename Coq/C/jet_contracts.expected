                   (Integers.Int64.repr
                      (BinNums.Zpos
                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                (Integers.Int64.repr
                   (BinInt.Z.of_nat
                      (@length (Ty.tySem (Word.Word (S (S (S O)))))
                         (byte_chunks_values (buffer_byte_chunks (S (S (S (S (S O))))) buf))))))
         (_ : uint32_array_at m bi input
                (@List.map (Ty.tySem (Word.Word (S (S (S (S (S O))))))) Integers.Int.int word32_array_value
                   (word32_chunks (S (S (S O))) state)))
         (_ : write_frame_at m bf base bw edge cursor
                (BinNums.Zpos
                   (BinNums.xO
                      (BinNums.xI
                         (BinNums.xI
                            (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall ge0 m
               (@Ctypes.Internal Clight.function f_simplicity_write_sha256_context)
               (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                  (@cons Values.val (Values.Vptr bc (Integers.Ptrofs.repr cbase)) (@nil Values.val))) Events.E0 mf
               (Values.Vint (bit_int (negb overflow))))
            (and
               (frame_output_cells_at mf bw edge cursor
                  (@encode
                     (Ty.Prod (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O))))))
                        (Ty.Prod (Word.Word (S (S (S (S (S (S O))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (@pair (Ty.tySem (buffer_type (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
                        (prod (Ty.tySem (Word.Word (wide_log W64)))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))) buf
                        (@pair (Ty.tySem (Word.Word (wide_log W64)))
                           (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                           (decode_wide W64
                              (Integers.Int64.zero_ext
                                 (BinNums.Zpos
                                    (BinNums.xO
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                 (Integers.Int64.shru counter
                                    (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))))) state))))
               (and (write_prefix_at m mf bw edge cursor)
                  (and
                     (frame_fields_at mf bf base bw edge
                        (BinInt.Z.sub cursor
                           (BinNums.Zpos
                              (BinNums.xO
                                 (BinNums.xI
                                    (BinNums.xI
                                       (BinNums.xI
                                          (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))))
                     (and
                        (loads_outside_ranges m mf bf
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                           (BinInt.Z.add base
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) bw
                           (BinInt.Z.add edge
                              (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                 (BinInt.Z.div
                                    (BinInt.Z.sub cursor
                                       (BinNums.Zpos
                                          (BinNums.xO
                                             (BinNums.xI
                                                (BinNums.xI
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                                    (BinNums.Zpos
                                       (BinNums.xO
                                          (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                           (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (and
                           (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind)
                              (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs kind p),
                            Memory.Mem.perm mf b ofs kind p)
                           (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))))
@readonly_int64_global_initialized ?F ?V
     : forall (p : AST.program ?F ?V) (b : Values.block) (info : ?V) (x : Integers.Int64.int)
         (m : Memory.Mem.mem)
         (_ : @eq (option (AST.globvar ?V))
                (@Globalenvs.Genv.find_var_info ?F ?V (@Globalenvs.Genv.globalenv ?F ?V p) b)
                (@Some (AST.globvar ?V)
                   (@AST.mkglobvar ?V info (@cons AST.init_data (AST.Init_int64 x) (@nil AST.init_data)) true false)))
         (_ : @eq (option Memory.Mem.mem) (@Globalenvs.Genv.init_mem ?F ?V p) (@Some Memory.Mem.mem m)),
       and (@eq (option Values.val) (Memory.Mem.load AST.Mint64 m b BinNums.Z0) (@Some Values.val (Values.Vlong x)))
         (forall ofs : BinNums.Z, not (Memory.Mem.perm m b ofs Memtype.Cur Memtype.Writable))
where
?F : [ |- Type]
?V : [ |- Type]
sha256_max_counter_symbol
     : @eq (option Values.block)
         (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge0) _sha256_max_counter)
         (@Some Values.block (jet_symbol_block _sha256_max_counter))
sha256_max_counter_var_info
     : @eq (option (AST.globvar Ctypes.type))
         (@Globalenvs.Genv.find_var_info (Ctypes.fundef Clight.function) Ctypes.type
            (@Globalenvs.Genv.globalenv (Ctypes.fundef Clight.function) Ctypes.type
               (@Ctypes.program_of_program Clight.function prog)) (jet_symbol_block _sha256_max_counter))
         (@Some (AST.globvar Ctypes.type) v_sha256_max_counter)
sha256_max_counter_threshold
     : @eq Integers.Int64.int
         (Integers.Int64.shru
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO
                                                                     (BinNums.xO (BinNums.xO (BinNums.xO ...))))))))))))))))))))))
            (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH)))))
         (Integers.Int64.repr
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO
                                                                     (BinNums.xO (BinNums.xO (BinNums.xO ...)))))))))))))))))))))))
sha256_max_counter_initialized
     : forall (m : Memory.Mem.mem)
         (_ : @eq (option Memory.Mem.mem)
                (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                   (@Ctypes.program_of_program Clight.function prog)) (@Some Memory.Mem.mem m)),
       sha256_max_counter_at m
sha256_max_counter_valid_block
     : forall (m : Memory.Mem.mem) (_ : sha256_max_counter_at m),
       Memory.Mem.valid_block m (jet_symbol_block _sha256_max_counter)
sha256_max_counter_alloc
     : forall (m : Memory.Mem.mem) (mf : Memory.Mem.mem') (lo hi : BinNums.Z) (fresh : Values.block)
         (_ : sha256_max_counter_at m)
         (_ : @eq (prod Memory.Mem.mem' Values.block) (Memory.Mem.alloc m lo hi)
                (@pair Memory.Mem.mem' Values.block mf fresh)),
       and (sha256_max_counter_at mf) (not (@eq Values.block fresh (jet_symbol_block _sha256_max_counter)))
sha256_max_counter_free
     : forall (m mf : Memory.Mem.mem) (b : Values.block) (lo hi : BinNums.Z) (_ : sha256_max_counter_at m)
         (_ : not (@eq Values.block b (jet_symbol_block _sha256_max_counter)))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.free m b lo hi) (@Some Memory.Mem.mem mf)),
       sha256_max_counter_at mf
sha256_max_counter_writable_other
     : forall (m : Memory.Mem.mem) (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
         (_ : sha256_max_counter_at m) (_ : Memory.Mem.valid_access m chunk b ofs Memtype.Writable),
       not (@eq Values.block b (jet_symbol_block _sha256_max_counter))
sha256_max_counter_store
     : forall (m mf : Memory.Mem.mem) (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
         (v : Values.val) (_ : sha256_max_counter_at m)
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.store chunk m b ofs v) (@Some Memory.Mem.mem mf)),
       sha256_max_counter_at mf
eval_sha256_max_counter
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Clight.temp_env)
         (m : Memory.Mem.mem)
         (_ : @eq (option (prod Values.block Ctypes.type))
                (@Maps.PTree.get (prod Values.block Ctypes.type) _sha256_max_counter e)
                (@None (prod Values.block Ctypes.type))) (_ : sha256_max_counter_at m),
       Clight.eval_expr ge0 e le m (Clight.Evar _sha256_max_counter (Ctypes.Tlong Ctypes.Unsigned Ctypes.noattr))
         (Values.Vlong
            (Integers.Int64.repr
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
sha256_read_counter_actual_stmt
     : @eq Clight.statement
         match Clight.fn_body f_simplicity_read_sha256_context return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s0 =>
             match s0 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s2 =>
                 match s2 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence stmt _ => stmt
                 | Clight.Sifthenelse _ _ _ => Clight.Sskip
                 | Clight.Sloop _ _ => Clight.Sskip
                 | Clight.Sbreak => Clight.Sskip
                 | Clight.Scontinue => Clight.Sskip
                 | Clight.Sreturn _ => Clight.Sskip
                 | Clight.Sswitch _ _ => Clight.Sskip
                 | Clight.Slabel _ _ => Clight.Sskip
                 | Clight.Sgoto _ => Clight.Sskip
                 end
             | Clight.Sifthenelse _ _ _ => Clight.Sskip
             | Clight.Sloop _ _ => Clight.Sskip
             | Clight.Sbreak => Clight.Sskip
             | Clight.Scontinue => Clight.Sskip
             | Clight.Sreturn _ => Clight.Sskip
             | Clight.Sswitch _ _ => Clight.Sskip
             | Clight.Slabel _ _ => Clight.Sskip
             | Clight.Sgoto _ => Clight.Sskip
             end
         | Clight.Sifthenelse _ _ _ => Clight.Sskip
         | Clight.Sloop _ _ => Clight.Sskip
         | Clight.Sbreak => Clight.Sskip
         | Clight.Scontinue => Clight.Sskip
         | Clight.Sreturn _ => Clight.Sskip
         | Clight.Sswitch _ _ => Clight.Sskip
         | Clight.Slabel _ _ => Clight.Sskip
         | Clight.Sgoto _ => Clight.Sskip
         end sha256_read_counter_stmt
exec_sha256_read_counter_store
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m mf : Memory.Mem.mem) (bc : Values.block)
         (base : BinNums.Z) (count len : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _compressionCount le)
                (@Some Values.val (Values.Vlong count)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _t'5 le) (@Some Values.val (Values.Vlong len)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bc
                   (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                   (Values.Vlong (sha256_read_counter count len))) (@Some Memory.Mem.mem mf)),
       ClightBigstep.Clight2.exec_stmt ge0 e le m
         (Clight.Sassign (sha256_context_field_expr CtxCounter _ctx)
            (Clight.Ebinop Cop.Oadd
               (Clight.Ebinop Cop.Oshl
                  (Clight.Ebinop Cop.Omul (Clight.Etempvar _compressionCount Ctypesdefs.tulong)
                     (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tuint)
                     Ctypesdefs.tulong)
                  (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xI BinNums.xH))))
                     Ctypesdefs.tint) Ctypesdefs.tulong) (Clight.Etempvar _t'5 Ctypesdefs.tulong) Ctypesdefs.tulong))
         Events.E0 le mf ClightBigstep.Out_normal
exec_sha256_read_counter_from_observation
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bc : Values.block) (base : BinNums.Z) (bl : Values.block)
         (count len : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) _len e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bl Ctypesdefs.tulong)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bl BinNums.Z0)
                (@Some Values.val (Values.Vlong len)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _compressionCount le)
                (@Some Values.val (Values.Vlong count)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bc
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt ge0 e le m sha256_read_counter_stmt Events.E0 lef mf
                  ClightBigstep.Out_normal)
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.store AST.Mint64 m bc
                        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (Values.Vlong (sha256_read_counter count len))) (@Some Memory.Mem.mem mf))
                  (@eq (option Values.val)
                     (Memory.Mem.load AST.Mint64 mf bc
                        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                     (@Some Values.val (Values.Vlong (sha256_read_counter count len)))))))
exec_sha256_read_counter_from_memory
     : forall (e : Maps.PTree.tree (prod Values.block Ctypes.type)) (le : Maps.PTree.tree Values.val)
         (m : Memory.Mem.mem) (bc : Values.block) (base : BinNums.Z) (bl : Values.block)
         (count len : Integers.Int64.int) (_ : BinInt.Z.le BinNums.Z0 base)
         (_ : BinInt.Z.le
                (BinInt.Z.add base
                   (BinNums.Zpos
                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                Integers.Ptrofs.max_unsigned)
         (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) _len e)
                (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type bl Ctypesdefs.tulong)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bl BinNums.Z0)
                (@Some Values.val (Values.Vlong len)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _ctx le)
                (@Some Values.val (Values.Vptr bc (Integers.Ptrofs.repr base))))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _compressionCount le)
                (@Some Values.val (Values.Vlong count)))
         (_ : Memory.Mem.valid_access m AST.Mint64 bc
                (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Writable)
         (_ : sha256_max_counter_at m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          @ex Clight.temp_env
            (fun lef : Clight.temp_env =>
             and
               (ClightBigstep.Clight2.exec_stmt ge0 e le m sha256_read_counter_stmt Events.E0 lef mf
                  ClightBigstep.Out_normal)
               (and
                  (@eq (option Memory.Mem.mem)
                     (Memory.Mem.store AST.Mint64 m bc
                        (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                        (Values.Vlong (sha256_read_counter count len))) (@Some Memory.Mem.mem mf))
                  (and
                     (@eq (option Values.val)
                        (Memory.Mem.load AST.Mint64 mf bc
                           (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                        (@Some Values.val (Values.Vlong (sha256_read_counter count len))))
                     (sha256_max_counter_at mf)))))
sha256_read_overflow_false
     : forall count : Integers.Int64.int,
       iff (@eq bool (sha256_read_overflow count) false)
         (BinInt.Z.lt (Integers.Int64.unsigned count)
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...)))))))))))))))))))))))
sha256_read_overflow_true
     : forall count : Integers.Int64.int,
       iff (@eq bool (sha256_read_overflow count) true)
         (BinInt.Z.le
            (BinNums.Zpos
               (BinNums.xO
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (...))))))))))))))))))))))
            (Integers.Int64.unsigned count))
sha256_read_overflow_actual_suffix
     : @eq Clight.statement
         match Clight.fn_body f_simplicity_read_sha256_context return Clight.statement with
         | Clight.Sskip => Clight.Sskip
         | Clight.Sassign _ _ => Clight.Sskip
         | Clight.Sset _ _ => Clight.Sskip
         | Clight.Scall _ _ _ => Clight.Sskip
         | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
         | Clight.Ssequence _ s0 =>
             match s0 return Clight.statement with
             | Clight.Sskip => Clight.Sskip
             | Clight.Sassign _ _ => Clight.Sskip
             | Clight.Sset _ _ => Clight.Sskip
             | Clight.Scall _ _ _ => Clight.Sskip
             | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
             | Clight.Ssequence _ s2 =>
                 match s2 return Clight.statement with
                 | Clight.Sskip => Clight.Sskip
                 | Clight.Sassign _ _ => Clight.Sskip
                 | Clight.Sset _ _ => Clight.Sskip
                 | Clight.Scall _ _ _ => Clight.Sskip
                 | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                 | Clight.Ssequence _ s4 =>
                     match s4 return Clight.statement with
                     | Clight.Sskip => Clight.Sskip
                     | Clight.Sassign _ _ => Clight.Sskip
                     | Clight.Sset _ _ => Clight.Sskip
                     | Clight.Scall _ _ _ => Clight.Sskip
                     | Clight.Sbuiltin _ _ _ _ => Clight.Sskip
                     | Clight.Ssequence _ suffix => suffix
                     | Clight.Sifthenelse _ _ _ => Clight.Sskip
                     | Clight.Sloop _ _ => Clight.Sskip
                     | Clight.Sbreak => Clight.Sskip
