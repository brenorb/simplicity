zgood =
fun (ρ : forall _ : nat, Integers.Int64.int) (β : forall _ : nat, prod Values.block BinNums.Z) (x : sx) =>
match ktop x return Prop with
| KI => @eq BinNums.Z (Integers.Int.unsigned (ii (den ρ β x))) (zval (zrho ρ) x)
| KL => @eq BinNums.Z (Integers.Int64.unsigned (il (den ρ β x))) (zval (zrho ρ) x)
| KP => True
| KA => True
| KV => True
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : forall _ : nat, prod Values.block BinNums.Z) (_ : sx), Prop

