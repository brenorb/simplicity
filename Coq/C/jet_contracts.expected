                                  (BinInt.Z.le
                                     (BinInt.Z.add dbase
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                     ofs)))
                        (_ : or (not (@eq Values.block b bw))
                               (or
                                  (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                     (BinInt.Z.add outedge
                                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                           (BinInt.Z.div
                                              (BinInt.Z.sub cursor
                                                 (BinInt.Z.of_nat
                                                    (bitSize
                                                       (Ty.Prod (Word.Word (wide_log s)) (Word.Word (wide_log s))))))
                                              (BinNums.Zpos
                                                 (BinNums.xO
                                                    (BinNums.xO
                                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                  (BinInt.Z.le
                                     (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                      @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))
wide_divmod_context_guarantees
     : forall (s : wide_size) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (ctx : Context)
         (a : Ty.tySem (Word.Word (S (wide_log s)))),
       let s0 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (wide_log s))) a)
              (newWriteFrame (bitSize (Word.Word (S (wide_log s)))))) in
       let s1 : RunState :=
         fillContext ctx
           (Build_LocalState (@encode (Word.Word (S (wide_log s))) a)
              (fullWriteFrame (@encode (Word.Word (S (wide_log s))) (@div_mod_word_spec (wide_log s) Alg.CoreFunSem a))))
         in
       forall (_ : bm_rep m L s0) (_ : bm_separated L s0) (_ : active_write_writable m L s0),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (silent_call_guarantees (Clight.globalenv prog) (@Ctypes.Internal Clight.function (wide_divmod s))
               (jet_args env L) m (Values.Vint Integers.Int.one) mf)
            (and (bm_rep mf L s1)
               (runProgram (@div_mod_word_spec (wide_log s) Naive.translate) (Running s0) (Running s1))))
divmod96_initial_bounds
     : forall (B ah al D bh bl : BinNums.Z) (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) B)
         (_ : and (BinInt.Z.le BinNums.Z0 ah) (BinInt.Z.lt ah D))
         (_ : and (BinInt.Z.le BinNums.Z0 al) (BinInt.Z.lt al B))
         (_ : and (BinInt.Z.lt BinNums.Z0 bh) (BinInt.Z.lt bh B))
         (_ : and (BinInt.Z.le BinNums.Z0 bl) (BinInt.Z.lt bl B))
         (_ : @eq BinNums.Z D (BinInt.Z.add (BinInt.Z.mul bh B) bl))
         (_ : BinInt.Z.le (BinInt.Z.mul B B) (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) D)),
       let q : BinNums.Z := divmod96_estimate B ah bh in
       and (and (BinInt.Z.le BinNums.Z0 q) (BinInt.Z.lt q B))
         (and
            (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.sub ah (BinInt.Z.mul q bh)))
               (BinInt.Z.le (BinInt.Z.sub ah (BinInt.Z.mul q bh)) ah))
            (and
               (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.mul q bl)) (BinInt.Z.lt (BinInt.Z.mul q bl) (BinInt.Z.mul B B)))
               (and
                  (BinInt.Z.le (BinInt.Z.mul (BinNums.Zneg (BinNums.xO BinNums.xH)) D)
                     (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul ah B) al) (BinInt.Z.mul q D)))
                  (BinInt.Z.lt (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul ah B) al) (BinInt.Z.mul q D)) D))))
divmod96_guard_exact
     : forall (B rh al d : BinNums.Z) (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) B)
         (_ : BinInt.Z.le BinNums.Z0 rh) (_ : and (BinInt.Z.le BinNums.Z0 al) (BinInt.Z.lt al B))
         (_ : and (BinInt.Z.le BinNums.Z0 d) (BinInt.Z.lt d (BinInt.Z.mul B B))),
       iff
         (and (BinInt.Z.le rh (BinInt.Z.sub B (BinNums.Zpos BinNums.xH)))
            (BinInt.Z.lt (BinInt.Z.add (BinInt.Z.mul B rh) al) d))
         (BinInt.Z.lt (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul B rh) al) d) BinNums.Z0)
divmod96_compare_no_wrap
     : forall (B rh al : BinNums.Z) (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) B)
         (_ : and (BinInt.Z.le BinNums.Z0 rh) (BinInt.Z.le rh (BinInt.Z.sub B (BinNums.Zpos BinNums.xH))))
         (_ : and (BinInt.Z.le BinNums.Z0 al) (BinInt.Z.lt al B)),
       and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add (BinInt.Z.mul B rh) al))
         (BinInt.Z.lt (BinInt.Z.add (BinInt.Z.mul B rh) al) (BinInt.Z.mul B B))
divmod96_correction_step
     : forall (B ah al D bh bl q rh d delta : BinNums.Z) (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) B)
         (_ : BinInt.Z.le BinNums.Z0 ah) (_ : and (BinInt.Z.le BinNums.Z0 al) (BinInt.Z.lt al B))
         (_ : and (BinInt.Z.lt BinNums.Z0 bh) (BinInt.Z.lt bh B))
         (_ : and (BinInt.Z.le BinNums.Z0 bl) (BinInt.Z.lt bl B))
         (_ : @eq BinNums.Z D (BinInt.Z.add (BinInt.Z.mul bh B) bl))
         (_ : and (BinInt.Z.le BinNums.Z0 q) (BinInt.Z.lt q B)) (_ : BinInt.Z.le BinNums.Z0 rh)
         (_ : @eq BinNums.Z ah (BinInt.Z.add (BinInt.Z.mul q bh) rh)) (_ : @eq BinNums.Z d (BinInt.Z.mul q bl))
         (_ : @eq BinNums.Z delta (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul B rh) al) d))
         (_ : BinInt.Z.lt delta BinNums.Z0),
       and
         (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.sub q (BinNums.Zpos BinNums.xH)))
            (BinInt.Z.lt (BinInt.Z.sub q (BinNums.Zpos BinNums.xH)) B))
         (and (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.add rh bh)) (BinInt.Z.le (BinInt.Z.add rh bh) ah))
            (and
               (@eq BinNums.Z ah
                  (BinInt.Z.add (BinInt.Z.mul (BinInt.Z.sub q (BinNums.Zpos BinNums.xH)) bh) (BinInt.Z.add rh bh)))
               (and
                  (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.sub d bl))
                     (BinInt.Z.lt (BinInt.Z.sub d bl) (BinInt.Z.mul B B)))
                  (and (@eq BinNums.Z (BinInt.Z.sub d bl) (BinInt.Z.mul (BinInt.Z.sub q (BinNums.Zpos BinNums.xH)) bl))
                     (and
                        (@eq BinNums.Z
                           (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul B (BinInt.Z.add rh bh)) al) (BinInt.Z.sub d bl))
                           (BinInt.Z.add delta D)) (BinInt.Z.lt (BinInt.Z.add delta D) D))))))
divmod96_two_corrections_suffice
     : forall (D delta0 i : BinNums.Z) (_ : BinInt.Z.lt BinNums.Z0 D)
         (_ : BinInt.Z.le (BinInt.Z.mul (BinNums.Zneg (BinNums.xO BinNums.xH)) D) delta0)
         (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) i),
       BinInt.Z.le BinNums.Z0 (BinInt.Z.add delta0 (BinInt.Z.mul i D))
divmod96_exit_balance
     : forall (B ah al D q rh d : BinNums.Z) (_ : BinInt.Z.lt BinNums.Z0 D)
         (_ : @eq BinNums.Z (BinInt.Z.add (BinInt.Z.mul ah B) al)
                (BinInt.Z.add (BinInt.Z.mul q D) (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul B rh) al) d)))
         (_ : BinInt.Z.lt (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul B rh) al) d) D)
         (_ : not
                (and (BinInt.Z.le rh (BinInt.Z.sub B (BinNums.Zpos BinNums.xH)))
                   (BinInt.Z.lt (BinInt.Z.add (BinInt.Z.mul B rh) al) d)))
         (_ : BinInt.Z.le (BinNums.Zpos (BinNums.xO BinNums.xH)) B) (_ : BinInt.Z.le BinNums.Z0 rh)
         (_ : and (BinInt.Z.le BinNums.Z0 al) (BinInt.Z.lt al B))
         (_ : and (BinInt.Z.le BinNums.Z0 d) (BinInt.Z.lt d (BinInt.Z.mul B B))),
       and
         (@eq BinNums.Z (BinInt.Z.add (BinInt.Z.mul q D) (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul B rh) al) d))
            (BinInt.Z.add (BinInt.Z.mul ah B) al))
         (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul B rh) al) d))
            (BinInt.Z.lt (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul B rh) al) d) D))
divmod96_high_unsigned
     : forall b : Integers.Int64.int,
       @eq BinNums.Z (Integers.Int64.unsigned (divmod96_high b))
         (BinInt.Z.div (Integers.Int64.unsigned b) divmod96_radix)
divmod96_low_unsigned
     : forall b : Integers.Int64.int,
       @eq BinNums.Z (Integers.Int64.unsigned (divmod96_low b))
         (BinInt.Z.modulo (Integers.Int64.unsigned b) divmod96_radix)
divmod96_sum_modular
     : forall (B : BinNums.Z) (rh al : Integers.Int64.int),
       @eq Integers.Int64.int (Integers.Int64.add (Integers.Int64.mul (Integers.Int64.repr B) rh) al)
         (Integers.Int64.repr (BinInt.Z.add (BinInt.Z.mul B (Integers.Int64.unsigned rh)) (Integers.Int64.unsigned al)))
divmod96_final_modular
     : forall (B : BinNums.Z) (rh al d : Integers.Int64.int),
       @eq Integers.Int64.int
         (Integers.Int64.sub (Integers.Int64.add (Integers.Int64.mul (Integers.Int64.repr B) rh) al) d)
         (Integers.Int64.repr
            (BinInt.Z.sub (BinInt.Z.add (BinInt.Z.mul B (Integers.Int64.unsigned rh)) (Integers.Int64.unsigned al))
               (Integers.Int64.unsigned d)))
divmod96_final_unsigned
     : forall (rh al d : Integers.Int64.int)
         (_ : and
                (BinInt.Z.le BinNums.Z0
                   (BinInt.Z.sub
                      (BinInt.Z.add (BinInt.Z.mul divmod96_radix (Integers.Int64.unsigned rh))
                         (Integers.Int64.unsigned al)) (Integers.Int64.unsigned d)))
                (BinInt.Z.lt
                   (BinInt.Z.sub
                      (BinInt.Z.add (BinInt.Z.mul divmod96_radix (Integers.Int64.unsigned rh))
                         (Integers.Int64.unsigned al)) (Integers.Int64.unsigned d)) Integers.Int64.modulus)),
       @eq BinNums.Z
         (Integers.Int64.unsigned
            (Integers.Int64.sub (Integers.Int64.add (Integers.Int64.mul (Integers.Int64.repr divmod96_radix) rh) al) d))
         (BinInt.Z.sub
            (BinInt.Z.add (BinInt.Z.mul divmod96_radix (Integers.Int64.unsigned rh)) (Integers.Int64.unsigned al))
            (Integers.Int64.unsigned d))
divmod96_guard_negative
     : forall (rh al d : Integers.Int64.int) (_ : BinInt.Z.lt (Integers.Int64.unsigned al) divmod96_radix)
         (_ : BinInt.Z.lt (Integers.Int64.unsigned d) (BinInt.Z.mul divmod96_radix divmod96_radix)),
       iff (@eq bool (divmod96_guard rh al d) true)
         (BinInt.Z.lt
            (BinInt.Z.sub
               (BinInt.Z.add (BinInt.Z.mul divmod96_radix (Integers.Int64.unsigned rh)) (Integers.Int64.unsigned al))
               (Integers.Int64.unsigned d)) BinNums.Z0)
eval_divmod96_high_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (b : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _b le) (@Some Values.val (Values.Vlong b))),
       Clight.eval_expr ge0 e le m
         (Clight.Ebinop Cop.Oshr (Clight.Etempvar _b Ctypesdefs.tulong)
            (Clight.Econst_int
               (Integers.Int.repr
                  (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
               Ctypesdefs.tint) Ctypesdefs.tulong) (Values.Vlong (divmod96_high b))
eval_divmod96_low_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (b : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _b le) (@Some Values.val (Values.Vlong b))),
       Clight.eval_expr ge0 e le m
         (Clight.Ebinop Cop.Oand (Clight.Etempvar _b Ctypesdefs.tulong)
            (Clight.Econst_int Integers.Int.mone Ctypesdefs.tuint) Ctypesdefs.tulong) (Values.Vlong (divmod96_low b))
eval_divmod96_sum_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (rh al : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _rh le) (@Some Values.val (Values.Vlong rh)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _al le) (@Some Values.val (Values.Vlong al))),
       Clight.eval_expr ge0 e le m divmod96_sum_expr
         (Values.Vlong (Integers.Int64.add (Integers.Int64.mul (Integers.Int64.repr divmod96_radix) rh) al))
eval_divmod96_first_guard_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (rh : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _rh le) (@Some Values.val (Values.Vlong rh))),
       Clight.eval_expr ge0 e le m divmod96_first_guard_expr
         (Values.Vint
            (bit_int
               (negb
                  (Integers.Int64.ltu (Integers.Int64.repr (BinInt.Z.sub divmod96_radix (BinNums.Zpos BinNums.xH))) rh))))
eval_divmod96_second_guard_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (rh al d : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _rh le) (@Some Values.val (Values.Vlong rh)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _al le) (@Some Values.val (Values.Vlong al)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _d le) (@Some Values.val (Values.Vlong d))),
       Clight.eval_expr ge0 e le m divmod96_second_guard_expr
         (Values.Vint
            (bit_int
               (Integers.Int64.ltu (Integers.Int64.add (Integers.Int64.mul (Integers.Int64.repr divmod96_radix) rh) al)
                  d)))
exec_divmod96_guard_stmt
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (rh al d : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _rh le) (@Some Values.val (Values.Vlong rh)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _al le) (@Some Values.val (Values.Vlong al)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _d le) (@Some Values.val (Values.Vlong d))),
       ClightBigstep.Clight2.exec_stmt ge0 e le m divmod96_guard_stmt Events.E0
         (@Maps.PTree.set Values.val _t'2 (Values.Vint (bit_int (divmod96_guard rh al d))) le) m
         ClightBigstep.Out_normal
eval_divmod96_final_expr
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (rh al d : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _rh le) (@Some Values.val (Values.Vlong rh)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _al le) (@Some Values.val (Values.Vlong al)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _d le) (@Some Values.val (Values.Vlong d))),
       Clight.eval_expr ge0 e le m divmod96_final_expr
         (Values.Vlong
            (Integers.Int64.repr
               (BinInt.Z.sub
                  (BinInt.Z.add (BinInt.Z.mul divmod96_radix (Integers.Int64.unsigned rh)) (Integers.Int64.unsigned al))
                  (Integers.Int64.unsigned d))))
divmod96_denominator_parts
     : forall (b : Integers.Int64.int)
         (_ : BinInt.Z.le Integers.Int64.modulus
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned b))),
       and
         (and (BinInt.Z.lt BinNums.Z0 (Integers.Int64.unsigned (divmod96_high b)))
            (BinInt.Z.lt (Integers.Int64.unsigned (divmod96_high b)) divmod96_radix))
         (and
            (and (BinInt.Z.le BinNums.Z0 (Integers.Int64.unsigned (divmod96_low b)))
               (BinInt.Z.lt (Integers.Int64.unsigned (divmod96_low b)) divmod96_radix))
            (@eq BinNums.Z (Integers.Int64.unsigned b)
               (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned (divmod96_high b)) divmod96_radix)
                  (Integers.Int64.unsigned (divmod96_low b)))))
divmod96_divu_unsigned
     : forall (ah bh : Integers.Int64.int) (_ : BinInt.Z.lt BinNums.Z0 (Integers.Int64.unsigned bh)),
       @eq BinNums.Z (Integers.Int64.unsigned (Integers.Int64.divu ah bh))
         (BinInt.Z.div (Integers.Int64.unsigned ah) (Integers.Int64.unsigned bh))
divmod96_clamp_unsigned
     : forall (ah bh : Integers.Int64.int) (_ : BinInt.Z.lt BinNums.Z0 (Integers.Int64.unsigned bh)),
       @eq BinNums.Z (Integers.Int64.unsigned (divmod96_clamp ah bh))
         (divmod96_estimate divmod96_radix (Integers.Int64.unsigned ah) (Integers.Int64.unsigned bh))
divmod96_machine_initial_bounds
     : forall (ah al b : Integers.Int64.int)
         (_ : BinInt.Z.le Integers.Int64.modulus
                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned b)))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned ah) (Integers.Int64.unsigned b))
         (_ : BinInt.Z.lt (Integers.Int64.unsigned al) divmod96_radix),
       let bh : Integers.Int64.int := divmod96_high b in
       let bl : Integers.Int64.int := divmod96_low b in
       let q : BinNums.Z := Integers.Int64.unsigned (divmod96_clamp ah bh) in
       and (and (BinInt.Z.le BinNums.Z0 q) (BinInt.Z.lt q divmod96_radix))
         (and
            (and
               (BinInt.Z.le BinNums.Z0
                  (BinInt.Z.sub (Integers.Int64.unsigned ah) (BinInt.Z.mul q (Integers.Int64.unsigned bh))))
               (BinInt.Z.le (BinInt.Z.sub (Integers.Int64.unsigned ah) (BinInt.Z.mul q (Integers.Int64.unsigned bh)))
                  (Integers.Int64.unsigned ah)))
            (and
               (and (BinInt.Z.le BinNums.Z0 (BinInt.Z.mul q (Integers.Int64.unsigned bl)))
                  (BinInt.Z.lt (BinInt.Z.mul q (Integers.Int64.unsigned bl)) Integers.Int64.modulus))
               (and
                  (BinInt.Z.le (BinInt.Z.mul (BinNums.Zneg (BinNums.xO BinNums.xH)) (Integers.Int64.unsigned b))
                     (BinInt.Z.sub
                        (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned ah) divmod96_radix)
                           (Integers.Int64.unsigned al)) (BinInt.Z.mul q (Integers.Int64.unsigned b))))
                  (BinInt.Z.lt
                     (BinInt.Z.sub
                        (BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned ah) divmod96_radix)
                           (Integers.Int64.unsigned al)) (BinInt.Z.mul q (Integers.Int64.unsigned b)))
                     (Integers.Int64.unsigned b)))))
eval_divmod96_quotient
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m : Memory.Mem.mem) (bq : Values.block)
         (ofs : Integers.Ptrofs.int) (q : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _q le) (@Some Values.val (Values.Vptr bq ofs)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bq (Integers.Ptrofs.unsigned ofs))
                (@Some Values.val (Values.Vlong q))),
       Clight.eval_expr ge0 e le m
         (Clight.Ederef (Clight.Etempvar _q (Ctypesdefs.tptr Ctypesdefs.tulong)) Ctypesdefs.tulong)
         (Values.Vlong q)
exec_divmod96_correction_stmt
     : forall (e : Clight.env) (le : Maps.PTree.tree Values.val) (m ms : Memory.Mem.mem) (bq : Values.block)
         (ofs : Integers.Ptrofs.int) (q rh bh d bl : Integers.Int64.int)
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _q le) (@Some Values.val (Values.Vptr bq ofs)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _rh le) (@Some Values.val (Values.Vlong rh)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _bh le) (@Some Values.val (Values.Vlong bh)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _d le) (@Some Values.val (Values.Vlong d)))
         (_ : @eq (option Values.val) (@Maps.PTree.get Values.val _bl le) (@Some Values.val (Values.Vlong bl)))
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint64 m bq (Integers.Ptrofs.unsigned ofs))
                (@Some Values.val (Values.Vlong q)))
         (_ : @eq (option Memory.Mem.mem)
                (Memory.Mem.store AST.Mint64 m bq (Integers.Ptrofs.unsigned ofs)
                   (Values.Vlong (Integers.Int64.sub q Integers.Int64.one))) (@Some Memory.Mem.mem ms)),
       ClightBigstep.Clight2.exec_stmt ge0 e le m divmod96_correction_stmt Events.E0
         (@Maps.PTree.set Values.val _d (Values.Vlong (Integers.Int64.sub d bl))
            (@Maps.PTree.set Values.val _rh (Values.Vlong (Integers.Int64.add rh bh))
               (@Maps.PTree.set Values.val _t'3 (Values.Vlong q) le))) ms ClightBigstep.Out_normal
divmod96_machine_step_values
     : forall (q rh bh d bl : Integers.Int64.int) (_ : BinInt.Z.lt BinNums.Z0 (Integers.Int64.unsigned q))
         (_ : BinInt.Z.lt (BinInt.Z.add (Integers.Int64.unsigned rh) (Integers.Int64.unsigned bh))
