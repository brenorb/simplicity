bnd_of_log =
fix bnd_of_log (tb : forall (_ : nat) (_ : nat), prod BinNums.Z BinNums.Z) (log : list event) (n : nat) {struct log} :
    prod BinNums.Z BinNums.Z :=
  match log return (prod BinNums.Z BinNums.Z) with
  | nil =>
      @pair BinNums.Z BinNums.Z BinNums.Z0
        (BinNums.Zpos
           (BinNums.xI
              (BinNums.xI
                 (BinNums.xI
                    (BinNums.xI
                       (BinNums.xI
                          (BinNums.xI
                             (BinNums.xI
                                (BinNums.xI
                                   (BinNums.xI
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI
                                                        (BinNums.xI
                                                           (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI ...)))))))))))))))))))))
  | cons ev t =>
      match
        andb (PeanoNat.Nat.leb (ebase ev) n) (PeanoNat.Nat.ltb n (Nat.add (ebase ev) (ecnt ev)))
        return (prod BinNums.Z BinNums.Z)
      with
      | true => tb (etag ev) (Nat.sub n (ebase ev))
      | false => bnd_of_log tb t n
      end
  end
     : forall (_ : forall (_ : nat) (_ : nat), prod BinNums.Z BinNums.Z) (_ : list event) (_ : nat),
       prod BinNums.Z BinNums.Z

