div_mod_word_representation
     : forall (n : nat) (x y : Ty.tySem (Word.Word n)),
       @eq (prod (Ty.tySem (Word.ToZ.obj (Word.WordToZ n))) (Ty.tySem (Word.ToZ.obj (Word.WordToZ n))))
         (@pair (Ty.tySem (Word.ToZ.obj (Word.WordToZ n))) (Ty.tySem (Word.ToZ.obj (Word.WordToZ n)))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ n)
               (division_numeric false (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)
                  (@Word.ToZ.Theory.toZ (Word.WordToZ n) y)))
            (@Word.ToZ.Theory.fromZ (Word.WordToZ n)
               (division_numeric true (@Word.ToZ.Theory.toZ (Word.WordToZ n) x)
                  (@Word.ToZ.Theory.toZ (Word.WordToZ n) y))))
         (@div_mod_word_spec n Alg.CoreFunSem (@pair (Ty.tySem (Word.Word n)) (Ty.tySem (Word.Word n)) x y))
divmod8_body
     : @eq Clight.statement (Clight.fn_body f_simplicity_div_mod_8)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar _src (Ctypes.Tstruct _frameItem Ctypes.noattr))
               (Clight.Etempvar _src (Ctypes.Tstruct _frameItem Ctypes.noattr)))
            (Clight.Ssequence
               (Clight.Ssequence (binary8_read _t'1)
                  (Clight.Sset _x (Clight.Ecast (Clight.Etempvar _t'1 Ctypesdefs.tuchar) Ctypesdefs.tuchar)))
               (Clight.Ssequence
                  (Clight.Ssequence (binary8_read _t'2)
                     (Clight.Sset _y (Clight.Ecast (Clight.Etempvar _t'2 Ctypesdefs.tuchar) Ctypesdefs.tuchar)))
                  (Clight.Ssequence
                     (Clight.Ssequence (divmod8_choose _t'3 false)
                        (jet_arith8_layout_exec.frame_writer_call _simplicity_write8 Ctypesdefs.tuchar Ctypesdefs.tvoid
                           (Clight.Etempvar _t'3 Ctypesdefs.tint)))
                     (Clight.Ssequence
                        (Clight.Ssequence (divmod8_choose _t'4 true)
                           (jet_arith8_layout_exec.frame_writer_call _simplicity_write8 Ctypesdefs.tuchar
                              Ctypesdefs.tvoid (Clight.Etempvar _t'4 Ctypesdefs.tint)))
                        (Clight.Sreturn (@Some Clight.expr (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))))))))
eval_divmod8_composes
     : forall (env : Values.val) (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc mr mr2 mq me mf : Memory.Mem.mem)
         (bl bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bytes : list Memdata.memval) (r t : Integers.Int.int) (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : not (@eq Values.block bl bs))
         (_ : @eq (prod Memory.Mem.mem' Values.block)
