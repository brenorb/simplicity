Inductive order_op : Set :=  OLt : order_op | OLe : order_op.
lt_word_spec =
fun (term : Alg.Core.Algebra) (n : nat) =>
@AC.comp (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n))
  (Ty.Sum Ty.Unit Ty.Unit) term (@subtract_word_spec term n)
  (@AC.take (Ty.Sum Ty.Unit Ty.Unit) (Word.Word n) (Ty.Sum Ty.Unit Ty.Unit) term
     (@AC.iden (Ty.Sum Ty.Unit Ty.Unit) term))
     : forall (term : Alg.Core.Algebra) (n : nat),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit)

Arguments lt_word_spec {term} n%nat_scope
le_word_spec =
fun (term : Alg.Core.Algebra) (n : nat) =>
@Bit.not (Ty.Prod (Word.Word n) (Word.Word n)) term
  (@AC.comp (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit) term
     (@AC.pair (Ty.Prod (Word.Word n) (Word.Word n)) (Word.Word n) (Word.Word n) term
        (@AC.drop (Word.Word n) (Word.Word n) (Word.Word n) term (@AC.iden (Word.Word n) term))
        (@AC.take (Word.Word n) (Word.Word n) (Word.Word n) term (@AC.iden (Word.Word n) term)))
     (@lt_word_spec term n))
     : forall (term : Alg.Core.Algebra) (n : nat),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit)

Arguments le_word_spec {term} n%nat_scope
order_word_spec =
fun (k : order_op) (n : nat) (term : Alg.Core.Algebra) =>
match k return (Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit)) with
| OLt => @lt_word_spec term n
| OLe => @le_word_spec term n
end
     : forall (_ : order_op) (n : nat) (term : Alg.Core.Algebra),
       Alg.Core.domain term (Ty.Prod (Word.Word n) (Word.Word n)) (Ty.Sum Ty.Unit Ty.Unit)

Arguments order_word_spec k n%nat_scope {term}
order_numeric =
fun (k : order_op) (a b : BinNums.Z) =>
match k return bool with
| OLt => BinInt.Z.ltb a b
| OLe => BinInt.Z.leb a b
end
     : forall (_ : order_op) (_ : BinNums.Z) (_ : BinNums.Z), bool

Arguments order_numeric k (a b)%Z_scope
order_cmp =
fun k : order_op => match k return Integers.comparison with
                    | OLt => Integers.Clt
                    | OLe => Integers.Cle
                    end
     : forall _ : order_op, Integers.comparison

Arguments order_cmp k
order_binop =
fun k : order_op => match k return Cop.binary_operation with
                    | OLt => Cop.Olt
                    | OLe => Cop.Ole
                    end
     : forall _ : order_op, Cop.binary_operation

Arguments order_binop k
