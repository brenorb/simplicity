binary1_choose =
fun k : binary_op =>
match k return Clight.statement with
| BAnd =>
    Clight.Sifthenelse (Clight.Etempvar _x Ctypesdefs.tbool)
      (Clight.Sset _t'3 (Clight.Ecast (Clight.Etempvar _y Ctypesdefs.tbool) Ctypesdefs.tbool))
      (Clight.Sset _t'3 (Clight.Econst_int Integers.Int.zero Ctypesdefs.tint))
| BOr =>
    Clight.Sifthenelse (Clight.Etempvar _x Ctypesdefs.tbool)
      (Clight.Sset _t'3 (Clight.Econst_int Integers.Int.one Ctypesdefs.tint))
      (Clight.Sset _t'3 (Clight.Ecast (Clight.Etempvar _y Ctypesdefs.tbool) Ctypesdefs.tbool))
| BXor => Clight.Sskip
end
