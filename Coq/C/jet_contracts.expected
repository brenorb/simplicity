                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))),
       @eq bool (Integers.Int64.testbit (copy_partial_cross_value ss ds old source next) i)
         match Coqlib.zlt i (BinInt.Z.sub ds ss) return bool with
         | left _ =>
             Integers.Int64.testbit next
               (BinInt.Z.add i
                  (BinInt.Z.sub
                     (BinNums.Zpos
                        (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                     (BinInt.Z.sub ds ss)))
         | right _ =>
             match Coqlib.zlt i ds return bool with
             | left _ => Integers.Int64.testbit source (BinInt.Z.sub i (BinInt.Z.sub ds ss))
             | right _ => Integers.Int64.testbit old i
             end
         end
