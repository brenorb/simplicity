bitcoin_read8_step
     : forall (m : Memory.Mem.mem) (ma : Memory.Mem.mem') (mc : Memory.Mem.mem) (bl bs : Values.block)
         (sbase : BinNums.Z) (bi : Values.block) (edge rc : BinNums.Z) (x : Ty.tySem (Word.Word (S (S (S O)))))
         (bytes : list Memdata.memval)
         (_ : and (BinInt.Z.le BinNums.Z0 rc)
                (BinInt.Z.le rc
                   (BinInt.Z.sub Integers.Int64.max_unsigned
                      (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : frame_fields_at m bs sbase bi edge rc) (_ : @frame_input_word_at (S (S (S O))) m bi edge rc x)
         (_ : @eq (prod Memory.Mem.mem' Values.block)
                (Memory.Mem.alloc m BinNums.Z0
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@pair Memory.Mem.mem' Values.block ma bl))
         (_ : @eq (option (list Memdata.memval))
                (Memory.Mem.loadbytes ma bs sbase
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                (@Some (list Memdata.memval) bytes))
         (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc)),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall bitcoin_ge mc (@Ctypes.Internal Clight.function f_simplicity_read8)
               (@cons Values.val (Values.Vptr bl (Integers.Ptrofs.repr BinNums.Z0)) (@nil Values.val)) Events.E0 mr
               (Values.Vint (Integers.Int.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S O)))) x))))
            (and
               (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                  (_ : not (@eq Values.block b bl)),
                @eq (option Values.val) (Memory.Mem.load chunk mr b ofs) (Memory.Mem.load chunk mc b ofs))
               (and
                  (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
                     (_ : Memory.Mem.perm mc b ofs kind p), Memory.Mem.perm mr b ofs kind p)
                  (and (forall (b : Values.block) (_ : Memory.Mem.valid_block mc b), Memory.Mem.valid_block mr b)
                     (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                        (v : Values.val)
                        (_ : @eq (option Values.val) (Memory.Mem.load chunk m b ofs) (@Some Values.val v)),
                      @eq (option Values.val) (Memory.Mem.load chunk mr b ofs) (@Some Values.val v))))))
