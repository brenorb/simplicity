  (@cons region
     (mkreg
        (u64_cells BinNums.Z0
           (@cons sx (XLv O) (@cons sx (XLv (S O)) (@cons sx (XLv (S (S O))) (@cons sx (XLv (S (S (S O)))) (@nil sx))))))
        true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
