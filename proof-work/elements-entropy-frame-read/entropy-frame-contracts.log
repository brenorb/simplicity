TAP_TYPE EntropyFrame.Allocation.calc_alloc_list_props
Allocation.calc_alloc_list_props
     : forall (zs : list BinNums.Z) (m m' : Memory.Mem.mem) (bs : list Values.block)
         (_ : @eq (prod Memory.Mem.mem (list Values.block)) (Allocation.calc_alloc_list m zs)
                (@pair Memory.Mem.mem (list Values.block) m' bs)),
       and (jet_sha_compress_call.mext m m')
         (and (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), not (@List.In Values.block b bs))
            (and (@List.NoDup Values.block bs)
               (@List.Forall2 Values.block BinNums.Z
                  (fun (b : Values.block) (z : BinNums.Z) =>
                   and (Memory.Mem.range_perm m' b BinNums.Z0 z Memtype.Cur Memtype.Freeable)
                     (Memory.Mem.valid_block m' b)) bs zs)))
