TAP_TYPE EntropyFrame.ReadTail.entropy_read_tail
ReadTail.entropy_read_tail
     : forall (m : Memory.Mem.mem) (bl bo bc bi : Values.block) (edge rc : BinNums.Z)
         (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (ix : Ty.tySem (Word.Word (S (S (S (S (S O)))))))
         (con : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : BinInt.Z.le BinNums.Z0 rc)
         (_ : BinInt.Z.le
                (BinInt.Z.add rc
                   (BinNums.Zpos
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH))))))))))
                Integers.Int64.max_unsigned) (_ : jet_frame_layout.frame_fields_at m bl BinNums.Z0 bi edge rc)
         (_ : not (@eq Values.block bl bi)) (_ : not (@eq Values.block bo bi)) (_ : not (@eq Values.block bc bi))
         (_ : not (@eq Values.block bl bo)) (_ : not (@eq Values.block bl bc)) (_ : not (@eq Values.block bo bc))
         (_ : Memory.Mem.range_perm m bl BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bo BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : Memory.Mem.range_perm m bc BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Freeable)
         (_ : jet_uint32_array_init.uint32_array_at m bo BinNums.Z0 (Digest.hash256_reg (Word.to_hash256 h)))
         (_ : @jet_input_layout.frame_input_word_at (S (S (S (S (S O))))) m bi edge rc ix)
         (_ : jet_encoding.frame_input_cells_at m bi edge
                (BinInt.Z.add rc
                   (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) con)),
       @ex Memory.Mem.mem
         (fun mr : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun ms : Memory.Mem.mem =>
             @ex Memory.Mem.mem
               (fun mf : Memory.Mem.mem =>
                and
                  (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                     (@Ctypes.Internal Clight.function jets_elements.f_simplicity_read32)
                     (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)) Events.E0 mr
                     (Values.Vlong (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) ix))))
                  (and
                     (@eq (option Memory.Mem.mem)
                        (Memory.Mem.store AST.Mint64 mr bo
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                           (Values.Vlong
                              (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) ix))))
                        (@Some Memory.Mem.mem ms))
                     (and
                        (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge ms
                           (@Ctypes.Internal Clight.function jets_elements.f_read32s)
                           (@cons Values.val (Values.Vptr bc Integers.Ptrofs.zero)
                              (@cons Values.val
                                 (Values.Vlong
                                    (Integers.Int64.repr
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val)))) Events.E0
                           mf Values.Vundef)
                        (and
                           (jet_uint32_array_init.uint32_array_at mf bo BinNums.Z0
                              (Digest.hash256_reg (Word.to_hash256 h)))
                           (and
                              (@eq (option Values.val)
                                 (Memory.Mem.load AST.Mint64 mf bo
                                    (BinNums.Zpos
                                       (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                                 (@Some Values.val
                                    (Values.Vlong
                                       (Integers.Int64.repr
                                          (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) ix)))))
                              (and
                                 (jet_uint32_array_init.uint32_array_at mf bc BinNums.Z0
                                    (Digest.hash256_reg (Word.to_hash256 con)))
                                 (and
                                    (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                                       (BinInt.Z.add rc
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                    (and
                                       (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                          (_ : not (@eq Values.block b bl)) (_ : not (@eq Values.block b bo))
                                          (_ : not (@eq Values.block b bc)),
                                        @eq (option Values.val) (Memory.Mem.load ch mf b ofs)
                                          (Memory.Mem.load ch m b ofs))
                                       (and
                                          (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                                             (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs k p),
                                           Memory.Mem.perm mf b ofs k p)
                                          (forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                           Memory.Mem.valid_block mf b))))))))))))
