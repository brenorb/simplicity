                (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm mf b ofs k p)
         (_ : forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)
         (_ : @List.Forall2 Values.block BinNums.Z
                (fun (b : Values.block) (z : BinNums.Z) =>
                 and (Memory.Mem.range_perm m b BinNums.Z0 z Memtype.Cur Memtype.Freeable) (Memory.Mem.valid_block m b))
                bs zs),
