(** Experimental composition of the proved original 52/64-bit C summaries. *)
From Coq Require Import ZArith List.
From compcert Require Import Integers AST Ctypes Clight ClightBigstep Maps Memory Events Values.
Require Import C.jet_sx_expr C.jet_sx_state C.jet_sx_mem C.jet_sx_exec C.jet_secp_linkage C.jets_secp.
Require Import C.jet_secp_u128_shift64_oracle.
Require Import SecpShift.Oracle.
Local Open Scope Z_scope.
Set Default Timeout 10.

Definition field_shift_oracle : oracle := fun base log xs regs =>
  match shift52_oracle base log xs regs with
  | Some result => Some result
  | None => u128_shift64_oracle base log xs regs end.

Theorem field_shift_oracle_correct :
  oracle_ok secp_ge (fun _ _ => True) (fun _ _ _ => True) (fun _ => False)
    f_secp256k1_u128_rshift field_shift_oracle.
Proof.
  unfold oracle_ok, field_shift_oracle.
  intros base xs regs regs' v tag cnt eargs log rho layout m HRun HRep HSep HInv HSol HEv.
  destruct (shift52_oracle base log xs regs) as [result|] eqn:H52.
  - inversion HRun; subst result.
    exact (shift52_oracle_correct base xs regs regs' v tag cnt eargs log rho layout m
      H52 HRep HSep HInv HSol HEv).
  - exact (u128_shift64_oracle_correct base xs regs regs' v tag cnt eargs log rho layout m
      HRun HRep HSep HInv HSol HEv).
Qed.
