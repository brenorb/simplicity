TAP_DEF BetaGlobal.Global.beta_digits
Global.beta_digits =
fun i : nat => @List.nth Integers.Int64.int i Global.beta_words Integers.Int64.zero
     : forall _ : nat, Integers.Int64.int

Arguments Global.beta_digits i%nat_scope
TAP_DEF BetaGlobal.Global.beta_block
Global.beta_block = jet_secp_linkage.secp_symbol_block jets_secp._secp256k1_const_beta
     : Values.block
TAP_DEF BetaGlobal.Global.beta_global_rep
Global.beta_global_rep =
fun m : Memory.Mem.mem =>
and (Memory.Mem.valid_block m Global.beta_block)
  (and
     (Memory.Mem.range_perm m Global.beta_block BinNums.Z0
        (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))) Memtype.Cur
        Memtype.Readable)
     (forall (i : nat) (w : Integers.Int64.int)
        (_ : @eq (option Integers.Int64.int) (@List.nth_error Integers.Int64.int Global.beta_words i)
               (@Some Integers.Int64.int w)),
      @eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m Global.beta_block
           (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) (BinInt.Z.of_nat i)))
        (@Some Values.val (Values.Vlong w))))
     : forall _ : Memory.Mem.mem, Prop

Arguments Global.beta_global_rep m
TAP_DEF BetaGlobal.Global.beta_readonly_bounds
Global.beta_readonly_bounds =
fun m : Memory.Mem.mem =>
forall (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission),
iff (Memory.Mem.perm m Global.beta_block ofs k p)
  (and
     (and (BinInt.Z.le BinNums.Z0 ofs)
        (BinInt.Z.lt ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     (Memtype.perm_order Memtype.Readable p))
     : forall _ : Memory.Mem.mem, Prop

Arguments Global.beta_readonly_bounds m
TAP_DEF BetaGlobal.Global.beta_initialized
Global.beta_initialized =
fun m : Memory.Mem.mem => and (Global.beta_global_rep m) (Global.beta_readonly_bounds m)
     : forall _ : Memory.Mem.mem, Prop

Arguments Global.beta_initialized m
TAP_DEF BetaGlobal.Global.beta_program_initialization_ok
Global.beta_program_initialization_ok =
@jet_program_initialization.program_initialization_okb (Ctypes.fundef Clight.function) Ctypes.type
  (@Ctypes.program_of_program Clight.function jets_secp.prog)
     : bool
TAP_DEF BetaGlobal.Inputs.beta_mixed_rho
Inputs.beta_mixed_rho =
fun (rho : forall _ : nat, Integers.Int64.int) (i : nat) =>
match PeanoNat.Nat.ltb i (S (S (S (S (S O))))) return Integers.Int64.int with
| true => rho i
| false => Global.beta_digits (Nat.sub i (S (S (S (S (S O))))))
end
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : nat), Integers.Int64.int

Arguments Inputs.beta_mixed_rho rho%function_scope i%nat_scope
TAP_DEF BetaGlobal.Inputs.beta_input_rho
Inputs.beta_input_rho =
fun x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
Inputs.beta_mixed_rho (jet_secp_b32_exec.limb_rho (jet_secp_multiply_input_input.normalized_value x))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : nat), Integers.Int64.int

Arguments Inputs.beta_input_rho x i%nat_scope
TAP_DEF BetaGlobal.Spec.beta_word
Spec.beta_word =
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) Global.beta_value
     : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))
TAP_DEF BetaGlobal.Spec.literal_fe_beta
Spec.literal_fe_beta =
fun term : Alg.Core.Algebra => @Alg.scribe Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) Spec.beta_word term
     : forall term : Alg.Core.Algebra, Alg.Core.domain term Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments Spec.literal_fe_beta {term}
TAP_DEF BetaGlobal.Spec.literal_fe_multiply_beta
Spec.literal_fe_multiply_beta =
fun term : Alg.Core.Algebra =>
@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O)))))))))
  (Ty.Prod (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
  (@Alg.Core.Combinators.pair (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
     (@Alg.Core.Combinators.comp (Word.Word (S (S (S (S (S (S (S (S O))))))))) Ty.Unit
        (Word.Word (S (S (S (S (S (S (S (S O))))))))) term
        (@Alg.Core.Combinators.unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) term) (@Spec.literal_fe_beta term))
     (@Alg.Core.Combinators.iden (Word.Word (S (S (S (S (S (S (S (S O))))))))) term))
  (@jet_secp_negate_literal_contract.literal_fe_multiply term)
     : forall term : Alg.Core.Algebra,
       Alg.Core.domain term (Word.Word (S (S (S (S (S (S (S (S O))))))))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments Spec.literal_fe_multiply_beta {term}
