TAP_DEF FieldSecondValues.Accum.accumulate
Accum.accumulate =
fix accumulate
  (s : prod Integers.Int64.int Integers.Int64.int) (ps : list (prod Integers.Int64.int Integers.Int64.int)) {struct ps} :
    prod Integers.Int64.int Integers.Int64.int :=
  match ps return (prod Integers.Int64.int Integers.Int64.int) with
  | nil => s
  | cons p rest =>
      match p return (prod Integers.Int64.int Integers.Int64.int) with
      | pair a b => accumulate (Machine.machine_accum s a b) rest
      end
  end
     : forall (_ : prod Integers.Int64.int Integers.Int64.int) (_ : list (prod Integers.Int64.int Integers.Int64.int)),
       prod Integers.Int64.int Integers.Int64.int

