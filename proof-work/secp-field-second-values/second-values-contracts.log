TAP_DEF FieldSecondValues.Accum.products
Accum.products =
fix products (ps : list (prod Integers.Int64.int Integers.Int64.int)) : BinNums.Z :=
  match ps return BinNums.Z with
  | nil => BinNums.Z0
  | cons p rest =>
      match p return BinNums.Z with
      | pair a b => BinInt.Z.add (BinInt.Z.mul (Integers.Int64.unsigned a) (Integers.Int64.unsigned b)) (products rest)
      end
  end
     : forall _ : list (prod Integers.Int64.int Integers.Int64.int), BinNums.Z

