TAP_DEF FieldCall.Call.field_output_regs
Call.field_output_regs =
fun rho : forall _ : nat, Integers.Int64.int =>
@cons jet_sx_state.region
  (jet_sx_state.mkreg
     (jet_sx_rep.u64_cells BinNums.Z0
        (@cons jet_sx_expr.sx (jet_sx_expr.XL (Execute.original_finish_words rho O))
           (@cons jet_sx_expr.sx (jet_sx_expr.XL (Execute.original_finish_words rho (S O)))
              (@cons jet_sx_expr.sx (jet_sx_expr.XL (Execute.original_finish_words rho (S (S O))))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XL (Execute.original_finish_words rho (S (S (S O)))))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XL (Execute.original_finish_words rho (S (S (S (S O))))))
                       (@nil jet_sx_expr.sx))))))) true
     (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
  (@cons jet_sx_state.region
     (jet_sx_state.mkreg
        (jet_sx_rep.u64_cells BinNums.Z0
           (@cons jet_sx_expr.sx (jet_sx_expr.XL (rho (S (S (S (S (S O)))))))
              (@cons jet_sx_expr.sx (jet_sx_expr.XL (rho (S (S (S (S (S (S O))))))))
                 (@cons jet_sx_expr.sx (jet_sx_expr.XL (rho (S (S (S (S (S (S (S O)))))))))
                    (@cons jet_sx_expr.sx (jet_sx_expr.XL (rho (S (S (S (S (S (S (S (S O))))))))))
                       (@cons jet_sx_expr.sx (jet_sx_expr.XL (rho (S (S (S (S (S (S (S (S (S O)))))))))))
                          (@nil jet_sx_expr.sx))))))) true
        (@Some BinNums.Z (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))))
     (@nil jet_sx_state.region))
     : forall _ : forall _ : nat, Integers.Int64.int, list jet_sx_state.region

Arguments Call.field_output_regs rho%function_scope
