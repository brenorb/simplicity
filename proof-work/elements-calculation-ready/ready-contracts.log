TAP_TYPE CalculationReady.Ready.calc_pointer_initialized
@Ready.calc_pointer_initialized
     : forall (F V : Type) (p : AST.program F V) (b : Values.block) (info : V) (symbol : AST.ident)
         (target : Values.block) (offset : Integers.Ptrofs.int) (m : Memory.Mem.mem) (readonly : bool)
         (_ : @eq (option (AST.globvar V)) (@Globalenvs.Genv.find_var_info F V (@Globalenvs.Genv.globalenv F V p) b)
                (@Some (AST.globvar V)
                   (@AST.mkglobvar V info (@cons AST.init_data (AST.Init_addrof symbol offset) (@nil AST.init_data))
                      readonly false)))
         (_ : @eq (option Values.block) (@Globalenvs.Genv.find_symbol F V (@Globalenvs.Genv.globalenv F V p) symbol)
                (@Some Values.block target))
         (_ : @eq (option Memory.Mem.mem) (@Globalenvs.Genv.init_mem F V p) (@Some Memory.Mem.mem m)),
       @eq (option Values.val) (Memory.Mem.load AST.Mptr m b BinNums.Z0) (@Some Values.val (Values.Vptr target offset))
