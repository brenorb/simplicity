TAP_DEF CalculationReady.Ready.calculation_initial_run
Ready.calculation_initial_run =
fun (f : Clight.function)
  (spec : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
          Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) =>
forall (env : Values.val) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (mi : Memory.Mem.mem)
  (_ : @eq (option Memory.Mem.mem)
         (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
            (@Ctypes.program_of_program Clight.function jets_elements.prog)) (@Some Memory.Mem.mem mi)),
@ex Memory.Mem.mem
  (fun m : Memory.Mem.mem =>
   @ex Values.block
     (fun bd : Values.block =>
      @ex Values.block
        (fun bs : Values.block =>
         @ex Values.block
           (fun bw : Values.block =>
            @ex Memory.Mem.mem
              (fun mf : Memory.Mem.mem =>
               and
                 (forall (b : Values.block) (ch : AST.memory_chunk) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block mi b),
                  @eq (option Values.val) (Memory.Mem.load ch m b ofs) (Memory.Mem.load ch mi b ofs))
                 (and
                    (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                       (@Ctypes.Internal Clight.function f)
                       (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                          (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                             (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
                    (and
                       (jet_encoding.frame_output_cells_at mf bw BinNums.Z0
                          (BinNums.Zpos
                             (BinNums.xO
                                (BinNums.xO
                                   (BinNums.xO
                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))
                          (@Translate.encode (Word.Word (S (S (S (S (S (S (S (S O))))))))) (spec h)))
                       (forall (b : Values.block) (ch : AST.memory_chunk) (ofs : BinNums.Z)
                          (_ : Memory.Mem.valid_block mi b),
                        @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch mi b ofs)))))))))
     : forall (_ : Clight.function)
         (_ : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
              Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))), Prop

Arguments Ready.calculation_initial_run f spec%function_scope
TAP_DEF CalculationReady.Ready.init_aligned_b
Ready.init_aligned_b =
fix init_aligned_b (p : BinNums.Z) (il : list AST.init_data) {struct il} : bool :=
  match il return bool with
  | nil => true
  | cons i rest =>
      andb (BinInt.Z.eqb (BinInt.Z.modulo p (Globalenvs.Genv.init_data_alignment i)) BinNums.Z0)
        (init_aligned_b (BinInt.Z.add p (AST.init_data_size i)) rest)
  end
     : forall (_ : BinNums.Z) (_ : list AST.init_data), bool

Arguments Ready.init_aligned_b p%Z_scope il%list_scope
TAP_DEF CalculationReady.Ready.addrof_defined_b
Ready.addrof_defined_b =
fun (F V : Type) (ge : Globalenvs.Genv.t F V) (d : AST.init_data) =>
match d return bool with
| AST.Init_int8 _ => true
| AST.Init_int16 _ => true
| AST.Init_int32 _ => true
| AST.Init_int64 _ => true
| AST.Init_float32 _ => true
| AST.Init_float64 _ => true
| AST.Init_space _ => true
| AST.Init_addrof i _ =>
    match @Globalenvs.Genv.find_symbol F V ge i return bool with
    | Some _ => true
    | None => false
    end
end
     : forall (F V : Type) (_ : Globalenvs.Genv.t F V) (_ : AST.init_data), bool

Arguments Ready.addrof_defined_b {F V}%type_scope ge d
TAP_DEF CalculationReady.Ready.globvar_init_ok
Ready.globvar_init_ok =
fun (F V : Type) (ge : Globalenvs.Genv.t F V) (g : AST.globdef F V) =>
match g return bool with
| AST.Gfun _ => true
| AST.Gvar v =>
    andb (Ready.init_aligned_b BinNums.Z0 (@AST.gvar_init V v))
      (@List.forallb AST.init_data (@Ready.addrof_defined_b F V ge) (@AST.gvar_init V v))
end
     : forall (F V : Type) (_ : Globalenvs.Genv.t F V) (_ : AST.globdef F V), bool

Arguments Ready.globvar_init_ok {F V}%type_scope ge g
