(** Actual original scalar_mul_512, using the sound no-op-branch executor.
    This establishes execution, not yet the numeric product observation. *)
From Coq Require Import ZArith List Lia.
From compcert Require Import AST Ctypes Clight ClightBigstep Integers Values Maps Memory Events Globalenvs.
Require Import C.jet_sx_expr C.jet_sx_state C.jet_sx_eval C.jet_sx_exec C.jet_sx_rep C.jet_sx_mem.
Require Import C.jet_sx_pure C.jet_secp_fns C.jet_secp_linkage C.jets_secp C.jet_secp_frame.
Require Import MulC.jet_sx_compact.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.

Definition scalar_mul512_functions :=
  [(_secp256k1_umul128, f_secp256k1_umul128);
   (_secp256k1_u128_mul, f_secp256k1_u128_mul);
   (_secp256k1_u128_to_u64, f_secp256k1_u128_to_u64);
   (_secp256k1_u128_hi_u64, f_secp256k1_u128_hi_u64)].
Lemma scalar_mul512_functions_ok id f : In (id,f) scalar_mul512_functions ->
  exists b, Genv.find_symbol secp_ge id = Some b /\ Genv.find_funct_ptr secp_ge b = Some (Internal f).
Proof.
  intros [H|[H|[H|[H|H]]]]; try contradiction; inversion H; subst; apply secp_pure_ok;
    unfold secp_pure.
  - right; left; reflexivity.
  - right; right; right; left; reflexivity.
  - do 7 right; left; reflexivity.
  - do 8 right; left; reflexivity.
Qed.
Definition scalar_mul512_initial_regs : list region :=
  [mkreg (u64_cells 0 [XLv 8; XLv 9; XLv 10; XLv 11; XLv 12; XLv 13; XLv 14; XLv 15]) true (Some 64);
   mkreg (u64_cells 0 [XLv 0; XLv 1; XLv 2; XLv 3]) true (Some 32);
   mkreg (u64_cells 0 [XLv 4; XLv 5; XLv 6; XLv 7]) true (Some 32)].
Definition scalar_mul512_run : option res :=
  compact_fun (genv_cenv secp_ge) [] (int_table scalar_mul512_functions) 200
    f_secp256k1_scalar_mul_512 [XP 0 0; XP 1 0; XP 2 0] scalar_mul512_initial_regs [] 16.
Lemma scalar_mul512_run_completes :
  match scalar_mul512_run with Some (RDone _ ONormal) => true | _ => false end = true.
Proof. Timeout 10 vm_compute; reflexivity. Qed.
Definition scalar_mul512_state : sstate :=
  match scalar_mul512_run with Some (RDone st _) => st
    | _ => mkst (PTree.empty sx) [] [] 0 end.
Lemma scalar_mul512_run_eq : scalar_mul512_run = Some (RDone scalar_mul512_state ONormal).
Proof.
  pose proof scalar_mul512_run_completes as H.
  unfold scalar_mul512_state; destruct scalar_mul512_run as [r|]; [|discriminate].
  destruct r; [destruct o; try discriminate; reflexivity|discriminate].
Qed.
Lemma scalar_mul512_return : (stemps scalar_mul512_state)!1%positive = None.
Proof. Timeout 10 vm_compute; reflexivity. Qed.
Lemma scalar_mul512_log_nil : slog scalar_mul512_state = [].
Proof. Timeout 10 vm_compute; reflexivity. Qed.
Definition scalar_mul512_limbs : list sx :=
  map cell_sx (rcells (hd (mkreg [] false None) (sregs scalar_mul512_state))).
Lemma scalar_mul512_limbs_length : length scalar_mul512_limbs = 8%nat.
Proof. Timeout 10 vm_compute; reflexivity. Qed.
Lemma scalar_mul512_output : sregs scalar_mul512_state =
  [mkreg (u64_cells 0 scalar_mul512_limbs) true (Some 64);
   mkreg (u64_cells 0 [XLv 0; XLv 1; XLv 2; XLv 3]) true (Some 32);
   mkreg (u64_cells 0 [XLv 4; XLv 5; XLv 6; XLv 7]) true (Some 32)].
Proof. Timeout 10 reflexivity. Qed.

Local Opaque scalar_mul512_state.
Theorem eval_scalar_mul512_owned rho beta m :
  rep rho beta scalar_mul512_initial_regs m ->
  exists mf,
    Clight2.eval_funcall secp_ge m (Internal f_secp256k1_scalar_mul_512)
      [Vptr (blk beta 0) (Ptrofs.repr (bas beta 0));
       Vptr (blk beta 1) (Ptrofs.repr (bas beta 1));
       Vptr (blk beta 2) (Ptrofs.repr (bas beta 2))] E0 mf Vundef /\
    rep rho beta
      [mkreg (u64_cells 0 scalar_mul512_limbs) true (Some 64);
       mkreg (u64_cells 0 [XLv 0; XLv 1; XLv 2; XLv 3]) true (Some 32);
       mkreg (u64_cells 0 [XLv 4; XLv 5; XLv 6; XLv 7]) true (Some 32)] mf /\
    lframe (fun b ofs => ~ foot beta (map rshape scalar_mul512_initial_regs) b ofs) m mf.
Proof.
  intro Hrep.
  destruct (compact_fun_pure secp_ge scalar_mul512_functions scalar_mul512_functions_ok
    200 f_secp256k1_scalar_mul_512 [XP 0 0; XP 1 0; XP 2 0] scalar_mul512_initial_regs
    16 (RDone scalar_mul512_state ONormal) scalar_mul512_run_eq
    ltac:(cbn [leaves_log_nil]; rewrite scalar_mul512_log_nil; reflexivity) rho beta m Hrep)
    as (mf & vres & Hcall & Hfinal & Hreturn & Hshape & Hframe).
  cbn [rsel fst] in Hfinal,Hreturn.
  rewrite scalar_mul512_return in Hreturn; subst vres.
  rewrite scalar_mul512_output in Hfinal.
  change (map (den rho (lay beta)) [XP 0 0; XP 1 0; XP 2 0]) with
    [Vptr (blk beta 0) (Ptrofs.repr (bas beta 0 + 0));
     Vptr (blk beta 1) (Ptrofs.repr (bas beta 1 + 0));
     Vptr (blk beta 2) (Ptrofs.repr (bas beta 2 + 0))] in Hcall.
  rewrite !Z.add_0_r in Hcall.
  exists mf; split; [exact Hcall|]. split; [exact Hfinal|exact Hframe].
Qed.
