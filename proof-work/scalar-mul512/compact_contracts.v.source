Set Warnings "-notation-overridden".
Require Import MulC.jet_sx_compact.
Require Import MulC.jet_secp_scalar_mul512_run.
Require Import MulC.jet_sx_compact_checks.
Set Printing All.
Set Printing Width 120.
Set Printing Depth 100000.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact.both_skip_true". exact I. Qed.
Check MulC.jet_sx_compact.both_skip_true.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact.break_stmt_true". exact I. Qed.
Check MulC.jet_sx_compact.break_stmt_true.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact.compact_stmt_lext". exact I. Qed.
Check MulC.jet_sx_compact.compact_stmt_lext.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact.compact_stmt_sound". exact I. Qed.
Check MulC.jet_sx_compact.compact_stmt_sound.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact.compact_fun_pure". exact I. Qed.
Check MulC.jet_sx_compact.compact_fun_pure.
Goal True. idtac "COMPACT_TYPE MulC.jet_secp_scalar_mul512_run.scalar_mul512_functions_ok". exact I. Qed.
Check MulC.jet_secp_scalar_mul512_run.scalar_mul512_functions_ok.
Goal True. idtac "COMPACT_TYPE MulC.jet_secp_scalar_mul512_run.scalar_mul512_run_completes". exact I. Qed.
Check MulC.jet_secp_scalar_mul512_run.scalar_mul512_run_completes.
Goal True. idtac "COMPACT_TYPE MulC.jet_secp_scalar_mul512_run.scalar_mul512_run_eq". exact I. Qed.
Check MulC.jet_secp_scalar_mul512_run.scalar_mul512_run_eq.
Goal True. idtac "COMPACT_TYPE MulC.jet_secp_scalar_mul512_run.scalar_mul512_return". exact I. Qed.
Check MulC.jet_secp_scalar_mul512_run.scalar_mul512_return.
Goal True. idtac "COMPACT_TYPE MulC.jet_secp_scalar_mul512_run.scalar_mul512_log_nil". exact I. Qed.
Check MulC.jet_secp_scalar_mul512_run.scalar_mul512_log_nil.
Goal True. idtac "COMPACT_TYPE MulC.jet_secp_scalar_mul512_run.scalar_mul512_limbs_length". exact I. Qed.
Check MulC.jet_secp_scalar_mul512_run.scalar_mul512_limbs_length.
Goal True. idtac "COMPACT_TYPE MulC.jet_secp_scalar_mul512_run.scalar_mul512_output". exact I. Qed.
Check MulC.jet_secp_scalar_mul512_run.scalar_mul512_output.
Goal True. idtac "COMPACT_TYPE MulC.jet_secp_scalar_mul512_run.eval_scalar_mul512_owned". exact I. Qed.
Check MulC.jet_secp_scalar_mul512_run.eval_scalar_mul512_owned.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact_checks.compact_undefined_condition_rejected". exact I. Qed.
Check MulC.jet_sx_compact_checks.compact_undefined_condition_rejected.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact_checks.compact_unconvertible_condition_rejected". exact I. Qed.
Check MulC.jet_sx_compact_checks.compact_unconvertible_condition_rejected.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact_checks.compact_symbolic_noop_no_fork". exact I. Qed.
Check MulC.jet_sx_compact_checks.compact_symbolic_noop_no_fork.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact_checks.compact_loop_return_preserved". exact I. Qed.
Check MulC.jet_sx_compact_checks.compact_loop_return_preserved.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact_checks.compact_loop_continue_exits". exact I. Qed.
Check MulC.jet_sx_compact_checks.compact_loop_continue_exits.
Goal True. idtac "COMPACT_TYPE MulC.jet_sx_compact_checks.compact_effectful_branches_not_erased". exact I. Qed.
Check MulC.jet_sx_compact_checks.compact_effectful_branches_not_erased.
Goal True. idtac "COMPACT_DEF MulC.jet_sx_compact.both_skip". exact I. Qed.
Print MulC.jet_sx_compact.both_skip.
Goal True. idtac "COMPACT_DEF MulC.jet_sx_compact.break_stmt". exact I. Qed.
Print MulC.jet_sx_compact.break_stmt.
Goal True. idtac "COMPACT_DEF MulC.jet_sx_compact.compact_stmt". exact I. Qed.
Print MulC.jet_sx_compact.compact_stmt.
Goal True. idtac "COMPACT_DEF MulC.jet_sx_compact.compact_fun". exact I. Qed.
Print MulC.jet_sx_compact.compact_fun.
Goal True. idtac "COMPACT_DEF MulC.jet_secp_scalar_mul512_run.scalar_mul512_functions". exact I. Qed.
Print MulC.jet_secp_scalar_mul512_run.scalar_mul512_functions.
Goal True. idtac "COMPACT_DEF MulC.jet_secp_scalar_mul512_run.scalar_mul512_initial_regs". exact I. Qed.
Print MulC.jet_secp_scalar_mul512_run.scalar_mul512_initial_regs.
Goal True. idtac "COMPACT_DEF MulC.jet_secp_scalar_mul512_run.scalar_mul512_run". exact I. Qed.
Print MulC.jet_secp_scalar_mul512_run.scalar_mul512_run.
Goal True. idtac "COMPACT_DEF MulC.jet_secp_scalar_mul512_run.scalar_mul512_state". exact I. Qed.
Print MulC.jet_secp_scalar_mul512_run.scalar_mul512_state.
Goal True. idtac "COMPACT_DEF MulC.jet_secp_scalar_mul512_run.scalar_mul512_limbs". exact I. Qed.
Print MulC.jet_secp_scalar_mul512_run.scalar_mul512_limbs.
Goal True. idtac "COMPACT_DEF MulC.jet_sx_compact_checks.compact_check_empty". exact I. Qed.
Print MulC.jet_sx_compact_checks.compact_check_empty.
Goal True. idtac "COMPACT_DEF MulC.jet_sx_compact_checks.compact_check_symbolic". exact I. Qed.
Print MulC.jet_sx_compact_checks.compact_check_symbolic.

