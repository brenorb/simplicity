(** Exact in-place symbolic execution of the unchanged original scalar
    negation helper, retaining caller ownership. No public spec is replaced. *)
From Coq Require Import ZArith List Lia.
From compcert Require Import AST Ctypes Clight Integers Values Maps.
Require Import C.jet_sx_expr C.jet_sx_state C.jet_sx_eval C.jet_sx_exec C.jet_sx_rep C.jet_sx_pure.
Require Import C.jet_secp_fns C.jet_secp_linkage C.jets_secp.
Require Import WriterC.jet_secp_scalar_writer_run.
Require Import OriginalC.jet_secp_shift64_executor.
Require Import C.jet_secp_frame.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.

Definition scalar_negate_run : option res :=
  xfun (genv_cenv secp_ge) [] secp_shift64_table 800 f_secp256k1_scalar_negate
    [XP 0 0; XP 0 0] scalar_writer_initial_regs [] 4.
Definition scalar_negate_tree := Eval vm_compute in scalar_negate_run.
Definition scalar_negate_state : sstate :=
  match scalar_negate_tree with Some (RDone state _) => state
  | _ => mkst (PTree.empty sx) [] [] 0 end.
Lemma scalar_negate_run_eq : scalar_negate_run = Some (RDone scalar_negate_state ONormal).
Proof. reflexivity. Qed.
Lemma scalar_negate_return : (stemps scalar_negate_state)!1%positive = None.
Proof. reflexivity. Qed.
Lemma scalar_negate_output_shape :
  exists limbs, length limbs = 4%nat /\
    sregs scalar_negate_state = [mkreg (u64_cells 0 limbs) true (Some 32)].
Proof.
  exists (map cell_sx (rcells (hd (mkreg [] false None) (sregs scalar_negate_state))));
    split; reflexivity.
Qed.
Lemma scalar_negate_output_owned :
  length (sregs scalar_negate_state) = 1%nat /\
  rfree (nth 0 (sregs scalar_negate_state) (mkreg [] false None)) = Some 32.
Proof. split; reflexivity. Qed.
