TAP_TYPE FieldBorrowed.Transport.borrow_at_length
Transport.borrow_at_length
     : forall (q : nat) (regs : list jet_sx_state.region),
       @eq nat (@length jet_sx_state.region (Borrow.borrow_at q regs)) (@length jet_sx_state.region regs)
TAP_TYPE FieldBorrowed.Transport.map_upd
@Transport.map_upd
     : forall (A B : Type) (f : forall _ : A, B) (xs : list A) (q : nat) (value : A),
       @eq (list B) (@List.map A B f (@jet_sx_state.upd A xs q value))
         (@jet_sx_state.upd B (@List.map A B f xs) q (f value))
TAP_TYPE FieldBorrowed.Transport.borrow_map
Transport.borrow_map
     : forall (f : forall _ : jet_sx_state.region, jet_sx_state.region) (q : nat) (regs : list jet_sx_state.region)
         (_ : forall reg : jet_sx_state.region,
              @eq jet_sx_state.region (f (Borrow.borrowed_region reg)) (Borrow.borrowed_region (f reg))),
       @eq (list jet_sx_state.region) (@List.map jet_sx_state.region jet_sx_state.region f (Borrow.borrow_at q regs))
         (Borrow.borrow_at q (@List.map jet_sx_state.region jet_sx_state.region f regs))
TAP_TYPE FieldBorrowed.Transport.revalue_borrow
Transport.revalue_borrow
     : forall (f : forall _ : jet_sx_expr.sx, jet_sx_expr.sx) (reg : jet_sx_state.region),
       @eq jet_sx_state.region (jet_sx_revalue_cells.revalue_region f (Borrow.borrowed_region reg))
         (Borrow.borrowed_region (jet_sx_revalue_cells.revalue_region f reg))
TAP_TYPE FieldBorrowed.Transport.atomic_regs_borrow
Transport.atomic_regs_borrow
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (q : nat)
         (regs : list jet_sx_state.region),
       @eq (list jet_sx_state.region)
         (jet_secp_multiply_checkpoint_atomic.atomic_regs rho beta (Borrow.borrow_at q regs))
         (Borrow.borrow_at q (jet_secp_multiply_checkpoint_atomic.atomic_regs rho beta regs))
TAP_TYPE FieldBorrowed.Transport.atomic_state_borrow
Transport.atomic_state_borrow
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout) (q : nat)
         (st : jet_sx_eval.sstate),
       @eq jet_sx_eval.sstate (jet_secp_multiply_checkpoint_atomic.atomic_state rho beta (Transport.borrow_state q st))
         (Transport.borrow_state q (jet_secp_multiply_checkpoint_atomic.atomic_state rho beta st))
TAP_TYPE FieldBorrowed.Transport.borrow_head
Transport.borrow_head
     : forall (a b : jet_sx_state.region) (rest : list jet_sx_state.region),
       @eq (list jet_sx_state.region)
         (Borrow.borrow_at (S O) (@cons jet_sx_state.region a (@cons jet_sx_state.region b rest)))
         (@cons jet_sx_state.region a (@cons jet_sx_state.region (Borrow.borrowed_region b) rest))
TAP_TYPE FieldBorrowed.Transport.foot_regions
Transport.foot_regions
     : forall (beta : jet_sx_state.layout) (regs : list jet_sx_state.region) (b : Values.block) (ofs : BinNums.Z),
       iff
         (jet_sx_state.foot beta
            (@List.map jet_sx_state.region
               (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape regs)
            b ofs)
         (@ex nat
            (fun r : nat =>
             @ex jet_sx_state.region
               (fun reg : jet_sx_state.region =>
                @ex BinNums.Z
                  (fun d : BinNums.Z =>
                   @ex AST.memory_chunk
                     (fun ch : AST.memory_chunk =>
                      and
                        (@eq (option jet_sx_state.region) (@List.nth_error jet_sx_state.region regs r)
                           (@Some jet_sx_state.region reg))
                        (and
                           (@List.In (prod BinNums.Z AST.memory_chunk) (@pair BinNums.Z AST.memory_chunk d ch)
                              (@List.map jet_sx_state.cell (prod BinNums.Z AST.memory_chunk) jet_sx_state.cshape
                                 (jet_sx_state.rcells reg)))
                           (and (@eq Values.block b (jet_sx_state.blk beta r))
                              (and (BinInt.Z.le (BinInt.Z.add (jet_sx_state.bas beta r) d) ofs)
                                 (BinInt.Z.lt ofs
                                    (BinInt.Z.add (BinInt.Z.add (jet_sx_state.bas beta r) d) (Memdata.size_chunk ch)))))))))))
TAP_TYPE FieldBorrowed.Transport.foot_cells
Transport.foot_cells
     : forall (beta : jet_sx_state.layout) (regs regs' : list jet_sx_state.region) (b : Values.block) 
         (ofs : BinNums.Z)
         (_ : @eq (list (list jet_sx_state.cell))
                (@List.map jet_sx_state.region (list jet_sx_state.cell) jet_sx_state.rcells regs)
                (@List.map jet_sx_state.region (list jet_sx_state.cell) jet_sx_state.rcells regs'))
         (_ : jet_sx_state.foot beta
                (@List.map jet_sx_state.region
                   (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                   regs) b ofs),
       jet_sx_state.foot beta
         (@List.map jet_sx_state.region (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
            jet_sx_state.rshape regs') b ofs
TAP_TYPE FieldBorrowed.Transport.foot_borrow
Transport.foot_borrow
     : forall (beta : jet_sx_state.layout) (q : nat) (regs : list jet_sx_state.region) (b : Values.block)
         (ofs : BinNums.Z),
       iff
         (jet_sx_state.foot beta
            (@List.map jet_sx_state.region
               (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
               (Borrow.borrow_at q regs)) b ofs)
         (jet_sx_state.foot beta
            (@List.map jet_sx_state.region
               (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape regs)
            b ofs)
TAP_TYPE FieldBorrowed.Transport.lframe_borrow
Transport.lframe_borrow
     : forall (beta : jet_sx_state.layout) (q : nat) (regs : list jet_sx_state.region) (m mf : Memory.Mem.mem)
         (_ : jet_sx_mem.lframe
                (fun (b : Values.block) (ofs : BinNums.Z) =>
                 not
                   (jet_sx_state.foot beta
                      (@List.map jet_sx_state.region
                         (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                         jet_sx_state.rshape (Borrow.borrow_at q regs)) b ofs)) m mf),
       jet_sx_mem.lframe
         (fun (b : Values.block) (ofs : BinNums.Z) =>
          not
            (jet_sx_state.foot beta
               (@List.map jet_sx_state.region
                  (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) jet_sx_state.rshape
                  regs) b ofs)) m mf
