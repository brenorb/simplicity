TAP_DEF FieldBorrowed.Transport.borrow_state
Transport.borrow_state =
fun (q : nat) (st : jet_sx_eval.sstate) =>
jet_sx_eval.mkst (jet_sx_eval.stemps st) (Borrow.borrow_at q (jet_sx_eval.sregs st)) (jet_sx_eval.slog st)
  (jet_sx_eval.snv st)
     : forall (_ : nat) (_ : jet_sx_eval.sstate), jet_sx_eval.sstate

Arguments Transport.borrow_state q%nat_scope st
TAP_DEF FieldBorrowed.Call.borrowed_mul_regs
Call.borrowed_mul_regs = Borrow.borrow_at (S O) jet_secp_multiply_run_run.field_mul_regs
     : list jet_sx_state.region
TAP_DEF FieldBorrowed.Call.borrowed_final_regs
Call.borrowed_final_regs =
fun rho : forall _ : nat, Integers.Int64.int =>
Borrow.borrow_at (S O) (jet_sx_eval.sregs (jet_secp_multiply_finish_execute.original_finish_checkpoint rho))
     : forall _ : forall _ : nat, Integers.Int64.int, list jet_sx_state.region

Arguments Call.borrowed_final_regs rho%function_scope
TAP_DEF FieldBorrowed.Call.borrowed_output_regs
Call.borrowed_output_regs =
fun rho : forall _ : nat, Integers.Int64.int =>
Borrow.borrow_at (S O) (jet_secp_multiply_call_call.field_output_regs rho)
     : forall _ : forall _ : nat, Integers.Int64.int, list jet_sx_state.region

