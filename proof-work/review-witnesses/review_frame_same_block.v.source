(** Shared-block frame/data diagnostic: actual writer, unchanged C/AST. *)
(** Generated bit writer at arbitrary frame addresses and backing-word indices. *)
From Coq Require Import ZArith List Lia.
From compcert Require Import Coqlib Integers AST Ctypes Cop Clight Maps.
From compcert Require Import ClightBigstep Memory Events Globalenvs.
Require Import C.jets C.jet_exec C.jet_frame_layout C.jet_write_layout C.jet_frame_access.
Require Import C.jet_word_bits C.jet_writeBit C.jet_writeBit_position.
Import Values Mem Ctypes ListNotations Clightdefs Clightdefs.ClightNotations.
Local Open Scope Z_scope.
Local Transparent Archi.ptr64.

Require Import C.jet_writeBit_layout C.jet_output_layout.
Lemma eval_writeBit_layout_ranges m mo mf bf base bw edge cursor old bit :
  frame_base_valid base -> 1 <= cursor <= Int64.max_unsigned ->
  0 <= edge -> write_word_address edge cursor + 8 <= Ptrofs.max_unsigned ->
  frame_fields_at m bf base bw edge cursor ->
  Mem.load Mint64 m bw (write_word_address edge cursor) = Some (Vlong old) ->
  Mem.store Mint64 m bf (base + 8) (Vlong (Int64.repr (cursor - 1))) = Some mo ->
  Mem.store Mint64 mo bw (write_word_address edge cursor)
    (Vlong (write_bit_value cursor old bit)) = Some mf ->
    (bf <> bw \/ write_word_address edge cursor + 8 <= base \/
      base + 16 <= write_word_address edge cursor) ->
  ClightBigstep.Clight2.eval_funcall ge0 m (Internal f_writeBit)
    [Vptr bf (Ptrofs.repr base); Vint (if bit then Int.one else Int.zero)] E0 mf
    (Vint (if bit then Int.one else Int.zero)).
Proof.
  intros HB HC HE HA [HF HO] HW SO SW HD.
  pose proof (write_layout_index cursor HC) as [HQ [HK [Hsub [Hdiv [Hmod Hwidth]]]]].
  pose proof (write_layout_pointer edge ((cursor - 1) / 64) HQ HE
    ltac:(unfold write_word_address in HA; lia)) as Hptr.
  fold (write_word_address edge cursor) in Hptr.
  assert (Haddr : Ptrofs.unsigned (Ptrofs.repr (write_word_address edge cursor)) =
      write_word_address edge cursor).
  { apply Ptrofs.unsigned_repr. unfold write_word_address in *; lia. }
  assert (HFo : Mem.load Mptr mo bf base = Some (Vptr bw (Ptrofs.repr edge))).
  { erewrite Mem.load_store_other; [exact HF|exact SO|right; left; change (base + 8 <= base + 8); lia]. }
  pose proof (Mem.load_store_same _ _ _ _ _ _ SO) as HOo.
  assert (HWp : Mem.load Mint64 mo bw
      (Ptrofs.unsigned (Ptrofs.repr (write_word_address edge cursor))) = Some (Vlong old)).
  { rewrite Haddr. erewrite Mem.load_store_other; [exact HW|exact SO|].
    destruct HD as [Hne|[Hbefore|Hafter]].
    - left; congruence.
    - right; left. change (write_word_address edge cursor + 8 <= base + 8). lia.
    - right; right. change (base + 8 + 8 <= write_word_address edge cursor). lia. }
  assert (SWp : Mem.store Mint64 mo bw
      (Ptrofs.unsigned (Ptrofs.repr (write_word_address edge cursor)))
      (Vlong (write_bit_value cursor old bit)) = Some mf) by (rewrite Haddr; exact SW).
  assert (Hshift : Int64.ltu (Int64.repr ((cursor - 1) mod 64)) Int64.iwordsize = true).
  { unfold Int64.ltu. rewrite Int64.unsigned_repr by (unfold write_word_shift in HK;
      change (0 <= (cursor - 1) mod 64 <= 18446744073709551615); lia).
    change ((if zlt ((cursor - 1) mod 64) 64 then true else false) = true).
    rewrite zlt_true by (unfold write_word_shift in HK; lia). reflexivity. }
  destruct bit; cbn [write_bit_value] in SWp;
    eapply ClightBigstep.eval_funcall_internal
      with (e := empty_env) (m1 := m) (m2 := mf).
  - apply entry_writeBit_layout.
  - unfold f_writeBit; cbn [fn_body]. timeout 10 bitlayout_stmt.
  - cbn; split; [discriminate|reflexivity].
  - reflexivity.
  - apply entry_writeBit_layout.
  - unfold f_writeBit; cbn [fn_body]. timeout 10 bitlayout_stmt.
  - cbn; split; [discriminate|reflexivity].
  - reflexivity.
Qed.

Theorem embedded_frame_writeBit_exists :
  exists m mf b,
    frame_fields_at m b 0 b 16 64 /\
    Mem.valid_access m Mint64 b 8 Writable /\
    Mem.valid_access m Mint64 b 16 Writable /\
    ~ write_frame_at m b 0 b 16 64 1 /\
    Clight2.eval_funcall ge0 m (Internal f_writeBit)
      [Vptr b Ptrofs.zero; Vint Int.one] E0 mf (Vint Int.one) /\
    frame_fields_at mf b 0 b 16 63 /\
    Mem.load Mint64 mf b 16 = Some (Vlong (Int64.repr 9223372036854775808)).
Proof.
  destruct (Mem.alloc Mem.empty 0 24) as [ma b] eqn:HA.
  assert (VA : forall ofs, 0 <= ofs -> ofs + 8 <= 24 -> (8 | ofs) ->
    Mem.valid_access ma Mint64 b ofs Writable).
  { intros ofs Hlo Hhi Hal. eapply Mem.valid_access_implies.
    - eapply Mem.valid_access_alloc_same; [exact HA|exact Hlo|exact Hhi|exact Hal].
    - constructor. }
  assert (VA0 : Mem.valid_access ma Mptr b 0 Writable).
  { change (Mem.valid_access ma Mint64 b 0 Writable). apply VA; try lia. exists 0; reflexivity. }
  assert (VA8 : Mem.valid_access ma Mint64 b 8 Writable).
  { apply VA; try lia. exists 1; reflexivity. }
  assert (VA16 : Mem.valid_access ma Mint64 b 16 Writable).
  { apply VA; try lia. exists 2; reflexivity. }
  destruct (Mem.valid_access_store _ _ _ _ (Vptr b (Ptrofs.repr 16)) VA0) as [mp HP].
  assert (VP8 : Mem.valid_access mp Mint64 b 8 Writable).
  { eapply Mem.store_valid_access_1; [exact HP|exact VA8]. }
  destruct (Mem.valid_access_store _ _ _ _ (Vlong (Int64.repr 64)) VP8) as [mc HC].
  assert (VC16 : Mem.valid_access mc Mint64 b 16 Writable).
  { eapply Mem.store_valid_access_1; [exact HC|]. eapply Mem.store_valid_access_1; [exact HP|exact VA16]. }
  destruct (Mem.valid_access_store _ _ _ _ (Vlong Int64.zero) VC16) as [m HI].
  assert (HE : Mem.load Mptr m b 0 = Some (Vptr b (Ptrofs.repr 16))).
  { rewrite (Mem.load_store_other _ _ _ _ _ _ HI Mptr b 0) by (right; left; change (8 <= 16); lia).
    rewrite (Mem.load_store_other _ _ _ _ _ _ HC Mptr b 0) by (right; left; change (8 <= 8); lia).
    exact (Mem.load_store_same _ _ _ _ _ _ HP). }
  assert (HO : Mem.load Mint64 m b 8 = Some (Vlong (Int64.repr 64))).
  { rewrite (Mem.load_store_other _ _ _ _ _ _ HI Mint64 b 8) by (right; left; change (16 <= 16); lia).
    exact (Mem.load_store_same _ _ _ _ _ _ HC). }
  assert (HL : Mem.load Mint64 m b 16 = Some (Vlong Int64.zero)).
  { exact (Mem.load_store_same _ _ _ _ _ _ HI). }
  assert (VM8 : Mem.valid_access m Mint64 b 8 Writable).
  { eapply Mem.store_valid_access_1; [exact HI|]. eapply Mem.store_valid_access_1; [exact HC|exact VP8]. }
  assert (VM16 : Mem.valid_access m Mint64 b 16 Writable).
  { eapply Mem.store_valid_access_1; [exact HI|exact VC16]. }
  destruct (Mem.valid_access_store _ _ _ _ (Vlong (Int64.repr 63)) VM8) as [mo SO].
  assert (VO16 : Mem.valid_access mo Mint64 b 16 Writable).
  { eapply Mem.store_valid_access_1; [exact SO|exact VM16]. }
  destruct (Mem.valid_access_store _ _ _ _
    (Vlong (write_bit_value 64 Int64.zero Datatypes.true)) VO16) as [mf SW].
  assert (HCall : Clight2.eval_funcall ge0 m (Internal f_writeBit)
    [Vptr b Ptrofs.zero; Vint Int.one] E0 mf (Vint Int.one)).
  { apply (eval_writeBit_layout_ranges m mo mf b 0 b 16 64 Int64.zero Datatypes.true).
    - unfold frame_base_valid. change (0 <= 0 /\ 16 <= 18446744073709551615). lia.
    - change (1 <= 64 <= 18446744073709551615). lia.
    - lia.
    - change (24 <= 18446744073709551615). lia.
    - split; [exact HE|exact HO].
    - exact HL.
    - exact SO.
    - exact SW.
    - right; right. change (16 <= 16). lia. }
  assert (HF : frame_fields_at mf b 0 b 16 63).
  { split.
    - rewrite (Mem.load_store_other _ _ _ _ _ _ SW Mptr b 0) by (right; left; change (8 <= 16); lia).
      rewrite (Mem.load_store_other _ _ _ _ _ _ SO Mptr b 0) by (right; left; change (8 <= 8); lia). exact HE.
    - change (Mem.load Mint64 mf b 8 = Some (Vlong (Int64.repr 63))).
      rewrite (Mem.load_store_other _ _ _ _ _ _ SW Mint64 b 8) by (right; left; change (16 <= 16); lia).
      exact (Mem.load_store_same _ _ _ _ _ _ SO). }
  assert (HW : Mem.load Mint64 mf b 16 = Some (Vlong (Int64.repr 9223372036854775808))).
  { pose proof (Mem.load_store_same _ _ _ _ _ _ SW) as H.
    change (Mem.load Mint64 mf b 16 = Some (Vlong (write_bit_value 64 Int64.zero Datatypes.true))) in H.
    replace (write_bit_value 64 Int64.zero Datatypes.true) with (Int64.repr 9223372036854775808) in H
      by (vm_compute; reflexivity). exact H. }
  exists m, mf, b. split; [split; [exact HE|exact HO]|].
  split; [exact VM8|]. split; [exact VM16|]. split.
  - intro H. destruct H as (_ & _ & _ & _ & _ & Hne & _). apply Hne; reflexivity.
  - split; [exact HCall|]. split; [exact HF|exact HW].
Qed.
Print Assumptions eval_writeBit_layout_ranges.
Print Assumptions embedded_frame_writeBit_exists.
