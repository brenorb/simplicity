+repo = Path(sys.argv[1]).resolve()
+coq = repo / 'Coq'
+hs = repo / 'Haskell/Elements/Simplicity/Elements/Primitive.hs'
+catalog = repo / 'Haskell/Simplicity/Elements/Jets.hs'
