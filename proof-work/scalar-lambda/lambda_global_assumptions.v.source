From Coq Require Import String.
Require LambdaC.jet_secp_scalar_lambda_global LambdaC.jet_secp_scalar_lambda_region.
Local Open Scope string_scope.
Set Printing Width 120.
Set Printing Depth 100000.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_symbol".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_symbol.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_info".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_info.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words_value".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words_value.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words_count".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words_count.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_genv_projection".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_genv_projection.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_initializes".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_initializes.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_readonly_initial".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_readonly_initial.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_unchanged".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_unchanged.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_mixed_input".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_mixed_input.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_mixed_rhs".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_mixed_rhs.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_borrowed_region".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_borrowed_region.
Goal True.
  idtac "JET_ASSUMPTIONS LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_global_allocated".
  exact I.
Qed.
Print Assumptions LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_global_allocated.
