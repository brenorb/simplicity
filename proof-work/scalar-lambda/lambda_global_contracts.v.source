From Coq Require Import String.
Require LambdaC.jet_secp_scalar_lambda_global LambdaC.jet_secp_scalar_lambda_region.
Local Open Scope string_scope.
Set Printing Width 120.
Set Printing Depth 100000.
Goal True.
  idtac "LAMBDA_GLOBAL_TYPE LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_symbol".
  exact I.
Qed.
Check LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_symbol.
Goal True.
  idtac "LAMBDA_GLOBAL_TYPE LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_info".
  exact I.
Qed.
Check LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_global_info.
Goal True.
  idtac "LAMBDA_GLOBAL_TYPE LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words_value".
  exact I.
Qed.
Check LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words_value.
Goal True.
  idtac "LAMBDA_GLOBAL_TYPE LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words_count".
  exact I.
Qed.
Check LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words_count.
Goal True.
  idtac "LAMBDA_GLOBAL_TYPE LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_genv_projection".
