Qed.
Check LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_mixed_rhs.
Goal True.
  idtac "LAMBDA_GLOBAL_TYPE LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_borrowed_region".
  exact I.
Qed.
Check LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_borrowed_region.
Goal True.
  idtac "LAMBDA_GLOBAL_TYPE LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_global_allocated".
  exact I.
Qed.
Check LambdaC.jet_secp_scalar_lambda_region.scalar_lambda_global_allocated.
Goal True.
  idtac "LAMBDA_GLOBAL_DEF LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words".
  exact I.
Qed.
Print LambdaC.jet_secp_scalar_lambda_global.scalar_lambda_words.
Goal True.
  idtac "LAMBDA_GLOBAL_DEF LambdaC.jet_secp_scalar_lambda_global.canonical_lambda_value".
