From Coq Require Import String.
Require LamSpecC.jet_secp_canonical_scalar_lambda.
Local Open Scope string_scope.
Set Printing Width 120.
Set Printing Depth 100000.
Goal True.
  idtac "JET_ASSUMPTIONS LamSpecC.jet_secp_canonical_scalar_lambda.canonical_lambda_value_range".
  exact I.
Qed.
Print Assumptions LamSpecC.jet_secp_canonical_scalar_lambda.canonical_lambda_value_range.
Goal True.
  idtac "JET_ASSUMPTIONS LamSpecC.jet_secp_canonical_scalar_lambda.canonical_lambda_word_value".
  exact I.
Qed.
Print Assumptions LamSpecC.jet_secp_canonical_scalar_lambda.canonical_lambda_word_value.
Goal True.
  idtac "JET_ASSUMPTIONS LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_lambda_parametric".
  exact I.
Qed.
Print Assumptions LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_lambda_parametric.
Goal True.
  idtac "JET_ASSUMPTIONS LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_multiply_lambda_parametric".
  exact I.
Qed.
Print Assumptions LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_multiply_lambda_parametric.
Goal True.
  idtac "JET_ASSUMPTIONS LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_multiply_lambda_step".
  exact I.
Qed.
Print Assumptions LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_multiply_lambda_step.
Goal True.
  idtac "JET_ASSUMPTIONS LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_multiply_lambda_numeric".
  exact I.
Qed.
Print Assumptions LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_multiply_lambda_numeric.
Goal True.
  idtac "JET_ASSUMPTIONS LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_lambda_normalized_value".
  exact I.
Qed.
Print Assumptions LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_lambda_normalized_value.
Goal True.
  idtac "JET_ASSUMPTIONS LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_multiply_lambda_c_order".
  exact I.
Qed.
Print Assumptions LamSpecC.jet_secp_canonical_scalar_lambda.canonical_scalar_multiply_lambda_c_order.
