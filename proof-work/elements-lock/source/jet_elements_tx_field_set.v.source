      _tx (tptr (Tstruct _elementsTransaction noattr))).

Lemma exec_elements_env_tx_set tmp e le m be ebase bt tbase :
  le!_env = Some (Vptr be (Ptrofs.repr ebase)) ->
  0 <= ebase -> ebase + 8 <= Ptrofs.max_unsigned ->
  Mem.load Mptr m be ebase = Some (Vptr bt (Ptrofs.repr tbase)) ->
  Clight2.exec_stmt elements_ge e le m (elements_env_tx_set tmp) E0
    (PTree.set tmp (Vptr bt (Ptrofs.repr tbase)) le) m Out_normal.
Proof.
  intros HE H0 HM HL. unfold elements_env_tx_set. apply exec_set.
  eapply eval_elements_field_value with (sid := _txEnv) (delta := 0) (chunk := Mptr).
  - reflexivity.
  - exact elements_txEnv_tx.
  - reflexivity.
  - apply eval_elements_deref_struct; exact HE.
  - rewrite elements_ptr_add_repr by lia. apply elements_loadv_repr; [lia|].
    replace (ebase + 0) with ebase by lia. exact HL.
Qed.

Lemma exec_elements_tx_field_set ptr tmp field delta e le m bt tbase (x : int64) :
  elements_field_at _elementsTransaction field delta -> 0 <= delta <= 752 ->
