                                          (list Integers.Byte.int) d rest)))
                             (_ : jet_elements_null_data_parse.null_data_parse rest ds),
                           jet_elements_null_data_parse.null_data_parse bs
                             (@cons (jet_elements_prim.txNullDatumF (list Integers.Byte.int)) d ds).

