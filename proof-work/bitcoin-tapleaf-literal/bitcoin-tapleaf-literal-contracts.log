TAP_DEF C.jet_bitcoin_tapleaf_literal.tapleaf_hash_program
jet_bitcoin_tapleaf_literal.tapleaf_hash_program =
fun (prefix : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (leaf_size : Ty.tySem (Word.Word (S (S (S O)))))
  (alg : jet_bitcoin_full_prim.PF.Algebra) =>
let term : Alg.Assertion.Algebra := jet_bitcoin_full_prim.PF.CanonicalStructures.toAssertion alg in
let core : Alg.Core.Algebra := Alg.Assertion.toCore term in
@jet_buffer_empty_spec.AC.comp Ty.Unit
  (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
  (@jet_buffer_empty_spec.AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
     (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_buffer_empty_spec.AC.comp Ty.Unit
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))))) jet_sha256_ctx8_init_spec.sha256_ctx8_type
        core
        (@jet_buffer_empty_spec.AC.pair Ty.Unit jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S O))))) core
           (@jet_bitcoin_tapleaf_hash_spec.ctx8_init_tag_spec prefix core)
           (@jet_buffer_empty_spec.AC.pair Ty.Unit (Word.Word (S (S (S O)))) (Word.Word (S (S (S O)))) core
              (@jet_bitcoin_full_prim.PF.Combinators.prim Ty.Unit (Word.Word (S (S (S O)))) alg
                 (@jet_bitcoin_full_prim.BitcoinFull.Ext Ty.Unit (Word.Word (S (S (S O))))
                    jet_bitcoin_ext_prim.BitcoinExt.TapleafVersion))
              (@Alg.scribe Ty.Unit (Word.Word (S (S (S O)))) leaf_size core)))
        (@jet_sha_ctx8_spec.ctx8_addn_spec (S O) term))
     (@jet_bitcoin_full_prim.PF.Combinators.prim Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O))))))))) alg
        (@jet_bitcoin_full_prim.BitcoinFull.Base Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
           Bitcoin.Bitcoin.ScriptCMR)))
  (@jet_buffer_empty_spec.AC.comp
     (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Vector (Word.Word (S (S (S O)))) (S (S (S (S (S O)))))))
     jet_sha256_ctx8_init_spec.sha256_ctx8_type (Word.Word (S (S (S (S (S (S (S (S O))))))))) core
     (@jet_sha_ctx8_spec.ctx8_addn_spec (S (S (S (S (S O))))) term) (@jet_sha_finalize_spec.ctx8_finalize_spec term))
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : Ty.tySem (Word.Word (S (S (S O)))))
         (alg : jet_bitcoin_full_prim.PF.Algebra),
       jet_bitcoin_full_prim.PF.domain alg Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))

Arguments jet_bitcoin_tapleaf_literal.tapleaf_hash_program prefix leaf_size {alg}
