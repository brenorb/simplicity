jet_bitcoin_tapleaf_literal.tapleaf_ascii =
@List.map BinNums.Z Integers.Byte.int Integers.Byte.repr
  (@cons BinNums.Z
     (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
     (@cons BinNums.Z
        (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
        (@cons BinNums.Z
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI BinNums.xH)))))))
           (@cons BinNums.Z
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
              (@cons BinNums.Z
                 (BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                 (@cons BinNums.Z
                    (BinNums.Zpos
                       (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                    (@cons BinNums.Z
                       (BinNums.Zpos
                          (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))
                       (@nil BinNums.Z))))))))
