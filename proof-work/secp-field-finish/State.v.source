(** The actual remaining original multiplier body, including both last stores. *)
From Coq Require Import ZArith List.
From compcert Require Import Integers AST Ctypes Clight Clightdefs Maps Values.
Require Import C.jet_sx_expr C.jet_sx_state C.jet_sx_eval C.jet_sx_exec C.jet_sx_mem C.jet_sx_rep.
Require Import C.jet_secp_linkage C.jets_secp C.jet_secp_statement_prefix.
Require Import FieldRun.Run FieldCheckpoint.Prefix FieldCheckpoint.Ops FieldSecond.Entry.
Require Import FieldNext.Checkpoint FieldFifth.State.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.

Definition finish_statement := after_fifth.
Lemma original_body_source : statement_sequence (firstn 97 mul_spine) finish_statement = fn_body f_secp256k1_fe_mul_inner.
Proof. exact through_fifth_suffix_source. Qed.
Definition finish_run digits written c d t3 t4 := xstmt (genv_cenv secp_ge) [] field_table 160
  (snd mul_allocated) (checkpoint_state digits written c d t3 t4) finish_statement.
Lemma finish_completes digits written c d t3 t4 :
  match finish_run digits written c d t3 t4 with Some (RDone _ ONormal) => true | _ => false end = true.
Proof. vm_compute; reflexivity. Qed.
Definition finish_state digits written c d t3 t4 := match finish_run digits written c d t3 t4 with
  | Some (RDone st _) => st | _ => checkpoint_state digits written c d t3 t4 end.
Lemma finish_run_eq digits written c d t3 t4 :
  finish_run digits written c d t3 t4 = Some (RDone (finish_state digits written c d t3 t4) ONormal).
Proof.
  pose proof (finish_completes digits written c d t3 t4) as H; unfold finish_state.
  destruct (finish_run digits written c d t3 t4) as [r|]; [|discriminate].
  destruct r; [destruct o; try discriminate; reflexivity|discriminate].
Qed.

Definition finish_base_c_sy (c d : int64 * int64) := sx_accum (XL (fst c), XL (snd c))
  (XLsh Hshl (XLc (Int64.repr 68719492368)) 12) (XL (fst d)).
Definition finish_fold_c_sy c d t3 := sx_accum_word (finish_base_c_sy c d) (XL t3).
Definition finish_final_c_sy c d t3 := sx_shift52 (finish_fold_c_sy c d t3).
Definition finish_r3_sy c d t3 := XLb Band (fst (finish_fold_c_sy c d t3)) (XLc (Int64.repr 4503599627370495)).
Definition finish_r4_sy c d t3 t4 := XLb Badd (fst (finish_final_c_sy c d t3)) (XL t4).

Lemma finish_regions_exact digits written c d t3 t4 : sregs (finish_state digits written c d t3 t4) =
  [mkreg (u64_cells 0 [XL (written 0%nat); XL (written 1%nat); XL (written 2%nat); finish_r3_sy c d t3; finish_r4_sy c d t3 t4]) true (Some 40);
   mkreg (u64_cells 0 [XL (digits 5%nat); XL (digits 6%nat); XL (digits 7%nat); XL (digits 8%nat); XL (digits 9%nat)]) true (Some 40);
   mkreg (u64_cells 0 [fst (finish_final_c_sy c d t3); snd (finish_final_c_sy c d t3)]) true (Some 16);
   mkreg (u64_cells 0 [XL (fst d); XL (snd d)]) true (Some 16)].
Proof. reflexivity. Qed.
Lemma finish_live_lookup digits written c d t3 t4 id x :
  In (id,x) (checkpoint_bindings digits t3 t4) -> (stemps (finish_state digits written c d t3 t4))!id = Some x.
Proof.
  intro H; cbn [checkpoint_bindings second_bindings app In] in H.
  repeat destruct H as [H|H]; try contradiction; inversion H; subst; timeout 10 reflexivity.
Qed.
