TAP_TYPE SquareRun.Run.square_completes
Run.square_completes
     : @eq bool
         match Run.square_run return bool with
         | Some r =>
             match r return bool with
             | jet_sx_exec.RDone _ o =>
                 match o return bool with
                 | jet_sx_exec.ONormal => true
                 | jet_sx_exec.OBreak => false
                 | jet_sx_exec.OContinue => false
                 | jet_sx_exec.OReturn _ => false
                 end
             | jet_sx_exec.RIf _ _ _ => false
             end
         | None => false
         end true
TAP_TYPE SquareRun.Run.square_run_eq
Run.square_run_eq
     : @eq (option jet_sx_exec.res) Run.square_run
         (@Some jet_sx_exec.res (jet_sx_exec.RDone Run.square_state jet_sx_exec.ONormal))
TAP_TYPE SquareRun.Run.square_return
Run.square_return
     : @eq (option jet_sx_expr.sx) (@Maps.PTree.get jet_sx_expr.sx BinNums.xH (jet_sx_eval.stemps Run.square_state))
         (@None jet_sx_expr.sx)
TAP_TYPE SquareRun.Run.square_regions_count
Run.square_regions_count
