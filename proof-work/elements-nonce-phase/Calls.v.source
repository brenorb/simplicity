(** Actual nonce-branch calls derived from represented frame/context states. *)
From Coq Require Import ZArith List Lia.
From compcert Require Import Integers AST Ctypes Cop Clight ClightBigstep Maps Values Memory Events Globalenvs.
Require Import Simplicity.Ty Simplicity.Word.
Require Import C.jet_exec C.jet_memcpy_model C.jet_frame_layout C.jet_input_layout.
Require Import C.jet_readBit_layout C.jet_forwardBits_layout C.jet_read8s_layout.
Require Import C.jet_sha_linkage C.jet_sha_transport C.jet_sha_block_local C.jet_sha_ctx_abs.
Require Import C.jet_sha_ctx8_model C.jet_sha_uchars_exec C.jet_sha_add_n_init C.jet_elements_sha_program.
Require Import C.jets_elements C.jet_elements_linkage.
Require Import NonceContext.Shape NonceExec.Effects.
Import Mem Values Ctypes ListNotations Clightdefs.
Local Open Scope Z_scope.
Local Opaque elements_ge sha_ge ge0.
Set Default Timeout 10.

Lemma nonce_local_frame_base : frame_base_valid 0.
Proof. split; [lia|change (16 <= 18446744073709551615 + 1); lia]. Qed.

Lemma nonce_readbit_link :
  Genv.find_symbol (Clight.genv_genv elements_ge) _readBit = Some (elements_symbol_block _readBit) /\
  Genv.find_funct (Clight.genv_genv elements_ge) (Vptr (elements_symbol_block _readBit) Ptrofs.zero) =
    Some (Internal f_readBit).
Proof. split; vm_compute; reflexivity. Qed.

Lemma nonce_forward_link :
  Genv.find_symbol (Clight.genv_genv elements_ge) _forwardBits = Some (elements_symbol_block _forwardBits) /\
  Genv.find_funct (Clight.genv_genv elements_ge) (Vptr (elements_symbol_block _forwardBits) Ptrofs.zero) =
    Some (Internal f_forwardBits).
Proof. split; vm_compute; reflexivity. Qed.

Lemma nonce_uchar_link :
  Genv.find_symbol (Clight.genv_genv elements_ge) _sha256_uchar = Some (elements_symbol_block _sha256_uchar) /\
  Genv.find_funct (Clight.genv_genv elements_ge) (Vptr (elements_symbol_block _sha256_uchar) Ptrofs.zero) =
    Some (Internal f_sha256_uchar).
Proof. split; vm_compute; reflexivity. Qed.

Lemma nonce_bit_bool m bit : Cop.bool_val (Vint (bit_int bit)) tbool m = Some bit.
Proof. destruct bit; reflexivity. Qed.

Theorem nonce_read_bit e le m bl bi edge rc bit id :
  e!_src = Some (bl, nc_fr) -> e!_readBit = None ->
  0 <= rc <= Int64.max_unsigned - 1 ->
  frame_fields_at m bl 0 bi edge rc -> frame_input_bit_at m bi edge rc bit ->
  Mem.valid_access m Mint64 bl 8 Writable ->
  exists mf,
    Clight2.exec_stmt elements_ge e le m (nc_readbit id) E0
      (PTree.set id (Vint (bit_int bit)) le) mf Out_normal /\
    frame_fields_at mf bl 0 bi edge (rc + 1) /\ nonce_effects m mf [bl].
Proof.
  intros HL HNone HR HF HI PW.
  destruct (eval_readBit_layout m bl 0 bi edge rc bit nonce_local_frame_base HR HF HI PW)
    as (mf & HC & HFields & HLoads & HPerm & HValid).
  assert (HCall : Clight2.eval_funcall elements_ge m (Internal f_readBit)
    [Vptr bl Ptrofs.zero] E0 mf (Vint (bit_int bit))).
  { rewrite <- elements_sha_genv. eapply sha_transport_call; [|exact HC].
    unfold sha_core_helpers. simpl. tauto. }
  exists mf. split.
  - destruct nonce_readbit_link as [HS HFun]. unfold nc_readbit.
    change (PTree.set id (Vint (bit_int bit)) le) with (set_opttemp (Some id) (Vint (bit_int bit)) le).
    eapply exec_Scall with (vf := Vptr (elements_symbol_block _readBit) Ptrofs.zero)
      (f := Internal f_readBit) (vargs := [Vptr bl Ptrofs.zero]) (vres := Vint (bit_int bit)).
    + reflexivity.
    + eapply eval_Elvalue; [apply eval_Evar_global; [exact HNone|exact HS]|apply deref_loc_reference; reflexivity].
    + eapply eval_Econs; [apply eval_Eaddrof, eval_Evar_local; exact HL|reflexivity|apply eval_Enil].
    + exact HFun.
    + reflexivity.
    + exact HCall.
  - split; [exact HFields|]. constructor; [|exact HPerm|exact HValid].
    intros ch b ofs V N. apply HLoads. left. intro E; subst b. apply N. left; reflexivity.
Qed.

Theorem nonce_forward_one e le m bl bi edge rc :
  e!_src = Some (bl, nc_fr) -> e!_forwardBits = None ->
  0 <= rc -> rc + 1 <= Int64.max_unsigned ->
  frame_fields_at m bl 0 bi edge rc -> Mem.valid_access m Mint64 bl 8 Writable ->
  exists mf,
    Clight2.exec_stmt elements_ge e le m nc_forward E0 le mf Out_normal /\
    frame_fields_at mf bl 0 bi edge (rc + 1) /\ nonce_effects m mf [bl].
Proof.
  intros HL HNone H0 HM HF PW.
  destruct (eval_forwardBits_layout m bl 0 bi edge rc 1 nonce_local_frame_base H0 ltac:(lia) HM HF PW)
    as (mf & HC & HFields & HLoads & HPerm & HValid).
  assert (HCall : Clight2.eval_funcall elements_ge m (Internal f_forwardBits)
    [Vptr bl Ptrofs.zero; Vlong (Int64.repr 1)] E0 mf Vundef).
  { rewrite <- elements_sha_genv. eapply sha_transport_call; [|exact HC].
    unfold sha_core_helpers. simpl. tauto. }
  exists mf. split.
  - destruct nonce_forward_link as [HS HFun]. unfold nc_forward.
    change le with (set_opttemp None Vundef le) at 2.
    eapply exec_Scall with (vf := Vptr (elements_symbol_block _forwardBits) Ptrofs.zero)
      (f := Internal f_forwardBits) (vargs := [Vptr bl Ptrofs.zero; Vlong (Int64.repr 1)]) (vres := Vundef).
    + reflexivity.
    + eapply eval_Elvalue; [apply eval_Evar_global; [exact HNone|exact HS]|apply deref_loc_reference; reflexivity].
    + eapply eval_Econs; [apply eval_Eaddrof, eval_Evar_local; exact HL|reflexivity|].
      eapply eval_Econs; [apply eval_Econst_int|reflexivity|apply eval_Enil].
    + exact HFun.
    + reflexivity.
    + exact HCall.
  - split; [exact HFields|]. constructor; [|exact HPerm|exact HValid].
    intros ch b ofs V N. apply HLoads. left. intro E; subst b. apply N. left; reflexivity.
Qed.

Theorem nonce_add_byte (Hmodel : memcpy_model) e le m bx bm l regs c ovf (x : Ty.tySem Word8) z :
  e!_ctx = Some (bx, CTX) -> e!_sha256_uchar = None ->
  bm <> bx -> GC <> bx -> GC <> bm -> GM <> bx -> GM <> bm ->
  word8_array_value x = Int.repr z -> ctx_abs m bx bm l regs c ovf ->
  exists mf,
    Clight2.exec_stmt elements_ge e le m (nc_uchar z) E0 le mf Out_normal /\
    ctx_abs mf bx bm (fst (absorb l regs [x])) (snd (absorb l regs [x]))
      (Int64.add c (Int64.repr 1)) (uc_overflow ovf c (Int64.repr 1)) /\
    nonce_effects m mf [bx; bm].
Proof.
  intros HX HNone Hmx Hgx Hgm Hcx Hcm HByte HC.
  destruct (ctx_abs_uchar bx bm Hmx Hgx Hgm Hcx Hcm Hmodel m l regs x c ovf HC)
    as (mf & HCall & HCtx & HLoads & HPerm & HValid).
  exists mf. split.
  - destruct nonce_uchar_link as [HS HFun]. unfold nc_uchar.
    change le with (set_opttemp None (Vint (bit_int (negb (uc_overflow ovf c (Int64.repr 1))))) le) at 2.
    eapply exec_Scall with (vf := Vptr (elements_symbol_block _sha256_uchar) Ptrofs.zero)
      (f := Internal f_sha256_uchar) (vargs := [Vptr bx Ptrofs.zero; Vint (word8_array_value x)])
      (vres := Vint (bit_int (negb (uc_overflow ovf c (Int64.repr 1))))).
    + reflexivity.
    + eapply eval_Elvalue; [apply eval_Evar_global; [exact HNone|exact HS]|apply deref_loc_reference; reflexivity].
    + eapply eval_Econs; [apply eval_Eaddrof, eval_Evar_local; exact HX|reflexivity|].
      eapply eval_Econs; [apply eval_Econst_int| |apply eval_Enil].
      change (Some (Vint (Int.zero_ext 8 (Int.repr z))) = Some (Vint (word8_array_value x))).
      rewrite <- HByte, word8_array_value_zero_ext. reflexivity.
    + exact HFun.
    + reflexivity.
    + rewrite <- elements_sha_genv. exact HCall.
  - split; [exact HCtx|]. constructor.
    + intros ch b ofs V N. apply HLoads; [exact V| |]; intro E; subst b; apply N; cbn; tauto.
    + intros b ofs k p HP. apply HPerm; [eapply Mem.perm_valid_block; exact HP|exact HP].
    + exact HValid.
Qed.
