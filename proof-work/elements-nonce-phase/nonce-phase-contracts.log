                Memtype.Writable)
         (_ : Memory.Mem.range_perm m bb BinNums.Z0
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) Memtype.Cur
                Memtype.Writable)
         (_ : jet_encoding.frame_input_cells_at m bi edge rc (@Translate.encode Spec.nonce_value_type a))
         (_ : jet_sha_ctx_abs.ctx_abs m bx bm l regs c ovf),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge (Shape.nc_env bl bm bb bx) le m
               Shape.nc_nonce Events.E0 (Phase.nonce_phase_temps a le) mf ClightBigstep.Out_normal)
            (and
               (jet_frame_layout.frame_fields_at mf bl BinNums.Z0 bi edge
                  (BinInt.Z.add rc (Phase.nonce_phase_read_bits a)))
               (and
                  (jet_sha_ctx_abs.ctx_abs mf bx bm
                     (@fst (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                        (jet_sha_ctx8_model.absorb l regs (Spec.nonce_hash_bytes a)))
                     (@snd (list (Ty.tySem (Word.Word (S (S (S O)))))) (list Integers.Int.int)
                        (jet_sha_ctx8_model.absorb l regs (Spec.nonce_hash_bytes a)))
                     (Integers.Int64.add c (Integers.Int64.repr (Phase.nonce_phase_count a)))
                     (Phase.nonce_phase_overflow ovf c a))
                  (Effects.nonce_effects m mf
                     (@cons Values.block bl
                        (@cons Values.block bb (@cons Values.block bx (@cons Values.block bm (@nil Values.block)))))))))
TAP_DEF NonceExec.Effects.nonce_effects
Variant nonce_effects (m mf : Memory.Mem.mem) (changed : list Values.block) : Prop :=
    Build_nonce_effects : forall
                            (_ : forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                                   (_ : Memory.Mem.valid_block m b) (_ : not (@List.In Values.block b changed)),
                                 @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))
                            (_ : forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind)
                                   (p : Memtype.permission) (_ : Memory.Mem.perm m b ofs k p),
                                 Memory.Mem.perm mf b ofs k p)
                            (_ : forall (b : Values.block) (_ : Memory.Mem.valid_block m b),
                                 Memory.Mem.valid_block mf b), Effects.nonce_effects m mf changed.

Arguments Effects.nonce_effects m mf changed%list_scope
Arguments Effects.Build_nonce_effects m mf changed%list_scope (nonce_loads nonce_perms nonce_valid)%function_scope
TAP_DEF NonceExec.Phase.nonce_present_temps
Phase.nonce_present_temps =
fun (p : Ty.tySem Spec.nonce_conf_type) (le : Clight.temp_env) =>
match p return (Maps.PTree.tree Values.val) with
| inl t =>
    match t return (Maps.PTree.tree Values.val) with
    | pair odd _ =>
        @Maps.PTree.set Values.val jets_elements._t'2
          (Values.Vint (jet_readBit_layout.bit_int match odd return bool with
                                                   | inl _ => false
                                                   | inr _ => true
                                                   end))
          (@Maps.PTree.set Values.val jets_elements._t'3 (Values.Vint Integers.Int.zero) le)
    end
| inr _ => @Maps.PTree.set Values.val jets_elements._t'3 (Values.Vint Integers.Int.one) le
end
     : forall (_ : Ty.tySem Spec.nonce_conf_type) (_ : Clight.temp_env), Maps.PTree.tree Values.val

Arguments Phase.nonce_present_temps p le
TAP_DEF NonceExec.Phase.nonce_phase_temps
Phase.nonce_phase_temps =
fun (a : Ty.tySem Spec.nonce_value_type) (le : Clight.temp_env) =>
match a return (Maps.PTree.tree Values.val) with
| inl _ => @Maps.PTree.set Values.val jets_elements._t'4 (Values.Vint Integers.Int.zero) le
| inr p =>
    Phase.nonce_present_temps p (@Maps.PTree.set Values.val jets_elements._t'4 (Values.Vint Integers.Int.one) le)
end
     : forall (_ : Ty.tySem Spec.nonce_value_type) (_ : Clight.temp_env), Maps.PTree.tree Values.val

Arguments Phase.nonce_phase_temps a le
TAP_DEF NonceExec.Phase.nonce_phase_count
Phase.nonce_phase_count =
fun a : Ty.tySem Spec.nonce_value_type =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos BinNums.xH
| inr _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
end
     : forall _ : Ty.tySem Spec.nonce_value_type, BinNums.Z

Arguments Phase.nonce_phase_count a
TAP_DEF NonceExec.Phase.nonce_phase_read_bits
Phase.nonce_phase_read_bits =
fun a : Ty.tySem Spec.nonce_value_type =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos BinNums.xH
| inr _ =>
    BinNums.Zpos
      (BinNums.xI (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
end
     : forall _ : Ty.tySem Spec.nonce_value_type, BinNums.Z

Arguments Phase.nonce_phase_read_bits a
TAP_DEF NonceExec.Phase.nonce_phase_overflow
Phase.nonce_phase_overflow =
fun (ovf : bool) (c : Integers.Int64.int) (a : Ty.tySem Spec.nonce_value_type) =>
match a return bool with
| inl _ => jet_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH))
| inr _ =>
    jet_sha_uchars_exec.uc_overflow
      (jet_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
      (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
      (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
end
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Ty.tySem Spec.nonce_value_type), bool

Arguments Phase.nonce_phase_overflow ovf%bool_scope c a
