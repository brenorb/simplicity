(** Startup permissions that survive actual Clight2 calls, not just stores. *)
From Coq Require Import ZArith List Lia.
From compcert Require Import Integers AST Ctypes Clight ClightBigstep Memory Globalenvs Events.
Require Import C.jets_sha C.jet_sha_linkage C.jet_sha_block_local.
Require Import C.jet_sha_uchars_exec C.jet_sha_add_n_exec.
Require Import C.jet_frame_layout C.jet_write_layout C.jet_output_layout.
Require Import JetStartupReview.jet_sha_initial_globals JetStartupReview.jet_sha_global_frame.
Require Import JetStartupReview.jet_clight_forward.
Import Values Mem ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.

Definition sha_persistent_global_state (m : mem) : Prop :=
  sha_globals_ok m /\
  (forall ofs, ~ Mem.perm m (sha_symbol_block _sha256_max_counter) ofs Max Writable) /\
  (forall ofs p, Mem.perm m (sha_symbol_block _simplicity_sha256_compression) ofs Max p ->
    0 <= ofs < 8).

Theorem sha_persistent_globals_initialized m :
  Genv.init_mem jets_sha.prog = Some m -> sha_persistent_global_state m.
Proof.
  intro HInit.
  pose proof (sha_original_global_state_initialized m HInit) as [HGlobals [_ HBounds]].
  split; [exact HGlobals|]; split.
  - intros ofs HP.
    destruct (Genv.init_mem_characterization jets_sha.prog
      (sha_symbol_block _sha256_max_counter) sha_counter_var_info HInit)
      as [_ [HOnly _]].
    destruct (HOnly ofs Max Writable HP) as [_ HOrder].
    change (perm_order Readable Writable) in HOrder; inversion HOrder.
  - intros; eapply HBounds; eassumption.
Qed.

Lemma sha_persistent_globals_original m :
  sha_persistent_global_state m -> sha_original_global_state m.
Proof.
  intros [HGlobals [HNoWrite HBounds]]; split; [exact HGlobals|]; split.
  - intros ofs HP; apply (HNoWrite ofs); apply Mem.perm_cur_max; exact HP.
  - intros ofs k p HP; apply (HBounds ofs p); eapply Mem.perm_max; exact HP.
Qed.

Theorem sha_persistent_globals_forward m mf :
  sha_persistent_global_state m -> mem_forward m mf ->
  sha_globals_ok mf -> sha_persistent_global_state mf.
Proof.
  intros [[HD HC] [HNoWrite HBounds]] HForward HFinal.
  assert (HVD : Mem.valid_block m (sha_symbol_block _simplicity_sha256_compression)).
  { eapply Mem.perm_valid_block with (ofs := 0) (k := Cur) (p := Readable).
    eapply (Mem.valid_access_perm m Mptr _ 0 Cur Readable).
    eapply Mem.load_valid_access; exact HD. }
  assert (HVC : Mem.valid_block m (sha_symbol_block _sha256_max_counter)).
  { eapply Mem.perm_valid_block with (ofs := 0) (k := Cur) (p := Readable).
    eapply (Mem.valid_access_perm m Mint64 _ 0 Cur Readable).
    eapply Mem.load_valid_access; exact HC. }
  split; [exact HFinal|]; split.
  - intros ofs HP; apply (HNoWrite ofs).
    exact (proj2 (HForward _ HVC) ofs Writable HP).
  - intros ofs p HP; apply (HBounds ofs p).
    exact (proj2 (HForward _ HVD) ofs p HP).
Qed.

Theorem sha_persistent_globals_alloc m mf lo hi fresh :
  sha_persistent_global_state m -> Mem.alloc m lo hi = (mf, fresh) ->
  sha_persistent_global_state mf /\
  fresh <> sha_symbol_block _simplicity_sha256_compression /\
  fresh <> sha_symbol_block _sha256_max_counter.
Proof.
  intros HState HA.
  destruct (sha_original_global_state_alloc m mf lo hi fresh
    (sha_persistent_globals_original m HState) HA) as [HOld HFresh].
  split; [|exact HFresh].
  eapply sha_persistent_globals_forward; [exact HState| |exact (proj1 HOld)].
  eapply alloc_forward; exact HA.
Qed.

Theorem sha_persistent_globals_store m mf chunk b ofs value :
  sha_persistent_global_state m ->
  b <> sha_symbol_block _simplicity_sha256_compression ->
  Mem.store chunk m b ofs value = Some mf -> sha_persistent_global_state mf.
Proof.
  intros HState HOther HS.
  pose proof (sha_original_global_state_store m mf chunk b ofs value
    (sha_persistent_globals_original m HState) HOther HS) as HOld.
  eapply sha_persistent_globals_forward; [exact HState| |exact (proj1 HOld)].
  eapply store_forward; exact HS.
Qed.

Theorem sha_persistent_globals_storebytes m mf b ofs bytes :
  sha_persistent_global_state m ->
  b <> sha_symbol_block _simplicity_sha256_compression ->
  0 < Z.of_nat (length bytes) ->
  Mem.storebytes m b ofs bytes = Some mf -> sha_persistent_global_state mf.
Proof.
  intros HState HOther HLength HS.
  pose proof (sha_original_global_state_storebytes m mf b ofs bytes
    (sha_persistent_globals_original m HState) HOther HLength HS) as HOld.
  eapply sha_persistent_globals_forward; [exact HState| |exact (proj1 HOld)].
  eapply storebytes_forward; exact HS.
Qed.

Require Import Simplicity.Ty Simplicity.Word Simplicity.Translate.
Require Import C.jet_input_layout C.jet_encoding.
From compcert Require Import Ctypes Clight ClightBigstep Events.

(** Complete canonical block call, now also deriving globals for its successor.
    The stronger initializer invariant is now re-established after the call;
    constructing ready frames from startup remains a separate obligation. *)
Theorem sha_256_block_local_spec_persistent :
  forall env m bd dbase bs sbase bi bw edge outedge cursor read_cursor
    (a : Ty.tySem (Ty.Prod Word256 Word512)),
    sha_persistent_global_state m ->
    frame_base_valid sbase -> (8 | sbase) ->
    frame_fields_at m bs sbase bi edge read_cursor ->
    0 <= read_cursor -> read_cursor + Z.of_nat (bitSize (Ty.Prod Word256 Word512)) <= Int64.max_unsigned ->
    frame_input_cells_at m bi edge read_cursor (encode a) ->
    write_frame_at m bd dbase bw outedge cursor (Z.of_nat (bitSize Word256)) ->
    exists mf,
      Clight2.eval_funcall sha_ge m (Internal f_simplicity_sha_256_block)
        [Vptr bd (Ptrofs.repr dbase); Vptr bs (Ptrofs.repr sbase); env]
        E0 mf (Vint Int.one) /\
      frame_output_cells_at mf bw outedge cursor (encode (sha_256_block_spec a)) /\
      write_prefix_at m mf bw outedge cursor /\
      frame_fields_at mf bd dbase bw outedge (cursor - Z.of_nat (bitSize Word256)) /\
      (forall chunk b ofs, Mem.valid_block m b ->
        (b <> bd \/ ofs + size_chunk chunk <= dbase + 8 \/ dbase + 16 <= ofs) ->
        (b <> bw \/ ofs + size_chunk chunk <= outedge + 8 * ((cursor - Z.of_nat (bitSize Word256)) / 64) \/
          write_word_address outedge cursor + 8 <= ofs) ->
        Mem.load chunk mf b ofs = Mem.load chunk m b ofs) /\
      sha_persistent_global_state mf.
Proof.
  intros env m bd dbase bs sbase bi bw edge outedge cursor rc a
    HState HBase HAlign HFields HCursor HMax HInput HOutput.
  destruct (sha_256_block_local_spec_preserves_globals env m bd dbase bs sbase bi bw edge outedge cursor rc a
    (sha_persistent_globals_original m HState) HBase HAlign HFields HCursor HMax HInput HOutput)
    as [mf [HCall [HCells [HPrefix [HFinal [HLoads HGlobals]]]]]].
  exists mf; split; [exact HCall|]; split; [exact HCells|]; split; [exact HPrefix|];
    split; [exact HFinal|]; split; [exact HLoads|].
  eapply sha_persistent_globals_forward; [exact HState| |exact HGlobals].
  exact (proj2 (clight_exec_forward sha_ge) _ _ _ _ _ _ HCall).
Qed.
