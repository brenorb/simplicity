Theorem sha_ctx8_finalize_running_spec : memcpy_model ->
  sha_partial_state_spec sha_persistent_global_state f_simplicity_sha_256_ctx_8_finalize
    sha256_ctx8_type (Word 8) (fun a => @ctx8_finalize_spec optalg a).
Proof.
  intro HModel; eapply sha_partial_running_from_local.
  - change (0 < 256); lia.
  - exact (sha_256_ctx_8_finalize_local_spec HModel).
Qed.
