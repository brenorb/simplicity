Theorem sha_ctx8_finalize_ready_spec : memcpy_model ->
  sha_partial_state_spec sha_ready_memory f_simplicity_sha_256_ctx_8_finalize
    sha256_ctx8_type (Word 8) (fun a => @ctx8_finalize_spec optalg a).
Proof.
  intro HModel; eapply sha_partial_state_from_local.
  - change (0 < 256); lia.
  - exact sha_ready_memory_globals.
  - exact (sha_256_ctx_8_finalize_local_spec HModel).
Qed.
