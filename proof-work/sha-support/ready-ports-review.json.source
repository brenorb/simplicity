  "scope": "Exact typed Coq ports and inspected Haskell mkLibAssert implementation, helper recursions and catalog types. Includes count and pad constants, recursion depths, projection order, option assertions and buffer shape. Underlying hashBlock, word arithmetic, commitment identity, type/notation definitions and memory-domain review remain separate inherited dependencies.",
  "coq": [
    {
      "path": "C/jet_buffer_empty_spec.v",
      "name": "buffer_type",
      "declaration": "Fixpoint buffer_type (X : Ty.Ty) (depth : nat) : Ty.Ty :=\n  match depth with\n  | Datatypes.O => Ty.Sum Ty.Unit X\n  | Datatypes.S d => Ty.Prod (Ty.Sum Ty.Unit (Vector X (Datatypes.S d))) (buffer_type X d)\n  end."
    },
    {
      "path": "C/jet_buffer_empty_spec.v",
      "name": "buffer_empty_spec",
      "declaration": "Fixpoint buffer_empty_spec (X : Ty.Ty) (depth : nat) (A : Ty.Ty) {term : Alg.Core.Algebra} :\n    term A (buffer_type X depth) :=\n  match depth with\n  | Datatypes.O => AC.injl AC.unit\n  | Datatypes.S d => AC.pair (AC.injl AC.unit) (buffer_empty_spec X d A)\n  end."
    },
    {
      "path": "C/jet_sha256_ctx8_init_spec.v",
      "name": "sha256_ctx8_type",
      "declaration": "Definition sha256_ctx8_type := Ty.Prod (buffer_type (Word 3) 5) (Ty.Prod (Word 6) (Word 8))."
    },
    {
      "path": "C/jet_sha_ctx8_spec.v",
      "name": "buffer_snoc_spec",
      "declaration": "Fixpoint buffer_snoc_spec (X : Ty.Ty) (depth : nat) {term : Alg.Core.Algebra} :\n    @Alg.Core.domain term (Ty.Prod (buffer_type X depth) X) (Ty.Sum (Vector X (S depth)) (buffer_type X depth)) :=\n  match depth with\n  | O => AC.case (AC.injr (AC.injr (AC.drop AC.iden))) (AC.injl AC.iden)\n  | S d =>\n      AC.comp\n        (AC.pair (AC.comp (AC.pair (AC.take (AC.drop AC.iden)) (AC.drop AC.iden)) (buffer_snoc_spec X d))\n                 (AC.take (AC.take AC.iden)))\n        (AC.case\n          (AC.comp (AC.pair (AC.drop AC.iden) (AC.take AC.iden))\n            (AC.case (AC.injr (AC.pair (AC.injr (AC.drop AC.iden)) (buffer_empty_spec X d _)))\n                     (AC.injl AC.iden)))\n          (AC.injr (AC.pair (AC.drop AC.iden) (AC.take AC.iden))))\n  end."
    },
    {
      "path": "C/jet_sha_ctx8_spec.v",
      "name": "ctx8_add1_snoc",
      "declaration": "Definition ctx8_add1_snoc {term : Alg.Core.Algebra} :\n    @Alg.Core.domain term (Ty.Prod sha256_ctx8_type (Word 3)) (Ty.Prod (Ty.Sum (Word 9) ctx8_buf) ctx8_tail) :=\n  AC.pair\n    (AC.comp (AC.pair (AC.take (AC.take AC.iden)) (AC.drop AC.iden)) (buffer_snoc_spec (Word 3) 5))\n    (AC.take (AC.drop AC.iden))."
    },
    {
      "path": "C/jet_sha_ctx8_spec.v",
      "name": "ctx8_add1_full",
      "declaration": "Definition ctx8_add1_full {term : Alg.Assertion.Algebra} :\n    @Alg.Assertion.domain term (Ty.Prod (Word 9) ctx8_tail) sha256_ctx8_type :=\n  AC.pair (AC.comp AC.unit (buffer_empty_spec (Word 3) 5 Ty.Unit))\n    (AC.pair\n      (AC.drop (AC.comp (AC.take (@increment_word_spec (Alg.Assertion.toCore term) 6))\n        (@Alg.Assertion.Combinators.assertl Ty.Unit Ty.Unit (Word 6) (Word 6) term\n          (@AC.drop Ty.Unit (Word 6) (Word 6) (Alg.Assertion.toCore term) (@AC.iden (Word 6) (Alg.Assertion.toCore term)))\n          assertion_cmr_fail0)))\n      (AC.comp (AC.pair (AC.drop (AC.drop AC.iden)) (AC.take AC.iden)) Simplicity.SHA256.hashBlock))."
    },
    {
      "path": "C/jet_sha_ctx8_spec.v",
      "name": "ctx8_add1_spec",
      "declaration": "Definition ctx8_add1_spec {term : Alg.Assertion.Algebra} :\n    @Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type (Word 3)) sha256_ctx8_type :=\n  AC.comp (@ctx8_add1_snoc (Alg.Assertion.toCore term))\n    (AC.comp (@AC.case _ _ _ _ (Alg.Assertion.toCore term) (@ctx8_add1_full term) AC.iden)\n      (AC.comp (@AC.pair _ _ _ (Alg.Assertion.toCore term) (@sha256_count_assertion_spec term) AC.iden)\n        (AC.drop AC.iden)))."
    },
    {
      "path": "C/jet_sha_ctx8_spec.v",
      "name": "ctx8_addn_spec",
      "declaration": "Fixpoint ctx8_addn_spec (n : nat) {term : Alg.Assertion.Algebra} :\n    @Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type (Vector (Word 3) n)) sha256_ctx8_type :=\n  match n with\n  | O => @ctx8_add1_spec term\n  | S n =>\n      @AC.comp _ _ _ (Alg.Assertion.toCore term)\n        (@AC.pair _ _ _ (Alg.Assertion.toCore term)\n          (@AC.comp _ _ _ (Alg.Assertion.toCore term)\n            (AC.pair (AC.take AC.iden) (AC.drop (AC.take AC.iden))) (@ctx8_addn_spec n term))\n          (AC.drop (AC.drop AC.iden)))\n        (@ctx8_addn_spec n term)\n  end."
    },
    {
      "path": "C/jet_sha256_count_assertion.v",
      "name": "sha256_count_limit",
      "declaration": "Definition sha256_count_limit : Ty.tySem (Word 6) := @fromZ (WordToZ 6) 36028797018963968."
    },
    {
      "path": "C/jet_sha256_count_assertion.v",
      "name": "sha256_count_check_spec",
      "declaration": "Definition sha256_count_check_spec {term : Alg.Core.Algebra} :\n    @Alg.Core.domain term sha256_ctx8_type Bit :=\n  AC.comp (AC.pair (AC.drop (AC.take AC.iden))\n    (AC.comp AC.unit (Alg.scribe sha256_count_limit))) (@lt_word_spec term 6)."
    },
    {
      "path": "C/jet_sha256_count_assertion.v",
      "name": "sha256_count_assertion_spec",
      "declaration": "Definition sha256_count_assertion_spec {term : Alg.Assertion.Algebra} :\n    @Alg.Assertion.domain term sha256_ctx8_type Ty.Unit :=\n  AC.comp (AC.pair (@sha256_count_check_spec term) AC.unit)\n    (Alg.Assertion.Combinators.assertr assertion_cmr_fail0 (AC.take AC.iden))."
    },
    {
      "path": "C/jet_sha_add_buffer_spec.v",
      "name": "ctx8_add_buffer_spec",
      "declaration": "Fixpoint ctx8_add_buffer_spec (d : nat) {term : Alg.Assertion.Algebra} :\n    @Alg.Assertion.domain term (Ty.Prod sha256_ctx8_type (buffer_type (Word 3) d)) sha256_ctx8_type :=\n  match d with\n  | O =>\n      @AC.comp _ _ _ (Alg.Assertion.toCore term) (AC.pair (AC.drop AC.iden) (AC.take AC.iden))\n        (@AC.case _ _ _ _ (Alg.Assertion.toCore term)\n          (@AC.drop _ _ _ (Alg.Assertion.toCore term)\n            (@AC.comp _ _ _ (Alg.Assertion.toCore term)\n              (@AC.pair _ _ _ (Alg.Assertion.toCore term) AC.iden (@sha256_count_assertion_spec term))\n              (AC.take AC.iden)))\n          (@AC.comp _ _ _ (Alg.Assertion.toCore term) (AC.pair (AC.drop AC.iden) (AC.take AC.iden))\n            (@ctx8_add1_spec term)))\n  | S d' =>\n      @AC.comp _ _ _ (Alg.Assertion.toCore term)\n        (@AC.pair _ _ _ (Alg.Assertion.toCore term)\n          (@AC.comp _ _ _ (Alg.Assertion.toCore term)\n            (AC.pair (AC.drop (AC.take AC.iden)) (AC.take AC.iden))\n            (@AC.case _ _ _ _ (Alg.Assertion.toCore term) (AC.drop AC.iden)\n              (@AC.comp _ _ _ (Alg.Assertion.toCore term) (AC.pair (AC.drop AC.iden) (AC.take AC.iden))\n                (@ctx8_addn_spec (S d') term))))\n          (AC.drop (AC.drop AC.iden)))\n        (@ctx8_add_buffer_spec d' term)\n  end."
    },
    {
      "path": "C/jet_sha_finalize_spec.v",
      "name": "buffer_pad_spec",
      "declaration": "Fixpoint buffer_pad_spec (d : nat) {term : Alg.Core.Algebra} :\n    @Alg.Core.domain term (buffer_type (Word 3) d) (Vector (Word 3) (S d)) :=\n  match d with\n  | O => AC.copair (@Word.zero 4 term) (AC.pair AC.iden (AC.comp AC.unit (@Word.zero 3 term)))\n  | S d' =>\n      AC.comp (AC.pair (AC.take AC.iden) (AC.drop (buffer_pad_spec d')))\n        (AC.case\n          (AC.pair (AC.drop AC.iden) (AC.take (@fill Ty.Unit (Word 3) (S d') term (@Word.zero 3 term))))\n          AC.iden)\n  end."
    },
    {
      "path": "C/jet_sha_finalize_spec.v",
      "name": "flag_spec",
      "declaration": "Definition flag_spec {X : Ty.Ty} {term : Alg.Core.Algebra} :\n    @Alg.Core.domain term (Ty.Sum Ty.Unit X) Bit :=\n  AC.copair Bit.false Bit.true."
    },
    {
      "path": "C/jet_sha_finalize_spec.v",
      "name": "buffer63_size_spec",
      "declaration": "Definition buffer63_size_spec {term : Alg.Core.Algebra} :\n    @Alg.Core.domain term (buffer_type (Word 3) 5) (Word 3) :=\n  AC.pair\n    (AC.pair (AC.pair Bit.false Bit.false)\n             (AC.pair (AC.take flag_spec) (AC.drop (AC.take flag_spec))))\n    (AC.drop (AC.drop\n      (AC.pair (AC.pair (AC.take flag_spec) (AC.drop (AC.take flag_spec)))\n               (AC.drop (AC.drop (AC.pair (AC.take flag_spec) (AC.drop flag_spec)))))))."
    },
    {
      "path": "C/jet_sha_finalize_spec.v",
      "name": "ctx8_bitlen_spec",
      "declaration": "Definition ctx8_bitlen_spec {term : Alg.Core.Algebra} :\n    @Alg.Core.domain term sha256_ctx8_type (Word 6) :=\n  AC.comp\n    (AC.pair (AC.comp (AC.take buffer63_size_spec) (@left_pad_low_spec term 3 3))\n             (AC.drop (AC.take (@Word.shift_const 6 term 6))))\n    (AC.comp (AC.comp (@Word.adder 6 term) (AC.drop AC.iden)) (@Word.shift_const 6 term 3))."
    },
    {
      "path": "C/jet_sha_finalize_spec.v",
      "name": "pad_word64",
      "declaration": "Definition pad_word64 : Ty.tySem (Word 6) := @fromZ (WordToZ 6) 9223372036854775808."
    },
    {
      "path": "C/jet_sha_finalize_spec.v",
      "name": "ctx8_clear_count_spec",
      "declaration": "Definition ctx8_clear_count_spec {term : Alg.Assertion.Algebra} :\n    @Alg.Assertion.domain term sha256_ctx8_type sha256_ctx8_type :=\n  @AC.pair _ _ _ (Alg.Assertion.toCore term) (AC.take AC.iden)\n    (@AC.pair _ _ _ (Alg.Assertion.toCore term)\n      (@AC.comp _ _ _ (Alg.Assertion.toCore term) (@sha256_count_assertion_spec term)\n        (@Word.zero 6 (Alg.Assertion.toCore term)))\n      (AC.drop (AC.drop AC.iden)))."
    },
    {
      "path": "C/jet_sha_finalize_spec.v",
      "name": "ctx8_finalize_pad_spec",
      "declaration": "Definition ctx8_finalize_pad_spec {term : Alg.Assertion.Algebra} :\n    @Alg.Assertion.domain term sha256_ctx8_type (Ty.Prod (Word 9) (Word 8)) :=\n  @AC.comp _ _ _ (Alg.Assertion.toCore term)\n    (@AC.pair _ _ (Word 6) (Alg.Assertion.toCore term) (@ctx8_clear_count_spec term)\n      (AC.comp AC.unit (Alg.scribe pad_word64)))\n    (@AC.comp _ _ _ (Alg.Assertion.toCore term) (@ctx8_addn_spec 3 term)\n      (AC.pair (AC.take (@buffer_pad_spec 5 (Alg.Assertion.toCore term))) (AC.drop (AC.drop AC.iden))))."
    },
    {
      "path": "C/jet_sha_finalize_spec.v",
      "name": "ctx8_finalize_block_spec",
      "declaration": "Definition ctx8_finalize_block_spec {term : Alg.Core.Algebra} :\n    @Alg.Core.domain term (Ty.Prod (Ty.Prod (Word 9) (Word 8)) (Word 6)) (Ty.Prod (Word 8) (Word 9)) :=\n  AC.pair (AC.take (AC.drop AC.iden))\n    (AC.pair (AC.take (AC.take (AC.take AC.iden)))\n      (AC.pair (AC.take (AC.take (AC.drop (AC.take AC.iden))))\n        (AC.pair (AC.take (AC.take (AC.drop (AC.drop (AC.take AC.iden))))) (AC.drop AC.iden))))."
    },
    {
      "path": "C/jet_sha_finalize_spec.v",
      "name": "ctx8_finalize_spec",
      "declaration": "Definition ctx8_finalize_spec {term : Alg.Assertion.Algebra} :\n    @Alg.Assertion.domain term sha256_ctx8_type (Word 8) :=\n  @AC.comp _ _ _ (Alg.Assertion.toCore term)\n    (@AC.pair _ _ _ (Alg.Assertion.toCore term) (@ctx8_finalize_pad_spec term)\n      (@ctx8_bitlen_spec (Alg.Assertion.toCore term)))\n    (AC.comp (@ctx8_finalize_block_spec (Alg.Assertion.toCore term)) Simplicity.SHA256.hashBlock)."
    },
    {
      "path": "C/jet_core_pad_spec.v",
      "name": "left_pad_pad",
      "declaration": "Fixpoint left_pad_pad {term : Alg.Core.Algebra} {a} (t : @Alg.Core.domain term a a) (k : nat) :\n    @Alg.Core.domain term a (Vector a k) :=\n  match k with\n  | O => AC.iden\n  | S k => AC.pair (fill (n := k) t) (left_pad_pad t k)\n  end."
    },
    {
      "path": "C/jet_core_pad_spec.v",
      "name": "low_word",
      "declaration": "Definition low_word {term : Alg.Core.Algebra} (w : nat) : @Alg.Core.domain term Ty.Unit (Word w) :=\n  fill (n := w) (@Bit.false Ty.Unit term)."
    },
    {
      "path": "C/jet_core_pad_spec.v",
      "name": "left_pad_low_spec",
      "declaration": "Definition left_pad_low_spec {term : Alg.Core.Algebra} (w k : nat) :\n    @Alg.Core.domain term (Word w) (Vector (Word w) k) :=\n  left_pad_pad (AC.comp AC.unit (low_word w)) k."
    },
    {
      "path": "C/jet_sha_ctx8_spec.v",
      "name": "ctx8_buf",
      "declaration": "Definition ctx8_buf := buffer_type (Word 3) 5."
    },
    {
      "path": "C/jet_sha_ctx8_spec.v",
      "name": "ctx8_tail",
