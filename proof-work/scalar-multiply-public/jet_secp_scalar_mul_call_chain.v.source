(** Actual original read/read/multiply/write calls, exact literal output and all
    caller-local ownership. Public entry/copy/return/free remains separate. *)
From Coq Require Import ZArith List Lia.
From compcert Require Import AST Ctypes Clight ClightBigstep Integers Values Memory Events.
Require Import Simplicity.Ty Simplicity.Word Simplicity.Translate.
Require Simplicity.Alg.
Require Import C.jet_sx_expr C.jet_sx_state C.jet_sx_rep C.jet_sx_exec C.jet_sx_mem.
Require Import C.jet_secp_linkage C.jets_secp C.jet_secp_frame C.jet_secp_wrapper_run.
Require Import C.jet_frame_layout C.jet_frame_inv C.jet_input_layout C.jet_output_layout C.jet_encoding.
Require Import C.jet_secp_local_regions C.jet_secp_public_body C.jet_secp_add_pair_input.
Require Import C.jet_secp_scalar_public_rest C.jet_secp_scalar_reader_run.
Require Import C.jet_secp_scalar_get_b32_numeric C.jet_secp_scalar_writer_run.
Require Import C.jet_secp_scalar_writer_exec C.jet_secp_scalar_read_write.
Require Import C.jet_secp_canonical_scalar_negate LifeC.jet_secp_scalar_mul_caller_alloc.
Require Import OwnC.jet_secp_scalar_add_two_reads OwnC.jet_secp_scalar_mul_from_readers.
Require Import PubC.jet_secp_scalar_writer_word.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.

Definition scalar_mul_locals_outside m0 bd bw bi ba bb bl (block : block) (_ : Z) :=
  block <> ba /\ block <> bb /\ block <> bl /\ ~ extA m0 bd bw bi block.

Lemma scalar_mul_foot_blocks ba bb block pos :
  foot [(ba,0);(bb,0)] (map rshape scalar_mul_caller_inputs) block pos ->
  block = ba \/ block = bb.
Proof.
  intros (r & sh & d & ch & HNth & HIn & HBlock & HRange).
  destruct r as [|[|r]]; [left; exact HBlock|right; exact HBlock|].
  cbn [scalar_mul_caller_inputs map nth_error] in HNth; destruct r; discriminate.
Qed.

Local Opaque secp_ge canonical_scalar_multiply encode.
Theorem eval_scalar_mul_read_read_mul_write m0 bd dbase bw outedge cursor N bi edge rc
    (a b : Ty.tySem (Word 8)) m ba bb bl :
  write_frame_at m0 bd dbase bw outedge cursor N ->
  frame_input_cells_at m0 bi edge rc (@encode (Ty.Prod (Word 8) (Word 8)) (a,b)) ->
  0 <= rc -> rc+512 <= Int64.max_unsigned ->
  Mem.range_perm m ba 0 32 Cur Freeable -> Mem.range_perm m bb 0 32 Cur Freeable ->
  Mem.range_perm m bl 0 16 Cur Freeable -> frame_fields_at m bl 0 bi edge rc ->
  ba <> bb -> ba <> bl -> bb <> bl ->
  xsep (extA m0 bd bw bi) [(ba,0);(bl,0)] ->
  xsep (extA m0 bd bw bi) [(bb,0);(bl,0)] ->
  invA m0 bd dbase bw outedge cursor N bi rc false [] 256
    (read_fe_rho (frame_input_word_bits a) rc) [] m ->
  exists ma mr mn mf,
    Clight2.eval_funcall secp_ge m (Internal f_read_scalar)
      [Vptr ba Ptrofs.zero; Vptr bl Ptrofs.zero] E0 ma Vundef /\
    Clight2.eval_funcall secp_ge ma (Internal f_read_scalar)
      [Vptr bb Ptrofs.zero; Vptr bl Ptrofs.zero] E0 mr Vundef /\
    Clight2.eval_funcall secp_ge mr (Internal f_secp256k1_scalar_mul)
      [Vptr ba Ptrofs.zero; Vptr ba Ptrofs.zero; Vptr bb Ptrofs.zero] E0 mn Vundef /\
    Clight2.eval_funcall secp_ge mn (Internal f_write_scalar)
      [Vptr bd (Ptrofs.repr dbase); Vptr ba Ptrofs.zero] E0 mf Vundef /\
    finv m0 bd dbase bw outedge cursor N bi mf true
      (encode (@canonical_scalar_multiply Alg.CoreFunSem (a,b))) /\
    Mem.range_perm mf ba 0 32 Cur Freeable /\ Mem.range_perm mf bb 0 32 Cur Freeable /\
    frame_fields_at mf bl 0 bi edge (rc+512) /\ Mem.range_perm mf bl 0 16 Cur Freeable /\
    lframe (scalar_mul_locals_outside m0 bd bw bi ba bb bl) m mf.
Proof.
  intros HO HI Hrc HM HFA HFB HFL HSource HAB HAL HBL HXSA HXSB HInv.
  destruct (field_pair_input_slices m0 bi edge rc a b HI) as [HA HB].
  destruct (eval_scalar_add_two_readers m0 bd dbase bw outedge cursor N 256 bi edge rc
    a b m ba bb bl HO HA HB Hrc HM HFA HFB HFL HSource HAB HAL HBL HXSA HXSB HInv)
    as (ma & mr & HReadA & HReadB & HScalarA & HScalarB & HCursorR & HFreeAR & HFreeBR &
      HFreeLR & HInvR & HReadFrameA & HReadFrameB).
  destruct (eval_scalar_mul_from_normalized_scalars mr ba bb a b HAB HScalarA HScalarB HFreeAR HFreeBR)
    as (mn & HAdd & HWriterRep & HFreeAN & HFreeBN & HAddFrame).
  assert (HAddExt : lframe (fun block _ => extA m0 bd bw bi block) mr mn).
  { eapply lframe_implies; [exact HAddFrame|].
    intros block pos HE HV HF.
    destruct (scalar_mul_foot_blocks ba bb block pos HF) as [HEq|HEq]; subst block.
    - exact ((HXSA 0%nat ltac:(cbn; lia)) HE).
    - exact ((HXSB 0%nat ltac:(cbn; lia)) HE). }
  assert (HInvN : invA m0 bd dbase bw outedge cursor N bi (rc+256) false [] 256
      (read_fe_rho (frame_input_word_bits b) (rc+256)) (scalar_reader_log bi (Ptrofs.repr edge)) mn).
  { eapply invA_stable; [exact HO|exact HInvR|exact HAddExt]. }
  assert (HValidLR : Mem.valid_block mr bl).
  { eapply load_valid; exact (proj1 HCursorR). }
  assert (HOutsideL : forall pos,
      ~ foot [(ba,0);(bb,0)] (map rshape scalar_mul_caller_inputs) bl pos).
  { intros pos HF; destruct (scalar_mul_foot_blocks ba bb bl pos HF); congruence. }
  assert (HCursorN : frame_fields_at mn bl 0 bi edge (rc+512)).
  { destruct HCursorR as [HE HC]; split;
      rewrite (proj1 HAddFrame) by (auto; intros; apply HOutsideL); assumption. }
  assert (HFreeLN : Mem.range_perm mn bl 0 16 Cur Freeable).
  { intros pos HP; eapply (proj1 (proj2 HAddFrame));
      [exact HValidLR|apply HOutsideL|apply HFreeLR; exact HP]. }
  assert (HValidLN : Mem.valid_block mn bl).
  { exact ((proj2 (proj2 HAddFrame)) bl HValidLR). }
  assert (HValidBN : Mem.valid_block mn bb).
  { eapply Mem.perm_valid_block; apply (HFreeBN 0); lia. }
  set (wrho := scalar_limb_rho (@toZ (WordToZ 8) (@canonical_scalar_multiply Alg.CoreFunSem (a,b)))).
  assert (HWriteSep : xsep (extA m0 bd bw bi) [(ba,0)]).
  { intros r Hr; destruct r as [|r]; [apply (HXSA 0%nat); cbn; lia|cbn in Hr; lia]. }
  assert (HWriteInv : jet_secp_scalar_writer_exec.scalar_write_inv m0 bd dbase bw outedge cursor N bi
      (Int64.unsigned (wrho 0%nat)) false [] wrho [] mn).
  { destruct HInvN as [_ [HCurrent [HCap _]]].
    change (finv m0 bd dbase bw outedge cursor N bi mn false []) in HCurrent.
    unfold jet_secp_scalar_writer_exec.scalar_write_inv, invA.
    split; [symmetry; apply Int64.repr_unsigned|]; split; [exact HCurrent|]; split; [exact HCap|cbn; lia]. }
  destruct (eval_write_scalar_word m0 bd dbase bw outedge cursor N bi (Int64.unsigned (wrho 0%nat))
    (@canonical_scalar_multiply Alg.CoreFunSem (a,b)) false [] mn [(ba,0)] HO HWriterRep HWriteSep HWriteInv)
    as (mf & HWrite & HFinalRep & HWritten & HWriteFrame).
  assert (HFreeAF : Mem.range_perm mf ba 0 32 Cur Freeable).
  { destruct (rep_free_region _ _ _ _ 0 32 HFinalRep ltac:(change (0 < 1)%nat; lia) eq_refl)
      as [_ HF]; exact HF. }
  assert (HFrameL : forall pos, frame (extA m0 bd bw bi) [(ba,0)] scalar_writer_initial_regs mn bl pos).
  { intro pos; split; [exact HValidLN|]; split.
    - intro HF; pose proof (scalar_writer_foot_block ba bl pos HF); congruence.
    - exact (HXSA 1%nat ltac:(cbn; lia)). }
  assert (HFrameB : forall pos, frame (extA m0 bd bw bi) [(ba,0)] scalar_writer_initial_regs mn bb pos).
  { intro pos; split; [exact HValidBN|]; split.
    - intro HF; pose proof (scalar_writer_foot_block ba bb pos HF); congruence.
    - exact (HXSB 0%nat ltac:(cbn; lia)). }
  assert (HCursorF : frame_fields_at mf bl 0 bi edge (rc+512)).
  { destruct HCursorN as [HE HC]; split;
      rewrite (proj1 HWriteFrame) by (auto; intros; apply HFrameL); assumption. }
  assert (HFreeLF : Mem.range_perm mf bl 0 16 Cur Freeable).
  { intros pos HP; eapply (proj1 (proj2 HWriteFrame));
      [exact HValidLN|apply HFrameL|apply HFreeLN; exact HP]. }
  assert (HFreeBF : Mem.range_perm mf bb 0 32 Cur Freeable).
  { intros pos HP; eapply (proj1 (proj2 HWriteFrame));
      [exact HValidBN|apply HFrameB|apply HFreeBN; exact HP]. }
  exists ma, mr, mn, mf; split; [exact HReadA|]; split; [exact HReadB|];
    split; [exact HAdd|]; split; [exact HWrite|]; split; [exact HWritten|];
    split; [exact HFreeAF|]; split; [exact HFreeBF|]; split; [exact HCursorF|]; split; [exact HFreeLF|].
  eapply lframe_trans.
  - eapply lframe_implies; [exact HReadFrameA|].
    intros block pos [HNotA [HNotB [HNotL HNotExt]]] HV.
    split; [exact HV|]; split; [eapply scalar_locals_not_foot; eassumption|exact HNotExt].
  - eapply lframe_trans.
    + eapply lframe_implies; [exact HReadFrameB|].
      intros block pos [HNotA [HNotB [HNotL HNotExt]]] HV.
      split; [exact HV|]; split; [eapply scalar_locals_not_foot; eassumption|exact HNotExt].
    + eapply lframe_trans.
      * eapply lframe_implies; [exact HAddFrame|].
        intros block pos [HNotA [HNotB [HNotL HNotExt]]] HV HF.
        destruct (scalar_mul_foot_blocks ba bb block pos HF); congruence.
      * eapply lframe_implies; [exact HWriteFrame|].
        intros block pos [HNotA [HNotB [HNotL HNotExt]]] HV.
        split; [exact HV|]; split; [|exact HNotExt].
        intro HF; apply HNotA; exact (scalar_writer_foot_block ba block pos HF).
Qed.
