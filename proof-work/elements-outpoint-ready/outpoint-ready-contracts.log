TAP_TYPE OutpointReady.Ready.outpoint_hash_initial_run
Ready.outpoint_hash_initial_run
     : forall _ : jet_memcpy_model.memcpy_model, Ready.op_initial_run
TAP_TYPE OutpointReady.Ready.outpoint_hash_initial_execution
Ready.outpoint_hash_initial_execution
     : forall (_ : jet_memcpy_model.memcpy_model) (env : Values.val) (a : Ty.tySem Shape.op_input_type),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          @ex Memory.Mem.mem
            (fun m : Memory.Mem.mem =>
             @ex Values.block
               (fun bd : Values.block =>
                @ex Values.block
                  (fun bs : Values.block =>
                   @ex Values.block
                     (fun bw : Values.block =>
                      @ex Memory.Mem.mem
                        (fun mf : Memory.Mem.mem =>
                         and
                           (@eq (option Memory.Mem.mem)
                              (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
                                 (@Ctypes.program_of_program Clight.function jets_elements.prog))
                              (@Some Memory.Mem.mem mi))
                           (and
                              (forall (b : Values.block) (ch : AST.memory_chunk) (ofs : BinNums.Z)
                                 (_ : Memory.Mem.valid_block mi b),
                               @eq (option Values.val) (Memory.Mem.load ch m b ofs) (Memory.Mem.load ch mi b ofs))
                              (and
                                 (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                                    (@Ctypes.Internal Clight.function jets_elements.f_simplicity_outpoint_hash)
                                    (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                                       (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                                          (@cons Values.val env (@nil Values.val)))) Events.E0 mf
                                    (@jet_partial.jet_partial_return
                                       (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
                                       (@Spec.elements_outpoint_hash_spec (Alg.AssertionSem Option.option_Monad_Zero) a)))
                                 (and
                                    match
                                      @Spec.elements_outpoint_hash_spec (Alg.AssertionSem Option.option_Monad_Zero) a
                                      return Prop
                                    with
                                    | Some result =>
                                        and
                                          (jet_encoding.frame_output_cells_at mf bw BinNums.Z0
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xI
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI
                                                                  (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
                                             (@Translate.encode jet_sha256_ctx8_init_spec.sha256_ctx8_type result))
                                          (and
                                             (jet_output_layout.write_prefix_at m mf bw BinNums.Z0
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xI
                                                         (BinNums.xI
                                                            (BinNums.xI
                                                               (BinNums.xI
                                                                  (BinNums.xI
                                                                     (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                                             (jet_frame_layout.frame_fields_at mf bd BinNums.Z0 bw BinNums.Z0
                                                BinNums.Z0))
                                    | None => True
                                    end
                                    (forall (b : Values.block) (ch : AST.memory_chunk) (ofs : BinNums.Z)
                                       (_ : Memory.Mem.valid_block mi b),
                                     @eq (option Values.val) (Memory.Mem.load ch mf b ofs)
                                       (Memory.Mem.load ch mi b ofs)))))))))))
TAP_DEF OutpointReady.Ready.op_initial_run
Ready.op_initial_run =
forall (env : Values.val) (a : Ty.tySem Shape.op_input_type) (mi : Memory.Mem.mem)
  (_ : @eq (option Memory.Mem.mem)
         (@Globalenvs.Genv.init_mem (Ctypes.fundef Clight.function) Ctypes.type
            (@Ctypes.program_of_program Clight.function jets_elements.prog)) (@Some Memory.Mem.mem mi)),
@ex Memory.Mem.mem
  (fun m : Memory.Mem.mem =>
   @ex Values.block
     (fun bd : Values.block =>
      @ex Values.block
        (fun bs : Values.block =>
         @ex Values.block
           (fun bw : Values.block =>
            @ex Memory.Mem.mem
              (fun mf : Memory.Mem.mem =>
               and
                 (forall (b : Values.block) (ch : AST.memory_chunk) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block mi b),
                  @eq (option Values.val) (Memory.Mem.load ch m b ofs) (Memory.Mem.load ch mi b ofs))
                 (and
                    (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                       (@Ctypes.Internal Clight.function jets_elements.f_simplicity_outpoint_hash)
                       (@cons Values.val (Values.Vptr bd Integers.Ptrofs.zero)
                          (@cons Values.val (Values.Vptr bs Integers.Ptrofs.zero)
                             (@cons Values.val env (@nil Values.val)))) Events.E0 mf
                       (@jet_partial.jet_partial_return (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
                          (@Spec.elements_outpoint_hash_spec (Alg.AssertionSem Option.option_Monad_Zero) a)))
                    (and
                       match
                         @Spec.elements_outpoint_hash_spec (Alg.AssertionSem Option.option_Monad_Zero) a return Prop
                       with
                       | Some result =>
                           and
                             (jet_encoding.frame_output_cells_at mf bw BinNums.Z0
                                (BinNums.Zpos
                                   (BinNums.xO
                                      (BinNums.xI
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH))))))))))
                                (@Translate.encode jet_sha256_ctx8_init_spec.sha256_ctx8_type result))
                             (and
                                (jet_output_layout.write_prefix_at m mf bw BinNums.Z0
                                   (BinNums.Zpos
                                      (BinNums.xO
                                         (BinNums.xI
                                            (BinNums.xI
                                               (BinNums.xI
                                                  (BinNums.xI
                                                     (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xI BinNums.xH)))))))))))
                                (jet_frame_layout.frame_fields_at mf bd BinNums.Z0 bw BinNums.Z0 BinNums.Z0))
                       | None => True
                       end
                       (forall (b : Values.block) (ch : AST.memory_chunk) (ofs : BinNums.Z)
                          (_ : Memory.Mem.valid_block mi b),
                        @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch mi b ofs)))))))))
     : Prop
