(** Formal specification-side checks for the native API overlap diagnostic.
    This module does not prove any Clight execution counterexample. *)
From Coq Require Import ZArith List.
From compcert Require Import Integers.
Require Import Simplicity.Ty Simplicity.Word.
Require Import C.jet_elements_prim.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.

Definition overlap_result_type : Ty.Ty :=
  Ty.Sum Ty.Unit (Ty.Sum Ty.Unit
    (Ty.Sum (Ty.Prod (Word 1) (Word 8))
      (Ty.Sum (Ty.Sum Ty.Unit Ty.Unit) (Word 2)))).

Definition overlap_OP1_value : Ty.tySem overlap_result_type :=
  inr (inr (inr (inr (@fromZ (WordToZ 2) 0)))).

Lemma overlap_script_is_one_OP1 :
  txNullData [Byte.repr 106; Byte.repr 81] = Some [OP1].
Proof. vm_compute; reflexivity. Qed.

Theorem overlap_original_primitive_value (e : Elements.env) txo :
  nth_error (sigTxOut (Elements.envTx e)) 0 = Some txo ->
  txoScript txo = [Byte.repr 106; Byte.repr 81] ->
  Elements.sem Elements.OutputNullDatum
    (@fromZ (WordToZ 5) 0, @fromZ (WordToZ 5) 0) e = Some overlap_OP1_value.
Proof.
  intros HO HS.
  cbn [Elements.sem fst snd].
  change (Z.to_nat (@toZ (WordToZ 5) (@fromZ (WordToZ 5) 0))) with 0%nat.
  rewrite HO, HS, overlap_script_is_one_OP1.
  reflexivity.
Qed.

Theorem overlap_changed_index_is_absent (e : Elements.env) txo :
  nth_error (sigTxOut (Elements.envTx e)) 0 = Some txo ->
  txoScript txo = [Byte.repr 106; Byte.repr 81] ->
  Elements.sem Elements.OutputNullDatum
    (@fromZ (WordToZ 5) 0, @fromZ (WordToZ 5) 16) e = Some (inr (inl tt)).
Proof.
  intros HO HS.
  cbn [Elements.sem fst snd].
  change (Z.to_nat (@toZ (WordToZ 5) (@fromZ (WordToZ 5) 0))) with 0%nat.
  change (Z.to_nat (@toZ (WordToZ 5) (@fromZ (WordToZ 5) 16))) with 16%nat.
  rewrite HO, HS, overlap_script_is_one_OP1.
  reflexivity.
Qed.

Theorem overlap_absent_value_is_not_original_value (e : Elements.env) txo :
  nth_error (sigTxOut (Elements.envTx e)) 0 = Some txo ->
  txoScript txo = [Byte.repr 106; Byte.repr 81] ->
  Elements.sem Elements.OutputNullDatum
    (@fromZ (WordToZ 5) 0, @fromZ (WordToZ 5) 0) e <>
    Some (inr (inl tt)).
Proof.
  intros HO HS. rewrite (overlap_original_primitive_value e txo HO HS).
  discriminate.
Qed.

Lemma overlap_uword64_tag_bit_is_sixteen :
  Int64.or Int64.zero (Int64.shl Int64.one (Int64.repr 4)) = Int64.repr 16.
Proof. vm_compute; reflexivity. Qed.
