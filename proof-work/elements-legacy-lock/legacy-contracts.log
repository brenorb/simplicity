      | true => negb (BinInt.Z.testbit s (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))
      | false => BinInt.Z.testbit s (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))
      end return BinNums.Z
    with
    | true =>
        BinInt.Z.modulo s
          (BinNums.Zpos
             (BinNums.xO
                (BinNums.xO
                   (BinNums.xO
                      (BinNums.xO
                         (BinNums.xO
                            (BinNums.xO
