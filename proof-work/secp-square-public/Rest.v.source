(** Compose the real calls and return in the unchanged public square body. *)
From Coq Require Import ZArith List.
From compcert Require Import AST Ctypes Clight Clightdefs ClightBigstep Integers Values Memory Events Globalenvs Maps.
Require Import Simplicity.Word Simplicity.Translate.
Require Simplicity.Alg.
Require Import C.jet_sx_exec C.jet_sx_mem C.jet_secp_frame C.jet_secp_linkage C.jets_secp.
Require Import C.jet_frame_layout C.jet_input_layout C.jet_output_layout C.jet_encoding C.jet_frame_inv.
Require Import C.jet_secp_public_copy C.jet_secp_public_body C.jet_secp_wrapper_run.
Require Import SquareRun.Run SquarePublic.Chain.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.

Definition square_inplace_stmt := match fn_body f_simplicity_fe_square with
  | Ssequence _ (Ssequence _ (Ssequence squaring _)) => squaring | _ => Sskip end.
Definition square_rest := match fn_body f_simplicity_fe_square with
  | Ssequence _ rest => rest | _ => Sskip end.
Lemma square_rest_eq : square_rest = Ssequence secp_public_read_stmt
  (Ssequence square_inplace_stmt (Ssequence secp_public_write_stmt (Sreturn (Some (Econst_int (Int.repr 1) tint))))).
Proof. reflexivity. Qed.
Lemma square_helper_symbols :
  Genv.find_symbol secp_ge _secp256k1_fe_sqr = Some (secp_symbol_block _secp256k1_fe_sqr) /\
  Genv.find_funct secp_ge (Vptr (secp_symbol_block _secp256k1_fe_sqr) Ptrofs.zero) = Some (Internal f_secp256k1_fe_sqr).
Proof. vm_compute; split; reflexivity. Qed.
Local Opaque secp_ge literal_fe_square Simplicity.Translate.encode.

Lemma exec_square_inplace le m mf bl ba :
  Clight2.eval_funcall secp_ge m (Internal f_secp256k1_fe_sqr)
    [Vptr ba Ptrofs.zero;Vptr ba Ptrofs.zero] E0 mf Vundef ->
  Clight2.exec_stmt secp_ge (secp_public_env bl ba) le m square_inplace_stmt E0 le mf Out_normal.
Proof.
  intro HCall; destruct square_helper_symbols as [HS HF].
  eapply exec_Scall with (vf := Vptr (secp_symbol_block _secp256k1_fe_sqr) Ptrofs.zero)
    (vargs := [Vptr ba Ptrofs.zero;Vptr ba Ptrofs.zero])
    (f := Internal f_secp256k1_fe_sqr) (vres := Vundef).
  - reflexivity.
  - eapply eval_Elvalue; [eapply eval_Evar_global; [reflexivity|exact HS]|apply deref_loc_reference; reflexivity].
  - eapply eval_Econs.
    + apply eval_Eaddrof; apply eval_Evar_local; reflexivity.
    + reflexivity.
    + eapply eval_Econs.
      * apply eval_Eaddrof; apply eval_Evar_local; reflexivity.
      * reflexivity.
      * apply eval_Enil.
  - exact HF.
  - reflexivity.
  - exact HCall.
Qed.

Theorem exec_square_rest le m0 bd dbase bw outedge cursor N bi edge rc
    (value : Ty.tySem (Word 8)) m ba bl :
  le!_dst = Some (Vptr bd (Ptrofs.repr dbase)) ->
  write_frame_at m0 bd dbase bw outedge cursor N ->
  frame_input_cells_at m0 bi edge rc (map Some (frame_input_word_bits value)) ->
  0 <= rc -> rc + 256 <= Int64.max_unsigned ->
  Mem.range_perm m ba 0 40 Cur Freeable -> Mem.range_perm m bl 0 16 Cur Freeable ->
  frame_fields_at m bl 0 bi edge rc -> ba <> bl ->
  xsep (extA m0 bd bw bi) [(ba,0);(bl,0)] ->
  invA m0 bd dbase bw outedge cursor N bi rc false [] 256
    (read_fe_rho (frame_input_word_bits value) rc) [] m ->
  exists mf,
    Clight2.exec_stmt secp_ge (secp_public_env bl ba) le m square_rest E0 le mf
      (Out_return (Some (Vint Int.one,tint))) /\
    finv m0 bd dbase bw outedge cursor N bi mf true
      (Simplicity.Translate.encode (@literal_fe_square Alg.CoreFunSem value)) /\
    Mem.range_perm mf ba 0 40 Cur Freeable /\ Mem.range_perm mf bl 0 16 Cur Freeable /\
    lframe (secp_locals_outside m0 bd bw bi ba bl) m mf.
Proof.
  intros HD HO HI Hrc HM HA HL HS HSeparate HSep HInv.
  destruct (eval_square_read_sqr_write m0 bd dbase bw outedge cursor N bi edge rc value m ba bl
    HO HI Hrc HM HA HL HS HSeparate HSep HInv)
    as (mr & mn & mf & HRead & HSqr & HWrite & HFinal & HFA & HFL & HFrame).
  exists mf; split.
  - rewrite square_rest_eq.
    eapply exec_Sseq_1 with (t1 := E0) (t2 := E0) (m1 := mr) (le1 := le).
    + apply exec_secp_public_read; exact HRead.
    + eapply exec_Sseq_1 with (t1 := E0) (t2 := E0) (m1 := mn) (le1 := le).
      * apply exec_square_inplace; exact HSqr.
      * eapply exec_Sseq_1 with (t1 := E0) (t2 := E0) (m1 := mf) (le1 := le).
        -- eapply exec_secp_public_write; [exact HD|exact HWrite].
        -- apply exec_Sreturn_some; constructor.
  - split; [exact HFinal|]; split; [exact HFA|]; split; assumption.
Qed.
