  ltac:(let T := type of ElementsStartup.jet_elements_startup_jets.sha_256_block_startup_spec in let R := runs_type T in exact R).
Proof.
  run. exact ElementsStartup.jet_elements_startup_jets.sha_256_block_startup_spec.
Qed.

