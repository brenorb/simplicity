From 2217368e002599d1fc295320ac11148002e78aa5 Mon Sep 17 00:00:00 2001
From: Breno Brito <brenorb@gmail.com>
Date: Tue, 6 Oct 2026 00:47:54 -0300
Subject: [PATCH 07/20] refactor(coq): transport increment layouts through
 frame byte ranges


diff --git a/Coq/C/jet_increment16_layout.v b/Coq/C/jet_increment16_layout.v
index 94c5532ef56959b3e36a0c9b08c0ea74c10a6fbe..32c8f25fe06a2ad1ed76445dcea91b2901f66cf1 100644
--- a/Coq/C/jet_increment16_layout.v
+++ b/Coq/C/jet_increment16_layout.v
@@ -37,9 +37,9 @@ Proof.
       HReadCursor HInput HOutput.
   assert (HLocalBase : frame_base_valid 0).
   { split; [lia|change (16 <= 18446744073709551615); lia]. }
-  pose proof HOutput as [HDBase [[HDE HDO] [HOutEdge [HN [HMax [HDw [PD HW]]]]]]].
+  pose proof HOutput as [HDBase [[HDE HDO] [HOutEdge [HN [HMax [PD HW]]]]]].
   pose proof (HW 0 ltac:(lia)) as HW0.
-  cbn zeta in HW0. destruct HW0 as [_ [_ [_ [initialword HInitialWord]]]].
+  cbn zeta in HW0. destruct HW0 as [_ [_ [_ [_ [initialword HInitialWord]]]]].
   destruct (Mem.alloc m 0 16) as [ma bl] eqn:HA.
   assert (HLs : bl <> bs).
   { eapply fresh_frame_not_loaded; eauto. }
