Subject: [PATCH 10/20] refactor(coq): transport logical and constants through
 frame byte ranges


diff --git a/Coq/C/jet_binary1_layout.v b/Coq/C/jet_binary1_layout.v
index c6689bc937f65016f1561966f426b88e055e9901..67f24129bc66f46d43b9ffb3c90eedd8e7980aa2 100644
--- a/Coq/C/jet_binary1_layout.v
+++ b/Coq/C/jet_binary1_layout.v
@@ -33,7 +33,7 @@ Proof.
   intros HSbase HSAlign [HSE HSO] HRC Hinput1 Hinput2 Hout.
   assert (HLocalBase : frame_base_valid 0).
   { split; [lia|change (16 <= 18446744073709551615); lia]. }
-  pose proof Hout as [HDbase [[HDE HDO] [HE [HC [HM [HD [PD HW]]]]]]].
+  pose proof Hout as [HDbase [[HDE HDO] [HE [HC [HM [PD HW]]]]]].
   destruct (write_frame_at_head m bd dbase bw outedge cursor 1 ltac:(lia) Hout)
     as [_ [_ [_ [initialword HInitialWord]]]].
   destruct (Mem.alloc m 0 16) as [ma bl] eqn:HA.
