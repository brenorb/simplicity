Subject: [PATCH 11/20] refactor(coq): transport numeric predicates through
 frame byte ranges


diff --git a/Coq/C/jet_divides8_layout.v b/Coq/C/jet_divides8_layout.v
index 8cabb6ba406ad50dd3be661827b15c4a3b72de5a..45ae6fae1dd295ce4f259f540071e3fcc82e65b1 100644
--- a/Coq/C/jet_divides8_layout.v
+++ b/Coq/C/jet_divides8_layout.v
@@ -32,7 +32,7 @@ Proof.
   intros HSbase HSAlign [HSE HSO] Hinput1 Hinput2 Hout.
   assert (HLocalBase : frame_base_valid 0).
   { split; [lia|change (16 <= 18446744073709551615); lia]. }
-  pose proof Hout as [HDbase [[HDE HDO] [HE [HC [HM [HD [PD HW]]]]]]].
+  pose proof Hout as [HDbase [[HDE HDO] [HE [HC [HM [PD HW]]]]]].
   destruct (write_frame_at_head m bd dbase bw outedge cursor 1 ltac:(lia) Hout)
     as [_ [_ [_ [initialword HInitialWord]]]].
   destruct (Mem.alloc m 0 16) as [ma bl] eqn:HA.
