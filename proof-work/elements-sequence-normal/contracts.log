SEQUENCE_NORMAL_DEF C.jet_elements_sequence_literal.haskell_from_word_acc
jet_elements_sequence_literal.haskell_from_word_acc =
fix haskell_from_word_acc (n : nat) : forall (_ : BinNums.Z) (_ : Ty.tySem (Word.Word n)), BinNums.Z :=
  match n as k return (forall (_ : BinNums.Z) (_ : Ty.tySem (Word.Word k)), BinNums.Z) with
  | O =>
      fun (i : BinNums.Z) (w : Ty.tySem (Word.Word O)) =>
      match w return BinNums.Z with
      | inl _ => BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) i
      | inr _ => BinInt.Z.add (BinInt.Z.mul (BinNums.Zpos (BinNums.xO BinNums.xH)) i) (BinNums.Zpos BinNums.xH)
      end
  | S k =>
      fun (i : BinNums.Z) (w : Ty.tySem (Word.Word (S k))) =>
      match w return BinNums.Z with
      | pair hi lo => haskell_from_word_acc k (haskell_from_word_acc k i hi) lo
      end
  end
     : forall (n : nat) (_ : BinNums.Z) (_ : Ty.tySem (Word.Word n)), BinNums.Z

