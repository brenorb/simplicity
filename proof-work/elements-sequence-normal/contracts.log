SEQUENCE_NORMAL_DEF C.jet_elements_sequence_literal.elements_input_sequence_literal_spec
jet_elements_sequence_literal.elements_input_sequence_literal_spec =
fun (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (environment : jet_elements_prim.Elements.env) =>
@Some (sum unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
  match
    @List.nth_error jet_elements_prim.sigTxInput
      (jet_elements_prim.sigTxIn (jet_elements_prim.Elements.envTx environment))
      (BinInt.Z.to_nat (jet_elements_sequence_literal.haskell_from_word (S (S (S (S (S O))))) a))
    return (sum unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
  with
  | Some txi =>
      @inr unit (Ty.tySem (Word.Word (S (S (S (S (S O)))))))
        (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S O)))))
           (Integers.Int.unsigned (jet_elements_prim.sigTxiSequence txi)))
  | None => @inl unit (Ty.tySem (Word.Word (S (S (S (S (S O))))))) tt
  end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S O))))))))

Arguments jet_elements_sequence_literal.elements_input_sequence_literal_spec a environment
SEQUENCE_NORMAL_DEF C.jet_elements_current_sequence_literal.elements_current_literal_result
jet_elements_current_sequence_literal.elements_current_literal_result =
fun (B : Ty.Ty)
  (p : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem (Ty.Sum Ty.Unit B))) (_ : Ty.tySem Ty.Unit) (environment : jet_elements_prim.Elements.env) =>
match
  p
    (jet_haskell_word_conversion.haskell_to_word (S (S (S (S (S O)))))
       (BinInt.Z.of_nat (jet_elements_prim.Elements.envIx environment))) environment return (option (Ty.tySem B))
with
| Some t =>
    match t return (option (Ty.tySem B)) with
    | inl _ => @None (Ty.tySem B)
    | inr value =>
        @Some
          ((fix tySem (X : Ty.Ty) : Set :=
              match X return Set with
              | Ty.Unit => unit
              | Ty.Sum A B0 => sum (tySem A) (tySem B0)
              | Ty.Prod A B0 => prod (tySem A) (tySem B0)
              end) B) value
    end
| None => @None (Ty.tySem B)
end
     : forall (B : Ty.Ty)
         (_ : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (_ : jet_elements_prim.Elements.env),
              option (Ty.tySem (Ty.Sum Ty.Unit B))) (_ : Ty.tySem Ty.Unit) (_ : jet_elements_prim.Elements.env),
       option (Ty.tySem B)

