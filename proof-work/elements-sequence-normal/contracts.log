jet_elements_sequence_literal.haskell_from_word =
fun (n : nat) (a : Ty.tySem (Word.Word n)) => jet_elements_sequence_literal.haskell_from_word_acc n BinNums.Z0 a
     : forall (n : nat) (_ : Ty.tySem (Word.Word n)), BinNums.Z

