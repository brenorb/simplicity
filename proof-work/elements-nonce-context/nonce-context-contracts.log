         (@Spec.nonce_prefix_spec)
TAP_TYPE NonceContext.Spec.nonce_hash_spec_parametric
Spec.nonce_hash_spec_parametric
     : @Alg.Assertion.Parametric Spec.nonce_hash_input_type jet_sha256_ctx8_init_spec.sha256_ctx8_type
         (@Spec.nonce_hash_spec)
TAP_TYPE NonceContext.Spec.nonce_prefix_core
Spec.nonce_prefix_core
     : forall p : Ty.tySem Spec.nonce_conf_type,
       @eq (Ty.tySem (Ty.Prod (Word.Word (S (S (S O)))) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (@Spec.nonce_prefix_spec Alg.CoreFunSem p) (Spec.nonce_prefix_value p)
TAP_TYPE NonceContext.Spec.nonce_hash_option
Spec.nonce_hash_option
     : forall (c : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (a : Ty.tySem Spec.nonce_value_type),
       @eq
         (Monad.CIMonad.domain (Monad.MonadZero.to_Monad Option.option_Monad_Zero)
            (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
         (@Spec.nonce_hash_spec (Alg.AssertionSem Option.option_Monad_Zero)
            (@pair (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) (Ty.tySem Spec.nonce_value_type) c a))
         (jet_sha_ctx8_spec.ctx8_add_list c (Spec.nonce_hash_bytes a))
