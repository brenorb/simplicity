  | Clight.Ssequence a _ => elements_statement_head_set a
  | Clight.Sifthenelse _ _ _ => @None AST.ident
  | Clight.Sloop _ _ => @None AST.ident
  | Clight.Sbreak => @None AST.ident
  | Clight.Scontinue => @None AST.ident
