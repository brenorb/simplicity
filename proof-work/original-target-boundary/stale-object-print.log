Record sigTxInput : Set := Build_sigTxInput
  { sigTxiPreviousOutpoint : Bitcoin.outpoint;
    sigTxiValue : Integers.Int64.int;
    sigTxiSequence : Integers.Int.int }.

sigTxInput has primitive projections with eta conversion.
Arguments Bitcoin.Build_sigTxInput sigTxiPreviousOutpoint 
  sigTxiValue sigTxiSequence

Record sigTx : Set := Build_sigTx
  { sigTxVersion : Integers.Int.int;
    sigTxIn : list Bitcoin.sigTxInput;
    sigTxOut : list Bitcoin.txOutput;
    sigTxLock : Bitcoin.lock;
    sigTxInBounds : BinInt.Z.lt BinNums.Z0 (Zcomplements.Zlength sigTxIn) /\
                    BinInt.Z.lt (Zcomplements.Zlength sigTxIn)
                      Integers.Int.modulus;
    sigTxOutBounds : BinInt.Z.le BinNums.Z0 (Zcomplements.Zlength sigTxOut) /\
                     BinInt.Z.lt (Zcomplements.Zlength sigTxOut)
                       Integers.Int.modulus;
    sigTxTotalInValue := List.Z_sum
                           (List.map
                              (fun i : Bitcoin.sigTxInput =>
                               Integers.Int64.signed (Bitcoin.sigTxiValue i))
                              sigTxIn);
    sigTxTotalOutValue := List.Z_sum
                            (List.map
                               (fun i : Bitcoin.txOutput =>
                                Integers.Int64.signed (Bitcoin.txoValue i))
                               sigTxOut);
    sigTxFee := BinInt.Z.sub sigTxTotalInValue sigTxTotalOutValue }.

sigTx has primitive projections with eta conversion.
Arguments Bitcoin.Build_sigTx sigTxVersion (sigTxIn sigTxOut)%list_scope
  sigTxLock sigTxInBounds sigTxOutBounds

