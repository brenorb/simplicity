  | O => @nil (prod BinNums.Z AST.memory_chunk)
  | S k =>
      @cons (prod BinNums.Z AST.memory_chunk) (@pair BinNums.Z AST.memory_chunk ofs AST.Mint64)
        (field_u64_shapes (BinInt.Z.add ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) k)
  end
