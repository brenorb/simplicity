TAP_DEF C.jet_elements_calc_field_eval.envu_field_offset
jet_elements_calc_field_eval.envu_field_offset =
fun sid field : AST.ident =>
match @Maps.PTree.get Ctypes.composite sid (Clight.genv_cenv jet_sha_linkage.sha_ge) return (option BinNums.Z) with
| Some co =>
    match
      Ctypes.field_offset (Clight.genv_cenv jet_sha_linkage.sha_ge) field (Ctypes.co_members co)
      return (option BinNums.Z)
    with
    | Errors.OK p =>
        match p return (option BinNums.Z) with
        | pair d b =>
            match b return (option BinNums.Z) with
            | Ctypes.Full => @Some BinNums.Z d
            | Ctypes.Bits _ _ _ _ => @None BinNums.Z
            end
        end
    | Errors.Error _ => @None BinNums.Z
    end
| None => @None BinNums.Z
end
     : forall (_ : AST.ident) (_ : AST.ident), option BinNums.Z

