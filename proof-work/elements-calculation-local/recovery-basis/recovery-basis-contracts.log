TAP_DEF C.jet_elements_calculate_token_exec.calc_token_regs
jet_elements_calculate_token_exec.calc_token_regs =
fun (ent : list Integers.Int.int) (pfx : Integers.Int.int) =>
SHA256.hash_block jet_sha256_iv_init.sha256_iv_words
  (@app Integers.Int.int ent
     (@cons Integers.Int.int (jet_elements_calculate_token_exec.token_word pfx)
        (@List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S O))))))))))
     : forall (_ : list Integers.Int.int) (_ : Integers.Int.int), list Integers.Int.int

Arguments jet_elements_calculate_token_exec.calc_token_regs ent%list_scope pfx
TAP_DEF C.jet_env_store_words.store_words
jet_env_store_words.store_words =
fix store_words (m : Memory.Mem.mem) (b : Values.block) (base : BinNums.Z) (ws : list Integers.Int.int) {struct ws} :
    option Memory.Mem.mem :=
  match ws return (option Memory.Mem.mem) with
  | nil => @Some Memory.Mem.mem m
  | cons w rest =>
      match Memory.Mem.store AST.Mint32 m b base (Values.Vint w) return (option Memory.Mem.mem) with
      | Some m1 => store_words m1 b (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))) rest
      | None => @None Memory.Mem.mem
      end
  end
     : forall (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int.int),
       option Memory.Mem.mem

Arguments jet_env_store_words.store_words m b base%Z_scope ws%list_scope
