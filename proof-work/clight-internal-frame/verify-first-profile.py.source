"""Audit closed-internal-call framing without new external-properties axioms."""
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
sp = importlib.util.spec_from_file_location('internal_beta_basis', HERE.parent / 'secp-beta-global/verify.py')
v = importlib.util.module_from_spec(sp)
sp.loader.exec_module(v)
s, g, WORK = v.s, v.g, v.WORK
EXT = Path('/private/tmp/jet-internal-frame.O4axwR')
EXTRA = v.EXTRA + ['-Q', str(EXT), 'InternalFrame']
NAMES = ['Internal', 'Multiply', 'Observed']
DEPS = ['C/jet_clight_forward.v', 'C/jet_clight_readonly.v', 'C/jet_clight_readonly_frame.v']
ROOT = 'InternalFrame.Observed'


def identity():
    v.check()
    known, inherited, beta, _ = v.identity()
    inherited.update({m: v.b.source_object(p) for m, p in beta})
    for name in DEPS:
        p = WORK / 'Coq' / name
        if p.is_symlink() or p.read_bytes() != (v.REPO / 'Coq' / name).read_bytes():
            raise ValueError('readonly primitive support source differs: ' + name)
        s.safe_source(p.read_text(), name)
        known[name] = v.b.source_object(p)
    own = []
    for name in NAMES:
        p = EXT / (name + '.v')
        if p.is_symlink() or p.read_bytes() != (HERE / (name + '.v.source')).read_bytes():
            raise ValueError('internal frame source/archive differs: ' + name)
        s.safe_source(p.read_text(), 'InternalFrame.' + name)
        own.append(('InternalFrame.' + name, p))
    return known, inherited, own


def profiles(results, definitions, deps):
    if len(results) != 17 or len(definitions) != 8 or set(results) != set(deps):
        raise ValueError('internal-frame report inventory differs')
    if any(not set(ds) <= s.SIX for ds in deps.values()):
        raise ValueError('internal-frame results gained non-inherited assumptions')
    if set(deps['InternalFrame.Observed.eval_beta_with_precise_frame']) != s.SIX:
        raise ValueError('actual execution endpoint assumption profile differs')
    four = s.SIX - {'Events.external_functions_sem', 'Events.inline_assembly_sem'}
    if any(not set(deps[n]) <= four for n in results if not n.endswith('.eval_beta_with_precise_frame')):
        raise ValueError('framing helpers acquired external semantics dependencies')


def compile():
    if (HERE / 'COMPILE-LAUNCH.json').exists():
        raise ValueError('internal-frame audit already launched; poll original process')
    known, inherited, own = identity()
    before, index = s.input_map(), s.index_hash()
    s.changed({HERE / 'COMPILE-LAUNCH.json': json.dumps(dict(candidate=str(EXT), complete=False,
        driver_sha256=s.sha(Path(__file__).read_bytes()), sources={m: s.sha(p.read_bytes()) for m, p in own}), indent=2) + '\n'})
    commands = {}
    for name in DEPS:
        p = WORK / 'Coq' / name
        stem = 'internal-fresh-' + p.stem
        commands[stem] = s.run(WORK, ['bash', 'build-jets.sh', '--coqc', '-q', str(p)], stem, 60)
    for module, p in own:
        stem = 'internal-fresh-' + p.stem.lower()
        commands[stem] = s.run(WORK, ['bash', 'build-jets.sh', '--coqc', '-q', *EXTRA, str(p)], stem, 60)
        print('Freshly compiled ' + module, flush=True)
    results, definitions, deps = g.reports(WORK, own, 'internal-audit', commands, EXTRA)
    profiles(results, definitions, deps)
    query = subprocess.run(['bash', 'build-jets.sh', '--coqtop', '-quiet', *EXTRA],
        input='Require ' + ROOT + '.\nPrint Libraries.\n', cwd=WORK / 'Coq', env=s.ENV,
        text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
    if query.returncode or re.search(r'(?m)^(?:Error|Anomaly):', query.stdout):
        raise ValueError('internal loaded-closure query failed')
    libraries = set(re.findall(r'^\s+([A-Z_a-z][\w]*(?:\.[\w]+)+)\s*$', query.stdout, re.M))
    local = {n.replace('.', '/') + '.v' for n in libraries if n.startswith(('C.', 'Simplicity.', 'Util.'))}
    exts = {n for n in libraries if n.startswith(('FieldBorrow.', 'FieldBorrowed.', 'BetaGlobal.'))}
    unknown = {n for n in libraries if not n.startswith(('C.', 'Simplicity.', 'Util.',
        'FieldBorrow.', 'FieldBorrowed.', 'BetaGlobal.', 'InternalFrame.', 'Coq.', 'compcert.', 'Flocq.', 'VST.', 'sha.'))}
    if unknown or not local <= set(known) or exts != set(inherited):
        raise ValueError('internal-frame closure has unchecked inputs: ' + str(unknown | (local - set(known))))
    identity()
    if before != s.input_map() or index != s.index_hash():
        raise ValueError('main sources/staging changed during internal-frame audit')
    r = dict(candidate=str(EXT), basis=str(WORK), results=results, definitions=definitions,
        dependencies={n: sorted(ds) for n, ds in deps.items()}, commands=commands,
        main_inputs=before, staged_patch_sha256=index,
        own_sources_objects={m: v.b.source_object(p) for m, p in own},
        loaded_local_source_objects={n: v.b.source_object(WORK / 'Coq' / n) for n in sorted(local)},
        inherited_extension_source_objects=inherited,
        parent_checked_sha256=s.sha((v.HERE / 'CHECKED.json').read_bytes()),
        driver_sha256=s.sha(Path(__file__).read_bytes()), recursive_kernel_check=False,
        actual_original_helper_call=True, full_readonly_global_frame=True,
        frame_excludes_only_writable_local_block=True, whole_beta_jet_proved=False, coverage_added=0)
    s.changed({HERE / 'RUN.json': json.dumps(r, indent=2) + '\n',
        HERE / 'internal-audit-assumptions.log': (WORK / 'internal-audit-assumptions.log').read_text(),
        HERE / 'internal-audit-contracts.log': (WORK / 'internal-audit-contracts.log').read_text(),
        HERE / 'loaded-libraries.log': query.stdout})
    print('Precise internal-frame reports passed without external-properties assumptions', flush=True)


def bound():
    known, inherited, own = identity()
    r = json.loads((HERE / 'RUN.json').read_text())
    if (r['driver_sha256'] != s.sha(Path(__file__).read_bytes()) or r['main_inputs'] != s.input_map() or
            r['staged_patch_sha256'] != s.index_hash() or
            r['parent_checked_sha256'] != s.sha((v.HERE / 'CHECKED.json').read_bytes()) or
            r['own_sources_objects'] != {m: v.b.source_object(p) for m, p in own} or
            r['inherited_extension_source_objects'] != inherited or
            any(known[n] != row for n, row in r['loaded_local_source_objects'].items())):
        raise ValueError('internal-frame checked inputs differ')
    profiles(r['results'], r['definitions'], r['dependencies'])
    for stem, row in r['commands'].items():
        if row['exit_code'] or row['log_sha256'] != s.sha((WORK / (stem + '.log')).read_bytes()):
            raise ValueError('internal-frame compiler/report log differs: ' + stem)
    return r


def kernel_command():
    return ['bash', '-c', 'ulimit -s 65520; exec bash build-jets.sh --coqchk -silent -o ' + ' '.join(EXTRA + [ROOT])]


def kernel():
    if (HERE / 'KERNEL-LAUNCH.json').exists():
        raise ValueError('internal-frame kernel already launched; poll original process')
    bound()
    s.changed({HERE / 'KERNEL-LAUNCH.json': json.dumps(dict(command=kernel_command(), complete=False,
        run_sha256=s.sha((HERE / 'RUN.json').read_bytes())), indent=2) + '\n'})
    row = s.run(WORK, kernel_command(), 'internal-audit-kernel', 900)
    log = (WORK / 'internal-audit-kernel.log').read_text()
    s.kernel.kernel(log, sorted((WORK / 'Coq/C/jet_coqchk_axioms.expected').read_text().split()))
    bound()
    s.changed({HERE / 'CHECKED.json': json.dumps(dict(kernel=row,
        run_sha256=s.sha((HERE / 'RUN.json').read_bytes()), recursive_kernel_check=True,
        whole_beta_jet_proved=False, coverage_added=0), indent=2) + '\n', HERE / 'internal-audit-kernel.log': log})
    print('Actual beta helper with precise readonly framing recursively kernel-checked', flush=True)


def check():
    bound()
    r = json.loads((HERE / 'CHECKED.json').read_text())
    if (not r['recursive_kernel_check'] or r['kernel']['exit_code'] or r['kernel']['command'] != kernel_command() or
            r['run_sha256'] != s.sha((HERE / 'RUN.json').read_bytes()) or
            r['kernel']['log_sha256'] != s.sha((HERE / 'internal-audit-kernel.log').read_bytes()) or
            (HERE / 'internal-audit-kernel.log').read_bytes() != (WORK / 'internal-audit-kernel.log').read_bytes()):
        raise ValueError('internal-frame completed kernel evidence differs')
    s.kernel.kernel((HERE / 'internal-audit-kernel.log').read_text(),
        sorted((WORK / 'Coq/C/jet_coqchk_axioms.expected').read_text().split()))
    print('Exact precise-frame sources/objects/full reports/kernel evidence verified')


if __name__ == '__main__':
    if len(sys.argv) != 2 or sys.argv[1] not in {'compile', 'kernel', 'check'}:
        raise SystemExit('usage: verify.py compile|kernel|check')
    {'compile': compile, 'kernel': kernel, 'check': check}[sys.argv[1]]()
