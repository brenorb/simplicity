TAP_DEF InternalFrame.Internal.nonfunction_type
Internal.nonfunction_type =
fun ty : Ctypes.type =>
match ty return bool with
| Ctypes.Tvoid => true
| Ctypes.Tint _ _ _ => true
| Ctypes.Tlong _ _ => true
| Ctypes.Tfloat _ _ => true
| Ctypes.Tpointer _ _ => true
| Ctypes.Tarray _ _ _ => true
| Ctypes.Tfunction _ _ _ => false
| Ctypes.Tstruct _ _ => true
| Ctypes.Tunion _ _ => true
end
     : forall _ : Ctypes.type, bool

Arguments Internal.nonfunction_type ty
TAP_DEF InternalFrame.Internal.plain_env
Internal.plain_env =
fun e : Clight.env =>
forall (id : BinNums.positive) (b : Values.block) (ty : Ctypes.type)
  (_ : @eq (option (prod Values.block Ctypes.type)) (@Maps.PTree.get (prod Values.block Ctypes.type) id e)
         (@Some (prod Values.block Ctypes.type) (@pair Values.block Ctypes.type b ty))),
@eq bool (Internal.nonfunction_type ty) true
     : forall _ : Clight.env, Prop

Arguments Internal.plain_env e
TAP_DEF InternalFrame.Internal.internal_lookup
Internal.internal_lookup =
fix internal_lookup (table : list (prod AST.ident Clight.function)) (id : BinNums.positive) {struct table} :
    option Clight.function :=
  match table return (option Clight.function) with
  | nil => @None Clight.function
  | cons p rest =>
      match p return (option Clight.function) with
      | pair key fd =>
          match BinPos.Pos.eqb key id return (option Clight.function) with
          | true => @Some Clight.function fd
          | false => internal_lookup rest id
          end
      end
  end
     : forall (_ : list (prod AST.ident Clight.function)) (_ : BinNums.positive), option Clight.function

Arguments Internal.internal_lookup table%list_scope id%positive_scope
TAP_DEF InternalFrame.Internal.closed_callb
Internal.closed_callb =
fun (table : list (prod AST.ident Clight.function)) (a : Clight.expr) =>
match a return bool with
| Clight.Econst_int _ _ => false
| Clight.Econst_float _ _ => false
| Clight.Econst_single _ _ => false
| Clight.Econst_long _ _ => false
| Clight.Evar id t =>
    match t return bool with
    | Ctypes.Tvoid => false
    | Ctypes.Tint _ _ _ => false
    | Ctypes.Tlong _ _ => false
    | Ctypes.Tfloat _ _ => false
    | Ctypes.Tpointer _ _ => false
    | Ctypes.Tarray _ _ _ => false
    | Ctypes.Tfunction _ _ _ =>
        match Internal.internal_lookup table id return bool with
        | Some _ => true
        | None => false
        end
    | Ctypes.Tstruct _ _ => false
    | Ctypes.Tunion _ _ => false
    end
| Clight.Etempvar _ _ => false
| Clight.Ederef _ _ => false
| Clight.Eaddrof _ _ => false
| Clight.Eunop _ _ _ => false
| Clight.Ebinop _ _ _ _ => false
| Clight.Ecast _ _ => false
| Clight.Efield _ _ _ => false
| Clight.Esizeof _ _ => false
| Clight.Ealignof _ _ => false
end
     : forall (_ : list (prod AST.ident Clight.function)) (_ : Clight.expr), bool

Arguments Internal.closed_callb table%list_scope a
TAP_DEF InternalFrame.Internal.closed_stmtb
Internal.closed_stmtb =
fix closed_stmtb (table : list (prod AST.ident Clight.function)) (s : Clight.statement) {struct s} : bool :=
  match s return bool with
  | Clight.Sskip => true
  | Clight.Sassign _ _ => true
  | Clight.Sset _ _ => true
  | Clight.Scall _ a _ => Internal.closed_callb table a
  | Clight.Sbuiltin _ _ _ _ => false
  | Clight.Ssequence s1 s2 => andb (closed_stmtb table s1) (closed_stmtb table s2)
  | Clight.Sifthenelse _ s1 s2 => andb (closed_stmtb table s1) (closed_stmtb table s2)
  | Clight.Sloop s1 s2 => andb (closed_stmtb table s1) (closed_stmtb table s2)
  | Clight.Sbreak => true
  | Clight.Scontinue => true
  | Clight.Sreturn _ => true
  | Clight.Sswitch _ _ => false
  | Clight.Slabel _ _ => false
  | Clight.Sgoto _ => false
  end
     : forall (_ : list (prod AST.ident Clight.function)) (_ : Clight.statement), bool

Arguments Internal.closed_stmtb table%list_scope s
TAP_DEF InternalFrame.Internal.allowed_call
Internal.allowed_call =
fun (table : list (prod AST.ident Clight.function)) (f : Clight.fundef) =>
@ex BinNums.positive
  (fun id : BinNums.positive =>
   @ex Clight.function
     (fun fd : Clight.function =>
      and (@eq (option Clight.function) (Internal.internal_lookup table id) (@Some Clight.function fd))
        (@eq Clight.fundef f (@Ctypes.Internal Clight.function fd))))
     : forall (_ : list (prod AST.ident Clight.function)) (_ : Clight.fundef), Prop

Arguments Internal.allowed_call table%list_scope f
TAP_DEF InternalFrame.Internal.internal_table_ok
Internal.internal_table_ok =
fun (ge : Clight.genv) (table : list (prod AST.ident Clight.function)) =>
forall (id : BinNums.positive) (fd : Clight.function)
  (_ : @eq (option Clight.function) (Internal.internal_lookup table id) (@Some Clight.function fd)),
and
  (@ex Values.block
     (fun b : Values.block =>
      and
        (@eq (option Values.block) (@Globalenvs.Genv.find_symbol Clight.fundef Ctypes.type (Clight.genv_genv ge) id)
           (@Some Values.block b))
        (@eq (option Clight.fundef) (@Globalenvs.Genv.find_funct_ptr Clight.fundef Ctypes.type (Clight.genv_genv ge) b)
           (@Some (Ctypes.fundef Clight.function) (@Ctypes.Internal Clight.function fd)))))
  (and (@eq bool (Internal.closed_stmtb table (Clight.fn_body fd)) true)
     (@eq bool
        (@List.forallb (prod AST.ident Ctypes.type)
           (fun it : prod AST.ident Ctypes.type => Internal.nonfunction_type (@snd AST.ident Ctypes.type it))
           (Clight.fn_vars fd)) true))
     : forall (_ : Clight.genv) (_ : list (prod AST.ident Clight.function)), Prop

Arguments Internal.internal_table_ok ge table%list_scope
TAP_DEF InternalFrame.Multiply.multiply_internal_table
Multiply.multiply_internal_table =
@cons (prod AST.ident Clight.function)
  (@pair AST.ident Clight.function jets_secp._secp256k1_fe_mul jets_secp.f_secp256k1_fe_mul)
  (@cons (prod AST.ident Clight.function)
     (@pair AST.ident Clight.function jets_secp._secp256k1_fe_mul_inner jets_secp.f_secp256k1_fe_mul_inner)
     (@cons (prod AST.ident Clight.function)
        (@pair AST.ident Clight.function jets_secp._secp256k1_u128_mul jets_secp.f_secp256k1_u128_mul)
        (@cons (prod AST.ident Clight.function)
           (@pair AST.ident Clight.function jets_secp._secp256k1_u128_accum_mul jets_secp.f_secp256k1_u128_accum_mul)
           (@cons (prod AST.ident Clight.function)
              (@pair AST.ident Clight.function jets_secp._secp256k1_u128_accum_u64 jets_secp.f_secp256k1_u128_accum_u64)
              (@cons (prod AST.ident Clight.function)
                 (@pair AST.ident Clight.function jets_secp._secp256k1_u128_rshift jets_secp.f_secp256k1_u128_rshift)
                 (@cons (prod AST.ident Clight.function)
                    (@pair AST.ident Clight.function jets_secp._secp256k1_u128_to_u64 jets_secp.f_secp256k1_u128_to_u64)
                    (@cons (prod AST.ident Clight.function)
                       (@pair AST.ident Clight.function jets_secp._secp256k1_umul128 jets_secp.f_secp256k1_umul128)
                       (@nil (prod AST.ident Clight.function)))))))))
     : list (prod AST.ident Clight.function)
