TAP_TYPE IssuanceRegisters.Registers.issuance_repr_block_pair
Registers.issuance_repr_block_pair
     : forall h t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq (list Integers.Int.int)
         (SHA256.repr_Block
            (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) h t))
         (@app Integers.Int.int (Digest.hash256_reg (Word.to_hash256 h)) (Digest.hash256_reg (Word.to_hash256 t)))
TAP_TYPE IssuanceRegisters.Registers.issuance_iv_registers
Registers.issuance_iv_registers
     : @eq SHA256.registers
         (Digest.hash256_reg (Word.to_hash256 (@jet_sha256_iv_init.sha256_iv_spec Alg.CoreFunSem tt)))
         jet_sha256_iv_init.sha256_iv_words
TAP_TYPE IssuanceRegisters.Registers.issuance_compress_registers
Registers.issuance_compress_registers
     : forall h t : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))),
       @eq SHA256.registers
         (Digest.hash256_reg
            (Word.to_hash256
               (@SHA256.hashBlock Alg.CoreFunSem
                  (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                     (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
                     (@jet_sha256_iv_init.sha256_iv_spec Alg.CoreFunSem tt)
                     (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                        (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) h t)))))
         (SHA256.hash_block jet_sha256_iv_init.sha256_iv_words
            (@app Integers.Int.int (Digest.hash256_reg (Word.to_hash256 h)) (Digest.hash256_reg (Word.to_hash256 t))))
TAP_TYPE IssuanceRegisters.Registers.issuance_zero_registers
Registers.issuance_zero_registers
     : @eq SHA256.registers
         (Digest.hash256_reg (Word.to_hash256 (@Word.zero (S (S (S (S (S (S (S (S O)))))))) Alg.CoreFunSem tt)))
         (@List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S (S O)))))))))
TAP_TYPE IssuanceRegisters.Registers.issuance_explicit_token_registers
Registers.issuance_explicit_token_registers
     : @eq SHA256.registers
         (Digest.hash256_reg
            (Word.to_hash256
               (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
                  (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH))
                     (BinNums.Zpos
                        (BinNums.xO
                           (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xI (BinNums.xI BinNums.xH))))))))))))
         (@cons Integers.Int.int
            (Integers.Int.repr
               (BinNums.Zpos
                  (BinNums.xO
                     (BinNums.xO
                        (BinNums.xO
                           (BinNums.xO
                              (BinNums.xO
                                 (BinNums.xO
                                    (BinNums.xO
                                       (BinNums.xO
                                          (BinNums.xO
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO
                                                                  (BinNums.xO
                                                                     (BinNums.xO
                                                                        (BinNums.xO
                                                                           (BinNums.xO
                                                                              (BinNums.xO
                                                                                 (BinNums.xO
                                                                                    (BinNums.xO (BinNums.xO BinNums.xH))))))))))))))))))))))))))
            (@List.repeat Integers.Int.int Integers.Int.zero (S (S (S (S (S (S (S O)))))))))
