Require Import NullableC.jet_bitcoin_tappath_nullable.
Require Import NullableC.jet_bitcoin_tappath_nullable_raw.
Set Printing All.
Set Printing Width 120.
Set Printing Depth 100000.
Goal True. idtac "NULLABLE_TYPE NullableC.jet_bitcoin_tappath_nullable.bitcoin_tappath_env_rep_weaken". exact I. Qed.
Check NullableC.jet_bitcoin_tappath_nullable.bitcoin_tappath_env_rep_weaken.
Goal True. idtac "NULLABLE_TYPE NullableC.jet_bitcoin_tappath_nullable.bitcoin_tappath_nullable_local_spec". exact I. Qed.
Check NullableC.jet_bitcoin_tappath_nullable.bitcoin_tappath_nullable_local_spec.
Goal True. idtac "NULLABLE_TYPE NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_nullable_raw_local_spec". exact I. Qed.
Check NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_nullable_raw_local_spec.
Goal True. idtac "NULLABLE_TYPE NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_env_rep_nonempty". exact I. Qed.
Check NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_env_rep_nonempty.
Goal True. idtac "NULLABLE_TYPE NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_nullable_empty". exact I. Qed.
Check NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_nullable_empty.
Goal True. idtac "NULLABLE_TYPE NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_empty_cells". exact I. Qed.
Check NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_empty_cells.
Goal True. idtac "NULLABLE_TYPE NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_empty_sem". exact I. Qed.
Check NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_empty_sem.
Goal True. idtac "NULLABLE_TYPE NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_nullable_raw_empty". exact I. Qed.
Check NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_nullable_raw_empty.
Goal True. idtac "NULLABLE_TYPE NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_old_rep_rejects_null". exact I. Qed.
Check NullableC.jet_bitcoin_tappath_nullable_raw.bitcoin_tappath_old_rep_rejects_null.
Goal True. idtac "NULLABLE_DEF NullableC.jet_bitcoin_tappath_nullable.bitcoin_tappath_env_rep_nullable". exact I. Qed.
Print NullableC.jet_bitcoin_tappath_nullable.bitcoin_tappath_env_rep_nullable.
