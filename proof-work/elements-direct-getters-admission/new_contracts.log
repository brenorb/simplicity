DIRECT_COMPACT_DEF C.jet_elements_write32s_exec.write32s_run
jet_elements_write32s_exec.write32s_run =
fix write32s_run
  (bi : Values.block) (input : BinNums.Z) (bf : Values.block) (base : BinNums.Z) (xs : list Integers.Int.int)
  (m mf : Memory.Mem.mem) {struct xs} : Prop :=
  match xs return Prop with
  | nil => @eq Memory.Mem.mem m mf
  | cons x rest =>
      @ex Memory.Mem.mem
        (fun mi : Memory.Mem.mem =>
         and (@eq (option Values.val) (Memory.Mem.load AST.Mint32 m bi input) (@Some Values.val (Values.Vint x)))
           (and
              (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
                 (@Ctypes.Internal Clight.function jets_elements.f_simplicity_write32)
                 (@cons Values.val (Values.Vptr bf (Integers.Ptrofs.repr base))
                    (@cons Values.val (Values.Vlong (Integers.Int64.repr (Integers.Int.unsigned x))) (@nil Values.val)))
                 Events.E0 mi Values.Vundef)
              (write32s_run bi (BinInt.Z.add input (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))) bf base rest mi
                 mf)))
  end
     : forall (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) (_ : list Integers.Int.int)
         (_ : Memory.Mem.mem) (_ : Memory.Mem.mem), Prop

Arguments jet_elements_write32s_exec.write32s_run bi input%Z_scope bf base%Z_scope xs%list_scope m mf
