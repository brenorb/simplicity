ISSUANCE_PROOF_DEF C.jet_elements_issuance_proof_literal.haskell_amount_proof_view
jet_elements_issuance_proof_literal.haskell_amount_proof_view =
fun a : jet_elements_prim.amountWith (list Integers.Byte.int) =>
match a return (list Integers.Byte.int) with
| jet_elements_prim.Explicit _ => @nil Integers.Byte.int
| jet_elements_prim.Confidential _ proof => proof
end
     : forall _ : jet_elements_prim.amountWith (list Integers.Byte.int), list Integers.Byte.int

Arguments jet_elements_issuance_proof_literal.haskell_amount_proof_view a
ISSUANCE_PROOF_DEF C.jet_elements_issuance_proof_literal.haskell_issuance_proof_view
jet_elements_issuance_proof_literal.haskell_issuance_proof_view =
fun (token : bool) (txi : jet_elements_prim.sigTxInput) =>
match jet_elements_prim.sigTxiIssuance txi return (list Integers.Byte.int) with
| Some i =>
    match i return (list Integers.Byte.int) with
    | inl new =>
        jet_elements_issuance_proof_literal.haskell_amount_proof_view
          match token return (jet_elements_prim.amountWith (list Integers.Byte.int)) with
          | true => jet_elements_prim.newIssuanceTokenAmount new
          | false => jet_elements_prim.newIssuanceAmount new
          end
    | inr re =>
        match token return (list Integers.Byte.int) with
        | true => @nil Integers.Byte.int
        | false =>
            jet_elements_issuance_proof_literal.haskell_amount_proof_view (jet_elements_prim.reissuanceAmount re)
        end
    end
| None => @nil Integers.Byte.int
end
     : forall (_ : bool) (_ : jet_elements_prim.sigTxInput), list Integers.Byte.int

