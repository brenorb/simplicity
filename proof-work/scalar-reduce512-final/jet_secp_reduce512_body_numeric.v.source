(** Whole unchanged reduce512 body with exact numeric output; function entry/free still separate. *)
From Coq Require Import ZArith List Lia.
From compcert Require Import Integers AST Ctypes Clight ClightBigstep Maps Memory Events Values.
Require Import C.jet_sx_expr C.jet_sx_state C.jet_sx_eval C.jet_sx_exec C.jet_sx_mem.
Require Import C.jet_sx_rep.
Require Import C.jet_secp_linkage C.jets_secp C.jet_secp_canonical_scalar C.jet_secp_statement_prefix.
Require Import MulC.jet_secp_scalar_reduce512_run MulC.jet_secp_reduce512_typed_stage
  MulC.jet_secp_reduce512_two_stages MulC.jet_secp_reduce512_three_stages
  MulC.jet_secp_reduce512_third_stage MulC.jet_secp_reduce512_third_checkpoint
  MulC.jet_secp_reduce512_third_value MulC.jet_secp_reduce512_final_stage
  MulC.jet_secp_reduce512_final_atomic MulC.jet_secp_reduce512_final_value
  MulC.jet_secp_reduce512_final_checkpoint MulC.jet_secp_reduce512_final_exec
  MulC.jet_secp_reduce512_fold_bounds MulC.jet_secp_scalar_mul512_low.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.
Definition reduce512_body_digits rho := third_checkpoint_digits
  (second_checkpoint_digits rho) (second_checkpoint_p4 rho).
Definition reduce512_body_carry rho := third_checkpoint_c
  (second_checkpoint_digits rho) (second_checkpoint_p4 rho).
Definition reduce512_input_integer rho :=
  scalar_mul512_input_value rho 0 + scalar_mul512_input_value rho 4 * reduce512_radix.
Lemma reduce512_body_numeric rho beta :
  final_output_value (reduce512_body_digits rho) (reduce512_body_carry rho) rho beta =
    reduce512_input_integer rho mod canonical_group_order.
Proof.
  unfold reduce512_body_digits,reduce512_body_carry.
  rewrite third_checkpoint_final_numeric by exact (proj2 (second_checkpoint_p4_bound rho)).
  rewrite second_checkpoint_third_modulo,second_fold_bridge_modulo_order,first_fold_modulo_order.
  reflexivity.
Qed.
Lemma final_shape_same_entry digits :
  map rshape (reduce512_final_regs digits) = map rshape (sregs reduce512_first_initial).
Proof. Timeout 10 reflexivity. Qed.
Lemma final_state_output_exact digits carry :
  sregs (reduce512_final_state digits carry) =
    mkreg (u64_cells 0 (reduce512_final_limbs digits carry)) true (Some 32) ::
      (tl scalar_reduce512_initial_regs ++ fst reduce512_allocated).
Proof. Timeout 10 reflexivity. Qed.
Local Opaque reduce512_allocated reduce512_third_state reduce512_final_state reduce512_final_suffix.
Theorem exec_reduce512_body_numeric rho beta e le m :
  rep rho beta (sregs reduce512_first_initial) m ->
  tmatch rho beta reduce512_initial_temps le ->
  ematch beta (snd reduce512_allocated) e ->
  exists le' mf,
    Clight2.exec_stmt secp_ge e le m (fn_body f_secp256k1_scalar_reduce_512) E0 le' mf Out_normal /\
    rep rho beta (sregs (reduce512_final_state (reduce512_body_digits rho) (reduce512_body_carry rho))) mf /\
    (forall i sy, nth_error (reduce512_final_limbs (reduce512_body_digits rho) (reduce512_body_carry rho)) i = Some sy ->
      Mem.load Mint64 mf (blk beta 0) (bas beta 0 + 8 * Z.of_nat i) = Some (den rho (lay beta) sy)) /\
    final_output_value (reduce512_body_digits rho) (reduce512_body_carry rho) rho (lay beta) =
      reduce512_input_integer rho mod canonical_group_order /\
    tmatch rho beta (stemps (reduce512_final_state (reduce512_body_digits rho) (reduce512_body_carry rho))) le' /\
    lframe (fun b ofs => ~ foot beta (map rshape (sregs reduce512_first_initial)) b ofs) m mf.
Proof.
  intros HR HT HE.
  destruct (exec_reduce512_first_three_stages rho beta e le m HR HT HE)
    as (le3 & m3 & Hex3 & HR3 & HL3 & LC3 & HV3 & HB3 & HC3 & HM3 & HT3 & HF3).
  pose proof (third_checkpoint_rep _ _ rho beta m3 HR3) as HR4.
  pose proof (third_checkpoint_tmatch _ _ rho beta le3 HT3) as HT4.
  destruct (exec_typed_final_suffix (reduce512_body_digits rho) (reduce512_body_carry rho)
    rho beta e le3 m3 HR4 HT4 HE) as (le4 & m4 & Hex4 & HR5 & HL4 & HT5 & HF4).
  assert (Hex : Clight2.exec_stmt secp_ge e le m (fn_body f_secp256k1_scalar_reduce_512) E0 le4 m4 Out_normal).
  { rewrite <- reduce512_final_source; eapply exec_statement_prefix_then_last; [exact Hex3|exact Hex4]. }
  exists le4,m4; split; [exact Hex|]. split; [exact HR5|]. split; [exact HL4|].
  split; [apply reduce512_body_numeric|]. split; [exact HT5|].
  cbn [reduce512_final_initial sregs] in HF4; rewrite final_shape_same_entry in HF4.
  eapply lframe_trans; [exact HF3|exact HF4].
Qed.
