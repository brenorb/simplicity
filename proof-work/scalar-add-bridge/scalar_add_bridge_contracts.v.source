Require Import AddC.jet_secp_canonical_scalar_add.
Require Import AddC.jet_secp_canonical_scalar_add_numeric.
Require Import AddC.jet_secp_scalar_add_storage.
Require Import AddC.jet_secp_scalar_add_literal_owned.
Set Printing All.
Set Printing Width 120.
Set Printing Depth 100000.
Goal True. idtac "SCALAR_TYPE AddC.jet_secp_canonical_scalar_add.canonical_scalar_add_parametric". exact I. Qed.
Check AddC.jet_secp_canonical_scalar_add.canonical_scalar_add_parametric.
Goal True. idtac "SCALAR_TYPE AddC.jet_secp_canonical_scalar_add_numeric.canonical_scalar_add_numeric". exact I. Qed.
Check AddC.jet_secp_canonical_scalar_add_numeric.canonical_scalar_add_numeric.
Goal True. idtac "SCALAR_TYPE AddC.jet_secp_canonical_scalar_add_numeric.canonical_scalar_add_normalize_value". exact I. Qed.
Check AddC.jet_secp_canonical_scalar_add_numeric.canonical_scalar_add_normalize_value.
Goal True. idtac "SCALAR_TYPE AddC.jet_secp_canonical_scalar_add_numeric.canonical_scalar_add_normalized_inputs_range". exact I. Qed.
Check AddC.jet_secp_canonical_scalar_add_numeric.canonical_scalar_add_normalized_inputs_range.
Goal True. idtac "SCALAR_TYPE AddC.jet_secp_scalar_add_storage.scalar_add_output_limbs_numeric". exact I. Qed.
Check AddC.jet_secp_scalar_add_storage.scalar_add_output_limbs_numeric.
Goal True. idtac "SCALAR_TYPE AddC.jet_secp_scalar_add_storage.scalar_add_output_scalar_at". exact I. Qed.
Check AddC.jet_secp_scalar_add_storage.scalar_add_output_scalar_at.
Goal True. idtac "SCALAR_TYPE AddC.jet_secp_scalar_add_storage.scalar_writer_initial_rep_from_add". exact I. Qed.
Check AddC.jet_secp_scalar_add_storage.scalar_writer_initial_rep_from_add.
Goal True. idtac "SCALAR_TYPE AddC.jet_secp_scalar_add_literal_owned.eval_scalar_add_literal_owned". exact I. Qed.
Check AddC.jet_secp_scalar_add_literal_owned.eval_scalar_add_literal_owned.
Goal True. idtac "SCALAR_DEF AddC.jet_secp_canonical_scalar_add.canonical_scalar_add". exact I. Qed.
Print AddC.jet_secp_canonical_scalar_add.canonical_scalar_add.
