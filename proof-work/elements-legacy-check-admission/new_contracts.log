fun (distance : bool) (alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra) =>
@jet_elements_current_spec.elements_assert_spec alg (Word.Word (S (S (S (S O))))) Ty.Unit
  (@jet_elements_current_spec.elements_comp alg (Word.Word (S (S (S (S O)))))
     (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))) (Ty.Sum Ty.Unit Ty.Unit)
     (@jet_elements_prim_sem.elements_pair alg (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))
        (Word.Word (S (S (S (S O)))))
        (@jet_elements_prim_sem.elements_core (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O)))))
           (fun alg0 : Alg.Core.Algebra => @DC.iden (Word.Word (S (S (S (S O))))) alg0) alg)
        (@jet_elements_current_spec.elements_comp alg (Word.Word (S (S (S (S O))))) Ty.Unit
           (Word.Word (S (S (S (S O)))))
           (@jet_elements_prim_sem.elements_core (Word.Word (S (S (S (S O))))) Ty.Unit
              (fun alg0 : Alg.Core.Algebra => @DC.unit (Word.Word (S (S (S (S O))))) alg0) alg)
           (@jet_elements_legacy_lock_spec.elements_legacy_lock_spec distance alg)))
     (@jet_elements_prim_sem.elements_core (Ty.Prod (Word.Word (S (S (S (S O))))) (Word.Word (S (S (S (S O))))))
        (Ty.Sum Ty.Unit Ty.Unit) (fun alg0 : Alg.Core.Algebra => @le_word_spec alg0 (S (S (S (S O))))) alg))
     : forall (_ : bool) (alg : jet_elements_prim.PrimitiveElements.Primitive.Algebra),
       jet_elements_prim.PrimitiveElements.Primitive.domain alg (Word.Word (S (S (S (S O))))) Ty.Unit

Arguments jet_elements_legacy_check.elements_legacy_check_spec distance%bool_scope {alg}
