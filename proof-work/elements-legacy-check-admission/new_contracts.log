           (Ctypes.Tfunction
              (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)) Ctypes.Tnil)
              Ctypesdefs.tulong AST.cc_default))
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_elements._src (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
              (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))) (@nil Clight.expr)))
     (Clight.Sset jets_elements._x (Clight.Etempvar jets_elements._t'1 Ctypesdefs.tulong)))
  (Clight.Ssequence
     (Clight.Ssequence (jet_elements_tx_field_set.elements_env_tx_set jets_elements._t'3)
        (Clight.Scall (@Some AST.ident jets_elements._t'2)
           (Clight.Evar fid
              (Ctypes.Tfunction
                 (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr))
                    Ctypes.Tnil) Ctypesdefs.tulong AST.cc_default))
           (@cons Clight.expr
              (Clight.Etempvar jets_elements._t'3
                 (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._elementsTransaction Ctypes.noattr)))
              (@nil Clight.expr))))
     (Clight.Sreturn
        (@Some Clight.expr
           (Clight.Ebinop Cop.Ole (Clight.Etempvar jets_elements._x Ctypesdefs.tulong)
              (Clight.Etempvar jets_elements._t'2 Ctypesdefs.tulong) Ctypesdefs.tint))))
     : forall (_ : wide_size) (_ : AST.ident), Clight.statement

Arguments jet_elements_legacy_check.elements_checked_helper_rest width fid
