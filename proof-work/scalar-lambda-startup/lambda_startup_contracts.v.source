From Coq Require Import String.
Require LamInitC.jet_program_initialization LamInitC.jet_secp_scalar_lambda_init_exists.
Local Open Scope string_scope.
Set Printing Width 120.
Set Printing Depth 100000.
Goal True. idtac "LAMBDA_STARTUP_TYPE LamInitC.jet_program_initialization.initializer_alignment_positive". exact I. Qed.
Check LamInitC.jet_program_initialization.initializer_alignment_positive.
Goal True. idtac "LAMBDA_STARTUP_TYPE LamInitC.jet_program_initialization.initializer_alignedb_sound". exact I. Qed.
Check LamInitC.jet_program_initialization.initializer_alignedb_sound.
Goal True. idtac "LAMBDA_STARTUP_TYPE LamInitC.jet_program_initialization.program_initialization_checked". exact I. Qed.
Check LamInitC.jet_program_initialization.program_initialization_checked.
Goal True. idtac "LAMBDA_STARTUP_TYPE LamInitC.jet_secp_scalar_lambda_init_exists.secp_initialization_succeeds_true". exact I. Qed.
Check LamInitC.jet_secp_scalar_lambda_init_exists.secp_initialization_succeeds_true.
Goal True. idtac "LAMBDA_STARTUP_TYPE LamInitC.jet_secp_scalar_lambda_init_exists.secp_initial_memory_exists". exact I. Qed.
Check LamInitC.jet_secp_scalar_lambda_init_exists.secp_initial_memory_exists.
Goal True. idtac "LAMBDA_STARTUP_TYPE LamInitC.jet_secp_scalar_lambda_init_exists.scalar_lambda_initialized_memory_exists". exact I. Qed.
Check LamInitC.jet_secp_scalar_lambda_init_exists.scalar_lambda_initialized_memory_exists.
Goal True. idtac "LAMBDA_STARTUP_DEF LamInitC.jet_program_initialization.initializer_alignedb". exact I. Qed.
Print LamInitC.jet_program_initialization.initializer_alignedb.
Goal True. idtac "LAMBDA_STARTUP_DEF LamInitC.jet_program_initialization.initializer_referenceb". exact I. Qed.
Print LamInitC.jet_program_initialization.initializer_referenceb.
Goal True. idtac "LAMBDA_STARTUP_DEF LamInitC.jet_program_initialization.program_initialization_okb". exact I. Qed.
Print LamInitC.jet_program_initialization.program_initialization_okb.
Goal True. idtac "LAMBDA_STARTUP_DEF LamInitC.jet_secp_scalar_lambda_init_exists.secp_initialization_succeeds". exact I. Qed.
Print LamInitC.jet_secp_scalar_lambda_init_exists.secp_initialization_succeeds.
