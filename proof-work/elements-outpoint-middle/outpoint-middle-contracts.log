TAP_DEF OutpointMiddle.Common.op_pegin_type
Common.op_pegin_type = Ty.Sum Ty.Unit (Word.Word (S (S (S (S (S (S (S (S O)))))))))
     : Ty.Ty
TAP_DEF OutpointMiddle.Common.op_bytes
Common.op_bytes =
fun a : Ty.tySem Common.op_pegin_type =>
match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl _ =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) (Spec.nonce_byte BinNums.Z0) (@nil (Ty.tySem (Word.Word (S (S (S O))))))
| inr h =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) (Spec.nonce_byte (BinNums.Zpos BinNums.xH))
      (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
end
     : forall _ : Ty.tySem Common.op_pegin_type, list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments Common.op_bytes a
TAP_DEF OutpointMiddle.Common.op_count
Common.op_count =
fun a : Ty.tySem Common.op_pegin_type =>
match a return BinNums.Z with
| inl _ => BinNums.Zpos BinNums.xH
| inr _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
end
     : forall _ : Ty.tySem Common.op_pegin_type, BinNums.Z

Arguments Common.op_count a
TAP_DEF OutpointMiddle.Common.op_bit
Common.op_bit =
fun a : Ty.tySem Common.op_pegin_type => match a return bool with
                                         | inl _ => false
                                         | inr _ => true
                                         end
     : forall _ : Ty.tySem Common.op_pegin_type, bool

Arguments Common.op_bit a
TAP_DEF OutpointMiddle.Common.op_overflow
Common.op_overflow =
fun (ovf : bool) (c : Integers.Int64.int) (a : Ty.tySem Common.op_pegin_type) =>
match a return bool with
| inl _ => jet_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH))
| inr _ =>
    jet_sha_uchars_exec.uc_overflow
      (jet_sha_uchars_exec.uc_overflow ovf c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
      (Integers.Int64.add c (Integers.Int64.repr (BinNums.Zpos BinNums.xH)))
      (Integers.Int64.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
end
     : forall (_ : bool) (_ : Integers.Int64.int) (_ : Ty.tySem Common.op_pegin_type), bool

Arguments Common.op_overflow ovf%bool_scope c a
