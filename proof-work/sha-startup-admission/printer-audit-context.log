Coq < Constant C.jet_clight_forward.mem_forward
  (shorter name to refer to it in current context is jet_clight_forward.mem_forward)

Coq < jet_sha_startup_globals.sha_persistent_globals_forward
     : forall (m mf : Memory.Mem.mem) (_ : jet_sha_startup_globals.sha_persistent_global_state m)
         (_ : jet_clight_forward.mem_forward m mf) (_ : sha_globals_ok mf),
       jet_sha_startup_globals.sha_persistent_global_state mf

Coq < jet_sha_startup_state.small_object_extent_preserved
     : forall (m mf : Memory.Mem.mem) (_ : jet_clight_forward.mem_forward m mf) (b : Values.block) 
         (bound : BinNums.Z) (v : Values.val)
         (_ : @eq (option Values.val) (Memory.Mem.load AST.Mint8unsigned m b BinNums.Z0) (@Some Values.val v))
         (_ : forall (o : BinNums.Z) (p : Memtype.permission) (_ : Memory.Mem.perm m b o Memtype.Max p),
              and (BinInt.Z.le BinNums.Z0 o) (BinInt.Z.lt o bound)) (o : BinNums.Z) (p : Memtype.permission)
         (_ : Memory.Mem.perm mf b o Memtype.Max p), and (BinInt.Z.le BinNums.Z0 o) (BinInt.Z.lt o bound)

Coq < jet_sha_startup_state.sha_tags_state_frame_call
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor count : BinNums.Z) (_ : jet_clight_forward.mem_forward m mf)
         (_ : BinInt.Z.lt
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                count) (_ : write_frame_at m bf base bw edge cursor count)
         (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                (_ : or (not (@eq Values.block b bf))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                          (BinInt.Z.le
                             (BinInt.Z.add base
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                (_ : or (not (@eq Values.block b bw))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add edge
                                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                   (BinInt.Z.div (BinInt.Z.sub cursor count)
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                          (BinInt.Z.le
                             (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
         (_ : jet_sha_startup_state.sha_tags_state m), jet_sha_startup_state.sha_tags_state mf

Coq < jet_sha_startup_state.sha_startup_state_frame_call
     : forall (m mf : Memory.Mem.mem) (bf : Values.block) (base : BinNums.Z) (bw : Values.block)
         (edge cursor count : BinNums.Z) (_ : jet_clight_forward.mem_forward m mf)
         (_ : BinInt.Z.lt
                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                count) (_ : write_frame_at m bf base bw edge cursor count)
         (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                (_ : or (not (@eq Values.block b bf))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                          (BinInt.Z.le
                             (BinInt.Z.add base
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                (_ : or (not (@eq Values.block b bw))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add edge
                                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                   (BinInt.Z.div (BinInt.Z.sub cursor count)
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                          (BinInt.Z.le
                             (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
         (_ : jet_sha_startup_state.sha_startup_state m), jet_sha_startup_state.sha_startup_state mf

Coq < jet_sha_startup_setup.sha_startup_state_preserved
     : forall (m mf : Memory.Mem.mem) (_ : jet_sha_startup_state.sha_startup_state m)
         (_ : jet_clight_forward.mem_forward m mf)
         (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                (_ : @List.In Values.block b jet_sha_startup_setup.sha_state_blocks),
              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs)),
       jet_sha_startup_state.sha_startup_state mf

Coq < 
