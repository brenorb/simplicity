  jet_elements_prim.sigTxiIssuance txi
  return
    (Ty.tySem
       (Ty.Sum Ty.Unit
          (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Word.Word (S (S (S (S (S (S O))))))))))
with
| Some i =>
    match
      i
      return
        (Ty.tySem
           (Ty.Sum Ty.Unit
              (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                 (Word.Word (S (S (S (S (S (S O))))))))))
    with
    | inl new =>
        @inr unit
          (Ty.tySem
             (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Word.Word (S (S (S (S (S (S O)))))))))
          (jet_elements_amount_literal.encode_amount_literal
             (@jet_elements_prim.clearPrf (list Integers.Byte.int) Integers.Int64.int
                (jet_elements_prim.newIssuanceTokenAmount new)))
    | inr _ =>
        @inr unit
          (Ty.tySem
             (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Word.Word (S (S (S (S (S (S O)))))))))
          (jet_elements_amount_literal.encode_amount_literal
             (@jet_elements_prim.Explicit unit Integers.Int64.int Integers.Int64.zero))
    end
| None =>
    @inl unit
      (sum
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S O))))))))) tt
end
     : forall _ : jet_elements_prim.sigTxInput,
       Ty.tySem
         (Ty.Sum Ty.Unit
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S O)))))))))

