jet_elements_token_select.token_armed_shape
     : match Clight.fn_body jets_elements.f_issuanceTokenAmt return Prop with
       | Clight.Sskip => False
       | Clight.Sassign _ _ => False
       | Clight.Sset _ _ => False
       | Clight.Scall _ _ _ => False
       | Clight.Sbuiltin _ _ _ _ => False
       | Clight.Ssequence _ s0 =>
           match s0 return Prop with
           | Clight.Sskip => False
           | Clight.Sassign _ _ => False
           | Clight.Sset _ _ => False
           | Clight.Scall _ _ _ => False
           | Clight.Sbuiltin _ _ _ _ => False
           | Clight.Ssequence _ _ => False
           | Clight.Sifthenelse _ armed _ => @eq Clight.statement armed jet_elements_token_select.token_armed_stmt
           | Clight.Sloop _ _ => False
           | Clight.Sbreak => False
           | Clight.Scontinue => False
           | Clight.Sreturn _ => False
           | Clight.Sswitch _ _ => False
           | Clight.Slabel _ _ => False
           | Clight.Sgoto _ => False
           end
       | Clight.Sifthenelse _ _ _ => False
       | Clight.Sloop _ _ => False
       | Clight.Sbreak => False
       | Clight.Scontinue => False
       | Clight.Sreturn _ => False
       | Clight.Sswitch _ _ => False
       | Clight.Slabel _ _ => False
       | Clight.Sgoto _ => False
       end
