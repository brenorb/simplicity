From Coq Require Import List.
From compcert Require Import Integers.
Require Import C.jet_sx_expr SquareRun.Run SquareValue.Schedule SquareValue.Equality.
Import ListNotations.
Local Transparent Archi.ptr64.
Set Default Timeout 10.
Lemma square_r0_source : nth 0 square_limbs (XLv 0) = sq_r0.
Proof. Timeout 10 reflexivity. Qed.
Lemma square_r1_source : nth 1 square_limbs (XLv 0) = sq_r1.
Proof. Timeout 10 reflexivity. Qed.
Lemma square_r2_source : nth 2 square_limbs (XLv 0) = sq_r2.
Proof. Timeout 10 reflexivity. Qed.
Lemma square_r3_source : nth 3 square_limbs (XLv 0) = sq_r3.
Proof. Timeout 10 reflexivity. Qed.
Lemma square_r4_source : nth 4 square_limbs (XLv 0) = sq_r4.
Proof. apply sx_same_sound. Timeout 10 vm_compute. reflexivity. Qed.

