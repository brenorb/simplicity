Lemma tapleaf_hash_literal_parametric : PF.Parametric (@tapleaf_hash_literal_spec).
Proof.
  intros alg1 alg2 R.
  rewrite <- (tapleaf_hash_literal_matches alg1), <- (tapleaf_hash_literal_matches alg2).
  apply tapleaf_hash_spec_parametric.
Qed.

