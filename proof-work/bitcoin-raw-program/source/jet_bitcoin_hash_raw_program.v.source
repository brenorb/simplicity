(** Whole original-C hash getters against their original Simplicity programs
    interpreted on raw transaction/taproot data, not independent hash inputs.
    The shared transport preserves the complete separated frame contract. *)
From Coq Require Import ZArith List.
Require Import Simplicity.Ty Simplicity.Word Simplicity.Util.Option.
Require Import Simplicity.Primitive.Bitcoin C.jet_bitcoin_ext_prim.
Require Import C.jet_application_sep C.jets_bitcoin C.jet_bitcoin_linkage.
Require Import C.jet_bitcoin_full_prim C.jet_bitcoin_raw_env C.jet_bitcoin_raw_jets.
Require Import C.jet_bitcoin_hash_getter_local C.jet_bitcoin_words_hash.
Require Import C.jet_bitcoin_raw_program C.jet_bitcoin_tapleaf_hash_spec.
Require Import C.jet_bitcoin_tapleaf_hash_local C.jet_bitcoin_tapleaf_literal.
Require Import C.jet_bitcoin_composite_hash C.jet_bitcoin_tx_hash C.jet_bitcoin_sig_all_hash.
Local Open Scope Z_scope.
Set Default Timeout 10.

Theorem bitcoin_output_values_hash_raw_program_local_spec :
  application_jet_local_spec_sep f_simplicity_bitcoin_output_values_hash bitcoin_ge raw_bitcoin_environment
    Ty.Unit Word256
    (raw_env_rep (hash_getter_rep (fun e => words_hash_of 3 5 (output_values_of e)) 0 16 432))
    (fun a environment => @prim_words_hash_spec 3 5 (BitcoinFull.Base Bitcoin.OutputValue) raw_fullalg a environment).
Proof.
  apply application_raw_program_local_spec_sep; [apply prim_words_hash_spec_parametric|].
  exact bitcoin_output_values_hash_local_spec.
Qed.

