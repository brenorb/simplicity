+  intros (r & sh & d & ch & Hs & Hin & Hb & Hr); destruct r as [|[|r]].
+  - exists 1%nat,sh,d,ch; exact (conj Hs (conj Hin (conj Hb Hr))).
+  - exists 0%nat,sh,d,ch; exact (conj Hs (conj Hin (conj Hb Hr))).
+  - cbn [scalar_reduce512_initial_regs map nth_error] in Hs; destruct r; discriminate.
+Qed.
