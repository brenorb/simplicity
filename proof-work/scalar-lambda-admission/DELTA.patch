+      (v2 := Vint (Int.repr (if bit then 5 else 4))).
+    + apply eval_Econst_int.
+    + apply eval_Etempvar; exact HC.
+    + destruct bit; reflexivity.
+  - reflexivity.
+  - exact CALL.
+Qed.
