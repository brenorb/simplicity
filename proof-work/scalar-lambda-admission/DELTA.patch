+Lemma borrowed_product_reduce_foot_embed beta b ofs :
+  foot (product_reduce_layout beta) (map rshape scalar_reduce512_initial_regs) b ofs ->
+  foot beta (map rshape scalar_mul512_borrowed_regs) b ofs.
