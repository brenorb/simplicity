+  pose proof (Hsafe t2 (or_intror (or_introl eq_refl))) as (H2i & H2j & H2e & H2d).
+  pose proof (Hsafe t3 (or_intror (or_intror (or_introl eq_refl)))) as (H3i & H3j & H3e & H3d).
