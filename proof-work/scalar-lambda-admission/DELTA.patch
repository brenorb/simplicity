+      [Vptr (blk beta 1) (Ptrofs.repr (bas beta 1));
+       Vptr (blk beta 0) (Ptrofs.repr (bas beta 0))] E0 mf Vundef /\
+    rep (product_reduce_rho rho) (product_reduce_layout beta)
