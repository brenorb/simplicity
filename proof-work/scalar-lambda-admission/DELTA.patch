+  intros HR; pose proof HR as (_ & HV & _ & HC & _).
+  change (Mem.valid_block m scalar_lambda_block) in HV.
+  assert (HP : forall i x, nth_error [XLv 4;XLv 5;XLv 6;XLv 7] i = Some x ->
