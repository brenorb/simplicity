+(** Append to the right spine without changing the generated statement shape. *)
+Fixpoint elements_append_stmt (s tail : statement) : statement :=
+  match s with
+  | Ssequence a b => Ssequence a (elements_append_stmt b tail)
+  | _ => Ssequence s tail
+  end.
