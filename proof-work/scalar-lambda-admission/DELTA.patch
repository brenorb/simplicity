+  destruct (exec_elements_null_data_small_switch n e next m bd dbase bw edge cur Hn Hnone HD' Hcode HF)
+    as (mf & HC & HE).
+  exists mf. split; [|exact HE].
+  change E0 with (E0 ** E0). eapply exec_elements_append_stmt; [exact Hreload|exact HC].
+Qed.
