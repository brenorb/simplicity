+    - reflexivity. }
+  assert (HRfinal : rep (product_reduce_rho rho) [lay beta 0] (scalar_mul_caller_output rho) mf).
+  { eapply rep_mem; [|exact HRprefix]; eapply Mem.unchanged_on_implies; [exact HUF|].
