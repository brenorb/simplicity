+Definition elements_output_ops_expr (xp : ident) : expr :=
+  Efield (Efield (elements_indexed_deref xp _i _sigOutput) _pnd (Tstruct _parsedNullData noattr))
+    _op (tptr (Tstruct _opcode noattr)).
