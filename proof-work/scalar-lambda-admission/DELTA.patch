+  le!_env = Some (Vptr be (Ptrofs.repr ebase)) -> le!_i = Some (Vlong i) -> le!_j = Some (Vlong j) ->
+  elements_null_data_path_valid m be ebase bt txbase bout outbase bop opbase i j
+    (Int.repr (if bit then 5 else 4)) ->
