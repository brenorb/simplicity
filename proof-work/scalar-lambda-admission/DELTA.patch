+    (edge_ofs (active_read_loc L) - 8 * (1 + (read_padding (read_size (activeReadFrame s)) + q) / 64))
+    (edge_ofs (active_read_loc L) - 8 * (1 + (read_padding (read_size (activeReadFrame s)) + q) / 64) + 8).
