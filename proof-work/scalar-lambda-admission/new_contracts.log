DELTA_DEEP_TYPE C.jet_secp_scalar_mul512_borrowed.eval_scalar_mul512_borrowed
jet_secp_scalar_mul512_borrowed.eval_scalar_mul512_borrowed
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                     (@cons Values.val (Values.Vptr (blk beta (S (S O))) (Integers.Ptrofs.repr (bas beta (S (S O)))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and (rep rho beta jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_output_regs mf)
               (lframe
                  (fun (b : Values.block) (ofs : BinNums.Z) =>
                   not
                     (foot beta
                        (@List.map region
                           (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                           jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_regs) b ofs)) m mf)))
DELTA_DEEP_TYPE C.jet_secp_scalar_mul512_borrowed.eval_scalar_mul512_borrowed_product
jet_secp_scalar_mul512_borrowed.eval_scalar_mul512_borrowed_product
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : layout) (m : Memory.Mem.mem)
         (_ : rep rho beta jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_regs m),
       @ex Memory.Mem.mem
         (fun mf : Memory.Mem.mem =>
          and
            (ClightBigstep.Clight2.eval_funcall secp_ge m
               (@Ctypes.Internal Clight.function jets_secp.f_secp256k1_scalar_mul_512)
               (@cons Values.val (Values.Vptr (blk beta O) (Integers.Ptrofs.repr (bas beta O)))
                  (@cons Values.val (Values.Vptr (blk beta (S O)) (Integers.Ptrofs.repr (bas beta (S O))))
                     (@cons Values.val (Values.Vptr (blk beta (S (S O))) (Integers.Ptrofs.repr (bas beta (S (S O)))))
                        (@nil Values.val)))) Events.E0 mf Values.Vundef)
            (and
               (forall (i : nat) (x : Integers.Int64.int)
                  (_ : @eq (option Integers.Int64.int)
                         (@List.nth_error Integers.Int64.int (scalar_mul512_machine_outputs rho) i)
                         (@Some Integers.Int64.int x)),
                @eq (option Values.val)
                  (Memory.Mem.load AST.Mint64 mf (blk beta O)
                     (BinInt.Z.add (bas beta O)
                        (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                           (BinInt.Z.of_nat i)))) (@Some Values.val (Values.Vlong x)))
               (and
                  (@eq BinNums.Z (column_words_value (scalar_mul512_machine_outputs rho))
                     (BinInt.Z.mul (scalar_mul512_input_value rho O) (scalar_mul512_input_value rho (S (S (S (S O)))))))
                  (and (rep rho beta jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_output_regs mf)
                     (lframe
                        (fun (b : Values.block) (ofs : BinNums.Z) =>
                         not
                           (foot beta
                              (@List.map region
                                 (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z)) rshape
                                 jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_regs) b ofs)) m mf)))))
