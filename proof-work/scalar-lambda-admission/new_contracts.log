     : forall (m0 : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bw : Values.block)
         (outedge cursor N : BinNums.Z) (bi : Values.block) (edge : BinNums.Z) (m mr : Memory.Mem.mem)
         (ba bl : Values.block) (_ : jet_secp_scalar_lambda_global.scalar_lambda_global_rep m0)
         (_ : jet_secp_scalar_lambda_global.scalar_lambda_global_rep m)
         (_ : jet_clight_readonly_frame.readonly_region_bounds m jet_secp_scalar_lambda_global.scalar_lambda_block
                BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         (_ : not (@eq Values.block jet_secp_scalar_lambda_global.scalar_lambda_block ba))
         (_ : not (@eq Values.block jet_secp_scalar_lambda_global.scalar_lambda_block bl))
         (_ : ClightBigstep.Clight2.eval_funcall secp_ge m (@Ctypes.Internal Clight.function jets_secp.f_read_scalar)
                (@cons Values.val (Values.Vptr ba Integers.Ptrofs.zero)
                   (@cons Values.val (Values.Vptr bl Integers.Ptrofs.zero) (@nil Values.val))) Events.E0 mr
                Values.Vundef) (_ : finv m0 bd dbase bw outedge cursor N bi mr false (@nil Cell))
         (_ : lframe
                (frame (extA m0 bd bw bi)
                   (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z ba BinNums.Z0)
                      (@cons (prod Values.block BinNums.Z) (@pair Values.block BinNums.Z bl BinNums.Z0)
                         (@nil (prod Values.block BinNums.Z))))
                   (scalar_reader_initial_regs bi (Integers.Ptrofs.repr edge)) m) m mr),
