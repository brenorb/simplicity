DELTA_DEEP_TYPE C.jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_stack_rotate
jet_secp_scalar_mul_borrowed_alloc.scalar_mul_borrowed_stack_rotate
     : forall (rho : forall _ : nat, Integers.Int64.int) (beta : list (prod Values.block BinNums.Z))
         (m : Memory.Mem.mem) (bl : Values.block)
