DELTA_DEEP_TYPE C.jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_completes
jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_completes
     : @eq bool
         match jet_secp_scalar_mul512_borrowed.scalar_mul512_borrowed_run return bool with
         | Some r =>
             match r return bool with
             | RDone _ o =>
                 match o return bool with
                 | ONormal => true
                 | OBreak => false
                 | OContinue => false
                 | OReturn _ => false
                 end
             | RIf _ _ _ => false
             end
         | None => false
         end true
