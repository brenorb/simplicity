(** Actual caller allocation establishes the existing in-place body contract. *)
From Coq Require Import ZArith List Lia Bool.
From compcert Require Import Coqlib Integers AST Ctypes Clight ClightBigstep Maps Memory Events Values.
Require Import C.jet_sx_expr C.jet_sx_state C.jet_sx_eval C.jet_sx_exec C.jet_sx_rep C.jet_sx_mem.
Require Import C.jet_secp_linkage C.jets_secp C.jet_secp_canonical_scalar.
Require Import MulC.jet_secp_scalar_mul512_run MulC.jet_secp_scalar_mul512_fresh
  MulC.jet_secp_scalar_mul_caller_body MulC.jet_sx_u64_transport
  MulC.jet_secp_product_reduce_bridge.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.
Local Opaque secp_ge.

Definition scalar_mul_caller_inputs := tl scalar_mul512_initial_regs.
Definition scalar_mul_stack_layout (beta : layout) bl := (bl,0) :: beta.
Definition scalar_mul_stack_cells :=
  map (fun c => mkcell (cofs c) (cchunk c) None)
    (rcells (hd (mkreg [] false None) scalar_mul512_initial_regs)).

Lemma scalar_mul_stack_cells_ok :
  cells_sorted 0 scalar_mul_stack_cells = true /\
  Forall (fun c => cofs c + size_chunk (cchunk c) <= 64 /\
    (align_chunk (cchunk c) | cofs c) /\ cval c = None) scalar_mul_stack_cells.
Proof. repeat split; try reflexivity; repeat constructor; cbn; try lia;
  try (exists 0; reflexivity); try (exists 1; reflexivity);
  try (exists 2; reflexivity); try (exists 3; reflexivity);
  try (exists 4; reflexivity); try (exists 5; reflexivity);
  try (exists 6; reflexivity); try (exists 7; reflexivity).
Qed.

Lemma scalar_mul_inputs_valid rho beta m :
  rep rho beta scalar_mul_caller_inputs m ->
  forall b, In b (map fst beta) -> Mem.valid_block m b.
Proof.
  intros HR b Hin.
  assert (HL : length beta = 2%nat) by (destruct HR as (HL & _); exact HL).
  destruct beta as [|pa [|pb [|pc rest]]]; cbn in HL; try discriminate.
  cbn [map In] in Hin. destruct Hin as [<-|[<-|[]]].
  - pose proof (rep_region rho _ _ m 0 _ HR eq_refl) as (_ & Hv & _). exact Hv.
  - pose proof (rep_region rho _ _ m 1 _ HR eq_refl) as (_ & Hv & _). exact Hv.
Qed.

Lemma scalar_mul_stack_cell_reindex rho beta beta' m r r' :
  lay beta' r' = lay beta r ->
  region_ok rho beta m r (mkreg scalar_mul_stack_cells true (Some 64)) ->
  region_ok rho beta' m r' (mkreg scalar_mul_stack_cells true (Some 64)).
Proof.
  intros HE (HB & HV & HS & HC & HF).
  assert (EB : blk beta' r' = blk beta r) by (unfold blk; rewrite HE; reflexivity).
  assert (ES : bas beta' r' = bas beta r) by (unfold bas; rewrite HE; reflexivity).
  unfold region_ok; cbn [rw rfree rcells]. rewrite EB,ES.
  split; [exact HB|]. split; [exact HV|]. split; [exact HS|]. split; [|exact HF].
  apply Forall_forall; intros c Hin.
  pose proof (proj1 (Forall_forall _ _) HC c Hin) as (Hmax & Hal & Hp & Hval).
  pose proof (proj1 (Forall_forall _ _) (proj2 scalar_mul_stack_cells_ok) c Hin) as (_ & _ & Hnone).
  unfold cell_ok; rewrite EB,ES.
  split; [exact Hmax|]. split; [exact Hal|]. split; [exact Hp|].
  intros x Hx. rewrite Hnone in Hx. discriminate.
Qed.

Lemma scalar_mul_stack_rotate rho beta m bl :
  rep rho (beta ++ [(bl,0)])
    (scalar_mul_caller_inputs ++ [mkreg scalar_mul_stack_cells true (Some 64)]) m ->
  length beta = 2%nat ->
  rep rho (scalar_mul_stack_layout beta bl) scalar_mul512_fresh_regs m.
Proof.
  intros HR HL.
  destruct beta as [|pa [|pb [|pc rest]]]; cbn in HL; try discriminate.
  destruct HR as (_ & HS & HC).
  unfold rep; split; [reflexivity|]. split.
  - intros r1 r2 reg1 reg2 Hne E1 E2.
    destruct r1 as [|[|[|r1]]], r2 as [|[|[|r2]]];
      cbn [scalar_mul512_fresh_regs scalar_mul512_initial_regs nth_error tl] in E1,E2;
      try (destruct r1; discriminate E1); try (destruct r2; discriminate E2);
      try (exfalso; apply Hne; reflexivity); inversion E1; inversion E2; subst.
    + exact (HS 2%nat 0%nat _ _ ltac:(discriminate) eq_refl eq_refl).
    + exact (HS 2%nat 1%nat _ _ ltac:(discriminate) eq_refl eq_refl).
    + exact (HS 0%nat 2%nat _ _ ltac:(discriminate) eq_refl eq_refl).
    + exact (HS 0%nat 1%nat _ _ ltac:(discriminate) eq_refl eq_refl).
    + exact (HS 1%nat 2%nat _ _ ltac:(discriminate) eq_refl eq_refl).
    + exact (HS 1%nat 0%nat _ _ ltac:(discriminate) eq_refl eq_refl).
  - intros r reg E. destruct r as [|[|[|r]]];
      cbn [scalar_mul512_fresh_regs scalar_mul512_initial_regs nth_error tl] in E;
      try (destruct r; discriminate E); inversion E; subst reg.
    + apply scalar_mul_stack_cell_reindex with (beta := [pa;pb;(bl,0)]) (r := 2%nat).
      * reflexivity.
      * exact (HC 2%nat _ eq_refl).
    + eapply region_u64_transport with (beta := [pa;pb;(bl,0)]) (r := 0%nat)
        (rho := rho) (rho' := rho) (xs := [XLv 0;XLv 1;XLv 2;XLv 3])
        (ys := [XLv 0;XLv 1;XLv 2;XLv 3]) (w := true) (owned := Some 32).
      * reflexivity.
      * reflexivity.
      * reflexivity.
      * reflexivity.
      * exact (HC 0%nat _ eq_refl).
    + eapply region_u64_transport with (beta := [pa;pb;(bl,0)]) (r := 1%nat)
        (rho := rho) (rho' := rho) (xs := [XLv 4;XLv 5;XLv 6;XLv 7])
        (ys := [XLv 4;XLv 5;XLv 6;XLv 7]) (w := true) (owned := Some 32).
      * reflexivity.
      * reflexivity.
      * reflexivity.
      * reflexivity.
      * exact (HC 1%nat _ eq_refl).
Qed.

Theorem scalar_mul_caller_allocates rho beta m ma bl :
  rep rho beta scalar_mul_caller_inputs m ->
  Mem.alloc m 0 64 = (ma,bl) ->
  rep rho (scalar_mul_stack_layout beta bl) scalar_mul512_fresh_regs ma.
Proof.
  intros HR HA.
  assert (HL : length beta = 2%nat) by (destruct HR as (HL & _); exact HL).
  assert (Hnew : ~ In bl (map fst beta)).
  { intro Hin. apply (Mem.fresh_block_alloc _ _ _ _ _ HA).
    exact (scalar_mul_inputs_valid rho beta m HR bl Hin). }
  assert (HRA : rep rho beta scalar_mul_caller_inputs ma).
  { eapply rep_mem; [|exact HR].
    eapply Mem.unchanged_on_implies; [eapply Mem.alloc_unchanged_on; exact HA|].
    intros; exact I. }
  apply scalar_mul_stack_rotate; [|exact HL].
  apply rep_snoc; [exact HRA|exact Hnew| | |exact (proj1 scalar_mul_stack_cells_ok)|
    exact (proj2 scalar_mul_stack_cells_ok)|].
  - eapply Mem.valid_new_block; exact HA.
  - intros ofs Ho. eapply Mem.perm_alloc_2; [exact HA|exact Ho].
  - change (64 <= 18446744073709551615); lia.
Qed.
