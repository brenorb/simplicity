+              | x <= 0xFFFF = putWord8 0xFD >> putWord16le (fromIntegral x)
+              | x <= 0xFFFFFFFF = putWord8 0xFE >> putWord32le (fromIntegral x)
+              | x <= 0xFFFFFFFFFFFFFFFF = putWord8 0xFF >> putWord64le (fromIntegral x)
