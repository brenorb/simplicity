+  putVarInt (V.length (sigTxIn tx))
+  mapM_ putInput (sigTxIn tx)
+  putVarInt (V.length (sigTxOut tx))
+  mapM_ putOutput (sigTxOut tx)
+  putWord32le $ sigTxLock tx
