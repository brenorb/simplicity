+        'issuanceTokenAmt(dst, &env->tx->input[0].issuance);'),
+    (c, 'issuanceTokenAmt(dst, &env->tx->input[env->ix].issuance);',
+        'issuanceTokenAmt(dst, &env->tx->input[0].issuance);'),
