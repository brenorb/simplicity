CURRENT_SEQUENCE_DEF C.jet_application_contract.application_jet_local_spec
jet_application_contract.application_jet_local_spec =
fun (f : Clight.function) (ge : Clight.genv) (E : Set) (A B : Ty.Ty)
  (env_rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E), Prop)
  (spec : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)) =>
forall (logical_env : E) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
  (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
  (a : Ty.tySem A) (_ : env_rep m env logical_env) (_ : jet_frame_layout.frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : jet_frame_layout.frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
  (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (Translate.bitSize A))) Integers.Int64.max_unsigned)
  (_ : jet_encoding.frame_input_cells_at m bi edge read_cursor (@Translate.encode A a))
  (_ : jet_output_layout.write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (Translate.bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   @ex (Ty.tySem B)
     (fun value : Ty.tySem B =>
      and (@eq (option (Ty.tySem B)) (spec a logical_env) (@Some (Ty.tySem B) value))
        (and
           (ClightBigstep.Clight2.eval_funcall ge m (@Ctypes.Internal Clight.function f)
              (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                 (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                    (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
           (and (jet_encoding.frame_output_cells_at mf bw outedge cursor (@Translate.encode B value))
              (and (jet_output_layout.write_prefix_at m mf bw outedge cursor)
                 (and
                    (jet_frame_layout.frame_fields_at mf bd dbase bw outedge
                       (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B))))
                    (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                       (_ : Memory.Mem.valid_block m b)
                       (_ : or (not (@eq Values.block b bd))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    ofs)))
                       (_ : or (not (@eq Values.block b bw))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add outedge
                                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                          (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (Translate.bitSize B)))
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                     @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))))))))
     : forall (_ : Clight.function) (_ : Clight.genv) (E : Set) (A B : Ty.Ty)
         (_ : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E), Prop)
         (_ : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)), Prop

Arguments jet_application_contract.application_jet_local_spec f ge E%type_scope (A B)%ty_scope
  (env_rep spec)%function_scope
CURRENT_SEQUENCE_DEF C.jet_elements_current_jets.current_scalar_rep
jet_elements_current_jets.current_scalar_rep =
fun (A : Type) (elems_of : forall _ : jet_elements_prim.Elements.env, list A) (valz : forall _ : A, BinNums.Z)
  (sz voff adelta cdelta : BinNums.Z) (m : Memory.Mem.mem) (env : Values.val)
  (environment : jet_elements_prim.Elements.env) =>
@ex Values.block
  (fun be : Values.block =>
   @ex BinNums.Z
     (fun ebase : BinNums.Z =>
      @ex Values.block
        (fun bt : Values.block =>
         @ex BinNums.Z
           (fun txbase : BinNums.Z =>
            @ex Values.block
              (fun bin : Values.block =>
               @ex BinNums.Z
                 (fun inbase : BinNums.Z =>
                  @ex Integers.Int64.int
                    (fun nI : Integers.Int64.int =>
                     @ex Integers.Int64.int
                       (fun ixv : Integers.Int64.int =>
                        and (@eq Values.val env (Values.Vptr be (Integers.Ptrofs.repr ebase)))
                          (and (BinInt.Z.le BinNums.Z0 ebase)
                             (and
                                (BinInt.Z.le
                                   (BinInt.Z.add ebase
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH))))))))
                                   Integers.Ptrofs.max_unsigned)
                                (and (BinInt.Z.le BinNums.Z0 txbase)
                                   (and
                                      (BinInt.Z.le
                                         (BinInt.Z.add txbase
                                            (BinNums.Zpos
                                               (BinNums.xO
                                                  (BinNums.xO
                                                     (BinNums.xO
                                                        (BinNums.xI
                                                           (BinNums.xI
                                                              (BinNums.xI
                                                                 (BinNums.xI (BinNums.xI (BinNums.xO BinNums.xH)))))))))))
                                         Integers.Ptrofs.max_unsigned)
                                      (and (BinInt.Z.le BinNums.Z0 inbase)
                                         (and
                                            (BinInt.Z.le
                                               (BinInt.Z.add inbase
                                                  (BinInt.Z.mul sz (BinInt.Z.of_nat (@length A (elems_of environment)))))
                                               Integers.Ptrofs.max_unsigned)
                                            (and
                                               (@eq (option Values.val)
                                                  (Memory.Mem.load AST.Mptr m be (BinInt.Z.add ebase BinNums.Z0))
                                                  (@Some Values.val (Values.Vptr bt (Integers.Ptrofs.repr txbase))))
                                               (and
                                                  (@eq (option Values.val)
                                                     (Memory.Mem.load AST.Mptr m bt (BinInt.Z.add txbase adelta))
                                                     (@Some Values.val (Values.Vptr bin (Integers.Ptrofs.repr inbase))))
                                                  (and
                                                     (@eq (option Values.val)
                                                        (Memory.Mem.load AST.Mint64 m bt (BinInt.Z.add txbase cdelta))
                                                        (@Some Values.val (Values.Vlong nI)))
                                                     (and
                                                        (@eq (option Values.val)
                                                           (Memory.Mem.load AST.Mint64 m be
                                                              (BinInt.Z.add ebase
                                                                 (BinNums.Zpos
                                                                    (BinNums.xO
                                                                       (BinNums.xO
                                                                          (BinNums.xO
                                                                             (BinNums.xO
                                                                                (BinNums.xI (BinNums.xO BinNums.xH)))))))))
                                                           (@Some Values.val (Values.Vlong ixv)))
                                                        (and
                                                           (@eq BinNums.Z (Integers.Int64.unsigned nI)
                                                              (BinInt.Z.of_nat (@length A (elems_of environment))))
                                                           (and
                                                              (@eq BinNums.Z (Integers.Int64.unsigned ixv)
                                                                 (BinInt.Z.of_nat
                                                                    (jet_elements_prim.Elements.envIx environment)))
                                                              (forall (j : nat) (x : A)
                                                                 (_ : @eq (option A)
                                                                        (@List.nth_error A (elems_of environment) j)
                                                                        (@Some A x)),
                                                               @eq (option Values.val)
                                                                 (Memory.Mem.load AST.Mint64 m bin
                                                                    (BinInt.Z.add
                                                                       (BinInt.Z.add inbase
                                                                          (BinInt.Z.mul sz (BinInt.Z.of_nat j))) voff))
                                                                 (@Some Values.val
                                                                    (Values.Vlong (Integers.Int64.repr (valz x)))))))))))))))))))))))))
     : forall (A : Type) (_ : forall _ : jet_elements_prim.Elements.env, list A) (_ : forall _ : A, BinNums.Z)
         (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : BinNums.Z) (_ : Memory.Mem.mem) 
         (_ : Values.val) (_ : jet_elements_prim.Elements.env), Prop

Arguments jet_elements_current_jets.current_scalar_rep {A}%type_scope (elems_of valz)%function_scope
  (sz voff adelta cdelta)%Z_scope m env environment
