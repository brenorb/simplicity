jet_elements_const_bits.elements_const_bits =
fix elements_const_bits (bits : list bool) : Clight.statement :=
  match bits return Clight.statement with
  | nil => Clight.Sbreak
  | cons bit rest => Clight.Ssequence (jet_elements_const_bits.elements_const_bit bit) (elements_const_bits rest)
  end
     : forall _ : list bool, Clight.statement

