TAP_DEF CalculationLifecycle.Shape.calc_suffix_values
Shape.calc_suffix_values =
fun p : option BinNums.Z =>
match p return (list Values.val) with
| Some z => @cons Values.val (Values.Vint (Integers.Int.repr z)) (@nil Values.val)
| None => @nil Values.val
end
     : forall _ : option BinNums.Z, list Values.val

Arguments Shape.calc_suffix_values p
TAP_DEF CalculationLifecycle.Shape.calc_copy_src
Shape.calc_copy_src =
Clight.Sassign (Clight.Evar jets_elements._src Shape.calc_fr) (Clight.Etempvar jets_elements._src Shape.calc_fr)
     : Clight.statement
TAP_DEF CalculationLifecycle.Shape.calc_read
Shape.calc_read =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._read32s
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr Ctypesdefs.tuint)
           (Ctypes.Tcons Ctypesdefs.tulong (Ctypes.Tcons (Ctypesdefs.tptr Shape.calc_fr) Ctypes.Tnil)))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr
     (Clight.Efield (Clight.Evar jets_elements._entropy Shape.calc_mid) jets_elements._s
        (Ctypesdefs.tarray Ctypesdefs.tuint (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (@cons Clight.expr
        (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
           Ctypesdefs.tint)
        (@cons Clight.expr
           (Clight.Eaddrof (Clight.Evar jets_elements._src Shape.calc_fr) (Ctypesdefs.tptr Shape.calc_fr))
           (@nil Clight.expr))))
     : Clight.statement
TAP_DEF CalculationLifecycle.Shape.calc_helper_call
Shape.calc_helper_call =
fun (jid : AST.ident) (p : option BinNums.Z) =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jid
     (Ctypes.Tfunction (Ctypes.Tcons Shape.calc_mid_ptr (Ctypes.Tcons Shape.calc_mid_ptr (Shape.calc_suffix_types p)))
        Ctypesdefs.tvoid Shape.calc_cc))
  (@app Clight.expr
     (@cons Clight.expr (Clight.Eaddrof (Clight.Evar jets_elements.__res Shape.calc_mid) Shape.calc_mid_ptr)
        (@cons Clight.expr (Clight.Eaddrof (Clight.Evar jets_elements._entropy Shape.calc_mid) Shape.calc_mid_ptr)
           (@nil Clight.expr))) (Shape.calc_suffix_exprs p))
     : forall (_ : AST.ident) (_ : option BinNums.Z), Clight.statement

Arguments Shape.calc_helper_call jid p
TAP_DEF CalculationLifecycle.Shape.calc_copy_result
Shape.calc_copy_result =
