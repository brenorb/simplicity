     : Clight.statement
TAP_DEF CalculationLifecycle.Shape.calc_write
Shape.calc_write =
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._writeHash
     (Ctypes.Tfunction (Ctypes.Tcons (Ctypesdefs.tptr Shape.calc_fr) (Ctypes.Tcons Shape.calc_mid_ptr Ctypes.Tnil))
        Ctypesdefs.tvoid AST.cc_default))
  (@cons Clight.expr (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr Shape.calc_fr))
     (@cons Clight.expr (Clight.Eaddrof (Clight.Evar jets_elements._result Shape.calc_mid) Shape.calc_mid_ptr)
