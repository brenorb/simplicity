     : Clight.statement
TAP_DEF CalculationLifecycle.Shape.calc_body
Shape.calc_body =
fun (jid : AST.ident) (p : option BinNums.Z) =>
Clight.Ssequence Shape.calc_copy_src
  (Clight.Ssequence Shape.calc_read
     (Clight.Ssequence (Clight.Ssequence (Shape.calc_helper_call jid p) Shape.calc_copy_result)
        (Clight.Ssequence Shape.calc_write
           (Clight.Sreturn
              (@Some Clight.expr (Clight.Econst_int (Integers.Int.repr (BinNums.Zpos BinNums.xH)) Ctypesdefs.tint))))))
     : forall (_ : AST.ident) (_ : option BinNums.Z), Clight.statement

Arguments Shape.calc_body jid p
