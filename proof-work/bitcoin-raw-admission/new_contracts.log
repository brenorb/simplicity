jet_bitcoin_raw_program.raw_full_sem =
fun (A B : Ty.Ty) (p : BitcoinFull.t A B) (a : Ty.tySem A) (environment : raw_bitcoin_environment) =>
match p in (BitcoinFull.prim A0 B0) return (forall _ : Ty.tySem A0, option (Ty.tySem B0)) with
| @BitcoinFull.Base A0 B0 q => fun a0 : Ty.tySem A0 => @Bitcoin.Bitcoin.sem A0 B0 q a0 (raw_base environment)
| @BitcoinFull.Ext A0 B0 q => fun a0 : Ty.tySem A0 => @raw_ext_sem A0 B0 q a0 environment
end a
     : forall (A B : Ty.Ty) (_ : BitcoinFull.t A B) (_ : Ty.tySem A) (_ : raw_bitcoin_environment), option (Ty.tySem B)

