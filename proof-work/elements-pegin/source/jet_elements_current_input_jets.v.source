Local Open Scope Z_scope.
Local Transparent Archi.ptr64.
Local Opaque elements_ge ge0.
Set Default Timeout 60.

Local Notation ConfTy a := (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) Word256) a).

Theorem elements_current_input_ptr (nbits : Z) (pcells : sigTxInput -> list Cell)
    (elemrep : mem -> block -> Z -> sigTxInput -> Prop) (Bpay : Ty) (cid : ident) (pt : type)
    (poff psz : Z) (pexpr : expr) (cf f : function)
    (Hnb : 1 <= nbits <= 1000) (Hpty : typeof pexpr = tptr pt)
    (Hnone : forall bl, (elements_version_locals bl)!cid = None)
    (Hsym : Genv.find_symbol (Clight.genv_genv elements_ge) cid = Some (elements_symbol_block cid))
    (Hfun : Genv.find_funct (Clight.genv_genv elements_ge) (Vptr (elements_symbol_block cid) Ptrofs.zero) =
      Some (Internal cf))
    (Hty : type_of_fundef (Internal cf) =
      Tfunction (Tcons (tptr (Tstruct _frameItem noattr)) (Tcons (tptr pt) Tnil)) tvoid cc_default)
    (Hpoff : 0 <= poff /\ poff + psz <= 544)
    (Hpres : forall m1 m2 b ofs x, elemrep m1 b ofs x ->
      (forall chunk o v, ofs <= o -> o + size_chunk chunk <= ofs + psz ->
        Mem.load chunk m1 b o = Some v -> Mem.load chunk m2 b o = Some v) -> elemrep m2 b ofs x)
    (Hpay : forall bd dbase bw outedge m' bin ofs x cur, elemrep m' bin ofs x -> 0 <= ofs ->
      ofs + psz <= Ptrofs.max_unsigned ->
      out_sep bd dbase bw outedge cur nbits bin ofs (ofs + psz) ->
      write_frame_at m' bd dbase bw outedge cur nbits ->
      exists me, Clight2.eval_funcall elements_ge m' (Internal cf)
        [Vptr bd (Ptrofs.repr dbase); Vptr bin (Ptrofs.repr ofs)] E0 me Vundef /\
        write_effect m' me bd dbase bw outedge cur nbits (pcells x))
    (Hptr : forall e le' m' bin inbase ixv,
      le'!_t'2 = Some (Vptr bin (Ptrofs.repr inbase)) -> le'!_t'3 = Some (Vlong ixv) ->
      0 <= inbase -> inbase + 544 * Int64.unsigned ixv + poff + psz <= Ptrofs.max_unsigned ->
      eval_expr elements_ge e le' m' pexpr (Vptr bin (Ptrofs.repr (inbase + 544 * Int64.unsigned ixv + poff))))
    (Hshape : elements_wrapper_shape f
      (elements_current_ptr_rest _t'1 _t'2 _t'3 _t'4 _t'5 _t'6 _input _numInputs _sigInput pexpr cid pt))
    (HB : Z.of_nat (bitSize Bpay) = nbits)
    (t : Ty.tySem Word32 -> Elements.env -> option (Ty.tySem (Ty.Sum Ty.Unit Bpay)))
    (fres : sigTxInput -> Ty.tySem Bpay)
    (Hres : forall a e, t a e = Some (match nth_error (sigTxIn (Elements.envTx e)) (Z.to_nat (toZ a)) with
                                      | Some txi => inr (fres txi)
                                      | None => inl tt
                                      end))
    (Henc : forall txi, encode (fres txi) = pcells txi)
    (Hlen : forall x, Z.of_nat (length (pcells x)) = nbits) :
  application_jet_local_spec_sep f elements_ge Elements.env Ty.Unit Bpay
    (current_ptr_rep (fun e => sigTxIn (Elements.envTx e)) Elements.envIx elemrep 544 poff 0 696)
    (fun a environment => @elements_current_spec (PrimitivePrimSem option_Monad_Zero) Bpay t a environment).
Proof.
  refine (elements_current_ptr_local (fun e => sigTxIn (Elements.envTx e)) Elements.envIx nbits pcells elemrep
    Bpay _t'1 _t'2 _t'3 _t'4 _t'5 _t'6 _input _numInputs _sigInput cid pt 696 0 544 poff psz pexpr cf f
    ltac:(discriminate) ltac:(discriminate) ltac:(discriminate) ltac:(discriminate) ltac:(discriminate)
    ltac:(discriminate) ltac:(discriminate) ltac:(discriminate) ltac:(discriminate) ltac:(discriminate)
    ltac:(discriminate) ltac:(discriminate) ltac:(discriminate) ltac:(discriminate)
    Hnb Hpty Hnone Hsym Hfun Hty
    elements_elementsTransaction_numInputs elements_elementsTransaction_input
    ltac:(split; lia) ltac:(split; lia) ltac:(split; lia) Hpoff
    Hpres Hpay Hptr Hshape HB _ _ Hlen).
  intros environment. destruct (elements_current_sem t fres Hres environment) as (txi & Hn & Hs).
  exists txi, (fres txi). split; [exact Hn|]. split; [exact Hs|apply Henc].
Qed.

(** * Shared payload contracts *)

Lemma hash_words_pres (W : sigTxInput -> list int) (HW : forall x, length (W x) = 8%nat) :
  forall m1 m2 b ofs x, uint32_array_at m1 b ofs (W x) ->
    (forall chunk o v, ofs <= o -> o + size_chunk chunk <= ofs + 32 ->
      Mem.load chunk m1 b o = Some v -> Mem.load chunk m2 b o = Some v) -> uint32_array_at m2 b ofs (W x).
Proof. intros m1 m2 b ofs x Hr Hl. eapply uint32_array_at_mono; [apply HW|exact Hr|exact Hl]. Qed.

Lemma hash_words_runs (W : sigTxInput -> list int) (HW : forall x, length (W x) = 8%nat) :
  forall bd dbase bw outedge m' bin ofs x cur, uint32_array_at m' bin ofs (W x) -> 0 <= ofs ->
    ofs + 32 <= Ptrofs.max_unsigned ->
    out_sep bd dbase bw outedge cur 256 bin ofs (ofs + 32) ->
    write_frame_at m' bd dbase bw outedge cur 256 ->
    exists me, Clight2.eval_funcall elements_ge m' (Internal f_writeHash)
      [Vptr bd (Ptrofs.repr dbase); Vptr bin (Ptrofs.repr ofs)] E0 me Vundef /\
      write_effect m' me bd dbase bw outedge cur 256 (hash_cells (W x)).
Proof.
  intros bd dbase bw outedge m' bin ofs x cur Hr H0 HM HSep HF.
  exact (eval_elements_writeHash_layout m' bin ofs bd dbase bw outedge cur (W x) (HW x) H0 ltac:(lia) HSep Hr HF).
Qed.

Lemma hash_words_len (W : sigTxInput -> list int) (HW : forall x, length (W x) = 8%nat) :
  forall x, Z.of_nat (length (hash_cells (W x))) = 256.
Proof. intros x. apply hash_cells_length_Z. apply HW. Qed.

Lemma outpoint_rep_pres : forall m1 m2 b ofs x, outpoint_rep m1 b ofs x ->
  (forall chunk o v, ofs <= o -> o + size_chunk chunk <= ofs + 40 ->
    Mem.load chunk m1 b o = Some v -> Mem.load chunk m2 b o = Some v) -> outpoint_rep m2 b ofs x.
Proof.
  intros m1 m2 b ofs x [Hr Hix] Hl. split.
  - eapply uint32_array_at_mono; [unfold outpoint_words; exact (hash256_len _)|exact Hr|].
    intros chunk o v H1 H2. apply Hl; [exact H1|lia].
  - apply (Hl Mint64 (ofs + 32) _); [lia|change (size_chunk Mint64) with 8; lia|exact Hix].
Qed.

Lemma outpoint_rep_runs : forall bd dbase bw outedge m' bin ofs x cur, outpoint_rep m' bin ofs x -> 0 <= ofs ->
  ofs + 40 <= Ptrofs.max_unsigned ->
  out_sep bd dbase bw outedge cur 288 bin ofs (ofs + 40) ->
  write_frame_at m' bd dbase bw outedge cur 288 ->
  exists me, Clight2.eval_funcall elements_ge m' (Internal f_prevOutpoint)
    [Vptr bd (Ptrofs.repr dbase); Vptr bin (Ptrofs.repr ofs)] E0 me Vundef /\
    write_effect m' me bd dbase bw outedge cur 288 (outpoint_pcells x).
Proof.
  intros bd dbase bw outedge m' bin ofs x cur [Hr Hix] H0 HM HSep HF.
  exact (eval_elements_prevOutpoint_layout m' bin ofs bd dbase bw outedge cur (outpoint_words x)
    (outpoint_ix (sigTxiPreviousOutpoint x))
    ltac:(unfold outpoint_words; exact (hash256_len _)) H0 ltac:(lia) HSep Hr Hix HF).
Qed.

Lemma encode_outpoint_cells txi :
  @encode (Ty.Prod Word256 Word32)
    (from_hash256 (opHash (sigTxiPreviousOutpoint txi)),
     @fromZ (WordToZ 5) (Int.unsigned (opIndex (sigTxiPreviousOutpoint txi)))) = outpoint_pcells txi.
Proof.
  unfold outpoint_pcells, elements_outpoint_cells, outpoint_words, outpoint_ix.
  rewrite encode_prod_word256_word32. rewrite encode_from_hash256. f_equal.
  rewrite decode_wide32_unsigned.
  - reflexivity.
  - pose proof (Int.unsigned_range (opIndex (sigTxiPreviousOutpoint txi))) as H.
    change Int.modulus with 4294967296 in H. exact H.
Qed.

Lemma input_asset_rep_pres : forall m1 m2 b ofs (x : sigTxInput), asset_rep m1 b ofs (utxoAsset (sigTxiTxo x)) ->
  (forall chunk o v, ofs <= o -> o + size_chunk chunk <= ofs + 36 ->
    Mem.load chunk m1 b o = Some v -> Mem.load chunk m2 b o = Some v) ->
  asset_rep m2 b ofs (utxoAsset (sigTxiTxo x)).
Proof. intros m1 m2 b ofs x Hr Hl. exact (asset_rep_mono m1 m2 b ofs _ Hr Hl). Qed.

Lemma input_asset_rep_runs : forall bd dbase bw outedge m' bin ofs (x : sigTxInput) cur,
  asset_rep m' bin ofs (utxoAsset (sigTxiTxo x)) -> 0 <= ofs -> ofs + 36 <= Ptrofs.max_unsigned ->
  out_sep bd dbase bw outedge cur 258 bin ofs (ofs + 36) ->
  write_frame_at m' bd dbase bw outedge cur 258 ->
  exists me, Clight2.eval_funcall elements_ge m' (Internal f_asset)
    [Vptr bd (Ptrofs.repr dbase); Vptr bin (Ptrofs.repr ofs)] E0 me Vundef /\
    write_effect m' me bd dbase bw outedge cur 258 (asset_pcells (utxoAsset (sigTxiTxo x))).
Proof.
  intros bd dbase bw outedge m' bin ofs x cur Hr H0 HM HSep HF.
  exact (asset_rep_runs bd dbase bw outedge m' bin ofs _ cur Hr H0 HM HSep HF).
Qed.

Section IssuanceHash.
Variables (K : int) (delta : Z) (gh : option issuance -> option hash256) (pexpr_h : expr).
Hypothesis Hg : forall o, Int.eq K (issuance_tag o) = opt_is_some (gh o).
Hypothesis Hd : 0 <= delta /\ delta + 32 <= 280.
Hypothesis Hpty : typeof pexpr_h = tptr (Tstruct _sha256_midstate noattr).
Hypothesis Hpexpr : forall e le m' bi ibase, le!_issuance = Some (Vptr bi (Ptrofs.repr ibase)) ->
  0 <= ibase -> ibase + 280 <= Ptrofs.max_unsigned ->
  eval_expr elements_ge e le m' pexpr_h (Vptr bi (Ptrofs.repr (ibase + delta))).

Lemma issuance_hash_rep_pres : forall m1 m2 b ofs x, issuance_hash_rep delta gh m1 b ofs x ->
  (forall chunk o v, ofs <= o -> o + size_chunk chunk <= ofs + 280 ->
    Mem.load chunk m1 b o = Some v -> Mem.load chunk m2 b o = Some v) -> issuance_hash_rep delta gh m2 b ofs x.
Proof.
  intros m1 m2 b ofs x [Ht Hh] Hl. split.
  - apply (Hl Mint32 (ofs + 272) _); [lia|change (size_chunk Mint32) with 4; lia|exact Ht].
  - intros h Hgh. eapply uint32_array_at_mono; [exact (hash256_len h)|exact (Hh h Hgh)|].
    intros chunk o v H1 H2. apply Hl; lia.
Qed.

Lemma issuance_hash_rep_runs : forall bd dbase bw outedge m' bin ofs x cur,
  issuance_hash_rep delta gh m' bin ofs x -> 0 <= ofs -> ofs + 280 <= Ptrofs.max_unsigned ->
  out_sep bd dbase bw outedge cur 257 bin ofs (ofs + 280) ->
  write_frame_at m' bd dbase bw outedge cur 257 ->
  exists me, Clight2.eval_funcall elements_ge m'
    (Internal (issuance_tagged_fun Oeq K pexpr_h _writeHash (Tstruct _sha256_midstate noattr) 256))
    [Vptr bd (Ptrofs.repr dbase); Vptr bin (Ptrofs.repr ofs)] E0 me Vundef /\
    write_effect m' me bd dbase bw outedge cur 257 (issuance_hash_pcells gh x).
Proof.
  intros bd dbase bw outedge m' bin ofs x cur [Ht Hh] H0 HM HSep HF.
  pose proof HF as [_ [_ [_ [HCur _]]]].
  unfold issuance_hash_pcells. rewrite <- (Hg (sigTxiIssuance x)).
  refine (eval_elements_issuance_tagged Oeq K pexpr_h _writeHash (Tstruct _sha256_midstate noattr) f_writeHash
    256 (Int.eq K) _ m' bin ofs bd dbase bw outedge cur (issuance_tag (sigTxiIssuance x)) (ofs + delta)
    (fun t mm => elements_eq_cmp K t mm) Hpty elements_writeHash_symbol elements_writeHash_funct
    ltac:(reflexivity) ltac:(lia) H0 HM HSep Ht HF
    (fun e le mm HI => Hpexpr e le mm bin ofs HI H0 HM) _).
  intros Hb mb HLoadB HFb.
  rewrite (Hg (sigTxiIssuance x)) in Hb.
  destruct (gh (sigTxiIssuance x)) as [h|] eqn:Hgh; [|discriminate Hb].
  assert (HAb : uint32_array_at mb bin (ofs + delta) (hash256_reg h)).
  { intros i w Hi.
    assert (Hi8 : (i < 8)%nat) by (rewrite <- (hash256_len h); apply nth_error_Some; rewrite Hi; discriminate).
    rewrite HLoadB by (try change (size_chunk Mint32) with 4; lia). exact (Hh h eq_refl i w Hi). }
  assert (HSepH : out_sep bd dbase bw outedge (cur - 1) 256 bin (ofs + delta) (ofs + delta + 32)).
  { eapply out_sep_range with (lo := ofs) (hi := ofs + 280); [|lia|lia].
    eapply out_sep_sub with (cursor := cur) (count := 1 + 256); [lia|lia|lia|lia|exact HSep]. }
  exact (eval_elements_writeHash_layout mb bin (ofs + delta) bd dbase bw outedge (cur - 1) (hash256_reg h)
    (hash256_len h) ltac:(lia) ltac:(lia) HSepH HAb HFb).
Qed.

Lemma encode_issuance_hash_cells txi :
  @encode (Ty.Sum Ty.Unit Word256)
    (match gh (sigTxiIssuance txi) with Some h => inr (from_hash256 h) | None => inl tt end) =
    issuance_hash_pcells gh txi.
Proof.
  unfold issuance_hash_pcells, issuance_tagged_cells.
  destruct (gh (sigTxiIssuance txi)) as [h|]; cbn [opt_is_some].
  - rewrite encode_sum_inr_hash, encode_from_hash256. reflexivity.
  - reflexivity.
Qed.
End IssuanceHash.

Lemma issuance_amount_rep_pres : forall m1 m2 b ofs x, issuance_amount_rep m1 b ofs x ->
  (forall chunk o v, ofs <= o -> o + size_chunk chunk <= ofs + 280 ->
    Mem.load chunk m1 b o = Some v -> Mem.load chunk m2 b o = Some v) -> issuance_amount_rep m2 b ofs x.
Proof.
  intros m1 m2 b ofs x [Ht Hh] Hl. split.
  - apply (Hl Mint32 (ofs + 272) _); [lia|change (size_chunk Mint32) with 4; lia|exact Ht].
  - intros i Hi. eapply amount_rep_mono; [exact (Hh i Hi)|].
    intros chunk o v H1 H2. apply Hl; lia.
Qed.

Lemma issuance_amount_rep_runs : forall bd dbase bw outedge m' bin ofs x cur,
  issuance_amount_rep m' bin ofs x -> 0 <= ofs -> ofs + 280 <= Ptrofs.max_unsigned ->
  out_sep bd dbase bw outedge cur 259 bin ofs (ofs + 280) ->
  write_frame_at m' bd dbase bw outedge cur 259 ->
  exists me, Clight2.eval_funcall elements_ge m'
    (Internal (issuance_tagged_fun One (Int.repr 0) assetamt_pexpr _amt (Tstruct _confAmount noattr) 258))
    [Vptr bd (Ptrofs.repr dbase); Vptr bin (Ptrofs.repr ofs)] E0 me Vundef /\
    write_effect m' me bd dbase bw outedge cur 259 (issuance_amount_pcells x).
Proof.
  intros bd dbase bw outedge m' bin ofs x cur [Ht Hh] H0 HM HSep HF.
  pose proof HF as [_ [_ [_ [HCur _]]]].
  unfold issuance_amount_pcells. rewrite <- (issuance_tag_present (sigTxiIssuance x)).
  refine (eval_elements_issuance_tagged One (Int.repr 0) assetamt_pexpr _amt (Tstruct _confAmount noattr) f_amt
    258 (fun t => negb (Int.eq (Int.repr 0) t)) _ m' bin ofs bd dbase bw outedge cur
    (issuance_tag (sigTxiIssuance x)) (ofs + 232)
    (fun t mm => elements_ne_cmp (Int.repr 0) t mm) ltac:(reflexivity) elements_amt_symbol elements_amt_funct
    ltac:(reflexivity) ltac:(lia) H0 HM HSep Ht HF
    (fun e le mm HI => eval_elements_issuance_field_addr e le mm _assetAmt 232 _confAmount bin ofs
      elements_assetIssuance_assetAmt H0 ltac:(lia) ltac:(lia) HI) _).
  intros Hb mb HLoadB HFb.
  rewrite (issuance_tag_present (sigTxiIssuance x)) in Hb.
  destruct (sigTxiIssuance x) as [i|] eqn:Hiss; [|discriminate Hb].
  assert (HRb : amount_rep mb bin (ofs + 232) (clearPrf (issuance_amount i))).
  { eapply amount_rep_mono; [exact (Hh i eq_refl)|].
    intros chunk o v H1 H2 Hl. rewrite HLoadB by lia. exact Hl. }
  assert (HSepA : out_sep bd dbase bw outedge (cur - 1) 258 bin (ofs + 232) (ofs + 232 + 40)).
  { eapply out_sep_range with (lo := ofs) (hi := ofs + 280); [|lia|lia].
    eapply out_sep_sub with (cursor := cur) (count := 1 + 258); [lia|lia|lia|lia|exact HSep]. }
  exact (amount_rep_runs bd dbase bw outedge mb bin (ofs + 232) _ (cur - 1) HRb ltac:(lia) ltac:(lia) HSepA HFb).
Qed.

Lemma encode_issuance_amount_cells txi :
  @encode (Ty.Sum Ty.Unit (ConfTy Word64))
    (match sigTxiIssuance txi with
     | Some i => inr (encode_amount (clearPrf (issuance_amount i)))
     | None => inl tt
     end) = issuance_amount_pcells txi.
Proof.
  unfold issuance_amount_pcells, issuance_tagged_cells.
  destruct (sigTxiIssuance txi) as [i|]; cbn [opt_is_some].
  - change (@encode (Ty.Sum Ty.Unit (ConfTy Word64)) (inr (encode_amount (clearPrf (issuance_amount i)))))
      with (Some true :: @encode (ConfTy Word64) (encode_amount (clearPrf (issuance_amount i)))).
    rewrite encode_amount_cells. reflexivity.
  - reflexivity.
Qed.

Lemma gh_blinding_tag o : Int.eq (Int.repr 2) (issuance_tag o) = opt_is_some (gh_blinding o).
Proof. destruct o as [[new|re]|]; reflexivity. Qed.
Lemma gh_contract_tag o : Int.eq (Int.repr 1) (issuance_tag o) = opt_is_some (gh_contract o).
Proof. destruct o as [[new|re]|]; reflexivity. Qed.
Lemma gh_entropy_tag o : Int.eq (Int.repr 2) (issuance_tag o) = opt_is_some (gh_entropy o).
Proof. destruct o as [[new|re]|]; reflexivity. Qed.

Lemma blinding_pexpr_eval : forall e le m' bi ibase, le!_issuance = Some (Vptr bi (Ptrofs.repr ibase)) ->
  0 <= ibase -> ibase + 280 <= Ptrofs.max_unsigned ->
  eval_expr elements_ge e le m' blinding_pexpr (Vptr bi (Ptrofs.repr (ibase + 0))).
Proof.
  intros e le m' bi ibase HI H0 HM. rewrite Z.add_0_r.
  exact (eval_elements_issuance_union_hash e le m' _anon_union2 __4841 _blindingNonce bi ibase
    elements_issuance_union_re elements_issuance_blindingNonce HI).
Qed.
Lemma contract_pexpr_eval : forall e le m' bi ibase, le!_issuance = Some (Vptr bi (Ptrofs.repr ibase)) ->
  0 <= ibase -> ibase + 280 <= Ptrofs.max_unsigned ->
  eval_expr elements_ge e le m' contract_pexpr (Vptr bi (Ptrofs.repr (ibase + 0))).
Proof.
  intros e le m' bi ibase HI H0 HM. rewrite Z.add_0_r.
  exact (eval_elements_issuance_union_hash e le m' _anon_union __4840 _contractHash bi ibase
    elements_issuance_union_new elements_issuance_contractHash HI).
Qed.
Lemma entropy_pexpr_eval : forall e le m' bi ibase, le!_issuance = Some (Vptr bi (Ptrofs.repr ibase)) ->
  0 <= ibase -> ibase + 280 <= Ptrofs.max_unsigned ->
  eval_expr elements_ge e le m' entropy_pexpr (Vptr bi (Ptrofs.repr (ibase + 72))).
Proof.
  intros e le m' bi ibase HI H0 HM.
  exact (eval_elements_issuance_field_addr e le m' _entropy 72 _sha256_midstate bi ibase
    elements_assetIssuance_entropy H0 ltac:(lia) ltac:(lia) HI).
Qed.

Lemma utxo_script_hash_words_len x : length (utxo_script_hash_words x) = 8%nat.
Proof. exact (hash256_len _). Qed.
Lemma script_sig_hash_words_len x : length (script_sig_hash_words x) = 8%nat.
Proof. exact (hash256_len _). Qed.
Lemma issuance_asset_proof_words_len x : length (issuance_asset_proof_words x) = 8%nat.
Proof. exact (hash256_len _). Qed.
Lemma issuance_token_proof_words_len x : length (issuance_token_proof_words x) = 8%nat.
Proof. exact (hash256_len _). Qed.

(** * current_prev_outpoint *)

Definition elements_current_prev_outpoint_spec {alg : Primitive.Algebra} : alg Ty.Unit (Ty.Prod Word256 Word32) :=
  elements_current_spec (@elements_input_prev_outpoint_spec alg).

Definition elements_current_prev_outpoint_pexpr : expr :=
  Eaddrof (Efield (Ederef (Ebinop Oadd (Etempvar _t'2 (tptr (Tstruct _sigInput noattr))) (Etempvar _t'3 tulong)
    (tptr (Tstruct _sigInput noattr))) (Tstruct _sigInput noattr)) _prevOutpoint
    (Tstruct _outpoint noattr)) (tptr (Tstruct _outpoint noattr)).

Lemma elements_current_prev_outpoint_shape :
  elements_wrapper_shape f_simplicity_current_prev_outpoint
    (elements_current_ptr_rest _t'1 _t'2 _t'3 _t'4 _t'5 _t'6 _input _numInputs _sigInput
      elements_current_prev_outpoint_pexpr _prevOutpoint (Tstruct _outpoint noattr)).
Proof. repeat split; try reflexivity. apply elements_current_ptr_disjoint. Qed.

Theorem elements_current_prev_outpoint_local_spec :
  application_jet_local_spec_sep f_simplicity_current_prev_outpoint elements_ge Elements.env Ty.Unit
    (Ty.Prod Word256 Word32)
    (current_ptr_rep (fun e => sigTxIn (Elements.envTx e)) Elements.envIx outpoint_rep 544 96 0 696)
    (fun a environment => @elements_current_prev_outpoint_spec (PrimitivePrimSem option_Monad_Zero) a environment).
Proof.
