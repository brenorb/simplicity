TAP_DEF AmountExec.Common.amount_value_type
Common.amount_value_type =
Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (Word.Word (S (S (S (S (S (S O)))))))
     : Ty.Ty
TAP_DEF AmountExec.Common.amount_bytes
Common.amount_bytes =
fun a : Ty.tySem Common.amount_value_type =>
match a return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
| inl t =>
    match t return (list (Ty.tySem (Word.Word (S (S (S O)))))) with
    | pair odd h =>
        @cons (Ty.tySem (Word.Word (S (S (S O)))))
          (Spec.nonce_byte
             match odd return BinNums.Z with
             | inl _ => BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))
             | inr _ => BinNums.Zpos (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))
             end) (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S (S (S O))))) h)
    end
| inr v =>
    @cons (Ty.tySem (Word.Word (S (S (S O))))) (Spec.nonce_byte (BinNums.Zpos BinNums.xH))
      (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S (S (S O))) v)
end
     : forall _ : Ty.tySem Common.amount_value_type, list (Ty.tySem (Word.Word (S (S (S O)))))

Arguments Common.amount_bytes a
