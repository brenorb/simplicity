TAP_TYPE OutpointExec.Shape.op_body
Shape.op_body
     : @eq Clight.statement (Clight.fn_body jets_elements.f_simplicity_outpoint_hash)
         (Clight.Ssequence
            (Clight.Sassign (Clight.Evar jets_elements._src Shape.nc_fr)
               (Clight.Etempvar jets_elements._src Shape.nc_fr))
            (jet_sha_add_n_init.an_init
               (Clight.Ssequence Shape.nc_context_read
                  (Clight.Ssequence Shape.op_pegin
                     (Clight.Ssequence
                        (Shape.op_read
                           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                        (Clight.Ssequence
                           (Shape.op_absorb
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xO BinNums.xH)))))))
                           Shape.op_write))))))
