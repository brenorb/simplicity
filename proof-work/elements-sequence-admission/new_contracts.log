  (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
  (bw : Values.block) (edge cursor count : BinNums.Z) (bytes : list Memdata.memval) =>
forall (ma : Memory.Mem.mem') (mc : Memory.Mem.mem) (bl : Values.block)
  (_ : @eq (prod Memory.Mem.mem' Values.block)
         (Memory.Mem.alloc m BinNums.Z0 (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
         (@pair Memory.Mem.mem' Values.block ma bl))
  (_ : @eq (option Memory.Mem.mem) (Memory.Mem.storebytes ma bl BinNums.Z0 bytes) (@Some Memory.Mem.mem mc))
  (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (v : Values.val)
         (_ : @eq (option Values.val) (Memory.Mem.load chunk m b ofs) (@Some Values.val v)),
       @eq (option Values.val) (Memory.Mem.load chunk mc b ofs) (@Some Values.val v))
  (_ : forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) (p : Memtype.permission)
         (_ : Memory.Mem.perm m b ofs kind p), Memory.Mem.perm mc b ofs kind p)
  (_ : write_frame_at mc bd dbase bw edge cursor count),
@ex Clight.temp_env
  (fun le1 : Clight.temp_env =>
   @ex Memory.Mem.mem
     (fun me : Memory.Mem.mem =>
      and
        (ClightBigstep.Clight2.exec_stmt jet_elements_linkage.elements_ge
           (jet_elements_version_exec.elements_version_locals bl)
           (jet_elements_wrapper.elements_wrapper_temps f env bd dbase bs sbase) mc rest Events.E0 le1 me
           jet_elements_wrapper.elements_returned_one)
        (and (frame_output_cells_at me bw edge cursor cells)
           (and (write_prefix_at mc me bw edge cursor)
              (and (frame_fields_at me bd dbase bw edge (BinInt.Z.sub cursor count))
                 (and
                    (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                       (_ : not (@eq Values.block b bl))
                       (_ : or (not (@eq Values.block b bd))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add dbase
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    ofs)))
                       (_ : or (not (@eq Values.block b bw))
                              (or
                                 (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                    (BinInt.Z.add edge
                                       (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                          (BinInt.Z.div (BinInt.Z.sub cursor count)
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                     @eq (option Values.val) (Memory.Mem.load chunk me b ofs) (Memory.Mem.load chunk mc b ofs))
                    (and
                       (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) 
                          (p : Memtype.permission) (_ : Memory.Mem.perm mc b ofs kind p),
                        Memory.Mem.perm me b ofs kind p)
                       (forall (b : Values.block) (_ : Memory.Mem.valid_block mc b), Memory.Mem.valid_block me b))))))))
     : forall (_ : Clight.function) (_ : Clight.statement) (_ : list Cell) (_ : Values.val) 
         (_ : Memory.Mem.mem) (_ : Values.block) (_ : BinNums.Z) (_ : Values.block) (_ : BinNums.Z) 
