fun (A : Type) (s : wide_size) (elems : list A) (specv : forall _ : A, Ty.tySem (Word.Word (wide_log s)))
  (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error A elems (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return (Ty.tySem (Ty.Sum Ty.Unit (Word.Word (wide_log s))))
with
| Some x => @inr unit (Ty.tySem (Word.Word (wide_log s))) (specv x)
| None =>
    @inl unit
      ((fix tySem (X : Ty.Ty) : Set :=
          match X return Set with
          | Ty.Unit => unit
          | Ty.Sum A0 B => sum (tySem A0) (tySem B)
          | Ty.Prod A0 B => prod (tySem A0) (tySem B)
          end) (Word.Word (wide_log s))) tt
end
     : forall (A : Type) (s : wide_size) (_ : list A) (_ : forall _ : A, Ty.tySem (Word.Word (wide_log s)))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S O))))))), Ty.tySem (Ty.Sum Ty.Unit (Word.Word (wide_log s)))

