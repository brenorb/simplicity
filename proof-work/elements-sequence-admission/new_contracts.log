                                          (BinInt.Z.div (BinInt.Z.sub cursor count)
                                             (BinNums.Zpos
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                 (BinInt.Z.le
                                    (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                       (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                     @eq (option Values.val) (Memory.Mem.load chunk me b ofs) (Memory.Mem.load chunk mc b ofs))
                    (and
                       (forall (b : Values.block) (ofs : BinNums.Z) (kind : Memtype.perm_kind) 
                          (p : Memtype.permission) (_ : Memory.Mem.perm mc b ofs kind p),
                        Memory.Mem.perm me b ofs kind p)
                       (forall (b : Values.block) (_ : Memory.Mem.valid_block mc b), Memory.Mem.valid_block me b))))))))
     : forall (_ : Clight.function) (_ : Clight.statement) (_ : list Cell) (_ : Values.val) 
