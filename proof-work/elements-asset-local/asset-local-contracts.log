TAP_DEF AssetLocal.Buffer.ctx8_add_buffer_model
Buffer.ctx8_add_buffer_model =
fix ctx8_add_buffer_model (d : nat) (c : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) {struct d} :
    forall _ : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) d),
    option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) :=
  match
    d as d0
    return
      (forall _ : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) d0),
       option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
  with
  | O =>
      fun b : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) O) =>
      match b return (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)) with
      | inl _ =>
          match
            BinInt.Z.ltb (Buffer.ctx8_count c) jet_sha_ctx8_spec.ctx8_limit
            return (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
          with
          | true => @Some (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type) c
          | false => @None (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
          end
      | inr x => jet_sha_ctx8_spec.ctx8_add1_model c x
      end
  | S d' =>
      fun b : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) (S d')) =>
      match
        @fst
          (sum
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) Ty.Unit)
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end) (Word.Vector (Word.Word (S (S (S O)))) (S d'))))
          ((fix tySem (X : Ty.Ty) : Set :=
              match X return Set with
              | Ty.Unit => unit
              | Ty.Sum A B => sum (tySem A) (tySem B)
              | Ty.Prod A B => prod (tySem A) (tySem B)
              end)
             ((fix buffer_type (X : Ty.Ty) (depth : nat) {struct depth} : Ty.Ty :=
                 match depth return Ty.Ty with
                 | O => Ty.Sum Ty.Unit X
                 | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d0))) (buffer_type X d0)
                 end) (Word.Word (S (S (S O)))) d')) b
        return (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
      with
      | inl _ =>
          ctx8_add_buffer_model d' c
            (@snd
               (sum
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) Ty.Unit)
                  ((fix tySem (X : Ty.Ty) : Set :=
                      match X return Set with
                      | Ty.Unit => unit
                      | Ty.Sum A B => sum (tySem A) (tySem B)
                      | Ty.Prod A B => prod (tySem A) (tySem B)
                      end) (Word.Vector (Word.Word (S (S (S O)))) (S d'))))
               ((fix tySem (X : Ty.Ty) : Set :=
                   match X return Set with
                   | Ty.Unit => unit
                   | Ty.Sum A B => sum (tySem A) (tySem B)
                   | Ty.Prod A B => prod (tySem A) (tySem B)
                   end)
                  ((fix buffer_type (X : Ty.Ty) (depth : nat) {struct depth} : Ty.Ty :=
                      match depth return Ty.Ty with
                      | O => Ty.Sum Ty.Unit X
                      | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d0))) (buffer_type X d0)
                      end) (Word.Word (S (S (S O)))) d')) b)
      | inr v =>
          match
            jet_sha_ctx8_spec.ctx8_add_list c (jet_buffer_input.vector_values (Word.Word (S (S (S O)))) (S d') v)
            return (option (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type))
          with
          | Some c' =>
              ctx8_add_buffer_model d' c'
                (@snd
                   (sum
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) Ty.Unit)
                      ((fix tySem (X : Ty.Ty) : Set :=
                          match X return Set with
                          | Ty.Unit => unit
                          | Ty.Sum A B => sum (tySem A) (tySem B)
                          | Ty.Prod A B => prod (tySem A) (tySem B)
                          end) (Word.Vector (Word.Word (S (S (S O)))) (S d'))))
                   ((fix tySem (X : Ty.Ty) : Set :=
                       match X return Set with
                       | Ty.Unit => unit
                       | Ty.Sum A B => sum (tySem A) (tySem B)
                       | Ty.Prod A B => prod (tySem A) (tySem B)
                       end)
                      ((fix buffer_type (X : Ty.Ty) (depth : nat) {struct depth} : Ty.Ty :=
                          match depth return Ty.Ty with
                          | O => Ty.Sum Ty.Unit X
                          | S d0 => Ty.Prod (Ty.Sum Ty.Unit (Word.Vector X (S d0))) (buffer_type X d0)
                          end) (Word.Word (S (S (S O)))) d')) b)
          | None => @None (Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
          end
      end
  end
     : forall (d : nat) (_ : Ty.tySem jet_sha256_ctx8_init_spec.sha256_ctx8_type)
         (_ : Ty.tySem (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) d)),
