TAP_DEF AssetLocal.Buffer.ctx8_add_buffer_spec
Buffer.ctx8_add_buffer_spec =
fix ctx8_add_buffer_spec (d : nat) (term : Alg.Assertion.Algebra) {struct d} :
    Alg.Assertion.domain term
      (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
         (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) d)) jet_sha256_ctx8_init_spec.sha256_ctx8_type :=
  match
    d as d0
    return
      (Alg.Assertion.domain term
         (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type
            (jet_buffer_empty_spec.buffer_type (Word.Word (S (S (S O)))) d0))
         jet_sha256_ctx8_init_spec.sha256_ctx8_type)
  with
  | O =>
      @jet_sha256_count_assertion.AC.comp
        (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))))
        (Ty.Prod (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))) jet_sha256_ctx8_init_spec.sha256_ctx8_type)
        jet_sha256_ctx8_init_spec.sha256_ctx8_type (Alg.Assertion.toCore term)
        (@jet_sha256_count_assertion.AC.pair
           (Ty.Prod jet_sha256_ctx8_init_spec.sha256_ctx8_type (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))))
           (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))) jet_sha256_ctx8_init_spec.sha256_ctx8_type
           (Alg.Assertion.toCore term)
           (@jet_sha256_count_assertion.AC.drop jet_sha256_ctx8_init_spec.sha256_ctx8_type
              (Ty.Sum Ty.Unit (Word.Word (S (S (S O))))) (Ty.Sum Ty.Unit (Word.Word (S (S (S O)))))
              (Alg.Assertion.toCore term)
              (@jet_sha256_count_assertion.AC.iden (Ty.Sum Ty.Unit (Word.Word (S (S (S O)))))
                 (Alg.Assertion.toCore term)))
