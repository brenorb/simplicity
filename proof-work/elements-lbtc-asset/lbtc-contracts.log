TAP_DEF C.jet_u32_local_init.u32_local_prefix
jet_u32_local_init.u32_local_prefix =
fix u32_local_prefix (arr : Clight.expr) (i : nat) (xs : list Integers.Int.int) (tail : Clight.statement) {struct xs} :
    Clight.statement :=
  match xs return Clight.statement with
  | nil => tail
  | cons x rest =>
      Clight.Ssequence (Clight.Sassign (jet_u32_local_init.u32_local_lhs arr i) (Clight.Econst_int x Ctypesdefs.tuint))
        (u32_local_prefix arr (S i) rest tail)
  end
     : forall (_ : Clight.expr) (_ : nat) (_ : list Integers.Int.int) (_ : Clight.statement), Clight.statement

