                      (BinInt.Z.add (BinInt.Z.of_nat i) (BinInt.Z.of_nat (@length Integers.Int.int xs)))))
                Integers.Ptrofs.max_unsigned)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) base)
         (_ : Memory.Mem.range_perm m b
                (BinInt.Z.add base
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i)))
                (BinInt.Z.add base
                   (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)))
                      (BinInt.Z.add (BinInt.Z.of_nat i) (BinInt.Z.of_nat (@length Integers.Int.int xs))))) Memtype.Cur
                Memtype.Writable),
       @ex Memory.Mem.mem
         (fun mi : Memory.Mem.mem =>
          and
            (jet_uint32_array_init.uint32_array_at mi b
               (BinInt.Z.add base
                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))) xs)
            (and
               (forall (chunk : AST.memory_chunk) (bb : Values.block) (ofs : BinNums.Z)
                  (_ : or (not (@eq Values.block bb b))
                         (or
                            (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                               (BinInt.Z.add base
                                  (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) (BinInt.Z.of_nat i))))
                            (BinInt.Z.le
