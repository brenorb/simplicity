"""Check an additive register bridge against the exact forced-source base."""
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
sp = importlib.util.spec_from_file_location('register_base', HERE.parent / 'elements-calculation-local/check.py')
base = importlib.util.module_from_spec(sp)
sp.loader.exec_module(base)
s, g = base.s, base.g
MODULE = 'EntropyRegisters.Registers'
BASE = HERE.parent / 'elements-calculation-local/recovery-basis'


def identity(external):
    r = json.loads((BASE / 'SOURCE-CLOSURE.json').read_text())
    work = Path(r['candidate'])
    base.b.tree(work)
    force = s.load('register_forced_closure', HERE.parent / 'verify-forced-closure.py')
    force.objects(work, r['compiled_and_loaded_local_modules'])
    if s.sha((BASE / 'RUN.json').read_bytes()) != r['compile_sha256']:
        raise ValueError('base source-bound compile differs')
    source = external / 'Registers.v'
    if (external == work or external == s.REPO or s.REPO in external.parents or
        source.is_symlink() or source.read_bytes() != (HERE / 'Registers.v.source').read_bytes() or
        {p.name for p in external.glob('*.v')} != {'Registers.v'}):
        raise ValueError('distinct exact external source required')
    s.safe_source(source.read_text(), MODULE)
    return work, source, r, ['-Q', str(external), 'IssuanceRegisters']


def compile(external):
    if (HERE / 'RUN.json').exists():
        raise ValueError('compile receipt exists')
    work, source, bound, extra = identity(external)
    before, index = s.input_map(), s.index_hash()
    commands = {'registers-fresh': s.run(work,
        ['bash', 'build-jets.sh', '--coqc', '-q', *extra, str(source)], 'registers-fresh', 60)}
    results, definitions, deps = g.reports(work, [(MODULE, source)], 'registers', commands, extra)
    if len(results) != 4 or len(definitions) != 4 or any(deps.values()):
        raise ValueError('expected exactly four closed bridge lemmas and four definitions')
    command = ['bash', 'build-jets.sh', '--coqtop', '-quiet', *extra]
    query = subprocess.run(command, input='Require ' + MODULE + '.\nPrint Libraries.\n',
        cwd=work / 'Coq', env=s.ENV, text=True, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT, timeout=60)
    if query.returncode or re.search(r'(?m)^(?:Error|Anomaly):', query.stdout):
        raise ValueError('loaded-library query failed')
    local = {m.replace('.', '/') + '.v' for m in
             re.findall(r'^  ((?:C|Simplicity|Util)\.[A-Za-z0-9_.]+)$', query.stdout, re.M)}
    if not local or not local <= set(bound['compiled_and_loaded_local_modules']):
        raise ValueError('an imported local object lacks forced source provenance')
    if re.findall(r'^  (EntropyRegisters\.[A-Za-z0-9_.]+)$', query.stdout, re.M) != [MODULE]:
        raise ValueError('unexpected extension library inventory')
    identity(external)
    if s.input_map() != before or s.index_hash() != index:
        raise ValueError('bridge compilation changed main/index')
    record = dict(candidate=str(work), external=str(external), module=MODULE,
        main_inputs=before, staged_patch_sha256=index, commands=commands,
        results=results, definitions=definitions, dependencies={n: sorted(d) for n, d in deps.items()},
        base_source_closure_sha256=s.sha((BASE / 'SOURCE-CLOSURE.json').read_bytes()),
        loaded_local_source_objects={n: bound['compiled_and_loaded_local_modules'][n] for n in sorted(local)},
        source_sha256=s.sha(source.read_bytes()), object_sha256=s.sha(source.with_suffix('.vo').read_bytes()),
        tools_sha256={'verify.py': s.sha(Path(__file__).read_bytes())},
        library_query=dict(command=command, exit_code=query.returncode, log_sha256=s.sha(query.stdout.encode())),
        recursive_kernel_check=False, whole_c_jet_equivalence_proved=False,
        normal_registration=False, coverage_added=0)
    s.changed({HERE / 'RUN.json': json.dumps(record, indent=2) + '\n',
               HERE / 'loaded-libraries.log': query.stdout,
               **{HERE / (stem + '.log'): (work / (stem + '.log')).read_text() for stem in commands}})
    print('Four closed register bridges compiled; every imported project object is source-bound', flush=True)


def kernel(external):
    if (HERE / 'KERNEL-RUN.json').exists():
        raise ValueError('kernel already launched; inspect the original process')
    work, source, bound, extra = identity(external)
    r = json.loads((HERE / 'RUN.json').read_text())
    if (r['external'] != str(external) or r['main_inputs'] != s.input_map() or
        r['staged_patch_sha256'] != s.index_hash() or
        r['source_sha256'] != s.sha(source.read_bytes()) or
        r['object_sha256'] != s.sha(source.with_suffix('.vo').read_bytes()) or
        r['base_source_closure_sha256'] != s.sha((BASE / 'SOURCE-CLOSURE.json').read_bytes()) or
        r['tools_sha256'] != {'verify.py': s.sha(Path(__file__).read_bytes())}):
        raise ValueError('bridge compile identity changed')
    command = ['bash', '-c', 'ulimit -s 65520; exec bash build-jets.sh --coqchk -silent -o '
               + ' '.join(extra) + ' ' + MODULE]
    launch = dict(command=command, compile_sha256=s.sha((HERE / 'RUN.json').read_bytes()),
                  recursive_kernel_check=False)
    s.changed({HERE / 'KERNEL-RUN.json': json.dumps(launch, indent=2) + '\n'})
    row = s.run(work, command, 'registers-kernel', 3600)
    s.kernel.kernel((work / 'registers-kernel.log').read_text(),
                    sorted((work / 'Coq/C/jet_coqchk_axioms.expected').read_text().split()))
    identity(external)
    if (r['main_inputs'] != s.input_map() or r['staged_patch_sha256'] != s.index_hash() or
        r['source_sha256'] != s.sha(source.read_bytes()) or
        r['object_sha256'] != s.sha(source.with_suffix('.vo').read_bytes())):
        raise ValueError('kernel changed bridge/base/main/index')
    r.update(recursive_kernel_check=True, kernel=row,
        kernel_launch_sha256=s.sha((HERE / 'KERNEL-RUN.json').read_bytes()))
    s.changed({HERE / 'CHECKED.json': json.dumps(r, indent=2) + '\n',
               HERE / 'registers-kernel.log': (work / 'registers-kernel.log').read_text()})
    print('Four closed register bridges recursively kernel-checked against their source-bound imports', flush=True)


if __name__ == '__main__':
    if len(sys.argv) != 3 or sys.argv[1] not in ['compile', 'kernel']:
        raise ValueError('usage: verify.py compile|kernel EXTERNAL_DIRECTORY')
    globals()[sys.argv[1]](Path(sys.argv[2]).resolve())
