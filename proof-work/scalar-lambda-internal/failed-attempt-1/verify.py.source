"""Exact-input audit of the unchanged scalar-lambda contract with six dependencies.

The older eight-dependency proof is a comparison, not an accepted baseline.
No shared registry, original implementation, specification or API is edited.
"""
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]


def load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


a = load('lambda_internal_preparation', HERE / 'prepare.py')
s = a.s
g = load('lambda_internal_reporter', HERE.parent / 'elements-tap-getters/check.py')
EXT = Path('/private/tmp/jet-scalar-lambda-internal.gdhGw3')
NAMES = ['Graph', 'State', 'Calls', 'Chain', 'Rest', 'Public', 'Initialized', 'Local', 'Fresh']
ROOTS = ['LambdaInternal.Local', 'LambdaInternal.Fresh']
EXTRA = ['-Q', str(EXT), 'LambdaInternal']
PREFIX = 'lambda-internal'
# Compare complete printed types under the same imports and printing options.
PAIRS = {
    'Calls.eval_lambda_tight_frame_internal': 'readonly.eval_scalar_lambda_tight_frame',
    'Chain.eval_scalar_read_lambda_write_internal': 'call_chain.eval_scalar_read_lambda_write_canonical',
    'Rest.exec_scalar_lambda_rest_internal': 'rest.exec_scalar_lambda_rest_canonical',
    'Public.eval_scalar_lambda_canonical_internal': 'lifecycle.eval_secp_scalar_lambda_canonical',
    'Initialized.eval_lambda_initialized_internal': 'initialized.eval_secp_scalar_lambda_initialized',
    'Local.scalar_lambda_initialized_local_spec_internal': 'local.scalar_lambda_initialized_local_spec',
    'Fresh.lambda_runs_from_initialized_internal': 'fresh.scalar_lambda_runs_from_initialized',
    'Fresh.lambda_runs_from_actual_init_internal': 'fresh.scalar_lambda_runs_from_actual_init',
}
OLD = {new: 'C.jet_secp_scalar_lambda_' + old for new, old in PAIRS.items()}
FOUR = s.SIX - {'Events.external_functions_sem', 'Events.inline_assembly_sem'}
EIGHT = s.SIX | {'Events.external_functions_properties', 'Events.inline_assembly_properties'}


def tools():
    paths = [Path(__file__), HERE / 'prepare.py', HERE.parent / 'elements-count/support.py',
        HERE.parent / 'elements-tap-getters/check.py', HERE.parent / 'scalar-mul/review.py',
        HERE.parent / 'scalar-multiply-integration/review-normal.py',
        HERE.parent / 'scalar-lambda-integration/check-lambda-public.py',
        REPO / 'Coq/check-jet-source-target.py', REPO / 'Coq/scan-jet-proofs.py']
    return {str(p.relative_to(REPO)): s.sha(p.read_bytes()) for p in paths}


def built():
    work, prep = a.identity()
    b = json.loads((HERE / 'BUILT.json').read_text())
    if (not b['complete'] or b['preparation_sha256'] != s.sha((HERE / 'PREPARATION.json').read_bytes()) or
            set(b['source_objects']) != set(prep['fresh_source_hashes']) or
            len(b['commands']) != len(prep['fresh_modules'])):
        raise ValueError('lambda dependencies are not completely built for these inputs')
    for stem, row in b['commands'].items():
        if row['exit_code'] or row['log_sha256'] != s.sha((work / (stem + '.log')).read_bytes()):
            raise ValueError('lambda dependency compilation log differs: ' + stem)
    for name, digest in b['source_objects'].items():
        if s.sha((work / name).with_suffix('.vo').read_bytes()) != digest:
            raise ValueError('lambda dependency object differs: ' + name)
    if {p.name for p in EXT.glob('*.v')} != {n + '.v' for n in NAMES}:
        raise ValueError('unexpected lambda extension source inventory')
    for n in NAMES:
        p = EXT / (n + '.v')
        if p.is_symlink() or p.read_bytes() != (HERE / (n + '.v.source')).read_bytes():
            raise ValueError('lambda extension archive differs: ' + n)
        s.safe_source(p.read_text(), 'LambdaInternal.' + n)
    known = {n: dict(source_sha256=h, object_sha256=prep['inherited_object_hashes'][n])
        for n, h in prep['inherited_source_hashes'].items()}
    known.update({n: dict(source_sha256=h, object_sha256=b['source_objects'][n])
        for n, h in prep['fresh_source_hashes'].items()})
    return work, prep, known


def objects():
    return {n: dict(source_sha256=s.sha((EXT / (n + '.v')).read_bytes()),
        object_sha256=s.sha((EXT / (n + '.vo')).read_bytes())) for n in NAMES}


def profiles(results, definitions, deps):
    if len(results) != 19 or len(definitions) != 1 or set(deps) != set(results):
        raise ValueError('lambda extension declaration inventory differs')
    for n, ds in deps.items():
        short = n.rsplit('.', 1)[1]
        expected = (set() if short in {'lambda_internal_table_correct', 'lambda_public_allowed',
            'lambda_reader_allowed', 'lambda_writer_allowed', 'lambda_mul_allowed', 'lambda_public_env_plain'}
            else FOUR if short in {'lambda_global_unchanged', 'lambda_initialized_preserved'} else s.SIX)
        if set(ds) != expected:
            raise ValueError('lambda exact dependency profile differs: ' + n)


def statement(text, name):
    code = s.scanner.code_only(text)
    matches = re.findall(r'\b(?:Lemma|Theorem)\s+' + re.escape(name) + r'\b(.*?)\bProof\s*\.', code, re.S)
    if len(matches) != 1:
        raise ValueError('missing or duplicate boundary: ' + name)
    return re.sub(r'\s+', '', matches[0])


def boundary(work, texts):
    for new, old in OLD.items():
        module, short = new.split('.')
        if module not in {'Local', 'Fresh'}:
            continue
        om, os = old.rsplit('.', 1)
        if statement(texts[module], short) != statement((work / 'Coq' / (om.replace('.', '/') + '.v')).read_text(), os):
            raise ValueError('public or actual-startup boundary differs: ' + new)


def source_review(work):
    # Restore only exact committed review scripts/fixtures; never copy main
    # uncommitted files or modify a proof dependency or checked parent tree.
    path = 'proof-work/secp-field-literal/ARCHIVED-INPUTS.json'
    raw = a.blob(path)
    inputs, changes = {path: s.sha(raw)}, {}
    for name, row in json.loads(raw)['inputs'].items():
        if not name.startswith('Coq/negate-review/'):
            continue
        origin = 'proof-work/secp-field-literal/' + row['archive']
        code = a.blob(origin)
        if s.sha(code) != row['sha256']:
            raise ValueError('archived review fixture differs: ' + origin)
        inputs[origin] = s.sha(code)
        changes[work / name] = code.decode()
    s.changed(changes)
    gate = load('lambda_internal_literal_authority', HERE.parent / 'scalar-lambda-integration/check-lambda-public.py')
    result = gate.check(work, work / 'Coq')
    for p, digest in result['hashes'].items():
        if s.sha(Path(p).read_bytes()) != digest:
            raise ValueError('literal authority input differs')
    texts = {n: (EXT / (n + '.v')).read_text() for n in NAMES}
    boundary(work, texts)
    mutations = [('Local', 'secp_jet_initialized_local_spec', 'secp_jet_local_spec'),
        ('Local', 'scalar_lambda_initialized f_simplicity', '(fun _ => True) f_simplicity'),
        ('Local', 'f_simplicity_scalar_multiply_lambda', 'f_simplicity_scalar_square'),
        ('Local', '(Word 8) (Word 8)', '(Word 7) (Word 8)'),
        ('Local', '(Word 8) (Word 8)', '(Word 8) (Word 7)'),
        ('Local', '@canonical_scalar_multiply_lambda', '@canonical_scalar_normalize'),
        ('Fresh', 'Genv.init_mem jets_secp.prog = Some mi', 'True'),
        ('Fresh', '(value : Ty.tySem (Word 8)) env :', '(value : Ty.tySem (Word 8)) env : False ->')]
    for module, old, new in mutations:
        if old not in texts[module]:
            raise ValueError('missing boundary mutation fixture: ' + old)
        altered = dict(texts); altered[module] = texts[module].replace(old, new, 1)
        try:
            boundary(work, altered)
        except ValueError:
            continue
        raise ValueError('boundary mutation escaped: ' + old)
    # These files must match both the actual candidate and the frozen revision.
    for n in ['Haskell/Core/Simplicity/CoreJets.hs', 'Haskell/Core/Simplicity/Programs/LibSecp256k1.hs',
            'Haskell/Core/Simplicity/LibSecp256k1/Spec.hs']:
        frozen = subprocess.check_output(['git', 'show', '91d89bac:' + n], cwd=REPO)
        if frozen != (work / n).read_bytes() or frozen != (REPO / n).read_bytes():
            raise ValueError('original lambda specification changed: ' + n)
        inputs[n] = s.sha(frozen)
    return dict(authority=result, committed_review_inputs=inputs, boundary_mutations_rejected=len(mutations))


def compare_types(work):
    text = (work / (PREFIX + '-contracts.log')).read_text()
    baseline = (work / (PREFIX + '-baseline-contracts.log')).read_text()
    aliases = {}
    for new, old in OLD.items():
        canonical = 'LambdaInternal.' + new
        for name in [canonical, new, old, old.removeprefix('C.')]:
            aliases[name] = canonical
    def chunks(raw):
        parts = re.split(r'(?m)^TAP_(TYPE|DEF) (\S+)\n', raw)
        result = {}
        for kind, name, body in zip(parts[1::3], parts[2::3], parts[3::3]):
            if kind != 'TYPE' or name not in aliases:
                continue
            body = re.sub(r'[A-Za-z_][\w\x27]*(?:\.[A-Za-z_][\w\x27]*)+',
                lambda m: aliases.get(m[0], m[0]), body)
            key = aliases[name]
            if key in result:
                raise ValueError('duplicate full theorem type: ' + key)
            result[key] = re.sub(r'\s+', '', body)
        return result
    expected, actual = chunks(baseline), chunks(text)
    if len(expected) != 8 or set(expected) != set(actual) or expected != actual:
        raise ValueError('lambda theorem types changed beyond names: ' + str([n for n in expected if expected[n] != actual.get(n)]))
    old_deps = s.reports.assumptions((work / (PREFIX + '-baseline-assumptions.log')).read_text())
    if set(old_deps) != set(OLD.values()) or any(ds != EIGHT for ds in old_deps.values()):
        raise ValueError('older eight-dependency comparison profile differs')
    return dict(compared_complete_theorem_types=8, theorem_name_only=True,
        old_dependencies=sorted(EIGHT), new_dependencies=sorted(s.SIX),
        normalized_types_sha256=s.sha(json.dumps(actual, sort_keys=True).encode()))


def kernel_command():
    return ['bash', '-c', 'ulimit -s 65520; exec bash build-jets.sh --coqchk -silent -o ' + ' '.join(EXTRA + ROOTS)]


def reports():
    work, prep, known = built()
    if (HERE / 'REPORT-LAUNCH.json').exists():
        raise ValueError('lambda report audit already launched; poll the original process')
    before, index, driver = s.input_map(), s.index_hash(), tools()
    s.changed({HERE / 'REPORT-LAUNCH.json': json.dumps(dict(complete=False, tools_sha256=driver,
        built_sha256=s.sha((HERE / 'BUILT.json').read_bytes()), source_objects=objects()), indent=2) + '\n'})
    commands = {}
    for n in NAMES:
        stem = PREFIX + '-compile-' + n.lower()
        commands[stem] = s.run(work, ['bash', 'build-jets.sh', '--coqc', '-q', *EXTRA, str(EXT / (n + '.v'))], stem, 180)
    modules = [('LambdaInternal.' + n, EXT / (n + '.v')) for n in NAMES]
    results, definitions, deps = g.reports(work, modules, PREFIX, commands, EXTRA)
    profiles(results, definitions, deps)
    header = ['Require ' + ' '.join(m for m, _ in modules) + '.']
    queries = {'contracts': header + ['Set Printing All.', 'Set Printing Width 120.', 'Set Printing Depth 1000000.'],
        'assumptions': header[:]}
    for n in OLD.values():
        queries['contracts'] += ['Goal True. idtac "TAP_TYPE ' + n + '". exact I. Qed.', 'Check @' + n + '.']
        queries['assumptions'] += ['Goal True. idtac "JET_ASSUMPTIONS ' + n + '". exact I. Qed.', 'Print Assumptions ' + n + '.']
    for kind, lines in queries.items():
        stem = PREFIX + '-baseline-' + kind
        path = work / (stem.replace('-', '_') + '.v')
        s.changed({path: '\n'.join(lines) + '\n'})
        commands[stem] = s.run(work, ['bash', 'build-jets.sh', '--coqc', '-q', *EXTRA, str(path)], stem, 180)
    compared = compare_types(work)
    review = source_review(work)
    query = subprocess.run(['bash', 'build-jets.sh', '--coqtop', '-quiet', *EXTRA],
        input='Require ' + ' '.join(ROOTS) + '.\nPrint Libraries.\n', cwd=work / 'Coq', env=s.ENV,
        text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
    libraries = set(re.findall(r'^\s+([A-Za-z_][\w]*(?:\.[\w]+)+)\s*$', query.stdout, re.M))
    local = {'Coq/' + n.replace('.', '/') + '.v' for n in libraries if n.startswith(('C.', 'Simplicity.', 'Util.'))}
    private = {n for n in libraries if n.startswith('LambdaInternal.')}
    unknown = {n for n in libraries if not n.startswith(('C.', 'Simplicity.', 'Util.', 'LambdaInternal.',
        'Coq.', 'compcert.', 'Flocq.', 'VST.', 'sha.'))}
    if (query.returncode or re.search(r'(?m)^(?:Error|Anomaly):', query.stdout) or unknown or
            not local <= set(known) or private != {'LambdaInternal.' + n for n in NAMES}):
        raise ValueError('lambda loaded an unreviewed local/private module')
    for stem, command, deadline in [
            (PREFIX + '-original-targets', [sys.executable, '-B', 'check-jet-source-target.py'], 60),
            (PREFIX + '-main-targets', [sys.executable, '-B', str(REPO / 'Coq/check-jet-source-target.py')], 60),
            (PREFIX + '-ast', ['bash', 'C/check-secp-jets-generation.sh'], 180)]:
        commands[stem] = s.run(work, command, stem, deadline)
    built()
    if before != s.input_map() or index != s.index_hash() or driver != tools():
        raise ValueError('lambda audit main/staged/tool inputs changed')
    record = dict(candidate=str(EXT), basis=str(work), results=results, definitions=definitions,
        dependencies={n: sorted(ds) for n, ds in deps.items()}, commands=commands, source_objects=objects(),
        loaded_local_source_objects={n: known[n] for n in sorted(local)}, tools_sha256=driver,
        main_inputs=before, staged_patch_sha256=index, source_review=review, exact_type_comparison=compared,
        built_sha256=s.sha((HERE / 'BUILT.json').read_bytes()), recursive_kernel_check=False,
        whole_initialized_lambda_C_to_literal_spec=True, accepted=False, coverage_added=0)
    changes = {HERE / 'RUN.json': json.dumps(record, indent=2) + '\n', HERE / 'loaded-libraries.log': query.stdout}
    for stem in commands:
        changes[HERE / (stem + '.log')] = (work / (stem + '.log')).read_text()
    s.changed(changes)
    print('Original lambda contract and actual-init witness: eight identical complete types, six dependencies; original AST regenerated', flush=True)


def bound():
    work, prep, known = built()
    r = json.loads((HERE / 'RUN.json').read_text())
    if (r['source_objects'] != objects() or r['main_inputs'] != s.input_map() or r['staged_patch_sha256'] != s.index_hash() or
            r['tools_sha256'] != tools() or r['built_sha256'] != s.sha((HERE / 'BUILT.json').read_bytes()) or
            any(known[n] != row for n, row in r['loaded_local_source_objects'].items()) or
            r['exact_type_comparison'] != compare_types(work) or r['source_review'] != source_review(work)):
        raise ValueError('lambda exact audited inputs differ')
    profiles(r['results'], r['definitions'], r['dependencies'])
    for stem, row in r['commands'].items():
        if (row['exit_code'] or row['log_sha256'] != s.sha((work / (stem + '.log')).read_bytes()) or
                (HERE / (stem + '.log')).read_bytes() != (work / (stem + '.log')).read_bytes()):
            raise ValueError('lambda audited command/log differs: ' + stem)
    return work, r


def kernel():
    work, r = bound()
    if (HERE / 'KERNEL-LAUNCH.json').exists():
        raise ValueError('lambda kernel already launched; poll original process')
    s.changed({HERE / 'KERNEL-LAUNCH.json': json.dumps(dict(complete=False, command=kernel_command(),
        run_sha256=s.sha((HERE / 'RUN.json').read_bytes())), indent=2) + '\n'})
    row = s.run(work, kernel_command(), PREFIX + '-kernel', 1800)
    log = (work / (PREFIX + '-kernel.log')).read_text()
    s.kernel.kernel(log, sorted((work / 'Coq/C/jet_coqchk_axioms.expected').read_text().split()))
    bound()
    s.changed({HERE / 'CHECKED.json': json.dumps(dict(kernel=row, recursive_kernel_check=True,
        run_sha256=s.sha((HERE / 'RUN.json').read_bytes()), whole_initialized_lambda_C_to_literal_spec=True,
        accepted=False, coverage_added=0), indent=2) + '\n', HERE / (PREFIX + '-kernel.log'): log})
    print('Original full initialized scalar-lambda C-to-literal-specification chain recursively kernel-checked', flush=True)


def check():
    work, r = bound()
    k = json.loads((HERE / 'CHECKED.json').read_text())
    if (not k['recursive_kernel_check'] or k['kernel']['exit_code'] or k['kernel']['command'] != kernel_command() or
            k['run_sha256'] != s.sha((HERE / 'RUN.json').read_bytes()) or
            k['kernel']['log_sha256'] != s.sha((work / (PREFIX + '-kernel.log')).read_bytes()) or
            (HERE / (PREFIX + '-kernel.log')).read_bytes() != (work / (PREFIX + '-kernel.log')).read_bytes()):
        raise ValueError('lambda completed kernel evidence differs')
    print('Exact original lambda proof inputs, public types, dependency profiles and recursive kernel receipts match')


if __name__ == '__main__':
    if len(sys.argv) != 2 or sys.argv[1] not in {'reports', 'kernel', 'check'}:
        raise SystemExit('usage: verify.py reports|kernel|check')
    {'reports': reports, 'kernel': kernel, 'check': check}[sys.argv[1]]()
