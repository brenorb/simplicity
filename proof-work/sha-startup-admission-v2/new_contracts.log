DELTA_DEEP_DEF C.jet_sha_startup_executable.sha_partial_runs_on_fresh_frames
jet_sha_startup_executable.sha_partial_runs_on_fresh_frames =
fun (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, option (Ty.tySem B)) =>
forall (a : Ty.tySem A) (env : Values.val) (m0 : Memory.Mem.mem) (_ : jet_sha_startup_state.sha_startup_state m0),
@ex Memory.Mem.mem
  (fun m : Memory.Mem.mem =>
   @ex Values.block
     (fun bd : Values.block =>
      @ex Values.block
        (fun bs : Values.block =>
         @ex Values.block
           (fun bw : Values.block =>
            @ex Memory.Mem.mem
              (fun mf : Memory.Mem.mem =>
               and
                 (ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function f)
                    (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr BinNums.Z0))
                       (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr BinNums.Z0))
                          (@cons Values.val env (@nil Values.val)))) Events.E0 mf
                    (@jet_partial_return (Ty.tySem B) (spec a)))
