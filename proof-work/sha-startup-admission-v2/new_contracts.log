DELTA_DEEP_DEF C.jet_sha_startup_state.sha_startup_application_spec
jet_sha_startup_state.sha_startup_application_spec =
fun (f : Clight.function) (E : Set) (A B : Ty.Ty)
  (env_rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E)
               (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
  (spec : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)) =>
forall (logical_env : E) (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z)
  (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z)
  (a : Ty.tySem A) (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z))
  (_ : jet_sha_startup_state.sha_startup_state m) (_ : env_rep m env logical_env fp)
  (_ : @List.Forall (prod (prod Values.block BinNums.Z) BinNums.Z)
         (fun pat : prod (prod Values.block BinNums.Z) BinNums.Z =>
          match pat return Prop with
          | pair y hi =>
              match y return Prop with
              | pair b lo => out_sep bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B)) b lo hi
              end
          end) fp) (_ : frame_base_valid sbase)
  (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
  (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
  (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize A))) Integers.Int64.max_unsigned)
  (_ : frame_input_cells_at m bi edge read_cursor (@encode A a))
  (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   @ex (Ty.tySem B)
     (fun value : Ty.tySem B =>
      and (@eq (option (Ty.tySem B)) (spec a logical_env) (@Some (Ty.tySem B) value))
        (and
           (ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function f)
              (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr dbase))
                 (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr sbase))
                    (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
           (and (frame_output_cells_at mf bw outedge cursor (@encode B value))
              (and (write_prefix_at m mf bw outedge cursor)
                 (and (frame_fields_at mf bd dbase bw outedge (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B))))
                    (and
                       (forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z)
                          (_ : Memory.Mem.valid_block m b)
                          (_ : or (not (@eq Values.block b bd))
                                 (or
                                    (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                       (BinInt.Z.add dbase
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                    (BinInt.Z.le
                                       (BinInt.Z.add dbase
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                                       ofs)))
                          (_ : or (not (@eq Values.block b bw))
                                 (or
                                    (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                                       (BinInt.Z.add outedge
                                          (BinInt.Z.mul
                                             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                             (BinInt.Z.div (BinInt.Z.sub cursor (BinInt.Z.of_nat (bitSize B)))
                                                (BinNums.Zpos
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                                    (BinInt.Z.le
                                       (BinInt.Z.add (jet_write_layout.write_word_address outedge cursor)
                                          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
                        @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
                       (jet_sha_startup_state.sha_startup_state mf))))))))
     : forall (_ : Clight.function) (E : Set) (A B : Ty.Ty)
         (_ : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E)
                (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
         (_ : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)), Prop

