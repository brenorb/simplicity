DELTA_DEEP_DEF C.jet_sha_startup_init.init_aligned_b
jet_sha_startup_init.init_aligned_b =
fix init_aligned_b (p : BinNums.Z) (il : list AST.init_data) {struct il} : bool :=
  match il return bool with
  | nil => true
  | cons i rest =>
      andb (BinInt.Z.eqb (BinInt.Z.modulo p (Globalenvs.Genv.init_data_alignment i)) BinNums.Z0)
        (init_aligned_b (BinInt.Z.add p (AST.init_data_size i)) rest)
  end
     : forall (_ : BinNums.Z) (_ : list AST.init_data), bool

Arguments jet_sha_startup_init.init_aligned_b p%Z_scope il%list_scope
DELTA_DEEP_DEF C.jet_sha_startup_init.addrof_defined_b
jet_sha_startup_init.addrof_defined_b =
fun (F V : Type) (ge : Globalenvs.Genv.t F V) (d : AST.init_data) =>
match d return bool with
| AST.Init_int8 _ => true
| AST.Init_int16 _ => true
| AST.Init_int32 _ => true
| AST.Init_int64 _ => true
| AST.Init_float32 _ => true
| AST.Init_float64 _ => true
| AST.Init_space _ => true
| AST.Init_addrof i _ =>
    match @Globalenvs.Genv.find_symbol F V ge i return bool with
    | Some _ => true
    | None => false
    end
end
     : forall (F V : Type) (_ : Globalenvs.Genv.t F V) (_ : AST.init_data), bool

Arguments jet_sha_startup_init.addrof_defined_b {F V}%type_scope ge d
DELTA_DEEP_DEF C.jet_sha_startup_init.globvar_init_ok
jet_sha_startup_init.globvar_init_ok =
fun (F V : Type) (ge : Globalenvs.Genv.t F V) (g : AST.globdef F V) =>
match g return bool with
| AST.Gfun _ => true
| AST.Gvar v =>
    andb (jet_sha_startup_init.init_aligned_b BinNums.Z0 (@AST.gvar_init V v))
      (@List.forallb AST.init_data (@jet_sha_startup_init.addrof_defined_b F V ge) (@AST.gvar_init V v))
end
     : forall (F V : Type) (_ : Globalenvs.Genv.t F V) (_ : AST.globdef F V), bool

Arguments jet_sha_startup_init.globvar_init_ok {F V}%type_scope ge g
DELTA_DEEP_DEF C.jet_sha_startup_executable.sha_total_runs_on_fresh_frames
jet_sha_startup_executable.sha_total_runs_on_fresh_frames =
fun (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, Ty.tySem B) =>
forall (a : Ty.tySem A) (env : Values.val) (m0 : Memory.Mem.mem) (_ : jet_sha_startup_state.sha_startup_state m0),
@ex Memory.Mem.mem
  (fun m : Memory.Mem.mem =>
   @ex Values.block
     (fun bd : Values.block =>
      @ex Values.block
        (fun bs : Values.block =>
         @ex Values.block
           (fun bw : Values.block =>
            @ex Memory.Mem.mem
              (fun mf : Memory.Mem.mem =>
               and
                 (ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function f)
                    (@cons Values.val (Values.Vptr bd (Integers.Ptrofs.repr BinNums.Z0))
                       (@cons Values.val (Values.Vptr bs (Integers.Ptrofs.repr BinNums.Z0))
                          (@cons Values.val env (@nil Values.val)))) Events.E0 mf (Values.Vint Integers.Int.one))
                 (and (frame_output_cells_at mf bw BinNums.Z0 (BinInt.Z.of_nat (bitSize B)) (@encode B (spec a)))
                    (and (jet_sha_startup_state.sha_startup_state mf)
                       (forall (b : Values.block) (chunk : AST.memory_chunk) (ofs : BinNums.Z)
                          (_ : Memory.Mem.valid_block m0 b),
                        @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m0 b ofs)))))))))
     : forall (_ : Clight.function) (A B : Ty.Ty) (_ : forall _ : Ty.tySem A, Ty.tySem B), Prop

