                count) (_ : write_frame_at m bf base bw edge cursor count)
         (_ : forall (chunk : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
                (_ : or (not (@eq Values.block b bf))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add base (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
                          (BinInt.Z.le
                             (BinInt.Z.add base
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ofs)))
                (_ : or (not (@eq Values.block b bw))
                       (or
                          (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk chunk))
                             (BinInt.Z.add edge
                                (BinInt.Z.mul (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                   (BinInt.Z.div (BinInt.Z.sub cursor count)
                                      (BinNums.Zpos
                                         (BinNums.xO
                                            (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
                          (BinInt.Z.le
                             (BinInt.Z.add (jet_write_layout.write_word_address edge cursor)
                                (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))) ofs))),
              @eq (option Values.val) (Memory.Mem.load chunk mf b ofs) (Memory.Mem.load chunk m b ofs))
         (_ : jet_sha_startup_state.sha_startup_state m), jet_sha_startup_state.sha_startup_state mf
