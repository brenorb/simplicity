DELTA_DEEP_TYPE C.jet_sha_startup_executable.sha_startup_frames_constructible
jet_sha_startup_executable.sha_startup_frames_constructible
     : forall (m0 : Memory.Mem.mem) (cells : list Cell) (count : BinNums.Z)
         (_ : jet_sha_startup_state.sha_startup_state m0)
         (_ : BinInt.Z.le (BinInt.Z.of_nat (@length Cell cells)) Integers.Int64.max_unsigned)
         (_ : and (BinInt.Z.le BinNums.Z0 count) (BinInt.Z.le count Integers.Int64.max_unsigned)),
       @ex Memory.Mem.mem
         (fun m : Memory.Mem.mem =>
          @ex Values.block
            (fun bd : Values.block =>
             @ex Values.block
               (fun bs : Values.block =>
                @ex Values.block
                  (fun bi : Values.block =>
                   @ex Values.block
                     (fun bw : Values.block =>
                      @ex BinNums.Z
                        (fun edge : BinNums.Z =>
                         and (jet_sha_startup_state.sha_startup_state m)
                           (and (frame_base_valid BinNums.Z0)
                              (and
                                 (BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
                                    BinNums.Z0)
                                 (and (frame_fields_at m bs BinNums.Z0 bi edge BinNums.Z0)
                                    (and (frame_input_cells_at m bi edge BinNums.Z0 cells)
                                       (and (write_frame_at m bd BinNums.Z0 bw BinNums.Z0 count count)
                                          (forall (b : Values.block) (_ : Memory.Mem.valid_block m0 b),
                                           and (Memory.Mem.valid_block m b)
                                             (and (not (@eq Values.block b bd))
                                                (and (not (@eq Values.block b bw))
                                                   (forall (chunk : AST.memory_chunk) (ofs : BinNums.Z),
                                                    @eq (option Values.val) (Memory.Mem.load chunk m b ofs)
                                                      (Memory.Mem.load chunk m0 b ofs))))))))))))))))
