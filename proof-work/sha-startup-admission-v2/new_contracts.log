DELTA_DEEP_TYPE C.jet_sha_startup_lifecycle.sha_total_call_preserves
jet_sha_startup_lifecycle.sha_total_call_preserves
     : forall (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, Ty.tySem B)
         (_ : jet_sha_startup_state.sha_startup_total_spec f A B spec) (env : Values.val) (m : Memory.Mem.mem)
         (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z) (bi bw : Values.block)
         (edge outedge cursor read_cursor : BinNums.Z) (a : Ty.tySem A) (t : Events.trace) 
         (mf : Memory.Mem.mem) (v : Values.val) (_ : jet_sha_startup_state.sha_startup_state m)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize A))) Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor (@encode A a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B)))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function f)
                (jet_sha_startup_lifecycle.jet_call_args bd dbase bs sbase env) t mf v),
       and (@eq Events.trace t Events.E0)
         (and (@eq Values.val v (Values.Vint Integers.Int.one))
            (and (jet_sha_startup_state.sha_startup_state mf)
               (frame_output_cells_at mf bw outedge cursor (@encode B (spec a)))))
DELTA_DEEP_TYPE C.jet_sha_startup_lifecycle.sha_partial_call_preserves
jet_sha_startup_lifecycle.sha_partial_call_preserves
     : forall (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, option (Ty.tySem B))
         (_ : jet_sha_startup_state.sha_startup_partial_spec f A B spec) (env : Values.val) 
         (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block) (sbase : BinNums.Z)
         (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z) (a : Ty.tySem A) 
         (t : Events.trace) (mf : Memory.Mem.mem) (v : Values.val) (_ : jet_sha_startup_state.sha_startup_state m)
         (_ : frame_base_valid sbase)
         (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) sbase)
         (_ : frame_fields_at m bs sbase bi edge read_cursor) (_ : BinInt.Z.le BinNums.Z0 read_cursor)
         (_ : BinInt.Z.le (BinInt.Z.add read_cursor (BinInt.Z.of_nat (bitSize A))) Integers.Int64.max_unsigned)
         (_ : frame_input_cells_at m bi edge read_cursor (@encode A a))
         (_ : write_frame_at m bd dbase bw outedge cursor (BinInt.Z.of_nat (bitSize B)))
         (_ : ClightBigstep.Clight2.eval_funcall sha_ge m (@Ctypes.Internal Clight.function f)
                (jet_sha_startup_lifecycle.jet_call_args bd dbase bs sbase env) t mf v),
       and (@eq Events.trace t Events.E0)
         (and (@eq Values.val v (@jet_partial_return (Ty.tySem B) (spec a)))
