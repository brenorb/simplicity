DELTA_COMPACT_DEF C.jet_sha_initial_globals.sha_original_global_state
jet_sha_initial_globals.sha_original_global_state =
fun m : Memory.Mem.mem =>
and (sha_globals_ok m)
  (and
     (forall ofs : BinNums.Z,
      not (Memory.Mem.perm m (sha_symbol_block jets_sha._sha256_max_counter) ofs Memtype.Cur Memtype.Writable))
     (forall (ofs : BinNums.Z) (k : Memtype.perm_kind) (perm : Memtype.permission)
        (_ : Memory.Mem.perm m (sha_symbol_block jets_sha._simplicity_sha256_compression) ofs k perm),
      and (BinInt.Z.le BinNums.Z0 ofs)
        (BinInt.Z.lt ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : forall _ : Memory.Mem.mem, Prop

Arguments jet_sha_initial_globals.sha_original_global_state m
DELTA_COMPACT_DEF C.jet_sha_startup_globals.sha_persistent_global_state
jet_sha_startup_globals.sha_persistent_global_state =
fun m : Memory.Mem.mem =>
and (sha_globals_ok m)
  (and
     (forall ofs : BinNums.Z,
      not (Memory.Mem.perm m (sha_symbol_block jets_sha._sha256_max_counter) ofs Memtype.Max Memtype.Writable))
     (forall (ofs : BinNums.Z) (p : Memtype.permission)
        (_ : Memory.Mem.perm m (sha_symbol_block jets_sha._simplicity_sha256_compression) ofs Memtype.Max p),
      and (BinInt.Z.le BinNums.Z0 ofs)
        (BinInt.Z.lt ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
     : forall _ : Memory.Mem.mem, Prop

Arguments jet_sha_startup_globals.sha_persistent_global_state m
DELTA_COMPACT_DEF C.jet_sha_startup_state.sha_tag_extents
jet_sha_startup_state.sha_tag_extents =
fun m : Memory.Mem.mem =>
and
  (forall (ofs : BinNums.Z) (p : Memtype.permission)
     (_ : Memory.Mem.perm m (sha_symbol_block jets_sha._tagName) ofs Memtype.Max p),
   and (BinInt.Z.le BinNums.Z0 ofs) (BinInt.Z.lt ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
  (and
     (forall (ofs : BinNums.Z) (p : Memtype.permission)
        (_ : Memory.Mem.perm m (sha_symbol_block jets_sha._tagName__1) ofs Memtype.Max p),
      and (BinInt.Z.le BinNums.Z0 ofs)
        (BinInt.Z.lt ofs (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
     (forall (ofs : BinNums.Z) (p : Memtype.permission)
        (_ : Memory.Mem.perm m (sha_symbol_block jets_sha._tagName__2) ofs Memtype.Max p),
      and (BinInt.Z.le BinNums.Z0 ofs)
        (BinInt.Z.lt ofs (BinNums.Zpos (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
     : forall _ : Memory.Mem.mem, Prop

Arguments jet_sha_startup_state.sha_tag_extents m
DELTA_COMPACT_DEF C.jet_sha_startup_state.sha_tags_state
jet_sha_startup_state.sha_tags_state =
fun m : Memory.Mem.mem =>
and (sha_tag_ok m)
  (and (sha_tapleaf_tag_ok m) (and (sha_tapbranch_tag_ok m) (jet_sha_startup_state.sha_tag_extents m)))
     : forall _ : Memory.Mem.mem, Prop

Arguments jet_sha_startup_state.sha_tags_state m
DELTA_COMPACT_DEF C.jet_sha_startup_state.sha_startup_state
jet_sha_startup_state.sha_startup_state =
fun m : Memory.Mem.mem =>
and (jet_sha_startup_globals.sha_persistent_global_state m) (jet_sha_startup_state.sha_tags_state m)
     : forall _ : Memory.Mem.mem, Prop

Arguments jet_sha_startup_state.sha_startup_state m
DELTA_COMPACT_DEF C.jet_sha_startup_state.sha_startup_total_spec
jet_sha_startup_state.sha_startup_total_spec =
fun (f : Clight.function) (A B : Ty.Ty) (spec : forall _ : Ty.tySem A, Ty.tySem B) =>
forall (env : Values.val) (m : Memory.Mem.mem) (bd : Values.block) (dbase : BinNums.Z) (bs : Values.block)
  (sbase : BinNums.Z) (bi bw : Values.block) (edge outedge cursor read_cursor : BinNums.Z) 
  (a : Ty.tySem A) (_ : jet_sha_startup_state.sha_startup_state m) (_ : frame_base_valid sbase)
