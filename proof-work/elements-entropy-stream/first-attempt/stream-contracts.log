                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit))
                          (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit)))))
                 (prod
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit))
                          (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit))))
                    ((fix tySem (X : Ty.Ty) : Set :=
                        match X return Set with
                        | Ty.Unit => unit
                        | Ty.Sum A B => sum (tySem A) (tySem B)
                        | Ty.Prod A B => prod (tySem A) (tySem B)
                        end)
                       (Ty.Prod (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit))
                          (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Ty.Sum Ty.Unit Ty.Unit))))) b a)
        end
    end
end
     : forall _ : Ty.tySem (Word.Word (S (S (S (S (S O)))))), Ty.tySem (Word.Word (S (S (S (S (S O))))))

