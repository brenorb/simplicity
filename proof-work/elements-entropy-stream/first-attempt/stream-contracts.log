TAP_DEF EntropyStreaming.Calls.entropy_helper_word_call
Calls.entropy_helper_word_call =
forall (m : Memory.Mem.mem) (bres : Values.block) (ores : BinNums.Z) (bop : Values.block) (oop : BinNums.Z)
  (bcon : Values.block) (ocon : Integers.Ptrofs.int) (h : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (ix : Ty.tySem (Word.Word (S (S (S (S (S O))))))) (contract : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
  (_ : BinInt.Z.le BinNums.Z0 ores)
  (_ : BinInt.Z.le
         (BinInt.Z.add ores (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         Integers.Ptrofs.max_unsigned) (_ : BinInt.Z.divide (BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH))) ores)
  (_ : Memory.Mem.range_perm m bres ores
         (BinInt.Z.add ores (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         Memtype.Cur Memtype.Writable) (_ : BinInt.Z.le BinNums.Z0 oop)
  (_ : BinInt.Z.le
         (BinInt.Z.add oop (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH)))))))
         Integers.Ptrofs.max_unsigned)
  (_ : jet_uint32_array_init.uint32_array_at m bop oop (Digest.hash256_reg (Word.to_hash256 h)))
  (_ : @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m bop
            (BinInt.Z.add oop
               (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))
         (@Some Values.val
            (Values.Vlong (Integers.Int64.repr (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) ix)))))
  (_ : BinInt.Z.le
         (BinInt.Z.add (Integers.Ptrofs.unsigned ocon)
            (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
         Integers.Ptrofs.max_unsigned)
  (_ : jet_uint32_array_init.uint32_array_at m bcon (Integers.Ptrofs.unsigned ocon)
         (Digest.hash256_reg (Word.to_hash256 contract)))
  (_ : @eq (option Values.val)
         (Memory.Mem.load AST.Mptr m
            (jet_elements_linkage.elements_symbol_block jets_elements._simplicity_sha256_compression) BinNums.Z0)
         (@Some Values.val
            (Values.Vptr (jet_elements_linkage.elements_symbol_block jets_elements._sha256_compression_portable)
               Integers.Ptrofs.zero)))
  (_ : @eq (option Values.val)
         (Memory.Mem.load AST.Mint64 m (jet_elements_linkage.elements_symbol_block jets_elements._sha256_max_counter)
            BinNums.Z0) (@Some Values.val (Values.Vlong jet_sha_uchars_exec.sha_max_counter))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   and
     (ClightBigstep.Clight2.eval_funcall jet_elements_linkage.elements_ge m
        (@Ctypes.Internal Clight.function jets_elements.f_simplicity_generateIssuanceEntropy)
        (@cons Values.val (Values.Vptr bres (Integers.Ptrofs.repr ores))
           (@cons Values.val (Values.Vptr bop (Integers.Ptrofs.repr oop))
              (@cons Values.val (Values.Vptr bcon ocon) (@nil Values.val)))) Events.E0 mf Values.Vundef)
     (and
        (jet_uint32_array_init.uint32_array_at mf bres ores
           (Digest.hash256_reg
              (Word.to_hash256
                 (@jet_elements_issuance_calc_spec.calculate_issuance_entropy_spec Alg.CoreFunSem
                    (@pair
                       (prod (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S O))))))))
                       (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                       (@pair (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                          (Ty.tySem (Word.Word (S (S (S (S (S O))))))) h ix) contract)))))
        (and
           (forall (ch : AST.memory_chunk) (b : Values.block) (ofs : BinNums.Z) (_ : Memory.Mem.valid_block m b)
              (_ : or (not (@eq Values.block b bres))
                     (or (BinInt.Z.le (BinInt.Z.add ofs (Memdata.size_chunk ch)) ores)
                        (BinInt.Z.le
                           (BinInt.Z.add ores
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))
                           ofs))), @eq (option Values.val) (Memory.Mem.load ch mf b ofs) (Memory.Mem.load ch m b ofs))
           (and
              (forall (b : Values.block) (ofs : BinNums.Z) (k : Memtype.perm_kind) (p : Memtype.permission)
                 (_ : Memory.Mem.perm m b ofs k p), Memory.Mem.perm mf b ofs k p)
              (forall (b : Values.block) (_ : Memory.Mem.valid_block m b), Memory.Mem.valid_block mf b)))))
     : Prop
