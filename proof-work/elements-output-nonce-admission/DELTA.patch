+    stop = 'bool simplicity_build_tapleaf_simplicity('
+    if c.count(start) != 1 or c.count(stop) != 1:
+        raise ValueError('missing/ambiguous actual C jet')
+    cbody = c.split(start, 1)[1].split(stop, 1)[0]
