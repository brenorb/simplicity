(** Integer model of the event log of the original [secp256k1_fe_sqr] run
    (log and definitions generated by
    proof-work/fe-multiply-parallel/tools/gen_fe_mul_model.py sqr; [fe_sqr_log]
    is re-checked against the actual executor run).  The output words are
    related to the product by instantiating the multiplication dataflow
    theorem [fe_mul_core] with b = a: each doubled product of the squaring
    code is split into its two symmetric products. *)
From Coq Require Import ZArith List Lia.
From compcert Require Import AST Ctypes Integers Values.
Require Import C.jet_sx_expr C.jet_sx_eval C.jet_sx_exec.
Require Import C.jet_secp_fe_math C.jet_parallel_fe_mul_math C.jet_parallel_fe_mul_oracle.
Require Import C.jet_parallel_fe_mul_shift C.jet_parallel_fe_mul_model.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 20.

Lemma uns_mul2 x : Int64.unsigned x < 2 ^ 63 ->
  Int64.unsigned (Int64.mul x (Int64.repr (Int.signed (Int.repr 2)))) = 2 * Int64.unsigned x.
Proof.
  intros H. pose proof (Int64.unsigned_range x).
  unfold Int64.mul. change (Int64.unsigned (Int64.repr (Int.signed (Int.repr 2)))) with 2.
  rewrite Z.mul_comm. apply Int64.unsigned_repr. change Int64.max_unsigned with (2 ^ 64 - 1). lia.
Qed.
Lemma uns_shr48 x : Int64.unsigned x < 2 ^ 63 ->
  Int64.unsigned (Int64.shr x (Int64.repr 48)) = Int64.unsigned x / 2 ^ 48.
Proof.
  intros H. pose proof (Int64.unsigned_range x).
  rewrite Int64.shr_div_two_p. change (two_p (Int64.unsigned (Int64.repr 48))) with (2 ^ 48).
  rewrite Int64.signed_eq_unsigned
    by (unfold Int64.max_signed, Int64.half_modulus; change Int64.modulus with (2 ^ 64); cbn; lia).
  apply Int64.unsigned_repr. change Int64.max_unsigned with (2 ^ 64 - 1).
  split; [apply Z.div_pos; lia|]. assert (Int64.unsigned x / 2 ^ 48 <= Int64.unsigned x)
    by (apply Z.div_le_upper_bound; lia). lia.
Qed.
Lemma uns_u0s W48 W36 :
  Int64.unsigned (Int64.or (Int64.shl (Int64.and (fm_lo W48) (Int64.repr 4503599627370495)) (Int64.repr 4))
    (Int64.shr (Int64.and (fm_lo W36) (Int64.repr 4503599627370495)) (Int64.repr 48))) =
  Z.lor ((Z.land (W48 mod 2 ^ 64) 4503599627370495 * 2 ^ 4) mod 2 ^ 64)
    (Z.land (W36 mod 2 ^ 64) 4503599627370495 / 2 ^ 48).
Proof.
  rewrite uns_or, uns_shl4, uns_shr48, !uns_and_lo; [reflexivity|].
  rewrite uns_and_lo. pose proof (Z.mod_pos_bound W36 (2 ^ 64) ltac:(lia)).
  pose proof (land_le_l (W36 mod 2 ^ 64) 4503599627370495 ltac:(lia) ltac:(lia)).
  assert (Z.land (W36 mod 2 ^ 64) 4503599627370495 <= 4503599627370495).
  { rewrite Z.land_comm. apply land_le_l; lia. }
  lia.
Qed.

Definition fe_sqr_log : list event := [
  mkev tMUL 5 2 [XLb Bmul (XLv 0) (XI2L Signed (XIc (Int.repr 2))); XLv 3];
  mkev tACC 7 2 [XLv 5; XLv 6; XLb Bmul (XLv 1) (XI2L Signed (XIc (Int.repr 2))); XLv 2];
  mkev tMUL 9 2 [XLv 4; XLv 4];
  mkev tACC 11 2 [XLv 7; XLv 8; XLc (Int64.repr 68719492368); XLv 9];
  mkev tSHR64 13 2 [XLv 9; XLv 10];
  mkev tSHR52 15 2 [XLv 11; XLv 12];
  mkev tACC 17 2 [XLv 15; XLv 16; XLv 0; XLb Bmul (XLv 4) (XI2L Signed (XIc (Int.repr 2)))];
  mkev tACC 19 2 [XLv 17; XLv 18; XLb Bmul (XLv 1) (XI2L Signed (XIc (Int.repr 2))); XLv 3];
  mkev tACC 21 2 [XLv 19; XLv 20; XLv 2; XLv 2];
  mkev tACC 23 2 [XLv 21; XLv 22; XLsh Hshl (XLc (Int64.repr 68719492368)) 12; XLv 13];
  mkev tSHR52 25 2 [XLv 23; XLv 24];
  mkev tMUL 27 2 [XLv 0; XLv 0];
  mkev tACC 29 2 [XLv 25; XLv 26; XLv 1; XLb Bmul (XLv 4) (XI2L Signed (XIc (Int.repr 2)))];
  mkev tACC 31 2 [XLv 29; XLv 30; XLb Bmul (XLv 2) (XI2L Signed (XIc (Int.repr 2))); XLv 3];
  mkev tSHR52 33 2 [XLv 31; XLv 32];
  mkev tACC 35 2 [XLv 27; XLv 28; XLb Bor (XLsh Hshl (XLb Band (XLv 31) (XLc (Int64.repr 4503599627370495))) 4) (XLsh Hshr (XLb Band (XLv 23) (XLc (Int64.repr 4503599627370495))) 48); XLsh Hshru (XLc (Int64.repr 68719492368)) 4];
  mkev tSHR52 37 2 [XLv 35; XLv 36];
  mkev tACC 39 2 [XLv 37; XLv 38; XLb Bmul (XLv 0) (XI2L Signed (XIc (Int.repr 2))); XLv 1];
  mkev tACC 41 2 [XLv 33; XLv 34; XLv 2; XLb Bmul (XLv 4) (XI2L Signed (XIc (Int.repr 2)))];
  mkev tACC 43 2 [XLv 41; XLv 42; XLv 3; XLv 3];
  mkev tACC 45 2 [XLv 39; XLv 40; XLb Band (XLv 43) (XLc (Int64.repr 4503599627370495)); XLc (Int64.repr 68719492368)];
  mkev tSHR52 47 2 [XLv 43; XLv 44];
  mkev tSHR52 49 2 [XLv 45; XLv 46];
  mkev tACC 51 2 [XLv 49; XLv 50; XLb Bmul (XLv 0) (XI2L Signed (XIc (Int.repr 2))); XLv 2];
  mkev tACC 53 2 [XLv 51; XLv 52; XLv 1; XLv 1];
  mkev tACC 55 2 [XLv 47; XLv 48; XLv 3; XLb Bmul (XLv 4) (XI2L Signed (XIc (Int.repr 2)))];
  mkev tACC 57 2 [XLv 53; XLv 54; XLc (Int64.repr 68719492368); XLv 55];
  mkev tSHR64 59 2 [XLv 55; XLv 56];
  mkev tSHR52 61 2 [XLv 57; XLv 58];
  mkev tACC 63 2 [XLv 61; XLv 62; XLsh Hshl (XLc (Int64.repr 68719492368)) 12; XLv 59];
  mkev tADD 65 2 [XLv 63; XLv 64; XLb Band (XLv 11) (XLc (Int64.repr 4503599627370495))];
  mkev tSHR52 67 2 [XLv 65; XLv 66]
].

Section MODEL.
Variables a0 a1 a2 a3 a4 : int64.
Definition S5 : Z := Int64.unsigned (Int64.mul a0 (Int64.repr (Int.signed (Int.repr 2)))) * Int64.unsigned a3.
Definition S7 : Z := (Int64.unsigned (fm_hi S5) * 2 ^ 64 + Int64.unsigned (fm_lo S5) + Int64.unsigned (Int64.mul a1 (Int64.repr (Int.signed (Int.repr 2)))) * Int64.unsigned a2) mod 2 ^ 128.
Definition S9 : Z := Int64.unsigned a4 * Int64.unsigned a4.
Definition S11 : Z := (Int64.unsigned (fm_hi S7) * 2 ^ 64 + Int64.unsigned (fm_lo S7) + Int64.unsigned (Int64.repr 68719492368) * Int64.unsigned (fm_lo S9)) mod 2 ^ 128.
Definition S13 : Z := (Int64.unsigned (fm_hi S9) * 2 ^ 64 + Int64.unsigned (fm_lo S9)) / 2 ^ 64.
Definition S15 : Z := (Int64.unsigned (fm_hi S11) * 2 ^ 64 + Int64.unsigned (fm_lo S11)) / 2 ^ 52.
Definition S17 : Z := (Int64.unsigned (fm_hi S15) * 2 ^ 64 + Int64.unsigned (fm_lo S15) + Int64.unsigned a0 * Int64.unsigned (Int64.mul a4 (Int64.repr (Int.signed (Int.repr 2))))) mod 2 ^ 128.
Definition S19 : Z := (Int64.unsigned (fm_hi S17) * 2 ^ 64 + Int64.unsigned (fm_lo S17) + Int64.unsigned (Int64.mul a1 (Int64.repr (Int.signed (Int.repr 2)))) * Int64.unsigned a3) mod 2 ^ 128.
Definition S21 : Z := (Int64.unsigned (fm_hi S19) * 2 ^ 64 + Int64.unsigned (fm_lo S19) + Int64.unsigned a2 * Int64.unsigned a2) mod 2 ^ 128.
Definition S23 : Z := (Int64.unsigned (fm_hi S21) * 2 ^ 64 + Int64.unsigned (fm_lo S21) + Int64.unsigned (Int64.shl (Int64.repr 68719492368) (Int64.repr 12)) * Int64.unsigned (fm_lo S13)) mod 2 ^ 128.
Definition S25 : Z := (Int64.unsigned (fm_hi S23) * 2 ^ 64 + Int64.unsigned (fm_lo S23)) / 2 ^ 52.
Definition S27 : Z := Int64.unsigned a0 * Int64.unsigned a0.
Definition S29 : Z := (Int64.unsigned (fm_hi S25) * 2 ^ 64 + Int64.unsigned (fm_lo S25) + Int64.unsigned a1 * Int64.unsigned (Int64.mul a4 (Int64.repr (Int.signed (Int.repr 2))))) mod 2 ^ 128.
Definition S31 : Z := (Int64.unsigned (fm_hi S29) * 2 ^ 64 + Int64.unsigned (fm_lo S29) + Int64.unsigned (Int64.mul a2 (Int64.repr (Int.signed (Int.repr 2)))) * Int64.unsigned a3) mod 2 ^ 128.
Definition S33 : Z := (Int64.unsigned (fm_hi S31) * 2 ^ 64 + Int64.unsigned (fm_lo S31)) / 2 ^ 52.
Definition S35 : Z := (Int64.unsigned (fm_hi S27) * 2 ^ 64 + Int64.unsigned (fm_lo S27) + Int64.unsigned (Int64.or (Int64.shl (Int64.and (fm_lo S31) (Int64.repr 4503599627370495)) (Int64.repr 4)) (Int64.shr (Int64.and (fm_lo S23) (Int64.repr 4503599627370495)) (Int64.repr 48))) * Int64.unsigned (Int64.shru (Int64.repr 68719492368) (Int64.repr 4))) mod 2 ^ 128.
Definition S37 : Z := (Int64.unsigned (fm_hi S35) * 2 ^ 64 + Int64.unsigned (fm_lo S35)) / 2 ^ 52.
Definition S39 : Z := (Int64.unsigned (fm_hi S37) * 2 ^ 64 + Int64.unsigned (fm_lo S37) + Int64.unsigned (Int64.mul a0 (Int64.repr (Int.signed (Int.repr 2)))) * Int64.unsigned a1) mod 2 ^ 128.
Definition S41 : Z := (Int64.unsigned (fm_hi S33) * 2 ^ 64 + Int64.unsigned (fm_lo S33) + Int64.unsigned a2 * Int64.unsigned (Int64.mul a4 (Int64.repr (Int.signed (Int.repr 2))))) mod 2 ^ 128.
Definition S43 : Z := (Int64.unsigned (fm_hi S41) * 2 ^ 64 + Int64.unsigned (fm_lo S41) + Int64.unsigned a3 * Int64.unsigned a3) mod 2 ^ 128.
Definition S45 : Z := (Int64.unsigned (fm_hi S39) * 2 ^ 64 + Int64.unsigned (fm_lo S39) + Int64.unsigned (Int64.and (fm_lo S43) (Int64.repr 4503599627370495)) * Int64.unsigned (Int64.repr 68719492368)) mod 2 ^ 128.
Definition S47 : Z := (Int64.unsigned (fm_hi S43) * 2 ^ 64 + Int64.unsigned (fm_lo S43)) / 2 ^ 52.
Definition S49 : Z := (Int64.unsigned (fm_hi S45) * 2 ^ 64 + Int64.unsigned (fm_lo S45)) / 2 ^ 52.
Definition S51 : Z := (Int64.unsigned (fm_hi S49) * 2 ^ 64 + Int64.unsigned (fm_lo S49) + Int64.unsigned (Int64.mul a0 (Int64.repr (Int.signed (Int.repr 2)))) * Int64.unsigned a2) mod 2 ^ 128.
Definition S53 : Z := (Int64.unsigned (fm_hi S51) * 2 ^ 64 + Int64.unsigned (fm_lo S51) + Int64.unsigned a1 * Int64.unsigned a1) mod 2 ^ 128.
Definition S55 : Z := (Int64.unsigned (fm_hi S47) * 2 ^ 64 + Int64.unsigned (fm_lo S47) + Int64.unsigned a3 * Int64.unsigned (Int64.mul a4 (Int64.repr (Int.signed (Int.repr 2))))) mod 2 ^ 128.
Definition S57 : Z := (Int64.unsigned (fm_hi S53) * 2 ^ 64 + Int64.unsigned (fm_lo S53) + Int64.unsigned (Int64.repr 68719492368) * Int64.unsigned (fm_lo S55)) mod 2 ^ 128.
Definition S59 : Z := (Int64.unsigned (fm_hi S55) * 2 ^ 64 + Int64.unsigned (fm_lo S55)) / 2 ^ 64.
Definition S61 : Z := (Int64.unsigned (fm_hi S57) * 2 ^ 64 + Int64.unsigned (fm_lo S57)) / 2 ^ 52.
Definition S63 : Z := (Int64.unsigned (fm_hi S61) * 2 ^ 64 + Int64.unsigned (fm_lo S61) + Int64.unsigned (Int64.shl (Int64.repr 68719492368) (Int64.repr 12)) * Int64.unsigned (fm_lo S59)) mod 2 ^ 128.
Definition S65 : Z := (Int64.unsigned (fm_hi S63) * 2 ^ 64 + Int64.unsigned (fm_lo S63) + Int64.unsigned (Int64.and (fm_lo S11) (Int64.repr 4503599627370495))) mod 2 ^ 128.
Definition S67 : Z := (Int64.unsigned (fm_hi S65) * 2 ^ 64 + Int64.unsigned (fm_lo S65)) / 2 ^ 52.
Definition fs_rho (n : nat) : int64 :=
  match n with
  | 0 => a0
  | 1 => a1
  | 2 => a2
  | 3 => a3
  | 4 => a4
  | 5 => fm_lo S5 | 6 => fm_hi S5
  | 7 => fm_lo S7 | 8 => fm_hi S7
  | 9 => fm_lo S9 | 10 => fm_hi S9
  | 11 => fm_lo S11 | 12 => fm_hi S11
  | 13 => fm_lo S13 | 14 => fm_hi S13
  | 15 => fm_lo S15 | 16 => fm_hi S15
  | 17 => fm_lo S17 | 18 => fm_hi S17
  | 19 => fm_lo S19 | 20 => fm_hi S19
  | 21 => fm_lo S21 | 22 => fm_hi S21
  | 23 => fm_lo S23 | 24 => fm_hi S23
  | 25 => fm_lo S25 | 26 => fm_hi S25
  | 27 => fm_lo S27 | 28 => fm_hi S27
  | 29 => fm_lo S29 | 30 => fm_hi S29
  | 31 => fm_lo S31 | 32 => fm_hi S31
  | 33 => fm_lo S33 | 34 => fm_hi S33
  | 35 => fm_lo S35 | 36 => fm_hi S35
  | 37 => fm_lo S37 | 38 => fm_hi S37
  | 39 => fm_lo S39 | 40 => fm_hi S39
  | 41 => fm_lo S41 | 42 => fm_hi S41
  | 43 => fm_lo S43 | 44 => fm_hi S43
  | 45 => fm_lo S45 | 46 => fm_hi S45
  | 47 => fm_lo S47 | 48 => fm_hi S47
  | 49 => fm_lo S49 | 50 => fm_hi S49
  | 51 => fm_lo S51 | 52 => fm_hi S51
  | 53 => fm_lo S53 | 54 => fm_hi S53
  | 55 => fm_lo S55 | 56 => fm_hi S55
  | 57 => fm_lo S57 | 58 => fm_hi S57
  | 59 => fm_lo S59 | 60 => fm_hi S59
  | 61 => fm_lo S61 | 62 => fm_hi S61
  | 63 => fm_lo S63 | 64 => fm_hi S63
  | 65 => fm_lo S65 | 66 => fm_hi S65
  | 67 => fm_lo S67 | 68 => fm_hi S67
  | _ => Int64.zero end%nat.
Definition fs_ws : list Z := [S5; S7; S9; S11; S13; S15; S17; S19; S21; S23; S25; S27; S29; S31; S33; S35; S37; S39; S41; S43; S45; S47; S49; S51; S53; S55; S57; S59; S61; S63; S65; S67].

Lemma fs_ranges : Forall (fun w => 0 <= w < 2 ^ 128) fs_ws.
Proof. unfold fs_ws. repeat (apply Forall_cons; [range_tac|]). apply Forall_nil. Qed.

Theorem fs_solves : Forall (u128_evok fs_rho) fe_sqr_log.
Proof.
  unfold fe_sqr_log.
  repeat (apply Forall_cons;
    [eapply evok_intro; [reflexivity|reflexivity|reflexivity|range_tac]|]).
  apply Forall_nil.
Qed.

Definition fs_t0 := Int64.and (fm_lo S35) (Int64.repr 4503599627370495).
Definition fs_t1 := Int64.and (fm_lo S45) (Int64.repr 4503599627370495).
Definition fs_t2 := Int64.and (fm_lo S57) (Int64.repr 4503599627370495).
Definition fs_t3 := Int64.and (fm_lo S65) (Int64.repr 4503599627370495).
Definition fs_t4 := Int64.add (fm_lo S67)
  (Int64.and (Int64.and (fm_lo S23) (Int64.repr 4503599627370495))
    (Int64.shru (Int64.repr 4503599627370495) (Int64.repr 4))).

Ltac sstep := rewrite ?fm_join by range_tac;
  rewrite ?uns_R, ?uns_R12, ?uns_R4, ?uns_and_lo, ?uns_u0s, ?uns_fm_lo; try reflexivity.
Ltac jn := rewrite fm_join by range_tac.
Ltac merge := rewrite ?uns_mul2 by lia;
  repeat (first [rewrite Z.add_mod_idemp_l by lia
                |rewrite <- (Z.add_assoc (_ mod 2 ^ 128))]); f_equal;
  repeat match goal with z := Int64.unsigned _ |- _ => subst z end; ring.

Theorem fs_sqr_values :
  fe_limbs_ok (Int64.unsigned a0) (Int64.unsigned a1) (Int64.unsigned a2)
    (Int64.unsigned a3) (Int64.unsigned a4) ->
  Int64.unsigned fs_t0 <= M52 /\ Int64.unsigned fs_t1 <= M52 /\ Int64.unsigned fs_t2 <= M52 /\
  Int64.unsigned fs_t3 <= M52 /\ Int64.unsigned fs_t4 < 2 ^ 49 /\
  fe_val (Int64.unsigned fs_t0) (Int64.unsigned fs_t1) (Int64.unsigned fs_t2)
    (Int64.unsigned fs_t3) (Int64.unsigned fs_t4) mod feP =
  (fe_val (Int64.unsigned a0) (Int64.unsigned a1) (Int64.unsigned a2)
     (Int64.unsigned a3) (Int64.unsigned a4) *
   fe_val (Int64.unsigned a0) (Int64.unsigned a1) (Int64.unsigned a2)
     (Int64.unsigned a3) (Int64.unsigned a4)) mod feP.
Proof.
  intros HA.
  assert (Ht : Int64.unsigned fs_t0 = Z.land (S35 mod 2 ^ 64) M52 /\
    Int64.unsigned fs_t1 = Z.land (S45 mod 2 ^ 64) M52 /\
    Int64.unsigned fs_t2 = Z.land (S57 mod 2 ^ 64) M52 /\
    Int64.unsigned fs_t3 = Z.land (S65 mod 2 ^ 64) M52 /\
    Int64.unsigned fs_t4 = (S67 mod 2 ^ 64 + Z.land (Z.land (S23 mod 2 ^ 64) M52) (M52 / 2 ^ 4)) mod 2 ^ 64).
  { unfold fs_t0, fs_t1, fs_t2, fs_t3, fs_t4. rewrite !uns_and_lo.
    split; [reflexivity|]. split; [reflexivity|]. split; [reflexivity|]. split; [reflexivity|].
    rewrite uns_add, uns_and, uns_and_lo, uns_M4, uns_fm_lo. reflexivity. }
  destruct Ht as (-> & -> & -> & -> & ->).
  unfold fe_limbs_ok in HA.
  set (z0 := Int64.unsigned a0) in *. set (z1 := Int64.unsigned a1) in *.
  set (z2 := Int64.unsigned a2) in *. set (z3 := Int64.unsigned a3) in *.
  set (z4 := Int64.unsigned a4) in *.
  edestruct (fe_mul_core
    (z0 * z0) (z0 * z1) (z0 * z2) (z0 * z3) (z0 * z4)
    (z1 * z0) (z1 * z1) (z1 * z2) (z1 * z3) (z1 * z4)
    (z2 * z0) (z2 * z1) (z2 * z2) (z2 * z3) (z2 * z4)
    (z3 * z0) (z3 * z1) (z3 * z2) (z3 * z3) (z3 * z4)
    (z4 * z0) (z4 * z1) (z4 * z2) (z4 * z3) (z4 * z4)
    (z0 * z3) ((z0 * z3 + z1 * z2) mod 2 ^ 128) (((z0 * z3 + z1 * z2) mod 2 ^ 128 + z2 * z1) mod 2 ^ 128) S7
    S9 S11 S13 S15
    ((S15 + z0 * z4) mod 2 ^ 128) (((S15 + z0 * z4) mod 2 ^ 128 + z1 * z3) mod 2 ^ 128)
    ((((S15 + z0 * z4) mod 2 ^ 128 + z1 * z3) mod 2 ^ 128 + z2 * z2) mod 2 ^ 128)
    (((((S15 + z0 * z4) mod 2 ^ 128 + z1 * z3) mod 2 ^ 128 + z2 * z2) mod 2 ^ 128 + z3 * z1) mod 2 ^ 128) S21
    S23 S25 S27
    ((S25 + z1 * z4) mod 2 ^ 128) (((S25 + z1 * z4) mod 2 ^ 128 + z2 * z3) mod 2 ^ 128)
    ((((S25 + z1 * z4) mod 2 ^ 128 + z2 * z3) mod 2 ^ 128 + z3 * z2) mod 2 ^ 128) S31
    S33 S35 S37
    ((S37 + z0 * z1) mod 2 ^ 128) S39
    ((S33 + z2 * z4) mod 2 ^ 128) (((S33 + z2 * z4) mod 2 ^ 128 + z3 * z3) mod 2 ^ 128) S43
    S45 S47 S49
    ((S49 + z0 * z2) mod 2 ^ 128) (((S49 + z0 * z2) mod 2 ^ 128 + z1 * z1) mod 2 ^ 128) S53
    ((S47 + z3 * z4) mod 2 ^ 128) S55
    S57 S59 S61 S63 S65 S67) as (B0 & B1 & B2 & B3 & B4 & K & HK).
  all: unfold fe_mul_bound_BB, fe_mul_bound_BT, fe_mul_bound_TT.
  all: try (apply prod_bound; lia).
  all: try (rewrite (Z.mul_comm (2 ^ 52 - 1) (2 ^ 48 - 1)); apply prod_bound; lia).
  all: try reflexivity.
  all: try (match goal with |- ?w = ?r => let w' := eval red in w in change (w' = r) end;
    sstep; fail).
  all: try (unfold S7; jn; unfold S5; merge; fail).
  all: try (unfold S21; jn; unfold S19; jn; unfold S17; jn; merge; fail).
  all: try (unfold S31; jn; unfold S29; jn; merge; fail).
  all: try (unfold S39; jn; merge; fail).
  all: try (unfold S43; jn; unfold S41; jn; merge; fail).
  all: try (unfold S53; jn; unfold S51; jn; merge; fail).
  all: try (unfold S55; jn; merge; fail).
  - split; [lia|]. split; [lia|]. split; [lia|]. split; [lia|]. split; [exact (proj2 B4)|].
    rewrite <- (Z.mod_add _ K) by (unfold feP, feR; lia). rewrite HK. f_equal.
    unfold fe_val. ring.
Qed.
End MODEL.
Print Assumptions fs_solves.
Print Assumptions fs_sqr_values.
