                        (and
                           (Memory.Mem.range_perm mr ba BinNums.Z0
                              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                              Memtype.Cur Memtype.Freeable)
                           (and
                              (Memory.Mem.range_perm mr bb BinNums.Z0
                                 (BinNums.Zpos
                                    (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xI (BinNums.xO BinNums.xH))))))
                                 Memtype.Cur Memtype.Freeable)
                              (and
                                 (Memory.Mem.range_perm mr bl BinNums.Z0
                                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
                                    Memtype.Cur Memtype.Freeable)
                                 (and
                                    (jet_frame_layout.frame_fields_at mr bl BinNums.Z0 bi edge
                                       (BinInt.Z.add rc
                                          (BinNums.Zpos
                                             (BinNums.xO
                                                (BinNums.xO
                                                   (BinNums.xO
                                                      (BinNums.xO
                                                         (BinNums.xO
                                                            (BinNums.xO
                                                               (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))))))))
                                    (and
                                       (jet_frame_inv.finv m0 bd dbase bw outedge cursor N bi mr false
                                          (@nil BitMachine.Cell))
                                       (jet_sx_mem.lframe
                                          (Pair.pair_locals_outside (jet_secp_frame.extA m0 bd bw bi) ba bb bl) m mr)))))))))))
