TAP_DEF FieldInput.Input.normalized_value
Input.normalized_value =
fun x : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
  (@jet_secp_canonical_normalize.canonical_fe_normalize Alg.CoreFunSem x)
     : forall _ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))), BinNums.Z

Arguments Input.normalized_value x
TAP_DEF FieldInput.Input.pair_rho
Input.pair_rho =
fun (x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (n : nat) =>
match PeanoNat.Nat.ltb n (S (S (S (S (S O))))) return Integers.Int64.int with
| true => jet_secp_b32_exec.limb_rho (Input.normalized_value x) n
| false => jet_secp_b32_exec.limb_rho (Input.normalized_value y) (Nat.sub n (S (S (S (S (S O))))))
end
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))) (_ : nat), Integers.Int64.int

Arguments Input.pair_rho x y n%nat_scope
TAP_DEF FieldInput.Input.input_product_word
Input.input_product_word =
fun x y : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))) =>
@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S (S (S O)))))))))
  (BinInt.Z.modulo
     (BinInt.Z.mul (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) x)
        (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))) y)) jet_secp_fe_math.feP)
     : forall (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
         (_ : Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))),
       Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S (S (S O))))))))))

Arguments Input.input_product_word x y
TAP_DEF FieldInput.Pair.pair_locals_outside
Pair.pair_locals_outside =
fun (ext : forall _ : Values.block, Prop) (ba bb bl b : Values.block) (_ : BinNums.Z) =>
and (not (@eq Values.block b ba)) (and (not (@eq Values.block b bb)) (and (not (@eq Values.block b bl)) (not (ext b))))
     : forall (_ : forall _ : Values.block, Prop) (_ : Values.block) (_ : Values.block) (_ : Values.block)
         (_ : Values.block) (_ : BinNums.Z), Prop

Arguments Pair.pair_locals_outside ext%function_scope ba bb bl b _%Z_scope
