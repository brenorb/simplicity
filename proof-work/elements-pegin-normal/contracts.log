jet_elements_amount_jets.amount_pair_result =
fun (A : Type) (elems : list A) (ga : forall _ : A, jet_elements_prim.assetWith unit)
  (gm : forall _ : A, jet_elements_prim.amountWith unit) (a : Ty.tySem (Word.Word (S (S (S (S (S O))))))) =>
match
  @List.nth_error A elems (BinInt.Z.to_nat (@Word.ToZ.Theory.toZ (Word.WordToZ (S (S (S (S (S O)))))) a))
  return
    (Ty.tySem
       (Ty.Sum Ty.Unit
          (Ty.Prod
             (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
                (Word.Word (S (S (S (S (S (S O)))))))))))
with
| Some x =>
    @inr unit
      (prod
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S O))))))))))
      (@pair
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
         (Ty.tySem
            (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
               (Word.Word (S (S (S (S (S (S O))))))))) (jet_elements_asset_jets.encode_asset (ga x))
         (jet_elements_amount_jets.encode_amount (gm x)))
| None =>
    @inl unit
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A0 B => sum (tySem A0) (tySem B)
