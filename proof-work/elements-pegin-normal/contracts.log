           (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)))
     (@Alg.Core.Combinators.comp (Ty.Prod CM (Ty.Sum Ty.Unit CA)) (Ty.Prod (Ty.Sum Ty.Unit CA) CM)
        (Ty.Sum Ty.Unit (Ty.Prod CA CM)) (jet_elements_prim.PrimitiveElements.Primitive.CanonicalStructures.toCore alg)
