NORMAL_PEGIN_DEF C.jet_elements_amount_jets.encode_amount
jet_elements_amount_jets.encode_amount =
fun a : jet_elements_prim.amountWith unit =>
match
  a
  return
    (Ty.tySem
       (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
          (Word.Word (S (S (S (S (S (S O)))))))))
with
| jet_elements_prim.Explicit v =>
    @inr
      (prod
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Ty.Sum Ty.Unit Ty.Unit))
         ((fix tySem (X : Ty.Ty) : Set :=
             match X return Set with
             | Ty.Unit => unit
             | Ty.Sum A B => sum (tySem A) (tySem B)
             | Ty.Prod A B => prod (tySem A) (tySem B)
             end) (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
      (Ty.tySem (Word.ToZ.obj (Word.WordToZ (S (S (S (S (S (S O)))))))))
      (@Word.ToZ.Theory.fromZ (Word.WordToZ (S (S (S (S (S (S O))))))) (Integers.Int64.unsigned v))
| jet_elements_prim.Confidential pt _ =>
    match
      pt
      return
        (Ty.tySem
           (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
              (Word.Word (S (S (S (S (S (S O)))))))))
    with
    | jet_elements_prim.Point odd x =>
        @inl (prod (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O)))))))))))
          (prod
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O)))))))
             ((fix tySem (X : Ty.Ty) : Set :=
                 match X return Set with
                 | Ty.Unit => unit
                 | Ty.Sum A B => sum (tySem A) (tySem B)
                 | Ty.Prod A B => prod (tySem A) (tySem B)
                 end)
                ((fix Vector (X : Ty.Ty) (n : nat) {struct n} : Ty.Ty :=
                    match n return Ty.Ty with
                    | O => X
                    | S n0 => Ty.Prod (Vector X n0) (Vector X n0)
                    end) (Ty.Sum Ty.Unit Ty.Unit) (S (S (S (S (S O))))))))
          (@pair (Ty.tySem (Ty.Sum Ty.Unit Ty.Unit)) (Ty.tySem (Word.Word (S (S (S (S (S (S (S (S O))))))))))
             (jet_elements_asset_jets.conf_toBit odd) (Word.from_hash256 x))
    end
end
     : forall _ : jet_elements_prim.amountWith unit,
       Ty.tySem
         (Ty.Sum (Ty.Prod (Ty.Sum Ty.Unit Ty.Unit) (Word.Word (S (S (S (S (S (S (S (S O))))))))))
            (Word.Word (S (S (S (S (S (S O))))))))

