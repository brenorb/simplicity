DELTA_DEEP_DEF C.jet_application_context_contract.application_jet_bitmachine_spec
jet_application_context_contract.application_jet_bitmachine_spec =
fun (f : Clight.function) (ge : Clight.genv) (E : Set) (A B : Ty.Ty)
  (env_rep : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E)
               (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
  (spec : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)) =>
forall (logical_env : E) (env : Values.val) (m : Memory.Mem.mem) (L : bm_layout) (s : RunState) 
  (a : Ty.tySem A) (tail : list Cell) (fp : list (prod (prod Values.block BinNums.Z) BinNums.Z))
  (_ : env_rep m env logical_env fp)
  (_ : @List.Forall (prod (prod Values.block BinNums.Z) BinNums.Z)
         (fun pat : prod (prod Values.block BinNums.Z) BinNums.Z =>
          match pat return Prop with
          | pair y hi =>
              match y return Prop with
              | pair b lo =>
                  out_sep (frames_blk L) (item_ofs (active_write_loc L)) (cells_blk L) (edge_ofs (active_write_loc L))
                    (BinInt.Z.of_nat (writeEmpty (activeWriteFrame s))) (BinInt.Z.of_nat (bitSize B)) b lo hi
              end
          end) fp) (_ : bm_rep m L s) (_ : bm_separated L s) (_ : active_write_writable m L s)
  (_ : @eq (list Cell) (nextData (activeReadFrame s)) (@app Cell (@encode A a) tail))
  (_ : le (bitSize B) (writeEmpty (activeWriteFrame s))),
@ex Memory.Mem.mem
  (fun mf : Memory.Mem.mem =>
   @ex (Ty.tySem B)
     (fun value : Ty.tySem B =>
      and (@eq (option (Ty.tySem B)) (spec a logical_env) (@Some (Ty.tySem B) value))
        (and
           (ClightBigstep.Clight2.eval_funcall ge m (@Ctypes.Internal Clight.function f) (jet_args env L) Events.E0 mf
              (Values.Vint Integers.Int.one))
           (bm_rep mf L
              (Build_RunState (inactiveReadFrames s) (activeReadFrame s)
                 (Build_WriteFrame (@app Cell (@List.rev Cell (@encode B value)) (writeData (activeWriteFrame s)))
                    (Nat.sub (writeEmpty (activeWriteFrame s)) (@length Cell (@encode B value))))
                 (inactiveWriteFrames s))))))
     : forall (_ : Clight.function) (_ : Clight.genv) (E : Set) (A B : Ty.Ty)
         (_ : forall (_ : Memory.Mem.mem) (_ : Values.val) (_ : E)
                (_ : list (prod (prod Values.block BinNums.Z) BinNums.Z)), Prop)
         (_ : forall (_ : Ty.tySem A) (_ : E), option (Ty.tySem B)), Prop

Arguments jet_application_context_contract.application_jet_bitmachine_spec f ge E%type_scope 
  (A B)%ty_scope (env_rep spec)%function_scope
