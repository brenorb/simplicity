DELTA_DEEP_DEF C.jet_elements_const_bits.elements_const_bit
jet_elements_const_bits.elements_const_bit =
fun bit : bool =>
Clight.Scall (@None AST.ident)
  (Clight.Evar jets_elements._writeBit
     (Ctypes.Tfunction
        (Ctypes.Tcons (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr))
           (Ctypes.Tcons Ctypesdefs.tbool Ctypes.Tnil)) Ctypesdefs.tbool AST.cc_default))
  (@cons Clight.expr
     (Clight.Etempvar jets_elements._dst (Ctypesdefs.tptr (Ctypes.Tstruct jets_elements._frameItem Ctypes.noattr)))
     (@cons Clight.expr
        (Clight.Econst_int
           match bit return Integers.Int.int with
           | true => Integers.Int.one
           | false => Integers.Int.zero
           end Ctypesdefs.tint) (@nil Clight.expr)))
     : forall _ : bool, Clight.statement

Arguments jet_elements_const_bits.elements_const_bit bit%bool_scope
DELTA_DEEP_DEF C.jet_elements_const_bits.elements_const_bits
jet_elements_const_bits.elements_const_bits =
fix elements_const_bits (bits : list bool) : Clight.statement :=
  match bits return Clight.statement with
  | nil => Clight.Sbreak
  | cons bit rest => Clight.Ssequence (jet_elements_const_bits.elements_const_bit bit) (elements_const_bits rest)
  end
     : forall _ : list bool, Clight.statement

Arguments jet_elements_const_bits.elements_const_bits bits%list_scope
DELTA_DEEP_DEF C.jet_elements_null_data_cases.elements_statement_switches
jet_elements_null_data_cases.elements_statement_switches =
fix elements_statement_switches (s : Clight.statement) : list (prod Clight.expr Clight.labeled_statements) :=
  match s return (list (prod Clight.expr Clight.labeled_statements)) with
  | Clight.Sskip => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sassign _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sset _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Scall _ _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sbuiltin _ _ _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Ssequence a b =>
      @app (prod Clight.expr Clight.labeled_statements) (elements_statement_switches a) (elements_statement_switches b)
  | Clight.Sifthenelse _ a b =>
      @app (prod Clight.expr Clight.labeled_statements) (elements_statement_switches a) (elements_statement_switches b)
  | Clight.Sloop a b =>
      @app (prod Clight.expr Clight.labeled_statements) (elements_statement_switches a) (elements_statement_switches b)
  | Clight.Sbreak => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Scontinue => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sreturn _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sswitch a cases =>
      @cons (prod Clight.expr Clight.labeled_statements) (@pair Clight.expr Clight.labeled_statements a cases)
        (@nil (prod Clight.expr Clight.labeled_statements))
  | Clight.Slabel _ _ => @nil (prod Clight.expr Clight.labeled_statements)
  | Clight.Sgoto _ => @nil (prod Clight.expr Clight.labeled_statements)
  end
     : forall _ : Clight.statement, list (prod Clight.expr Clight.labeled_statements)

Arguments jet_elements_null_data_cases.elements_statement_switches s
