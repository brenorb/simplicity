     : forall (digits : forall _ : nat, Integers.Int64.int) (c d : prod Integers.Int64.int Integers.Int64.int)
         (t3 : Integers.Int64.int) (rho : forall _ : nat, Integers.Int64.int) (beta : jet_sx_state.layout)
         (e : Clight.env) (le : Clight.temp_env) (m : Memory.Mem.mem)
         (_ : jet_sx_state.rep rho beta (jet_sx_eval.sregs (State.second_initial digits c d t3)) m)
         (_ : jet_sx_eval.tmatch rho beta (jet_sx_eval.stemps (State.second_initial digits c d t3)) le)
         (_ : jet_sx_eval.ematch beta (@snd (list jet_sx_state.region) jet_sx_eval.venv Prefix.mul_allocated) e),
       @ex Clight.temp_env
         (fun le' : Clight.temp_env =>
          @ex Memory.Mem.mem
            (fun mf : Memory.Mem.mem =>
             and
               (ClightBigstep.Clight2.exec_stmt jet_secp_linkage.secp_ge e le m State.second_statement Events.E0 le' mf
                  ClightBigstep.Out_normal)
               (and (Machine.second_observations digits c d t3 beta le' mf)
                  (and
                     (jet_sx_state.rep rho beta
                        (jet_sx_eval.sregs (Atomic.atomic_state rho beta (State.second_state digits c d t3))) mf)
                     (and
                        (jet_sx_eval.tmatch rho beta
                           (jet_sx_eval.stemps (Atomic.atomic_state rho beta (State.second_state digits c d t3))) le')
                        (jet_sx_mem.lframe
                           (fun (b : Values.block) (ofs : BinNums.Z) =>
                            not
                              (jet_sx_state.foot beta
                                 (@List.map jet_sx_state.region
                                    (prod (prod (list (prod BinNums.Z AST.memory_chunk)) bool) (option BinNums.Z))
                                    jet_sx_state.rshape (jet_sx_eval.sregs (State.second_initial digits c d t3))) b ofs))
                           m mf))))))
