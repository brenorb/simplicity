TAP_DEF FieldSecond.Machine.second_observations
Machine.second_observations =
fun (digits : forall _ : nat, Integers.Int64.int) (c d : prod Integers.Int64.int Integers.Int64.int)
  (t3 : Integers.Int64.int) (beta : jet_sx_state.layout) (le : Maps.PTree.tree Values.val) 
  (m : Memory.Mem.mem) =>
and
  (@eq (option Values.val)
     (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk beta (S (S O)))
        (BinInt.Z.add (jet_sx_state.bas beta (S (S O))) BinNums.Z0))
     (@Some Values.val (Values.Vlong (@fst Integers.Int64.int Integers.Int64.int c))))
  (and
     (@eq (option Values.val)
        (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk beta (S (S O)))
           (BinInt.Z.add (jet_sx_state.bas beta (S (S O)))
              (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
        (@Some Values.val (Values.Vlong (@snd Integers.Int64.int Integers.Int64.int c))))
     (and
        (@eq (option Values.val)
           (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk beta (S (S (S O))))
              (BinInt.Z.add (jet_sx_state.bas beta (S (S (S O)))) BinNums.Z0))
           (@Some Values.val
              (Values.Vlong (@fst Integers.Int64.int Integers.Int64.int (Machine.second_final_machine digits c d)))))
        (and
           (@eq (option Values.val)
              (Memory.Mem.load AST.Mint64 m (jet_sx_state.blk beta (S (S (S O))))
                 (BinInt.Z.add (jet_sx_state.bas beta (S (S (S O))))
                    (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))))
              (@Some Values.val
                 (Values.Vlong (@snd Integers.Int64.int Integers.Int64.int (Machine.second_final_machine digits c d)))))
           (and
              (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._tx le)
                 (@Some Values.val (Values.Vlong (Machine.second_tx_machine digits c d))))
              (and
                 (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t4 le)
                    (@Some Values.val (Values.Vlong (Machine.second_t4_machine digits c d))))
                 (@eq (option Values.val) (@Maps.PTree.get Values.val jets_secp._t3 le)
                    (@Some Values.val (Values.Vlong t3))))))))
     : forall (_ : forall _ : nat, Integers.Int64.int) (_ : prod Integers.Int64.int Integers.Int64.int)
         (_ : prod Integers.Int64.int Integers.Int64.int) (_ : Integers.Int64.int) (_ : jet_sx_state.layout)
         (_ : Maps.PTree.tree Values.val) (_ : Memory.Mem.mem), Prop

