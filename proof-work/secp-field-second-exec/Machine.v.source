(** Concrete machine observation of the next original C slice, including wrap. *)
From Coq Require Import ZArith List.
From compcert Require Import Integers AST Ctypes Clight Clightdefs ClightBigstep Maps Memory Events Values.
Require Import C.jet_sx_expr C.jet_sx_state C.jet_sx_eval C.jet_sx_exec C.jet_sx_mem C.jet_sx_rep.
Require Import C.jet_secp_linkage C.jets_secp C.jet_secp_u128_shift64_rep.
Require Import FieldCheckpoint.Machine FieldCheckpoint.Ops FieldCheckpoint.Prefix FieldCheckpoint.Atomic.
Require Import FieldSecond.State.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.

Definition second_fold_machine (digits : nat -> int64) (c d : int64 * int64) :=
  machine_accum
    (machine_accum (machine_accum (machine_accum (machine_accum (machine_accum d
      (digits 0%nat) (digits 9%nat)) (digits 1%nat) (digits 8%nat))
      (digits 2%nat) (digits 7%nat)) (digits 3%nat) (digits 6%nat)) (digits 4%nat) (digits 5%nat))
    (Int64.shl (Int64.repr 68719492368) (Int64.repr 12)) (fst c).
Definition second_final_machine digits c d := machine_shift52 (second_fold_machine digits c d).
Definition second_before_machine digits c d := Int64.and (fst (second_fold_machine digits c d)) (Int64.repr 4503599627370495).
Definition second_tx_machine digits c d := Int64.shru (second_before_machine digits c d) (Int64.repr 48).
Definition second_t4_machine digits c d := Int64.and (second_before_machine digits c d)
  (Int64.shru (Int64.repr 4503599627370495) (Int64.repr 4)).

Lemma second_fold_den rho beta digits c d : pair_den rho beta (second_fold_sy digits c d) = second_fold_machine digits c d.
Proof. unfold second_fold_sy, second_fold_machine; rewrite !sx_accum_machine; reflexivity. Qed.
Lemma second_final_den rho beta digits c d : pair_den rho beta (second_final_sy digits c d) = second_final_machine digits c d.
Proof. unfold second_final_sy, second_final_machine; rewrite sx_shift52_machine, second_fold_den; reflexivity. Qed.
Lemma second_before_den rho beta digits c d : den rho beta (second_t4_before digits c d) = Vlong (second_before_machine digits c d).
Proof.
  unfold second_t4_before, second_before_machine.
  change (Vlong (Int64.and (fst (pair_den rho beta (second_fold_sy digits c d))) (Int64.repr 4503599627370495)) =
    Vlong (Int64.and (fst (second_fold_machine digits c d)) (Int64.repr 4503599627370495))).
  rewrite second_fold_den; reflexivity.
Qed.
Lemma second_tx_den rho beta digits c d : den rho beta (second_tx_sy digits c d) = Vlong (second_tx_machine digits c d).
Proof.
  unfold second_tx_sy, second_tx_machine.
  change (Vlong (Int64.shru (il (den rho beta (second_t4_before digits c d))) (Int64.repr 48)) =
    Vlong (Int64.shru (second_before_machine digits c d) (Int64.repr 48))).
  rewrite second_before_den; reflexivity.
Qed.
Lemma second_t4_den rho beta digits c d : den rho beta (second_t4_sy digits c d) = Vlong (second_t4_machine digits c d).
Proof.
  unfold second_t4_sy, second_t4_machine.
  change (Vlong (Int64.and (il (den rho beta (second_t4_before digits c d)))
    (Int64.shru (Int64.repr 4503599627370495) (Int64.repr 4))) =
    Vlong (Int64.and (second_before_machine digits c d) (Int64.shru (Int64.repr 4503599627370495) (Int64.repr 4)))).
  rewrite second_before_den; reflexivity.
Qed.

Definition second_observations digits c d t3 beta le m :=
  Mem.load Mint64 m (blk beta 2) (bas beta 2 + 0) = Some (Vlong (fst c)) /\
  Mem.load Mint64 m (blk beta 2) (bas beta 2 + 8) = Some (Vlong (snd c)) /\
  Mem.load Mint64 m (blk beta 3) (bas beta 3 + 0) = Some (Vlong (fst (second_final_machine digits c d))) /\
  Mem.load Mint64 m (blk beta 3) (bas beta 3 + 8) = Some (Vlong (snd (second_final_machine digits c d))) /\
  le!_tx = Some (Vlong (second_tx_machine digits c d)) /\
  le!_t4 = Some (Vlong (second_t4_machine digits c d)) /\ le!_t3 = Some (Vlong t3).

Local Opaque xstmt second_state second_initial second_statement mul_allocated.
Lemma second_typed_run digits c d t3 : xstmt (genv_cenv secp_ge) [] FieldRun.Run.field_table 160
  (snd mul_allocated) (second_initial digits c d t3) second_statement = Some (RDone (second_state digits c d t3) ONormal).
Proof. change (second_run digits c d t3 = Some (RDone (second_state digits c d t3) ONormal)); apply second_run_eq. Qed.

Theorem exec_second_machine_atomic digits c d t3 rho beta e le m :
  rep rho beta (sregs (second_initial digits c d t3)) m ->
  tmatch rho beta (stemps (second_initial digits c d t3)) le -> ematch beta (snd mul_allocated) e ->
  exists le' mf,
    Clight2.exec_stmt secp_ge e le m second_statement E0 le' mf Out_normal /\
    second_observations digits c d t3 beta le' mf /\
    rep rho beta (sregs (atomic_state rho beta (second_state digits c d t3))) mf /\
    tmatch rho beta (stemps (atomic_state rho beta (second_state digits c d t3))) le' /\
    lframe (fun b ofs => ~ foot beta (map rshape (sregs (second_initial digits c d t3))) b ofs) m mf.
Proof.
  intros HR HT HE.
  destruct (field_stmt_normal 160 (snd mul_allocated) (second_initial digits c d t3) second_statement
    (second_state digits c d t3) (second_typed_run digits c d t3) rho beta e le m HR HT HE)
    as (le' & mf & HX & HRep & HTm & HS & HF).
  pose proof (rep_region rho beta _ mf 2 _ HRep (second_c_unchanged digits c d t3)) as HC.
  pose proof (region_load rho beta mf 2 _ 0 Mint64 (XL (fst c)) HC ltac:(left; reflexivity)) as HCL.
  pose proof (region_load rho beta mf 2 _ 8 Mint64 (XL (snd c)) HC ltac:(right; left; reflexivity)) as HCH.
  pose proof (xload_u64_defined_sound rho beta _ mf 3 0 (fst (second_final_sy digits c d)) HRep (second_d_low digits c d t3)) as HDL.
  pose proof (xload_u64_defined_sound rho beta _ mf 3 8 (snd (second_final_sy digits c d)) HRep (second_d_high digits c d t3)) as HDH.
  rewrite (pair_low_den rho (lay beta) _ _ (second_final_den rho (lay beta) digits c d) eq_refl) in HDL.
  rewrite (pair_high_den rho (lay beta) _ _ (second_final_den rho (lay beta) digits c d) eq_refl) in HDH.
  pose proof (HTm _ _ (second_tx digits c d t3)) as HTX; rewrite second_tx_den in HTX.
  pose proof (HTm _ _ (second_t4 digits c d t3)) as HT4; rewrite second_t4_den in HT4.
  pose proof (HTm _ _ (second_t3_preserved digits c d t3)) as HT3.
  exists le', mf; split; [exact HX|]; split.
  - unfold second_observations; split; [exact HCL|]; split; [exact HCH|]; split; [exact HDL|];
      split; [exact HDH|]; split; [exact HTX|]; split; assumption.
  - split; [apply atomic_rep; exact HRep|]; split; [apply atomic_tmatch; exact HTm|exact HF].
Qed.
