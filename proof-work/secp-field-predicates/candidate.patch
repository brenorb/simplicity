+  fn_vars f = fn_vars g -> fn_params f = fn_params g -> fn_temps f = fn_temps g ->
+  function_entry2 ge f args m e le mf -> function_entry2 ge g args m e le mf.
+Proof.
+  intros HVars HParams HTemps HEntry; inversion HEntry; subst.
