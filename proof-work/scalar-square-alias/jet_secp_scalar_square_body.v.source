(** Original scalar_mul body in square's r=a=b calling configuration. *)
From Coq Require Import ZArith List.
From compcert Require Import AST Ctypes Clight ClightBigstep Integers Values Maps Memory Events.
Require Import C.jet_sx_expr C.jet_sx_state C.jet_sx_rep C.jet_sx_mem C.jet_sx_eval
  C.jet_secp_linkage C.jets_secp C.jet_secp_canonical_scalar
  C.jet_secp_scalar_mul_caller_body C.jet_secp_product_reduce_bridge
  C.jet_secp_scalar_mul512_low C.jet_secp_reduce512_function_numeric
  C.jet_secp_reduce512_body_numeric C.jet_secp_reduce512_final_atomic
  C.jet_secp_scalar_reduce512_run.
Require Import SqrC.jet_secp_scalar_square512_run SqrC.jet_secp_scalar_square512_product
  SqrC.jet_secp_square_product_reduce.
Import ListNotations.
Local Open Scope Z_scope.
Set Default Timeout 10.

Lemma exec_scalar_square_product_call beta le m mf :
  le!_a = Some (Vptr (blk beta 1) (Ptrofs.repr (bas beta 1))) ->
  le!_b = Some (Vptr (blk beta 1) (Ptrofs.repr (bas beta 1))) ->
  bas beta 0 = 0 ->
  Clight2.eval_funcall secp_ge m (Internal f_secp256k1_scalar_mul_512)
    [Vptr (blk beta 0) (Ptrofs.repr (bas beta 0));
     Vptr (blk beta 1) (Ptrofs.repr (bas beta 1));
     Vptr (blk beta 1) (Ptrofs.repr (bas beta 1))] E0 mf Vundef ->
  Clight2.exec_stmt secp_ge (scalar_mul_caller_env beta) le m
    scalar_mul_product_stmt E0 le mf Out_normal.
Proof.
  intros HA HB H0 HC.
  (* This layout only instantiates an expression/call rule: it is never
     asserted to own three regions. The actual memory contract has two. *)
  exact (exec_scalar_mul_product_call [lay beta 0; lay beta 1; lay beta 1]
    le m mf HA HB H0 HC).
Qed.

Theorem exec_scalar_square_body_inplace rho beta le m :
  rep rho beta scalar_square512_regs m ->
  le!_r = Some (Vptr (blk beta 1) (Ptrofs.repr (bas beta 1))) ->
  le!_a = Some (Vptr (blk beta 1) (Ptrofs.repr (bas beta 1))) ->
  le!_b = Some (Vptr (blk beta 1) (Ptrofs.repr (bas beta 1))) ->
  exists mf,
    Clight2.exec_stmt secp_ge (scalar_mul_caller_env beta) le m
      (fn_body f_secp256k1_scalar_mul) E0 le mf Out_normal /\
    rep (product_reduce_rho (square512_rho rho)) (product_reduce_layout beta)
      (reduce512_numeric_owned_regs (product_reduce_rho (square512_rho rho))) mf /\
    final_output_value (reduce512_body_digits (product_reduce_rho (square512_rho rho)))
      (reduce512_body_carry (product_reduce_rho (square512_rho rho)))
      (product_reduce_rho (square512_rho rho)) (lay (product_reduce_layout beta)) =
      (scalar_mul512_input_value rho 0 * scalar_mul512_input_value rho 0) mod canonical_group_order /\
    lframe (fun b ofs => ~ foot beta (map rshape scalar_square512_regs) b ofs) m mf.
Proof.
  intros HR LR LA LB.
  pose proof (rep_region rho beta _ m 0 _ HR eq_refl) as (_ & _ & _ & _ & HOwned).
  destruct HOwned as (Hbase & _).
  destruct (eval_square_product_then_reduce rho beta m HR)
    as (mp & mf & HP & HC & Hout & Hvalue & HFP & HFR).
  exists mf; split.
  - rewrite scalar_mul_caller_source.
    eapply exec_Sseq_1 with (t1 := E0) (t2 := E0) (le1 := le) (m1 := mp).
    + eapply exec_scalar_square_product_call; eassumption.
    + eapply exec_scalar_mul_reduction_call; eassumption.
  - split; [exact Hout|]. split; [exact Hvalue|].
    eapply lframe_trans; [exact HFP|].
    eapply lframe_implies; [exact HFR|].
    intros b ofs HF Hv Hfoot; apply HF; eapply square_product_reduce_foot_embed; exact Hfoot.
Qed.
